jian_id":"b7966f9c-db0e-11ef-b73b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"31張護、李通殺賀拔懷廣，立汝州別駕竇伏明爲主，進逼瓜州；長史趙孝倫擊卻之。","content_fanyi":"张护、李通杀死贺拔怀广，将汝州别驾窦伏明拥立为主，进逼瓜州；瓜州长史赵孝伦击退了他们。","content_jianti_auto":"31张护、李通杀贺拔怀广，立汝州别驾窦伏明为主，进逼瓜州；长史赵孝伦击却之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18422,"number":31,"path":"资治通鉴 : 卷第一百九十 (唐紀六) / 高祖神堯大聖光孝皇帝中之下 / 六年 / 第 31 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":30,"tongjian_id":"b795d310-db0e-11ef-9c82-a0d3651f611f","year_int":623},"tongjian_id":"b795d310-db0e-11ef-9c82-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"汝州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"漢景帝","people_name_jianti_auto":"汉景帝","start_index":16,"tongjian_id":"b89759ba-db0e-11ef-a75d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"b89759bb-db0e-11ef-8925-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":25,"tongjian_id":"b89759bc-db0e-11ef-b28e-a0d3651f611f"},{"place_name":"清暑宮","place_name_jianti_auto":"清暑宫","start_index":53,"tongjian_id":"b89759bd-db0e-11ef-a96b-a0d3651f611f"},{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南省临汝市","start_index":57,"tongjian_id":"b89759be-db0e-11ef-8d6e-a0d3651f611f"},{"place_name":"臨汝縣","place_name_jianti_auto":"临汝县","start_index":59,"tongjian_id":"b89759bf-db0e-11ef-a3f6-a0d3651f611f"},{"place_name":"鳴皋山","place_name_jianti_auto":"鸣皋山","start_index":62,"tongjian_id":"b89759c0-db0e-11ef-9cca-a0d3651f611f"},{"place_name":"汝水","place_name_jianti_auto":"汝水","start_index":68,"tongjian_id":"b89759c1-db0e-11ef-9b80-a0d3651f611f"},{"place_name":"廣成澤","place_name_jianti_auto":"广成泽","start_index":71,"tongjian_id":"b89759c2-db0e-11ef-a54c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦置將作，掌營繕宮室，歷代不改。漢景帝置將作大匠。唐從三品，掌供邦國脩造、土木工匠之政令。新志：貞觀中，置清暑宮於汝州臨汝縣鳴皋山南。按汝水睨廣成澤。","note_content_jianti_auto":"秦置将作，掌营缮宫室，历代不改。汉景帝置将作大匠。唐从三品，掌供邦国修造、土木工匠之政令。新志：贞观中，置清暑宫于汝州临汝县鸣皋山南。按汝水睨广成泽。","note_type":"hu_note","start_index":39,"tongjian_id":"b89759b9-db0e-11ef-872d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"閻立本","people_name_jianti_auto":"阎立本","start_index":0,"tongjian_id":"b89759c5-db0e-11ef-8931-a0d3651f611f"},{"people_name":"高宗","people_name_jianti_auto":"高宗","start_index":4,"tongjian_id":"b89759c6-db0e-11ef-8a0c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閻立本，高宗朝爲相。","note_content_jianti_auto":"阎立本，高宗朝为相。","note_type":"hu_note","start_index":48,"tongjian_id":"b89759c4-db0e-11ef-ad44-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南省临汝市","resolved_place_entity_id":801,"start_index":34,"tongjian_id":"b89759ca-db0e-11ef-afb8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9上將幸洛陽，命將作大匠閻立德行清暑之地。秋，八月，庚午，作襄城宮於汝州西山。立德，立本之兄也。","content_fanyi":"唐太宗即将临幸洛阳，命令将作大匠阎立德沿途巡视并选择清静的避暑之地。秋季，八月初五日庚午，在汝州西山修建襄城宫。阎立德是阎立本的哥哥。","content_jianti_auto":"9上将幸洛阳，命将作大匠阎立德行清暑之地。秋，八月，庚午，作襄城宫于汝州西山。立德，立本之兄也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19064,"number":9,"path":"资治通鉴 : 卷第一百九十五 (唐紀十一) / 太宗文武大聖大廣孝皇帝中之上 / 十四年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"b89759b7-db0e-11ef-82e3-a0d3651f611f","year_int":640},"tongjian_id":"b89759b7-db0e-11ef-82e3-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"汝州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南省汝州市","start_index":0,"tongjian_id":"b9cdf60c-db0e-11ef-98a9-a0d3651f611f"},{"place_name":"梁縣","place_name_jianti_auto":"梁县","start_index":2,"tongjian_id":"b9cdf60d-db0e-11ef-86e0-a0d3651f611f"},{"place_name":"黃女湯","place_name_jianti_auto":"黄女汤","start_index":20,"tongjian_id":"b9cdf60e-db0e-11ef-96fb-a0d3651f611f"},{"place_name":"溫泉頓","place_name_jianti_auto":"温泉顿","start_index":26,"tongjian_id":"b9cdf60f-db0e-11ef-ae2e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"汝州梁縣西南五十里有溫湯，可以熟米。又有黃女湯。帝置溫泉頓。","note_content_jianti_auto":"汝州梁县西南五十里有温汤，可以熟米。又有黄女汤。帝置温泉顿。","note_type":"hu_note","start_index":12,"tongjian_id":"b9cdf60b-db0e-11ef-a0ff-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南省汝州市","resolved_place_entity_id":801,"start_index":6,"tongjian_id":"b9cdf610-db0e-11ef-aef1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、汝州（卷五十一）","excerpts":[{"context_after":"。武后圣历三年，亦幸汝州温汤。又开元十年，幸汝州广成汤泉...","context_before":"...，狩于嵩高，遂幸温汤，即梁县之温汤也。炀帝于此置温泉顿。","source_end_index":267,"source_paragraph_tongjian_id":"002c99bb-fc60-555a-a67b-73fe94b46da1","source_start_index":250,"source_text":"唐仪凤元年，幸汝州温汤，后又屡幸焉"}],"path":"河南方舆纪要/九、汝州（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"5丁亥，上幸汝州之溫湯。","content_fanyi":"丁亥日，高宗临幸汝州的温泉。","content_jianti_auto":"5丁亥，上幸汝州之温汤。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19889,"number":5,"path":"资治通鉴 : 卷第二百二 (唐紀十八) / 高宗天皇大聖大弘孝皇帝中之下 / 儀鳳元年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"b9cdf60a-db0e-11ef-ad9f-a0d3651f611f","year_int":676},"tongjian_id":"b9cdf60a-db0e-11ef-ad9f-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"汝州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師正","people_name_jianti_auto":"师正","start_index":8,"tongjian_id":"b9dd2559-db0e-11ef-a06e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙州","place_name_jianti_auto":"赵州","start_index":11,"tongjian_id":"b9dd255a-db0e-11ef-8e4b-a0d3651f611f"},{"place_name":"贊皇","place_name_jianti_auto":"赞皇","start_index":13,"tongjian_id":"b9dd255b-db0e-11ef-93ca-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊傳，「師正，趙州贊皇人。」今從實錄。","note_content_jianti_auto":"考异曰：旧传，「师正，赵州赞皇人。」今从实录。","note_type":"hu_note","start_index":47,"tongjian_id":"b9dd2558-db0e-11ef-9dfb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言帝崇信異端。","note_content_jianti_auto":"史言帝崇信异端。","note_type":"hu_note","start_index":58,"tongjian_id":"b9dd255f-db0e-11ef-b110-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南汝州","resolved_place_entity_id":801,"start_index":11,"tongjian_id":"b9dd2561-db0e-11ef-bb88-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"又少室山，在县西十七里，一名御寨。潘岳云：少室山有十八叠...","context_before":"○嵩山[在县北十里。中岳是也。","source_end_index":41,"source_paragraph_tongjian_id":"7404d9b6-c5be-5417-a627-c48414b3a158","source_start_index":15,"source_text":"有逍遥谷，一名承天谷，道士潘师正居此，唐高宗尝幸焉。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"又少室山，在县西十七里，一名御寨。潘岳云：少室山有十八叠...","context_before":"○嵩山[在县北十里。中岳是也。有逍遥谷，一名承天谷，","source_end_index":41,"source_paragraph_tongjian_id":"687867d3-0bf4-50e1-9e84-c81b21e454a4","source_start_index":26,"source_text":"道士潘师正居此，唐高宗尝幸焉。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1春，二月，癸丑，上幸汝州之溫湯；戊午，幸嵩山處士三原田遊巖所居；己未，幸道士宗城潘師正所居，上及天后、太子皆拜之。乙丑，還東都。","content_fanyi":"春季，二月癸丑日，高宗来到汝州温泉；戊午日，来到嵩山处士三原人田游岩的住所；己未日，来到道士宗城人潘师正的住所，高宗与天后、太子都向他行礼。乙丑日，高宗一行返回东都。","content_jianti_auto":"1春，二月，癸丑，上幸汝州之温汤；戊午，幸嵩山处士三原田游岩所居；己未，幸道士宗城潘师正所居，上及天后、太子皆拜之。乙丑，还东都。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19956,"number":1,"path":"资治通鉴 : 卷第二百二 (唐紀十八) / 高宗天皇大聖大弘孝皇帝中之下 / 永隆元年 / 第 1 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":0,"tongjian_id":"b9dd2556-db0e-11ef-8c18-a0d3651f611f","year_int":680},"tongjian_id":"b9dd2556-db0e-11ef-8c18-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"汝州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三陽宮","place_name_jianti_auto":"三阳宫","place_note":"河南省登封县东南","start_index":0,"tongjian_id":"bb9c2479-db0e-11ef-8958-a0d3651f611f"},{"place_name":"洛城","place_name_jianti_auto":"洛城","start_index":4,"tongjian_id":"bb9c247a-db0e-11ef-a19c-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","start_index":20,"tongjian_id":"bb9c247b-db0e-11ef-96ae-a0d3651f611f"},{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":22,"tongjian_id":"bb9c247c-db0e-11ef-ae61-a0d3651f611f"},{"place_name":"告成","place_name_jianti_auto":"告成","start_index":26,"tongjian_id":"bb9c247d-db0e-11ef-aff2-a0d3651f611f"},{"place_name":"神嶽","place_name_jianti_auto":"神岳","start_index":31,"tongjian_id":"bb9c247e-db0e-11ef-8f7c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三陽宮去洛城一百六十里，萬歲登封元年，改東都陽城縣曰告成，以祀神嶽告成也。淙，藏宗翻，又士江翻。","note_content_jianti_auto":"三阳宫去洛城一百六十里，万岁登封元年，改东都阳城县曰告成，以祀神岳告成也。淙，藏宗翻，又士江翻。","note_type":"hu_note","start_index":42,"tongjian_id":"bb9c2478-db0e-11ef-94a6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bb9c2477-db0e-11ef-a641-a0d3651f611f","pinyin":"cóng","source_anchor_text":"告成之石淙二月乙未","source_key":"baiyang_epub","start_index":40,"text":"淙","tongjian_id":"53c8d0fc-dbb2-5869-9fd1-5c3f0e3b1fc9"}],"ExtRef_Children_places":[{"place_name":"汝州","place_name_jianti_auto":"汝州","place_note":"河南省汝州市","resolved_place_entity_id":801,"start_index":18,"tongjian_id":"bb9c2480-db0e-11ef-b48c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷四十六）","excerpts":[{"context_after":"]。夫嵩高在汝洛间，虽逼近都会，而道里少为僻远，故由来战...","context_before":"...奉天宫。武后垂拱四年，号嵩高为神岳[既而封神岳，禅少室。","source_end_index":465,"source_paragraph_tongjian_id":"ab05e77a-b60a-5470-8dbe-6133a5d23eeb","source_start_index":450,"source_text":"圣历二年，幸嵩山。明年，复幸焉"}],"path":"河南方舆纪要/〇、封域山川险要（卷四十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"长安四年毁]。","context_before":"○奉天宫[在县北嵩山之南，唐高宗永淳初建。","source_end_index":51,"source_paragraph_tongjian_id":"4c6ba3ab-c5f1-50dc-9b63-e1bf63e9a77e","source_start_index":21,"source_text":"又三阳宫，在县西二十里之石淙山，武后圣历三年建，自是数幸焉。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"长安四年毁]。","context_before":"○奉天宫[在县北嵩山之南，唐高宗永淳初建。","source_end_index":51,"source_paragraph_tongjian_id":"7497c0f8-9710-520a-b9d1-9f0816bb79f1","source_start_index":21,"source_text":"又三阳宫，在县西二十里之石淙山，武后圣历三年建，自是数幸焉。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"乙巳，太后幸嵩山；春，一月，丁卯，幸汝州之溫湯；戊寅，還神都。作三陽宮於告成之石淙。","content_fanyi":"乙巳日，太后驾临嵩山；春季一月丁卯日，前往汝州的温泉；戊寅日，返回神都。又在告成县的石淙兴建三阳宫。","content_jianti_auto":"乙巳，太后幸嵩山；春，一月，丁卯，幸汝州之温汤；戊寅，还神都。作三阳宫于告成之石淙。","dtjl_paragraph_links":[],"dtjl_references":[],"id":20526,"path":"资治通鉴 : 卷第二百六 (唐紀二十二) / 則天順聖皇后中之下 / 久視元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"bb9c2477-db0e-11ef-a641-a0d3651f611f","year_int":700},"tongjian_id":"bb9c2477-db0e-11ef-a641-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"汝州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"令狐峘","people_name_jianti_auto":"令狐峘","start_index":4,"tongjian_id":"bcd7eb2b-db0e-11ef-a9b4-a0d3651f611f"},{"people_name":"玄宗","people_name_jianti_auto":"玄宗","start_index":29,"tongjian_id":"bcd7eb2c-db0e-11ef-b505-a0d3651f611f"},{"people_name":"玄宗","people_name_jianti_auto":"玄宗","start_index":51,"tongjian_id":"bcd7eb2d-db0e-11ef-b1e4-a0d3651f611f"},{"people_name":"代宗","people_name_jianti_auto":"代宗","start_index":60,"tongjian_id":"bcd7eb2e-db0e-11ef-a05b-a0d