_death_year":740,"link_td_description":"张九龄，字子寿，一名博物，韶州曲江人（今广东省韶关市曲江区）。唐代第一位由岭南书生进身的宰相、诗人。卒谥文献。人称“张曲江”。有《张曲江集》。","link_td_id":"Q10002171","link_td_number_id":72688,"people_name":"張九齡","people_name_jianti_auto":"张九龄","people_xingming":"张九龄","start_index":8,"tongjian_id":"bd365795-db0e-11ef-b489-a0d3651f611f"},{"link_birth_year":678,"link_death_year":740,"link_td_description":"张九龄，字子寿，一名博物，韶州曲江人（今广东省韶关市曲江区）。唐代第一位由岭南书生进身的宰相、诗人。卒谥文献。人称“张曲江”。有《张曲江集》。","link_td_id":"Q10002171","link_td_number_id":72688,"people_name":"九齡","people_name_jianti_auto":"九龄","people_xingming":"张九龄","start_index":16,"tongjian_id":"bd365796-db0e-11ef-a8e0-a0d3651f611f"},{"link_birth_year":678,"link_death_year":740,"link_td_description":"张九龄，字子寿，一名博物，韶州曲江人（今广东省韶关市曲江区）。唐代第一位由岭南书生进身的宰相、诗人。卒谥文献。人称“张曲江”。有《张曲江集》。","link_td_id":"Q10002171","link_td_number_id":72688,"people_name":"九齡","people_name_jianti_auto":"九龄","people_xingming":"张九龄","start_index":46,"tongjian_id":"bd365798-db0e-11ef-80ad-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"荊州","place_name_jianti_auto":"荆州","place_note":"湖北江陵","resolved_place_entity_id":145,"start_index":4,"tongjian_id":"bd365797-db0e-11ef-8d3a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2二月，荊州長史張九齡卒。上雖以九齡忤旨，逐之，然終愛重其人，每宰相薦士，輒問曰：「風度得如九齡不？」","content_fanyi":"二月，荆州长史张九龄去世。唐玄宗虽然因张九龄违逆自己的旨意而将他放逐出京担任地方官，但终究爱惜器重他的为人，每当宰相举荐士人时，总是问道：“风度能不能像张九龄那样？”","content_jianti_auto":"2二月，荆州长史张九龄卒。上虽以九龄忤旨，逐之，然终爱重其人，每宰相荐士，辄问曰：「风度得如九龄不？」","dtjl_paragraph_links":[],"dtjl_references":[],"id":21654,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"bd365792-db0e-11ef-94f2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3三月，丁亥朔，日有食之。","content_fanyi":"三月初一，丁亥朔，发生日食。","content_jianti_auto":"3三月，丁亥朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21655,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"bd365799-db0e-11ef-9521-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"策反吐蕃守将夺回安戎城","decision_tongjian_id":"DECISION_BD36579ADB0E11EF93FDA0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":12,"chapter_name":"臣节篇第十二","chenzhu_chapter":"臣节者人臣事君之大节。《公羊·庄四年传》言：“国、君一体也。”故其时忠于君即忠于国。所谓忠于国者，国存与存，国亡与亡。国亡而不亡，必其无封疆之寄焉可也；国亡不亡，而犹欲保全其禄位，必顽钝无耻，贪利卖国之徒也。故《胡注》之论臣节，以能致其身为第一义，抗节不仕者次之，保禄位而背宗国者，在所必摈也，况助敌国以噬宗国者乎！","chenzhu_index_in_chapter":19,"chenzhu_text":"孟子曰：“名之曰幽厉，虽孝子慈孙，百世不能改也。”不能改其幽厉耳，固无害子孙之孝慈也。故幽厉自幽厉，孝慈自孝慈，许远之于许敬宗是也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":68,"tongjian_id":"CH12-CZ019"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"許敬宗","people_name_jianti_auto":"许敬宗","start_index":8,"tongjian_id":"bd36579d-db0e-11ef-b643-a0d3651f611f"},{"people_name":"安","people_name_jianti_auto":"安","start_index":19,"tongjian_id":"bd36579e-db0e-11ef-a236-a0d3651f611f"},{"people_name":"史","people_name_jianti_auto":"史","start_index":21,"tongjian_id":"bd36579f-db0e-11ef-9037-a0d3651f611f"},{"people_name":"遠","people_name_jianti_auto":"远","start_index":25,"tongjian_id":"bd3657a0-db0e-11ef-9939-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"永徽、顯慶之閒，許敬宗以姦佞致位公輔；安、史之亂，遠乃能效死節以報國，史故著其世以勉爲臣者。","note_content_jianti_auto":"永徽、显庆之闲，许敬宗以奸佞致位公辅；安、史之乱，远乃能效死节以报国，史故著其世以勉为臣者。","note_type":"hu_note","start_index":64,"tongjian_id":"bd36579c-db0e-11ef-85a9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"維州別駕","official_note":"別駕是州級副長官，協助刺史處理政務，在唐代地方行政體系中常見。此處董承晏擔任維州別駕，參與與吐蕃的密謀，顯示其在地方事務中的角色。","official_rank":"未知","source_snippet":"維州別駕董承晏結謀","start_index":18,"tongjian_id":"368a57fb-3a14-4956-81de-ed3a3f7e53eb"},{"confidence":0.95,"official_category":"监察","official_name":"監察御史","official_note":"監察御史是唐代御史台的官員，負責監察百官、巡按州縣，品秩較低但職權重要。此處許遠被任命為監察御史，率兵守衛安戎城，體現其在軍事行動中的監察和指揮作用。","official_rank":"正八品上","source_snippet":"使監察御史許遠將兵守之","start_index":40,"tongjian_id":"399ade70-2670-46b9-86de-45b45dae863d"}],"ExtRef_Children_people":[{"link_death_year":750,"link_td_description":"章仇兼琼，字兼琼，鲁郡任城县（今山东省济宁市任城区）人，唐玄宗时期的政治人物。曾于天宝初年担任剑南节度使。","link_td_id":"Q10015484","link_td_number_id":3499435,"people_name":"章仇兼瓊","people_name_jianti_auto":"章仇兼琼","people_xingming":"章仇兼琼","start_index":1,"tongjian_id":"bd3657a1-db0e-11ef-81d7-a0d3651f611f"},{"people_name":"翟都局","people_name_jianti_auto":"翟都局","people_xingming":"翟都局","start_index":13,"tongjian_id":"bd3657a2-db0e-11ef-98ed-a0d3651f611f"},{"people_name":"董承晏","people_name_jianti_auto":"董承晏","people_xingming":"董承晏","start_index":21,"tongjian_id":"bd3657a3-db0e-11ef-ac10-a0d3651f611f"},{"people_name":"局","people_name_jianti_auto":"局","people_xingming":"翟都局","start_index":28,"tongjian_id":"bd3657a4-db0e-11ef-bff8-a0d3651f611f"},{"link_birth_year":709,"link_death_year":757,"link_td_description":"许远，字令威，杭州盐官县（治所在今浙江省海宁市伊桥乡）人。唐朝地方官员。安史之乱时为睢阳郡太守，与张巡死守睢阳城而知名。城破被送至洛阳，后被杀害。与张巡并称“双忠”，在中国各地被广泛地奉祀为神，在闽南，泉州安溪人奉其为乡土保护神之一。","link_td_id":"Q10000797","link_td_number_id":316512,"people_name":"許遠","people_name_jianti_auto":"许远","people_xingming":"许远","start_index":48,"tongjian_id":"bd3657a5-db0e-11ef-9b94-a0d3651f611f"},{"link_birth_year":709,"link_death_year":757,"link_td_description":"许远，字令威，杭州盐官县（治所在今浙江省海宁市伊桥乡）人。唐朝地方官员。安史之乱时为睢阳郡太守，与张巡死守睢阳城而知名。城破被送至洛阳，后被杀害。与张巡并称“双忠”，在中国各地被广泛地奉祀为神，在闽南，泉州安溪人奉其为乡土保护神之一。","link_td_id":"Q10000797","link_td_number_id":316512,"people_name":"遠","people_name_jianti_auto":"远","people_xingming":"许远","start_index":55,"tongjian_id":"bd3657ab-db0e-11ef-bc48-a0d3651f611f"},{"link_birth_year":592,"link_death_year":672,"link_td_description":"许敬宗，字延族，杭州新城县（今浙江杭州市富阳区）人，祖籍高阳郡北新城县（今河北省保定市徐水区），唐朝官员，官至中书令（宰相）。","link_td_id":"Q10001350","link_td_number_id":505864,"people_name":"敬宗","people_name_jianti_auto":"敬宗","people_xingming":"许敬宗","start_index":57,"tongjian_id":"bd3657ac-db0e-11ef-8392-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"安戎城","place_name_jianti_auto":"安戎城","place_note":"四川省理县西","resolved_place_entity_id":2600,"start_index":7,"tongjian_id":"bd3657a6-db0e-11ef-8312-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":11,"tongjian_id":"bd3657a7-db0e-11ef-9f76-a0d3651f611f"},{"place_name":"維州","place_name_jianti_auto":"维州","place_note":"四川省理县","resolved_place_entity_id":1580,"start_index":17,"tongjian_id":"bd3657a8-db0e-11ef-8f06-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","resolved_place_entity_id":44,"start_index":33,"tongjian_id":"bd3657a9-db0e-11ef-b3b2-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":38,"tongjian_id":"bd3657aa-db0e-11ef-af6a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"至德初，改曰平戎城。《会要》：平戎城凭藉高深，玄宗以为其...","context_before":"...与松、茂、巂接。开元二十六年，剑南节度王昱攻之，为所败。","source_end_index":176,"source_paragraph_tongjian_id":"96e054d1-b4b2-5c4b-a347-cebce2facb34","source_start_index":135,"source_text":"二十八年，节度使章仇兼琼克而守之，未几，吐蕃围安戎城，不能陷，寻复寇安戎城及维州。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"4章仇兼瓊潛與安戎城中吐蕃翟都局及維州別駕董承晏結謀，使局開門引內唐兵，盡殺吐蕃將卒，使監察御史許遠將兵守之。遠，敬宗之曾孫也。","content_fanyi":"章仇兼琼在暗中与安戎城中的吐蕃将领翟都局、维州别驾董承晏合谋，让翟都局打开城门引导唐兵入城，把吐蕃将士全都杀死，并派监察御史许远率兵驻守该城。许远，是许敬宗的曾孙。","content_jianti_auto":"4章仇兼琼潜与安戎城中吐蕃翟都局及维州别驾董承晏结谋，使局开门引内唐兵，尽杀吐蕃将卒，使监察御史许远将兵守之。远，敬宗之曾孙也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21656,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"bd36579a-db0e-11ef-93fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"嘉運","people_name_jianti_auto":"嘉运","start_index":9,"tongjian_id":"bd388e44-db0e-11ef-a673-a0d3651f611f"},{"people_name":"懷道","people_name_jianti_auto":"怀道","start_index":13,"tongjian_id":"bd388e45-db0e-11ef-b043-a0d3651f611f"},{"people_name":"昕","people_name_jianti_auto":"昕","start_index":17,"tongjian_id":"bd388e46-db0e-11ef-a337-a0d3651f611f"},{"people_name":"莫賀達干","people_name_jianti_auto":"莫贺达干","start_index":26,"tongjian_id":"bd388e47-db0e-11ef-ae77-a0d3651f611f"},{"people_name":"蘇祿","people_name_jianti_auto":"苏禄","start_index":38,"tongjian_id":"bd388e48-db0e-11ef-b035-a0d3651f611f"},{"people_name":"史昕","people_name_jianti_auto":"史昕","start_index":50,"tongjian_id":"bd388e49-db0e-11ef-b8a9-a0d3651f611f"},{"people_name":"史昕","people_name_jianti_auto":"史昕","start_index":69,"tongjian_id":"bd388e4a-db0e-11ef-8b41-a0d3651f611f"},{"people_name":"莫賀達干","people_name_jianti_auto":"莫贺达干","start_index":74,"tongjian_id":"bd388e4b-db0e-11ef-b658-a0d3651f611f"},{"people_name":"嘉運","people_name_jianti_auto":"嘉运","start_index":86,"tongjian_id":"bd388e4c-db0e-11ef-a242-a0d3651f611f"},{"people_name":"吐火仙","people_name_jianti_auto":"吐火仙","start_index":96,"tongjian_id":"bd388e4d-db0e-11ef-aeb9-a0d3651f611f"},{"people_name":"斛瑟羅","people_name_jianti_auto":"斛瑟罗","start_index":115,"tongjian_id":"bd388e4e-db0e-11ef-af30-a0d3651f611f"},{"people_name":"懷道","people_name_jianti_auto":"怀道","start_index":121,"tongjian_id":"bd388e4f-db0e-11ef-b0ce-a0d3651f611f"},{"