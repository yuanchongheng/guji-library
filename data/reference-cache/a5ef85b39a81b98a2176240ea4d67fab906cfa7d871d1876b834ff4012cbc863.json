ace_name_jianti_auto":"罗","place_note":"湖北宜城","start_index":18,"tongjian_id":"bd388ea8-db0e-11ef-aa7b-a0d3651f611f"},{"place_name":"蒲騷","place_name_jianti_auto":"蒲骚","place_note":"湖北省应城市北","start_index":66,"tongjian_id":"bd388ea9-db0e-11ef-9a22-a0d3651f611f"},{"place_name":"羅","place_name_jianti_auto":"罗","start_index":97,"tongjian_id":"bd388eaa-db0e-11ef-8331-a0d3651f611f"},{"place_name":"羅","place_name_jianti_auto":"罗","start_index":99,"tongjian_id":"bd388eab-db0e-11ef-beb7-a0d3651f611f"},{"place_name":"盧戎","place_name_jianti_auto":"卢戎","start_index":101,"tongjian_id":"bd388eac-db0e-11ef-8ca0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：楚莫敖屈瑕旣敗鄖師於蒲騷，復伐羅。鬬伯比送之曰：「莫敖必敗；舉趾高，心不固矣。」遂見楚子，楚子入告夫人鄧曼。鄧曼曰：「莫敖忸於蒲騷之役，將自用也。君若不鎭撫，其不設備乎！」莫敖果不設備。及羅，羅與盧戎兩軍之，大敗之。忸，女九翻。陸德明曰：騷，音蕭，又音縿。卒，子恤翻。","note_content_jianti_auto":"左传：楚莫敖屈瑕既败郧师于蒲骚，复伐罗。鬬伯比送之曰：「莫敖必败；举趾高，心不固矣。」遂见楚子，楚子入告夫人邓曼。邓曼曰：「莫敖忸于蒲骚之役，将自用也。君若不镇抚，其不设备乎！」莫敖果不设备。及罗，罗与卢戎两军之，大败之。忸，女九翻。陆德明曰：骚，音萧，又音縿。卒，子恤翻。","note_type":"hu_note","start_index":96,"tongjian_id":"bd388e99-db0e-11ef-8cbb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蓋嘉運","people_name_jianti_auto":"盖嘉运","start_index":0,"tongjian_id":"bd388eb0-db0e-11ef-baeb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蓋嘉運小器易盈，志氣惰矣，安能有功！","note_content_jianti_auto":"盖嘉运小器易盈，志气惰矣，安能有功！","note_type":"hu_note","start_index":205,"tongjian_id":"bd388eaf-db0e-11ef-b8e5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"河西、隴右節度使","official_note":"河西、隴右節度使是唐代设立的军事官职，负责河西和陇右地区的军事防御和指挥，此处表示盖嘉运被任命此职以经略吐蕃。","official_rank":"未知","source_snippet":"以爲河西、隴右節度使","start_index":9,"tongjian_id":"df83cf1b-53ba-4aa6-ba62-758de3da33d5"},{"confidence":0.9,"official_category":"中枢机构","official_name":