i_auto":"嘉运","people_xingming":"盖嘉运","start_index":97,"tongjian_id":"bd388ebb-db0e-11ef-b1f3-a0d3651f611f"},{"link_td_description":"盖嘉运，唐朝军事将领，在西域期间撰有《西域记》，现已失传，部分被《唐会要》引用。","link_td_id":"Q10017846","link_td_number_id":5305708,"people_name":"嘉運","people_name_jianti_auto":"嘉运","people_xingming":"盖嘉运","start_index":193,"tongjian_id":"bd388ebc-db0e-11ef-82c6-a0d3651f611f"},{"link_td_description":"盖嘉运，唐朝军事将领，在西域期间撰有《西域记》，现已失传，部分被《唐会要》引用。","link_td_id":"Q10017846","link_td_number_id":5305708,"people_name":"嘉運","people_name_jianti_auto":"嘉运","people_xingming":"盖嘉运","start_index":199,"tongjian_id":"bd388ebd-db0e-11ef-990f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河西","place_name_jianti_auto":"河西","resolved_place_entity_id":214,"start_index":11,"tongjian_id":"bd388eb3-db0e-11ef-961d-a0d3651f611f"},{"place_name":"隴右","place_name_jianti_auto":"陇右","resolved_place_entity_id":313,"start_index":14,"tongjian_id":"bd388eb4-db0e-11ef-aad2-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":24,"tongjian_id":"bd388eb5-db0e-11ef-8c98-a0d3651f611f"},{"place_name":"蒲騷","place_name_jianti_auto":"蒲骚","place_note":"湖北省应城市北","resolved_place_entity_id":8989,"start_index":86,"tongjian_id":"bd388eb9-db0e-11ef-919b-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":93,"tongjian_id":"bd388eba-db0e-11ef-a126-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","军事"],"content":"7上嘉蓋嘉運之功，以爲河西、隴右節度使，使之經略吐蕃。嘉運恃恩流連，不時發。左丞相裴耀卿上疏，以爲：「臣近與嘉運同班，觀其舉措，誠勇烈有餘，然言氣矜誇，恐難成事。昔莫敖忸於蒲騷之役，卒喪楚師；今嘉運有驕敵之色，臣竊憂之。況防秋非遠，未言發日，若臨事始去，則士卒尚未相識，何以制敵！且將軍受命，鑿凶門而出；今乃酣飲朝夕，殆非憂國愛人之心。若不可改易，宜速遣進塗，仍乞聖恩嚴加訓勵。」上乃趣嘉運行。已而嘉運竟無功。","content_fanyi":"唐玄宗嘉许盖嘉运的功劳，任命他为河西、陇右节度使，派他经略吐蕃。盖嘉运仗恃恩宠，在京城滞留，不按期限出发。左丞相裴耀卿上疏，认为：“臣近来与盖嘉运同在朝班，观察他的行为举止，确实勇烈有余，但是说话口气骄矜夸张，恐怕难以成事。过去楚国的莫敖满足于蒲骚之役的胜利，最终让楚军覆败；如今盖嘉运露出骄傲轻敌的神色，臣私下很替他担忧。何况防秋已经不远，他却不说出发日期，如果事到临头才动身，士兵们还不认识他，凭什么去制服敌人！而且将军接受任命，应当凿凶门而出，以此表示必死的决心；如今竟夜以继日地酣饮，恐怕不是忧国爱民的心思。如果不能改变任命，就应该赶快派遣他上路赴任，并请圣上严加训诫勉励。”唐玄宗于是催促盖嘉运启行。后来盖嘉运终究没有建立功绩。","content_jianti_auto":"7上嘉盖嘉运之功，以为河西、陇右节度使，使之经略吐蕃。嘉运恃恩流连，不时发。左丞相裴耀卿上疏，以为：「臣近与嘉运同班，观其举措，诚勇烈有余，然言气矜夸，恐难成事。昔莫敖忸于蒲骚之役，卒丧楚师；今嘉运有骄敌之色，臣窃忧之。况防秋非远，未言发日，若临事始去，则士卒尚未相识，何以制敌！且将军受命，凿凶门而出；今乃酣饮朝夕，殆非忧国爱人之心。若不可改易，宜速遣进涂，仍乞圣恩严加训励。」上乃趣嘉运行。已而嘉运竟无功。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21659,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"bd388e94-db0e-11ef-90af-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"幽州","place_name_jianti_auto":"幽州","place_note":"总部设幽州【北京市】","resolved_place_entity_id":102,"start_index":9,"tongjian_id":"bd388ebf-db0e-11ef-b9a8-a0d3651f611f"},{"place_name":"奚","place_name_jianti_auto":"奚","place_note":"滦河上游","resolved_place_entity_id":401,"start_index":13,"tongjian_id":"bd388ec0-db0e-11ef-8036-a0d3651f611f"},{"place_name":"契丹","place_name_jianti_auto":"契丹","place_note":"辽河上游","resolved_place_entity_id":89,"start_index":15,"tongjian_id":"bd388ec1-db0e-11ef-b66e-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"唐攻契丹之战","tongjian_id":"war_N1001"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"8秋，八月，甲戌，幽州奏破奚、契丹。","content_fanyi":"秋季，八月二十日甲戌，幽州奏报击败奚、契丹。","content_jianti_auto":"8秋，八月，甲戌，幽州奏破奚、契丹。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21660,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"bd388ebe-db0e-11ef-bb5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"驪山","place_name_jianti_auto":"骊山","resolved_place_entity_id":616,"start_index":11,"tongjian_id":"bd3ad8d6-db0e-11ef-b19d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9冬，十月，甲子，上幸驪山溫泉；辛巳，還宮。","content_fanyi":"冬季，十月十一日甲子，玄宗前往骊山温泉；十月二十八日辛巳，返回宫中。","content_jianti_auto":"9冬，十月，甲子，上幸骊山温泉；辛巳，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21661,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"bd3ad8d5-db0e-11ef-bded-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bd3ad8d7-db0e-11ef-9b95-a0d3651f611f","pinyin":"guō","source_anchor_text":"州發關中彍騎救之吐","source_key":"baiyang_epub","start_index":15,"text":"彍","tongjian_id":"a20faa90-4f47-5083-9ab7-b3890562b215"}],"ExtRef_Children_places":[{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":2,"tongjian_id":"bd3ad8da-db0e-11ef-bd4e-a0d3651f611f"},{"place_name":"安戎城","place_name_jianti_auto":"安戎城","resolved_place_entity_id":2600,"start_index":5,"tongjian_id":"bd3ad8db-db0e-11ef-b31b-a0d3651f611f"},{"place_name":"維州","place_name_jianti_auto":"维州","place_note":"四川省理县","resolved_place_entity_id":1580,"start_index":9,"tongjian_id":"bd3ad8dc-db0e-11ef-ad42-a0d3651f611f"},{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":133,"start_index":13,"tongjian_id":"bd3ad8dd-db0e-11ef-affd-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":20,"tongjian_id":"bd3ad8de-db0e-11ef-8f5f-a0d3651f611f"},{"place_name":"安戎城","place_name_jianti_auto":"安戎城","resolved_place_entity_id":2600,"start_index":27,"tongjian_id":"bd3ad8df-db0e-11ef-80ce-a0d3651f611f"},{"place_name":"平戎","place_name_jianti_auto":"平戎","resolved_place_entity_id":4590,"start_index":31,"tongjian_id":"bd3ad8e0-db0e-11ef-9c75-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"至德初，改曰平戎城。《会要》：平戎城凭藉高深，玄宗以为其...","context_before":"...与松、茂、巂接。开元二十六年，剑南节度王昱攻之，为所败。","source_end_index":176,"source_paragraph_tongjian_id":"96e054d1-b4b2-5c4b-a347-cebce2facb34","source_start_index":135,"source_text":"二十八年，节度使章仇兼琼克而守之，未几，吐蕃围安戎城，不能陷，寻复寇安戎城及维州。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二十二、松潘卫（卷七十三）","excerpts":[{"context_after":"韦皋镇蜀，于西山南北，分道出师，翼州其必争之地也。明初，...","context_before":"所北瞰松潘，西控维州，制御生番，良为要地。","source_end_index":38,"source_paragraph_tongjian_id":"0ab14605-ad11-5875-848c-6198da52a703","source_start_index":21,"source_text":"唐之中叶，吐蕃据此，屡为西川之祸。"}],"path":"四川方舆纪要/二十二、松潘卫（卷七十三）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"10吐蕃寇安戎城及維州；發關中彍騎救之，吐蕃引去。更命安戎城曰平戎。","content_fanyi":"吐蕃进犯安戎城和维州；朝廷征发关中的彍骑前往救援，吐蕃于是撤兵离去。将安戎城改名为平戎城。","content_jianti_auto":"10吐蕃寇安戎城及维州；发关中彍骑救之，吐蕃引去。更命安戎城曰平戎。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21662,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"bd3ad8d7-db0e-11ef-9b95-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":675,"link_death_year":742,"link_td_description":"牛仙客，唐代泾州鹑觚（今甘肃灵台）人。","link_td_id":"Q10010087","link_td_number_id":951087,"people_name":"牛仙客","people_name_jianti_auto":"牛仙客","people_xingming":"牛仙客","start_index":7,"tongjian_id":"bd3ad8e2-db0e-11ef-af7e-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"朔方","place_name_jianti_auto":"朔方","place_note":"总部设灵州【宁夏灵武】","resolved_place_entity_id":219,"start_index":10,"tongjian_id":"bd3ad8e3-db0e-11ef-b902-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","place_note":"总部设太原府【山西太原】","resolved_place_entity_id":129,"start_index":13,"tongjian_id":"bd3ad8e4-db0e-11ef-8fd5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"11十一月，罷牛仙客朔方、河東節度使。","content_fanyi":"十一月，免去牛仙客所兼任的朔方、河东节度使职务。","content_jianti_auto":"11十一月，罢牛仙客朔方、河东节度使。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21663,"number":11,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"bd3ad8e1-db0e-11ef-a25b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":744,"link_td_description":"莫贺达干，突骑施黄姓的首领。","link_td_id":"Q10011508","link_td_number_id":1266878,"people_name":"莫賀達干","people_name_jianti_auto":"莫贺达干","start_index":5,"tongjian_id":"bd3ad8e7-db0e-11ef-95f6-a0d3651f611f"},{"people_name":"阿史那昕","people_name_jianti_auto":"阿史那昕","people_xingming":"阿史那昕","start_index":10,"tongjian_id":"bd3ad8e8-db0e-11ef-a7fa-a0d3651f611f"},{"link_death_year":738,"link_td_description":"苏禄可汗，8世纪突厥别部突骑施的可汗，突骑施汗国第三任君主。","link_td_id":"Q10011496","link_td_number_id":1267317,"people_name":"蘇祿","people_name_jianti_auto":"苏禄","people_xingming":"苏禄","start_index":24,"tongjian_id":"bd3ad8e9-db0e-11ef-9daa-a0d3651f611f"},{"people_name":"史昕","people_name_jianti_auto":"史昕","people_xingming":"阿史那昕","start_index":34,"tongjian_id":"bd3ad8ea-db0e-11ef-a4cf-a0d3651f611f"},{"link_death_year":744,"link_td_description":"莫贺达干，突骑施黄姓的首领。","link_td_id":"Q10011508","link_td_number_id":1266878,"people_name":"莫賀達干","people_name_jianti_auto":"莫贺达干","people_xingming":"莫贺达干","start_index":52,"tongjian_id":"bd3ad8eb-db0e-11ef-a266-a0d3651f611f"},{"link_td_description":"盖嘉运，唐朝军事将领，在西域期间撰有《西域记》，现已失传，部分被《唐会要》引用。","link_td_id":"Q10017846","link_td_number_id":5305708,"people_name":"蓋嘉運","people_name_jianti_auto":"盖嘉运","people_xingming":"盖嘉运","start_index":69,"tongjian_id":"bd3ad8ec-db0e-11ef-af7d-a0d3651f611f"},{"link_death_year":744,"link_td_description":"莫贺达干，突骑施黄姓的首领。","link_td_id":"Q10011508","link_td_number_id":1266878,"people_name":"莫賀達干","people_name_jianti_auto":"莫贺达干","people_xingming":"莫贺达干","start_index":83,"tongjian_id":"bd3ad8ed-db0e-11ef-bd8d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"突騎施","place_name_jianti_auto":"突骑施","place_note":"伊犁河中下游","resolved_place_entity_id":912,"start_index":2,"tongjian_id":"bd3ad8ee-db0e-11ef-a4f2-a0d3651f611f"},{"place_name":"突騎施","place_name_jianti_auto":"突骑施","resolved_place_entity_id":912,"start_index":62,"tongjian_id":"bd3ad8ef-db0e-11ef-9d50-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"天宝三载，河西节度使夫蒙灵詧讨斩之，更立黑姓酋长骨咄禄毗...","context_before":"...仙可汗，据碎叶城。又别部长黑姓可汗尔微特勒，据怛罗斯城。","source_end_index":218,"source_paragraph_tongjian_id":"6529d176-8f61-5411-a344-d9a82f8e5ad8","source_start_index":183,"source_text":"二十九年，碛西节度使盖嘉运袭击吐火仙等，擒之，别部酋莫贺达干，据其地。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"天宝初复叛，杀十姓可汗阿史那昕于俱阑城，安西节度使夫蒙灵...","context_before":"...二百六十里，东南与鄯善、且末接界。○俱阑城，在碎叶西南。","source_end_index":82,"source_paragraph_tongjian_id":"0d3398f8-5a72-5b3b-85d9-bd3d17a83aa1","source_start_index":57,"source_text":"唐开元二十六年，突骑施酋长莫贺达干作乱，既而来归。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"12突騎施莫賀達干聞阿史那昕爲可汗，怒曰：「首誅蘇祿，我之謀也；今立史昕，何以賞我！」遂帥諸部叛。上乃立莫賀達干爲可汗，使統突騎施之衆；命蓋嘉運招諭之。十二月，乙卯，莫賀達干降。","content_fanyi":"突骑施酋长莫贺达干得知唐朝册立阿史那昕为十姓可汗，愤怒地说：“最先诛杀苏禄可汗，本是我的计谋；如今却立阿史那昕为可汗，拿什么来封赏我！”于是率领各部落反叛。唐玄宗便册立莫贺达干为可汗，让他统率突骑施部众，并命盖嘉运招抚晓谕他。十二月初三日乙卯，莫贺达干投降。","content_jianti_auto":"12突骑施莫贺达干闻阿史那昕为可汗，怒曰：「首诛苏禄，我之谋也；今立史昕，何以赏我！」遂帅诸部叛。上乃立莫贺达干为可汗，使统突骑施之众；命盖嘉运招谕之。十二月，乙卯，莫贺达干降。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21664,"number":12,"reading_annotation_sources":[],"start_index":11,"tongjian_id":"bd3ad8e5-db0e-11ef-8380-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"金城公主","people_name_jianti_auto":"金城公主","start_index":0,"tongjian_id":"bd3ad8f2-db0e-11ef-95cb-a0d3651f611f"},{"people_name":"中宗","people_name_jianti_auto":"中宗","start_index":10,"tongjian_id":"bd3ad8f3-db0e-11ef-aad1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"金城公主事始二百八卷中宗景龍元年。","note_content_jianti_auto":"金城公主事始二百八卷中宗景龙元年。","note_type":"hu_note","start_index":8,"tongjian_id":"bd3ad8f1-db0e-11ef-a6f9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":698,"link_death_year":739,"link_td_description":"金城公主，唐宗女，和亲公主之一。生父为嗣雍王李守礼，养父为叔祖唐中宗。步曾祖姑文成公主之后尘和亲吐蕃，嫁赞普赤德祖赞（即尺带珠丹）。金城公主在吐蕃三十年，为唐蕃称为甥舅宿亲，“和同为一家”维系纽带，贡献匪浅。","link_td_id":"Q10009195","link_td_number_id":550768,"people_name":"金城公主","people_name_jianti_auto":"金城公主","people_xingming":"金城公主","start_index":2,"tongjian_id":"bd3ad8f4-db0e-11ef-8435-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":8,"tongjian_id":"bd3ad8f5-db0e-11ef-a725-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"13金城公主薨；吐蕃告喪，且請和，上不許。","content_fanyi":"金城公主去世；吐蕃派使者前来报丧，并请求和解，玄宗没有应允。","content_jianti_auto":"13金城公主薨；吐蕃告丧，且请和，上不许。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21665,"number":13,"reading_annotation_sources":[],"start_index":12,"tongjian_id":"bd3ad8f0-db0e-11ef-bdcb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":13,"tongjian_id":"bd3ad8f8-db0e-11ef-b793-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":18,"tongjian_id":"bd3ad8f9-db0e-11ef-b69b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以開元之承平，而戶口猶不及漢之盛時，唐興以來，治日少而亂日多也。","note_content_jianti_auto":"以开元之承平，而户口犹不及汉之盛时，唐兴以来，治日少而乱日多也。","note_type":"hu_note","start_index":80,"tongjian_id":"bd3ad8f7-db0e-11ef-aa81-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西京","place_name_jianti_auto":"西京","resolved_place_entity_id":454,"start_index":45,"tongjian_id":"bd3ad8fa-db0e-11ef-9cc9-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","resolved_place_entity_id":54,"start_index":48,"tongjian_id":"bd3ad8fb-db0e-11ef-8351-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"14是歲，天下縣千五百七十三，戶八百四十一萬二千八百七十一，口四千八百一十四萬三千六百九。西京、東都米斛直錢不滿二百，絹匹亦如之。海內富安，行者雖萬里不持寸兵。","content_fanyi":"这一年，全国共有一千五百七十三个县，八百四十一万二千八百七十一户，四千八百一十四万三千六百零九人。西京、东都每斛米的价格不到二百钱，每匹绢的价钱也是如此。海内富庶安宁，行路之人即使远行万里，也不携带任何兵器。","content_jianti_auto":"14是岁，天下县千五百七十三，户八百四十一万二千八百七十一，口四千八百一十四万三千六百九。西京、东都米斛直钱不满二百，绢匹亦如之。海内富安，行者虽万里不持寸兵。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21666,"number":14,"reading_annotation_sources":[],"start_index":13,"tongjian_id":"bd3ad8f6-db0e-11ef-ab6c-a0d3651f611f"}],"reign_name":"二十八年","reign_name_jianti_auto":"二十八年","start_index":6,"tongjian_id":"bd36578e-db0e-11ef-a36e-a0d3651f611f","year_anno":"（庚寅、七四○）","year_int":740},"message":"success","success":true}