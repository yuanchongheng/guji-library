db0e-11ef-9409-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"周承休侯","official_note":"周承休侯是汉朝封爵，用于尊崇周朝后裔，此处表示周子南君被改封为周承休侯，以体现对周朝宗室的优待。","official_rank":"侯爵","source_snippet":"以周子南君爲周承休侯","start_index":8,"tongjian_id":"27b0db09-be73-43e4-b229-9d40c1c67876"}],"ExtRef_Children_people":[{"link_death_year":-36,"link_td_description":"姬延年，周子南君姬嘉之孙，姬置之子，姬当之弟。西汉元康元年（前65年）三月丙戌，姬延年以姬当弟弟的身份延续周子南君的世袭，初元五年（前44年）正月癸巳，姬延年被改封为周承休侯，地位次于诸侯王。前36年，姬延年去世，谥号为考。","link_td_id":"Q10013923","link_td_number_id":1660461,"people_name":"周子南君","people_name_jianti_auto":"周子南君","people_xingming":"姬延","start_index":7,"tongjian_id":"91590385-db0e-11ef-a3ae-a0d3651f611f"},{"link_death_year":-36,"link_td_description":"姬延年，周子南君姬嘉之孙，姬置之子，姬当之弟。西汉元康元年（前65年）三月丙戌，姬延年以姬当弟弟的身份延续周子南君的世袭，初元五年（前44年）正月癸巳，姬延年被改封为周承休侯，地位次于诸侯王。前36年，姬延年去世，谥号为考。","link_td_id":"Q10013923","link_td_number_id":1660461,"people_name":"周承休侯","people_name_jianti_auto":"周承休侯","people_xingming":"姬延","start_index":12,"tongjian_id":"91590386-db0e-11ef-809a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，正月，以周子南君爲周承休侯。","content_fanyi":"春季，正月，汉元帝册封周子南君为周承休侯。","content_jianti_auto":"1春，正月，以周子南君为周承休侯。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2224,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9159037b-db0e-11ef-950b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","