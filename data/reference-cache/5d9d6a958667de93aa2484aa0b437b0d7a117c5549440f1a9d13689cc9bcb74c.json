[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"烏孫國","place_name_jianti_auto":"乌孙国","start_index":4,"tongjian_id":"915903f9-db0e-11ef-a631-a0d3651f611f"},{"place_name":"赤谷城","place_name_jianti_auto":"赤谷城","start_index":9,"tongjian_id":"915903fa-db0e-11ef-bce0-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","start_index":15,"tongjian_id":"915903fb-db0e-11ef-aadd-a0d3651f611f"},{"place_name":"赤谷","place_name_jianti_auto":"赤谷","start_index":34,"tongjian_id":"915903fc-db0e-11ef-b1a1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西域傳：烏孫國，治赤谷城，西至康居蕃地五千里。若云空虛者五千里，則自赤谷以西皆不居矣。此已抵其國都，不得云西邊也。陳湯傳作「且千里」，當從之。","note_content_jianti_auto":"西域传：乌孙国，治赤谷城，西至康居蕃地五千里。若云空虚者五千里，则自赤谷以西皆不居矣。此已抵其国都，不得云西边也。陈汤传作「且千里」，当从之。","note_type":"hu_note","start_index":522,"tongjian_id":"915903f8-db0e-11ef-b852-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"衞司馬","official_note":"衞司馬是漢代軍職，隸屬於衞尉，負責宮廷警衛或邊防事務。在《資治通鑑》此段中，漢朝商議派遣衞司馬谷吉護送匈奴侍子，顯示其作為軍事官員執行外交任務的角色。","official_rank":"未知","source_snippet":"漢議遣衞司馬谷吉送之","start_index":48,"tongjian_id":"fe1a6c59-9d21-4ef4-9838-503a786713dc"},{"confidence":0.95,"official_category":"監察","official_name":"御史大夫","official_note":"御史大夫是漢代三公之一，主管監察百官，位高權重。在《資治通鑑》此段中，御史大夫貢禹參與討論是否護送匈奴侍子，體現其作為高級官員在國家決策中的作用。","official_rank":"正三品","source_snippet":"御史大夫貢禹、博士東海匡衡以爲","start_index":56,"tongjian_id":"8132b74b-6374-4a23-a385-44962b5fb02a"},{"confidence":0.9,"official_category":"文教","official_name":"博士","official_note":"博士是漢代學官，負責經學研究和教育，有時也參與政事諮詢。在《資治通鑑》此段中，博士匡衡與御史大夫貢禹一同發表意見，顯示其作為文教官員在國家事務中的參與。","official_rank":"未知","source_snippet":"御史大夫貢禹、博士東海匡衡以爲","start_index":62,"tongjian_id":"d3bcbd9b-4fd2-4b93-afb9-6769b22b9ca5"}],"ExtRef_Children_people":[{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_nu