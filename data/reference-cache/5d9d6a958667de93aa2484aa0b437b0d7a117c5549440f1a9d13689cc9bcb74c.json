"915b6525-db0e-11ef-a356-a0d3651f611f"},{"place_name":"堅昆","place_name_jianti_auto":"坚昆","resolved_place_entity_id":2392,"start_index":388,"tongjian_id":"915b6526-db0e-11ef-b8c9-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":403,"tongjian_id":"915b6528-db0e-11ef-a321-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","resolved_place_entity_id":771,"start_index":407,"tongjian_id":"915b6529-db0e-11ef-8b36-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","resolved_place_entity_id":771,"start_index":440,"tongjian_id":"915b652f-db0e-11ef-96c7-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","resolved_place_entity_id":771,"start_index":462,"tongjian_id":"915b6532-db0e-11ef-afe5-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":485,"tongjian_id":"915b6533-db0e-11ef-8d43-a0d3651f611f"},{"place_name":"赤谷城","place_name_jianti_auto":"赤谷城","resolved_place_entity_id":3426,"start_index":491,"tongjian_id":"915b6534-db0e-11ef-825d-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":505,"tongjian_id":"915b6535-db0e-11ef-be4c-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"郅支之战","tongjian_id":"war_N0588"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"梁绍泰初，突厥强盛，北并契骨，即坚昆矣。唐初曰结骨，亦曰...","context_before":"...之坚昆。《汉纪》：坚昆东去单于庭七千里，南至车师五千里。","source_end_index":80,"source_paragraph_tongjian_id":"f32cbbc8-db6d-5dff-9f5f-6e5dfbfaf132","source_start_index":44,"source_text":"黄龙元年，郅支单于西击乌孙，因北并坚昆，留都之。其后西徙，坚昆复有其地。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"建昭二年，西域副校尉陈汤与都护甘延寿谋曰：郅支侵凌乌孙、...","context_before":"郅支城[在康居东。","source_end_index":65,"source_paragraph_tongjian_id":"241cc0ab-a65c-5237-80e2-74897ebce4f2","source_start_index":9,"source_text":"汉初元中，康居为乌孙所困，乃迎郅支单于于坚昆，欲与合兵击乌孙。郅支遂西至康居，叛汉，侵击乌孙，发康居民筑城居之。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"6匈奴郅支單于自以道遠，又怨漢擁護呼韓邪而不助己，困辱漢使者江乃始等；遣使奉獻，因求侍子。漢議遣衞司馬谷吉送之，御史大夫貢禹、博士東海匡衡以爲：「郅支單于鄕化未醇，所在絕遠，宜令使者送其子，至塞而還。」吉上書言：「中國與夷狄有羈縻不絕之義，今旣養全其子十年，德澤甚厚，空絕而不送，近從塞還，示棄捐不畜，使無鄕從之心，棄前恩，立後怨，不便！議者見前江乃始無應敵之數，智勇俱困，以致恥辱，卽豫爲臣憂。臣幸得建強漢之節，承明聖之詔，宣諭厚恩，不宜敢桀。若懷禽獸心，加無道於臣，則單于長嬰大罪，必遁逃遠舍，不敢近邊。沒一使以安百姓，國之計，臣之願也。願送至庭。」上許焉。旣至，郅支單于怒，竟殺吉等；自知負漢，又聞呼韓邪益強，恐見襲擊，欲遠去。會康居王數爲烏孫所困，與諸翕侯計，以爲：「匈奴大國，烏孫素服屬之。今郅支單于困阨在外，可迎置東邊，使合兵取烏孫而立之，長無匈奴憂矣。」卽使使至堅昆，通語郅支。郅支素恐，又怨烏孫，聞康居計，大說，遂與相結，引兵而西。郅支人衆中寒道死，餘財三千人。到康居，康居王以女妻郅支；郅支亦以女予康居王。康居甚尊敬郅支，欲倚其威以脅諸國。郅支數借兵擊烏孫，深入至赤谷城，殺略民人，敺畜產去。烏孫不敢追，西邊空虛不居者五千里。","content_fanyi":"匈奴郅支单于呼屠吾斯自认为距汉朝道路遥远，又怨恨汉朝拥戴呼韩邪单于稽侯珊而不帮助自己，便困辱汉朝使者江乃始等人；又派遣使者到汉朝进贡，并借机请求送回入侍汉朝的儿子栾提驹于利受。汉朝商议派卫司马谷吉护送他回去，御史大夫贡禹、博士东海人匡衡认为：“郅支单于归附汉朝的心意还不真诚，其地又极其遥远，应让使者送他的儿子到边塞就返回。”谷吉上书说：“汉朝与夷狄之间有笼络而不断绝关系的道理。如今已经养育并保全他的儿子十年，恩德十分深厚；如果因为路途荒远隔绝就不继续护送到地，只送到近处边塞就返回，那就等于表示抛弃不再养恤他们，会使他们失去归附之心，丢掉了先前的恩德，结下日后的怨恨，很不妥当！那些提议不远送的人看到先前江乃始没有应对敌人的办法，智谋和勇气都施展不开，以致遭受耻辱，便预先替臣担忧。臣有幸充当强大汉朝的使节，承接圣明诏书，宣扬晓谕皇上深厚的恩德，郅支单于当不敢逞强施暴。如果他怀有禽兽之心，对臣横加无道之举，那么单于就会长期背负大罪，一定畏罪远逃，不敢靠近汉朝边界。牺牲一个使者而使百姓安宁，是国家的利益所在，也是臣的愿望。臣愿把他送到单于王庭。”汉元帝准许了他的请求。谷吉把栾提驹于利受送到匈奴王庭后，郅支单于发怒，竟杀死谷吉等人；他自知有负汉朝，又听说呼韩邪单于日益强大，恐怕遭到袭击，想远走他方。恰逢康居王屡次受到乌孙侵扰，便与各位翕侯商议，认为：“匈奴是大国，乌孙一向臣属于它。如今郅支单于在境外困窘，可以把他迎接到我国东部边境安置，联合他的兵力攻取乌孙，让他在乌孙立国，这样就可长久没有匈奴的忧患了。”于是派使者到坚昆，向郅支单于通报此意。郅支单于一向畏惧乌孙，又怨恨乌孙，听到康居王的计策，大为高兴，便与康居王相互结交，领兵向西而去。郅支的人马因途中遭遇严寒，有很多死在路上，最后只剩三千人。到达康居后，康居王把女儿嫁给郅支单于为妻，郅支单于也把女儿嫁给康居王。康居王很敬重郅支单于，想借助他的声威来胁迫各国。郅支单于多次借康居兵攻打乌孙，深入到乌孙的赤谷城，杀害掳掠乌孙百姓，驱赶牲畜财物离去。乌孙不敢追赶，西部边境空虚无人居住的地方达五千里。","content_jianti_auto":"6匈奴郅支单于自以道远，又怨汉拥护呼韩邪而不助己，困辱汉使者江乃始等；遣使奉献，因求侍子。汉议遣衞司马谷吉送之，御史大夫贡禹、博士东海匡衡以为：「郅支单于鄕化未醇，所在绝远，宜令使者送其子，至塞而还。」吉上书言：「中国与夷狄有羁縻不绝之义，今既养全其子十年，德泽甚厚，空绝而不送，近从塞还，示弃捐不畜，使无鄕从之心，弃前恩，立后怨，不便！议者见前江乃始无应敌之数，智勇俱困，以致耻辱，即豫为臣忧。臣幸得建强汉之节，承明圣之诏，宣谕厚恩，不宜敢桀。若怀禽兽心，加无道于臣，则单于长婴大罪，必遁逃远舍，不敢近边。没一使以安百姓，国之计，臣之愿也。愿送至庭。」上许焉。既至，郅支单于怒，竟杀吉等；自知负汉，又闻呼韩邪益强，恐见袭击，欲远去。会康居王数为乌孙所困，与诸翕侯计，以为：「匈奴大国，乌孙素服属之。今郅支单于困阨在外，可迎置东边，使合兵取乌孙而立之，长无匈奴忧矣。」即使使至坚昆，通语郅支。郅支素恐，又怨乌孙，闻康居计，大说，遂与相结，引兵而西。郅支人众中寒道死，余财三千人。到康居，康居王以女妻郅支；郅支亦以女予康居王。康居甚尊敬郅支，欲倚其威以胁诸国。郅支数借兵击乌孙，深入至赤谷城，杀略民人，敺畜产去。乌孙不敢追，西边空虚不居者五千里。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2229,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"915903c3-db0e-11ef-b273-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷事务","official_name":"長信少府","official_note":"長信少府是汉代官职，负责管理长信宫（皇太后居所）的日常事务，属于宫廷内官。在《资治通鉴》此段中，薛廣德由長信少府升任御史大夫，反映了官职变动。","official_rank":"九卿级别","source_snippet":"長信少府薛廣德","start_index":18,"tongjian_id":"4b3f013c-5d20-45f1-a453-88f8d1f4d586"},{"confidence":0.95,"official_category":"监察与行政","official_name":"御史大夫","official_note":"御史大夫是汉代三公之一，负责监察百官、掌管文书，地位仅次于丞相。在《资治通鉴》此段中，薛廣德被任命为御史大夫，是重要的官职晋升。","official_rank":"三公级别","source_snippet":"爲御史大夫","start_index":24,"tongjian_id":"bf86a592-ec25-4669-9929-aad274df00c9"}],"ExtRef_Children_people":[{"link_birth_year":-124,"link_death_year":-44,"link_td_description":"贡禹，西汉中期大臣。字少翁，琅琊郡（今山东诸城）人。他在汉宣帝时，任谏大夫。他多次上书汉元帝，针对朝廷腐败、贵族奢侈、郡县人民贫困，建议皇帝选贤任能、诛杀奸臣，重视节俭、减轻徭役。初元五年（前44年）六月，代陈万年为御史大夫，十二月去世，薛广德继任。","link_td_id":"Q10013054","link_td_number_id":1551696,"people_name":"貢禹","people_name_jianti_auto":"贡禹","people_xingming":"贡禹","start_index":10,"tongjian_id":"915b6537-db0e-11ef-8b32-a0d3651f611f"},{"link_td_description":"薛广德，字长卿，为西汉沛郡相县（今安徽省濉溪县西北）人，其历任博士、谏大夫、长信少府等职，最终官至御史大夫，位列三公。","link_td_id":"Q10015382","link_td_number_id":3457117,"people_name":"薛廣德","people_name_jianti_auto":"薛广德","people_xingming":"薛广德","start_index":21,"tongjian_id":"915b6538-db0e-11ef-9f60-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長信","place_name_jianti_auto":"长信","resolved_place_entity_id":1961,"start_index":17,"tongjian_id":"915b6539-db0e-11ef-bc6f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/匡衡守正","excerpts":[{"context_after":"后乃下诏先罢郡国庙，其亲尽寝园，皆无复修。已而上寝疾，梦...","context_before":"","source_end_index":49,"source_paragraph_tongjian_id":"1d741831-296a-4273-b6fa-0d7aa7f147b5","source_start_index":0,"source_text":"汉元帝时，贡禹奏言：天子七庙，亲尽之庙宜毁，及郡国庙不应古礼，宜正定。天子下其议，未及施行而禹卒。"}],"path":"四笔/卷一/匡衡守正","source_name":"容斋随笔"}],"class_tags":["人事"],"content":"7冬，十二月，丁未，貢禹卒。丁巳，長信少府薛廣德爲御史大夫。","content_fanyi":"冬季，十二月初九日丁未，御史大夫贡禹去世。十二月十九日丁巳，长信少府薛广德升任御史大夫。","content_jianti_auto":"7冬，十二月，丁未，贡禹卒。丁巳，长信少府薛广德为御史大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2230,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"915b6536-db0e-11ef-ab67-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":4,"tongjian_id":"9158e199-db0e-11ef-8a7e-a0d3651f611f","year_anno":"（丁丑、前四四）","year_int":-44},"message":"success","success":true}