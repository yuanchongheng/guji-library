art_index":135,"tongjian_id":"95dbef29-db0e-11ef-b43d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按范書，板楯蠻夷者，秦昭襄王時射殺白虎有功，昭王復夷人頃田不租，十妻不算，傷人者論，殺人者得以倓錢贖死。高祖爲漢王，發夷人以定三秦，復其渠帥七姓不輸租賦，餘戶乃歲入賨錢，口四十。世號爲板楯蠻夷。閬中有渝水，其人多居水左右，天性勁勇，數陷陳，喜歌舞，高祖爲制巴渝舞。蠻蓋挾板楯而戰，因以爲名。楯，食尹翻。倓，徒濫翻。賨，藏宗翻。","note_content_jianti_auto":"按范书，板楯蛮夷者，秦昭襄王时射杀白虎有功，昭王复夷人顷田不租，十妻不算，伤人者论，杀人者得以倓钱赎死。高祖为汉王，发夷人以定三秦，复其渠帅七姓不输租赋，余户乃岁入賨钱，口四十。世号为板楯蛮夷。阆中有渝水，其人多居水左右，天性劲勇，数陷陈，喜歌舞，高祖为制巴渝舞。蛮盖挟板楯而战，因以为名。楯，食尹翻。倓，徒滥翻。賨，藏宗翻。","note_type":"hu_note","start_index":25,"tongjian_id":"95dbef19-db0e-11ef-b661-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百官志：郡有五官掾，署功曹及諸曹事。掾，俞絹翻。","note_content_jianti_auto":"百官志：郡有五官掾，署功曹及诸曹事。掾，俞绢翻。","note_type":"hu_note","start_index":42,"tongjian_id":"95dbef2c-db0e-11ef-867a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"枹罕縣","place_name_jianti_auto":"枹罕县","start_index":0,"tongjian_id":"95dbef30-db0e-11ef-bbb0-a0d3651f611f"},{"place_name":"隴西郡","place_name_jianti_auto":"陇西郡","start_index":5,"tongjian_id":"95dbef31-db0e-11ef-ab76-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":9,"tongjian_id":"95dbef32-db0e-11ef-93d2-a0d3651f611f"},{"place_name":"河州","place_name_jianti_auto":"河州","start_index":11,"tongjian_id":"95dbef33-db0e-11ef-852d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"枹罕縣，屬隴西郡，唐之河州。枹，音膚。","note_content_jianti_auto":"枹罕县，属陇西郡，唐之河州。枹，音肤。","note_type":"hu_note","start_index":70,"tongjian_id":"95dbef2f-db0e-11ef-96d4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"五官掾","official_note":"五官掾是漢代郡守的屬官，負責協助處理郡內事務，如文書、刑獄等。在《資治通鑑》此段中，程信擔任漢中郡的五官掾，率領郡兵與板楯蠻共同擊敗羌豪號多，顯示其在地方軍事行動中的指揮角色。此信息基於漢代官制常識。","official_rank":"未知","source_snippet":"漢中五官掾程信率郡兵與蠻共擊破之","start_index":28,"tongjian_id":"25ed9bc6-9aae-40c1-8d9b-18c972632bdf"}],"ExtRef_Children_people":[{"people_name":"號多","people_name_jianti_auto":"号多","people_xingming":"号多","start_index":4,"tongjian_id":"95dbef34-db0e-11ef-93c6-a0d3651f611f"},{"people_name":"程信","people_name_jianti_auto":"程信","people_xingming":"程信","start_index":30,"tongjian_id":"95dbef3a-db0e-11ef-b0c4-a0d3651f611f"},{"people_name":"號多","people_name_jianti_auto":"号多","start_index":42,"tongjian_id":"95dbef3c-db0e-11ef-8aa0-a0d3651f611f"},{"link_death_year":117,"link_td_description":"零昌，东汉时西羌首领，先零羌别种滇零的儿子。","link_td_id":"Q10011564","link_td_number_id":1279738,"people_name":"零昌","people_name_jianti_auto":"零昌","people_xingming":"零昌","start_index":52,"tongjian_id":"95dbef3d-db0e-11ef-907d-a0d3651f611f"},{"link_death_year":37,"link_td_description":"侯霸，字君房，河南郡密县（今河南省新密市东南）人，东汉初年大臣。","link_td_id":"Q10007205","link_td_number_id":1549261,"people_name":"侯霸","people_name_jianti_auto":"侯霸","people_xingming":"侯霸","start_index":56,"tongjian_id":"95dbef3f-db0e-11ef-93af-a0d3651f611f"},{"link_death_year":141,"link_td_description":"马贤，东汉将领、官员。马贤初任骑都尉，后历任护羌校尉、弘农太守、征西将军。马贤在担任护羌校尉期间，多次击败羌人各部落，为陇右、凉州地区安定巨大贡献。","link_td_id":"Q10016947","link_td_number_id":4472671,"people_name":"馬賢","people_name_jianti_auto":"马贤","people_xingming":"马贤","start_index":59,"tongjian_id":"95dbef40-db0e-11ef-bdd0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":2,"tongjian_id":"95dbef35-db0e-11ef-802c-a0d3651f611f"},{"place_name":"武都","place_name_jianti_auto":"武都","resolved_place_entity_id":783,"start_index":11,"tongjian_id":"95dbef36-db0e-11ef-b25e-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"s