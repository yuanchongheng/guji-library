{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙亥、前一○六）","note_content_jianti_auto":"（乙亥、前一○六）","note_type":"hu_note","start_index":0,"tongjian_id":"902e8380-db0e-11ef-912f-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":0,"tongjian_id":"902e8383-db0e-11ef-995e-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":22,"tongjian_id":"902e8384-db0e-11ef-b8b5-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":53,"tongjian_id":"902e8385-db0e-11ef-9f84-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"廬江","place_name_jianti_auto":"庐江","start_index":14,"tongjian_id":"902e8386-db0e-11ef-b3a4-a0d3651f611f"},{"place_name":"南郡","place_name_jianti_auto":"南郡","start_index":27,"tongjian_id":"902e8387-db0e-11ef-9687-a0d3651f611f"},{"place_name":"壽州","place_name_jianti_auto":"寿州","start_index":38,"tongjian_id":"902e8388-db0e-11ef-b371-a0d3651f611f"},{"place_name":"盛唐縣","place_name_jianti_auto":"盛唐县","start_index":41,"tongjian_id":"902e8389-db0e-11ef-ba2e-a0d3651f611f"},{"place_name":"壽州","place_name_jianti_auto":"寿州","start_index":57,"tongjian_id":"902e838a-db0e-11ef-ad7e-a0d3651f611f"},{"place_name":"六安縣","place_name_jianti_auto":"六安县","start_index":59,"tongjian_id":"902e838b-db0e-11ef-b6fe-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":63,"tongjian_id":"902e838c-db0e-11ef-a078-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":69,"tongjian_id":"902e838d-db0e-11ef-8d91-a0d3651f611f"},{"place_name":"盛唐縣","place_name_jianti_auto":"盛唐县","start_index":71,"tongjian_id":"902e838e-db0e-11ef-aa25-a0d3651f611f"},{"place_name":"盛唐山","place_name_jianti_auto":"盛唐山","start_index":80,"tongjian_id":"902e838f-db0e-11ef-b786-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文穎曰：按地理志不得，疑當在廬江左右，縣名。韋昭曰：在南郡。余據唐·地理志，壽州有盛唐縣，蓋以古地名名縣。宋白曰：壽州六安縣，楚之潛也，在漢爲盛唐縣，西十五里有盛唐山。","note_content_jianti_auto":"文颖曰：按地理志不得，疑当在庐江左右，县名。韦昭曰：在南郡。余据唐·地理志，寿州有盛唐县，盖以古地名名县。宋白曰：寿州六安县，楚之潜也，在汉为盛唐县，西十五里有盛唐山。","note_type":"hu_note","start_index":13,"tongjian_id":"902e8382-db0e-11ef-bd74-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"舜","people_name_jianti_auto":"舜","start_index":38,"tongjian_id":"902e8393-db0e-11ef-b5d0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"九疑山","place_name_jianti_auto":"九疑山","start_index":4,"tongjian_id":"902e8394-db0e-11ef-8833-a0d3651f611f"},{"place_name":"零陵","place_name_jianti_auto":"零陵","start_index":8,"tongjian_id":"902e8395-db0e-11ef-bc9b-a0d3651f611f"},{"place_name":"營道縣","place_name_jianti_auto":"营道县","start_index":10,"tongjian_id":"902e8396-db0e-11ef-b7b5-a0d3651f611f"},{"place_name":"蒼梧山","place_name_jianti_auto":"苍梧山","start_index":17,"tongjian_id":"902e8397-db0e-11ef-8844-a0d3651f611f"},{"place_name":"九疑","place_name_jianti_auto":"九疑","start_index":33,"tongjian_id":"902e8398-db0e-11ef-b504-a0d3651f611f"},{"place_name":"蒼梧","place_name_jianti_auto":"苍梧","start_index":41,"tongjian_id":"902e8399-db0e-11ef-9cfe-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志：九疑山在零陵營道縣南，亦名蒼梧山；九峯相似，望而疑之，故曰九疑。相傳舜死於蒼梧，因葬焉，故望祀之。","note_content_jianti_auto":"地理志：九疑山在零陵营道县南，亦名苍梧山；九峰相似，望而疑之，故曰九疑。相传舜死于苍梧，因葬焉，故望祀之。","note_type":"hu_note","start_index":21,"tongjian_id":"902e8392-db0e-11ef-9860-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"902e839c-db0e-11ef-b501-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"灊縣","place_name_jianti_auto":"灊县","start_index":3,"tongjian_id":"902e839d-db0e-11ef-8201-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":6,"tongjian_id":"902e839e-db0e-11ef-a941-a0d3651f611f"},{"place_name":"天柱山","place_name_jianti_auto":"天柱山","place_note":"安徽霍山县西南","start_index":10,"tongjian_id":"902e839f-db0e-11ef-9d54-a0d3651f611f"},{"place_name":"南嶽","place_name_jianti_auto":"南岳","start_index":19,"tongjian_id":"902e83a0-db0e-11ef-a16a-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":27,"tongjian_id":"902e83a1-db0e-11ef-ae08-a0d3651f611f"},{"place_name":"舒州","place_name_jianti_auto":"舒州","start_index":29,"tongjian_id":"902e83a2-db0e-11ef-b63a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，灊縣屬廬江郡，天柱山在南，帝以爲南嶽。灊，音潛。唐之舒州。","note_content_jianti_auto":"班志，灊县属庐江郡，天柱山在南，帝以为南岳。灊，音潜。唐之舒州。","note_type":"hu_note","start_index":27,"tongjian_id":"902e839b-db0e-11ef-afb2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"902e83a5-db0e-11ef-8c9c-a0d3651f611f"},{"people_name":"沈約","people_name_jianti_auto":"沈约","start_index":25,"tongjian_id":"902e83a6-db0e-11ef-93f4-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":77,"tongjian_id":"902e83a7-db0e-11ef-9c71-a0d3651f611f"},{"people_name":"溫嶠","people_name_jianti_auto":"温峤","start_index":97,"tongjian_id":"902e83a8-db0e-11ef-9e08-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"尋陽縣","place_name_jianti_auto":"寻阳县","start_index":3,"tongjian_id":"902e83a9-db0e-11ef-87de-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":7,"tongjian_id":"902e83aa-db0e-11ef-8831-a0d3651f611f"},{"place_name":"九江","place_name_jianti_auto":"九江","start_index":13,"tongjian_id":"902e83ab-db0e-11ef-98de-a0d3651f611f"},{"place_name":"大江","place_name_jianti_auto":"大江","start_index":22,"tongjian_id":"902e83ac-db0e-11ef-be98-a0d3651f611f"},{"place_name":"尋陽","place_name_jianti_auto":"寻阳","place_note":"湖北黄梅西南","start_index":29,"tongjian_id":"902e83ad-db0e-11ef-9715-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":44,"tongjian_id":"902e83ae-db0e-11ef-89ad-a0d3651f611f"},{"place_name":"尋陽縣","place_name_jianti_auto":"寻阳县","start_index":45,"tongjian_id":"902e83af-db0e-11ef-832f-a0d3651f611f"},{"place_name":"大江","place_name_jianti_auto":"大江","start_index":49,"tongjian_id":"902e83b0-db0e-11ef-8f77-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":55,"tongjian_id":"902e83b1-db0e-11ef-aaa1-a0d3651f611f"},{"place_name":"尋陽郡","place_name_jianti_auto":"寻阳郡","start_index":57,"tongjian_id":"902e83b2-db0e-11ef-b871-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":61,"tongjian_id":"902e83b3-db0e-11ef-bbfe-a0d3651f611f"},{"place_name":"柴桑","place_name_jianti_auto":"柴桑","start_index":64,"tongjian_id":"902e83b4-db0e-11ef-90f7-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":68,"tongjian_id":"902e83b5-db0e-11ef-9521-a0d3651f611f"},{"place_name":"尋陽","place_name_jianti_auto":"寻阳","start_index":70,"tongjian_id":"902e83b6-db0e-11ef-888f-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":81,"tongjian_id":"902e83b7-db0e-11ef-9425-a0d3651f611f"},{"place_name":"尋陽縣","place_name_jianti_auto":"寻阳县","start_index":83,"tongjian_id":"902e83b8-db0e-11ef-b37b-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":87,"tongjian_id":"902e83b9-db0e-11ef-9fa1-a0d3651f611f"},{"place_name":"蘄春郡","place_name_jianti_auto":"蕲春郡","start_index":91,"tongjian_id":"902e83ba-db0e-11ef-9490-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":96,"tongjian_id":"902e83bb-db0e-11ef-8c45-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":101,"tongjian_id":"902e83bc-db0e-11ef-bea1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，尋陽縣屬廬江郡。禹貢九江在南，皆東合爲大江。沈約曰：尋陽，因水名縣，水南注江。余據漢尋陽縣在大江之北，自晉立尋陽郡於江南之柴桑，而江北尋陽之名遂晦。杜佑曰：漢舊尋陽縣在江北，今蘄春郡界；晉溫嶠移於江南。","note_content_jianti_auto":"班志，寻阳县属庐江郡。禹贡九江在南，皆东合为大江。沈约曰：寻阳，因水名县，水南注江。余据汉寻阳县在大江之北，自晋立寻阳郡于江南之柴桑，而江北寻阳之名遂晦。杜佑曰：汉旧寻阳县在江北，今蕲春郡界；晋温峤移于江南。","note_type":"hu_note","start_index":33,"tongjian_id":"902e83a4-db0e-11ef-b043-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"902e83c0-db0e-11ef-80f5-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":10,"tongjian_id":"902e83c1-db0e-11ef-8a8d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：蛟，龍屬也。郭璞說其狀云：「似蛇而有脚，細頸有白嬰，大者數圍，卵生，子如二石大甕，能吞人。」射，而亦翻。","note_content_jianti_auto":"师古曰：蛟，龙属也。郭璞说其状云：「似蛇而有脚，细颈有白婴，大者数围，卵生，子如二石大瓮，能吞人。」射，而亦翻。","note_type":"hu_note","start_index":42,"tongjian_id":"902e83bf-db0e-11ef-8a94-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李斐","people_name_jianti_auto":"李斐","start_index":0,"tongjian_id":"902e83c3-db0e-11ef-8dbd-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":46,"tongjian_id":"902e83c4-db0e-11ef-a1d3-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":57,"tongjian_id":"902e83c5-db0e-11ef-a515-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":80,"tongjian_id":"902e83c6-db0e-11ef-af52-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"樅陽縣","place_name_jianti_auto":"枞阳县","start_index":49,"tongjian_id":"902e83c7-db0e-11ef-a696-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":53,"tongjian_id":"902e83c8-db0e-11ef-b5bf-a0d3651f611f"},{"place_name":"舒州","place_name_jianti_auto":"舒州","start_index":61,"tongjian_id":"902e83c9-db0e-11ef-ab60-a0d3651f611f"},{"place_name":"桐城縣","place_name_jianti_auto":"桐城县","start_index":63,"tongjian_id":"902e83ca-db0e-11ef-9855-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":67,"tongjian_id":"902e83cb-db0e-11ef-9831-a0d3651f611f"},{"place_name":"樅陽縣","place_name_jianti_auto":"枞阳县","start_index":69,"tongjian_id":"902e83cc-db0e-11ef-a5bf-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":74,"tongjian_id":"902e83cd-db0e-11ef-95b9-a0d3651f611f"},{"place_name":"樅陽郡","place_name_jianti_auto":"枞阳郡","start_index":76,"tongjian_id":"902e83ce-db0e-11ef-a32f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李斐曰：舳，舡後持柁處；艫，船前刺櫂處。言其船多，前後相銜，千里不絕也。舳，音逐。艫，音盧。班志，樅陽縣屬廬江郡。宋白曰：舒州桐城縣，漢爲樅陽縣也；梁置樅陽郡。師古曰：樅，千容翻。","note_content_jianti_auto":"李斐曰：舳，舡后持柁处；舻，船前刺櫂处。言其船多，前后相衔，千里不绝也。舳，音逐。舻，音卢。班志，枞阳县属庐江郡。宋白曰：舒州桐城县，汉为枞阳县也；梁置枞阳郡。师古曰：枞，千容翻。","note_type":"hu_note","start_index":53,"tongjian_id":"902e83c2-db0e-11ef-bb15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"琅邪郡","place_name_jianti_auto":"琅邪郡","start_index":0,"tongjian_id":"902e83d1-db0e-11ef-9a0b-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":4,"tongjian_id":"902e83d2-db0e-11ef-ac9a-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":7,"tongjian_id":"902e83d3-db0e-11ef-af69-a0d3651f611f"},{"place_name":"沂州","place_name_jianti_auto":"沂州","start_index":9,"tongjian_id":"902e83d4-db0e-11ef-af56-a0d3651f611f"},{"place_name":"海","place_name_jianti_auto":"海","start_index":16,"tongjian_id":"902e83d5-db0e-11ef-83e8-a0d3651f611f"},{"place_name":"萊","place_name_jianti_auto":"莱","start_index":18,"tongjian_id":"902e83d6-db0e-11ef-9a72-a0d3651f611f"},{"place_name":"密州","place_name_jianti_auto":"密州","start_index":20,"tongjian_id":"902e83d7-db0e-11ef-94ef-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"琅邪郡，秦置；唐爲沂州，其餘地入海、萊、密州界。","note_content_jianti_auto":"琅邪郡，秦置；唐为沂州，其余地入海、莱、密州界。","note_type":"hu_note","start_index":59,"tongjian_id":"902e83d0-db0e-11ef-90a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"902e83da-db0e-11ef-8412-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：計，若今之諸州計帳也。朝，直遙翻。","note_content_jianti_auto":"师古曰：计，若今之诸州计帐也。朝，直遥翻。","note_type":"hu_note","start_index":116,"tongjian_id":"902e83d9-db0e-11ef-b2f0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"舜，中国上古时代的五帝之一，东夷人。亦是道教与民间信仰的地官大帝。名重华；生于姚墟，为姚姓，后居于妫水之边，后人将姚姓改为妫姓，有虞氏。冀州人，都城在蒲阪（今山西永济）。舜为四部落联盟首领，以受尧的「禅让」而称帝于天下，其国号为「有虞」。","link_td_id":"Q10000010","link_td_number_id":4332,"people_name":"虞舜","people_name_jianti_auto":"虞舜","people_xingming":"虞舜","start_index":15,"tongjian_id":"9030a664-db0e-11ef-a7a6-a0d3651f611f"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高祖","people_name_jianti_auto":"高祖","people_xingming":"刘邦","start_index":98,"tongjian_id":"9030a66d-db0e-11ef-8d0b-a0d3651f611f","wl_zhushi":"[刘邦]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"902e8381-db0e-11ef-ac63-a0d3651f611f","pinyin":"zhú","source_anchor_text":"江中獲之舳艫千里薄","source_key":"baiyang_epub","start_index":42,"text":"舳","tongjian_id":"d02dc041-feda-5eda-84f9-3053297b5a6e"}],"ExtRef_Children_places":[{"place_name":"盛唐","place_name_jianti_auto":"盛唐","resolved_place_entity_id":3962,"start_index":10,"tongjian_id":"9030a663-db0e-11ef-b3ab-a0d3651f611f"},{"place_name":"九疑","place_name_jianti_auto":"九疑","resolved_place_entity_id":5745,"start_index":18,"tongjian_id":"9030a665-db0e-11ef-8fae-a0d3651f611f"},{"place_name":"灊","place_name_jianti_auto":"灊","resolved_place_entity_id":4972,"start_index":22,"tongjian_id":"9030a666-db0e-11ef-9e61-a0d3651f611f"},{"place_name":"天柱山","place_name_jianti_auto":"天柱山","place_note":"安徽霍山县西南","resolved_place_entity_id":6460,"start_index":23,"tongjian_id":"9030a667-db0e-11ef-8add-a0d3651f611f"},{"place_name":"尋陽","place_name_jianti_auto":"寻阳","place_note":"湖北黄梅西南","resolved_place_entity_id":343,"start_index":28,"tongjian_id":"9030a668-db0e-11ef-9e45-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","resolved_place_entity_id":47,"start_index":31,"tongjian_id":"9030a669-db0e-11ef-9008-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","resolved_place_entity_id":47,"start_index":36,"tongjian_id":"9030a66a-db0e-11ef-94e4-a0d3651f611f"},{"place_name":"樅陽","place_name_jianti_auto":"枞阳","place_note":"安徽樅陽","resolved_place_entity_id":3244,"start_index":48,"tongjian_id":"9030a66b-db0e-11ef-99e9-a0d3651f611f"},{"place_name":"琅邪","place_name_jianti_auto":"琅邪","place_note":"山東胶南","resolved_place_entity_id":445,"start_index":56,"tongjian_id":"9030a66c-db0e-11ef-bcbe-a0d3651f611f"},{"place_name":"太山","place_name_jianti_auto":"太山","resolved_place_entity_id":306,"start_index":79,"tongjian_id":"9030a66e-db0e-11ef-9145-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","place_note":"陝西淳化西北","resolved_place_entity_id":648,"start_index":138,"tongjian_id":"9030a66f-db0e-11ef-8811-a0d3651f611f"},{"place_name":"泰畤","place_name_jianti_auto":"泰畤","resolved_place_entity_id":1246,"start_index":142,"tongjian_id":"9030a670-db0e-11ef-8ae7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、庐州府（卷二十六）","excerpts":[{"context_after":"，宋白曰：盛唐县西十五里有盛唐山，当即此山矣。又州西七十...","context_before":"○武陟山[州西三十里。","source_end_index":41,"source_paragraph_tongjian_id":"fa285e74-93d0-586a-b387-3b7e4b1f0ffe","source_start_index":11,"source_text":"汉武南巡尝登陟于此，因名。《汉纪》：元封五年，南巡狩至于盛唐"},{"context_after":"《洞天记》：黄帝封五岳，南岳衡山最远，以灊岳副之，舜南巡...","context_before":"...亦曰南岳山，又名衡山。文帝分淮南地立衡山国，以此山名也。","source_end_index":78,"source_paragraph_tongjian_id":"6622a516-a5b4-568c-b222-feaaf97113bb","source_start_index":43,"source_text":"《封禅书》：元封五年冬，巡南郡，至江陵，而东登礼灊之天柱山，号曰南岳。"},{"context_after":"又复览山，在县东二十里，即汉武南巡还，登此顾瞻处也。南宋...","context_before":"...封山[县东三十里。旧《志》：在六安州南九十里。盖接壤也。","source_end_index":65,"source_paragraph_tongjian_id":"781b1dba-8dd4-5931-9dcf-958d00c3ebe7","source_start_index":29,"source_text":"相传汉武南巡还，登复览山，见此山峻拔，因指示群臣，拟封为霍岳之副，故名。"}],"path":"南直方舆纪要/九、庐州府（卷二十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十、安庆府（卷二十六）","excerpts":[{"context_after":"后汉县废。萧梁始复置。太清末，萧范以合肥之军顿濡须以待上...","context_before":"○枞阳城[县东南百二十里，临江。汉县治此。","source_end_index":68,"source_paragraph_tongjian_id":"19c86f78-946f-509d-a190-cd73bff952e9","source_start_index":21,"source_text":"《汉纪》：元封五年，南巡狩，自寻阳浮江，射蛟江中，获之，舳舻千里，薄枞阳而出，作盛唐枞阳之歌。"},{"context_after":"，陈友谅自枞阳寇池州、太平，是也。《志》云：枞阳东十余里...","context_before":"...枞阳河。府西北境诸川及县东北诸川，皆汇流入焉，达于大江。","source_end_index":85,"source_paragraph_tongjian_id":"915d2d30-ef5e-562a-b96e-66f3b152f683","source_start_index":78,"source_text":"汉武薄枞阳而出"},{"context_after":"又《尔雅》：霍即天柱山，灊水所经。山或以邑名，或以水名，...","context_before":"...、岩十二、原四、洞十、台四、池三，其瑰奇秀丽，不可殚纪。","source_end_index":298,"source_paragraph_tongjian_id":"1947e355-9947-52ea-b893-964acbff1b3f","source_start_index":280,"source_text":"《汉·郊祀志》：武帝登礼灊之天柱山。"}],"path":"南直方舆纪要/十、安庆府（卷二十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"又太初元年，行幸泰山，禅蒿里[蒿，一作高，亦见泰安州]。...","context_before":"...载一巡狩，用事泰山，令诸侯各治邸泰山下。明年，复祠泰山。","source_end_index":378,"source_paragraph_tongjian_id":"4fb08d4f-c3c0-5b48-be3b-5e70e4f4b948","source_start_index":364,"source_text":"五年，南巡狩，还至泰山增封。"},{"context_after":"太始三年，幸琅邪。《封禅书》八祀曰：四时主，祠琅邪。《子...","context_before":"...县]。汉初，田肯曰：齐东有琅邪、即墨之饶，南有泰山之固。","source_end_index":317,"source_paragraph_tongjian_id":"2508282e-eb37-5c49-838e-08d132734ee1","source_start_index":300,"source_text":"武帝元封五年，东巡，北至琅邪并海。"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷七十五）","excerpts":[{"context_after":"郭璞云：其山九溪皆相似。郦道元曰：九疑山盘基苍梧之野，峰...","context_before":"...登此。《秦纪》：始皇三十七年，行至云梦，望祀虞舜于九疑。","source_end_index":117,"source_paragraph_tongjian_id":"3503dc98-e73e-5487-955e-b061b5e7a152","source_start_index":105,"source_text":"汉武元封五年，亦望祀焉。"}],"path":"湖广方舆纪要/〇、封域山川险要（卷七十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷八十三）","excerpts":[{"context_after":"后亦谓之扬澜左里。晋末，刘裕破卢循于左里，即彭蠡湖口也[...","context_before":"...：彭蠡既猪。《史记》：吴起曰：三苗之国，左洞庭，右彭蠡。","source_end_index":117,"source_paragraph_tongjian_id":"82d0e33f-6a28-51ed-869a-e8323469f295","source_start_index":92,"source_text":"又汉武帝浮江出枞阳，过彭蠡[枞阳，见江南桐城县]。"}],"path":"江西方舆纪要/〇、封域 山川险要（卷八十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、九江府（卷八十五）","excerpts":[{"context_after":"后汉永嘉初，庐江贼攻寻阳。建安十四年，孙权以吕蒙领寻阳令...","context_before":"...阳县也。《班志》注：《禹贡》九江在寻阳县南，皆东合大江。","source_end_index":147,"source_paragraph_tongjian_id":"7ccbbe83-76e3-527c-b2f6-76392136d3b2","source_start_index":131,"source_text":"汉武南巡，自寻阳浮江，射蛟江中。"}],"path":"江西方舆纪要/四、九江府（卷八十五）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"1冬，上南巡狩，至于盛唐，望祀虞舜于九疑。登灊天柱山，自尋陽浮江，親射蛟江中，獲之。舳艫千里，薄樅陽而出，遂北至琅邪，並海，所過禮祠其名山大川。春，三月，還至太山，增封。甲子，始祀上帝於明堂，配以高祖；因朝諸侯王、列侯，受郡、國計。夏，四月，赦天下，所幸縣毋出今年租賦。還，幸甘泉，郊泰畤。","content_fanyi":"冬季，汉武帝南巡，抵达盛唐，遥祭九疑山的虞舜。又登上灊县天柱山，从寻阳乘船沿长江而行，亲自在江中射蛟，并把它捕获。船队首尾相接，绵延千里，抵达枞阳后离船登岸，随后向北到达琅邪郡，沿海岸行进，沿途祭祀所经过的名山大川。春季，三月，回到泰山，加高封土。甲子日，第一次在明堂祭祀上帝，以汉高祖刘邦配享；随后接受诸侯王、列侯朝见，并受理各郡、国呈报的户口赋税计簿。夏季，四月，大赦天下，本次巡幸所到的县免交当年田租和赋税。返回后，又巡幸甘泉，在泰畤举行郊祭。","content_jianti_auto":"1冬，上南巡狩，至于盛唐，望祀虞舜于九疑。登灊天柱山，自寻阳浮江，亲射蛟江中，获之。舳舻千里，薄枞阳而出，遂北至琅邪，并海，所过礼祠其名山大川。春，三月，还至太山，增封。甲子，始祀上帝于明堂，配以高祖；因朝诸侯王、列侯，受郡、国计。夏，四月，赦天下，所幸县毋出今年租赋。还，幸甘泉，郊泰畤。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1706,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"902e8381-db0e-11ef-ac63-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：漢武故事云：「大將軍四子皆不才，皇后每因太子涕泣請上削其封。上曰：『吾自知之，不令皇后憂也。』少子竟坐奢淫誅。上遣謝后，通削諸子封爵，各留千戶焉。」按青四子無坐奢淫誅者，此說妄也。","note_content_jianti_auto":"考异曰：汉武故事云：「大将军四子皆不才，皇后每因太子涕泣请上削其封。上曰：『吾自知之，不令皇后忧也。』少子竟坐奢淫诛。上遣谢后，通削诸子封爵，各留千户焉。」按青四子无坐奢淫诛者，此说妄也。","note_type":"hu_note","start_index":9,"tongjian_id":"9030a672-db0e-11ef-8777-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"揚雄","people_name_jianti_auto":"扬雄","start_index":8,"tongjian_id":"9030a676-db0e-11ef-8c63-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":22,"tongjian_id":"9030a677-db0e-11ef-96a8-a0d3651f611f"},{"people_name":"衞青","people_name_jianti_auto":"衞青","start_index":35,"tongjian_id":"9030a678-db0e-11ef-8b15-a0d3651f611f"},{"people_name":"霍去病","people_name_jianti_auto":"霍去病","start_index":44,"tongjian_id":"9030a679-db0e-11ef-bcb8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"廬山","place_name_jianti_auto":"庐山","place_note":"蒙古国杭爱山南面的一支","start_index":0,"tongjian_id":"9030a67a-db0e-11ef-893a-a0d3651f611f"},{"place_name":"盧山","place_name_jianti_auto":"卢山","start_index":5,"tongjian_id":"9030a67b-db0e-11ef-bdf8-a0d3651f611f"},{"place_name":"盧山","place_name_jianti_auto":"卢山","start_index":14,"tongjian_id":"9030a67c-db0e-11ef-b8c7-a0d3651f611f"},{"place_name":"盧山","place_name_jianti_auto":"卢山","start_index":26,"tongjian_id":"9030a67d-db0e-11ef-ba69-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":29,"tongjian_id":"9030a67e-db0e-11ef-9dd8-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":31,"tongjian_id":"9030a67f-db0e-11ef-8fa8-a0d3651f611f"},{"place_name":"茂陵","place_name_jianti_auto":"茂陵","place_note":"刘彻墓，陕西兴平东北","start_index":39,"tongjian_id":"9030a680-db0e-11ef-b1ec-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"廬山，蓋卽盧山。揚雄所謂「塡盧山之壑」者也。師古曰：盧山，匈奴中山名。衞青冢在茂陵東，次霍去病冢之西，相倂者是也。","note_content_jianti_auto":"庐山，盖即卢山。扬雄所谓「塡卢山之壑」者也。师古曰：卢山，匈奴中山名。衞青冢在茂陵东，次霍去病冢之西，相倂者是也。","note_type":"hu_note","start_index":16,"tongjian_id":"9030a675-db0e-11ef-911b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-106,"link_td_description":"卫青，本姓郑，字仲卿，河东郡平阳县（今山西省临汾市西南）人，西汉汉武帝时期军事家，是汉匈战争早期击溃匈奴的重要功臣，官至大将军，加官大司马，封长平侯，食禄万户。卫青是汉武帝第二任皇后卫子夫的同母异父弟弟、太子刘据和名将霍去病的舅舅，也是汉武帝姐姐平阳公主的第三任丈夫。","link_td_id":"Q10000910","link_td_number_id":70251,"people_name":"長平烈侯","people_name_jianti_auto":"长平烈侯","people_xingming":"卫青","start_index":1,"tongjian_id":"9030a681-db0e-11ef-81e4-a0d3651f611f"},{"link_death_year":-106,"link_td_description":"卫青，本姓郑，字仲卿，河东郡平阳县（今山西省临汾市西南）人，西汉汉武帝时期军事家，是汉匈战争早期击溃匈奴的重要功臣，官至大将军，加官大司马，封长平侯，食禄万户。卫青是汉武帝第二任皇后卫子夫的同母异父弟弟、太子刘据和名将霍去病的舅舅，也是汉武帝姐姐平阳公主的第三任丈夫。","link_td_id":"Q10000910","link_td_number_id":70251,"people_name":"衞青","people_name_jianti_auto":"衞青","people_xingming":"卫青","start_index":5,"tongjian_id":"9030a682-db0e-11ef-9102-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"廬山","place_name_jianti_auto":"庐山","place_note":"蒙古国杭爱山南面的一支","start_index":13,"tongjian_id":"9030a683-db0e-11ef-a6d7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"又扬雄曰：运府库之财，填卢山之壑。孟康曰：卢山，单于南庭...","context_before":"...病以轻骑追虏至窴颜山，得匈奴积粟处也。或曰：山亦名卢山，","source_end_index":105,"source_paragraph_tongjian_id":"71a0f72a-57c6-56fc-89ad-286411439e28","source_start_index":92,"source_text":"卫青薨，武帝命起冢象卢山。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"2長平烈侯衞青薨。起冢，象廬山。","content_fanyi":"长平烈侯卫青去世。汉武帝为他修建坟墓，形状仿照匈奴国中的庐山。","content_jianti_auto":"2长平烈侯衞青薨。起冢，象庐山。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1707,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"9030a671-db0e-11ef-97cd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孝武帝","people_name_jianti_auto":"孝武帝","start_index":34,"tongjian_id":"9030a686-db0e-11ef-a7ab-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":4,"tongjian_id":"9030a687-db0e-11ef-a57b-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":15,"tongjian_id":"9030a688-db0e-11ef-a91a-a0d3651f611f"},{"place_name":"京都","place_name_jianti_auto":"京都","start_index":328,"tongjian_id":"9030a689-db0e-11ef-b6a5-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":355,"tongjian_id":"9030a68a-db0e-11ef-bddb-a0d3651f611f"},{"place_name":"涼州","place_name_jianti_auto":"凉州","start_index":3