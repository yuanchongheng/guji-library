Children_zhang_notes":[],"note_content":"已，終也，竟也。師古曰：撮，總取也，音千括翻。","note_content_jianti_auto":"已，终也，竟也。师古曰：撮，总取也，音千括翻。","note_type":"hu_note","start_index":89,"tongjian_id":"91d17de6-db0e-11ef-89e1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"謁者","official_note":"謁者是汉代负责传达、引见等事务的官职，此处表示派遣謁者陈农到各地搜集散佚书籍，源自《资治通鉴》上下文和历史常识。","official_rank":"未知","source_snippet":"使謁者陳農求遺書於天下","start_index":12,"tongjian_id":"20ba9111-f8dd-45e9-b9ef-00497fd91a29"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"光祿大夫","official_note":"光祿大夫是汉代顾问性质的官职，此处表示任命光祿大夫刘向负责校勘经传、诸子、诗赋等书籍，源自《资治通鉴》上下文和历史常识。","official_rank":"未知","source_snippet":"詔光祿大夫劉向校經傳、諸子、詩賦","start_index":28,"tongjian_id":"847736f7-e05f-4728-9e9d-513d555244ab"},{"confidence":0.9,"official_category":"军事指挥","official_name":"步兵校尉","official_note":"步兵校尉是汉代军事官职，负责步兵部队，此处表示任命步兵校尉任宏负责校勘兵书，源自《资治通鉴》上下文和历史常识。","official_rank":"未知","source_snippet":"步兵校尉任宏校兵書","start_index":44,"tongjian_id":"f394485f-6ee5-4843-8059-3ab920c7e66c"},{"confidence":0.9,"official_category":"文教","official_name":"太史令","official_note":"太史令是汉代掌管天文、历法、史书等事务的官职，此处表示任命太史令尹咸负责校勘数术书籍，源自《资治通鉴》上下文和历史常识。","official_rank":"未知","source_snippet":"太史令尹咸校數術","start_index":54,"tongjian_id":"4346f283-ede6-4cf8-8bc2-b3a4fa5a4b4a"},{"confidence":0.9,"official_category":"宫廷服务","official_name":"侍醫","official_note":"侍醫是汉代宫廷中的医官，负责医疗事务，此处表示任命侍醫李柱国负责校勘方技书籍，源自《资治通鉴》上下文和历史常识。","official_rank":"未知","source_snippet":"侍醫李柱國校方技","start_index":62,"tongjian_id":"a605d49c-57c9-4fc5-8d93-f6db9a274485"}],"ExtRef_Children_people":[{"people_name":"陳農","people_name_jianti_auto":"陈农","people_xingming":"陈农","start_index":13,"tongjian_id":"91d1a751-db0e-11ef-9d90-a0d3651f611f"},{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"劉向","people_name_jianti_auto":"刘向","people_xingming":"刘向","start_index":27,"tongjian_id":"91d1a752-db0e-11ef-ad90-a0d3651f611f","wl_zhushi":"[刘更生]"},{"people_name":"任宏","people_name_jianti_auto":"任宏","people_xingming":"任宏","start_index":43,"tongjian_id":"91d1a753-db0e-11ef-a8ba-a0d3651f611f"},{"people_name":"尹咸","people_name_jianti_auto":"尹咸","people_xingming":"尹咸","start_index":52,"tongjian_id":"91d1a754-db0e-11ef-9130-a0d3651f611f"},{"people_name":"李柱國","people_name_jianti_auto":"李柱国","people_xingming":"李柱国","start_index":60,"tongjian_id":"91d1a755-db0e-11ef-b8b4-a0d3651f611f"},{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"向","people_name_jianti_auto":"向","people_xingming":"刘向","start_index":72,"tongjian_id":"91d1a756-db0e-11ef-a8c2-a0d3651f611f","wl_zhushi":"[刘更生]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"91d17dd6-db0e-11ef-94cb-a0d3651f611f","pinyin":"cuō","source_anchor_text":"條其篇目撮其指意錄","source_key":"baiyang_epub","start_index":79,"text":"撮","tongjian_id":"92f95a6b-6e05-5cb3-8fd4-7c571d73a37a"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4上以中祕書頗散亡，使謁者陳農求遺書於天下。詔光祿大夫劉向校經傳、諸子、詩賦，步兵校尉任宏校兵書，太史令尹咸校數術，侍醫李柱國校方技。每一書已，向輒條其篇目，撮其指意，錄而奏之。","content_fanyi":"汉成帝因为宫中藏书失散很多，便派谒者陈农到全国各地搜求散佚的书籍。又下诏命光禄大夫刘向负责校订经传、诸子、诗赋等各类典籍，步兵校尉任宏负责校订兵书，太史令尹咸负责校订数术占卜类书籍，侍医李柱国负责校订方技医药类书籍。每一部书校订完成后，刘向就分条列出该书的篇目，概括其主旨要义，并写成提要呈报汉成帝。","content_jianti_auto":"4上以中秘书颇散亡，使谒者陈农求遗书于天下。诏光禄大夫刘向校经传、诸子、诗赋，步兵校尉任宏校兵书，太史令尹咸校数术，侍医李柱国校方技。每一书已，向辄条其篇目，撮其指意，录而奏之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2388,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"91d17dd6-db0e-11ef-94cb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"劉向","people_name_jianti_auto":"刘向","people_xingming":"刘更生","start_index":1,"tongjian_id":"91d1a75a-db0e-11ef-997b-a0d3651f611f","wl_zhushi":"[刘更生]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","people_xingming":"王氏","start_index":4,"tongjian_id":"91d1a75b-db0e-11ef-8e13-a0d3651f611f"},{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"向","people_name_jianti_auto":"向","people_xingming":"刘更生","start_index":101,"tongjian_id":"91d1a763-db0e-11ef-93fb-a0d3651f611f","wl_zhushi":"[刘更生]"},{"link_death_year":-22,"link_td_description":"王凤，字孝卿，西汉魏郡元城（今河北省大名县）人。济北王田安之后裔，王禁之子，汉成帝时外戚、大臣。","link_td_id":"Q10003974","link_td_number_id":301991,"people_name":"鳳","people_name_jianti_auto":"凤","people_xingming":"王凤","start_index":107,"tongjian_id":"91d1a764-db0e-11ef-bf73-a0d3651f611f"},{"people_name":"王氏","people_name_jianti_auto":"王氏","people_xingming":"王氏","start_index":120,"tongjian_id":"91d1a766-db0e-11ef-b5d6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":38,"tongjian_id":"91d1a75c-db0e-11ef-beaf-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","resolved_place_entity_id":877,"start_index":41,"tongjian_id":"91d1a75d-db0e-11ef-b1c5-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":19,"start_index":44,"tongjian_id":"91d1a75e-db0e-11ef-b0ba-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":46,"tongjian_id":"91d1a75f-db0e-11ef-bc06-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"5劉向以王氏權位太盛，而上方嚮詩、書古文，向乃因尚書·洪範，集合上古以來，歷春秋、六國至秦、漢符瑞、災異之記，推迹行事，連傅禍福，著其占驗，比類相從，各有條目，凡十一篇，號曰洪範五行傳論，奏之。天子心知向忠精，故爲鳳兄弟起此論也；然終不能奪王氏權。","content_fanyi":"刘向看到外戚王氏权位过盛，而汉成帝正喜好《诗经》《尚书》等古文经籍，便依据《尚书·洪范》，汇集上古以来，历经春秋、六国直至秦、汉的祥瑞吉兆、天地灾异记录，推究这些祥瑞灾异背后的事迹经过，连缀祸福因果，标明占验结果，分类编排，各立条目，共十一篇，题为《洪范五行传论》，进呈汉成帝。汉成帝心里明白刘向对汉朝一片忠心精诚，是因为王凤兄弟权势过大，才写此书来规劝他；但终究不忍削夺王氏的权位。","content_jianti_auto":"5刘向以王氏权位太盛，而上方向诗、书古文，向乃因尚书·洪范，集合上古以来，历春秋、六国至秦、汉符瑞、灾异之记，推迹行事，连傅祸福，著其占验，比类相从，各有条目，凡十一篇，号曰洪范五行传论，奏之。天子心知向忠精，故为凤兄弟起此论也；然终不能夺王氏权。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2389,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"91d1a757-db0e-11ef-a2dd-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000610"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。濟，子禮翻。乘，繩證翻。壞，音怪。敗，補邁翻。","note_content_jianti_auto":"复，扶又翻；下同。济，子礼翻。乘，绳证翻。坏，音怪。败，补迈翻。","note_type":"hu_note","start_index":24,"tongjian_id":"91d1a768-db0e-11ef-bcde-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":18,"tongjian_id":"91d1a76a-db0e-11ef-beb0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":10,"tongjian_id":"91d1a76b-db0e-11ef-b3d5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百官表曰：將作少府，秦官，掌治宮室；景帝中六年，更名將作大匠。","note_content_jianti_auto":"百官表曰：将作少府，秦官，掌治宫室；景帝中六年，更名将作大匠。","note_type":"hu_note","start_index":43,"tongjian_id":"91d1a769-db0e-11ef-bf97-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"91d1a76e-db0e-11ef-ad80-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":10,"tongjian_id":"91d1a76f-db0e-11ef-baf2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：乘馬，姓也。師古曰：乘，音食證翻。","note_content_jianti_auto":"孟康曰：乘马，姓也。师古曰：乘，音食证翻。","note_type":"hu_note","start_index":54,"tongjian_id":"91d1a76d-db0e-11ef-b1e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇林","people_name_jianti_auto":"苏林","start_index":0,"tongjian_id":"91d1a771-db0e-11ef-9dfd-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":23,"tongjian_id":"91d1a772-db0e-11ef-ac0e-a0d3651f611f"},{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":74,"tongjian_id":"91d1a773-db0e-11ef-93a8-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":93,"tongjian_id":"91d1a774-db0e-11ef-a99a-a0d3651f611f"},{"people_name":"如","people_name_jianti_auto":"如","start_index":97,"tongjian_id":"91d1a775-db0e-11ef-8206-a0d3651f611f"},{"people_name":"孟","people_name_jianti_auto":"孟","start_index":99,"tongjian_id":"91d1a776-db0e-11ef-b2ef-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":65,"tongjian_id":"91d1a777-db0e-11ef-97d6-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":109,"tongjian_id":"91d1a778-db0e-11ef-8907-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蘇林曰：平賈，以錢取人作卒，顧其時庸之平賈也。如淳曰：律說，平賈一月，得錢二千。又律說，戍邊一歲當罷；若有急，當留守六月。今以卒治河之故，復留六月。孟康曰：外繇，戍邊也。治水不復戍邊也。師古曰：如、孟二說皆非也。以卒治河有勞，雖執役日近，皆得比繇戍六月也。著，謂著簿籍也。治，直之翻。賈，讀曰價。著，音竹助翻。繇，讀曰傜。","note_content_jianti_auto":"苏林曰：平贾，以钱取人作卒，顾其时庸之平贾也。如淳曰：律说，平贾一月，得钱二千。又律说，戍边一岁当罢；若有急，当留守六月。今以卒治河之故，复留六月。孟康曰：外繇，戍边也。治水不复戍边也。师古曰：如、孟二说皆非也。以卒治河有劳，虽执役日近，皆得比繇戍六月也。著，谓著簿籍也。治，直之翻。贾，读曰价。著，音竹助翻。繇，读曰傜。","note_type":"hu_note","start_index":84,"tongjian_id":"91d1a770-db0e-11ef-857b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"丞相史","official_note":"丞相史是丞相的属官，负责协助处理政务和文书工作，此处杨焉作为丞相史参与治河工程，显示中央官员参与地方事务。","official_rank":"未知","source_snippet":"丞相史楊焉","start_index":38,"tongjian_id":"b10a3339-1c3e-4326-b9f2-1b24870aff99"},{"confidence":0.95,"official_category":"工程营造","official_name":"將作大匠","official_note":"將作大匠是负责宫殿、陵墓等大型工程建设的官员，此处许商参与治河，表明其职能扩展到水利工程。","official_rank":"未知","source_snippet":"將作大匠許商","start_index":43,"tongjian_id":"8324f21f-7aec-47d9-acf4-ce95034840df"},{"confidence":0.9,"official_category":"监察谏议","official_name":"諫大夫","official_note":"諫大夫是负责向皇帝进谏和监察的官员，此处乘马延年参与治河，可能涉及监督或建议工程事宜。","official_rank":"未知","source_snippet":"諫大夫乘馬延年","start_index":48,"tongjian_id":"b29ca84d-e364-48a5-8698-9a18d0902ce0"}],"ExtRef_Children_people":[{"link_td_description":"王延世，字长叔，犍为郡资中（治今四川省资阳市）人，西汉治河专家。","link_td_id":"Q10019775","link_td_number_id":6023280,"people_name":"王延世","people_name_jianti_auto":"王延世","people_xingming":"王延世","start_index":26,"tongjian_id":"91d1a77f-db0e-11ef-9370-a0d3651f611f"},{"people_name":"楊焉","people_name_jianti_auto":"杨焉","people_xingming":"楊焉","start_index":33,"tongjian_id":"91d1a780-db0e-11ef-a59f-a0d3651f611f"},{"link_td_description":"许商，字长伯，西汉经学家、数学家、历算家、治水专家。长安（治今陕西省西安西北）人。","link_td_id":"Q10019881","link_td_number_id":6038279,"people_name":"許商","people_name_jianti_auto":"许商","people_xingming":"許商","start_index":40,"tongjian_id":"91d1a781-db0e-11ef-96e8-a0d3651f611f"},{"link_td_description":"王延世，字长叔，犍为郡资中（治今四川省资阳市）人，西汉治河专家。","link_td_id":"Q10019775","link_td_number_id":6023280,"people_name":"延世","people_name_jianti_auto":"延世","people_xingming":"王延世","start_index":61,"tongjian_id":"91d1a782-db0e-11ef-aabd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":1,"tongjian_id":"91d1a77b-db0e-11ef-8347-a0d3651f611f"},{"place_name":"平原","place_name_jianti_auto":"平原","resolved_place_entity_id":403,"start_index":4,"tongjian_id":"91d1a77c-db0e-11ef-823f-a0d3651f611f"},{"place_name":"濟南","place_name_jianti_auto":"济南","resolved_place_entity_id":859,"start_index":9,"tongjian_id":"91d1a77d-db0e-11ef-8bb6-a0d3651f611f"},{"place_name":"千乘","place_name_jianti_auto":"千乘","resolved_place_entity_id":2090,"start_index":12,"tongjian_id":"91d1a77e-db0e-11ef-afb5-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":69,"tongjian_id":"91d1a783-db0e-11ef-8b6f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"或曰：宋大中祥符间，以商河为棣州患，议徙商河，南入大清河...","context_before":"...三里。自德平、乐陵县流入境，又东北入武定州境。《志》云：","source_end_index":56,"source_paragraph_tongjian_id":"09770dcf-5c24-55f4-8efe-92e8b43a47dd","source_start_index":34,"source_text":"汉成帝时，河水为患，许商凿渠以杀其势，因名。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/◎川渎二大河上（卷一百二十五）","excerpts":[{"context_after":"东汉永平中，河流合汴，泛滥兖、豫。明帝使王景治之，绝水立...","context_before":"...原。成帝建始三年，河决馆陶，遂溢入平原、千乘、济南界中。","source_end_index":121,"source_paragraph_tongjian_id":"9b5f2531-68f9-59d6-a9cd-a76d22664be5","source_start_index":97,"source_text":"河平三年，河复决平原，流入济南、千乘，复堤塞之。"}],"path":"川渎/◎川渎二大河上（卷一百二十五）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"6河復決平原，流入濟南、千乘，所壞敗者半建始時。復遣王延世與丞相史楊焉及將作大匠許商、諫大夫乘馬延年同作治，六月乃成。復賜延世黃金百斤。治河卒非受平賈者，爲著外繇六月。","content_fanyi":"黄河又在平原郡决口，洪水灌入济南郡和千乘郡，造成的破坏相当于建始四年水灾的一半。于是又派遣王延世与丞相长史杨焉，会同掌管宫室建筑的将作大匠许商、谏大夫乘马延年等共同前往修筑河堤，历时六个月才将决口堵塞。朝廷再次赏赐王延世黄金一百斤。参加治河而未领工钱的差役民夫，都登记在册，可抵免六个月的其他劳役。","content_jianti_auto":"6河复决平原，流入济南、千乘，所坏败者半建始时。复遣王延世与丞相史杨焉及将作大匠许商、谏大夫乘马延年同作治，六月乃成。复赐延世黄金百斤。治河卒非受平贾者，为著外繇六月。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2390,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"91d1a767-db0e-11ef-ac3c-a0d3651f611f"}],"reign_name":"三年","reign_name_jianti_auto":"三年","start_index":6,"tongjian_id":"91d0eb33-db0e-11ef-b466-a0d3651f611f","year_anno":"（乙未、前二六）","year_int":-26},"message":"success","success":true}