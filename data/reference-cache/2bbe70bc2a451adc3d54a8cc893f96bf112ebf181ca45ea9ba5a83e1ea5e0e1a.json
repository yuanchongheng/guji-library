ldren_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻，又音如字。將，領也。卒，臧沒翻。說文：吏人給事者衣爲卒，卒衣有題識；其字從「衣」從「十」。","note_content_jianti_auto":"将，即亮翻，又音如字。将，领也。卒，臧没翻。说文：吏人给事者衣为卒，卒衣有题识；其字从「衣」从「十」。","note_type":"hu_note","start_index":158,"tongjian_id":"8bef659e-db0e-11ef-a661-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以此敗彼曰敗。敗，比邁翻。","note_content_jianti_auto":"以此败彼曰败。败，比迈翻。","note_type":"hu_note","start_index":165,"tongjian_id":"8bef65a0-db0e-11ef-881e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"智氏","people_name_jianti_auto":"智氏","start_index":11,"tongjian_id":"8bef65a2-db0e-11ef-9b63-a0d3651f611f"},{"people_name":"周定王","people_name_jianti_auto":"周定王","start_index":14,"tongjian_id":"8bef65a3-db0e-11ef-9057-a0d3651f611f"},{"people_name":"皇甫謐","people_name_jianti_auto":"皇甫谧","start_index":30,"tongjian_id":"8bef65a4-db0e-11ef-ace3-a0d3651f611f"},{"people_name":"元王","people_name_jianti_auto":"元王","start_index":35,"tongjian_id":"8bef65a5-db0e-11ef-8221-a0d3651f611f"},{"people_name":"智伯","people_name_jianti_auto":"智伯","start_index":46,"tongjian_id":"8bef65a6-db0e-11ef-bfb5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"三晉","place_name_jianti_auto":"三晋","start_index":8,"tongjian_id":"8bef65a7-db0e-11ef-93a3-a0d3651f611f"},{"place_name":"三晉","place_name_jianti_auto":"三晋","start_index":43,"tongjian_id":"8bef65a8-db0e-11ef-9f58-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記·六國年表，三晉滅智氏在周定王十六年，上距獲麟二十七年。皇甫謐曰：元王十一年癸未，三晉滅智伯。","note_content_jianti_auto":"史记·六国年表，三晋灭智氏在周定王十六年，上距获麟二十七年。皇甫谧曰：元王十一年癸未，三晋灭智伯。","note_type":"hu_note","start_index":177,"tongjian_id":"8bef65a1-db0e-11ef-b80c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以別族也。","note_content_jianti_auto":"以别族也。","note_type":"hu_note","start_index":182,"tongjian_id":"8bef65aa-db0e-11ef-8d05-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"张孟谈，《国语》中作张谈，姬姓，张氏。中国战国时期晋国赵襄子的家臣，曾经在晋阳之战策动了韩氏、魏氏，合灭了智氏。《史记》中由于司马迁避讳父亲司马谈，以张孟同称呼。","link_td_id":"Q10003399","link_td_number_id":3265647,"people_name":"張孟談","people_name_jianti_auto":"张孟谈","people_xingming":"张孟谈","start_index":4,"tongjian_id":"8bef65ac-db0e-11ef-939d-a0d3651f611f"},{"link_td_description":"张孟谈，《国语》中作张谈，姬姓，张氏。中国战国时期晋国赵襄子的家臣，曾经在晋阳之战策动了韩氏、魏氏，合灭了智氏。《史记》中由于司马迁避讳父亲司马谈，以张孟同称呼。","link_td_id":"Q10003399","link_td_number_id":3265647,"people_name":"張孟談","people_name_jianti_auto":"张孟谈","start_index":74,"tongjian_id":"8bef65b4-db0e-11ef-91ef-a0d3651f611f"},{"link_td_description":"张孟谈，《国语》中作张谈，姬姓，张氏。中国战国时期晋国赵襄子的家臣，曾经在晋阳之战策动了韩氏、魏氏，合灭了智氏。《史记》中由于司马迁避讳父亲司马谈，以张孟同称呼。","link_td_id":"Q10003399","link_td_number_id":3265647,"people_name":"張孟談","people_name_jianti_auto":"张孟谈","start_index":102,"tongjian_id":"8bef65b5-db0e-11ef-b23d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷三十九）","excerpts":[{"context_after":"后周建德五年，周主自将攻晋州军于汾曲，分遣宇文纯守千里径...","context_before":"...报，乃为坛于霍太山而致命焉。山下有观堆，高二里，周十里，","source_end_index":166,"source_paragraph_tongjian_id":"158109d3-386f-5258-8feb-9c58951abe7f","source_start_index":147,"source_text":"赵襄子灭智氏，祠霍太山于此，曰观堆祠。"}],"path":"山西方舆纪要/〇、封域山川险要（卷三十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、太原府（卷四十）","excerpts":[{"context_after":"秦昭襄王四十八年，司马耿北定太原。庄襄王二年，使蒙骜攻赵...","context_before":"...传》：定十三年，赵鞅入于晋阳以叛，其后简子使尹铎为晋阳，","source_end_index":334,"source_paragraph_tongjian_id":"02f1ca4e-71d1-5803-94e9-8670f591db2d","source_start_index":296,"source_text":"及知伯攻赵，襄子走晋阳，知伯与韩、魏围而灌之，沉灶产蛙，民无叛意，卒灭知伯。"}],"path":"山西方舆纪要/一、太原府（卷四十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"趙襄子使張孟談潛出見二子，曰：「臣聞脣亡則齒寒。今智伯帥韓、魏以攻趙，趙亡則韓、魏爲之次矣。」二子曰：「我心知其然也；恐事未遂而謀泄，則禍立至矣。」張孟談曰：「謀出二主之口，入臣之耳，何傷也！」二子乃潛與張孟談約，爲之期日而遣之。襄子夜使人殺守隄之吏，而決水灌智伯軍。智伯軍救水而亂，韓、魏翼而擊之，襄子將卒犯其前，大敗智伯之衆，遂殺智伯，盡滅智氏之族。唯輔果在。","content_fanyi":"赵襄子派张孟谈秘密出城去见韩、魏二子，说：“我听说唇亡则齿寒。如今智伯统率韩、魏两军攻打赵氏，赵氏灭亡之后，韩、魏就是接下来的了。”韩康子、魏桓子说：“我们心里知道会是这样；只是怕事情还没成功而计谋泄露，那么灾祸立刻就会到来。”张孟谈说：“计谋从两位主人口中说出，只进入我一个人的耳中，有什么妨害呢！”二人于是暗中与张孟谈约定，定好行动的日期后送走了他。赵襄子趁夜派人杀死智伯军守堤的官吏，并决开河水灌淹智伯军营。智伯军因救水而陷入混乱，韩、魏从两翼夹击，赵襄子率领士卒冲击智伯军正面，大败智伯的军队，随后杀死智伯，将智氏族人全部诛灭。只有辅果幸免。","content_jianti_auto":"赵襄子使张孟谈潜出见二子，曰：「臣闻唇亡则齿寒。今智伯帅韩、魏以攻赵，赵亡则韩、魏为之次矣。」二子曰：「我心知其然也；恐事未遂而谋泄，则祸立至矣。」张孟谈曰：「谋出二主之口，入臣之耳，何伤也！」二子乃潜与张孟谈约，为之期日而遣之。襄子夜使人杀守隄之吏，而决水灌智伯军。智伯军救水而乱，韩、魏翼而击之，襄子将卒犯其前，大败智伯之众，遂杀智伯，尽灭智氏之族。唯辅果在。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 16 段","reading_annotation_sources":[],"start_index":15,"tongjian_id":"8bef6580-db0e-11ef-ab45-a0d3651f611f","year_int":-403},"tongjian_id":"8bef6580-db0e-11ef-ab45-a0d3651f611f"},"paragraph_order":1}],"page_size":7,"total_pages":1,"total_paragraphs":1},"profile":{"alias_list":["张谈","张孟同"],"biography":"张孟谈，《国语》中作张谈，姬姓，张氏。中国战国时期晋国赵襄子的家臣，曾经在晋阳之战策动了韩氏、魏氏，合灭了智氏。《史记》中由于司马迁避讳父亲司马谈，以张孟同称呼。","link_td_id":"Q10003399","name":"张孟谈","number_id":3265647},"relationships":[{"direction":"forward","rank":"normal","relation_detail":"家臣关系，来源文本：中国战国时期晋国赵襄子的家臣","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10003399","source_person_name":"张孟谈","source_person_number_id":3265647,"statement_id":"S-Q10003399-P100061-Q10000663","target_person_id":"Q10000663","target_person_name":"赵襄子","target_person_number_id":334795},{"direction":"reverse","rank":"normal","relation_detail":"同僚关系，来源文本：赵襄子以尹铎待民宽厚，民众定能同赵氏和衷共济，家臣張孟談亦作出同樣建議","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10023383","source_person_name":"尹铎","source_person_number_id":8301824,"statement_id":"S-Q10023383-P100061-Q10003399","target_person_id":"Q10003399","target_person_name":"张孟谈","target_person_number_id":3265647}]},"message":"success","success":true}