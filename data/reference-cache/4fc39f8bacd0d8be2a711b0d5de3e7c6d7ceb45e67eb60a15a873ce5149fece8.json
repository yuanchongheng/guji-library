x":113,"tongjian_id":"9055e3a3-db0e-11ef-8c64-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-89,"link_td_description":"李广利，西汉时期将军，中山（今河北定州）人，汉武帝宠姬李夫人和宠臣李延年的哥哥。后来兵败投降匈奴，后被卫律猜忌而被杀害。","link_td_id":"Q10004232","link_td_number_id":215075,"people_name":"貳師","people_name_jianti_auto":"贰师","people_xingming":"李广利","start_index":118,"tongjian_id":"9055e3a4-db0e-11ef-8647-a0d3651f611f"},{"link_death_year":-96,"link_td_description":"公孙敖，义渠人，汉朝军事人物。","link_td_id":"Q10009481","link_td_number_id":717641,"people_name":"因杅","people_name_jianti_auto":"因杅","people_xingming":"公孙敖","start_index":140,"tongjian_id":"9055e3a5-db0e-11ef-828a-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","people_xingming":"左贤王","start_index":143,"tongjian_id":"9055e3a6-db0e-11ef-a9d6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"貳師","place_name_jianti_auto":"贰师","resolved_place_entity_id":2062,"start_index":13,"tongjian_id":"9055e398-db0e-11ef-a3c0-a0d3651f611f"},{"place_name":"朔方","place_name_jianti_auto":"朔方","place_note":"內蒙杭锦旗北黄河南岸","resolved_place_entity_id":206,"start_index":30,"tongjian_id":"9055e399-db0e-11ef-961e-a0d3651f611f"},{"place_name":"五原","place_name_jianti_auto":"五原","place_note":"內蒙包頭","resolved_place_entity_id":554,"start_index":62,"tongjian_id":"9055e39e-db0e-11ef-88fd-a0d3651f611f"},{"place_name":"因杅","place_name_jianti_auto":"因杅","resolved_place_entity_id":3640,"start_index":65,"tongjian_id":"9055e39f-db0e-11ef-b4bb-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","resolved_place_entity_id":496,"start_index":82,"tongjian_id":"9055e3a0-db0e-11ef-96c4-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":85,"tongjian_id":"9055e3a1-db0e-11ef-a468-a0d3651f611f"},{"place_name":"余吾水","place_name_jianti_auto":"余吾水","resolved_place_entity_id":3571,"start_index":96,"tongjian_id":"9055e3a2-db0e-11ef-9bf7-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"又昭帝元凤二年，匈奴复遣骑屯受降城以备汉，而北桥余吾水，...","context_before":"...州北塞外。《山海经》：北鲜诸山，鲜水出焉。北流注于余吾。","source_end_index":78,"source_paragraph_tongjian_id":"8d0bb313-e20b-51df-9c85-ce237bd979d7","source_start_index":35,"source_text":"汉武天汉四年，遣李广利出朔方击匈奴，匈奴悉远其累重于余吾水北，而以兵十万待水南，是也。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2發天下七科讁及勇敢士，遣貳師將軍李廣利將騎六萬、步兵七萬出朔方；強弩都尉路博德將萬餘人與貳師會；游擊將軍韓說將步兵三萬人出五原；因杅將軍公孫敖將騎萬、步兵三萬人出鴈門。匈奴聞之，悉遠其累重於余吾水北；而單于以兵十萬待水南，與貳師接戰。貳師解而引歸，與單于連鬬十餘日。游擊無所得。因杅與左賢王戰，不利，引歸。","content_fanyi":"征发天下七类被谪罚的人员以及勇士，命令贰师将军李广利率六万骑兵、七万步兵从朔方出塞；强弩都尉路博德率一万多人与贰师会合；游击将军韩说率三万步兵从五原出塞；因杅将军公孙敖率一万骑兵、三万名步兵从雁门出塞。匈奴得知汉军动向，把家属、财物全部远迁到余吾水以北；单于则率十万部队在余吾水南岸等待，与贰师将军接战。贰师将军李广利撤军退回，途中与单于连续交战十多天。游击将军韩说所部没有取得战果。因杅将军公孙敖与左贤王交战失利，率军退回。","content_jianti_auto":"2发天下七科讁及勇敢士，遣贰师将军李广利将骑六万、步兵七万出朔方；强弩都尉路博德将万余人与贰师会；游击将军韩说将步兵三万人出五原；因杅将军公孙敖将骑万、步兵三万人出鴈门。匈奴闻之，悉远其累重于余吾水北；而单于以兵十万待水南，与贰师接战。贰师解而引归，与单于连鬬十余日。游击无所得。因杅与左贤王战，不利，引归。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，法已苛矣，乃犹有正俗重农之意焉。吏有罪，一也；使为吏者...","context_before":"","source_end_index":10,"source_paragraph_tongjian_id":"9198f6af-7750-4aec-9a3a-f2180a7c5c25","source_start_index":0,"source_text":"汉发七科谪充战士征胡"}],"title":"二七 汉谪七科仍有重农正俗之意"}],"id":1782,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"9055e381-db0e-11ef-9f61-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9055e3aa-db0e-11ef-b817-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：大閼氏，單于之母。閼氏，音煙支。","note_content_jianti_auto":"师古曰：大阏氏，单于之母。阏氏，音烟支。","note_type":"hu_note","start_index":87,"tongjian_id":"9055e3a9-db0e-11ef-911c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"右校王","official_note":"右校王是匈奴官职，通常授予投降的汉将，负责军事事务，此处表示李陵在匈奴中被封此职，显示其地位提升。","official_rank":"未知","source_snippet":"立爲右校王","start_index":112,"tongjian_id":"8881be82-6bdb-463e-b36d-193eed9fb399"}],"ExtRef_Children_people":[{"link_death_year":-96,"link_td_description":"公孙敖，义渠人，汉朝军事人物。","link_td_id":"Q10009481","link_td_number_id":717641,"people_name":"敖","people_name_jianti_auto":"敖","people_xingming":"公孙敖","start_index":3,"tongjian_id":"9055e3ad-db0e-11ef-b3e7-a0d3651f611f"},{"link_death_year":-74,"link_td_description":"李陵，字少卿，陇西成纪人，西汉将领李广之孙，汉武帝期间曾以少击多攻打匈奴，但后来因政治事件考虑最终投降匈奴。","link_td_id":"Q10008004","link_td_number_id":6265,"people_name":"李陵","people_name_jianti_auto":"李陵","people_xingming":"李陵","start_index":9,"tongjian_id":"9055e3ae-db0e-11ef-a19d-a0d3651f611f"},{"link_death_year":-96,"link_td_description":"公孙敖，义渠人，汉朝军事人物。","link_td_id":"Q10009481","link_td_number_id":717641,"people_name":"敖","people_name_jianti_auto":"敖","people_xingming":"公孙敖","start_index":12,"tongjian_id":"9055e3af-db0e-11ef-b40f-a0d3651f611f"},{"link_death_year":-74,"link_td_description":"李陵，字少卿，陇西成纪人，西汉将领李广之孙，汉武帝期间曾以少击多攻打匈奴，但后来因政治事件考虑最终投降匈奴。","link_td_id":"Q10008004","link_td_number_id":6265,"people_name":"李陵","people_name_jianti_auto":"李陵","people_xingming":"李陵","start_index":28,"tongjian_id":"9055e3b0-db0e-11ef-9de5-a0d3651f611f"},{"link_death_year":-74,"link_td_description":"李陵，字少卿，陇西成纪人，西汉将领李广之孙，汉武帝期间曾以少击多攻打匈奴，但后来因政治事件考虑最终投降匈奴。","link_td_id":"Q10008004","link_td_number_id":6265,"people_name":"陵","people_name_jianti_auto":"陵","people_xingming":"李陵","start_index":51,"tongjian_id":"9055e3b1-db0e-11ef-8e40-a0d3651f611f"},{"link_td_description":"李绪，原西汉将领，後投降匈奴並為单于練兵對付汉军。","li