-db0e-11ef-8e03-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":8,"tongjian_id":"8bfa323a-db0e-11ef-9cb4-a0d3651f611f"},{"place_name":"咸林","place_name_jianti_auto":"咸林","start_index":19,"tongjian_id":"8bfa323b-db0e-11ef-ad79-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":23,"tongjian_id":"8bfa323c-db0e-11ef-8a0f-a0d3651f611f"},{"place_name":"鄭邑","place_name_jianti_auto":"郑邑","start_index":25,"tongjian_id":"8bfa323d-db0e-11ef-bce7-a0d3651f611f"},{"place_name":"虢","place_name_jianti_auto":"虢","start_index":40,"tongjian_id":"8bfa323e-db0e-11ef-a8d4-a0d3651f611f"},{"place_name":"鄶","place_name_jianti_auto":"郐","start_index":42,"tongjian_id":"8bfa323f-db0e-11ef-9736-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":52,"tongjian_id":"8bfa3240-db0e-11ef-b09d-a0d3651f611f"},{"place_name":"新鄭","place_name_jianti_auto":"新郑","start_index":54,"tongjian_id":"8bfa3241-db0e-11ef-a6fc-a0d3651f611f"},{"place_name":"陽翟縣","place_name_jianti_auto":"阳翟县","start_index":92,"tongjian_id":"8bfa3242-db0e-11ef-abbb-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":96,"tongjian_id":"8bfa3243-db0e-11ef-a75f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周宣王封其弟友於鄭。杜預世族譜曰：封於咸林，今京兆鄭邑是也。幽王無道，友徙其人於虢、鄶之間，遂有其地，今河南新鄭是也。友，諡桓公。是年，鄭繻公駘之二十三年。自桓公至繻公二十二世。班志，陽翟縣屬潁川郡。索隱曰：翟，音狄，溫公類篇音萇伯切。繻，詢趨翻。駘，堂來翻。","note_content_jianti_auto":"周宣王封其弟友于郑。杜预世族谱曰：封于咸林，今京兆郑邑是也。幽王无道，友徙其人于虢、郐之间，遂有其地，今河南新郑是也。友，谥桓公。是年，郑𦈡公骀之二十三年。自桓公至𦈡公二十二世。班志，阳翟县属颍川郡。索隐曰：翟，音狄，温公类篇音苌伯切。𦈡，询趋翻。骀，堂来翻。","note_type":"hu_note","start_index":7,"tongjian_id":"8bfa322d-db0e-11ef-a2e1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄭","place_name_jianti_auto":"郑","place_note":"府新郑，河南新郑","resolved_place_entity_id":512,"start_index":1,"tongjian_id":"8bfa3248-db0e-11ef-9019-a0d3651f611f"}],"ExtR