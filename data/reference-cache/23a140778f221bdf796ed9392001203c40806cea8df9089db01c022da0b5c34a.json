651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄭","place_name_jianti_auto":"郑","place_note":"府新郑，河南新郑","resolved_place_entity_id":512,"start_index":1,"tongjian_id":"8bfb1582-db0e-11ef-86e9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1鄭駟子陽之黨弑繻公，而立其弟乙，是爲康公。","content_fanyi":"郑国驷子阳的党羽弑杀郑繻公，拥立他的弟弟姬乙，即郑康公。","content_jianti_auto":"1郑驷子阳之党弑𦈡公，而立其弟乙，是为康公。","dtjl_paragraph_links":[],"dtjl_references":[],"id":43,"number":1,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 六年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8bfb157a-db0e-11ef-ae25-a0d3651f611f","year_int":-396},"tongjian_id":"8bfb157a-db0e-11ef-ae25-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"鄭","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"繻公","people_name_jianti_auto":"𦈡公","start_index":4,"tongjian_id":"8bfd663f-db0e-11ef-b269-a0d3651f611f"},{"people_name":"劉昭","people_name_jianti_auto":"刘昭","start_index":32,"tongjian_id":"8bfd6640-db0e-11ef-a057-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","start_index":12,"tongjian_id":"8bfd6641-db0e-11ef-b7b9-a0d3651f611f"},{"place_name":"負黍","place_name_jianti_auto":"负黍","start_index":14,"tongjian_id":"8bfd6642-db0e-11ef-a177-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"府平阳，山西临汾","start_index":29,"tongjian_id":"8bfd6643-db0e-11ef-9dff-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":38,"tongjian_id":"8bfd6644-db0e-11ef-8d2d-a0d3651f611f"},{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":41,"tongjian_id":"8bfd6645-db0e-11ef-815e-a0d3651f611f"},{"place_name":"負黍聚","place_name_jianti_auto":"负黍聚","start_index":45,"tongjian_id":"8bfd6646-db0e-11ef-8170-a0d3651f611f"},{"place_name":"負黍","place_name_jianti_auto":"负黍","place_note":"河南登封西南","start_index":55,"tongjian_id":"8bfd6647-db0e-11ef-9036-a0d3651f611f"},{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":59,"tongjian_id":"8bfd6648-db0e-11ef-a96d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"據史記，繻公之十六年，敗韓於負黍，蓋以此時取之，而今復叛歸韓也。劉昭郡國志：潁川郡陽城縣有負黍聚。古今地名云：負黍山在陽城縣西南二十七里，或云在西南三十五里。","note_content_jianti_auto":"据史记，𦈡公之十六年，败韩于负黍，盖以此时取之，而今复叛归韩也。刘昭郡国志：颍川郡阳城县有负黍聚。古今地名云：负黍山在阳城县西南二十七里，或云在西南三十五里。","note_type":"hu_note","start_index":10,"tongjian_id":"8bfd4b9c-db0e-11ef-8700-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄭","place_name_jianti_auto":"郑","place_note":"府新郑，河南新郑","resolved_place_entity_id":512,"start_index":1,"tongjian_id":"8bfd664c-db0e-11ef-bd6a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"，《韩世家》：宣惠王十七年，秦拔我阳城、负黍。又《楚世家...","context_before":"...郑伐周负黍。《史记》：郑繻公十六年，伐韩，败韩兵于负黍。","source_end_index":87,"source_paragraph_tongjian_id":"fc547932-a08d-54e9-950c-647a323058a3","source_start_index":74,"source_text":"郑君乙二年，负黍反，复归韩"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2鄭負黍叛，復歸韓。","content_fanyi":"郑国的负黍反叛郑国，重新归附韩国。","content_jianti_auto":"2郑负黍叛，复归韩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":46,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 八年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bfd4b9b-db0e-11ef-b501-a0d3651f611f","year_int":-394},"tongjian_id":"8bfd4b9b-db0e-11ef-b501-a0d3651f611f"},"paragraph_order":4},