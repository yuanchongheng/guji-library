nnotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"南陽郡平氏縣東南有桐柏、大復山，淮水所出，東南至淮陵入海。泗水出魯國卞縣西南，至方與入沛。宋、魯、鄒、滕、薛、郳等國，國於其間。齊威王所謂「泗上十二諸侯」。","note_content_jianti_auto":"南阳郡平氏县东南有桐柏、大复山，淮水所出，东南至淮陵入海。泗水出鲁国卞县西南，至方与入沛。宋、鲁、邹、滕、薛、郳等国，国于其间。齐威王所谓「泗上十二诸侯」。","note_type":"hu_note","start_index":41,"tongjian_id":"8c1ffd69-db0e-11ef-a6da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周宣王","people_name_jianti_auto":"周宣王","start_index":3,"tongjian_id":"8c205108-db0e-11ef-bed7-a0d3651f611f"},{"people_name":"鄭桓公","people_name_jianti_auto":"郑桓公","start_index":8,"tongjian_id":"8c205109-db0e-11ef-bf26-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":14,"tongjian_id":"8c20510a-db0e-11ef-b634-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":103,"tongjian_id":"8c20510b-db0e-11ef-9b6e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄭縣","place_name_jianti_auto":"郑县","place_note":"陝西華縣","start_index":0,"tongjian_id":"8c20510c-db0e-11ef-ae72-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":17,"tongjian_id":"8c20510d-db0e-11ef-911f-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":20,"tongjian_id":"8c20510e-db0e-11ef-b7de-a0d3651f611f"},{"place_name":"伊","place_name_jianti_auto":"伊","start_index":26,"tongjian_id":"8c20510f-db0e-11ef-b190-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":28,"tongjian_id":"8c205110-db0e-11ef-8e48-a0d3651f611f"},{"place_name":"渭水","place_name_jianti_auto":"渭水","start_index":37,"tongjian_id":"8c205111-db0e-11ef-a747-a0d3651f611f"},{"place_name":"華陰縣","place_name_jianti_auto":"华阴县","start_index":41,"tongjian_id":"8c205112-db0e-11ef-9819-a0d3651f611f"},{"place_name":"洛水","place_name_jianti_auto":"洛水","start_index":46,"tongjian_id":"8c205113-db0e-11ef-a123-a0d3651f611f"},{"place_name":"洛水","place_name_jiant