11ef-8d1d-a0d3651f611f"},{"people_name":"丁","people_name_jianti_auto":"丁","start_index":82,"tongjian_id":"9081d1a9-db0e-11ef-815a-a0d3651f611f"},{"people_name":"外人","people_name_jianti_auto":"外人","start_index":86,"tongjian_id":"9081d1aa-db0e-11ef-a4b0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蓋縣","place_name_jianti_auto":"盖县","start_index":4,"tongjian_id":"9081d1ab-db0e-11ef-8d98-a0d3651f611f"},{"place_name":"泰山郡","place_name_jianti_auto":"泰山郡","start_index":7,"tongjian_id":"9081d1ac-db0e-11ef-8a01-a0d3651f611f"},{"place_name":"鄂","place_name_jianti_auto":"鄂","start_index":18,"tongjian_id":"9081d1ad-db0e-11ef-a24a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志，蓋縣屬泰山郡。師古曰：食邑於鄂，爲蓋侯所尚，故曰蓋長公主。長公主儀比諸王，帝姊妹乃稱之。蓋侯王充，武帝舅王信之子，襲爵。蓋，如字，又古盍翻。子客，子賓客也。丁，姓；外人，其名。長，知兩翻；下同。近，其靳翻。","note_content_jianti_auto":"地理志，盖县属泰山郡。师古曰：食邑于鄂，为盖侯所尚，故曰盖长公主。长公主仪比诸王，帝姊妹乃称之。盖侯王充，武帝舅王信之子，袭爵。盖，如字，又古盍翻。子客，子宾客也。丁，姓；外人，其名。长，知两翻；下同。近，其靳翻。","note_type":"hu_note","start_index":75,"tongjian_id":"9081d1a1-db0e-11ef-ab07-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9081d1b1-db0e-11ef-aff6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"椒房殿","place_name_jianti_auto":"椒房殿","start_index":4,"tongjian_id":"9081d1b2-db0e-11ef-a2f3-a0d3651f611f"},{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":8,"tongjian_id":"9081d1b3-db0e-11ef-affc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：椒房殿在未央宮中，皇后所居；以椒和泥塗壁，取其溫而芳。朝，直遙翻。","note_content_jianti_auto":"师古曰：椒房殿在未央宫中，皇后所居；以椒和泥涂壁，取其温而芳。朝，直遥翻。","note_type":"hu_note","start_index":118,"tongjian_id":"9081d1b0-db0e-11ef-b9b1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type