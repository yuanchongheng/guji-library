b0e-11ef-b0b5-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":47,"tongjian_id":"8bf42b00-db0e-11ef-8900-a0d3651f611f"},{"place_name":"定州","place_name_jianti_auto":"定州","start_index":48,"tongjian_id":"8bf42b01-db0e-11ef-afd3-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":51,"tongjian_id":"8bf42b02-db0e-11ef-82a0-a0d3651f611f"},{"place_name":"白狄","place_name_jianti_auto":"白狄","start_index":53,"tongjian_id":"8bf42b03-db0e-11ef-a829-a0d3651f611f"},{"place_name":"鮮虞","place_name_jianti_auto":"鲜虞","start_index":55,"tongjian_id":"8bf42b04-db0e-11ef-8253-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","place_note":"都顾城，河北定州","start_index":65,"tongjian_id":"8bf42b05-db0e-11ef-8867-a0d3651f611f"},{"place_name":"唐昌縣","place_name_jianti_auto":"唐昌县","start_index":70,"tongjian_id":"8bf42b06-db0e-11ef-801a-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","place_note":"都顾城，河北定州","start_index":80,"tongjian_id":"8bf42b07-db0e-11ef-89fa-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":98,"tongjian_id":"8bf42b08-db0e-11ef-b3ea-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"樂，姓也。本自有殷微子之後。宋戴公四世孫樂呂爲大司寇。中山，春秋之鮮虞也，漢爲中山郡。宋白曰：唐定州，春秋白狄鮮虞之地。隋圖經曰：中山城在今唐昌縣東北三十一里，中山故城是也。杜佑曰：城中有山，故曰中山。","note_content_jianti_auto":"乐，姓也。本自有殷微子之后。宋戴公四世孙乐吕为大司寇。中山，春秋之鲜虞也，汉为中山郡。宋白曰：唐定州，春秋白狄鲜虞之地。隋图经曰：中山城在今唐昌县东北三十一里，中山故城是也。杜佑曰：城中有山，故曰中山。","note_type":"hu_note","start_index":10,"tongjian_id":"8bf42af3-db0e-11ef-bc61-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"任座","people_name_jianti_auto":"任座","start_index":0,"tongjian_id":"8bf42b0b-db0e-11ef-afae-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"任座亦習見當時鄰國之事而爲是言耳。任，音壬。「座」一作「痤」，音才戈翻。","note_content_jianti_auto":"任座亦习见当时邻国之事而为是言耳。任，音壬。「座」一作「痤」，音才戈翻。","note_type":"hu_note","start_index":77,"tongjian_id":"8bf42b0a-db0e-11ef-9954-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"翟","people_name_jianti_auto":"翟","start_index":0,"tongjian_id":"8bf42b0d-db0e-11ef-b4db-a0d3651f611f"},{"people_name":"翟","people_name_jianti_auto":"翟","start_index":17,"tongjian_id":"8bf42b0e-db0e-11ef-9783-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":19,"tongjian_id":"8bf42b0f-db0e-11ef-8d4c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"翟，姓也，音直格翻，又音狄。姓譜：翟爲晉所滅，子孫以國爲氏。今人多讀從上音。璜，戶光翻。","note_content_jianti_auto":"翟，姓也，音直格翻，又音狄。姓谱：翟为晋所灭，子孙以国为氏。今人多读从上音。璜，户光翻。","note_type":"hu_note","start_index":82,"tongjian_id":"8bf42b0c-db0e-11ef-87da-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"擊","people_name_jianti_auto":"击","people_xingming":"魏击","start_index":14,"tongjian_id":"8bf42b13-db0e-11ef-86a8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/中山宜阳","excerpts":[{"context_after":"。故任座云：“君得中山不以封君之弟，而以封君之子。”翟璜...","context_before":"战国事杂出于诸书，故有不可考信者。","source_end_index":34,"source_paragraph_tongjian_id":"899ca649-bbb0-4456-a935-4efcdb628196","source_start_index":17,"source_text":"魏文侯使乐羊伐中山，克之，以封其子"}],"path":"续笔/卷四/中山宜阳","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/四、真定府（卷十四）","excerpts":[{"context_after":"秦属巨鹿郡。汉为新市县。景帝封王弃之为侯邑，属中山国。魏...","context_before":"...中，晋荀寅谓中山不服。哀三年，齐卫求援于中山，即鲜虞也。","source_end_index":112,"source_paragraph_tongjian_id":"41366cbc-babd-53c9-b4e4-b1616ca2baff","source_start_index":85,"source_text":"战国时，乐羊为魏文侯将，攻中山，三年而克之。没为赵地。"},{"context_after":"又赵惠文王二年，主父起灵寿北地，方从代道大通。汉因置灵寿...","context_before":"○灵寿城[在今县城东。《汉志》：中山桓公徙都灵寿。","source_end_index":48,"source_paragraph_tongjian_id":"901a297e-c146-5545-8081-082ee60b339d","source_start_index":25,"source_text":"《史记》：乐羊为魏文侯将，攻拔中山，封之灵寿。"},{"context_after":"赵武灵王伐取之]。秦为上谷、巨鹿二郡地。汉初置中山郡，景...","context_before":"春秋时鲜虞国地。战国初为中山国，寻为魏所并，后又属赵[","source_end_index":51,"source_paragraph_tongjian_id":"1130cfac-da26-5df4-8bd6-afcf4f6b94e5","source_start_index":27,"source_text":"魏文侯时，使乐羊伐中山，取之。既而中山复有其地。"}],"path":"北直方舆纪要/四、真定府（卷十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"使樂羊伐中山，克之；以封其子擊。文侯問於羣臣曰：「我何如主？」皆曰：「仁君。」任座曰：「君得中山，不以封君之弟而以封君之子，何謂仁君！」文侯怒，任座趨出。次問翟璜，對曰：「仁君。」文侯曰：「何以知之？」對曰：「臣聞君仁則臣直。嚮者任座之言直，臣是以知之。」文侯悅，使翟璜召任座而反之，親下堂迎之，以爲上客。","content_fanyi":"魏文侯派乐羊攻打中山国，攻克了它；把它封给自己的儿子魏击。魏文侯问群臣说：“我是怎样的君主？”大家都说：“是仁君。”任座说：“您取得了中山，不把它封给您的弟弟，却封给自己的儿子，怎么能说是仁君！”魏文侯大怒，任座急忙退出朝堂。魏文侯接着问翟璜，翟璜回答说：“是仁君。”魏文侯问：“你凭什么知道我是仁君？”翟璜回答说：“我听说国君仁爱，臣子就正直。刚才任座的话正直，我因此知道您是仁君。”魏文侯很高兴，派翟璜去召任座回朝堂，并亲自下堂迎接他，待他为上客。","content_jianti_auto":"使乐羊伐中山，克之；以封其子击。文侯问于群臣曰：「我何如主？」皆曰：「仁君。」任座曰：「君得中山，不以封君之弟而以封君之子，何谓仁君！」文侯怒，任座趋出。次问翟璜，对曰：「仁君。」文侯曰：「何以知之？」对曰：「臣闻君仁则臣直。向者任座之言直，臣是以知之。」文侯悦，使翟璜召任座而反之，亲下堂迎之，以为上客。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 23 段","reading_annotation_sources":[],"start_index":22,"tongjian_id":"8bf42af2-db0e-11ef-899a-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000342"},"tongjian_id":"8bf42af2-db0e-11ef-899a-a0d3651f611f"},"paragraph_order":1},{"mention_count":3,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":6,"tongjian_id":"8bf67666-db0e-11ef-aa2e-a0d3651f611f"},{"people_name":"少昊氏","people_name_jianti_auto":"少昊氏","start_index":16,"tongjian_id":"8bf67667-db0e-11ef-a99d-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":22,"tongjian_id":"8bf67668-db0e-11ef-9cca-a0d3651f611f"},{"people_name":"奚仲","people_name_jianti_auto":"奚仲","start_index":24,"tongjian_id":"8bf67669-db0e-11ef-97d8-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":38,"tongjian_id":"8bf6766a-db0e-11ef-bf21-a0d3651f611f"},{"people_name":"蕭子顯","people_name_jianti_auto":"萧子显","start_index":60,"tongjian_id":"8bf6766b-db0e-11ef-9e68-a0d3651f611f"},{"people_name":"三皇氏","people_name_jianti_auto":"三皇氏","start_index":65,"tongjian_id":"8bf6766c-db0e-11ef-8f57-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":49,"tongjian_id":"8bf6766d-db0e-11ef-9b47-a0d3651f611f"},{"place_name":"谷口","place_name_jianti_auto":"谷口","start_index":72,"tongjian_id":"8bf6766e-db0e-11ef-a7d4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古文史考曰：黃帝作車，引重致遠；少昊氏加牛；禹時奚仲加馬。釋名曰：車，居也。韋昭曰：古唯尺遮翻，自漢以來，始有「居」音。蕭子顯曰：三皇氏乘祇車出谷口，車之始也。祇，翹移翻。","note_content_jianti_auto":"古文史考曰：黄帝作车，引重致远；少昊氏加牛；禹时奚仲加马。释名曰：车，居也。韦昭曰：古唯尺遮翻，自汉以来，始有「居」音。萧子显曰：三皇氏乘祇车出谷口，车之始也。祇，翘移翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8bf67665-db0e-11ef-9ece-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"子擊","people_name_jianti_auto":"子击","people_xingming":"魏击","start_index":0,"tongjian_id":"8bf67672-db0e-11ef-986f-a0d3651f611f"},{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"子擊","people_name_jianti_auto":"子击","people_xingming":"魏击","start_index":22,"tongjian_id":"8bf67675-db0e-11ef-99db-a0d3651f611f"},{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"子擊","people_name_jianti_auto":"子击","people_xingming":"魏击","start_index":147,"tongjian_id":"8bf67678-db0e-11ef-b651-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"子擊出，遭田子方於道，下車伏謁。子方不爲禮。子擊怒，謂子方曰：「富貴者驕人乎？貧賤者驕人乎？」子方曰：「亦貧賤者驕人耳，富貴者安敢驕人！國君而驕人則失其國，大夫而驕人則失其家。失其國者未聞有以國待之者也，失其家者未聞有以家待之者也。夫士貧賤者，言不用，行不合，則納履而去耳，安往而不得貧賤哉！」子擊乃謝之。","content_fanyi":"魏文侯的儿子魏击一次外出，在路上遇到田子方，便下车伏地拜见问好。田子方却不回礼。魏击大怒，对田子方说：“是富贵的人能傲慢待人呢，还是贫贱的人能傲慢待人呢？”田子方说：“只是贫贱的人才能对人傲慢罢了，富贵的人哪里敢对人傲慢呢！身为国君如果傲慢待人，就会失去他的国家；身为大夫如果傲慢待人，就会失去他的封邑。失去国家的人，从没听说有人会以国君之礼对待他；失去封邑的人，也从没听说有人会以大夫之礼对待他。至于那些贫贱的士人，进言不被采用，行事不合人意，就穿上鞋子离开罢了，到哪里还不都是贫贱呢！”魏击于是向田子方道歉。","content_jianti_auto":"子击出，遭田子方于道，下车伏谒。子方不为礼。子击怒，谓子方曰：「富贵者骄人乎？贫贱者骄人乎？」子方曰：「亦贫贱者骄人耳，富贵者安敢骄人！国君而骄人则失其国，大夫而骄人则失其家。失其国者未闻有以国待之者也，失其家者未闻有以家待之者也。夫士贫贱者，言不用，行不合，则纳履而去耳，安往而不得贫贱哉！」子击乃谢之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"8bf67664-db0e-11ef-b8a4-a0d3651f611f","year_int":-403},"tongjian_id":"8bf67664-db0e-11ef-b8a4-a0d3651f611f"},"paragraph_order":2},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":30,"tongjian_id":"8bffbbe4-db0e-11ef-a7c5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":23,"tongjian_id":"8bffbbe5-db0e-11ef-a0ca-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"王者以嫡長子爲太子，謂之國儲副君。諸侯曰世子。周衰，率上僭。孔穎達曰：太者，大中之大也。上，時掌翻。長，知兩翻。","note_content_jianti_auto":"王者以嫡长子为太子，谓之国储副君。诸侯曰世子。周衰，率上僭。孔颖达曰：太者，大中之大也。上，时掌翻。长，知两翻。","note_type":"hu_note","start_index":11,"tongjian_id":"8bffbbe3-db0e-11ef-9466-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"擊","people_name_jianti_auto":"击","people_xingming":"魏击","start_index":8,"tongjian_id":"8bffbbe7-db0e-11ef-8bac-a0d3651f611f"},{"link_death_year":-370,"link_td_description":"魏武侯，中国战国时魏国君主，姬姓，魏氏，名击。前396年继魏文侯位，前370年卒。","link_td_id":"Q10001005","link_td_number_id":265362,"people_name":"武侯","people_name_jianti_auto":"武侯","people_xingming":"魏击","start_index":13,"tongjian_id":"8bffbbe8-db0e-11ef-88ea-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/卜子夏","excerpts":[{"context_after":"。姑以始侯之岁计之，则子夏已百三岁矣，方为诸侯师，岂其然...","context_before":"...魏始为侯，去孔子卒时七十五年。文侯为大夫二十二年而为侯，","source_end_index":110,"source_paragraph_tongjian_id":"4b1e305c-9d40-4764-94a5-a5aa733b8bdd","source_start_index":104,"source_text":"又十六年而卒"}],"path":"续笔/卷二/卜子夏","source_name":"容斋随笔"}],"class_tags":[],"content":"2魏文侯薨，太子擊立，是爲武侯。","content_fanyi":"魏文侯去世，太子魏击即位，是为魏武侯。","content_jianti_auto":"2魏文侯薨，太子击立，是为武侯。","dtjl_paragraph_links":[],"dtjl_references":[],"id":57,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 十五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bffbbe2-db0e-11ef-9aaf-a0d3651f611f","year_int":-387},"tongjian_id":"8bffbbe2-db0e-11ef-9aaf-a0d3651f611f"},"paragraph_order":3},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annota