{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲戌、八五四）","note_content_jianti_auto":"（甲戌、八五四）","note_type":"hu_note","start_index":0,"tongjian_id":"c4c18124-db0e-11ef-903b-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，丙戌朔，日有食之。罷元會。","content_fanyi":"春季，正月初一丙戌，发生日食。停止举行元旦朝会。","content_jianti_auto":"1春，正月，丙戌朔，日有食之。罢元会。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25401,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c4c18125-db0e-11ef-948d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宣宗","people_name_jianti_auto":"宣宗","start_index":0,"tongjian_id":"c4c18128-db0e-11ef-aa4e-a0d3651f611f"},{"people_name":"郭后","people_name_jianti_auto":"郭后","start_index":3,"tongjian_id":"c4c18129-db0e-11ef-8043-a0d3651f611f"},{"people_name":"穆宗","people_name_jianti_auto":"穆宗","start_index":23,"tongjian_id":"c4c1812a-db0e-11ef-b2e7-a0d3651f611f"},{"people_name":"陳弘志","people_name_jianti_auto":"陈弘志","start_index":29,"tongjian_id":"c4c1812b-db0e-11ef-9033-a0d3651f611f"},{"people_name":"文宗","people_name_jianti_auto":"文宗","start_index":37,"tongjian_id":"c4c1812c-db0e-11ef-a770-a0d3651f611f"},{"people_name":"穆宗","people_name_jianti_auto":"穆宗","start_index":40,"tongjian_id":"c4c1812d-db0e-11ef-b837-a0d3651f611f"},{"people_name":"文宗","people_name_jianti_auto":"文宗","start_index":47,"tongjian_id":"c4c1812e-db0e-11ef-b299-a0d3651f611f"},{"people_name":"商臣","people_name_jianti_auto":"商臣","start_index":74,"tongjian_id":"c4c1812f-db0e-11ef-8948-a0d3651f611f"},{"people_name":"潘崇","people_name_jianti_auto":"潘崇","start_index":81,"tongjian_id":"c4c18130-db0e-11ef-8480-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"景陵","place_name_jianti_auto":"景陵","start_index":5,"tongjian_id":"c4c18131-db0e-11ef-b7e9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宣宗絕郭后景陵之合葬，誅元和東宮之官屬，則以爲穆宗母子誠預陳弘志之謀者。然文宗於穆宗，父子也。文宗憤元和逆黨，欲盡誅之而不克，以成甘露之禍。使父果爲商臣，則子必爲潘崇諱矣。","note_content_jianti_auto":"宣宗绝郭后景陵之合葬，诛元和东宫之官属，则以为穆宗母子诚预陈弘志之谋者。然文宗於穆宗，父子也。文宗愤元和逆党，欲尽诛之而不克，以成甘露之祸。使父果为商臣，则子必为潘崇讳矣。","note_type":"hu_note","start_index":32,"tongjian_id":"c4c18127-db0e-11ef-8be6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"溫公","people_name_jianti_auto":"温公","start_index":0,"tongjian_id":"c4c18133-db0e-11ef-b995-a0d3651f611f"},{"people_name":"郭后","people_name_jianti_auto":"郭后","start_index":3,"tongjian_id":"c4c18134-db0e-11ef-90aa-a0d3651f611f"},{"people_name":"王皞","people_name_jianti_auto":"王皞","start_index":8,"tongjian_id":"c4c18135-db0e-11ef-9821-a0d3651f611f"},{"people_name":"王皞","people_name_jianti_auto":"王皞","start_index":25,"tongjian_id":"c4c18136-db0e-11ef-941e-a0d3651f611f"},{"people_name":"懿宗","people_name_jianti_auto":"懿宗","start_index":44,"tongjian_id":"c4c18137-db0e-11ef-aa70-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"溫公於郭后之崩，王皞之貶，旣詳書之矣；復書此詔。然王皞之議，卒伸於咸通之初，通鑑又書之。懿宗以子繼父，而天理所在者公議所在，不可得而違也，不可得而揜也。讀通鑑者宜以是觀之。","note_content_jianti_auto":"温公于郭后之崩，王皞之贬，既详书之矣；复书此诏。然王皞之议，卒伸于咸通之初，通鉴又书之。懿宗以子继父，而天理所在者公议所在，不可得而违也，不可得而揜也。读通鉴者宜以是观之。","note_type":"hu_note","start_index":65,"tongjian_id":"c4c18132-db0e-11ef-b929-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，一從、再從、三從兄之親。族，袒免以外之親也。從，才用翻。","note_content_jianti_auto":"从，一从、再从、三从兄之亲。族，袒免以外之亲也。从，才用翻。","note_type":"hu_note","start_index":79,"tongjian_id":"c4c1813a-db0e-11ef-9270-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"東宮官屬","official_note":"東宮官屬指太子東宮的官員，包括太子太傅、少傅等，負責教導和輔佐太子。在《資治通鑑》此段中，宣宗皇帝治理弒憲宗之黨，涉及東宮官屬，顯示當時政治清洗擴大到太子相關人員，可能反映宮廷鬥爭或對太子勢力的控制。此信息基於《資治通鑑》原文和歷史常識。","official_rank":"未知","source_snippet":"東宮官屬","start_index":26,"tongjian_id":"c812c3ed-d012-40af-b88a-ed0855dca74a"}],"ExtRef_Children_people":[{"link_birth_year":778,"link_death_year":820,"link_td_description":"唐宪宗李纯，原名李淳，唐朝皇帝，805年－820年在位。唐宪宗通过宦官俱文珍等人的协助，迫使父亲唐顺宗让位予自己，即“永贞内禅”。即位后，曾一度讨平不服朝廷的藩镇，短暂终结藩镇割据，重新统一中国，史称“元和中兴”。","link_td_id":"Q10000089","link_td_number_id":53576,"people_name":"憲宗","people_name_jianti_auto":"宪宗","people_xingming":"李纯","start_index":10,"tongjian_id":"c4c1813b-db0e-11ef-bdf5-a0d3651f611f","wl_zhushi":"[李纯]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c4c18126-db0e-11ef-9d9d-a0d3651f611f","pinyin":"tì","source_anchor_text":"賊子頃搜擿餘黨流竄","source_key":"baiyang_epub","start_index":56,"text":"擿","tongjian_id":"7b65de71-ecf1-5bf0-af45-1599f0b81d4f"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","权争"],"content":"2上自卽位以來，治弒憲宗之黨，宦官、外戚乃至東宮官屬，誅竄甚衆。慮人情不安，丙申，詔：「長慶之初，亂臣賊子，頃搜擿餘黨，流竄已盡，其餘族從疏遠者，一切不問。」","content_fanyi":"宣宗自从即位以来，处治弑杀宪宗的党羽，包括宦官、外戚乃至东宫官属，受到诛杀流放的人很多。担心人心不安，正月十一日丙申，下诏说：“长庆初年的乱臣贼子，近来已搜捕余党，流放发配已尽，其余同族中亲疏远近的人，一概不再追究。”","content_jianti_auto":"2上自即位以来，治弑宪宗之党，宦官、外戚乃至东宫官属，诛窜甚众。虑人情不安，丙申，诏：「长庆之初，乱臣贼子，顷搜擿余党，流窜已尽，其余族从疏远者，一切不问。」","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，郭氏迫欲坠楼。弑逆之迹，暴露于论定之后，则宪宗之贼，非...","context_before":"考诸稗官之传记，宣宗既立，","source_end_index":18,"source_paragraph_tongjian_id":"3f1aa025-5ef3-4fa7-999b-219195c4d563","source_start_index":13,"source_text":"追宪宗之雠"}],"title":"一八 宪宗被弑陈弘志非戎首"}],"id":25402,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c4c18126-db0e-11ef-9d9d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李德裕","people_name_jianti_auto":"李德裕","start_index":0,"tongjian_id":"c4c3caad-db0e-11ef-99f4-a0d3651f611f"},{"people_name":"牛僧孺","people_name_jianti_auto":"牛僧孺","start_index":4,"tongjian_id":"c4c3caae-db0e-11ef-a7cf-a0d3651f611f"},{"people_name":"德裕","people_name_jianti_auto":"德裕","start_index":10,"tongjian_id":"c4c3caaf-db0e-11ef-bf4d-a0d3651f611f"},{"people_name":"僧孺","people_name_jianti_auto":"僧孺","start_index":15,"tongjian_id":"c4c3cab0-db0e-11ef-8c65-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李德裕排牛僧孺；上惡德裕；故親僧孺之子。","note_content_jianti_auto":"李德裕排牛僧孺；上恶德裕；故亲僧孺之子。","note_type":"hu_note","start_index":72,"tongjian_id":"c4c3caac-db0e-11ef-b021-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"中書門下","official_note":"中書門下是唐代中后期的宰相机构，负责决策和行政事务，此处表示该机构上奏朝廷。","official_rank":"未知","source_snippet":"中書門下奏","start_index":3,"tongjian_id":"f801aeea-06f2-48d5-8b45-9f95a27869a2"},{"confidence":0.85,"official_category":"监察","official_name":"拾遺","official_note":"拾遺是唐代谏官，负责规谏皇帝过失，此处表示该官职有缺员需要增补。","official_rank":"从八品上","source_snippet":"拾遺、補闕缺員","start_index":9,"tongjian_id":"42654664-0b3b-4481-99d4-de48d5904390"},{"confidence":0.85,"official_category":"监察","official_name":"補闕","official_note":"補闕是唐代谏官，职责与拾遺类似，负责补正皇帝决策，此处表示该官职有缺员需要增补。","official_rank":"从七品上","source_snippet":"拾遺、補闕缺員","start_index":12,"tongjian_id":"7885ffb0-4f70-40aa-87f8-bbd8eb88aff9"},{"confidence":0.8,"official_category":"监察","official_name":"諫官","official_note":"諫官泛指负责进谏的官员，如拾遺、補闕等，此处皇帝强调其职责在于履行职责而非人数多寡。","official_rank":"未知","source_snippet":"諫官要在舉職","start_index":24,"tongjian_id":"4474c7c1-08fb-4cbc-a7c2-1d0921e6c69b"}],"ExtRef_Children_people":[{"people_name":"張道符","people_name_jianti_auto":"张道符","people_xingming":"张道符","start_index":40,"tongjian_id":"c4c3cab1-db0e-11ef-ae3d-a0d3651f611f"},{"people_name":"牛叢","people_name_jianti_auto":"牛丛","people_xingming":"牛丛","start_index":44,"tongjian_id":"c4c3cab2-db0e-11ef-8bd6-a0d3651f611f"},{"link_td_description":"赵璘，字泽章。平原（今属山东）人，唐朝政治人物。","link_td_id":"Q10010741","link_td_number_id":1125131,"people_name":"趙璘","people_name_jianti_auto":"赵璘","people_xingming":"赵璘","start_index":47,"tongjian_id":"c4c3cab3-db0e-11ef-ac32-a0d3651f611f"},{"people_name":"叢","people_name_jianti_auto":"丛","people_xingming":"牛丛","start_index":64,"tongjian_id":"c4c3cab4-db0e-11ef-99a8-a0d3651f611f"},{"link_birth_year":779,"link_death_year":848,"link_td_description":"牛僧孺，字思黯，陇西人。是唐朝著名大臣，牛李党争的牛派领袖，领导科举新秀进士对抗士族李派。一般认为牛僧孺是古典小说《玄怪录》的作者。","link_td_id":"Q10001769","link_td_number_id":278348,"people_name":"僧孺","people_name_jianti_auto":"僧孺","people_xingming":"牛僧孺","start_index":66,"tongjian_id":"c4c3cab5-db0e-11ef-9cc3-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"3二月，中書門下奏，拾遺、補闕缺員，請更增補。上曰：「諫官要在舉職，不必人多，如張道符、牛叢、趙璘輩數人，使朕日聞所不聞足矣。」叢，僧孺之子也。","content_fanyi":"二月，中书门下上奏说，拾遗、补阙官员出现缺额，请求再增补一些。宣宗说：“谏官重要的是尽忠职守，不一定要人员多，像张道符、牛丛、赵璘这几个人，让朕每天能听到一些平素听不到的事就足够了。”牛丛是牛僧孺的儿子。","content_jianti_auto":"3二月，中书门下奏，拾遗、补阙缺员，请更增补。上曰：「谏官要在举职，不必人多，如张道符、牛丛、赵璘辈数人，使朕日闻所不闻足矣。」丛，僧孺之子也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25403,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"c4c3caab-db0e-11ef-8d1e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"睦州","place_name_jianti_auto":"睦州","place_note":"浙江建德市","start_index":0,"tongjian_id":"c4c3cab8-db0e-11ef-bd6e-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":3,"tongjian_id":"c4c3cab9-db0e-11ef-9681-a0d3651f611f"},{"place_name":"新都郡","place_name_jianti_auto":"新都郡","start_index":5,"tongjian_id":"c4c3caba-db0e-11ef-b5c8-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":9,"tongjian_id":"c4c3cabb-db0e-11ef-9337-a0d3651f611f"},{"place_name":"睦州","place_name_jianti_auto":"睦州","start_index":11,"tongjian_id":"c4c3cabc-db0e-11ef-b52d-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":27,"tongjian_id":"c4c3cabd-db0e-11ef-ac1f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"睦州，吳置新都郡，隋置睦州，取俗阜人和、內外輯睦爲義，京師東南三千六百五十九里。","note_content_jianti_auto":"睦州，吴置新都郡，隋置睦州，取俗阜人和、内外辑睦为义，京师东南三千六百五十九里。","note_type":"hu_note","start_index":17,"tongjian_id":"c4c3cab7-db0e-11ef-ba49-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謝恩之後，前進而言。","note_content_jianti_auto":"谢恩之后，前进而言。","note_type":"hu_note","start_index":33,"tongjian_id":"c4c3cabe-db0e-11ef-9e98-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司勳員外郞","official_note":"司勳員外郞是唐代吏部司勳司的副长官，负责官员勋绩的评定和管理。在上下文中，这是人物丛之前的官职，表明他从中枢机构调任地方刺史。","official_rank":"从六品上","source_snippet":"叢自司勳員外郞出爲睦州刺史","start_index":6,"tongjian_id":"fbead06a-3a27-443b-9452-9f252f645544"},{"confidence":0.95,"official_category":"地方行政","official_name":"睦州刺史","official_note":"睦州刺史是唐代睦州（今浙江一带）的地方行政长官，负责州内政务。在上下文中，这是人物丛的新任命，显示他从中央调往地方任职。","official_rank":"正四品下","source_snippet":"叢自司勳員外郞出爲睦州刺史","start_index":13,"tongjian_id":"82d3d999-c5f5-4c77-8e66-4190457e7de5"},{"confidence":0.9,"official_category":"地方行政","official_name":"刺史","official_note":"刺史是唐代州级地方行政长官的泛称，负责治理州郡。在上下文中，这里指人物丛作为睦州刺史的身份，用于解释他之前所穿绯衣的来源。","official_rank":"未知","source_snippet":"臣所服緋，刺史所借也","start_index":38,"tongjian_id":"3ceea3b6-729b-438e-ba94-a31b92e443f3"},{"confidence":0.95,"official_category":"文教","official_name":"翰林學士","official_note":"翰林學士是唐代宫廷中的文学侍从官，负责起草诏令、参与机要。在上下文中，皇帝重视此官职，强调不因私情轻易授予官爵，体现了其重要性和皇帝对官员选拔的谨慎态度。","official_rank":"未知","source_snippet":"上重翰林學士","start_index":94,"tongjian_id":"ec6282bf-9dbd-4262-9cd6-4ed6e901d7c4"}],"ExtRef_Children_people":[{"people_name":"叢","people_name_jianti_auto":"丛","people_xingming":"牛丛","start_index":3,"tongjian_id":"c4c3cabf-db0e-11ef-990a-a0d3651f611f"},{"people_name":"叢","people_name_jianti_auto":"丛","people_xingming":"牛丛","start_index":25,"tongjian_id":"c4c3cac1-db0e-11ef-ae63-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"睦州","place_name_jianti_auto":"睦州","resolved_place_entity_id":1134,"start_index":12,"tongjian_id":"c4c3cac0-db0e-11ef-8059-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/绯紫假服","excerpts":[{"context_after":"然则唐制借服色得于君前服之，国朝之制，到阙则不许。乾道二...","context_before":"唐宣宗重惜服章，","source_end_index":58,"source_paragraph_tongjian_id":"930da185-83ef-4876-adb9-c233513761fe","source_start_index":8,"source_text":"牛丛自司勋员外郎为睦州刺史，上赐之紫，丛既谢，前言曰：“臣所服绯，刺史所借也。”上遽曰：“且赐绯。”"}],"path":"三笔/卷五/绯紫假服","source_name":"容斋随笔"}],"class_tags":["内政","人事"],"content":"久之，叢自司勳員外郞出爲睦州刺史，入謝，上賜之紫。叢旣謝，前言曰：「臣所服緋，刺史所借也。」上遽曰：「且賜緋。」上重惜服章，有司常具緋、紫衣數襲從行，以備賞賜，或半歲不用其一，故當時以緋、紫爲榮。上重翰林學士，至於遷官，必校歲月，以爲不可以官爵私近臣也。","content_fanyi":"过了一段时间，牛丛由司勋员外郎外调担任睦州刺史，入朝谢恩，宣宗赐给他紫衣。牛丛谢恩之后，上前对宣宗说：“臣所穿的绯衣，还是任刺史时借用的。”宣宗立即说：“暂且赐你绯衣。”宣宗十分珍惜显示品级的官服，有关部门经常准备绯衣、紫衣数件随行，以备赏赐使用，有时半年也用不上一件，所以当时人们以得到绯衣、紫衣为荣耀。宣宗看重翰林学士，对于官职升迁，必定核验任职年月，认为不应把官爵私自授予亲近的臣子。","content_jianti_auto":"久之，丛自司勋员外郞出为睦州刺史，入谢，上赐之紫。丛既谢，前言曰：「臣所服绯，刺史所借也。」上遽曰：「且赐绯。」上重惜服章，有司常具绯、紫衣数袭从行，以备赏赐，或半岁不用其一，故当时以绯、紫为荣。上重翰林学士，至于迁官，必校岁月，以为不可以官爵私近臣也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25404,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"c4c3cab6-db0e-11ef-92a5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"硤石","place_name_jianti_auto":"硖石","place_note":"河南省三门峡市东硖石镇","start_index":0,"tongjian_id":"c4c3cac4-db0e-11ef-af02-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":3,"tongjian_id":"c4c3cac5-db0e-11ef-bd8d-a0d3651f611f"},{"place_name":"崤縣","place_name_jianti_auto":"崤县","start_index":5,"tongjian_id":"c4c3cac6-db0e-11ef-9fc3-a0d3651f611f"},{"place_name":"硤石塢","place_name_jianti_auto":"硖石坞","start_index":15,"tongjian_id":"c4c3cac7-db0e-11ef-8228-a0d3651f611f"},{"place_name":"硤石","place_name_jianti_auto":"硖石","start_index":21,"tongjian_id":"c4c3cac8-db0e-11ef-8513-a0d3651f611f"},{"place_name":"陝州","place_name_jianti_auto":"陕州","start_index":25,"tongjian_id":"c4c3cac9-db0e-11ef-bfdb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"硤石，隋之崤縣，貞觀十四年移治硤石塢，改名硤石，屬陝州。陝，失冉翻。","note_content_jianti_auto":"硖石，隋之崤县，贞观十四年移治硖石坞，改名硖石，属陕州。陕，失冉翻。","note_type":"hu_note","start_index":32,"tongjian_id":"c4c3cac3-db0e-11ef-a03b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢近臣","official_name":"右散騎常侍","official_note":"右散騎常侍是唐代中央官职，属门下省，负责侍从皇帝、规谏过失，常作为加官或荣誉衔。在上下文中，高少逸以此官职被任命为地方观察使，体现了官职的调动或兼任。","official_rank":"从三品","source_snippet":"以右散騎常侍高少逸爲陝虢觀察使","start_index":10,"tongjian_id":"cc28810f-85bd-43e9-902b-94dcbc9124c3"},{"confidence":0.85,"official_category":"地方行政","official_name":"陝虢觀察使","official_note":"陝虢觀察使是唐代地方官职，负责监察和管理陕州和虢州地区，属观察使系统，通常由中央官员兼任，以加强中央对地方的控制。在上下文中，高少逸被任命此职，负责处理地方事务。","official_rank":"未知","source_snippet":"以右散騎常侍高少逸爲陝虢觀察使","start_index":18,"tongjian_id":"4133e17b-2a1c-48bb-89e3-f3523dd2bda8"},{"confidence":0.8,"official_category":"中枢机构","official_name":"敕使","official_note":"敕使是唐代皇帝派出的使者，负责传达诏令或执行特定任务，通常由宦官或近臣担任。在上下文中，敕使过硤石时鞭打驿吏，引发事件，后被皇帝责罚。","official_rank":"未知","source_snippet":"有敕使過硤石","start_index":28,"tongjian_id":"6efb7dbc-f12b-4221-a1ff-c26ed20f5bb8"},{"confidence":0.75,"official_category":"地方行政","official_name":"驛吏","official_note":"驛吏是唐代地方驿站的管理人员，负责驿站的日常运营和接待官员，属低级地方吏员。在上下文中，驛吏被敕使鞭打，显示了地方官员与中央使者的冲突。","official_rank":"低级","source_snippet":"鞭驛吏見血","start_index":36,"tongjian_id":"947abd4e-b135-4399-b2dc-72855b212919"}],"ExtRef_Children_people":[{"link_td_description":"高少逸，渤海郡蓨縣人，唐朝官員。高元裕之兄。","link_td_id":"Q10023226","link_td_number_id":8210347,"people_name":"高少逸","people_name_jianti_auto":"高少逸","people_xingming":"高少逸","start_index":15,"tongjian_id":"c4c3cacc-db0e-11ef-aa2d-a0d3651f611f"},{"link_td_description":"高少逸，渤海郡蓨縣人，唐朝官員。高元裕之兄。","link_td_id":"Q10023226","link_td_number_id":8210347,"people_name":"少逸","people_name_jianti_auto":"少逸","people_xingming":"高少逸","start_index":42,"tongjian_id":"c4c3cacf-db0e-11ef-a7c3-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c4c3cac2-db0e-11ef-be3d-a0d3651f611f","pinyin":"xiá","source_anchor_text":"有敕使過硤石怒餅黑","source_key":"baiyang_epub","start_index":29,"text":"硤","tongjian_id":"f02e8016-1427-58c1-bdb4-a3c27b04097e"}],"ExtRef_Children_places":[{"place_name":"陝虢","place_name_jianti_auto":"陕虢","resolved_place_entity_id":854,"start_index":19,"tongjian_id":"c4c3cacd-db0e-11ef-be70-a0d3651f611f"},{"place_name":"硤石","place_name_jianti_auto":"硖石","place_note":"河南省三门峡市东硖石镇","resolved_place_entity_id":1706,"start_index":29,"tongjian_id":"c4c3cace-db0e-11ef-8193-a0d3651f611f"},{"place_name":"恭陵","place_name_jianti_auto":"恭陵","place_note":"李治的儿子李弘墓•位于河南省偃师县南","resolved_place_entity_id":1943,"start_index":73,"tongjian_id":"c4c3cad0-db0e-11ef-8289-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"4秋，九月，丙戌，以右散騎常侍高少逸爲陝虢觀察使。有敕使過硤石，怒餅黑，鞭驛吏見血；少逸封其餅以進。敕使還，上責之曰：「深山中如此食豈易得！」讁配恭陵。","content_fanyi":"秋季九月初四日丙戌，宣宗任命右散骑常侍高少逸为陕虢观察使。有敕使经过硖石县，因驿站供给的饼颜色发黑而发怒，把驿吏鞭打至流血；高少逸把饼封装起来进奏给宣宗。敕使回到朝廷后，宣宗责备他说：“深山之中这样的食物哪里容易得到！”随后把他贬谪发配到恭陵服劳役。","content_jianti_auto":"4秋，九月，丙戌，以右散骑常侍高少逸为陕虢观察使。有敕使过硖石，怒饼黑，鞭驿吏见血；少逸封其饼以进。敕使还，上责之曰：「深山中如此食岂易得！」讁配恭陵。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25405,"number":4,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"c4c3cac2-db0e-11ef-be3d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"汶，音問。考異曰：唐年補錄：「五年，正月，甲戌朔，封三王。」今從實錄、新紀。","note_content_jianti_auto":"汶，音问。考异曰：唐年补录：「五年，正月，甲戌朔，封三王。」今从实录、新纪。","note_type":"hu_note","start_index":19,"tongjian_id":"c4c3cad2-db0e-11ef-a975-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"洽","people_name_jianti_auto":"洽","people_xingming":"李洽","start_index":4,"tongji