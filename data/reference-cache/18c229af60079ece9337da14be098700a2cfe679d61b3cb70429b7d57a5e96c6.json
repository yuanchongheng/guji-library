f_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此又出苑城而北獵。","note_content_jianti_auto":"此又出苑城而北猎。","note_type":"hu_note","start_index":7,"tongjian_id":"c4c3cade-db0e-11ef-9778-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":10,"tongjian_id":"c4c3cae0-db0e-11ef-9420-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"軍家，謂北司諸軍也。唐人謂諸道節度及觀察爲使家，諸州爲州家，諸縣爲縣家。索，山客翻。","note_content_jianti_auto":"军家，谓北司诸军也。唐人谓诸道节度及观察为使家，诸州为州家，诸县为县家。索，山客翻。","note_type":"hu_note","start_index":62,"tongjian_id":"c4c3cadf-db0e-11ef-ba1d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"衣，於旣翻；下至衣紫、衣黃並同。","note_content_jianti_auto":"衣，于既翻；下至衣紫、衣黄并同。","note_type":"hu_note","start_index":118,"tongjian_id":"c4c3cae1-db0e-11ef-b232-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"海州刺史","official_note":"海州刺史是唐代地方行政官职，负责管理海州（今江苏连云港一带）的政务、军事和司法。在《资治通鉴》此段中，李行言因皇帝赏识其政绩而被任命为海州刺史，体现了皇帝对地方官员的选拔和奖励。","official_rank":"正四品下（唐代刺史品秩）","source_snippet":"行言除海州刺史","start_index":78,"tongjian_id":"cd0c4ad6-c5fb-428d-9524-20cf448fbcc5"}],"ExtRef_Children_people":[{"people_name":"李行言","people_name_jianti_auto":"李行言","people_xingming":"李行言","start_index":33,"tongjian_id":"c4c3cae2-db0e-11ef-b0c6-a0d3651f611f"},{"people_name":"行言","people_name_jianti_auto":"行言","people_xingming":"李行言","start_index":88,"tongjian_id":"c4c3cae4-db0e-11ef-bd95-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"涇陽","place_name_jianti_auto":"泾阳","place_note":"陕西省泾阳县","resolved_place_entity_id":1305,"start_index":18,"tongjian_id":"c4c3cae3-db0e-11ef-b616-a0d3651f611f"},{"place_name":"海州","place_name_jianti_auto":"海州","place_note":"江苏省连云港市","resolved_place_entity_id":464,"start_index":91,"tongjian_id":"c4c3cae5-db0e-11ef-8bc1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"6上獵於苑北，遇樵夫，問其縣，曰：「涇陽人也。」「今爲誰？」曰：「李行言。」「爲政何如？」曰：「性執。有強盜數人，軍家索之，竟不與，盡殺之。」上歸，帖其名於寢殿之柱。冬，十月，行言除海州刺史，入謝，上賜之金紫。問曰：「卿知所以衣紫乎？」對曰：「不知。」上命取殿柱之帖示之。","content_fanyi":"宣宗在苑北狩猎，遇到一位樵夫，问他是什么县人，他回答说：“我是泾阳县人。”宣宗又问：“县令是谁？”他回答说：“李行言。”宣宗又问：“他处理政事怎么样？”他回答说：“他性情固执。有几个强盗，北司诸军前来索要，他终究不肯交出，把强盗全部杀了。”宣宗回宫后，将李行言的名字张贴在寝殿的柱子上。冬季，十月，李行言被任命为海州刺史，入朝谢恩，宣宗赏赐他金鱼袋和紫衣。宣宗问他：“你可知道因何得以穿上紫衣吗？”他回答说：“不知道。”宣宗便命人取下寝殿柱子上的名帖给他看。","content_jianti_auto":"6上猎于苑北，遇樵夫，问其县，曰：「泾阳人也。」「今为谁？」曰：「李行言。」「为政何如？」曰：「性执。有强盗数人，军家索之，竟不与，尽杀之。」上归，帖其名于寝殿之柱。冬，十月，行言除海州刺史，入谢，上赐之金紫。问曰：「卿知所以衣紫乎？」对曰：「不知。」上命取殿柱之帖示之。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，李君奭以佛祠数老而遽擢。举进退刑赏之大权，唯视人罄欬笑...","context_before":"...门而返，以萧倣之一言也；李远之不用，以长日棋局之一诗也。","source_end_index":99,"source_paragraph_tongjian_id":"eccc7fb6-6086-4ed6-8b5b-8b5c7fbbc28c","source_start_index":88,"source_text":"李行言以樵夫片语而典州"}],"title":"五 宣宗多疑致祸甚于德宗"},{"excerpts":[{"context_after":"，宜足以风厉廉隅而坊止贪浊矣，然而固不能也。君愈疑，臣愈...","context_before":"...遽走险以自求斩艾乎？然则所以致之者，非有司之虐害而谁耶？","source_end_index":210,"source_paragraph_tongjian_id":"b7974a9f-0fce-4f57-8462-742036bcd768","source_start_index":197,"source_text":"李行言、李君奭以得民而优擢"}],"title":"六 大中五年民起为盗因有司虐害"},{"excerpts":[{"context_after":"，恶知非贿奸民以为之媒介哉？乃决于信，而谓廷臣之公论举不...","context_before":"...用焉，而抑不能周知其人，则微行窃听，以里巷之谣诼为朝章。","source_end_index":95,"source_paragraph_tongjian_id":"d943d88c-d1a3-4032-95bf-58aad50e61f2","source_start_index":85,"source_text":"