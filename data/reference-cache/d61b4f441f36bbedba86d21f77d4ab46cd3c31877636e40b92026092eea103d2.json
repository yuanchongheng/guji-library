ren_officials":[{"confidence":0.95,"official_category":"財政","official_name":"大司農","official_note":"大司農是漢代掌管國家財政、農業和倉儲的中央高級官員，屬於九卿之一。在《資治通鑒》此段中，谷永被徵召擔任大司農，顯示其被任命為財政主管，但由於他之前多次上書批評皇帝和後宮，且與王氏結黨，皇帝對他不甚信任，因此任職僅一年多就因病被免職。這反映了當時政治鬥爭和皇帝對官員的態度。","official_rank":"九卿之一，秩中二千石","source_snippet":"爲大司農","start_index":12,"tongjian_id":"c19f54fb-cb23-44d2-a83c-7c6017877ed6"}],"ExtRef_Children_people":[{"link_death_year":-6,"link_td_description":"王根，西汉政治人物。王禁的第七子，王政君的弟弟，前27年，为曲阳侯。前12年，为大司马、骠骑将军。前8年，他和赵飞燕、赵昭仪姐妹支持定陶王刘欣为皇位继承人。王根去世之前，他向汉成帝推荐自己二哥的儿子王莽继承自己的位置。前6年，去世後，谥号炀（曲阳炀侯）。","link_td_id":"Q10012823","link_td_number_id":1509138,"people_name":"王根","people_name_jianti_auto":"王根","people_xingming":"王根","start_index":1,"tongjian_id":"922361dd-db0e-11ef-9811-a0d3651f611f"},{"link_death_year":-8,"link_td_description":"谷永，西汉大臣，字子云，原名并，长安人。","link_td_id":"Q10013197","link_td_number_id":1572704,"people_name":"谷永","people_name_jianti_auto":"谷永","people_xingming":"谷永","start_index":4,"tongjian_id":"922361de-db0e-11ef-a84f-a0d3651f611f"},{"link_death_year":-8,"link_td_description":"谷永，西汉大臣，字子云，原名并，长安人。","link_td_id":"Q10013197","link_td_number_id":1572704,"people_name":"永","people_name_jianti_auto":"永","people_xingming":"谷永","start_index":15,"tongjian_id":"922361df-db0e-11ef-a6b3-a0d3651f611f"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":42,"tongjian_id":"922361e0-db0e-11ef-80b7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"5王根薦谷永，徵入，爲大司農。永前後所上四十餘事，略相反覆，專攻上身與後宮而已；黨於王氏，上亦知之，不甚親信也。爲大司農歲餘，病；滿三月，上不賜告，卽時免。數月，卒。","content_fanyi":"王根举荐谷永，将他从北地太守任上征召入朝，任命为大司农。谷永前后上书四十余次，内容大体相同，反覆陈说，专门指责汉成帝本人过分宠幸后宫妃嫔而已。谷永是王氏外戚的党羽，汉成帝也知道这一点，所以对他并不很亲信。谷永担任大司农一年多后生病；休假满三个月，汉成帝未再赐予病假，当即将他免职。又过了几个月，谷永去世。","content_jianti_auto":"5王根荐谷永，征入，为大司农。永前后所上四十余事，略相反复，专攻上身与后宫而已；党于王氏，上亦知之，不甚亲信也。为大司农岁余，病；满三月，上不赐告，即时免。数月，卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2536,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"922361d6-db0e-11ef-8e5b-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":4,"tongjian_id":"92211853-db0e-11ef-b9e6-a0d3651f611f","year_anno":"（壬子、前九）","year_int":-9},"message":"success","success":true}