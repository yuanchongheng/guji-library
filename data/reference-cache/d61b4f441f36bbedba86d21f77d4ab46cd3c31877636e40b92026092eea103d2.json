n_tongjian_id":"DECISION_92211858DB0E11EF8CB7A0D3651F611F_05"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"興","people_name_jianti_auto":"兴","start_index":0,"tongjian_id":"9221185a-db0e-11ef-b3f2-a0d3651f611f"},{"people_name":"定陶共王","people_name_jianti_auto":"定陶共王","start_index":10,"tongjian_id":"9221185b-db0e-11ef-9ef9-a0d3651f611f"},{"people_name":"康","people_name_jianti_auto":"康","start_index":14,"tongjian_id":"9221185c-db0e-11ef-893e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"興，帝少弟。欣，帝弟定陶共王康之子。朝，直遙翻。","note_content_jianti_auto":"兴，帝少弟。欣，帝弟定陶共王康之子。朝，直遥翻。","note_type":"hu_note","start_index":14,"tongjian_id":"92211859-db0e-11ef-94a4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9221185e-db0e-11ef-86a3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：三官皆從王入朝。相，息亮翻。","note_content_jianti_auto":"师古曰：三官皆从王入朝。相，息亮翻。","note_type":"hu_note","start_index":33,"tongjian_id":"9221185d-db0e-11ef-b146-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92211860-db0e-11ef-8641-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：說其義也。","note_content_jianti_auto":"师古曰：说其义也。","note_type":"hu_note","start_index":92,"tongjian_id":"9221185f-db0e-11ef-9102-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92211862-db0e-11ef-80af-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：中忘之也。法令，力政翻。令誦，力呈翻。","note_content_jianti_auto":"师古曰：中忘之也。法令，力政翻。令诵，力呈翻。","note_type":"hu_note","start_index":122,"tongjian_id":"92211861-db0e-11ef-8940-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92211864-db0e-11ef-b3ed-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：食而獨在後飽；及起，又韈係解也。韈，音武伐翻。余謂賜食於君前，禮主於敬，食而獨後，又致飽而止，皆非敬也。及起而降階，韈係解而不知，是皆不能執禮。夫禮，所以固人肌膚之會，筋骸之束也。韈，足衣也；係，所以結韈。","note_content_jianti_auto":"师古曰：食而独在后饱；及起，又韈系解也。韈，音武伐翻。余谓赐食于君前，礼主于敬，食而独后，又致饱而止，皆非敬也。及起而降阶，韈系解而不知，是皆不能执礼。夫礼，所以固人肌肤之会，筋骸之束也。韈，足衣也；系，所以结韈。","note_type":"hu_note","start_index":138,"tongjian_id":"92211863-db0e-11ef-a6df-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"傅太后","people_name_jianti_auto":"傅太后","start_index":0,"tongjian_id":"92211867-db0e-11ef-b19b-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":4,"tongjian_id":"92211868-db0e-11ef-943a-a0d3651f611f"},{"people_name":"傅昭儀","people_name_jianti_auto":"傅昭仪","start_index":6,"tongjian_id":"92211869-db0e-11ef-9774-a0d3651f611f"},{"people_name":"定陶共王","people_name_jianti_auto":"定陶共王","start_index":10,"tongjian_id":"9221186a-db0e-11ef-980d-a0d3651f611f"},{"people_name":"共王","people_name_jianti_auto":"共王","start_index":18,"tongjian_id":"9221186b-db0e-11ef-bcc2-a0d3651f611f"},{"people_name":"定陶太后","people_name_jianti_auto":"定陶太后","start_index":24,"tongjian_id":"9221186c-db0e-11ef-957c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"傅太后，元帝傅昭儀，定陶共王母也；隨共王就國，爲定陶太后。","note_content_jianti_auto":"傅太后，元帝傅昭仪，定陶共王母也；随共王就国，为定陶太后。","note_type":"hu_note","start_index":184,"tongjian_id":"92211866-db0e-11ef-a965-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":8,"tongjian_id":"9221186f-db0e-11ef-940c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"迭互稱其材美也。師古曰：更，工衡翻。","note_content_jianti_auto":"迭互称其材美也。师古曰：更，工衡翻。","note_type":"hu_note","start_index":230,"tongjian_id":"9221186e-db0e-11ef-8ee0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92211871-db0e-11ef-bcf4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：爲之冠也。爲，于僞翻。","note_content_jianti_auto":"师古曰：为之冠也。为，于伪翻。","note_type":"hu_note","start_index":251,"tongjian_id":"92211870-db0e-11ef-b69f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"傅","official_note":"傅是诸侯王的师傅，负责教导和辅佐，此处中山王仅带傅来朝，显示其随从简略。","official_rank":"未知","source_snippet":"中山王獨從傅","start_index":12,"tongjian_id":"b744591c-3c9c-4844-aab5-4ce40fafd6ba"},{"confidence":0.9,"official_category":"文教","official_name":"傅","official_note":"傅是诸侯王的师傅，负责教导和辅佐，此处定陶王带傅来朝，显示其随从齐全。","official_rank":"未知","source_snippet":"定陶王盡從傅、相、中尉","start_index":22,"tongjian_id":"7f2c37f1-f82f-4c37-b641-9eeafb9f4317"},{"confidence":0.95,"official_category":"地方行政","official_name":"相","official_note":"相是诸侯国的行政长官，掌管国政，此处定陶王带相来朝，符合法令规定。","official_rank":"二千石","source_snippet":"定陶王盡從傅、相、中尉","start_index":25,"tongjian_id":"acef4d68-2792-438d-90f5-145e49b1e1ba"},{"confidence":0.95,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉是诸侯国的军事长官，负责治安和军队，此处定陶王带中尉来朝，符合法令规定。","official_rank":"二千石","source_snippet":"定陶王盡從傅、相、中尉","start_index":28,"tongjian_id":"5bcc1ae1-8327-4be3-8b0a-25c392726b04"},{"confidence":0.85,"official_category":"财政","official_name":"二千石","official_note":"二千石是汉代官员俸禄等级，泛指高级官员，此处指诸侯国的高级官员如傅、相、中尉。","official_rank":"未知","source_snippet":"得從其國二千石","start_index":48,"tongjian_id":"eb42db18-5536-409e-b939-2677a8c262cc"},{"confidence":0.8,"official_category":"中枢机构","official_name":"趙皇后","official_note":"趙皇后是皇帝的妻子，属于后宫官职，此处傅太后贿赂她以影响皇帝决策。","official_rank":"未知","source_snippet":"私賂遺趙皇后、昭儀及票騎將軍王根","start_index":148,"tongjian_id":"77123157-dfdd-4cc5-af11-21da668fca2a"},{"confidence":0.8,"official_category":"中枢机构","official_name":"昭儀","official_note":"昭儀是汉代后宫妃嫔的称号，属于宫廷官职，此处傅太后贿赂她以影响皇帝决策。","official_rank":"未知","source_snippet":"私賂遺趙皇后、昭儀及票騎將軍王根","start_index":154,"tongjian_id":"a3bc765d-5467-44f1-9391-bfdff99e14b7"},{"confidence":0.9,"official_category":"军事指挥","official_name":"票騎將軍","official_note":"票騎將軍是汉代高级军事官职，掌管骑兵，此处王根担任此职，傅太后贿赂他以结盟。","official_rank":"未知","source_snippet":"私賂遺趙皇后、昭儀及票騎將軍王根","start_index":159,"tongjian_id":"84572b40-42a8-4132-95f9-aad1ec3b2cfc"}],"ExtRef_Children_people":[{"link_death_year":-8,"link_td_description":"刘兴，汉元帝第三子，昭仪冯媛所生。","link_td_id":"Q10002458","link_td_number_id":1010875,"people_name":"中山王","people_name_jianti_auto":"中山王","start_index":1,"tongjian_id":"922361b9-db0e-11ef-b141-a0d3651f611f"},{"link_death_year":-8,"link_td_description":"刘兴，汉元帝第三子，昭仪冯媛所生。","link_td_id":"Q10002458","link_td_number_id":1010875,"people_name":"興","people_name_jianti_auto":"兴","people_xingming":"刘兴","start_index":4,"tongjian_id":"922361ba-db0e-11ef-bb14-a0d3651f611f"},{"link_birth_year":-25,"link_death_year":-1,"link_td_description":"汉哀帝刘欣，汉朝皇帝，在位6年，其正式谥号为“孝哀皇帝”，后世省略“孝”字称“汉哀帝”。刘欣是汉元帝孙