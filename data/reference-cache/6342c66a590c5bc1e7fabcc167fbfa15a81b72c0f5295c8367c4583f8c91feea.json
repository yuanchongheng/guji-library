hildren_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李心傳","people_name_jianti_auto":"李心传","start_index":0,"tongjian_id":"8f31a8e2-db0e-11ef-bf13-a0d3651f611f"},{"people_name":"漢景帝","people_name_jianti_auto":"汉景帝","start_index":5,"tongjian_id":"8f31a8e3-db0e-11ef-bc67-a0d3651f611f"},{"people_name":"劉貢父","people_name_jianti_auto":"刘贡父","start_index":66,"tongjian_id":"8f31a8e4-db0e-11ef-9139-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":45,"tongjian_id":"8f31a8e5-db0e-11ef-8894-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李心傳曰：漢景帝四年、中四年皆以冬十月日食，今通鑑書于夏、秋之後，蓋編輯者自志中摘出，不思漢初以十月爲歲首，故誤係之歲末耳。余按此誤劉貢父已言之，通鑑蓋承用漢書·本紀也。","note_content_jianti_auto":"李心传曰：汉景帝四年、中四年皆以冬十月日食，今通鉴书于夏、秋之后，盖编辑者自志中摘出，不思汉初以十月为岁首，故误系之岁末耳。余按此误刘贡父已言之，通鉴盖承用汉书·本纪也。","note_type":"hu_note","start_index":15,"tongjian_id":"8f31a8e1-db0e-11ef-a417-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5冬，十月，戊戌晦，日有食之。","content_fanyi":"冬季，十月，戊戌晦（疑误），发生日食。","content_jianti_auto":"5冬，十月，戊戌晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1275,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8f31a8df-db0e-11ef-b437-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否响应吴楚七国之乱","decision_tongjian_id":"DECISION_8F31A8E9DB0E11EF987FA0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻；下同。屬，之欲翻，委也；言以兵事委之。","note_conten