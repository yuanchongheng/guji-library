{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁巳、八三七）","note_content_jianti_auto":"（丁巳、八三七）","note_type":"hu_note","start_index":0,"tongjian_id":"c415e9f2-db0e-11ef-8e86-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"竇易直","people_name_jianti_auto":"窦易直","start_index":0,"tongjian_id":"c415e9f5-db0e-11ef-806f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"竇易直爲相於長慶、寶曆。","note_content_jianti_auto":"窦易直为相于长庆、宝历。","note_type":"hu_note","start_index":30,"tongjian_id":"c415e9f4-db0e-11ef-be3d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"宰相","official_note":"宰相是唐代最高行政长官，负责辅佐皇帝处理朝政，此处皇帝对宰相说话，表明其在朝中核心地位。","official_rank":"正一品至正三品","source_snippet":"上謂宰相","start_index":12,"tongjian_id":"09964829-cf5c-4840-a6b6-a13f2d8acf89"},{"confidence":0.9,"official_category":"中枢机构","official_name":"相","official_note":"相是宰相的简称，指窦易直担任宰相职务，此处用于说明其用人原则。","official_rank":"正一品至正三品","source_snippet":"竇易直爲相","start_index":32,"tongjian_id":"f2b4222e-0373-4872-bc60-a44da3e51f61"}],"ExtRef_Children_people":[{"link_death_year":833,"link_td_description":"窦易直，字宗玄，谥号晋阳恭惠公，中国唐朝官员，唐敬宗和唐文宗年间为宰相。","link_td_id":"Q10007640","link_td_number_id":4465961,"people_name":"竇易直","people_name_jianti_auto":"窦易直","people_xingming":"窦易直","start_index":24,"tongjian_id":"c415e9f6-db0e-11ef-83a9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，二月，己未，上謂宰相：「薦人勿問親疏。朕聞竇易直爲相，未嘗用親故。若親故果才，避嫌而棄之，是亦不爲至公也。」","content_fanyi":"春季，二月己未日，皇上对宰相说：“举荐人才不要分亲疏。我听说窦易直做宰相时，从未任用亲戚故旧。如果亲戚故旧果真有才能，因避嫌而舍弃不用，这也算不上是真正的公正。”","content_jianti_auto":"1春，二月，己未，上谓宰相：「荐人勿问亲疏。朕闻窦易直为相，未尝用亲故。若亲故果才，避嫌而弃之，是亦不为至公也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":24962,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c415e9f3-db0e-11ef-a4a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"緯","people_name_jianti_auto":"纬","start_index":0,"tongjian_id":"c416d44b-db0e-11ef-af4c-a0d3651f611f"},{"people_name":"順宗","people_name_jianti_auto":"顺宗","start_index":2,"tongjian_id":"c416d44c-db0e-11ef-bba5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"緯，順宗子。","note_content_jianti_auto":"纬，顺宗子。","note_type":"hu_note","start_index":6,"tongjian_id":"c416d44a-db0e-11ef-86b0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":837,"link_td_description":"李纬，本名李沔，唐朝皇子，是唐顺宗李诵的第三子，生母不详。","link_td_id":"Q10002977","link_td_number_id":1600981,"people_name":"均王","people_name_jianti_auto":"均王","people_xingming":"李纬","start_index":1,"tongjian_id":"c416d44d-db0e-11ef-989c-a0d3651f611f"},{"link_death_year":837,"link_td_description":"李纬，本名李沔，唐朝皇子，是唐顺宗李诵的第三子，生母不详。","link_td_id":"Q10002977","link_td_number_id":1600981,"people_name":"緯","people_name_jianti_auto":"纬","people_xingming":"李纬","start_index":3,"tongjian_id":"c416d44e-db0e-11ef-a877-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2均王緯薨。","content_fanyi":"均王李纬去世。","content_jianti_auto":"2均王纬薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24963,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c416d449-db0e-11ef-8726-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3三月，有彗星出於張，長八丈餘。壬申，詔撤樂減膳，以一日之膳分充十日。","content_fanyi":"三月，有彗星在张宿出现，长达八丈多。壬申日，皇帝下诏撤去乐舞、裁减膳食，把一天的膳食分作十天食用。","content_jianti_auto":"3三月，有彗星出于张，长八丈余。壬申，诏撤乐减膳，以一日之膳分充十日。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24964,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"c416d44f-db0e-11ef-bded-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"柳公權","people_name_jianti_auto":"柳公权","start_index":0,"tongjian_id":"c4170c9b-db0e-11ef-b9be-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"柳公權先除翰林侍書學士，今以翰林學士兼侍書。","note_content_jianti_auto":"柳公权先除翰林侍书学士，今以翰林学士兼侍书。","note_type":"hu_note","start_index":30,"tongjian_id":"c4170c9a-db0e-11ef-9309-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"c4170c9e-db0e-11ef-b969-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑通典曰：中書舍人，文士之極任，朝廷之盛選，諸官莫得比。","note_content_jianti_auto":"杜佑通典曰：中书舍人，文士之极任，朝廷之盛选，诸官莫得比。","note_type":"hu_note","start_index":131,"tongjian_id":"c4170c9d-db0e-11ef-b4b7-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"中書舍人","official_note":"中書舍人為中書省屬官，負責起草詔令、參議政事，在唐代為重要文職官員。此處柳公權原任此職，顯示其在中樞機構的地位。","official_rank":"正五品上","source_snippet":"上對中書舍人、翰林學士兼侍書柳公權於便殿","start_index":12,"tongjian_id":"44769685-e1ff-49f1-9768-a4fd054109a8"},{"confidence":0.95,"official_category":"文教","official_name":"翰林學士","official_note":"翰林學士為唐代內廷文學侍從之官，掌起草機密詔令，參與朝政議事，地位清要。此處柳公權兼任此職，反映其受皇帝信任。","official_rank":"品秩不定，常為皇帝近臣","source_snippet":"上對中書舍人、翰林學士兼侍書柳公權於便殿","start_index":18,"tongjian_id":"9762eafe-8035-41e7-9f47-9e643f87f7f3"},{"confidence":0.9,"official_category":"文教","official_name":"侍書","official_note":"侍書為侍奉皇帝讀書、書法的官職，多由文學或書法優長者擔任。此處柳公權兼任，突顯其書法家身份。","official_rank":"較低，具體品秩不詳","source_snippet":"上對中書舍人、翰林學士兼侍書柳公權於便殿","start_index":24,"tongjian_id":"aad11ea5-2574-47e6-95e0-91a2434fc78e"},{"confidence":0.85,"official_category":"中枢机构","official_name":"舍人","official_note":"此處'舍人'指中書舍人，為前文'中書舍人'的簡稱，是柳公權的原職。皇帝提及此職，表示對其原有職務的認知。","official_rank":"正五品上","source_snippet":"朕知舍人不應復爲諫議","start_index":116,"tongjian_id":"913feb8a-3c85-45e1-85bc-ec3657cf5512"},{"confidence":0.95,"official_category":"监察","official_name":"諫議大夫","official_note":"諫議大夫為門下省屬官，負責規諫皇帝過失、議論朝政得失。此處皇帝任命柳公權為此職，因其直言敢諫，符合上下文'諍臣風采'的描述。","official_rank":"正四品下","source_snippet":"以公權爲諫議大夫","start_index":148,"tongjian_id":"5a1538a7-b60c-4ce6-8f6d-6768985a7ca6"}],"ExtRef_Children_people":[{"link_birth_year":778,"link_death_year":865,"link_td_description":"柳公权，字诚悬，京兆府华原县（今陕西省铜川市耀州区）人，祖籍河东郡解县（今山西省运城市临猗县），出自河东柳氏东眷，唐朝大书法家。他担任侍书（朝廷书法教师）数十年，因书见重，历仕数朝，位至太子少傅，封河东郡公，追赠太子太师。他工于书法，尤其精通碑版楷书，开创“柳体”这一中国书法发展史上最后的楷书书体，成为唐朝楷书艺术最后的完善者。代表作有《玄秘塔碑》、《神策军碑》、《〈送梨帖〉跋》等。","link_td_id":"Q10000107","link_td_number_id":48641,"people_name":"柳公權","people_name_jianti_auto":"柳公权","people_xingming":"柳公权","start_index":23,"tongjian_id":"c4170ca0-db0e-11ef-814f-a0d3651f611f"},{"link_birth_year":778,"link_death_year":865,"link_td_description":"柳公权，字诚悬，京兆府华原县（今陕西省铜川市耀州区）人，祖籍河东郡解县（今山西省运城市临猗县），出自河东柳氏东眷，唐朝大书法家。他担任侍书（朝廷书法教师）数十年，因书见重，历仕数朝，位至太子少傅，封河东郡公，追赠太子太师。他工于书法，尤其精通碑版楷书，开创“柳体”这一中国书法发展史上最后的楷书书体，成为唐朝楷书艺术最后的完善者。代表作有《玄秘塔碑》、《神策军碑》、《〈送梨帖〉跋》等。","link_td_id":"Q10000107","link_td_number_id":48641,"people_name":"公權","people_name_jianti_auto":"公权","people_xingming":"柳公权","start_index":55,"tongjian_id":"c4170ca1-db0e-11ef-9095-a0d3651f611f"},{"link_birth_year":778,"link_death_year":865,"link_td_description":"柳公权，字诚悬，京兆府华原县（今陕西省铜川市耀州区）人，祖籍河东郡解县（今山西省运城市临猗县），出自河东柳氏东眷，唐朝大书法家。他担任侍书（朝廷书法教师）数十年，因书见重，历仕数朝，位至太子少傅，封河东郡公，追赠太子太师。他工于书法，尤其精通碑版楷书，开创“柳体”这一中国书法发展史上最后的楷书书体，成为唐朝楷书艺术最后的完善者。代表作有《玄秘塔碑》、《神策军碑》、《〈送梨帖〉跋》等。","link_td_id":"Q10000107","link_td_number_id":48641,"people_name":"公權","people_name_jianti_auto":"公权","people_xingming":"柳公权","start_index":150,"tongjian_id":"c4170ca2-db0e-11ef-92d0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4夏，四月，甲辰，上對中書舍人、翰林學士兼侍書柳公權於便殿，上舉衫袖示之曰：「此衣已三澣矣！」衆皆美上之儉德；公權獨無言，上問其故，對曰：「陛下貴爲天子，富有四海，當進賢退不肖，納諫諍，明賞罰，乃可以致雍熙。服澣濯之衣，乃末節耳。」上曰：「朕知舍人不應復爲諫議，以卿有諍臣風采，須屈卿爲之。」乙巳，以公權爲諫議大夫，餘如故。","content_fanyi":"夏季四月甲辰日，皇上在便殿召见中书舍人、翰林学士兼侍书柳公权，皇上举起衫袖给他看说：“这件衣服已经洗过三次了！”众人都赞美皇上的节俭之德；只有柳公权一言不发，皇上问他原因，他回答说：“陛下贵为天子，富有四海，应当进用贤才，斥退不肖之人，采纳谏诤，严明赏罚，才可以达到和乐太平。穿洗过的衣服，不过是细微末节罢了。”皇上说：“朕知道中书舍人不应再改任谏议之职，只因你有诤臣的风采，必须委屈你担任此职。”乙巳日，任命柳公权为谏议大夫，其余职务照旧。","content_jianti_auto":"4夏，四月，甲辰，上对中书舍人、翰林学士兼侍书柳公权于便殿，上举衫袖示之曰：「此衣已三澣矣！」众皆美上之俭德；公权独无言，上问其故，对曰：「陛下贵为天子，富有四海，当进贤退不肖，纳谏诤，明赏罚，乃可以致雍熙。服澣濯之衣，乃末节耳。」上曰：「朕知舍人不应复为谏议，以卿有诤臣风采，须屈卿为之。」乙巳，以公权为谏议大夫，余如故。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24965,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"c4170c99-db0e-11ef-a9c1-a0d3651f611f","zhang_TJZJ_id":"zttjzj_001413"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"翰林學士","official_note":"翰林學士是唐代負責起草詔書、參與機要的官員，通常由皇帝親信擔任，此處表示陳夷行在擔任此職。","official_rank":"未知","source_snippet":"翰林學士","start_index":5,"tongjian_id":"440d832f-fb28-4c53-87cf-6b372f7f98dc"},{"confidence":0.9,"official_category":"財政","official_name":"工部侍郞","official_note":"工部侍郞是唐代工部的副長官，負責工程、工匠等事務，此處表示陳夷行兼任此職。","official_rank":"正四品下","source_snippet":"工部侍郞","start_index":10,"tongjian_id":"c93af5f1-9e7c-468a-b0e0-680792761209"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代宰相的職銜，表示參與國家政務決策，此處表示陳夷行被任命為宰相。","official_rank":"宰相級","source_snippet":"同平章事","start_index":17,"tongjian_id":"41f238ba-8b5a-4b3a-a065-87aadcdef025"}],"ExtRef_Children_people":[{"link_death_year":844,"link_td_description":"陈夷行，字周道，颍川许昌（今属河南）人。他在唐文宗、唐武宗年间两度担任宰相，被视为牛李党争中李党的领导人物。","link_td_id":"Q10002571","link_td_number_id":1459287,"people_name":"陳夷行","people_name_jianti_auto":"陈夷行","people_xingming":"陈夷行","start_index":14,"tongjian_id":"c4170ca4-db0e-11ef-b93a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"5戊戌，以翰林學士、工部侍郞陳夷行同平章事。","content_fanyi":"戊戌日，皇上任命翰林学士、工部侍郎陈夷行担任同平章事。","content_jianti_auto":"5戊戌，以翰林学士、工部侍郞陈夷行同平章事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24966,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"c4170ca3-db0e-11ef-b50e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_p