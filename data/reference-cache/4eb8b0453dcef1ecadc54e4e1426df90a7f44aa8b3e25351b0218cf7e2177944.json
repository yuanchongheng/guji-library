{"data":{"current_mention_tongjian_id":"8c1dc751-db0e-11ef-81ee-a0d3651f611f","current_paragraph_tongjian_id":"8c1dc745-db0e-11ef-b1c9-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"簡公","people_name_jianti_auto":"简公","start_index":30,"tongjian_id":"8c1dc747-db0e-11ef-a888-a0d3651f611f"},{"people_name":"文公","people_name_jianti_auto":"文公","start_index":36,"tongjian_id":"8c1dc748-db0e-11ef-a619-a0d3651f611f"},{"people_name":"易王","people_name_jianti_auto":"易王","start_index":40,"tongjian_id":"8c1dc749-db0e-11ef-9e8b-a0d3651f611f"},{"people_name":"文公","people_name_jianti_auto":"文公","start_index":47,"tongjian_id":"8c1dc74a-db0e-11ef-b57d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":25,"tongjian_id":"8c1dc74b-db0e-11ef-b24e-a0d3651f611f"},{"place_name":"北燕","place_name_jianti_auto":"北燕","start_index":28,"tongjian_id":"8c1dc74c-db0e-11ef-9a6d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕，因肩翻。考異曰：史記·蘇秦傳謂之「燕文侯」。按春秋時北燕簡公已稱公，文公之子易王尋稱王，豈文公獨稱侯乎！今從世家。","note_content_jianti_auto":"燕，因肩翻。考异曰：史记·苏秦传谓之「燕文侯」。按春秋时北燕简公已称公，文公之子易王寻称王，岂文公独称侯乎！今从世家。","note_type":"hu_note","start_index":11,"tongjian_id":"8c1dc746-db0e-11ef-aa30-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"燕后文公，即燕文侯，中国战国时期的燕国君主，继燕后桓公之位，在位二十九年，秦惠文王将女儿嫁给燕太子。文公卒，燕易王立。齐宣王趁新君不稳攻讨之，取燕十座城池。武安君苏秦为燕说齐王，说服了齐宣王把城池又还给燕国。二十九年（前333年），文公去世，太子即位，是为燕易王。","link_td_id":"Q10000603","link_td_number_id":319373,"people_name":"文公","people_name_jianti_auto":"文公","people_xingming":"燕文公","start_index":7,"tongjian_id":"8c1dc751-db0e-11ef-81ee-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4燕桓公薨，子文公立。","content_fanyi":"燕桓公去世，其子燕文公继位。","content_jianti_auto":"4燕桓公薨，子文公立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":122,"number":4,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 七年 / 第 4 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"8c1dc745-db0e-11ef-b1c9-a0d3651f611f","year_int":-362},"tongjian_id":"8c1dc745-db0e-11ef-b1c9-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否采纳苏秦的兼并天下之策","decision_tongjian_id":"DECISION_8C39B143DB0E11EFAE4BA0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇","people_name_jianti_auto":"苏","start_index":9,"tongjian_id":"8c39b145-db0e-11ef-9fb4-a0d3651f611f"},{"people_name":"己","people_name_jianti_auto":"己","start_index":11,"tongjian_id":"8c39b146-db0e-11ef-919b-a0d3651f611f"},{"people_name":"顓頊","people_name_jianti_auto":"颛顼","start_index":14,"tongjian_id":"8c39b147-db0e-11ef-ac0e-a0d3651f611f"},{"people_name":"吳回","people_name_jianti_auto":"吴回","start_index":18,"tongjian_id":"8c39b148-db0e-11ef-abe6-a0d3651f611f"},{"people_name":"陸終","people_name_jianti_auto":"陆终","start_index":21,"tongjian_id":"8c39b149-db0e-11ef-8cd1-a0d3651f611f"},{"people_name":"陸終","people_name_jianti_auto":"陆终","start_index":24,"tongjian_id":"8c39b14a-db0e-11ef-a91b-a0d3651f611f"},{"people_name":"昆吾","people_name_jianti_auto":"昆吾","start_index":27,"tongjian_id":"8c39b14b-db0e-11ef-ab88-a0d3651f611f"},{"people_name":"蘇公","people_name_jianti_auto":"苏公","start_index":37,"tongjian_id":"8c39b14c-db0e-11ef-a7c4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","start_index":32,"tongjian_id":"8c39b14d-db0e-11ef-8ee2-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":35,"tongjian_id":"8c39b14e-db0e-11ef-9cde-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。姓譜：蘇，己姓，顓頊裔孫吳回生陸終，陸終生昆吾，封於蘇，至周，蘇公。","note_content_jianti_auto":"说，式芮翻。姓谱：苏，己姓，颛顼裔孙吴回生陆终，陆终生昆吾，封于苏，至周，苏公。","note_type":"hu_note","start_index":18,"tongjian_id":"8c39b144-db0e-11ef-8a3c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":0,"tongjian_id":"8c39b152-db0e-11ef-8bba-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":3,"tongjian_id":"8c39b153-db0e-11ef-b486-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":19,"tongjian_id":"8c39b154-db0e-11ef-8b75-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":22,"tongjian_id":"8c39b155-db0e-11ef-8aab-a0d3651f611f"},{"place_name":"蒲","place_name_jianti_auto":"蒲","start_index":25,"tongjian_id":"8c39b156-db0e-11ef-b07b-a0d3651f611f"},{"place_name":"潼","place_name_jianti_auto":"潼","start_index":27,"tongjian_id":"8c39b157-db0e-11ef-b58c-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":33,"tongjian_id":"8c39b158-db0e-11ef-a193-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":40,"tongjian_id":"8c39b159-db0e-11ef-9f93-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","start_index":46,"tongjian_id":"8c39b15a-db0e-11ef-b2b5-a0d3651f611f"},{"place_name":"九原","place_name_jianti_auto":"九原","start_index":49,"tongjian_id":"8c39b15b-db0e-11ef-8fdc-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":54,"tongjian_id":"8c39b15c-db0e-11ef-a9d3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕南與趙接境；戰於百里之內，言其近也。秦欲攻燕，自蒲、潼下兵，則爲趙所隔，故必逕上郡之西，出雲中、九原然後至燕，故云戰於千里之外。","note_content_jianti_auto":"燕南与赵接境；战于百里之内，言其近也。秦欲攻燕，自蒲、潼下兵，则为赵所隔，故必迳上郡之西，出云中、九原然后至燕，故云战于千里之外。","note_type":"hu_note","start_index":85,"tongjian_id":"8c39b151-db0e-11ef-aab8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":13,"tongjian_id":"8c39b15e-db0e-11ef-9566-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。計無過於此者，言燕計之過，無甚於此。","note_content_jianti_auto":"夫，音扶。计无过于此者，言燕计之过，无甚于此。","note_type":"hu_note","start_index":106,"tongjian_id":"8c39b15d-db0e-11ef-a2f6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":1,"tongjian_id":"8c39b161-db0e-11ef-b243-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":4,"tongjian_id":"8c39b162-db0e-11ef-a428-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此蘇秦爲燕至計，先定於胸中者。","note_content_jianti_auto":"此苏秦为燕至计，先定于胸中者。","note_type":"hu_note","start_index":128,"tongjian_id":"8c39b160-db0e-11ef-9683-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"燕后文公，即燕文侯，中国战国时期的燕国君主，继燕后桓公之位，在位二十九年，秦惠文王将女儿嫁给燕太子。文公卒，燕易王立。齐宣王趁新君不稳攻讨之，取燕十座城池。武安君苏秦为燕说齐王，说服了齐宣王把城池又还给燕国。二十九年（前333年），文公去世，太子即位，是为燕易王。","link_td_id":"Q10000603","link_td_number_id":319373,"people_name":"燕文公","people_name_jianti_auto":"燕文公","people_xingming":"燕文公","start_index":31,"tongjian_id":"8c39b168-db0e-11ef-9a68-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/苏张说六国","excerpts":[{"context_after":"。谓燕地方二千余里，带甲数十万，车六百乘，骑六千匹；谓赵...","context_before":"...鬼谷，而其从横之辩，如冰炭水火之不同，盖所以设心者异耳。","source_end_index":50,"source_paragraph_tongjian_id":"1db2313c-c7f2-4053-bd18-4454471f59de","source_start_index":36,"source_text":"苏欲六国合从以摈秦，故言其强"}],"path":"续笔/卷二/苏张说六国","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"○范雎曰：秦四塞以为固[高诱曰：四面有关山之固也。徐广曰...","context_before":"《战国策》：","source_end_index":330,"source_paragraph_tongjian_id":"b27eaeea-565c-5ed1-91b2-55e606fb2cb3","source_start_index":6,"source_text":"苏秦曰：秦西有巴、蜀、汉中之利[巴、蜀、汉中，见后四十郡。《史记》作西有汉中，南有巴蜀]，北有胡、貉、代马之用[胡在北方，貉在东北方。王氏曰：胡如楼烦、林胡之属，貉如辰韩之属。今山西太原府岢岚州以北，故楼烦胡地；大同府朔州以北，故林胡地；辽东三万卫以东北，即貉地。而大同蔚州之境，古代地也。三处皆产良马。胡与代本属赵，貉属燕。苏秦时，巴、蜀、胡、代，皆非秦有也，盖侈言之]，南有巫山、黔中之限[巫山，在四川巫山县东三十里。详四川名山。黔中，见后黔中郡]，东有崤、函之固[崤，崤阪，在河南永宁县北六十里。见河南名山三崤。函，函谷关，在河南灵宝县南十里。今曰潼关，在陕西华阴县东四十里。见陕西重险、潼关]，沃野千里，地势形便，此所谓天府，天下之雄国也。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、真定府（卷十四）","excerpts":[{"context_after":"汉八年，高祖击韩王信，余反寇于东垣。十一年，陈豨将赵利守...","context_before":"...里，即赵故邑也。《史记》赵武灵王二十年，攻中山，取东垣。","source_end_index":63,"source_paragraph_tongjian_id":"a7c7deb8-a59e-5de5-b1d0-287e69ab0aac","source_start_index":36,"source_text":"苏秦说燕：赵之攻燕也，不十日，而数十万之军军于东垣矣。"}],"path":"北直方舆纪要/四、真定府（卷十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3初，洛陽人蘇秦說秦王以兼天下之術，秦王不用其言。蘇秦乃去，說燕文公曰：「燕之所以不犯寇被甲兵者，以趙之爲蔽其南也。且秦之攻燕也，戰於千里之外；趙之攻燕也，戰於百里之內。夫不憂百里之患而重千里之外，計無過於此者。願大王與趙從親，天下爲一，則燕國必無患矣。」","content_fanyi":"当初，洛阳人苏秦以兼并天下的谋略游说秦王，秦王没有采纳他的建议。苏秦于是离开秦国，前往游说燕文公说：“燕国之所以不被侵犯、不遭兵祸，是因为有赵国在南方作为屏障。如果秦国攻打燕国，是在燕国千里之外作战；而赵国攻打燕国，是在燕国百里之内兵戎相见。燕国不忧虑百里之内的战祸却重视千里之外的威胁，没有比这更错误的谋划了。我希望大王与赵国结成合纵相亲的盟国，使天下诸侯联合为一体，那么燕国就一定没有忧患了。”","content_jianti_auto":"3初，洛阳人苏秦说秦王以兼天下之术，秦王不用其言。苏秦乃去，说燕文公曰：「燕之所以不犯寇被甲兵者，以赵之为蔽其南也。且秦之攻燕也，战于千里之外；赵之攻燕也，战于百里之内。夫不忧百里之患而重千里之外，计无过于此者。愿大王与赵从亲，天下为一，则燕国必无患矣。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":185,"number":3,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c39b143-db0e-11ef-ae4b-a0d3651f611f","year_int":-333},"tongjian_id":"8c39b143-db0e-11ef-ae4b-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"采纳合纵抗秦之策","decision_tongjian_id":"DECISION_8C39B171DB0E11EFB42DA0D3651F611F_01"},{"decision_name":"接受六国合纵抗秦的提议","decision_tongjian_id":"DECISION_8C39B171DB0E11EFB42DA0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。建國，猶言立國也。","note_content_jianti_auto":"说，式芮翻。建国，犹言立国也。","note_type":"hu_note","start_index":34,"tongjian_id":"8c39b172-db0e-11ef-a776-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8c39b177-db0e-11ef-89d5-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"8c39b178-db0e-11ef-9ec6-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":26,"tongjian_id":"8c39b179-db0e-11ef-91c0-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「地」作「之」；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：十二行本「地」作「之」；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8c39b176-db0e-11ef-a3da-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":125,"tongjian_id":"8c39b175-db0e-11ef-abd0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"衡，讀曰橫。衡人，說客之連橫者。","note_content_jianti_auto":"衡，读曰横。衡人，说客之连横者。","note_type":"hu_note","start_index":182,"tongjian_id":"8c39b17c-db0e-11ef-b966-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄒氏","people_name_jianti_auto":"邹氏","start_index":27,"tongjian_id":"8c39b17f-db0e-11ef-bf16-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：恐，起拱翻。愒，許曷翻，又呼曷翻，謂相恐脅也。鄒氏愒音憩，義疏。","note_content_jianti_auto":"索隐曰：恐，起拱翻。愒，许曷翻，又呼曷翻，谓相恐胁也。邹氏愒音憩，义疏。","note_type":"hu_note","start_index":220,"tongjian_id":"8c39b17e-db0e-11ef-8af1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":12,"tongjian_id":"8c39b182-db0e-11ef-9429-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":18,"tongjian_id":"8c39b183-db0e-11ef-838c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，子容翻。畔，反也，反秦之所爲也，秦之所爲者衡也。","note_content_jianti_auto":"从，子容翻。畔，反也，反秦之所为也，秦之所为者衡也。","note_type":"hu_note","start_index":256,"tongjian_id":"8c39b181-db0e-11ef-8d59-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":21,"tongjian_id