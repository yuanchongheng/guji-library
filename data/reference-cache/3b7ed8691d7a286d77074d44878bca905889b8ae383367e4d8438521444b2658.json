abb1-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":42,"tongjian_id":"8c9b04d8-db0e-11ef-ba52-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"1楚懷王亡歸。秦人覺之，遮楚道。懷王從間道走趙。趙主父在代，趙人不敢受。懷王將走魏，秦人追及之，以歸。","content_fanyi":"楚怀王逃回楚国。秦国人发觉后，拦住他回楚国的道路。怀王抄偏僻小路逃往赵国。当时赵主父正在代地，赵国官员不敢收留楚怀王。怀王又打算逃往魏国，秦国人追了上来，把楚怀王带回秦国。","content_jianti_auto":"1楚怀王亡归。秦人觉之，遮楚道。怀王从间道走赵。赵主父在代，赵人不敢受。怀王将走魏，秦人追及之，以归。","dtjl_paragraph_links":[],"dtjl_references":[],"id":301,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c9b04ca-db0e-11ef-a169-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"世本「緡」作「湣」。","note_content_jianti_auto":"世本「缗」作「湣」。","note_type":"hu_note","start_index":12,"tongjian_id":"8c9b04da-db0e-11ef-8c29-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-303,"link_td_description":"鲁平公，姬姓，名叔，《世本》名旅，为战国诸侯国鲁国君主，鲁国第三十三任君主，他为鲁景公儿子。","link_td_id":"Q10001666","link_td_number_id":364628,"people_name":"魯平公","people_name_jianti_auto":"鲁平公","people_xingming":"姬旅","start_index":1,"tongjian_id":"8c9b04dc-db0e-11ef-8834-a0d3651f611f"},{"people_name":"緡公賈","people_name_jianti_auto":"缗公贾","people_xingming":"姬贾","start_index":7,"tongjian_id":"8c9b04dd-db0e-11ef-80d2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2魯平公薨，子緡公賈立。","content_fanyi":"鲁平公去世，他的儿子姬贾即位，是为鲁缗公。","content_ji