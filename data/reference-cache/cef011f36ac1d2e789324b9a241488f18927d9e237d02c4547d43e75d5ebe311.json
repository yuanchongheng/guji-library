{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丙戌、前三五）","note_content_jianti_auto":"（丙戌、前三五）","note_type":"hu_note","start_index":0,"tongjian_id":"919bad76-db0e-11ef-a748-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"919bad79-db0e-11ef-aa8b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：混，同也，音胡本翻。余謂混爲一者，合四海之內，同稟命於一人，天下之治出於一也。","note_content_jianti_auto":"师古曰：混，同也，音胡本翻。余谓混为一者，合四海之内，同禀命于一人，天下之治出于一也。","note_type":"hu_note","start_index":34,"tongjian_id":"919bad78-db0e-11ef-b37f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":14,"tongjian_id":"919bad7b-db0e-11ef-84e4-a0d3651f611f"},{"people_name":"郅支","people_name_jianti_auto":"郅支","start_index":24,"tongjian_id":"919bad7c-db0e-11ef-a778-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"大夏","place_name_jianti_auto":"大夏","start_index":0,"tongjian_id":"919bad7d-db0e-11ef-8581-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","start_index":3,"tongjian_id":"919bad7e-db0e-11ef-9529-a0d3651f611f"},{"place_name":"大宛","place_name_jianti_auto":"大宛","start_index":9,"tongjian_id":"919bad7f-db0e-11ef-9730-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":19,"tongjian_id":"919bad80-db0e-11ef-92fa-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"大夏，西域國名，在大宛西南。師古曰：謂漢爲不能使郅支臣服也。","note_content_jianti_auto":"大夏，西域国名，在大宛西南。师古曰：谓汉为不能使郅支臣服也。","note_type":"hu_note","start_index":84,"tongjian_id":"919bad7a-db0e-11ef-9b5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":0,"tongjian_id":"919bad83-db0e-11ef-b55e-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":16,"tongjian_id":"919bad84-db0e-11ef-865e-a0d3651f611f"},{"people_name":"崔浩","people_name_jianti_auto":"崔浩","start_index":55,"tongjian_id":"919bad85-db0e-11ef-9671-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"槀街","place_name_jianti_auto":"槀街","start_index":4,"tongjian_id":"919bad86-db0e-11ef-b7d0-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":10,"tongjian_id":"919bad87-db0e-11ef-9220-a0d3651f611f"},{"place_name":"槀街","place_name_jianti_auto":"槀街","start_index":20,"tongjian_id":"919bad88-db0e-11ef-8ff3-a0d3651f611f"},{"place_name":"銅駝街","place_name_jianti_auto":"铜驼街","start_index":72,"tongjian_id":"919bad89-db0e-11ef-b944-a0d3651f611f"},{"place_name":"銅駝街","place_name_jianti_auto":"铜驼街","start_index":82,"tongjian_id":"919bad8a-db0e-11ef-998b-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":86,"tongjian_id":"919bad8b-db0e-11ef-a634-a0d3651f611f"},{"place_name":"西京","place_name_jianti_auto":"西京","start_index":89,"tongjian_id":"919bad8c-db0e-11ef-8660-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉灼曰：槀街，黃圖在長安城門內。師古曰：槀街，街名，蠻夷邸在此街也。邸，若今客館也。又曰：蠻夷邸，若今鴻臚館。崔浩以爲「槀」當作「橐」；橐街，卽銅駝街也。此說失之。銅駝街在雒陽，西京無也。縣，讀曰懸；下同。","note_content_jianti_auto":"晋灼曰：槀街，黄图在长安城门内。师古曰：槀街，街名，蛮夷邸在此街也。邸，若今客馆也。又曰：蛮夷邸，若今鸿胪馆。崔浩以为「槀」当作「橐」；橐街，即铜驼街也。此说失之。铜驼街在雒阳，西京无也。县，读曰悬；下同。","note_type":"hu_note","start_index":156,"tongjian_id":"919bad82-db0e-11ef-906a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":26,"tongjian_id":"919bad8f-db0e-11ef-8e90-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":55,"tongjian_id":"919bad90-db0e-11ef-9ea1-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":69,"tongjian_id":"919bad91-db0e-11ef-904b-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":73,"tongjian_id":"919bad92-db0e-11ef-926d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"禮記·月令：孟春，掩骼、埋胔。註云：謂死氣逆生氣也。應劭曰：禽獸之骨曰骼，骼，大也；鳥鼠之骨曰胔，胔，可惡也。臣瓚曰：枯骨曰骼；有肉曰胔。師古曰：瓚說是也。骼，音工客翻。胔，音才賜翻。","note_content_jianti_auto":"礼记·月令：孟春，掩骼、埋胔。注云：谓死气逆生气也。应劭曰：禽兽之骨曰骼，骼，大也；鸟鼠之骨曰胔，胔，可恶也。臣瓒曰：枯骨曰骼；有肉曰胔。师古曰：瓒说是也。骼，音工客翻。胔，音才赐翻。","note_type":"hu_note","start_index":192,"tongjian_id":"919bad8e-db0e-11ef-8194-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉朝最高行政长官，负责辅佐皇帝处理政务，此处匡衡作为丞相参与讨论郅支单于首级处理事宜，体现了中枢决策作用。","official_rank":"正一品","source_snippet":"丞相匡衡等以爲","start_index":180,"tongjian_id":"8875e7bb-c65f-4fe3-b6b6-3a73e4918089"}],"ExtRef_Children_people":[{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_number_id":366934,"people_name":"郅支","people_name_jianti_auto":"郅支","people_xingming":"郅支单于","start_index":6,"tongjian_id":"919bad95-db0e-11ef-9d06-a0d3651f611f"},{"link_death_year":-25,"link_td_description":"甘延寿，字君况，西汉北地郡郁郅县人。年轻时因出身清白、善骑射，被选为羽林军骑士，后升为郎官、期门郎。甘露元年，以期门郎身份护送冯嫽出使乌孙。曾任辽东郡太守，后任郎中谏大夫、都护骑都卫出使西域。建昭三年，与陈汤矫诏发兵远征郅支城，大败康居、匈奴联军，斩郅支单于。后被封为义成侯，任长水校尉。河平四年去世，谥号“壮”。","link_td_id":"Q10009486","link_td_number_id":717631,"people_name":"延壽","people_name_jianti_auto":"延寿","people_xingming":"甘延寿","start_index":13,"tongjian_id":"919bad96-db0e-11ef-bd86-a0d3651f611f"},{"link_death_year":-6,"link_td_description":"陈汤，字子公，西汉山阳郡瑕丘县（今山东省兖州区东北）人，学识渊博，早年因家贫而向人乞讨。汉元帝时期受荐举担任郎官，建昭三年与甘延寿共同出使西域，矫诏发兵诛灭郅支单于，因功受封关内侯，后屡遭贬谪，死于京师。","link_td_id":"Q10001540","link_td_number_id":133551,"people_name":"湯","people_name_jianti_auto":"汤","people_xingming":"陈汤","start_index":16,"tongjian_id":"919bad97-db0e-11ef-99e3-a0d3651f611f"},{"link_td_description":"尧，祁姓，名放勋，中国神话中五帝之一，传说出生于三阿之南。道教中为天官大帝，三官大帝之一，诞日为上元节。","link_td_id":"Q10000026","link_td_number_id":14183,"people_name":"唐","people_name_jianti_auto":"唐","people_xingming":"唐尧","start_index":36,"tongjian_id":"919bad99-db0e-11ef-95a0-a0d3651f611f"},{"link_td_description":"舜，中国上古时代的五帝之一，东夷人。亦是道教与民间信仰的地官大帝。名重华；生于姚墟，为姚姓，后居于妫水之边，后人将姚姓改为妫姓，有虞氏。冀州人，都城在蒲阪（今山西永济）。舜为四部落联盟首领，以受尧的「禅让」而称帝于天下，其国号为「有虞」。","link_td_id":"Q10000010","link_td_number_id":4332,"people_name":"虞","people_name_jianti_auto":"虞","people_xingming":"虞舜","start_index":38,"tongjian_id":"919bad9a-db0e-11ef-8640-a0d3651f611f"},{"link_death_year":-31,"link_td_description":"呼韩邪单于（？－前31年），名稽侯狦，是西汉后期匈奴单于之一，挛鞮氏，虚闾权渠单于的儿子。","link_td_id":"Q10000775","link_td_number_id":356590,"people_name":"呼韓邪單于","people_name_jianti_auto":"呼韩邪单于","people_xingming":"呼韩邪单于","start_index":47,"tongjian_id":"919bad9b-db0e-11ef-b6d4-a0d3651f611f"},{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_number_id":366934,"people_name":"郅支單于","people_name_jianti_auto":"郅支单于","people_xingming":"郅支单于","start_index":58,"tongjian_id":"919bad9c-db0e-11ef-a0c8-a0d3651f611f"},{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_number_id":366934,"people_name":"郅支單于","people_name_jianti_auto":"郅支单于","people_xingming":"郅支单于","start_index":84,"tongjian_id":"919bada1-db0e-11ef-98bd-a0d3651f611f"},{"link_death_year":-25,"link_td_description":"甘延寿，字君况，西汉北地郡郁郅县人。年轻时因出身清白、善骑射，被选为羽林军骑士，后升为郎官、期门郎。甘露元年，以期门郎身份护送冯嫽出使乌孙。曾任辽东郡太守，后任郎中谏大夫、都护骑都卫出使西域。建昭三年，与陈汤矫诏发兵远征郅支城，大败康居、匈奴联军，斩郅支单于。后被封为义成侯，任长水校尉。河平四年去世，谥号“壮”。","link_td_id":"Q10009486","link_td_number_id":717631,"people_name":"延壽","people_name_jianti_auto":"延寿","start_index":101,"tongjian_id":"919bada2-db0e-11ef-8faf-a0d3651f611f"},{"link_death_year":-6,"link_td_description":"陈汤，字子公，西汉山阳郡瑕丘县（今山东省兖州区东北）人，学识渊博，早年因家贫而向人乞讨。汉元帝时期受荐举担任郎官，建昭三年与甘延寿共同出使西域，矫诏发兵诛灭郅支单于，因功受封关内侯，后屡遭贬谪，死于京师。","link_td_id":"Q10001540","link_td_number_id":133551,"people_name":"湯","people_name_jianti_auto":"汤","start_index":105,"tongjian_id":"919bada3-db0e-11ef-be19-a0d3651f611f"},{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_number_id":366934,"people_name":"郅支","people_name_jianti_auto":"郅支","start_index":137,"tongjian_id":"919bada4-db0e-11ef-b681-a0d3651f611f"},{"link_td_description":"匡衡，字稚圭，东海郡承县（今天的山东省兰陵县西南、枣庄一带）人。西汉经学家，元帝时位至丞相。","link_td_id":"Q10009100","link_td_number_id":522878,"people_name":"匡衡","people_name_jianti_auto":"匡衡","people_xingming":"匡衡","start_index":175,"tongjian_id":"919bada6-db0e-11ef-b1dd-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"919bad77-db0e-11ef-a7ce-a0d3651f611f","pinyin":"zì","source_anchor_text":"春掩骼埋胔之時宜勿","source_key":"baiyang_epub","start_index":188,"text":"胔","tongjian_id":"ec9fdc71-5685-524f-8aaa-776c627181e8"}],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":43,"start_index":10,"tongjian_id":"919bad98-db0e-11ef-abd6-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":43,"tongjian_id":"919bad9d-db0e-11ef-b0ce-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":45,"tongjian_id":"919bad9e-db0e-11ef-ab19-a0d3651f611f"},{"place_name":"大夏","place_name_jianti_auto":"大夏","resolved_place_entity_id":1550,"start_index":70,"tongjian_id":"919bad9f-db0e-11ef-b494-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":78,"tongjian_id":"919bada0-db0e-11ef-950d-a0d3651f611f"},{"place_name":"槀街","place_name_jianti_auto":"槀街","resolved_place_entity_id":3848,"start_index":149,"tongjian_id":"919bada5-db0e-11ef-ad20-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":164,"tongjian_id":"919bada7-db0e-11ef-9fc8-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"郅支之战","tongjian_id":"war_N0588"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"又有香室街。亦曰香街。魏主子攸初，元彧言，汉高立太上皇庙...","context_before":"...、九陌。汉京兆尹张敞走马章台街。丞相刘屈氂妻枭首华阳街。","source_end_index":462,"source_paragraph_tongjian_id":"10d45da5-d1d3-5588-97f1-54beb6adee74","source_start_index":449,"source_text":"陈汤斩郅支单于，悬首藁街。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"1春，正月，郅支首至京師。延壽、湯上疏曰：「臣聞天下之大義當混爲一，昔有唐、虞，今有強漢。匈奴呼韓邪單于已稱北藩，唯郅支單于叛逆，未伏其辜，大夏之西，以爲強漢不能臣也。郅支單于慘毒行於民，大惡通於天；臣延壽、臣湯，將義兵，行天誅，賴陛下神靈，陰陽並應，天氣精明，陷陳克敵，斬郅支首及名王以下，宜縣頭槀街蠻夷邸間，以示萬里，明犯強漢者，雖遠必誅！」丞相匡衡等以爲：「方春掩骼、埋胔之時，宜勿縣。」詔縣十日，乃埋之；仍告祠郊廟，赦天下。羣臣上壽，置酒。","content_fanyi":"春季，正月，郅支单于的首级送到京师长安。甘延寿、陈汤上疏说：“臣听说天下的大义，归根到底是天下统一，从前有唐尧、虞舜，今天有强汉。匈奴呼韩邪单于已经归顺，称为北边藩属，只有郅支单于叛逆，没有伏罪，他逃亡到大夏国以西，自以为强汉无法使他臣服。郅支单于对百姓暴虐狠毒，大恶上通于天；臣甘延寿、臣陈汤率领正义之师，奉行上天的诛罚，仰赖陛下神灵，阴阳相互应和，天气清明，攻破敌阵、战胜敌人，斩下郅支单于及名王以下的首级，应当把他们的头颅悬挂在长安城内槀街的各蛮夷邸舍之间，以此昭示万里之外的蛮夷，让他们明确知道：冒犯强汉的人，即使距离再远也必定诛杀！”丞相匡衡等人认为：“眼下正是春季掩埋枯骨、尸骸的时候，不宜悬挂头颅。”汉元帝下诏悬挂示众十天，然后掩埋；接着照例祭告天地、宗庙，赦免天下。群臣向皇帝上寿，摆设酒宴。","content_jianti_auto":"1春，正月，郅支首至京师。延寿、汤上疏曰：「臣闻天下之大义当混为一，昔有唐、虞，今有强汉。匈奴呼韩邪单于已称北藩，唯郅支单于叛逆，未伏其辜，大夏之西，以为强汉不能臣也。郅支单于惨毒行于民，大恶通于天；臣延寿、臣汤，将义兵，行天诛，赖陛下神灵，阴阳并应，天气精明，陷陈克敌，斩郅支首及名王以下，宜县头槀街蛮夷邸间，以示万里，明犯强汉者，虽远必诛！」丞相匡衡等以为：「方春掩骼、埋胔之时，宜勿县。」诏县十日，乃埋之；仍告祠郊庙，赦天下。群臣上寿，置酒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2303,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"919bad77-db0e-11ef-a7ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":12,"tongjian_id":"919badaa-db0e-11ef-8b60-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"游，謂宴游。學，謂講學。師古曰：同處長養，以至於壯大。少，詩照翻。長，知兩翻。","note_content_jianti_auto":"游，谓宴游。学，谓讲学。师古曰：同处长养，以至于壮大。少，诗照翻。长，知两翻。","note_type":"hu_note","start_index":32,"tongjian_id":"919bada9-db0e-11ef-a4b6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"護，監護也。","note_content_jianti_auto":"护，监护也。","note_type":"hu_note","start_index":110,"tongjian_id":"919badab-db0e-11ef-98d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"919badad-db0e-11ef-aa42-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：謂者，告語也。","note_content_jianti_auto":"师古曰：谓者，告语也。","note_type":"hu_note","start_index":116,"tongjian_id":"919badac-db0e-11ef-b57c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂哀感而神氣爲之耗損。","note_content_jianti_auto":"谓哀感而神气为之耗损。","note_type":"hu_note","start_index":139,"tongjian_id":"919badae-db0e-11ef-829d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見，賢遍翻；下同。","note_content_jianti_auto":"见，贤遍翻；下同。","note_type":"hu_note","start_index":147,"tongjian_id":"919badaf-db0e-11ef-b86d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"919badb1-db0e-11ef-a5a0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：屬，音之欲翻。","note_content_jianti_auto":"师古曰：属，音之欲翻。","note_type":"hu_note","start_index":161,"tongjian_id":"919badb0-db0e-11ef-96ad-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"駙馬都尉","official_note":"駙馬都尉是漢代官職，原為掌管皇帝副車的武官，後常授予皇帝女婿，成為榮譽職銜。在上下文中，史丹擔任此職，負責護衛太子家，顯示其親近皇室和軍事職能。","official_rank":"未知","source_snippet":"是時駙馬都尉、侍中史丹護太子家","start_index":86,"tongjian_id":"64d978ca-a5b4-4e9f-9c63-d7599ca5f936"},{"confidence":0.85,"official_category":"中枢近臣","official_name":"侍中","official_note":"侍中是漢代重要官職，掌管宮廷詔命和顧問，常由皇帝親信擔任。在上下文中，史丹以侍中身份護衛太子家，體現其參與宮廷事務和輔佐太子的角色。","official_rank":"正三品","source_snippet":"是時駙馬都尉、侍中史丹護太子家","start_index":91,"tongjian_id":"4133caa3-77bd-43b0-8faf-1a3333a6338f"}],"ExtRef_Children_people":[{"link_death_year":-35,"link_td_description":"刘竟，汉宣帝第五子，生母戎婕妤。","link_td_id":"Q10004231","link_td_number_id":1296136,"people_name":"中山哀王","people_name_jianti_auto":"中山哀王","people_xingming":"刘竟","start_index":7,"tongjian_id":"919badb2-db0e-11ef-96d8-a0d3651f611f"},{"link_death_year":-35,"link_td_description":"刘竟，汉宣帝第五子，生母戎婕妤。","link_td_id":"Q10004231","link_td_number_id":1296136,"people_name":"竟","people_name_jianti_auto":"竟","people_xingming":"刘竟","start_index":11,"tongjian_id":"919badb3-db0e-11ef-9a18-a0d3651f611f"},{"link_death_year":-35,"link_td_description":"刘竟，汉宣帝第五子，生母戎婕妤。","link_td_id":"Q10004231","link_td_number_id":1296136,"people_name":"哀王","people_name_jianti_auto":"哀王","people_xingming":"刘竟","start_index":14,"tongjian_id":"919badb4-db0e-11ef-9e3b-a0d3651f611f","wl_zhushi":"[刘竟]"},{"link_death_year":-35,"link_td_description":"刘竟，汉宣帝第五子，生母戎婕妤。","link_td_id":"Q10004231","link_td_number_id":1296136,"people_name":"哀王","people_name_jianti_auto":"哀王","people_xingming":"刘竟","start_index":48,"tongjian_id":"919badb5-db0e-11ef-ba33-a0d3651f611f","wl_zhushi":"[刘竟]"},{"people_name":"史丹","people_name_jianti_auto":"史丹","people_xingming":"史丹","start_index":103,"tongjian_id":"919badb6-db0e-11ef-a8b3-a0d3651f611f"},{"people_name":"丹","people_name_jianti_auto":"丹","people_xingming":"史丹","start_index":114,"tongjian_id":"919badb7-db0e-11ef-8ad8-a0d3651f611f"},{"people_name":"丹","people_name_jianti_auto":"丹","people_xingming":"史丹","start_index":116,"tongjian_id":"919badb8-db0e-11ef-9be3-a0d3651f611f"},{"link_death_year":-35,"link_td_description":"刘竟，汉宣帝第五子，生母戎婕妤。","link_td_id":"Q10004231","link_td_number_id":1296136,"people_name":"中山王","people_name_jianti_auto":"中山王","people_xingming":"刘竟","start_index":130,"tongjian_id":"919badb9-db0e-11ef-bf12-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2六月，甲申，中山哀王竟薨。哀王者，帝之少弟，與太子游學相長大。及薨，太子前弔。上望見太子，感念哀王，悲不能自止。太子旣至前，不哀，上大恨曰：「安有人不慈仁，而可以奉宗廟，爲民父母者乎！」是時駙馬都尉、侍中史丹護太子家，上以責謂丹，丹免冠謝曰：「臣誠見陛下哀痛中山王，至以感損。向者太子當進見，臣竊戒屬，毋涕泣，感傷陛下；罪乃在臣，當死！」上以爲然，意乃解。","content_fanyi":"六月初五日甲申，中山哀王刘竟去世。哀王是汉元帝最小的弟弟，与太子刘骜从小一起游玩读书，一同长大。等到他去世，太子刘骜前来吊丧。汉元帝望见太子，感念哀王，悲哀得无法自制。太子已经走到近前，却不露悲色，汉元帝非常生气地说：“哪里有毫无慈爱仁心的人，能够承奉宗庙、做百姓父母的呢！”当时，驸马都尉、侍中史丹兼职护持太子家，汉元帝因此责备史丹。史丹脱下官帽谢罪说：“臣实在看到陛下哀痛中山王，以致伤感损神。刚才太子应当进见时，臣私下告诫嘱咐他不要流泪哭泣，以免触动陛下伤感；罪责在臣，臣该当死罪！”汉元帝认为他说得有理，心情才平静下来。","content_jianti_auto":"2六月，甲申，中山哀王竟薨。哀王者，帝之少弟，与太子游学相长大。及薨，太子前吊。上望见太子，感念哀王，悲不能自止。太子既至前，不哀，上大恨曰：「安有人不慈仁，而可以奉宗庙，为民父母者乎！」是时驸马都尉、侍中史丹护太子家，上以责谓丹，丹免冠谢曰：「臣诚见陛下哀痛中山王，至以感损。向者太子当进见，臣窃戒属，毋涕泣，感伤陛下；罪乃在臣，当死！」上以为然，意乃解。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2304,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"919bada8-db0e-11ef-8ad5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":32,"tongjian_id":"919badbc-db0e-11ef-80ba-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"藍田縣","place_name_jianti_auto":"蓝田县","start_index":0,"tongjian_id":"919badbd-db0e-11ef-9c0b-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":4,"tongjian_id":"919badbe-db0e-11ef-a0b9-a0d3651f611f"},{"place_name":"霸水","place_name_jianti_auto":"霸水","start_index":10,"tongjian_id":"919badbf-db0e-11ef-b2aa-a0d3651f611f"},{"place_name":"藍田縣","place_name_jianti_auto":"蓝田县","start_index":13,"tongjian_id":"919badc0-db0e-11ef-bf1c-a0d3651f611f"},{"place_name":"藍田谷","place_name_jianti_auto":"蓝田谷","start_index":16,"tongjian_id":"919badc1-db0e-11ef-ab07-a0d3651f611f"},{"place_name":"霸陵縣","place_name_jianti_auto":"霸陵县","start_index":21,"tongjian_id":"919badc2-db0e-11ef-90e9-a0d3651f611f"},{"place_name":"渭","place_name_jianti_auto":"渭","start_index":30,"tongjian_id":"919badc3-db0e-11ef-85fa-a0d3651f611f"},{"place_name":"安陵","place_name_jianti_auto":"安陵","start_index":36,"tongjian_id":"919badc4-db0e-11ef-a2c9-a0d3651f611f"},{"place_name":"惠帝陵","place_name_jianti_auto":"惠帝陵","start_index":40,"tongjian_id":"919badc5-db0e-11ef-8c1b-a0d3651f611f"},{"place_name":"涇水","place_name_jianti_auto":"泾水","start_index":44,"tongjian_id":"919badc6-db0e-11ef-8bb4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"藍田縣屬京兆。水經：霸水出藍田縣藍田谷，過霸陵縣，西北流注于渭。孟康曰：安陵岸，惠帝陵旁涇水岸也。","note_content_jianti_auto":"蓝田县属京兆。水经：霸水出蓝田县蓝田谷，过霸陵县，西北流注于渭。孟康曰：安陵岸，惠帝陵旁泾水岸也。","note_type":"hu_note","start_index":27,"tongjian_id":"919badbb-db0e-11ef-8c9c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"藍田","place_name_jianti_auto":"蓝田","resolved_place_entity_id":835,"start_index":1,"tongjian_id":"919badc8-db0e-11ef-99ac-a0d3651f611f"},{"place_name":"霸水","place_name_jianti_auto":"霸水","resolved_place_entity_id":5479,"start_index":10,"tongjian_id":"919badc9-db0e-11ef-bed0-a0d3651f611f"},{"place_name":"安陵","place_name_jianti_auto":"安陵","resolved_place_entity_id":2109,"start_index":13,"tongjian_id":"919badca-db0e-11ef-8e9b-a0d3651f611f"},{"place_name":"涇水","place_name_jianti_auto":"泾水","resolved_place_entity_id":2691,"start_index":19,"tongjian_id":"919badcb-db0e-11ef-bdfd-a0d3651f611f"},{"place_name":"涇水","place_name_jianti_auto":"泾水","resolved_place_entity_id":2691,"start_index":22,"tongjian_id":"919badcc-db0e-11ef-b2cb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"]。","context_before":"...。○泾水，在县东北四十里，自醴泉县流入境，与泾阳县分界。","source_end_index":115,"source_paragraph_tongjian_id":"01d2badf-bf12-5b23-b079-4ab4d521f52e","source_start_index":97,"source_text":"汉建始四年，安陵岸崩，壅泾水逆流是也"},{"context_after":"○浐水，在县南，北流经白鹿原西，又北合于霸水。《志》云：...","context_before":"...县之蓝田谷，亦曰蓝田谷水，经蓝关，历白鹿原东下，流入渭。","source_end_index":62,"source_paragraph_tongjian_id":"fc6c776a-e134-528f-9ea0-630f4e232b9a","source_start_index":44,"source_text":"汉建昭四年，蓝田山崩，壅霸水，即此。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"3藍田地震，山崩，壅霸水；安陵岸崩，壅涇水，涇水逆流。","content_fanyi":"蓝田县发生地震，山体崩塌，壅塞霸水；景帝陵所在的安陵一带泾水河岸崩塌，壅塞泾水，使泾水倒流。","content_jianti_auto":"3蓝田地震，山崩，壅霸水；安陵岸崩，壅泾水，泾水逆流。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2305,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"919badba-db0e-11ef-8f9e-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":6,"tongjian_id":"919bad75-db0e-11ef-97fd-a0d3651f611f","year_anno":"（丙戌、前三五）","year_int":-35},"message":"success","success":true}