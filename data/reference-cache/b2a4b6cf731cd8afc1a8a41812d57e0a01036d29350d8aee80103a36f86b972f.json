_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"少，詩照翻。及其生者，及其生而親見之。","note_content_jianti_auto":"少，诗照翻。及其生者，及其生而亲见之。","note_type":"hu_note","start_index":18,"tongjian_id":"8c83cc96-db0e-11ef-810b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-356,"link_death_year":-295,"link_td_description":"赵武灵王，嬴姓，赵氏，名雍，中国战国中后期赵国的君主。死后谥号武灵。","link_td_id":"Q10000536","link_td_number_id":193810,"people_name":"趙武靈王","people_name_jianti_auto":"赵武灵王","people_xingming":"赵雍","start_index":1,"tongjian_id":"8c83cc97-db0e-11ef-95f1-a0d3651f611f","wl_zhushi":"[赵雍]"},{"link_birth_year":-310,"link_death_year":-266,"link_td_description":"赵惠文王，亦称文王。名何，赵武灵王次子，周朝战国时期赵国君主。在位时有蔺相如、廉颇、李牧、赵奢等文武大臣，政治清明，武力强大。","link_td_id":"Q10000661","link_td_number_id":334704,"people_name":"何","people_name_jianti_auto":"何","people_xingming":"赵何","start_index":8,"tongjian_id":"8c83cc98-db0e-11ef-bfb1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"4趙武靈王愛少子何，欲及其生而立之。","content_fanyi":"赵武灵王喜爱小儿子赵何，想趁自己还在世时立他为王。","content_jianti_auto":"4赵武灵王爱少子何，欲及其生而立之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":290,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c83cc95-db0e-11ef-af9f-a0d3651f611f"}],"reign_name":"十五年","reign_name_jianti_auto":"十五年","start_index":14,"tongjian_id":"8c83cc6c-db0e-11ef-8f4c-a0d3651f611f","year_anno":"（辛酉、前三○○）","year_int":-300},"message":"success","success":true}