tongjian_id":"919badd8-db0e-11ef-8a76-a0d3651f611f","wl_zhushi":"[刘邦姐]"},{"link_death_year":-91,"link_td_description":"卫子夫，汉代平阳（今山西临汾）人，汉武帝第二任皇后，卫青的同母异父姐姐，霍去病的姨母，戾太子刘据的母亲，汉宣帝的曾祖母。","link_td_id":"Q10000909","link_td_number_id":434102,"people_name":"衞思后","people_name_jianti_auto":"衞思后","people_xingming":"卫子夫","start_index":32,"tongjian_id":"919badd9-db0e-11ef-8787-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"原廟","place_name_jianti_auto":"原庙","resolved_place_entity_id":4345,"start_index":17,"tongjian_id":"919badda-db0e-11ef-af51-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4秋，七月，庚子，復太上皇寢廟園、原廟、昭靈后、武哀王、昭哀后、衞思后園。時上寢疾，久不平，以爲祖宗譴怒，故盡復之；唯郡國廟遂廢云。","content_fanyi":"秋季，七月二十八日庚子，恢复太上皇的寝庙园、原庙，以及昭灵后、武哀王、昭哀后、卫思后的陵园。当时汉元帝正患病卧床，久治不愈，认为是祖宗在谴责怪罪他，因此把这些园庙全部恢复；只有郡国中的那些园庙最终不再恢复。","content_jianti_auto":"4秋，七月，庚子，复太上皇寝庙园、原庙、昭灵后、武哀王、昭哀后、衞思后园。时上寝疾，久不平，以为祖宗谴怒，故尽复之；唯郡国庙遂废云。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2309,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"919badd3-db0e-11ef-a840-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-23,"link_td_description":"定陶共王刘康，汉元帝次子，母傅昭仪。庶子刘欣即位后追尊共皇。","link_td_id":"Q10004634","link_td_number_id":1010863,"people_name":"濟陽王","people_name_jianti_auto":"济阳王","people_xingming":"刘康","start_index":5,"tongjian_id":"919baddd-db0e-11ef-be60-a0d3651f611f"},{"link_death_year":-23,"link_td_description":"定陶共王刘康，汉元帝次子，母傅昭仪。庶子刘欣即位后追尊共皇。","link_td_id":"Q10004634","link_td_number_id":1010863,"people_name":"康","people_name_jianti_auto":"康","people_xingming":"刘康","start_index":8,"tongjian_id":"919badde-db0e-11ef-b48c-a0d3651f611f"},{"link_death_year":-23,"link_td_description":"定陶共王刘康，汉元帝次子，母傅昭仪。庶子刘欣即位后追尊共皇。","link_td_id":"Q10004634","link_td_number_id":1010863,"people_name":"山陽王","people_name_jianti_auto":"山阳王","people_xingming":"刘康","start_index":10,"tongjian_id":"919baddf-db0e-11ef-b4b9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"，县仍属陈留。《后汉纪》：光武生于济阳宫，光明照室。盖县...","context_before":"...王初征至济阳，求长鸣鸡。又元帝永光三年，立子康为济阳王。","source_end_index":156,"source_paragraph_tongjian_id":"8b389a4d-6d01-5bd5-be9d-08eab9dea672","source_start_index":147,"source_text":"建昭五年，徙王山阳"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"5是歲，徙濟陽王康爲山陽王。","content_fanyi":"这一年，汉元帝把济阳王刘康改封为山阳王。","content_jianti_auto":"5是岁，徙济阳王康为山阳王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2310,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"919baddb-db0e-11ef-b3f2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"郅支","people_name_jianti_auto":"郅支","start_index":4,"tongjian_id":"919bade2-db0e-11ef-90c3-a0d3651f611f"},{"people_name":"郅支","people_name_jianti_auto":"郅支","start_index":31,"tongjian_id":"919bade3-db0e-11ef-b078-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":19,"tongjian_id":"919bade4-db0e-11ef-b884-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"喜者，以郅支旣誅而己無後患也。懼者，以漢威強，懼復得罪而滅亡如郅支也。","note_content_jianti_auto":"喜者，以郅支既诛而己无后患也。惧者，以汉威强，惧复得罪而灭亡如郅支也。","note_type":"hu_note","start_index":19,"tongjian_id":"919bade1-db0e-11ef-a919-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-31,"link_td_description":"呼韩邪单于（？－前31年），名稽侯狦，是西汉后期匈奴单于之一，挛鞮氏，虚闾权渠单于的儿子。","link_td_id":"Q10000775","link_td_number_id":356590,"people_name":"呼韓邪單于","people_name_jianti_auto":"呼韩邪单于","people_xingming":"挛鞮稽侯狦","start_index":3,"tongjian_id":"919df750-db0e-11ef-9baf-a0d3651f611f"},{"link_death_year":-36,"link_td_description":"郅支单于，全称郅支骨都侯单于，名呼屠吾斯，是匈奴的单于，于前56年—前36年在位，第12代虚闾权渠单于之子，呼韩邪单于的哥哥。","link_td_id":"Q10000539","link_td_number_id":366934,"people_name":"郅支","people_name_jianti_auto":"郅支","people_xingming":"挛鞮呼屠吾斯","start_index":9,"tongjian_id":"919df751-db0e-11ef-8273-a0d3651f611f","wl_zhushi":"[挛鞮呼屠吾斯]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":1,"tongjian_id":"919df752-db0e-11ef-b331-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"郅支之战","tongjian_id":"war_N0588"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"6匈奴呼韓邪單于聞郅支旣誅，且喜且懼；上書，願入朝見。","content_fanyi":"匈奴呼韩邪单于听说郅支单于已被诛杀，既高兴又害怕；于是上书汉朝，请求入京朝见。","content_jianti_auto":"6匈奴呼韩邪单于闻郅支既诛，且喜且惧；上书，愿入朝见。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2311,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"919bade0-db0e-11ef-9bdd-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":7,"tongjian_id":"919badcd-db0e-11ef-bfc6-a0d3651f611f","year_anno":"（丁亥、前三四）","year_int":-34},"message":"success","success":true}