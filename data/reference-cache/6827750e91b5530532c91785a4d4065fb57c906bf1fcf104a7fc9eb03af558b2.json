hildren_places":[{"place_name":"汝南郡","place_name_jianti_auto":"汝南郡","resolved_place_entity_id":7720,"start_index":24,"tongjian_id":"a8789bee-db0e-11ef-afd7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/七、汝宁府（卷五十）","excerpts":[{"context_after":"明年，魏人南寇，陷悬瓠。寻复得之。泰始三年，汝南太守常珍...","context_before":"...宁二年，燕李洪等攻汝南，败晋兵于悬瓠，郡守朱斌弃城走宋。","source_end_index":138,"source_paragraph_tongjian_id":"74eabc2b-ba31-56a4-9574-6cac43d9fd72","source_start_index":72,"source_text":"元嘉二十年，魏人入寇。时豫州刺史南平王铄镇寿阳，遣其属陈宪行汝南郡事，守悬瓠。魏人力攻，坏其南城，宪随方拒守，积四十余日，卒不能拔。"}],"path":"河南方舆纪要/七、汝宁府（卷五十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"是時，豫州刺史南平王鑠鎭壽陽，遣左軍行參軍陳憲行汝南郡事，守懸瓠，城中戰士不滿千人，魏主圍之。","content_fanyi":"这时，刘宋豫州刺史、南平王刘铄镇守寿阳，派遣左军行参军陈宪代理汝南郡太守职事，驻守悬瓠，城中战士不满千人，北魏太武帝率兵包围了悬瓠。","content_jianti_auto":"是时，豫州刺史南平王铄镇寿阳，遣左军行参军陈宪行汝南郡事，守悬瓠，城中战士不满千人，魏主围之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11661,"path":"资治通鉴 : 卷第一百二十五 (宋紀七) / 太祖文皇帝中之下 / 二十七年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"a8789bde-db0e-11ef-93eb-a0d3651f611f","year_int":450},"tongjian_id":"a8789bde-db0e-11ef-93eb-a0d3651f611f"},"paragraph_order":1}],"page_size":10,"total_pages":1,"total_paragraphs":1},"place_name":"汝南郡"},"message":"success","success":true}