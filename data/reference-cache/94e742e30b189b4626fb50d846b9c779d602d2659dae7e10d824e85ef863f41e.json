xtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f","pinyin":"lǐn","source_anchor_text":"周取陵觀廩丘楚昭奚","source_key":"baiyang_epub","start_index":10,"text":"廩","tongjian_id":"2b062e55-3977-5881-8f2d-4a8ac6b8f87d"}],"ExtRef_Children_places":[{"place_name":"東周","place_name_jianti_auto":"东周","place_note":"府巩县，河南巩县","resolved_place_entity_id":4746,"start_index":3,"tongjian_id":"8c2b9cc0-db0e-11ef-9d6d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、怀庆府（卷四十九）","excerpts":[{"context_after":"秦昭王四十一年，攻魏，取邢丘、怀。又秦始皇五年，蒙骜伐魏...","context_before":"...晋侯于邢丘。《战国策》：范雎说秦攻邢丘，邢丘拔而魏请附。","source_end_index":124,"source_paragraph_tongjian_id":"a68ffbc0-58de-5026-a874-5fdf478e1ce6","source_start_index":105,"source_text":"《史记》：韩昭侯六年，伐东周，取邢丘。"}],"path":"河南方舆纪要/三、怀庆府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2韓伐東周，取陵觀、廩丘。","content_fanyi":"韩国攻打东周，攻取了陵观、廪丘。","content_jianti_auto":"2韩伐东周，取陵观、廪丘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":143,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十六年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f","year_int":-353},"tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"東周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，湖北江陵","start_index":3,"tongjian_id":"8cafcf35-db0e-11ef-8d0a-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":14,"tongjian_id":"8cafcf36-db0e-11ef-8adf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令尹，楚上卿，執其國之政，猶秦之丞相也。令，力正翻。","note_content_jianti_auto":"令尹，楚上卿，执其国之政，犹秦之丞相也。令，力正翻。","note_type":"hu_note","start_index":38,"tongjian_id":"8cafcf34-db0e-11ef-8312-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":12,"tongjian_id":"8cafcf38-db0e-11ef-a2d1-a0d3651f611f"},{"people_name":"敬王","people_name_jianti_auto":"敬王","start_index":53,"tongjian_id":"8cafcf39-db0e-11ef-a05a-a0d3651f611f"},{"people_name":"孝王","people_name_jianti_auto":"孝王","start_index":57,"tongjian_id":"8cafcf3a-db0e-11ef-bb01-a0d3651f611f"},{"people_name":"桓公","people_name_jianti_auto":"桓公","start_index":62,"tongjian_id":"8cafcf3b-db0e-11ef-9d70-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":69,"tongjian_id":"8cafcf3c-db0e-11ef-aa29-a0d3651f611f"},{"people_name":"惠公","people_name_jianti_auto":"惠公","start_index":77,"tongjian_id":"8cafcf3d-db0e-11ef-ba7d-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":91,"tongjian_id":"8cafcf3e-db0e-11ef-8eed-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","start_index":4,"tongjian_id":"8cafcf3f-db0e-11ef-8374-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":16,"tongjian_id":"8cafcf40-db0e-11ef-8c54-a0d3651f611f"},{"place_name":"成周","place_name_jianti_auto":"成周","start_index":20,"tongjian_id":"8cafcf41-db0e-11ef-ad97-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":26,"tongjian_id":"8cafcf42-db0e-11ef-abf9-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":38,"tongjian_id":"8cafcf43-db0e-11ef-b0c3-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":44,"tongjian_id":"8cafcf44-db0e-11ef-836a-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":65,"tongjian_id":"8cafcf45-db0e-11ef-8556-a0d3651f611f"},{"place_name":"鞏","place_name_jianti_auto":"巩","start_index":84,"tongjian_id":"8cafcf46-db0e-11ef-8eec-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":88,"tongjian_id":"8cafcf47-db0e-11ef-a2bf-a0d3651f611f"},{"place_name":"東","place_name_jianti_auto":"东","start_index":95,"tongjian_id":"8cafcf48-db0e-11ef-995c-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":97,"tongjian_id":"8cafcf49-db0e-11ef-aee8-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":105,"tongjian_id":"8cafcf4a-db0e-11ef-b6a3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言天下共宗周以爲諸侯主。杜佑曰：洛陽，古成周之地。今洛陽城東三十餘里故城，是周之下都也。晉帥諸侯城之，以居敬王。至孝王封其弟桓公於河南以續周公之官職，至孫惠公乃封少子於鞏，號曰東周。赧王立，東、西周分理，又徙都西周，則王城也。帥，讀曰率。少，始照翻。鞏，居勇翻。赧，奴版翻。","note_content_jianti_auto":"言天下共宗周以为诸侯主。杜佑曰：洛阳，古成周之地。今洛阳城东三十余里故城，是周之下都也。晋帅诸侯城之，以居敬王。至孝王封其弟桓公于河南以续周公之官职，至孙惠公乃封少子于巩，号曰东周。赧王立，东、西周分理，又徙都西周，则王城也。帅，读曰率。少，始照翻。巩，居勇翻。赧，奴版翻。","note_type":"hu_note","start_index":87,"tongjian_id":"8cafcf37-db0e-11ef-b5a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","start_index":1,"tongjian_id":"8cafcf4c-db0e-11ef-9ee0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂三代所傳之祭器，如九鼎之類是也。","note_content_jianti_auto":"谓三代所传之祭器，如九鼎之类是也。","note_type":"hu_note","start_index":133,"tongjian_id":"8cafcf4b-db0e-11ef-8d5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉伯莊","people_name_jianti_auto":"刘伯庄","start_index":5,"tongjian_id":"8cafcf4e-db0e-11ef-9a10-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。劉伯莊曰：虎之爪牙如兵之利刃在身，其肉雖臊而人猶攻之者，以其皮之所在也。鹿之大者曰麋，麋無爪牙之利而肉可食；若更蒙虎之皮，人之攻之必萬倍於虎矣。臊，蘇遭翻。魚腥，肉臊。麋，武悲翻。更，古孟翻。","note_content_jianti_auto":"夫，音扶。刘伯庄曰：虎之爪牙如兵之利刃在身，其肉虽臊而人犹攻之者，以其皮之所在也。鹿之大者曰麋，麋无爪牙之利而肉可食；若更蒙虎之皮，人之攻之必万倍于虎矣。臊，苏遭翻。鱼腥，肉臊。麋，武悲翻。更，古孟翻。","note_type":"hu_note","start_index":168,"tongjian_id":"8cafcf4d-db0e-11ef-89d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","start_index":13,"tongjian_id":"8cafcf55-db0e-11ef-87ba-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":19,"tongjian_id":"8cafcf56-db0e-11ef-8058-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":21,"tongjian_id":"8cafcf57-db0e-11ef-875c-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":32,"tongjian_id":"8cafcf58-db0e-11ef-8820-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":40,"tongjian_id":"8cafcf59-db0e-11ef-975e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"共，音如字。傳，直專翻。言三代之器傳於周，周亡則所傳之器將南歸於楚，天下將合兵至楚而共討其罪也。","note_content_jianti_auto":"共，音如字。传，直专翻。言三代之器传于周，周亡则所传之器将南归于楚，天下将合兵至楚而共讨其罪也。","note_type":"hu_note","start_index":223,"tongjian_id":"8cafcf54-db0e-11ef-abcf-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8cafcf33-db0e-11ef-a3e8-a0d3651f611f","pinyin":"sāo","source_anchor_text":"也夫虎肉臊而兵利身","source_key":"baiyang_epub","start_index":136,"text":"臊","tongjian_id":"2590bec6-2156-5ec1-998c-c45340935df8"}],"ExtRef_Children_places":[{"place_name":"東周","place_name_jianti_auto":"东周","place_note":"府巩县，河南巩县","resolved_place_entity_id":4746,"start_index":18,"tongjian_id":"8cafcf61-db0e-11ef-be1a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3楚欲與齊、韓共伐秦，因欲圖周。王使東周武公謂楚令尹昭子曰：「周不可圖也。」昭子曰：「乃圖周，則無之；雖然，何不可圖？」武公曰：「西周之地，絕長補短，不過百里。名爲天下共主，裂其地不足以肥國，得其衆不足以勁兵。雖然，攻之者名爲弑君。然而猶有欲攻之者，見祭器在焉故也。夫虎肉臊而兵利身，人猶攻之；若使澤中之麋蒙虎之皮，人之攻之也必萬倍矣。裂楚之地，足以肥國，詘楚之名，足以尊王。今子欲誅殘天下之共主，居三代之傳器，器南，則兵至矣！」於是楚計輟不行。","content_fanyi":"楚国想要与齐国、韩国一起讨伐秦国，趁机图谋攻占西周。周赧王派东周的武公对楚国令尹昭子说：“西周国是不可图谋占领的。”昭子说：“攻占西周，是没有这回事的；尽管如此，为什么不可以占领西周呢？”武公说：“西周如今的土地，取长补短，不超过方圆百里。它名义上是天下共同的君主，占据它的土地不足以使国家富足，得到它的民众不足以使军队强盛。即使如此，攻打它的人要背上臣子弑君的罪名。然而仍有人想攻占它，是因为古代祭祀重器还在那里。老虎的肉腥臊，身上又有如同兵器般锋利的爪牙护身，人们尚且去猎杀它；如果让草泽中的麋鹿披上诱人的虎皮，人们攻击它的次数必定比攻击老虎还要多上万倍。割占楚国的土地，足以使国家富足；使楚国屈服的名声，足以使国君享有称王的尊荣。如今你想杀害天下共同的君主，占有夏、商、周三代相传的祭器国宝，祭器一旦南运到楚国，讨伐的军队也就到了！”于是，楚国中止了攻占西周的计划。","content_jianti_auto":"3楚欲与齐、韩共伐秦，因欲图周。王使东周武公谓楚令尹昭子曰：「周不可图也。」昭子曰：「乃图周，则无之；虽然，何不可图？」武公曰：「西周之地，绝长补短，不过百里。名为天下共主，裂其地不足以肥国，得其众不足以劲兵。虽然，攻之者名为弑君。然而犹有欲攻之者，见祭器在焉故也。夫虎肉臊而兵利身，人犹攻之；若使泽中之麋蒙虎之皮，人之攻之也必万倍矣。裂楚之地，足以肥国，诎楚之名，足以尊王。今子欲诛残天下之共主，居三代之传器，器南，则兵至矣！」于是楚计辍不行。","dtjl_paragraph_links":[],"dtjl_references":[],"id":355,"number":3,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 三十四年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8cafcf33-db0e-11ef-a3e8-a0d3651f611f","year_int":-281},"tongjian_id":"8cafcf33-db0e-11ef-a3e8-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"東周"},"message":"success","success":true}