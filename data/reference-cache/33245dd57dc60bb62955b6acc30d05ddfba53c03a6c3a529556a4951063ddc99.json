用於描述其身份和與沛王的關係。","official_rank":"侯爵","source_snippet":"會更始之子壽光侯鯉得幸於沛王","start_index":176,"tongjian_id":"4a69b188-e0b0-4c91-aeb2-dda79addf064"},{"confidence":0.9,"official_category":"地方行政","official_name":"沛王","official_note":"沛王是漢代的諸侯王，封地在沛，此處指劉秀的兒子或親屬，因賓客事件被牽連入獄。","official_rank":"王爵","source_snippet":"會更始之子壽光侯鯉得幸於沛王","start_index":184,"tongjian_id":"5f1a08ce-50b4-4b60-8d3b-c88c832f2ff4"},{"confidence":0.9,"official_category":"爵位","official_name":"式侯","official_note":"式侯是漢代的爵位，屬於列侯，此處指已故的侯爵恭，被壽光侯鯉的賓客殺害。","official_rank":"侯爵","source_snippet":"結客殺故式侯恭","start_index":196,"tongjian_id":"29684982-59e7-477f-80d3-d7cb2e2b2c18"},{"confidence":0.8,"official_category":"軍事指揮","official_name":"馬將軍","official_note":"馬將軍指馬援，他曾任伏波將軍等職，此處是呂种對他的尊稱，表示馬援的預見能力。","official_rank":"將軍","source_snippet":"馬將軍誠神人也","start_index":310,"tongjian_id":"b858629f-866f-460b-9d6e-fff3e1cc5429"}],"ExtRef_Children_people":[{"link_birth_year":-14,"link_death_year":49,"link_td_description":"马援，字文渊，扶风郡茂陵（今陕西省兴平市东北）人，东汉军事家。汉光武帝时，拜为伏波将军，封新息侯，世称马伏波。","link_td_id":"Q10000488","link_td_number_id":135961,"people_name":"馬援","people_name_jianti_auto":"马援","people_xingming":"马援","start_index":3,"tongjian_id":"94ec5bb5-db0e-11ef-87fd-a0d3651f611f"},{"link_death_year":46,"link_td_description":"王磐，字子石，东汉人，王莽三叔平阿侯王譚之孙，王仁之子，马援的侄婿。","link_td_id":"Q10018034","link_td_number_id":5383086,"people_name":"王磐","people_name_jianti_auto":"王磐","people_xingming":"王磐","start_index":8,"tongjian_id":"94ec5bb6-db0e-11ef-8fce-a0d3651f611f"},{"link_death_year":3,"link_td_description":"王仁，西汉外戚，王莽三叔平阿侯王譚之长子，王去疾、王閎、王向之兄。","link_td_id":"Q10003975","link_td_number_id":5383037,"people_name":"平阿侯","people_name_jianti_auto":"平阿侯","people_xingming":"王仁","start_index":11,"tongjian_id":"94ec5bb7-db0e-11ef-8c8a-a0d3651f611f"},{"link_death_year":3,"link_td_description":"王仁，西汉外戚，王莽三叔平阿侯王譚之长子，王去疾、王閎、王向之兄。","link_td_id":"Q10003975","link_td_number_id":5383037,"people_name":"仁","people_name_jianti_auto":"仁","people_xingming":"王仁","start_index":14,"tongjian_id":"94ec5bb8-db0e-11ef-a7e0-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"王莽","people_name_jianti_auto":"王莽","people_xingming":"王莽","start_index":19,"tongjian_id":"94ec5bb9-db0e-11ef-a01e-a0d3651f611f"},{"link_death_year":46,"link_td_description":"王磐，字子石，东汉人，王莽三叔平阿侯王譚之孙，王仁之子，马援的侄婿。","link_td_id":"Q10018034","link_td_number_id":5383086,"people_name":"磐","people_name_jianti_auto":"磐","people_xingming":"王磐","start_index":23,"tongjian_id":"94ec5bba-db0e-11ef-8832-a0d3651f611f"},{"link_birth_year":-14,"link_death_year":49,"link_td_description":"马援，字文渊，扶风郡茂陵（今陕西省兴平市东北）人，东汉军事家。汉光武帝时，拜为伏波将军，封新息侯，世称马伏波。","link_td_id":"Q10000488","link_td_number_id":135961,"people_name":"援","people_name_jianti_auto":"援","people_xingming":"马援","start_index":50,"tongjian_id":"94ec5bbb-db0e-11ef-82a2-a0d3651f611f"},{"people_name":"曹訓","people_name_jianti_auto":"曹训","people_xingming":"曹训","start_index":54,"tongjian_id":"94ec5bbc-db0e-11ef-ab9f-a0d3651f611f"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":59,"tongjian_id":"94ec5bbd-db0e-11ef-be5c-a0d3651f611f"},{"link_death_year":46,"link_td_description":"王磐，字子石，东汉人，王莽三叔平阿侯王譚之孙，王仁之子，马援的侄婿。","link_td_id":"Q10018034","link_td_number_id":5383086,"people_name":"子石","people_name_jianti_auto":"子石","people_xingming":"王磐","start_index":66,"tongjian_id":"94ec5bbe-db0e-11ef-8f76-a0d3651f611f"},{"link_death_year":46,"link_td_description":"王磐，字子石，东汉人，王莽三叔平阿侯王譚之孙，王仁之子，马援的侄婿。","link_td_id":"Q10018034","link_td_number_id":5383086,"people_name":"磐","people_name_jianti_auto":"磐","people_xingming":"王磐","start_index":102,"tongjian_id":"94ec5bc3-db0e-11ef-8904-a0d3651f611f"},{"link_death_year":46,"link_td_description":"王磐，字子石