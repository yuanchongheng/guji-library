places":[{"place_name":"魯","place_name_jianti_auto":"鲁","resolved_place_entity_id":506,"start_index":19,"tongjian_id":"94eb162e-db0e-11ef-bb1a-a0d3651f611f"},{"place_name":"東海","place_name_jianti_auto":"东海","resolved_place_entity_id":443,"start_index":21,"tongjian_id":"94eb162f-db0e-11ef-bb6b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"1春，正月，己巳，徙魯王興爲北海王；以魯益東海。帝以東海王彊去就有禮，故優以大封，食二十九縣，賜虎賁、旄頭，設鍾虡之樂，擬於乘輿。","content_fanyi":"春季，正月十三日己巳，改封鲁王刘兴为北海王；把鲁国并入东海国。光武帝认为东海王刘强去留进退有礼，所以用大国封地优待他，食邑二十九个县，赐给他虎贲武士和旄头仪仗，设置钟虡悬挂的编钟之乐，排场比拟天子。","content_jianti_auto":"1春，正月，己巳，徙鲁王兴为北海王；以鲁益东海。帝以东海王彊去就有礼，故优以大封，食二十九县，赐虎贲、旄头，设钟虡之乐，拟于乘舆。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3467,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"94eb1622-db0e-11ef-98e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":6,"link_death_year":52,"link_td_description":"郭圣通，为东汉光武帝刘秀的第二任妻子和首任皇后，真定槀县人，其父阳安思侯郭昌，其母为真定恭王刘普之女，号为郭主。","link_td_id":"Q10001464","link_td_number_id":520745,"people_name":"沛太后","people_name_jianti_auto":"沛太后","people_xingming":"郭圣通","start_index":9,"tongjian_id":"94eb1631-db0e-11ef-8c6c-a0d3651f611f"},{"link_birth_year":6,"link_death_year":52,"link_td_description":"郭圣通，为东汉光武帝刘秀的第二任妻子和首任皇后，真定槀县人，其父阳安思侯郭昌，其母为真定恭王刘普之女，号为郭主。","link_td_id":"Q10001464","link_td_number_id":520745,"people_name":"郭氏","people_name_jianti_auto":"郭氏","people_xingming":"郭圣通","start_index":12,"tongjian_id":"94eb1632-db0e-11ef-a67c-a0d3651f611f","wl_zhushi":"[郭圣通]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/田千秋郅恽","excerpts":[{"context_after":"此二人者，可谓善处人骨肉之间，谏不费词，婉而能入者矣。","context_before":"...人所难言也。公独明其不然，公当遂为吾辅佐。”遂拜为丞相。","source_end_index":162,"source_paragraph_tongjian_id":"a6b24b51-83c5-4a29-bf47-1782bd23c76b","source_start_index":68,"source_text":"光武废郭后，郅恽言曰：“夫妇之好，父不能得之于子，况臣能得之于君乎？是臣所不敢言。虽然，愿陛下念其可否之计，无令天下有议社稷而已。”帝曰：“恽善恕己量主。”遂以郭氏为中山王太后，卒以寿终。"}],"path":"随笔/卷二/田千秋郅恽","source_name":"容斋随笔"}],"class_tags":[],"content":"2夏，六月，丁卯，沛太后郭氏薨。","content_fanyi":"夏季，六月初七日丁卯，沛太后郭氏去世。","content_jianti_auto":"2夏，六月，丁卯，沛太后郭氏薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3468,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"94eb1630-db0e-11ef-a16a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"磐","people_name_jianti_auto":"磐","start_index":0,"tongjian_id":"94eb1636-db0e-11ef-bc3c-a0d3651f611f"},{"people_name":"子石","people_name_jianti_auto":"子石","start_index":3,"tongjian_id":"94eb1637-db0e-11ef-aa5f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"磐，字子石。屛，必郢翻。","note_content_jianti_auto":"磐，字子石。屛，必郢翻。","note_type":"hu_note","start_index":74,"tongjian_id":"94eb1635-db0e-11ef-b0f2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94eb1639-db0e-11ef-af37-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：長者，謂豪俠者也。余謂長者，正指諸貴戚耳，前所謂長者家兒，可以槪推。","note_content_jianti_auto":"贤曰：长者，谓豪侠者也。余谓长者，正指诸贵戚耳，前所谓长者家儿，可以槪推。","note_type":"hu_note","start_index":82,"tongjian_id":"94eb1638-db0e-11ef-a262-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef