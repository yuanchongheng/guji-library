3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":84,"tongjian_id":"8be19ec2-db0e-11ef-b42e-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":93,"tongjian_id":"8be19ec3-db0e-11ef-8538-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":108,"tongjian_id":"8be19ec4-db0e-11ef-b3fd-a0d3651f611f"},{"place_name":"韓原","place_name_jianti_auto":"韩原","start_index":112,"tongjian_id":"8be19ec5-db0e-11ef-af23-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":120,"tongjian_id":"8be19ec6-db0e-11ef-9165-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":135,"tongjian_id":"8be19ec7-db0e-11ef-a1c0-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":140,"tongjian_id":"8be19ec8-db0e-11ef-8fa8-a0d3651f611f"},{"place_name":"周室","place_name_jianti_auto":"周室","start_index":146,"tongjian_id":"8be19ec9-db0e-11ef-91ef-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":151,"tongjian_id":"8be19eca-db0e-11ef-bf5a-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":153,"tongjian_id":"8be19ecb-db0e-11ef-bbe6-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":170,"tongjian_id":"8be19ecc-db0e-11ef-a565-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此溫公書法所由始也。魏之先，畢公高後，與周同姓；其苗裔曰畢萬，始封於魏。至魏舒，始爲晉正卿；三世至斯。趙之先，造父後；至叔帶，始自周適晉；至趙夙，始封於耿。至趙盾，始爲晉正卿；六世至籍。韓之先，出於周武王；至韓武子事晉，封於韓原。至韓厥，爲晉正卿；六世至虔。三家者，世爲晉大夫，於周則陪臣也。周室旣衰，晉主夏盟，以尊王室，故命之爲伯。三卿竊晉之權，暴蔑其君，剖分其國，此王法所必誅也。威烈王不惟不能誅之，又命之爲諸侯，是崇獎奸名犯分之臣也，通鑑始於此，其所以謹名分歟！","note_content_jianti_auto":"此温公书法所由始也。魏之先，毕公高后，与周同姓；其苗裔曰毕万，始封于魏。至魏舒，始为晋正卿；三世至斯。赵之先，造父后；至叔带，始自周适晋；至赵夙，始封于耿。至赵盾，始为晋正卿；六世至籍。韩之先，出于周武王；至韩武子事晋，封于韩原。至韩厥，为晋正卿；六世至虔。三家者，世为晋大夫，于周则陪臣也。周室既衰，晋主夏盟，以尊王室，故命之为伯。三卿窃晋之权，暴蔑其君，剖分其国，此王法所必诛也。威烈王不惟不能诛之，又命之为诸侯，是崇奖奸名犯分之臣也，通鉴始于此，其所以谨名分欤！","note_type":"hu_note","start_index":18,"tongjian_id":"8be19eaa-db0e-11ef-a0aa-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是春秋战国时期晋国的高级官职，通常指卿大夫，负责国家政务和军事。在《资治通鉴》此段中，魏斯、赵籍、韩虔原为晋国大夫，后被周威烈王封为诸侯，标志着三家分晋的开始。","official_rank":"未知","source_snippet":"晉大夫魏斯、趙籍、韓虔","start_index":3,"tongjian_id":"f48e8683-bfd4-4684-b07c-5d29b64b73a7"},{"confidence":0.85,"official_category":"地方行政","official_name":"諸侯","official_note":"诸侯是周朝分封制度下的地方统治者，拥有封地和自治权。在此段中，周威烈王正式任命魏斯、赵籍、韩虔为诸侯，这标志着晋国被分裂为魏、赵、韩三国，是战国时期的重要历史事件。","official_rank":"未知","source_snippet":"爲諸侯","start_index":15,"tongjian_id":"a21e225f-558b-45ca-8c65-e4a04665f1fb"}],"ExtRef_Children_people":[{"link_death_year":-400,"link_td_description":"赵烈侯，是中国战国时期赵国的君主，原名赵籍，赵献侯之子。","link_td_id":"Q10000666","link_td_number_id":334806,"people_name":"趙籍","people_name_jianti_auto":"赵籍","people_xingming":"赵籍","start_index":9,"tongjian_id":"8be19ecf-db0e-11ef-893d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/周汉存国","excerpts":[{"context_after":"，齐田氏代姜而兴，其有土各不及二百年，俱非旧邦。秦始皇乃...","context_before":"...侯千八百国，至王赧之亡，所存者才八国耳，七战国与卫也。然","source_end_index":42,"source_paragraph_tongjian_id":"42d5a99a-ff96-4284-a708-c3b672a939fa","source_start_index":33,"source_text":"赵、韩、魏分晋而立"}],"path":"随笔/卷十二/周汉存国","source_name":"容斋随笔"},{"display_title":"容斋随笔/卜子夏","excerpts":[{"context_after":"，去孔子卒时七十五年。文侯为大夫二十二年而为侯，又十六年...","context_before":"...矣。是时，周敬王四十一年，后一年元王立，历贞定王、考王，","source_end_index":80,"source_paragraph_tongjian_id":"4b1e305c-9d40-4764-94a5-a5aa733b8bdd","source_start_index":67,"source_text":"至威烈王二十三年，魏始为侯"}],"path":"续笔/卷二/卜子夏","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/◎分野（卷一百三十）","excerpts":[{"context_after":"后十七年，安王之时，三国共灭晋而分其地。后五十六年，显王...","context_before":"...杜佑《分野议》曰：《左传》周敬王鲁哀公之时，吴为越所灭。","source_end_index":1032,"source_paragraph_tongjian_id":"cb64e26d-35e9-5e60-9f72-44f0654c839b","source_start_index":1011,"source_text":"其后六十九年，至威烈王，始命韩魏赵为诸侯。"}],"path":"分野/◎分野（卷一百三十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1初命晉大夫魏斯、趙籍、韓虔爲諸侯。","content_fanyi":"周威烈王姬午首次册封晋国大夫魏斯、赵籍、韩虔为诸侯。","content_jianti_auto":"1初命晋大夫魏斯、赵籍、韩虔为诸侯。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1,"number":1,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8be19ea9-db0e-11ef-b00e-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000334"},"tongjian_id":"8be19ea9-db0e-11ef-b00e-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙襄子","people_name_jianti_auto":"赵襄子","start_index":10,"tongjian_id":"8bf40341-db0e-11ef-99f0-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":16,"tongjian_id":"8bf40342-db0e-11ef-ab0a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"代國","place_name_jianti_auto":"代国","start_index":0,"tongjian_id":"8bf40343-db0e-11ef-865a-a0d3651f611f"},{"place_name":"夏屋","place_name_jianti_auto":"夏屋","start_index":3,"tongjian_id":"8bf40344-db0e-11ef-82dd-a0d3651f611f"},{"place_name":"句注","place_name_jianti_auto":"句注","start_index":5,"tongjian_id":"8bf40345-db0e-11ef-9c02-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":19,"tongjian_id":"8bf40346-db0e-11ef-a418-a0d3651f611f"},{"place_name":"代縣","place_name_jianti_auto":"代县","start_index":21,"tongjian_id":"8bf40347-db0e-11ef-a783-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"代國在夏屋句注之北，趙襄子滅之。班志有代郡代縣。爲，于僞翻。夏，戶雅翻。","note_content_jianti_auto":"代国在夏屋句注之北，赵襄子灭之。班志有代郡代县。为，于伪翻。夏，户雅翻。","note_type":"hu_note","start_index":28,"tongjian_id":"