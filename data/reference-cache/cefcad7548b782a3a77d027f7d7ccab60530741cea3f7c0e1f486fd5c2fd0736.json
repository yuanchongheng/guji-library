d":"8cbd9aea-db0e-11ef-9e4d-a0d3651f611f"},{"place_name":"黔中郡","place_name_jianti_auto":"黔中郡","start_index":212,"tongjian_id":"8cbd9aeb-db0e-11ef-8303-a0d3651f611f"},{"place_name":"黔州","place_name_jianti_auto":"黔州","start_index":221,"tongjian_id":"8cbd9aec-db0e-11ef-855b-a0d3651f611f"},{"place_name":"夷","place_name_jianti_auto":"夷","start_index":224,"tongjian_id":"8cbd9aed-db0e-11ef-8ff3-a0d3651f611f"},{"place_name":"費","place_name_jianti_auto":"费","start_index":226,"tongjian_id":"8cbd9aee-db0e-11ef-b3e8-a0d3651f611f"},{"place_name":"思","place_name_jianti_auto":"思","start_index":228,"tongjian_id":"8cbd9aef-db0e-11ef-a42b-a0d3651f611f"},{"place_name":"播","place_name_jianti_auto":"播","start_index":230,"tongjian_id":"8cbd9af0-db0e-11ef-9afd-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":233,"tongjian_id":"8cbd9af1-db0e-11ef-8f8c-a0d3651f611f"},{"place_name":"黔中郡","place_name_jianti_auto":"黔中郡","start_index":234,"tongjian_id":"8cbd9af2-db0e-11ef-be9a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"括地志：黔中故城在辰州沅陵縣西二十二里江南，今黔府亦其地。按秦黔中郡地，非唐黔州地也。宋白曰：秦黔中郡所理在今辰州西二十里黔中故郡城是。漢改黔中爲武陵郡，移理義陵，卽今辰州潊浦縣是。後漢移理臨沅，卽今朗州所理是。今辰州潊、獎、溪、澧、朗、施八州，是秦、漢黔中郡之地。自永嘉之後，沒於夷、䝤；元魏之後，圖記不傳。至後周保定四年，涪陵首領田思鶴歸化，初於其地立奉州，續改爲黔州。大業中，又改爲黔安郡。因周、隋州郡之名，遂與秦、漢黔中郡交㸦難辨。今黔州及夷、費、思、播，與秦黔中郡隔越峻嶺，以山川言之，炳然自分。黔，其今翻，又其炎翻。沅，音元。潊，音敍。澧，里弟翻。䝤，魯皓翻。涪，音浮。㸦，與互同。費，兵媚翻，以水名。","note_content_jianti_auto":"括地志：黔中故城在辰州沅陵县西二十二里江南，今黔府亦其地。按秦黔中郡地，非唐黔州地也。宋白曰：秦黔中郡所理在今辰州西二十里黔中故郡城是。汉改黔中为武陵郡，移理义陵，即今辰州潊浦县是。后汉移理临沅，即今朗州所理是。今辰州潊、奖、溪、澧、朗、施八州，是秦、汉黔中郡之地。自永嘉之后，没于夷、䝤；元魏之后，图记不传。至后周保定四年，涪陵首领田思鹤归化，初于其地立奉州，续改为黔州。大业中，又改为黔安郡。因周、隋州郡之名，遂与秦、汉黔中郡交㸦难辨。今黔州及夷、费、思、播，与秦黔中郡隔越峻岭，以山川言之，炳然自分。黔，其今翻，又其炎翻。沅，音元。潊，音敍。澧，里弟翻。䝤，鲁皓翻。涪，音浮。㸦，与互同。费，兵媚翻，以水名。","note_type":"hu_note","start_index":17,"tongjian_id":"8cbd9abe-db0e-11ef-a466-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"武安君","official_note":"武安君是战国时期秦国的高级封号，通常授予功勋卓著的将领，如白起曾受此封。在《资治通鉴》此段中，武安君指挥平定巫、黔中地区，并初置黔中郡，体现了其在军事扩张和行政设置中的作用。","official_rank":"未知","source_snippet":"秦武安君定巫、黔中","start_index":1,"tongjian_id":"6c038325-3235-47b8-b10f-1766f04b5535"}],"ExtRef_Children_people":[{"link_birth_year":-332,"link_death_year":-257,"link_td_description":"白起，芈姓白氏，郿县人，战国时代军事家、秦国名将，兵家代表人物。担任秦国将领30多年，攻城70余座，被封为武安君。","link_td_id":"Q10008015","link_td_number_id":19391,"people_name":"武安君","people_name_jianti_auto":"武安君","people_xingming":"白起","start_index":2,"tongjian_id":"8cbd9af4-db0e-11ef-8da9-a0d3651f611f","wl_zhushi":"[白起]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8cbd9af5-db0e-11ef-a6d9-a0d3651f611f"},{"place_name":"巫","place_name_jianti_auto":"巫","place_note":"重庆巫山","resolved_place_entity_id":3159,"start_index":6,"tongjian_id":"8cbd9af6-db0e-11ef-a602-a0d3651f611f"},{"place_name":"黔中","place_name_jianti_auto":"黔中","place_note":"湖南西部及贵州东部","resolved_place_entity_id":1041,"start_index":8,"tongjian_id":"8cbd9af7-db0e-11ef-ad66-a0d3651f611f"},{"place_name":"黔中郡","place_name_jianti_auto":"黔中郡","place_note":"府设湖南沅陵","resolved_place_entity_id":5580,"start_index":13,"tongjian_id":"8cbd9af8-db0e-11ef-94d2-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"鄢郢之战","tongjian_id":"war_N0527"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、夔州府（卷六十九）","excerpts":[{"context_after":"汉因之。后汉建安中，先主改属宜都郡。二十四年，孙权分宜都...","context_before":"...山县[府东百三十里。东至湖广巴东县百六十里。楚之巫郡也。","source_end_index":55,"source_paragraph_tongjian_id":"12e2fd1f-9053-5df0-b2c8-26a50d9f822f","source_start_index":29,"source_text":"秦昭襄王三十年，蜀守张若取巫郡，寻改置巫县，属南郡。"}],"path":"四川方舆纪要/四、夔州府（卷六十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷七十五）","excerpts":[{"context_after":"汉武置十三州，此亦为荆州[其五溪地，自汉以后，历代开拓]...","context_before":"...荆也]。春秋至战国，并为楚地。其在天文，翼、轸则楚分野。","source_end_index":126,"source_paragraph_tongjian_id":"2130dd09-1e34-511b-9f5c-69bb2b0ac912","source_start_index":109,"source_text":"秦并天下，置南郡、黔中、长沙等郡。"}],"path":"湖广方舆纪要/〇、封域山川险要（卷七十五）","source_name":"读史方舆纪要"}],"class_tags":["军事","内政"],"content":"1秦武安君定巫、黔中，初置黔中郡。","content_fanyi":"秦国武安君白起完全控制了楚国的巫、黔中，开始设置黔中郡。","content_jianti_auto":"1秦武安君定巫、黔中，初置黔中郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":371,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8cbd9abd-db0e-11ef-854d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"安釐王","people_name_jianti_auto":"安厘王","start_index":4,"tongjian_id":"8cbd9afb-db0e-11ef-afa5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"世本曰：安釐王，名圉。釐，讀曰僖。","note_content_jianti_auto":"世本曰：安厘王，名圉。厘，读曰僖。","note_type":"hu_note","start_index":12,"tongjian_id":"8cbd9afa-db0e-11ef-818f-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-277,"link_td_description":"魏昭王，名魏遫，魏襄王之子。孟尝君奔魏，魏昭王以为相，与诸侯共伐破齐。前277年，魏昭王薨，子安釐王立。","link_td_id":"Q10001810","link_td_number_id":334900,"people_name":"魏昭王","people_name_jianti_auto":"魏昭王","people_xingming":"遫","start_index":1,"tongjian_id":"8cbd9afd-db0e-11ef-aa23-a0d3651f611f","wl_zhushi":"[遫]"},{"link_death_year":-243,"link_td_description":"魏安釐王，或作魏安禧王、魏安僖王，姬姓，魏氏，名圉，魏昭王之子。","link_td_id":"Q10000680","link_td_number_id":334917,"people_name":"安釐王","people_name_jianti_auto":"安厘王","people_xingming":"圉","start_index":7,"tongjian_id":"8cbd9afe-db0e-11ef-aad9-a0d3651f611f","wl_zhushi":"[圉]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2魏昭王薨，子安釐王立。","cont