tongjian_id":"bd6b1b2d-db0e-11ef-91fa-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","resolved_place_entity_id":51,"start_index":45,"tongjian_id":"bd6b1b2e-db0e-11ef-abe6-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","resolved_place_entity_id":51,"start_index":47,"tongjian_id":"bd6b1b2f-db0e-11ef-9386-a0d3651f611f"},{"place_name":"京城","place_name_jianti_auto":"京城","resolved_place_entity_id":413,"start_index":49,"tongjian_id":"bd6b1b30-db0e-11ef-9dc9-a0d3651f611f"},{"place_name":"望春樓","place_name_jianti_auto":"望春楼","resolved_place_entity_id":3808,"start_index":69,"tongjian_id":"bd6b1b31-db0e-11ef-9f04-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","place_note":"陕郡郡政府所在县•河南省三门峡市","resolved_place_entity_id":307,"start_index":99,"tongjian_id":"bd6b1b32-db0e-11ef-98a0-a0d3651f611f"},{"place_name":"廣運","place_name_jianti_auto":"广运","resolved_place_entity_id":6938,"start_index":201,"tongjian_id":"bd6b1b37-db0e-11ef-9493-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":217,"start_index":205,"tongjian_id":"bd6b1b38-db0e-11ef-8ead-a0d3651f611f"},{"place_name":"渭水","place_name_jianti_auto":"渭水","resolved_place_entity_id":397,"start_index":213,"tongjian_id":"bd6b1b39-db0e-11ef-8542-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"今湮废]。","context_before":"...，至潼关。王镇恶请率水军自河入渭，即渭口也。又县有漕渠。","source_end_index":218,"source_paragraph_tongjian_id":"e840ffc3-2c0f-5b2b-9c9f-c20c2ee41bcb","source_start_index":184,"source_text":"唐天宝初，韦坚自禁苑西引渭水，因石渠，会灞、浐，经广运潭，至县入渭。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":["内政","人事"],"content":"4江、淮南租庸等使韋堅引滻水抵苑東望春樓下爲潭，以聚江、淮運船，役夫匠通漕渠，發人丘壟，自江、淮至京城，民間蕭然愁怨。二年而成。丙寅，上幸望春樓觀新潭。堅以新船數百艘，扁榜郡名，各陳郡中珍貨於船背；陝尉崔成甫著錦半臂，鈌胯綠衫以裼之，紅袹首，居前船唱得寶歌，使美婦百人盛飾而和之，連檣數里；堅跪進諸郡輕貨，仍上百牙盤食。上置宴，竟日而罷，觀者山積。夏，四月，加堅左散騎常侍，其僚屬吏卒褒賞有差；名其潭曰廣運。時京兆尹韓朝宗亦引渭水置潭於西街，以貯材木。","content_fanyi":"江、淮南租庸等使韦坚引导浐水到禁苑东边望春楼下积聚为潭，用来聚集停泊江、淮地区的运输船只，又役使民夫工匠开通漕运渠道，挖掘百姓坟墓，从江、淮一直到京城，民间萧条哀愁，怨声载道。历时两年才完工。三月二十六日丙寅，玄宗驾临望春楼观赏新潭。韦坚用数百艘新船，在船上张挂书写各郡名称的匾额，并在船上分别陈列各郡出产的珍奇货物；陕县县尉崔成甫穿着锦制半臂短衣，外罩缺胯绿衫，袒露胸臂，头裹红巾，站在前面的船上高唱《得宝歌》，让一百名美女盛装打扮随声应和，船桅相连，绵延数里；韦坚跪着进献各郡的丝绸绢帛等轻货，又进上一百个盛有珍奇食物的牙盘。玄宗摆设宴席，整整一天才结束，观看的人堆积如山。夏季四月，加授韦坚为左散骑常侍，他的同僚、属官、吏卒分别得到不同赏赐；将那个潭命名为广运。当时，京兆尹韩朝宗也引渭水在西街开置水潭，用来贮存木材。","content_jianti_auto":"4江、淮南租庸等使韦坚引浐水抵苑东望春楼下为潭，以聚江、淮运船，役夫匠通漕渠，发人丘垄，自江、淮至京城，民间萧然愁怨。二年而成。丙寅，上幸望春楼观新潭。坚以新船数百艘，扁榜郡名，各陈郡中珍货于船背；陕尉崔成甫著锦半臂，鈌胯绿衫以裼之，红袹首，居前船唱得宝歌，使美妇百人盛饰而和之，连樯数里；坚跪进诸郡轻货，仍上百牙盘食。上置宴，竟日而罢，观者山积。夏，四月，加坚左散骑常侍，其僚属吏卒褒赏有差；名其潭曰广运。时京兆尹韩朝宗亦引渭水置潭于西街，以贮材木。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21708,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"bd6b1b10-db0e-11ef-8258-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"主动出击吐蕃洪济城","decision_tongjian_id":"DECISION_BD6B1B3ADB0E11EF8FF4A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"西平郡","place_name_jianti_auto":"西平郡","start_index":0,"tongjian_id":"bd6b1b3c-db0e-11ef-8d6f-a0d3651f611f"},{"place_name":"鄯州","place_name_jianti_auto":"鄯州","start_index":4,"tongjian_id":"bd6b1b3d-db0e-11ef-867a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西平郡卽鄯州。","note_content_jianti_auto":"西平郡即鄯州。","note_type":"hu_note","start_index":14,"tongjian_id":"bd6b1b3b-db0e-11ef-a95c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"bd6b1b3f-db0e-11ef-823e-a0d3651f611f"},{"people_name":"周武帝","people_name_jianti_auto":"周武帝","start_index":14,"tongjian