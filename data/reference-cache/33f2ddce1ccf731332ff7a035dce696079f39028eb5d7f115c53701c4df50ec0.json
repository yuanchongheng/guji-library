7-a0d3651f611f"},{"place_name":"劍南","place_name_jianti_auto":"剑南","start_index":170,"tongjian_id":"bd6b1b51-db0e-11ef-8e68-a0d3651f611f"},{"place_name":"洪濟城","place_name_jianti_auto":"洪济城","start_index":180,"tongjian_id":"bd6b1b52-db0e-11ef-ba01-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":186,"tongjian_id":"bd6b1b53-db0e-11ef-a8ef-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：廓州達化縣有洪濟鎭，周武帝逐吐谷渾所築，在縣西二百七十里。長慶中，劉元鼎爲盟會使，言河之上流，由洪濟西行二千里，水益狹，冬、春可涉，夏、秋乃勝舟。其南三百里，三山中高四下，曰歷山，直大羊同國，古所謂昆侖者也，虜曰悶摩黎山，東距長安五千里，河源其間，流澄緩下，稍合衆流，色赤，行益遠，他水幷注則濁。河源東北直莫賀延磧尾，隱測其地，蓋在劍南之西。此劉元鼎因洪濟城而上敍河源，附見于此。","note_content_jianti_auto":"杜佑曰：廓州达化县有洪济镇，周武帝逐吐谷浑所筑，在县西二百七十里。长庆中，刘元鼎为盟会使，言河之上流，由洪济西行二千里，水益狭，冬、春可涉，夏、秋乃胜舟。其南三百里，三山中高四下，曰历山，直大羊同国，古所谓昆仑者也，虏曰闷摩黎山，东距长安五千里，河源其间，流澄缓下，稍合众流，色赤，行益远，他水幷注则浊。河源东北直莫贺延碛尾，隐测其地，盖在剑南之西。此刘元鼎因洪济城而上敍河源，附见于此。","note_type":"hu_note","start_index":31,"tongjian_id":"bd6b1b3e-db0e-11ef-81b4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":747,"link_td_description":"皇甫惟明，曾任742年－746年的陇右节度使、746年兼任河西节度使。","link_td_id":"Q10017852","link_td_number_id":5305736,"people_name":"皇甫惟明","people_name_jianti_auto":"皇甫惟明","people_xingming":"皇甫惟明","start_index":4,"tongjian_id":"bd6b1b54-db0e-11ef-b678-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西平","place_name_jianti_auto":"西平","resolved_place_entity_id":686,"start_index":11,"tongjian_id":"bd6b1b55-db0e-11ef-9523-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":15,"tongjian_id":"bd6b1b56-db0e-11ef-905e-a0d3651f611f"},{"place_name":"洪濟城","place_name_jianti_auto":"洪济城","place_note":"青海省共和县东南","resolved_place_entity_id":7847,"start_index":24,"tongjian_id":"bd6b1b57-db0e-11ef-b02a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"《唐志》云：廓州西南百四十里为洪济桥。其相近有金天军，天...","context_before":"...里。后周武帝逐吐谷浑，置洪济镇。其后吐蕃亦置洪济城于此。","source_end_index":69,"source_paragraph_tongjian_id":"f0e53558-0f35-5a1c-9000-1144505998c3","source_start_index":51,"source_text":"唐天宝二载，皇甫维明攻洪济城，克之。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"5丁亥，皇甫惟明引軍出西平，擊吐蕃，行千餘里，攻洪濟城，破之。","content_fanyi":"四月十八日丁亥，陇右节度使皇甫惟明率领军队从西平郡出发，进攻吐蕃，行军一千余里，攻打吐蕃的洪济城，攻克了该城。","content_jianti_auto":"5丁亥，皇甫惟明引军出西平，击吐蕃，行千余里，攻洪济城，破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21709,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"bd6b1b3a-db0e-11ef-8ff4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"龍朔二年，改太子中允爲贊善大夫；咸亨元年復置中允，而贊善大夫不廢，後又分左、右，各置五員，班左、右諭德下。諭德掌諭太子以道德；贊善掌翊贊太子以規諷。","note_content_jianti_auto":"龙朔二年，改太子中允为赞善大夫；咸亨元年复置中允，而赞善大夫不废，后又分左、右，各置五员，班左、右谕德下。谕德掌谕太子以道德；赞善掌翊赞太子以规讽。","note_type":"hu_note","start_index":11,"tongjian_id":"bd6b1b59-db0e-11ef-b7d9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"右贊善大夫","official_note":"右贊善大夫是唐代東宮官職，負責輔導太子，屬文教類。在原文中，楊愼矜原任此職，後被任命知御史中丞事，顯示其職務變動。","official_rank":"從五品上","source_snippet":"右贊善大夫楊愼矜","start_index":3,"tongjian_id":"5111d618-7e12-4924-8237-4c3dd4d69a42"},{"confidence":0.95,"official_category":"监察","official_name":"御史中丞","official_note":"御史中丞是唐代御史臺的副長官，負責監察百官，屬監察類。在原文中，楊愼矜被任命知御史中丞事，但由於李林甫專權，他固辭不敢受，反映了當時政治環境的緊張。","official_rank":"正四品下","source_snippet":"知御史中丞事","start_index":12,"tongjian_id":"b840384e-53a7-414b-b602-9aeb1f22988d"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"諫議大夫","official_note":"諫議大夫是唐代門下省的官職，負責規諫皇帝，屬中樞近臣類。在原文中，楊愼矜最終被任命為此職，取代了原計劃的御史中丞，可能出於避開李林甫權勢的考慮。","official_rank":"正五品上","source_snippet":"以愼矜爲諫議大夫","start_index":58,"tongjian_id":"0f670d03-f873-4b66-9120-a4e9687c8a05"}],"ExtRef_Children_people":[{"link_death_year":747,"link_td_description":"杨慎矜，唐朝政治人物，隋炀帝后代。曾依附杨国忠、李林甫，诬陷大臣，后因得罪李林甫，被唐玄宗赐死。","link_td_id":"Q10009499","link_td_number_id":722178,"people_name":"楊愼矜","people_name_jianti_auto":"杨愼矜","people_xingming":"杨慎矜","start_index":8,"tongjian_id":"bd6b1b5b-db0e-11ef-9265-a0d3651f611f"},{"link_birth_year":683,"link_death_year":753,"link_td_description":"李林甫，小名哥奴，号月堂，陕西人。唐朝远房宗室、权臣、奸臣。唐玄宗开元二十二年（734年）五月，出任礼部尚书同中书门下平章事，从此任相十九年。","link_td_id":"Q10008274","link_td_number_id":181807,"people_name":"李林甫","people_name_jianti_auto":"李林甫","people_xingming":"李林甫","start_index":19,"tongjian_id":"bd6b1b5c-db0e-11ef-b7fe-a0d3651f611f"},{"link_death_year":747,"link_td_description":"杨慎矜，唐朝政治人物，隋炀帝后代。曾依附杨国忠、李林甫，诬陷大臣，后因得罪李林甫，被唐玄宗赐死。","link_td_id":"Q10009499","link_td_number_id":722178,"people_name":"愼矜","people_name_jianti_auto":"愼矜","people_xingming":"杨慎矜","start_index":43,"tongjian_id":"bd6b1b5d-db0e-11ef-840e-a0d3651f611f"},{"link_death_year":747,"link_td_description":"杨慎矜，唐朝政治人物，隋炀帝后代。曾依附杨国忠、李林甫，诬陷大臣，后因得罪李林甫，被唐玄宗赐死。","link_td_id":"Q10009499","link_td_number_id":722178,"people_name":"愼矜","people_name_jianti_auto":"愼矜","people_xingming":"杨慎矜","start_index":61,"tongjian_id":"bd6b1b5e-db0e-11ef-aa77-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"6上以右贊善大夫楊愼矜知御史中丞事。時李林甫專權，公卿之進，有不出其門者，必以罪去之；愼矜由是固辭，不敢受。五月，辛丑，以愼矜爲諫議大夫。","content_fanyi":"唐玄宗任命右赞善大夫杨慎矜主持御史中丞事务。当时李林甫专擅朝政，公卿中获进用的人，如果不是出自他的门下，必定会被罗织罪名而遭到罢黜；杨慎矜因此坚决推辞，不敢接受这一官职。五月初三日辛丑，任命杨慎矜为谏议大夫。","content_jianti_auto":"6上以右赞善大夫杨愼矜知御史中丞事。时李林甫专权，公卿之进，有不出其门者，必以罪去之；愼矜由是固辞，不敢受。五月，辛丑，以愼矜为谏议大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21710,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"bd6b1b58-db0e-11ef-948f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"溫泉宮","place_name_jianti_auto":"温泉宫","start_index":49,"tongjian_id":"bd6b1b61-db0e-11ef-b750-a0d3651f611f"},{"place_name":"溫泉宮","place_name_jianti_auto":"温泉宫","start_index":75,"tongjian_id":"bd6b1b62-db0e-11ef-8dd8-a0d3651f611f"},{"place_name":"溫泉宮","place_name_jianti_auto":"温泉宫","start_index":114,"tongjian_id":"bd6b1b63-db0e-11ef-993b-a0d3651f611f"},{"place_name":"京","place_name_jianti_auto":"京","start_index":121,"tongjian_id":"bd6b1b64-db0e-11ef-a3cb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"戊寅至乙卯三十八日。史言帝耽樂而忘返。驪，力知翻。還，從宣翻，又音如字。考異曰：舊紀，「十月戊寅幸溫泉宮，十一月乙卯還宮，」與實錄同。「十二月戊申又幸溫泉宮，丙辰還宮」，實錄無。按十二月丙寅朔，無戊申、丙辰。唐曆：「十一月戊申幸溫泉宮，丙辰還京」，又與實錄本紀不同。今皆不取。","note_content_jianti_auto":"戊寅至乙卯三十八日。史言帝耽乐而忘返。骊，力知翻。还，从宣翻，又音如字。考异曰：旧纪，「十月戊寅幸温泉宫，十一月乙卯还宫，」与实录同。「十二月戊申又幸温泉宫，丙辰还宫」，实录无。按十二月丙寅朔，无戊申、丙辰。唐历：「十一月戊申幸温泉宫，丙辰还京」，又与实录本纪不同。今皆不取。","note_type":"hu_note","start_index":22,"tongjian_id":"bd6b1b60-db0e-11ef-97b2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"驪山","place_name_jianti_auto":"骊山","resolved_place_entity_id":616,"start_index":11,"tongjian_id":"bd6b1b6b-db0e-11ef-81ed-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7冬，十月，戊寅，上幸驪山溫泉；乙卯，還宮。","content_fanyi":"冬季，十月十三日戊寅，玄宗驾临骊山温泉；十一月二十日乙卯，返回宫中。","content_jianti_auto":"7冬，十月，戊寅，上幸骊山温泉；乙卯，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21711,"number":7,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"bd6b1b5f-db0e-11ef-ba08-a0d3651f611f"}],"reign_name":"二年","reign_name_jianti_auto":"二年","start_index":1,"tongjian_id":"bd68cf69-db0e-11ef-81a5-a0d3651f611f","year_anno":"（癸未、七四三）","year_int":743},"message":"success","success":true}