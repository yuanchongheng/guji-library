d":"bd6b1b11-db0e-11ef-a481-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"袹，莫白翻。袹首，今人謂之抹額。","note_content_jianti_auto":"袹，莫白翻。袹首，今人谓之抹额。","note_type":"hu_note","start_index":121,"tongjian_id":"bd6b1b14-db0e-11ef-92ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"成甫","people_name_jianti_auto":"成甫","start_index":27,"tongjian_id":"bd6b1b16-db0e-11ef-9d4a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"桃林","place_name_jianti_auto":"桃林","start_index":24,"tongjian_id":"bd6b1b17-db0e-11ef-98d0-a0d3651f611f"},{"place_name":"弘農","place_name_jianti_auto":"弘农","start_index":47,"tongjian_id":"bd6b1b18-db0e-11ef-9427-a0d3651f611f"},{"place_name":"弘農","place_name_jianti_auto":"弘农","start_index":51,"tongjian_id":"bd6b1b19-db0e-11ef-a5d1-a0d3651f611f"},{"place_name":"揚州","place_name_jianti_auto":"扬州","start_index":63,"tongjian_id":"bd6b1b1a-db0e-11ef-96f7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"先是，民間唱俚歌曰：「得體紇那邪。」其後得寶符於桃林，成甫乃更紇體歌爲得寶弘農野，歌曰：「得寶弘農野，弘農得寶耶？潭裏舟船鬧，揚州銅器多。三郞當殿坐，聽唱得寶歌。」其俚又甚焉。","note_content_jianti_auto":"先是，民间唱俚歌曰：「得体纥那邪。」其后得宝符于桃林，成甫乃更纥体歌为得宝弘农野，歌曰：「得宝弘农野，弘农得宝耶？潭里舟船闹，扬州铜器多。三郞当殿坐，听唱得宝歌。」其俚又甚焉。","note_type":"hu_note","start_index":129,"tongjian_id":"bd6b1b15-db0e-11ef-91de-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"程大昌","people_name_jianti_auto":"程大昌","start_index":0,"tongjian_id":"bd6b1b20-db0e-11ef-9838-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":8,"tongjian_id":"bd6b1b21-db0e-11ef-90c0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"程大昌演繁露曰：唐少府監，御饌器用九飣食，以牙盤九枚裝食味於上，置上前，亦謂之看食。仍上，時掌翻。","note_content_jianti_auto":"程大昌演繁露曰：唐少府监，御馔器用九饤食，以牙盘九枚装食味于上，置上前，亦谓之看食。仍上，时掌翻。","note_type":"hu_note","start_index":160,"tongjian_id":"bd6b1b1f-db0e-11ef-a050-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"财政","official_name":"租庸等使","official_note":"租庸等使是唐代负责征收租税和庸调的财政官员，此处韦坚担任此职，负责管理江、淮南地区的财政事务，并引水建潭以聚运船，体现了其财政职能。","official_rank":"未知","source_snippet":"江、淮南租庸等使韋堅引滻水抵苑東望春樓下爲潭","start_index":1,"tongjian_id":"e971ee73-7233-4e2e-82b4-d066980f09c1"},{"confidence":0.85,"official_category":"地方行政","official_name":"陝尉","official_note":"陝尉是唐代陕县（今河南陕县）的县尉，负责地方治安和司法事务，此处崔成甫担任此职，参与韦坚组织的庆典活动。","official_rank":"未知","source_snippet":"陝尉崔成甫著錦半臂，鈌胯綠衫以裼之","start_index":88,"tongjian_id":"5ad66e18-2243-4399-8b28-b2bcb37fa762"},{"confidence":0.95,"official_category":"中枢近臣","official_name":"左散騎常侍","official_note":"左散骑常侍是唐代门下省的官职，负责侍从皇帝、规谏过失，此处韦坚因建潭有功被加授此职，以示褒赏。","official_rank":"正三品","source_snippet":"加堅左散騎常侍","start_index":155,"tongjian_id":"69bfb271-25f5-424d-8c8f-f42215342f55"},{"confidence":0.9,"official_category":"地方行政","official_name":"京兆尹","official_note":"京兆尹是唐代首都长安的最高行政长官，负责京畿地区的政务，此处韩朝宗担任此职，效仿韦坚引水建潭以贮木材。","official_rank":"正三品","source_snippet":"時京兆尹韓朝宗亦引渭水置潭於西街","start_index":183,"tongjian_id":"fff07be1-78a4-4d5f-b9d0-d5a70159a0c9"}],"ExtRef_Children_people":[{"link_death_year":746,"link_td_description":"韦坚，字子金，京兆万年（今陕西省西安市）人，唐代官员。父韦元珪。","link_td_id":"Q10004453","link_td_number_id":951073,"people_name":"韋堅","people_name_jianti_auto":"韦坚","people_xingming":"韦坚","start_index":9,"tongjian_id":"bd6b1b25-db0e-11ef-b58a-a0d3651f611f"},{"link_death_year":746,"link_td_description":"韦坚，字子金，京兆万年（今陕西省西安市）人，唐代官员。父韦元珪。","link_td_id":"Q10004453","link_td_number_id":951073,"people_name":"堅","people_name_jianti_auto":"坚","people_xingming":"韦坚","start_index":76,"tongjian_id":"bd6b1b2a-db0e-11ef-9e44-a0d3651f611f"},{"people_name":"崔成甫