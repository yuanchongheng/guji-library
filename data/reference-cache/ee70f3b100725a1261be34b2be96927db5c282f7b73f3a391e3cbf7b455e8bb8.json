,"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"鎭西將軍","official_note":"鎭西將軍是魏朝的軍事官職，負責西部邊疆的防務和指揮，此處授予高車王伊匐以表彰其歸附，源自資治通鑑記載。","official_rank":"未知","source_snippet":"魏以伊匐爲鎭西將軍、西海郡公、高車王","start_index":24,"tongjian_id":"5bfd931e-327d-4ea7-83dc-f99b9ed4da25"},{"confidence":0.85,"official_category":"地方行政","official_name":"西海郡公","official_note":"西海郡公是魏朝的爵位，授予伊匐以表示封地和地位，此處作為封號使用，源自資治通鑑記載。","official_rank":"未知","source_snippet":"魏以伊匐爲鎭西將軍、西海郡公、高車王","start_index":29,"tongjian_id":"a29f04cf-83c9-485a-aba2-4dfb43ea34c5"},{"confidence":0.8,"official_category":"地方行政","official_name":"高車王","official_note":"高車王是伊匐的原有王號，此處魏朝予以確認或冊封，表示其統治高車部族的地位，源自資治通鑑記載。","official_rank":"未知","source_snippet":"魏以伊匐爲鎭西將軍、西海郡公、高車王","start_index":34,"tongjian_id":"4e726104-6bc3-4574-9d31-1fba3b049c99"}],"ExtRef_Children_people":[{"people_name":"高車王","people_name_jianti_auto":"高车王","people_xingming":"伊匐","start_index":1,"tongjian_id":"adab8335-db0e-11ef-8fa4-a0d3651f611f"},{"people_name":"伊匐","people_name_jianti_auto":"伊匐","people_xingming":"伊匐","start_index":4,"tongjian_id":"adab8336-db0e-11ef-95c8-a0d3651f611f"},{"people_name":"伊匐","people_name_jianti_auto":"伊匐","people_xingming":"伊匐","start_index":23,"tongjian_id":"adab8338-db0e-11ef-95b3-a0d3651f611f"},{"people_name":"高車王","people_name_jianti_auto":"高车王","people_xingming":"伊匐","start_index":36,"tongjian_id":"adab8339-db0e-11ef-9a36-a0d3651f611f"},{"people_name":"伊匐","people_name_jianti_auto":"伊匐","people_xingming":"伊匐","start_index":43,"tongjian_id":"adab833a-db0e-11ef-838f-a0d3651f611f"},{"people_name":"越居","people_name_jianti_auto":"越居","people_xingming":"越居","start_index":53,"tongjian_id":"adab833b-db0e-11ef-9ec9-a0d3651f611f"},{"people_name":"伊匐","people_name_jianti_auto":"伊匐","people_xingming":"伊匐","start_index":56,"tongjian_id":"adab833c-db0e-11ef-8995-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":11,"tongjian_id":"adab8337-db0e-11ef-bdda-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":21,"tongjian_id":"adab833d-db0e-11ef-98e7-a0d3651f611f"},{"place_name":"柔然","place_name_jianti_auto":"柔然","resolved_place_entity_id":262,"start_index":46,"tongjian_id":"adab833e-db0e-11ef-86d1-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"魏攻柔然之战","tongjian_id":"war_N0737"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十、突厥（卷四十五）","excerpts":[{"context_after":"西魏大统十七年，铁勒将伐柔然，突厥酋长土门邀击破之，尽降...","context_before":"...二年，嚈哒遣弥俄突弟伊匐帅余众还国，伊匐击柔然，大破之。","source_end_index":348,"source_paragraph_tongjian_id":"bda63a08-bcf0-5067-98b4-e0030af118e8","source_start_index":325,"source_text":"三年，伊匐复为柔然所败，其弟越居杀伊匐而自立。"}],"path":"山西方舆纪要/十、突厥（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["外交","人事","军事","权争"],"content":"4高車王伊匐遣使入貢于魏。夏，四月，庚辰，魏以伊匐爲鎭西將軍、西海郡公、高車王。久之，伊匐與柔然戰敗，其弟越居殺伊匐自立。","content_fanyi":"高车王伊匐派遣使臣向北魏进贡。夏季，四月十九日庚辰，北魏任命伊匐为镇西将军、西海郡公、高车王。过了很久，伊匐与柔然交战失败，他的弟弟越居杀死伊匐自立为王。","content_jianti_auto":"4高车王伊匐遣使入贡于魏。夏，四月，庚辰，魏以伊匐为镇西将军、西海郡公、高车王。久之，伊匐与柔然战败，其弟越居杀伊匐自立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14131,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"adab8333-db0e-11ef-9ef4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5五月，壬辰朔，日有食之，旣。","content_fanyi":"五月初一日壬辰朔，发生日全食，之后恢复原状。","content_jianti_auto":"5五月，壬辰朔，日有食之，既。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14132,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"adab833f-db0e-11ef-9b0c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6癸巳，大赦。","content_fanyi":"五月初二日癸巳，梁朝大赦天下。","content_jianti_auto":"6癸巳，大赦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14133,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"adab8340-db0e-11ef-ab41-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"領軍將軍","official_note":"領軍將軍是南北朝時期的重要軍事官職，負責統領禁軍，守衛京師，常由宗室或親信擔任。在《資治通鑑》此段中，始興忠武王蕭憺擔任此職，其卒於梁武帝天監三年（522年），反映了梁朝初期宗室成員在軍事體系中的角色。","official_rank":"正三品","source_snippet":"領軍將軍始興忠武王憺卒","start_index":7,"tongjian_id":"7371d3a4-b883-472e-96da-50551cf4008f"}],"ExtRef_Children_people":[{"link_birth_year":478,"link_death_year":522,"link_td_description":"萧憺，字僧达，是萧顺之的第十一子，梁武帝的异母弟。从武帝起兵就开始跟随他，梁朝建立后历任地方大员，尤以荆州附近为多，政绩颇佳。也多次被征召入朝，官至侍中、开府仪同三司等。封始兴郡王，谥忠武。","link_td_id":"Q10006733","link_td_number_id":1544132,"people_name":"始興忠武王","people_name_jianti_auto":"始兴忠武王","people_xingming":"萧憺","start_index":14,"tongjian_id":"adab8343-db0e-11ef-a2e2-a0d3651f611f","wl_zhushi":"[萧]"},{"link_birth_year":478,"link_death_year":522,"link_td_description":"萧憺，字僧达，是萧顺之的第十一子，梁武帝的异母弟。从武帝起兵就开始跟随他，梁朝建立后历任地方大员，尤以荆州附近为多，政绩颇佳。也多次被征召入朝，官至侍中、开府仪同三司等。封始兴郡王，谥忠武。","link_td_id":"Q10006733","link_td_number_id":1544132,"people_name":"憺","people_name_jianti_auto":"憺","people_xingming":"萧憺","start_index":19,"tongjian_id":"adab8344-db0e-11ef-9fe1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"7冬，十一月，甲午，領軍將軍始興忠武王憺卒。","content_fanyi":"冬季，十一月十六日甲午，梁朝领军将军始兴忠武王萧憺去世。","content_jianti_auto":"7冬，十一月，甲午，领军将军始兴忠武王憺卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14134,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"adab8341-db0e-11ef-85e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":4,"tongjian_id":"adab8346-db0e-11ef-a64c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8乙巳，魏主祀圜丘。","content_fanyi":"十一月十一日乙巳，北魏孝明帝在圜丘祭天。","content_jianti_auto":"8乙巳，魏主祀圜丘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14135,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"adab8345-db0e-11ef-9201-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"adab834a-db0e-11ef-b089-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"adab834b-db0e-11ef-9a70-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二