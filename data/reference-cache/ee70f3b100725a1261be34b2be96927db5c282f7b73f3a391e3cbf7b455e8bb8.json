ongjian_id":"adab8354-db0e-11ef-8043-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孝明帝","people_name_jianti_auto":"孝明帝","start_index":17,"tongjian_id":"adab8356-db0e-11ef-b1cb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：後魏·律曆志云：「曆成，會孝明帝加元服，改元正光，因命曰正光曆。」按帝紀，「正光元年七月辛卯加元服，三年十一月丙午行正光曆」，今從之。","note_content_jianti_auto":"考异曰：后魏·律历志云：「历成，会孝明帝加元服，改元正光，因命曰正光历。」按帝纪，「正光元年七月辛卯加元服，三年十一月丙午行正光历」，今从之。","note_type":"hu_note","start_index":83,"tongjian_id":"adab8355-db0e-11ef-aa43-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"著作郞","official_note":"著作郞是魏晉南北朝時期負責編修國史、著作的官職，屬於文教類。在《資治通鑑》此段中，崔光擔任著作郞，負責收集和審核曆法，體現了其在曆法改革中的職能。","official_rank":"未知","source_snippet":"著作郞崔光表取盪寇將軍張龍祥等九家所上曆","start_index":28,"tongjian_id":"a77f01ed-7a55-40c5-9c10-64ff219023eb"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"盪寇將軍","official_note":"盪寇將軍是魏晉南北朝時期的武官職稱，屬於軍事指揮類，通常負責平定叛亂或防禦任務。在《資治通鑑》此段中，張龍祥擔任盪寇將軍，參與曆法上呈，可能反映了當時官員跨職能參與文教事務的情況。","official_rank":"未知","source_snippet":"著作郞崔光表取盪寇將軍張龍祥等九家所上曆","start_index":33,"tongjian_id":"3d63ac5c-fbf9-4195-bc23-514ffbdfeb88"}],"ExtRef_Children_people":[{"link_birth_year":408,"link_death_year":452,"link_td_description":"魏太武帝拓跋焘，鲜卑名狸伐，北魏第三位皇帝（423年12月27日—452年3月11日在位），魏明元帝拓跋嗣的长子，魏道武帝拓跋珪的长孙，在位28年，谥号太武皇帝。","link_td_id":"Q10000507","link_td_number_id":103444,"people_name":"魏世祖","people_name_jianti_auto":"魏世祖","people_xingming":"拓跋焘","start_index":3,"tongjian_id":"adab835c-db0e-11ef-8f8a-a0d3651f611f","wl_zhushi":"[拓跋焘]"},{"link_birth_year":451,"link_death_year":523,"link_td_description":"崔光，本名孝伯，字长仁，魏孝文帝赐名光，改字孝伯，东清河郡鄃县（今山东省淄博市临淄区）人，祖籍清河郡东武城县（今河北省衡水市故城县），出自清河崔氏定著六房之一的南祖崔氏乌水房，北魏官员。","link_td_id":"Q10004571","link_td_number_id":5355464,"people_name":"崔光","people_name_jianti_auto":"崔光","people_xingming":"崔光","start_index":25,"tongjian_id":"adab835e-db0e-11ef-bb44-a0d3651f611f"},{"people_name":"張龍祥","people_name_jianti_auto":"张龙祥","people_xingming":"张龙祥","start_index":33,"tongjian_id":"adab835f-db0e-11ef-b902-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":60,"tongjian_id":"adab8360-db0e-11ef-aac0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"9初，魏世祖以玄始曆浸疏，命更造新曆。至是，著作郞崔光表取盪寇將軍張龍祥等九家所上曆，候驗得失，合爲一曆，以壬子爲元，應魏之水德，命曰正光曆。丙午，初行正光曆，大赦。","content_fanyi":"当初，魏太武帝认为《玄始历》逐渐不准确，便下令另编新历。到这时，著作郎崔光上表选取荡寇将军张龙祥等九家所呈上的历法，经过观测验证其得失，合并为一部历法，以壬子作为起算之元，用以应合北魏以水德而王的气运，定名为《正光历》。十一月十八日丙午，开始施行《正光历》，大赦天下。","content_jianti_auto":"9初，魏世祖以玄始历浸疏，命更造新历。至是，著作郞崔光表取荡寇将军张龙祥等九家所上历，候验得失，合为一历，以壬子为元，应魏之水德，命曰正光历。丙午，初行正光历，大赦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14136,"number":9,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":8,"tongjian_id":"adab8347-db0e-11ef-a553-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"車騎大將軍","official_note":"車騎大將軍是魏晉南北朝時期的高級軍事官職，通常授予宗室或重臣，掌管車騎部隊，地位崇高。在《資治通鑑》此段中，元欽被任命為儀同三司，顯示其官職變動。","official_rank":"正一品或從一品","source_snippet":"車騎大將軍","start_index":8,"tongjian_id":"2949863e-3181-4656-93d1-52379f8684d4"},{"confidence":0.95,"official_category":"中樞機構","official_name":"尚書右僕射","official_note":"尚書右僕射是尚書省的副長官，協助尚書令處理政務，在魏晉南北朝時期是重要的行政官職。此處元欽原任此職，後被改任儀同三司。","official_rank":"從二品或正三品","source_snippet":"尚書右僕射","start_index":14,"tongjian_id":"0c5cace3-243c-43fc-b629-ef186623e83b"},{"confidence":0.9,"official_category":"榮譽官銜","official_name":"儀同三司","official_note":"儀同三司是魏晉南北朝時期的榮譽官銜，授予官員與三公（太尉、司徒、司空）同等的儀制，表示尊崇但無實權。此處元欽被任命為此職，顯示其地位提升。","official_rank":"正一品或從一品","source_snippet":"儀同三司","start_index":22,"tongjian_id":"fd4f3c29-3633-4036-981e-f0985ad206e1"},{"confidence":0.95,"official_category":"中樞近臣","official_name":"太保","official_note":"太保是三公之一，是輔佐皇帝的高級官職，通常授予德高望重的重臣。在《資治通鑑》此段中，京兆王繼原任太保，後被改任太傅。","official_rank":"正一品","source_snippet":"太保","start_index":28,"tongjian_id":"a3de62ba-c7b5-45d7-9c16-97b065748143"},{"confidence":0.95,"official_category":"中樞近臣","official_name":"太傅","official_note":"太傅是三公之一，負責教導和輔佐皇帝，地位崇高。此處京兆王繼被任命為太傅，顯示其官職變動。","official_rank":"正一品","source_snippet":"太傅","start_index":35,"tongjian_id":"ee71baa7-f302-4051-84f1-b0de864784f0"},{"confidence":0.95,"official_category":"中樞近臣","official_name":"司徒","official_note":"司徒是三公之一，掌管土地和人民事務，是重要的行政官職。在《資治通鑑》此段中，崔光原任司徒，後被改任太保。","official_rank":"正一品","source_snippet":"司徒","start_index":40,"tongjian_id":"dd471fae-4521-4039-abab-bf2715b4b4d7"},{"confidence":0.95,"official_category":"中樞近臣","official_name":"太保","official_note":"太保是三公之一，是輔佐皇帝的高級官職。此處崔光被任命為太保，顯示其官職變動。","official_rank":"正一品","source_snippet":"太保","start_index":45,"tongjian_id":"a658f610-8944-4f08-ace5-a53066686b48"}],"ExtRef_Children_people":[{"link_birth_year":470,"link_death_year":528,"link_td_description":"元钦，字思若，河南郡洛阳县（今河南省洛阳市）人，追尊魏景穆帝拓跋晃之孙，阳平幽王拓跋新成之子，北魏宗室、官员。","link_td_id":"Q10003860","link_td_number_id":1540913,"people_name":"元欽","people_name_jianti_auto":"元钦","people_xingming":"元钦","start_index":22,"tongjian_id":"adab8365-db0e-11ef-ae6f-a0d3651f611f"},{"link_birth_year":464,"link_death_year":528,"link_td_description":"元继，魏道武帝拓跋珪后裔，南平安王拓跋霄的次子，北魏宗室、官员。","link_td_id":"Q10018266","link_td_number_id":5485612,"people_name":"京兆王","people_name_jianti_auto":"京兆王","people_xingming":"元继","start_index":32,"tongjian_id":"adab8367-db0e-11ef-a828-a0d3651f611f"},{"link_birth_year":464,"link_death_year":528,"link_td_description":"元继，魏道武帝拓跋珪后裔，南平安王拓跋霄的次子，北魏宗室、官员。","link_td_id":"Q10018266","link_td_number_id":5485612,"people_name":"繼","people_name_jianti_auto":"继","people_xingming":"元