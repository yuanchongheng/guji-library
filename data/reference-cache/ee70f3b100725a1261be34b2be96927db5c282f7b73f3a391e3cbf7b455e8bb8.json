ame":"巫臣","people_name_jianti_auto":"巫臣","start_index":3,"tongjian_id":"adadcd20-db0e-11ef-8da3-a0d3651f611f"},{"people_name":"子重","people_name_jianti_auto":"子重","start_index":6,"tongjian_id":"adadcd21-db0e-11ef-afb6-a0d3651f611f"},{"people_name":"子反","people_name_jianti_auto":"子反","start_index":9,"tongjian_id":"adadcd22-db0e-11ef-9a99-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳，巫臣遺子重、子反書曰：「吾必使汝疲於奔命以死。」奔命者，赴急之兵也。復，扶又翻。","note_content_jianti_auto":"左传，巫臣遗子重、子反书曰：「吾必使汝疲于奔命以死。」奔命者，赴急之兵也。复，扶又翻。","note_type":"hu_note","start_index":83,"tongjian_id":"adadcd1f-db0e-11ef-9d22-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"平西府長史","official_note":"平西府長史是平西将军府的属官，负责协助处理军务，此处费穆兼任此职，参与讨伐婆罗门叛乱。","official_rank":"未知","source_snippet":"平西府長史代人費穆","start_index":18,"tongjian_id":"94fe9cdb-a51f-4bf4-8670-4327139de6b5"},{"confidence":0.85,"official_category":"中枢机构","official_name":"尚書右丞","official_note":"尚書右丞是尚书省的官员，负责处理文书和行政事务，此处费穆兼任此职，显示其多职身份。","official_rank":"正四品","source_snippet":"兼尚書右丞西北道行臺","start_index":24,"tongjian_id":"6a73e241-f738-4a87-9b82-9fc4bc240496"},{"confidence":0.8,"official_category":"地方行政","official_name":"西北道行臺","official_note":"西北道行臺是北魏时期在西北地区设立的临时军事行政机构，负责指挥作战和治理，此处费穆担任此职以讨伐叛乱。","official_rank":"未知","source_snippet":"兼尚書右丞西北道行臺","start_index":28,"tongjian_id":"595edb83-6f47-4555-8afd-1c7e7f550810"}],"ExtRef_Children_people":[{"people_name":"婆羅門","people_name_jianti_auto":"婆罗门","people_xingming":"婆罗门","start_index":0,"tongjian_id":"adadcd25-db0e-11ef-aca6-a0d3651f611f"},{"people_name":"費穆","people_name_jianti_auto":"费穆","people_xingming":"费穆","start_index":23,"tongjian_id":"adadcd26-db0e-11ef-b568-a0d3651f611f"},{"people_name":"穆","people_name_jianti_auto":"穆","people_xingming":"费穆","start_index":46,"tongjian_id":"adadcd2a-db0e-11ef-81cf-a0d3651f611f"},{"people_name":"婆羅門","people_name_jianti_auto":"婆罗门","start_index":116,"tongjian_id":"adadcd2c-db0e-11ef-ae35-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":7,"tongjian_id":"adadcd27-db0e-11ef-bea7-a0d3651f611f"},{"place_name":"嚈噠","place_name_jianti_auto":"嚈哒","place_note":"首都拔底延城【阿富汗北部瓦齐拉巴德市】","resolved_place_entity_id":2575,"start_index":11,"tongjian_id":"adadcd28-db0e-11ef-b1d4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":6,"start_index":14,"tongjian_id":"adadcd29-db0e-11ef-bbd7-a0d3651f611f"},{"place_name":"柔然","place_name_jianti_auto":"柔然","resolved_place_entity_id":262,"start_index":41,"tongjian_id":"adadcd2b-db0e-11ef-b088-a0d3651f611f"},{"place_name":"柔然","place_name_jianti_auto":"柔然","resolved_place_entity_id":262,"start_index":104,"tongjian_id":"adadcd2d-db0e-11ef-8a46-a0d3651f611f"},{"place_name":"涼州","place_name_jianti_auto":"凉州","resolved_place_entity_id":156,"start_index":120,"tongjian_id":"adadcd2e-db0e-11ef-937e-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","resolved_place_entity_id":54,"start_index":127,"tongjian_id":"adadcd2f-db0e-11ef-8bc5-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"魏攻柔然之战","tongjian_id":"war_N0737"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十、突厥（卷四十五）","excerpts":[{"context_after":"阿那瑰专统其众，既而魏乱，柔然遂雄据北方为边患。齐天保三...","context_before":"...伐为可汗，魏人议分处阿那瑰、婆罗门于东西二境，各统其众。","source_end_index":624,"source_paragraph_tongjian_id":"676ebf45-84a9-53d3-906e-34861111f5bf","source_start_index":607,"source_text":"三年，婆罗门叛魏归嚈哒，魏击擒之。"}],"path":"山西方舆纪要/十、突厥（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"婆羅門帥部落叛魏，亡歸嚈噠。魏以平西府長史代人費穆兼尚書右丞西北道行臺，將兵討之，柔然遁去。穆謂諸將曰：「戎狄之性，見敵卽走，乘虛復出，若不使之破膽，終恐疲於奔命。」乃簡練精騎，伏於山谷，以步兵之羸者爲外營，柔然果至，奮擊，大破之。婆羅門爲涼州軍所擒，送洛陽。","content_fanyi":"婆罗门率领部落反叛北魏，逃奔嚈哒。北魏任命平西府长史、代都人费穆兼任尚书右丞、西北道行台，率兵讨伐他，柔然人逃走了。费穆对众将领说：“戎狄的本性，见到敌人就跑，乘虚又再来，如果不把他们吓破胆，恐怕终究会使我们疲于奔命。”于是挑选精锐骑兵埋伏在山谷中，让步兵中瘦弱的人在外扎营，柔然人果然来到，费穆率军奋力进击，大败柔然。婆罗门被凉州军抓获，送往洛阳。","content_jianti_auto":"婆罗门帅部落叛魏，亡归嚈哒。魏以平西府长史代人费穆兼尚书右丞西北道行台，将兵讨之，柔然遁去。穆谓诸将曰：「戎狄之性，见敌即走，乘虚复出，若不使之破胆，终恐疲于奔命。」乃简练精骑，伏于山谷，以步兵之羸者为外营，柔然果至，奋击，大破之。婆罗门为凉州军所擒，送洛阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14140,"reading_annotation_sources":[],"start_index":12,"tongjian_id":"adadcd19-db0e-11ef-8703-a0d3651f611f"}],"reign_name":"三年","reign_name_jianti_auto":"三年","start_index":3,"tongjian_id":"adab8315-db0e-11ef-8c0f-a0d3651f611f","year_anno":"（壬寅、五二二）","year_int":522},"message":"success","success":true}