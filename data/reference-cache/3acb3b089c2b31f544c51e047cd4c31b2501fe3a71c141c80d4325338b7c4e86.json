{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（戊辰、前二三三）","note_content_jianti_auto":"（戊辰、前二三三）","note_type":"hu_note","start_index":0,"tongjian_id":"8d4b751e-db0e-11ef-b6fc-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":4,"tongjian_id":"8d4b7521-db0e-11ef-aaea-a0d3651f611f"},{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":6,"tongjian_id":"8d4b7522-db0e-11ef-8630-a0d3651f611f"},{"place_name":"武城","place_name_jianti_auto":"武城","start_index":9,"tongjian_id":"8d4b7523-db0e-11ef-8ee5-a0d3651f611f"},{"place_name":"貝州","place_name_jianti_auto":"贝州","start_index":19,"tongjian_id":"8d4b7524-db0e-11ef-b266-a0d3651f611f"},{"place_name":"武城縣","place_name_jianti_auto":"武城县","start_index":21,"tongjian_id":"8d4b7525-db0e-11ef-84e1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢志，魏郡鄴縣有武城。史記正義曰：卽貝州武城縣外城是。齮，丘奇翻，又去倚翻。","note_content_jianti_auto":"后汉志，魏郡邺县有武城。史记正义曰：即贝州武城县外城是。𬺈，丘奇翻，又去倚翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8d4b7520-db0e-11ef-88eb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-279,"link_death_year":-229,"link_td_description":"战国末年秦国将军。","link_td_id":"Q10007896","link_td_number_id":316660,"people_name":"桓齮","people_name_jianti_auto":"桓𬺈","people_xingming":"桓齮","start_index":1,"tongjian_id":"8d4b7528-db0e-11ef-abd7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":4,"tongjian_id":"8d4b7529-db0e-11ef-af11-a0d3651f611f"},{"place_name":"宜安","place_name_jianti_auto":"宜安","place_note":"河北藁城西南","resolved_place_entity_id":4494,"start_index":7,"tongjian_id":"8d4b752a-db0e-11ef-bbad-a0d3651f611f"},{"place_name":"平陽","place_name_jianti_auto":"平阳","place_note":"河北临漳西南","resolved_place_entity_id":501,"start_index":10,"tongjian_id":"8d4b752b-db0e-11ef-818c-a0d3651f611f"},{"place_name":"武城","place_name_jianti_auto":"武城","place_note":"河北磁县西南","resolved_place_entity_id":2035,"start_index":13,"tongjian_id":"8d4b752c-db0e-11ef-bc94-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦赵平阳之战","tongjian_id":"war_N0542"},{"title":"肥之战","tongjian_id":"war_N0543"},{"title":"秦灭赵之战","tongjian_id":"war_N0546"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"汉置东武城县，文帝封齐悼惠王子贤为侯国。十四年，改封贤为...","context_before":"...文王封孟尝君以武城。又孝成王封其弟胜于武城，号为平原君。","source_end_index":63,"source_paragraph_tongjian_id":"2c68bea4-4ebd-5b40-b5c7-f58d8578a80c","source_start_index":47,"source_text":"秦始皇十四年，桓齮伐赵，取武城。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1桓齮伐趙，取宜安、平陽、武城。","content_fanyi":"桓齮率军攻打赵国，夺取宜安、平阳、武城。","content_jianti_auto":"1桓𬺈伐赵，取宜安、平阳、武城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":508,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d4b751f-db0e-11ef-86d9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古者列國之於天子，比年一小聘，三年一大聘。璽，斯氏翻。","note_content_jianti_auto":"古者列国之于天子，比年一小聘，三年一大聘。玺，斯氏翻。","note_type":"hu_note","start_index":19,"tongjian_id":"8d4b752e-db0e-11ef-8fa7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d4b7530-db0e-11ef-8a95-a0d3651f611f"},{"people_name":"鼂錯","people_name_jianti_auto":"鼌错","start_index":24,"tongjian_id":"8d4b7531-db0e-11ef-8633-a0d3651f611f"},{"people_name":"申","people_name_jianti_auto":"申","start_index":27,"tongjian_id":"8d4b7532-db0e-11ef-84cf-a0d3651f611f"},{"people_name":"商","people_name_jianti_auto":"商","start_index":29,"tongjian_id":"8d4b7533-db0e-11ef-a625-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":45,"tongjian_id":"8d4b7534-db0e-11ef-a3a0-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":58,"tongjian_id":"8d4b7535-db0e-11ef-8597-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":74,"tongjian_id":"8d4b7536-db0e-11ef-9030-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":78,"tongjian_id":"8d4b7537-db0e-11ef-a2c8-a0d3651f611f"},{"people_name":"公孫弘","people_name_jianti_auto":"公孙弘","start_index":83,"tongjian_id":"8d4b7538-db0e-11ef-a36b-a0d3651f611f"},{"people_name":"錯","people_name_jianti_auto":"错","start_index":129,"tongjian_id":"8d4b7539-db0e-11ef-bb4a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：法家者流，蓋出於理官，信賞必罰，以輔禮制。鼂錯爲申、商刑名之學，言人主不可不知術數。張晏曰：術數，刑名之書也。臣瓚曰：術數，謂法制治國之術也。師古曰：瓚說是也。公孫弘曰：「擅殺生之力，通雍塞之塗，權輕重之數，論得失之道，使遠近情僞畢見於上，謂之術，」與錯所言同。灋，古法字。鼂，古朝字。錯，千故翻。瓚，藏旱翻。塞，悉則翻。見，賢遍翻。","note_content_jianti_auto":"班志：法家者流，盖出于理官，信赏必罚，以辅礼制。鼌错为申、商刑名之学，言人主不可不知术数。张晏曰：术数，刑名之书也。臣瓒曰：术数，谓法制治国之术也。师古曰：瓒说是也。公孙弘曰：「擅杀生之力，通雍塞之涂，权轻重之数，论得失之道，使远近情伪毕见于上，谓之术，」与错所言同。灋，古法字。鼌，古朝字。错，千故翻。瓒，藏旱翻。塞，悉则翻。见，贤遍翻。","note_type":"hu_note","start_index":38,"tongjian_id":"8d4b752f-db0e-11ef-b72f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"溫公","people_name_jianti_auto":"温公","start_index":143,"tongjian_id":"8d4b753e-db0e-11ef-b3ab-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自孤憤至說難，皆韓非子篇名。索隱曰：孤憤者，憤孤直不容於時也。五蠹者，蠹政之事有五也。內、外儲者，韓非子有內、外儲說篇：內儲者，言明君執術以制臣下，制之在己，故曰內也；外儲者，明君觀聽臣下之言行以斷其賞罰，賞罰在彼，故曰外也。說林廣說諸事，其多若林，故曰說林也。余謂說難者，言游說之難。溫公揚子註：說，音稅。難，如字。","note_content_jianti_auto":"自孤愤至说难，皆韩非子篇名。索隐曰：孤愤者，愤孤直不容于时也。五蠹者，蠹政之事有五也。内、外储者，韩非子有内、外储说篇：内储者，言明君执术以制臣下，制之在己，故曰内也；外储者，明君观听臣下之言行以断其赏罚，赏罚在彼，故曰外也。说林广说诸事，其多若林，故曰说林也。余谓说难者，言游说之难。温公扬子注：说，音税。难，如字。","note_type":"hu_note","start_index":158,"tongjian_id":"8d4b753d-db0e-11ef-b913-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-226,"link_td_description":"韩王安，姬姓，韩氏，名安，韩国末代国王，在位9年。","link_td_id":"Q10000650","link_td_number_id":334575,"people_name":"韓王","people_name_jianti_auto":"韩王","people_xingming":"韩安","start_index":1,"tongjian_id":"8d4b7550-db0e-11ef-96c1-a0d3651f611f","wl_zhushi":"[韩安]"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"韓非","people_name_jianti_auto":"韩非","people_xingming":"韩非","start_index":14,"tongjian_id":"8d4b7551-db0e-11ef-8f07-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"韓非","people_name_jianti_auto":"韩非","start_index":19,"tongjian_id":"8d4b7552-db0e-11ef-b83b-a0d3651f611f"},{"link_death_year":-226,"link_td_description":"韩王安，姬姓，韩氏，名安，韩国末代国王，在位9年。","link_td_id":"Q10000650","link_td_number_id":334575,"people_name":"韓王","people_name_jianti_auto":"韩王","people_xingming":"韩安","start_index":48,"tongjian_id":"8d4b7554-db0e-11ef-b682-a0d3651f611f","wl_zhushi":"[韩安]"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"韓非","people_name_jianti_auto":"韩非","people_xingming":"韩非","start_index":58,"tongjian_id":"8d4b7556-db0e-11ef-91f0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"都新郑，河南新郑","resolved_place_entity_id":301,"start_index":23,"tongjian_id":"8d4b7553-db0e-11ef-803f-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":39,"tongjian_id":"8d4b7555-db0e-11ef-bbdc-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭韩之战","tongjian_id":"war_N0545"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/谏说之难","excerpts":[{"context_after":"，盖谏说之难，自古以然。至于知其所欲说，迎而拒之，然卒至...","context_before":"","source_end_index":13,"source_paragraph_tongjian_id":"057264f6-1756-4c35-a9c4-cd1ae70f3f9d","source_start_index":0,"source_text":"韩非作《说难》，而死于说难"}],"path":"随笔/卷十三/谏说之难","source_name":"容斋随笔"}],"class_tags":["外交","人事"],"content":"2韓王納地効璽，請爲藩臣，使韓非來聘。韓非者，韓之諸公子也，善刑名灋術之學，見韓之削弱，數以書干韓王，王不能用。於是韓非疾治國不務求人任賢，反舉浮淫之蠹而加之功實之上，寬則寵名譽之人，急則用介冑之士，所養非所用，所用非所養。悲廉直不容於邪枉之臣，觀往者得失之變，作孤憤、五蠹、內、外儲、說林、說難五十六篇，十餘萬言。","content_fanyi":"韩王献出土地和印玺，请求成为秦国的藩臣，派韩非前来聘问。韩非是韩国宗室的公子之一，擅长刑名法术之学，看到韩国日渐削弱，多次上书向韩王进言，韩王却不能任用他。于是韩非痛恨治国不致力于访求人才、任用贤能，反而举用浮淫的蛀虫，让他们的官位凌驾于有实际功劳的人之上，宽松时就宠信有名声的人，危急时就使用披甲戴盔的武士，培养的人不是能任用的人，能任用的人不是培养的人。他悲叹廉洁正直的人为邪曲的臣子所不容，考察以往得失的变化，撰写了《孤愤》《五蠹》《内储》《外储》《说林》《说难》五十六篇，共十余万字。","content_jianti_auto":"2韩王纳地効玺，请为藩臣，使韩非来聘。韩非者，韩之诸公子也，善刑名灋术之学，见韩之削弱，数以书干韩王，王不能用。于是韩非疾治国不务求人任贤，反举浮淫之蠹而加之功实之上，宽则宠名誉之人，急则用介胄之士，所养非所用，所用非所养。悲廉直不容于邪枉之臣，观往者得失之变，作孤愤、五蠹、内、外储、说林、说难五十六篇，十余万言。","dtjl_paragraph_links":[],"dtjl_references":[],"id":509,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8d4b752d-db0e-11ef-9891-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"非","people_name_jianti_auto":"非","people_xingming":"韩非","start_index":9,"tongjian_id":"8d4dad1d-db0e-11ef-b765-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-208,"link_td_description":"李斯，楚国上蔡人，秦朝政治家、文学家和书法家，法家学说代表人物。曾任秦朝左丞相。","link_td_id":"Q10008012","link_td_number_id":13760,"people_name":"李斯","people_name_jianti_auto":"李斯","people_xingming":"李斯","start_index":144,"tongjian_id":"8d4dad27-db0e-11ef-bd12-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"韓非","people_name_jianti_auto":"韩非","people_xingming":"韩非","start_index":152,"tongjian_id":"8d4dad28-db0e-11ef-9114-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"非","people_name_jianti_auto":"非","people_xingming":"韩非","start_index":168,"tongjian_id":"8d4dad29-db0e-11ef-b55d-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"非","people_name_jianti_au