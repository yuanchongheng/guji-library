_entity_id":130,"start_index":91,"tongjian_id":"8d4dad23-db0e-11ef-b4ee-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":93,"tongjian_id":"8d4dad24-db0e-11ef-aba3-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":97,"tongjian_id":"8d4dad25-db0e-11ef-8985-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":99,"tongjian_id":"8d4dad26-db0e-11ef-acf8-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"都新郑，河南新郑","resolved_place_entity_id":301,"start_index":155,"tongjian_id":"8d4dad2a-db0e-11ef-b95a-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":171,"tongjian_id":"8d4dad2b-db0e-11ef-82e2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":174,"tongjian_id":"8d4dad2c-db0e-11ef-8eba-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭韩之战","tongjian_id":"war_N0545"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/谏说之难","excerpts":[{"context_after":"，盖谏说之难，自古以然。至于知其所欲说，迎而拒之，然卒至...","context_before":"","source_end_index":13,"source_paragraph_tongjian_id":"057264f6-1756-4c35-a9c4-cd1ae70f3f9d","source_start_index":0,"source_text":"韩非作《说难》，而死于说难"}],"path":"随笔/卷十三/谏说之难","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"汉初，郦食其曰：齐负海岱，阻河济，南近楚，虽数十万师，未...","context_before":"...也]，夜加即墨，顾据午道，则长城之东收，而泰山之北举矣。","source_end_index":296,"source_paragraph_tongjian_id":"d003969e-77ca-5ce3-ac86-88a7fcf5331a","source_start_index":223,"source_text":"韩非说秦曰：往者齐南破荆，中破宋，西服秦，北破燕，中使韩魏，地广而兵强，战克攻取，诏令天下，济清河浊，足以为限，长城巨防，足以为塞，齐五战之国也。"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"}],"class_tags":["人事","权争"],"content":"王聞其賢，欲見之。非爲韓使於秦，因上書說王曰：「今秦地方數千里，師名百萬，號令賞罰，天下不如。臣昧死願望見大王，言所以破天下從之計。大王誠聽臣說，一舉而天下之從不破，趙不舉，韓不亡，荊、魏不臣，齊、燕不親，霸王之名不成，四鄰諸侯不朝，大王斬臣以徇國，以戒爲王謀不忠者也。」王悅之，未任用。李斯嫉之，曰：「韓非，韓之諸公子也。今欲幷諸侯，非終爲韓不爲秦，此人情也。今王不用，久留而歸之，此自遺患也；不如以法誅之。」王以爲然，下吏治非。李斯使人遺非藥，令早自殺。韓非欲自陳，不得見。王後悔，使人赦之，非已死矣。","content_fanyi":"秦王听说韩非有贤才，想要见他。韩非正作为韩国使者出使秦国，便趁机上书劝秦王说：“如今秦国土地方圆几千里，军队号称百万，号令与赏罚，天下各国都比不上。我冒着死罪希望拜见大王，说明击破天下合纵的计策。大王如果真能听从臣的劝说，一次用兵之后，天下的合纵不能击破，赵国不能攻克，韩国不能灭亡，楚国、魏国不肯臣服，齐国、燕国不肯亲附，霸王的名声不能成就，四方邻国的诸侯不来朝见，就请大王把臣斩首示众，用来警戒那些替君主谋划却不忠诚的人。”秦王听了很高兴，但没有任用他。李斯嫉妒韩非，说：“韩非是韩国的公子。现在大王想要吞并诸侯，韩非终究会为韩国而不是为秦国打算，这是人之常情。如今大王不任用他，长久留在秦国又放他回去，这是自己留下后患；不如依据法律杀掉他。”秦王认为有道理，就把韩非交给司法官员治罪。李斯派人送毒药给韩非，叫他早些自杀。韩非想当面向秦王陈述，却无法见到秦王。后来秦王后悔了，派人去赦免韩非，但韩非已经死了。","content_jianti_auto":"王闻其贤，欲见之。非为韩使于秦，因上书说王曰：「今秦地方数千里，师名百万，号令赏罚，天下不如。臣昧死愿望见大王，言所以破天下从之计。大王诚听臣说，一举而天下之从不破，赵不举，韩不亡，荆、魏不臣，齐、燕不亲，霸王之名不成，四邻诸侯不朝，大王斩臣以徇国，以戒为王谋不忠者也。」王悦之，未任用。李斯嫉之，曰：「韩非，韩之诸公子也。今欲幷诸侯，非终为韩不为秦，此人情也。今王不用，久留而归之，此自遗患也；不如以法诛之。」王以为然，下吏治非。李斯使人遗非药，令早自杀。韩非欲自陈，不得见。王后悔，使人赦之，非已死矣。","dtjl_paragraph_links":[],"dtjl_references":[],"id":510,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8d4dad17-db0e-11ef-b29c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"知說之難而卒死於說，是何其所行與所言反也？說，式芮翻。難，如字。卒，子恤翻。","note_content_jianti_auto":"知说之难而卒死于说，是何其所行与所言反也？说，式芮翻。难，如字。卒，子恤翻。","note_type":"hu_note","start_index":31,"tongjian_id":"8d4dad32-db0e-11ef-a9c1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"確，堅也，言自信之堅也。","note_content_jianti_auto":"确，坚也，言自信之坚也。","note_type":"hu_note","start_index":81,"tongjian_id":"8d4dad33-db0e-11ef-9cbb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓非子","people_name_jianti_auto":"韩非子","start_index":9,"tongjian_id":"8d4dad35-db0e-11ef-bfb0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。此非，指韓非子之名。","note_content_jianti_auto":"夫，音扶。此非，指韩非子之名。","note_type":"hu_note","start_index":110,"tongjian_id":"8d4dad34-db0e-11ef-820e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此非，是非之非。邪，音耶。","note_content_jianti_auto":"此非，是非之非。邪，音耶。","note_type":"hu_note","start_index":114,"tongjian_id":"8d4dad36-db0e-11ef-a3f9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-53,"link_death_year":18,"link_td_description":"扬雄，字子云，姓名又作杨雄，蜀郡成都（今四川成都郫都区）人，西汉哲学家、文学家、语言学家。","link_td_id":"Q10000105","link_td_number_id":68672,"people_name":"揚子","people_name_jianti_auto":"扬子","people_xingming":"扬雄","start_index":0,"tongjian_id":"8d4dad37-db0e-11ef-90df-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"韓非","people_name_jianti_auto":"韩非","people_xingming":"韩非","start_index":10,"tongjian_id":"8d4dad38-db0e-11ef-9e9c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"揚子法言曰：或問：「韓非作說難之書而卒死乎說難，敢問何反也？」曰：「說難蓋其所以死乎！」曰：「何也？」曰：「君子以禮動，以義止，合則進，否則退，確乎不憂其不合也。夫說人而憂其不合，則亦無所不至矣。」或曰：「非憂說之不合，非邪？」曰：「說不由道，憂也。由道而不合，非憂也。」","content_fanyi":"扬雄《法言》说：有人问：“韩非写作《说难》一书，最终却死于说难，请问为什么言行相反呢？”答：“《说难》大概正是他致死的原因吧！”问：“为什么？”答：“君子按照礼来行动，按照义来停止，合乎礼义就进身，不合就退隐，内心坚定，不担心自己与人不合。游说别人却担心不能投合，那就没有什么手段做不出来了。”有人说：“韩非是担心游说不能投合，难道不对吗？”答：“游说不遵循道，才是值得忧虑的。遵循道却不能投合，并不值得忧虑。”","content_jianti_auto":"扬子法言曰：或问：「韩非作说难之书而卒死乎说难，敢问何反也？」曰：「说难盖其所以死乎！」曰：「何也？」曰：「君子以礼动，以义止，合则进，否则退，确乎不忧其不合也。夫说人而忧其不合，则亦无所不至矣。」或曰：「非忧说之不合，非邪？」曰：「说不由道，忧也。由道而不合，非忧也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":511,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8d4dad31-db0e-11ef-a5ec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":12,"chapter_name":"臣节篇第十二","chenzhu_chapter":"臣节者人臣事君之大节。《公羊·庄四年传》言：“国、君一体也。”故其时忠于君即忠于国。所谓忠于国者，国存与存，国亡与亡。国亡而不亡，必其无封疆之寄焉可也；国亡不亡，而犹欲保全其禄位，必顽钝无耻，贪利卖国之徒也。故《胡注》之论臣节，以能致其身为第一义，抗节不仕者次之，保禄位而背宗国者，在所必摈也，况助敌国以噬宗国者乎！","chenzhu_index_in_chapter":1,"chenzhu_text":"由余、韩非，均为本国使秦，而导秦以伐其宗国，二者皆贼臣也。由余前韩非四百年，其事为《通鉴》所不及载，注特详之，其有感于刘整、吕文焕诸人之事乎！刘整、吕文焕皆宋季疆臣，不得于宋，而降元以伐宋者也。昔乐毅不得于燕而走赵，赵王欲与之图燕，乐毅垂泣对曰：“臣事昭王，犹事大王。臣若获戾，放在他国，没世不忍谋赵之徒隶，况燕后嗣乎！”语见《魏志·武帝纪》汉建安十五年《注》。《通鉴》不载，朱子《纲目》周赧王三十六年条特采之。与乐毅，即不与由余也。韩非则温公已论之矣。万季野《书宋史吕文德传後》曰：“文德为宋名将，有功于封疆甚大。然许元人开榷场，驯致襄阳不可守，其悮国之罪亦不小。文德之后，其弟文焕、文福，子师夔、师孟，皆以文德故，授显官，委封疆重寄。乃相继叛降，反引敌入寇，导以取江南之策。此万世罪人，其罪视畏死失节者更加数等。昔廉颇负谤出奔，赵患用于他国为己害，使人视颇，对使者曰：‘颇得罪在他国，终身不敢谋赵之奴隶，况子孙乎！’世之为将，苟困守孤城，粮尽援绝，不得已而降，犹当守廉颇之义，终身不敢谋故国，君子或恕之；若既已负国，又引寇以覆其国，此与率寇雠而戕父母者何异？君子可轻其罪，不以昭示后世乎？”语见《群书疑辨》十一。《宋史》无吕文德传，当作《宋史新编》，廉颇当作乐毅，季野偶误记耳。","created_at":"2025-12-31 08:50:44","seq_in_chapter":6,"tongjian_id":"CH12-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","start_index":3,"tongjian_id":"8d4dad3e-db0e-11ef-93bb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂欲亡韓。","note_content_jianti_auto":"谓欲亡韩。","note_type":"hu_note","start_index":53,"tongjian_id":"8d4dad3d-db0e-11ef-b873-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言死猶有餘罪也。","note_content_jianti_auto":"言死犹有余罪也。","note_type":"hu_note","start_index":66,"tongjian_id":"8d4dad3f-db0e-11ef-af7b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8d4dad40-db0e-11ef-a72d-a0d3651f611f"},{"link_birth_year":-280,"link_death_year":-233,"link_td_description":"韩非，为中国战国末期韩国的宗室公子，又称公子非。思想家，为中国古代法家思想的代表人物，认为应该要「法」、「术」、「势」三者并重，是法家的集大成者。其著作收在《韩非子》。","link_td_id":"Q10000102","link_td_number_id":1109577,"people_name":"非","people_name_jianti_auto":"非","people_xingming":"韩非","start_index":40,"tongjian_id":"8d4dad41-db0e-11ef-ac7b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":42,"tongjian_id":"8d4dad42-db0e-11ef-84f1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：臣聞君子親其親以及人之親，愛其國以及人之國，是以功大名美而享有百福也。今非爲秦畫謀，而首欲覆其宗國以售其言，罪固不容於死矣，烏足愍哉！","content_fanyi":"臣司马光说：我听说君子由亲近自己的亲人推及到亲近别人的亲人，由爱护自己的国家推及到爱护别人的国家，因此功业伟大、名声美好，从而享有百福。如今韩非替秦国出谋划策，却首先想灭亡自己的祖国来证明他的主张，这种罪过本来就死有余辜，哪里还值得怜悯呢！","content_jianti_auto":"臣光曰：臣闻君子亲其亲以及人之亲，爱其国以及人之国，是以功大名美而享有百福也。今非为秦画谋，而首欲覆其宗国以售其言，罪固不容于死矣，乌足愍哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":512,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8d4dad3c-db0e-11ef-a834-a0d3651f611f"}],"reign_name":"十四年","reign_name_jianti_auto":"十四年","start_index":13,"tongjian_id":"8d4b751d-db0e-11ef-adbc-a0d3651f611f","year_anno":"（戊辰、前二三三）","year_int":-233},"message":"success","success":true}