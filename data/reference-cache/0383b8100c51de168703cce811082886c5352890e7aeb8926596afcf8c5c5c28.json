ef-9d2d-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":78,"tongjian_id":"8bfb1550-db0e-11ef-858b-a0d3651f611f"},{"place_name":"原邑","place_name_jianti_auto":"原邑","start_index":80,"tongjian_id":"8bfb1551-db0e-11ef-9c02-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":90,"tongjian_id":"8bfb1552-db0e-11ef-ae5d-a0d3651f611f"},{"place_name":"軹縣","place_name_jianti_auto":"轵县","start_index":92,"tongjian_id":"8bfb1553-db0e-11ef-b59f-a0d3651f611f"},{"place_name":"河內郡","place_name_jianti_auto":"河内郡","start_index":96,"tongjian_id":"8bfb1554-db0e-11ef-8e15-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":107,"tongjian_id":"8bfb1555-db0e-11ef-a2d8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相，息亮翻。俠，戶頰翻。累，力追翻。濮陽，春秋之帝丘，漢爲濮陽縣，屬東郡。應劭曰：濮水南入鉅野。水北爲陽。濮，博木翻。惡，如字，不善也；康：烏故切，非。軹，春秋原邑，晉文公所圍者；漢爲軹縣，屬河內郡；音只。姓譜曰：楚大夫食采於聶，因以爲氏。聶，尼輒翻。溢，夷質翻。二十四兩爲溢。","note_content_jianti_auto":"相，息亮翻。侠，户颊翻。累，力追翻。濮阳，春秋之帝丘，汉为濮阳县，属东郡。应劭曰：濮水南入巨野。水北为阳。濮，博木翻。恶，如字，不善也；康：乌故切，非。轵，春秋原邑，晋文公所围者；汉为轵县，属河内郡；音只。姓谱曰：楚大夫食采于聂，因以为氏。聂，尼辄翻。溢，夷质翻。二十四两为溢。","note_type":"hu_note","start_index":48,"tongjian_id":"8bfb1543-db0e-11ef-8d01-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8bfb155b-db0e-11ef-ac0a-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：乙十一行本作「抉」。』","note_content_jianti_auto":"『章：乙十一行本作「抉」。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8bfb155a-db0e-11ef-b288-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":111,"tongjian_id":"8bfb1559-db0e-11ef-b833-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"深井里","place_name_jianti_auto":"深井里","place_note":"河南济源东南十五公里","start_index":6,"tongjian_id":"8bfb155e-db0e-11ef-9847-a0d3651f611f"},{"place_name":"懷州","place_name_jianti_auto":"怀州","start_index":10,"tongjian_id":"8bfb155f-db0e-11ef-8839-a0d3651f611f"},{"place_name":"濟源縣","place_name_jianti_auto":"济源县","start_index":12,"tongjian_id":"8bfb1560-db0e-11ef-985c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：深井里在懷州濟源縣南三十里。","note_content_jianti_auto":"史记正义曰：深井里在怀州济源县南三十里。","note_type":"hu_note","start_index":154,"tongjian_id":"8bfb155d-db0e-11ef-a14b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"皮面，以刀剺面而去其皮。懸賞以募告者曰購。購，古候翻。嫈，烏莖翻。絕從之從，讀曰蹤，謂自絕其蹤跡。或曰：從，讀如字，謂絕其從坐之罪也。","note_content_jianti_auto":"皮面，以刀剺面而去其皮。悬赏以募告者曰购。购，古候翻。嫈，乌茎翻。绝从之从，读曰踪，谓自绝其踪迹。或曰：从，读如字，谓绝其从坐之罪也。","note_type":"hu_note","start_index":193,"tongjian_id":"8bfb1562-db0e-11ef-b898-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"韓相","official_note":"韓相是戰國時期韓國的最高行政長官，相當於宰相，負責輔佐君主處理國政。在上下文中，俠累擔任韓相，成為刺殺目標，顯示其政治地位和影響力。","official_rank":"未知","source_snippet":"盜殺韓相俠累","start_index":4,"tongjian_id":"aac5bf32-2444-413a-9ed1-1893ff41d6ee"}],"ExtRef_Children_people":[{"link_death_year":-397,"link_td_description":"聂嫈，《史记》记载名荣，战国轵邑（今日河南省济源市轵城镇）深井里人，是战国时期著名的刺客聂政的姐姐。","link_td_id":"Q10005260","link_td_number_id":5498919,"people_name":"嫈","people_name_jianti_auto":"嫈","people_xingming":"聂嫈","start_index":135,"tongjian_id":"8bfb1574-db0e-11ef-b643-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8bfb1542-db0e-11ef-a3f1-a0d3651f611f","pinyin":"zhǐ","source_anchor_text":"惡仲子聞軹人聶政之","source_key":"baiyang_epub","start_index":25,"text":"軹","tongjian_id":"272ec0c3-57a4-59f2-a432-ffac398ce12e"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2三月，盜殺韓相俠累。俠累與濮陽嚴仲子有惡。仲子聞軹人聶政之勇，以黃金百溢爲政母壽，欲因以報仇。政不受，曰：「老母在，政身未敢以許人也！」及母卒，仲子乃使政刺俠累。俠累方坐府上，兵衞甚衆，聶政直入上階，刺殺俠累，因自皮面決眼，自屠出腸。韓人暴其尸於市，購問，莫能識。其姊嫈聞而往，哭之曰：「是軹深井里聶政也！以妾尚在之故，重自刑以絕從。妾柰何畏歿身之誅，終滅賢弟之名！」遂死於政尸之旁。","content_fanyi":"三月，强盗刺杀了韩国国相侠累。侠累与濮阳人严仲子有仇。严仲子听说轵邑人聂政勇敢，用一百镒黄金给聂政的母亲祝寿，想借他报仇。聂政不接受，说：“老母还在世，我聂政不敢把自身许诺给别人！”等到母亲去世后，严仲子就派聂政去刺杀侠累。侠累正坐在相府厅堂上，侍卫很多，聂政径直冲上台阶，杀死了侠累，然后自己割破脸皮、剜出眼睛，又剖腹拉出肠子而死。韩国人把他的尸体陈放在街市上示众，悬赏征求能辨认的人，但没有人能认出来。他的姐姐聂嫈听说后，赶往陈尸的街市，抚着尸体哭着说：“这是轵邑深井里的聂政啊！他因为我还在人世，就深深毁伤自己来断绝线索。我怎么能因为怕招来杀身之祸，就永远埋没贤弟的名声呢！”于是自杀，死在聂政尸体旁边。","content_jianti_auto":"2三月，盗杀韩相侠累。侠累与濮阳严仲子有恶。仲子闻轵人聂政之勇，以黄金百溢为政母寿，欲因以报仇。政不受，曰：「老母在，政身未敢以许人也！」及母卒，仲子乃使政刺侠累。侠累方坐府上，兵衞甚众，聂政直入上阶，刺杀侠累，因自皮面决眼，自屠出肠。韩人暴其尸于市，购问，莫能识。其姊嫈闻而往，哭之曰：「是轵深井里聂政也！以妾尚在之故，重自刑以绝从。妾柰何畏殁身之诛，终灭贤弟之名！」遂死于政尸之旁。","dtjl_paragraph_links":[],"dtjl_references":[],"id":42,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bfb1542-db0e-11ef-a3f1-a0d3651f611f","year_int":-397},"tongjian_id":"8bfb1542-db0e-11ef-a3f1-a0d3651f611f"},"paragraph_order":1}],"page_size":7,"total_pages":1,"total_paragraphs":1},"profile":{"alias_list":["聂荣"],"biography":"聂嫈，《史记》记载名荣，战国轵邑（今日河南省济源市轵城镇）深井里人，是战国时期著名的刺客聂政的姐姐。","death_year":-397,"link_td_id":"Q10005260","name":"聂嫈","number_id":5498919},"relationships":[{"direction":"forward","rank":"normal","relation_detail":"聂嫈是聂政的姐姐，来源文本：是戰國 (中国)(戰國时期)著名的刺客聶政的姐姐。","relation_property_display_template":"{subject}的兄弟姐妹是{value}","relation_property_id":"P100028","relation_property_label":"兄弟姐妹","source_person_id":"Q10005260","source_person_name":"聂嫈","source_person_number_id":5498919,"statement_id":"S-Q10005260-P100028-Q10009102","target_person_id":"Q10009102","target_person_name":"聂政","target_person_number_id":523601},{"direction":"reverse","rank":"normal","relation_detail":"聂政的姐姐，来源文本：|兄弟姊妹=聶嫈","relation_property_display_template":"{subject}的兄弟姐妹是{value}","relation_property_id":"P100028","relation_property_label":"兄弟姐妹","source_person_id":"Q10009102","source_person_name":"聂政","source_person_number_id":523601,"statement_id":"S-Q10009102-P100028-Q10005260","target_person_id":"Q10005260","target_person_name":"聂嫈","target_person_number_id":5498919}]},"message":"success","success":true}