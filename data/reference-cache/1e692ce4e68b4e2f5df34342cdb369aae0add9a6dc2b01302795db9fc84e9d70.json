[{"people_name":"劉向","people_name_jianti_auto":"刘向","start_index":4,"tongjian_id":"8ca437c6-db0e-11ef-9347-a0d3651f611f"},{"people_name":"陸璣","people_name_jianti_auto":"陆玑","start_index":20,"tongjian_id":"8ca437c7-db0e-11ef-b56f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「𪄟」，劉向說苑作「鸇」。字林曰：鷂屬。陸璣曰：鸇似鷂，青黃色，燕頷句啄，向風搖翅，乃因風飛急疾，擊鳩、鴿、燕、雀食之。陬，子侯翻，隅也。句，古侯翻。","note_content_jianti_auto":"「𪄟」，刘向说苑作「鹯」。字林曰：鹞属。陆玑曰：鹯似鹞，青黄色，燕颔句啄，向风摇翅，乃因风飞急疾，击鸠、鸽、燕、雀食之。陬，子侯翻，隅也。句，古侯翻。","note_type":"hu_note","start_index":11,"tongjian_id":"8ca437c5-db0e-11ef-92c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史，太史之屬，掌卜筮者。","note_content_jianti_auto":"史，太史之属，掌卜筮者。","note_type":"hu_note","start_index":14,"tongjian_id":"8ca437cd-db0e-11ef-9def-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"凶人吉其凶。","note_content_jianti_auto":"凶人吉其凶。","note_type":"hu_note","start_index":19,"tongjian_id":"8ca437ce-db0e-11ef-b5f8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8ca437d0-db0e-11ef-aa6b-a0d3651f611f"},{"people_name":"孟嘗君","people_name_jianti_auto":"孟尝君","start_index":35,"tongjian_id":"8ca437d1-db0e-11ef-96b0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沛郡公丘縣","place_name_jianti_auto":"沛郡公丘县","start_index":3,"tongjian_id":"8ca437d2-db0e-11ef-b3fd-a0d3651f611f"},{"place_name":"滕國","place_name_jianti_auto":"滕国","start_index":10,"tongjian_id":"8ca437d3-db0e-11ef-bae8-a0d3651f611f"},{"place_name":"滕城","place_name_jianti_auto":"滕城","start_index":17,"tongjian_id":"8ca437d4-db0e-11ef-99c5-a0d3651f611f"},{"place_name":"蕃縣","place_name_jianti_auto":"蕃县","start_index":20,"tongjian_id":"8ca437d5-db0e-11ef-992d-a0d3651f611f"},{"place_name":"滕縣","place_name_jianti_auto":"滕县","start_index":27,"tongjian_id":"8ca437d6-db0e-11ef-bf13-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":30,"tongjian_id":"8ca437d7-db0e-11ef-937c-a0d3651f611f"},{"place_name":"薛","place_name_jianti_auto":"薛","start_index":33,"tongjian_id":"8ca437d8-db0e-11ef-9227-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：沛郡公丘縣，古滕國。水經註：滕城在蕃縣西。唐志，滕縣屬徐州。薛卽孟嘗君所封地。蕃，音皮，又音如字。","note_content_jianti_auto":"班志：沛郡公丘县，古滕国。水经注：滕城在蕃县西。唐志，滕县属徐州。薛即孟尝君所封地。蕃，音皮，又音如字。","note_type":"hu_note","start_index":43,"tongjian_id":"8ca437cf-db0e-11ef-8c15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"敗，補邁翻。亟，己力翻。射，而亦翻；後以義推。笞，擊也，音丑之翻。","note_content_jianti_auto":"败，补迈翻。亟，己力翻。射，而亦翻；后以义推。笞，击也，音丑之翻。","note_type":"hu_note","start_index":93,"tongjian_id":"8ca437dc-db0e-11ef-83e1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"共工氏","people_name_jianti_auto":"共工氏","start_index":3,"tongjian_id":"8ca437de-db0e-11ef-809d-a0d3651f611f"},{"people_name":"句龍","people_name_jianti_auto":"句龙","start_index":9,"tongjian_id":"8ca437df-db0e-11ef-a23b-a0d3651f611f"},{"people_name":"烈山氏","people_name_jianti_auto":"烈山氏","start_index":23,"tongjian_id":"8ca437e0-db0e-11ef-8ac5-a0d3651f611f"},{"people_name":"柱","people_name_jianti_auto":"柱","start_index":29,"tongjian_id":"8ca437e1-db0e-11ef