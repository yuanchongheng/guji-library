{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛亥、前七○）","note_content_jianti_auto":"（辛亥、前七○）","note_type":"hu_note","start_index":0,"tongjian_id":"90bd187b-db0e-11ef-9f32-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"霍光","people_name_jianti_auto":"霍光","people_xingming":"霍光","start_index":10,"tongjian_id":"90bd187f-db0e-11ef-9c14-a0d3651f611f"},{"link_birth_year":-88,"link_death_year":-71,"link_td_description":"许平君，昌邑（今山东省金乡县）人，平恩戴侯许广汉之女，汉宣帝刘询的糟糠之妻和首任皇后。","link_td_id":"Q10000627","link_td_number_id":148967,"people_name":"許后","people_name_jianti_auto":"许后","people_xingming":"许平君","start_index":23,"tongjian_id":"90bd1880-db0e-11ef-9aaa-a0d3651f611f","wl_zhushi":"[许平君]"},{"link_death_year":-54,"link_td_description":"霍成君，中国西汉名臣霍光小女儿，霍显所生，汉宣帝刘询第二位皇后，孝昭皇后姨母。被废，后自杀。","link_td_id":"Q10008227","link_td_number_id":148985,"people_name":"霍后","people_name_jianti_auto":"霍后","people_xingming":"霍成君","start_index":44,"tongjian_id":"90bd1881-db0e-11ef-b73c-a0d3651f611f"},{"link_birth_year":-88,"link_death_year":-71,"link_td_description":"许平君，昌邑（今山东省金乡县）人，平恩戴侯许广汉之女，汉宣帝刘询的糟糠之妻和首任皇后。","link_td_id":"Q10000627","link_td_number_id":148967,"people_name":"許后","people_name_jianti_auto":"许后","start_index":66,"tongjian_id":"90bd1882-db0e-11ef-a2af-a0d3651f611f","wl_zhushi":"[许平君]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"90bd187c-db0e-11ef-ac85-a0d3651f611f","pinyin":"yú","source_anchor_text":"及霍后立轝駕侍從益","source_key":"baiyang_epub","start_index":48,"text":"轝","tongjian_id":"82841465-7bff-5c98-b821-f43bbe07974f"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","权争"],"content":"1春，三月，乙卯，立霍光女爲皇后；赦天下。初，許后起微賤，登至尊日淺，從官車服甚節儉。及霍后立，轝駕、侍從益盛，賞賜官屬以千萬計，與許后時縣絕矣。","content_fanyi":"春季，三月乙卯日，册立霍光的女儿霍成君为皇后；大赦天下。起初，许皇后出身卑微，登上至尊之位的时间不长，随从官员、车马服饰都很节俭。到霍成君被立为皇后时，车驾、侍从更加盛大，赏赐属官的财物数以千万计，与许皇后时期相比已是天壤之别。","content_jianti_auto":"1春，三月，乙卯，立霍光女为皇后；赦天下。初，许后起微贱，登至尊日浅，从官车服甚节俭。及霍后立，轝驾、侍从益盛，赏赐官属以千万计，与许后时县绝矣。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1986,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"90bd187c-db0e-11ef-ac85-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":0,"tongjian_id":"90bd1885-db0e-11ef-ba35-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"太祖高皇帝廟","place_name_jianti_auto":"太祖高皇帝庙","place_note":"刘邦","start_index":10,"tongjian_id":"90bd1886-db0e-11ef-9bea-a0d3651f611f"},{"place_name":"太宗文皇帝廟","place_name_jianti_auto":"太宗文皇帝庙","place_note":"刘恒","start_index":17,"tongjian_id":"90bd1887-db0e-11ef-b027-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"景帝元年，令郡國各立太祖高皇帝廟、太宗文皇帝廟。壞，音怪。","note_content_jianti_auto":"景帝元年，令郡国各立太祖高皇帝庙、太宗文皇帝庙。坏，音怪。","note_type":"hu_note","start_index":46,"tongjian_id":"90bd1884-db0e-11ef-9b87-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90bd1889-db0e-11ef-91e2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：謂禦塞災異也。","note_content_jianti_auto":"师古曰：谓御塞灾异也。","note_type":"hu_note","start_index":72,"tongjian_id":"90bd1888-db0e-11ef-93c9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"揚州","place_name_jianti_auto":"扬州","start_index":0,"tongjian_id":"90bd188b-db0e-11ef-918e-a0d3651f611f"},{"place_name":"廬江","place_name_jianti_auto":"庐江","start_index":3,"tongjian_id":"90bd188c-db0e-11ef-8a2a-a0d3651f611f"},{"place_name":"九江","place_name_jianti_auto":"九江","start_index":6,"tongjian_id":"90bd188d-db0e-11ef-8779-a0d3651f611f"},{"place_name":"會稽","place_name_jianti_auto":"会稽","start_index":9,"tongjian_id":"90bd188e-db0e-11ef-95ba-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","start_index":12,"tongjian_id":"90bd188f-db0e-11ef-a4a9-a0d3651f611f"},{"place_name":"豫章","place_name_jianti_auto":"豫章","start_index":15,"tongjian_id":"90bd1890-db0e-11ef-8843-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"揚州統廬江、九江、會稽、丹陽、豫章等郡。","note_content_jianti_auto":"扬州统庐江、九江、会稽、丹阳、豫章等郡。","note_type":"hu_note","start_index":137,"tongjian_id":"90bd188a-db0e-11ef-bd9a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处皇帝下诏要求丞相参与咨询经学之士以应对地震灾害，体现了其核心决策角色。","official_rank":"正一品","source_snippet":"詔丞相、御史與列侯、中二千石博問經學之士","start_index":48,"tongjian_id":"f98ac618-8bd8-42ba-a67d-72712c6968ab"},{"confidence":0.9,"official_category":"监察","official_name":"御史","official_note":"御史在汉代负责监察百官，此处皇帝下诏要求御史参与咨询经学之士，可能涉及监督或建议职能。","official_rank":"未知","source_snippet":"詔丞相、御史與列侯、中二千石博問經學之士","start_index":51,"tongjian_id":"af876c8d-1d20-4df1-bff7-1573c1312ece"},{"confidence":0.85,"official_category":"爵位","official_name":"列侯","official_note":"列侯是汉代高级爵位，通常授予功臣或贵族，此处皇帝下诏要求列侯参与咨询经学之士，可能表示其社会地位或咨询作用。","official_rank":"未知","source_snippet":"詔丞相、御史與列侯、中二千石博問經學之士","start_index":54,"tongjian_id":"647b636a-5799-4d26-a10d-56cfc13c89ed"},{"confidence":0.8,"official_category":"俸禄等级","official_name":"中二千石","official_note":"中二千石是汉代官员的俸禄等级，对应高级官员，此处皇帝下诏要求中二千石官员参与咨询经学之士，可能指代特定高级官员群体。","official_rank":"未知","source_snippet":"詔丞相、御史與列侯、中二千石博問經學之士","start_index":57,"tongjian_id":"a7e639a6-c40d-4a0c-bd6b-55d575f101b6"},{"confidence":0.9,"official_category":"地方行政","official_name":"三輔","official_note":"三輔指汉代京畿地区的三个行政区划（京兆尹、左冯翊、右扶风），此处皇帝下令三輔举荐贤良方正，体现了其地方行政职能。","official_rank":"未知","source_snippet":"令三輔、太常、內郡國舉賢良方正各一人","start_index":78,"tongjian_id":"b8560005-09ea-4c26-8294-ce0a46fe2f7d"},{"confidence":0.95,"official_category":"文教","official_name":"太常","official_note":"太常是汉代九卿之一，掌管宗庙礼仪和教育，此处皇帝下令太常举荐贤良方正，与其文教职能相关。","official_rank":"九卿之一","source_snippet":"令三輔、太常、內郡國舉賢良方正各一人","start_index":81,"tongjian_id":"fe97664b-497a-4f30-a48b-2d17126ed30c"},{"confidence":0.85,"official_category":"地方行政","official_name":"內郡國","official_note":"內郡國指汉代的内地郡和诸侯国，此处皇帝下令內郡國举荐贤良方正，体现了地方行政单位的举荐职责。","official_rank":"未知","source_snippet":"令三輔、太常、內郡國舉賢良方正各一人","start_index":84,"tongjian_id":"0e2dc0a6-bea7-404d-894b-d3834d62a415"},{"confidence":0.9,"official_category":"谏议","official_name":"諫大夫","official_note":"諫大夫是汉代谏官，负责向皇帝进谏，此处夏侯胜被任命为諫大夫，可能与其经学背景或应对灾害的建议相关。","official_rank":"未知","source_snippet":"以勝爲諫大夫、給事中","start_index":108,"tongjian_id":"2a6de584-cdce-4a60-bef8-e694d2b04d62"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"給事中","official_note":"給事中是汉代加官，允许官员出入禁中参与决策，此处夏侯胜被任命为給事中，可能增强其谏议职能。","official_rank":"未知","source_snippet":"以勝爲諫大夫、給事中","start_index":112,"tongjian_id":"2235d257-ef30-417a-a341-40a616c2cb85"},{"confidence":0.95,"official_category":"地方行政","official_name":"揚州刺史","official_note":"揚州刺史是汉代地方行政官员，负责监察扬州地区的郡国，此处黄霸被任命为揚州刺史，可能涉及地方治理或举荐贤良。","official_rank":"州牧级别","source_snippet":"霸爲揚州刺史","start_index":118,"tongjian_id":"00f57694-f45a-47c7-8934-15087384c46d"}],"ExtRef_Children_people":[{"link_td_description":"夏侯胜，字长公，是西汉官员、经学家，其出身东平（今宁阳县西）。夏侯胜为人质朴守正，个性简率无威严，早年师事夏侯始昌、蕳卿、欧阳氏等人学习儒家经典，精通儒学，世称“大夏侯”，是大夏侯氏学的开创者，后受朝廷征召出仕，汉宣帝时期，夏侯胜一度因反对替汉武帝增封庙乐而下狱，后遇赦复出为官，在九十岁高龄时，于太子太傅任上逝世。","link_td_id":"Q10009933","link_td_number_id":912893,"people_name":"夏侯勝","people_name_jianti_auto":"夏侯胜","people_xingming":"夏侯胜","start_index":112,"tongjian_id":"90be16a3-db0e-11ef-a8fb-a0d3651f611f"},{"link_birth_year":-130,"link_death_year":-51,"link_td_description":"黄霸，字次公，西汉淮阳郡阳夏县（今河南省太康县）人，汉武帝末年以捐官出仕，逐步晋升，为政外宽内明，政绩卓著，被誉为自汉朝建立以来最善于治理百姓的官吏。五凤三年接替邴吉为丞相，封建成侯。甘露三年逝世，谥号“定”。后世常与龚遂并称“龚黄”，作为循吏的代表。","link_td_id":"Q10013021","link_td_number_id":1547170,"people_name":"黃霸","people_name_jianti_auto":"黄霸","people_xingming":"黄霸","start_index":116,"tongjian_id":"90be16a4-db0e-11ef-a597-a0d3651f611f"},{"link_td_description":"夏侯胜，字长公，是西汉官员、经学家，其出身东平（今宁阳县西）。夏侯胜为人质朴守正，个性简率无威严，早年师事夏侯始昌、蕳卿、欧阳氏等人学习儒家经典，精通儒学，世称“大夏侯”，是大夏侯氏学的开创者，后受朝廷征召出仕，汉宣帝时期，夏侯胜一度因反对替汉武帝增封庙乐而下狱，后遇赦复出为官，在九十岁高龄时，于太子太傅任上逝世。","link_td_id":"Q10009933","link_td_number_id":912893,"people_name":"勝","people_name_jianti_auto":"胜","people_xingming":"夏侯胜","start_index":120,"tongjian_id":"90be16a5-db0e-11ef-9b69-a0d3651f611f"},{"link_birth_year":-130,"link_death_year":-51,"link_td_description":"黄霸，字次公，西汉淮阳郡阳夏县（今河南省太康县）人，汉武帝末年以捐官出仕，逐步晋升，为政外宽内明，政绩卓著，被誉为自汉朝建立以来最善于治理百姓的官吏。五凤三年接替邴吉为丞相，封建成侯。甘露三年逝世，谥号“定”。后世常与龚遂并称“龚黄”，作为循吏的代表。","link_td_id":"Q10013021","link_td_number_id":1547170,"people_name":"霸","people_name_jianti_auto":"霸","people_xingming":"黄霸","start_index":130,"tongjian_id":"90be16a6-db0e-11ef-827f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"北海","place_name_jianti_auto":"北海","place_note":"山東昌樂东南","resolved_place_entity_id":595,"start_index":36,"tongjian_id":"90bd1891-db0e-11ef-8b91-a0d3651f611f"},{"place_name":"琅邪","place_name_jianti_auto":"琅邪","place_note":"山東諸城","resolved_place_entity_id":445,"start_index":39,"tongjian_id":"90bd1892-db0e-11ef-84ef-a0d3651f611f"},{"place_name":"三輔","place_name_jianti_auto":"三辅","resolved_place_entity_id":476,"start_index":78,"tongjian_id":"90be16a7-db0e-11ef-b6fc-a0d3651f611f"},{"place_name":"揚州","place_name_jianti_auto":"扬州","resolved_place_entity_id":155,"start_index":132,"tongjian_id":"90be16a8-db0e-11ef-8db4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉诽谤法","excerpts":[{"context_after":"。章帝时，孔僖、崔骃游太学，相与论武帝始为天子，崇信圣道...","context_before":"汉宣帝诏群臣议武帝庙乐，","source_end_index":97,"source_paragraph_tongjian_id":"2ef6af7f-535e-4202-81b2-8d9e7e53a5e0","source_start_index":12,"source_text":"夏侯胜曰：“武帝竭民财力，奢泰亡度，天下虚耗，百姓流离，赤地数千里，亡德泽于民，不宜为立庙乐。”于是丞相、御史劾奏胜非议诏书，毁先帝，不道。遂下狱，系再更冬，会赦，乃得免"}],"path":"随笔/卷十一/汉诽谤法","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"2夏，四月，壬寅，郡國四十九同日地震，或山崩，壞城郭、室屋，殺六千餘人。北海、琅邪壞祖宗廟。詔丞相、御史與列侯、中二千石博問經學之士，有以應變，毋有所諱。令三輔、太常、內郡國舉賢良方正各一人。大赦天下。上素服，避正殿五日。釋夏侯勝、黃霸；以勝爲諫大夫、給事中，霸爲揚州刺史。","content_fanyi":"夏季，四月壬寅日，四十九个郡、国在同一天发生地震，有的地方山体崩塌，城郭、房屋被毁，死亡六千余人。北海、琅邪两郡的太祖庙、太宗庙也遭到破坏。汉宣帝下诏，命丞相、御史与列侯、中二千石官员广泛询问通晓经学的士人，有能够应对灾变的办法，不要有所避讳。又命三辅、太常和内地郡国各举荐贤良、方正一人。大赦天下。宣帝身穿素服，避开正殿五天。释放夏侯胜、黄霸；任命夏侯胜为谏大夫、给事中，黄霸为扬州刺史。","content_jianti_auto":"2夏，四月，壬寅，郡国四十九同日地震，或山崩，坏城郭、室屋，杀六千余人。北海、琅邪坏祖宗庙。诏丞相、御史与列侯、中二千石博问经学之士，有以应变，毋有所讳。令三辅、太常、内郡国举贤良方正各一人。大赦天下。上素服，避正殿五日。释夏侯胜、黄霸；以胜为谏大夫、给事中，霸为扬州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1987,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"90bd1883-db0e-11ef-b53f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90be4639-db0e-11ef-9b10-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：前，天子之前也。君前臣名，不當相呼字也。","note_content_jianti_auto":"师古曰：前，天子之前也。君前臣名，不当相呼字也。","note_type":"hu_note","start_index":28,"tongjian_id":"90be4638-db0e-11ef-9f7c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90be463b-db0e-11ef-8ad7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：知其質樸也。","note_content_jianti_auto":"师古曰：知其质朴也。","note_type":"hu_note","start_index":36,"tongjian_id":"90be463a-db0e-11ef-844c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90be463d-db0e-11ef-bbdf-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：入見天子而以其言爲外人道之。見，賢遍翻。","note_content_jianti_auto":"师古曰：入见天子而以其言为外人道之。见，贤遍翻。","note_type":"hu_note","start_index":44,"tongjian_id":"90be463c-db0e-11ef-9e51-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90be463f-db0e-11ef-a9ab-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：懲，創也。前事，謂坐議廟樂事。","note_content_jianti_auto":"师古曰：惩，创也。前事，谓坐议庙乐事。","note_type":"hu_note","start_index":117,"tongjian_id":"90be463e-db0e-11ef-8f57-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷事务","official_name":"長信少府","official_note":"長信少府是漢代官職，負責長信宮（太后居所）的事務，屬於宮廷事務官員。在《資