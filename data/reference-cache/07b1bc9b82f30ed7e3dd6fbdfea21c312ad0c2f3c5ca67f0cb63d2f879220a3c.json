hildren_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8c30441d-db0e-11ef-b0bc-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":2,"tongjian_id":"8c30441e-db0e-11ef-b587-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":4,"tongjian_id":"8c30441f-db0e-11ef-9841-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦、魏以河爲界也。","note_content_jianti_auto":"秦、魏以河为界也。","note_type":"hu_note","start_index":54,"tongjian_id":"8c30441c-db0e-11ef-9066-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-390,"link_death_year":-338,"link_td_description":"商鞅（前390年—前338年），又称卫鞅或公孙鞅，是战国中期卫国人，公元前4世纪的重要政治家和军事家，也是法家代表人物之一，师从李悝。","link_td_id":"Q10000225","link_td_number_id":5851,"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","people_xingming":"卫鞅","start_index":1,"tongjian_id":"8c327a64-db0e-11ef-ab16-a0d3651f611f"},{"link_birth_year":-382,"link_death_year":-338,"link_td_description":"秦孝公，战国时期秦国君主，秦献公之子，前362年－前338年在位，在位共25年。","link_td_id":"Q10001805","link_td_number_id":139181,"people_name":"秦孝公","people_name_jianti_auto":"秦孝公","people_xingming":"嬴渠梁","start_index":5,"tongjian_id":"8c327a65-db0e-11ef-a994-a0d3651f611f","wl_zhushi":"[嬴渠梁]"},{"link_birth_year":-390,"link_death_year":-338,"link_td_description":"商鞅（前390年—前338年），又称卫鞅或公孙鞅，是战国中期卫国人，公元前4世纪的重要政治家和军事家，也是法家代表人物之一，师从李悝。","link_td_id":"Q10000225","link_td_number_id":5851,"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","start_index":146,"tongjian_id":"8c3297b6-db0e-11ef-925b-a0d3651f611f"},{"link_td_description":"公子卬，姬姓，魏氏，名卬，战国时期魏国公子。","link_td_id":"Q10002986","link_td_number_id":1602944,"people_name":"公子卬","people_name_jianti_auto":"公子卬","people_xingming":"公子卬","start_index":155,"tongjian_id":"8c3297b7-db0e-11ef-bbd5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_pl