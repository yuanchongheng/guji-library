ty_id":1,"start_index":105,"tongjian_id":"8c3297b0-db0e-11ef-9fb4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":107,"tongjian_id":"8c3297b1-db0e-11ef-a671-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":110,"tongjian_id":"8c3297b2-db0e-11ef-8d07-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":118,"tongjian_id":"8c3297b3-db0e-11ef-ab0a-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":120,"tongjian_id":"8c3297b4-db0e-11ef-9249-a0d3651f611f"},{"place_name":"山","place_name_jianti_auto":"山","resolved_place_entity_id":1386,"start_index":122,"tongjian_id":"8c3297b5-db0e-11ef-8e48-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":151,"tongjian_id":"8c3297b8-db0e-11ef-95b4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":153,"tongjian_id":"8c3297b9-db0e-11ef-b8f4-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"河西之战（后期）","tongjian_id":"war_N0507"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"，伐赵取晋阳，伐楚取鄢、郢矣。覆三国之军，兼二周之地，举...","context_before":"...晋阳者，赵之柱国也；鄢、郢者，楚之柱国也。三国与秦壤界，","source_end_index":264,"source_paragraph_tongjian_id":"1ce54d3a-f726-5dd3-9c48-497593cd268b","source_start_index":258,"source_text":"秦伐魏取安邑"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"盖魏之强，以河西、安邑；而韩之强，则以上党；赵之强，则以...","context_before":"...谓非晋之大有造于天下也。及三家分晋，而晋非复春秋之旧矣。","source_end_index":619,"source_paragraph_tongjian_id":"72077296-9784-5719-b078-2e0a63e7f383","source_start_index":555,"source_text":"然而卫鞅之言曰：秦之与魏，譬如人有腹心之疾，非魏并秦，秦即并魏，魏必东徙，然后秦可据山河之固，东乡以制诸侯。是一魏犹足以难秦也。"}],"path":"山西方舆纪要/序","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷三十九）","excerpts":[{"context_after":"司马贞曰：大河径中条之西，自中条以东，连汾、晋之险嶝，谓...","context_before":"...禹贡》：壶口、雷首。即是山也。《左传》：赵宣子田于首山。","source_end_index":123,"source_paragraph_tongjian_id":"a2ec7a8f-05ea-5d22-a454-b5d5b1511794","source_start_index":87,"source_text":"《史记》：卫鞅谓秦孝公，魏居岭阨之西，都安邑，与秦界河，而独擅山东之利。"}],"path":"山西方舆纪要/〇、封域山川险要（卷三十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"秦、汉以降，河东多事，平阳尝为战地。曹魏置郡于此，襟带河...","context_before":"...涑、浍以为渊，而子犯所谓表里河山者也。战国时，魏有其地。","source_end_index":164,"source_paragraph_tongjian_id":"7adafbb7-a267-5334-9c53-1e4f442bba8e","source_start_index":75,"source_text":"秦商鞅言于孝公曰：秦之与魏，譬若人有腹心之疾，非魏并秦，秦即并魏。何者？魏居岭阨之西，都安邑，而独擅山东之利。利则西侵秦，病则东收地。魏必东徙，然后秦据河山之固，东向以制诸侯矣。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"其尽得河西，则犀首张仪之力也]。《吕氏春秋》：吴起去西河...","context_before":"...摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也[吕氏曰：","source_end_index":442,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":430,"source_text":"秦孝公用商鞅，取河西地。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"1衞鞅言於秦孝公曰：「秦之與魏，譬若人有腹心之疾，非魏幷秦，秦卽幷魏。何者？魏居嶺阨之西，都安邑，與秦界河，而獨擅山東之利，利則西侵秦，病則東收地。今以君之賢聖，國賴以盛；而魏往年大破於齊，諸侯畔之，可因此時伐魏。魏不支秦，必東徙，然後秦據河、山之固，東鄕以制諸侯，此帝王之業也。」公從之，使衞鞅將兵伐魏。魏使公子卬將而禦之。","content_fanyi":"卫鞅对秦孝公说：“秦魏两国势不两立，就好比人身上长有心腹部位的毒疮，不是魏国吞并秦国，就是秦国吞并魏国。这是为什么呢？魏国地处中条山险阻的西面，建都安邑，与秦国以黄河为界，独自占有华山以东的地势优势；形势有利时，它就向西侵犯秦国，形势不利时，它就向东夺取地盘。如今凭着君主您的贤明圣德，国家因此强盛；而魏国前些年被齐国打得大败，诸侯都背叛了它，可以趁这个时候进攻魏国。魏国抵挡不住秦国的进攻，必定向东迁都，然后秦国据有黄河、中条山的险固，向东控制诸侯各国，这是建立帝王之业啊。”秦孝公听从了商鞅的计策，派卫鞅率兵攻打魏国。魏国派公子卬率军抵御秦军。","content_jianti_auto":"1衞鞅言于秦孝公曰：「秦之与魏，譬若人有腹心之疾，非魏幷秦，秦即幷魏。何者？魏居岭阨之西，都安邑，与秦界河，而独擅山东之利，利则西侵秦，病则东收地。今以君之贤圣，国赖以盛；而魏往年大破于齐，诸侯畔之，可因此时伐魏。魏不支秦，必东徙，然后秦据河、山之固，东鄕以制诸侯，此帝王之业也。」公从之，使衞鞅将兵伐魏。魏使公子卬将而御之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":166,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c304414-db0e-11ef-914b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"盟已而飲也。","note_content_jianti_auto":"盟已而饮也。","note_type":"hu_note","start_index":75,"tongjian_id":"8c3297bd-db0e-11ef-8485-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-390,"link_death_year":-338,"link_td_description":"商鞅（前390年—前338年），又称卫鞅或公孙鞅，是战国中期卫国人，公元前4世纪的重要政治家和军事家，也是法家代表人物之一，师从李悝。","link_td_id":"Q10000225","link_td_number_id":5851,"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","people_xingming":"卫鞅","start_index":5,"tongjian_id":"8c3297be-db0e-11ef-a7a0-a0d3651f611f"},{"link_td_description":"公子卬，姬姓，魏氏，名卬，战国时期魏国公子。","link_td_id":"Q10002986","link_td_number_id":1602944,"people_name":"公子卬","people_name_jianti_auto":"公子卬","people_xingming":"公子卬","start_index":8,"tongjian_id":"8c3297bf-db0e-11ef-ad43-a0d3651f611f"},{"link_td_description":"公子卬，姬姓，魏氏，名卬，战国时期魏国公子。","link_td_id":"Q10002986","link_td_number_id":1602944,"people_name":"公子卬","people_name_jianti_auto":"公子卬","people_xingming":"公子卬","start_index":58,"tongjian_id":"8c3297c2-db0e-11ef-96fb-a0d3651f611f"},{"link_birth_year":-390,"link_death_year":-338,"link_td_description":"商鞅（前390年—前338年），又称卫鞅或公孙鞅，是战国中期卫国人，公元前4世纪的重要政治家和军事家，也是法家代表人物之一，师从李悝。","link_td_id":"Q10000225","link_td_number_id":5851,"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","people_xingming":"卫鞅","start_index":76,"tongjian_id":"8c3297c3-db0e-11ef-9177-a0d3651f611f"},{"link_td_description":"公子卬，姬姓，魏氏，名卬，战国时期魏国公子。","link_td_id":"Q10002986","link_td_number_id":1602944,"people_name":"公子卬","people_name_jianti_auto":"公子卬","people_xingming":"公子卬","start_index":84,"tongjian_id":"8c3297c4-db0e-11ef-aede-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c3297ba-db0e-11ef-a212-a0d3651f611f","pinyin":"huān","source_anchor_text":"始與公子驩今俱為兩","source_key":"baiyang_epub","start_index":20,"text":"驩","tongjian_id":"7bcb55ef-457d-5276-8614-5a0d6fd1aa0f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":51,"tongjian_id":"8c3297c0-db0e-11ef-8788-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":53,"tongjian_id":"8c3297c1-db0e-11ef-815a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":90,"tongjian_id":"8c3297c5-db0e-11ef-b343-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"河西之战（后期）","tongjian_id":"war_N0507"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"其尽得河西，则犀首张仪之力也]。《吕氏春秋》：吴起去西河...","context_before":"...摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也[吕氏曰：","source_end_index":442,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":430,"source_text":"秦孝公用商鞅，取河西地。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"軍旣相距，衞鞅遺公子卬書曰：「吾始與公子驩；今俱爲兩國將，不忍相攻，可與公子面相見盟，樂飲而罷兵，以安秦、魏之民。」公子卬以爲然，乃相與會；盟已，飲，而衞鞅伏甲士，襲虜公子卬，因攻魏師，大破之。","content_fanyi":"秦、魏两军相互对峙时，卫鞅派人送信给公子卬说：“我当初与公子交情很好，如今我们都已成为两国的将领，我不忍心互相攻杀。我可以与公子当面相见、订立盟约，畅饮之后撤兵，以此安定秦、魏两国的百姓。”公子卬认为这样很好，便前去与卫鞅相会。盟誓结束，正在饮酒祝贺时，卫鞅预先埋伏的甲士突然袭击，俘虏了公子卬，接着乘势进攻魏军，把魏军打得大败。","content_jianti_auto":"军既相距，衞鞅遗公子卬书曰：「吾始与公子驩；今俱为两国将，不忍相攻，可与公子面相见盟，乐饮而罢兵，以安秦、魏之民。」公子卬以为然，乃相与会；盟已，饮，而衞鞅伏甲士，袭虏公子卬，因攻魏师，大破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":167,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c3297ba-db0e-11ef-a212-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c3297c9-db0e-11ef-98f0-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":14,"tongjian_id":"8c3297ca-db0e-11ef-849f-a0d3651f611f"},{"people_name":"魏惠王","people_name_jianti_auto":"魏惠王","start_index":28,"tongjian_id":"8c3297cb-db0e-11ef-87f2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陳留郡","place_name_jianti_auto":"陈留郡","start_index":3,"tongjian_id":"8c3297cc-db0e-11ef-9a4d-a0d3651f611f"},{"place_name":"浚儀縣","place_name_jianti_auto":"浚仪县","start_index":6,"tongjian_id":"8c3297cd-db0e-11ef-b334-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","start_index":11,"tongjian_id":"8c3297ce-db0e-11ef-b221-a0d3651f611f"},{"place_name":"汴州","place_name_jianti_auto":"汴州","start_index":18,"tongjian_id":"8c3297cf-db0e-11ef-b5ee-a0d3651f611f"},{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":25,"tongjian_id":"8c3297d0-db0e-11ef-be94-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：陳留郡浚儀縣，故大梁。杜佑曰：汴州城西古城，戰國時魏惠王所築。","note_content_jianti_auto":"班志：陈留郡浚仪县，故大梁。杜佑曰：汴州城西古城，战国时魏惠王所筑。","note_type":"hu_note","start_index":27,"tongjian_id":"8c3297c8-db0e-11ef-8ff7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":7,"source_start_index":0,"source_text":"公叔言見上八年","target_paragraph_tongjian_id":"8c22eb11-db0e-11ef-bc51-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"公叔","people_name_jianti_auto":"公叔","start_index":0,"tongjian_id":"8c3297d3-db0e-11ef-9f4e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"公叔言見上八年。","note_content_jianti_auto":"公叔言见上八年。","note_type":"hu_note","start_index":42,"tongjian_id":"8c3297d2-db0e-11ef-94b3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏惠王","people_name_jianti_auto":"魏惠王","people_xingming":"魏罃","start_index":0,"tongjian_id":"8c3297d4-db0e-11ef-94d2-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_death_year":-360,"link_td_description":"公叔痤，中国战国时期魏国的相国。又作公孙痤或公叔座，历仕魏武侯、魏惠王。","link_td_id":"Q10003024","link_td_number_id":1628877,"people_name":"公叔","people_name_jianti_auto":"公叔","people_xingming":"公叔痤","start_index":36,"tongjian_id":"8c3297d9-db0e-11ef-a1f7-a0d3651f611f","wl_zhushi":"[公叔痤]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河西","place_name_jianti_auto":"河西","resolved_place_entity_id":214,"start_index":8,"tongjian_id":"8c3297d5-db0e-11ef-bdec-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":13,"tongjian_id":"8c3297d6-db0e-11ef-af2e-a0d3651f611f"},{"place_name":"安邑","place_name_jianti_auto":"安邑","place_note":"山西夏縣","resolved_place_entity_id":1233,"start_index":19,"tongjian_id":"8c3297d7-db0e-11ef-af16-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","place_note":"河南開封","resolved_place_entity_id":236,"start_index":24,"tongjian_id":"8c3297d8-db0e-11ef-b709-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"河西之战（后期）","tongjian_id":"war_N0507"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/战国自取亡","excerpts":[{"context_after":"，数世不振，讫于殄国。闵王承威、宣之后，山东之建国莫强焉...","context_before":"...，志吞邯郸，挫败于齐，军覆子死，卒之为秦所困，国日以蹙，","source_end_index":188,"source_paragraph_tongjian_id":"1509ccdd-dd12-435e-a66e-d1a5b3e173e1","source_start_index":174,"source_text":"失河西七百里，去安邑而都大梁"}],"path":"随笔/卷十/战国自取亡","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"，伐赵取晋阳，伐楚取鄢、郢矣。覆三国之军，兼二周之地，举...","context_before":"...晋阳者，赵之柱国也；鄢、郢者，楚之柱国也。三国与秦壤界，","source_end_index":264,"source_paragraph_tongjian_id":"1ce54d3a-f726-5dd3-9c48-497593cd268b","source_start_index":258,"source_text":"秦伐魏取安邑"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、宋下辽金元附（卷八）","excerpts":[{"context_after":"，楚自渚宫徙于寿春而不振，刘嗣自咸阳徙于上邽而不振，赫连...","context_before":"...氏曰：避寇而徙都，未有能复振者。周自丰镐徙于东洛而不振，","source_end_index":1432,"source_paragraph_tongjian_id":"f21b65ed-b257-53e4-ba71-e07ccfd2e60b","source_start_index":1421,"source_text":"魏自安邑徙于大梁而不振"}],"path":"历代州域形势纪要/八、宋下辽金元附（卷八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"秦惠文君时，魏以河西之地，尽入于秦，而魏益弱。秦昭襄二十...","context_before":"...安邑；而韩之强，则以上党；赵之强，则以晋阳及云中、九原。","source_end_index":672,"source_paragraph_tongjian_id":"72077296-9784-5719-b078-2e0a63e7f383","source_start_index":656,"source_text":"自魏去安邑，都大梁，而魏始弱矣。"}],"path":"山西方舆纪要/序","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"","context_before":"...《国赋考》：解盐岁额凡四十二万引，都转盐运使驻于河东]。","source_end_index":94,"source_paragraph_tongjian_id":"47ac651c-9da9-526f-8dac-c2e47cea3dc9","source_start_index":57,"source_text":"《战国策》：秦有安邑，则韩必无上党、三晋之祸，盖始于失河外，而成于亡安邑。"},{"context_after":"《秦纪》：昭襄二十一年，左史错攻魏，魏献安邑。始置河东郡...","context_before":"...，安邑不知。《史记》：秦孝公八年，卫鞅将兵围安邑，降之。","source_end_index":129,"source_paragraph_tongjian_id":"258d4a16-83a4-50ca-a2e2-30d841e3e9ff","source_start_index":98,"source_text":"《魏世家》：惠王三十一年，秦地东至河，安邑近秦，于是徙都大梁。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"。秦属三川郡。汉置陈留郡。晋为陈留国[其后没于群胡，石虎...","context_before":"《禹贡》豫州之域。春秋时为郑地。","source_end_index":37,"source_paragraph_tongjian_id":"8d5b4c5d-6cbb-57e3-8702-d05850da2722","source_start_index":16,"source_text":"战国时为魏都[魏惠王自安邑徙都大梁，即此]"},{"context_after":"秦昭王三十二年，穰侯攻魏，至大梁。始皇三十二年，王贲攻魏...","context_before":"○浚仪废县[在今城西北。汉县治此。","source_end_index":29,"source_paragraph_tongjian_id":"f6c61206-cb80-544b-9473-a8a5a0051f72","source_start_index":17,"source_text":"故曰大梁，魏惠王始都此。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"《秦纪》：穆公时，常得河西地，而晋复取之。故孝公元年下令...","context_before":"...秦孝公用商鞅，取河西地。其尽得河西，则犀首张仪之力也]。","source_end_index":545,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":458,"source_text":"《吕氏春秋》：吴起去西河而泣曰：君诚知我，而使我毕能，秦必可亡，而西河可以王。今君听谗人之议，而不知我，西河之为秦也不久矣。吴起果去魏入荆，而西河毕入秦，魏日以削，秦日益大。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"魏惠王恐，使使獻河西之地於秦以和。因去安邑，徙都大梁。乃歎曰：「吾恨不用公叔之言！」","content_fanyi":"魏惠王很害怕，派使臣把河西之地献给秦国求和。于是离开安邑，把都城迁到大梁。他感叹说：“我真后悔没有采纳公叔痤杀掉公孙鞅的建议！”","content_jianti_auto":"魏惠王恐，使使献河西之地于秦以和。因去安邑，徙都大梁。乃叹曰：「吾恨不用公叔之言！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":168,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c3297c6-db0e-11ef-8a4f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c3297dc-db0e-11ef-9d3b-a0d3651f611f"},{"people_name":"商君","people_name_jianti_auto":"商君","start_index":9,"tongjian_id":"8c3297dd-db0e-11ef-816a-a0d3651f611f"},{"people_name":"裴駰","people_name_jianti_auto":"裴骃","start_index":13,"tongjian_id":"8c3297de-db0e-11ef-bd80-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":117,"tongjian_id":"8c3297df-db0e-11ef-8e6c-a0d3651f611f"},{"people_name":"卨","people_name_jianti_auto":"卨","start_index":149,"tongjian_id":"8c3297e0-db0e-11