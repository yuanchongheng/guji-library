{"data":{"current_mention_tongjian_id":"8c2df14c-db0e-11ef-80ad-a0d3651f611f","current_paragraph_tongjian_id":"8c2df143-db0e-11ef-a12e-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃","people_name_jianti_auto":"黄","start_index":0,"tongjian_id":"8c2df145-db0e-11ef-bf6f-a0d3651f611f"},{"people_name":"老","people_name_jianti_auto":"老","start_index":2,"tongjian_id":"8c2df146-db0e-11ef-b758-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":4,"tongjian_id":"8c2df147-db0e-11ef-a663-a0d3651f611f"},{"people_name":"老子","people_name_jianti_auto":"老子","start_index":7,"tongjian_id":"8c2df148-db0e-11ef-96fe-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"黃、老，黃帝、老子之書。","note_content_jianti_auto":"黄、老，黄帝、老子之书。","note_type":"hu_note","start_index":24,"tongjian_id":"8c2df144-db0e-11ef-ac5f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期诸侯国的最高行政长官，负责辅佐君主处理政务。在《资治通鉴》此段中，申不害被韩昭侯任命为相，表明他成为韩国的核心官员，负责内政外交，如原文所述“内修政敎，外應諸侯”。","official_rank":"未知","source_snippet":"昭侯用爲相","start_index":24,"tongjian_id":"36774516-a98a-4c37-a2db-cec4b000e7da"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"老子","start_index":14,"tongjian_id":"8c2df14c-db0e-11ef-80ad-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"申不害者，鄭之賤臣也，學黃、老、刑名，以干昭侯。昭侯用爲相，內修政敎，外應諸侯，十五年，終申子之身，國治兵強。","content_fanyi":"申不害原是郑国的一介低级官吏，修习黄帝、老子和法家刑名之学，前去游说韩昭侯求取官职。韩昭侯任命他为国相，对内整饬政治教化，对外结交诸侯。申不害任相十五年间，直到去世，韩国政治清明，军队强大。","content_jianti_auto":"申不害者，郑之贱臣也，学黄、老、刑名，以干昭侯。昭侯用为相，内修政教，外应诸侯，十五年，终申子之身，国治兵强。","dtjl_paragraph_links":[],"dtjl_references":[],"id":150,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c2df143-db0e-11ef-a12e-a0d3651f611f","year_int":-351},"tongjian_id":"8c2df143-db0e-11ef-a12e-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"8f56b2b9-db0e-11ef-bf0f-a0d3651f611f"},{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","start_index":1,"tongjian_id":"8f56b2ba-db0e-11ef-ae0d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢長樂宮在東，太后居之，故謂之東宮，亦謂之東朝。","note_content_jianti_auto":"汉长乐宫在东，太后居之，故谓之东宫，亦谓之东朝。","note_type":"hu_note","start_index":26,"tongjian_id":"8f56b2b8-db0e-11ef-bf96-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":10,"source_start_index":0,"source_text":"事見十五卷文帝十六年","target_paragraph_tongjian_id":"8f08125d-db0e-11ef-9df1-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":5,"tongjian_id":"8f56b2bc-db0e-11ef-b727-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見十五卷文帝十六年。復，扶又翻。","note_content_jianti_auto":"事见十五卷文帝十六年。复，扶又翻。","note_type":"hu_note","start_index":44,"tongjian_id":"8f56b2bb-db0e-11ef-b374-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处指窦婴被免职，反映了窦太后对儒术支持者的打压。","official_rank":"正一品","source_snippet":"丞相嬰","start_index":88,"tongjian_id":"1e36a632-2e9f-4e01-93ab-e8444b18b02b"},{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代最高军事长官，掌管全国军事，此处指田蚡被免职，同样体现了窦太后对儒术反对者的清洗。","official_rank":"正一品","source_snippet":"太尉蚡","start_index":91,"tongjian_id":"703e160c-0de3-48bc-be8b-71a411145f20"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"李耳","start_index":9,"tongjian_id":"8f56b2c0-db0e-11ef-8245-a0d3651f611f","wl_zhushi":"[李耳著《老子》]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉母后","excerpts":[{"context_after":"窦婴、田蚡廷辩，王太后大怒不食，曰：“我在也，而人皆藉吾...","context_before":"...都忠臣。”欲释之。后曰：“临江王独非忠臣乎？”于是斩都。","source_end_index":241,"source_paragraph_tongjian_id":"9be3ffd2-3469-42c6-8678-33be0f520187","source_start_index":189,"source_text":"武帝用王臧、赵绾，太皇窦太后不悦儒术，绾请毋奏事东宫，后大怒，求得二人奸利事以责上，上下绾、臧吏，杀之。"}],"path":"随笔/卷二/汉母后","source_name":"容斋随笔"},{"display_title":"容斋随笔/灌夫任安","excerpts":[{"context_after":"。蚡后为丞相，而婴不用，无势，诸公稍自引而怠骜，唯灌夫独...","context_before":"","source_end_index":15,"source_paragraph_tongjian_id":"acfd3931-a172-4f66-bef1-80041fa66cb4","source_start_index":0,"source_text":"窦婴为丞相，田蚡为太尉，同日免"}],"path":"随笔/卷二/灌夫任安","source_name":"容斋随笔"}],"class_tags":[],"content":"2太皇竇太后好黃、老言，不悅儒術。趙綰請毋奏事東宮。竇太后大怒曰：「此欲復爲新垣平邪！」陰求得趙綰、王臧姦利事，以讓上；上因廢明堂事，諸所興爲皆廢。下綰、臧吏，皆自殺；丞相嬰、太尉蚡免，申公亦以疾免歸。","content_fanyi":"窦太皇太后喜好黄、老学说，不喜欢儒家学说。赵绾奏请说，国家政务不要再向太后奏报。窦太后勃然大怒说：“他是想当第二个新垣平吧！”她暗中搜集到赵绾、王臧贪赃枉法的事实，以此责备汉武帝用人不当；武帝因此废止了兴建明堂的事，赵绾等人主张兴办的事务也全部废止。赵绾、王臧被交付官吏处置，他们都自杀了；丞相窦婴、太尉田蚡被免职，申公也以有病为由被免职归家。","content_jianti_auto":"2太皇窦太后好黄、老言，不悦儒术。赵绾请毋奏事东宫。窦太后大怒曰：「此欲复为新垣平邪！」阴求得赵绾、王臧奸利事，以让上；上因废明堂事，诸所兴为皆废。下绾、臧吏，皆自杀；丞相婴、太尉蚡免，申公亦以疾免归。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1375,"number":2,"path":"资治通鉴 : 卷第十七 (漢紀九) / 世宗孝武皇帝上之上 / 二年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f56b2b7-db0e-11ef-8927-a0d3651f611f","year_int":-139},"tongjian_id":"8f56b2b7-db0e-11ef-8927-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf30f-db0e-11ef-9c58-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：恬，安也。","note_content_jianti_auto":"师古曰：恬，安也。","note_type":"hu_note","start_index":93,"tongjian_id":"933bf30e-db0e-11ef-b67c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"桓譚","people_name_jianti_auto":"桓谭","start_index":0,"tongjian_id":"933bf312-db0e-11ef-a3b3-a0d3651f611f"},{"people_name":"揚雄","people_name_jianti_auto":"扬雄","start_index":4,"tongjian_id":"933bf313-db0e-11ef-9cb9-a0d3651f611f"},{"people_name":"伏羲氏","people_name_jianti_auto":"伏羲氏","start_index":56,"tongjian_id":"933bf314-db0e-11ef-9958-a0d3651f611f"},{"people_name":"老子","people_name_jianti_auto":"老子","start_index":63,"tongjian_id":"933bf315-db0e-11ef-a442-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":69,"tongjian_id":"933bf316-db0e-11ef-83cc-a0d3651f611f"},{"people_name":"揚雄","people_name_jianti_auto":"扬雄","start_index":75,"tongjian_id":"933bf317-db0e-11ef-a463-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"桓譚曰：揚雄作玄書，以爲：玄者，天也，道也，言聖賢制法作事，皆引天道以爲本統，而因附屬萬類，王政、人事、法度。故伏羲氏謂之易，老子謂之道，孔子謂之元，揚雄謂之玄。玄經三篇，以紀天、地、人之道，立三體，有上、中、下，如禹貢之陳三品，三三而九，因以九九八十一，故爲八十一卦。以四爲數，數從一至四，重累變易，竟八十一而徧，不可增損，以三十五蓍揲之。玄經五千餘言，而傳十二篇。","note_content_jianti_auto":"桓谭曰：扬雄作玄书，以为：玄者，天也，道也，言圣贤制法作事，皆引天道以为本统，而因附属万类，王政、人事、法度。故伏羲氏谓之易，老子谓之道，孔子谓之元，扬雄谓之玄。玄经三篇，以纪天、地、人之道，立三体，有上、中、下，如禹贡之陈三品，三三而九，因以九九八十一，故为八十一卦。以四为数，数从一至四，重累变易，竟八十一而徧，不可增损，以三十五蓍揲之。玄经五千余言，而传十二篇。","note_type":"hu_note","start_index":122,"tongjian_id":"933bf311-db0e-11ef-82ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf31e-db0e-11ef-98c9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：舛，相背。","note_content_jianti_auto":"师古曰：舛，相背。","note_type":"hu_note","start_index":133,"tongjian_id":"933bf31d-db0e-11ef-92c3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf320-db0e-11ef-b3f2-a0d3651f611f"},{"people_name":"周","people_name_jianti_auto":"周","start_index":43,"tongjian_id":"933bf321-db0e-11ef-b8a0-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":45,"tongjian_id":"933bf322-db0e-11ef-a9eb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：大抵，大歸也。詆，訾毀也。迂，遠也。析，分也。詭，異也。言諸子之書，大歸皆非毀周、孔之敎，爲巧辯異辭以撓亂時政也。訾，音紫。迂，音于。撓，音火高翻。","note_content_jianti_auto":"师古曰：大抵，大归也。诋，訾毁也。迂，远也。析，分也。诡，异也。言诸子之书，大归皆非毁周、孔之教，为巧辩异辞以挠乱时政也。訾，音紫。迂，音于。挠，音火高翻。","note_type":"hu_note","start_index":154,"tongjian_id":"933bf31f-db0e-11ef-9ff2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf324-db0e-11ef-b09d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：忽，謂輕也。","note_content_jianti_auto":"师古曰：忽，谓轻也。","note_type":"hu_note","start_index":215,"tongjian_id":"933bf323-db0e-11ef-a38a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf326-db0e-11ef-b0a2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：無比類。","note_content_jianti_auto":"师古曰：无比类。","note_type":"hu_note","start_index":232,"tongjian_id":"933bf325-db0e-11ef-9dbc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"933bf328-db0e-11ef-b4e0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"服虔曰：芭，音葩。","note_content_jianti_auto":"服虔曰：芭，音葩。","note_type":"hu_note","start_index":240,"tongjian_id":"933bf327-db0e-11ef-8032-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"揚雄","people_name_jianti_auto":"扬雄","start_index":0,"tongjian_id":"933bf32a-db0e-11ef-bea3-a0d3651f611f"},{"people_name":"子雲","people_name_jianti_auto":"子云","start_index":3,"tongjian_id":"933bf32b-db0e-11ef-8b41-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"揚雄字子雲。","note_content_jianti_auto":"扬雄字子云。","note_type":"hu_note","start_index":314,"tongjian_id":"933bf329-db0e-11ef-b73f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf32d-db0e-11ef-a105-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：謂道德經也。","note_content_jianti_auto":"师古曰：谓道德经也。","note_type":"hu_note","start_index":330,"tongjian_id":"933bf32c-db0e-11ef-9484-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"933bf331-db0e-11ef-8cf6-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":13,"tongjian_id":"933bf332-db0e-11ef-af01-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":16,"tongjian_id":"933bf333-db0e-11ef-92e7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：詭，違也。聖人，謂周公、孔子。","note_content_jianti_auto":"师古曰：诡，违也。圣人，谓周公、孔子。","note_type":"hu_note","start_index":385,"tongjian_id":"933bf330-db0e-11ef-8636-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"郞","official_note":"郞是汉代宫廷中的低级官员，负责侍卫、顾问等职，此处表示扬雄在成帝时期担任此职。","official_rank":"未知","source_snippet":"雄爲郞","start_index":15,"tongjian_id":"42361ae6-34d8-488e-884f-b2fdbba2ca67"},{"confidence":0.85,"official_category":"中枢近臣","official_name":"給事黃門","official_note":"給事黃門是汉代官职，指在黄门（宫廷门户）任职的官员，负责传达诏令、侍从皇帝等，此处表示扬雄的职务。","official_rank":"未知","source_snippet":"給事黃門","start_index":18,"tongjian_id":"336dab16-a784-4314-a36f-65c256d4e410"},{"confidence":0.95,"official_category":"中枢机构","official_name":"三公","official_note":"三公是汉代最高行政长官，通常指太尉、司徒、司空，此处指王莽和董贤担任此高位，权倾朝野。","official_rank":"正一品","source_snippet":"莽、賢爲三公","start_index":40,"tongjian_id":"7a799aac-ff1d-4beb-84ea-8a86b4c7c151"},{"confidence":0.8,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是汉代高级官员的泛称，常指议政或顾问之职，此处表示扬雄在王莽篡位后转任此职。","official_rank":"未知","source_snippet":"轉爲大夫","start_index":67,"tongjian_id":"eaea4482-066c-40ad-bf0b-184e14a106cb"},{"confidence":0.95,"official_category":"中枢机构","official_name":"大司空","official_note":"大司空是汉代三公之一，主管监察和工程事务，此处指王邑担任此职，与纳言严尤对话。","official_rank":"正一品","source_snippet":"大司空王邑","start_index":294,"tongjian_id":"63781121-2188-4202-8b46-7f5bb82d1de0"},{"confidence":0.85,"official_category":"中枢机构","official_name":"納言","official_note":"納言是汉代官职，负责传达皇帝命令和进谏，此处指严尤担任此职，与大司空王邑对话。","official_rank":"未知","source_snippet":"納言嚴尤","start_index":299,"tongjian_id":"2a1f6fe2-d4b3-4f0f-a0e0-be32670ec110"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老耼","people_name_jianti_auto":"老耼","people_xingming":"李耳","start_index":320,"tongjian_id":"933bf350-db0e-11ef-916b-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"933bf30d-db0e-11ef-aa12-a0d3651f611f","pinyin":"zǐ","source_anchor_text":"馳大抵詆訾聖人即為","source_key":"baiyang_epub","start_index":136,"text":"訾","tongjian_id":"e68d0cec-5d48-5044-b2dd-d63e4501376c"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5是歲，揚雄卒。初，成帝之世，雄爲郞，給事黃門，與莽及劉秀並列；哀帝之初，又與董賢同官。莽、賢爲三公，權傾人主，所薦莫不拔擢，而雄三世不徙官。及莽篡位，雄以耆老久次，轉爲大夫。恬於勢利，好古樂道，欲以文章成名於後世，乃作太玄以綜天、地、人之道；又見諸子各以其智舛馳，大抵詆訾聖人，卽爲怪迂、析辯詭辭以撓世事，雖小辯，終破大道而惑衆，使溺於所聞而不自知其非也，故人時有問雄者，常用法應之，號曰法言。用心於內，不求於外，於時人皆忽之；唯劉秀及范逡敬焉，而桓譚以爲絕倫，鉅鹿侯芭師事焉。大司空王邑、納言嚴尤聞雄死，謂桓譚曰：「子常稱揚雄書，豈能傳於後世乎？」譚曰：「必傳，顧君與譚不及見也。凡人賤近而貴遠，親見揚子雲祿位容貌不能動人，故輕其書。昔老耼著虛無之言兩篇，薄仁義，非禮學，然後好之者尚以爲過於五經，自漢文、景之君及司馬遷皆有是言。今揚子之書文義至深，而論不詭於聖人，則必度越諸子矣！」","content_fanyi":"这一年，扬雄去世。起初，在汉成帝时代，扬雄担任郎官，供职于黄门，与王莽、刘秀官位并列；汉哀帝初年，他又与董贤同官。王莽、董贤位居三公，权势超过君主，凡他们所举荐的人无不得到提拔，可是扬雄历经三代皇帝却没有迁转官职。等到王莽篡位后，扬雄才凭年高、久居原职的资历，转任大夫。他把权势财利看得很淡，喜好古学、乐守圣贤之道，想用文章使自己留名后世，于是撰写《太玄》，用来综合天、地、人三方面的道理；他又看到先秦诸子各凭其学说智慧与儒家背道而驰，大多诋毁圣人，造作怪诞迂曲、巧辩诡诈的言辞来扰乱世事，这些虽然只是小辩，终究会破坏大道、迷惑众人，使人们沉溺于所听之说而不自知其错误，所以当时常有人向扬雄请教，他便用合乎法度的言论回答，汇集称为《法言》。他致力于内心修养，不向外炫耀，当时人都轻忽他；只有刘秀和范逡尊敬他，而桓谭认为他的书当世无双，巨鹿人侯芭拜扬雄为师。大司空王邑、纳言严尤听说扬雄去世，对桓谭说：“您常称赞扬雄的著作，难道它能在后世流传吗？”桓谭说：“必定能流传，只是您和我都来不及看见了。一般人总是轻视近处而看重远处，亲眼看到扬子云的俸禄、官位和容貌都平常无奇，不能打动人，因此轻视他的著作。从前老聃写作虚无之说两篇，鄙薄仁义，非议礼学，可是后来喜好它的人还认为它超过《五经》，从汉文帝、汉景帝到司马迁都有这种说法。如今扬子之书的文义极为深邃，而议论又不违背圣人之道，那么必定会超越诸子了！”","content_jianti_auto":"5是岁，扬雄卒。初，成帝之世，雄为郞，给事黄门，与莽及刘秀并列；哀帝之初，又与董贤同官。莽、贤为三公，权倾人主，所荐莫不拔擢，而雄三世不徙官。及莽篡位，雄以耆老久次，转为大夫。恬于势利，好古乐道，欲以文章成名于后世，乃作太玄以综天、地、人之道；又见诸子各以其智舛驰，大抵诋訾圣人，即为怪迂、析辩诡辞以挠世事，虽小辩，终破大道而惑众，使溺于所闻而不自知其非也，故人时有问雄者，常用法应之，号曰法言。用心于内，不求于外，于时人皆忽之；唯刘秀及范逡敬焉，而桓谭以为绝伦，巨鹿侯芭师事焉。大司空王邑、纳言严尤闻雄死，谓桓谭曰：「子常称扬雄书，岂能传于后世乎？」谭曰：「必传，顾君与谭不及见也。凡人贱近而贵远，亲见扬子云禄位容貌不能动人，故轻其书。昔老耼著虚无之言两篇，薄仁义，非礼学，然后好之者尚以为过于五经，自汉文、景之君及司马迁皆有是言。今扬子之书文义至深，而论不诡于圣人，则必度越诸子矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":2894,"number":5,"path":"资治通鉴 : 卷第三十八 (漢紀三十) / 王莽下 / 五年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"933bf30d-db0e-11ef-aa12-a0d3651f611f","year_int":18},"tongjian_id":"933bf30d-db0e-11ef-aa12-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"日過中則昃。朝，直遙翻。","note_content_jianti_auto":"日过中则昃。朝，直遥翻。","note_type":"hu_note","start_index":31,"tongjian_id":"94f33100-db0e-11ef-8c7a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94f33103-db0e-11ef-8d87-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：分，猶半也。","note_content_jianti_auto":"贤曰：分，犹半也。","note_type":"hu_note","start_index":48,"tongjian_id":"94f33102-db0e-11ef-b87e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公卿","official_note":"公卿泛指高级官员，如三公九卿，此处表示皇帝常与高官讨论治国之道，源自资治通鉴原文描述光武帝勤政。","official_rank":"未知","source_snippet":"數引公卿、郞將講論經理","start_index":38,"tongjian_id":"cc12177b-5523-4e5e-8052-fd34d9aa2cec"},{"confidence":0.85,"official_category":"军事指挥","official_name":"郞將","official_note":"郞將是汉代武官，负责宫廷侍卫或军事指挥，此处表示皇帝也引武官参与讨论，源自资治通鉴原文。","official_rank":"未知","source_snippet":"數引公卿、郞將講論經理","start_index":41,"tongjian_id":"a715a7fb-e52b-4f4c-9d43-ac97c08214fb"},{"confidence":0.95,"official_category":"皇室成员","official_name":"皇太子","official_note":"皇太子是储君，此处表示太子劝谏皇帝注意休息，源自资治通鉴原文。","official_rank":"未知","source_snippet":"皇太子見帝勤勞不怠","start_index":58,"tongjian_id":"2dfc7e69-1163-490c-a7ad-5bb50f1101be"},{"confidence":0.8,"official_category":"军事指挥","official_name":"功臣","official_note":"功臣指有功的将领或官员，此处表示光武帝在天下平定后减少对功臣的依赖，源自资治通鉴原文。","official_rank":"未知","source_snippet":"乃退功臣而進文吏","start_index":114,"tongjian_id":"005c2c40-26d5-499c-a229-e9b10b5eaaca"},{"confidence":0.8,"official_category":"文教","official_name":"文吏","official_note":"文吏指文职官员，此处表示光武帝转向任用文官治理国家，源自资治通鉴原文。","official_rank":"未知","source_snippet":"乃退功臣而進文吏","start_index":118,"tongjian_id":"bf993804-44a2-4d05-97ed-045e47ff6de9"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"李耳","start_index":77,"tongjian_id":"94f3310b-db0e-11ef-908c-a0d3651f611f","wl_zhushi":"[李耳]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2二月，戊戌，帝崩於南宮前殿，年六十二。帝每旦視朝，日昃乃罷，數引公卿、郞將講論經理，夜分乃寐。皇太子見帝勤勞不怠，承間諫曰：「陛下有禹、湯之明，而失黃、老養性之福，願頤愛精神，優游自寧。」帝曰：「我自樂此，不爲疲也！」雖以征伐濟大業，及天下旣定，乃退功臣而進文吏，明愼政體，總攬權綱，量時度力，舉無過事，故能恢復前烈，身致太平。","content_fanyi":"二月初五日戊戌，光武帝在南宫前殿去世，终年六十二岁。光武帝每天早晨上朝处理政事，直到黄昏才停止，经常召见公卿、郎将讲论经学义理，到半夜才就寝。皇太子刘庄见光武帝勤勉劳苦而不懈怠，趁机劝谏说：“陛下有夏禹、商汤那样的英明，却缺少黄帝、老子那样修养身心而得长寿的福分，但愿能保养爱惜精神，悠闲宁静。”光武帝说：“我自己喜欢这样做事，并不为此感到疲劳！”光武帝虽然依靠征伐成就大业，但等到天下平定之后，就让功臣隐退，提拔文吏，明察政体，谨慎处理政务，总揽大权，观察时势，估量自己的力量，不做力所不及的事，因此能够恢复前代的伟大功业，在有生之年亲身实现天下太平。","content_jianti_auto":"2二月，戊戌，帝崩于南宫前殿，年六十二。帝每旦视朝，日昃乃罢，数引公卿、郞将讲论经理，夜分乃寐。皇太子见帝勤劳不怠，承间谏曰：「陛下有禹、汤之明，而失黄、老养性之福，愿颐爱精神，优游自宁。」帝曰：「我自乐此，不为疲也！」虽以征伐济大业，及天下既定，乃退功臣而进文吏，明愼政体，总揽权纲，量时度力，举无过事，故能恢复前烈，身致太平。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，曾未期年，而雍容于冠冕笙磬之下，不已急乎！躬与荣凭几受...","context_before":"...曰：“敬老为其近于父也。”以近父故敬，则敬老以父而推尔。","source_end_index":494,"source_paragraph_tongjian_id":"f91168f2-a6db-4657-b889-a48e1ede3d29","source_start_index":491,"source_text":"光武崩"}],"title":"二 光武崩未期年明帝即修礼乐毋乃过急过泰"}],"id":3504,"number":2,"path":"资治通鉴 : 卷第四十四 (漢紀三十六) / 世祖光武皇帝下 / 二年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"94f330ff-db0e-11ef-8019-a0d3651f611f","year_int":57,"zhang_TJZJ_id":"zttjzj_000686"},"tongjian_id":"94f330ff-db0e-11ef-8019-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"漢成帝","people_name_jianti_auto":"汉成帝","start_index":0,"tongjian_id":"950c8e91-db0e-11ef-bdb4-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":31,"tongjian_id":"950c8e92-db0e-11ef-845a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢成帝王國省內史，令相治民，職如太守，秩二千石。紈，今之絹也。師古曰：紈，素也；縑，幷絲絹也。相，息亮翻。","note_content_jianti_auto":"汉成帝王国省内史，令相治民，职如太守，秩二千石。纨，今之绢也。师古曰：纨，素也；缣，幷丝绢也。相，息亮翻。","note_type":"hu_note","start_index":41,"tongjian_id":"950c8e90-db0e-11ef-a7ff-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"國相","official_note":"國相是漢代諸侯國的行政長官，負責輔佐諸侯王管理封國事務，此處楚王英向國相報告贖罪事宜，顯示國相在地方行政中的監管角色。","official_rank":"未知","source_snippet":"楚王英奉黃縑、白紈詣國相曰","start_index":32,"tongjian_id":"f43f530b-1e3a-4aba-82aa-ab4b40c11abb"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"李耳","start_index":83,"tongjian_id":"950c8e9a-db0e-11ef-9d94-a0d3651f611f","wl_zhushi":"[李耳]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6丙子，募死罪繫囚詣度遼營；有罪亡命者，令贖罪各有差。楚王英奉黃縑、白紈詣國相曰：「託在藩輔，過惡累積，歡喜大恩，奉送縑帛，以贖愆罪。」國相以聞，詔報曰：「楚王誦黃、老之微言，尚浮屠之仁慈，潔齊三月，與神爲誓，何嫌何疑，當有悔吝！其還贖，以助伊蒲塞、桑門之盛饌。」","content_fanyi":"十月初四日丙子，朝廷招募关押在牢中的死刑犯前往度辽营；有罪而逃亡的人，按照罪情轻重定出不同等级，让他们从军赎罪。楚王刘英拿着黄色细绢和白色薄绸，来见楚国国相，说：“我身在藩国辅佐之列，过失和罪恶积累很多，幸蒙天子大恩，特此奉上缣帛，用来赎回罪过。”楚国国相把这件事奏报汉明帝，汉明帝下诏回答说：“楚王诵读黄帝、老子精微的言论，崇尚佛陀的仁慈，斋戒沐浴三个月，与神明立下誓言，哪有什么嫌疑和疑忌，该当悔恨呢！退还他送来的赎罪之物，用来资助在家修行的伊蒲塞和出家的桑门置办丰盛饭食。”","content_jianti_auto":"6丙子，募死罪系囚诣度辽营；有罪亡命者，令赎罪各有差。楚王英奉黄缣、白纨诣国相曰：「托在藩辅，过恶累积，欢喜大恩，奉送缣帛，以赎愆罪。」国相以闻，诏报曰：「楚王诵黄、老之微言，尚浮屠之仁慈，洁齐三月，与神为誓，何嫌何疑，当有悔吝！其还赎，以助伊蒲塞、桑门之盛馔。」","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"；笮融课民盛饰以事浮屠，而以劫掠死于锋刃；梁武帝舍身事浮...","context_before":"","source_end_index":13,"source_paragraph_tongjian_id":"70b3d447-98e1-4117-9031-029b4f31086e","source_start_index":0,"source_text":"楚王英始事浮屠，而以反自杀"}],"title":"五 事浮屠致祸"}],"id":3570,"number":6,"path":"资治通鉴 : 卷第四十五 (漢紀三十七) / 顯宗孝明皇帝下 / 八年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"950c8e8f-db0e-11ef-b1ee-a0d3651f611f","year_int":65},"tongjian_id":"950c8e8f-db0e-11ef-b1ee-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97248c83-db0e-11ef-820d-a0d3651f611f"},{"people_name":"老子","people_name_jianti_auto":"老子","start_index":7,"tongjian_id":"97248c84-db0e-11ef-9317-a0d3651f611f"},{"people_name":"耳","people_name_jianti_auto":"耳","start_index":23,"tongjian_id":"97248c85-db0e-11ef-83ff-a0d3651f611f"},{"people_name":"耼","people_name_jianti_auto":"耼","start_index":26,"tongjian_id":"97248c86-db0e-11ef-95ee-a0d3651f611f"},{"people_name":"李","people_name_jianti_auto":"李","start_index":29,"tongjian_id":"97248c87-db0e-11ef-a7b0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":11,"tongjian_id":"97248c88-db0e-11ef-84bd-a0d3651f611f"},{"place_name":"苦縣","place_name_jianti_auto":"苦县","start_index":12,"tongjian_id":"97248c89-db0e-11ef-bca0-a0d3651f611f"},{"place_name":"厲鄕","place_name_jianti_auto":"厉鄕","start_index":14,"tongjian_id":"97248c8a-db0e-11ef-ac59-a0d3651f611f"},{"place_name":"曲仁里","place_name_jianti_auto":"曲仁里","start_index":16,"tongjian_id":"97248c8b-db0e-11ef-8719-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":32,"tongjian_id":"97248c8c-db0e-11ef-ba31-a0d3651f611f"},{"place_name":"苦縣","place_name_jianti_auto":"苦县","start_index":46,"tongjian_id":"97248c8d-db0e-11ef-85f1-a0d3651f611f"},{"place_name":"陳國","place_name_jianti_auto":"陈国","start_index":50,"tongjian_id":"97248c8e-db0e-11ef-9d47-a0d3651f611f"},{"place_name":"亳州","place_name_jianti_auto":"亳州","start_index":57,"tongjian_id":"97248c8f-db0e-11ef-a611-a0d3651f611f"},{"place_name":"谷陽縣","place_name_jianti_auto":"谷阳县","start_index":59,"tongjian_id":"97248c90-db0e-11ef-af85-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：史記曰：老子者，楚苦縣厲鄕曲仁里人也，名耳，字耼，姓李，爲周守藏吏。有神廟，故就祠之。苦縣，屬陳國，故城在今亳州谷陽縣。苦，音戶，又如字。","note_content_jianti_auto":"贤曰：史记曰：老子者，楚苦县厉鄕曲仁里人也，名耳，字耼，姓李，为周守藏吏。有神庙，故就祠之。苦县，属陈国，故城在今亳州谷阳县。苦，音户，又如字。","note_type":"hu_note","start_index":20,"tongjian_id":"97248c82-db0e-11ef-aaec-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢近臣","official_name":"中常侍","official_note":"中常侍是东汉时期的宦官官职，负责侍从皇帝、传达诏令，常参与宫廷事务。在《资治通鉴》此段中，皇帝派遣中常侍左悺前往苦县祭祀老子，体现了中常侍作为皇帝亲信执行重要使命的角色。","official_rank":"未知","source_snippet":"帝遣中常侍左悺之苦縣祠老子","start_index":6,"tongjian_id":"0c5f555a-7102-4b01-8eae-37f9a7d0aa60"}],"ExtRef_Children_people":[{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老子","people_name_jianti_auto":"老子","people_xingming":"李耳","start_index":17,"tongjian_id":"97248c93-db0e-11ef-96dd-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97248c81-db0e-11ef-9f61-a0d3651f611f","pinyin":"guàn","source_anchor_text":"中常侍左悺之苦縣祠","source_key":"baiyang_epub","start_index":12,"text":"悺","tongjian_id":"bfb88c80-706d-53a3-a3fb-c232b362