{"data":{"current_mention_tongjian_id":"8bedcb20-db0e-11ef-a3ab-a0d3651f611f","current_paragraph_tongjian_id":"8bedcafb-db0e-11ef-8771-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"汾陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"太原","place_name_jianti_auto":"太原","start_index":4,"tongjian_id":"af0ce589-db0e-11ef-aea3-a0d3651f611f"},{"place_name":"汾陽縣","place_name_jianti_auto":"汾阳县","start_index":6,"tongjian_id":"af0ce58a-db0e-11ef-8bdd-a0d3651f611f"},{"place_name":"燕京山","place_name_jianti_auto":"燕京山","start_index":10,"tongjian_id":"af0ce58b-db0e-11ef-8691-a0d3651f611f"},{"place_name":"天池","place_name_jianti_auto":"天池","place_note":"祁连池•山西宁武县南管涔山上","start_index":28,"tongjian_id":"af0ce58c-db0e-11ef-98f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"水經註：太原汾陽縣北燕京山上有大池，池在山原之上，世謂之天池，方里餘，其水澄渟鏡淨而不流。","note_content_jianti_auto":"水经注：太原汾阳县北燕京山上有大池，池在山原之上，世谓之天池，方里余，其水澄渟镜净而不流。","note_type":"hu_note","start_index":14,"tongjian_id":"af0ce588-db0e-11ef-9c23-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"歡","people_name_jianti_auto":"欢","start_index":0,"tongjian_id":"af0ce58f-db0e-11ef-a0e4-a0d3651f611f"},{"people_name":"賀六渾","people_name_jianti_auto":"贺六浑","start_index":2,"tongjian_id":"af0ce590-db0e-11ef-996a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歡字賀六渾，故云然。","note_content_jianti_auto":"欢字贺六浑，故云然。","note_type":"hu_note","start_index":52,"tongjian_id":"af0ce58e-db