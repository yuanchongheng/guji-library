f-b05a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陽固事魏孝文帝，嘗從劉昶南伐。","note_content_jianti_auto":"阳固事魏孝文帝，尝从刘昶南伐。","note_type":"hu_note","start_index":127,"tongjian_id":"af0ce59b-db0e-11ef-af65-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高歡","people_name_jianti_auto":"高欢","start_index":0,"tongjian_id":"af0ce5a0-db0e-11ef-86c6-a0d3651f611f"},{"people_name":"曹操","people_name_jianti_auto":"曹操","start_index":7,"tongjian_id":"af0ce5a1-db0e-11ef-b018-a0d3651f611f"},{"people_name":"周文王","people_name_jianti_auto":"周文王","start_index":13,"tongjian_id":"af0ce5a2-db0e-11ef-bd2d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":22,"tongjian_id":"af0ce5a3-db0e-11ef-8c06-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高歡之志，蓋如曹操所謂吾爲周文王者，非眞無移魏鼎之心也。間，古莧翻。","note_content_jianti_auto":"高欢之志，盖如曹操所谓吾为周文王者，非真无移魏鼎之心也。间，古苋翻。","note_type":"hu_note","start_index":148,"tongjian_id":"af0ce59f-db0e-11ef-834a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陽","place_name_jianti_auto":"汾阳","resolved_place_entity_id":4854,"start_index":8,"tongjian_id":"af0e6c41-db0e-11ef-bd2a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、太原府（卷四十）","excerpts":[{"context_after":"。高洋天保九年，自邺如晋阳，至祁连。高演皇建初，自将伐厙...","context_before":"...源也。北人谓天为祁连，亦谓之祁连泊。元魏孝文屡游畋于此，","source_end_index":64,"source_paragraph_tongjian_id":"c42f4c6c-c556-5b63-9ae1-a6a673e94489","source_start_index":58,"source_text":"高欢亦尝游焉"}],"path":"山西方舆纪要/一、太原府（卷四十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"10東魏丞相歡遊汾陽之天池，得奇石，隱起成文曰「六王三川」。以問行臺郞中陽休之，對曰：「六者，大王之字；王者，當王天下。河、洛、伊爲三川，涇、渭、洛亦爲三川。大王若受天命，終應奄有關、洛。」歡曰：「世人無事常言我反，況聞此乎！愼勿妄言！」休之，固之子也。行臺郞中中山杜弼間勸歡受禪，歡舉杖擊走之。","content_fanyi":"东魏丞相高欢在汾阳的天池游玩，得到一块奇石，石上隐隐隆起，形成文字，写着“六王三川”。高欢拿此事询问行台郎中阳休之，阳休之回答说：“‘六’，是大王您的表字；‘王’，是应当称王于天下。黄河、洛水、伊水是三川，泾水、渭水、洛水也是三川。大王如果承受天命，终究会全部拥有关、洛的大片土地。”高欢说：“世人没有事还常常说我谋反，何况听到这样的话呢！千万不要乱说！”阳休之是阳固的儿子。行台郎中中山人杜弼乘机劝高欢接受禅让，高欢举起木杖把他打跑了。","content_jianti_auto":"10东魏丞相欢游汾阳之天池，得奇石，隐起成文曰「六王三川」。以问行台郞中阳休之，对曰：「六者，大王之字；王者，当王天下。河、洛、伊为三川，泾、渭、洛亦为三川。大王若受天命，终应奄有关、洛。」欢曰：「世人无事常言我反，况闻此乎！愼勿妄言！」休之，固之子也。行台郞中中山杜弼间劝欢受禅，欢举杖击走之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14813,"number":10,"path":"资治通鉴 : 卷第一百五十七 (梁紀十三) / 高祖武皇帝十三 / 三年 / 第 12 段","reading_annotation_sources":[],"start_index":11,"tongjian_id":"af0ce587-db0e-11ef-b316-a0d3651f611f","year_int":537},"tongjian_id":"af0ce587-db0e-11ef-b316-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"薛大鼎","people_name_jianti_auto":"薛大鼎","start_index":5,"tongjian_id":"b60db51c-db0e-11ef-a29d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蒲州","place_name_jianti_auto":"蒲州","start_index":9,"tongjian_id":"b60db51d-db0e-11ef-9cc9-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":11,"tongjian_id":"b60db51e-db0e-11ef-b07d-a0d3651f611f"},{"place_name":"汾陽縣","place_name_jianti_auto":"汾阳县","start_index":22,"tongjian_id":"b60db51f-db0e-11ef-b147-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按新唐書，薛大鼎，蒲州汾陰人。隋、唐志亦皆無汾陽縣，「陽」當作「陰」。說，式芮翻。","note_content_jianti_auto":"按新唐书，薛大鼎，蒲州汾阴人。隋、唐志亦皆无汾阳县，「阳」当作「阴」。说，式芮翻。","note_type":"hu_note","start_index":8,"tongjian_id":"b60db51b-db0e-11ef-a72d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"煬帝","people_name_jianti_auto":"炀帝","start_index":18,"tongjian_id":"b60db524-db0e-11ef-b03a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":12,"tongjian_id":"b60db525-db0e-11ef-9f76-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"察非掾，言使之察姦非，若漢刺姦掾也。煬帝時左、右候衞府增置察非掾。諸將，卽亮翻。掾，俞絹翻。","note_content_jianti_auto":"察非掾，言使之察奸非，若汉刺奸掾也。炀帝时左、右候衞府增置察非掾。诸将，即亮翻。掾，俞绢翻。","note_type":"hu_note","start_index":66,"tongjian_id":"b60db523-db0e-11ef-be2c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陽","place_name_jianti_auto":"汾阳","resolved_place_entity_id":4855,"start_index":0,"tongjian_id":"b60db528-db0e-11ef-abd5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷三十九）","excerpts":[{"context_after":"宋围太原，壅汾、晋二水灌之。《汉志》注：汾水经郡二[太原...","context_before":"...汾州。又周、齐相攻，争汾北之地，周主邕围晋州，军于汾曲。","source_end_index":339,"source_paragraph_tongjian_id":"387423fe-3490-5e3e-b7c8-c2ec46372d69","source_start_index":329,"source_text":"唐取关中，自汾而西。"}],"path":"山西方舆纪要/〇、封域山川险要（卷三十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"至德中，郭子仪讨安庆绪，据永丰，关陕之路始通。《志》云：...","context_before":"...李子雄劝玄感直入关中，开永丰仓以赈贫乏，三辅可指挥而定。","source_end_index":249,"source_paragraph_tongjian_id":"d10efe86-0b3a-56ec-b6b5-4c1aa1b0eaf5","source_start_index":155,"source_text":"十三年，李渊起义师，薛大鼎任瑰谓渊曰：今济河，直据永丰仓积粟，虽未得京师，关中已定。既而渊引军而西，华阴令李孝常以永丰仓降。渊使世子建成等屯于此。渊寻引兵还如蒲津，自临晋济渭，至永丰劳军。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"汾陽薛大鼎說淵：「請勿攻河東，自龍門直濟河，據永豐倉，傳檄遠近，關中可坐取也。」淵將從之。諸將請先攻河東，乃以大鼎爲大將軍府察非掾。","content_fanyi":"汾阳人薛大鼎向李渊进言：“请不要攻打河东，从龙门直接渡过黄河，占据永丰仓，向远近各地传布檄文，关中就可以轻易取得。”李渊准备听从。众将领请求先攻河东，于是任命薛大鼎为大将军府察非掾。","content_jianti_auto":"汾阳薛大鼎说渊：「请勿攻河东，自龙门直济河，据永丰仓，传檄远近，关中可坐取也。」渊将从之。诸将请先攻河东，乃以大鼎为大将军府察非掾。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17772,"path":"资治通鉴 : 卷第一百八十四 (隋紀八) / 恭皇帝下 / 義寧元年 / 第 22 段","reading_annotation_sources":[],"start_index":21,"tongjian_id":"b60db51a-db0e-11ef-ba43-a0d3651f611f","year_int":617},"tongjian_id":"b60db51a-db0e-11ef-ba43-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"汾陽"},"message":"success","success":true}