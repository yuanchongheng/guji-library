l_references":[],"class_tags":[],"content":"2春，三月，孝惠皇后張氏薨。","content_fanyi":"二年春季，三月，孝惠皇后张氏去世。","content_jianti_auto":"2春，三月，孝惠皇后张氏薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1204,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f081296-db0e-11ef-92b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"與，與歟同；下同。","note_content_jianti_auto":"与，与欤同；下同。","note_type":"hu_note","start_index":51,"tongjian_id":"8f0812a1-db0e-11ef-b5d6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0812a3-db0e-11ef-8ee0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：度，謂量計之。度，徒各翻。","note_content_jianti_auto":"师古曰：度，谓量计之。度，徒各翻。","note_type":"hu_note","start_index":115,"tongjian_id":"8f0812a2-db0e-11ef-a3af-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0812a6-db0e-11ef-b0d0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：蕃，多也，扶元翻。","note_content_jianti_auto":"师古曰：蕃，多也，扶元翻。","note_type":"hu_note","start_index":162,"tongjian_id":"8f0812a5-db0e-11ef-8738-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0812a8-db0e-11ef-86ee-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：醪，汁滓酒也。靡，散也。醪，來高翻。靡，音糜。","note_content_jianti_auto":"师古曰：醪，汁滓酒也。靡，散也。醪，来高翻。靡，音糜。","note_type":"hu_note","start_index":171,"tongjian_id":"8f0812a7-db0e-11ef-b5db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"六畜，馬、牛、羊、犬、豕、雞。畜、許救翻。","note_content_jianti_auto":"六畜，马、牛、羊、犬、豕、鸡。畜、许救翻。","note_type":"hu_note","start_index":180,"tongjian_id":"8f0812a9-db0e-11ef-8552-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0812ab-db0e-11ef-b9c2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：中，竹仲翻。","note_content_jianti_auto":"师古曰：中，竹仲翻。","note_type":"hu_note","start_index":191,"tongjian_id":"8f0812aa-db0e-11ef-880d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处皇帝下诏要求丞相参与讨论如何帮助百姓，体现了其在国家决策中的核心作用。","official_rank":"正一品","source_snippet":"其與丞相、列侯、吏二千石、博士議之","start_index":186,"tongjian_id":"86ecadcf-1469-437a-91a8-8e809aefb8e0"},{"confidence":0.85,"official_category":"爵位","official_name":"列侯","official_note":"列侯是汉代的一种爵位，通常授予功臣或贵族，此处皇帝下诏要求列侯参与讨论如何帮助百姓，反映了其在朝廷中的咨询角色。","official_rank":"未知","source_snippet":"其與丞相、列侯、吏二千石、博士議之","start_index":189,"tongjian_id":"8f5925cc-db3e-42d3-84c3-169e7c210879"},{"confidence":0.9,"official_category":"地方行政","official_name":"吏二千石","official_note":"吏二千石指汉代俸禄为二千石的官员，通常包括郡守等地方高级官员，此处皇帝下诏要求他们参与讨论如何帮助百姓，强调了地方行政在解决民生问题中的作用。","official_rank":"二千石","source_snippet":"其與丞相、列侯、吏二千石、博士議之","start_index":192,"tongjian_id":"eac21ac8-603f-4e80-b465-3d1bff3c9d96"},{"confidence":0.88,"official_category":"文教","official_name":"博士","official_note":"博士是汉代掌管经学教育和咨询的官员，此处皇帝下诏要求博士参与讨论如何帮助百姓，体现了其在政策咨询中的学术角色。","official_rank":"未知","source_snippet":"其與丞相、列侯、吏二千石、博士議之","start_index":198,"tongjian_id":"a292440f-2eb9-4f89-bac0-24d0a8dbe292"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f0812a0-db0e-11ef-b194-a0d3651f611f","pinyin":"láo","source_anchor_text":"者蕃為酒醪以靡穀者","source_key":"baiyang_epub","start_index":164,"text":"醪","tongjian_id":"1f2e606b-600e-54f4-9ad3-bf37a8498227"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3詔曰：「間者數年不登，又有水旱、疾疫之災，朕甚憂之。愚而不明，未達其咎：意者朕之政有所失而行有過與？乃天道有不順，地利或不得，人事多失和，鬼神廢不享與？何以致此？將百官之奉養或廢，無用之事或多與？何其民食之寡乏也？夫度田非益寡，而計民未加益，以口量地，其於古猶有餘；而食之甚不足者，其咎安在？無乃百姓之從事於末以害農者蕃，爲酒醪以靡穀者多，六畜之食焉者衆與？細大之義，吾未得其中，其與丞相、列侯、吏二千石、博士議之；有可以佐百姓者，率意遠思，無有所隱！」","content_fanyi":"文帝下诏说：“近来连续数年收成不好，又发生水旱、瘟疫等灾害，朕十分忧虑。朕愚昧而不明智，未能明白过失所在：莫非是朕的政务有失误、行为有过错吗？还是天道运行不顺，地利未能得到，人间诸事多不和谐，鬼神祭祀废弃不供奉呢？是什么原因造成这种局面？还是百官的俸禄供养有所废弛，无益的事务兴办太多呢？为什么百姓的粮食如此匮乏？计算田地并没有比过去少，统计人口也没有增加，按人口来衡量土地，比起古代还有富余；可是粮食却极不充足，问题出在哪里？莫非是百姓中从事工商业而妨害农业的人多，酿酒耗费粮食多，饲养的牲畜吃掉粮食多吗？这些大大小小的原因，朕未能把握其中关键，可同丞相、列侯、二千石官员、博士商议；有能够帮助百姓的办法，尽可直率深入思虑，不要有所隐瞒！”","content_jianti_auto":"3诏曰：「间者数年不登，又有水旱、疾疫之灾，朕甚忧之。愚而不明，未达其咎：意者朕之政有所失而行有过与？乃天道有不顺，地利或不得，人事多失和，鬼神废不享与？何以致此？将百官之奉养或废，无用之事或多与？何其民食之寡乏也？夫度田非益寡，而计民未加益，以口量地，其于古犹有余；而食之甚不足者，其咎安在？无乃百姓之从事于末以害农者蕃，为酒醪以靡谷者多，六畜之食焉者众与？细大之义，吾未得其中，其与丞相、列侯、吏二千石、博士议之；有可以佐百姓者，率意远思，无有所隐！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":1205,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f0812a0-db0e-11ef-b194-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000500"}],"reign_name":"後元年","reign_name_jianti_auto":"后元年","start_index":6,"tongjian_id":"8f08128a-db0e-11ef-b32a-a0d3651f611f","year_anno":"（戊寅、前一六三）","year_int":-163},"message":"success","success":true}