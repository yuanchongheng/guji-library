吐蕃尚志董星寇宁州，张献甫击却之；吐蕃转掠鄜、坊而去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23494,"number":17,"path":"资治通鉴 : 卷第二百三十三 (唐紀四十九) / 德宗神武聖文皇帝八 / 四年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"c21873dc-db0e-11ef-ad13-a0d3651f611f","year_int":788},"tongjian_id":"c21873dc-db0e-11ef-ad13-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"坊","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄜，音夫；下同。","note_content_jianti_auto":"鄜，音夫；下同。","note_type":"hu_note","start_index":22,"tongjian_id":"c91ff2a0-db0e-11ef-a185-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"坊州","place_name_jianti_auto":"坊州","start_index":4,"tongjian_id":"c91ff2a2-db0e-11ef-85c6-a0d3651f611f"},{"place_name":"鄜州","place_name_jianti_auto":"鄜州","start_index":8,"tongjian_id":"c91ff2a3-db0e-11ef-922a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：坊州北至鄜州一百一十里。","note_content_jianti_auto":"九域志：坊州北至鄜州一百一十里。","note_type":"hu_note","start_index":51,"tongjian_id":"c91ff2a1-db0e-11ef-ace4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔勍","people_name_jianti_auto":"孔勍","start_index":36,"tongjian_id":"c91ff2a6-db0e-11ef-b14b-a0d3651f611f"},{"people_name":"李暉","people_name_jianti_auto":"李晖","start_index":39,"tongjian_id":"c91ff2a7-db0e-11ef-9d37-a0d3651f611f"},{"people_name":"李周彝","people_name_jianti_auto":"李周彝","sta