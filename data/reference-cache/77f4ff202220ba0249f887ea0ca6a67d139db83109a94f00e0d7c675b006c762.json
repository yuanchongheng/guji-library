dex":94,"tongjian_id":"cd4c50cf-2627-4a5d-9409-6f9a7f00d4fe"}],"ExtRef_Children_people":[{"link_death_year":-55,"link_td_description":"丙吉，西汉鲁国人，字少卿，曾任丞相，麒麟阁十一功臣之一。","link_td_id":"Q10002152","link_td_number_id":502321,"people_name":"丙吉","people_name_jianti_auto":"丙吉","people_xingming":"丙吉","start_index":3,"tongjian_id":"912aefdf-db0e-11ef-95a8-a0d3651f611f"},{"link_death_year":-46,"link_td_description":"萧望之，字长倩，东海郡兰陵县（今山东省临沂市兰陵县）人，西汉大臣、汉元帝帝师、儒家学者，历任大鸿胪、太傅等官。被后世谱牒家附会为萧何六世孙。","link_td_id":"Q10004019","link_td_number_id":1485174,"people_name":"蕭望之","people_name_jianti_auto":"萧望之","people_xingming":"萧望之","start_index":12,"tongjian_id":"912aefe0-db0e-11ef-bbf9-a0d3651f611f"},{"link_death_year":-55,"link_td_description":"丙吉，西汉鲁国人，字少卿，曾任丞相，麒麟阁十一功臣之一。","link_td_id":"Q10002152","link_td_number_id":502321,"people_name":"吉","people_name_jianti_auto":"吉","people_xingming":"丙吉","start_index":18,"tongjian_id":"912aefe1-db0e-11ef-bdb1-a0d3651f611f"},{"link_death_year":-46,"link_td_description":"萧望之，字长倩，东海郡兰陵县（今山东省临沂市兰陵县）人，西汉大臣、汉元帝帝师、儒家学者，历任大鸿胪、太傅等官。被后世谱牒家附会为萧何六世孙。","link_td_id":"Q10004019","link_td_number_id":1485174,"people_name":"望之","people_name_jianti_auto":"望之","people_xingming":"萧望之","start_index":31,"tongjian_id":"912aefe2-db0e-11ef-a5e5-a0d3651f611f"},{"link_death_year":-46,"link_td_description":"萧望之，字长倩，东海郡兰陵县（今山东省临沂市兰陵县）人，西汉大臣、汉元帝帝师、儒家学者，历任大鸿胪、太傅等官。被后世谱牒家附会为萧何六世孙。","link_td_id":"Q10004019","link_td_number_id":1485174,"people_name":"望之","people_name_jianti_auto":"望之","people_xingming":"萧望之","start_index":74,"tongjian_id":"912aefe3-db0e-11ef-a1fa-a0d3651f611f"},{"link_birth_year":-130,"link_death_year":-51,"link_td_description":"黄霸，字次公，西汉淮阳郡阳夏县（今河南省太康县）人，汉武帝末年以捐官出仕，逐步晋升，为政外宽内明，政绩卓著，被誉为自汉朝建立以来最善于治理百姓的官吏。五凤三年接替邴吉为丞相，封建成侯。甘露三年逝世，谥号“定”。后世常与龚遂并称“龚黄”，作为循吏的代表。","link_td_id":"Q10013021","link_td_number_id":1547170,"people_name":"黃霸","people_name_jianti_auto":"黄霸","people_xingming":"黄霸","start_index":87,"tongjian_id":"912aefe4-db0e-11ef-8abd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/晁错张汤","excerpts":[{"context_after":"。三人者，贤否虽不同，然均为非谊，各以它事至死，抑有以致...","context_before":"...为御史，每朝奏事，国家用日旰，丞相取充位，天下事皆决汤。","source_end_index":76,"source_paragraph_tongjian_id":"3336966f-f74d-47fa-ba30-20b5d12f5023","source_start_index":60,"source_text":"萧望之为御史，意轻丞相，遇之无礼"}],"path":"随笔/卷十二/晁错张汤","source_name":"容斋随笔"}],"class_tags":["人事","权争"],"content":"3丞相丙吉年老，上重之。蕭望之意常輕吉，上由是不悅。丞相司直奏望之遇丞相禮節倨慢，又使吏買賣，私所附益凡十萬三千，請逮捕繫治。秋，八月，壬午，詔左遷望之爲太子太傅；以太子太傅黃霸爲御史大夫。","content_fanyi":"丞相丙吉年事已高，汉宣帝很敬重他。萧望之却时常看不起丙吉，汉宣帝因此很不高兴。丞相司直上奏弹劾萧望之对待丞相礼节傲慢无礼，又让属吏替自己家买卖，暗中增加私财共计十万三千钱，请求将他逮捕治罪。秋季八月初二壬午日，汉宣帝下诏将萧望之贬为太子太傅；任命太子太傅黄霸为御史大夫。","content_jianti_auto":"3丞相丙吉年老，上重之。萧望之意常轻吉，上由是不悦。丞相司直奏望之遇丞相礼节倨慢，又使吏买卖，私所附益凡十万三千，请逮捕系治。秋，八月，壬午，诏左迁望之为太子太傅；以太子太傅黄霸为御史大夫。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"且不但已也，出补平原太守，则自陈而请留；试之左冯翊，则谢...","context_before":"...臣，谦亨之福。”韩延寿良吏也，忌其名而讦其小过以陷之死。","source_end_index":190,"source_paragraph_tongjian_id":"39482594-52ec-4156-93a8-9b6464425ccb","source_start_index":173,"source_text":"丙吉贤相也，则倨慢无礼而以老侮之。"}],"title":"一八 萧望之难以大受"},{"excerpts":[{"context_after":"，张敞以之攻黄霸之私，势已成乎极重，则其反而相奖以诡随也...","context_before":"...人主厌其苛核，非但贵戚宦寺之疾之也。魏相以之赤霍氏之族，","source_end_index":219,"source_paragraph_tongjian_id":"f3d9ea16-0f10-41e2-85f6-473c5caa0bda","source_start_index":209,"source_text":"萧望之以之持丙吉之短"}],"title":"二 四科消天下之气节"}],"id":2129,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"912aefd7-db0e-11ef-be30-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note