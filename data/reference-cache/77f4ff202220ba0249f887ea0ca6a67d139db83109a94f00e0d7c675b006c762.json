1ef-84af-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":80,"tongjian_id":"912af012-db0e-11ef-8399-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":122,"tongjian_id":"912af01a-db0e-11ef-b33b-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":133,"tongjian_id":"912af01b-db0e-11ef-8e45-a0d3651f611f"},{"place_name":"烏藉","place_name_jianti_auto":"乌藉","resolved_place_entity_id":4981,"start_index":160,"tongjian_id":"912d39bc-db0e-11ef-babe-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"4匈奴呼韓邪單于遣其弟右谷蠡王等西襲屠耆單于屯兵，殺略萬餘人。屠耆單于聞之，卽自將六萬騎擊呼韓邪單于。屠耆單于兵敗，自殺。都隆奇乃與屠耆少子右谷蠡王姑瞀樓頭亡歸漢。車犂單于東降呼韓邪單于。冬，十一月，呼韓邪單于左大將烏厲屈與父呼遫累烏厲溫敦皆見匈奴亂，率其衆數萬人降漢；封烏厲屈爲新城侯，烏厲溫敦爲義陽侯。是時李陵子復立烏藉都尉爲單于，呼韓邪單于捕斬之；遂復都單于庭，然衆裁數萬人。屠耆單于從弟休旬王自立爲閏振單于，在西邊；呼韓邪單于兄左賢王呼屠吾斯亦自立爲郅支骨都侯單于，在東邊。","content_fanyi":"匈奴呼韩邪单于派他的弟弟右谷蠡王等人向西袭击屠耆单于的屯驻军队，杀死并掳掠了一万多人。屠耆单于得知后，立即亲自率领六万骑兵攻击呼韩邪单于。屠耆单于兵败，自杀。都隆奇于是与屠耆单于的小儿子右谷蠡王姑瞀楼头逃往汉朝归降。车犁单于向东投降呼韩邪单于。冬季，十一月，呼韩邪单于的左大将乌厉屈与父亲呼遫累乌厉温敦都看到匈奴内乱，率领部众数万人投降汉朝；汉宣帝封乌厉屈为新城侯，封乌厉温敦为义阳侯。此时，李陵的儿子又拥立乌藉都尉为单于，呼韩邪单于将他捕杀；于是又定都单于王庭，但部众只有数万人。屠耆单于的堂弟休旬王在匈奴西部自立为闰振单于；呼韩邪单于的兄长左贤王呼屠吾斯也在匈奴东部自立为郅支骨都侯单于。","content_jianti_auto":"4匈奴呼韩邪单于遣其弟右谷蠡王等西袭屠耆单于屯兵，杀略万余人。屠耆单于闻之，即自将六万骑击呼韩邪单于。屠耆单于兵败，自杀。都隆奇乃与屠耆少子右谷蠡王姑瞀楼头亡归汉。车犂单于东降呼韩邪单于。冬，十一月，呼韩邪单于左大将乌厉屈与父呼遫累乌厉温敦皆见匈奴乱，率其众数万人降汉；封乌厉屈为新城侯，乌厉温敦为义阳侯。是时李陵子复立乌藉都尉为单于，呼韩邪单于捕斩之；遂复都单于庭，然众裁数万人。屠耆单于从弟休旬王自立为闰振单于，在西边；呼韩邪单于兄左贤王呼屠吾斯亦自立为郅支骨都侯单于，在东边。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2130,"number":4,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"912aefe5-db0e-11ef-9019-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"平通侯","people_name_jianti_auto":"平通侯","start_index":5,"tongjian_id":"912d39c7-db0e-11ef-ab7f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汝南","place_name_jianti_auto":"汝南","start_index":11,"tongjian_id":"912d39c8-db0e-11ef-b934-a0d3651f611f"},{"place_name":"博陽","place_name_jianti_auto":"博阳","start_index":14,"tongjian_id":"912d39c9-db0e-11ef-9d43-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"功臣侯表，平通侯食邑於汝南之博陽。","note_content_jianti_auto":"功臣侯表，平通侯食邑于汝南之博阳。","note_type":"hu_note","start_index":10,"tongjian_id":"912d39c6-db0e-11ef-a44d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"伐，矜也。行，身所行也。能，才所堪也。行，下孟翻。","note_content_jianti_auto":"伐，矜也。行，身所行也。能，才所堪也。行，下孟翻。","note_type":"hu_note","start_index":21,"tongjian_id":"912d39cb-db0e-11ef-901e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"912d39d0-db0e-11ef-b9ca-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：脛脛，直貌也。脛，下頂翻。","note_content_jianti_auto":"师古曰：胫胫，直貌也。胫，下顶翻。","note_type":"hu_note","start_index":124,"tongjian_id":"912d39cf-db0e-11ef-8401-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"912d39d2-db0e-11ef-ae7d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言我尚不能自保，訟人何以得活。","note_content_jianti_auto":"师古曰：言我尚不能自保，讼人何以得活。","note_type":"hu_note","start_index":130,"tongjian_id":"912d39d1-db0e-11ef-be3a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李奇","people_name_jianti_auto":"李奇","start_index":0,"tongjian_id":"912d39d4-db0e-11ef-9f07-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":11,"tongjian_id":"912d39d5-db0e-11ef-b0d8-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":36,"tongjian_id":"912d39d6-db0e-11ef-b6e3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李奇曰：眞人，正人也。如淳曰：所以不容穴，正坐銜窶數自妨，故不得入穴也。師古曰：窶數，戴盆器也。以盆盛物戴於頭者，則以窶數薦之。今賣白團餅人所用者是也。窶，音其羽翻。數，音山羽翻。","note_content_jianti_auto":"李奇曰：真人，正人也。如淳曰：所以不容穴，正坐衔窭数自妨，故不得入穴也。师古曰：窭数，戴盆器也。以盆盛物戴于头者，则以窭数荐之。今卖白团饼人所用者是也。窭，音其羽翻。数，音山羽翻。","note_type":"hu_note","start_index":148,"tongjian_id":"912d39d3-db0e-11ef-9c5e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":0,"tongjian_id":"912d39d9-db0e-11ef-8967-a0d3651f611f"},{"people_name":"夏侯勝","people_name_jianti_auto":"夏侯胜","start_index":4,"tongjian_id":"912d39da-db0e-11ef-825d-a0d3651f611f"},{"people_name":"昌邑王","people_name_jianti_auto":"昌邑王","start_index":8,"tongjian_id":"912d39db-db0e-11ef-997a-a0d3651f611f"},{"people_name":"勝","people_name_jianti_auto":"胜","start_index":43,"tongjian_id":"912d39dc-db0e-11ef-931d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":62,"tongjian_id":"912d39dd-db0e-11ef-b806-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":85,"tongjian_id":"912d39de-db0e-11ef-b2bf-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":40,"tongjian_id":"912d39df-db0e-11ef-86ea-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":88,"tongjian_id":"912d39e0-db0e-11ef-8e15-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張晏曰：夏侯勝諫昌邑王曰：「天久陰不雨，臣下必有謀上者。」春秋無久陰不雨之異也。漢史記勝所言，故曰春秋所記，謂說春秋災異耳。師古曰：春秋有不雨事，說者因論久陰，附著之也。張晏謂漢史爲春秋，失之矣。","note_content_jianti_auto":"张晏曰：夏侯胜谏昌邑王曰：「天久阴不雨，臣下必有谋上者。」春秋无久阴不雨之异也。汉史记胜所言，故曰春秋所记，谓说春秋灾异耳。师古曰：春秋有不雨事，说者因论久阴，附著之也。张晏谓汉史为春秋，失之矣。","note_type":"hu_note","start_index":179,"tongjian_id":"912d39d8-db0e-11ef-92fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"于定國","people_name_jianti_auto":"于定国","start_index":0,"tongjian_id":"912d39e8-db0e-11ef-a296-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"于定國也。訞，與妖同。","note_content_jianti_auto":"于定国也。𫍚，与妖同。","note_type":"hu_note","start_index":198,"tongjian_id":"912d39e7-db0e-11ef-963c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楊惲","people_name_jianti_auto":"杨恽","start_index":12,"tongjian_id":"912d39ea-db0e-11ef-bbbd-a0d3651f611f"},{"people_name":"荀","people_name_jianti_auto":"荀","start_index":44,"tongjian_id":"912d39eb-db0e-11ef-91ff-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":55,"tongjian_id":"912d39ec-db0e-11ef-85d3-a0d3651f611f"},{"people_name":"孫會宗","people_name_jianti_auto":"孙会宗","start_index":57,"tongjian_id":"912d39ed-db0e-11ef-9f9d-a0d3651f611f"},{"people_name":"成","people_name_jianti_auto":"成","start_index":86,"tongjian_id":"912d39ee-db0e-11ef-b763-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":90,"tongjian_id":"912d39ef-db0e-11ef-91dc-a0d3651f611f"},{"people_name":"楊譚","people_name_jianti_auto":"杨谭","start_index":98,"tongjian_id":"912d39f0-db0e-11ef-b727-a0d3651f611f"},{"people_name":"杜延年","people_name_jianti_auto":"杜延年","start_index":101,"tongjian_id":"912d39f1-db0e-11ef-bcdd-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":115,"tongjian_id":"912d39f2-db0e-11ef-8060-a0d3651f611f"},{"people_name":"戴長樂","people_name_jianti_auto":"戴长乐","start_index":130,"tongjian_id":"912d39f3-db0e-11ef-b07b-a0d3651f611f"},{"people_name":"杜延年","people_name_jianti_auto":"杜延年","start_index":145,"tongjian_id":"912d39f4-db0e-11ef-a69a-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":177,"tongjian_id":"912d39f5-db0e-11ef-a842-a0d3651f611f"},{"people_name":"望之","people_name_jianti_auto":"望之","start_index":180,"tongjian_id":"912d39f6-db0e-11ef-97fa-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":192,"tongjian_id":"912d39f7-db0e-11ef-8708-a0d3651f611f"},{"people_name":"惲","people_name_jianti_auto":"恽","start_index":213,"tongjian_id":"912d39f8-db0e-11ef-8dcf-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：宣紀：「十二月，楊惲坐前爲光祿勳有罪，免爲庶人。不悔過，怨望，大逆不道，要斬。」荀紀因而用之。惲傳：「惲與孫會宗書曰：『臣之得罪已三年矣。』」又因日食之變，騶馬猥佐成上書告惲罪，下獄死。又楊譚稱杜延年爲御史大夫。按百官表，惲以神爵元年爲光祿勳，五年免。戴長樂亦以其年爲太僕，五年免。杜延年以五鳳三年，六月，辛酉爲御史大夫。又按蕭望之傳：「使光祿勳惲策免望之」，其事在今年八月，惲猶爲光祿勳。至四年四月，乃有日蝕之變。蓋惲以今年十二月免爲庶人，至四年乃死。宣紀誤也。","note_content_jianti_auto":"考异曰：宣纪：「十二月，杨恽坐前为光禄勋有罪，免为庶人。不悔过，怨望，大逆不道，要斩。」荀纪因而用之。恽传：「恽与孙会宗书曰：『臣之得罪已三年矣。』」又因日食之变，驺马猥佐成上书告恽罪，下狱死。又杨谭称杜延年为御史大夫。按百官表，恽以神爵元年为光禄勋，五年免。戴长乐亦以其年为太仆，五年免。杜延年以五凤三年，六月，辛酉为御史大夫。又按萧望之传：「使光禄勋恽策免望之」，其事在今年八月，恽犹为光禄勋。至四年四月，乃有日蚀之变。盖恽以今年十二月免为庶人，至四年乃死。宣纪误也。","note_type":"hu_note","start_index":221,"tongjian_id":"912d39e9-db0e-11ef-826a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"光祿勳","official_note":"光祿勳是汉代九卿之一，掌管宫殿门户和宿卫，此处是杨恽的官职，表明其地位。","official_rank":"九卿之一","source_snippet":"光祿勳平通侯楊惲","start_index":0,"tongjian_id":"6dd8631e-3447-4356-88e5-f28fa213f61e"},{"confidence":0.95,"official_category":"中枢机构","official_name":"太僕","official_note":"太僕是汉代九卿之一，掌管皇帝车马和全国马政，此处是戴长乐的官职，表明其身份。","official_rank":"九卿之一","source_snippet":"與太僕戴長樂相失","start_index":30,"tongjian_id":"769e8844-4967-4f4d-9539-47396153a21a"},{"confidence":0.9,"official_category":"文教或近侍","official_name":"郞中","official_note":"郞中是汉代低级官员，常侍从皇帝或参与宫廷事务，此处是丘常的官职，用于对话中。","official_rank":"低级官员","source_snippet":"郞中丘常謂惲曰","start_index":78,"tongjian_id":"386b96cb-df8e-4dc3-bbd9-14e3c458997a"},{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是汉代九卿之一，掌管司法和刑狱，此处指廷尉机构及其官员定国处理案件。","official_rank":"九卿之一","source_snippet":"事下廷尉。廷尉定國奏惲怨望","start_index":140,"tongjian_id":"15f70d57-1dca-4a92-8ad1-9c15e8e2747e"}],"ExtRef_Children_people":[{"link_death_year":-54,"link_td_description":"杨恽，字子幼。西汉华阴（今属陕西）人。","link_td_id":"Q10010214","link_td_number_id":970391,"people_name":"平通侯","people_name_jianti_auto":"平通侯","people_xingming":"杨恽","start_index":4,"tongjian_id":"912d3a00-db0e-11ef-b047-a0d3651f611f"},{"link_death_year":-54,"link_td_description":"杨恽，字子幼。西汉华阴（今属陕西）人。","link_td_id":"Q10010214","link_td_number_id":970391,"people_name":"楊惲","people_name_jianti_auto":"杨恽","people_xingming":"杨恽","start_index":7,"tongjian_id":"912d3a01-db0e-11ef-abad-a0d3651f611f"},{"link_td_description":"戴长乐，西汉人，官至太仆。","link_td_id":"Q10019849","link_td_number_id":6036253,"people_name":"戴長樂","people_name_jianti_auto":"戴长乐","people_xingming":"戴长乐","start_index":43,"tongjian_id":"912d3a02-db0e-11ef-a3bd-a0d3651f611f"},{"link_td_description":"戴长乐，西汉人，官至太仆。","link_td_id":"Q10019849","link_td_number_id":6036253,"people_name":"長樂","people_name_jianti_auto":"长乐","people_xingming":"戴长乐","start_index":54,"tongjian_id":"912d3a03-db0e-11ef-98ff-a0d3651f611f"},{"link_td_description":"戴长乐，西汉人，官至太仆。","link_td_id":"Q10019849","link_td_number_id":60362