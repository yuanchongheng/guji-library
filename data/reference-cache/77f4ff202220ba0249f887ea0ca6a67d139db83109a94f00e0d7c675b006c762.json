、車騎大將軍","start_index":24,"tongjian_id":"7b309657-e1bd-4d31-862a-d29e66b92538"}],"ExtRef_Children_people":[{"link_death_year":-56,"link_td_description":"韩增，西汉大臣，韩王信玄孙、韩颓当曾孙、韩嫣侄子、龙额侯韩说之子，麒麟阁十一功臣之一。","link_td_id":"Q10012605","link_td_number_id":1492059,"people_name":"韓增","people_name_jianti_auto":"韩增","people_xingming":"韩增","start_index":5,"tongjian_id":"912aefd5-db0e-11ef-9ffb-a0d3651f611f"},{"link_death_year":-53,"link_td_description":"许延寿，字翁孙，昌邑（今山东巨野东南）人，西汉政治人物。","link_td_id":"Q10004230","link_td_number_id":1508151,"people_name":"許延壽","people_name_jianti_auto":"许延寿","people_xingming":"许延寿","start_index":14,"tongjian_id":"912aefd6-db0e-11ef-be98-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2車騎將軍韓增薨。五月，將軍許延壽爲大司馬、車騎大將軍。","content_fanyi":"车骑将军韩增去世。五月，将军许延寿升迁为大司马、车骑大将军。","content_jianti_auto":"2车骑将军韩增薨。五月，将军许延寿为大司马、车骑大将军。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2128,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"912aefd4-db0e-11ef-a227-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"繁延壽","people_name_jianti_auto":"繁延寿","start_index":1,"tongjian_id":"912aefd9-db0e-11ef-b54d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":10,"tongjian_id":"912aefda-db0e-11ef-a2cd-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"時繁延壽爲丞相司直。師古曰：繁，音婆。","note_content_jianti_auto":"时繁延寿为丞相司直。师古曰：繁，音婆。","note_type":"hu_note","start_index":41,"tongjian_id":"912aefd8-db0e-11ef-8c76-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Child