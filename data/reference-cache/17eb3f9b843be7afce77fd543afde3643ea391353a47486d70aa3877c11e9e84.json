ExtRef_Children_zhang_notes":[],"note_content":"見上卷高祖七年。考異曰：季布傳云：「前陳豨反於代時，匈奴圍高帝於平城」。按平城之圍，乃韓王信反，非陳豨反也。","note_content_jianti_auto":"见上卷高祖七年。考异曰：季布传云：「前陈豨反于代时，匈奴围高帝于平城」。按平城之围，乃韩王信反，非陈豨反也。","note_type":"hu_note","start_index":102,"tongjian_id":"8e8920eb-db0e-11ef-a1b9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張釋","people_name_jianti_auto":"张释","start_index":73,"tongjian_id":"8e8920f9-db0e-11ef-984f-a0d3651f611f"},{"people_name":"顏師古","people_name_jianti_auto":"颜师古","start_index":102,"tongjian_id":"8e8920fa-db0e-11ef-8bd6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":3,"tongjian_id":"8e8920fb-db0e-11ef-9a87-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謁者，秦官，掌賓贊受事，員七十人。大謁者，蓋其長也。考異曰：史記·文帝本紀及惠景間侯者表、漢書·匈奴傳皆作「澤」；史記·呂后本紀：「八年，中大謁者張釋」，漢書·紀作「釋卿」，恩澤侯表及周勃傳皆云「張釋」；顏師古註曰：荊燕吳傳云「張擇」。今從史記·呂后本紀、漢書·恩澤侯表、周勃傳。","note_content_jianti_auto":"谒者，秦官，掌宾赞受事，员七十人。大谒者，盖其长也。考异曰：史记·文帝本纪及惠景间侯者表、汉书·匈奴传皆作「泽」；史记·吕后本纪：「八年，中大谒者张释」，汉书·纪作「释卿」，恩泽侯表及周勃传皆云「张释」；颜师古注曰：荆燕吴传云「张择」。今从史记·吕后本纪、汉书·恩泽侯表、周勃传。","note_type":"hu_note","start_index":197,"tongjian_id":"8e8920f8-db0e-11ef-804d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"愻，與遜同，順也。","note_content_jianti_auto":"𢙏，与逊同，顺也。","note_type":"hu_note","start_index":205,"tongjian_id":"8e892109-db0e-11ef-9c64-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"中郞將","official_note":"中郞將是汉代禁军将领，负责宫廷侍卫和军事事务，此处季布以中郞將身份进谏，反对樊噲的军事主张，体现了其作为近臣的谏议作用。","official_rank":"未知","source_snippet":"中郞將季布曰","start_index":78,"tongjian_id":"a9be0949-47c9-4bb0-ad1d-44184319c960"},{"confidence":0.85,"official_category":"军事指挥","official_name":"上將軍","official_note":"上將軍是高级军事统帅，此处指樊噲在平城之围时担任此职，用于说明其过去的军事经历和当前建议的对比。","official_rank":"未知","source_snippet":"噲爲上將軍","start_index":103,"tongjian_id":"8342474f-4bdc-404d-9515-7c285a223f44"},{"confidence":0.88,"official_category":"中枢近臣","official_name":"大謁者","official_note":"大謁者是汉代掌管传达、礼仪的官员，此处张释以大謁者身份负责回复匈奴书信，体现了其在外交事务中的角色。","official_rank":"未知","source_snippet":"令大謁者張釋報書","start_index":176,"tongjian_id":"b705339c-90ca-4589-88b7-a3aad9cc2591"}],"ExtRef_Children_people":[{"link_death_year":-174,"link_td_description":"冒顿，挛鞮氏，于公元前209年（秦二世元年），发动兵变，杀父头曼而自立。冒顿认为领土乃国家之根本，随后便开始了他的扩张，亦为匈奴帝国打下基础，并设置一些基本的军事、内政的官僚机构。","link_td_id":"Q10000751","link_td_number_id":116055,"people_name":"冒頓單于","people_name_jianti_auto":"冒顿单于","people_xingming":"冒顿","start_index":12,"tongjian_id":"8e89210c-db0e-11ef-89a5-a0d3651f611f"},{"link_death_year":-174,"link_td_description":"冒顿，挛鞮氏，于公元前209年（秦二世元年），发动兵变，杀父头曼而自立。冒顿认为领土乃国家之根本，随后便开始了他的扩张，亦为匈奴帝国打下基础，并设置一些基本的军事、内政的官僚机构。","link_td_id":"Q10000751","link_td_number_id":116055,"people_name":"冒頓","people_name_jianti_auto":"冒顿","start_index":20,"tongjian_id":"8e89210d-db0e-11ef-aa3b-a0d3651f611f"},{"link_birth_year":-241,"link_death_year":-180,"link_td_description":"吕雉，字娥姁，一说名雉，汉高祖刘邦皇后，山东单父（今单县）人，为中国历史上首位有正式记载姓名的皇后与皇太后。","link_td_id":"Q10000140","link_td_number_id":95981,"people_name":"高后","people_name_jianti_auto":"高后","people_xingming":"吕雉","start_index":31,"tongjian_id":"8e89210e-db0e-11ef-b3f5-a0d3651f611f","wl_zhushi":"[吕雉]"},{"link_birth_year":-241,"link_death_year":-180,"link_td_description":"吕雉，字娥姁，一说名雉，汉高祖刘邦皇后，山东单父（今单县）人，为中国历史上首位有正式记载姓名的皇后与皇太后。","link_td_id":"Q10000140","link_td_number_id":95981,"people_name":"高后","people_name_jianti_auto":"高后","start_index":39,"tongjian_id":"8e892110-db0e-11ef-9d47-a0d3651f611f","wl_zhushi":"[吕雉]"},{"link_birth_year":-242,"link_death_year":-189,"link_td_description":"樊哙，秦末汉初将领，西汉的开国功臣之一，赐爵贤成君，封武阳侯、舞阳侯，谥武侯。刘邦麾下猛将。早年以屠宰狗为业，最著名事迹为曾在鸿门宴时出面营救汉高祖刘邦，并有“人为刀俎，我为鱼肉”的典故。","link_td_id":"Q10000602","link_td_number_id":318135,"people_name":"樊噲","people_name_jianti_auto":"樊哙","people_xingming":"樊哙","start_index":61,"tongjian_id":"8e892111-db0e-11ef-ae07-a0d3651f611f"},{"link_birth_year":-235,"link_death_year":-165,"link_td_description":"季布，秦末楚地下相（今江苏省宿迁市宿城区）人，曾效力于项羽，并于多次战役中崭露头角，击败刘邦军队。项羽败亡后，被汉高祖刘邦悬赏缉拿。后在夏侯婴说情下，刘邦饶赦了他，并拜他为郎中。惠帝时，官至中郎将。文帝时，任河东郡守。","link_td_id":"Q10008897","link_td_number_id":444236,"people_name":"季布","people_name_jianti_auto":"季布","people_xingming":"季布","start_index":82,"tongjian_id":"8e892112-db0e-11ef-a6b4-a0d3651f611f"},{"link_birth_year":-242,"link_death_year":-189,"link_td_description":"樊哙，秦末汉初将领，西汉的开国功臣之一，赐爵贤成君，封武阳侯、舞阳侯，谥武侯。刘邦麾下猛将。早年以屠宰狗为业，最著名事迹为曾在鸿门宴时出面营救汉高祖刘邦，并有“人为刀俎，我为鱼肉”的典故。","link_td_id":"Q10000602","link_td_number_id":318135,"people_name":"噲","people_name_jianti_auto":"哙","people_xingming":"樊哙","start_index":87,"tongjian_id":"8e892113-db0e-11ef-bf96-a0d3651f611f"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高帝","people_name_jianti_auto":"高帝","people_xingming":"刘邦","start_index":96,"tongjian_id":"8e892115-db0e-11ef-ad1a-a0d3651f611f"},{"link_birth_year":-242,"link_death_year":-189,"link_td_description":"樊哙，秦末汉初将领，西汉的开国功臣之一，赐爵贤成君，封武阳侯、舞阳侯，谥武侯。刘邦麾下猛将。早年以屠宰狗为业，最著名事迹为曾在鸿门宴时出面营救汉高祖刘邦，并有“人为刀俎，我为鱼肉”的典故。","link_td_id":"Q10000602","link_td_number_id":318135,"people_name":"噲","people_name_jianti_auto":"哙","people_xingming":"樊哙","start_index":109,"tongjian_id":"8e892118-db0e-11ef-afcf-a0d3651f611f"},{"link_birth_year":-242,"link_death_year":-189,"link_td_description":"樊哙，秦末汉初将领，西汉的开国功臣之一，赐爵贤成君，封武阳侯、舞阳侯，谥武侯。刘邦麾下猛将。早年以屠宰狗为业，最著名事迹为曾在鸿门宴时出面营救汉高祖刘邦，并有“人为刀俎，我为鱼肉”的典故。","link_td_id":"Q10000602","link_td_number_id":318135,"people_name":"噲","people_name_jianti_auto":"哙","people_xingming":"樊哙","start_index":135,"tongjian_id":"8e892119-