ics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3蝗。","content_fanyi":"发生蝗灾。","content_jianti_auto":"3蝗。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3483,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"94ee9423-db0e-11ef-ae79-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"倫","people_name_jianti_auto":"伦","start_index":0,"tongjian_id":"94ee9426-db0e-11ef-b4d1-a0d3651f611f"},{"people_name":"田","people_name_jianti_auto":"田","start_index":6,"tongjian_id":"94ee9427-db0e-11ef-8e06-a0d3651f611f"},{"people_name":"田","people_name_jianti_auto":"田","start_index":13,"tongjian_id":"94ee9428-db0e-11ef-a902-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":4,"tongjian_id":"94ee9429-db0e-11ef-be13-a0d3651f611f"},{"place_name":"長陵","place_name_jianti_auto":"长陵","start_index":9,"tongjian_id":"94ee942a-db0e-11ef-823c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"倫之先，齊諸田，徙長陵；諸田徙園陵者多，故以次第爲氏。掾，俞絹翻。","note_content_jianti_auto":"伦之先，齐诸田，徙长陵；诸田徙园陵者多，故以次第为氏。掾，俞绢翻。","note_type":"hu_note","start_index":7,"tongjian_id":"94ee9425-db0e-11ef-a226-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94ee942c-db0e-11ef-982d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：將謂州將。說，輸芮翻。將，卽亮翻。","note_content_jianti_auto":"贤曰：将谓州将。说，输芮翻。将，即亮翻。","note_type":"hu_note","start_index":59,"tongjian_id":"94ee942b-db0e-11ef-a130-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百官志：王國官有禮樂長，主樂人；衞士長，主衞士；醫工長，主醫藥；永巷長，主宮中婢使；祠祀長，主祠祀；皆比四百石。長，知兩翻。","note_content_jianti_auto":"百官志：王国官有礼乐长，主乐人；衞士长，主衞士；医工长，主医药；永巷长，主宫中婢使；祠祀长，主祠祀；皆比四百石。长，知两翻。","note_type":"hu_note","start_index":96,"tongjian_id":"94ee942e-db0e-11ef-95a6-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"京兆掾","official_note":"京兆掾是京兆尹的属官，负责辅助处理京兆地区的行政事务。在原文中，第五倫担任此职，负责管理长安市场，体现其地方行政职能。","official_rank":"未知","source_snippet":"京兆掾第五倫領長安市","start_index":0,"tongjian_id":"53f6911e-1815-4a39-a219-0164881722ec"},{"confidence":0.85,"official_category":"文教","official_name":"淮陽王醫工長","official_note":"淮陽王醫工長是淮陽王国的医官，负责医疗事务。在原文中，第五倫后来被举荐为孝廉后补任此职，显示其从地方行政转向王国医疗管理的职业变化。","official_rank":"未知","source_snippet":"補淮陽王醫工長","start_index":86,"tongjian_id":"774c34e6-5eb5-497d-8a89-525261ae257b"}],"ExtRef_Children_people":[{"link_td_description":"第五伦，字伯鱼，京兆长陵县（今陕西咸阳）人。东汉司空。","link_td_id":"Q10007366","link_td_number_id":669196,"people_name":"第五倫","people_name_jianti_auto":"第五伦","people_xingming":"第五伦","start_index":4,"tongjian_id":"94ee9430-db0e-11ef-86a4-a0d3651f611f"},{"link_td_description":"第五伦，字伯鱼，京兆长陵县（今陕西咸阳）人。东汉司空。","link_td_id":"Q10007366","link_td_number_id":669196,"people_name":"倫","people_name_jianti_auto":"伦","people_xingming":"第五伦","start_index":67,"tongjian_id":"94ee9433-db0e-11ef-8344-a0d3651f611f"},{"people_name":"淮陽王","people_name_jianti_auto":"淮阳王","people_xingming":"淮阳王","start_index":89,"tongjian_id":"94ee9434-db0e-11ef-8793-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":1,"tongjian_id":"94ee9431-db0e-11ef-9990-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":8,"tongjian_id":"94ee9432-db0e-11ef-93d4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4京兆掾第五倫領長安市，公平廉介，市無姦枉。每讀詔書，常歎息曰：「此聖主也，一見決矣。」等輩笑之曰：「爾說將尚不能下，安能動萬乘乎！」倫曰：「未遇知己，道不同故耳。」後舉孝廉，補淮陽王醫工長。","content_fanyi":"京兆掾第五伦掌管长安市场，公平清廉、耿直方正，市中没有奸邪欺诈和冤屈。每当读到诏书，他常常感叹说：“这真是圣明的君主，只要能见上一面就可以断定了。”同辈人嘲笑他说：“你游说州郡长官尚且不能让人听服，又怎么能打动天子呢！”第五伦说：“只是没有遇到知己，彼此所走的道路不同罢了。”后来他被举荐为孝廉，补任淮阳王医工长。","content_jianti_auto":"4京兆掾第五伦领长安市，公平廉介，市无奸枉。每读诏书，常叹息曰：「此圣主也，一见决矣。」等辈笑之曰：「尔说将尚不能下，安能动万乘乎！」伦曰：「未遇知己，道不同故耳。」后举孝廉，补淮阳王医工长。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3484,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"94ee9424-db0e-11ef-a11b-a0d3651f611f"}],"reign_name":"三十一年","reign_name_jianti_auto":"三十一年","start_index":8,"tongjian_id":"94ee941f-db0e-11ef-b6bc-a0d3651f611f","year_anno":"（乙卯、五五）","year_int":55},"message":"success","success":true}