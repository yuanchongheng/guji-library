d_place_entity_id":5600,"start_index":1,"tongjian_id":"b9924125-db0e-11ef-9a0b-a0d3651f611f"},{"place_name":"龜茲","place_name_jianti_auto":"龟兹","place_note":"新疆库车县","resolved_place_entity_id":649,"start_index":12,"tongjian_id":"b9924126-db0e-11ef-8b9f-a0d3651f611f"},{"place_name":"鼠尼施","place_name_jianti_auto":"鼠尼施","place_note":"新疆新源县境","resolved_place_entity_id":3516,"start_index":140,"tongjian_id":"b9948a6c-db0e-11ef-b55d-a0d3651f611f"},{"place_name":"拔塞幹","place_name_jianti_auto":"拔塞干","resolved_place_entity_id":7140,"start_index":144,"tongjian_id":"b9948a6d-db0e-11ef-af92-a0d3651f611f"},{"place_name":"疏勒","place_name_jianti_auto":"疏勒","place_note":"新疆喀什市","resolved_place_entity_id":953,"start_index":168,"tongjian_id":"b9948a73-db0e-11ef-a400-a0d3651f611f"},{"place_name":"弓月部","place_name_jianti_auto":"弓月部","resolved_place_entity_id":6974,"start_index":172,"tongjian_id":"b9948a74-db0e-11ef-85b7-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","place_note":"首都逻些城【西藏拉萨市】","resolved_place_entity_id":92,"start_index":177,"tongjian_id":"b9948a75-db0e-11ef-91cb-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","resolved_place_entity_id":44,"start_index":185,"tongjian_id":"b9948a76-db0e-11ef-9362-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":202,"tongjian_id":"b9948a77-db0e-11ef-b4f0-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":255,"tongjian_id":"b9948a7a-db0e-11ef-a1c1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"9䫻海道總管蘇海政受詔討龜茲，敕興昔亡、繼往絕二可汗發兵與之俱。至興昔亡之境，繼往絕素與興昔亡有怨，密謂海政曰：「彌射謀反，請誅之。」時海政兵纔數千，集軍吏謀曰：「彌射若反，我輩無噍類，不如先事誅之。」乃矯稱敕，令大總管齎帛數萬段賜可汗及諸酋長，興昔亡帥其徒受賜，海政悉收斬之。其鼠尼施、拔塞幹兩部亡走，海政與繼往絕追討，平之。軍還，至疏勒南，弓月部復引吐蕃之衆來，欲與唐兵戰；海政以師老不敢戰，以軍資賂吐蕃，約和而還。由是諸部落皆以興昔亡爲冤，各有離心。繼往絕尋卒，十姓無主，有阿史那都支及李遮匐收其餘衆附於吐蕃。","content_fanyi":"䫻海道总管苏海政接受诏命讨伐龟兹，朝廷敕令兴昔亡、继往绝二位可汗发兵与他一同前往。到达兴昔亡境内后，继往绝因一向与兴昔亡有仇怨，秘密对苏海政说：“阿史那弥射将要谋反，请将他诛杀。”当时苏海政所部只有数千人，召集军中官吏商议说：“阿史那弥射如果反叛，我们这些人就都活不成，不如事先将他杀掉。”于是假称朝廷敕令，让大总管带着数万段帛赐给可汗和众酋长，兴昔亡率领部众前来接受赏赐，苏海政将他们全部收捕斩首。其中鼠尼施、拔塞幹两部逃散，苏海政与继往绝随后追击讨伐，平定了他们。军队返回，行至疏勒以南，弓月部又引来吐蕃军队，准备与唐兵交战；苏海政因部队久战疲惫不敢应战，便用军资贿赂吐蕃，订约讲和后返回。从此各部落都认为兴昔亡冤枉，各怀离心。继往绝不久去世，十姓部落无人统领，阿史那都支和李遮匐收集其余部众归附吐蕃。","content_jianti_auto":"9𫗇海道总管苏海政受诏讨龟兹，敕兴昔亡、继往绝二可汗发兵与之俱。至兴昔亡之境，继往绝素与兴昔亡有怨，密谓海政曰：「弥射谋反，请诛之。」时海政兵才数千，集军吏谋曰：「弥射若反，我辈无噍类，不如先事诛之。」乃矫称敕，令大总管赍帛数万段赐可汗及诸酋长，兴昔亡帅其徒受赐，海政悉收斩之。其鼠尼施、拔塞干两部亡走，海政与继往绝追讨，平之。军还，至疏勒南，弓月部复引吐蕃之众来，欲与唐兵战；海政以师老不敢战，以军资赂吐蕃，约和而还。由是诸部落皆以兴昔亡为冤，各有离心。继往绝寻卒，十姓无主，有阿史那都支及李遮匐收其余众附于吐蕃。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19678,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"b9924111-db0e-11ef-b5f9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"刺史","official_note":"刺史是唐代地方行政长官，负责州郡的治理和军事防御。在《资治通鉴》此段中，刺史来济率兵抵抗西突厥入侵，体现了其作为地方军事指挥官的职责。","official_rank":"未知","source_snippet":"刺史來濟將兵拒之","start_index":18,"tongjian_id":"3d598feb-2a0d-4e38-901f-96f61cf5ec9a"}],"ExtRef_Children_people":[{"link_birth_year":610,"link_death_year":662,"link_td_description":"来济，扬州人，唐朝官员，唐高宗时期的宰相。他因为反对唐高宗立武昭仪为皇后，被派到西域为官。662年，他在抵抗西突厥部落入侵时阵亡，他的哥哥来恒之后也被任命为宰相。","link_td_id":"Q10011699","link_td_number_id":1298798,"people_name":"來濟","people_name_jianti_auto":"来济","people_xingming":"来济","start_index":14,"tongjian_id":"b9948a7d-db0e-11ef-a53d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西突厥","place_name_jianti_auto":"西突厥","resolved_place_entity_id":117,"start_index":5,"tongjian_id":"b9948a7e-db0e-11ef-8e87-a0d3651f611f"},{"place_name":"庭州","place_name_jianti_auto":"庭州","place_note":"新疆吉木萨尔县","resolved_place_entity_id":2269,"start_index":9,"tongjian_id":"b9948a7f-db0e-11ef-a5d4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"10是歲，西突厥寇庭州，刺史來濟將兵拒之，謂其衆曰：「吾久當死，幸蒙存全以至今日，當以身報國。」遂不釋甲冑，赴敵而死。","content_fanyi":"这一年，西突厥侵扰唐朝庭州，刺史来济率兵抵抗，对部众说：“我早就该死，有幸保全活到今天，应当以身报国。”于是不脱甲胄，冲向敌阵战死。","content_jianti_auto":"10是岁，西突厥寇庭州，刺史来济将兵拒之，谓其众曰：「吾久当死，幸蒙存全以至今日，当以身报国。」遂不释甲胄，赴敌而死。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19679,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"b9948a7b-db0e-11ef-a434-a0d3651f611f"}],"reign_name":"龍朔二年","reign_name_jianti_auto":"龙朔二年","start_index":0,"tongjian_id":"b99240d6-db0e-11ef-89c1-a0d3651f611f","year_anno":"（壬戌、六六二）","year_int":662},"message":"success","success":true}