{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（壬戌、六六二）","note_content_jianti_auto":"（壬戌、六六二）","note_type":"hu_note","start_index":0,"tongjian_id":"b99240d7-db0e-11ef-9ef8-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"同中書門下三品、知中書事。","note_content_jianti_auto":"同中书门下三品、知中书事。","note_type":"hu_note","start_index":29,"tongjian_id":"b99240d9-db0e-11ef-812c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"太子少師","official_note":"太子少師是東宮官職，負責教導太子，屬於文教類。在《資治通鑑》此段中，許敬宗被任命為此職，顯示其在高宗朝的地位提升。","official_rank":"正二品","source_snippet":"以許敬宗爲太子少師","start_index":11,"tongjian_id":"d3635f7e-7ca7-4ff8-90c6-9474786d1699"},{"confidence":0.85,"official_category":"中枢机构","official_name":"同東西臺三品","official_note":"同東西臺三品是唐代官職，指以同中書門下三品身份參與政事，屬於宰相級別的中樞機構職務。在此上下文中，許敬宗獲此銜，表明他進入權力核心。","official_rank":"正三品","source_snippet":"同東西臺三品","start_index":18,"tongjian_id":"76d68e7c-eeba-4fe9-94e1-30f26c8f4d97"},{"confidence":0.8,"official_category":"中枢机构","official_name":"知西臺事","official_note":"知西臺事是唐代官職，指負責西臺（中書省）的事務，屬於中樞機構的具體職掌。在此段中，許敬宗兼任此職，加強其在中書省的權力。","official_rank":"未知","source_snippet":"知西臺事","start_index":24,"tongjian_id":"bb5c6fb1-2b86-4b32-ac75-9f188c0e19b5"}],"ExtRef_Children_people":[{"link_birth_year":592,"link_death_year":672,"link_td_description":"许敬宗，字延族，杭州新城县（今浙江杭州市富阳区）人，祖籍高阳郡北新城县（今河北省保定市徐水区），唐朝官员，官至中书令（宰相）。","link_td_id":"Q10001350","link_td_number_id":505864,"people_name":"許敬宗","people_name_jianti_auto":"许敬宗","people_xingming":"许敬宗","start_index":8,"tongjian_id":"b99240da-db0e-11ef-b466-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1八月，壬寅，以許敬宗爲太子少師、同東西臺三品、知西臺事。","content_fanyi":"八月壬寅日，任命许敬宗为太子少师、同东西台三品，并主持西台事务。","content_jianti_auto":"1八月，壬寅，以许敬宗为太子少师、同东西台三品、知西台事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19670,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"b99240d8-db0e-11ef-913f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"品秩等级","official_name":"八品","official_note":"八品是唐代官员品秩体系中的低级品级，通常对应低级官员，如县丞、主簿等。在《资治通鉴》此段中，提到初令八品、九品衣碧，表示唐高宗龙朔二年开始规定八品和九品官员穿碧色衣服，这反映了唐代官服制度的调整，用于区分官员等级。","official_rank":"八品","source_snippet":"八品","start_index":17,"tongjian_id":"bba3b19e-ef69-43d3-8925-2f4ac76adfd1"},{"confidence":0.9,"official_category":"品秩等级","official_name":"九品","official_note":"九品是唐代官员品秩体系中的最低品级，通常对应最低级官员，如县尉、录事等。在《资治通鉴》此段中，提到初令八品、九品衣碧，表示唐高宗龙朔二年开始规定八品和九品官员穿碧色衣服，这反映了唐代官服制度的调整，用于区分官员等级。","official_rank":"九品","source_snippet":"九品","start_index":20,"tongjian_id":"3a5f000d-b1bb-45fc-b1ec-21dbace89da7"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2九月，戊寅，初令八品、九品衣碧。","content_fanyi":"九月戊寅日，开始规定八品、九品官员穿蓝色官服。","content_jianti_auto":"2九月，戊寅，初令八品、九品衣碧。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19671,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"b99240db-db0e-11ef-8f1a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"太子監國","official_note":"太子監國是太子在皇帝外出或无法理政时，代理国家政务的职务，源自《资治通鉴》记载，此处表示高宗幸驪山溫湯期间，由太子负责监国事务。","official_rank":"未知","source_snippet":"太子監國","start_index":18,"tongjian_id":"703dae67-d6fd-4ace-9479-13656a424d40"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"驪山","place_name_jianti_auto":"骊山","resolved_place_entity_id":616,"start_index":11,"tongjian_id":"b99240df-db0e-11ef-8cf1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3冬，十月，丁酉，上幸驪山溫湯，太子監國；丁未，還宮。","content_fanyi":"冬季十月丁酉日，高宗前往骊山温泉，由太子留守京城监理国政；丁未日返回皇宫。","content_jianti_auto":"3冬，十月，丁酉，上幸骊山温汤，太子监国；丁未，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19672,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"b99240dd-db0e-11ef-a0be-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西臺侍郞，卽中書侍郞。陝，失冉翻。","note_content_jianti_auto":"西台侍郞，即中书侍郞。陕，失冉翻。","note_type":"hu_note","start_index":20,"tongjian_id":"b99240e1-db0e-11ef-b0f1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"西臺侍郞","official_note":"西臺侍郞是唐代官职，属于中书省（西臺）的副长官，负责起草诏令和参与机要事务。在《资治通鉴》此段中，上官仪被任命为此职，表明他进入中央决策层。","official_rank":"未知","source_snippet":"西臺侍郞陝人上官儀同東西臺三品","start_index":3,"tongjian_id":"889589e8-295b-4f61-a03b-e6b91c61d304"},{"confidence":0.85,"official_category":"中枢机构","official_name":"東西臺三品","official_note":"東西臺三品是唐代官职，指中书省（西臺）和门下省（东臺）的三品官衔，通常表示高级官员参与宰相事务。在此上下文中，上官仪以侍郞身份加此衔，意味着他获得更高的政治地位和权力。","official_rank":"三品","source_snippet":"西臺侍郞陝人上官儀同東西臺三品","start_index":14,"tongjian_id":"748266ff-8df3-4b9a-8ee3-28c522c94bc8"}],"ExtRef_Children_people":[{"link_birth_year":608,"link_death_year":665,"link_td_description":"上官仪，字游韶，唐朝陝州陝縣（今河南三门峡市陕州区）人，移居江都。西汉上官桀后裔。唐初诗人及宰相。","link_td_id":"Q10000450","link_td_number_id":101240,"people_name":"上官儀","people_name_jianti_auto":"上官仪","people_xingming":"上官仪","start_index":10,"tongjian_id":"b99240e2-db0e-11ef-ac35-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"陝","place_name_jianti_auto":"陕","resolved_place_entity_id":307,"start_index":8,"tongjian_id":"b99240e3-db0e-11ef-8863-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4庚戌，西臺侍郞陝人上官儀同東西臺三品。","content_fanyi":"庚戌日，任命西台侍郎、陕州人上官仪为同东西台三品。","content_jianti_auto":"4庚戌，西台侍郞陕人上官仪同东西台三品。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19673,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"b99240e0-db0e-11ef-998f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"泰山","place_name_jianti_auto":"泰山","resolved_place_entity_id":306,"start_index":13,"tongjian_id":"b99240e5-db0e-11ef-afc2-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","place_note":"洛阳","resolved_place_entity_id":54,"start_index":23,"tongjian_id":"b99240e6-db0e-11ef-8a79-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5癸丑，詔以四年正月有事於泰山，仍以來年二月幸東都。","content_fanyi":"癸丑日，朝廷下诏，定于龙朔四年正月在泰山举行封禅，并于次年二月前往东都洛阳。","content_jianti_auto":"5癸丑，诏以四年正月有事于泰山，仍以来年二月幸东都。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19674,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"b99240e4-db0e-11ef-b9a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"奉輦直長，卽尚輦直長。殿中六局直長，正七品。龍朔改尚輦局爲奉輦局。相，息亮翻。長，知兩翻。","note_content_jianti_auto":"奉辇直长，即尚辇直长。殿中六局直长，正七品。龙朔改尚辇局为奉辇局。相，息亮翻。长，知两翻。","note_type":"hu_note","start_index":21,"tongjian_id":"b99240e8-db0e-11ef-963b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西臺舍人，卽中書舍人。爲，于僞翻。上，時掌翻。","note_content_jianti_auto":"西台舍人，即中书舍人。为，于伪翻。上，时掌翻。","note_type":"hu_note","start_index":82,"tongjian_id":"b99240eb-db0e-11ef-929d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"圉師","people_name_jianti_auto":"圉师","start_index":15,"tongjian_id":"b99240ee-db0e-11ef-8dbe-a0d3651f611f"},{"people_name":"圉師","people_name_jianti_auto":"圉师","start_index":32,"tongjian_id":"b99240ef-db0e-11ef-a88a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":35,"tongjian_id":"b99240f0-db0e-11ef-805d-a0d3651f611f"},{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":56,"tongjian_id":"b99240f1-db0e-11ef-9c75-a0d3651f611f"},{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":65,"tongjian_id":"b99240f2-db0e-11ef-ac87-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊本紀：「十一月辛未，圉師下獄。」新本紀：「十一月辛未，圉師貶虔州刺史。」今據實錄，辛未，免官，久之，貶虔州刺史。舊紀，貶虔州刺史在三年二月。新本紀誤。","note_content_jianti_auto":"考异曰：旧本纪：「十一月辛未，圉师下狱。」新本纪：「十一月辛未，圉师贬虔州刺史。」今据实录，辛未，免官，久之，贬虔州刺史。旧纪，贬虔州刺史在三年二月。新本纪误。","note_type":"hu_note","start_index":225,"tongjian_id":"b99240ed-db0e-11ef-9453-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"左相","official_note":"左相是唐代的宰相官职之一，通常指尚书左仆射或类似高级官员，负责辅佐皇帝处理朝政。在上下文中，许圉师担任左相，表明他是朝廷重臣，因儿子犯事而受到皇帝责问，体现了其政治地位和职责。","official_rank":"正二品或更高","source_snippet":"左相許圉師","start_index":0,"tongjian_id":"a7797a66-e1e3-4ff0-91f2-f14d7a7afca5"},{"confidence":0.85,"official_category":"宫廷侍从","official_name":"奉輦直長","official_note":"奉輦直長是唐代宫廷中的低级官职，负责管理皇帝的车驾或相关事务。在上下文中，许自然担任此职，因游猎伤人而引发事件，显示了其职务与宫廷服务的关联。","official_rank":"从七品或类似低级","source_snippet":"奉輦直長自然","start_index":5,"tongjian_id":"850db178-655a-4680-961b-dcced7c12353"},{"confidence":0.88,"official_category":"监察","official_name":"司憲大夫","official_note":"司憲大夫是唐代的监察官职，隶属于御史台，负责弹劾官员、处理诉讼等。在上下文中，杨德裔担任此职，但未处理田主的诉讼，反映了监察系统的运作或失职。","official_rank":"从五品或类似中级","source_snippet":"司憲大夫楊德裔","start_index":48,"tongjian_id":"3cd27b5e-e5a7-47fd-9ef8-23e143efc0fd"},{"confidence":0.87,"official_category":"中枢近臣","official_name":"西臺舍人","official_note":"西臺舍人是唐代中书省的官职，负责起草诏令、参与机要。在上下文中，袁公瑜担任此职，派人匿名上告许圉师，显示了其在政治斗争中的角色。","official_rank":"从六品或类似中级","source_snippet":"西臺舍人袁公瑜","start_index":66,"tongjian_id":"b2d19e37-d54b-434c-9b13-21724525d871"},{"confidence":0.95,"official_category":"中枢机构","official_name":"宰相","official_note":"宰相是唐代最高行政长官的泛称，包括左相、右相等，总揽朝政。在上下文中，皇帝称许圉师为宰相，强调其权力和责任，因儿子事件而受责。","official_rank":"正二品或更高","source_snippet":"圉師爲宰相","start_index":94,"tongjian_id":"6f574447-07c1-427c-a60d-c764db475185"}],"ExtRef_Children_people":[{"link_birth_year":617,"link_death_year":679,"link_td_description":"许圉师，安州安陆（今湖北省安陆市）人，祖籍高阳（今河北省高阳县），唐朝大臣。","link_td_id":"Q10007183","link_td_number_id":1091486,"people_name":"許圉師","people_name_jianti_auto":"许圉师","people_xingming":"许圉师","start_index":3,"tongjian_id":"b99240f9-db0e-11ef-96c5-a0d3651f611f"},{"people_name":"自然","people_name_jianti_auto":"自然","people_xingming":"许自然","start_index":12,"tongjian_id":"b99240fa-db0e-11ef-8c07-a0d3651f611f"},{"people_name":"自然","people_name_jianti_auto":"自然","start_index":25,"tongjian_id":"b99240fb-db0e-11ef-9690-a0d3651f611f"},{"link_birth_year":617,"link_death_year":679,"link_td_description":"许圉师，安州安陆（今湖北省安陆市）人，祖籍高阳（今河北省高阳县），唐朝大臣。","link_td_id":"Q10007183","link_td_number_id":1091486,"people_name":"圉師","people_name_jianti_auto":"圉师","start_index":33,"tongjian_id":"b99240fc-db0e-11ef-bc7d-a0d3651f611f"},{"people_name":"自然","people_name_jianti_auto":"自然","start_index":36,"tongjian_id":"b99240fd-db0e-11ef-84f7-a0d3651f611f"},{"link_td_description":"杨德裔，弘农郡华阴县人，唐朝官员，杨炯伯父。","link_td_id":"Q10010618","link_td_number_id":1093351,"people_name":"楊德裔","people_name_jianti_auto":"杨德裔","people_xingming":"杨德裔","start_index":57,"tongjian_id":"b99240fe-db0e-11ef-8c58-a0d3651f611f"},{"link_birth_year":613,"link_death_year":685,"link_td_description":"袁公瑜，陈郡扶乐县（今河南省周口市太康县）人，唐朝官员。","link_td_id":"Q10011551","link_td_number_id":1279439,"people_name":"袁公瑜","people_name_jianti_auto":"袁公瑜","people_xingming":"袁公瑜","start_index":68,"tongjian_id":"b99240ff-db0e-11ef-8826-a0d3651f611f"},{"link_birth_year":617,"link_death_year":679,"link_td_description":"许圉师，安州安陆（今湖北省安陆市）人，祖籍高阳（今河北省高阳县），唐朝大臣。","link_td_id":"Q10007183","link_td_number_id":1091486,"people_name":"圉師","people_name_jianti_auto":"圉师","people_xingming":"许圉师","start_index":86,"tongjian_id":"b9924100-db0e-11ef-b37e-a0d3651f611f"},{"link_birth_year":617,"link_death_year":679,"link_td_description":"许圉师，安州安陆（今湖北省安陆市）人，祖籍高阳（今河北省高阳县），唐朝大臣。","link_td_id":"Q10007183","link_td_number_id":1091486,"people_name":"圉師","people_name_jianti_auto":"圉师","people_xingming":"许圉师","start_index":110,"tongjian_id":"b9924101-db0e-11ef-9f46-a0d3651f611f"},{"link_birth_year":592,"link_death_year":672,"link_td_description":"许敬宗，字延族，杭州新城县（今浙江杭州市富阳区）人，祖籍高阳郡北新城县（今河北省保定市徐水区），唐朝官员，官至中书令（宰相）。","link_td_id":"Q10001350","link_td_number_id":505864,"people_name":"許敬宗","people_name_jianti_auto":"许敬宗","people_xingming":"许敬宗","start_index":198,"tongjian_id":"b9924102-db0e-11ef-a32d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"6左相許圉師之子奉輦直長自然，遊獵犯人田，田主怒，自然以鳴鏑射之。圉師杖自然一百而不以聞。田主詣司憲訟之，司憲大夫楊德裔不爲治。西臺舍人袁公瑜遣人易姓名上封事告之，上曰：「圉師爲宰相，侵陵百姓，匿而不言，豈非作威作福！」圉師謝曰：「臣備位樞軸，以直道事陛下，不能悉允衆心，故爲人所攻訐。至於作威福者，或手握強兵，或身居重鎭；臣以文吏，奉事聖明，惟知閉門自守，何敢作威福！」上怒曰：「汝恨無兵邪！」許敬宗曰：「人臣如此，罪不容誅。」遽令引出。詔特免官。","content_fanyi":"左相许圉师的儿子、奉辇直长许自然，外出游猎时侵犯了别人的田地，田主发怒，许自然用鸣镝射他。许圉师杖打许自然一百下，却不把此事上报朝廷。田主到司宪衙门控告，司宪大夫杨德裔不予治罪。西台舍人袁公瑜派人改换姓名，向皇上呈上封事告发此事。皇上说：“许圉师身为宰相，儿子侵害欺凌百姓，他隐瞒不报，这难道不是作威作福吗！”许圉师谢罪说：“臣忝列枢轴之位，以直道侍奉陛下，不能使众人都满意，因此被人攻讦。至于作威作福的人，有的手握强兵，有的身居重镇；我作为文吏，侍奉圣明君主，只知道闭门自守，哪里敢作威作福！”皇上发怒说：“你是怨恨自己没有军队吗！”许敬宗说：“做臣子的到了这种地步，罪不容诛。”皇上随即下令把他带出去。下诏特别免除他的官职。","content_jianti_auto":"6左相许圉师之子奉辇直长自然，游猎犯人田，田主怒，自然以鸣镝射之。圉师杖自然一百而不以闻。田主诣司宪讼之，司宪大夫杨德裔不为治。西台舍人袁公瑜遣人易姓名上封事告之，上曰：「圉师为宰相，侵陵百姓，匿而不言，岂非作威作福！」圉师谢曰：「臣备位枢轴，以直道事陛下，不能悉允众心，故为人所攻讦。至于作威福者，或手握强兵，或身居重镇；臣以文吏，奉事圣明，惟知闭门自守，何敢作威福！」上怒曰：「汝恨无兵邪！」许敬宗曰：「人臣如此，罪不容诛。」遽令引出。诏特免官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19675,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"b99240e7-db0e-11ef-9e78-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"旭輪","people_name_jianti_auto":"旭轮","start_index":0,"tongjian_id":"b9924105-db0e-11ef-a822-a0d3651f611f"},{"people_name":"旦","people_name_jianti_auto":"旦","start_index":5,"tongjian_id":"b9924106-db0e-11ef-87a1-a0d3651f611f"},{"people_name":"睿宗