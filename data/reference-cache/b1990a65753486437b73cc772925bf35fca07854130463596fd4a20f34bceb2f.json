655b-db0e-11ef-804d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":0,"tongjian_id":"b433656b-db0e-11ef-9f7a-a0d3651f611f"},{"place_name":"嶺","place_name_jianti_auto":"岭","start_index":2,"tongjian_id":"b433656c-db0e-11ef-b92f-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":5,"tongjian_id":"b433656d-db0e-11ef-8ba6-a0d3651f611f"},{"place_name":"嶺","place_name_jianti_auto":"岭","start_index":8,"tongjian_id":"b433656e-db0e-11ef-9c08-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"江、嶺，謂江南、嶺南也。","note_content_jianti_auto":"江、岭，谓江南、岭南也。","note_type":"hu_note","start_index":64,"tongjian_id":"b433656a-db0e-11ef-b4d7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢陽郡","place_name_jianti_auto":"汉阳郡","start_index":3,"tongjian_id":"b4336570-db0e-11ef-b5ae-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":7,"tongjian_id":"b4336571-db0e-11ef-8dad-a0d3651f611f"},{"place_name":"南秦州","place_name_jianti_auto":"南秦州","start_index":10,"tongjian_id":"b4336572-db0e-11ef-a1d1-a0d3651f611f"},{"place_name":"西魏","place_name_jianti_auto":"西魏","start_index":14,"tongjian_id":"b4336573-db0e-11ef-a91f-a0d3651f611f"},{"place_name":"成州","place_name_jianti_auto":"成州","start_index":17,"tongjian_id":"b4336574-db0e-11ef-a3a4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋志：漢陽郡，後魏曰南秦州，西魏曰成州。守，手又翻。","note_content_jianti_auto":"隋志：汉阳郡，后魏曰南秦州，西魏曰成州。守，手又翻。","note_type":"hu_note","start_index":74,"tongjian_id":"b433656f-db0e-11ef-8d58-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","offic