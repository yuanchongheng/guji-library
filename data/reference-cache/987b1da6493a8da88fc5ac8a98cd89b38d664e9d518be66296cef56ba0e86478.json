91d4-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":44,"tongjian_id":"8e518e01-db0e-11ef-956e-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":55,"tongjian_id":"8e518e02-db0e-11ef-b53d-a0d3651f611f"},{"place_name":"淮陽","place_name_jianti_auto":"淮阳","place_note":"河南淮陽","start_index":63,"tongjian_id":"8e518e03-db0e-11ef-8b5e-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":88,"tongjian_id":"8e518e04-db0e-11ef-b498-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓之分晉，其地南至宛、葉，西北包鞏、洛，接于新安、宜陽，東有潁川；而淮陽之地則屬于楚。及漢定天下，韓王信剖符王潁川，其地東兼有淮陽，所謂「北近」、「南迫」，言其境相迫近耳，不屬韓也。宛，於元翻。葉，式涉翻。","note_content_jianti_auto":"韩之分晋，其地南至宛、叶，西北包巩、洛，接于新安、宜阳，东有颍川；而淮阳之地则属于楚。及汉定天下，韩王信剖符王颍川，其地东兼有淮阳，所谓「北近」、「南迫」，言其境相迫近耳，不属韩也。宛，于元翻。叶，式涉翻。","note_type":"hu_note","start_index":28,"tongjian_id":"8e518df4-db0e-11ef-af34-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8e518e06-db0e-11ef-8e7c-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":90,"tongjian_id":"8e518e07-db0e-11ef-95b1-a0d3651f611f"},{"people_name":"李奇","people_name_jianti_auto":"李奇","start_index":107,"tongjian_id":"8e518e08-db0e-11ef-9aad-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":119,"tongjian_id":"8e518e09-db0e-11ef-a67e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"太原郡","place_name_jianti_auto":"太原郡","start_index":3,"tongjian_id":"8e518e0a-db0e-11ef-8529-a0d3651f611f"},{"place_name":"韓國","place_name_jianti_auto":"韩国","start_index":19,"tongjian_id":"8e518e0b-db0e-11ef-b33b-a0d3651f611f"},{"place_name":"定襄","place_name_jianti_auto":"定襄","start_index":23,"tongjian_id":"8e518e0c-db0e-11ef-bebf-a0d3651f611f"},{"place_name":"太原","place_name_jianti_auto":"太原","start_index":30,"tongjian_id":"8e518e0d-db0e-11ef-a8c5-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","start_index":41,"tongjian_id":"8e518e0e-db0e-11ef-a879-a0d3651f611f"},{"place_name":"馬邑","place_name_jianti_auto":"马邑","start_index":44,"tongjian_id":"8e518e0f-db0e-11ef-b703-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":55,"tongjian_id":"8e518e10-db0e-11ef-87b9-a0d3651f611f"},{"place_name":"馬邑","place_name_jianti_auto":"马邑","start_index":87,"tongjian_id":"8e518e11-db0e-11ef-99e8-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":94,"tongjian_id":"8e518e12-db0e-11ef-9e5a-a0d3651f611f"},{"place_name":"馬邑城","place_name_jianti_auto":"马邑城","start_index":95,"tongjian_id":"8e518e13-db0e-11ef-a96d-a0d3651f611f"},{"place_name":"朔州","place_name_jianti_auto":"朔州","start_index":100,"tongjian_id":"8e518e14-db0e-11ef-a35d-a0d3651f611f"},{"place_name":"善陽縣","place_name_jianti_auto":"善阳县","start_index":102,"tongjian_id":"8e518e15-db0e-11ef-8380-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，太原郡領二十一縣；今以三十一縣爲韓國。蓋定襄未置郡，故太原之境，北被邊，兼有鴈門之馬邑也。晉太康地記曰：秦時建此城輒崩，不成；有馬周旋走反覆，父老異之，因依以築城，遂名馬邑。杜佑曰：秦馬邑城，在朔州善陽縣界。李奇曰：被，音被馬之被。師古曰：被，猶帶也，皮義翻。數，所角翻。","note_content_jianti_auto":"班志，太原郡领二十一县；今以三十一县为韩国。盖定襄未置郡，故太原之境，北被边，兼有鴈门之马邑也。晋太康地记曰：秦时建此城辄崩，不成；有马周旋走反复，父老异之，因依以筑城，遂名马邑。杜佑曰：秦马邑城，在朔州善阳县界。李奇曰：被，音被马之被。师古曰：被，犹带也，皮义翻。数，所角翻。","note_type":"hu_note","start_index":94,"tongjian_id":"8e518e05-db0e-11ef-947d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"韓國","place_name_jianti_auto":"韩国","resolved_place_entity_id":301,"start_index":45,"tongjian_id":"8e518e21-db0e-11ef-b614-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、两汉 三国（卷二）","excerpts":[{"context_after":"是年，信降匈奴。十一年，击斩之。晋阳，见前晋国。马邑，今...","context_before":"韩[韩信初封韩王，王故韩地，都阳翟。","source_end_index":47,"source_paragraph_tongjian_id":"73bd5972-807d-5f11-b758-114b140ca22d","source_start_index":18,"source_text":"六年，更以太原雁门郡三十一县为韩国，徙都晋阳，信请治马邑。"}],"path":"历代州域形势纪要/二、两汉 三国（卷二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"复为马邑县治。后汉永和五年，中郎将张耽等败南匈奴于马邑。...","context_before":"马邑城[《旧志》：在州东北，相传秦时所筑。","source_end_index":53,"source_paragraph_tongjian_id":"284c4b4d-8f78-519b-9067-a24a6b8c3823","source_start_index":21,"source_text":"汉初，韩王信自晋阳请治马邑，既而为匈奴所围，遂以马邑降胡。信平。"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"其后蒙古攻金人于河南，先陷钧州而汴遂不可守。","context_before":"...向，鸿沟不能限，成皋不足恃矣。战国时，韩都阳翟以角群雄。","source_end_index":143,"source_paragraph_tongjian_id":"b04de53c-e184-516a-bee5-ee642ac33f58","source_start_index":89,"source_text":"汉初，高祖封韩王信于此，既而以信壮武，颍川北近巩、洛，南迫宛、叶，东有淮阳，皆天下劲兵处也，乃徙封信于太原。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"4上以韓王信材武，所王北近鞏、洛，南迫宛、葉，東有淮陽，皆天下勁兵處；乃以太原郡三十一縣爲韓國，徙韓王信王太原以北，備禦胡，都晉陽。信上書曰：「國被邊，匈奴數入寇；晉陽去塞遠，請治馬邑。」上許之。","content_fanyi":"汉高帝认为韩王韩信有雄才武略，其封地北面紧靠巩地、洛阳，南面迫近宛、叶，东面有淮阳，这些地方都是天下劲兵聚集之地，令人放心不下；于是划出太原郡的三十一个县设为韩国，迁韩王韩信到太原以北的新地区为王，防备抵御胡人，定都晋阳。韩王韩信上书说：“韩国国土紧靠边界，匈奴屡次入侵；都城晋阳距边塞遥远，请求改以马邑为国都。”高帝批准了他的请求。","content_jianti_auto":"4上以韩王信材武，所王北近巩、洛，南迫宛、叶，东有淮阳，皆天下劲兵处；乃以太原郡三十一县为韩国，徙韩王信王太原以北，备御胡，都晋阳。信上书曰：「国被边，匈奴数入寇；晋阳去塞远，请治马邑。」上许之。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，其欲甘心于汉久矣。请都马邑，近塞而易与胡通；数使之胡求...","context_before":"...祸，自冒顿始。冒顿之阑入句注、保太原，自韩王信之叛降始。","source_end_index":44,"source_paragraph_tongjian_id":"56b58268-be64-4e31-a5c7-41a691f19fb2","source_start_index":33,"source_text":"信失韩之故封而徙于太原"},{"context_after":"，近塞而易与胡通；数使之胡求和，阳为汉和而阴自为降地；畜...","context_before":"...王信之叛降始。信失韩之故封而徙于太原，其欲甘心于汉久矣。","source_end_index":58,"source_paragraph_tongjian_id":"56b58268-be64-4e31-a5c7-41a691f19fb2","source_start_index":54,"source_text":"请都马邑"}],"title":"一一 中国北胡之祸始于韩王信叛降"}],"id":851,"number":4,"path":"资治通鉴 : 卷第十一 (漢紀三) / 太祖高皇帝中 / 六年 / 第 8 段","reading_annotation_sources":[],"start_index":7,"tongjian_id":"8e518df3-db0e-11ef-9907-a0d3651f611f","year_int":-201},"tongjian_id":"8e518df3-db0e-11ef-9907-a0d3651f611f"},"paragraph_order":1}],"page_size":10,"total_pages":1,"total_paragraphs":1},"place_name":"韓國"},"message":"success","success":true}