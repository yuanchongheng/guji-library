dren_zhang_notes":[],"note_content":"班志，陽武縣屬河南郡，有博浪沙。索隱曰：今浚儀西北四十里有博浪城。史記正義曰：鄭州陽武縣有博浪沙，當官道。師古曰：「狼」，音浪，史記作「浪」，正義音狼。","note_content_jianti_auto":"班志，阳武县属河南郡，有博浪沙。索隐曰：今浚仪西北四十里有博浪城。史记正义曰：郑州阳武县有博浪沙，当官道。师古曰：「狼」，音浪，史记作「浪」，正义音狼。","note_type":"hu_note","start_index":14,"tongjian_id":"8d706cf1-db0e-11ef-bb60-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":80,"tongjian_id":"8d706d02-db0e-11ef-b51d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"狙，玃屬。狙之伺物，必伏，乘其便而擊之。狙擊者，謂伏其旁而狙伺以擊之也。狙，千恕翻，又千余翻。索隱曰：漢官儀：天子有屬車，卽副車，奉車卽御而從後。余謂副，貳也；漢有五時副車，又在屬車之外。","note_content_jianti_auto":"狙，玃属。狙之伺物，必伏，乘其便而击之。狙击者，谓伏其旁而狙伺以击之也。狙，千恕翻，又千余翻。索隐曰：汉官仪：天子有属车，即副车，奉车即御而从后。余谓副，贰也；汉有五时副车，又在属车之外。","note_type":"hu_note","start_index":32,"tongjian_id":"8d706d01-db0e-11ef-8d2c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":1,"tongjian_id":"8d706d06-db0e-11ef-959c-a0d3651f611f"},{"link_death_year":-186,"link_td_description":"张良（？—前186年），字子房，颍川城父（今河南省禹州市张得镇）人。战国时代韩国人，韩国被秦朝灭亡后，曾暗杀秦始皇失败，后成为汉高祖刘邦的谋臣，是汉朝的开国元勋之一，与萧何、韩信同为汉初三杰。封留侯，谥号文成。","link_td_id":"Q10000191","link_td_number_id":15455,"people_name":"張良","people_name_jianti_auto":"张良","people_xingming":"张良","start_index":14,"tongjian_id":"8d706d09-db0e-11ef-b1f7-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":24,"tongjian_id":"8d706d0a-db0e-11ef-a232-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":32,"tongjian_id":"8d706d0b-db0e-11ef-8442-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"陽武","place_name_jianti_auto":"阳武","place_note":"河南原陽","resolved_place_entity_id":1971,"start_index":7,"tongjian_id":"8d706d07-db0e-11ef-884d-a0d3651f611f"},{"place_name":"博浪沙","place_name_jianti_auto":"博浪沙","resolved_place_entity_id":6134,"start_index":9,"tongjian_id":"8d706d08-db0e-11ef-b0cb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/陈涉不可轻","excerpts":[{"context_after":"之外，更无一人敢西向窥其锋者。陈胜出于戍卒，一旦奋发不顾...","context_before":"...乘之国，相踵灭亡，岂无孝子慈孙、故家遗俗？皆奉头鼠伏。自","source_end_index":134,"source_paragraph_tongjian_id":"563ae407-7ef0-489b-8f45-b1f210e12d30","source_start_index":130,"source_text":"张良狙击"}],"path":"续笔/卷十四/陈涉不可轻","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"司马贞曰：浚仪西北四十里有博浪城。建安五年，袁绍与曹操相...","context_before":"○博浪城[","source_end_index":24,"source_paragraph_tongjian_id":"c46c4802-c369-5f3d-a154-d0e50323789a","source_start_index":5,"source_text":"在县东南五里，即张良令力士击秦始皇处。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1始皇東游，至陽武博浪沙中，張良令力士操鐵椎狙擊始皇，誤中副車。始皇驚，求，弗得；令天下大索十日。","content_fanyi":"秦始皇向东巡游，到达阳武县博浪沙时，张良命令大力士手持铁椎伏击秦始皇，误中了随从天子车驾的副车。秦始皇大惊，搜捕刺客，却没有抓到；于是下令在全国范围内大搜捕十天。","content_jianti_auto":"1始皇东游，至阳武博浪沙中，张良令力士操铁椎狙击始皇，误中副车。始皇惊，求，弗得；令天下大索十日。","dtjl_par