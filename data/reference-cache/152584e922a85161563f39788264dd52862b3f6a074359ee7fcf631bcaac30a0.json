e-11ef-9573-a0d3651f611f"},{"people_name":"狼莫","people_name_jianti_auto":"狼莫","people_xingming":"狼莫","start_index":50,"tongjian_id":"95f8ee44-db0e-11ef-9823-a0d3651f611f"},{"link_death_year":121,"link_td_description":"邓遵，南阳郡新野县（今河南省新野县）人。东汉人物，邓禹之孙，和熹皇后邓绥、邓骘的从兄弟。","link_td_id":"Q10020274","link_td_number_id":6213073,"people_name":"鄧遵","people_name_jianti_auto":"邓遵","people_xingming":"邓遵","start_index":66,"tongjian_id":"95f8ee45-db0e-11ef-806c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"先零羌","place_name_jianti_auto":"先零羌","resolved_place_entity_id":1028,"start_index":15,"tongjian_id":"95f8ee40-db0e-11ef-b703-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","resolved_place_entity_id":457,"start_index":23,"tongjian_id":"95f8ee41-db0e-11ef-be23-a0d3651f611f"},{"place_name":"富平","place_name_jianti_auto":"富平","resolved_place_entity_id":1565,"start_index":35,"tongjian_id":"95f8ee42-db0e-11ef-9a1f-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":37,"tongjian_id":"95f8ee43-db0e-11ef-9631-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","resolved_place_entity_id":563,"start_index":57,"tongjian_id":"95f8ee46-db0e-11ef-86bc-a0d3651f611f"},{"place_name":"虔人種羌","place_name_jianti_auto":"虔人种羌","resolved_place_entity_id":9062,"start_index":59,"tongjian_id":"95f8ee47-db0e-11ef-9e0c-a0d3651f611f"},{"place_name":"隴右","place_name_jianti_auto":"陇右","resolved_place_entity_id":313,"start_index":70,"tongjian_id":"95f8ee48-db0e-11ef-ac1a-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、宁夏卫（卷六十二）","excerpts":[{"context_after":"中平中，以羌乱，富平寄治安定郡彭阳县界。自晋以后，益徙而...","context_before":"富平城[在所西南。汉置县，属北地郡。后汉因之。","source_end_index":48,"source_paragraph_tongjian_id":"616e90db-d279-5659-ab1c-13f5c14504bf","source_start_index":23,"source_text":"永初三年，任尚等大破先零叛羌狼莫于富平河上，是也。"},{"context_after":"后魏永熙二年，雍秦诸州都督贺拔岳击灵州帅曹泥，会秦州刺史...","context_before":"...平北入河。河水于此，有上河之名。前汉冯参为上河典农都尉。","source_end_index":135,"source_paragraph_tongjian_id":"522f5e21-0dd7-5a5f-bf44-865d4b2317ff","source_start_index":118,"source_text":"后汉任尚破先零羌于富平上河，是也。"}],"path":"陕西方舆纪要/十一、宁夏卫（卷六十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"13甲子，任尚與騎都尉馬賢共擊先零羌狼莫，追至北地，相持六十餘日，戰於富平河上，大破之，斬首五千級，狼莫逃去。於是西河虔人種羌萬人詣鄧遵降，隴右平。","content_fanyi":"甲子这天，任尚会同骑都尉马贤一起攻打先零羌首领狼莫，追击到北地。双方相持六十多天，在富平县黄河岸边交战，大败羌军，斩首五千级，狼莫脱身逃走。此后，西河郡虔人种羌一万人来到度辽将军邓遵处归降，陇右地区从此平定。","content_jianti_auto":"13甲子，任尚与骑都尉马贤共击先零羌狼莫，追至北地，相持六十余日，战于富平河上，大破之，斩首五千级，狼莫逃去。于是西河虔人种羌万人诣邓遵降，陇右平。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4107,"number":13,"reading_annotation_sources":[],"start_index":12,"tongjian_id":"95f8ee10-db0e-11ef-a8b7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"14是歲，郡國十三地震。","content_fanyi":"这一年，东汉十三个郡、封国发生地震。","content_jianti_auto":"14是岁，郡国十三地震。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4108,"number":14,"reading_annotation_sources":[],"start_index":13,"tongjian_id":"95f8ee49-db0e-11ef-a29d-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":1,"tongjian_id":"95f79886-db0e-11ef-b4a9-a0d3651f611f","year_anno":"（丁巳、一一七）","year_int":117},"message":"success","success":true}