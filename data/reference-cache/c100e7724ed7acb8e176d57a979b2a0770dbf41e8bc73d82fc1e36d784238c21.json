{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（壬子、七七二）","note_content_jianti_auto":"（壬子、七七二）","note_type":"hu_note","start_index":0,"tongjian_id":"bf918c49-db0e-11ef-884e-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"bf918c4c-db0e-11ef-a5c5-a0d3651f611f"},{"place_name":"朱雀街","place_name_jianti_auto":"朱雀街","start_index":6,"tongjian_id":"bf918c4d-db0e-11ef-bfbd-a0d3651f611f"},{"place_name":"西內","place_name_jianti_auto":"西内","start_index":22,"tongjian_id":"bf918c4e-db0e-11ef-8d25-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐鴻臚寺，在朱雀街西第二街北來第一坊，又北卽西內宮城。紇，下沒翻。臚，陵奴翻。","note_content_jianti_auto":"唐鸿胪寺，在朱雀街西第二街北来第一坊，又北即西内宫城。纥，下没翻。胪，陵奴翻。","note_type":"hu_note","start_index":19,"tongjian_id":"bf918c4b-db0e-11ef-aba7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"金光門","place_name_jianti_auto":"金光门","start_index":6,"tongjian_id":"bf918c50-db0e-11ef-b896-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":10,"tongjian_id":"bf918c51-db0e-11ef-9d63-a0d3651f611f"},{"place_name":"朱雀門","place_name_jianti_auto":"朱雀门","start_index":18,"tongjian_id":"bf918c52-db0e-11ef-bde4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"騎，奇計翻。金光門，長安城西面中門；朱雀門，宮城南門也。","note_content_jianti_auto":"骑，奇计翻。金光门，长安城西面中门；朱雀门，宫城南门也。","note_type":"hu_note","start_index":46,"tongjian_id":"bf918c4f-db0e-11ef-9834-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"外交礼仪","official_name":"鴻臚寺","official_note":"鴻臚寺是唐代负责接待外宾和礼仪事务的中央机构，此处指回纥使者从鸿胪寺擅自外出，表明其作为外交接待场所的作用。","official_rank":"未知","source_snippet":"回紇使者擅出鴻臚寺","start_index":12,"tongjian_id":"e7b5acd1-8606-4fde-8f8b-286df639eaff"},{"confidence":0.7,"official_category":"未知","official_name":"所司","official_note":"所司泛指相关主管官员或机构，此处指负责管理鸿胪寺事务的官员试图制止回纥使者的行为，但具体官职不明。","official_rank":"未知","source_snippet":"所司禁之","start_index":24,"tongjian_id":"01bd17fb-cbc9-49d2-add9-8b7a55929d50"},{"confidence":0.85,"official_category":"宫廷内侍","official_name":"中使","official_note":"中使是皇帝派遣的宦官使者，负责传达诏令或处理宫廷事务，此处指代宗派遣中使刘清潭去劝谕回纥使者，以平息事端。","official_rank":"未知","source_snippet":"上遣中使劉清潭諭之","start_index":48,"tongjian_id":"04eaebdf-6072-4811-86a4-29f1d92e68c0"}],"ExtRef_Children_people":[{"people_name":"劉清潭","people_name_jianti_auto":"刘清潭","people_xingming":"刘清潭","start_index":58,"tongjian_id":"bf918c57-db0e-11ef-a479-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"回紇","place_name_jianti_auto":"回纥","place_note":"瀚海沙漠群","resolved_place_entity_id":265,"start_index":9,"tongjian_id":"bf918c54-db0e-11ef-94f2-a0d3651f611f"},{"place_name":"金光","place_name_jianti_auto":"金光","resolved_place_entity_id":4106,"start_index":39,"tongjian_id":"bf918c55-db0e-11ef-b03e-a0d3651f611f"},{"place_name":"朱雀門","place_name_jianti_auto":"朱雀门","resolved_place_entity_id":1932,"start_index":42,"tongjian_id":"bf918c56-db0e-11ef-b3ef-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","内政"],"content":"1春，正月，甲辰，回紇使者擅出鴻臚寺，掠人子女；所司禁之，毆擊所司，以三百騎犯金光、朱雀門。是日，宮門皆閉，上遣中使劉清潭諭之，乃止。","content_fanyi":"春季，正月二十二日甲辰，回纥使者擅自走出鸿胪寺，抢夺百姓子女；主管官员出面制止，他们反而殴打主管官员，并率三百名骑兵进犯金光门和朱雀门。当天，宫门全部关闭，代宗派中使刘清潭前去晓谕，他们才停止。","content_jianti_auto":"1春，正月，甲辰，回纥使者擅出鸿胪寺，掠人子女；所司禁之，殴击所司，以三百骑犯金光、朱雀门。是日，宫门皆闭，上遣中使刘清潭谕之，乃止。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22732,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"bf918c4a-db0e-11ef-95eb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":697,"link_death_year":781,"link_td_description":"郭子仪，华州郑县（今陕西渭南市华州区）人，祖籍并州太原，唐代政治家、军事家、名将。唐朝朔方军集团将领，一生平定安史之乱等诸多乱事，历事玄宗、肃宗、代宗、德宗四帝，封汾阳郡王，世称郭令公。","link_td_id":"Q10000116","link_td_number_id":1007698,"people_name":"郭子儀","people_name_jianti_auto":"郭子仪","people_xingming":"郭子仪","start_index":4,"tongjian_id":"bf918c5a-db0e-11ef-89f0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"邠州","place_name_jianti_auto":"邠州","place_note":"陕西省彬县","resolved_place_entity_id":622,"start_index":14,"tongjian_id":"bf918c5b-db0e-11ef-a2c9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2三月，郭子儀入朝；丙午，還邠州。","content_fanyi":"三月，郭子仪入朝；三月二十五日丙午，返回邠州。","content_jianti_auto":"2三月，郭子仪入朝；丙午，还邠州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22733,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"bf918c58-db0e-11ef-b4ea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"吐，從暾入聲。騎，奇計翻。","note_content_jianti_auto":"吐，从暾入声。骑，奇计翻。","note_type":"hu_note","start_index":18,"tongjian_id":"bf918c5d-db0e-11ef-9758-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":6,"tongjian_id":"bf918c5e-db0e-11ef-a053-a0d3651f611f"},{"place_name":"靈州","place_name_jianti_auto":"灵州","place_note":"宁夏灵武市","resolved_place_entity_id":491,"start_index":12,"tongjian_id":"bf918c5f-db0e-11ef-a1e1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"3夏，四月，吐蕃五千騎至靈州，尋退。","content_fanyi":"夏季四月，吐蕃的五千骑兵进抵灵州，不久便退去。","content_jianti_auto":"3夏，四月，吐蕃五千骑至灵州，寻退。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22734,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"bf918c5c-db0e-11ef-92da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4五月，乙未，赦天下。","content_fanyi":"五月十五日乙未，大赦天下。","content_jianti_auto":"4五月，乙未，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22735,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"bf918c60-db0e-11ef-96de-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"西內","place_name_jianti_auto":"西内","start_index":0,"tongjian_id":"bf918c64-db0e-11ef-95cc-a0d3651f611f"},{"place_name":"含光門","place_name_jianti_auto":"含光门","start_index":17,"tongjian_id":"bf918c65-db0e-11ef-a73e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西內宮城之外爲皇城，南面三門，西爲含光門。說，讀曰悅。","note_content_jianti_auto":"西内宫城之外为皇城，南面三门，西为含光门。说，读曰悦。","note_type":"hu_note","start_index":30,"tongjian_id":"bf918c63-db0e-11ef-b821-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"長安令","official_note":"長安令是唐代京兆府長安縣的行政長官，負責縣內政務、司法等事務。在上下文中，長安令邵說被回紇驅逐，顯示了回紇在長安的囂張行為和對地方官員的侵犯。","official_rank":"正五品上（唐代长安令品秩）","source_snippet":"逐長安令邵說至含光門街","start_index":22,"tongjian_id":"9a3f7863-fce8-469f-a417-b2794cd8aae7"}],"ExtRef_Children_people":[{"people_name":"邵說","people_name_jianti_auto":"邵说","people_xingming":"邵说","start_index":22,"tongjian_id":"bf918c67-db0e-11ef-96fc-a0d3651f611f"},{"people_name":"說","people_name_jianti_auto":"说","people_xingming":"邵说","start_index":34,"tongjian_id":"bf918c6a-db0e-11ef-8484-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"回紇","place_name_jianti_auto":"回纥","place_note":"瀚海沙漠群","resolved_place_entity_id":265,"start_index":9,"tongjian_id":"bf918c66-db0e-11ef-8ee8-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":57,"start_index":19,"tongjian_id":"bf918c68-db0e-11ef-be14-a0d3651f611f"},{"place_name":"含光門","place_name_jianti_auto":"含光门","resolved_place_entity_id":3627,"start_index":25,"tongjian_id":"bf918c69-db0e-11ef-8669-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"5秋，七月，癸巳，回紇又擅出鴻臚寺，逐長安令邵說至含光門街，奪其馬；說乘他馬而去，弗敢爭。","content_fanyi":"秋季，七月十四日癸巳，回纥人又擅自走出鸿胪寺，将长安令邵说驱赶至含光门街，夺走了他的马；邵说改骑别的马离去，不敢与他们争辩。","content_jianti_auto":"5秋，七月，癸巳，回纥又擅出鸿胪寺，逐长安令邵说至含光门街，夺其马；说乘他马而去，弗敢争。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22736,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"bf918c61-db0e-11ef-b0b2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":57,"source_start_index":51,"source_text":"事見上卷三年","target_paragraph_tongjian_id":"bf7ce3bc-db0e-11ef-9c0a-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"朱希彩","people_name_jianti_auto":"朱希彩","start_index":41,"tongjian_id":"bf918c6d-db0e-11ef-817a-a0d3651f611f"},{"people_name":"李懷仙","people_name_jianti_auto":"李怀仙","start_index":45,"tongjian_id":"bf918c6e-db0e-11ef-9d8e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"使，疏吏翻。悖，蒲妹翻，又蒲沒翻。朝，直遙翻。將，卽亮翻。伺，相吏翻。間，古莧翻。朱希彩殺李懷仙自立，事見上卷三年。瑗，于絹翻。","note_content_jianti_auto":"使，疏吏翻。悖，蒲妹翻，又蒲没翻。朝，直遥翻。将，即亮翻。伺，相吏翻。间，古苋翻。朱希彩杀李怀仙自立，事见上卷三年。瑗，于绢翻。","note_type":"hu_note","start_index":38,"tongjian_id":"bf918c6c-db0e-11ef-9024-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左常侍，左散騎常侍也。","note_content_jianti_auto":"左常侍，左散骑常侍也。","note_type":"hu_note","start_index":130,"tongjian_id":"bf918c70-db0e-11ef-b3cf-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政/军事指挥","official_name":"盧龍節度使","official_note":"盧龍節度使是唐代在河北地區設置的節度使，掌管盧龍地區的軍政大權。在《資治通鑑》此段中，朱希彩擔任此職，但因其行為悖慢朝廷、殘虐將卒，最終被殺。","official_rank":"从二品至正三品","source_snippet":"盧龍節度使朱希彩旣得位","start_index":0,"tongjian_id":"3db00788-f805-44fe-8f53-077b6baffa20"},{"confidence":0.9,"official_category":"地方行政/财政","official_name":"孔目官","official_note":"孔目官是唐代節度使府中的低級官吏，負責文書、賬目等事務。在此段中，李懷瑗擔任此職，並利用眾怒伺機殺害朱希彩。","official_rank":"未知","source_snippet":"孔目官李懷瑗因衆怒","start_index":24,"tongjian_id":"ea631e63-08ff-49d2-bd06-4876d417b2b4"},{"confidence":0.92,"official_category":"军事指挥","official_name":"經略副使","official_note":"經略副使是唐代在邊疆地區設置的軍事副長官，輔助經略使處理軍務。在此段中，朱泚擔任此職，並在朱希彩被殺後，被推舉為新的節度使人選。","official_rank":"从四品至正五品","source_snippet":"經略副使朱泚營於城北","start_index":44,"tongjian_id":"bbfeb250-42e9-4dec-9180-1118115132cf"},{"confidence":0.95,"official_category":"地方行政/军事指挥","official_name":"節度使","official_note":"節度使是唐代在邊疆和重要地區設置的軍政長官，總攬一地的軍民財政。在此段中，眾人推舉朱泚接替朱希彩擔任盧龍節度使。","official_rank":"从二品至正三品","source_snippet":"節度使非朱副使不可","start_index":68,"tongjian_id":"d9a12e67-a0ac-4cc9-891e-33d3beecde0b"},{"confidence":0.88,"official_category":"地方行政","official_name":"權知留後","official_note":"權知留後是唐代節度使缺位時，暫時代理職務的官職，通常由部下推舉或朝廷臨時任命。在此段中，朱泚在朱希彩被殺後，暫時代理盧龍節度使的職務。","official_rank":"未知","source_snippet":"泚遂權知留後","start_index":84,"tongjian_id":"8dec6194-6e80-4557-b61b-8f0d5b9f9b7d"},{"confidence":0.93,"official_category":"中枢机构/文教","official_name":"檢校左常侍","official_note":"檢校左常侍是唐代的加官，表示榮譽職銜，左常侍原屬門下省，負責規諫、禮儀等事務。在此段中，朝廷正式任命朱泚為盧龍節度使，並加檢校左常侍的頭銜。","official_rank":"正三品","source_snippet":"以泚爲檢校左常侍","start_index":108,"tongjian_id":"ce3b68fb-3f72-47d2-92a6-9e7b680d548d"},{"confidence":0.95,"official_category":"地方行政/军事指挥","official_name":"幽州·盧龍節度使","official_note":"幽州·盧龍節度使是唐代在河北地區的節度使，掌管幽州和盧龍地區的軍政大權。在此段中，朝廷正式任命朱泚擔任此職，接替被殺的朱希彩。","official_rank":"从二品至正三品","source_snippet":"幽州·盧龍節度使","start_index":117,"tongjian_id":"1903b2a9-3652-413b-b233-84f5a36d3bed"}],"ExtRef_Children_people":[{"link_death_year":772,"link_td_description":"朱希彩，唐代幽州节度使，封高密郡王。","link_td_id":"Q10009329","link_td_number_id":608582,"people_name":"朱希彩","people_name_jianti_auto":"朱希彩","people_xingming":"朱希彩","start_index":6,"tongjian_id":"bf918c71-db0e-11ef-9eb4-a0d3651f611f"},{"people_name":"李懷瑗","people_name_jianti_auto":"李怀瑗","people_xingming":"李怀瑗","start_index":26,"tongjian_id":"bf918c72-db0e-11ef-882b-a0d3651f611f"},{"link_birth_year":742,"link_death_year":784,"link_td_description":"朱泚，幽州昌平人（今北京昌平南），本为唐朝武将，后叛唐称帝。","link_td_id":"Q10008118","link_td_