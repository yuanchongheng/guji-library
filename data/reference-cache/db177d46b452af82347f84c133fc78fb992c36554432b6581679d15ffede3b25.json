.85,"official_category":"中枢机构","official_name":"尚書","official_note":"尚書是汉代掌管文书和机要的官职，此处表明王氏家族控制中枢行政。","official_rank":"中枢官员","source_snippet":"尚書、九卿、州牧、郡守皆出其門","start_index":240,"tongjian_id":"1aa8fb88-ffd4-4a5e-a855-934e05201ae3"},{"confidence":0.8,"official_category":"中枢机构","official_name":"九卿","official_note":"九卿是汉代中央政府的高级官员，包括太常、光禄勋等，此处泛指王氏家族影响广泛。","official_rank":"高级官员群体","source_snippet":"尚書、九卿、州牧、郡守皆出其門","start_index":243,"tongjian_id":"a2cec8ca-4991-4cda-be88-e0b1ef40797e"},{"confidence":0.85,"official_category":"地方行政","official_name":"州牧","official_note":"州牧是汉代州级行政长官，负责地方治理，此处显示王氏家族在地方上的势力。","official_rank":"地方高级官员","source_snippet":"尚書、九卿、州牧、郡守皆出其門","start_index":246,"tongjian_id":"3fd3af98-4138-47c9-82dc-4fc030009116"},{"confidence":0.85,"official_category":"地方行政","official_name":"郡守","official_note":"郡守是汉代郡级行政长官，管理地方事务，此处进一步强调王氏家族对地方的控制。","official_rank":"地方中级官员","source_snippet":"尚書、九卿、州牧、郡守皆出其門","start_index":249,"tongjian_id":"deddaf77-529e-4610-b3ed-a9fb16318593"}],"ExtRef_Children_people":[{"link_death_year":-15,"link_td_description":"王音，魏郡元城（今河北省大名县）人，西汉官员。","link_td_id":"Q10012816","link_td_number_id":1509133,"people_name":"王音","people_name_jianti_auto":"王音","people_xingming":"王音","start_index":15,"tongjian_id":"91d9e722-db0e-11ef-a6a9-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":25,"tongjian_id":"91d9e723-db0e-11ef-995e-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"劉向","people_name_jianti_auto":"刘向","people_xingming":"刘向","start_index":93,"tongjian_id":"91d9e724-db0e-11ef-9333-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_death_year":-6,"link_td_description":"陈汤，字子公，西汉山阳郡瑕丘县（今山东省兖州区东北）人，学识渊博，早年因家贫而向人乞讨。汉元帝时期受荐举担任郎官，建昭三年与甘延寿共同出使西域，矫诏发兵诛灭郅支单于，因功受封关内侯，后屡遭贬谪，死于京师。","link_td_id":"Q10001540","link_td_number_id":133551,"people_name":"陳湯","people_name_jianti_auto":"陈汤","people_xingming":"陈汤","start_index":96,"tongjian_id":"91d9e725-db0e-11ef-a312-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"劉氏","people_name_jianti_auto":"刘氏","start_index":117,"tongjian_id":"91d9e726-db0e-11ef-84b9-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_birth_year":-551,"link_death_year":-479,"link_td_description":"孔丘，春秋末期鲁国的教育家与哲学家，儒家创始人兼主要代表人物。","link_td_id":"Q10000008","link_td_number_id":484,"people_name":"孔子","people_name_jianti_auto":"孔子","people_xingming":"孔子","start_index":259,"tongjian_id":"91d9e729-db0e-11ef-8d92-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":282,"tongjian_id":"91d9e72a-db0e-11ef-ba92-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"燕王","people_name_jianti_auto":"燕王","people_xingming":"null","start_index":468,"tongjian_id":"91d9e72b-db0e-11ef-9cbd-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_death_year":-80,"link_td_description":"鄂邑公主，又称盖主、盖长公主、鄂邑盖长公主或鄂邑长公主。汉朝公主，汉武帝的女儿。","link_td_id":"Q10002402","link_td_number_id":1280384,"people_name":"蓋主","people_name_jianti_auto":"盖主","people_xingming":"null","start_index":471,"tongjian_id":"91d9e72c-db0e-11ef-880a-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_birth_year":-241,"link_death_year":-180,"link_td_description":"吕雉，字娥姁，一说名雉，汉高祖刘邦皇后，山东单父（今单县）人，为中国历史上首位有正式记载姓名的皇后与皇太后。","link_td_id":"Q10000140","link_td_number_id":95981,"people_name":"呂","people_name_jianti_auto":"吕","start_index":480,"tongjian_id":"91d9e72d-db0e-11ef-9f1c-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"霍","people_name_jianti_auto":"霍","start_index":482,"tongjian_id":"91d9e72e-db0e-11ef-93ce-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_death_year":-1039,"link_td_description":"管叔鲜，姬姓，名鲜，又称管叔、关叔。是西周初年管国的唯一一任君主。是周武王的弟弟，周文王第三子，周成王叔。管叔鲜和蔡叔度、霍叔处并称周初三监，监护殷商的顽军遗民，后发动三监之乱反对其弟周公旦，之后事败被杀。","link_td_id":"Q10001026","link_td_number_id":531658,"people_name":"管","people_name_jianti_auto":"管","people_xingming":"管叔","start_index":490,"tongjian_id":"91dc30ce-db0e-11ef-b502-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_td_description":"蔡叔度，姬姓，名度，是周文王第五子，周武王的弟弟。他是西周诸侯国蔡国第一任国君。","link_td_id":"Q10008757","link_td_number_id":377169,"people_name":"蔡","people_name_jianti_auto":"蔡","people_xingming":"蔡叔","start_index":492,"tongjian_id":"91dc30cf-db0e-11ef-9669-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_td_description":"周公旦，姬姓，周氏，名旦，谥文，又称周文公、周公。周文王第四子、周武王之弟，西周初年政治家，封于周邑，为诸侯国鲁国之祖，创“礼乐制度”。武则天天授元年（690年）追封为“褒德王”，宋真宗大中祥符元年（1008年）追封为“文宪王”，后世多称其“元圣”。","link_td_id":"Q10000209","link_td_number_id":15573,"people_name":"周公","people_name_jianti_auto":"周公","people_xingming":"周公","start_index":498,"tongjian_id":"91dc30d0-db0e-11ef-bbd0-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":528,"tongjian_id":"91dc30d1-db0e-11ef-85b2-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"link_birth_year":-94,"link_death_year":-74,"link_td_description":"汉昭帝刘弗陵，汉朝皇帝（前87年－前74年在位），其正式谥号为“孝昭皇帝”，后世省略“孝”字称“汉昭帝”，汉武帝幼子，母亲钩弋夫人。","link_td_id":"Q10000314","link_td_number_id":98999,"people_name":"孝昭帝","people_name_jianti_auto":"孝昭帝","people_xingming":"刘弗陵","start_index":550,"tongjian_id":"91dc30d4-db0e-11ef-b6be-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"孝宣帝","people_name_jianti_auto":"孝宣帝","start_index":570,"tongjian_id":"91dc30d7-db0e-11ef-95c9-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":577,"tongjian_id":"91dc30d8-db0e-11ef-bbd9-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"王氏","people_name_jianti_auto":"王氏","start_index":626,"tongjian_id":"91dc30da-db0e-11ef-9c1a-a0d3651f611f","wl_zhushi":"[刘骜本年三十岁]"},{"people_name":"劉氏","people_name_jianti_auto":"刘氏","people_xingming":"刘氏皇族","start_ind