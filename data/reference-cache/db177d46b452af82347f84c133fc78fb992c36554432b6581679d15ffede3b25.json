nzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":0,"tongjian_id":"91d9e6de-db0e-11ef-94da-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":15,"tongjian_id":"91d9e6df-db0e-11ef-986b-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":21,"tongjian_id":"91d9e6e0-db0e-11ef-9bd8-a0d3651f611f"},{"people_name":"三桓","people_name_jianti_auto":"三桓","start_index":45,"tongjian_id":"91d9e6e1-db0e-11ef-8320-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臣瓚曰：政不由君，下及大夫也。師古曰：論語孔子曰：祿之去公室五世矣，政逮於大夫四世矣。故夫三桓之子孫微矣。","note_content_jianti_auto":"臣瓒曰：政不由君，下及大夫也。师古曰：论语孔子曰：禄之去公室五世矣，政逮于大夫四世矣。故夫三桓之子孙微矣。","note_type":"hu_note","start_index":281,"tongjian_id":"91d9e6dd-db0e-11ef-bdda-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":33,"tongjian_id":"91d9e6e4-db0e-11ef-b083-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"91d9e6e5-db0e-11ef-b8ee-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢制，列侯，紫綬；二千石，青綬；侍中、中常侍，皆銀璫左貂、金附蟬。師古曰：言在帝之左右，相次若魚鱗也。","note_content_jianti_auto":"汉制，列侯，紫绶；二千石，青绶；侍中、中常侍，皆银珰左貂、金附蝉。师古曰：言在帝之左右，相次若鱼鳞也。","note_type":"hu_note","start_index":315,"tongjian_id":"91d9e6e3-db0e-11ef-b4b3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91d9e6e7-db0e-11ef-9cb6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：內爲汙私之行而外則寄託治公之道也。斷，丁亂翻。行，下孟翻。","note_content_jianti_auto":"师古曰：内为污私之行而外则寄托治公之道也。断，丁乱翻。行，下孟翻。","note_type":"hu_note","start_index":352,"tongjian_id":"91d9e6e6-db0e-11ef-93de-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91d9e6e9-db0e-11ef-aaf5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":15,"tongjian_id":"91d9e6ea-db0e-11ef-928b-a0d3651f611f"},{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","start_index":22,"tongjian_id":"91d9e6eb-db0e-11ef-8125-a0d3651f611f"},{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":27,"tongjian_id":"91d9e6ec-db0e-11ef-bdb6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：東宮，太后所居也。余按漢制，太后率居長樂宮，在未央宮東，故曰東宮。","note_content_jianti_auto":"师古曰：东宫，太后所居也。余按汉制，太后率居长乐宫，在未央宫东，故曰东宫。","note_type":"hu_note","start_index":358,"tongjian_id":"91d9e6e8-db0e-11ef-8516-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蓋","people_name_jianti_auto":"盖","start_index":2,"tongjian_id":"91d9e6f1-db0e-11ef-893c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":9,"tongjian_id":"91d9e6f2-db0e-11ef-91b5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":0,"tongjian_id":"91d9e6f3-db0e-11ef-a672-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕、蓋事見昭帝紀。師古曰：以示宗室親近而反逆也。數，所角翻。","note_content_jianti_auto":"燕、盖事见昭帝纪。师古曰：以示宗室亲近而反逆也。数，所角翻。","note_type":"hu_note","start_index":478,"tongjian_id":"91d9e6f0-db0e-11ef-9173-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Chil