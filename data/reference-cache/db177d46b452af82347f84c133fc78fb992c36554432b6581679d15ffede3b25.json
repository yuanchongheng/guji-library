:606,"tongjian_id":"91d9e709-db0e-11ef-bd58-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91d9e70d-db0e-11ef-b42f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：皁隸，卑賤之人也。春秋左氏傳曰：大夫臣士，士臣皁，皁臣輿，輿臣隸也。","note_content_jianti_auto":"师古曰：皂隶，卑贱之人也。春秋左氏传曰：大夫臣士，士臣皂，皂臣舆，舆臣隶也。","note_type":"hu_note","start_index":679,"tongjian_id":"91d9e70c-db0e-11ef-a8d1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"91d9e711-db0e-11ef-ad98-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：內，猶親也；而皇太后反外夫家也。","note_content_jianti_auto":"如淳曰：内，犹亲也；而皇太后反外夫家也。","note_type":"hu_note","start_index":710,"tongjian_id":"91d9e710-db0e-11ef-8c5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"平昌侯","people_name_jianti_auto":"平昌侯","start_index":0,"tongjian_id":"91d9e713-db0e-11ef-b8ed-a0d3651f611f"},{"people_name":"王無故","people_name_jianti_auto":"王无故","start_index":3,"tongjian_id":"91d9e714-db0e-11ef-b8bc-a0d3651f611f"},{"people_name":"宣帝","people_name_jianti_auto":"宣帝","start_index":7,"tongjian_id":"91d9e715-db0e-11ef-871e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"平昌侯王無故，宣帝舅也。","note_content_jianti_auto":"平昌侯王无故，宣帝舅也。","note_type":"hu_note","start_index":729,"tongjian_id":"91d9e712-db0e-11ef-ba90-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91d9e717-db0e-11ef-967b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：援，引也。謂升引而附近之也。援，音爰。近，其靳翻。","note_content_jianti_auto":"师古曰：援，引也。谓升引而附近之也。援，音爰。近，其靳翻。","note_type":"hu_note","start_index":763,"tongjian_id":"91d9e716-db0e-11ef-8353-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91d9e719-db0e-11ef-ac4f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：遠，謂疏而離之也，音于萬翻。","note_content_jianti_auto":"师古曰：远，谓疏而离之也，音于万翻。","note_type":"hu_note","start_index":773,"tongjian_id":"91d9e718-db0e-11ef-9be8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":14,"tongjian_id":"91d9e71b-db0e-11ef-bcc7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"弟，與第同；漢書率作「弟」。孟康曰：第，宅也，有甲乙次第也；亦作「弟」。","note_content_jianti_auto":"弟，与第同；汉书率作「弟」。孟康曰：第，宅也，有甲乙次第也；亦作「弟」。","note_type":"hu_note","start_index":779,"tongjian_id":"91d9e71a-db0e-11ef-97ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":0,"tongjian_id":"91d9e71e-db0e-11ef-a5d3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":3,"tongjian_id":"91d9e71f-db0e-11ef-ba4e-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_ind