{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁巳、五七）","note_content_jianti_auto":"（丁巳、五七）","note_type":"hu_note","start_index":0,"tongjian_id":"94f330fc-db0e-11ef-9335-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"后土","people_name_jianti_auto":"后土","people_xingming":"后土","start_index":15,"tongjian_id":"94f330fe-db0e-11ef-872b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，辛未，初立北郊，祀后土。","content_fanyi":"春季，正月，初八日辛未，朝廷开始在京城北郊设立地坛，祭祀土地神。","content_jianti_auto":"1春，正月，辛未，初立北郊，祀后土。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3503,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"94f330fd-db0e-11ef-8718-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"日過中則昃。朝，直遙翻。","note_content_jianti_auto":"日过中则昃。朝，直遥翻。","note_type":"hu_note","start_index":31,"tongjian_id":"94f33100-db0e-11ef-8c7a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94f33103-db0e-11ef-8d87-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：分，猶半也。","note_content_jianti_auto":"贤曰：分，犹半也。","note_type":"hu_note","start_index":48,"tongjian_id":"94f33102-db0e-11ef-b87e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公卿","official_note":"公卿泛指高级官员，如三公九卿，此处表示皇帝常与高官讨论治国之道，源自资治通鉴原文描述光武帝勤政。","official_rank":"未知","source_snippet":"數引公卿、郞將講論經理","start_index":38,"tongjian_id":"cc12177b-5523-4e5e-8052-fd34d9aa2cec"},{"confidence":0.85,"official_category":"军事指挥","official_name":"郞將","official_note":"郞將是汉代武官，负责宫廷侍卫或军事指挥，此处表示皇帝也引武官参与讨论，源自资治通鉴原文。","official_rank":"未知","source_snippet":"數引公卿、郞將講論經理","start_index":41,"tongjian_id":"a715a7fb-e52b-4f4c-9d43-ac97c08214fb"},{"confidence":0.95,"official_category":"皇室成员","official_name":"皇太子","official_note":"皇太子是储君，此处表示太子劝谏皇帝注意休息，源自资治通鉴原文。","official_rank":"未知","source_snippet":"皇太子見帝勤勞不怠","start_index":58,"tongjian_id":"2dfc7e69-1163-490c-a7ad-5bb50f1101be"},{"confidence":0.8,"official_category":"军事指挥","official_name":"功臣","official_note":"功臣指有功的将领或官员，此处表示光武帝在天下平定后减少对功臣的依赖，源自资治通鉴原文。","official_rank":"未知","source_snippet":"乃退功臣而進文吏","start_index":114,"tongjian_id":"005c2c40-26d5-499c-a229-e9b10b5eaaca"},{"confidence":0.8,"official_category":"文教","official_name":"文吏","official_note":"文吏指文职官员，此处表示光武帝转向任用文官治理国家，源自资治通鉴原文。","official_rank":"未知","source_snippet":"乃退功臣而進文吏","start_index":118,"tongjian_id":"bf993804-44a2-4d05-97ed-045e47ff6de9"}],"ExtRef_Children_people":[{"link_td_description":"禹，姒姓，夏后氏，传说名文命，后世尊称为大禹。远古时期中国神话人物，是黄帝轩辕氏八世孙，因在大禹治水中成功治理洪水之患的故事而广为人知。传说中，禹是中国历史上第一个家天下政权夏朝的开创者，定都于阳城（具体所在有多种说法）。禹在尧时被封为夏伯，故史书又称伯禹、夏禹。在道教信仰里，禹也被尊为水官大帝、水仙尊王。","link_td_id":"Q10000013","link_td_number_id":4218,"people_name":"禹","people_name_jianti_auto":"禹","people_xingming":"姒文命","start_index":67,"tongjian_id":"94f33108-db0e-11ef-bda5-a0d3651f611f","wl_zhushi":"[姒文命]"},{"link_birth_year":-1670,"link_death_year":-1587,"link_td_description":"商汤，商朝开国之君，子姓，名履。","link_td_id":"Q10000014","link_td_number_id":6813,"people_name":"湯","people_name_jianti_auto":"汤","people_xingming":"子天乙","start_index":69,"tongjian_id":"94f33109-db0e-11ef-b71b-a0d3651f611f","wl_zhushi":"[子天乙]"},{"link_td_description":"黄帝，中国古代部落联盟首领，为《史记》中五帝之首。","link_td_id":"Q10000032","link_td_number_id":10961,"people_name":"黃","people_name_jianti_auto":"黄","people_xingming":"姬轩辕","start_index":75,"tongjian_id":"94f3310a-db0e-11ef-956c-a0d3651f611f","wl_zhushi":"[姬轩辕]"},{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"李耳","start_index":77,"tongjian_id":"94f3310b-db0e-11ef-908c-a0d3651f611f","wl_zhushi":"[李耳]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"南宮","place_name_jianti_auto":"南宫","resolved_place_entity_id":842,"start_index":10,"tongjian_id":"94f33107-db0e-11ef-8d28-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"2二月，戊戌，帝崩於南宮前殿，年六十二。帝每旦視朝，日昃乃罷，數引公卿、郞將講論經理，夜分乃寐。皇太子見帝勤勞不怠，承間諫曰：「陛下有禹、湯之明，而失黃、老養性之福，願頤愛精神，優游自寧。」帝曰：「我自樂此，不爲疲也！」雖以征伐濟大業，及天下旣定，乃退功臣而進文吏，明愼政體，總攬權綱，量時度力，舉無過事，故能恢復前烈，身致太平。","content_fanyi":"二月初五日戊戌，光武帝在南宫前殿去世，终年六十二岁。光武帝每天早晨上朝处理政事，直到黄昏才停止，经常召见公卿、郎将讲论经学义理，到半夜才就寝。皇太子刘庄见光武帝勤勉劳苦而不懈怠，趁机劝谏说：“陛下有夏禹、商汤那样的英明，却缺少黄帝、老子那样修养身心而得长寿的福分，但愿能保养爱惜精神，悠闲宁静。”光武帝说：“我自己喜欢这样做事，并不为此感到疲劳！”光武帝虽然依靠征伐成就大业，但等到天下平定之后，就让功臣隐退，提拔文吏，明察政体，谨慎处理政务，总揽大权，观察时势，估量自己的力量，不做力所不及的事，因此能够恢复前代的伟大功业，在有生之年亲身实现天下太平。","content_jianti_auto":"2二月，戊戌，帝崩于南宫前殿，年六十二。帝每旦视朝，日昃乃罢，数引公卿、郞将讲论经理，夜分乃寐。皇太子见帝勤劳不怠，承间谏曰：「陛下有禹、汤之明，而失黄、老养性之福，愿颐爱精神，优游自宁。」帝曰：「我自乐此，不为疲也！」虽以征伐济大业，及天下既定，乃退功臣而进文吏，明愼政体，总揽权纲，量时度力，举无过事，故能恢复前烈，身致太平。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，曾未期年，而雍容于冠冕笙磬之下，不已急乎！躬与荣凭几受...","context_before":"...曰：“敬老为其近于父也。”以近父故敬，则敬老以父而推尔。","source_end_index":494,"source_paragraph_tongjian_id":"f91168f2-a6db-4657-b889-a48e1ede3d29","source_start_index":491,"source_text":"光武崩"}],"title":"二 光武崩未期年明帝即修礼乐毋乃过急过泰"}],"id":3504,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"94f330ff-db0e-11ef-8019-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000686"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宮省，卽宮禁也。","note_content_jianti_auto":"宫省，即宫禁也。","note_type":"hu_note","start_index":40,"tongjian_id":"94f3310d-db0e-11ef-bd80-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":6,"tongjian_id":"94f33110-db0e-11ef-a0a3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諸王國各置邸洛陽。","note_content_jianti_auto":"诸王国各置邸洛阳。","note_type":"hu_note","start_index":84,"tongjian_id":"94f3310f-db0e-11ef-9a0e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臨，臨哭也，力鴆翻；下同。","note_content_jianti_auto":"临，临哭也，力鸩翻；下同。","note_type":"hu_note","start_index":91,"tongjian_id":"94f33111-db0e-11ef-9e94-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈公彥","people_name_jianti_auto":"贾公彦","start_index":0,"tongjian_id":"94f33113-db0e-11ef-8542-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":5,"tongjian_id":"94f33114-db0e-11ef-a0d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賈公彥曰：漢宮殿門每門皆使司馬一人守門，比千石，皆號司馬殿門。","note_content_jianti_auto":"贾公彦曰：汉宫殿门每门皆使司马一人守门，比千石，皆号司马殿门。","note_type":"hu_note","start_index":99,"tongjian_id":"94f33112-db0e-11ef-8f23-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处赵熹担任太尉，负责主持丧事，体现了其在朝廷中的高级地位和职责。","official_rank":"正一品","source_snippet":"太尉趙熹典喪事","start_index":0,"tongjian_id":"6b2d8f41-5625-4c7d-b565-946e65a828fc"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"皇太子","official_note":"皇太子是皇帝的继承人，此处描述其与诸王同席，显示礼仪混乱，赵熹采取措施以明尊卑。","official_rank":"未知","source_snippet":"皇太子與諸王雜止同席","start_index":24,"tongjian_id":"a1adfd76-0536-432d-b138-4250d8f3e20c"},{"confidence":0.85,"official_category":"中枢机构","official_name":"謁者","official_note":"謁者是汉代官职，负责传达诏令和礼仪事务，此处赵熹奏请派遣謁者护送藩国官属到其他县安置，以整顿秩序。","official_rank":"未知","source_snippet":"奏遣謁者將護官屬分止他縣","start_index":64,"tongjian_id":"eec938bd-9420-4d77-87b2-c57e8d161b95"}],"ExtRef_Children_people":[{"link_birth_year":-4,"link_death_year":80,"link_td_description":"赵憙，字伯阳，南阳郡宛县（今河南南阳）人，东汉初期大臣。","link_td_id":"Q10002792","link_td_number_id":1556313,"people_name":"趙熹","people_name_jianti_auto":"赵熹","people_xingming":"赵熹","start_index":2,"tongjian_id":"94f33115-db0e-11ef-b326-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"王莽","people_name_jianti_auto":"王莽","people_xingming":"王莽","start_index":10,"tongjian_id":"94f33116-db0e-11ef-9019-a0d3651f611f"},{"link_birth_year":-4,"link_death_year":80,"link_td_description":"赵憙，字伯阳，南阳郡宛县（今河南南阳）人，东汉初期大臣。","link_td_id":"Q10002792","link_td_number_id":1556313,"people_name":"熹","people_name_jianti_auto":"熹","people_xingming":"赵熹","start_index":46,"tongjian_id":"94f33117-db0e-11ef-884f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"太尉趙熹典喪事。時經王莽之亂，舊典不存，皇太子與諸王雜止同席，藩國官屬出入宮省，與百僚無別。熹正色，橫劍殿階，扶下諸王以明尊卑；奏遣謁者將護官屬分止他縣，諸王並令就邸，唯得朝晡入臨；整禮儀，嚴門衞，內外肅然。","content_fanyi":"太尉赵熹主持丧事。当时经过王莽之乱，旧日典章制度已经不存，皇太子刘庄与各位封王混杂起居、同席而坐，封国属官出入宫禁，与朝中百官没有差别。赵熹神色严肃，在殿阶上横握佩剑，把诸王扶下大殿，以表明尊卑；他上奏请求派谒者监护并护送封国属官，分别安置到其他郡县，命令诸王都回到各自官邸，只许早晚两次入宫哭丧；又整肃礼仪，加强宫门守卫，内外一片肃然。","content_jianti_auto":"太尉赵熹典丧事。时经王莽之乱，旧典不存，皇太子与诸王杂止同席，藩国官属出入宫省，与百僚无别。熹正色，横剑殿阶，扶下诸王以明尊卑；奏遣谒者将护官属分止他县，诸王并令就邸，唯得朝晡入临；整礼仪，严门衞，内外肃然。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3505,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"94f3310c-db0e-11ef-ae8c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3太子卽皇帝位，尊皇后曰皇太后。","content_fanyi":"太子即位为皇帝，尊奉阴皇后为皇太后。","content_jianti_auto":"3太子即皇帝位，尊皇后曰皇太后。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3506,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"94f33118-db0e-11ef-b032-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragr