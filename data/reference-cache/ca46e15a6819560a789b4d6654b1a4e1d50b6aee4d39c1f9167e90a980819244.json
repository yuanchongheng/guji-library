1f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","start_index":6,"tongjian_id":"8f94f81a-db0e-11ef-8165-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":10,"tongjian_id":"8f94f81b-db0e-11ef-8db8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"渠起長安，旁南山下至河三百餘里。","note_content_jianti_auto":"渠起长安，旁南山下至河三百余里。","note_type":"hu_note","start_index":19,"tongjian_id":"8f94f818-db0e-11ef-8202-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"財政","official_name":"大司農","official_note":"大司農是漢代掌管國家財政、農業和倉儲的中央高級官員，屬於九卿之一。在《資治通鑑》此段中，鄭當時以大司農身份建議開鑿渭水渠道以運輸糧食和灌溉農田，這體現了其財政和農業管理職能，有助於改善經濟和民生。","official_rank":"九卿之一，正三品","source_snippet":"大司農鄭當時言","start_index":0,"tongjian_id":"25a0aa7a-b106-4b24-884d-2b8de961dfa8"}],"ExtRef_Children_people":[{"link_td_description":"郑当时，字庄，陈郡人，西汉大臣。","link_td_id":"Q10007508","link_td_number_id":1492302,"people_name":"鄭當時","people_name_jianti_auto":"郑当时","people_xingming":"郑当时","start_index":4,"tongjian_id":"8f94f81d-db0e-11ef-9c51-a0d3651f611f"},{"link_td_description":"郑当时，字庄，陈郡人，西汉大臣。","link_td_id":"Q10007508","link_td_number_id":1492302,"people_name":"當時","people_name_jianti_auto":"当时","people_xingming":"郑当时","start_index":51,"tongjian_id":"8f94f820-db0e-11ef-91e9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":17,"tongjian_id":"8f94f81e-db0e-11ef-992a-a0d3651f611f"},{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":134,"start_index":20,"tongjian_id":"8f94f81f-db0e-11ef-9871-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"《淮南子》：渭水多力，宜黍。杜笃《论都赋》：洪渭之流，径...","context_before":"...天水、扶风、京兆、冯翊]，行千八百七十里，汉漕渠所经也。","source_end_index":547,"source_paragraph_tongjian_id":"e94eae6e-878d-5a7d-b7ae-d1209e5a93da","source_start_index":419,"source_text":"元光六年，郑当时言：异时关东漕粟，从渭上度，六月罢，而渭水道九百余里，时有难处。引渭穿渠，起长安，旁南山，下至河三百余里，径易漕度，可令三月罢，渠下民田万余顷，又可得以溉。此损漕省卒而益肥关中之地得穀。上以为然，令水工徐伯穿漕渠。渠成，水大便利，民得以溉。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"2大司農鄭當時言：「穿渭爲渠，下至河，漕關東粟徑易，又可以漑渠下民田萬餘頃。」春，詔發卒數萬人穿渠，如當時策；三歲而通，人以爲便。","content_fanyi":"大司农郑当时说：“从渭水开凿一条水渠，向下连通到黄河；漕运函谷关以东地区的粮食，路程直捷便利，还可以灌溉水渠附近的一万多顷民田。”春季，武帝下诏征发数万役卒开凿水渠，按照郑当时的方案施行；三年后水渠修通，人们都觉得十分便利。","content_jianti_auto":"2大司农郑当时言：「穿渭为渠，下至河，漕关东粟径易，又可以漑渠下民田万余顷。」春，诏发卒数万人穿渠，如当时策；三岁而通，人以为便。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1462,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f94e445-db0e-11ef-9271-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"龍城","place_name_jianti_auto":"龙城","start_index":0,"tongjian_id":"8f94f823-db0e-11ef-a101-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","place_note":"王庭设蒙古哈尔和林","start_index":3,"tongjian_id":"8f94f824-db0e-11ef-9738-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"龍城，匈奴祭天，大會諸部處。","note_content_jianti_auto":"龙城，匈奴祭天，大会诸部处。","note_type":"hu_note","start_index":69,"tongjian_id":"8f94f822-db0e-11ef-8f2c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f94f827-db0e-11ef-af26-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：騰，跳躍也。上，時掌翻。","note_content_jianti_auto":"师古曰：腾，跳跃也。上，时掌翻。","no