{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁丑、四三七）","note_content_jianti_auto":"（丁丑、四三七）","note_type":"hu_note","start_index":0,"tongjian_id":"a810d053-db0e-11ef-aeb9-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"北平宣王","official_note":"北平宣王是北魏的封爵，授予長孫嵩，表示其贵族身份和地位，在上下文中用于标识人物身份。","official_rank":"王爵","source_snippet":"魏北平宣王長孫嵩卒","start_index":8,"tongjian_id":"49089f17-3bd2-4625-89eb-2eee4549da37"}],"ExtRef_Children_people":[{"link_birth_year":358,"link_death_year":437,"link_td_description":"长孙嵩，胡姓拔拔氏，十六国时代国及北魏初年重要官员。长孙嵩在代王拓跋什翼犍在位时任南部大人，后为北魏开国功臣，并历仕道武、明元及太武三朝，官至太尉、柱国大将军。","link_td_id":"Q10011076","link_td_number_id":1216014,"people_name":"北平宣王","people_name_jianti_auto":"北平宣王","people_xingming":"长孙嵩","start_index":10,"tongjian_id":"a810d056-db0e-11ef-8d13-a0d3651f611f"},{"link_birth_year":358,"link_death_year":437,"link_td_description":"长孙嵩，胡姓拔拔氏，十六国时代国及北魏初年重要官员。长孙嵩在代王拓跋什翼犍在位时任南部大人，后为北魏开国功臣，并历仕道武、明元及太武三朝，官至太尉、柱国大将军。","link_td_id":"Q10011076","link_td_number_id":1216014,"people_name":"長孫嵩","people_name_jianti_auto":"长孙嵩","people_xingming":"长孙嵩","start_index":14,"tongjian_id":"a810d057-db0e-11ef-abaa-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":9,"tongjian_id":"a810d058-db0e-11ef-9089-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1春，正月，戊子，魏北平宣王長孫嵩卒。","content_fanyi":"春季，正月十二日戊子，北魏北平宣王长孙嵩去世。","content_jianti_auto":"1春，正月，戊子，魏北平宣王长孙嵩卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11366,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"a810d054-db0e-11ef-b53b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2辛卯，大赦。","content_fanyi":"正月十五日辛卯，刘宋大赦天下。","content_jianti_auto":"2辛卯，大赦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11367,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"a810d059-db0e-11ef-9584-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"鎭東大將軍","official_note":"鎭東大將軍是魏晉南北朝時期的軍事官職，負責鎮守東部地區，此處魏主任命南平王渾擔任此職，以鎮守和龍（今遼寧朝陽），顯示其軍事指揮和邊防職能。","official_rank":"未知","source_snippet":"鎭東大將軍","start_index":28,"tongjian_id":"adab41e2-ca3a-45cb-92da-f1f9cf9d10fa"},{"confidence":0.85,"official_category":"榮譽官銜","official_name":"儀同三司","official_note":"儀同三司是魏晉南北朝時期的榮譽官銜，授予官員與三公（太尉、司徒、司空）同等的禮儀待遇，此處加封給南平王渾，以提升其地位和榮譽。","official_rank":"未知","source_snippet":"儀同三司","start_index":33,"tongjian_id":"ad313b89-789c-4001-bd59-e781c9e08c8e"}],"ExtRef_Children_people":[{"link_death_year":487,"link_td_description":"拓跋浑，鲜卑名吐谷浑，魏道武帝拓跋珪之孙，阳平王拓跋熙第二子，北魏宗室、官员。","link_td_id":"Q10010692","link_td_number_id":1103985,"people_name":"南平王","people_name_jianti_auto":"南平王","people_xingming":"拓跋","start_index":22,"tongjian_id":"a810d05b-db0e-11ef-a2e9-a0d3651f611f","wl_zhushi":"[拓跋]"},{"link_death_year":487,"link_td_description":"拓跋浑，鲜卑名吐谷浑，魏道武帝拓跋珪之孙，阳平王拓跋熙第二子，北魏宗室、官员。","link_td_id":"Q10010692","link_td_number_id":1103985,"people_name":"渾","people_name_jianti_auto":"浑","people_xingming":"拓跋浑","start_index":25,"tongjian_id":"a810d05c-db0e-11ef-80aa-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":7,"tongjian_id":"a810d05d-db0e-11ef-a9e8-a0d3651f611f"},{"place_name":"幽州","place_name_jianti_auto":"幽州","resolved_place_entity_id":102,"start_index":10,"tongjian_id":"a810d05e-db0e-11ef-917a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":19,"tongjian_id":"a810d05f-db0e-11ef-8d62-a0d3651f611f"},{"place_name":"和龍","place_name_jianti_auto":"和龙","resolved_place_entity_id":1016,"start_index":39,"tongjian_id":"a810d060-db0e-11ef-a705-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"魏燕之战","tongjian_id":"war_N0740"},{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"二十一年，仍置营州。魏收《志》：永安末，陷于群贼。天平初...","context_before":"...仍都龙城。宋元嘉九年，魏主焘攻和龙。穿围堑以守之，不克。","source_end_index":313,"source_paragraph_tongjian_id":"15865604-9c1d-5e8e-a417-0500466bc9b0","source_start_index":299,"source_text":"十三年，魏取和龙，置镇于此。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"3二月，乙卯，魏主如幽州。三月，丁丑，魏主以南平王渾爲鎭東大將軍、儀同三司，鎭和龍。己卯，還宮。","content_fanyi":"二月初九乙卯，北魏主拓跋焘动身赴幽州。三月初二丁丑，拓跋焘委任南平王拓跋浑为镇东大将军、仪同三司，让他镇守和龙。初四己卯，拓跋焘返回皇宫。","content_jianti_auto":"3二月，乙卯，魏主如幽州。三月，丁丑，魏主以南平王浑为镇东大将军、仪同三司，镇和龙。己卯，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11368,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"a810d05a-db0e-11ef-aaac-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":0,"tongjian_id":"a813065f-db0e-11ef-ad86-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏請婚始上卷十年。","note_content_jianti_auto":"魏请婚始上卷十年。","note_type":"hu_note","start_index":23,"tongjian_id":"a810d063-db0e-11ef-8fd2-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢近臣","official_name":"散騎常侍","official_note":"散騎常侍是魏晋南北朝时期的重要官职，属于侍从顾问之职，常参与朝政决策和外交事务。在《资治通鉴》此段中，散騎常侍劉熙伯被派遣出使北魏商议纳币事宜，体现了该官职在外交活动中的作用。","official_rank":"正三品","source_snippet":"帝遣散騎常侍劉熙伯如魏議納幣","start_index":4,"tongjian_id":"85fe750c-d896-4d1b-a059-a0327ffcbd29"}],"ExtRef_Children_people":[{"people_name":"劉熙伯","people_name_jianti_auto":"刘熙伯","people_xingming":"刘熙伯","start_index":7,"tongjian_id":"a8130660-db0e-11ef-b021-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":11,"tongjian_id":"a8130661-db0e-11ef-b139-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"4帝遣散騎常侍劉熙伯如魏議納幣，會帝女亡而止。","content_fanyi":"宋文帝刘义隆派遣散骑常侍刘熙伯出使北魏，商议公主出嫁的事宜；正逢文帝的女儿去世，于是中止。","content_jianti_auto":"4帝遣散骑常侍刘熙伯如魏议纳币，会帝女亡而止。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11369,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"a810d061-db0e-11ef-9f1d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙廣","people_name_jianti_auto":"赵广","start_index":3,"tongjian_id":"a8130664-db0e-11ef-b2a9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九年，趙廣等反，今乃平。帥，讀曰率。降，戶江翻。將，卽亮翻。","note_content_jianti_auto":"九年，赵广等反，今乃平。帅，读曰率。降，户江翻。将，即亮翻。","note_type":"hu_note","start_index":38,"tongjian_id":"a8130663-db0e-11ef-af35-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"輔國將軍","official_note":"輔國將軍是魏晉南北朝時期的將軍號，通常授予高級將領，負責軍事指揮或輔佐國家。在《資治通鑑》此段中，周籍之被任命為輔國將軍，隨後兼任益州刺史，顯示其軍事和行政職責。","official_rank":"未知","source_snippet":"以輔國將軍周籍之爲益州刺史","start_index":40,"tongjian_id":"8e45e143-c7cf-41a4-949f-1af0282f0728"},{"confidence":0.9,"official_category":"地方行政","official_name":"益州刺史","official_note":"益州刺史是中國古代地方行政官職，負責管理益州（今四川一帶）的民政和軍事事務。在《資治通鑑》此段中，周籍之被任命為益州刺史，以平定趙廣等叛亂後的餘黨，體現了中央對地方的控制。","official_rank":"未知","source_snippet":"以輔國將軍周籍之爲益州刺史","start_index":45,"tongjian_id":"83a36836-6262-45ff-bb55-467993093098"}],"ExtRef_Children_people":[{"people_name":"趙廣","people_name_jianti_auto":"赵广","people_xingming":"赵广","start_index":6,"tongjian_id":"a8130665-db0e-11ef-beb7-a0d3651f611f"},{"people_name":"張尋","people_name_jianti_auto":"张寻","people_xingming":"张寻","start_index":9,"tongjian_id":"a8130666-db0e-11ef-bae3-a0d3651f611f"},{"people_name":"梁顯","people_name_jianti_auto":"梁显","people_xingming":"梁显","start_index":12,"tongjian_id":"a8130667-db0e-11ef-b353-a0d3651f611f"},{"people_name":"王道恩","people_name_jianti_auto":"王道恩","people_xingming":"王道恩","start_index":22,"tongjian_id":"a8130668-db0e-11ef-aaf6-a0d3651f611f"},{"link_death_year":437,"link_td_description":"程道养，南朝刘宋时益州起事领袖，枹罕（今甘肃临夏）人，本来是阳泉山道士。","link_td_id":"Q10010139","link_td_number_id":961733,"people_name":"程道養","people_name_jianti_auto":"程道养","people_xingming":"程道养","start_index":26,"tongjian_id":"a8130669-db0e-11ef-aa1f-a0d3651f611f"},{"people_name":"周籍之","people_name_jianti_auto":"周籍之","people_xingming":"周籍之","start_index":46,"tongjian_id":"a813066a-db0e-11ef-95fd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"益州","place_name_jianti_auto":"益州","resolved_place_entity_id":204,"start_index":50,"tongjian_id":"a813066b-db0e-11ef-9022-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","人事"],"content":"5夏，四月，趙廣、張尋、梁顯等各帥衆降；別將王道恩斬程道養，送首，餘黨悉平。丁未，以輔國將軍周籍之爲益州刺史。","content_fanyi":"夏季四月，益州叛民首领赵广、张寻、梁显等人各自率众向朝廷投降；别将王道恩斩杀程道养，把程道养的人头送往京城，程道养的残余党羽全部平定。丁未日，也就是四月初二，刘宋朝廷任命辅国将军周籍之为益州刺史。","content_jianti_auto":"5夏，四月，赵广、张寻、梁显等各帅众降；别将王道恩斩程道养，送首，余党悉平。丁未，以辅国将军周籍之为益州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11370,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"a8130662-db0e-11ef-9fd8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡守、縣令，親民之官。","note_content_jianti_auto":"郡守、县令，亲民之官。","note_type":"hu_note","start_index":9,"tongjian_id":"a813066d-db0e-11ef-9abb-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"守令","official_note":"守令泛指郡守和县令，是地方行政长官，负责治理地方事务。在《资治通鉴》此段中，魏主因民官多贪而下诏允许吏民举报守令的不法行为，反映了对地方官员腐败的整治措施。","official_rank":"未知","source_snippet":"舉告守令不如法者","start_index":28,"tongjian_id":"d55b32ca-2077-4cae-9d2f-60d8a1a6f8e5"},{"confidence":0.85,"official_category":"地方行政","official_name":"牧宰","official_note":"牧宰泛指州牧和县令等地方行政官员，与守令类似，是地方治理的核心人物。在此上下文中，奸猾之人专门寻找牧宰的过失，以胁迫在位官员，显示了地方行政中的权力滥用和监察问题。","official_rank":"未知","source_snippet":"專求牧宰之失","start_index":36,"tongjian_id":"2c7ddf00-d60a-4a6d-8dac-c5bced6f9897"},{"confidence":0.8,"official_category":"地方行政","official_name":"長吏","official_note":"长吏泛指地方高级官员，如郡守、县令等，负责管理地方政务。在此段中，长吏们被迫降低姿态对待奸猾之人，但贪纵行为依旧，突出了地方官员的腐败和治理困境。","official_rank":"未知","source_snippet":"而長吏咸降心待之","start_index":48,"tongjian_id":"546e5739-cc76-45bb-a97c-52af5450b06b"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":1,"tongjian_id":"a8130670-db0e-11ef-a484-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6魏主以民官多貪，夏，五月，己丑，詔吏民得舉告守令不如法者。於是姦猾專求牧宰之失，迫脇在位，橫於閭里；而長吏咸降心待之，貪縱如故。","content_fanyi":"北魏主拓跋焘认为地方郡守、县令大多贪赃枉法，在夏季五月十五日己丑下诏，准许官吏和百姓检举告发郡守、县令中贪污不法的行为。于是，奸猾的地痞流氓专门挑取地方长官的过失，胁迫在职官员，在乡里横行霸道；而地方长官都降低身份对待他们，贪污放纵却仍像从前一样。","content_jianti_auto":"6魏主以民官多贪，夏，五月，己丑，诏吏民得举告守令不如法者。于是奸猾专求牧宰之失，迫脇在位，横于闾里；而长吏咸降心待之，贪纵如故。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，以伸其气，自以为快，而无知者亦将快之，要为夷狄駤戾之情...","context_before":"","source_end_index":26,"source_paragraph_tongjian_id":"686f962c-ca17-4df9-aeeb-0471a2625297","source_start_index":0,"source_text":"吏民得告守令，拓拔氏之制也。拓拔焘自谓恤弱民而惩贪虐"}],"title":"一二 吏民可告守令之制乱纲纪坏人心"}],"id":11371,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"a813066c-db0e-11ef-8eee-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":4,"tongjian_id":"a8130672-db0e-11ef-a261-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","resolved_place_entity_id":379,"start_index":7,"tongjian_id":"a8130673-db0e-11ef-b962-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7丙申，魏主如雲中。","content_fanyi":"五月二十二日丙申，北魏主拓跋焘前往云中。","content_jianti_auto":"7丙申，魏主如云中。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11372,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"a8130671-db0e-11ef-bd3b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"永昌王","official_note":"永昌王是北魏的封爵，通常授予宗室或功臣，此处指魏永昌王健，在上下文中作为军事指挥官讨伐山胡白龙的余党。","official_rank":"王爵","source_snippet":"魏永昌王健等討山胡白龍餘黨於西河","start_index":8,"tongjian_id":"90d7f938-0a88-4eed-9747-d1177d30c860"}],"ExtRef_Children_people":[{"link_death_year":441,"link_td_description":"拓跋健，魏明元帝拓跋嗣第五子，生母尹夫人，北魏宗室、官员。","link_td_id":"Q10011821","link_td_number_id":1365063,"people_name":"永昌王","people_name_jianti_auto":"永昌王","people_xingming":"拓跋健","start_index":10,"tongjian_id":"a8137bb2-db0e-11ef-a66f-a0d3651f611f"},{"link_death_year":441,"link_td_description":"拓跋健，魏明元帝拓跋嗣第五子，生母尹夫人，北魏宗室、官员。","link_td_id":"Q10011821","link_td_number_id":1365063,"people_name":"健","people_name_jianti_auto":"健","people_xingming":"拓跋健","start_index":13,"tongjian_id":"a8137bb3-db0e-11ef-87ed-a0d3651f611f"},{"link_death_year":434,"link_td_description":"白龙，北魏山胡起事首领。","link_td_id":"Q10015747","link_td_number_id":3595785,"people_name":"白龍","people_name_jianti_auto":"白龙","people_xingming":"白龙","start_index":18,"tongjian_id":"a8137bb4-db0e-11ef-bea7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":9,"tongjian_id":"a8137bb5-db0e-11ef-8998-a0d3651f611f"},{"place_name":"山胡","place_name_jianti_auto":"山胡","resolved_place_entity_id":2117,"start_index":16,"tongjian_id":"a8137bb6-db0e-11ef-9811-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","resolved_place_entity_id":563,"start_index":23,"tongjian_id":"a8137bb7-db0e-11ef-8e5f-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"8秋，七月，戊子，魏永昌王健等討山胡白龍餘黨於西河，滅之。","content_fanyi":"秋季，七月十五日戊子，北魏永昌王拓跋健等人讨伐盘踞在西河的山胡酋长白龙余党，将他们彻底消灭。","content_jianti_auto":"8秋，七月，戊子，魏永昌王健等讨山胡白龙余党于西河，灭之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11373,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"a8130674-db0e-11ef-972a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":7,"tongjian_id":"a8137bb9-db0e-11ef-aa2c-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","resolved_place_entity_id":224,"start_index":10,"tongjian_id":"a8137bba-db0e-11ef-bae0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9八月，甲辰，魏主如河西；九月，甲申，還宮。","content_fanyi":"八月甲辰日，即八月初一，北魏主拓跋焘前往河西；九月甲申日，即九月十二日，拓跋焘返回宫中。","content_jianti_auto":"9八月，甲辰，魏主如河西；九月，甲申，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11374,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"a8137bb8-db0e-11ef-837f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"鎭西大將軍","official_note":"鎭西大將軍是魏國授予吐谷渾王慕利延的軍事職銜，表示對其西部邊疆的軍事統轄權。在《資治通鑑》中，此類封號常用於安撫或拉攏周邊民族首領，以維護邊境穩定。","official_rank":"未知","source_snippet":"拜吐谷渾王慕利延爲鎭西大將軍","start_index":15,"tongjian_id":"74c4b21c-9a33-4ed7-90d2-3d479f5e2051"},{"confidence":0.9,"official_category":"榮譽虛銜","official_name":"儀同三司","official_note":"儀同三司是魏國授予吐谷渾王慕利延的榮譽官銜，意為儀制同於三公（太尉、司徒、司空），常用於加封功臣或外藩首領以示尊崇。在上下文中，此銜與鎭西大將軍一同授予，以強化對吐谷渾的籠絡。","official_rank":"未知","source_snippet":"儀同三司","start_index":24,"tongjian_id":"760045d8-a0b9-478a-86e7-bd912ee6ea06"},{"confidence":0.85,"official_category":"封爵","official_name":"西平王","official_note":"西平王是魏國改封吐谷渾王慕利延的爵位，屬於地方藩王封號。在《資治通鑑》中，此類改封常出於政治考量，如調整藩屬關係或獎賞功績，以鞏固中央對邊疆的控制。","official_rank":"王爵","source_snippet":"改封西平王","start_index":28,"tongjian_id":"744706b4-4f27-44f2-92e2-27b951308b53"}],"ExtRef_Children_people":[{"link_death_year":452,"link_td_description":"慕利延，又作慕延、没利延，封西平王，为4－6世纪建立之吐谷浑第十一任统治者，他为乌纥堤的儿子，惠王慕璝弟弟，承袭慕璝担任首领。","link_td_id":"Q10003174","link_td_number_id":361430,"people_name":"吐谷渾王","people_name_jianti_auto":"吐谷浑王","people_xingming":"慕容慕利延","start_index":11,"tongjian_id":"a8137bbc-db0e-11ef-ad71-a0d3651f611f","wl_zhushi":"[慕容]"},{"link_death_year":452,"link_td_description":"慕利延，又作慕延、没利延，封西平王，为4－6世纪建立之吐谷浑第十一任统治者，他为乌纥堤的儿子，惠王慕璝弟弟，承袭慕璝担任首领。","link_td_id":"Q10003174","link_td_number_id":361430,"people_name":"慕利延","people_name_jianti_auto":"慕利延","people_xingming":"慕容慕利延","start_index":15,"tongjian_id":"a8137bbd-db0e-11ef-b64f-a0d3651f611f"},{"link_death_year":452,"link_td_description":"慕利延，又作慕延、没利延，封西平王，为4－6世纪建立之吐谷浑第十一任统治者，他为乌纥堤的儿子，惠王慕璝弟弟，承袭慕璝担任首领。","link_td_id":"Q10003174","link_td_number_id":361430,"people_name":"西平王","people_name_jianti_auto":"西平王","people_xingming":"慕容慕利延","start_index":32,"tongjian_id":"a8137bbe-db0e-11ef-916d-a0d3651f611f","wl_zhushi":"[慕容]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":5,"tongjian_id":"a8137bbf-db0e-11ef-9670-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","人事"],"content":"10丁酉，魏主遣使者拜吐谷渾王慕利延爲鎭西大將軍、儀同三司，改封西平王。","content_fanyi":"九月二十五日丁酉，北魏主拓跋焘令使节出访吐谷浑汗国，把刚刚登上王位的吐谷浑可汗慕容慕利延正式册命为镇西大将军、仪同三司，又改授西平王的封号。","content_jianti_auto":"10丁酉，魏主遣使者拜吐谷浑王慕利延为镇西大将军、仪同三司，改封西平王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11375,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"a8137bbb-db0e-11ef-b466-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":10,"tongjian_id":"a8137bc1-db0e-11ef-9a35-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","resolved_place_entity_id":379,"start_index":13,"tongjian_id":"a8137bc2-db0e-11ef-b2d6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"11冬，十月，癸卯，魏主如雲中；十一月，壬申，還宮。","content_fanyi":"冬季十月的癸卯日，北魏主前往云中；十一月壬申日，返回宫中。","content_jianti_auto":"11冬，十月，癸卯，魏主如云中；十一月，壬申，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11376,"number":11,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"a8137bc0-db0e-11ef-865d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":25,"source_start_index":19,"source_text":"見上卷十二年","target_paragraph_tongjian_id":"a7fe5faf-db0e-11ef-8642-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下不復、爲復同。九國入貢，見上卷十二年。","note_content_jianti_auto":"复，扶又翻；下不复、为复同。九国入贡，见上卷十二年。","note_type":"hu_note","start_index":29,"tongjian_id":"a8137bc4-db0e-11ef-b8fe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"E