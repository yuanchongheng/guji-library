7-a0d3651f611f"},{"people_name":"琬","people_name_jianti_auto":"琬","people_xingming":"董琬","start_index":29,"tongjian_id":"a8137bd3-db0e-11ef-95f4-a0d3651f611f"},{"people_name":"琬","people_name_jianti_auto":"琬","people_xingming":"董琬","start_index":81,"tongjian_id":"a8137bd7-db0e-11ef-bd8e-a0d3651f611f"},{"people_name":"明","people_name_jianti_auto":"明","people_xingming":"高明","start_index":87,"tongjian_id":"a8137bd8-db0e-11ef-bcf6-a0d3651f611f"},{"people_name":"琬","people_name_jianti_auto":"琬","people_xingming":"董琬","start_index":102,"tongjian_id":"a8137bd9-db0e-11ef-803b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":2,"tongjian_id":"a8137bd1-db0e-11ef-ac80-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":21,"tongjian_id":"a8137bd2-db0e-11ef-bc0b-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":32,"tongjian_id":"a8137bd4-db0e-11ef-b651-a0d3651f611f"},{"place_name":"破落那","place_name_jianti_auto":"破落那","resolved_place_entity_id":5080,"start_index":43,"tongjian_id":"a8137bd5-db0e-11ef-8492-a0d3651f611f"},{"place_name":"者舌","place_name_jianti_auto":"者舌","resolved_place_entity_id":8770,"start_index":47,"tongjian_id":"a8137bd6-db0e-11ef-89af-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":58,"tongjian_id":"a8137bda-db0e-11ef-b391-a0d3651f611f"},{"place_name":"破落那","place_name_jianti_auto":"破落那","resolved_place_entity_id":5080,"start_index":83,"tongjian_id":"a8137bdb-db0e-11ef-8610-a0d3651f611f"},{"place_name":"者舌","place_name_jianti_auto":"者舌","resolved_place_entity_id":8770,"start_index":89,"tongjian_id":"a8137bdc-db0e-11ef-98fa-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"十四年，魏遣使董琬如乌孙。其后并于突厥。○呼揭国城，在乌...","context_before":"...之垫隘处也。昆弥，即乌孙王号。后汉建初五年，复招慰乌孙。","source_end_index":205,"source_paragraph_tongjian_id":"624b35da-0b41-5e76-a9dd-29fc29347809","source_start_index":191,"source_text":"宋元嘉十六年，乌孙入贡于魏。"},{"context_after":"其后并于突厥。○呼揭国城，在乌孙西北。文帝六年，匈奴遗汉...","context_before":"...。后汉建初五年，复招慰乌孙。宋元嘉十六年，乌孙入贡于魏。","source_end_index":218,"source_paragraph_tongjian_id":"624b35da-0b41-5e76-a9dd-29fc29347809","source_start_index":205,"source_text":"十四年，魏遣使董琬如乌孙。"},{"context_after":"《北史》：破落那即汉大宛，去代万四千四百五十里。《唐史》...","context_before":"...别部也。晋咸康中，代王什翼犍之地，东自秽貊，西及破落那。","source_end_index":63,"source_paragraph_tongjian_id":"16346c30-f6db-5cfa-98a8-d4519c672b55","source_start_index":48,"source_text":"宋元嘉十四年，破落那入贡于魏。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["外交"],"content":"12魏主復遣散騎侍郞董琬、高明等多齎金帛使西域，招撫九國。琬等至烏孫，其王甚喜，曰：「破落那、者舌二國皆欲稱臣致貢於魏，但無路自致耳，今使君宜過撫之。」乃遣導譯送琬詣破落那，明詣者舌。旁國聞之，爭遣使者隨琬等入貢，凡十六國，自是每歲朝貢不絕。","content_fanyi":"北魏主拓跋焘又派遣散骑侍郎董琬、高明等人携带大批金银绸缎出使西域，招抚西域九国。董琬等人到达乌孙，乌孙王十分高兴，说：“破落那、者舌两国也都想向魏国称臣进贡，只是没有门路可以自行表达，如今二位使君应当绕道前往安抚他们。”于是乌孙王特地派出向导和翻译，分别送董琬到破落那、高明到者舌。邻近各国听说后，争相派遣使臣跟随董琬等人入北魏朝贡，共有十六国之多。从此以后，西域各国每年都到北魏朝贡，从不间断。","content_jianti_auto":"12魏主复遣散骑侍郞董琬、高明等多赍金帛使西域，招抚九国。琬等至乌孙，其王甚喜，曰：「破落那、者舌二国皆欲称臣致贡于魏，但无路自致耳，今使君宜过抚之。」乃遣导译送琬诣破落那，明诣者舌。旁国闻之，争遣使者随琬等入贡，凡十六国，自是每岁朝贡不绝。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11377,"number":12,"reading_annotation_sources":[],"start_index":11,"tongjian_id":"a8137bc3-db0e-11ef-9573-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"a8137be1-db0e-11ef-953f-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":28,"tongjian_id":"a8137be2-db0e-11ef-9569-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":32,"tongjian_id":"a8137be3-db0e-11ef-81b2-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":36,"tongjian_id":"a8137be4-db0e-11ef-927b-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十一行本「公」上有「其母及」三字；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：甲十一行本「公」上有「其母及」三字；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"a8137be0-db0e-11ef-bf34-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":34,"tongjian_id":"a8137bdf-db0e-11ef-a5ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋之義，母以子貴。禮記：婦人無爵，從夫之爵。","note_content_jianti_auto":"春秋之义，母以子贵。礼记：妇人无爵，从夫之爵。","note_type":"hu_note","start_index":61,"tongjian_id":"a8137be5-db0e-11ef-a453-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"河西王","official_note":"河西王是十六国时期北凉政权的君主称号，此处指牧犍，在文中作为魏主的妹夫和封国统治者，涉及外交和婚姻关系。","official_rank":"王爵","source_snippet":"河西王牧犍","start_index":12,"tongjian_id":"3dd7de3b-3c10-4a96-8be0-b9be5362f97b"},{"confidence":0.85,"official_category":"宫廷","official_name":"王后","official_note":"王后是国王的正妻称号，此处指武威公主在河西国应被称为王后，反映了古代婚姻和封国礼仪。","official_rank":"王爵配偶","source_snippet":"稱王后","start_index":68,"tongjian_id":"4b04f76b-2ad3-42a3-8319-0d457b6ccde4"},{"confidence":0.8,"official_category":"宫廷","official_name":"公主","official_note":"公主是皇帝女儿的称号，此处指武威公主在京师（平城）仍保持公主身份，体现了双重身份在政治联姻中的作用。","official_rank":"皇室成员","source_snippet":"稱公主","start_index":78,"tongjian_id":"f17b3cf1-f3a6-4440-b