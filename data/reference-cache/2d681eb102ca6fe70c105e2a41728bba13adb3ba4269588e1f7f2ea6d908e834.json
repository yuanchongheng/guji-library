11f"},{"place_name":"平城","place_name_jianti_auto":"平城","resolved_place_entity_id":277,"start_index":27,"tongjian_id":"a8137bee-db0e-11ef-acfb-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":39,"tongjian_id":"a8137bef-db0e-11ef-8af3-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":64,"start_index":82,"tongjian_id":"a8137bf2-db0e-11ef-9e0f-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":90,"tongjian_id":"a8137bf3-db0e-11ef-a052-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"13魏主以其妹武威公主妻河西王牧犍，河西王遣宋繇奉表詣平城謝，且問公主所宜稱。魏主使羣臣議之，皆曰：「母以子貴，妻從夫爵。牧犍母宜稱河西國太后，公主於其國稱王后，於京師則稱公主。」魏主從之。","content_fanyi":"北魏主拓跋焘把妹妹武威公主嫁给北凉王沮渠牧犍为妻。北凉王沮渠牧犍派右相宋繇携带奏表前往平城谢恩，并请示今后应如何称呼武威公主。拓跋焘让群臣商议，大家一致认为：“母亲凭儿子而尊贵，妻子的称号随丈夫的爵位而定。沮渠牧犍的母亲应称河西国太后，公主在河西国内称王后，在京师则称公主。”拓跋焘采纳了这一意见。","content_jianti_auto":"13魏主以其妹武威公主妻河西王牧犍，河西王遣宋繇奉表诣平城谢，且问公主所宜称。魏主使群臣议之，皆曰：「母以子贵，妻从夫爵。牧犍母宜称河西国太后，公主于其国称王后，于京师则称公主。」魏主从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11378,"number":13,"reading_annotation_sources":[],"start_index":12,"tongjian_id":"a8137bdd-db0e-11ef-8fcf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":19,"source_start_index":6,"source_text":"見一百十九卷營陽王景平元年","target_paragraph_tongjian_id":"a6deb856-db0e-11ef-a564-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"李寶","people_name_jianti_auto":"李宝","start_index":0,"tongjian_id":"a8137bf6-db0e-11ef-9d63-a0d3651f611f"},{"people_name":"營陽王","people_name_jianti_auto":"营阳王","start_index":12,"tongjian_id":"a8137bf7-db0e-11ef-834a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"伊吾","place_name_jianti_auto":"伊吾","start_index":3,"tongjian_id":"a8137bf8-db0e-11ef-9c0d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李寶奔伊吾，見一百十九卷營陽王景平元年。","note_content_jianti_auto":"李宝奔伊吾，见一百十九卷营阳王景平元年。","note_type":"hu_note","start_index":83,"tongjian_id":"a8137bf5-db0e-11ef-94da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"尹氏","people_name_jianti_auto":"尹氏","start_index":2,"tongjian_id":"a8137bfa-db0e-11ef-865d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言尹氏義烈。紿，蕩亥翻。幾，居豈翻。復，扶又翻。騎，奇寄翻。卒，子恤翻。","note_content_jianti_auto":"史言尹氏义烈。绐，荡亥翻。几，居岂翻。复，扶又翻。骑，奇寄翻。卒，子恤翻。","note_type":"hu_note","start_index":200,"tongjian_id":"a8137bf9-db0e-11ef-b86e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":447,"link_td_description":"沮渠牧犍，一名茂虔，匈奴支系卢水胡族人，沮渠蒙逊之子，十六国时期北凉国末代君主。","link_td_id":"Q10000517","link_td_number_id":208089,"people_name":"牧犍","people_name_jianti_auto":"牧犍","people_xingming":"沮渠牧犍","start_index":2,"tongjian_id":"a8137bfb-db0e-11ef-be2c-a0d3651f611f"},{"link_birth_year":351,"link_death_year":417,"link_td_description":"涼武昭王李暠，字玄盛，小字長生，陇西郡狄道县（今甘肃省定西市临洮县）人，十六國時期西涼的建立者，唐朝皇室和诗人李白皆稱李暠為其先祖。天宝二年（743），唐玄宗追尊李暠为兴圣皇帝。","link_td_id":"Q10000878","link_td_number_id":207634,"people_name":"武昭王","people_name_jianti_auto":"武昭王","people_xingming":"李暠","start_index":6,"tongjian_id":"a8137bfc-db0e-11ef-aed3-a0d3651f611f","wl_zhushi":"[李暠]"},{"people_name":"李氏","people_name_jianti_auto":"李氏","people_xingming":"李氏","start_index":18,"tongjian_id":"a8137bfd-db0e-11ef-b28a-a0d3651f611f"},{"people_name":"尹氏","people_name_jianti_auto":"尹氏","people_xingming":"尹氏","start_index":23,"tongjian_id":"a8137bfe-db0e-11ef-a3cd-a