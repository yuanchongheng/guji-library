ople_name_jianti_auto":"王滔","people_xingming":"王滔","start_index":65,"tongjian_id":"bd99152d-db0e-11ef-94aa-a0d3651f611f"},{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","start_index":73,"tongjian_id":"bd99152f-db0e-11ef-b064-a0d3651f611f"},{"people_name":"靈詧","people_name_jianti_auto":"灵詧","start_index":76,"tongjian_id":"bd991530-db0e-11ef-9608-a0d3651f611f"},{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","start_index":81,"tongjian_id":"bd991531-db0e-11ef-a688-a0d3651f611f"},{"link_death_year":757,"link_td_description":"程千里，唐代京兆万年县人，身高七尺，勇猛有力，官至安西副都护、河东节度副使、上黨郡长史。","link_td_id":"Q10014251","link_td_number_id":2750367,"people_name":"千里","people_name_jianti_auto":"千里","people_xingming":"程千里","start_index":85,"tongjian_id":"bd991532-db0e-11ef-83d3-a0d3651f611f"},{"link_td_description":"毕思琛是一名突厥人，出身于西域毕国（今乌兹别克境内）。担任过安西四镇节度使夫蒙灵詧押衙（内营管理者）、大将军、特进。安史之乱时，原被遣往防守东都洛阳，后降于安禄山，转为叛军将领。","link_td_id":"Q10022526","link_td_number_id":7778828,"people_name":"思琛","people_name_jianti_auto":"思琛","people_xingming":"毕思琛","start_index":88,"tongjian_id":"bd991533-db0e-11ef-866f-a0d3651f611f"},{"people_name":"滔","people_name_jianti_auto":"滔","people_xingming":"王滔","start_index":110,"tongjian_id":"bd991534-db0e-11ef-a0a9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"安西","place_name_jianti_auto":"安西","resolved_place_entity_id":505,"start_index":13,"tongjian_id":"bd991526-db0e-11ef-9f4f-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":217,"start_index":51,"tongjian_id":"bd99152e-db0e-11ef-bb9d-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"唐击小勃律之战","tongjian_id":"war_N1003"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"1十二月，己巳，上以仙芝爲安西四鎭節度使，徵靈詧入朝，靈詧大懼。仙芝見靈詧，趨走如故，靈詧益懼。副都護京兆程千里、押牙畢思琛及行官王滔等，皆平日構仙芝於靈詧者也，仙芝面責千里、思琛曰：「公面如男子，心如婦人，何也？」又捽滔等，欲笞之，旣而皆釋之，謂曰：「吾素所恨於汝者，欲不言，恐汝懷憂；今旣言之，則無事矣。」軍中乃安。","content_fanyi":"十二月己巳日，玄宗任命高仙芝为安西四镇节度使，征召夫蒙灵詧入朝，夫蒙灵詧极为恐惧。高仙芝见到夫蒙灵詧，仍照旧小步快走，夫蒙灵詧更加恐惧。副都护京兆人程千里、押牙毕思琛以及行官王滔等人，都是平时在夫蒙灵詧面前构陷高仙芝的人。高仙芝当面斥责程千里、毕思琛说：“你们外貌像男子，内心却像妇人，这是为什么？”又揪住王滔等人，准备鞭打他们，随后又全都释放了，对他们说：“我平时对你们所怀的怨恨，本想不说出来，怕你们心中忧惧；如今已经说了，也就没有事了。”军中于是安定。","content_jianti_auto":"1十二月，己巳，上以仙芝为安西四镇节度使，征灵詧入朝，灵詧大惧。仙芝见灵詧，趋走如故，灵詧益惧。副都护京兆程千里、押牙毕思琛及行官王滔等，皆平日构仙芝于灵詧者也，仙芝面责千里、思琛曰：「公面如男子，心如妇人，何也？」又捽滔等，欲笞之，既而皆释之，谓曰：「吾素所恨于汝者，欲不言，恐汝怀忧；今既言之，则无事矣。」军中乃安。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21803,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"bd96ca90-db0e-11ef-8cd7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"傔，苦念翻。離，力智翻；下離席同。","note_content_jianti_auto":"傔，苦念翻。离，力智翻；下离席同。","note_type":"hu_note","start_index":60,"tongjian_id":"bd991537-db0e-11ef-bb2d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":1,"chapter_name":"本朝篇第一","chenzhu_chapter":"本朝谓父母国。人莫不有父母国，观其对本朝之称呼，即知其对父母国之厚薄。胡身之今本《通鉴注》，撰于宋亡以後，故《四库提要》称之为元人。然观其对宋朝之称呼，实未尝一日忘宋也。大抵全书自四十卷至二百三十二卷之间，恒称宋为“我朝”或“我宋”，而前後则率称“宋”或“宋朝”，吾颇疑为元末镂板时所改，其作内词者，身之原文也。试顺全书卷次，条举其例如下：","chenzhu_index_in_chapter":20,"chenzhu_text":"全注称宋为“本朝”者，自《避讳篇》外，始见于此。","created_at":"2025-12-31 08:50:44","seq_in_chapter":87,"tongjian_id":"CH01-CZ020"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"bd991539-db0e-11ef-aa87-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐諸使之屬，判官位次副使，盡總府事。又節度使或出征，或入朝，或死而未有代，皆有知留後事，其後遂以節度留後爲稱；至我朝遂以留後爲承宣使，資序未應建節者爲之。","note_content_jianti_auto":"唐诸使之属，判官位次副使，尽总府事。又节度使或出征，或入朝，或死而未有代，皆有知留后事，其后遂以节度留后为称；至我朝遂以留后为承宣使，资序未应建节者为之。","note_type":"hu_note","start_index":140,"tongjian_id":"bd991538-db0e-11ef-b232-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"使院，留後治事之所；節度使便坐治事，亦或就使院。使，疏吏翻。","note_content_jianti_auto":"使院，留后治事之所；节度使便坐治事，亦或就使院。使，疏吏翻。","note_type":"hu_note","start_index":192,"tongjian_id":"bd99153b-db0e-11ef-ad9c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高仙芝","people_name_jianti_auto":"高仙芝","start_index":9,"tongjian_id":"bd99153d-db0e-11ef-88f0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":13,"tongjian_id":"bd99153e-db0e-11ef-914a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"離，力智翻。中丞謂高仙芝。唐邊鎭諸帥或帶御史中丞、大夫時，隨其所帶官稱之。","note_content_jianti_auto":"离，力智翻。中丞谓高仙芝。唐边镇诸帅或带御史中丞、大夫时，随其所带官称之。","note_type":"hu_note","start_index":238,"tongjian_id":"bd99153c-db0e-11ef-a435-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蹔，與暫同。","note_content_jianti_auto":"𫏐，与暂同。","note_type":"hu_note","start_index":267,"tongjian_id":"bd99153f-db0e-11ef-b19a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"封常清","people_name_jianti_auto":"封常清","start_index":2,"tongjian_id":"bd991542-db0e-11ef-a782-a0d3651f611f"},{"people_name":"高仙芝","people_name_jianti_auto":"高仙芝","start_index":12,"tongjian_id":"bd991543-db0e-11ef-a40c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言封常清能治軍政，亦緣高仙芝不以私親撓法。惕，他歷翻。","note_content_jianti_auto":"史言封常清能治军政，亦缘高仙芝不以私亲挠法。惕，他历翻。","note_type":"hu_note","start_index":342,"tongjian_id":"bd991541-db0e-11ef-ab36-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"都知兵馬使","official_note":"都知兵馬使是唐代节度使下属的高级军事官职，负责统领兵马，此处指高仙芝担任此职，为后续情节铺垫。","official_rank":"未知","source_snippet":"仙芝爲都知兵馬使","start_index":2,"tongjian_id":"1743d8be-47fb-49c1-a80b-32f7a3b5b58c"},{"confidence":0.95,"official_category":"地方行政与军事","official_name":"節度使","official_note":"節度使是唐代中后期重要的地方军政长官，掌管一镇或数州的军事、行政和财政，此处高仙芝升任此职，显示其权力提升。","official_rank":"正三品或更高","source_snippet":"仙芝爲節度使","start_index":88,"tongjian_id":"0a7bd921-eeed-403d-957c-0a63a72dda49"},{"confidence":0.85,"official_category":"中枢机构或地方行政","official_name":"判官","official_note":"判官是唐代节度使、观察使等高级官员的僚属，负责处理文书和政务，此处封常清被任命为判官，协助高仙芝管理事务。","official_rank":"从五品至从七品","source_snippet":"卽署常清判官","start_index":92,"tongjian_id":"dba836fb-4b1a-4bd5-9974-708cb25aae88"},{"confidence":0.88,"official_category":"地方行政与军事","official_name":"留後","official_note":"留後是唐代节度使出征或离任时，临时代理其职务的官员，负责镇守后方，此处封常清常担任此职，显示其在高仙芝军中的重要地位。","official_rank":"未知","source_snippet":"常爲留後","start_index":98,"tongjian_id":"6268a2e3-182d-4eb5-8e37-eaf581ed2584"},{"confidence":0.9,"official_category":"军事指挥","official_name":"郞將","official_note":"郞將是唐代武官官职，通常为中低级军官，负责统领部分军队，此处郑德诠担任此职，因其与高仙芝的关系而显赫，引发后续冲突。","official_rank":"从五品","source_snippet":"鄭德詮爲郞將","start_index":108,"tongjian_id":"dc285d1b-53f4-476c-82aa-caf18b55e8a8"},{"confidence":0.8,"official_category":"监察","official_name":"中丞","official_note":"中丞是御史中丞的简称，唐代中央监察机构御史台的副长官，负责弹劾官员、监督政务，此处可能指高仙芝或其他上级官员以中丞身份任命封常清为留后，但原文未明确人物，仅作为官职引用。","official_rank":"正四品下","source_snippet":"今日中丞命爲留後","start_index":184,"tongjian_id":"ce700ce9-e974-43fe-87db-c1144115f41d"}],"ExtRef_Children_people":[{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","people_xingming":"高仙芝","start_index":2,"tongjian_id":"bd991544-db0e-11ef-818e-a0d3651f611f"},{"link_death_year":756,"link_td_description":"封常清，蒲州猗氏人（今山西临猗县），唐朝名将。","link_td_id":"Q10008188","link_td_number_id":133425,"people_name":"封常清","people_name_jianti_auto":"封常清","people_xingming":"封常清","start_index":14,"tongjian_id":"bd991545-db0e-11ef-a68e-a0d3651f611f"},{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","start_index":34,"tongjian_id":"bd991547-db0e-11ef-9666-a0d3651f611f"},{"link_death_year":756,"link_td_description":"封常清，蒲州猗氏人（今山西临猗县），唐朝名将。","link_td_id":"Q10008188","link_td_number_id":133425,"people_name":"常清","people_name_jianti_auto":"常清","people_xingming":"封常清","start_index":41,"tongjian_id":"bd991548-db0e-11ef-90cf-a0d3651f611f"},{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","start_index":45,"tongjian_id":"bd991549-db0e-11ef-8f92-a0d3651f611f"},{"link_death_year":756,"link_td_description":"高仙芝，高麗族，唐朝名將，爵至密云郡公。其生平活躍於唐玄宗時期，最著名的事蹟是率領唐軍於中亞與阿拉伯帝國展開怛罗斯战役。","link_td_id":"Q10008166","link_td_number_id":127211,"people_name":"仙芝","people_name_jianti_auto":"仙芝","start_index":60,"tongjian_id":"bd99154a-db0e-11ef-bc8e-a0d3651f611f"},{"people_name":"夫蒙靈詧","people_name_ji