{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚子、一○○）","note_content_jianti_auto":"（庚子、一○○）","note_type":"hu_note","start_index":0,"tongjian_id":"95a03b5c-db0e-11ef-b189-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95a03b5f-db0e-11ef-a98b-a0d3651f611f"},{"people_name":"袁山松","people_name_jianti_auto":"袁山松","start_index":21,"tongjian_id":"95a03b60-db0e-11ef-9108-a0d3651f611f"},{"people_name":"屈原","people_name_jianti_auto":"屈原","start_index":26,"tongjian_id":"95a03b61-db0e-11ef-8757-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秭歸縣","place_name_jianti_auto":"秭归县","start_index":3,"tongjian_id":"95a03b62-db0e-11ef-a55d-a0d3651f611f"},{"place_name":"南郡","place_name_jianti_auto":"南郡","start_index":8,"tongjian_id":"95a03b63-db0e-11ef-b2b2-a0d3651f611f"},{"place_name":"夔國","place_name_jianti_auto":"夔国","start_index":13,"tongjian_id":"95a03b64-db0e-11ef-8526-a0d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":17,"tongjian_id":"95a03b65-db0e-11ef-9537-a0d3651f611f"},{"place_name":"秭歸","place_name_jianti_auto":"秭归","start_index":52,"tongjian_id":"95a03b66-db0e-11ef-8f25-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：秭歸縣，屬南郡，古之夔國，今歸州也。袁山松曰：屈原此縣人，旣被流放，忽然蹔歸，其姊亦來，因名其地爲秭歸。秭，亦姊也，音蔣兕翻。","note_content_jianti_auto":"贤曰：秭归县，属南郡，古之夔国，今归州也。袁山松曰：屈原此县人，既被流放，忽然𫏐归，其姊亦来，因名其地为秭归。秭，亦姊也，音蒋兕翻。","note_type":"hu_note","start_index":14,"tongjian_id":"95a03b5e-db0e-11ef-b12e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秭歸","place_name_jianti_auto":"秭归","resolved_place_entity_id":2169,"start_index":9,"tongjian_id":"95a076ad-db0e-11ef-8055-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1夏，四月，戊辰，秭歸山崩。","content_fanyi":"夏季，四月十六日戊辰，秭归山发生山崩。","content_jianti_auto":"1夏，四月，戊辰，秭归山崩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3889,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"95a03b5d-db0e-11ef-984c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2秋，七月，辛亥朔，日有食之。","content_fanyi":"秋季，七月初一日辛亥朔，发生日食。","content_jianti_auto":"2秋，七月，辛亥朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3890,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"95a076ae-db0e-11ef-ab72-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处表示张酺被免去太尉职务。","official_rank":"正一品","source_snippet":"太尉張酺免","start_index":3,"tongjian_id":"1846bc57-a996-4d38-9974-e9ebae2551b3"},{"confidence":0.95,"official_category":"财政","official_name":"大司農","official_note":"大司农是汉代九卿之一，掌管国家财政和农业，此处表示张禹从大司农升任太尉。","official_rank":"正三品","source_snippet":"以大司農張禹爲太尉","start_index":12,"tongjian_id":"3df43bc2-3fc3-4f04-b51a-