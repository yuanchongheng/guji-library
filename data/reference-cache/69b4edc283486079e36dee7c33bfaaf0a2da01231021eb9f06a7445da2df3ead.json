{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":8,"tongjian_id":"90be4663-db0e-11ef-801e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（壬子、前六九）應劭曰：以先者地震，山崩、水出，於是改元曰地節，欲令地得其節。","note_content_jianti_auto":"（壬子、前六九）应劭曰：以先者地震，山崩、水出，于是改元曰地节，欲令地得其节。","note_type":"hu_note","start_index":0,"tongjian_id":"90be4662-db0e-11ef-b621-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"90be4664-db0e-11ef-a08b-a0d3651f611f","pinyin":"bèi","source_anchor_text":"正月有星孛於西方楚","source_key":"baiyang_epub","start_index":8,"text":"孛","tongjian_id":"4e0142cf-5883-5a9d-a2ab-4f9d8f59bd3f"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1春，正月，有星孛于西方。","content_fanyi":"春季，正月，有异星出现在西方天空。","content_jianti_auto":"1春，正月，有星孛于西方。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1991,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"90be4664-db0e-11ef-a08b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":0,"tongjian_id":"90be4668-db0e-11ef-a5de-a0d3651f611f"},{"people_name":"平陸侯","people_name_jianti_auto":"平陆侯","start_index":3,"tongjian_id":"90be4669-db