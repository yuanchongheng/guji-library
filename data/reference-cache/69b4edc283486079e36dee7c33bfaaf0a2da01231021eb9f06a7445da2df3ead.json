_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"胥","people_name_jianti_auto":"胥","start_index":9,"tongjian_id":"90be467d-db0e-11ef-8b6f-a0d3651f611f"},{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"武帝","people_name_jianti_auto":"武帝","people_xingming":"刘彻","start_index":11,"tongjian_id":"90be467e-db0e-11ef-8907-a0d3651f611f"},{"people_name":"趙何齊","people_name_jianti_auto":"赵何齐","people_xingming":"赵何齐","start_index":34,"tongjian_id":"90be467f-db0e-11ef-8670-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"廣陵王","people_name_jianti_auto":"广陵王","start_index":38,"tongjian_id":"90be4680-db0e-11ef-b65b-a0d3651f611f","wl_zhushi":"[刘胥]"},{"people_name":"何齊","people_name_jianti_auto":"何齐","people_xingming":"赵何齐","start_index":47,"tongjian_id":"90be4681-db0e-11ef-ac0d-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"廣陵王","people_name_jianti_auto":"广陵王","start_index":52,"tongjian_id":"90be4682-db0e-11ef-b551-a0d3651f611f","wl_zhushi":"[刘胥]"},{"people_name":"何齊","people_name_jianti_auto":"何齐","people_xingming":"赵何齐","start_index":71,"tongjian_id":"90be4683-db0e-11ef-830a-a0d3651f611f"},{"link_death_year":-69,"link_td_description":"刘延寿，汉朝宗室，西汉楚王。其高祖父刘礼是楚元王刘交的儿子。","link_td_id":"Q10012569","link_td_number_id":1489647,"people_name":"延壽","people_name_jianti_auto":"延寿","people_xingming":"刘延寿","start_index":97,"tongjian_id":"90be4684-db0e-11ef-93b7-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"胥","people_name_jianti_auto":"胥","people_xingming":"刘胥","start_index":102,"tongjian_id":"90be4685-db0e-11ef-a13f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2楚王延壽以廣陵王胥，武帝子，天下有變，必得立，陰附助之，爲其後母弟趙何齊取廣陵王女爲妻，因使何齊奉書遺廣陵王曰：「願長耳目，毋後人有天下！」何齊父長年上書告之，事下有司考驗，辭服。冬，十一月，延壽自殺。胥勿治。","content_fanyi":"楚王刘延寿认为广陵王刘胥是汉武帝的儿子，天下如有变故，一定会被立为皇帝，于是暗中依附并帮助他；他还为自己的后母的弟弟赵何齐娶了广陵王的女儿为妻，并让赵何齐捧着书信送给广陵王说：“希望您多设耳目，取得天下不要落在别人后头！”赵何齐的父亲赵长年上书朝廷告发此事，事情交给有关官员审理查验，刘延寿供认不讳。冬季，十一月，刘延寿自杀。刘胥则免予追究。","content_jianti_auto":"2楚王延寿以广陵王胥，武帝子，天下有变，必得立，阴附助之，为其后母弟赵何齐取广陵王女为妻，因使何齐奉书遗广陵王曰：「愿长耳目，毋后人有天下！」何齐父长年上书告之，事下有司考验，辞服。冬，十一月，延寿自杀。胥勿治。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1992,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"90be4666-db0e-11ef-8289-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3十二月，癸亥晦，日有食之。","content_fanyi":"十二月癸亥这天是月末，发生了日食。","content_jianti_auto":"3十二月，癸亥晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1993,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"90be4686-db0e-11ef-aad5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周武王","people_name_jianti_auto":"周武王","start_index":3,"tongjian_id":"90be4689-db0e-11ef-8800-a