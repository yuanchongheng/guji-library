{"data":{"current_mention_tongjian_id":"8bf67676-db0e-11ef-bc6c-a0d3651f611f","current_paragraph_tongjian_id":"8bf67664-db0e-11ef-b8a4-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":3,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"卜","people_name_jianti_auto":"卜","start_index":0,"tongjian_id":"8bf42ab4-db0e-11ef-b6b2-a0d3651f611f"},{"people_name":"田","people_name_jianti_auto":"田","start_index":7,"tongjian_id":"8bf42ab5-db0e-11ef-8cfd-a0d3651f611f"},{"people_name":"陳","people_name_jianti_auto":"陈","start_index":11,"tongjian_id":"8bf42ab6-db0e-11ef-90c8-a0d3651f611f"},{"people_name":"陳敬仲","people_name_jianti_auto":"陈敬仲","start_index":13,"tongjian_id":"8bf42ab7-db0e-11ef-9d38-a0d3651f611f"},{"people_name":"陳","people_name_jianti_auto":"陈","start_index":17,"tongjian_id":"8bf42ab8-db0e-11ef-960f-a0d3651f611f"},{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":19,"tongjian_id":"8bf42ab9-db0e-11ef-ae45-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":22,"tongjian_id":"8bf42aba-db0e-11ef-a1a1-a0d3651f611f"},{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":35,"tongjian_id":"8bf42abb-db0e-11ef-ba3c-a0d3651f611f"},{"people_name":"陳","people_name_jianti_auto":"陈","start_index":42,"tongjian_id":"8bf42abc-db0e-11ef-89d9-a0d3651f611f"},{"people_name":"田","people_name_jianti_auto":"田","start_index":44,"tongjian_id":"8bf42abd-db0e-11ef-a4a0-a0d3651f611f"},{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":52,"tongjian_id":"8bf42abe-db0e-11ef-9032-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卜，以官爲氏。田本出於陳，陳敬仲以陳爲田氏。徐廣曰：始食采地，由是改姓田氏。索隱曰：陳、田二聲相近，遂爲田氏。夏，戶雅翻。","note_content_jianti_auto":"卜，以官为氏。田本出于陈，陈敬仲以陈为田氏。徐广曰：始食采地，由是改姓田氏。索隐曰：陈、田二声相近，遂为田氏。夏，户雅翻。","note_type":"hu_note","start_index":14,"tongjian_id":"8bf42ab3-db0e-11ef-b965-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李耳","people_name_jianti_auto":"李耳","start_index":13,"tongjian_id":"8bf42ac1-db0e-11ef-a51f-a0d3651f611f"},{"people_name":"伯陽","people_name_jianti_auto":"伯阳","start_index":17,"tongjian_id":"8bf42ac2-db0e-11ef-9045-a0d3651f611f"},{"people_name":"耼","people_name_jianti_auto":"耼","start_index":22,"tongjian_id":"8bf42ac3-db0e-11ef-9d33-a0d3651f611f"},{"people_name":"李宗","people_name_jianti_auto":"李宗","start_index":27,"tongjian_id":"8bf42ac4-db0e-11ef-97e6-a0d3651f611f"},{"people_name":"段","people_name_jianti_auto":"段","start_index":33,"tongjian_id":"8bf42ac5-db0e-11ef-8823-a0d3651f611f"},{"people_name":"段","people_name_jianti_auto":"段","start_index":43,"tongjian_id":"8bf42ac6-db0e-11ef-aae7-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":53,"tongjian_id":"8bf42ac7-db0e-11ef-a3c2-a0d3651f611f"},{"people_name":"段干子","people_name_jianti_auto":"段干子","start_index":62,"tongjian_id":"8bf42ac8-db0e-11ef-8ef7-a0d3651f611f"},{"people_name":"段干","people_name_jianti_auto":"段干","start_index":67,"tongjian_id":"8bf42ac9-db0e-11ef-bd10-a0d3651f611f"},{"people_name":"武王","people_name_jianti_auto":"武王","start_index":76,"tongjian_id":"8bf42aca-db0e-11ef-ad29-a0d3651f611f"},{"people_name":"商容","people_name_jianti_auto":"商容","start_index":79,"tongjian_id":"8bf42acb-db0e-11ef-a216-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":127,"tongjian_id":"8bf42acc-db0e-11ef-8828-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":160,"tongjian_id":"8bf42acd-db0e-11ef-bafe-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":6,"tongjian_id":"8bf42ace-db0e-11ef-882e-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":30,"tongjian_id":"8bf42acf-db0e-11ef-993c-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":60,"tongjian_id":"8bf42ad0-db0e-11ef-9ac4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"過，工禾翻。唐人志氏族曰：李耳，字伯陽，一字耼；其後有李宗，魏封於段，爲干木大夫，是以段爲氏也。余按：通鑑赧王四十二年，魏有段干子，則段干，複姓也。書：武王式商容閭。註云：式其閭巷，以禮賢。記·曲禮：國君撫式，士下之。註云：升車必正立，據式小俛，崇敬也。師古曰：式，車前橫木。古者立乘；凡言式車者，謂俛首撫式，以禮敬人。孔穎達曰：式，謂俯下頭也。古者車箱長四尺四寸而三分，前一後二，橫一木，下去車牀三尺三寸，謂之爲式；又於式上二尺二寸橫一木，謂之較，較去車牀凡五尺五寸。於時立乘，若平常則憑較，故詩云「倚重較兮」是也。若應爲敬，則落隱下式，而頭得俯俛，故記云「式視馬尾」是也。較，訖岳翻。","note_content_jianti_auto":"过，工禾翻。唐人志氏族曰：李耳，字伯阳，一字耼；其后有李宗，魏封于段，为干木大夫，是以段为氏也。余按：通鉴赧王四十二年，魏有段干子，则段干，复姓也。书：武王式商容闾。注云：式其闾巷，以礼贤。记·曲礼：国君抚式，士下之。注云：升车必正立，据式小俛，崇敬也。师古曰：式，车前横木。古者立乘；凡言式车者，谓俛首抚式，以礼敬人。孔颖达曰：式，谓俯下头也。古者车箱长四尺四寸而三分，前一后二，横一木，下去车床三尺三寸，谓之为式；又于式上二尺二寸横一木，谓之较，较去车床凡五尺五寸。于时立乘，若平常则凭较，故诗云「倚重较兮」是也。若应为敬，则落隐下式，而头得俯俛，故记云「式视马尾」是也。较，讫岳翻。","note_type":"hu_note","start_index":24,"tongjian_id":"8bf42ac0-db0e-11ef-bbed-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"田子方","people_name_jianti_auto":"田子方","people_xingming":"田子方","start_index":8,"tongjian_id":"8bf42ada-db0e-11ef-bb76-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/卜子夏","excerpts":[{"context_after":"。按《史记》所书，子夏少孔子四十四岁，孔子卒时，子夏年二...","context_before":"","source_end_index":9,"source_paragraph_tongjian_id":"4b1e305c-9d40-4764-94a5-a5aa733b8bdd","source_start_index":0,"source_text":"魏文侯以卜子夏为师"}],"path":"续笔/卷二/卜子夏","source_name":"容斋随笔"}],"class_tags":[],"content":"魏文侯以卜子夏、田子方爲師。每過段干木之廬必式。四方賢士多歸之。","content_fanyi":"魏文侯魏斯尊崇卜子夏、田子方为老师。他每次经过段干木的庐舍，一定手扶车轼俯首致敬。四方贤士因此多来归附他。","content_jianti_auto":"魏文侯以卜子夏、田子方为师。每过段干木之庐必式。四方贤士多归之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":20,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 20 段","reading_annotation_sources":[],"start_index":19,"tongjian_id":"8bf42ab2-db0e-11ef-80a0-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000340"},"tongjian_id":"8bf42ab2-db0e-11ef-80a0-a0d3651f611f"},"paragraph_order":1},{"mention_count":3,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"比，音毗。不比，言不和也。","note_content_jianti_auto":"比，音毗。不比，言不和也。","note_type":"hu_note","start_index":19,"tongjian_id":"8bf64da2-db0e-11ef-a8fe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此蓋編鍾之懸，左高，故其聲不和。","note_content_jianti_auto":"此盖编钟之悬，左高，故其声不和。","note_type":"hu_note","start_index":23,"tongjian_id":"8bf64da3-db0e-11ef-883e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"明樂官，知其才不才；明樂音，知其和不和。五聲合和，然後成音。詩·大序曰：聲成文，謂之音。","note_content_jianti_auto":"明乐官，知其才不才；明乐音，知其和不和。五声合和，然后成音。诗·大序曰：声成文，谓之音。","note_type":"hu_note","start_index":71,"tongjian_id":"8bf64da4-db0e-11ef-92b5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"田子方","people_name_jianti_auto":"田子方","people_xingming":"田子方","start_index":3,"tongjian_id":"8bf64da7-db0e-11ef-a5df-a0d3651f611f"},{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"田子方","people_name_jianti_auto":"田子方","start_index":23,"tongjian_id":"8bf67660-db0e-11ef-82d0-a0d3651f611f"},{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"子方","people_name_jianti_auto":"子方","people_xingming":"田子方","start_index":37,"tongjian_id":"8bf67662-db0e-11ef-83a6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"文侯與田子方飲，文侯曰：「鍾聲不比乎？左高。」田子方笑。文侯曰：「何笑？」子方曰：「臣聞之，君明樂官，不明樂音。今君審於音，臣恐其聾於官也。」文侯曰：「善。」","content_fanyi":"魏文侯和田子方一起饮酒，魏文侯说：“编钟的声音好像不和谐，左边的音偏高。”田子方听后笑了。魏文侯问：“你笑什么？”田子方说：“臣听说，国君应当明察并追究乐官，不必去审订乐音。现在您对乐音明察秋毫，我担心您对乐官的管理会松懈失察。”魏文侯说：“你说得好。”","content_jianti_auto":"文侯与田子方饮，文侯曰：「钟声不比乎？左高。」田子方笑。文侯曰：「何笑？」子方曰：「臣闻之，君明乐官，不明乐音。今君审于音，臣恐其聋于官也。」文侯曰：「善。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":24,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 24 段","reading_annotation_sources":[],"start_index":23,"tongjian_id":"8bf42b1f-db0e-11ef-8a56-a0d3651f611f","year_int":-403},"tongjian_id":"8bf42b1f-db0e-11ef-8a56-a0d3651f611f"},"paragraph_order":2},{"mention_count":4,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":6,"tongjian_id":"8bf67666-db0e-11ef-aa2e-a0d3651f611f"},{"people_name":"少昊氏","people_name_jianti_auto":"少昊氏","start_index":16,"tongjian_id":"8bf67667-db0e-11ef-a99d-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":22,"tongjian_id":"8bf67668-db0e-11ef-9cca-a0d3651f611f"},{"people_name":"奚仲","people_name_jianti_auto":"奚仲","start_index":24,"tongjian_id":"8bf67669-db0e-11ef-97d8-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":38,"tongjian_id":"8bf6766a-db0e-11ef-bf21-a0d3651f611f"},{"people_name":"蕭子顯","people_name_jianti_auto":"萧子显","start_index":60,"tongjian_id":"8bf6766b-db0e-11ef-9e68-a0d3651f611f"},{"people_name":"三皇氏","people_name_jianti_auto":"三皇氏","start_index":65,"tongjian_id":"8bf6766c-db0e-11ef-8f57-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":49,"tongjian_id":"8bf6766d-db0e-11ef-9b47-a0d3651f611f"},{"place_name":"谷口","place_name_jianti_auto":"谷口","start_index":72,"tongjian_id":"8bf6766e-db0e-11ef-a7d4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古文史考曰：黃帝作車，引重致遠；少昊氏加牛；禹時奚仲加馬。釋名曰：車，居也。韋昭曰：古唯尺遮翻，自漢以來，始有「居」音。蕭子顯曰：三皇氏乘祇車出谷口，車之始也。祇，翹移翻。","note_content_jianti_auto":"古文史考曰：黄帝作车，引重致远；少昊氏加牛；禹时奚仲加马。释名曰：车，居也。韦昭曰：古唯尺遮翻，自汉以来，始有「居」音。萧子显曰：三皇氏乘祇车出谷口，车之始也。祇，翘移翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8bf67665-db0e-11ef-9ece-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"田子方","people_name_jianti_auto":"田子方","people_xingming":"田子方","start_index":5,"tongjian_id":"8bf67673-db0e-11ef-aadd-a0d3651f611f"},{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"子方","people_name_jianti_auto":"子方","people_xingming":"田子方","start_index":16,"tongjian_id":"8bf67674-db0e-11ef-aad5-a0d3651f611f"},{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"子方","people_name_jianti_auto":"子方","people_xingming":"田子方","start_index":27,"tongjian_id":"8bf67676-db0e-11ef-bc6c-a0d3651f611f"},{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"子方","people_name_jianti_auto":"子方","people_xingming":"田子方","start_index":47,"tongjian_id":"8bf67677-db0e-11ef-91a4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"子擊出，遭田子方於道，下車伏謁。子方不爲禮。子擊怒，謂子方曰：「富貴者驕人乎？貧賤者驕人乎？」子方曰：「亦貧賤者驕人耳，富貴者安敢驕人！國君而驕人則失其國，大夫而驕人則失其家。失其國者未聞有以國待之者也，失其家者未聞有以家待之者也。夫士貧賤者，言不用，行不合，則納履而去耳，安往而不得貧賤哉！」子擊乃謝之。","content_fanyi":"魏文侯的儿子魏击一次外出，在路上遇到田子方，便下车伏地拜见问好。田子方却不回礼。魏击大怒，对田子方说：“是富贵的人能傲慢待人呢，还是贫贱的人能傲慢待人呢？”田子方说：“只是贫贱的人才能对人傲慢罢了，富贵的人哪里敢对人傲慢呢！身为国君如果傲慢待人，就会失去他的国家；身为大夫如果傲慢待人，就会失去他的封邑。失去国家的人，从没听说有人会以国君之礼对待他；失去封邑的人，也从没听说有人会以大夫之礼对待他。至于那些贫贱的士人，进言不被采用，行事不合人意，就穿上鞋子离开罢了，到哪里还不都是贫贱呢！”魏击于是向田子方道歉。","content_jianti_auto":"子击出，遭田子方于道，下车伏谒。子方不为礼。子击怒，谓子方曰：「富贵者骄人乎？贫贱者骄人乎？」子方曰：「亦贫贱者骄人耳，富贵者安敢骄人！国君而骄人则失其国，大夫而骄人则失其家。失其国者未闻有以国待之者也，失其家者未闻有以家待之者也。夫士贫贱者，言不用，行不合，则纳履而去耳，安往而不得贫贱哉！」子击乃谢之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"8bf67664-db0e-11ef-b8a4-a0d3651f611f","year_int":-403},"tongjian_id":"8bf67664-db0e-11ef-b8a4-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":0,"tongjian_id":"8bf6767b-db0e-11ef-90eb-a0d3651f611f"},{"people_name":"顓頊","people_name_jianti_auto":"颛顼","start_index":4,"tongjian_id":"8bf6767c-db0e-11ef-9555-a0d3651f611f"},{"people_name":"皋陶","people_name_jianti_auto":"皋陶","start_index":8,"tongjian_id":"8bf6767d-db0e-11ef-af6b-a0d3651f611f"},{"people_name":"堯","people_name_jianti_auto":"尧","start_index":12,"tongjian_id":"8bf6767e-db0e-11ef-af11-a0d3651f611f"},{"people_name":"理氏","people_name_jianti_auto":"理氏","start_index":21,"tongjian_id":"8bf6767f-db0e-11ef-9088-a0d3651f611f"},{"people_name":"商紂","people_name_jianti_auto":"商纣","start_index":24,"tongjian_id":"8bf67680-db0e-11ef-a6ff-a0d3651f611f"},{"people_name":"利貞","people_name_jianti_auto":"利贞","start_index":30,"tongjian_id":"8bf67681-db0e-11ef-afdf-a0d3651f611f"},{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":43,"tongjian_id":"8bf67682-db0e-11ef-8898-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李氏出自顓頊曾孫皋陶，爲堯大理，以官命族爲理氏。商紂時，裔孫利貞逃難，食木子得全，改爲李氏。置，言置相也。相，息亮翻。難，乃旦翻。","note_content_jianti_auto":"李氏出自颛顼曾孙皋陶，为尧大理，以官命族为理氏。商纣时，裔孙利贞逃难，食木子得全，改为李氏。置，言置相也。相，息亮翻。难，乃旦翻。","note_type":"hu_note","start_index":43,"tongjian_id":"8bf6767a-db0e-11ef-bf9d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"在闕門之外，謂疏遠也。","note_content_jianti_auto":"在阙门之外，谓疏远也。","note_type":"hu_note","start_index":70,"tongjian_id":"8bf67683-db0e-11ef-9270-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8bf67686-db0e-11ef-80f9-a0d3651f611f"},{"people_name":"吳起","people_name_jianti_auto":"吴起","start_index":50,"tongjian_id":"8bf67687-db0e-11ef-9fca-a0d3651f611f"},{"people_name":"惠王","people_name_jianti_auto":"惠王","start_index":63,"tongjian_id":"8bf67688-db0e-11ef-8205-a0d3651f611f"},{"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","start_index":69,"tongjian_id":"8bf67689-db0e-11ef-b9f9-a0d3651f611f"},{"people_name":"公子卬","people_name_jianti_auto":"公子卬","start_index":75,"tongjian_id":"8bf6768a-db0e-11ef-8b47-a0d3651f611f"},{"people_name":"吳","people_name_jianti_auto":"吴","start_index":88,"tongjian_id":"8bf6768b-db0e-11ef-be68-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":3,"tongjian_id":"8bf6768c-db0e-11ef-b3ea-a0d3651f611f"},{"place_name":"高陵","place_name_jianti_auto":"高陵","start_index":9,"tongjian_id":"8bf6768d-db0e-11ef-83b3-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":15,"tongjian_id":"8bf6768e-db0e-11ef-a505-a0d3651f611f"},{"place_name":"河內","place_name_jianti_auto":"河内","start_index":18,"tongjian_id":"8bf6768f-db0e-11ef-8609-a0d3651f611f"},{"place_name":"高陵縣","place_name_jianti_auto":"高陵县","start_index":21,"tongjian_id":"8bf67690-db0e-11ef-a1d1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":25,"tongjian_id":"8bf67691-db0e-11ef-8a6e-a0d3651f611f"},{"place_name":"馮翊","place_name_jianti_auto":"冯翊","start_index":27,"tongjian_id":"8bf67692-db0e-11ef-9662-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","start_index":33,"tongjian_id":"8bf67693-db0e-11ef-a216-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","place_note":"黃河西岸，陝西東部","start_index":39,"tongjian_id":"8bf67694-db0e-11ef-b0bf-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":47,"tongjian_id":"8bf67695-db0e-11ef-9ab7-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府雍县，陕西凤翔","start_index":55,"tongjian_id":"8bf67696-db0e-11ef-b597-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府雍县，陕西凤翔","start_index":67,"tongjian_id":"8bf67697-db0e-11ef-aaf5-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","start_index":81,"tongjian_id":"8bf67698-db0e-11ef-bbd4-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":86,"tongjian_id":"8bf67699-db0e-11ef-8b6b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：魏地，其界自高陵以東，盡河東、河內。高陵縣，漢屬馮翊，其地在河西，所謂「西河之外」者也。魏初使吳起守之，秦兵不敢東向。至惠王時，秦使衞鞅擊虜其將公子卬，遂獻西河之外於秦。吳，以國爲姓。相，息亮翻。守，式又翻。","note_content_jianti_auto":"班志：魏地，其界自高陵以东，尽河东、河内。高陵县，汉属冯翊，其地在河西，所谓「西河之外」者也。魏初使吴起守之，秦兵不敢东向。至惠王时，秦使衞鞅击虏其将公子卬，遂献西河之外于秦。吴，以国为姓。相，息亮翻。守，式又翻。","note_type":"hu_note","start_index":214,"tongjian_id":"8bf67685-db0e-11ef-a42e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8bf6769c-db0e-11ef-91bb-a0d3651f611f"},{"people_name":"西門豹","people_name_jianti_auto":"西门豹","start_index":9,"tongjian_id":"8bf6769d-db0e-11ef-9c79-a0d3651f611f"},{"people_name":"東門","people_name_jianti_auto":"东门","start_index":35,"tongjian_id":"8bf6769e-db0e-11ef-ba97-a0d3651f611f"},{"people_name":"西郭","people_name_jianti_auto":"西郭","start_index":38,"tongjian_id":"8bf6769f-db0e-11ef-897f-a0d3651f611f"},{"people_name":"南宮","people_name_jianti_auto":"南宫","start_index":41,"tongjian_id":"8bf676a0-db0e-11ef-8e3a-a0d3651f611f"},{"people_name":"北郭","people_name_jianti_auto":"北郭","start_index":44,"tongjian_id":"8bf676a1-db0e-11ef-9328-a0d3651f611f"},{"people_name":"西門","people_name_jianti_auto":"西门","start_index":54,"tongjian_id":"8bf676a2-db0e-11ef-87f8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":3,"tongjian_id":"8bf676a3-db0e-11ef-9162-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":6,"tongjian_id":"8bf676a4-db0e-11ef-8c6b-a0d3651f611f"},{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":13,"tongjian_id":"8bf676a5-db0e-11ef-82f1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，鄴縣屬魏郡。西門豹爲鄴令，鑿渠以利民。王符潛夫論·姓氏篇曰：如有東門、西郭、南宮、北郭，皆因居以爲姓。西門蓋亦此類。鄴，魚怯翻。","note_content_jianti_auto":"班志，邺县属魏郡。西门豹为邺令，凿渠以利民。王符潜夫论·姓氏篇曰：如有东门、西郭、南宫、北郭，皆因居以为姓。西门盖亦此类。邺，鱼怯翻。","note_type":"hu_note","start_index":227,"tongjian_id":"8bf6769b-db0e-11ef-b6c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"屈","people_name_jianti_auto":"屈","start_index":21,"tongjian_id":"8bf676a9-db0e-11ef-b4ef-a0d3651f611f"},{"people_name":"屈","people_name_jianti_auto":"屈","start_index":32,"tongjian_id":"8bf676aa-db0e-11ef-9617-a0d3651f611f"},{"people_name":"鮒","people_name_jianti_auto":"鲋","start_index":41,"tongjian_id":"8bf676ab-db0e-11ef-b7ac-a0d3651f611f"},{"people_name":"屈侯","people_name_jianti_auto":"屈侯","start_index":45,"tongjian_id":"8bf676ac-db0e-11ef-9cce-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":34,"tongjian_id":"8bf676ad-db0e-11ef-aac5-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":39,"tongjian_id":"8bf676ae-db0e-11ef-8ec7-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":43,"tongjian_id":"8bf676af-db0e-11ef-aea9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"傅者，傅之以德義，因以爲官名。傅，芳遇翻。屈，九勿翻，姓也。余按屈，晉地，時屬魏；鮒蓋魏封屈侯也。鮒，音符遇翻。","note_content_jianti_auto":"傅者，傅之以德义，因以为官名。傅，芳遇翻。屈，九勿翻，姓也。余按屈，晋地，时属魏；鲋盖魏封屈侯也。鲋，音符遇翻。","note_type":"hu_note","start_index":265,"tongjian_id":"8bf676a8-db0e-11ef-abd5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不勝爲負。","note_content_jianti_auto":"不胜为负。","note_type":"hu_note","start_index":281,"tongjian_id":"8bf676b0-db0e-11ef-9b8f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8bf676b3-db0e-11ef-bc3a-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8bf676b4-db0e-11ef-846f-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「子」下有「之」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「子」下有「之」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8bf676b2-db0e-11ef-b425-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":287,"tongjian_id":"8bf676b1-db0e-11ef-9276-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"比，毗至翻。阿黨爲比。","note_content_jianti_auto":"比，毗至翻。阿党为比。","note_type":"hu_note","start_index":305,"tongjian_id":"8bf676b5-db0e-11ef-ac32-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李克","people_name_jianti_auto":"李克","start_index":0,"tongjian_id":"8bf676b7-db0e-11ef-9148-a0d3651f611f"},{"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","start_index":6,"tongjian_id":"8bf676b8-db0e-11ef-b8bb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李克自叙其答魏文侯之言也。","note_content_jianti_auto":"李克自叙其答魏文侯之言也。","note_type":"hu_note","start_index":317,"tongjian_id":"8bf676b6-db0e-11ef-9e74-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":0,"tongjian_id":"8bf676ba-db0e-11ef-8948-a0d3651f611f"},{"people_name":"鄭","people_name_jianti_auto":"郑","start_index":12,"tongjian_id":"8bf676bb-db0e-11ef-8944-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孔穎達曰：祿者，穀也。故鄭註司祿云：祿也言穀，年穀豐然後制祿。授神契云：祿者，錄也。白虎通曰：上以收錄接下，下以名錄謹以事上是也。六斛四斗爲一鍾。","note_content_jianti_auto":"孔颖达曰：禄者，谷也。故郑注司禄云：禄也言谷，年谷丰然后制禄。授神契云：禄者，录也。白虎通曰：上以收录接下，下以名录谨以事上是也。六斛四斗为一钟。","note_type":"hu_note","start_index":335,"tongjian_id":"8bf676b9-db0e-11ef-93c5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":22,"tongjian_id":"8bf676c1-db0e-11ef-bcf4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"逡，七倫翻。逡巡，却退貌。卒，子恤翻，終也。孔穎達曰：先生，師也。謂師爲先生者，言彼先己而生，其德多厚也。自稱爲弟子者，言己自處如弟子，則尊其師如父兄也。","note_content_jianti_auto":"逡，七伦翻。逡巡，却退貌。卒，子恤翻，终也。孔颖达曰：先生，师也。谓师为先生者，言彼先己而生，其德多厚也。自称为弟子者，言己自处如弟子，则尊其师如父兄也。","note_type":"hu_note","start_index":418,"tongjian_id":"8bf676c0-db0e-11ef-9534-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.85,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期诸侯国的最高行政长官，相当于宰相，此处文侯与李克讨论任命相国之事，涉及魏成和翟璜的候选。","official_rank":"未知","source_snippet":"卜相","start_index":172,"tongjian_id":"70c798e4-5748-4ca0-8cdf-526050da409e"},{"confidence":0.9,"official_category":"地方行政","official_name":"西河守","official_note":"西河守是战国时期魏国的地方官职，负责西河地区的行政和军事事务，此处翟璜提及吴起担任此职以展示自己的推荐功绩。","official_rank":"未知","source_snippet":"西河守吳起","start_index":184,"tongjian_id":"3765a725-e740-4228-a519-c95c8c916a40"},{"confidence":0.8,"official_category":"文教","official_name":"傅","official_note":"傅是古代负责教导君主或贵族子弟的官职，此处翟璜提到推荐屈侯鮒担任文侯之子的傅，以显示自己的贡献。","official_rank":"未知","source_snippet":"君之子無傅","start_index":224,"tongjian_id":"159d2913-40fa-424c-85b9-7d20dcbd6e65"}],"ExtRef_Children_people":[{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"田子方","people_name_jianti_auto":"田子方","people_xingming":"田子方","start_index":353,"tongjian_id":"8bf7ce8a-db0e-11ef-83ae-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"文侯謂李克曰：「先生嘗有言曰：『家貧思良妻，國亂思良相。』今所置非成則璜，二子何如？」對曰：「卑不謀尊，疏不謀戚。臣在闕門之外，不敢當命。」文侯曰：「先生臨事勿讓！」克曰：「君弗察故也。居視其所親，富視其所與，達視其所舉，窮視其所不爲，貧視其所不取，五者足以定之矣，何待克哉！」文侯曰：「先生就舍，吾之相定矣。」李克出，見翟璜。翟璜曰：「今者聞君召先生而卜相，果誰爲之？」克曰：「魏成。」翟璜忿然作色曰：「西河守吳起，臣所進也。君內以鄴爲憂，臣進西門豹。君欲伐中山，臣進樂羊。中山已拔，無使守之，臣進先生。君之子無傅，臣進屈侯鮒。以耳目之所睹記，臣何負於魏成！」李克曰：「子言克於子之君者，豈將比周以求大官哉？君問相於克，克之對如是。所以知君之必相魏成者，魏成食祿千鍾，什九在外，什一在內；是以東得卜子夏、田子方、段干木。此三人者，君皆師之；子所進五人者，君皆臣之。子惡得與魏成比也！」翟璜逡巡再拜曰：「璜，鄙人也，失對，願卒爲子弟！」","content_fanyi":"魏文侯对李克说：“先生曾经说过：‘家贫时想着良妻，国乱时想着良相。’现在所要选任的国相，不是魏成就是翟璜，你看两人怎么样？”李克回答说：“地位卑下的人不谋议尊上的事，关系疏远的人不谋议亲近者的事。臣身在宫门之外，不敢参与议论。”魏文侯说：“先生遇到国事就不要推辞了！”李克说：“这是您没有仔细考察的缘故。平时看他亲近什么人，富有时看他交往什么人，显达时看他举荐什么人，困厄时看他不肯做什么，贫穷时看他不拿取什么。这五点就足以确定国相了，哪里用得着等我李克来定呢！”魏文侯说：“先生请回府吧，我的国相已经定了。”李克出来后，见到翟璜。翟璜问道：“刚才听说主君召先生去商议国相人选，到底定了谁做国相？”李克说：“魏成。”翟璜立刻气得变了脸色，说：“西河守吴起，是我举荐的；主君为国内的邺地忧虑，我举荐了西门豹；主君想攻伐中山，我举荐了乐羊；中山攻下之后，没有人可派去镇守，我举荐了先生；主君的儿子没有师傅，我举荐了屈侯鲋。凭这些耳闻目睹的事实，我哪里比不上魏成！”李克说：“你向主君推荐我李克，难道是为了结党营私来求取大官吗？主君向我询问国相人选，我就是这样回答的。我之所以知道主君必定会让魏成做国相，是因为魏成享受千钟俸禄，十分之九用在外面结交贤士，十分之一才用在家里；因此他在东边得到了卜子夏、田子方、段干木。这三个人，主君都当作老师；你所举荐的五个人，主君都当作臣下。你怎么能和魏成相比呢！”翟璜惭愧不安地拜了两拜说：“我翟璜是个鄙陋的人，方才答对失礼，情愿终身做先生的弟子！”","content_jianti_auto":"文侯谓李克曰：「先生尝有言曰：『家贫思良妻，国乱思良相。』今所置非成则璜，二子何如？」对曰：「卑不谋尊，疏不谋戚。臣在阙门之外，不敢当命。」文侯曰：「先生临事勿让！」克曰：「君弗察故也。居视其所亲，富视其所与，达视其所举，穷视其所不为，贫视其所不取，五者足以定之矣，何待克哉！」文侯曰：「先生就舍，吾之相定矣。」李克出，见翟璜。翟璜曰：「今者闻君召先生而卜相，果谁为之？」克曰：「魏成。」翟璜忿然作色曰：「西河守吴起，臣所进也。君内以邺为忧，臣进西门豹。君欲伐中山，臣进乐羊。中山已拔，无使守之，臣进先生。君之子无傅，臣进屈侯鲋。以耳目之所睹记，臣何负于魏成！」李克曰：「子言克于子之君者，岂将比周以求大官哉？君问相于克，克之对如是。所以知君之必相魏成者，魏成食禄千钟，什九在外，什一在内；是以东得卜子夏、田子方、段干木。此三人者，君皆师之；子所进五人者，君皆臣之。子恶得与魏成比也！」翟璜逡巡再拜曰：「璜，鄙人也，失对，愿卒为子弟！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":26,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 26 段","reading_annotation_sources":[],"start_index":25,"tongjian_id":"8bf67679-db0e-11ef-b621-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000344"},"tongjian_id":"8bf67679-db0e-11ef-b621-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":18,"source_start_index":6,"source_text":"見四十五卷明帝永平十六年","target_paragraph_tongjian_id":"951ca1eb-db0e-11ef-8884-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"超","people_name_jianti_auto":"超","start_index":0,"tongjian_id":"95a4f91b-db0e-11ef-97bc-a0d3651f611f"},{"people_name":"明帝","people_name_jianti_auto":"明帝","start_index":11,"tongjian_id":"95a4f91c-db0e-11ef-9285-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","start_index":3,"tongjian_id":"95a4f91d-db0e-11ef-b2c5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"超始出西域，見四十五卷明帝永平十六年。","note_content_jianti_auto":"超始出西域，见四十五卷明帝永平十六年。","note_type":"hu_note","start_index":8,"tongjian_id":"95a4f91a-db0e-11ef-bebf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":14,"tongjian_id":"95a4f91f-db0e-11ef-93f1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"酒泉郡","place_name_jianti_auto":"酒泉郡","start_index":0,"tongjian_id":"95a4f920-db0e-11ef-af0d-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":5,"tongjian_id":"95a4f921-db0e-11ef-9205-a0d3651f611f"},{"place_name":"玉門關","place_name_jianti_auto":"玉门关","start_index":17,"tongjian_id":"95a4f922-db0e-11ef-a656-a0d3651f611f"},{"place_name":"敦煌郡","place_name_jianti_auto":"敦煌郡","start_index":22,"tongjian_id":"95a4f923-db0e-11ef-959c-a0d3651f611f"},{"place_name":"沙州","place_name_jianti_auto":"沙州","start_index":27,"tongjian_id":"95a4f924-db0e-11ef-bf0c-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":32,"tongjian_id":"95a4f925-db0e-11ef-8823-a0d3651f611f"},{"place_name":"敦煌縣","place_name_jianti_auto":"敦煌县","start_index":42,"tongjian_id":"95a4f926-db0e-11ef-bfb5-a0d3651f611f"},{"place_name":"酒泉郡","place_name_jianti_auto":"酒泉郡","start_index":48,"tongjian_id":"95a4f927-db0e-11ef-8902-a0d3651f611f"},{"place_name":"肅州","place_name_jianti_auto":"肃州","start_index":53,"tongjian_id":"95a4f928-db0e-11ef-abbe-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":58,"tongjian_id":"95a4f929-db0e-11ef-871b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"酒泉郡，在雒陽西四千七百里。賢曰：玉門關，屬敦煌郡，今沙州也，去長安三千六百里，關在敦煌縣西北。酒泉郡，今肅州也，去長安二千八百五十里。","note_content_jianti_auto":"酒泉郡，在雒阳西四千七百里。贤曰：玉门关，属敦煌郡，今沙州也，去长安三千六百里，关在敦煌县西北。酒泉郡，今肃州也，去长安二千八百五十里。","note_type":"hu_note","start_index":37,"tongjian_id":"95a4f91e-db0e-11ef-94d7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"超","people_name_jianti_auto":"超","start_index":0,"tongjian_id":"95a4f92b-db0e-11ef-93f8-a0d3651f611f"},{"people_name":"昭","people_name_jianti_auto":"昭","start_index":2,"tongjian_id":"95a4f92c-db0e-11ef-9568-a0d3651f611f"},{"people_name":"曹壽","people_name_jianti_auto":"曹寿","start_index":7,"tongjian_id":"95a4f92d-db0e-11ef-8565-a0d3651f611f"},{"people_name":"沖帝","people_name_jianti_auto":"冲帝","start_index":58,"tongjian_id":"95a4f92e-db0e-11ef-98ca-a0d3651f611f"},{"people_name":"虞貴人","people_name_jianti_auto":"虞贵人","start_index":61,"tongjian_id":"95a4f92f-db0e-11ef-a741-a0d3651f611f"},{"people_name":"梁冀","people_name_jianti_auto":"梁冀","start_index":65,"tongjian_id":"95a4f930-db0e-11ef-a83d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":5,"tongjian_id":"95a4f931-db0e-11ef-97a5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"超妹昭，嫁扶風曹壽，博學高才，有節行法度。帝數召入宮，令皇后諸貴人師事焉，號曰大家。家，今人相傳讀曰姑。又據皇后紀，沖帝母虞貴人，梁冀秉政，抑而不加爵號，但稱大家而已。則大家者，宮中相尊之稱也。","note_content_jianti_auto":"超妹昭，嫁扶风曹寿，博学高才，有节行法度。帝数召入宫，令皇后诸贵人师事焉，号曰大家。家，今人相传读曰姑。又据皇后纪，冲帝母虞贵人，梁冀秉政，抑而不加爵号，但称大家而已。则大家者，宫中相尊之称也。","note_type":"hu_note","start_index":74,"tongjian_id":"95a4f92a-db0e-11ef-8716-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卒，讀曰猝；下同。","note_content_jianti_auto":"卒，读曰猝；下同。","note_type":"hu_note","start_index":133,"tongjian_id":"95a4f934-db0e-11ef-803b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95a4f936-db0e-11ef-8dd4-a0d3651f611f"},{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":8,"tongjian_id":"95a4f937-db0e-11ef-8c39-a0d3651f611f"},{"people_name":"黥布","people_name_jianti_auto":"黥布","start_index":12,"tongjian_id":"95a4f938-db0e-11ef-a0fb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：踰，遙也，高祖踰謂黥布曰：何苦而反？余按前書，當作「隃」，讀曰遙，傳寫誤作「踰」。","note_content_jianti_auto":"贤曰：逾，遥也，高祖逾谓黥布曰：何苦而反？余按前书，当作「隃」，读曰遥，传写误作「逾」。","note_type":"hu_note","start_index":184,"tongjian_id":"95a4f935-db0e-11ef-9380-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95a4f93c-db0e-11ef-8dad-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：周禮·鄕大夫職曰：國中七尺以及六十有五，皆征之。征，謂賦稅從征役也。韓詩外傳曰：二十行役，六十免役；與周禮國中同，卽知一與周禮七尺同。禮，國中六十免役，野卽六十有五，晚於國中五年。國中七尺從役，野六尺，卽是野又早於國中五年。七尺，謂二十；六尺，卽十五也。此言十五受兵，據野外爲言；六十還之，據國中爲說也。","note_content_jianti_auto":"贤曰：周礼·鄕大夫职曰：国中七尺以及六十有五，皆征之。征，谓赋税从征役也。韩诗外传曰：二十行役，六十免役；与周礼国中同，即知一与周礼七尺同。礼，国中六十免役，野即六十有五，晚于国中五年。国中七尺从役，野六尺，即是野又早于国中五年。七尺，谓二十；六尺，即十五也。此言十五受兵，据野外为言；六十还之，据国中为说也。","note_type":"hu_note","start_index":209,"tongjian_id":"95a4f93b-db0e-11ef-b7c1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":6,"tongjian_id":"95a4f944-db0e-11ef-94fd-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲，于僞翻。賢曰：匄，乞也。","note_content_jianti_auto":"为，于伪翻。贤曰：匄，乞也。","note_type":"hu_note","start_index":234,"tongjian_id":"95a4f943-db0e-11ef-bb72-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周文王","people_name_jianti_auto":"周文王","start_index":4,"tongjian_id":"95a4f946-db0e-11ef-b1fb-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":38,"tongjian_id":"95a4f947-db0e-11ef-9688-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":89,"tongjian_id":"95a4f948-db0e-11ef-8c52-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"靈臺","place_name_jianti_auto":"灵台","start_index":8,"tongjian_id":"95a4f949-db0e-11ef-a736-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"新序曰：周文王作靈臺，掘地得死人之骨，王曰：「更葬之！」吏曰：「此無主矣。」文王曰：「有天下者，天下之主也，有一國者，一國之主也；寡人固其主，又安求之主！」遂更葬之。天下皆曰：「文王賢矣，澤及朽骨，而況於人乎！」","note_content_jianti_auto":"新序曰：周文王作灵台，掘地得死人之骨，王曰：「更葬之！」吏曰：「此无主矣。」文王曰：「有天下者，天下之主也，有一国者，一国之主也；寡人固其主，又安求之主！」遂更葬之。天下皆曰：「文王贤矣，泽及朽骨，而况于人乎！」","note_type":"hu_note","start_index":272,"tongjian_id":"95a4f945-db0e-11ef-8b5b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95a4f94c-db0e-11ef-a716-a0d3651f611f"},{"people_name":"田子方","people_name_jianti_auto":"田子方","start_index":3,"tongjian_id":"95a4f94d-db0e-11ef-bd25-a0d3651f611f"},{"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","start_index":7,"tongjian_id":"95a4f94e-db0e-11ef-ae6d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：田子方，魏文侯之師也，見君之老馬棄之，曰：「少盡其力，老而棄之，非仁也。」於是收而養之。","note_content_jianti_auto":"贤曰：田子方，魏文侯之师也，见君之老马弃之，曰：「少尽其力，老而弃之，非仁也。」于是收而养之。","note_type":"hu_note","start_index":280,"tongjian_id":"95a4f94b-db0e-11ef-9e79-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"超","people_name_jianti_auto":"超","start_index":7,"tongjian_id":"95a4f950-db0e-11ef-a1f8-a0d3651f611f"},{"people_name":"昭","people_name_jianti_auto":"昭","start_index":23,"tongjian_id":"95a4f951-db0e-11ef-90ca-a0d3651f611f"},{"people_name":"超","people_name_jianti_auto":"超","start_index":59,"tongjian_id":"95a4f952-db0e-11ef-83f5-a0d3651f611f"},{"people_name":"勇","people_name_jianti_auto":"勇","start_index":62,"tongjian_id":"95a4f953-db0e-11ef-a596-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":84,"tongjian_id":"95a4f954-db0e-11ef-9d55-a0d3651f611f"},{"people_name":"超","people_name_jianti_auto":"超","start_index":87,"tongjian_id":"95a4f955-db0e-11ef-8eb5-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":103,"tongjian_id":"95a4f956-db0e-11ef-ad8b-a0d3651f611f"},{"people_name":"超","people_name_jianti_auto":"超","start_index":108,"tongjian_id":"95a4f957-db0e-11ef-b727-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":18,"tongjian_id":"95a4f958-db0e-11ef-82e7-a0d3651f611f"},{"place_name":"安息","place_name_jianti_auto":"安息","start_index":48,"tongjian_id":"95a4f959-db0e-11ef-8ef7-a0d3651f611f"},{"place_name":"安息國","place_name_jianti_auto":"安息国","start_index":77,"tongjian_id":"95a4f95a-db0e-11ef-a85a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：本傳稱超十二年上疏，十四年至雒陽。而妹昭上書曰：「延頸踰望，三年於今。」註引東觀記曰：「安息遣使獻大雀、師子，超遣子勇隨入塞。」按帝紀：「十三年，安息國入貢」，袁紀載超書亦在十三年。今幷置其書於此。袁紀又云「超到數月薨」，今從本傳。","note_content_jianti_auto":"考异曰：本传称超十二年上疏，十四年至雒阳。而妹昭上书曰：「延颈逾望，三年于今。」注引东观记曰：「安息遣使献大雀、师子，超遣子勇随入塞。」按帝纪：「十三年，安息国入贡」，袁纪载超书亦在十三年。今幷置其书于此。袁纪又云「超到数月薨」，今从本传。","note_type":"hu_note","start_index":310,"tongjian_id":"95a4f94f-db0e-11ef-8f10-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"射聲校尉","official_note":"射聲校尉是漢代北軍八校尉之一，負責弓弩部隊，屬於中央禁軍。在《資治通鑑》此段中，班超被任命為射聲校尉，表示他從西域返回後被授予中央軍事職務，以表彰其功績並安置於朝廷。","official_rank":"比二千石","source_snippet":"拜爲射聲校尉","start_index":290,"tongjian_id":"8deda381-827f-4ac0-b489-31b2abaaf89a"}],"ExtRef_Children_people":[{"link_td_description":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","link_td_number_id":1608668,"people_name":"子方","people_name_jianti_auto":"子方","people_xingming":"田子方","start_index":272,"tongjian_id":"95a4f973-db0e-11ef-b996-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95a4f919-db0e-11ef-ba69-a0d3651f611f","pinyin":"guǐ","source_anchor_text":"代恐開姦宄之原生逆","source_key":"baiyang_epub","start_index":104,"text":"宄","tongjian_id":"3238f041-8808-5943-97c8-09e997271be9"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"隋大业四年，遣将薛世雄等出玉门，击伊吾。七年，遣裴矩驰至...","context_before":"...西域传》：自敦煌西出玉门、阳关，涉鄯善，北通伊吾千余里。","source_end_index":178,"source_paragraph_tongjian_id":"23e2d8a3-0e3b-5e62-bf03-9dae4ba5d5c8","source_start_index":163,"source_text":"班超在西域，上书愿生入玉门关。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"7班超久在絕域，年老思土，上書乞歸曰：「臣不敢望到酒泉郡，但願生入玉門關。謹遣子勇隨安息獻物入塞，及臣生在，令勇目見中土。」朝廷久之未報，超妹曹大家上書曰：「蠻夷之性，悖逆侮老；而超旦暮入地，久不見代，恐開姦宄之原，生逆亂之心。而卿大夫咸懷一切，莫肯遠慮，如有卒暴，超之氣力不能從心，便爲上損國家累世之功，下棄忠臣竭力之用，誠可痛也！故超萬里歸誠，自陳苦急，延頸踰望，三年於今，未蒙省錄。妾竊聞古者十五受兵，六十還之，亦有休息，不任職也。故妾敢觸死爲超求哀，匄超餘年，一得生還，復見闕庭，使國家無勞遠之慮，西域無倉卒之憂，超得長蒙文王葬骨之恩，子方哀老之惠。」帝感其言，乃徵超還。八月，超至雒陽，拜爲射聲校尉；九月，卒。","content_fanyi":"班超长期驻守极远的边地，年老思念故土，上书请求归国说：“臣不敢奢望到达酒泉郡，只愿活着进入玉门关。臣恭谨地派遣儿子班勇跟随安息进献贡物的使者进入塞内，趁着臣还活着，让班勇亲眼见一见中原。”朝廷过了很久也没有答复。班超的妹妹曹大家（即班昭）上书说：“蛮夷的性情，悖逆无礼、欺侮年老之人；而班超早晚就会入土，长久无人接替，恐怕会开启奸邪的源头，生出叛逆动乱之心。而公卿大夫们都怀着一时权宜的打算，不肯作长远考虑，一旦发生突然变故，班超已力不从心，便会在上损害国家历代积累的功业，在下抛弃忠臣竭尽全力的效用，实在令人痛心！所以班超在万里之外表达归向朝廷的诚心，陈说自己困苦急迫，伸长脖子遥望，至今已有三年，却不曾被朝廷省察采纳。我私下听说古代的人十五岁接受兵役，六十岁便遣返还乡，也还有休息的时候，不再任职。因此我冒死替班超请求哀怜，乞求在班超的残余之年，让他能活着回来，重新见到朝廷宫阙，使国家没有忧劳远方的顾虑，西域没有仓促生变的忧患，班超得以长久蒙受周文王埋葬骸骨那样的恩德和田子方怜悯老马那样的惠爱。”和帝被这番话感动，于是征召班超回京。八月，班超抵达洛阳，被任命为射声校尉；九月，便去世了。","content_jianti_auto":"7班超久在绝域，年老思土，上书乞归曰：「臣不敢望到酒泉郡，但愿生入玉门关。谨遣子勇随安息献物入塞，及臣生在，令勇目见中土。」朝廷久之未报，超妹曹大家上书曰：「蛮夷之性，悖逆侮老；而超旦暮入地，久不见代，恐开奸宄之原，生逆乱之心。而卿大夫咸怀一切，莫肯远虑，如有卒暴，超之气力不能从心，便为上损国家累世之功，下弃忠臣竭力之用，诚可痛也！故超万里归诚，自陈苦急，延颈逾望，三年于今，未蒙省录。妾窃闻古者十五受兵，六十还之，亦有休息，不任职也。故妾敢触死为超求哀，匄超余年，一得生还，复见阙庭，使国家无劳远之虑，西域无仓卒之忧，超得长蒙文王葬骨之恩，子方哀老之惠。」帝感其言，乃征超还。八月，超至雒阳，拜为射声校尉；九月，卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3906,"number":7,"path":"资治通鉴 : 卷第四十八 (漢紀四十) / 孝和皇帝下 / 十四年 / 第 7 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"95a4f919-db0e-11ef-ba69-a0d3651f611f","year_int":102},"tongjian_id":"95a4f919-db0e-11ef-ba69-a0d3651f611f"},"paragraph_order":5}],"page_size":7,"total_pages":1,"total_paragraphs":5},"profile":{"alias_list":[],"biography":"田子方，战国时期初期人物。曾经和子夏、段干木都被魏成推荐给魏文侯，魏文侯以他为师。","link_td_id":"Q10013710","name":"田子方","number_id":1608668},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"向其请教，来源文本：魏文侯經常向孔子的弟子子夏以及再傳弟子田子方、段干木等請教","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10008342","source_person_name":"魏文侯","source_person_number_id":211476,"statement_id":"S-Q10008342-P100061-Q10013710","target_person_id":"Q10013710","target_person_name":"田子方","target_person_number_id":1608668},{"direction":"forward","rank":"normal","relation_detail":"被同一人推荐给魏文侯，来源文本：曾经和子夏、段干木都被魏成推荐给魏文侯","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10013710","source_person_name":"田子方","source_person_number_id":1608668,"statement_id":"S-Q10013710-P100061-Q10000061","target_person_id":"Q10000061","target_person_name":"子夏","target_person_number_id":42144},{"direction":"forward","rank":"normal","relation_detail":"推荐者，来源文本：曾经和子夏、段干木都被魏成推荐给魏文侯","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10013710","source_person_name":"田子方","source_person_number_id":1608668,"statement_id":"S-Q10013710-P100061-Q10002987","target_person_id":"Q10002987","target_person_name":"魏成","target_person_number_id":1522959},{"direction":"forward","rank":"normal","relation_detail":"被同一人推荐给魏文侯，来源文本：曾经和子夏、段干木都被魏成推荐给魏文侯","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10013710","source_person_name":"田子方","source_person_number_id":1608668,"statement_id":"S-Q10013710-P100061-Q10004288","target_person_id":"Q10004288","target_person_name":"段干木","target_person_number_id":1608700},{"direction":"forward","rank":"normal","relation