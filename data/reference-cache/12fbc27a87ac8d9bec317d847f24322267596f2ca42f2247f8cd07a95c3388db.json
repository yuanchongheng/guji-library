8d16\u4e4b\u3002\u738b\u91cd\u5730\u5c0a\u79e6\uff0c\u79e6\u5973\u5fc5\u8cb4\u800c\u592b\u4eba\u65a5\u77e3\u3002\u300d\u65bc\u662f\u912d\u8896\u65e5\u591c\u6ce3\u65bc\u695a\u738b\u66f0\uff1a\u300c\u81e3\u5404\u7232\u5176\u4e3b\u8033\u3002\u4eca\u6bba\u5f35\u5100\uff0c\u79e6\u5fc5\u5927\u6012\u3002\u59be\u8acb\u5b50\u6bcd\u4ff1\u9077\u6c5f\u5357\uff0c\u6bcb\u7232\u79e6\u6240\u9b5a\u8089\u4e5f\uff01\u300d\u738b\u4e43\u8d66\u5f35\u5100\u800c\u539a\u79ae\u4e4b\u3002\u5f35\u5100\u56e0\u8aaa\u695a\u738b\u66f0\uff1a\u300c\u592b\u7232\u5f9e\u8005\u7121\u4ee5\u7570\u65bc\u9a45\u7fa3\u7f8a\u800c\u653b\u731b\u864e\uff0c\u4e0d\u683c\u660e\u77e3\u3002\u4eca\u738b\u4e0d\u4e8b\u79e6\uff0c\u79e6\u52ab\u97d3\u9a45\u6881\u800c\u653b\u695a\uff0c\u5247\u695a\u5371\u77e3\u3002\u79e6\u897f\u6709\u5df4\u3001\u8700\uff0c\u6cbb\u8239\u7a4d\u7c9f\uff0c\u6d6e\u5cb7\u6c5f\u800c\u4e0b\uff0c\u4e00\u65e5\u884c\u4e94\u767e\u9918\u91cc\uff0c\u4e0d\u81f3\u5341\u65e5\u800c\u62d2\u625e\u95dc\uff0c\u625e\u95dc\u9a5a\u5247\u5f9e\u5883\u4ee5\u6771\u76e1\u57ce\u5b88\u77e3\uff0c\u9ed4\u4e2d\u3001\u5deb\u90e1\u975e\u738b\u4e4b\u6709\u3002\u79e6\u8209\u7532\u51fa\u6b66\u95dc\uff0c\u5247\u5317\u5730\u7d55\u3002\u79e6\u5175\u4e4b\u653b\u695a\u4e5f\uff0c\u5371\u96e3\u5728\u4e09\u6708\u4e4b\u5167\u3002\u800c\u695a\u5f85\u8af8\u4faf\u4e4b\u6551\u5728\u534a\u6b72\u4e4b\u5916\uff0c\u592b\u5f85\u5f31\u570b\u4e4b\u6551\uff0c\u5fd8\u5f37\u79e6\u4e4b\u798d\uff0c\u6b64\u81e3\u6240\u7232\u5927\u738b\u60a3\u4e5f\u3002\u5927\u738b\u8aa0\u80fd\u807d\u81e3\uff0c\u81e3\u8acb\u4ee4\u79e6\u3001\u695a\u9577\u7232\u5144\u5f1f\u4e4b\u570b\uff0c\u7121\u76f8\u653b\u4f10\u3002\u300d\u695a\u738b\u5df2\u5f97\u5f35\u5100\u800c\u91cd\u51fa\u9ed4\u4e2d\u5730\uff0c\u4e43\u8a31\u4e4b\u3002","content_fanyi":"\u79e6\u60e0\u738b\u6d3e\u4eba\u544a\u8bc9\u695a\u6000\u738b\uff0c\u60f3\u7528\u6b66\u5173\u4ee5\u5916\u7684\u571f\u5730\u6362\u53d6\u695a\u56fd\u7684\u9ed4\u4e2d\u90e1\u3002\u695a\u6000\u738b\u8bf4\uff1a\u201c\u6211\u4e0d\u613f\u4ea4\u6362\u571f\u5730\uff0c\u53ea\u5e0c\u671b\u5f97\u5230\u5f20\u4eea\uff0c\u5c31\u732e\u51fa\u9ed4\u4e2d\u90e1\u3002\u201d\u5f20\u4eea\u542c\u8bf4\u540e\uff0c\u8bf7\u6c42\u524d\u5f80\u695a\u56fd\u3002\u79e6\u60e0\u738b\u8bf4\uff1a\u201c\u695a\u56fd\u8981\u6740\u4e86\u4f60\u624d\u7518\u5fc3\uff0c\u4f60\u600e\u4e48\u8fd8\u8981\u53bb\u5462\uff1f\u201d\u5f20\u4eea\u8bf4\uff1a\u201c\u79e6\u56fd\u5f3a\u5927\uff0c\u695a\u56fd\u5f31\u5c0f\uff0c\u53ea\u8981\u5927\u738b\u5728\uff0c\u695a\u56fd\u5c31\u4e0d\u6562\u6740\u5bb3\u6211\u3002\u51b5\u4e14\u6211\u4e0e\u695a\u738b\u7684\u5ba0\u81e3\u9773\u5c1a\u4ea4\u597d\uff0c\u9773\u5c1a\u53c8\u80fd\u4e8b\u5949\u695a\u738b\u7684\u5ba0\u59ec\u90d1\u8896\uff0c\u90d1\u8896\u8bf4\u7684\u8bdd\uff0c\u695a\u738b\u6ca1\u6709\u4e0d\u542c\u4ece\u7684\u3002\u201d\u4e8e\u662f\u5f20\u4eea\u524d\u5f80\u695a\u56fd\u3002\u695a\u6000\u738b\u628a\u5f20\u4eea\u56da\u7981\u8d77\u6765\uff0c\u51c6\u5907\u6740\u6389\u4ed6\u3002\u9773\u5c1a\u5bf9\u90d1\u8896\u8bf4\uff1a\u201c\u79e6\u738b\u975e\u5e38\u5ba0\u4fe1\u5f20\u4eea\uff0c\u51c6\u5907\u7528\u4e0a\u5eb8\u516d\u53bf\u548c\u79e6\u56fd\u7f8e\u5973\u6765\u8d4e\u4ed6\u3002\u5927\u738b\u770b\u91cd\u8fd9\u4e9b\u571f\u5730\uff0c\u53c8\u5c0a\u5949\u79e6\u56fd\uff0c\u79e6\u56fd\u7f8e\u5973\u5fc5\u5b9a\u5f97\u5ba0\uff0c\u592b\u4eba\u60a8\u5c31\u8981\u88ab\u51b7\u843d\u4e86\u3002\u201d\u4e8e\u662f\u90d1\u8896\u65e5\u591c\u5728\u695a\u738b\u9762\u524d\u54ed\u6ce3\u8bf4\uff1a\u201c\u505a\u81e3\u5b50\u7684\u90fd\u4e0d\u8fc7\u662f\u5404\u4e3a\u5176\u4e3b\u7f62\u4e86\u3002\u73b0\u5728\u6740\u6389\u5f20\u4eea\uff0c\u79e6\u56fd\u5fc5\u5b9a\u5927\u6012\u3002\u59be\u8bf7\u6c42\u4e0e\u513f\u5b50\u4e00\u8d77\u8fc1\u5230\u6c5f\u5357\uff0c\u4e0d\u8981\u7b49\u7740\u88ab\u79e6\u56fd\u51cc\u8fb1\u5bb0\u5272\u554a\uff01\u201d\u695a\u738b\u4e8e\u662f\u8d66\u514d\u4e86\u5f20\u4eea\uff0c\u5e76\u539a\u793c\u76f8\u5f85\u3002\u5f20\u4eea\u4e8e\u662f\u6e38\u8bf4\u695a\u738b\u8bf4\uff1a\u201c\u5b9e\u884c\u5408\u7eb5\u6297\u79e6\uff0c\u548c\u9a71\u8d76\u7f8a\u7fa4\u53bb\u653b\u6253\u731b\u864e\u6ca1\u6709\u4e24\u6837\uff0c\u7f8a\u7fa4\u6597\u4e0d\u8fc7\u731b\u864e\u662f\u660e\u6446\u7740\u7684\u3002\u5982\u4eca\u5927\u738b\u4e0d\u80af\u4e8b\u5949\u79e6\u56fd\uff0c\u79e6\u56fd\u5982\u679c\u80c1\u8feb\u97e9\u56fd\u3001\u9a71\u4f7f\u9b4f\u56fd\u6765\u653b\u6253\u695a\u56fd\uff0c\u695a\u56fd\u5c31\u5371\u9669\u4e86\u3002\u79e6\u56fd\u897f\u8fb9\u62e5\u6709\u5df4\u3001\u8700\uff0c\u5728\u90a3\u91cc\u4fee\u9020\u6218\u8239\u3001\u79ef\u50a8\u7cae\u98df\uff0c\u987a\u5cb7\u6c5f\u800c\u4e0b\uff0c\u4e00\u5929\u80fd\u884c\u4e94\u767e\u591a\u91cc\uff0c\u4e0d\u5230\u5341\u5929\u5c31\u80fd\u903c\u8fd1\u625e\u5173\u3002\u625e\u5173\u4e00\u65e6\u53d7\u60ca\u6270\uff0c\u4ece\u8fb9\u5883\u4ee5\u4e1c\u7684\u695a\u56fd\u571f\u5730\u5168\u90fd\u8981\u6212\u4e25\u5b88\u57ce\uff0c\u9ed4\u4e2d\u3001\u5deb\u90e1\u5c31\u4e0d\u518d\u5f52\u5927\u738b\u6240\u6709\u4e86\u3002\u79e6\u56fd\u5982\u679c\u53d1\u52a8\u7532\u5175\u51fa\u6b66\u5173\uff0c\u695a\u56fd\u5317\u65b9\u7684\u571f\u5730\u5c31\u4f1a\u88ab\u9694\u7edd\u3002\u79e6\u5175\u653b\u6253\u695a\u56fd\uff0c\u5371\u96be\u5728\u4e09\u4e2a\u6708\u4e4b\u5185\u5c31\u4f1a\u5230\u6765\u3002\u800c\u695a\u56fd\u7b49\u5f85\u8bf8\u4faf\u5404\u56fd\u7684\u6551\u63f4\uff0c\u5374\u8981\u7b49\u5230\u534a\u5e74\u4ee5\u540e\u3002\u6307\u671b\u5f31\u56fd\u7684\u6551\u63f4\uff0c\u5374\u5fd8\u8bb0\u5f3a\u79e6\u7684\u7978\u60a3\uff0c\u8fd9\u6b63\u662f\u6211\u66ff\u5927\u738b\u62c5\u5fe7\u7684\u539f\u56e0\u3002\u5927\u738b\u5982\u679c\u771f\u80fd\u542c\u4ece\u6211\u7684\u5efa\u8bae\uff0c\u6211\u613f\u610f\u8ba9\u79e6\u3001\u695a\u4e24\u56fd\u957f\u671f\u7ed3\u4e3a\u5144\u5f1f\u4e4b\u56fd\uff0c\u4e0d\u518d\u4e92\u76f8\u653b\u4f10\u3002\u201d\u695a\u738b\u5df2\u7ecf\u5f97\u5230\u5f20\u4eea\uff0c\u53c8\u820d\u4e0d\u5f97\u518d\u4ea4\u51fa\u9ed4\u4e2d\u4e4b\u5730\uff0c\u5c31\u7b54\u5e94\u4e86\u5f20\u4eea\u7684\u5efa\u8bae\u3002","content_jianti_auto":"2\u79e6\u60e0\u738b\u4f7f\u4eba\u544a\u695a\u6000\u738b\uff0c\u8bf7\u4ee5\u6b66\u5173\u4e4b\u5916\u6613\u9ed4\u4e2d\u5730\u3002\u695a\u738b\u66f0\uff1a\u300c\u4e0d\u613f\u6613\u5730\uff0c\u613f\u5f97\u5f20\u4eea\u800c\u732e\u9ed4\u4e2d\u5730\u3002\u300d\u5f20\u4eea\u95fb\u4e4b\uff0c\u8bf7\u884c\u3002\u738b\u66f0\uff1a\u300c\u695a\u5c06\u7518\u5fc3\u4e8e\u5b50\uff0c\u67f0\u4f55\u884c\uff1f\u300d\u5f20\u4eea\u66f0\uff1a\u300c\u79e6\u5f3a\u695a\u5f31\uff0c\u5927\u738b\u5728\uff0c\u695a\u4e0d\u5b9c\u6562\u53d6\u81e3\u3002\u4e14\u81e3\u5584\u5176\u5b16\u81e3\u9773\u5c1a\uff0c\u9773\u5c1a\u5f97\u4e8b\u5e78\u59ec\u90d1\u8896\uff0c\u8896\u4e4b\u8a00\uff0c\u738b\u65e0\u4e0d\u542c\u8005\u3002\u300d\u9042\u5f80\u3002\u695a\u738b\u56da\uff0c\u5c06\u6740\u4e4b\u3002\u9773\u5c1a\u8c13\u90d1\u8896\u66f0\uff1a\u300c\u79e6\u738b\u751a\u7231\u5f20\u4eea\uff0c\u5c06\u4ee5\u4e0a\u5eb8\u516d\u53bf\u53ca\u7f8e\u5973\u8d4e\u4e4b\u3002\u738b\u91cd\u5730\u5c0a\u79e6\uff0c\u79e6\u5973\u5fc5\u8d35\u800c\u592b\u4eba\u65a5\u77e3\u3002\u300d\u4e8e\u662f\u90d1\u8896\u65e5\u591c\u6ce3\u4e8e\u695a\u738b\u66f0\uff1a\u300c\u81e3\u5404\u4e3a\u5176\u4e3b\u8033\u3002\u4eca\u6740\u5f20\u4eea\uff0c\u79e6\u5fc5\u5927\u6012\u3002\u59be\u8bf7\u5b50\u6bcd\u4ff1\u8fc1\u6c5f\u5357\uff0c\u6bcb\u4e3a\u79e6\u6240\u9c7c\u8089\u4e5f\uff01\u300d\u738b\u4e43\u8d66\u5f20\u4eea\u800c\u539a\u793c\u4e4b\u3002\u5f20\u4eea\u56e0\u8bf4\u695a\u738b\u66f0\uff1a\u300c\u592b\u4e3a\u4ece\u8005\u65e0\u4ee5\u5f02\u4e8e\u9a71\u7fa4\u7f8a\u800c\u653b\u731b\u864e\uff0c\u4e0d\u683c\u660e\u77e3\u3002\u4eca\u738b\u4e0d\u4e8b\u79e6\uff0c\u79e6\u52ab\u97e9\u9a71\u6881\u800c\u653b\u695a\uff0c\u5219\u695a\u5371\u77e3\u3002\u79e6\u897f\u6709\u5df4\u3001\u8700\uff0c\u6cbb\u8239\u79ef\u7c9f\uff0c\u6d6e\u5cb7\u6c5f\u800c\u4e0b\uff0c\u4e00\u65e5\u884c\u4e94\u767e\u4f59\u91cc\uff0c\u4e0d\u81f3\u5341\u65e5\u800c\u62d2\u625e\u5173\uff0c\u625e\u5173\u60ca\u5219\u4ece\u5883\u4ee5\u4e1c\u5c3d\u57ce\u5b88\u77e3\uff0c\u9ed4\u4e2d\u3001\u5deb\u90e1\u975e\u738b\u4e4b\u6709\u3002\u79e6\u4e3e\u7532\u51fa\u6b66\