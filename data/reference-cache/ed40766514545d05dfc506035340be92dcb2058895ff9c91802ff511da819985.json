ef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"驃國","place_name_jianti_auto":"骠国","place_note":"缅甸","resolved_place_entity_id":5528,"start_index":21,"tongjian_id":"c27f7383-db0e-11ef-abf6-a0d3651f611f"},{"place_name":"南詔","place_name_jianti_auto":"南诏","resolved_place_entity_id":371,"start_index":24,"tongjian_id":"c27f7384-db0e-11ef-a920-a0d3651f611f"},{"place_name":"南詔","place_name_jianti_auto":"南诏","resolved_place_entity_id":371,"start_index":35,"tongjian_id":"c27f7385-db0e-11ef-84c2-a0d3651f611f"},{"place_name":"南詔","place_name_jianti_auto":"南诏","resolved_place_entity_id":371,"start_index":44,"tongjian_id":"c27f7386-db0e-11ef-aa9c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二十五、缅甸军民宣慰使司（卷一百十九）","excerpts":[{"context_after":"元和初，复至。太和六年，南诏掠骠民，迁之拓东。咸通三年，...","context_before":"...师万四千里。南滨海，北南诏。至德初，与寻传蛮皆降于南诏。","source_end_index":191,"source_paragraph_tongjian_id":"1d4bd7bb-248a-585b-8a48-340ede541952","source_start_index":165,"source_text":"贞元十八年，自南诏入贡，骠国王雍羌遣其弟悉利移来朝。"}],"path":"云南方舆纪要/二十五、缅甸军民宣慰使司（卷一百十九）","source_name":"读史方舆纪要"}],"class_tags":["外交"],"content":"1春，正月，驃王摩羅思那遣其子悉利移入貢。驃國在南詔西南六千八百里，聞南詔內附而慕之，因南詔入見，仍獻其樂。","content_fanyi":"春季，正月，骠国国王摩罗思那派遣其子悉利移入朝进贡。骠国地处南诏西南六千八百里处，听说南诏归附朝廷后对唐朝心生仰慕，于是随南诏一起入京朝见，并献上他们的音乐。","content_jianti_auto":"1春，正月，骠王摩罗思那遣其子悉利移入贡。骠国在南诏西南六千八百里，闻南诏内附而慕之，因南诏入见，仍献其乐。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23772,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c27f7378-db0e-11ef-a887-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"論莽熱","people_name_jianti_auto":"论莽热","start_index":17,"tongjian_id":"c27f738b-db0e-11ef-94d0-a0d3651f611f"}],"ExtRef_Children_