95-a0d3651f611f"},{"place_name":"西川","place_name_jianti_auto":"西川","place_note":"总部设成都府【四川省成都市】","resolved_place_entity_id":231,"start_index":28,"tongjian_id":"c27f7392-db0e-11ef-b8d4-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","place_note":"首都逻些城【西藏拉萨市】","resolved_place_entity_id":92,"start_index":39,"tongjian_id":"c27f7393-db0e-11ef-a1bb-a0d3651f611f"},{"place_name":"維州","place_name_jianti_auto":"维州","place_note":"四川省理县","resolved_place_entity_id":1580,"start_index":75,"tongjian_id":"c27f7395-db0e-11ef-b17d-a0d3651f611f"},{"place_name":"昆明","place_name_jianti_auto":"昆明","place_note":"四川省盐源县","resolved_place_entity_id":1755,"start_index":78,"tongjian_id":"c27f7396-db0e-11ef-ac58-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"唐破吐蕃维州之战","tongjian_id":"war_N1047"},{"title":"维州之战","tongjian_id":"war_N1046"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"太和中来降，诏弃之。大中三年，复内附。宋白曰：维州城因山...","context_before":"...四五百里。广德初，复陷于吐蕃。贞元八年，韦皋攻之，不克。","source_end_index":317,"source_paragraph_tongjian_id":"eb7e5965-36e4-5af7-a4c9-37e7604beae2","source_start_index":287,"source_text":"十七年，皋复攻维州，明年，大破吐蕃援兵于维州城下，竟不能克。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二十二、松潘卫（卷七十三）","excerpts":[{"context_after":"《新唐书》：翼州有峨和、白岸、都护、祚鼎四城，合江、穀塠...","context_before":"白岸城[在所西。","source_end_index":35,"source_paragraph_tongjian_id":"d47a03eb-5abc-597f-b223-9b459289c883","source_start_index":8,"source_text":"唐贞元中，韦皋破吐蕃论莽热兵，进屯白岸，西山诸羌皆降。"}],"path":"四川方舆纪要/二十二、松潘卫（卷七十三）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2吐蕃遣其大相兼東鄙五道節度使論莽熱將兵十萬解維州之圍，西川兵據險設伏以待之。吐蕃至，出千人挑戰，虜悉衆追之，伏發，虜衆大敗，擒論莽熱，士卒死者太半。維州、昆明竟不下，引兵還。乙亥，皋遣使獻論莽熱，上赦之。","content_fanyi":"吐蕃赞普派遣大相兼东部边境五道节度使论莽热率领十万兵力，前去解救韦皋对维州的包围。韦皋的西川兵占据险要地势设下埋伏，等待吐蕃军到来。吐蕃军到达后，韦皋派出一千人挑战，吐蕃全军追击，伏兵突然杀出，吐蕃军大败，论莽热被生擒，士兵战死超过一半。但维州、昆明二城最终未能攻下，韦皋只得率军返回。正月十八日乙亥，韦皋派遣使者将论莽热进献给朝廷，德宗赦免了他。","content_jianti_auto":"2吐蕃遣其大相兼东鄙五道节度使论莽热将兵十万解维州之围，西川兵据险设伏以待之。吐蕃至，出千人挑战，虏悉众追之，伏发，虏众大败，擒论莽热，士卒死者太半。维州、昆明竟不下，引兵还。乙亥，皋遣使献论莽热，上赦之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23773,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"c27f7387-db0e-11ef-ad8a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":16,"source_start_index":9,"source_text":"事見上卷十二年","target_paragraph_tongjian_id":"c25ad1e7-db0e-11ef-86dc-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"裴肅","people_name_jianti_auto":"裴肃","start_index":0,"tongjian_id":"c27f739b-db0e-11ef-88ab-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"裴肅以進奉得廉車，事見上卷十二年。","note_content_jianti_auto":"裴肃以进奉得廉车，事见上卷十二年。","note_type":"hu_note","start_index":15,"tongjian_id":"c27f739a-db0e-11ef-8e66-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"張","people_name_jianti_auto":"张","start_index":1,"tongjian_id":"c27f739e-db0e-11ef-9f1e-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『張：「判」上脫「肅卒」。』","note_content_jianti_auto":"『张：「判」上脱「肃卒」。』","note_type":"『張：[^』]*』","start_index":0,"tongjian_id":"c27f739d-db0e-11ef-9e9a-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":16,"tongjian_id":"c27f739c-db0e-11ef-8af4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":