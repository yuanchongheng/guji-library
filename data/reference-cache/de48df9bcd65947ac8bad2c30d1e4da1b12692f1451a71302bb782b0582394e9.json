{"data":{"current_mention_tongjian_id":"8c49c1fe-db0e-11ef-b34c-a0d3651f611f","current_paragraph_tongjian_id":"8c4774a4-db0e-11ef-a485-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":3,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"屈宜臼","people_name_jianti_auto":"屈宜臼","start_index":2,"tongjian_id":"8c39b13d-db0e-11ef-b438-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卒如屈宜臼言。卒，子恤翻。","note_content_jianti_auto":"卒如屈宜臼言。卒，子恤翻。","note_type":"hu_note","start_index":10,"tongjian_id":"8c39b13c-db0e-11ef-8b66-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宣惠","people_name_jianti_auto":"宣惠","start_index":0,"tongjian_id":"8c39b13f-db0e-11ef-a9e4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宣惠，複諡也。","note_content_jianti_auto":"宣惠，复谥也。","note_type":"hu_note","start_index":16,"tongjian_id":"8c39b13e-db0e-11ef-b1ca-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-312,"link_td_description":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","link_td_id":"Q10000620","link_td_number_id":334590,"people_name":"宣惠王","people_name_jianti_auto":"宣惠王","people_xingming":"韩宣惠王","start_index":11,"tongjian_id":"8c39b142-db0e-11ef-8273-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2韓高門成。昭侯薨，子宣惠王立。","content_fanyi":"韩国高大的宫门建成。韩昭侯去世，他的儿子韩宣惠王即位。","content_jianti_auto":"2韩高门成。昭侯薨，子宣惠王立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":184,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c39b13b-db0e-11ef-bf88-a0d3651f611f","year_int":-333},"tongjian_id":"8c39b13b-db0e-11ef-bf88-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"韩王是否采纳苏秦的合纵抗秦之策","decision_tongjian_id":"DECISION_8C3E2172DB0E11EF84F0A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"被，皮義翻。蹠，之石翻，踏也。史記正義曰：欲放弩者皆坐，舉足踏弩材，手引湊機，然後發之。","note_content_jianti_auto":"被，皮义翻。跖，之石翻，踏也。史记正义曰：欲放弩者皆坐，举足踏弩材，手引凑机，然后发之。","note_type":"hu_note","start_index":69,"tongjian_id":"8c3e2173-db0e-11ef-9495-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":48,"tongjian_id":"8c3e2176-db0e-11ef-9b68-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","start_index":0,"tongjian_id":"8c3e2177-db0e-11ef-9f52-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","start_index":2,"tongjian_id":"8c3e2178-db0e-11ef-abed-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":9,"tongjian_id":"8c3e2179-db0e-11ef-90ab-a0d3651f611f"},{"place_name":"函谷","place_name_jianti_auto":"函谷","start_index":12,"tongjian_id":"8c3e217a-db0e-11ef-af89-a0d3651f611f"},{"place_name":"成皋","place_name_jianti_auto":"成皋","place_note":"河南荥阳西北","start_index":19,"tongjian_id":"8c3e217b-db0e-11ef-ab13-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":22,"tongjian_id":"8c3e217c-db0e-11ef-a84a-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":24,"tongjian_id":"8c3e217d-db0e-11ef-8830-a0d3651f611f"},{"place_name":"虎牢","place_name_jianti_auto":"虎牢","start_index":31,"tongjian_id":"8c3e217e-db0e-11ef-8acf-a0d3651f611f"},{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":34,"tongjian_id":"8c3e217f-db0e-11ef-b162-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":38,"tongjian_id":"8c3e2180-db0e-11ef-97b1-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":44,"tongjian_id":"8c3e2181-db0e-11ef-9ec6-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","place_note":"河南宜阳","start_index":51,"tongjian_id":"8c3e2182-db0e-11ef-b151-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":54,"tongjian_id":"8c3e2183-db0e-11ef-bbc9-a0d3651f611f"},{"place_name":"成皋","place_name_jianti_auto":"成皋","place_note":"河南荥阳西北","start_index":58,"tongjian_id":"8c3e2184-db0e-11ef-85b6-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":61,"tongjian_id":"8c3e2185-db0e-11ef-a1a5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓之宜陽，西接境於秦，當函谷出兵之路。成皋，春秋鄭之制邑，亦曰虎牢，戰國時爲鄭之屛蔽，皆韓之地。班志，宜陽屬弘農郡，成皋屬河南郡。","note_content_jianti_auto":"韩之宜阳，西接境于秦，当函谷出兵之路。成皋，春秋郑之制邑，亦曰虎牢，战国时为郑之屛蔽，皆韩之地。班志，宜阳属弘农郡，成皋属河南郡。","note_type":"hu_note","start_index":97,"tongjian_id":"8c3e2175-db0e-11ef-8751-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"市，買也。凡以物買賣貿易曰市。","note_content_jianti_auto":"市，买也。凡以物买卖贸易曰市。","note_type":"hu_note","start_index":162,"tongjian_id":"8c3e2188-db0e-11ef-a10f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":39,"tongjian_id":"8c3e218a-db0e-11ef-af28-a0d3651f611f"},{"people_name":"韓王","people_name_jianti_auto":"韩王","start_index":42,"tongjian_id":"8c3e218b-db0e-11ef-8dea-a0d3651f611f"},{"people_name":"延篤","people_name_jianti_auto":"延笃","start_index":117,"tongjian_id":"8c3e218c-db0e-11ef-8a32-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諺，魚變翻，俗言也。史記正義曰：雞口雖小，猶進食；牛後雖大，乃出糞。爾雅翼曰：蘇秦說韓王，「寧爲雞尸，無爲牛從。」尸，主也；一羣之主，所以將衆也。從，從物者也，謂牛子也；隨羣而往，制不在我者也。言寧爲雞中之主，不爲牛子之從後也。此本諸延篤註戰國策。","note_content_jianti_auto":"谚，鱼变翻，俗言也。史记正义曰：鸡口虽小，犹进食；牛后虽大，乃出粪。尔雅翼曰：苏秦说韩王，「宁为鸡尸，无为牛从。」尸，主也；一群之主，所以将众也。从，从物者也，谓牛子也；随群而往，制不在我者也。言宁为鸡中之主，不为牛子之从后也。此本诸延笃注战国策。","note_type":"hu_note","start_index":186,"tongjian_id":"8c3e2189-db0e-11ef-877b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"韓宣惠王","official_note":"韓宣惠王是戰國時期韓國君主，此處作為蘇秦遊說的對象，在上下文中代表韓國的最高統治者，負責國家決策。","official_rank":"王爵","source_snippet":"於是蘇秦說韓宣惠王曰","start_index":4,"tongjian_id":"56f2a1b0-034b-4a35-8f1b-7ba643bc749e"},{"confidence":0.9,"official_category":"地方行政","official_name":"大王","official_note":"大王是對君主的尊稱，此處指韓宣惠王，在上下文中用於勸諫其外交政策，強調其作為統治者的權威和責任。","official_rank":"王爵","source_snippet":"大王事秦","start_index":94,"tongjian_id":"59e30acb-4527-4f4a-9ff9-9ac5bf8efc9f"},{"confidence":0.9,"official_category":"地方行政","official_name":"韓王","official_note":"韓王是對韓國君主的簡稱，此處指韓宣惠王，在上下文中表示他接受了蘇秦的建議，作為決策者推動國家行動。","official_rank":"王爵","source_snippet":"韓王從其言","start_index":217,"tongjian_id":"a24c48a6-b300-41a5-adf9-cdac2a7ee42c"}],"ExtRef_Children_people":[{"link_death_year":-312,"link_td_description":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","link_td_id":"Q10000620","link_td_number_id":334590,"people_name":"韓宣惠王","people_name_jianti_auto":"韩宣惠王","people_xingming":"韩宣惠王","start_index":5,"tongjian_id":"8c3e2192-db0e-11ef-947f-a0d3651f611f"},{"link_death_year":-312,"link_td_description":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","link_td_id":"Q10000620","link_td_number_id":334590,"people_name":"韓王","people_name_jianti_auto":"韩王","people_xingming":"韩宣惠王","start_index":215,"tongjian_id":"8c3e219c-db0e-11ef-ba4f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/苏张说六国","excerpts":[{"context_after":"。谓燕地方二千余里，带甲数十万，车六百乘，骑六千匹；谓赵...","context_before":"...鬼谷，而其从横之辩，如冰炭水火之不同，盖所以设心者异耳。","source_end_index":50,"source_paragraph_tongjian_id":"1db2313c-c7f2-4053-bd18-4454471f59de","source_start_index":36,"source_text":"苏欲六国合从以摈秦，故言其强"}],"path":"续笔/卷二/苏张说六国","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"○张仪请秦伐韩曰：亲魏善楚，下兵三川[三川，谓成周也。河...","context_before":"《战国策》：","source_end_index":168,"source_paragraph_tongjian_id":"b4d16548-9039-5bed-af93-54f64ccb30cd","source_start_index":6,"source_text":"苏秦曰：韩北有巩、洛、成皋之固[巩、洛、成皋，俱见前]，西有宜阳、商阪之塞[宜阳，今河南府有宜阳县。商阪，即商洛山，在陕西商州东南九十里。司马贞曰：商阪在商、洛间，适秦、楚之险塞]，东有宛、穰、洧水[宛，即申；穰，即邓也。洧水，出禹州密县，至陈州西华县而入于颍水]，南有陉山[陉山，在新郑县西南三十里，亦名陉塞]，地方千里。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"张仪曰：秦攻新城、宜阳，以临二周之郊。又说韩曰：秦下甲据...","context_before":"○宜阳城[在县东北十四里，韩城也。","source_end_index":53,"source_paragraph_tongjian_id":"c6cba627-a9d9-5dec-9de3-c71783a832ff","source_start_index":17,"source_text":"苏秦说赵曰：韩弱则效宜阳，宜阳效则上郡绝。说韩曰：韩西有宜阳、商阪之塞。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、南阳府（卷五十一）","excerpts":[{"context_after":"其后谓之南阳。《战国策》：秦惠王时，楚、魏战于陉山[见前...","context_before":"...申、邓者，楚图郑之道所自出也]。战国时，宛、穰尝为韩有。","source_end_index":209,"source_paragraph_tongjian_id":"06f2ec1d-e122-5487-9bbc-bb711a43e265","source_start_index":185,"source_text":"苏秦说韩，谓“北有成皋之固，西有商阪之阻”者也。"}],"path":"河南方舆纪要/八、南阳府（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"於是蘇秦說韓宣惠王曰：「韓地方九百餘里，帶甲數十萬，天下之強弓、勁弩、利劍皆從韓出。韓卒超足而射，百發不暇止。以韓卒之勇，被堅甲，蹠勁弩，帶利劍，一人當百，不足言也。大王事秦，秦必求宜陽、成皋；今茲効之，明年復求割地。與則無地以給之；不與則棄前功，受後禍。且大王之地有盡而秦求無已，以有盡之地逆無已之求，此所謂市怨結禍者也。不戰而地已削矣。鄙諺曰：『寧爲雞口，無爲牛後。』夫以大王之賢，挾強韓之兵，而有牛後之名，臣竊爲大王羞之！」韓王從其言。","content_fanyi":"于是苏秦游说韩宣惠王说：“韩国土地方圆九百多里，披甲的兵士有几十万，天下的强弓、劲弩、利剑都从韩国出产。韩国士兵脚踏弩机射箭，连射上百箭也来不及停歇。凭着韩国士兵的勇猛，身披坚甲，足踏劲弩，佩带利剑，以一人抵挡百人，也不在话下。大王如果侍奉秦国，秦国必定会索求宜阳、成皋；今年献出这些地方，明年它又会要求割让别的土地。给它吧，已没有土地可给；不给吧，就会前功尽弃，接着遭受祸患。况且大王的土地有穷尽，而秦国的索求没有止境，用有限的土地去面对没有止境的索求，这就叫作买来怨恨、结下祸患。仗还没有打，土地就已经被削减了。俗语说：‘宁可做鸡口，也不做牛后。’凭大王的贤明，拥有强大韩国的军队，却落得牛后的名声，我私下替大王感到羞愧！”韩王于是听从了他的话。","content_jianti_auto":"于是苏秦说韩宣惠王曰：「韩地方九百余里，带甲数十万，天下之强弓、劲弩、利剑皆从韩出。韩卒超足而射，百发不暇止。以韩卒之勇，被坚甲，跖劲弩，带利剑，一人当百，不足言也。大王事秦，秦必求宜阳、成皋；今兹効之，明年复求割地。与则无地以给之；不与则弃前功，受后祸。且大王之地有尽而秦求无已，以有尽之地逆无已之求，此所谓市怨结祸者也。不战而地已削矣。鄙谚曰：『宁为鸡口，无为牛后。』夫以大王之贤，挟强韩之兵，而有牛后之名，臣窃为大王羞之！」韩王从其言。","dtjl_paragraph_links":[],"dtjl_references":[],"id":189,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"8c3e2172-db0e-11ef-84f0-a0d3651f611f","year_int":-333},"tongjian_id":"8c3e2172-db0e-11ef-84f0-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"智氏","people_name_jianti_auto":"智氏","start_index":4,"tongjian_id":"8c49c1e5-db0e-11ef-81ec-a0d3651f611f"},{"people_name":"范氏","people_name_jianti_auto":"范氏","start_index":7,"tongjian_id":"8c49c1e6-db0e-11ef-8e2e-a0d3651f611f"},{"people_name":"中行氏","people_name_jianti_auto":"中行氏","start_index":10,"tongjian_id":"8c49c1e7-db0e-11ef-a0a7-a0d3651f611f"},{"people_name":"趙氏","people_name_jianti_auto":"赵氏","start_index":14,"tongjian_id":"8c49c1e8-db0e-11ef-b43f-a0d3651f611f"},{"people_name":"韓氏","people_name_jianti_auto":"韩氏","start_index":17,"tongjian_id":"8c49c1e9-db0e-11ef-a594-a0d3651f611f"},{"people_name":"魏氏","people_name_jianti_auto":"魏氏","start_index":20,"tongjian_id":"8c49c1ea-db0e-11ef-9577-a0d3651f611f"},{"people_name":"晉文","people_name_jianti_auto":"晋文","start_index":25,"tongjian_id":"8c49c1eb-db0e-11ef-8178-a0d3651f611f"},{"people_name":"襄","people_name_jianti_auto":"襄","start_index":28,"tongjian_id":"8c49c1ec-db0e-11ef-b5b5-a0d3651f611f"},{"people_name":"齊簡公","people_name_jianti_auto":"齐简公","start_index":47,"tongjian_id":"8c49c1ed-db0e-11ef-b19d-a0d3651f611f"},{"people_name":"闞止","people_name_jianti_auto":"阚止","start_index":51,"tongjian_id":"8c49c1ee-db0e-11ef-8789-a0d3651f611f"},{"people_name":"陳成子","people_name_jianti_auto":"陈成子","start_index":56,"tongjian_id":"8c49c1ef-db0e-11ef-a834-a0d3651f611f"},{"people_name":"陳常","people_name_jianti_auto":"陈常","start_index":64,"tongjian_id":"8c49c1f0-db0e-11ef-b946-a0d3651f611f"},{"people_name":"闞止","people_name_jianti_auto":"阚止","start_index":67,"tongjian_id":"8c49c1f1-db0e-11ef-bd40-a0d3651f611f"},{"people_name":"簡公","people_name_jianti_auto":"简公","start_index":71,"tongjian_id":"8c49c1f2-db0e-11ef-9419-a0d3651f611f"},{"people_name":"闞","people_name_jianti_auto":"阚","start_index":74,"tongjian_id":"8c49c1f3-db0e-11ef-a8f8-a0d3651f611f"},{"people_name":"蘇代","people_name_jianti_auto":"苏代","start_index":81,"tongjian_id":"8c49c1f4-db0e-11ef-bf3c-a0d3651f611f"},{"people_name":"犀首","people_name_jianti_auto":"犀首","start_index":87,"tongjian_id":"8c49c1f5-db0e-11ef-95ad-a0d3651f611f"},{"people_name":"張儀","people_name_jianti_auto":"张仪","start_index":98,"tongjian_id":"8c49c1f6-db0e-11ef-afcc-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":0,"tongjian_id":"8c49c1f7-db0e-11ef-948a-a0d3651f611f"},{"place_name":"晉國","place_name_jianti_auto":"晋国","start_index":44,"tongjian_id":"8c49c1f8-db0e-11ef-af14-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":85,"tongjian_id":"8c49c1f9-db0e-11ef-a731-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":92,"tongjian_id":"8c49c1fa-db0e-11ef-a49e-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":95,"tongjian_id":"8c49c1fb-db0e-11ef-95da-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":103,"tongjian_id":"8c49c1fc-db0e-11ef-bea4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":126,"tongjian_id":"8c49c1fd-db0e-11ef-a7c6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉六卿，智氏、范氏、中行氏、趙氏、韓氏、魏氏也。自晉文、襄以來，迭秉國政，後皆強大，卒分晉國。齊簡公使闞止爲政，陳成子憚之；已而陳常殺闞止，弒簡公。闞，以邑爲氏。蘇代曰：魏相犀首，必右韓而左魏；相張儀，必右秦而左魏。蓋二相外各倚與國以爲重而內爭權，所以魏日削也。闞，戶監翻。行，戶剛翻。恆，戶登翻。卒，子恤翻。相，息亮翻。","note_content_jianti_auto":"晋六卿，智氏、范氏、中行氏、赵氏、韩氏、魏氏也。自晋文、襄以来，迭秉国政，后皆强大，卒分晋国。齐简公使阚止为政，陈成子惮之；已而陈常杀阚止，弑简公。阚，以邑为氏。苏代曰：魏相犀首，必右韩而左魏；相张仪，必右秦而左魏。盖二相外各倚与国以为重而内争权，所以魏日削也。阚，户监翻。行，户刚翻。恒，户登翻。卒，子恤翻。相，息亮翻。","note_type":"hu_note","start_index":64,"tongjian_id":"8c4774a6-db0e-11ef-9826-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-312,"link_td_description":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","link_td_id":"Q10000620","link_td_number_id":334590,"people_name":"韓宣惠王","people_name_jianti_auto":"韩宣惠王","people_xingming":"韩宣惠王","start_index":1,"tongjian_id":"8c49c1fe-db0e-11ef-b34c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"[吕氏曰：秦孝公用商鞅，取河西地。其尽得河西，则犀首张仪...","context_before":"...年，魏纳上郡十五县[今延安以北地]，而河西之地尽入于秦。","source_end_index":425,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":396,"source_text":"《战国策》：摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"5韓宣惠王欲兩用公仲、公叔爲政，問於繆留。對曰：「不可，晉用六卿而國分；齊簡公用陳成子及闞止而見殺；魏用犀首、張儀而西河之外亡。今君兩用之，其多力者內樹黨，其寡力者藉外權。羣臣有內樹黨以驕主，有外爲交以削地，君之國危矣。」","content_fanyi":"韩宣惠王想同时任用公仲和公叔两人执掌国政，便向缪留询问。缪留回答说：“不可以，晋国任用六卿，国家因而分裂；齐简公任用陈成子和阚止，自身因而被杀；魏国任用犀首、张仪，西河以外的土地因而丧失。如今您要同时任用这两人，他们中力量强的一方便会在国内树立党羽，力量弱的一方便会向外借助他国权势。群臣中有的在国内树立党羽以欺凌君主，有的对外结交以削减国土，您的国家就危险了。”","content_jianti_auto":"5韩宣惠王欲两用公仲、公叔为政，问于缪留。对曰：「不可，晋用六卿而国分；齐简公用陈成子及阚止而见杀；魏用犀首、张仪而西河之外亡。今君两用之，其多力者内树党，其寡力者藉外权。群臣有内树党以骄主，有外为交以削地，君之国危矣。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":223,"number":5,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十八年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"8c4774a4-db0e-11ef-a485-a0d3651f611f","year_int":-321},"tongjian_id":"8c4774a4-db0e-11ef-a485-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-312,"link_td_description":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","link_td_id":"Q10000620","link_td_number_id":334590,"people_name":"韓宣惠王","people_name_jianti_auto":"韩宣惠王","people_xingming":"韩宣惠王","start_index":1,"tongjian_id":"8c682308-db0e-11ef-9569-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3韓宣惠王薨，子襄王倉立。","content_fanyi":"韩国宣惠王去世，其子韩襄王仓继位。","content_jianti_auto":"3韩宣惠王薨，子襄王仓立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":248,"number":3,"path":"资治通鉴 : 卷第三 (周紀三) / 赧王上 / 三年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c682307-db0e-11ef-b0ea-a0d3651f611f","year_int":-312},"tongjian_id":"8c682307-db0e-11ef-b0ea-a0d3651f611f"},"paragraph_order":4}],"page_size":7,"total_pages":1,"total_paragraphs":4},"profile":{"alias_list":["韩威侯","韩宣王"],"biography":"韩宣惠王，或称韩威侯，名康，战国时期韩国君主，韩釐侯之子，在位21年。","death_year":-312,"link_td_id":"Q10000620","name":"韩宣惠王","number_id":334590},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"君臣关系，张谴为其相国，来源文本：张谴，战国韓國人，韓昭侯、韩宣惠王的相國。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10003823","source_person_name":"张谴","source_person_number_id":4763226,"statement_id":"S-Q10003823-P100061-Q10000620","target_person_id":"Q10000620","target_person_name":"韩宣惠王","target_person_number_id":334590},{"direction":"reverse","rank":"normal","relation_detail":"辅佐关系，来源文本：张开地先后辅佐韩昭侯、韩宣惠王、韩襄王三代国君","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10014934","source_person_name":"张开地","source_person_number_id":3203833,"statement_id":"S-Q10014934-P100061-Q10000620","target_person_id":"Q10000620","target_person_name":"韩宣惠王","target_person_number_id":334590},{"direction":"reverse","rank":"normal","relation_detail":"君臣关系（君主与属下），来源文本：申差（?－?），战国时期韩国的军事人物，在韩宣惠王属下。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10023156","source_person_name":"申差","source_person_number_id":8173889,"statement_id":"S-Q10023156-P100061-Q10000620","target_person_id":"Q10000620","target_person_name":"韩宣惠王","target_person_number_id":334590}]},"message":"success","success":true}