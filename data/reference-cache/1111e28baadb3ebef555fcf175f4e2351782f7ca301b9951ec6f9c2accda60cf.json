-db0e-11ef-bd30-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","start_index":76,"tongjian_id":"95417005-db0e-11ef-b92a-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":80,"tongjian_id":"95417006-db0e-11ef-8bc7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：前書曰：漢遣公主爲烏孫夫人，結爲昆弟，則是斷匈奴右臂也。哀帝時，劉歆上議曰：武帝立五屬國，起朔方，伐朝鮮，起玄菟、樂浪以斷匈奴左臂也；西伐大宛，結烏孫，裂匈奴之右臂也。南面，以西爲右。斷，丁管翻。","note_content_jianti_auto":"贤曰：前书曰：汉遣公主为乌孙夫人，结为昆弟，则是断匈奴右臂也。哀帝时，刘歆上议曰：武帝立五属国，起朔方，伐朝鲜，起玄菟、乐浪以断匈奴左臂也；西伐大宛，结乌孙，裂匈奴之右臂也。南面，以西为右。断，丁管翻。","note_type":"hu_note","start_index":125,"tongjian_id":"95416ff7-db0e-11ef-8f79-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"條支國","place_name_jianti_auto":"条支国","start_index":6,"tongjian_id":"95417009-db0e-11ef-8bcc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西域傳曰：自條支國乘水西行，可百餘日，近日所入也。","note_content_jianti_auto":"西域传曰：自条支国乘水西行，可百余日，近日所入也。","note_type":"hu_note","start_index":142,"tongjian_id":"95417008-db0e-11ef-9611-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"9541700d-db0e-11ef-874f-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":23,"tongjian_id":"9541700e-db0e-11ef-ab05-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":27,"tongjian_id":"9541700f-db0e-11ef-8d69-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十六行本「延」作「焉」；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：甲十六行本「延」作「焉」；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"9541700c-db0e-11ef-949f-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":154,"tongjian_id":"9541700b-db0e-11ef-964d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂城郭之國，若小若大，其言皆然。","note_content_jianti_auto":"谓城郭之国，若小若大，其言皆然。","note_type":"hu_note","start_index":219,"tongjian_id":"95417011-db0e-11ef-b015-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95417013-db0e-11ef-8288-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：效猶驗也。","note_content_jianti_auto":"贤曰：效犹验也。","note_type":"hu_note","start_index":224,"tongjian_id":"95417012-db0e-11ef-a3de-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古領、嶺字通。","note_content_jianti_auto":"古领、岭字通。","note_type":"hu_note","start_index":230,"tongjian_id":"95417014-db0e-11ef-a13d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"溫宿國","place_name_jianti_auto":"温宿国","start_index":3,"tongjian_id":"95417017-db0e-11ef-a6e8-a0d3651f611f"},{"place_name":"溫宿城","place_name_jianti_auto":"温宿城","start_index":7,"tongjian_id":"95417018-db0e-11ef-8377-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":12,"tongjian_id":"95417019-db0e-11ef-9bc2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"前書，溫宿國治溫宿城，去長安八千三百五十里。","note_content_jianti_auto":"前书，温宿国治温宿城，去长安八千三百五十里。","note_type":"hu_note","start_index":341,"tongjian_id":"95417016-db0e-11ef-959a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"更，工衡翻。降，戶江翻；下同。","note_content_jianti_auto":"更，工衡翻。降，户江翻；下同。","note_type":"hu_note","start_index":370,"tongjian_id":"9541701c-db0e-11ef-b65b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","start_index":1,"tongjian_id":"9541701f-db0e-11ef-8af1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言西域平定，廷臣畢賀，天子爲之舉觴也。","note_content_jianti_auto":"言西域平定，廷臣毕贺，天子为之举觞也。","note_type":"hu_note","start_index":421,"tongjian_id":"9541701e-db0e-11ef-aac0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95417021-db0e-11ef-9bfe-a0d3651f611f"},{"people_name":"超","people_name_jianti_auto":"超","start_index":31,"tongjian_id":"95417022-db0e-11ef-aa0b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","start_index":35,"tongjian_id":"95417023-db0e-11ef-ae38-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：薦，進也。勳，功也。左氏傳曰：反行飲至，舍爵策勳也。余謂超蓋言平西域，告成功於祖廟也。","note_content_jianti_auto":"贤曰：荐，进也。勋，功也。左氏传曰：反行饮至，舍爵策勋也。余谓超盖言平西域，告成功于祖庙也。","note_type":"hu_note","start_index":434,"tongjian_id":"95417020-db0e-11ef-9f3d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"胡","place_name_jianti_auto":"胡","start_index":21,"tongjian_id":"95417026-db0e-11ef-a20d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"弛，刑徒也。義從，自奮願從行者。或曰：義從胡也。從，才用翻。","note_content_jianti_auto":"弛，刑徒也。义从，自奋愿从行者。或曰：义从胡也。从，才用翻。","note_type":"hu_note","start_index":481,"tongjian_id":"95417025-db0e-11ef-a7db-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"假司馬","official_note":"假司馬是漢代軍職，為司馬的副職或代理司馬，負責協助軍事指揮。在《資治通鑑》此段中，平陵徐幹上疏願協助班超，漢章帝任命他為假司馬，率領弛刑及義從千人支援班超，這反映了漢朝對西域事務的軍事介入。","official_rank":"未知","source_snippet":"帝以幹爲假司馬","start_index":468,"tongjian_id":"da6626e5-62a3-4c9b-8706-9507a01428f3"}],"ExtRef_Children_people":[{"link_birth_year":32,"link_death_year":102,"link_td_description":"班超，字仲升，右扶风平陵县（今陕西省咸阳市秦都区）人，东汉将领、外交家。是开拓和维持汉代与西域关系的重要人物。","link_td_id":"Q10007410","link_td_number_id":13520,"people_name":"班超","people_name_jianti_auto":"班超","people_xingming":"班超","start_index":1,"tongjian_id":"95417027-db0e-11ef-9953-a0d3651f611f"},{"link_td_description":"白霸，东汉时龟兹王。","link_td_id":"Q10015743","link_td_number_id":3595730,"people_name":"白霸","people_name_jianti_auto":"白霸","people_xingming":"白霸","start_index":242,"tongjian_id":"9541703f-db0e-11ef-9059-a0d3651f611f"},{"link_birth_year":32,"link_death_year":102,"link_td_description":"班超，字仲升，右扶风平陵县（今陕西省咸阳市秦都区）人，东汉将领、外交家。是开拓和维持汉代与西域关系的重要人物。","link_td_id":"Q10007410","link_td_number_id":13520,"people_name":"超","people_name_jianti_auto":"超","start_index":391,"tongjian_id":"9541704b-db0e-11ef-afa0-a0d3651f611f"},{"link_birth_year":170,"link_death_year":217,"link_td_description":"徐干，字伟长，北海郡剧县人，东汉时期文学家，建安七子之一。","link_td_id":"Q10007497","link_td_number_id":228192,"people_name":"徐幹","people_name_jianti_auto":"徐干","peo