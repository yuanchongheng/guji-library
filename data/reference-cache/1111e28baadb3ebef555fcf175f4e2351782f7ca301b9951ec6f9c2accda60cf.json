c-a0d3651f611f"},{"place_name":"溫宿","place_name_jianti_auto":"温宿","resolved_place_entity_id":2477,"start_index":329,"tongjian_id":"95417048-db0e-11ef-b3e4-a0d3651f611f"},{"place_name":"龜茲","place_name_jianti_auto":"龟兹","resolved_place_entity_id":649,"start_index":336,"tongjian_id":"95417049-db0e-11ef-b03d-a0d3651f611f"},{"place_name":"龜茲","place_name_jianti_auto":"龟兹","resolved_place_entity_id":649,"start_index":365,"tongjian_id":"9541704a-db0e-11ef-9c05-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":408,"tongjian_id":"9541704c-db0e-11ef-877f-a0d3651f611f"},{"place_name":"平陵","place_name_jianti_auto":"平陵","resolved_place_entity_id":1289,"start_index":449,"tongjian_id":"95417051-db0e-11ef-874b-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与西域各国的战争","tongjian_id":"war_N0614"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"章和元年，班超击降之。永和以后，与中国隔远。其后灭于匈奴...","context_before":"...大宛、妫塞诸国，使其将守之。寻为于阗所败。其后降于龟兹。","source_end_index":249,"source_paragraph_tongjian_id":"ff0f228c-dd37-5a98-b42e-e83e9fb2c672","source_start_index":203,"source_text":"建初五年，班超言莎车、疏勒，田地肥广，草木饶衍，不比敦煌、鄯善间，兵可不费中国，而粮食自足。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"5班超欲遂平西域，上疏請兵曰：「臣竊見先帝欲開西域，故北擊匈奴，西使外國，鄯善、于窴卽時向化，今拘彌、莎車、疏勒、月氏、烏孫、康居復願歸附，欲共幷力，破滅龜茲，平通漢道。若得龜茲，則西域未服者百分之一耳。前世議者皆曰：『取三十六國，號爲斷匈奴右臂。』今西域諸國，自日之所入，莫不向化，大小欣欣，貢奉不絕，唯延耆、龜茲獨未服從。臣前與官屬三十六人奉使絕域，備遭艱戹，自孤守疏勒，於今五載，胡夷情數，臣頗識之，問其城郭小大，皆言倚漢與依天等。以是效之，則葱領可通，龜茲可伐。今宜拜龜茲侍子白霸爲其國王，以步騎數百送之，與諸國連兵，歲月之間，龜茲可禽。以夷狄攻夷狄，計之善者也！臣見莎車、疏勒田地肥廣，草牧饒衍，不比敦煌、鄯善間也，兵可不費中國而糧食自足。且姑墨、溫宿二王，特爲龜茲所置，旣非其種，更相厭苦，其勢必有降者；若二國來降，則龜茲自破。願下臣章，參考行事，誠有萬分，死復何恨！臣超區區特蒙神靈，竊冀未便僵仆，目見西域平定，陛下舉萬年之觴，薦勳祖廟，布大喜於天下。」書奏，帝知其功可成，議欲給兵。平陵徐幹上疏，願奮身佐超，帝以幹爲假司馬，將弛刑及義從千人就超。","content_fanyi":"班超想要乘势完全平定西域，上疏请求增派援兵说：“臣私下看到先帝想要开拓西域，所以向北攻打匈奴，向西出使外国，鄯善、于阗即时归顺。现在拘弥、莎车、疏勒、月氏、乌孙、康居又愿意重新归附，想要联合力量，共同消灭龟兹，打通汉道。如果得到龟兹，那么西域尚未归服的不过百分之一而已。前代议论西域的人都说：‘取得西域三十六国，可说是斩断了匈奴的右臂。’现在西域各国，从太阳落下的地方，没有不倾慕汉德、向往归化的，大国小国都欢欣喜悦，进贡不断，只有延耆、龟兹仍然不服从。臣以前与官属三十六人奉命出使绝远异域，备尝艰难困苦，自从孤守疏勒，至今已经五年。胡夷的情况，臣颇为了解；询问大小城邦，他们都说依附汉朝如同依附上天一般。以此验证，那么葱岭可以通行，龟兹国可以讨伐。现在应当册立龟兹入侍的王子白霸为龟兹国王，派数百名步骑兵护送他，与各国联兵，几个月之内，龟兹就可降服。用夷狄攻打夷狄，这是最好的计策！臣看到莎车、疏勒田地肥沃广阔，牧草丰饶，不像敦煌、鄯善之间那样贫乏；军队可以不依靠中原供应而粮食自足。况且姑墨、温宿二国的国王，本是龟兹所立；他们既与龟兹不是同族，又与龟兹互相厌恶怨恨，照这种形势必有归降的；如果二国来降，那么龟兹自然不攻自破。希望把臣的奏章下交朝廷审议，作为施政参考，如果真有万分之一的不测，臣死也没有遗恨！臣班超不过是区区微躯，特别蒙受神灵护佑，私下希望不要很快倒毙，能亲眼看到西域平定，陛下举起庆祝万年太平的酒杯，向祖庙献上功勋，向天下颁示这特大喜讯。”奏书呈上后，汉章帝知道这项功业可以成就，便商议准备派发援兵。平陵人徐幹上疏，愿意奋身辅佐班超，汉章帝便任命徐幹为假司马，率领减刑的囚犯和自愿随从的一千人前往班超处。","content_jianti_auto":"5班超欲遂平西域，上疏请兵曰：「臣窃见先帝欲开西域，故北击匈奴，西使外国，鄯善、于窴即时向化，今拘弥、莎车、疏勒、月氏、乌孙、康居复愿归附，欲共幷力，破灭龟兹，平通汉道。若得龟兹，则西域未服者百分之一耳。前世议者皆曰：『取三十六国，号为断匈奴右臂。』今西域诸国，自日之所入，莫不向化，大小欣欣，贡奉不绝，唯延耆、龟兹独未服从。臣前与官属三十六人奉使绝域，备遭艰戹，自孤守疏勒，于今五载，胡夷情数，臣颇识之，问其城郭小大，皆言倚汉与依天等。以是效之，则葱领可通，龟兹可伐。今宜拜龟兹侍子白霸为其国王，以步骑数百送之，与诸国连兵，岁月之间，龟兹可禽。以夷狄攻夷狄，计之善者也！臣见莎车、疏勒田地肥广，草牧饶衍，不比敦煌、鄯善间也，兵可不费中国而粮食自足。且姑墨、温宿二王，特为龟兹所置，既非其种，更相厌苦，其势必有降者；若二国来降，则龟兹自破。愿下臣章，参考行事，诚有万分，死复何恨！臣超区区特蒙神灵，窃冀未便僵仆，目见西域平定，陛下举万年之觞，荐勋祖庙，布大喜于天下。」书奏，帝知其功可成，议欲给兵。平陵徐干上疏，愿奋身佐超，帝以干为假司马，将弛刑及义从千人就超。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3684,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"95416ff3-db0e-11ef-a842-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否联合乌孙以进攻龟兹","decision_tongjian_id":"DECISION_95417052DB0E11EFB660A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":10,"source_start_index":0,"source_text":"事見二十一卷元封六年","target_paragraph_tongjian_id":"90331569-db0e-11ef-b922-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見二十一卷元封六年。妻，七細翻。","note_content_jianti_auto":"事见二十一卷元封六年。妻，七细翻。","note_type":"hu_note","start_index":91,"tongjian_id":"95417056-db0e-11ef-ab8a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":10,"source_start_index":0,"source_text":"事見二十四卷本始三年","target_paragraph_tongjian_id":"90b9a28d-db0e-11ef-a1f7-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見二十四卷本始三年。卒，子恤翻。","note_content_jianti_auto":"事见二十四卷本始三年。卒，子恤翻。","note_type":"hu_note","start_index":100,"tongjian_id":"95417057-db0e-11ef-a740-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"都尉","official_note":"都尉是汉代地方军事长官，负责郡或边境地区的军事防御和治安，此处疏勒都尉指在疏勒地区任职的都尉，番辰是其姓名，上下文描述他叛变，表明该官职在边疆管理中具有重要军事角色。","official_rank":"未知","source_snippet":"疏勒都尉番辰亦叛","start_index":21,"tongjian_id":"89c933bf-5aac-42f8-b22e-65c7fc5ec580"}],"ExtRef_Children_people":[{"people_name":"番辰","people_name_jianti_auto":"番辰","people_xingming":"番辰","start_index":22,"tongjian_id":"9541705a-db0e-11ef-baa7-a0d3651f611f"},{"people_name":"徐幹","people_name_jianti_auto":"徐干","people_xingming":"徐幹","start_index":28,"tongjian_id":"9541705d-db0e-11ef-b52c-a0d3651f611f"},{"link_birth_year":32,"link_death_year":102,"link_td_description":"班超，字仲升，右扶风平陵县（今陕西省咸阳市秦都区）人，东汉将领、外交家。是开拓和维持汉代与西域关系的重要人物。","link_td_id":"Q10007410","link_td_number_id":13520,"people_name":"超","people_name_jianti_auto":"超","people_xingming":"班超","start_index":33,"tongjian_id":"9541705e-db0e-11ef-b51b-a0d3651f611f"},{"people_name":"幹","people_name_jianti_auto":"干","people_xingming":"徐幹","start_index":36,"tongjian_id":"9541705f-db0e-11ef-bae8-a0d3651f611f"},{"people_name":"番辰","people_name_jianti_auto":"番辰","people_xingming":"番辰","start_index":38,"tongjian_id":"95417060-db0e-11ef-8bd3-a0d3651f611f"},{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"武帝","people_name_jianti_auto":"武帝","people_xingming":"刘彻","start_index":84,"tongjian_id":"95417061-db0e-11ef-a052-a0d3651f611f","wl_zhushi":"[刘彻]"},{"people_name":"孝宣帝","people_name_jianti_auto":"孝宣帝","start_index":92,"tongjian_id":"9543b9de-db0e-11ef-a1c8-a0d3651f611f","wl_zhushi":"[刘病已•刘询]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"莎車","place_name_jianti_auto":"莎车","resolved_place_entity_id":1762,"start_index":2,"tongjian_id":"95417058-db0e-11ef-a420-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":6,"tongjian_id":"95417059-db0e-11ef-8bcb-a0d3651f611f"},{"place_name":"龜茲","place_name_jianti_auto":"龟兹","resolved_place_entity_id":649,"start_index":14,"tongjian_id":"9541705b-db0e-11ef-9cd0-a0d3651f611f"},{"place_name":"疏勒","place_name_jianti_auto":"疏勒","resolved_place_entity_id":952,"start_index":18,"tongjian_id":"9541705c-db0e-11ef-a831-a0d3651f611f"},{"place_name":"龜茲","place_name_jianti_auto":"龟兹","resolved_place_entity_id":649,"start_index":54,"tongjian_id":"95417062-db0e-11ef-8923-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":58,"tongjian_id":"95417063-db0e-11ef-bbf7-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":73,"tongjian_id":"95417064-db0e-11ef-8ad5-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与西域各国的战争","tongjian_id":"war_N0614"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"宋元嘉十六年，乌孙入贡于魏。十四年，魏遣使董琬如乌孙。其...","context_before":"...至其国，击杀之。垫娄，盖地之垫隘处也。昆弥，即乌孙王号。","source_end_index":191,"source_paragraph_tongjian_id":"624b35da-0b41-5e76-a9dd-29fc29347809","source_start_index":178,"source_text":"后汉建初五年，复招慰乌孙。"},{"context_after":"建初五年，班超言莎车、疏勒，田地肥广，草木饶衍，不比敦煌...","context_before":"...遣使奉献。既而稍贰于汉。二十一年，击破鄯善，攻杀龟兹王。","source_end_index":203,"source_paragraph_tongjian_id":"ff0f228c-dd37-5a98-b42e-e83e9fb2c672","source_start_index":160,"source_text":"永平三年，又以兵威逼，夺于阗、大宛、妫塞诸国，使其将守之。寻为于阗所败。其后降于龟兹。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"先是莎車以爲漢兵不出，遂降於龜茲，而疏勒都尉番辰亦叛。會徐幹適至，超遂與幹擊番辰，大破之，斬首千餘級。欲進攻龜茲，以烏孫兵強，宜因其力，乃上言：「烏孫大國，控弦十萬，故武帝妻以公主，至孝宣帝卒得其用，今可遣使招慰，與共合力。」帝納之。","content_fanyi":"先前，莎车认为汉军不会出兵，便归降了龟兹，而疏勒都尉番辰也反叛了。恰好徐幹赶到，班超便与徐幹一起攻打番辰，大败番辰，斩首一千余级。班超准备进攻龟兹，因为乌孙兵力强盛，应当借助它的兵力，于是上书说：“乌孙是个大国，拥有十万军队，所以武帝把公主嫁给乌孙王，到孝宣帝时终于得以借助它的力量，现在可以派遣使者招抚慰问，与乌孙共同合力。”汉章帝接受了他的意见。","content_jianti_auto":"先是莎车以为汉兵不出，遂降于龟兹，而疏勒都尉番辰亦叛。会徐干适至，超遂与干击番辰，大破之，斩首千余级。欲进攻龟兹，以乌孙兵强，宜因其力，乃上言：「乌孙大国，控弦十万，故武帝妻以公主，至孝宣帝卒得其用，今可遣使招慰，与共合力。」帝纳之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3685,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"95417052-db0e-11ef-b660-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":4,"tongjian_id":"953f2689-db0e-11ef-a01b-a0d3651f611f","year_anno":"（庚辰、八○）","year_int":80},"message":"success","success":true}