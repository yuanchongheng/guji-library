Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郝，呼各翻。郝散若自上黨帥衆向洛陽歸降，當入河內界。今爲馮翊都尉所殺，蓋自穀遠歷河東界，渡河至馮翊界而被殺也。帥，讀曰率。降，戶江翻。","note_content_jianti_auto":"郝，呼各翻。郝散若自上党帅众向洛阳归降，当入河内界。今为冯翊都尉所杀，盖自谷远历河东界，渡河至冯翊界而被杀也。帅，读曰率。降，户江翻。","note_type":"hu_note","start_index":38,"tongjian_id":"9d2b3cf0-db0e-11ef-b75d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.85,"official_category":"地方行政","official_name":"長吏","official_note":"長吏在漢晉時期泛指地方官員，如縣令、郡守等，此處指上黨地區的官員，在匈奴郝散反叛中被殺，顯示地方行政機構受攻擊。","official_rank":"未知","source_snippet":"殺長吏","start_index":18,"tongjian_id":"d8f7c8db-0f2f-4986-9a67-2b393fe039e4"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"馮翊都尉","official_note":"馮翊都尉是漢晉時期馮翊郡的軍事長官，負責地方防務和治安，此處在郝散投降後將其殺害，體現軍事指揮職能。","official_rank":"未知","source_snippet":"馮翊都尉殺之","start_index":28,"tongjian_id":"a114ac8e-57d2-4d0b-ba16-15e2cff63e79"}],"ExtRef_Children_people":[{"link_death_year":294,"link_td_description":"郝散，匈奴人，西晋民变领袖。","link_td_id":"Q10013405","link_td_number_id":1595983,"people_name":"郝散","people_name_jianti_auto":"郝散","people_xingming":"郝散","start_index":8,"tongjian_id":"9d2b3cfa-db0e-11ef-b85b-a0d3651f611f"},{"link_death_year":294,"link_td_description":"郝散，匈奴人，西晋民变领袖。","link_td_id":"Q10013405","link_td_number_id":1595983,"people_name":"郝散","people_name_jianti_auto":"郝散","start_index":25,"tongjian_id":"9d2b3cfb-db0e-11ef-a0ac-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":6,"tongjian_id":"9d2b3cfc-db0e-11ef-af31-a0d3651f611f"},{"place_name":"上黨","place_name_jianti_auto":"上党","resolved_place_entity_id":364,"start_index":13,"tongjian_id":"9d2b3cfd-db0e-11ef-942b-a0d3651f611f"},{"place_name":"馮翊","place_name_jianti_auto":"冯翊","resolved_place_entity_id":521,"start_index":31,"tongjian_id":"9d2b3cfe-db0e-11ef-b36e-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"西晋末年流民起义","tongjian_id":"war_N0692"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"2夏，五月，匈奴郝散反，攻上黨，殺長吏。秋，八月，郝散帥衆降，馮翊都尉殺之。","content_fanyi":"夏季五月，匈奴郝散起兵反叛，攻打上党，杀死长吏。秋季八月，郝散率领部众投降，冯翊都尉将他杀死。","content_jianti_auto":"2夏，五月，匈奴郝散反，攻上党，杀长吏。秋，八月，郝散帅众降，冯翊都尉杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7067,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9d2b3cef-db0e-11ef-b684-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3是歲，大饑。","content_fanyi":"这一年，发生了大饥荒。","content_jianti_auto":"3是岁，大饥。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7068,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9d2b3cff-db0e-11ef-b54b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"傅咸","people_name_jianti_auto":"傅咸","start_index":20,"tongjian_id":"9d2b3d02-db0e-11ef-81f6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：三十國、晉春秋：「元康四年七月，傅咸爲司隸，五年五月，始親職，十月卒。」二書附年月多差舛，故以本傳爲定。","note_content_jianti_auto":"考异曰：三十国、晋春秋：「元康四年七月，傅咸为司隶，五年五月，始亲职，十月卒。」二书附年月多差舛，故以本传为定。","note_type":"hu_note","start_index":9,"tongjian_id":"9d2b3d01-db0e-11ef-b582-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"监察","official_name":"司隸校尉","official_note":"司隸校尉是漢晉時期的監察官，負責監察京師及周邊地區的官員，此處傅咸擔任此職，顯示其職責包括彈劾不法官員，如後文提及他奏免河南尹澹等官