reading_annotation_sources":[],"start_index":0,"tongjian_id":"8cee7f6b-db0e-11ef-b8cb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":6,"source_start_index":0,"source_text":"事見三卷十年","target_paragraph_tongjian_id":"8c808d95-db0e-11ef-bd85-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見三卷十年。援，于元翻，手引也。","note_content_jianti_auto":"事见三卷十年。援，于元翻，手引也。","note_type":"hu_note","start_index":16,"tongjian_id":"8cee7f72-db0e-11ef-a5e9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":7,"source_start_index":0,"source_text":"見上卷二十三年","target_paragraph_tongjian_id":"8c9fb348-db0e-11ef-8a1e-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見上卷二十三年。將，卽亮翻。","note_content_jianti_auto":"见上卷二十三年。将，即亮翻。","note_type":"hu_note","start_index":22,"tongjian_id":"8cee7f73-db0e-11ef-bc44-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":14,"source_start_index":9,"source_text":"事並見上卷","target_paragraph_tongjian_id":"8cc24185-db0e-11ef-a51f-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":6,"tongjian_id":"8cee7f75-db0e-11ef-a5b4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言拓地東聯於齊也，事並見上卷。鄢，於晚翻。郢，以井翻。屬，之欲翻。","note_content_jianti_auto":"言拓地东联于齐也，事并见上卷。鄢，于晚翻。郢，以井翻。属，之欲翻。","note_type":"hu_note","start_index":34,"tongjian_id":"8cee7f74-db0e-11ef-804e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賈，音古，言其致禍如商賈之賈物也。凡商賈之賈皆同音。","note_content_jianti_auto":"贾，音古，言其致祸如商贾之贾物也。凡商贾之贾皆同音。","note_type":"hu_note","start_index":68,"tongjian_id":"8cee7f77-db0e-11ef-8617-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8cee7f7a-db0e-11ef-9bd6-a0d3651f611f"},{"link_birth_year":-335,"link_death_year":-266,"link_td_description":"魏冉，芈姓，魏氏，名冉，亦作魏焻、魏厓，中国战国时期秦国政治家，宣太后异父弟，封於穰邑（今日河南邓州市），故为穰侯。","link_td_id":"Q10001101","link_td_number_id":672615,"people_name":"穰侯","people_name_jianti_auto":"穰侯","people_xingming":"魏冉","start_index":4,"tongjian_id":"8cee7f7b-db0e-11ef-8137-a0d3651f611f"},{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"昭王","people_name_jianti_auto":"昭王","people_xingming":"嬴稷","start_index":8,"tongjian_id":"8cee7f7c-db0e-11ef-a15d-a0d3651f611f","wl_zhushi":"[嬴稷]"},{"link_birth_year":-332,"link_death_year":-257,"link_td_description":"白起，芈姓白氏，郿县人，战国时代军事家、秦国名将，兵家代表人物。担任秦国将领30多年，攻城70余座，被封为武安君。","link_td_id":"Q10008015","link_td_number_id":19391,"people_name":"白起","people_name_jianti_auto":"白起","people_xingming":"白起","start_index":17,"tongjian_id":"8cee7f7d-db0e-11ef-8ea4-a0d3651f611f"},{"link_birth_year":-335,"link_death_year":-266,"link_td_description":"魏冉，芈姓，魏氏，名冉，亦作魏焻、魏厓，中国战国时期秦国政治家，宣太后异父弟，封於穰邑（今日河南邓州市），故为穰侯。","link_td_id":"Q10001101","link_td_number_id":672615,"people_name":"穰侯","people_name_jianti_auto":"穰侯","start_index":51,"tongjian_id":"8cee7f82-db0e-11ef-b5bf-a0d3651f611f"},{"link_death_year":-255,"link_td_description":"范雎，姬姓、范氏，字叔，化名为张禄，芮城（今山西芮城）人，东周战国时魏国政治家、军事谋略家，秦昭襄王宰相。封地在应城（今河南鲁山东），所以又称为应侯。","link_td_id":"Q10001749","link_td_number_id":304624,"people_name":"范睢","people_name_jianti_auto":"范睢","people_xingming":"范睢","start_index":73,"tongjian_id":"8cee7f84-db0e-11ef-bb85-a0d3651f611f"},{"link_death_year":-255,"link_td_description":"范雎，姬姓、范氏，字叔，化名为张禄，芮城（今山西芮城）人，东周战国时魏国政治家、军事谋略家，秦昭襄王宰相。封地在应城（今河南鲁山东），所以又称为应侯。","link_td_id":"Q10001749","link_td_number_id":304624,"people_name":"睢","people_name_jianti_auto":"睢","people_xingming":"范睢","start_index":79,"tongjian_id":"8cee7f85-db0e-11ef-8e16-a0d3651f611f"},{"link_birth_year":-335,"link_death_year":-266,"link_td_description":"魏冉，芈姓，魏氏，名冉，亦作魏焻、魏厓，中国战国时期秦国政治家，宣太后异父弟，封於穰邑（今日河南邓州市），故为穰侯。","link_td_id":"Q10001101","link_td_number_id":672615,"people_name":"穰侯","people_name_jianti_auto":"穰侯","start_index":93,"tongjian_id":"8cee7f86-db0e-11ef-9de0-a0d3651f611f"},{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴稷","start_index":109,"tongjian_id":"8cee7f88-db0e-11ef-8bd0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄢","place_name_jianti_auto":"鄢","place_note":"湖北宜城南","resolved_place_entity_id":3442,"start_index":24,"tongjian_id":"8cee7f7e-db0e-11ef-af40-a0d3651f611f"},{"place_name":"郢","place_name_jianti_auto":"郢","place_note":"湖北江陵","resolved_place_entity_id":805,"start_index":26,"tongjian_id":"8cee7f7f-db0e-11ef-a290-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":32,"tongjian_id":"8cee7f80-db0e-11ef-b1e3-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":43,"tongjian_id":"8cee7f81-db0e-11ef-b99c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":45,"tongjian_id":"8cee7f83-db0e-11ef-9899-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":86,"tongjian_id":"8cee7f87-db0e-11ef-bdb1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：穰侯援立昭王，除其災害；薦白起爲將，南取鄢、郢，東屬地於齊，使天下諸侯稽首而事秦，秦益強大者，穰侯之功也。雖其專恣驕貪足以賈禍，亦未至盡如范睢之言。若睢者，亦非能爲秦忠謀，直欲得穰侯之處，故搤其吭而奪之耳。遂使秦王絕母子之義，失舅甥之恩。要之，睢眞傾危之士哉！","content_fanyi":"臣司马光说：穰侯魏冉拥立秦昭王，为他除去祸患；举荐白起担任大将，向南攻取鄢城、郢都，向东扩张领土并与齐国接壤，使天下诸侯都俯首称臣、事奉秦国。秦国日益强大，这是穰侯的功劳。虽然穰侯专断放纵、骄横贪婪，足以招来灾祸，但也没有完全像范睢所说的那样。像范睢这样的人，也不是能为秦国尽忠谋划，只是想得到穰侯的地位，所以要扼住他的喉咙而夺取他的地位罢了。于是使秦王断绝了与太后的母子情义，失去了与穰侯的舅甥恩爱。总之，范睢真是个倾危诡诈的人啊！","content_jianti_auto":"臣光曰：穰侯援立昭王，除其灾害；荐白起为将，南取鄢、郢，东属地于齐，使天下诸侯稽首而事秦，秦益强大者，穰侯之功也。虽其专恣骄贪足以贾祸，亦未至尽如范睢之言。若睢者，亦非能为秦忠谋，直欲得穰侯之处，故搤其吭而夺之耳。遂使秦王绝母子之义，失舅甥之恩。要之，睢真倾危之士哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":400,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8cee7f71-db0e-11ef-9677-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"确立太子人选","decision_tongjian_id":"DECISION_8CEE7F89DB0E11EFA7F9A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":12,"source_start_index":0,"source_text":"爲安國君立子異人爲嗣張本","target_paragraph_tongjian_id":"8d0a3456-db0e-11ef-80b9-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"安國君","people_name_jianti_auto":"安国君","start_index":1,"tongjian_id":"8cee7f8b-db0e-11ef-8211-a0d3651f611f"},{"people_name":"子異人","people_name_jianti_auto":"子异人","start_index":5,"tongjian_id":"8cee7f8c-db0e-11ef-88f8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲安國君立子異人爲嗣張本。嗣，祥吏翻。","note_content_jianti_auto":"为安国君立子异人为嗣张本。嗣，祥吏翻。","note_type":"hu_note","start_index":12,"tongjian_id":"8cee7f8a-db0e-11ef-888b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"秦王","official_note":"秦王是战国时期秦国的君主称号，此处指秦昭襄王，他在位期间秦国国力强盛，为统一六国奠定基础。在上下文中，秦王作为决策者，任命其子安国君为太子，体现了君主继承制度。","official_rank":"未知","source_snippet":"秦王以子安國君爲太子。","start_index":2,"tongjian_id":"8d159caa-4d63-476f-96a2-c2e1248aff6c"},{"confidence":0.85,"official_category":"中枢机构","official_name":"太子","official_note":"太子是古代王位或皇位的继承人，通常由君主的长子或指定子嗣担任，负责学习政务和参与朝政。在上下文中，安国君被秦王立为太子，标志着继承权的确立，对秦国未来政治格局有重要影响。","official_rank":"未知","source_snippet":"秦王以子安國君爲太子。","start_index":12,"tongjian_id":"0e91bf87-ded7-4183-8cec-79653ce23067"}],"ExtRef_Children_people":[{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"稷","start_index":1,"tongjian_id":"8cee7f8d-db0e-11ef-8d97-a0d3651f611f","wl_zhushi":"[稷]"},{"link_birth_year":-302,"link_death_year":-250,"link_td_description":"秦孝文王，即位前称安国君，嬴姓，《史记索隐》记载名柱，《广弘明集》引《陶公年纪》记载名式，战国时期秦国君主。秦昭襄王与唐太后之子，正式改元后三天去世，实际统治不足一年。","link_td_id":"Q10000972","link_td_number_id":176268,"people_name":"安國君","people_name_jianti_auto":"安国君","people_xingming":"柱","start_index":5,"tongjian_id":"8cee7f8e-db0e-11ef-b28f-a0d3651f611f","wl_zhushi":"[柱]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2秦王以子安國君爲太子。","content_fanyi":"秦昭襄王把儿子安国君立为太子。","content_jianti_auto":"2秦王以子安国君为太子。","dtj