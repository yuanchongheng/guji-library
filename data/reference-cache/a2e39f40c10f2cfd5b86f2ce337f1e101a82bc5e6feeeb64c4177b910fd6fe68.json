efore":"...西四十五里。故韩邑。《史记》：魏文侯三十三年，败秦于注。","source_end_index":51,"source_paragraph_tongjian_id":"417608c2-67af-5e03-a477-70ed3388efa7","source_start_index":33,"source_text":"又赵孝成王元年，田单攻韩注人，拔之。"}],"path":"河南方舆纪要/九、汝州（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"4齊安平君田單將趙師以伐燕，取中陽；又伐韓，取注人。","content_fanyi":"齐国安平君田单统率赵国军队讨伐燕国，夺取中阳邑；又攻打韩国，夺取注人邑。","content_jianti_auto":"4齐安平君田单将赵师以伐燕，取中阳；又伐韩，取注人。","dtjl_paragraph_links":[],"dtjl_references":[],"id":403,"number":4,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8cf0c0cf-db0e-11ef-99ff-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"齊襄王","official_note":"齊襄王是齊國的君主，屬於地方諸侯王，在《資治通鑑》中記載其去世事件，上下文涉及齊國政權交接。","official_rank":"王爵","source_snippet":"齊襄王薨","start_index":0,"tongjian_id":"353e2c94-5b45-453b-a631-50fe082af4f7"},{"confidence":0.85,"official_category":"中枢机构","official_name":"君王后","official_note":"君王后是齊國的王后，在齊襄王去世後，因齊王建年少而實際掌握國政決策權，屬於宮廷核心人物。","official_rank":"未知","source_snippet":"國事皆決於君王后","start_index":15,"tongjian_id":"c2e00c92-9bd8-494e-adba-ffcd74c582aa"}],"ExtRef_Children_people":[{"link_death_year":-265,"link_td_description":"齐襄王，本名田法章，齐湣王之子，田齐君主。","link_td_id":"Q10002278","link_td_number_id":326668,"people_name":"齊襄王","people_name_jianti_auto":"齐襄王","people_xingming":"田法章","start_index":1,"tongjian_id":"8cf0c0e9-db0e-11ef-b826-a0d3651f611f","wl_zhushi":"[田法章]"},{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_td_number_id":205574,"people_name":"建","people_name_jianti_auto":"建","people_xingming":"田建","start_index":7,"tongjian_id":"8cf0c0ea-db0e-11ef-b2f2-a0d3651f611f"},{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_