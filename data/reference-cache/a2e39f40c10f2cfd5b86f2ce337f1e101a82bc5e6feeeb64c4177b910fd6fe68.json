ph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻。唾，吐臥翻，口液也。明謂左右者，顯言之也。","note_content_jianti_auto":"复，扶又翻。唾，吐卧翻，口液也。明谓左右者，显言之也。","note_type":"hu_note","start_index":79,"tongjian_id":"8cee7f9a-db0e-11ef-b0b7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"胥，待也。言盛氣以待其入也。","note_content_jianti_auto":"胥，待也。言盛气以待其入也。","note_type":"hu_note","start_index":97,"tongjian_id":"8cee7f9b-db0e-11ef-bdaa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"觸龍","people_name_jianti_auto":"触龙","start_index":19,"tongjian_id":"8cee7f9d-db0e-11ef-a57f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":0,"tongjian_id":"8cee7f9e-db0e-11ef-94fd-a0d3651f611f"},{"place_name":"宋國","place_name_jianti_auto":"宋国","start_index":3,"tongjian_id":"8cee7f9f-db0e-11ef-9338-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":17,"tongjian_id":"8cee7fa0-db0e-11ef-ac05-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋時宋國之官有左、右師，上卿也。趙以觸龍爲左師，蓋宂散之官，以優老臣者也。息，子也。祺，音其。宂，而隴翻。散，悉亶翻。","note_content_jianti_auto":"春秋时宋国之官有左、右师，上卿也。赵以触龙为左师，盖宂散之官，以优老臣者也。息，子也。祺，音其。宂，而陇翻。散，悉亶翻。","note_type":"hu_note","start_index":197,"tongjian_id":"8cee7f9c-db0e-11ef-82be-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"觸龍","people_name_jianti_auto":"触龙","start_index":9,"tongjian_id":"8cee7fa2-db0e-11ef-9ac2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"黑衣，衞士之服也。觸龍先爲其少子言，以發太后之問也。昧死言，忘其死也。少，失照翻，又音小。昧，莫佩翻。","note_content_jianti_auto":"黑衣，衞士之服也。触龙先为其少子言，以发太后之问也。昧死言，忘其死也。少，失照翻，又音小。昧，莫佩翻。","note_type":"hu_note","start_index":230,"tongjian_id":"8cee7fa1-db0e-11ef-8b8e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"趙","place_name_jianti_auto":"赵","start_index":13,"tongjian_id":"8cee7fa5-db0e-11ef-9f2d-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":20,"tongjian_id":"8cee7fa6-db0e-11ef-baf0-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":26,"tongjian_id":"8cee7fa7-db0e-11ef-924f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"媼，烏浩翻，婦之老者之稱。趙太后之女嫁於燕，故稱之曰燕后。燕，因肩翻。","note_content_jianti_auto":"媪，乌浩翻，妇之老者之称。赵太后之女嫁于燕，故称之曰燕后。燕，因肩翻。","note_type":"hu_note","start_index":323,"tongjian_id":"8cee7fa4-db0e-11ef-ac6f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"奉，讀曰俸；凡奉祿之奉皆同音。","note_content_jianti_auto":"奉，读曰俸；凡奉禄之奉皆同音。","note_type":"hu_note","start_index":510,"tongjian_id":"8cee7fa8-db0e-11ef-9278-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"左師","official_note":"左師是战国时期赵国的一种官职，属于中枢机构，可能负责顾问或礼仪事务。在上下文中，左師觸龍作为官员进谏太后，讨论国家政事，体现了其参与决策的作用。","official_rank":"未知","source_snippet":"左師觸龍願見太后","start_index":78,"tongjian_id":"c88494b9-e6fd-4a11-823a-99283af0f521"},{"confidence":0.85,"official_category":"中枢机构","official_name":"左師公","official_note":"左師公是对左師的尊称，可能表示其地位较高或年长。在上下文中，左師公触龙继续与太后对话，推动劝谏过程，显示了其作为官员的影响力。","official_rank":"未知","source_snippet":"左師公徐趨而坐"