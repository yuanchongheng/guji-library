f_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":8,"tongjian_id":"8bfd6662-db0e-11ef-831e-a0d3651f611f"},{"place_name":"唐城","place_name_jianti_auto":"唐城","start_index":16,"tongjian_id":"8bfd6663-db0e-11ef-b79e-a0d3651f611f"},{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":19,"tongjian_id":"8bfd6664-db0e-11ef-9382-a0d3651f611f"},{"place_name":"晉陽縣","place_name_jianti_auto":"晋阳县","start_index":21,"tongjian_id":"8bfd6665-db0e-11ef-a0ac-a0d3651f611f"},{"place_name":"晉水","place_name_jianti_auto":"晋水","start_index":47,"tongjian_id":"8bfd6666-db0e-11ef-8603-a0d3651f611f"},{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":52,"tongjian_id":"8bfd6667-db0e-11ef-8819-a0d3651f611f"},{"place_name":"唐城","place_name_jianti_auto":"唐城","start_index":56,"tongjian_id":"8bfd6668-db0e-11ef-9e38-a0d3651f611f"},{"place_name":"晉水","place_name_jianti_auto":"晋水","start_index":88,"tongjian_id":"8bfd6669-db0e-11ef-a989-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周成王封弟叔虞於唐。括地志曰：故唐城在幷州晉陽縣北二里，堯所築也。都城記曰：唐叔虞之子燮父徙居晉水旁，今幷州理故唐城，卽燮父初徙之處；其城南半入州城中。毛詩譜曰：燮父以堯墟南有晉水，改曰晉侯。自唐叔至烈公三十七世。烈公，名止。諡法：慈惠愛親曰孝。","note_content_jianti_auto":"周成王封弟叔虞于唐。括地志曰：故唐城在幷州晋阳县北二里，尧所筑也。都城记曰：唐叔虞之子燮父徙居晋水旁，今幷州理故唐城，即燮父初徙之处；其城南半入州城中。毛诗谱曰：燮父以尧墟南有晋水，改曰晋侯。自唐叔至烈公三十七世。烈公，名止。谥法：慈惠爱亲曰孝。","note_type":"hu_note","start_index":12,"tongjian_id":"8bfd6655-db0e-11ef-b07b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-357,"link_td_description":"晋孝公（？─约前357年），《古本竹书》称作晋桓公，姬姓，名頎，是中国春秋战国时代晋国的君主，晋烈公之子，烈公二十七年（前389年），烈公死，孝公即位。孝公死年不详，子晋静公即位。晋孝公时，晋国的大多数领土已大多落入韩、魏、赵三家之手，屡被迁移，孝公二十年（前369年），赵迁晋君于屯留，后封晋君于端氏。","link_td_id":"Q10001752","link_td_number_id":173085,"people_name":"孝公","people_name_jianti_auto":"孝公","people_xingming":"姬倾","start_index":7,"tongjian_id":"8bfd666f-db0e-11ef-bcf1-a0d3651f611f"},{"link_death_year":-357,"link_td_description":"晋孝公（？─约前357年），《古本竹书》称作晋桓公，姬姓，名頎，是中国春秋战国时代晋国的君主，晋烈公之子，