_auto":"3是岁，平阿安侯王谭薨。上悔废谭使不辅政而薨也，乃复进成都侯商，以特进领城门兵，置幕府，得举吏如将军。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2452,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"91ee9233-db0e-11ef-9662-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否采纳杜邺建议，与王商和解并共事","decision_tongjian_id":"DECISION_91EE923CDB0E11EFB970A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91ee923e-db0e-11ef-9243-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：戚，近也。殊，謂異於疏也。說，輸芮翻。","note_content_jianti_auto":"师古曰：戚，近也。殊，谓异于疏也。说，输芮翻。","note_type":"hu_note","start_index":44,"tongjian_id":"91ee923d-db0e-11ef-acd2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91ee9240-db0e-11ef-86c0-a0d3651f611f"},{"people_name":"秦景公","people_name_jianti_auto":"秦景公","start_index":4,"tongjian_id":"91ee9241-db0e-11ef-887d-a0d3651f611f"},{"people_name":"公子鍼","people_name_jianti_auto":"公子针","start_index":9,"tongjian_id":"91ee9242-db0e-11ef-8178-a0d3651f611f"},{"people_name":"桓公","people_name_jianti_auto":"桓公","start_index":17,"tongjian_id":"91ee9243-db0e-11ef-ba52-a0d3651f611f"},{"people_name":"景公","people_name_jianti_auto":"景公","start_index":20,"tongjian_id":"91ee9244-db0e-11ef-9393-a0d3651f611f"},{"people_name":"鍼","people_name_jianti_auto":"针","start_index":24,"tongjian_id":"91ee9245-db0e-11ef-89d6-a0d3651f611f"},{"people_name":"昭","people_name_jianti_auto":"昭","start_index":32,"tongjian_id":"91ee9246-db0e-11ef-b7a3-a0d3651f611f"},{"people_name":"秦伯","people_name_jianti_auto":"秦伯","start_index":40,"tongjian_id":"91ee9247-db0e-11ef-983d-a0d3651f611f"},{"people_name":"鍼","people_name_jianti_auto":"针","start_index":44,"tongjian_id":"91ee9248-db0e-11ef-9832-a0d3651f611f"},{"people_name":"秦伯","people_name_jianti_auto":"秦伯","start_index":57,"tongjian_id":"91ee9249-db0e-11ef-8ee3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":28,"tongjian_id":"91ee924a-db0e-11ef-9617-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":47,"tongjian_id":"91ee924b-db0e-11ef-b497-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：秦景公母弟公子鍼有寵於其父桓公。景公立，鍼懼而奔晉。事在昭元年。故經書「秦伯之弟鍼出奔晉」，傳曰：稱弟，罪秦伯也。","note_content_jianti_auto":"师古曰：秦景公母弟公子针有宠于其父桓公。景公立，针惧而奔晋。事在昭元年。故经书「秦伯之弟针出奔晋」，传曰：称弟，罪秦伯也。","note_type":"hu_note","start_index":60,"tongjian_id":"91ee923f-db0e-11ef-b746-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91ee924f-db0e-11ef-9c01-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":5,"tongjian_id":"91ee9250-db0e-11ef-a74e-a0d3651f611f"},{"people_name":"召公","people_name_jianti_auto":"召公","start_index":8,"tongjian_id":"91ee9251-db0e-11ef-a4f3-a0d3651f611f"},{"people_name":"秦伯","people_name_jianti_auto":"秦伯","start_index":23,"tongjian_id":"91ee9252-db0e-11ef-9ab0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言周公、召公無私怨也。余謂不然者，不爲秦伯之爲也。召，讀曰邵。","note_content_jianti_auto":"师古曰：言周公、召公无私怨也。余谓不然者，不为秦伯之为也。召，读曰邵。","note_type":"hu_note","start_index":72,"tongjian_id":"91ee924e-db0e-11ef-b86e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91ee9254-db0e-11ef-bd31-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":14,"tongjian_id":"91ee9255-db0e-11ef-8a7e-a0d3651f611f"},{"people_name":"召公","people_name_jianti_auto":"召公","start_index":23,"tongjian_id":"91ee9256-db0e-11ef-832a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陝","place_name_jianti_auto":"陕","start_index":7,"tongjian_id":"91ee9257-db0e-11ef-a040-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":11,"tongjian_id":"91ee9258-db0e-11ef-808a-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":20,"tongjian_id":"91ee9259-db0e-11ef-91e4-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":28,"tongjian_id":"91ee925a-db0e-11ef-bad1-a0d3651f611f"},{"place_name":"陝州","place_name_jianti_auto":"陕州","start_index":32,"tongjian_id":"91ee925b-db0e-11ef-9029-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":48,"tongjian_id":"91ee925c-db0e-11ef-b33d-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":50,"tongjian_id":"91ee925d-db0e-11ef-93a6-a0d3651f611f"},{"place_name":"郟縣","place_name_jianti_auto":"郏县","start_index":52,"tongjian_id":"91ee925e-db0e-11ef-9694-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":80,"tongjian_id":"91ee925f-db0e-11ef-ab27-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：分職於陝，謂自陝以東周公主之，自陝以西召公主之。陝，卽今陝州縣也；音式冉翻。而說者妄云分陝是潁川郟縣，謬矣。弼疑，謂左輔、右弼、前疑、後丞也。余按字書，陝從兩「入」，郟從兩「人」，人自不考耳。爲，于僞翻。長，知兩翻。","note_content_jianti_auto":"师古曰：分职于陕，谓自陕以东周公主之，自陕以西召公主之。陕，即今陕州县也；音式冉翻。而说者妄云分陕是颍川郏县，谬矣。弼疑，谓左辅、右弼、前疑、后丞也。余按字书，陕从两「入」，郏从两「人」，人自不考耳。为，于伪翻。长，知两翻。","note_type":"hu_note","start_index":120,"tongjian_id":"91ee9253-db0e-11ef-9ab7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"Ext