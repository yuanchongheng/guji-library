x":131,"tongjian_id":"8c3297f8-db0e-11ef-b2a0-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":135,"tongjian_id":"8c3297f9-db0e-11ef-835d-a0d3651f611f"},{"place_name":"商州","place_name_jianti_auto":"商州","start_index":138,"tongjian_id":"8c3297fa-db0e-11ef-8c2c-a0d3651f611f"},{"place_name":"商洛縣","place_name_jianti_auto":"商洛县","start_index":141,"tongjian_id":"8c3297fb-db0e-11ef-bf5c-a0d3651f611f"},{"place_name":"商邑","place_name_jianti_auto":"商邑","start_index":146,"tongjian_id":"8c3297fc-db0e-11ef-91d5-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":154,"tongjian_id":"8c3297fd-db0e-11ef-a354-a0d3651f611f"},{"place_name":"商縣","place_name_jianti_auto":"商县","start_index":156,"tongjian_id":"8c3297fe-db0e-11ef-9414-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：弘農郡商縣，商君邑。裴駰曰：商於之地在今順陽郡南鄕、丹水二縣，有商城在於中，所謂之商於。史記正義曰：丹水及商皆屬弘農，今言順陽，是魏、晉始分置順陽郡，商及丹水皆屬之也。水經註：丹水逕南鄕、丹水二縣之間，歷於中之北，所謂商於者也。杜佑曰：今鄧州內鄕縣東七里有於村，蓋秦所謂商州。商洛縣，古商邑，卨所封也；漢爲商縣。於，如字。","note_content_jianti_auto":"班志：弘农郡商县，商君邑。裴骃曰：商于之地在今顺阳郡南鄕、丹水二县，有商城在于中，所谓之商于。史记正义曰：丹水及商皆属弘农，今言顺阳，是魏、晋始分置顺阳郡，商及丹水皆属之也。水经注：丹水迳南鄕、丹水二县之间，历于中之北，所谓商于者也。杜佑曰：今邓州内鄕县东七里有于村，盖秦所谓商州。商洛县，古商邑，卨所封也；汉为商县。于，如字。","note_type":"hu_note","start_index":10,"tongjian_id":"8c3297db-db0e-11ef-9550-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"商於","place_name_jianti_auto":"商于","resolved_place_entity_id":3109,"start_index":4,"tongjian_id":"8c329804-db0e-11ef-8077-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"]。始皇并天下，属内史。汉属弘农郡。后汉属京兆尹。晋初为...","context_before":"...魏。《国策》：楚、魏战于陉山，魏许秦以上雒]。战国属秦[","source_end_index":80,"source_paragraph_tongjian_id":"5419e65e-1fa8-5262-b91d-a16b17bc6c7d","source_start_index":71,"source_text":"卫鞅封于此，为商君"},{"context_after":"，张仪以绐楚怀王也。汉置商县，属弘农郡。后汉属京兆尹。晋...","context_before":"...九十里。古商邑，契所封也。战国时为商于地。盖近南阳之界，","source_end_index":40,"source_paragraph_tongjian_id":"8eeef47e-e247-5108-a54e-816d9dd1bfc6","source_start_index":35,"source_text":"秦商君封此"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"秦封衞鞅商於十五邑。號曰商君。","content_fanyi":"秦国把商、於十五邑封给卫鞅，称他为商君，又称商鞅。","content_jianti_auto":"秦封衞鞅商于十五邑。号曰商君。","dtjl_paragraph_links":[],"dtjl_references":[],"id":169,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 二十九年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c3297da-db0e-11ef-9f06-a0d3651f611f","year_int":-340},"tongjian_id":"8c3297da-db0e-11ef-9f06-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"商於","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"之，如也，往也。","note_content_jianti_auto":"之，如也，往也。","note_type":"hu_note","start_index":34,"tongjian_id":"8c329811-db0e-11ef-aedb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":12,"tongjian_id":"8c329813-db0e-11ef-9aae-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"內，讀曰納。怨其挾詐以破魏師，故不受。","note_content_jianti_auto":"内，读曰纳。怨其挟诈以破魏师，故不受。","note_type":"hu_note","start_index":44,"tongjian_id":"8c329812-db0e-11ef-a34b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周宣王","people_name_jianti_auto":"周宣王","start_index":17,"tongjian_id":"8c329815-db0e-11ef-b409-a0d3651f611f"},{"people_name":"鄭桓公","people_name_jianti_auto":"郑桓公","start_index":21,"tongjian_id":"8c329816-db0e-11ef-b29d-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":32,"tongjian_id":"8c329817-db0e-11ef-9837-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":8,"tongjian_id":"8c329818-db0e-11ef-a8b3-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":10,"tongjian_id":"8c329819-db0e-11ef-9c83-a0d3651f611f"},{"place_name":"鄭縣","place_name_jianti_auto":"郑县","start_index":13,"tongjian_id":"8c32981a-db0e-11ef-a2b7-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":27,"tongjian_id":"8c32981b-db0e-11ef-9820-a0d3651f611f"},{"place_name":"華州","place_name_jianti_auto":"华州","start_index":29,"tongjian_id":"8c32981c-db0e-11ef-8b1c-a0d3651f611f"},{"place_name":"鄭縣","place_name_jianti_auto":"郑县","start_index":39,"tongjian_id":"8c32981d-db0e-11ef-bd84-a0d3651f611f"},{"place_name":"華州郡","place_name_jianti_auto":"华州郡","start_index":44,"tongjian_id":"8c32981e-db0e-11ef-bf00-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"之，往也，如也。鄭，京兆之鄭縣也，周宣王弟鄭桓公采邑，唐屬華州。宋白續通典曰：鄭縣古城在華州郡城北。","note_content_jianti_auto":"之，往也，如也。郑，京兆之郑县也，周宣王弟郑桓公采邑，唐属华州。宋白续通典曰：郑县古城在华州郡城北。","note_type":"hu_note","start_index":60,"tongjian_id":"8c329814-db0e-11ef-a47f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"車裂，古之轘刑。轘，戶串翻。","note_content_jianti_auto":"车裂，古之轘刑。轘，户串翻。","note_type":"hu_note","start_index":79,"tongjian_id":"8c329820-db0e-11ef-88b9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"商於","place_name_jianti_auto":"商于","resolved_place_entity_id":3109,"start_index":51,"tongjian_id":"8c34320a-db0e-11ef-9dab-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"郑，即韩矣。翼奉曰：成周右阻渑池，汉景帝始因崤渑之地以目...","context_before":"...[在县东北三十里。一名渑池山。《郡县志》：渑池，故韩地。","source_end_index":44,"source_paragraph_tongjian_id":"a9c2ae55-516a-599e-9dfe-cdb8dca07a96","source_start_index":32,"source_text":"秦攻商君，杀之于郑渑池。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"郑，即韩矣。翼奉曰：成周右阻渑池，汉景帝始因崤渑之地以目...","context_before":"...[在县东北三十里。一名渑池山。《郡县志》：渑池，故韩地。","source_end_index":44,"source_paragraph_tongjian_id":"1d7f32cc-d414-5ca1-80ea-7e45244dcf54","source_start_index":32,"source_text":"秦攻商君，杀之于郑渑池。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"胡氏曰：在京兆郑县界]。","context_before":"...曾驻于此。○彤城，在州西南周彤伯国。战国时，秦魏遇于彤。","source_end_index":175,"source_paragraph_tongjian_id":"52729bdd-2d04-5172-a52c-f7b28cdfcb51","source_start_index":160,"source_text":"《史记》：商君反死彤地。即此。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦孝公薨，子惠文王立。公子虔之徒告商君欲反，發吏捕之。商君亡之魏；魏人不受，復內之秦。商君乃與其徒之商於，發兵北擊鄭，秦人攻商君，殺之，車裂以徇，盡滅其家。","content_fanyi":"秦孝公去世，他的儿子秦惠文王即位。公子虔的党徒上书告发商君企图谋反，秦惠文王派官吏去抓捕他。商君逃亡到魏国；魏国人不肯收留，又把他送回秦国。商君于是与他的部属前往商於之地，发兵向北攻打郑县，秦国人攻打商君，将他杀死，处以车裂之刑示众，并诛灭了商鞅的全家。","content_jianti_auto":"1秦孝公薨，子惠文王立。公子虔之徒告商君欲反，发吏捕之。商君亡之魏；魏人不受，复内之秦。商君乃与其徒之商于，发兵北击郑，秦人攻商君，杀之，车裂以徇，尽灭其家。","dtjl_paragraph_links":[],"dtjl_references":[],"id":172,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十一年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c329810-db0e-11ef-80b6-a0d3651f611f","year_int":-338},"tongjian_id":"8c329810-db0e-11ef-80b6-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"商於","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"商君","people_name_jianti_auto":"商君","start_index":30,"tongjian_id":"8c343210-db0e-11ef-9044-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"渭水","place_name_jianti_auto":"渭水","start_index":9,"tongjian_id":"8c343211-db0e-11ef-909f-a0d3651f611f"},{"place_name":"隴西","place_name_jianti_auto":"陇西","start_index":12,"tongjian_id":"8c343212-db0e-11ef-81d4-a0d3651f611f"},{"place_name":"首陽縣","place_name_jianti_auto":"首阳县","start_index":14,"tongjian_id":"8c343213-db0e-11ef-88bd-a0d3651f611f"},{"place_name":"鳥鼠山","place_name_jianti_auto":"鸟鼠山","start_index":17,"tongjian_id":"8c343214-db0e-11ef-95d9-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":24,"tongjian_id":"8c343215-db0e-11ef-9725-a0d3651f611f"},{"place_name":"咸陽","place_name_jianti_auto":"咸阳","start_index":26,"tongjian_id":"8c343216-db0e-11ef-a7f3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相，息亮翻。水經：渭水出隴西首陽縣鳥鼠山，東流至秦都咸陽南。商君蓋臨此以論囚。決罪曰論。論，盧困翻。","note_content_jianti_auto":"相，息亮翻。水经：渭水出陇西首阳县鸟鼠山，东流至秦都咸阳南。商君盖临此以论囚。决罪曰论。论，卢困翻。","note_type":"hu_note","start_index":23,"tongjian_id":"8c34320f-db0e-11ef-a7a9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":1,"tongjian_id":"8c343219-db0e-11ef-8a85-a0d3651f611f"},{"people_name":"商鞅","people_name_jianti_auto":"商鞅","start_index":9,"tongjian_id":"8c34321a-db0e-11ef-bad0-a0d3651f611f"},{"people_name":"商鞅","people_name_jianti_auto":"商鞅","start_index":20,"tongjian_id":"8c34321b-db0e-11ef-8780-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":7,"tongjian_id":"8c34321c-db0e-11ef-b271-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":23,"tongjian_id":"8c34321d-db0e-11ef-b090-a0d3651f611f"},{"place_name":"咸陽","place_name_jianti_auto":"咸阳","start_index":25,"tongjian_id":"8c34321e-db0e-11ef-9397-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按顯王十七年，秦以商鞅爲大良造；十九年，商鞅徙秦都咸陽，廢井田，開阡陌，平權量。二十一年，更賦稅法，爲相當在是年，至今年十年矣。","note_content_jianti_auto":"按显王十七年，秦以商鞅为大良造；十九年，商鞅徙秦都咸阳，废井田，开阡陌，平权量。二十一年，更赋税法，为相当在是年，至今年十年矣。","note_type":"hu_note","start_index":33,"tongjian_id":"8c343218-db0e-11ef-ac9b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"百里奚","people_name_jianti_auto":"百里奚","start_index":0,"tongjian_id":"8c343221-db0e-11ef-bfa4-a0d3651f611f"},{"people_name":"秦穆公","people_name_jianti_auto":"秦穆公","start_index":17,"tongjian_id":"8c343222-db0e-11ef-b0b4-a0d3651f611f"},{"people_name":"五羖大夫","people_name_jianti_auto":"五羖大夫","start_index":29,"tongjian_id":"8c343223-db0e-11ef-9bbe-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":25,"tongjian_id":"8c343224-db0e-11ef-abdf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百里奚自賣以五羖羊之皮，爲人養牛；秦穆公舉以爲相，秦人謂之五羖大夫。羖，牡羊也。羖，音古。","note_content_jianti_auto":"百里奚自卖以五羖羊之皮，为人养牛；秦穆公举以为相，秦人谓之五羖大夫。羖，牡羊也。羖，音古。","note_type":"hu_note","start_index":59,"tongjian_id":"8c343220-db0e-11ef-815c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙簡子","people_name_jianti_auto":"赵简子","start_index":1,"tongjian_id":"8c343226-db0e-11ef-9ea5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"引趙簡子之言。諾，應聲也。諤，謇直也。","note_content_jianti_auto":"引赵简子之言。诺，应声也。谔，謇直也。","note_type":"hu_note","start_index":78,"tongjian_id":"8c343225-db0e-11ef-960a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"百里奚","people_name_jianti_auto":"百里奚","start_index":3,"tongjian_id":"8c343228-db0e-11ef-9dc7-a0d3651f611f"},{"people_name":"秦繆公","people_name_jianti_auto":"秦缪公","start_index":15,"tongjian_id":"8c343229-db0e-11ef-a3ce-a0d3651f611f"},{"people_name":"百里傒","people_name_jianti_auto":"百里傒","start_index":35,"tongjian_id":"8c34322a-db0e-11ef-86d7-a0d3651f611f"},{"people_name":"繆夫人","people_name_jianti_auto":"缪夫人","start_index":41,"tongjian_id":"8c34322b-db0e-11ef-9bec-a0d3651f611f"},{"people_name":"百里傒","people_name_jianti_auto":"百里傒","start_index":46,"tongjian_id":"8c34322c-db0e-11ef-8fc8-a0d3651f611f"},{"people_name":"繆公","people_name_jianti_auto":"缪公","start_index":60,"tongjian_id":"8c34322d-db0e-11ef-90b8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"虞","place_name_jianti_auto":"虞","place_note":"山西平陸","start_index":7,"tongjian_id":"8c34322e-db0e-11ef-b5aa-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","start_index":21,"tongjian_id":"8c34322f-db0e-11ef-aea1-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":30,"tongjian_id":"8c343230-db0e-11ef-9075-a0d3651f611f"},{"place_name":"虞","place_name_jianti_auto":"虞","start_index":32,"tongjian_id":"8c343231-db0e-11ef-a71c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":40,"tongjian_id":"8c343232-db0e-11ef-845f-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":50,"tongjian_id":"8c343233-db0e-11ef-8882-a0d3651f611f"},{"place_name":"宛","place_name_jianti_auto":"宛","place_note":"河南南陽","start_index":52,"tongjian_id":"8c343234-db0e-11ef-9649-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":54,"tongjian_id":"8c343235-db0e-11ef-acef-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟子：百里奚，虞人也，以食牛干秦繆公。今曰荊之鄙人，按史記：晉滅虞，執百里傒，爲秦繆夫人媵。百里傒亡秦走宛，楚鄙人執之；繆公以五羖羊皮贖之，以爲上大夫。傒，讀與奚同。繆，讀與穆同。媵，以證翻。宛，於元翻。","note_content_jianti_auto":"孟子：百里奚，虞人也，以食牛干秦缪公。今曰荆之鄙人，按史记：晋灭虞，执百里傒，为秦缪夫人媵。百里傒亡秦走宛，楚鄙人执之；缪公以五羖羊皮赎之，以为上大夫。傒，读与奚同。缪，读与穆同。媵，以证翻。宛，于元翻。","note_type":"hu_note","start_index":124,"tongjian_id":"8c343227-db0e-11ef-a72b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"僖","people_name_jianti_auto":"僖","start_index":3,"tongjian_id":"8c343239-db0e-11ef-a375-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":8,"tongjian_id":"8c34323a-db0e-11ef-b56b-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":10,"tongjian_id":"8c34323b-db0e-11ef-a16f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂左傳僖三十年與晉圍鄭也。相，息亮翻。","note_content_jianti_auto":"谓左传僖三十年与晋围郑也。相，息亮翻。","note_type":"hu_note","start_index":149,"tongjian_id":"8c343238-db0e-11ef-8758-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":5,"chapter_name":"避讳篇第五","chenzhu_chapter":"避讳为民国以前吾国特有之体制，故史书上之记载，有待于以避讳解释者甚众，不讲避讳学，不足以读中国之史也，吾昔撰《史讳举例》问世，职为是焉。胡身之生避讳最盛之朝，熟谙避讳掌故。其撰《通鉴释文辨误後序》，谓：“海陵所刊公休《释文》，以乌桓为乌元。宋朝钦宗讳桓，靖康之初，公休没久矣，安得预为钦宗讳！”即利用避讳以证史书伪讬之一法。其注《通鉴》，以避讳为训释者尤多。兹所采不过数十条，而避讳常识已略具于是矣。","chenzhu_index_in_chapter":2,"chenzhu_text":"此避讳称异名。秦始皇父庄襄王名子楚，见司马贞《索隐》。","created_at":"2025-12-31 08:50:44","seq_in_chapter":7,"tongjian_id":"CH05-CZ002"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"惠公","people_name_jianti_auto":"惠公","start_index":7,"tongjian_id":"8c34323e-db0e-11ef-a1fd-a0d3651f611f"},{"people_name":"懷公","people_name_jianti_auto":"怀公","start_index":10,"tongjian_id":"8c34323f-db0e-11ef-89d3-a0d3651f611f"},{"people_name":"文公","people_name_jianti_auto":"文公","start_index":13,"tongjian_id":"8c343240-db0e-11ef-8db8-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":28,"tongjian_id":"8c343241-db0e-11ef-ac04-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":69,"tongjian_id":"8c343242-db0e-11ef-9c92-a0d3651f611f"},{"people_name":"鬬克","people_name_jianti_auto":"鬬克","start_index":72,"tongjian_id":"8c343243-db0e-11ef-adb7-a0d3651f611f"},{"people_name":"太史公","people_name_jianti_auto":"太史公","start_index":106,"tongjian_id":"8c343244-db0e-11ef-8bd8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":2,"tongjian_id":"8c343245-db0e-11ef-a54b-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":36,"tongjian_id":"8c343246-db0e-11ef-94e2-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":38,"tongjian_id":"8c343247-db0e-11ef-91cf-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":40,"tongjian_id":"8c343248-db0e-11ef-9b0b-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","start_index":45,"tongjian_id":"8c343249-db0e-11ef-b8a2-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":55,"tongjian_id":"8c34324a-db0e-11ef-9c73-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":58,"tongjian_id":"8c34324b-db0e-11ef-a843-a0d3651f611f"},{"place_name":"城濮","place_name_jianti_auto":"城濮","start_index":60,"tongjian_id":"8c34324c-db0e-11ef-a401-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":65,"tongjian_id":"8c34324d-db0e-11ef-9403-a0d3651f611f"},{"place_name":"崤","place_name_jianti_auto":"崤","start_index":67,"tongjian_id":"8c34324e-db0e-11ef-9931-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":75,"tongjian_id":"8c34324f-db0e-11ef-ac5f-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","start_index":82,"tongjian_id":"8c343250-db0e-11ef-907b-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":90,"tongjian_id":"8c343251-db0e-11ef-afb1-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":92,"tongjian_id":"8c343252-db0e-11ef-a866-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":100,"tongjian_id":"8c343253-db0e-11ef-85e8-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":129,"tongjian_id":"8c343254-db0e-11ef-a406-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","start_index":131,"tongjian_id":"8c343255-db0e-11ef-b281-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三置晉君，謂立惠公、懷公、文公也。索隱曰：十二諸侯年表，穆公二十八年，會晉伐楚朝周；此云救荊，未詳。余按左傳，晉旣敗楚于城濮，又敗秦於崤，穆公使鬬克歸楚求成，所謂救荊禍，蓋指此也。秦諱楚，故其國記率謂楚爲「荊」。太史公取秦記爲史記，通鑑又因史記而成書，故亦以楚爲荊。","note_content_jianti_auto":"三置晋君，谓立惠公、怀公、文公也。索隐曰：十二诸侯年表，穆公二十八年，会晋伐楚朝周；此云救荆，未详。余按左传，晋既败楚于城濮，又败秦于崤，穆公使鬬克归楚求成，所谓救荆祸，盖指此也。秦讳楚，故其国记率谓楚为「荆」。太史公取秦记为史记，通鉴又因史记而成书，故亦以楚为荆。","note_type":"hu_note","start_index":159,"tongjian_id":"8c34323d-db0e-11ef-b174-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古者車立乘，惟安車則坐乘耳。","note_content_jianti_auto":"古者车立乘，惟安车则坐乘耳。","note_type":"hu_note","start_index":169,"tongjian_id":"8c34325d-db0e-11ef-aded-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周禮：輪人爲蓋。蓋，所以覆冒車上也。","note_content_jianti_auto":"周礼：轮人为盖。盖，所以复冒车上也。","note_type":"hu_note","start_index":174,"tongjian_id":"8c34325e-db0e-11ef-a207-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"記：鄰有喪，舂不相。註云：相杵者，以音聲相勸。相，息亮翻。","note_content_jianti_auto":"记：邻有丧，舂不相。注云：相杵者，以音声相劝。相，息亮翻。","note_type":"hu_note","start_index":214,"tongjian_id":"8c343262-db0e-11ef-a415-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":5,"source_start_index":0,"source_text":"事見上八年","target_paragraph_tongjian_id":"8c22eb11-db0e-11ef-bc51-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上八年。嬖，卑義翻，又博計翻。監，甲暫翻。","note_content_jianti_auto":"事见上八年。嬖，卑义翻，又博计翻。监，甲暂翻。","note_type":"hu_note","start_index":229,"tongjian_id":"8c343265-db0e-11ef-bfd1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"轢，郞擊翻。車踐曰轢。","note_content_jianti_auto":"轹，郞击翻。车践曰轹。","note_type":"hu_note","start_index":244,"tongjian_id":"8c343266-db0e-11ef-954d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"祝","people_name_jianti_auto":"祝","start_index":0,"tongjian_id":"8c343268-db0e-11ef-8763-a0d3651f611f"},{"people_name":"武王","people_name_jianti_auto":"武王","start_index":26,"tongjian_id":"8c343269-db0e-11ef-a98c-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":29,"tongjian_id":"8c34326a-db0e-11ef-b72a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"祝，姓也。古有巫，史、祝之官，其子孫因以爲姓。或曰：武王封黃帝之後於祝，其子孫因氏焉。黥，其京翻。","note_content_jianti_auto":"祝，姓也。古有巫，史、祝之官，其子孙因以为姓。或曰：武王封黄帝之后于祝，其子孙因氏焉。黥，其京翻。","note_type":"hu_note","start_index":267,"tongjian_id":"8c343267-db0e-11ef-9a02-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"逸詩也。","note_content_jianti_auto":"逸诗也。","note_type":"hu_note","start_index":282,"tongjian_id":"8c34326b-db0e-11ef-a29a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":0,"tongjian_id":"8c34326e-db0e-11ef-b6c2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜預曰：騈脅，合幹也。騈，步田翻。乘，繩證翻。驂，讀曰參。","note_content_jianti_auto":"杜预曰：騈胁，合干也。騈，步田翻。乘，绳证翻。骖，读曰参。","note_type":"hu_note","start_index":313,"tongjian_id":"8c34326d-db0e-11ef-9566-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"薛綜","people_name_jianti_auto":"薛综","start_index":0,"tongjian_id":"8c343270-db0e-11ef-a4db-a0d3651f611f"},{"people_name":"顧野王","people_name_jianti_auto":"顾野王","start_index":80,"tongjian_id":"8c343271-db0e-11ef-a21a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":96,"tongjian_id":"8c343272-db0e-11ef-9adb-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":98,"tongjian_id":"8c343273-db0e-11ef-a38c-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":100,"tongjian_id":"8c343274-db0e-11ef-bafc-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","start_index":102,"tongjian_id":"8c343275-db0e-11ef-ba68-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"薛綜曰：闟之爲言函也，取四戟函車邊。此蓋令力士旁車而趨，有急則操翕戟以禦之也。後漢志有闟戟車。晉志：闟戟車，長戟邪偃在後。唐韻：戟名曰闟，音所及翻。史記正義曰：顧野王云：矛，鋋也。方言云：矛，吳、楚、江、淮之間謂之鋋。釋名曰：戟，格也，旁有枝格。旁車之旁，音步浪翻。","note_content_jianti_auto":"薛综曰：闟之为言函也，取四戟函车边。此盖令力士旁车而趋，有急则操翕戟以御之也。后汉志有闟戟车。晋志：闟戟车，长戟邪偃在后。唐韵：戟名曰闟，音所及翻。史记正义曰：顾野王云：矛，鋋也。方言云：矛，吴、楚、江、淮之间谓之鋋。释名曰：戟，格也，旁有枝格。旁车之旁，音步浪翻。","note_type":"hu_note","start_index":325,"tongjian_id":"8c34326f-db0e-11ef-80ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"逸書也。","note_content_jianti_auto":"逸书也。","note_type":"hu_note","start_index":351,"tongjian_id":"8c34327c-db0e-11ef-a26e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"朝露易晞，言不久也。","note_content_jianti_auto":"朝露易晞，言不久也。","note_type":"hu_note","start_index":367,"tongjian_id":"8c34327e-db0e-11ef-833c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦國","place_name_jianti_auto":"秦国","start_index":3,"tongjian_id":"8c343280-db0e-11ef-8d19-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言以專秦國之政爲寵也。","note_content_jianti_auto":"言以专秦国之政为宠也。","note_type":"hu_note","start_index":381,"tongjian_id":"8c34327f-db0e-11ef-bde4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙良","people_name_jianti_auto":"赵良","start_index":5,"tongjian_id":"8c343284-db0e-11ef-8825-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"微，少也。趙良言豈少，蓋謂太子與其師傅將挾怨而殺之也。","note_content_jianti_auto":"微，少也。赵良言岂少，盖谓太子与其师傅将挟怨而杀之也。","note_type":"hu_note","start_index":413,"tongjian_id":"8c343283-db0e-11ef-b8bc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"商君","people_name_jianti_auto":"商君","start_index":8,"tongjian_id":"8c343286-db0e-11ef-a082-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"難，乃旦翻。史言商君尚刑愎諫之禍速。","note_content_jianti_auto":"难，乃旦翻。史言商君尚刑愎谏之祸速。","note_type":"hu_note","start_index":425,"tongjian_id":"8c343285-db0e-11ef-accd-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f","pinyin":"gǔ","source_anchor_text":"秦孰與五羖大夫賢趙","source_key":"baiyang_epub","start_index":53,"text":"羖","tongjian_id":"87cce49e-2aab-5c22-83a9-d161421236cd"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f","pinyin":"lì","source_anchor_text":"從政也淩轢公族殘傷","source_key":"baiyang_epub","start_index":235,"text":"轢","tongjian_id":"2caa0644-94b2-5493-a41e-40281c672450"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f","pinyin":"huān","source_anchor_text":"君又殺祝懽而黥公孫","source_key":"baiyang_epub","start_index":260,"text":"懽","tongjian_id":"5969ddc5-6a5c-5838-aaa6-844a3f7e1b43"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f","pinyin":"xì","source_anchor_text":"持矛而操闟戟者旁車","source_key":"baiyang_epub","start_index":317,"text":"闟","tongjian_id":"9f99859f-c05a-54d3-b939-a74665ef85c4"}],"ExtRef_Children_places":[{"place_name":"商於","place_name_jianti_auto":"商于","resolved_place_entity_id":3109,"start_index":370,"tongjian_id":"8c372c3c-db0e-11ef-a043-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"初，商君相秦，用法嚴酷，嘗臨渭論囚，渭水盡赤。爲相十年，人多怨之。趙良見商君，商君問曰：「子觀我治秦孰與五羖大夫賢？」趙良曰：「千人之諾諾，不如一士之諤諤。僕請終日正言而無誅，可乎？」商君曰：「諾。」趙良曰：「五羖大夫，荊之鄙人也，穆公舉之牛口之下而加之百姓之上，秦國莫敢望焉。相秦六七年而東伐鄭，三置晉君，一救荊禍。其爲相也，勞不坐乘，暑不張蓋。行於國中，不從車乘，不操干戈。五羖大夫死，秦國男女流涕，童子不歌謠，舂者不相杵。今君之見也，因嬖人景監以爲主；其從政也，淩轢公族，殘傷百姓。公子虔杜門不出已八年矣。君又殺祝懽而黥公孫賈。詩曰：『得人者興，失人者崩。』此數者，非所以得人也。君之出也，後車載甲，多力而騈脅者爲驂乘，持矛而操闟戟者旁車而趨。此一物不具，君固不出。書曰：『恃德者昌，恃力者亡。』此數者，非恃德也。君之危若朝露，而尚貪商於之富，寵秦國之政，畜百姓之怨。秦王一旦捐賓客而不立朝，秦國之所以收君者豈其微哉！」商君弗從。居五月而難作。","content_fanyi":"当初，商君被任用为秦相，施行法令极其严酷，曾到渭水边审判处决囚犯，渭水被血染得通红。他任相十年，人们大多怨恨他。\n\n赵良来见商君，商君问他：“你看我治理秦国，与五羖大夫百里奚相比，谁更贤能？”赵良说：“上千人唯唯诺诺，也抵不上一个士人直言敢谏。请允许我整天直言而不受责罚，可以吗？”商君说：“可以。”\n\n赵良说：“五羖大夫本是楚国边地的粗人，秦穆公把他从牛口之下提拔起来，置于百官之上，秦国没有人敢有怨言。百里奚任秦国相六七年，与晋国合兵向东讨伐郑国，三次参与扶立晋国国君，一次挽救了楚国的祸难。他任相时，劳累也不坐车，暑热也不张设车盖。他在国都中巡行，不带随从车辆，也不持兵器。五羖大夫死时，秦国全国男女都痛哭流涕，儿童不再唱歌谣，舂米的人也不再随着杵声唱和。\n\n如今说到您能进见秦孝公，是靠宠臣景监引见；您执掌国政，欺凌秦国公族，残害百姓。公子虔闭门不出已经八年了。您又杀死祝懽，并对公孙贾施以刺面的黥刑。《诗经》说：‘得人者兴，失人者崩。’这几件事，都不是能得人心的。\n\n您外出时，后面的车载着甲士，力气大而体格健壮的人担任骖乘，手持矛和长戟的卫士在车旁紧随奔走。这些护卫只要缺少一样，您就不敢出行。《尚书》说：‘依靠仁德者昌盛，依靠暴力者灭亡。’这几件事，都不是依靠仁德。您的危险就像早晨的露水一样不能持久，却还贪图商於之地的富庶，专擅秦国的政令，蓄积百姓的怨恨。一旦秦王弃宾客而去、不再临朝，秦国想加害您的人难道会少吗？”\n\n商君没有听从。只过了五个月，祸难就爆发了。","content_jianti_auto":"初，商君相秦，用法严酷，尝临渭论囚，渭水尽赤。为相十年，人多怨之。赵良见商君，商君问曰：「子观我治秦孰与五羖大夫贤？」赵良曰：「千人之诺诺，不如一士之谔谔。仆请终日正言而无诛，可乎？」商君曰：「诺。」赵良曰：「五羖大夫，荆之鄙人也，穆公举之牛口之下而加之百姓之上，秦国莫敢望焉。相秦六七年而东伐郑，三置晋君，一救荆祸。其为相也，劳不坐乘，暑不张盖。行于国中，不从车乘，不操干戈。五羖大夫死，秦国男女流涕，童子不歌谣，舂者不相杵。今君之见也，因嬖人景监以为主；其从政也，凌轹公族，残伤百姓。公子虔杜门不出已八年矣。君又杀祝懽而黥公孙贾。诗曰：『得人者兴，失人者崩。』此数者，非所以得人也。君之出也，后车载甲，多力而騈胁者为骖乘，持矛而操闟戟者旁车而趋。此一物不具，君固不出。书曰：『恃德者昌，恃力者亡。』此数者，非恃德也。君之危若朝露，而尚贪商于之富，宠秦国之政，畜百姓之怨。秦王一旦捐宾客而不立朝，秦国之所以收君者岂其微哉！」商君弗从。居五月而难作。","dtjl_paragraph_links":[],"dtjl_references":[],"id":173,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十一年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f","year_int":-338},"tongjian_id":"8c34320e-db0e-11ef-b541-a0d3651f611f"},"paragraph_order":3},{"mention_count":3,"paragraph_brief":{"brief_for":"商於","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。閉關者，古之列國各置關尹，敵國賓至，關尹以告，則行理以節逆之。閉關則距絕其使，不爲通也。使，疏吏翻。","note_content_jianti_auto":"说，式芮翻。闭关者，古之列国各置关尹，敌国宾至，关尹以告，则行理以节逆之。闭关则距绝其使，不为通也。使，疏吏翻。","note_type":"hu_note","start_index":42,"tongjian_id":"8c637a59-db0e-11ef-8098-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"於，如字。箕帚之妾，猶言備灑掃也。帚，止酉翻，篲也。","note_content_jianti_auto":"于，如字。箕帚之妾，犹言备洒扫也。帚，止酉翻，篲也。","note_type":"hu_note","start_index":65,"tongjian_id":"8c637a5a-db0e-11ef-81f1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陳","people_name_jianti_auto":"陈","start_index":0,"tongjian_id":"8c637a5d-db0e-11ef-a5ee-a0d3651f611f"},{"people_name":"舜","people_name_jianti_auto":"舜","start_index":4,"tongjian_id":"8c637a5e-db0e-11ef-ba0c-a0d3651f611f"},{"people_name":"周武王","people_name_jianti_auto":"周武王","start_index":6,"tongjian_id":"8c637a5f-db0e-11ef-a5c8-a0d3651f611f"},{"people_name":"舜","people_name_jianti_auto":"舜","start_index":10,"tongjian_id":"8c637a60-db0e-11ef-852a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陳","place_name_jianti_auto":"陈","start_index":13,"tongjian_id":"8c637a61-db0e-11ef-8318-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陳姓出於舜，周武王封舜後於陳，子孫以國爲氏。","note_content_jianti_auto":"陈姓出于舜，周武王封舜后于陈，子孙以国为氏。","note_type":"hu_note","start_index":98,"tongjian_id":"8c637a5c-db0e-11ef-89c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":0,"tongjian_id":"8c637a64-db0e-11ef-90d6-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":4,"tongjian_id":"8c637a65-db0e-11ef-a337-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":8,"tongjian_id":"8c637a66-db0e-11ef-9590-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楚東北接齊，西接秦。","note_content_jianti_auto":"楚东北接齐，西接秦。","note_type":"hu_note","start_index":235,"tongjian_id":"8c637a63-db0e-11ef-bc35-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班固","people_name_jianti_auto":"班固","start_index":0,"tongjian_id":"8c637a6a-db0e-11ef-8e76-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":9,"tongjian_id":"8c637a6b-db0e-11ef-b396-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":13,"tongjian_id":"8c637a6c-db0e-11ef-b17b-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":15,"tongjian_id":"8c637a6d-db0e-11ef-802b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班固百官表：將軍，周末官，秦、漢因之。","note_content_jianti_auto":"班固百官表：将军，周末官，秦、汉因之。","note_type":"hu_note","start_index":328,"tongjian_id":"8c637a69-db0e-11ef-aef0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"商於","place_name_