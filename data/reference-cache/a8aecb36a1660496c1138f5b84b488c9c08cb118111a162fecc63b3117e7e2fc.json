hu_note","start_index":13,"tongjian_id":"8c046799-db0e-11ef-9b8c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":1,"tongjian_id":"8c0467b3-db0e-11ef-916b-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"府平阳，山西临汾","resolved_place_entity_id":301,"start_index":3,"tongjian_id":"8c0467b4-db0e-11ef-9eb4-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","place_note":"府邯郸，河北邯郸","resolved_place_entity_id":88,"start_index":5,"tongjian_id":"8c0467b5-db0e-11ef-afa6-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","place_note":"府临淄，山东淄博东临淄镇","resolved_place_entity_id":25,"start_index":7,"tongjian_id":"8c0467b6-db0e-11ef-b2b9-a0d3651f611f"},{"place_name":"靈丘","place_name_jianti_auto":"灵丘","place_note":"山東茌平","resolved_place_entity_id":3479,"start_index":10,"tongjian_id":"8c0467b7-db0e-11ef-8cf9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"《赵世家》：惠文王十四年，相国乐毅将赵、秦、韩、魏、燕之...","context_before":"灵县城[在州东北。胡氏以为即齐灵丘邑。","source_end_index":42,"source_paragraph_tongjian_id":"585d48f1-0a41-542a-b2f7-241fcce9b618","source_start_index":19,"source_text":"《史记·齐世家》：威王元年，三晋伐我，至灵丘。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2魏、韓、趙伐齊，至靈丘。","content_fanyi":"魏、韩、赵三国讨伐齐国，军队进至灵丘。","content_jianti_auto":"2魏、韩、赵伐齐，至灵丘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":79,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c046798-db0e-11ef-a831-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：柔衆安民曰靖；又，恭己鮮言曰靖。","note_content_jianti_auto":"谥法：柔众安民曰靖；又，恭己鲜言曰靖。","note_type":"hu_note","start_index":13,"tongjian_id":"8c0467b9-db0e-11ef-b323-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-357,"link_td_description":"晋孝公（？─约前357年），《古本竹书》称作晋桓公，姬姓，名頎，是中国春秋战国时代晋国的君主，晋烈公之子，烈公二十七年（前389年），烈公死，孝公即位。孝公死年不详，子晋静公即位。晋孝公时，晋国的大多数领土已大多落入韩、魏、赵三家之手，屡被迁移，孝公二十年（前369年），赵迁晋君于屯留，后封晋君于端氏。","link_td_id":"Q10001752","link_td_number_id":173085,"people_name":"晉孝公","people_name_jianti_auto":"晋孝公","people_xingming":"姬倾","start_index":1,"tongjian_id":"8c06768b-db0e-11ef-83fd-a0d3651f611f","wl_zhushi":"[姬倾]"},{"link_td_description":"晋静公，又称晋靖公、姬姓，名俱酒，是中国战国时代晋国的末代君主，晋孝公之子。孝公死后，静公即位，被三晋流放，夺取残余的食邑端氏，后被韩国大臣韩玘所杀。","link_td_id":"Q10001850","link_td_number_id":172547,"people_name":"靖公","people_name_jianti_auto":"靖公","people_xingming":"姬俱酒","start_index":7,"tongjian_id":"8c06768c-db0e-11ef-a383-a0d3651f611f"},{"link_td_description":"晋静公，又称晋靖公、姬姓，名俱酒，是中国战国时代晋国的末代君主，晋孝公之子。孝公死后，静公即位，被三晋流放，夺取残余的食邑端氏，后被韩国大臣韩玘所杀。","link_td_id":"Q10001850","link_td_number_id":172547,"people_name":"俱酒","people_name_jianti_auto":"俱酒","people_xingming":"姬俱酒","start_index":9,"tongjian_id":"8c06768d-db0e-11ef-934a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3晉孝公薨，子靖公俱酒立。","content_fanyi":"晋孝公去世，他的儿子晋靖公姬俱酒继位为国君。","content_jianti_auto":"3晋孝公薨，子靖公俱酒立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":80,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c0467b8-db0e-11ef-a6d6-a0d3651f611f"}],"reign_name":"二十四年","reign_name_jianti_auto":"二十四年","start_index":19,"tongjian_id":"8c04677d-db0e-11ef-a702-a0d3651f611f","year_anno":"（癸卯、前三七八）