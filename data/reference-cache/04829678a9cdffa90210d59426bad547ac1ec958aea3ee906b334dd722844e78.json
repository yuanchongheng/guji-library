ExtRef_Children_zhang_notes":[],"note_content":"師古曰：頓丘，丘名，因以爲縣；本衞地也。地理志，屬東郡；今則在魏州界。考異曰：漢書·武紀云：「東南流入勃海。」按頓丘屬東郡，勃海乃在頓丘東。此恐誤，今不取。","note_content_jianti_auto":"师古曰：顿丘，丘名，因以为县；本衞地也。地理志，属东郡；今则在魏州界。考异曰：汉书·武纪云：「东南流入勃海。」按顿丘属东郡，勃海乃在顿丘东。此恐误，今不取。","note_type":"hu_note","start_index":14,"tongjian_id":"8f84eb6c-db0e-11ef-b8c3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":7,"tongjian_id":"8f84eb7b-db0e-11ef-a9b9-a0d3651f611f"},{"people_name":"蘇林","people_name_jianti_auto":"苏林","start_index":21,"tongjian_id":"8f84eb7c-db0e-11ef-8fc2-a0d3651f611f"},{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":105,"tongjian_id":"8f84eb7d-db0e-11ef-92ab-a0d3651f611f"},{"people_name":"蘇林","people_name_jianti_auto":"苏林","start_index":129,"tongjian_id":"8f84eb7e-db0e-11ef-82fb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"濮陽縣","place_name_jianti_auto":"濮阳县","start_index":0,"tongjian_id":"8f84eb7f-db0e-11ef-885e-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":4,"tongjian_id":"8f84eb80-db0e-11ef-85eb-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","place_note":"河南濮陽西南","start_index":11,"tongjian_id":"8f84eb81-db0e-11ef-8622-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":18,"tongjian_id":"8f84eb82-db0e-11ef-ad2f-a0d3651f611f"},{"place_name":"甄城","place_name_jianti_auto":"甄城","start_index":25,"tongjian_id":"8f84eb83-db0e-11ef-a72b-a0d3651f611f"},{"place_name":"濮陽","place_name_jianti_auto":"濮阳","start_index":30,"tongjian_id":"8f84eb84-db0e-11ef-bf43-a0d3651f611f"},{"place_name":"瓠子河","place_name_jianti_auto":"瓠子河","start_index":35,"tongjian_id":"8f84eb85-db0e-11ef-be80-a0d3651f611f"},{"place_name":"瓠子河","place_name_jianti_auto":"瓠子河","start_index":50,"tongjian_id":"8f84eb86-db0e-11ef-bf51-a0d3651f611f"},{"place_name":"濮陽縣","place_name_jianti_auto":"濮阳县","start_index":54,"tongjian_id":"8f84eb87-db0e-11ef-94f4-a0d3651f611f"},{"place_name":"瓠河","place_name_jianti_auto":"瓠河","start_index":62,"tongjian_id":"8f84eb88-db0e-11ef-901a-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":94,"tongjian_id":"8f84eb89-db0e-11ef-959a-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","start_index":96,"tongjian_id":"8f84eb8a-db0e-11ef-9a56-a0d3651f611f"},{"place_name":"鉅野","place_name_jianti_auto":"巨野","place_note":"山東鉅野","start_index":101,"tongjian_id":"8f84eb8b-db0e-11ef-86dd-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","place_note":"河南濮陽西南","start_index":116,"tongjian_id":"8f84eb8c-db0e-11ef-a286-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":123,"tongjian_id":"8f84eb8d-db0e-11ef-b20b-a0d3651f611f"},{"place_name":"白馬","place_name_jianti_auto":"白马","start_index":125,"tongjian_id":"8f84eb8e-db0e-11ef-b315-a0d3651f611f"},{"place_name":"甄城","place_name_jianti_auto":"甄城","start_index":135,"tongjian_id":"8f84eb8f-db0e-11ef-8529-a0d3651f611f"},{"place_name":"濮陽","place_name_jianti_auto":"濮阳","start_index":140,"tongjian_id":"8f84eb90-db0e-11ef-a33a-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":160,"tongjian_id":"8f84eb91-db0e-11ef-89ec-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","start_index":162,"tongjian_id":"8f84eb92-db0e-11ef-86bd-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","start_index":168,"tongjian_id":"8f84eb93-db0e-11ef-b8c1-a0d3651f611f"},{"place_name":"濮陽縣","place_name_jianti_auto":"濮阳县","start_index":171,"tongjian_id":"8f84eb94-db0e-11ef-9229-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"濮陽縣屬東郡。服虔曰：瓠子，隄名，在東郡。蘇林曰：甄城以南、濮陽以北爲瓠子河，廣百步，深五丈。水經：瓠子河出濮陽縣北十里，卽瓠河口。復，扶又翻。瓠，戶故翻。考異曰：史記·河渠書：「元光中，河決瓠子，東注鉅野。」服虔註漢書·武紀曰：「瓠子，隄名，在東郡白馬。」蘇林曰：「在甄城以南，濮陽以北。」將相名臣表曰：「五月，丙子，河決瓠子。」然則瓠子卽濮陽縣境隄名也。","note_content_jianti_auto":"濮阳县属东郡。服虔曰：瓠子，隄名，在东郡。苏林曰：甄城以南、濮阳以北为瓠子河，广百步，深五丈。水经：瓠子河出濮阳县北十里，即瓠河口。复，扶又翻。瓠，户故翻。考异曰：史记·河渠书：「元光中，河决瓠子，东注巨野。」服虔注汉书·武纪曰：「瓠子，隄名，在东郡白马。」苏林曰：「在甄城以南，濮阳以北。」将相名臣表曰：「五月，丙子，河决瓠子。」然则瓠子即濮阳县境隄名也。","note_type":"hu_note","start_index":29,"tongjian_id":"8f84eb7a-db0e-11ef-8e13-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8f84eb9b-db0e-11ef-a69f-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":18,"tongjian_id":"8f84eb9c-db0e-11ef-90d2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鉅野縣","place_name_jianti_auto":"巨野县","start_index":3,"tongjian_id":"8f84eb9d-db0e-11ef-a476-a0d3651f611f"},{"place_name":"山陽郡","place_name_jianti_auto":"山阳郡","start_index":7,"tongjian_id":"8f84eb9e-db0e-11ef-b953-a0d3651f611f"},{"place_name":"大野澤","place_name_jianti_auto":"大野泽","start_index":11,"tongjian_id":"8f84eb9f-db0e-11ef-b802-a0d3651f611f"},{"place_name":"鄆州","place_name_jianti_auto":"郓州","start_index":24,"tongjian_id":"8f84eba0-db0e-11ef-881a-a0d3651f611f"},{"place_name":"鉅野縣","place_name_jianti_auto":"巨野县","start_index":26,"tongjian_id":"8f84eba1-db0e-11ef-8ff0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，鉅野縣屬山陽郡；大野澤在其北。師古曰：卽今鄆州鉅野縣。","note_content_jianti_auto":"班志，巨野县属山阳郡；大野泽在其北。师古曰：即今郓州巨野县。","note_type":"hu_note","start_index":33,"tongjian_id":"8f84eb9a-db0e-11ef-917e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":1,"tongjian_id":"8f84eba4-db0e-11ef-936a-a0d3651f611f"},{"place_name":"鉅野","place_name_jianti_auto":"巨野","start_index":6,"tongjian_id":"8f84eba5-db0e-11ef-99ee-a0d3651f611f"},{"place_name":"泗水","place_name_jianti_auto":"泗水","start_index":10,"tongjian_id":"8f84eba6-db0e-11ef-ba10-a0d3651f611f"},{"place_name":"泗水","place_name_jianti_auto":"泗水","start_index":14,"tongjian_id":"8f84eba7-db0e-11ef-96f6-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","start_index":18,"tongjian_id":"8f84eba8-db0e-11ef-a0b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"決河之水，由鉅野而通泗水，由泗水而通淮也。","note_content_jianti_auto":"决河之水，由巨野而通泗水，由泗水而通淮也。","note_type":"hu_note","start_index":38,"tongjian_id":"8f84eba3-db0e-11ef-9203-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"塞，悉則翻。復，扶又翻；下同。","note_content_jianti_auto":"塞，悉则翻。复，扶又翻；下同。","note_type":"hu_note","start_index":63,"tongjian_id":"8f84ebaa-db0e-11ef-b9cd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鄃縣","place_name_jianti_auto":"鄃县","start_index":11,"tongjian_id":"8f84ebac-db0e-11ef-aad3-a0d3651f611f"},{"place_name":"清河郡","place_name_jianti_auto":"清河郡","start_index":14,"tongjian_id":"8f84ebad-db0e-11ef-bd08-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"奉，扶用翻。鄃，音輸。鄃縣屬清河郡。","note_content_jianti_auto":"奉，扶用翻。鄃，音输。鄃县属清河郡。","note_type":"hu_note","start_index":73,"tongjian_id":"8f84ebab-db0e-11ef-b2e2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-108,"link_td_description":"汲黯，字长孺，西汉濮阳（今濮阳西南）人，西汉名臣。汉景帝时汲黯为太子洗马（太子家宦，太子出入时为先导），汉武帝时任中大夫；因常规劝武帝，武帝不耐，调为东海郡太守，继为主爵都尉，是汉代著名的直谏之臣。","link_td_id":"Q10008365","link_td_number_id":223030,"people_name":"汲黯","people_name_jianti_auto":"汲黯","people_xingming":"汲黯","start_index":46,"tongjian_id":"8f84ebb6-db0e-11ef-b89a-a0d3651f611f"},{"link_td_description":"郑当时，字庄，陈郡人，西汉大臣。","link_td_id":"Q10007508","link_td_number_id":1492302,"people_name":"鄭當時","people_name_jianti_auto":"郑当时","people_xingming":"郑当时","start_index":49,"tongjian_id":"8f84ebb7-db0e-11ef-bdc4-a0d3651f611f"},{"link_death_year":-130,"link_td_description":"田蚡，内史长陵（今陕西咸阳市东北）人，西汉政治人物。汉武帝的舅舅、大臣，封武安侯。后来与魏其侯窦婴不和，设计杀害灌夫及窦婴，窦婴死后，田蚡亦发疯而亡。《史记》中说，占卜师分析田蚡是因为窦婴和灌夫两鬼的灵魂缠身而死亡。","link_td_id":"Q10008552","link_td_number_id":325827,"people_name":"田蚡","people_name_jianti_auto":"田蚡","people_xingming":"田蚡","start_index":66,"tongjian_id":"8f84ebb8-db0e-11ef-bc00-a0d3651f611f"},{"link_death_year":-130,"link_td_description":"田蚡，内史长陵（今陕西咸阳市东北）人，西汉政治人物。汉武帝的舅舅、大臣，封武安侯。后来与魏其侯窦婴不和，设计杀害灌夫及窦婴，窦婴死后，田蚡亦发疯而亡。《史记》中说，占卜师分析田蚡是因为窦婴和灌夫两鬼的灵魂缠身而死亡。","link_td_id":"Q10008552","link_td_number_id":325827,"people_name":"蚡","people_name_jianti_auto":"蚡","people_xingming":"田蚡","start_index":93,"tongjian_id":"8f84ebba-db0e-11ef-83ea-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f84eb6b-db0e-11ef-b4d1-a0d3651f611f","pinyin":"shū","source_anchor_text":"蚡奉邑食鄃鄃居河北","source_key":"baiyang_epub","start_index":71,"text":"鄃","tongjian_id":"a32fedef-730b-5a36-b531-529f21e83799"}],"ExtRef_Children_places":[{"place_name":"河水","place_name_jianti_auto":"河水","resolved_place_entity_id":42,"start_index":3,"tongjian_id":"8f84ebaf-db0e-11ef-b9b9-a0d3651f611f"},{"place_name":"頓丘","place_name_jianti_auto":"顿丘","place_note":"河南内黄东南","resolved_place_entity_id":1602,"start_index":8,"tongjian_id":"8f84ebb0-db0e-11ef-93da-a0d3651f611f"},{"place_name":"濮陽","place_name_jianti_auto":"濮阳","resolved_place_entity_id":828,"start_index":24,"tongjian_id":"8f84ebb1-db0e-11ef-803e-a0d3651f611f"},{"place_name":"瓠子","place_name_jianti_auto":"瓠子","place_note":"河南濮陽西南","resolved_place_entity_id":5016,"start_index":26,"tongjian_id":"8f84ebb2-db0e-11ef-90d7-a0d3651f611f"},{"place_name":"鉅野","place_name_jianti_auto":"巨野","place_note":"山東鉅野","resolved_place_entity_id":2750,"start_index":30,"tongjian_id":"8f84ebb3-db0e-11ef-86aa-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","resolved_place_entity_id":107,"start_index":34,"tongjian_id":"8f84ebb4-db0e-11ef-9e23-a0d3651f611f"},{"place_name":"泗","place_name_jianti_auto":"泗","resolved_place_entity_id":681,"start_index":36,"tongjian_id":"8f84ebb5-db0e-11ef-b37d-a0d3651f611f"},{"place_name":"鄃","place_name_jianti_auto":"鄃","place_note":"山東高唐东北","resolved_place_entity_id":4090,"start_index":71,"tongjian_id":"8f84ebb9-db0e-11ef-bfd5-a0d3651f611f"},{"place_name":"鄃","place_name_jianti_auto":"鄃","resolved_place_entity_id":4090,"start_index":73,"tongjian_id":"8f84ebbb-db0e-11ef-93c6-a0d3651f611f"},{"place_name":"河北","place_name_jianti_auto":"河北","resolved_place_entity_id":58,"start_index":75,"tongjian_id":"8f84ebbc-db0e-11ef-9f3e-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":78,"tongjian_id":"8f84ebbd-db0e-11ef-ad1c-a0d3651f611f"},{"place_name":"鄃","place_name_jianti_auto":"鄃","resolved_place_entity_id":4090,"start_index":84,"tongjian_id":"8f84ebbe-db0e-11ef-9917-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","resolved_place_entity_id":47,"start_index":100,"tongjian_id":"8f84ebbf-db0e-11ef-b7b2-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":102,"tongjian_id":"8f84ebc0-db0e-11ef-bfec-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、徐州（卷二十九）","excerpts":[{"context_after":"后汉初，王梁击佼强、苏茂于楚沛间，拔大梁、啮桑，是也]。","context_before":"...地也。战国周显王四十六年，秦张仪及齐、楚之相，会于啮桑。","source_end_index":82,"source_paragraph_tongjian_id":"18afb555-2c9a-5155-ad10-944e6a3ce351","source_start_index":52,"source_text":"汉武帝《瓠子歌》：啮桑浮兮淮泗满。及塞决口，而梁、楚无水灾。"}],"path":"南直方舆纪要/十四、徐州（卷二十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"后汉光武亦封马□为鄃侯。晋仍曰鄃县，属清河郡□之。后魏初...","context_before":"...。汉县，属清河郡。吕后封吕陀为侯邑。又文帝封栾布为鄃侯。","source_end_index":112,"source_paragraph_tongjian_id":"622de18e-71e3-523e-815b-482fbcfb5f55","source_start_index":45,"source_text":"武帝时，复为武安侯田蚡食邑。《史记·河渠书》：鄃为丞相，其奉邑食鄃。鄃居河北，河决而南，则鄃无水灾，邑收多。蚡言于上，久之不事复塞也。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"晋太和四年，桓温伐燕，至金乡，遣毛虎生凿巨野三百里，引汶...","context_before":"...，鲁有大野。是也。秦末，昌邑人彭越渔于巨野泽中，为群盗。","source_end_index":121,"source_paragraph_tongjian_id":"d04836ae-a846-52f7-bcf9-666a77a51ee7","source_start_index":104,"source_text":"汉元光中，河决瓠子，东南注于巨野。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"苏林曰：鄄城南有瓠子堤。《州志》：故黄河自州东南三十里合...","context_before":"...源自直隶之滑县开州流入界，此其下流也。《史记·河渠书》：","source_end_index":82,"source_paragraph_tongjian_id":"d246155b-99f1-5f6f-8461-1c0dfdd4f804","source_start_index":40,"source_text":"元光中，河决瓠子，东南注巨野，通于淮、泗。后二十余载，天子自临决河塞之，作瓠子之歌。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/◎川渎二大河上（卷一百二十五）","excerpts":[{"context_after":"五代周广顺三年，澶州河溢。宋乾德三年，河决澶州。开宝四年...","context_before":"大河旧在开州城南，汉之濮阳，宋之澶州，皆其地也。","source_end_index":153,"source_paragraph_tongjian_id":"717b18d3-43f2-543a-8aad-0ee16d9402be","source_start_index":24,"source_text":"汉元光三年，河水徙从顿丘东南流，既而决瓠子[在今州西南二十五里]，东南注巨野[巨野泽，见山东巨野县]，通于淮、泗[此为黄河入淮之始。丘氏以宋熙宁十年为黄河入淮之始，误矣]，泛郡十六。使汲黯、郑当时兴人徒塞之，辄复坏。元封二年，自临决河塞之，作瓠子之歌，是也。"},{"context_after":"宋时澶州河屡决，河复行北道。开宝八年，河决澶州之顿丘。太...","context_before":"...，见开州。繁阳，见内黄。阴安，见清丰县]。汉时河皆经此。","source_end_index":120,"source_paragraph_tongjian_id":"9505f746-bbb8-5ddb-95c4-a248aee75e2f","source_start_index":83,"source_text":"元光三年，河徙，从顿丘东南流[顿丘，今清丰县境是也]。后决塞不时，故道废。"}],"path":"川渎/◎川渎二大河上（卷一百二十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/◎川渎三大河下（卷一百二十六）","excerpts":[{"context_after":"然则河之趋于淮也，旧矣。独是合淮三百年而不变者，唯有近时...","context_before":"...又太宗太平兴国八年，河决滑州，东南流，至彭城入淮。更远而","source_end_index":1395,"source_paragraph_tongjian_id":"d9dd456f-6419-573d-9fce-77b5beb52655","source_start_index":1378,"source_text":"汉武帝元光中，河决瓠子，通于淮泗。"}],"path":"川渎/◎川渎三大河下（卷一百二十六）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"1春，河水徙，從頓丘東南流。夏，五月，丙子，復決濮陽瓠子，注鉅野，通淮、泗，汎郡十六。天子使汲黯、鄭當時發卒十萬塞之，輒復壞。是時，田蚡奉邑食鄃；鄃居河北，河決而南，則鄃無水災，邑收多。蚡言於上曰：「江、河之決皆天事，未易以人力強塞，塞之未必應天。」而望氣用數者亦以爲然。於是天子久之不復事塞也。","content_fanyi":"春季，黄河决口改道，从顿丘向东南方流去。到了夏季，五月初二丙子日，黄河又在濮阳县的瓠子决口，洪水注入巨野县，连通了淮河和泗水，十六个郡因此遭受水灾。汉武帝刘彻派遣汲黯、郑当时征发十万役夫堵塞决口，但刚堵上就被洪水重新冲毁。当时，田蚡的食邑是鄃县；鄃县地处黄河北岸，黄河决口向南泛滥，鄃县就不会遭受水灾，食邑收入也会随之增多。田蚡便向汉武帝进言说：“长江、黄河的决口都是天意的安排，靠人力强行堵塞并不容易，堵塞了也未必符合天意。”而那些候望云气和使用法术的方士们也认为是这样。于是，汉武帝很长时间不再征调人力去从事堵塞决口的工程。","content_jianti_auto":"1春，河水徙，从顿丘东南流。夏，五月，丙子，复决濮阳瓠子，注巨野，通淮、泗，泛郡十六。天子使汲黯、郑当时发卒十万塞之，辄复坏。是时，田蚡奉邑食鄃；鄃居河北，河决而南，则鄃无水灾，邑收多。蚡言于上曰：「江、河之决皆天事，未易以人力强塞，塞之未必应天。」而望气用数者亦以为然。于是天子久之不复事塞也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1435,"number":1,"reading_annotation_sources":[{"count":2,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":0,"tongjian_id":"8f84eb6b-db0e-11ef-b4d1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諸郞，諸曹郞也。","note_content_jianti_auto":"诸郞，诸曹郞也。","note_type":"hu_note","start_index":27,"tongjian_id":"8f84ebc2-db0e-11ef-abc4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f84ebc4-db0e-11ef-997f-a0d3651f611f"},{"people_name":"嬰","people_name_jianti_auto":"婴","start_index":7,"tongjian_id":"8f84ebc5-db0e-11ef-9c19-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言素爲嬰之賓客者，漸以衰退，不復往也。","note_content_jianti_auto":"师古曰：言素为婴之宾客者，渐以衰退，不复往也。","note_type":"hu_note","start_index":57,"tongjian_id":"8f84ebc3-db0e-11ef-847b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"燕王","people_name_jianti_auto":"燕王","start_index":0,"tongjian_id":"8f84ebc7-db0e-11ef-bf79-a0d3651f611f"},{"people_name":"定國","people_name_jianti_auto":"定国","start_index":2,"tongjian_id":"8f84ebc8-db0e-11ef-b2bc-a0d3651f611f"},{"people_name":"澤","people_name_jianti_auto":"泽","start_index":6,"tongjian_id":"8f84ebc9-db0e-11ef-bf75-a0d3651f611f"},{"people_name":"夫","people_name_jianti_auto":"夫","start_index":11,"tongjian_id":"8f84ebca-db0e-11ef-a44e-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":19,"tongjian_id":"8f84ebcb-db0e-11ef-92bd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"潁陰縣","place_name_jianti_auto":"颍阴县","start_index":22,"tongjian_id":"8f84ebcc-db0e-11ef-ae58-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":26,"tongjian_id":"8f84ebcd-db0e-11ef-bbb2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕王定國，王澤之孫也；夫自太僕出相之。班志，潁陰縣屬潁川郡。相，息亮翻。","note_content_jianti_auto":"燕王定国，王泽之孙也；夫自太仆出相之。班志，颍阴县属颍川郡。相，息亮翻。","note_type":"hu_note","start_index":68,"tongjian_id":"8f84ebc6-db0e-11ef-b328-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":0,"tongjian_id":"8f84ebd0-db0e-11ef-b047-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":12,"tongjian_id":"8f84ebd1-db0e-11ef-b38e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張晏曰：相薦達爲聲勢也。師古曰：相牽引以致於尊重也。爲，于僞翻。","note_content_jianti_auto":"张晏曰：相荐达为声势也。师古曰：相牵引以致于尊重也。为，于伪翻。","note_type":"hu_note","start_index":79,"tongjian_id":"8f84ebcf-db0e-11ef-8a32-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"夫","people_name_jianti_auto":"夫","start_index":0,"tongjian_id":"8f84ebd4-db0e-11ef-a519-a0d3651f611f"},{"people_name":"灌氏","people_name_jianti_auto":"灌氏","start_index":26,"tongjian_id":"8f84ebd5-db0e-11ef-b031-a0d3651f611f"},{"people_name":"灌氏","people_name_jianti_auto":"灌氏","start_index":34,"tongjian_id":"8f84ebd6-db0e-11ef-ac88-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":12,"tongjian_id":"8f84ebd7-db0e-11ef-9165-a0d3651f611f"},{"place_name":"潁水","place_name_jianti_auto":"颍水","start_index":22,"tongjian_id":"8f84ebd8-db0e-11ef-914b-a0d3651f611f"},{"place_name":"潁水","place_name_jianti_auto":"颍水","start_index":30,"tongjian_id":"8f84ebd9-db0e-11ef-a582-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫宗族、賓客爲權利，橫於潁川；小兒歌之曰：「潁水清，灌氏寧；潁水濁，灌氏族。」橫，戶孟翻。","note_content_jianti_auto":"夫宗族、宾客为权利，横于颍川；小儿歌之曰：「颍水清，灌氏宁；颍水浊，灌氏族。」横，户孟翻。","note_type":"hu_note","start_index":134,"tongjian_id":"8f84ebd3-db0e-11ef-9f75-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":21,"tongjian_id":"8f84ebdb-db0e-11ef-9a9e-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":33,"tongjian_id":"8f84ebdc-db0e-11ef-a18c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":62,"tongjian_id":"8f84ebdd-db0e-11ef-a127-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"刑人於市，與衆棄之，故殺之於市者謂之棄市。景帝中元年，改磔曰棄市。應劭曰：先諸死刑皆磔於市，今改曰棄市，自非妖逆，不復磔也。師古曰：磔，謂張其尸也。棄市，殺之於市也。","note_content_jianti_auto":"刑人于市，与众弃之，故杀之于市者谓之弃市。景帝中元年，改磔曰弃市。应劭曰：先诸死刑皆磔于市，今改曰弃市，自非妖逆，不复磔也。师古曰：磔，谓张其尸也。弃市，杀之于市也。","note_type":"hu_note","start_index":147,"tongjian_id":"8f84ebda-db0e-11ef-bd9b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","start_index":7,"tongjian_id":"8f84ebdf-db0e-11ef-93b1-a0d3651f611f"},{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":12,"tongjian_id":"8f84ebe0-db0e-11ef-b456-a0d3651f611f"},{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","start_index":21,"tongjian_id":"8f84ebe1-db0e-11ef-928e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東朝，謂太后居長樂宮，在未央宮之東也；令於長樂宮見太后，廷辨其是非也。朝，直遙翻，下同。","note_content_jianti_auto":"东朝，谓太后居长乐宫，在未央宫之东也；令于长乐宫见太后，廷辨其是非也。朝，直遥翻，下同。","note_type":"hu_note","start_index":167,"tongjian_id":"8f84ebde-db0e-11ef-a8d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"若屬，猶言汝輩也。","note_content_jianti_auto":"若属，犹言汝辈也。","note_type":"hu_note","start_index":232,"tongjian_id":"8f84ebe3-db0e-11ef-9dd9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":0,"tongjian_id":"8f84ebe6-db0e-11ef-bb2c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉灼曰：藉，蹈也。藉，慈夜翻。","note_content_jianti_auto":"晋灼曰：藉，蹈也。藉，慈夜翻。","note_type":"hu_note","start_index":265,"tongjian_id":"8f84ebe5-db0e-11ef-b9c9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f84ebe8-db0e-11ef-a35d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：以比魚肉而食啖也。","note_content_jianti_auto":"师古曰：以比鱼肉而食啖也。","note_type":"hu_note","start_index":278,"tongjian_id":"8f84ebe7-db0e-11ef-b7f4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代最高軍事長官，掌管全國軍事，位高權重。在原文中，竇嬰曾任此職，顯示其早期地位顯赫。","official_rank":"正一品或從一品","source_snippet":"魏其侯竇嬰爲大將軍","start_index":10,"tongjian_id":"976d411f-f478-4c4a-9fe3-3c9b93d9182a"},{"confidence":0.9,"official_category":"宮廷侍從","official_name":"諸郞","official_note":"諸郞泛指郎官，是漢代宮廷中的侍從官員，負責宿衛、侍從等職務。在原文中，田蚡早期擔任此職，地位較低。","official_rank":"低級官員","source_snippet":"武安侯田蚡乃爲諸郞","start_index":20,"tongjian_id":"58fbe990-11a9-4139-860a-80a65d8ec787"},{"confidence":0.98,"official_category":"中樞機構","official_name":"丞相","official_note":"丞相是漢代最高行政長官，輔佐皇帝處理政務，權力極大。在原文中，田蚡後來升任此職，顯示其權勢增長。","official_rank":"正一品或最高行政長官","source_snippet":"已而蚡日益貴幸，爲丞相","start_index":32,"tongjian_id":"e9ffe351-256e-4ee9-bad6-5ec77cf4fd67"},{"confidence":0.92,"official_category":"地方行政","official_name":"燕相","official_note":"燕相是燕國的相國，負責管理燕國政務，屬於地方諸侯國的高級官員。在原文中，灌夫曾任此職，後因故失去官職。","official_rank":"郡國級高官","source_snippet":"獨故燕相潁陰灌夫不去","start_index":48,"tongjian_id":"66711cc5-831e-4c2a-a4fc-711d3d776b8a"}],"ExtRef_Children_people":[{"link_birth_year":-188,"link_death_year":-141,"link_td_description":"汉景帝刘启，为汉朝皇帝（前157年7月14日－前141年3月9日在位），在位16年，享年48岁，其正式谥号为「孝景皇帝」，后世省略「孝」字称「汉景帝」。为汉文帝刘恒长子，母窦皇后。他在位期间，主要是削诸侯封地，平定七国之乱，巩固中央集权，勤俭治国，发展生产，他和其父亲文帝的统治时期合称文景之治，为中国自大一统以来的首个太平盛世。","link_td_id":"Q10000365","link_td_number_id":90408,"people_name":"孝景","people_name_jianti_auto":"孝景","people_xingming":"刘启","start_index":3,"tongjian_id":"8f8721ee-db0e-11ef-ad96-a0d3651f611f","wl_zhushi":"[刘启]"},{"link_death_year":-131,"link_td_description":"窦婴，清河郡觀津縣（今河北省衡水市武邑县）人，西汉政治人物，是汉文帝皇后窦氏堂兄之子，以军功封魏其侯，后因与武安侯田蚡不和，被以「伪造诏书罪」斩首。","link_td_id":"Q10000764","link_td_number_id":358768,"people_name":"魏其侯","people_name_jianti_auto":"魏其侯","people_xingming":"窦婴","start_index":7,"tongjian_id":"8f8721ef-db0e-11ef-9fd2-a0d3651f611f"},{"link_death_year":-131,"link_td_description":"窦婴，清河郡觀津縣（今河北省衡水市武邑县）人，西汉政治人物，是汉文帝皇后窦氏堂兄之子，以军功封魏其侯，后因与武安侯田蚡不和，被以「伪造诏书罪」斩首。","link_td_id":"Q10000764","link_td_number_id":358768,"people_name":"竇嬰","people_name_jianti_auto":"窦婴","people_xingming":"窦婴","start_index":10,"tongjian_id":"8f8721f0-db0e-11ef-ada5-a0d3651f611f"},{"link_death_year":-130,"link_td_description":"田蚡，内史长陵（今陕西咸阳市东北）人，西汉政治人物。汉武帝的舅舅、大臣，封武安侯。后来与魏其侯窦婴不和，设计杀害灌夫及窦婴，窦婴死后，田蚡亦发疯而亡。《史记》中说，占卜师分析田蚡是因为窦婴和灌夫两鬼的灵魂缠身而死亡。","link_td_id":"Q10008552","link_td_number_id":325827,"people_name":"武安侯","people_name_jianti_auto":"武安侯","people_xingming":"田蚡","start_index":17,"tongjian_id":"8f8721f1-db0e-11ef-8e86-a0d3651f611f"},{"link_death_year":-130,"link_td_description":"田蚡，内史长陵（今陕西咸阳市东北）人，西汉政治人物。汉武帝的舅舅、大臣，封武安侯。后来与魏其侯窦婴不和，设计杀害灌夫及窦婴，窦婴死后，田蚡亦发疯而亡。《史记》中说，占卜师分析田蚡是因为窦婴和灌夫两鬼的灵魂缠身而死亡。","link_td_id":"Q10008552","link_td_number_id":325827,"people_name":"田蚡","people_name_jianti_auto":"田蚡","people_xingming":"田蚡","start_index":20,"tongjian_id":"8f8721f2-db0e-11ef-8c0f-a0d3651f611f"},{"link_death_year":-130,"link_td_description":"田蚡，内史长陵（今陕西咸阳市东北）人，西汉政治人物。汉武帝的舅舅、大臣，封武安侯。后来与魏其侯窦婴不和，设计杀害灌夫及窦婴，窦婴死后，田蚡亦发疯而亡。《史记》中说，占卜师分析田蚡是因为窦婴和灌夫两鬼的灵魂缠身而死亡。","link_td_id":"Q10008552","link_td_number_id":325827,"people_name":"蚡","people_name_jianti_auto":"蚡","people_xingming":"田蚡","start_index":37,"tongjian_id":"8f8721f3-db0e-11ef-ae53-a0d3651f611f"},{"link_death_year":-131,"link_td_description":"窦婴，清河郡觀津縣（今河北省衡水市武邑县）人，西汉政治人物，是汉文帝皇后窦氏堂兄之子，以军功封魏其侯，后因与武安侯田蚡不和，被以「伪造诏书罪」斩首。","link_td_id":"Q10000764","link_td_number_id":358768,"people_name":"魏其","people_name_jianti_auto":"魏其","start_index":47,"tongjian_id":"8f8721f4-d