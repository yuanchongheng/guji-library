urce_paragraph_tongjian_id":"7548135d-52d9-5001-b976-56cea81f634a","source_start_index":44,"source_text":"后汉建武十七年，始入塞为寇，辽东太守祭彤讨破之，后遂服属焉。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"9匈奴、鮮卑、赤山烏桓數連兵入塞，殺略吏民；詔拜襄賁令祭肜爲遼東太守。肜有勇力，虜每犯塞，常爲士卒鋒，數破走之。肜，遵之從弟也。","content_fanyi":"匈奴、鲜卑、赤山乌桓多次联合发兵侵入边塞，杀害掳掠官吏百姓；光武帝下诏任命襄贲县令祭肜为辽东太守。祭肜勇猛有力，每当胡人侵犯边塞，总是身先士卒，多次把他们打败赶跑。祭肜，是祭遵的堂弟。","content_jianti_auto":"9匈奴、鲜卑、赤山乌桓数连兵入塞，杀略吏民；诏拜襄贲令祭肜为辽东太守。肜有勇力，虏每犯塞，常为士卒锋，数破走之。肜，遵之从弟也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3375,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"948a960f-db0e-11ef-8cc9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"障，與嶂同，山也。山谿爲阻，則治橋道以通之。","note_content_jianti_auto":"障，与嶂同，山也。山谿为阻，则治桥道以通之。","note_type":"hu_note","start_index":31,"tongjian_id":"948ae863-db0e-11ef-9ff9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":6,"chapter_name":"考证篇第六","chenzhu_chapter":"胡注长于地理及考证，今日学者无不知。书名《表微》，非微何必表也？曰：考证为史学方法之一，欲实事求是，非考证不可。彼毕生从事考证，以为尽史学之能事者固非；薄视考证以为不足道者，亦未必是也。兹特辑存数十条，以备史学之一法，固知非大义微言所在也。","chenzhu_index_in_chapter":9,"chenzhu_text":"《晋志》九真郡有扶乐县，谓“九真郡未尝有扶乐县”者，指《汉志》也。贤以晋地理释汉地理，故《胡注》以为误。","created_at":"2025-12-31 08:50:44","seq_in_chapter":28,"tongjian_id":"CH06-CZ009"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"948b0f66-db0e-11ef-a901-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":16,"tongjian_id":"948b0f67-db0e-11ef-b7fb-a0d3651f611f"},{"people_name":"隆","people_name_jianti_auto":"隆","start_index":31,"tongjian_id":"948b0f68-db0e-11ef-b756-a0d3651f611f"},{"people_name":"亢父侯","people_name_jianti_auto":"亢父侯","start_index":34,"tongjian_id":"948b0f69-db0e-11ef-a88a-a0d3651f611f"},{"people_name":"扶樂鄕侯","people_name_jianti_auto":"扶乐鄕侯","start_index":50,"tongjian_id":"948b0f6a-db0e-11ef-b015-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":66,"tongjian_id":"948b0f6b-db0e-11ef-b47b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"扶樂","place_name_jianti_auto":"扶乐","start_index":3,"tongjian_id":"948b0f6c-db0e-11ef-b8d9-a0d3651f611f"},{"place_name":"九眞郡","place_name_jianti_auto":"九真郡","start_index":10,"tongjian_id":"948b0f6d-db0e-11ef-9c04-a0d3651f611f"},{"place_name":"九眞郡","place_name_jianti_auto":"九真郡","start_index":21,"tongjian_id":"948b0f6e-db0e-11ef-9259-a0d3651f611f"},{"place_name":"扶樂縣","place_name_jianti_auto":"扶乐县","start_index":27,"tongjian_id":"948b0f6f-db0e-11ef-8c05-a0d3651f611f"},{"place_name":"扶樂","place_name_jianti_auto":"扶乐","start_index":56,"tongjian_id":"948b0f70-db0e-11ef-a0da-a0d3651f611f"},{"place_name":"扶樂城","place_name_jianti_auto":"扶乐城","start_index":77,"tongjian_id":"948b0f71-db0e-11ef-8b31-a0d3651f611f"},{"place_name":"扶溝縣","place_name_jianti_auto":"扶沟县","start_index":81,"tongjian_id":"948b0f72-db0e-11ef-9dab-a0d3651f611f"},{"place_name":"砂水","place_name_jianti_auto":"砂水","start_index":85,"tongjian_id":"948b0f73-db0e-11ef-a3ea-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：扶樂，縣名，屬九眞郡。余謂賢說誤矣，九眞郡未嘗有扶樂縣。隆初封亢父侯，以度田不實免，次年，封爲扶樂鄕侯。則扶樂乃鄕名，非縣名，賢考之不詳也。水經註：扶樂城在扶溝縣，砂水逕其北。","note_content_jianti_auto":"贤曰：扶乐，县名，属九真郡。余谓贤说误矣，九真郡未尝有扶乐县。隆初封亢父侯，以度田不实免，次年，封为扶乐鄕侯。则扶乐乃鄕名，非县名，贤考之不详也。水经注：扶乐城在扶沟县，砂水迳其北。","note_type":"hu_note","start_index":53,"tongjian_id":"948ae864-db0e-11ef-bf4f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"伏波將軍","official_note":"伏波將軍是漢代軍事職位，負責平定叛亂或征伐，此處馬援被任命為伏波將