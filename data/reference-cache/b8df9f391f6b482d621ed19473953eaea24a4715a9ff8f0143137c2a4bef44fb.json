dex":138,"text":"貰","tongjian_id":"6ce21788-9c1f-5d85-96a1-406bd601f1ea"}],"ExtRef_Children_places":[{"place_name":"懷縣","place_name_jianti_auto":"怀县","resolved_place_entity_id":889,"start_index":14,"tongjian_id":"9488b5c2-db0e-11ef-947b-a0d3651f611f"},{"place_name":"懷","place_name_jianti_auto":"怀","resolved_place_entity_id":889,"start_index":26,"tongjian_id":"9488b5c3-db0e-11ef-8311-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":45,"tongjian_id":"9488b5c5-db0e-11ef-a4a6-a0d3651f611f"},{"place_name":"懷","place_name_jianti_auto":"怀","resolved_place_entity_id":889,"start_index":89,"tongjian_id":"9488b5cc-db0e-11ef-90a8-a0d3651f611f"},{"place_name":"平原","place_name_jianti_auto":"平原","resolved_place_entity_id":403,"start_index":146,"tongjian_id":"9488b5d0-db0e-11ef-b3d5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，正月，趙孝公良薨。初，懷縣大姓李子春二孫殺人，懷令趙憙窮治其姦，二孫自殺，收繫子春。京師貴戚爲請者數十，憙終不聽。及良病，上臨視之，問所欲言，良曰：「素與李子春厚，今犯罪，懷令趙憙欲殺之，願乞其命。」帝曰：「吏奉法律，不可枉也。更道他所欲。」良無復言。旣薨，上追思良，乃貰出子春。遷憙爲平原太守。","content_fanyi":"春季，正月，赵孝公刘良去世。当初，怀县豪门大族李子春的两个孙子杀人，怀县令赵憙彻底追究他们的罪行，两个孙子自杀，李子春被收押入狱。在洛阳的皇亲国戚有数十人为李子春求情，赵憙始终没有答应。等到刘良病重时，光武帝亲自到病榻前探望，问他还想说些什么，刘良说：“我向来与李子春交情深厚，如今他犯了罪，怀县令赵憙要杀他，希望饶他一命。”光武帝说：“官吏奉行法律，法律不可歪曲。你另外说别的愿望吧。”刘良不再说话。刘良去世后，光武帝追念叔父刘良，便赦免释放了李子春。又提升赵憙为平原郡太守。","content_jianti_auto":"1春，正月，赵孝公良薨。初，怀县大姓李子春二孙杀人，怀令赵憙穷治其奸，二孙自杀，收系子春。京师贵戚为请者数十，憙终不听。及良病，上临视之，问所欲言，良曰：「素与李子春厚，今犯罪，怀令赵憙欲杀之，愿乞其命。」帝曰：「吏奉法律，不可枉也。更道他所欲。」良无复言。既薨，上追思良，乃贳出子春。迁憙为平原太守。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3367,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9487e2d2-db0e-11ef-b80c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_