_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9489abbb-db0e-11ef-9c57-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：左右，猶向背也；言其齊等。","note_content_jianti_auto":"贤曰：左右，犹向背也；言其齐等。","note_type":"hu_note","start_index":150,"tongjian_id":"9489abba-db0e-11ef-b10e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"中山國","place_name_jianti_auto":"中山国","start_index":4,"tongjian_id":"9489abbd-db0e-11ef-af0e-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":9,"tongjian_id":"9489abbe-db0e-11ef-9b69-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志：中山國，在雒陽北一千四百里。","note_content_jianti_auto":"郡国志：中山国，在雒阳北一千四百里。","note_type":"hu_note","start_index":173,"tongjian_id":"9489abbc-db0e-11ef-8ad1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"右翊公","official_note":"右翊公是漢代的封爵，屬於公爵等級，通常授予皇室成員或功臣，此處指郭后的兒子劉輔被封為右翊公，後晉升為中山王，反映了漢代封爵制度中的爵位變動。","official_rank":"公爵","source_snippet":"帝進郭后子右翊公輔爲中山王","start_index":124,"tongjian_id":"1bbcbe62-ba8d-45f6-bb94-8954e95bdf7f"},{"confidence":0.9,"official_category":"封爵","official_name":"中山王","official_note":"中山王是漢代的封爵，屬於王爵等級，通常授予皇室成員，此處指郭后的兒子劉輔從右翊公晉升為中山王，並增加常山郡以擴充中山國，顯示了漢代封國制度的運作。","official_rank":"王爵","source_snippet":"帝進郭后子右翊公輔爲中山王","start_index":130,"tongjian_id":"3663b5b6-6ae8-4b80-a448-af0a2d7d413e"},{"confidence":0.85,"official_category":"皇室稱號","official_name":"中山太后","official_note":"中山太后是漢代對已故或廢后皇后的尊稱，此處指郭后被廢后，被尊為中山太后，反映了漢代皇室稱號的變更和禮儀制度。","official_rank":"太后","source_snippet":"郭后爲中山太后","start_index":144,"tongjian_id":"7e45613c-3121-452c-84bb-fbb482d3ce76"}],"ExtRef_Chil