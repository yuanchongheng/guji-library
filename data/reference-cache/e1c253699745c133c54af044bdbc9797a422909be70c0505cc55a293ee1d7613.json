{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（戊寅、前二二三）","note_content_jianti_auto":"（戊寅、前二二三）","note_type":"hu_note","start_index":0,"tongjian_id":"8d6636b1-db0e-11ef-ab91-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":0,"tongjian_id":"8d6636b4-db0e-11ef-9590-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":7,"tongjian_id":"8d6636b5-db0e-11ef-a226-a0d3651f611f"},{"place_name":"楚郡","place_name_jianti_auto":"楚郡","start_index":13,"tongjian_id":"8d6636b6-db0e-11ef-b48a-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":19,"tongjian_id":"8d6636b7-db0e-11ef-9972-a0d3651f611f"},{"place_name":"九江","place_name_jianti_auto":"九江","start_index":29,"tongjian_id":"8d6636b8-db0e-11ef-866f-a0d3651f611f"},{"place_name":"鄣","place_name_jianti_auto":"鄣","place_note":"浙江安吉西北","start_index":32,"tongjian_id":"8d6636b9-db0e-11ef-8047-a0d3651f611f"},{"place_name":"會稽","place_name_jianti_auto":"会稽","place_note":"江苏苏州","start_index":34,"tongjian_id":"8d6636ba-db0e-11ef-b867-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楚至是亡矣。按秦三十六郡無楚郡，此蓋滅楚之時暫置耳；後分爲九江、鄣、會稽三郡。","note_content_jianti_auto":"楚至是亡矣。按秦三十六郡无楚郡，此盖灭楚之时暂置耳；后分为九江、鄣、会稽三郡。","note_type":"hu_note","start_index":19,"tongjian_id":"8d6636b3-db0e-11ef-9161-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","people_xingming":"王翦","start_index":1,"tongjian_id":"8d6636bb-db0e-11ef-b9c1-a0d3651f611f"},{"link_td_description":"蒙武，中国战国时期秦国名将。祖居齐国，父蒙骜、子蒙恬及蒙毅皆为秦名将。","link_td_id":"Q10008466","link_td_number_id":277661,"people_name":"蒙武","people_name_jianti_auto":"蒙武","people_xingming":"蒙武","start_index":4,"tongjian_id":"8d6636bc-db0e-11ef-934c-a0d3651f611f"},{"link_td_description":"楚王负刍，芈姓，熊氏，名负刍，楚考烈王之子，楚哀王之庶兄，一说楚顷襄王之子，楚考烈王之弟。楚哀王继位二月余，负刍门客杀哀王、太后李嫣和李园，立负刍为王。秦王政二十四年（前223年），秦再度出兵攻楚，虏负刍，平定楚国。负刍被废为庶人。","link_td_id":"Q10000654","link_td_number_id":335245,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈负刍","start_index":7,"tongjian_id":"8d6636bd-db0e-11ef-a360-a0d3651f611f"},{"link_td_description":"楚王负刍，芈姓，熊氏，名负刍，楚考烈王之子，楚哀王之庶兄，一说楚顷襄王之子，楚考烈王之弟。楚哀王继位二月余，负刍门客杀哀王、太后李嫣和李园，立负刍为王。秦王政二十四年（前223年），秦再度出兵攻楚，虏负刍，平定楚国。负刍被废为庶人。","link_td_id":"Q10000654","link_td_number_id":335245,"people_name":"負芻","people_name_jianti_auto":"负刍","people_xingming":"芈负刍","start_index":9,"tongjian_id":"8d6636be-db0e-11ef-a165-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"楚郡","place_name_jianti_auto":"楚郡","resolved_place_entity_id":3845,"start_index":16,"tongjian_id":"8d6636bf-db0e-11ef-a26a-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭楚之战","tongjian_id":"war_N0548"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/临敌易将","excerpts":[{"context_after":"，魏公子无忌易晋鄙而胜秦，将岂不可易乎？燕以骑劫易乐毅而...","context_before":"...事当审其是非，当易而不易，亦非也。秦以白起易王龁而胜赵，","source_end_index":50,"source_paragraph_tongjian_id":"da20ffe5-4b1d-4e20-ae3a-169032641b78","source_start_index":41,"source_text":"以王翦易李信而灭楚"}],"path":"随笔/卷十/临敌易将","source_name":"容斋随笔"}],"class_tags":["军事","内政"],"content":"1王翦、蒙武虜楚王負芻，以其地置楚郡。","content_fanyi":"秦将王翦、蒙武俘获了楚国国君熊负刍，将楚地设置为楚郡。","content_jianti_auto":"1王翦、蒙武虏楚王负刍，以其地置楚郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":538,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d6636b2-db0e-11ef-824a-a0d3651f611f"}],"reign_name":"二十四年","reign_name_jianti_auto":"二十四年","start_index":4,"tongjian_id":"8d6636b0-db0e-11ef-9a2f-a0d3651f611f","year_anno":"（戊寅、前二二三）","year_int":-223},"message":"success","success":true}