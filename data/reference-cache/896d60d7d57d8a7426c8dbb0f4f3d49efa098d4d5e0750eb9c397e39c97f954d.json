"note_content_jianti_auto":"汉志，桂阳郡有浈阳县。沈约志，宋泰始三年改浈为贞，属广兴公相。","note_type":"hu_note","start_index":173,"tongjian_id":"a9d98e08-db0e-11ef-975d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"沈文秀","people_name_jianti_auto":"沈文秀","start_index":59,"tongjian_id":"a9d98e14-db0e-11ef-9407-a0d3651f611f"},{"people_name":"崔道固","people_name_jianti_auto":"崔道固","start_index":63,"tongjian_id":"a9d98e15-db0e-11ef-a2da-a0d3651f611f"},{"people_name":"永","people_name_jianti_auto":"永","start_index":80,"tongjian_id":"a9d98e16-db0e-11ef-a56f-a0d3651f611f"},{"people_name":"攸之","people_name_jianti_auto":"攸之","start_index":82,"tongjian_id":"a9d98e17-db0e-11ef-b6b9-a0d3651f611f"},{"people_name":"文秀","people_name_jianti_auto":"文秀","start_index":96,"tongjian_id":"a9d98e18-db0e-11ef-99d1-a0d3651f611f"},{"people_name":"道固","people_name_jianti_auto":"道固","start_index":99,"tongjian_id":"a9d98e19-db0e-11ef-87df-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"淮","place_name_jianti_auto":"淮","start_index":0,"tongjian_id":"a9d98e1a-db0e-11ef-ae87-a0d3651f611f"},{"place_name":"青","place_name_jianti_auto":"青","start_index":5,"tongjian_id":"a9d98e1b-db0e-11ef-81a7-a0d3651f611f"},{"place_name":"冀","place_name_jianti_auto":"冀","start_index":7,"tongjian_id":"a9d98e1c-db0e-11ef-bf9d-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","start_index":9,"tongjian_id":"a9d98e1d-db0e-11ef-8aa4-a0d3651f611f"},{"place_name":"兗","place_name_jianti_auto":"兖","start_index":11,"tongjian_id":"a9d98e1e-db0e-11ef-867c-a0d3651f611f"},{"place_name":"豫州","place_name_jianti_auto":"豫州","start_index":13,"tongjian_id":"a9d98e1f-db0e-11ef-b2ea-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","start_index":15,"tongjian_id":"a9d98e20-db0e-11ef-884a-a0d3651f611f"},{"place_name":"汝南","place_name_jianti_auto":"汝南","start_index":18,"tongjian_id":"a9d98e21-db0e-11ef-89ac-a0d3651f611f"},{"place_name":"新蔡","