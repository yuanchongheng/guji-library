auto":"拊离","start_index":29,"tongjian_id":"91e7b34f-db0e-11ef-b815-a0d3651f611f"},{"people_name":"安日","people_name_jianti_auto":"安日","people_xingming":"安日","start_index":32,"tongjian_id":"91e7b350-db0e-11ef-ac45-a0d3651f611f"},{"people_name":"日貳","people_name_jianti_auto":"日贰","start_index":39,"tongjian_id":"91e7b351-db0e-11ef-9c94-a0d3651f611f"},{"people_name":"安日","people_name_jianti_auto":"安日","start_index":46,"tongjian_id":"91e7b354-db0e-11ef-9b37-a0d3651f611f"},{"people_name":"姑莫匿","people_name_jianti_auto":"姑莫匿","people_xingming":"姑莫匿","start_index":51,"tongjian_id":"91e7b355-db0e-11ef-b465-a0d3651f611f"},{"people_name":"日貳","people_name_jianti_auto":"日贰","start_index":60,"tongjian_id":"91e7b356-db0e-11ef-ad63-a0d3651f611f"},{"link_birth_year":-84,"link_death_year":-10,"link_td_description":"段会宗，字子松，西汉天水郡上邽（今甘肃省天水市）人，其在汉元帝和汉成帝时期，两度担任西域都护，并数次出使乌孙，弭平该国的多场内乱，稳定局势，于西域各邦国中威望甚高。元延三年段会宗去世，享年七十五岁。","link_td_id":"Q10013024","link_td_number_id":1549717,"people_name":"段會宗","people_name_jianti_auto":"段会宗","people_xingming":"段会宗","start_index":82,"tongjian_id":"91e7b357-db0e-11ef-8e1b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":1,"tongjian_id":"91e7b34d-db0e-11ef-a47f-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":24,"tongjian_id":"91e7b352-db0e-11ef-ab76-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","resolved_place_entity_id":771,"start_index":43,"tongjian_id":"91e7b353-db0e-11ef-99a8-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":69,"tongjian_id":"91e7b358-db0e-11ef-bed9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","人事"],"content":"6烏孫小昆彌烏就屠死，子拊離代立；爲弟日貳所殺。漢遣使者立拊離子安日爲小昆彌。日貳亡阻康居；安日使貴人姑莫匿等三人詐亡從日貳，刺殺之。於是西域諸國上書，願復得前都護段會宗；上從之。城郭諸國聞之，皆翕然親附。","content_fanyi":"乌孙的小昆弥乌就屠去世，他的儿子拊离继位；拊离被弟弟日贰杀害。汉朝派使者册立拊离的儿子安日为小昆弥。日贰逃亡到康居国，借以躲避安日的追杀；安日派贵族姑莫匿等三人假装逃亡投奔日贰，趁机刺杀了日贰。于是西域各国上书朝廷，请求再让前任都护段会宗返回西域；汉成帝批准了这一请求。西域各城郭国家听说后，都一致亲近归附汉朝。","content_jianti_auto":"6乌孙小昆弥乌就屠死，子拊离代立；为弟日贰所杀。汉遣使者立拊离子安日为小昆弥。日贰亡阻康居；安日使贵人姑莫匿等三人诈亡从日贰，刺杀之。于是西域诸国上书，愿复得前都护段会宗；上从之。城郭诸国闻之，皆翕然亲附。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2426,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"91e7b341-db0e-11ef-a42a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"监察","official_name":"御史大夫","official_note":"御史大夫是秦汉时期的高级官职，负责监察百官、弹劾不法，位列三公之一，此处谷永在奏言中提及以强调其职责重要性。","official_rank":"正三品","source_snippet":"御史大夫任重職大","start_index":18,"tongjian_id":"98cc21cb-11c4-4058-bd4e-72af4fa673de"},{"confidence":0.9,"official_category":"财政","official_name":"少府","official_note":"少府是秦汉时期的官职，掌管皇室财政和宫廷事务，此处谷永在奏言中提及以说明其从政能力，强调实际效果而非名誉。","official_rank":"正三品","source_snippet":"少府宣達於從政","start_index":28,"tongjian_id":"bd562dc1-c7cd-4a3c-ad36-2df29e7aa091"}],"ExtRef_Children_people":[{"link_death_year":-8,"link_td_description":"谷永，西汉大臣，字子云，原名并，长安人。","link_td_id":"Q10013197","link_td_number_id":1572704,"people_name":"谷永","people_name_jianti_auto":"谷永","people_xingming":"谷永","start_index":1,"tongjian_id":"91e7b35a-db0e-11ef-b7ad-a0d3651f611f"},{"link_td_description":"薛宣，字贛君，西汉东海郡郯城县（今山东省郯城县）人，出身小吏，通晓律令，举茂才后历任冤句县县令、长安令，治理地方声名远播。汉成帝年间屡迁御史中丞、临淮郡太守、陈留郡太守、左冯翊、少府、御史大夫等职，任官赏罚分明，恩威并施，颇有政绩。鸿嘉元年四月接替张禹为丞相，封高阳侯，食邑一千户。永始二年因邛成太后丧事办理不周被罢官，后经翟方进推荐重得起用，再封列侯，加官特进，娶汉宣帝之女敬武公主为妻。汉哀帝时期因受儿子薛况买凶伤人牵连被免为庶人，返回故乡东海郡，在家中去世。","link_td_id":"Q10012786","link_td_number_id":1505274,"people_name":"宣","people_name_jianti_auto":"宣","people_xingming":"薛宣","start_index":29,"tongjian_id":"91e7b35b-db0e-11ef-b37a-a0d3651f611f","wl_zhushi":"[薛宣]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉书多叙谷永","excerpts":[{"context_after":"。谏大夫刘辅系狱，永同中朝臣上书救之。光禄大夫郑宽中卒，...","context_before":"...漫摭永诸所论建，以渫予在原之思。薛宣为少府，御史大夫缺，","source_end_index":112,"source_paragraph_tongjian_id":"7161b8fc-ffb4-416b-b85e-2ea251e9feb4","source_start_index":105,"source_text":"永言宣简在两府"}],"path":"五笔/卷六/汉书多叙谷永","source_name":"容斋随笔"}],"class_tags":["人事"],"content":"7谷永奏言：「聖王不以名譽加於實效；御史大夫任重職大，少府宣達於從政，唯陛下留神考察！」上然之。","content_fanyi":"谷永上奏说：“圣明的君王不会让名誉凌驾于实际才能之上；御史大夫责任重大、职位重要，少府薛宣处理政务通达干练，希望陛下留心考察！”汉成帝同意了他的举荐。","content_jianti_auto":"7谷永奏言：「圣王不以名誉加于实效；御史大夫任重职大，少府宣达于从政，唯陛下留神考察！」上然之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2427,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"91e7b359-db0e-11ef-ae2f-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":1,"tongjian_id":"91e568e6-db0e-11ef-8075-a0d3651f611f","year_anno":"（庚子、前二一）","year_int":-21},"message":"success","success":true}