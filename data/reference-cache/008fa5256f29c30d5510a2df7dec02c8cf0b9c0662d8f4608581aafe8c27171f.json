d":3787026,"people_name":"吉","people_name_jianti_auto":"吉","people_xingming":"王吉","start_index":12,"tongjian_id":"91e7b333-db0e-11ef-9096-a0d3651f611f"},{"link_death_year":-65,"link_td_description":"赵广汉，字子都，西汉涿郡蠡吾县（今河北省博野县西南）人，早年为郡吏，后历任州从事、平准令、阳翟县县令、京辅都尉等职。因参与拥立汉宣帝的议决，赐爵关内侯，升迁颖川郡太守、京兆尹，为人精明干练，严于吏治，深受京师百姓爱戴。地节三年因诬告丞相魏相之妻杀人，被司直萧望之弹劾，经廷尉审讯后遭腰斩而死。","link_td_id":"Q10015501","link_td_number_id":3505976,"people_name":"趙廣漢","people_name_jianti_auto":"赵广汉","people_xingming":"赵广汉","start_index":23,"tongjian_id":"91e7b334-db0e-11ef-a081-a0d3651f611f"},{"link_death_year":-48,"link_td_description":"张敞，字子高，茂陵县（今陕西省兴平市）人，西汉政治人物，汉宣帝时期，其迁居杜陵县（今陕西省西安市东南）。张敞因曾上书劝谏昌邑王刘贺而在刘贺被废后被破格提拔为豫州刺史，其后历任函谷关都尉、山阳郡太守、胶东国国相、京兆尹、冀州刺史等职，任内政绩突出，以善于治盗而闻名，最终张敞于太原郡太守任上去世。","link_td_id":"Q10004484","link_td_number_id":316858,"people_name":"張敞","people_name_jianti_auto":"张敞","people_xingming":"张敞","start_index":27,"tongjian_id":"91e7b335-db0e-11ef-be31-a0d3651f611f"},{"link_td_description":"王尊，字子赣，西汉涿郡高阳县（今河北省高阳县）人。","link_td_id":"Q10007791","link_td_number_id":1540889,"people_name":"王尊","people_name_jianti_auto":"王尊","people_xingming":"王尊","start_index":30,"tongjian_id":"91e7b336-db0e-11ef-ba93-a0d3651f611f"},{"link_birth_year":-99,"link_death_year":-24,"link_td_description":"王章，字仲卿，西汉泰山郡钜平县（今山东省泰安市南）人。王章早年求学于长安，一度身患重病躺在牛衣中对着妻子哭泣，此后其进入朝中为官，逐步升迁至京兆尹。汉成帝年间，王章因直言进谏，得罪了当时大权在握的大将军王凤，遭其陷害下狱而死。","link_td_id":"Q10005633","link_td_number_id":1539583,"people_name":"王章","people_name_jianti_auto":"王章","people_xingming":"王章","start_index":33,"tongjian_id":"91e7b337-db0e-11ef-94e0-a0d3651f611f"},{"link_death_year":16,"link_td_description":"王骏，字君公，京兆长安人，西汉时代末期、新朝武将。","link_td_id":"Q10007727","link_td_number_id":3817652,"people_name":"駿","people_name_jianti_auto":"骏","people_xingming":"王骏","start_index":37,"tongjian_id":"91e7b338-db0e-11ef-b98f-a0d3651f611f"},{"link_death_year":-65,"link_td_description":"赵广汉，字子都，西汉涿郡蠡吾县（今河北省博野县西南）人，早年为郡吏，后历任州从事、平准令、阳翟县县令、京辅都尉等职。因参与拥立汉宣帝的议决，赐爵关内侯，升迁颖川郡太守、京兆尹，为人精明干练，严于吏治，深受京师百姓爱戴。地节三年因诬告丞相魏相之妻杀人，被司直萧望之弹劾，经廷尉审讯后遭腰斩而死。","link_td_id":"Q10015501","link_td_number_id":3505976,"people_name":"趙","people_name_jianti_auto":"赵","people_xingming":"赵广汉","start_index":53,"tongjian_id":"91e7b339-db0e-11ef-9220-a0d3651f611f"},{"link_death_year":-48,"link_td_description":"张敞，字子高，茂陵县（今陕西省兴平市）人，西汉政治人物，汉宣帝时期，其迁居杜陵县（今陕西省西安市东南）。张敞因曾上书劝谏昌邑王刘贺而在刘贺被废后被破格提拔为豫州刺史，其后历任函谷关都尉、山阳郡太守、胶东国国相、京兆尹、冀州刺史等职，任内政绩突出，以善于治盗而闻名，最终张敞于太原郡太守任上去世。","link_td_id":"Q10004484","link_td_number_id":316858,"people_name":"張","people_name_jianti_auto":"张","people_xingming":"张敞","start_index":55,"tongjian_id":"91e7b33a-db0e-11ef-a03f-a0d3651f611f"},{"people_name":"王","people_name_jianti_auto":"王","start_index":60,"tongjian_id":"91e7b33b-db0e-11ef-abd2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":6,"tongjian_id":"91e7b33c-db0e-11ef-84f7-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":20,"tongjian_id":"91e7b33d-db0e-11ef-85a2-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":43,"start_index":45,"tongjian_id":"91e7b33e-db0e-11ef-94cb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4少府王駿爲京兆尹。駿，吉之子也。先是，京兆有趙廣漢、張敞、王尊、王章，至駿，皆有能名，故京師稱曰：「前有趙、張，後有三王。」","content_fanyi":"任命少府王骏为京兆尹。王骏是王吉的儿子。此前，赵广汉、张敞、王尊、王章先后出任京兆尹，到王骏时，都以才干闻名，所以京城中传颂说：“前有赵、张，后有三王。”","content_jianti_auto":"4少府王骏为京兆尹。骏，吉之子也。先是，京兆有赵广汉、张敞、王尊、王章，至骏，皆有能名，故京师称曰：「前有赵、张，后有三王。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":2424,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"91e7b329-db0e-11ef-bfa4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[