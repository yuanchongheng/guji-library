":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：大鴻臚奏主歸國，小黃門受詔者。臚，陵如翻。","note_content_jianti_auto":"贤曰：大鸿胪奏主归国，小黄门受诏者。胪，陵如翻。","note_type":"hu_note","start_index":87,"tongjian_id":"9546303d-db0e-11ef-bda6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"祖道供張以送之。","note_content_jianti_auto":"祖道供张以送之。","note_type":"hu_note","start_index":106,"tongjian_id":"9546303f-db0e-11ef-b2a7-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大鴻臚","official_note":"大鴻臚是漢代九卿之一，掌管諸侯王、少數民族事務及朝會禮儀，此處指皇帝想讓大鴻臚上奏處理東平王歸國事宜，顯示其職能涉及諸侯王事務。","official_rank":"九卿之一，秩中二千石","source_snippet":"欲署大鴻臚奏","start_index":58,"tongjian_id":"f34ee671-01d1-45ce-8cf0-f2d96f26bf83"},{"confidence":0.85,"official_category":"宫廷内侍","official_name":"小黃門","official_note":"小黃門是漢代宦官職位，負責宮廷內侍和傳達詔令，此處皇帝因不忍親自下筆，轉而授權小黃門處理，體現其近侍角色。","official_rank":"低級宦官，秩六百石","source_snippet":"顧授小黃門","start_index":68,"tongjian_id":"a427288d-9d21-4c10-baee-f531275a5e77"}],"ExtRef_Children_people":[{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"東平王","people_name_jianti_auto":"东平王","people_xingming":"刘苍","start_index":15,"tongjian_id":"95463041-db0e-11ef-a7e7-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","start_index":18,"tongjian_id":"95463042-db0e-11ef-a6d7-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":30,"tongjian_id":"95463043-db0e-11ef-b056-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95463039-db0e-11ef-93a6-a0d3651f611f","pinyin":"zhòu","source_anchor_text":"秋八月飲酎畢有司復","source_key":"baiyang_epub","start_index":7,"text":"酎","tongjian_id":"35b32b21-fbbe-571a-bd57-53f5ece59ca3"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"4秋，八月，飲酎畢，有司復奏遣東平王蒼歸國，帝乃許之，手詔賜蒼曰：「骨肉天性，誠不以遠近爲親疏；然數見顏色，情重昔時。念王久勞，思得還休，欲署大鴻臚奏，不忍下筆，顧授小黃門；中心戀戀，惻然不能言。」於是車駕祖送，流涕而訣；復賜乘輿服御、珍寶、輿馬，錢布以億萬計。","content_fanyi":"秋季，八月，酎祭高庙的宴会结束之后，主管官员再次奏请让东平王刘苍返回封国，章帝这才批准，亲手下诏赐给刘苍说：“骨肉亲情出于天性，确实不因距离远近而分出亲疏；然而多次见面，感情比过去更深。想到你长久辛劳，希望你能回去休养，我本想在大鸿胪的奏章上签批，却不忍下笔，便另外写下这封信，派贴身的小黄门送去；心中恋恋不舍，悲伤得说不出话来。”于是章帝亲自为他祖道饯行，流泪而别；又赐给刘苍皇帝使用的车舆、衣服器物、珍宝、车马，钱布以亿万计。","content_jianti_auto":"4秋，八月，饮酎毕，有司复奏遣东平王苍归国，帝乃许之，手诏赐苍曰：「骨肉天性，诚不以远近为亲疏；然数见颜色，情重昔时。念王久劳，思得还休，欲署大鸿胪奏，不忍下笔，顾授小黄门；中心恋恋，恻然不能言。」于是车驾祖送，流涕而诀；复赐乘舆服御、珍宝、舆马，钱布以亿万计。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3695,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"95463039-db0e-11ef-93a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"偃師縣","place_name_jianti_auto":"偃师县","start_index":0,"tongjian_id":"95463046-db0e-11ef-bea1-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":5,"tongjian_id":"95463047-db0e-11ef-9826-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"偃師縣，屬河南郡。","note_content_jianti_auto":"偃师县，属河南郡。","note_type":"hu_note","start_index":12,"tongjian_id":"95463045-db0e-11ef-96dd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"卷縣","place_name_jianti_auto":"卷县","start_index":0,"tongjian_id":"95463049-db0e-11ef-b3d4-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":4,"tongjian_id":"9546304a-db0e-11ef-8542-a0d3651f611f"},{"place_name":"河津","place_name_jianti_auto":"河津","start_index":11,"tongjian_id":"9546304b-db0e-11ef-be86-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卷縣，屬河南郡，其北卽河津。卷，丘權翻。","note_content_jianti_auto":"卷县，属河南郡，其北即河津。卷，丘权翻。","note_type":"hu_note","start_index":17,"tongjian_id":"95463048-db0e-11ef-9b05-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95463050-db0e-11ef-9ff6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：刺探，謂候伺也。刺，七亦翻。探，音湯勘翻。","note_content_jianti_auto":"贤曰：刺探，谓候伺也。刺，七亦翻。探，音汤勘翻。","note_type":"hu_note","start_index":74,"tongjian_id":"9546304f-db0e-11ef-9f5e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95463052-db0e-11ef-a607-a0d3651f611f"},{"people_name":"晏子","people_name_jianti_auto":"晏子","start_index":3,"tongjian_id":"95463053-db0e-11ef-8e36-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":14,"tongjian_id":"95463054-db0e-11ef-94d0-a0d3651f611f"},{"people_name":"顏回","people_name_jianti_auto":"颜回","start_index":18,"tongjian_id":"95463055-db0e-11ef-9c6d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":6,"tongjian_id":"95463056-db0e-11ef-85a0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：晏子相齊，食脫粟之飯。孔子曰：顏回一瓢飲。","note_content_jianti_auto":"贤曰：晏子相齐，食脱粟之饭。孔子曰：颜回一瓢饮。","note_type":"hu_note","start_index":100,"tongjian_id":"95463051-db0e-11ef-933a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95463044-db0e-11ef-8683-a0d3651f611f","pinyin":"sù","source_anchor_text":"患不能脫粟瓢飲耳己","source_key":"baiyang_epub","start_index":94,"text":"粟","tongjian_id":"a72c030e-0160-56fc-8805-2d9e7ef207a5"}],"ExtRef_Children_places":[{"place_name":"偃師","place_name_jianti_auto":"偃师","resolved_place_entity_id":1433,"start_index":9,"tongjian_id":"95463057-db0e-11ef-a2df-a0d3651f611f"},{"place_name":"卷津","place_name_jianti_auto":"卷津","resolved_place_entity_id":6142,"start_index":14,"tongjian_id":"95463058-db0e-11ef-9637-a0d3651f611f"},{"place_name":"河內","place_name_jianti_auto":"河内","resolved_place_entity_id":278,"start_index":18,"tongjian_id":"95463059-db0e-11ef-ae12-a0d3651f611f"},{"place_name":"鄴","place_name_jianti_auto":"邺","resolved_place_entity_id":101,"start_index":105,"tongjian_id":"9546305a-db0e-11ef-b505-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"晋卷县属荥阳郡。后魏因之。北齐废。《水经注》：河水经卷县...","context_before":"...魏卷，取之。又始皇二年，麃公将卒攻卷。汉置县，属河南郡。","source_end_index":81,"source_paragraph_tongjian_id":"1cdb6c89-fb3e-5759-a598-62ebb8d552d1","source_start_index":66,"source_text":"建初二年，帝幸偃师，东涉卷津。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"5九月，甲戌，帝幸偃師，東涉卷津，至河內，下詔曰：「車駕行秋稼，觀收穫，因涉郡界，皆精騎輕行，無他輜重。不得輒脩道橋，遠離城郭，遣吏逢迎，刺探起居，出入前後，以爲煩擾。動務省約，但患不能脫粟瓢飲耳。」己酉，進幸鄴；辛卯，還宮。","content_fanyi":"九月初十日甲戌，汉章帝巡幸偃师县，向东渡过卷县境内的卷津，到达河内，下诏说：“朕巡视秋季庄稼，察看收获情况，趁便进入河内郡境内；随行都是精壮骑兵，轻装行进，没有其他笨重辎重。不得随意修筑道路桥梁，也不得让官吏远离城郭前来迎接、打探起居，在车驾前后出入跟随，造成烦扰。凡事务必节省简约，只担心不能吃上粗米饭、用瓢喝水罢了。”九月己酉日（疑误），汉章帝继续巡行至邺县；九月二十七日辛卯，返回宫中。","content_jianti_auto":"5九月，甲戌，帝幸偃师，东涉卷津，至河内，下诏曰：「车驾行秋稼，观收获，因涉郡界，皆精骑轻行，无他辎重。不得辄修道桥，远离城郭，遣吏逢迎，刺探起居，出入前后，以为烦扰。动务省约，但患不能脱粟瓢饮耳。」己酉，进幸邺；辛卯，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3696,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"95463044-db0e-11ef-8683-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":8,"tongjian_id":"9546305d-db0e-11ef-8a2c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"槐里縣","place_name_jianti_auto":"槐里县","start_index":0,"tongjian_id":"9546305e-db0e-11ef-94d0-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":5,"tongjian_id":"9546305f-db0e-11ef-9161-a0d3651f611f"},{"place_name":"槐里","place_name_jianti_auto":"槐里","start_index":12,"tongjian_id":"95463060-db0e-11ef-9eca-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":15,"tongjian_id":"95463061-db0e-11ef-9a9a-a0d3651f611f"},{"place_name":"犬丘","place_name_jianti_auto":"犬丘","start_index":17,"tongjian_id":"95463062-db0e-11ef-a3a2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":20,"tongjian_id":"95463063-db0e-11ef-b998-a0d3651f611f"},{"place_name":"廢丘","place_name_jianti_auto":"废丘","start_index":22,"tongjian_id":"95463064-db0e-11ef-879e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":25,"tongjian_id":"95463065-db0e-11ef-9129-a0d3651f611f"},{"place_name":"槐里","place_name_jianti_auto":"槐里","start_index":28,"tongjian_id":"95463066-db0e-11ef-b9d3-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":31,"tongjian_id":"95463067-db0e-11ef-8621-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":35,"tongjian_id":"95463068-db0e-11ef-ac7b-a0d3651f611f"},{"place_name":"美陽縣","place_name_jianti_auto":"美阳县","start_index":37,"tongjian_id":"95463069-db0e-11ef-8ac7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"槐里縣，屬扶風。杜佑曰：槐里，周曰犬丘，秦曰廢丘，漢改曰槐里。岐山，在扶風美陽縣。","note_content_jianti_auto":"槐里县，属扶风。杜佑曰：槐里，周曰犬丘，秦曰废丘，汉改曰槐里。岐山，在扶风美阳县。","note_type":"hu_note","start_index":33,"tongjian_id":"9546305c-db0e-11ef-b975-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-257,"link_death_year":-193,"link_td_description":"萧何，沛县（今中国江苏省沛县）人。是汉朝初年丞相、政治家。封爵酇侯，谥号文终，汉初三杰之一。辅助汉高祖刘邦建立汉政权。","link_td_id":"Q10000053","link_td_number_id":93952,"people_name":"蕭何","people_name_jianti_auto":"萧何","people_xingming":"萧何","start_index":16,"tongjian_id":"9546306a-db0e-11ef-894f-a0d3651f611f"},{"people_name":"熊","people_name_jianti_auto":"熊","people_xingming":"萧熊","start_index":20,"tongjian_id":"9546306b-db0e-11ef-a2fd-a0d3651f611f"},{"people_name":"酇侯","people_name_jianti_auto":"酂侯","people_xingming":"萧熊","start_index":22,"tongjian_id":"9546306c-db0e-11ef-93f6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":12,"tongjian_id":"9546306d-db0e-11ef-8eba-a0d3651f611f"},{"place_name":"槐里","place_name_jianti_auto":"槐里","resolved_place_entity_id":1508,"start_index":27,"tongjian_id":"9546306e-db0e-11ef-8317-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","resolved_place_entity_id":592,"start_index":30,"tongjian_id":"9546306f-db0e-11ef-8386-a0d3651f611f"},{"place_name":"長平","place_name_jianti_auto":"长平","resolved_place_entity_id":1851,"start_index":35,"tongjian_id":"95463070-db0e-11ef-94a4-a0d3651f611f"},{"place_name":"池陽宮","place_name_jianti_auto":"池阳宫","resolved_place_entity_id":4847,"start_index":39,"tongjian_id":"95463071-db0e-11ef-957a-a0d3651f611f"},{"place_name":"高陵","place_name_jianti_auto":"高陵","resolved_place_entity_id":1674,"start_index":45,"tongjian_id":"95463072-db0e-11ef-9e18-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/资治通鉴","excerpts":[{"context_after":"；又乙未幸东阿，北登太行山，至天井关，夏四月乙卯还宫。又...","context_before":"...昌宣王和其奴卒，皆无关于社稷治乱。而周勃薨，乃不书。及书","source_end_index":576,"source_paragraph_tongjian_id":"bed14566-6877-48d4-869c-49a53aaa7eeb","source_start_index":538,"source_text":"汉章帝行幸长安，进幸槐里、岐山，又幸长平，御池阳宫，东至高陵，十二月丁亥还宫"}],"path":"续笔/卷四/资治通鉴","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"]。","context_before":"...长安，宿长平阪。上自甘泉宿池阳宫，登长平阪，诏单于毋谒。","source_end_index":93,"source_paragraph_tongjian_id":"00313ef0-0d21-5276-bd66-1161099381a5","source_start_index":63,"source_text":"后汉建初七年，幸长平，御池阳宫，东至高陵，造舟于泾而还，是也"},{"context_after":"晋初为始平郡治。建兴四年，南阳王保镇上邽，遣其将胡崧救长...","context_before":"...丘。汉王引水灌之，废丘降，章邯自杀。汉三年，始置槐里县。","source_end_index":122,"source_paragraph_tongjian_id":"3b47a8b7-06d0-5cc3-8870-dbc2a2d09629","source_start_index":111,"source_text":"后汉建初七年，幸槐里。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、凤翔府（卷五十五）","excerpts":[{"context_after":"西魏大统十三年，宇文泰从魏主狩于岐阳。魏主廓三年，以岐阳...","context_before":"...王三年，三川竭，岐山崩。《吕氏春秋》：岐山，九山之一也。","source_end_index":145,"source_paragraph_tongjian_id":"331a9223-9183-5dc1-8d15-f3af54cb72fe","source_start_index":134,"source_text":"后汉建初七年，幸岐山。"}],"path":"陕西方舆纪要/三、凤翔府（卷五十五）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"6冬，十月，癸丑，帝行幸長安，封蕭何末孫熊爲酇侯。進幸槐里、岐山；又幸長平，御池陽宮，東至高陵；十二月，丁亥，還宮。","content_fanyi":"冬季，十月十九日癸丑，汉章帝出巡长安，封萧何的末代孙萧熊为酇侯。继而巡行槐里、岐山；又巡行长平，入住池阳宫，东行到达高陵县；十二月丁亥日（疑误），返回宫中。","content_jianti_auto":"6冬，十月，癸丑，帝行幸长安，封萧何末孙熊为酂侯。进幸槐里、岐山；又幸长平，御池阳宫，东至高陵；十二月，丁亥，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3697,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"9546305b-db0e-11ef-863c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范","people_name_jianti_auto":"范","start_index":4,"tongjian_id":"95463075-db0e-11ef-a91c-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":13,"tongjian_id":"95463076-db0e-11ef-bfd4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：范書作「憲」，今從袁紀。","note_content_jianti_auto":"考异曰：范书作「宪」，今从袁纪。","note_type":"hu_note","start_index":9,"tongjian_id":"95463074-db0e-11ef-81c7-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷内侍","official_name":"小黃門","official_note":"小黃門是漢代宦官官職，負責宮廷內務和侍奉皇帝，此處在原文中表示派遣小黃門侍奉東平獻王蒼的疾病，體現了皇帝對其的關懷。","official_rank":"未知","source_snippet":"小黃門侍疾","start_index":15,"tongjian_id":"a85e9bdd-3c6d-47d3-98cd-6d9cc6129252"}],"ExtRef_Children_people":[{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"東平獻王","people_name_jianti_auto":"东平献王","people_xingming":"刘苍","start_index":1,"tongjian_id":"9546307b-db0e-11ef-afd1-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":5,"tongjian_id":"9546307c-db0e-11ef-af5a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"7東平獻王蒼疾病，馳遣名醫、小黃門侍疾，使者冠蓋不絕於道。又置驛馬，千里傳問起居。","content_fanyi":"东平献王刘苍患病，汉章帝紧急派遣名医、小黄门前去诊治侍候，使者的车马冠盖在道路上往来不绝。又设置驿马，千里传问刘苍的起居。","content_jianti_auto":"7东平献王苍疾病，驰遣名医、小黄门侍疾，使者冠盖不绝于道。又置驿马，千里传问起居。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3698,"number":7,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"95463073-db0e-11ef-9ab8-a0d3651f611f"}],"reign_name":"七年","reign_name_jianti_auto":"七年","start_index":6,"tongjian_id":"9543dfc6-db0e-11ef-9848-a0d3651f611f","year_anno":"（壬午、八二）","year_int":82},"message":"success","success":true}