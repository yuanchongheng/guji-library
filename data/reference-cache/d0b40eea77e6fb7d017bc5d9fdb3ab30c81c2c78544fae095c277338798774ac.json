fe4-db0e-11ef-8b1c-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"東平王","people_name_jianti_auto":"东平王","people_xingming":"刘苍","start_index":131,"tongjian_id":"9543dfe5-db0e-11ef-a15b-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":134,"tongjian_id":"9543dfe6-db0e-11ef-a8dd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":136,"tongjian_id":"9543dfe7-db0e-11ef-a611-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，沛王輔、濟南王康、東平王蒼、中山王焉、東海王政、琅邪王宇來朝。詔沛、濟南、東平、中山王贊拜不名；升殿乃拜，上親答之，所以寵光榮顯，加於前古。每入宮，輒以輦迎，至省閣乃下，上爲之興席改容，皇后親拜於內；皆鞠躬辭謝不自安。三月，大鴻臚奏遣諸王歸國，帝特留東平王蒼於京師。","content_fanyi":"春季，正月，沛王刘辅、济南王刘康、东平王刘苍、中山王刘焉、东海王刘政、琅邪王刘宇一同前来朝见汉章帝。汉章帝下诏，司仪谒者在引荐沛王、济南王、东平王、中山王时只称王而不称名；他们登上殿堂后才行拜礼，汉章帝亲自答礼，以此使恩宠荣耀超过前代。刘辅等人每逢入宫，总是以皇帝、皇后专用的辇车迎接，抵达禁中阁门才下车步行，见面时汉章帝起身离席、神色恭敬，皇后则在帘内以侄媳晚辈之礼向诸叔父亲王行拜礼；诸王都鞠躬行礼辞谢，惶恐不安。三月，大鸿胪奏请遣送诸王返回封国，汉章帝特地将东平王刘苍留在京师。","content_jianti_auto":"1春，正月，沛王辅、济南王康、东平王苍、中山王焉、东海王政、琅邪王宇来朝。诏沛、济南、东平、中山王赞拜不名；升殿乃拜，上亲答之，所以宠光荣显，加于前古。每入宫，辄以辇迎，至省阁乃下，上为之兴席改容，皇后亲拜于内；皆鞠躬辞谢不自安。三月，大鸿胪奏遣诸王归国，帝特留东平王苍于京师。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3692,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9543dfc8-db0e-11ef-8bc7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9543dfeb-db0e-11ef-9092-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：偵，候也；音丑政翻。廣雅曰：偵，問也。伺，相吏翻。","note_content_jianti_auto":"贤曰：侦，候也；音丑政翻。广雅曰：侦，问也。伺，相吏翻。","note_type":"hu_note","start_index":109,"tongjian_id":"9543dfea-db0e-11ef-b7b6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"兔，獸名。口有缺，尻有九孔，舐毫而孕，生子從口出。霜前獵取而食之，其味甚美。","note_content_jianti_auto":"兔，兽名。口有缺，尻有九孔，舐毫而孕，生子从口出。霜前猎取而食之，其味甚美。","note_type":"hu_note","start_index":118,"tongjian_id":"9543dfed-db0e-11ef-a4ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"續漢志：中藏府有承祿署。","note_content_jianti_auto":"续汉志：中藏府有承禄署。","note_type":"hu_note","start_index":143,"tongjian_id":"9543dfef-db0e-11ef-9262-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋左氏傳之言。","note_content_jianti_auto":"春秋左氏传之言。","note_type":"hu_note","start_index":178,"tongjian_id":"9543dff1-db0e-11ef-a9d6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"袵，衣襟，亦臥席也。","note_content_jianti_auto":"袵，衣襟，亦卧席也。","note_type":"hu_note","start_index":205,"tongjian_id":"9543dff3-db0e-11ef-9a9c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"南宮","place_name_jianti_auto":"南宫","start_index":20,"tongjian_id":"9543dff5-db0e-11ef-8b12-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"丙舍，宮中之室，以甲乙丙爲次也。續漢志：南宮有丙署。","note_content_jianti_auto":"丙舍，宫中之室，以甲乙丙为次也。续汉志：南宫有丙署。","note_type":"hu_note","start_index":225,"tongjian_id":"9543dff4-db0e-11ef-aaa0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"議郞","official_note":"議郞是漢代官職，屬光祿勳，負責顧問應對，無固定職掌，常參與朝議。在原文中，宋楊因女兒宋貴人事件被免去議郞職務，返回本郡，這反映了漢代外戚政治中官職與家族命運的關聯。","official_rank":"未知","source_snippet":"父議郞楊免歸本郡","start_index":280,"tongjian_id":"59fb9f4b-3a85-4452-8612-90145165b7f3"}],"ExtRef_Children_people":[{"link_birth_year":40,"link_death_year":79,"link_td_description":"明德皇后，伏波将军马援小女，母蔺氏，名不详，汉明帝刘庄的皇后，撰《显宗起居注》。","link_td_id":"Q10001122","link_td_number_id":501420,"people_name":"明德太后","people_name_jianti_auto":"明德太后","people_xingming":"马太后","start_index":3,"tongjian_id":"9543dff7-db0e-11ef-ad0d-a0d3651f611f","wl_zhushi":"[马太后]"},{"people_name":"宋楊","people_name_jianti_auto":"宋杨","people_xingming":"宋楊","start_index":12,"tongjian_id":"9543dff8-db0e-11ef-9831-a0d3651f611f"},{"link_birth_year":78,"link_death_year":107,"link_td_description":"刘庆，汉章帝的太子，母宋贵人，后废为清河王，谥号曰孝王。","link_td_id":"Q10003853","link_td_number_id":418321,"people_name":"慶","people_name_jianti_auto":"庆","start_index":26,"tongjian_id":"9543dff9-db0e-11ef-9273-a0d3651f611f"},{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"梁松","people_name_jianti_auto":"梁松","people_xingming":"梁松","start_index":28,"tongjian_id":"9543dffa-db0e-11ef-baac-a0d3651f611f"},{"link_death_year":83,"link_td_description":"梁竦，字叔敬，东汉文学家、易学家、思想家。梁统次子，兄长梁松是光武帝刘秀的女婿。","link_td_id":"Q10007600","link_td_number_id":942582,"people_name":"竦","people_name_jianti_auto":"竦","people_xingming":"梁竦","start_index":31,"tongjian_id":"9543dffb-db0e-11ef-9360-a0d3651f611f"},{"link_birth_year":79,"link_death_year":106,"link_td_description":"汉和帝刘肇，东汉皇帝（88年4月9日－106年2月13日在位），在位17年，得年仅27岁，其正式谥号为「孝和皇帝」，后世省略「孝」字称「汉和帝」，他是汉明帝孙，章帝第四子，母贵人梁氏，死后庙号穆宗（后于汉献帝初平元年除去庙号），葬于慎陵。由于年幼即位，权力被外戚所挟制，及长后利用宦官权力扫除外戚威胁得以亲政。这开始了东汉戚宦相争的恶性循环。但和帝本人亲政后励精图治，四海升平，是东汉明章二帝后获评价最高的皇帝。","link_td_id":"Q10000183","link_td_number_id":103198,"people_name":"肇","people_name_jianti_auto":"肇","start_index":47,"tongjian_id":"9543dffc-db0e-11ef-8af2-a0d3651f611f"},{"people_name":"竇皇后","people_name_jianti_auto":"窦皇后","people_xingming":"竇皇后","start_index":49,"tongjian_id":"9543dffd-db0e-11ef-b315-a0d3651f611f"},{"link_birth_year":79,"link_death_year":106,"link_td_description":"汉和帝刘肇，东汉皇帝（88年4月9日－106年2月13日在位），在位17年，得年仅27岁，其正式谥号为「孝和皇帝」，后世省略「孝」字称「汉和帝」，他是汉明帝孙，章帝第四子，母贵人梁氏，死后庙号穆宗（后于汉献帝初平元年除去庙号），葬于慎陵。由于年幼即位，权力被外戚所挟制，及长后利用宦官权力扫除外戚威胁得以亲政。这开始了东汉戚宦相争的恶性循环。但和帝本人亲政后励精图治，四海升平，是东汉明章二帝后获评价最高的皇帝。","link_td_id":"Q10000183","link_td_number_id":103198,"people_name":"肇","people_name_jianti_auto":"肇","start_index":56,"tongjian_id":"9543dffe-db0e-11ef-92b9-a0d3651f611f"},{"link_death_year":82,"link_td_description":"宋贵人，名不详，右扶风平陵县（今陕西省咸阳市秦都区）人为汉章帝贵人、废太子刘庆生母、汉安帝祖母。","link_td_id":"Q10007720","link_td_number_id":1266850,"people_name":"宋貴人","people_name_jianti_auto":"宋贵人","start_index":60,"tongjian_id":"9543dfff-db0e-11ef-8cb9-a0d3651f611f"},{"link_birth_year":40,"link_death_year":79,"link_td_description":"明德皇后，伏波将军马援小女，母蔺氏，名不详，汉明帝刘庄的皇后，撰《显宗起居注》。","link_td_id":"Q10001122","link_td_number_id":501420,"people_name":"馬太后","people_name_jianti_auto":"马太后","people_xingming":"马太后","start_index":66,"tongjian_id":"9543e000-db0e-11ef-b86e-a0d3651f611f"},{"people_name":"竇皇后","people_name_jianti_auto":"窦皇后","start_index":74,"tongjian_id":"9543e001-db0e-11ef-9451-a0d3651f611f"},{"link_td_description":"沘阳公主，东汉前期的公主。其生父东海王刘彊。嫁给了窦勋，大司空安丰侯窦融的孙子、窦穆的儿子。","link_