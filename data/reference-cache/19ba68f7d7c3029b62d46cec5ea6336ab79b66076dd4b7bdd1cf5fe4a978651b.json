{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（癸未、一四三）","note_content_jianti_auto":"（癸未、一四三）","note_type":"hu_note","start_index":0,"tongjian_id":"96abbf3a-db0e-11ef-942d-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范","people_name_jianti_auto":"范","start_index":11,"tongjian_id":"96abbf3d-db0e-11ef-942e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燒當","place_name_jianti_auto":"烧当","start_index":16,"tongjian_id":"96abbf3e-db0e-11ef-9ca4-a0d3651f611f"},{"place_name":"燒何","place_name_jianti_auto":"烧何","start_index":19,"tongjian_id":"96abbf3f-db0e-11ef-b4f3-a0d3651f611f"},{"place_name":"羌","place_name_jianti_auto":"羌","start_index":22,"tongjian_id":"96abbf40-db0e-11ef-b4d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「當」當作「何」，此承范紀之誤。燒當、燒何，羌兩種也。","note_content_jianti_auto":"「当」当作「何」，此承范纪之误。烧当、烧何，羌两种也。","note_type":"hu_note","start_index":33,"tongjian_id":"96abbf3c-db0e-11ef-b464-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"護羌校尉","official_note":"護羌校尉是汉代负责管理羌族事务的军事官职，常驻边地，负责防御和安抚羌人。在《资治通鉴》此段中，趙沖担任此职，与漢陽太守张贡共同出击烧当羌，体现了其在军事行动中的指挥角色。","official_rank":"未知","source_snippet":"護羌校尉趙沖","start_index":12,"tongjian_id":"9414c947-76d2-42bc-bbd5-3ad77705b01a"},{"confidence":0.95,"official_category":"地方行政","official_name":"漢陽太守","official_note":"漢陽太守是汉代地方行政官职，负责漢陽郡的治理，包括民政、军事等事务。在此段中，张贡作为漢陽太守，与護羌校尉趙沖合作攻击烧当羌，显示了地方行政官员在边疆军事行动中的参与。","official_rank":"未知","source_snippet":"漢陽太守張貢","start_index":18,"tongjian_id":"e679f0f9-9438-4e5d-8ac6-0dfa62681f50"}],"ExtRef_Children_people":[{"people_name":"趙沖","people_name_jianti_auto":"赵冲","people_xingming":"赵冲","start_index":13,"tongjian_id":"96abbf42-db0e-11ef-83d7-a0d3651f611f"},{"people_name":"張貢","people_name_jianti_auto":"张贡","people_xingming":"张贡","start_index":20,"tongjian_id":"96abbf43-db0e-11ef-97a6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":10,"tongjian_id":"96abbf44-db0e-11ef-be22-a0d3651f611f"},{"place_name":"漢陽","place_name_jianti_auto":"汉阳","resolved_place_entity_id":879,"start_index":16,"tongjian_id":"96abbf45-db0e-11ef-962d-a0d3651f611f"},{"place_name":"燒當羌","place_name_jianti_auto":"烧当羌","resolved_place_entity_id":1653,"start_index":23,"tongjian_id":"96abbf46-db0e-11ef-8ffd-a0d3651f611f"},{"place_name":"參䜌","place_name_jianti_auto":"参䜌","resolved_place_entity_id":4347,"start_index":27,"tongjian_id":"96abbf47-db0e-11ef-b990-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、庆阳府（卷五十七）","excerpts":[{"context_after":"魏晋间，县废。○周槃城，在府南百二十里。后魏置东槃县，属...","context_before":"...郡属县。纻读廉。《汉志》注：王骑都尉治此。后汉属北地郡。","source_end_index":68,"source_paragraph_tongjian_id":"994fe7a9-a879-5008-bc58-892789138124","source_start_index":40,"source_text":"顺帝安汉中，烧何种羌据参纻，护羌校尉赵冲等击破之。是也。"}],"path":"陕西方舆纪要/六、庆阳府（卷五十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1夏，四月，庚戌，護羌校尉趙沖與漢陽太守張貢擊燒當羌於參䜌，破之。","content_fanyi":"夏季四月庚戌日，护羌校尉赵冲与汉阳太守张贡在参䜌进击烧当羌，并击破了他们。","content_jianti_auto":"1夏，四月，庚戌，护羌校尉赵冲与汉阳太守张贡击烧当羌于参䜌，破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4434,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"96abbf3b-db0e-11ef-aa08-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"吾斯","people_name_jianti_auto":"吾斯","start_index":5,"tongjian_id":"96abbf4a-db0e-11ef-9cfc-a0d3651f611f"},{"people_name":"車紐","people_name_jianti_auto":"车纽","start_index":8,"tongjian_id":"96abbf4b-db0e-11ef-989f-a0d3651f611f"},{"people_name":"陳龜","people_name_jianti_auto":"陈龟","start_index":12,"tongjian_id":"96abbf4c-db0e-11ef-808a-a0d3651f611f"},{"people_name":"休利","people_name_jianti_auto":"休利","start_index":18,"tongjian_id":"96abbf4d-db0e-11ef-831e-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":37,"tongjian_id":"96abbf4e-db0e-11ef-8624-a0d3651f611f"},{"people_name":"兜樓儲","people_name_jianti_auto":"兜楼储","start_index":45,"tongjian_id":"96abbf4f-db0e-11ef-9b04-a0d3651f611f"},{"people_name":"范","people_name_jianti_auto":"范","start_index":54,"tongjian_id":"96abbf50-db0e-11ef-85ec-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"南庭","place_name_jianti_auto":"南庭","start_index":21,"tongjian_id":"96abbf51-db0e-11ef-8842-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自永和五年吾斯、車紐反，陳龜逼殺單于休利，南庭虛位，至是始立單于。考異曰：袁紀，去年六月立兜樓儲爲單于，今從范書。","note_content_jianti_auto":"自永和五年吾斯、车纽反，陈龟逼杀单于休利，南庭虚位，至是始立单于。考异曰：袁纪，去年六月立兜楼储为单于，今从范书。","note_type":"hu_note","start_index":27,"tongjian_id":"96abbf49-db0e-11ef-8cc6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":31,"tongjian_id":"96abbf57-db0e-11ef-9b40-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"廣陽","place_name_jianti_auto":"广阳","start_index":34,"tongjian_id":"96abbf58-db0e-11ef-a845-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"太常掌樂，大鴻臚典四夷之客，故詔使祖單于。祖會，爲祖道之會也。賢曰：廣陽，城西面南頭門。角抵之戲，則魚龍爵馬之屬，言兩兩相當，亦角而爲抵對，卽今之鬭用古之角抵也。臚，陵如翻。","note_content_jianti_auto":"太常掌乐，大鸿胪典四夷之客，故诏使祖单于。祖会，为祖道之会也。贤曰：广阳，城西面南头门。角抵之戏，则鱼龙爵马之属，言两两相当，亦角而为抵对，即今之鬭用古之角抵也。胪，陵如翻。","note_type":"hu_note","start_index":91,"tongjian_id":"96abbf56-db0e-11ef-8f25-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"太常","official_note":"太常掌管宗廟禮儀和祭祀，在漢代為九卿之一，此處負責與大鴻臚共同主持外國侍子的送別宴會，體現朝廷禮儀職能。","official_rank":"九卿之一，正三品","source_snippet":"詔太常、大鴻臚與諸國侍子於廣陽門外祖會","start_index":58,"tongjian_id":"a5396ea6-23fd-4d98-9789-8c85c9773ae4"},{"confidence":0.9,"official_category":"外交","official_name":"大鴻臚","official_note":"大鴻臚掌管諸侯和少數民族事務，在漢代為九卿之一，此處負責與太常共同主持外國侍子的送別宴會，體現外交職能。","official_rank":"九卿之一，正三品","source_snippet":"詔太常、大鴻臚與諸國侍子於廣陽門外祖會","start_index":61,"tongjian_id":"ea478fce-f6b5-4116-b828-4b1f6a817857"}],"ExtRef_Children_people":[{"link_death_year":147,"link_td_description":"呼兰若尸逐就单于，挛鞮氏，名兜楼储。143年7月24日由汉顺帝册封为南匈奴单于，147年去世。","link_td_id":"Q10003038","link_td_number_id":913367,"people_name":"守義王","people_name_jianti_auto":"守义王","people_xingming":"兜楼储","start_index":11,"tongjian_id":"96abbf59-db0e-11ef-9898-a0d3651f611f"},{"link_death_year":147,"link_td_description":"呼兰若尸逐就单于，挛鞮氏，名兜楼储。143年7月24日由汉顺帝册封为南匈奴单于，147年去世。","link_td_id":"Q10003038","link_td_number_id":913367,"people_name":"兜樓儲","people_name_jianti_auto":"兜楼储","people_xingming":"兜楼储","start_index":14,"tongjian_id":"96abbf5a-db0e-11ef-b32b-a0d3651f611f"},{"link_death_year":147,"link_td_description":"呼兰若尸逐就单于，挛鞮氏，名兜楼储。143年7月24日由汉顺帝册封为南匈奴单于，147年去世。","link_td_id":"Q10003038","link_td_number_id":913367,"people_name":"呼蘭若尸逐就單于","people_name_jianti_auto":"呼兰若尸逐就单于","people_xingming":"兜楼储","start_index":18,"tongjian_id":"96abbf5b-db0e-11ef-9b69-a0d3651f611f"},{"link_death_year":147,"link_td_description":"呼兰若尸逐就单于，挛鞮氏，名兜楼储。143年7月24日由汉顺帝册封为南匈奴单于，147年去世。","link_td_id":"Q10003038","link_td_number_id":913367,"people_name":"兜樓儲","people_name_jianti_auto":"兜楼储","start_index":28,"tongjian_id":"96abbf5d-db0e-11ef-b088-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"南匈奴","place_name_jianti_auto":"南匈奴","resolved_place_entity_id":1075,"start_index":8,"tongjian_id":"96abbf5c-db0e-11ef-bd20-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":32,"tongjian_id":"96abbf5e-db0e-11ef-a706-a0d3651f611f"},{"place_name":"廣陽門","place_name_jianti_auto":"广阳门","resolved_place_entity_id":2631,"start_index":72,"tongjian_id":"96abbf5f-db0e-11ef-9758-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"魏晋因之。晋河间王颙将张方至洛阳，入广阳门。亦曰西阳门。...","context_before":"...尔朱世隆帅荣部曲焚西阳门，出屯河阴]，其南一门曰广阳门[","source_end_index":1237,"source_paragraph_tongjian_id":"e3b93898-81a6-5ccc-96dd-d1fc249f706c","source_start_index":1207,"source_text":"顺帝安汉二年，立南匈奴兜楼储为单于，绍祖饯于广阳门外，是也。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":["外交"],"content":"2六月，丙寅，立南匈奴守義王兜樓儲爲呼蘭若尸逐就單于。時兜樓儲在京師，上親臨軒授璽綬，引上殿，賜車馬、器服、金帛甚厚。詔太常、大鴻臚與諸國侍子於廣陽門外祖會，饗賜、作樂、角抵、百戲。","content_fanyi":"二年六月丙寅日，朝廷册立南匈奴守义王兜楼储为呼兰若尸逐就单于。当时兜楼储正在京师洛阳，顺帝亲临殿前平台，授予他玺绶，引他上殿，并赐给车马、器物、衣服、金银、丝织品，十分丰厚。又下诏命太常、大鸿胪与各国派到汉朝做人质的王子到广阳门外为他举行饯行聚会，设宴赏赐、演奏音乐、表演角抵和百戏。","content_jianti_auto":"2六月，丙寅，立南匈奴守义王兜楼储为呼兰若尸逐就单于。时兜楼储在京师，上亲临轩授玺绶，引上殿，赐车马、器服、金帛甚厚。诏太常、大鸿胪与诸国侍子于广阳门外祖会，飨赐、作乐、角抵、百戏。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4435,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"96abbf48-db0e-11ef-affc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"96abbf62-db0e-11ef-a5b0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"阿陽縣","place_name_jianti_auto":"阿阳县","start_index":3,"tongjian_id":"96abbf63-db0e-11ef-bb50-a0d3651f611f"},{"place_name":"漢陽郡","place_name_jianti_auto":"汉阳郡","start_index":8,"tongjian_id":"96abbf64-db0e-11ef-b8aa-a0d3651f611f"},{"place_name":"秦州","place_name_jianti_auto":"秦州","start_index":16,"tongjian_id":"96abbf65-db0e-11ef-88b8-a0d3651f611f"},{"place_name":"隴城縣","place_name_jianti_auto":"陇城县","start_index":18,"tongjian_id":"96abbf66-db0e-11ef-bd47-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：阿陽縣，屬漢陽郡；故城在今秦州隴城縣西北。","note_content_jianti_auto":"贤曰：阿阳县，属汉阳郡；故城在今秦州陇城县西北。","note_type":"hu_note","start_index":20,"tongjian_id":"96abbf61-db0e-11ef-93e9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"趙沖","people_name_jianti_auto":"赵冲","people_xingming":"赵冲","start_index":7,"tongjian_id":"96abbf67-db0e-11ef-ba7d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燒當羌","place_name_jianti_auto":"烧当羌","resolved_place_entity_id":1653,"start_index":10,"tongjian_id":"96abbf68-db0e-11ef-a67f-a0d3651f611f"},{"place_name":"阿陽","place_name_jianti_auto":"阿阳","resolved_place_entity_id":3464,"start_index":14,"tongjian_id":"96abbf69-db0e-11ef-8d6d-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、巩昌府（卷五十九）","excerpts":[{"context_after":"又光和七年，北地羌胡与边章侵陇右，汉阳长史盖勋屯阿阳以拒...","context_before":"...天水郡。吕后六年，匈徒寇狄道攻阿阳，即此。后汉属汉阳郡。","source_end_index":65,"source_paragraph_tongjian_id":"cbb2b76d-31da-5ec0-9ede-961783c97e20","source_start_index":49,"source_text":"汉安二年，赵冲等击破叛羌于阿阳。"}],"path":"陕西方舆纪要/八、巩昌府（卷五十九）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"conten