32,"tongjian_id":"8cab28cc-db0e-11ef-ac0a-a0d3651f611f"},{"place_name":"薊丘","place_name_jianti_auto":"蓟丘","start_index":38,"tongjian_id":"8cab28cd-db0e-11ef-bd6d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"薊，燕都也。班志，薊縣屬廣陽國。唐爲幽州治所；今爲燕京。水經註：薊城西北隅有薊丘，故名。燕，因肩翻。薊，音計。","note_content_jianti_auto":"蓟，燕都也。班志，蓟县属广阳国。唐为幽州治所；今为燕京。水经注：蓟城西北隅有蓟丘，故名。燕，因肩翻。蓟，音计。","note_type":"hu_note","start_index":275,"tongjian_id":"8cab28c3-db0e-11ef-b243-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca8d9cb-db0e-11ef-963a-a0d3651f611f","pinyin":"zhú","source_anchor_text":"晝邑人王蠋賢令軍中","source_key":"baiyang_epub","start_index":8,"text":"蠋","tongjian_id":"8d2f751e-eddc-59e2-84ae-04eb18d154bd"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca8d9cb-db0e-11ef-963a-a0d3651f611f","pinyin":"dòu","source_anchor_text":"枝自奮絕脰而死燕師","source_key":"baiyang_epub","start_index":108,"text":"脰","tongjian_id":"9f21ab41-28b8-545f-88fb-6f2f99698ae8"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca8d9cb-db0e-11ef-963a-a0d3651f611f","pinyin":"juàn","source_anchor_text":"河濟屯阿鄄以連魏師","source_key":"baiyang_epub","start_index":205,"text":"鄄","tongjian_id":"75f0a50b-a6d4-5239-951c-3d491b7ee11d"}],"ExtRef_Children_places":[{"place_name":"鄄","place_name_jianti_auto":"鄄","place_note":"山東鄄城","resolved_place_entity_id":1523,"start_index":205,"tongjian_id":"8cad5f50-db0e-11ef-b1ef-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/秦用他国人","excerpts":[{"context_after":"，辛、毅皆赵人也。楚悼王任吴起为相，诸侯患楚之强，盖卫人...","context_before":"...斯楚人。皆委国而听之不疑，卒之所以兼天下者，诸人之力也。","source_end_index":170,"source_paragraph_tongjian_id":"6e15c2e4-f2d3-4bfd-b268-aaf88f22dfd7","source_start_index":153,"source_text":"燕昭王任郭隗、剧辛、乐毅，几灭强齐"}],"path":"随笔/卷二/秦用他国人","source_name":"容斋随笔"},{"display_title":"容斋随笔/拔亡为存","excerpts":[{"context_after":"，赖田单之力，齐复为齐，尺寸之土无所失。曹操牧兖州，州叛...","context_before":"","source_end_index":23,"source_paragraph_tongjian_id":"bec384b8-3cbb-4700-979c-de28237fab3d","source_start_index":0,"source_text":"燕乐毅伐齐，下七十余城，所存者唯莒、即墨两城耳"}],"path":"随笔/卷十三/拔亡为存","source_name":"容斋随笔"},{"display_title":"容斋随笔/燕非强国","excerpts":[{"context_after":"。故苏秦说赵王曰：“赵北有燕，燕固弱国，不足畏也。”燕王...","context_before":"...见于中国者，不过三四，大率制命于齐。七雄之际，为齐所取，","source_end_index":69,"source_paragraph_tongjian_id":"736aac77-1802-441e-9402-8cea82e51826","source_start_index":41,"source_text":"后赖五国之力，乐毅为将，然后胜齐，然卒于得七十城不能守也"}],"path":"四笔/卷三/燕非强国","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"次则莫如元季之察罕。元至正中，山东为群盗田丰等所据，察罕...","context_before":"...，天下有事，未尝不起于山东。繇秦汉以迄宋元，可更仆数也。","source_end_index":596,"source_paragraph_tongjian_id":"d003969e-77ca-5ce3-ac86-88a7fcf5331a","source_start_index":444,"source_text":"若其攻取大略，彪炳史册者，莫如乐毅，毅并护赵、楚、韩、魏之兵，为燕昭王伐齐，败齐兵于济，西分魏师，以略宋地，部赵师以收河间，身帅燕师，长驱逐北，遂入临淄。又遣左军渡胶东、东莱，前军循泰山，东至海，略琅邪，右军循河济，屯阿鄄以连魏师，后军并北海而抚千乘，以中军据临淄而镇齐都，六月之间，下齐七十余城，是也。"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"黄歇说秦昭王，所谓割濮磨之北，绝齐、秦之要者[濮磨，徐广...","context_before":"州指挥相、魏，顾盼汴、宋，当走集之郊，为四战之地。","source_end_index":65,"source_paragraph_tongjian_id":"9bd62a86-4b23-5b16-ad0a-e4b2df36d57b","source_start_index":25,"source_text":"战国时，乐毅伐齐，命左军循河屯阿、鄄之间[阿，谓东阿；鄄，即鄄城也]，以连魏师。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、青州府（卷三十五）","excerpts":[{"context_after":"后汉耿弇攻张步，进军画中。章怀太子曰：即画邑也，以澅水而...","context_before":"画邑城[县西北二十里。齐邑也。孟子去齐，宿于画。","source_end_index":41,"source_paragraph_tongjian_id":"64a82e70-4fa2-54dc-8cdf-cd6a65a54855","source_start_index":24,"source_text":"又乐毅伐齐，闻画邑人王蠋贤，即此。"}],"path":"山东方舆纪要/五、青州府（卷三十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2樂毅聞晝邑人王蠋賢，令軍中環晝邑三十里無入。使人請蠋，蠋謝不往。燕人曰：「不來，吾且屠晝邑！」蠋曰：「忠臣不事二君，烈女不更二夫。國破君亡，吾不能存，而又欲劫之以兵；吾與其不義而生，不若死！」遂經其頸於樹枝，自奮絕脰而死。燕師乘勝長驅，齊城皆望風奔潰。樂毅修整燕軍，禁止侵掠，求齊之逸民，顯而禮之，寬其賦斂，除其暴令，修其舊政，齊民喜悅。乃遣左軍渡膠東、東萊；前軍循泰山以東至海，略琅邪；右軍循河、濟，屯阿、鄄以連魏師；後軍旁北海以撫千乘：中軍據臨淄而鎭齊都。祀桓公、管仲於郊，表賢者之閭，封王蠋之墓。齊人食邑於燕者二十餘君，有爵位於薊者百有餘人。六月之間，下齊七十餘城，皆爲郡縣。","content_fanyi":"乐毅听说昼邑人王蠋贤良，命令军中在昼邑周围三十里以内不得进入。派人去请王蠋，王蠋辞谢不去。燕国人说：“你不来，我们就要屠灭昼邑！”王蠋说：“忠臣不侍奉两个君主，烈女不嫁两个丈夫。如今国家破亡，君主丧命，我已不能保全国家，而你们又想用武力逼迫我；我与其不义地偷生，不如一死！”于是把脖颈套在树枝上，自己奋力一挣，勒断脖颈而死。燕国军队乘胜长驱直入，齐国各城邑民众都望风奔逃溃散。乐毅整饬燕军，禁止侵害抢掠百姓，寻访齐国隐逸的贤士，使他们显贵并礼遇他们，减轻赋税，废除暴虐的政令，恢复齐国原先宽松的政令，齐国百姓都很高兴。于是派遣左军渡过胶莱河抵达胶东、东莱；前军沿着泰山向东到达海边，攻取琅邪；右军沿着黄河、济水前进，屯驻在阿、鄄以联络魏军；后军沿着北海以安抚千乘；中军占据临淄，镇守齐国都城。乐毅又在郊外祭祀齐桓公、管仲，表彰贤者居住的里巷，增高王蠋的坟墓封土。齐国人中，在燕国享有封君食邑的有二十余位，在蓟都享有爵位的有一百余人。六个月之内，乐毅攻下齐国七十余座城邑，都设置为郡县。","content_jianti_auto":"2乐毅闻昼邑人王蠋贤，令军中环昼邑三十里无入。使人请蠋，蠋谢不往。燕人曰：「不来，吾且屠昼邑！」蠋曰：「忠臣不事二君，烈女不更二夫。国破君亡，吾不能存，而又欲劫之以兵；吾与其不义而生，不若死！」遂经其颈于树枝，自奋绝脰而死。燕师乘胜长驱，齐城皆望风奔溃。乐毅修整燕军，禁止侵掠，求齐之逸民，显而礼之，宽其赋敛，除其暴令，修其旧政，齐民喜悦。乃遣左军渡胶东、东莱；前军循泰山以东至海，略琅邪；右军循河、济，屯阿、鄄以连魏师；后军旁北海以抚千乘：中军据临淄而镇齐都。祀桓公、管仲于郊，表贤者之闾，封王蠋之墓。齐人食邑于燕者二十余君，有爵位于蓟者百有余人。六月之间，下齐七十余城，皆为郡县。","dtjl_paragraph_links":[],"dtjl_references":[],"id":345,"number":2,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 三十一年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"8ca8d9cb-db0e-11ef-963a-a0d3651f611f","year_int":-284},"tongjian_id":"8ca8d9cb-db0e-11ef-963a-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"鄄","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"華，戶化翻。「鄄」，當作「鄜」。詳見辯誤。","note_content_jianti_auto":"华，户化翻。「鄄」，当作「鄜」。详见辩误。","note_type":"hu_note","start_index":84,"tongjian_id":"c7035557-db0e-11ef-9194-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李匡威","people_name_jianti_auto":"李匡威","start_index":2,"tongjian_id":"c703555a-db0e-11ef-bbac-a0d3651f611f"},{"people_name":"赫連鐸","people_name_jianti_auto":"赫连铎","start_index":8,"tongjian_id":"c703555b-db0e-11ef-820c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"幽","place_name_jianti_auto":"幽","start_index":0,"tongjian_id":"c703555c-db0e-11ef-aeab-a0d3651f611f"},{"place_name":"雲","place_name_jianti_auto":"云","start_index":6,"tongjian_id":"c703555d-db0e-11ef-b42d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"幽，李匡威；雲，赫連鐸。","note_content_jianti_auto":"幽，李匡威；云，赫连铎。","note_type":"hu_note","start_index":99,"tongjian_id":"c7035559-db0e-11ef-875f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張濬","people_name_jianti_auto":"张濬","start_index":9,"tongjian_id":"c703555f-db0e-11ef-91ec-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復從，扶又翻。史言張濬志節可憐。","note_content_jianti_auto":"复从，扶又翻。史言张濬志节可怜。","note_type":"hu_note","start_index":116,"tongjian_id":"c703555e-db0e-11ef-9a7b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄄","place_name_jianti_auto":"鄄","start_index":76,"tongjian_id":"c7035570-db0e-11ef-be17-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"是役也，朝廷倚朱全忠及河朔三鎭；及濬至晉州，全忠方連兵徐、鄆，雖遣將攻澤州而身不至。行營乃求兵糧於鎭、魏，鎭、魏倚河東爲扞蔽，皆不出兵；惟華、邠、鳳翔、鄄、夏之兵會之。兵未交而孫揆被擒，幽、雲俱敗，楊復恭復從中沮之，故濬軍望風自潰。","content_fanyi":"这次战役，朝廷依仗朱全忠和河朔三镇；等到张浚到达晋州时，朱全忠正在联合徐州、郓州二州的军队，虽然派将领攻打泽州，自己却没有亲自前往。张浚的行营于是向镇州、魏州请求支援兵员和粮草，而镇州、魏州倚仗李克用的河东军队作为屏障，都不肯出兵；只有华州、邠州、凤翔、鄜州、夏州的军队前来与他会合。两军尚未交锋，孙揆就被擒获，幽州的李匡威、云州的赫连铎也都战败，杨复恭又从中阻挠，因此张浚的军队望风溃散。","content_jianti_auto":"是役也，朝廷倚朱全忠及河朔三镇；及濬至晋州，全忠方连兵徐、郓，虽遣将攻泽州而身不至。行营乃求兵粮于镇、魏，镇、魏倚河东为扞蔽，皆不出兵；惟华、邠、凤翔、鄄、夏之兵会之。兵未交而孙揆被擒，幽、云俱败，杨复恭复从中沮之，故濬军望风自溃。","dtjl_paragraph_links":[],"dtjl_references":[],"id":26587,"path":"资治通鉴 : 卷第二百五十八 (唐紀七十四) / 昭宗聖穆景文孝皇帝上之上 / 大順元年 / 第 51 段","reading_annotation_sources":[],"start_index":50,"tongjian_id":"c7035556-db0e-11ef-8229-a0d3651f611f","year_int":890},"tongjian_id":"c7035556-db0e-11ef-8229-a0d3651f611f"},"paragraph_order":4}],"page_size":10,"total_pages":1,"total_paragraphs":4},"place_name":"鄄","resolved_profile":{"entity_id":1523,"entry_list_str":"鄄城,甄城,鄄","intro":"春秋时期为卫国鄄邑，西汉初置鄄城县，属济阴郡，后为兖州、濮阳郡、濮州等治所，是千年古县，今属山东省菏泽市。","lat_max":35.7,"lat_min":35.3,"lon_max":115.8,"lon_min":115.3,"modern_location":"今山东省菏泽市鄄城县一带","seat":"鄄城县（今山东省菏泽市鄄城县）","show_map":true,"standard_name":"鄄城","type_code":"settlement"}},"message":"success","success":true}