"},{"people_name":"康","people_name_jianti_auto":"康","start_index":169,"tongjian_id":"8ca8d9d8-db0e-11ef-a140-a0d3651f611f"},{"people_name":"孟子","people_name_jianti_auto":"孟子","start_index":185,"tongjian_id":"8ca8d9d9-db0e-11ef-8d7f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"畫","place_name_jianti_auto":"画","start_index":4,"tongjian_id":"8ca8d9da-db0e-11ef-b9e6-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":6,"tongjian_id":"8ca8d9db-db0e-11ef-a766-a0d3651f611f"},{"place_name":"戟里城","place_name_jianti_auto":"戟里城","start_index":28,"tongjian_id":"8ca8d9dc-db0e-11ef-b7f7-a0d3651f611f"},{"place_name":"臨淄城","place_name_jianti_auto":"临淄城","start_index":32,"tongjian_id":"8ca8d9dd-db0e-11ef-a36d-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":41,"tongjian_id":"8ca8d9de-db0e-11ef-a00a-a0d3651f611f"},{"place_name":"棘邑","place_name_jianti_auto":"棘邑","start_index":44,"tongjian_id":"8ca8d9df-db0e-11ef-bc71-a0d3651f611f"},{"place_name":"澅邑","place_name_jianti_auto":"𣶩邑","start_index":50,"tongjian_id":"8ca8d9e0-db0e-11ef-8732-a0d3651f611f"},{"place_name":"澅水","place_name_jianti_auto":"𣶩水","start_index":62,"tongjian_id":"8ca8d9e1-db0e-11ef-a565-a0d3651f611f"},{"place_name":"臨淄","place_name_jianti_auto":"临淄","start_index":74,"tongjian_id":"8ca8d9e2-db0e-11ef-b674-a0d3651f611f"},{"place_name":"澅水","place_name_jianti_auto":"𣶩水","start_index":77,"tongjian_id":"8ca8d9e3-db0e-11ef-97d2-a0d3651f611f"},{"place_name":"沛","place_name_jianti_auto":"沛","start_index":83,"tongjian_id":"8ca8d9e4-db0e-11ef-bd73-a0d3651f611f"},{"place_name":"澅水","place_name_jianti_auto":"𣶩水","start_index":102,"tongjian_id":"8ca8d9e5-db0e-11ef-8867-a0d3651f611f"},{"place_name":"時水","place_name_jianti_auto":"时水","start_index":105,"tongjian_id":"8ca8d9e6-db0e-11ef-947d-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":111,"tongjian_id":"8ca8d9e7-db0e-11ef-b556-a0d3651f611f"},{"place_name":"畫中","place_name_jianti_auto":"画中","start_index":121,"tongjian_id":"8ca8d9e8-db0e-11ef-a210-a0d3651f611f"},{"place_name":"臨淄","place_name_jianti_auto":"临淄","start_index":125,"tongjian_id":"8ca8d9e9-db0e-11ef-b345-a0d3651f611f"},{"place_name":"西安","place_name_jianti_auto":"西安","start_index":128,"tongjian_id":"8ca8d9ea-db0e-11ef-a065-a0d3651f611f"},{"place_name":"畫邑","place_name_jianti_auto":"画邑","start_index":178,"tongjian_id":"8ca8d9eb-db0e-11ef-b9e0-a0d3651f611f"},{"place_name":"晝邑","place_name_jianti_auto":"昼邑","start_index":181,"tongjian_id":"8ca8d9ec-db0e-11ef-9636-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":188,"tongjian_id":"8ca8d9ed-db0e-11ef-88ab-a0d3651f611f"},{"place_name":"晝","place_name_jianti_auto":"昼","start_index":191,"tongjian_id":"8ca8d9ee-db0e-11ef-acde-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉熙曰：畫，齊西南近邑，音獲。索隱曰：音胡卦翻。括地志：戟里城在臨淄城西北三十里，春秋時棘邑。又云：澅邑，蠋所居，卽此邑，因澅水爲名也。京相璠曰：今臨淄有澅水，西北入沛，卽班志所謂如水；如、時聲相似，然則澅水卽時水也。余按後漢耿弇攻張步，進軍畫中，在臨淄、西安二邑之間。「蠋」，班固古今人表作「歜」，音觸。據「蠋」字則當音蜀，或音之欲翻；康：珠玉切。通鑑以畫邑爲晝邑，以孟子去齊宿於晝爲據也。若以孟子爲據，則晝讀如字。","note_content_jianti_auto":"刘熙曰：画，齐西南近邑，音获。索隐曰：音胡卦翻。括地志：戟里城在临淄城西北三十里，春秋时棘邑。又云：𣶩邑，蠋所居，即此邑，因𣶩水为名也。京相璠曰：今临淄有𣶩水，西北入沛，即班志所谓如水；如、时声相似，然则𣶩水即时水也。余按后汉耿弇攻张步，进军画中，在临淄、西安二邑之间。「蠋」，班固古今人表作「歜」，音触。据「蠋」字则当音蜀，或音之欲翻；康：珠玉切。通鉴以画邑为昼邑，以孟子去齐宿于昼为据也。若以孟子为据，则昼读如字。","note_type":"hu_note","start_index":11,"tongjian_id":"8ca8d9d0-db0e-11ef-9495-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"經，絞也，縊也。頸，居郢翻，頭莖也。自奮，自奮起而還擲也。脰，大透翻，頸也。","note_content_jianti_auto":"经，绞也，缢也。颈，居郢翻，头茎也。自奋，自奋起而还掷也。脰，大透翻，颈也。","note_type":"hu_note","start_index":112,"tongjian_id":"8ca8d9fe-db0e-11ef-8f54-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"斂，力驗翻；後以義推。","note_content_jianti_auto":"敛，力验翻；后以义推。","note_type":"hu_note","start_index":155,"tongjian_id":"8ca8d9ff-db0e-11ef-9ef4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8ca8da02-db0e-11ef-9a6b-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":3,"tongjian_id":"8ca8da03-db0e-11ef-8f2b-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：孔本「政」作「制」。』","note_content_jianti_auto":"『章：孔本「政」作「制」。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8ca8da01-db0e-11ef-a278-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":165,"tongjian_id":"8ca8da00-db0e-11ef-844d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"萊子","people_name_jianti_auto":"莱子","start_index":64,"tongjian_id":"8ca8da05-db0e-11ef-b99d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"膠東","place_name_jianti_auto":"胶东","start_index":0,"tongjian_id":"8ca8da06-db0e-11ef-a036-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":3,"tongjian_id":"8ca8da07-db0e-11ef-bb17-a0d3651f611f"},{"place_name":"膠水","place_name_jianti_auto":"胶水","start_index":11,"tongjian_id":"8ca8da08-db0e-11ef-b5a5-a0d3651f611f"},{"place_name":"琅邪","place_name_jianti_auto":"琅邪","start_index":14,"tongjian_id":"8ca8da09-db0e-11ef-8ce6-a0d3651f611f"},{"place_name":"黔陬縣","place_name_jianti_auto":"黔陬县","start_index":16,"tongjian_id":"8ca8da0a-db0e-11ef-bbe1-a0d3651f611f"},{"place_name":"膠山","place_n