f_Children_zhang_notes":[],"note_content":"應劭曰：丞者，承也；相者，助也。荀悅曰：秦本次國，命卿二人，故置左右丞相，無三公官。樗里疾，秦惠王之弟也。高誘曰：疾居渭南之陰鄕，其里有大樗樹，故號樗里子。相，息亮翻。樗，丑於翻。誘，羊久翻。","note_content_jianti_auto":"应劭曰：丞者，承也；相者，助也。荀悦曰：秦本次国，命卿二人，故置左右丞相，无三公官。樗里疾，秦惠王之弟也。高诱曰：疾居渭南之阴鄕，其里有大樗树，故号樗里子。相，息亮翻。樗，丑于翻。诱，羊久翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8c76061f-db0e-11ef-8b30-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是秦朝设立的最高行政长官，负责辅佐君主处理国家政务，此处表示秦国首次设立丞相职位，标志着中央集权制度的加强。","official_rank":"正一品","source_snippet":"秦初置丞相","start_index":1,"tongjian_id":"b90ee0f1-f07f-4e7a-933d-1a594f592ea5"},{"confidence":0.9,"official_category":"中枢机构","official_name":"右丞相","official_note":"右丞相是丞相职位中的一种，通常与左丞相并列，负责协助君主管理国家事务，此处表示樗里疾被任命为右丞相，体现了秦国对高级官员的任命。","official_rank":"正一品","source_snippet":"以樗里疾爲右丞相","start_index":8,"tongjian_id":"53b2c7b9-c33d-4ea1-ad7f-e01431c55411"}],"ExtRef_Children_people":[{"link_death_year":-300,"link_td_description":"樗里子，嬴姓，名疾，又称“樗里疾”，秦国公族、大臣，秦孝公之子，惠文王弟，母亲为韩国人，乃战国时代著名军事家及政治家，曾辅佐秦惠王、秦武王、秦昭王等秦国君主。擅长外交、军事。","link_td_id":"Q10002142","link_td_number_id":109473,"people_name":"樗里疾","people_name_jianti_auto":"樗里疾","people_xingming":"贏疾","start_index":8,"tongjian_id":"8c76062a-db0e-11ef-98ba-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c76061e-db0e-11ef-95ed-a0d3651f611f","pinyin":"chū","source_anchor_text":"置丞相以樗里疾為右","source_key":"baiyang_epub","start_index":8,"text":"樗","tongjian_id":"b032923e-bf01-52ca-b5cf-3d6bad89e4e0"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c76062b-db0e-11ef-94cb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"1秦初置丞相，以樗里疾爲右丞相。","content_fanyi":"秦国开始设置丞相一职，任命樗里疾为右丞相。","content_jianti_auto":"1秦初置丞相，以樗里疾为右丞相。","dtjl_paragraph_links":[]