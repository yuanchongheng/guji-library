es":[{"place_name":"溫","place_name_jianti_auto":"温","start_index":0,"tongjian_id":"8ca437ef-db0e-11ef-be32-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":2,"tongjian_id":"8ca437f0-db0e-11ef-819c-a0d3651f611f"},{"place_name":"溫縣","place_name_jianti_auto":"温县","start_index":14,"tongjian_id":"8ca437f1-db0e-11ef-bdd6-a0d3651f611f"},{"place_name":"河內郡","place_name_jianti_auto":"河内郡","start_index":17,"tongjian_id":"8ca437f2-db0e-11ef-9f99-a0d3651f611f"},{"place_name":"宋","place_name_jianti_auto":"宋","place_note":"都睢阳，河南商丘","start_index":21,"tongjian_id":"8ca437f3-db0e-11ef-bddb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"溫，周司寇蘇忿生之邑。班志，溫縣屬河內郡。宋至此而滅。湣，讀曰閔。","note_content_jianti_auto":"温，周司寇苏忿生之邑。班志，温县属河内郡。宋至此而灭。湣，读曰闵。","note_type":"hu_note","start_index":197,"tongjian_id":"8ca437ec-db0e-11ef-b6a8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca437c4-db0e-11ef-98c3-a0d3651f611f","pinyin":"zōu","source_anchor_text":"𪄟於城之陬史占之曰","source_key":"baiyang_epub","start_index":9,"text":"陬","tongjian_id":"8663d69a-f13f-563e-a63e-cd6676e2a343"}],"ExtRef_Children_places":[{"place_name":"宋","place_name_jianti_auto":"宋","place_note":"都睢阳，河南商丘","resolved_place_entity_id":354,"start_index":1,"tongjian_id":"8ca437f5-db0e-11ef-a0dc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/战国自取亡","excerpts":[{"context_after":"，南侵楚，西侵三晋，欲并二周为天子，遂为燕所屠。虽赖田单...","context_before":"...振，讫于殄国。闵王承威、宣之后，山东之建国莫强焉。而狃于","source_end_index":224,"source_paragraph_tongjian_id":"1509ccdd-dd12-435e-a66e-d1a5b3e173e1","source_start_index":220,"source_text":"伐宋之利"}],"path":"随笔/卷十/战国自取亡","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"秦置滕县。汉高祖封夏侯婴为侯邑，号滕公，寻改置公丘县，属...","context_before":"○滕城[县西南十四里。周滕国，文王子叔绣所封。","source_end_index":33,"source_paragraph_tongjian_id":"06c862de-4dd5-516a-b498-3ce31b45dad1","source_start_index":23,"source_text":"至战国时，为宋所灭。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/六、归德府（卷五十）","excerpts":[{"context_after":"秦置砀郡。汉改为梁国。后汉因之。晋亦为梁国。后魏曰梁郡。...","context_before":"...阏伯居商丘]。商汤为亳邑地。周武王以封微子启，是为宋国。","source_end_index":64,"source_paragraph_tongjian_id":"14c04339-3046-5f8c-a0c1-e966e1b0b2c6","source_start_index":50,"source_text":"战国齐灭宋，与楚魏三分其地。"}],"path":"河南方舆纪要/六、归德府（卷五十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3宋有雀生𪄟於城之陬。史占之曰：「吉。小而生巨，必霸天下。」宋康王喜，起兵滅滕，伐薛，東敗齊，取五城，南敗楚，取地三百里，西敗魏軍，與齊、魏爲敵國，乃愈自信其霸。欲霸之亟成，故射天笞地，斬社稷而焚滅之，以示威服鬼神。爲長夜之飲於室中，室中人呼萬歲，則堂上之人應之，堂下之人又應之，門外之人又應之，以至於國中，無敢不呼萬歲者。天下之人謂之「桀宋」。齊湣王起兵伐之，民散，城不守。宋王奔魏，死於溫。","content_fanyi":"宋国出现一桩异事：麻雀在城墙角落孵出一只鹞鹰。掌管卜筮的太史占卜后说：“这是吉兆。小鸟生出大鸟，宋国必定会称霸天下。”宋康王听后大喜，发兵灭掉滕国，攻打薛邑，向东击败齐国，夺取五座城邑，向南击败楚国，夺取三百里土地，向西击败魏军，和齐、魏两国成为敌国，于是越加相信自己的霸业能够成功。他急于让霸业早日告成，就箭射苍天、鞭打大地，砍断社稷神主并烧毁，以此显示自己的威势足以压服鬼神。他在宫中通宵饮酒作乐，宫中的人高呼万岁，堂上的人随即应声高呼，堂下的人又应声高呼，门外的人又接着应声高呼，直至整个国都之内没有人敢不呼万岁。天下人都称他为昏暴的“桀宋”。齐湣王起兵讨伐宋康王，宋国百姓四散奔逃，都城失守。宋康王逃往魏国，死在温邑。","content_jianti_auto":"3宋有雀生𪄟于城之陬。史占之曰：「吉。小而生巨，必霸天下。」宋康王喜，起兵灭滕，伐薛，东败齐，取五城，南败楚，取地三百里，西败魏军，与齐、魏为敌国，乃愈自信其霸。欲霸之亟成，故射天笞地，斩社稷而焚灭之，以示威服鬼神。为长夜之饮于室中，室中人呼万岁，则堂上之人应之，堂下之人又应之，门外之人又应之，以至于国中，无敢不呼万岁者。天下之人谓之「桀宋」。齐湣王起兵伐之，民散，城不守。宋王奔魏，死于温。","dtjl_paragraph_links":[],"dtjl_references":[],"id":332,"number":3,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 二十九年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8ca437c4-db0e-11ef-98c3-a0d3651f611f","year_int":-286},"tongjian_id":"8ca437c4-db0e-11ef-98c3-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":11,"total_paragraphs":109},"place_name":"宋"},"message":"success","success":true}