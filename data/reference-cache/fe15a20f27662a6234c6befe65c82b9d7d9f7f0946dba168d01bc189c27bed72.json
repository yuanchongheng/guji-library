1f611f"},{"place_name":"高密縣","place_name_jianti_auto":"高密县","start_index":54,"tongjian_id":"8ca68852-db0e-11ef-8a86-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":63,"tongjian_id":"8ca68853-db0e-11ef-8695-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":68,"tongjian_id":"8ca68854-db0e-11ef-80fe-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":75,"tongjian_id":"8ca68855-db0e-11ef-a82c-a0d3651f611f"},{"place_name":"城陽","place_name_jianti_auto":"城阳","start_index":84,"tongjian_id":"8ca68856-db0e-11ef-a07d-a0d3651f611f"},{"place_name":"莒縣","place_name_jianti_auto":"莒县","start_index":86,"tongjian_id":"8ca68857-db0e-11ef-8937-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":89,"tongjian_id":"8ca68858-db0e-11ef-8d39-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":105,"tongjian_id":"8ca68859-db0e-11ef-84d4-a0d3651f611f"},{"place_name":"莒縣","place_name_jianti_auto":"莒县","start_index":107,"tongjian_id":"8ca6885a-db0e-11ef-b89b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"莒，春秋莒子之國，齊滅之。班志，莒縣屬城陽國，國都也。宋白曰：周武王封少昊之後嬴姓茲輿於莒，始都計斤城，在今高密縣東南四十里。春秋時徙於莒。隱公二年，莒人入向。註云：今城陽莒縣。莒自初封二十三君，爲楚簡王所滅。漢爲莒縣，城陽王所都。莒，音居禦翻。","note_content_jianti_auto":"莒，春秋莒子之国，齐灭之。班志，莒县属城阳国，国都也。宋白曰：周武王封少昊之后嬴姓兹舆于莒，始都计斤城，在今高密县东南四十里。春秋时徙于莒。隐公二年，莒人入向。注云：今城阳莒县。莒自初封二十三君，为楚简王所灭。汉为莒县，城阳王所都。莒，音居御翻。","note_type":"hu_note","start_index":52,"tongjian_id":"8ca68840-db0e-11ef-b40d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"康","people_name_jianti_auto":"康","start_index":10,"tongjian_id":"8ca6885e-db0e-11ef-b2a6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：淖，女敎翻；康曰：竹角切；姓也。相，息亮翻。","note_content_jianti_auto":"索隐曰：淖，女教翻；康曰：竹角切；姓也。相，息亮翻。","note_type":"hu_note","start_index":75,"tongjian_id":"8ca6885d-db0e-11ef-90f6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":5,"tongjian_id":"8ca68861-db0e-11ef-a591-a0d3651f611f"},{"people_name":"宋祁","people_name_jianti_auto":"宋祁","start_index":15,"tongjian_id":"8ca68862-db0e-11ef-b989-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"數其罪也。師古曰：數，所具翻；宋祁曰：所主翻。","note_content_jianti_auto":"数其罪也。师古曰：数，所具翻；宋祁曰：所主翻。","note_type":"hu_note","start_index":82,"tongjian_id":"8ca68860-db0e-11ef-bed4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"8ca68864-db0e-11ef-bb94-a0d3651f611f"},{"place_name":"千乘郡","place_name_jianti_auto":"千乘郡","start_index":2,"tongjian_id":"8ca68865-db0e-11ef-90f9-a0d3651f611f"},{"place_name":"博昌縣","place_name_jianti_auto":"博昌县","start_index":6,"tongjian_id":"8ca68866-db0e-11ef-8aa1-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":12,"tongjian_id":"8ca68867-db0e-11ef-ac33-a0d3651f611f"},{"place_name":"千乘郡","place_name_jianti_auto":"千乘郡","start_index":15,"tongjian_id":"8ca68868-db0e-11ef-abbf-a0d3651f611f"},{"place_name":"樂安國","place_name_jianti_auto":"乐安国","start_index":19,"tongjian_id":"8ca68869-db0e-11ef-9514-a0d3651f611f"},{"place_name":"昌水","place_name_jianti_auto":"昌水","start_index":29,"tongjian_id":"8ca6886a-db0e-11ef-bce1-a0d3651f611f"},{"place_name":"博昌","place_name_jianti_auto":"博昌","start_index":38,"tongjian_id":"8ca6886b-db0e-11ef-b089-a0d3651f611f"},{"place_name":"千乘","place_name_jianti_auto":"千乘","start_index":44,"tongjian_id":"8ca6886c-db0e-11ef-a032-a0d3651f611f"},{"place_name":"博昌","place_name_jianti_auto":"博昌","place_note":"山東博興东南二十里寨郝镇南","start_index":47,"tongjian_id":"8ca6886d-db0e-11ef-89dd-a0d3651f611f"},{"place_name":"青州","place_name_jianti_auto":"青州","start_index":53,"tongjian_id":"8ca6886e-db0e-11ef-a0a9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢置千乘郡，博昌縣屬焉。後漢更千乘郡爲樂安國。十三州志曰：昌水，其勢平，故曰博昌。唐志，千乘、博昌二縣皆屬青州。乘，繩證翻。雨，王遇翻。自上而下曰雨。","note_content_jianti_auto":"汉置千乘郡，博昌县属焉。后汉更千乘郡为乐安国。十三州志曰：昌水，其势平，故曰博昌。唐志，千乘、博昌二县皆属青州。乘，绳证翻。雨，王遇翻。自上而下曰雨。","note_type":"hu_note","start_index":103,"tongjian_id":"8ca68863-db0e-11ef-9e6a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8ca68872-db0e-11ef-bca5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"嬴","place_name_jianti_auto":"嬴","place_note":"山東萊蕪","start_index":3,"tongjian_id":"8ca68873-db0e-11ef-ab45-a0d3651f611f"},{"place_name":"博","place_name_jianti_auto":"博","place_note":"山東泰安","start_index":5,"tongjian_id":"8ca68874-db0e-11ef-be39-a0d3651f611f"},{"place_name":"泰山郡","place_name_jianti_auto":"泰山郡","start_index":9,"tongjian_id":"8ca68875-db0e-11ef-bf8f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，嬴、博二縣屬泰山郡。","note_content_jianti_auto":"班志，嬴、博二县属泰山郡。","note_type":"hu_note","start_index":128,"tongjian_id":"8ca68871-db0e-11ef-97b3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛晃","people_name_jianti_auto":"毛晃","start_index":12,"tongjian_id":"8ca68878-db0e-11ef-85fe-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"誡，與戒同；戒，警敕也。毛晃曰：警敕之辭曰誡。此言天、地、人皆以相警敕也。","note_content_jianti_auto":"诫，与戒同；戒，警敕也。毛晃曰：警敕之辞曰诫。此言天、地、人皆以相警敕也。","note_type":"hu_note","start_index":231,"tongjian_id":"8ca68877-db0e-11ef-b314-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鼓里","place_name_jianti_auto":"鼓里","place_note":"山東莒縣南","start_index":0,"tongjian_id":"8ca6887a-db0e-11ef-ba3d-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":3,"tongjian_id":"8ca6887b-db0e-11ef-b414-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":9,"tongjian_id":"8ca6887c-db0e-11ef-ad05-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鼓里，莒中地名，近齊廟。","note_content_jianti_auto":"鼓里，莒中地名，近齐庙。","note_type":"hu_note","start_index":244,"tongjian_id":"8ca68879-db0e-11ef-8e94-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca6883e-db0e-11ef-ae75-a0d3651f611f","pinyin":"zhuō","source_anchor_text":"走莒楚使淖齒將兵救","source_key":"baiyang_epub","start_index":54,"text":"淖","tongjian_id":"cbe31b2b-00cc-5002-ab0e-f859a2c7c01f"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8ca6883e-db0e-11ef-ae75-a0d3651f611f","pinyin":"chè","source_anchor_text":"博之間地坼及泉王知","source_key":"baiyang_epub","start_index":124,"text":"坼","tongjian_id":"6c12d2ac-71c8-5af9-8229-41b9d808a8de"}],"ExtRef_Children_places":[{"place_name":"鄒","place_name_jianti_auto":"邹","place_note":"山东邹县","resolved_place_entity_id":4092,"start_index":34,"tongjian_id":"8ca68883-db0e-11ef-9ce6-a0d3651f611f"},{"place_name":"鄒","place_name_jianti_auto":"邹","resolved_place_entity_id":4092,"start_index":42,"tongjian_id":"8ca68885-db0e-11ef-b33b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、青州府（卷三十五）","excerpts":[{"context_after":"是也]。","context_before":"...里。今详见安丘之渠丘亭。又鼓里，在故莒城内，《战国策》：","source_end_index":92,"source_paragraph_tongjian_id":"5b90ecd7-b116-50c0-a85e-a4920cfbde66","source_start_index":82,"source_text":"淖齿杀齐湣王于鼓里。"}],"path":"山东方舆纪要/五、青州府（卷三十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"齊王出亡之衞，衞君辟宮舍之，稱臣而共具。齊王不遜，衞人侵之。齊王去奔鄒、魯，有驕色；鄒、魯弗內，遂走莒。楚使淖齒將兵救齊，因爲齊相。淖齒欲與燕分齊地，乃執湣王而數之曰：「千乘、博昌之間，方數百里，雨血沾衣，王知之乎？」曰：「知之。」「嬴、博之間，地坼及泉，王知之乎？」曰：「知之。」「有人當闕而哭者，求之不得，去則聞其聲，王知之乎？」曰：「知之。」淖齒曰：「天雨血沾衣者，天以告也；地坼及泉者，地以告也；有人當闕而哭者，人以告也。天、地、人皆告矣，而王不知誡焉，何得無誅！」遂弑王於鼓里。","content_fanyi":"齐湣王逃往卫国，卫国国君让出宫室供他居住，向他称臣并供奉酒食器具。齐湣王傲慢不逊，卫国人气愤地攻击他。齐湣王离开卫国，投奔邹国、鲁国，仍然面有骄色；邹国、鲁国不接纳他，于是逃往莒邑。楚国派淖齿率领军队援救齐国，淖齿因此被任命为齐国国相。淖齿想与燕国瓜分齐国土地，便囚禁了齐湣王，当面列举他的罪状说：“千乘和博昌之间方圆数百里的地方，天降血雨沾湿了百姓的衣裳，大王知道吗？”齐湣王说：“知道。”“嬴地和博地之间，大地裂开的深沟直达泉水涌出的地方，大王知道吗？”齐湣王回答说：“知道。”“有人对着阙门哭泣，去找他却找不到，离开阙门时又听到哭声，大王知道吗？”齐湣王回答说：“知道。”淖齿说：“天降血雨沾湿衣裳，是上天给你的警告；大地裂开深沟直达泉水涌出的地方，是大地给你的警告；有人对着阙门哭泣，是人给你的警告。天、地、人都已经警告了，大王却不知道警戒，怎么能不杀你！”于是在鼓里弑杀了齐湣王。","content_jianti_auto":"齐王出亡之衞，衞君辟宫舍之，称臣而共具。齐王不逊，衞人侵之。齐王去奔邹、鲁，有骄色；邹、鲁弗内，遂走莒。楚使淖齿将兵救齐，因为齐相。淖齿欲与燕分齐地，乃执湣王而数之曰：「千乘、博昌之间，方数百里，雨血沾衣，王知之乎？」曰：「知之。」「嬴、博之间，地坼及泉，王知之乎？」曰：「知之。」「有人当阙而哭者，求之不得，去则闻其声，王知之乎？」曰：「知之。」淖齿曰：「天雨血沾衣者，天以告也；地坼及泉者，地以告也；有人当阙而哭者，人以告也。天、地、人皆告矣，而王不知诫焉，何得无诛！」遂弑王于鼓里。","dtjl_paragraph_links":[],"dtjl_references":[],"id":338,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 三十一年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8ca6883e-db0e-11ef-ae75-a0d3651f611f","year_int":-284},"tongjian_id":"8ca6883e-db0e-11ef-ae75-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"鄒","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚元王","people_name_jianti_auto":"楚元王","start_index":0,"tongjian_id":"8f218a05-db0e-11ef-a560-a0d3651f611f"},{"people_name":"交","people_name_jianti_auto":"交","start_index":3,"to