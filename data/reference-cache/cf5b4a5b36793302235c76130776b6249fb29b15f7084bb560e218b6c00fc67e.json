{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁丑、前二二四）","note_content_jianti_auto":"（丁丑、前二二四）","note_type":"hu_note","start_index":0,"tongjian_id":"8d65acd8-db0e-11ef-9978-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"數，所角翻。挑戰者，擿撓敵以求戰也。挑，徒了翻。","note_content_jianti_auto":"数，所角翻。挑战者，擿挠敌以求战也。挑，徒了翻。","note_type":"hu_note","start_index":44,"tongjian_id":"8d65acda-db0e-11ef-963b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":0,"tongjian_id":"8d65acdd-db0e-11ef-920c-a0d3651f611f"},{"people_name":"裴駰","people_name_jianti_auto":"裴骃","start_index":14,"tongjian_id":"8d65acde-db0e-11ef-962b-a0d3651f611f"},{"people_name":"甘延壽","people_name_jianti_auto":"甘延寿","start_index":23,"tongjian_id":"8d65acdf-db0e-11ef-a42f-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":36,"tongjian_id":"8d65ace0-db0e-11ef-a9ff-a0d3651f611f"},{"people_name":"范蠡","people_name_jianti_auto":"范蠡","start_index":40,"tongjian_id":"8d65ace1-db0e-11ef-90e1-a0d3651f611f"},{"people_name":"延壽","people_name_jianti_auto":"延寿","start_index":61,"tongjian_id":"8d65ace2-db0e-11ef-8026-a0d3651f611f"},{"people_name":"高固","people_name_jianti_auto":"高固","start_index":103,"tongjian_id":"8d65ace3-db0e-11ef-954c-a0d3651f611f"},{"people_name":"魏犨","people_name_jianti_auto":"魏犨","start_index":123,"tongjian_id":"8d65ace4-db0e-11ef-9cb4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":102,"tongjian_id":"8d65ace5-db0e-11ef-984f-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":122,"tongjian_id":"8d65ace6-db0e-11ef-a7d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徐廣曰：「超」，一作「拔」。裴駰曰：據漢書云：甘延壽投石拔距，絕於等倫。張晏曰：范蠡兵法：飛石重十二斤，爲機發，行三百步。延壽有力，能手投之。拔距，猶超距也。索隱曰：超距，猶跳躍也。余謂投石，以石投人也，齊高固「桀石以投人」是也。超距，距躍也，晉魏犨「距躍三百」是也。","note_content_jianti_auto":"徐广曰：「超」，一作「拔」。裴骃曰：据汉书云：甘延寿投石拔距，绝于等伦。张晏曰：范蠡兵法：飞石重十二斤，为机发，行三百步。延寿有力，能手投之。拔距，犹超距也。索隐曰：超距，犹跳跃也。余谓投石，以石投人也，齐高固「桀石以投人」是也。超距，距跃也，晋魏犨「距跃三百」是也。","note_type":"hu_note","start_index":99,"tongjian_id":"8d65acdc-db0e-11ef-9c2a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d65aceb-db0e-11ef-903c-a0d3651f611f"},{"people_name":"康","people_name_jianti_auto":"康","start_index":20,"tongjian_id":"8d65acec-db0e-11ef-bb74-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","start_index":3,"tongjian_id":"8d65aced-db0e-11ef-816b-a0d3651f611f"},{"place_name":"蘄縣","place_name_jianti_auto":"蕲县","start_index":6,"tongjian_id":"8d65acee-db0e-11ef-8dff-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":15,"tongjian_id":"8d65acef-db0e-11ef-a4be-a0d3651f611f"},{"place_name":"江夏","place_name_jianti_auto":"江夏","start_index":23,"tongjian_id":"8d65acf0-db0e-11ef-8bc2-a0d3651f611f"},{"place_name":"蘄春","place_name_jianti_auto":"蕲春","start_index":26,"tongjian_id":"8d65acf1-db0e-11ef-939f-a0d3651f611f"},{"place_name":"蘄","place_name_jianti_auto":"蕲","start_index":34,"tongjian_id":"8d65acf2-db0e-11ef-a270-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，沛郡有蘄縣。史記正義曰：徐州縣也。康以爲江夏之蘄春，其誤甚矣。蘄，渠之翻，又音機。","note_content_jianti_auto":"班志，沛郡有蕲县。史记正义曰：徐州县也。康以为江夏之蕲春，其误甚矣。蕲，渠之翻，又音机。","note_type":"hu_note","start_index":139,"tongjian_id":"8d65acea-db0e-11ef-b972-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"項燕","people_name_jianti_auto":"项燕","start_index":0,"tongjian_id":"8d65acf6-db0e-11ef-8663-a0d3651f611f"},{"people_name":"項梁","people_name_jianti_auto":"项梁","start_index":3,"tongjian_id":"8d65acf7-db0e-11ef-ae35-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"項燕，項梁之父也。燕，烏賢翻。","note_content_jianti_auto":"项燕，项梁之父也。燕，乌贤翻。","note_type":"hu_note","start_index":146,"tongjian_id":"8d65acf5-db0e-11ef-9efe-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"將軍","official_note":"將軍是古代軍隊中的高級指揮官，負責統領軍隊作戰。在《資治通鑑》此段中，項燕作為楚國的將軍，被秦軍擊殺，標誌著楚軍的敗退，反映了秦滅楚戰爭的關鍵轉折點。","official_rank":"未知","source_snippet":"殺其將軍項燕","start_index":124,"tongjian_id":"55a4d7f8-2949-4fd4-8104-858662cb4045"}],"ExtRef_Children_people":[{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","people_xingming":"王翦","start_index":1,"tongjian_id":"8d65acf8-db0e-11ef-862c-a0d3651f611f"},{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","start_index":14,"tongjian_id":"8d65acf9-db0e-11ef-a814-a0d3651f611f"},{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与