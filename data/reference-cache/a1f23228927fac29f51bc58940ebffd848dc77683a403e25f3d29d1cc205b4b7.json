:"8bfd66de-db0e-11ef-ab2c-a0d3651f611f"},{"place_name":"平陸縣","place_name_jianti_auto":"平陆县","start_index":50,"tongjian_id":"8bfd66df-db0e-11ef-b252-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","place_note":"府曲阜，山东曲阜","start_index":57,"tongjian_id":"8bfd66e0-db0e-11ef-8cf4-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":59,"tongjian_id":"8bfd66e1-db0e-11ef-ae5c-a0d3651f611f"},{"place_name":"平陸","place_name_jianti_auto":"平陆","start_index":62,"tongjian_id":"8bfd66e2-db0e-11ef-a10f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，東平國有東平陸縣，戰國時之平陸也。史記正義曰：平陸，兗州縣，卽古厥國。宋白曰：鄆州中都縣，漢爲平陸縣，史記「魯敗齊師于平陸」是也。敗，補邁翻。","note_content_jianti_auto":"班志，东平国有东平陆县，战国时之平陆也。史记正义曰：平陆，兖州县，即古厥国。宋白曰：郓州中都县，汉为平陆县，史记「鲁败齐师于平陆」是也。败，补迈翻。","note_type":"hu_note","start_index":9,"tongjian_id":"8bfd66d2-db0e-11ef-a102-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平陸","place_name_jianti_auto":"平陆","resolved_place_entity_id":2619,"start_index":6,"tongjian_id":"8bfd66e8-db0e-11ef-8566-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"又威王二十三年，与赵王会平陆。《韩非子》：魏安釐王加兵于...","context_before":"...陆城，在县北。战国时齐邑。孟子之平陆，又处于平陆。是也。","source_end_index":170,"source_paragraph_tongjian_id":"a638e79b-241e-5774-b51e-f1e9519aa5b4","source_start_index":147,"source_text":"《史记·齐世家》：康公十五年，鲁败齐师于平陆。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3魯敗齊師于平陸。","content_fanyi":"鲁国军队在平陆击败了齐国军队。","content_jianti_auto":"3鲁败齐师于平陆。","dtjl_paragraph_links":[],"dtjl_references":[],"id":53,"number":3,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 十二年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8bfd66d1-db0e-11ef-8e7f-a0d3651f611f","year_int":-390},"tongjian_id":"8bfd66d1-db0e-11ef-8e7f-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"平陸","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平陸","place_name_jianti_auto":"平陆","resolved_place_entity_id":2619,"start_index":8,"tongjian_id":"8c27e654-db0e-11ef-a5bc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2趙、齊、宋會于平陸。","content_fanyi":"赵国、齐国、宋国在平陆会合。","content_jianti_auto":"2赵、齐、宋会于平陆。","dtjl_paragraph_links":[],"dtjl_references":[],"id":134,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c27e650-db0e-11ef-a14e-a0d3651f611f","year_int":-356},"tongjian_id":"8c27e650-db0e-11ef-a14e-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"平陸","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"平陸縣","place_name_jianti_auto":"平陆县","start_index":0,"tongjian_id":"a7245ff5-db0e-11ef-8848-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"a7245ff6-db0e-11ef-953d-a0d3651f611f"},{"place_name":"東平郡","place_name_jianti_auto":"东平郡","start_index":8,"tongjian_id":"a7245ff7-db0e-11ef-a81b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"平陸縣自漢以來屬東平郡。","note_content_jianti_auto":"平陆县自汉以来属东平郡。","note_type":"hu_note","start_index":8,"tongjian_id":"a7245ff4-db0e-11ef-b808-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平陸","place_name_jianti_auto":"平陆","resolved_place_entity_id":2619,"start_index":1,"tongjian_id":"a7245ffa-db0e-11ef-9f81-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9平陸令河南成粲復勸王弘遜位，弘從之，累表陳請。帝不得已，六月，庚戌，以弘爲衞將軍、開府儀同三司。","content_fanyi":"刘宋平陆县令、河南人成粲再次劝说担任司徒的王弘逊位，王弘听从了他的建议，接连上表陈请辞职。刘宋文帝刘义隆不得已，在六月十四日庚戌，调任王弘为卫将军、开府仪同三司。","content_jianti_auto":"9平陆令河南成粲复劝王弘逊位，弘从之，累表陈请。帝不得已，六月，庚戌，以弘为衞将军、开府仪同三司。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11054,"number":9,"path":"资治通鉴 : 卷第一百二十一 (宋紀三) / 太祖文皇帝上之中 / 元嘉五年 / 第 14 段","reading_annotation_sources":[],"start_index":13,"tongjian_id":"a7245ff3-db0e-11ef-b57b-a0d3651f611f","year_int":428},"tongjian_id":"a7245ff3-db0e-11ef-b57b-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"平陸","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"煬帝","people_name_jianti_auto":"炀帝","start_index":0,"tongjian_id":"b6b201ad-db0e-11ef-aa06-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"青州","place_name_jianti_auto":"青州","start_index":3,"tongjian_id":"b6b201ae-db0e-11ef-b2df-a0d3651f611f"},{"place_name":"北海郡","place_name_jianti_auto":"北海郡","start_index":6,"tongjian_id":"b6b201af-db0e-11ef-affa-a0d3651f611f"},{"place_name":"文登縣","place_name_jianti_auto":"文登县","start_index":16,"tongjian_id":"b6b201b0-db0e-11ef-98cf-a0d3651f611f"},{"place_name":"東萊郡","place_name_jianti_auto":"东莱郡","start_index":20,"tongjian_id":"b6b201b1-db0e-11ef-9748-a0d3651f611f"},{"place_name":"海州","place_name_jianti_auto":"海州","start_index":25,"tongjian_id":"b6b201b2-db0e-11ef-bf6f-a0d3651f611f"},{"place_name":"東海郡","place_name_jianti_auto":"东海郡","start_index":28,"tongjian_id":"b6b201b3-db0e-11ef-967b-a0d3651f611f"},{"place_name":"齊州","place_name_jianti_auto":"齐州","place_note":"齐郡改•总部设山东省济南市","start_index":32,"tongjian_id":"b6b201b4-db0e-11ef-8d88-a0d3651f611f"},{"place_name":"齊郡","place_name_jianti_auto":"齐郡","start_index":35,"tongjian_id":"b6b201b5-db0e-11ef-80ed-a0d3651f611f"},{"place_name":"鄆州","place_name_jianti_auto":"郓州","start_index":38,"tongjian_id":"b6b201b6-db0e-11ef-b22b-a0d3651f611f"},{"place_name":"東平郡","place_name_jianti_auto":"东平郡","start_index":41,"tongjian_id":"b6b201b7-db0e-11ef-8de8-a0d3651f611f"},{"place_name":"須昌縣","place_name_jianti_auto":"须昌县","start_index":45,"tongjian_id":"b6b201b8-db0e-11ef-b80f-a0d3651f611f"},{"place_name":"任城","place_name_jianti_auto":"任城","place_note":"山东省济宁市","start_index":51,"tongjian_id":"b6b201b9-db0e-11ef-8b2c-a0d3651f611f"},{"place_name":"平陸","place_name_jianti_auto":"平陆","place_note":"山东省汶上县西","start_index":54,"tongjian_id":"b6b201ba-db0e-11ef-af36-a0d3651f611f"},{"place_name":"魯郡","place_name_jianti_auto":"鲁郡","start_index":59,"tongjian_id":"b6b201bb-db0e-11ef-be09-a0d3651f611f"},{"place_name":"壽張縣","place_name_jianti_auto":"寿张县","start_index":62,"tongjian_id":"b6b201bc-db0e-11ef-94a0-a0d3651f611f"},{"place_name":"濟北郡","place_name_jianti_auto":"济北郡","start_index":66,"tongjian_id":"b6b201bd-db0e-11ef-8e10-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"煬帝以青州爲北海郡。守，式又翻。文登縣屬東萊郡。以海州爲東海郡，齊州爲齊郡，鄆州爲東平郡，須昌縣屬焉。任城、平陸二縣屬魯郡，壽張縣屬濟北郡。任，音壬。帥，所類翻。降，戶江翻。","note_content_jianti_auto":"炀帝以青州为北海郡。守，式又翻。文登县属东莱郡。以海州为东海郡，齐州为齐郡，郓州为东平郡，须昌县属焉。任城、平陆二县属鲁郡，寿张县属济北郡。任，音壬。帅，所类翻。降，户江翻。","note_type":"hu_note","start_index":53,"tongjian_id":"b6b201ac-db0e-11ef-8e24-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平陸","place_name_jianti_auto":"平陆","place_note":"山东省汶上县西","resolved_place_entity_id":2619,"start_index":33,"tongjian_id":"b6b201c8-db0e-11ef-a9ee-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"31庚辰，隋北海通守鄭虔符、文登令方惠整及東海、齊郡、東平、任城、平陸、壽張、須昌賊帥王薄等並以其地來降。","content_fanyi":"三月十一日庚辰，隋朝北海郡通守郑虔符、文登县令方惠整，以及东海、齐郡、东平、任城、平陆、寿张、须昌的贼帅王薄等人，都各自献出所据之地，归降唐朝。","content_jianti_auto":"31庚辰，隋北海通守郑虔符、文登令方惠整及东海、齐郡、东平、任城、平陆、寿张、须昌贼帅王薄等并以其地来降。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18004,"number":31,"path":"资治通鉴 : 卷第一百八十七 (唐紀三) / 高祖神堯大聖光孝皇帝上之下 / 武德二年 / 第 38 段","reading_annotation_sources":[],"start_index":37,"tongjian_id":"b6b201ab-db0e-11ef-b6c0-a0d3651f611f","year_int":619},"tongjian_id":"b6b201ab-db0e-11ef-b6c0-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"平陸","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李齊物","people_name_jianti_auto":"李齐物","start_index":36,"tongjian_id":"cb95bc63-db0e-11ef-978f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陝州","place_name_jianti_auto":"陕州","start_index":18,"tongjian_id":"cb95bc64-db0e-11ef-b60d-a0d3651f611f"},{"place_name":"河北縣","place_name_jianti_auto":"河北县","start_index":20,"tongjian_id":"cb95bc65-db0e-11ef-81e6-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":24,"tongjian_id":"cb95bc66-db0e-11ef-8de4-a0d3651f611f"},{"place_name":"大陽縣","place_name_jianti_auto":"大阳县","start_index":25,"tongjian_id":"cb95bc67-db0e-11ef-974f-a0d3651f611f"},{"place_name":"三門","place_name_jianti_auto":"三门","start_index":40,"tongjian_id":"cb95bc68-db0e-11ef-be49-a0d3651f611f"},{"place_name":"河北縣","place_name_jianti_auto":"河北县","start_index":62,"tongjian_id":"cb95bc69-db0e-11ef-8e89-a0d3651f611f"},{"place_name":"平陸縣","place_name_jianti_auto":"平陆县","start_index":66,"tongjian_id":"cb95bc6a-db0e-11ef-8438-a0d3651f611f"},{"place_name":"陝州","place_name_jianti_auto":"陕州","start_index":76,"tongjian_id":"cb95bc6b-db0e-11ef-88ba-a0d3651f611f"},{"place_name":"大河","place_name_jianti_auto":"大河","start_index":83,"tongjian_id":"cb95bc6c-db0e-11ef-afc4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，才用翻。唐書·地理志曰：括地志：陝州河北縣本漢大陽縣，天寶元年，太守李齊物開三門以利漕運，得古刃，有篆文曰「平陸」，因更河北縣爲平陸縣。九域志：縣在陝州北五里，隔大河。","note_content_jianti_auto":"从，才用翻。唐书·地理志曰：括地志：陕州河北县本汉大阳县，天宝元年，太守李齐物开三门以利漕运，得古刃，有篆文曰「平陆」，因更河北县为平陆县。九域志：县在陕州北五里，隔大河。","note_type":"hu_note","start_index":25,"tongjian_id":"cb95bc62-db0e-11ef-8c97-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平陸","place_name_jianti_auto":"平陆","place_note":"山西平陆县","resolved_place_entity_id":2620,"start_index":22,"tongjian_id":"cb95bc75-db0e-11ef-8eae-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"李紹榮欲奔河中就永王存霸，從兵稍散；庚寅，至平陸，止餘數騎，爲人所執，折足送洛陽。存霸亦帥衆千人棄鎭奔晉陽。","content_fanyi":"李绍荣打算投奔河中的永王李存霸，随行士兵逐渐逃散；庚寅日到平陆时，仅剩几名骑兵，被人捉住，脚被打断后送往洛阳。李存霸也率领部众一千余人放弃镇所逃奔晋阳。","content_jianti_auto":"李绍荣欲奔河中就永王存霸，从兵稍散；庚寅，至平陆，止余数骑，为人所执，折足送洛阳。存霸亦帅众千人弃镇奔晋阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28553,"path":"资治通鉴 : 卷第二百七十五 (後唐紀四) / 明宗聖德和武欽孝皇帝上之下 / 天成元年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"cb95bc61-db0e-11ef-98f9-a0d3651f611f","year_int":926},"tongjian_id":"cb95bc61-db0e-11ef-98f9-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"平陸","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtR