jian_id":"8c65cf7c-db0e-11ef-add1-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","start_index":200,"tongjian_id":"8c65cf7d-db0e-11ef-aabf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：此丹陽在漢中。劉昭曰：南郡枝江縣有丹陽聚，卽秦破楚處。李𡌴輿地紀勝曰：丹陽在今歸州秭歸縣東八里屈沱楚王城是也。余按楚遣屈匄伐秦，秦發兵逆擊之，枝江之丹陽則距郢逼近，秭歸之丹陽則不當秦、楚之路。索隱因下文遂取漢中，卽謂丹陽在漢中，皆非也。此丹陽謂丹水之陽。班志：丹水出上洛冢嶺山，東至析入鈞水，其水蓋在弘農丹水、析兩縣之間，武關之外也。秦、楚交戰當在此水之陽。楚師旣敗，秦師乘勝取上庸路西入以收漢中，其勢易矣。索，山客翻。𡌴，與埴同。屈，九勿翻。冢，知隴翻。易，弋豉翻。","note_content_jianti_auto":"索隐曰：此丹阳在汉中。刘昭曰：南郡枝江县有丹阳聚，即秦破楚处。李𡌴舆地纪胜曰：丹阳在今归州秭归县东八里屈沱楚王城是也。余按楚遣屈匄伐秦，秦发兵逆击之，枝江之丹阳则距郢逼近，秭归之丹阳则不当秦、楚之路。索隐因下文遂取汉中，即谓丹阳在汉中，皆非也。此丹阳谓丹水之阳。班志：丹水出上洛冢岭山，东至析入钧水，其水盖在弘农丹水、析两县之间，武关之外也。秦、楚交战当在此水之阳。楚师既败，秦师乘胜取上庸路西入以收汉中，其势易矣。索，山客翻。𡌴，与埴同。屈，九勿翻。冢，知陇翻。易，弋豉翻。","note_type":"hu_note","start_index":12,"tongjian_id":"8c65cf50-db0e-11ef-baad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":3,"tongjian_id":"8c65cf83-db0e-11ef-b598-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"執珪，楚爵也，執珪而朝者也。","note_content_jianti_auto":"执珪，楚爵也，执珪而朝者也。","note_type":"hu_note","start_index":37,"tongjian_id":"8c65cf82-db0e-11ef-b6aa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃義仲","people_name_jianti_auto":"黄义仲","start_index":36,"tongjian_id":"8c65cf85-db0e-11ef-9cd9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沔陽","place_name_jianti_auto":"沔阳","start_index":1,"tongjian_id":"8c65cf86-db0e-11ef-8c7b-a0d3651f611f"},{"place_name":"成固","place_name_jianti_auto":"成固","start_index":4,"tongjian_id":"8c65cf87-db0e-11ef-a2f9-a0d3651f611f"},{"place_name":"新城","place_name_jianti_auto":"新城","start_index":7,"tongjian_id":"8c65cf88-db0e-11ef-a09f-a0d3651f611f"},{"place_name":"上庸","place_name_jianti_auto":"上庸","start_index":10,"tongjian_id":"8c65cf89-db0e-11ef-9e9f-a0d3651f611f"},{"place_name":"漢中郡","place_name_jianti_auto":"汉中郡","start_index":15,"tongjian_id":"8c65cf8a-db0e-11ef-adad-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自沔陽、成固至新城、上庸，時皆漢中郡之地。釋名曰：郡，羣也，人所羣聚也。黃義仲十三州記曰：郡之言君也。改公侯之封而言君者，至尊也。今郡字，「君」在其左，「邑」在其右，君爲元首，邑以載民，故取名於君，謂之郡。","note_content_jianti_auto":"自沔阳、成固至新城、上庸，时皆汉中郡之地。释名曰：郡，群也，人所群聚也。黄义仲十三州记曰：郡之言君也。改公侯之封而言君者，至尊也。今郡字，「君」在其左，「邑」在其右，君为元首，邑以载民，故取名于君，谓之郡。","note_type":"hu_note","start_index":43,"tongjian_id":"8c65cf84-db0e-11ef-a2a0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c65cf8f-db0e-11ef-b0be-a0d3651f611f"},{"people_name":"秦孝公","people_name_jianti_auto":"秦孝公","start_index":10,"tongjian_id":"8c65cf90-db0e-11ef-ad17-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"藍田縣","place_name_jianti_auto":"蓝田县","start_index":3,"tongjian_id":"8c65cf91-db0e-11ef-a131-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":7,"tongjian_id":"8c65cf92-db0e-11ef-b7aa-a0d3651f611f"},{"place_name":"藍田縣","place_name_jianti_auto":"蓝田县","start_index":21,"tongjian_id":"8c65cf93-db0e-11ef-bd02-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":25,"tongjian_id":"8c65cf94-db0e-11ef-973d-a0d3651f611f"},{"place_name":"藍田關","place_name_jianti_auto":"蓝田关","start_index":34,"tongjian_id":"8c65cf95-db0e-11ef-b2db-a0d3651f611f"},{"place_name":"藍田縣","place_name_jianti_auto":"蓝田县","start_index":38,"tongjian_id":"8c65cf96-db0e-11ef-a2f9-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":43,"tongjian_id":"8c65cf97-db0e-11ef-a367-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":45,"tongjian_id":"8c65cf98-db0e-11ef-9407-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，藍田縣屬京兆，秦孝公置。史記正義曰：藍田縣在雍州東南八十里。從藍田關入藍田縣，時楚襲秦深入。","note_content_jianti_auto":"班志，蓝田县属京兆，秦孝公置。史记正义曰：蓝田县在雍州东南八十里。从蓝田关入蓝田县，时楚袭秦深入。","note_type":"hu_note","start_index":60,"tongjian_id":"8c65cf8e-db0e-11ef-8322-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":9,"tongjian_id":"8c65cf9c-db0e-11ef-b7b6-a0d3651f611f"},{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":19,"tongjian_id":"8c65cf9d-db0e-11ef-92ce-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄧","place_name_jianti_auto":"邓","start_index":0,"tongjian_id":"8c65cf9e-db0e-11ef-8970-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":2,"tongjian_id":"8c65cf9f-db0e-11ef-a261-a0d3651f611f"},{"place_name":"鄧國","place_name_jianti_auto":"邓国","start_index":4,"tongjian_id":"8c65cfa0-db0e-11ef-b55b-a0d3651f611f"},{"place_name":"鄧縣","place_name_jianti_auto":"邓县","start_index":12,"tongjian_id":"8c65cfa1-db0e-11ef-8894-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":15,"tongjian_id":"8c65cfa2-db0e-11ef-99b0-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":23,"tongjian_id":"8c65cfa3-db0e-11ef-9220-a0d3651f611f"},{"place_name":"召陵縣","place_name_jianti_auto":"召陵县","start_index":25,"tongjian_id":"8c65cfa4-db0e-11ef-9c95-a0d3651f611f"},{"place_name":"鄧城","place_name_jianti_auto":"邓城","start_index":30,"tongjian_id":"8c65cfa5-db0e-11ef-aa13-a0d3651f611f"},{"place_name":"鄧城","place_name_jianti_auto":"邓城","start_index":39,"tongjian_id":"8c65cfa6-db0e-11ef-845e-a0d3651f611f"},{"place_name":"豫州","place_name_jianti_auto":"豫州","start_index":42,"tongjian_id":"8c65cfa7-db0e-11ef-9d20-a0d3651f611f"},{"place_name":"郾陵縣","place_name_jianti_auto":"郾陵县","start_index":44,"tongjian_id":"8c65cfa8-db0e-11ef-bb25-a0d3651f611f"},{"place_name":"召陵","place_name_jianti_auto":"召陵","start_index":57,"tongjian_id":"8c65cfa9-db0e-11ef-9099-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄧，春秋鄧國之地。班志，鄧縣屬南陽郡。杜預曰：潁川召陵縣西有鄧城。括地志曰：故鄧城在豫州郾陵縣東三十五里，所謂在古召陵西十里者也。召，讀曰邵。","note_content_jianti_auto":"邓，春秋邓国之地。班志，邓县属南阳郡。杜预曰：颍川召陵县西有邓城。括地志曰：故邓城在豫州郾陵县东三十五里，所谓在古召陵西十里者也。召，读曰邵。","note_type":"hu_note","start_index":80,"tongjian_id":"8c65cf9b-db0e-11ef-b6d0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"列侯","official_note":"列侯是秦漢時期的爵位，通常授予有功之臣，此處在楚國戰敗中被俘，表示楚國高級貴族或官員的損失。","official_rank":"未知","source_snippet":"虜屈匄及列侯、執珪七十餘人","start_index":28,"tongjian_id":"f0cbf16c-aa8a-424a-9a4a-442a181c1ffe"},{"confidence":0.85,"official_category":"爵位","official_name":"執珪","official_note":"執珪是楚國的爵位或官職，可能與軍事或禮儀相關，此處在戰敗中被俘，反映楚國高層的潰敗。","official_rank":"未知","source_snippet":"虜屈匄及列侯、執珪七十餘人","start_index":31,"tongjian_id":"b5ba25bf-8ec4-4d74-bd3c-46d5692e417e"}],"ExtRef_Children_people":[{"link_death_year":-312,"link_td_description":"屈匄，战国时期楚国将领，于丹阳之战战败身亡。也有说法称他被俘后入秦国为相。","link_td_id":"Q10003041","link_td_number_id":1636142,"people_name":"屈匄","people_name_jianti_auto":"屈匄","people_xingming":"屈匄","start_index":24,"tongjian_id":"8c6822ba-db0e-11ef-956f-a0d3651f611f"},{"link_birth_year":-355,"link_death_year":-296,"link_td_description":"楚怀王，芈姓，熊氏，名槐，楚国君主。父为楚威王，怀王任用佞臣令尹子兰、上官大夫靳尚，宠爱郑袖，为人利令智昏，国事日非。最后被秦昭襄王所骗，监禁于秦国至死，楚人皆悲之。","link_td_id":"Q10000652","link_td_number_id":335220,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈槐","start_index":43,"tongjian_id":"8c6822bd-db0e-11ef-8ecb-a0d3651f611f","wl_zhushi":"[芈槐]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":3,"tongjian_id":"8c6822b7-db0e-11ef-b464-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto"