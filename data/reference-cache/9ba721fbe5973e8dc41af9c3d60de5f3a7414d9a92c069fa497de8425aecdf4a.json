资治通鉴》中常指魏国的国王，此处张仪游说魏王，体现了外交互动。","official_rank":"未知","source_snippet":"儀因說魏王曰","start_index":48,"tongjian_id":"1b90bbce-171a-4c2c-9229-01eff8ada9e4"},{"confidence":0.85,"official_category":"中枢机构","official_name":"相秦","official_note":"相秦指担任秦国的相国，是高级官职，负责辅佐君主处理政务，此处表示张仪回国后被任命为秦相。","official_rank":"未知","source_snippet":"張儀歸而相秦","start_index":78,"tongjian_id":"0aea9189-9b78-4c4a-a6d2-083c2fa138da"}],"ExtRef_Children_people":[{"people_name":"公子華","people_name_jianti_auto":"公子华","people_xingming":"公子华","start_index":2,"tongjian_id":"8c43808a-db0e-11ef-bf51-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":6,"tongjian_id":"8c43808b-db0e-11ef-9506-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","start_index":18,"tongjian_id":"8c43808f-db0e-11ef-b45f-a0d3651f611f"},{"link_birth_year":-356,"link_death_year":-311,"link_td_description":"秦惠文王，又称秦惠王或秦惠文君，嬴姓，考古名骃，传世名驷，秦孝公之子，称王前为伯爵，称秦伯骃或秦伯驷。在位期间称王，秦国称王自嬴驷始，并重用樗里疾、张仪等人。","link_td_id":"Q10001806","link_td_number_id":176314,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴驷","start_index":22,"tongjian_id":"8c438090-db0e-11ef-8fbc-a0d3651f611f","wl_zhushi":"[嬴驷]"},{"link_td_description":"公子繇，嬴姓，马非百《秦集史》认为他是秦惠文王的庶子。","link_td_id":"Q10014031","link_td_number_id":1709912,"people_name":"公子繇","people_name_jianti_auto":"公子繇","people_xingming":"公子繇","start_index":35,"tongjian_id":"8c438091-db0e-11ef-9bed-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"儀","people_name_jianti_auto":"仪","people_xingming":"张仪","start_index":42,"tongjian_id":"8c438095-db0e-11ef-864a-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏王","people_name_jianti_auto":"魏王","people_xingming":"魏罃","start_index":45,"tongjian_id":"8c438096-db0e-11ef-9fef-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":80,"tongjian_id":"8c43809d-db0e-11ef-94c5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c43808c-db0e-11ef-8bd1-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":11,"tongjian_id":"8c43808d-db0e-11ef-b07d-a0d3651f611f"},{"place_name":"蒲陽","place_name_jianti_auto":"蒲阳","place_note":"山西隰县","resolved_place_entity_id":5242,"start_index":12,"tongjian_id":"8c43808e-db0e-11ef-b291-a0d3651f611f"},{"place_name":"蒲陽","place_name_jianti_auto":"蒲阳","resolved_place_entity_id":5242,"start_index":27,"tongjian_id":"8c438092-db0e-11ef-9631-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":31,"tongjian_id":"8c438093-db0e-11ef-804d-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":40,"tongjian_id":"8c438094-db0e-11ef-8a0f-a0d3651f611f"},{