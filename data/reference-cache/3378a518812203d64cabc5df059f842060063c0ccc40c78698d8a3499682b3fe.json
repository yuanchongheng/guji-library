{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（己未、五九）","note_content_jianti_auto":"（己未、五九）","note_type":"hu_note","start_index":0,"tongjian_id":"94f7b69c-db0e-11ef-8bb3-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宗，尊也，尊而祀之以配上帝。","note_content_jianti_auto":"宗，尊也，尊而祀之以配上帝。","note_type":"hu_note","start_index":19,"tongjian_id":"94f7b69e-db0e-11ef-a34b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"董巴","people_name_jianti_auto":"董巴","start_index":191,"tongjian_id":"94f7b6a0-db0e-11ef-8da1-a0d3651f611f"},{"people_name":"顯宗","people_name_jianti_auto":"显宗","start_index":198,"tongjian_id":"94f7b6a1-db0e-11ef-81ca-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":276,"tongjian_id":"94f7b6a2-db0e-11ef-8697-a0d3651f611f"},{"people_name":"漢明帝","people_name_jianti_auto":"汉明帝","start_index":283,"tongjian_id":"94f7b6a3-db0e-11ef-b6a5-a0d3651f611f"},{"people_name":"明帝","people_name_jianti_auto":"明帝","start_index":436,"tongjian_id":"94f7b6a4-db0e-11ef-8eb2-a0d3651f611f"},{"people_name":"歐陽氏","people_name_jianti_auto":"欧阳氏","start_index":469,"tongjian_id":"94f7b6a5-db0e-11ef-b3b0-a0d3651f611f"},{"people_name":"大","people_name_jianti_auto":"大","start_index":480,"tongjian_id":"94f7b6a6-db0e-11ef-b8ec-a0d3651f611f"},{"people_name":"小夏侯氏","people_name_jianti_auto":"小夏侯氏","start_index":482,"tongjian_id":"94f7b6a7-db0e-11ef-8cab-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陳留","place_name_jianti_auto":"陈留","start_index":268,"tongjian_id":"94f7b6a8-db0e-11ef-b92d-a0d3651f611f"},{"place_name":"襄邑","place_name_jianti_auto":"襄邑","start_index":271,"tongjian_id":"94f7b6a9-db0e-11ef-b1f5-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":393,"tongjian_id":"94f7b6aa-db0e-11ef-a17e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":414,"tongjian_id":"94f7b6ab-db0e-11ef-b3f4-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":416,"tongjian_id":"94f7b6ac-db0e-11ef-b809-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢官儀曰：天子冠通天，諸侯王冠遠遊，三公諸侯冠進賢三梁，卿大夫尚書二千石博士冠兩梁，千石以下至小吏冠一梁。天子、公卿、特進、諸侯祀天地明堂，皆冠平冕，天子十二旒，三公、九卿、諸侯七；其纓各如其綬色，玄衣纁裳。周禮曰：王祀昊天上帝，則服大裘而冕，祀五帝亦如之。三禮圖曰：冕以三十升布漆而爲之，廣八寸，長尺六寸，前圜後方，前下後高，有俛伏之形，故謂之冕。欲人之位彌高而志彌下，故以名焉。董巴輿服志曰：顯宗初服冕衣裳以祀天地。衣裳以玄上纁下，乘輿備文日月星辰十二章，三公、諸侯用山龍九章，卿已下用華蟲七章，皆五色采；乘輿刺繡，公卿已下皆織成，陳留、襄邑獻之。徐廣車服註曰：漢明帝按古禮備服章，天子郊廟衣，皁上絳下，前三幅，後四幅，衣畫而裳繡。禮記：古之君子必佩玉，君子於玉比德焉。天子佩白玉，公侯佩山玄玉，大夫佩水蒼玉，世子佩瑜玉。晉志曰：周禮弁師掌六冕，司服掌六服，自后王至庶人，各有等差。秦變古制，郊祭之服皆以袀玄，舊法掃地盡矣。漢承秦故，二百餘年，未能有所制立。及中興後，明帝乃始采周官、禮記、尚書及諸儒記說，備袞冕之服。天子車乘冠服，從歐陽氏說；公卿已下，從大、小夏侯氏說。","note_content_jianti_auto":"汉官仪曰：天子冠通天，诸侯王冠远游，三公诸侯冠进贤三梁，卿大夫尚书二千石博士冠两梁，千石以下至小吏冠一梁。天子、公卿、特进、诸侯祀天地明堂，皆冠平冕，天子十二旒，三公、九卿、诸侯七；其缨各如其绶色，玄衣𫄸裳。周礼曰：王祀昊天上帝，则服大裘而冕，祀五帝亦如之。三礼图曰：冕以三十升布漆而为之，广八寸，长尺六寸，前圜后方，前下后高，有俛伏之形，故谓之冕。欲人之位弥高而志弥下，故以名焉。董巴舆服志曰：显宗初服冕衣裳以祀天地。衣裳以玄上𫄸下，乘舆备文日月星辰十二章，三公、诸侯用山龙九章，卿已下用华虫七章，皆五色采；乘舆刺绣，公卿已下皆织成，陈留、襄邑献之。徐广车服注曰：汉明帝按古礼备服章，天子郊庙衣，皂上绛下，前三幅，后四幅，衣画而裳绣。礼记：古之君子必佩玉，君子于玉比德焉。天子佩白玉，公侯佩山玄玉，大夫佩水苍玉，世子佩瑜玉。晋志曰：周礼弁师掌六冕，司服掌六服，自后王至庶人，各有等差。秦变古制，郊祭之服皆以袀玄，旧法扫地尽矣。汉承秦故，二百余年，未能有所制立。及中兴后，明帝乃始采周官、礼记、尚书及诸儒记说，备衮冕之服。天子车乘冠服，从欧阳氏说；公卿已下，从大、小夏侯氏说。","note_type":"hu_note","start_index":37,"tongjian_id":"94f7b69f-db0e-11ef-8d6f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":17,"tongjian_id":"94f7b6b9-db0e-11ef-88c3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋左氏傳曰：分至啓閉，必書雲物。杜預註曰：雲物，氣色災變也，素察妖祥，逆爲之備。前書·天文志曰：歲正月旦，旦至食爲麥，食至日昳爲稷，昳至晡爲黍，晡至下晡爲菽，下晡至日入爲麻，各以其時用雲色，占種所宜。","note_content_jianti_auto":"春秋左氏传曰：分至启闭，必书云物。杜预注曰：云物，气色灾变也，素察妖祥，逆为之备。前书·天文志曰：岁正月旦，旦至食为麦，食至日昳为稷，昳至晡为黍，晡至下晡为菽，下晡至日入为麻，各以其时用云色，占种所宜。","note_type":"hu_note","start_index":48,"tongjian_id":"94f7b6b8-db0e-11ef-9938-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公卿","official_note":"公卿泛指高级官员，如三公九卿，此处表示皇帝与高官一同参与祭祀仪式。","official_rank":"未知","source_snippet":"帝及公卿列侯","start_index":18,"tongjian_id":"7095e353-2ad8-4ade-9442-9f2edbf9cdc9"},{"confidence":0.85,"official_category":"地方行政","official_name":"列侯","official_note":"列侯是汉代爵位，通常授予功臣或贵族，此处表示侯爵参与祭祀活动。","official_rank":"未知","source_snippet":"帝及公卿列侯","start_index":21,"tongjian_id":"9ec9233e-c73b-4605-a306-c32edbc65103"}],"ExtRef_Children_people":[{"link_birth_year":-5,"link_death_year":57,"link_td_description":"汉光武帝刘秀，字文叔，南阳郡蔡阳县人（今湖北省枣阳市），祖籍沛丰邑中阳里，东汉开国皇帝，25年8月5日至57年3月29日在位。庙号世祖，谥号光武皇帝。","link_td_id":"Q10000030","link_td_number_id":17001,"people_name":"光武皇帝","people_name_jianti_auto":"光武皇帝","people_xingming":"刘秀","start_index":11,"tongjian_id":"94f7b6bd-db0e-11ef-aed6-a0d3651f611f","wl_zhushi":"[刘秀]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/用书云之误","excerpts":[{"context_after":"，尤可为证。而但读《左传》前两三句，故遂颛以指冬至云。今...","context_before":"...秋、立冬；云物者，气色灾变也。”盖四时凡八节，其礼并同。","source_end_index":185,"source_paragraph_tongjian_id":"1d1f18c2-11c2-4075-9a50-45fe22c562bb","source_start_index":160,"source_text":"汉明帝永平二年春正月辛未，宗祀光武毕，登灵台观云物"}],"path":"四笔/卷十一/用书云之误","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"1春，正月，辛未，宗祀光武皇帝於明堂，帝及公卿列侯，始服冠冕、玉佩以行事。禮畢，登靈臺，望雲物。赦天下。","content_fanyi":"春季，正月十九日辛未，在明堂隆重祭祀光武帝，汉明帝与公卿、列侯首次戴上冠冕、佩挂玉饰参加祭礼。典礼结束后，汉明帝登上灵台，观望云气天象。大赦天下。","content_jianti_auto":"1春，正月，辛未，宗祀光武皇帝于明堂，帝及公卿列侯，始服冠冕、玉佩以行事。礼毕，登灵台，望云物。赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3520,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"94f7b69d-db0e-11ef-9885-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"儀禮曰：大射之禮，王將祭射宮，擇士以助祭也。張虎侯、熊侯、豹侯，其制若今之射的也。","note_content_jianti_auto":"仪礼曰：大射之礼，王将祭射宫，择士以助祭也。张虎侯、熊侯、豹侯，其制若今之射的也。","note_type":"hu_note","start_index":14,"tongjian_id":"94f7b6bf-db0e-11ef-87a8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2三月，臨辟雍，初行大射禮。","content_fanyi":"二年三月，汉明帝亲临辟雍，首次举行大射礼。","content_jianti_auto":"2三月，临辟雍，初行大射礼。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3521,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"94f7b6be-db0e-11ef-97b5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"紵，直呂翻。說文曰：紵，檾屬。績紵以爲美布，故曰都紵。續漢志：進賢冠，古緇布冠也，文儒者之服也。前高七寸，後高三寸，長八寸。公侯三梁，中二千石至博士兩梁，自博士以下至小史、私學弟子皆一梁。又，仲春之月，縣道皆案戶比民，民年始七十者授之以玉杖。玉杖，長七尺，端以鳩鳥爲飾。鳩者，不噎之鳥也，欲老人不噎。爾雅翼曰：刻玉爲鳩，置之杖端，謂之鳩杖，亦曰玉杖。","note_content_jianti_auto":"纻，直吕翻。说文曰：纻，檾属。绩纻以为美布，故曰都纻。续汉志：进贤冠，古缁布冠也，文儒者之服也。前高七寸，后高三寸，长八寸。公侯三梁，中二千石至博士两梁，自博士以下至小史、私学弟子皆一梁。又，仲春之月，县道皆案户比民，民年始七十者授之以玉杖。玉杖，长七尺，端以鸠鸟为饰。鸠者，不噎之鸟也，欲老人不噎。尔雅翼曰：刻玉为鸠，置之杖端，谓之鸠杖，亦曰玉杖。","note_type":"hu_note","start_index":48,"tongjian_id":"94f7b6c3-db0e-11ef-9e0e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"饋，進食也，醬，食味之主，故執之而饋。","note_content_jianti_auto":"馈，进食也，酱，食味之主，故执之而馈。","note_type":"hu_note","start_index":147,"tongjian_id":"94f7b6c9-db0e-11ef-83ca-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94f7b6cd-db0e-11ef-b8f2-a0d3651f611f"},{"people_name":"宋均","people_name_jianti_auto":"宋均","start_index":3,"tongjian_id":"94f7b6ce-db0e-11ef-a205-a0d3651f611f"},{"people_name":"鄭康成","people_name_jianti_auto":"郑康成","start_index":33,"tongjian_id":"94f7b6cf-db0e-11ef-b9a8-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":157,"tongjian_id":"94f7b6d0-db0e-11ef-9a57-a0d3651f611f"},{"people_name":"陸德明","people_name_jianti_auto":"陆德明","start_index":176,"tongjian_id":"94f7b6d1-db0e-11ef-8e3a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：宋均曰：三老，老人知天地人之事者；五更，老人知五行更代事者。鄭康成曰：三老、五更，皆年老更事致仕者也；天子以父兄養之，示天下之孝弟也。名以三、五者，取象三辰、五星，天所以照明天下者。都布，布名。進賢冠，古緇布冠也，文儒者之服，前高七寸，後高三寸，長八寸。禮殿，先聖、先師也。阼階，東階，主階也；賓階，西階也。賢曰：醬，醢也；酳，漱也，所以潔口也。陸德明曰：以酒曰酳，以水曰漱。音義隱云：飯畢盪口也，音胤。老人食多鯁饐，故置人於前後祝之，令其不鯁饐也。都，布之美者也。進賢冠，古緇布冠也。玉杖，長七尺，端以鳩鳥爲飾，鳩者，不噎之鳥也，欲老人不噎。更，工衡翻。","note_content_jianti_auto":"贤曰：宋均曰：三老，老人知天地人之事者；五更，老人知五行更代事者。郑康成曰：三老、五更，皆年老更事致仕者也；天子以父兄养之，示天下之孝弟也。名以三、五者，取象三辰、五星，天所以照明天下者。都布，布名。进贤冠，古缁布冠也，文儒者之服，前高七寸，后高三寸，长八寸。礼殿，先圣、先师也。阼阶，东阶，主阶也；宾阶，西阶也。贤曰：酱，醢也；酳，漱也，所以洁口也。陆德明曰：以酒曰酳，以水曰漱。音义隐云：饭毕荡口也，音胤。老人食多鲠饐，故置人于前后祝之，令其不鲠饐也。都，布之美者也。进贤冠，古缁布冠也。玉杖，长七尺，端以鸠鸟为饰，鸠者，不噎之鸟也，欲老人不噎。更，工衡翻。","note_type":"hu_note","start_index":177,"tongjian_id":"94f7b6cc-db0e-11ef-bd10-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94f7b6d4-db0e-11ef-a715-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：下說，謂下語而講說也。","note_content_jianti_auto":"贤曰：下说，谓下语而讲说也。","note_type":"hu_note","start_index":195,"tongjian_id":"94f7b6d3-db0e-11ef-b359-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢官儀曰：辟雍，四門外有水，以節觀者，門外皆有橋，觀者在水外，故云圜橋門也。圜，繞也。","note_content_jianti_auto":"汉官仪曰：辟雍，四门外有水，以节观者，门外皆有桥，观者在水外，故云圜桥门也。圜，绕也。","note_type":"hu_note","start_index":223,"tongjian_id":"94f7b6d6-db0e-11ef-a50a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李躬","people_name_jianti_auto":"李躬","start_index":12,"tongjian_id":"94f7b6d9-db0e-11ef-a3a1-a0d3651f611f"},{"people_name":"榮","people_name_jianti_auto":"荣","start_index":18,"tongjian_id":"94f7b6da-db0e-11ef-8aeb-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":30,"tongjian_id":"94f7b6db-db0e-11ef-a3fb-a0d3651f611f"},{"people_name":"桓榮","people_name_jianti_auto":"桓荣","start_index":36,"tongjian_id":"94f7b6dc-db0e-11ef-b7ee-a0d3651f611f"},{"people_name":"李躬","people_name_jianti_auto":"李躬","start_index":41,"tongjian_id":"94f7b6dd-db0e-11ef-b4b3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：帝紀載詔文，上言李躬而下獨封榮，似脫「躬」字。榮傳、袁紀，詔獨言桓榮，不及李躬，今闕疑。","note_content_jianti_auto":"考异曰：帝纪载诏文，上言李躬而下独封荣，似脱「躬」字。荣传、袁纪，诏独言桓荣，不及李躬，今阙疑。","note_type":"hu_note","start_index":234,"tongjian_id":"94f7b6d8-db0e-11ef-a6ca-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"三老","official_note":"三老是汉代尊崇的养老官职，通常由德高望重的长者担任，负责教化礼仪，此处李躬被任命为三老，参与养老礼仪式，体现皇帝尊老重教。","official_rank":"未知","source_snippet":"以李躬爲三老","start_index":18,"tongjian_id":"bb35fba8-6be0-4ad4-841c-106da347f797"},{"confidence":0.9,"official_category":"文教","official_name":"五更","official_note":"五更是汉代养老官职，与三老类似，由年长有德者担任，辅助教化，此处桓荣被任命为五更，参与养老礼，彰显朝廷对儒学的重视。","official_rank":"未知","source_snippet":"桓榮爲五更","start_index":24,"tongjian_id":"708c0d76-f849-42a7-889d-b71b3e4544fa"},{"confidence":0.85,"official_category":"中枢机构","official_name":"三公","official_note":"三公是汉代最高行政官职，通常指太尉、司徒、司空，负责辅佐皇帝处理政务，此处三公在养老礼中设置几案，体现其礼仪职能。","official_rank":"正一品","source_snippet":"三公設几","start_index":84,"tongjian_id":"2dfb11f1-c48c-425f-b0af-ac70d7827b29"},{"confidence":0.85,"official_category":"中枢机构","official_name":"九卿","official_note":"九卿是汉代中央高级官职，如太常、光禄勋等，分管不同事务，此处九卿在养老礼中整理鞋履，显示其参与宫廷礼仪活动。","official_rank":"正三品","source_snippet":"九卿正履","start_index":88,"tongjian_id":"b4e09280-7902-4e1d-92bd-556f7bd7fe87"},{"confidence":0.8,"official_category":"爵位","official_name":"關內侯","official_note":"關內侯是汉代爵位，有食邑但无封国，地位较高，此处皇帝赐予桓荣此爵，以表彰其儒学贡献和参与养老礼。","official_rank":"二十等爵第十九级","source_snippet":"賜榮爵關內侯","start_index":186,"tongjian_id":"33f66de2-b4b3-41d7-8fd0-4b7ba8b5f986"},{"confidence":0.75,"official_category":"俸禄等级","official_name":"二千石","official_note":"二千石是汉代官员俸禄等级，对应高级地方官如郡守，此处指三老五更享受二千石级别的终身俸禄，以示优抚。","official_rank":"未知","source_snippet":"三老五更皆以二千石祿養終厥身","start_index":198,"tongjian_id":"ecad1512-598d-4216-83f0-1dee7727522b"}],"ExtRef_Children_people":[{"people_name":"李躬","people_name_jianti_auto":"李躬","people_xingming":"李躬","start_index":20,"tongjian_id":"94f7b6e2-db0e-11ef-a02d-a0d3651f611f"},{"link_td_description":"桓荣，字春卿，沛郡龙亢人，东汉时期官员。东晋世族谯国桓氏的远祖。","link_td_id":"Q10007373","link_td_number_id":1699136,"people_name":"桓榮","people_name_jianti_auto":"桓荣","people_xingming":"桓荣","start_index":26,"tongjian_id":"94f7b6e3-db0e-11ef-81a9-a0d3651f611f"},{"link_td_description":"桓荣，字春卿，沛郡龙亢人，东汉时期官员。东晋世族谯国桓氏的远祖。","link_td_id":"Q10007373","link_td_number_id":1699136,"people_name":"桓榮","people_name_jianti_auto":"桓荣","start_index":181,"tongjian_id":"94f7b6e4-db0e-11ef-b11d-a0d3651f611f"},{"link_td_description":"桓荣，字春卿，沛郡龙亢人，东汉时期官员。东晋世族谯国桓氏的远祖。","link_td_id":"Q10007373","link_td_number_id":1699136,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"桓荣","start_index":228,"tongjian_id":"94f7b6e5-db0e-11ef-82d0-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94f7b6c1-db0e-11ef-ba77-a0d3651f611f","pinyin":"zhù","source_anchor_text":"三老服都紵大袍冠進","source_key":"baiyang_epub","start_index":36,"text":"紵","tongjian_id":"ff8157d9-dd1e-5c39-ad17-98887f64f4e7"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94f7b6c1-db0e-11ef-ba77-a0d3651f611f","pinyin":"zuò","source_anchor_text":"交禮道自阼階三老升","source_key":"baiyang_epub","start_index":99,"text":"阼","tongjian_id":"8b4b5eb1-f9f7-5d16-aaf4-c4d33281315a"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94f7b6c1-db0e-11ef-ba77-a0d3651f611f","pinyin":"yī","source_anchor_text":"至階天子揖如禮三老","source_key":"baiyang_epub","start_index":114,"text":"揖","tongjian_id":"ca50480b-1282-506a-b1c6-722579f375ba"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94f7b6c1-db0e-11ef-ba77-a0d3651f611f","pinyin":"yìn","source_anchor_text":"饋執爵而酳祝鯁在前","source_key":"baiyang_epub","start_index":150,"text":"酳","tongjian_id":"16fa308d-e324-5815-aae8-2469bb36f450"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"冬，十月，壬子，上幸辟雍，初行養老禮；以李躬爲三老，桓榮爲五更。三老服都紵大袍，冠進賢，扶玉杖；五更亦如之，不杖。乘輿到辟雍禮殿，御坐東廂，遣使者安車迎三老、五更於太學講堂，天子迎于門屛，交禮；道自阼階，三老升自賓階；至階，天子揖如禮。三老升，東面，三公設几，九卿正履，天子親袒割牲，執醬而饋，執爵而酳，祝鯁在前，祝饐在後。五更南面，三公進供，禮亦如之。禮畢，引桓榮及弟子升堂，上自爲下說，諸儒執經問難於前，冠帶縉紳之人圜橋門而觀聽者，蓋億萬計。於是下詔賜榮爵關內侯；三老五更皆以二千石祿養終厥身。賜天下三老酒，人一石，肉四十斤。","content_fanyi":"冬季，十月初五日壬子，汉明帝亲临辟雍，初次举行养老礼；任命李躬为三老，桓荣为五更。三老身穿都纻细麻布制成的大袍，头戴进贤冠，手持玉杖；五更的穿戴也与此相同，只是不持杖。天子乘车来到辟雍礼殿，坐在东厢，派使者用安车到太学讲堂迎接三老、五更；天子在门屏前迎接，行交接礼；天子从阼阶引导，三老从西边的宾阶登阶；到了阶上，天子依照礼节作揖。三老登堂，面向东方；三公摆设几案，九卿将木屐摆放端正；天子亲自挽袖袒臂，分割祭肉，捧着酱汁进献，手持酒爵敬酒，先祝愿老人吃鱼不遭鱼刺伤害，后祝愿老人吃饭不噎，身体健康。五更面向南方，三公进献酒食，礼节也和对待三老一样。礼节完毕后，引导桓荣及其弟子登上讲堂，明帝亲自为臣下讲说；众儒生手持经书在堂前请问疑难，冠带缙绅之士环绕桥门观看聆听的，成千上万。于是下诏赐给桓荣关内侯爵位；三老、五更都以二千石俸禄供养终身。又赏赐全国各郡国的三老每人一石酒、四十斤肉。","content_jianti_auto":"冬，十月，壬子，上幸辟雍，初行养老礼；以李躬为三老，桓荣为五更。三老服都纻大袍，冠进贤，扶玉杖；五更亦如之，不杖。乘舆到辟雍礼殿，御坐东厢，遣使者安车迎三老、五更于太学讲堂，天子迎于门屛，交礼；道自阼阶，三老升自宾阶；至阶，天子揖如礼。三老升，东面，三公设几，九卿正履，天子亲袒割牲，执酱而馈，执爵而酳，祝鲠在前，祝饐在后。五更南面，三公进供，礼亦如之。礼毕，引桓荣及弟子升堂，上自为下说，诸儒执经问难于前，冠带缙绅之人圜桥门而观听者，盖亿万计。于是下诏赐荣爵关内侯；三老五更皆以二千石禄养终厥身。赐天下三老酒，人一石，肉四十斤。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，于时之天下，果使家给户饶遂其衣帛食肉以奉其父母乎？抑尚...","context_before":"...，乃以兴起斯民之心而不敢凭壮以遗老，则标以荫本而道益荣。","source_end_index":232,"source_paragraph_tongjian_id":"f91168f2-a6db-4657-b889-a48e1ede3d29","source_start_index":211,"source_text":"明帝修三老五更之礼，养李躬、桓荣尽敬养之文"}],"title":"二 光武崩未期年明帝即修礼乐毋乃过急过泰"},{"excerpts":[{"context_after":"。今且未知明帝之果可以养老，而荣、躬之果可为老更否邪？虽...","context_before":"汉儒饰文而迷其本，于是","source_end_index":24,"source_paragraph_tongjian_id":"fd1b6e05-9520-4250-86ff-21b126f5c25e","source_start_index":11,"source_text":"桓荣、李躬受割牲躬馈之荣施"}],"title":"五 于谨助宇文护弑君乃为其三老"}],"id":3522,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":2,"tongjian_id":"94f7b6c1-db0e-11ef-ba77-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000690"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"門生，受業於門者也。","note_content_jianti_auto":"门生，受业于门者也。","note_type":"hu_note","start_index":52,"tongjian_id":"94f7b6e7-db0e-11ef-90c8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"執業，猶執經也。","note_content_jianti_auto":"执业，犹执经也。","note_type":"hu_note","start_index":58,"tongjian_id":"94f7b6e8-db0e-11ef-86a9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"發難，發疑難也。難，乃旦翻。","note_content_jianti_auto":"发难，发疑难也。难，乃旦翻。","note_type":"hu_note","start_index":66,"tongjian_id":"94f7b6e9-db0e-11ef-958b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94f7b6ec-db0e-11ef-9c10-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"首陽山","place_name_jianti_auto":"首阳山","start_index":3,"tongjian_id":"94f7b6ed-db0e-11ef-a3ee-a0d3651f611f"},{"place_name":"偃師縣","place_name_jianti_auto":"偃师县","start_index":9,"tongjian_id":"94f7b6ee-db0e-11ef-bb18-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：首陽山，在今偃師縣西北。","note_content_jianti_auto":"贤曰：首阳山，在今偃师县西北。","note_type":"hu_note","start_index":219,"tongjian_id":"94f7b6eb-db0e-11ef-aa96-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence"