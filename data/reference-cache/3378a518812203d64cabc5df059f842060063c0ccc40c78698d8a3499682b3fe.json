jian_id":"541956c8-3a00-4b8b-99b0-d3320092bb5a"}],"ExtRef_Children_people":[{"people_name":"竇林","people_name_jianti_auto":"窦林","people_xingming":"窦林","start_index":9,"tongjian_id":"94fa22e4-db0e-11ef-8f0c-a0d3651f611f"},{"people_name":"林","people_name_jianti_auto":"林","people_xingming":"窦林","start_index":22,"tongjian_id":"94fa22e6-db0e-11ef-999e-a0d3651f611f"},{"link_birth_year":-16,"link_death_year":62,"link_td_description":"窦融，字周公，扶风平陵（今陕西省咸阳市西北）人，窦氏家族世代仕官于河右，家族中不少成员自称河右大族，任凉州刺史。东汉官员，曾孙女是汉章帝章德窦皇后。","link_td_id":"Q10000534","link_td_number_id":232095,"people_name":"融","people_name_jianti_auto":"融","people_xingming":"窦融","start_index":25,"tongjian_id":"94fa22e7-db0e-11ef-816b-a0d3651f611f"},{"people_name":"竇氏","people_name_jianti_auto":"窦氏","start_index":34,"tongjian_id":"94fa22e8-db0e-11ef-a2dc-a0d3651f611f"},{"people_name":"林","people_name_jianti_auto":"林","people_xingming":"窦林","start_index":81,"tongjian_id":"94fa22e9-db0e-11ef-bbd5-a0d3651f611f"},{"link_birth_year":-16,"link_death_year":62,"link_td_description":"窦融，字周公，扶风平陵（今陕西省咸阳市西北）人，窦氏家族世代仕官于河右，家族中不少成员自称河右大族，任凉州刺史。东汉官员，曾孙女是汉章帝章德窦皇后。","link_td_id":"Q10000534","link_td_number_id":232095,"people_name":"融","people_name_jianti_auto":"融","people_xingming":"窦融","start_index":90,"tongjian_id":"94fa22ea-db0e-11ef-a774-a0d3651f611f"},{"link_birth_year":-16,"link_death_year":62,"link_td_description":"窦融，字周公，扶风平陵（今陕西省咸阳市西北）人，窦氏家族世代仕官于河右，家族中不少成员自称河右大族，任凉州刺史。东汉官员，曾孙女是汉章帝章德窦皇后。","link_td_id":"Q10000534","link_td_number_id":232095,"people_name":"融","people_name_jianti_auto":"融","people_xingming":"窦融","start_index":92,"tongjian_id":"94fa22eb-db0e-11ef-8290-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":6,"tongjian_id":"94fa22e5-db0e-11ef-958d-a0d3651f611f"},{"place_name":"京邑","place_name_jianti_auto":"京邑","resolved_place_entity_id":809,"start_index":66,"tongjian_id":"94fa22ec-db0e-11ef-9b3b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"5十二月，護羌校尉竇林坐欺罔及臧罪，下獄死。林者，融之從兄子也。於是竇氏一公、兩侯、三公主、四二千石相與並時，自祖及孫，官府邸第相望京邑，於親戚功臣中莫與爲比。及林誅，帝數下詔切責融，融惶恐乞骸骨，詔令歸第養病。","content_fanyi":"十二月，护羌校尉窦林因欺骗和贪赃获罪，被关入狱中而死。窦林是窦融堂兄的儿子。当时窦氏同时有一人任公、两人封侯、三人娶公主、四人任二千石官员，从祖父到孙子，官府和宅第在京城中彼此相望，在皇亲国戚和功臣中无人能比。等到窦林被诛杀，汉明帝多次下诏严厉责备窦融，窦融惶恐请求辞官，诏令让他回家养病。","content_jianti_auto":"5十二月，护羌校尉窦林坐欺罔及臧罪，下狱死。林者，融之从兄子也。于是窦氏一公、两侯、三公主、四二千石相与并时，自祖及孙，官府邸第相望京邑，于亲戚功臣中莫与为比。及林诛，帝数下诏切责融，融惶恐乞骸骨，诏令归第养病。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3526,"number":5,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"94f9511c-db0e-11ef-9206-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"青帝","people_name_jianti_auto":"青帝","start_index":45,"tongjian_id":"94fa22ef-db0e-11ef-bb87-a0d3651f611f"},{"people_name":"句芒","people_name_jianti_auto":"句芒","start_index":48,"tongjian_id":"94fa22f0-db0e-11ef-9e04-a0d3651f611f"},{"people_name":"赤帝","people_name_jianti_auto":"赤帝","start_index":80,"tongjian_id":"94fa22f1-db0e-11ef-b7c5-a0d3651f611f"},{"people_name":"祝融","people_name_jianti_auto":"祝融","start_index":83,"tongjian_id":"94fa22f2-db0e-11ef-8a19-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":115,"tongjian_id":"94fa22f3-db0e-11ef-a527-a0d3651f611f"},{"people_name":"后土","people_name_jianti_auto":"后土","start_index":118,"tongjian_id":"94fa22f4-db0e-11ef-8662-a0d3651f611f"},{"people_name":"黑帝","people_name_jianti_auto":"黑帝","start_index":187,"tongjian_id":"94fa22f5-db0e-11ef-b479-a0d3651f611f"},{"people_name":"玄冥","people_name_jianti_auto":"玄冥","start_index":190,"tongjian_id":"94fa22f6-db0e-11ef-903e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"續漢書曰：迎氣五郊之兆，四方之兆各依其位，中央之兆在未，壇皆三尺。立春之日，迎春於東郊，祭青帝、句芒，車服皆青，歌青陽，八佾舞雲翹之舞。立夏之日，迎夏於南郊，祭赤帝、祝融，車服皆赤，歌朱明，舞如迎春。先立秋十八日，迎黃靈於中兆，祭黃帝、后土，車服皆黃，歌朱明，八佾舞雲翹育命之舞。立秋之日，迎秋於西郊，祭白帝、蓐收，車服皆白，歌白藏，八佾舞育命之舞。立冬之日，迎冬於北郊，祭黑帝、玄冥，車服皆黑，歌玄冥，舞如迎秋。","note_content_jianti_auto":"续汉书曰：迎气五郊之兆，四方之兆各依其位，中央之兆在未，坛皆三尺。立春之日，迎春于东郊，祭青帝、句芒，车服皆青，歌青阳，八佾舞云翘之舞。立夏之日，迎夏于南郊，祭赤帝、祝融，车服皆赤，歌朱明，舞如迎春。先立秋十八日，迎黄灵于中兆，祭黄帝、后土，车服皆黄，歌朱明，八佾舞云翘育命之舞。立秋之日，迎秋于西郊，祭白帝、蓐收，车服皆白，歌白藏，八佾舞育命之舞。立冬之日，迎冬于北郊，祭黑帝、玄冥，车服皆黑，歌玄冥，舞如迎秋。","note_type":"hu_note","start_index":11,"tongjian_id":"94fa22ee-db0e-11ef-a0fe-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6是歲，初迎氣於五郊。","content_fanyi":"这一年，初次在五郊举行迎气典礼。","content_jianti_auto":"6是岁，初迎气于五郊。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3527,"number":6,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"94fa22ed-db0e-11ef-9abd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"光武","people_name_jianti_auto":"光武","start_index":3,"tongjian_id":"94fa22fa-db0e-11ef-b39c-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":7,"tongjian_id":"94fa22fb-db0e-11ef-942e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"酈縣","place_name_jianti_auto":"郦县","start_index":10,"tongjian_id":"94fa22fc-db0e-11ef-8600-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":14,"tongjian_id":"94fa22fd-db0e-11ef-a5af-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"公主，光武女。賢曰：酈縣，屬南陽郡。酈，音櫟。","note_content_jianti_auto":"公主，光武女。贤曰：郦县，属南阳郡。郦，音栎。","note_type":"hu_note","start_index":32,"tongjian_id":"94fa22f9-db0e-11ef-8fdc-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":59,"link_td_description":"阴就，东汉外戚，汉光武帝皇后阴丽华的弟弟，父亲阴陆，母亲邓氏。","link_td_id":"Q10007335","link_td_number_id":5415108,"people_name":"新陽侯","people_name_jianti_auto":"新阳侯","people_xingming":"阴就","start_index":1,"tongjian_id":"94fa22fe-db0e-11ef-b4cd-a0d3651f611f"},{"link_death_year":59,"link_td_description":"阴就，东汉外戚，汉光武帝皇后阴丽华的弟弟，父亲阴陆，母亲邓氏。","link_td_id":"Q10007335","link_td_number_id":5415108,"people_name":"陰就","people_name_jianti_auto":"阴就","people_xingming":"阴就","start_index":4,"tongjian_id":"94fa22ff-db0e-11ef-beb5-a0d3651f611f"},{"people_name":"豐","people_name_jianti_auto":"丰","people_xingming":"阴丰","start_index":7,"tongjian_id":"94fa2300-db0e-11ef-8488-a0d3651f611f"},{"link_death_year":59,"link_td_description":"刘绶，东汉公主，光武帝刘秀之五女。","link_td_id":"Q10002922","link_td_number_id":1583819,"people_name":"酈邑公主","people_name_jianti_auto":"郦邑公主","people_xingming":"刘绶","start_index":9,"tongjian_id":"94fa2301-db0e-11ef-8a52-a0d3651f611f","wl_zhushi":"[刘绶]"},{"people_name":"豐","people_name_jianti_auto":"丰","people_xingming":"阴丰","start_index":19,"tongjian_id":"94fa2302-db0e-11ef-ad0d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"7新陽侯陰就子豐尚酈邑公主。公主驕妬，豐殺之，被誅，父母皆自殺。","content_fanyi":"新阳侯阴就的儿子阴丰娶郦邑公主为妻。公主骄横妒忌，阴丰把她杀死，自己获罪被诛，父母也都自杀。","content_jianti_auto":"7新阳侯阴就子丰尚郦邑公主。公主骄妬，丰杀之，被诛，父母皆自杀。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3528,"number":7,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"94fa22f8-db0e-11ef-8758-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtR