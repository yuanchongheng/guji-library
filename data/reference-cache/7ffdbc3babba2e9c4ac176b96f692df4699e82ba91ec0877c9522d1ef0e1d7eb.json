otes":[],"note_content":"春秋「晉敗楚師于鄢陵」，卽此鄢也。班志作「傿陵」，屬潁川郡。鄢，音謁晚翻，又於建翻；師古音偃。史記正義曰：許州鄢陵縣西北十五里有鄢陵古城。","note_content_jianti_auto":"春秋「晋败楚师于鄢陵」，即此鄢也。班志作「傿陵」，属颍川郡。鄢，音谒晚翻，又于建翻；师古音偃。史记正义曰：许州鄢陵县西北十五里有鄢陵古城。","note_type":"hu_note","start_index":8,"tongjian_id":"8c57be17-db0e-11ef-8cd2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c5a179d-db0e-11ef-b176-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":3,"tongjian_id":"8c5a179e-db0e-11ef-9b1e-a0d3651f611f"},{"place_name":"鄢","place_name_jianti_auto":"鄢","place_note":"河南鄢陵北","resolved_place_entity_id":2197,"start_index":6,"tongjian_id":"8c5a179f-db0e-11ef-ac14-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1秦伐韓，取鄢。","content_fanyi":"秦国攻打韩国，夺取了鄢陵。","content_jianti_auto":"1秦伐韩，取鄢。","dtjl_paragraph_links":[],"dtjl_references":[],"id":225,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c57be16-db0e-11ef-916d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"襄王","people_name_jianti_auto":"襄王","start_index":8,"tongjian_id":"8c5a17a2-db0e-11ef-8bca-a0d3651f611f"},{"people_name":"嗣","people_name_jianti_auto":"嗣","start_index":12,"tongjian_id":"8c5a17a3-db0e-11ef-9cd2-a0d3651f611f"},{"people_name":"司馬貞","people_name_jianti_auto":"司马贞","start_index":22,"tongjian_id":"8c5a17a4-db0e-11ef-aee8-a0d3651f611f"},{"people_name":"惠王","people_name_jianti_auto":"惠王","start_index":50,"tongjian_id":"8c5a17a5-db0e-11ef-ad50-a0d3651f611f"},{"p