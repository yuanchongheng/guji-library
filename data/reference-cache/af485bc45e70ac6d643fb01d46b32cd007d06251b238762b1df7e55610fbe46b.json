:"8c2b9cf0-db0e-11ef-b720-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":146,"tongjian_id":"8c2b9cf1-db0e-11ef-a4fc-a0d3651f611f"},{"place_name":"安邑","place_name_jianti_auto":"安邑","start_index":150,"tongjian_id":"8c2b9cf2-db0e-11ef-a080-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","place_note":"河南開封","start_index":154,"tongjian_id":"8c2b9cf3-db0e-11ef-9869-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","start_index":166,"tongjian_id":"8c2b9cf4-db0e-11ef-9f2b-a0d3651f611f"},{"place_name":"安邑","place_name_jianti_auto":"安邑","start_index":182,"tongjian_id":"8c2b9cf5-db0e-11ef-81c6-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":185,"tongjian_id":"8c2b9cf6-db0e-11ef-8965-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":211,"tongjian_id":"8c2b9cf7-db0e-11ef-bbcb-a0d3651f611f"},{"place_name":"安邑","place_name_jianti_auto":"安邑","start_index":213,"tongjian_id":"8c2b9cf8-db0e-11ef-bbac-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","start_index":217,"tongjian_id":"8c2b9cf9-db0e-11ef-9d98-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":225,"tongjian_id":"8c2b9cfa-db0e-11ef-8923-a0d3651f611f"},{"place_name":"安邑","place_name_jianti_auto":"安邑","start_index":226,"tongjian_id":"8c2b9cfb-db0e-11ef-9dd2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":229,"tongjian_id":"8c2b9cfc-db0e-11ef-9de3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8c2b9d08-db0e-11ef-8b8d-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":23,"tongjian_id":"8c2b9d09-db0e-11ef-8ce4-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":27,"tongjian_id":"8c2b9d0a-db0e-11ef-89ed-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本正有「衞鞅」二字；乙十一行本同；孔本同；退齋校同。』","note_content_jianti_auto":"『章：十二行本正有「衞鞅」二字；乙十一行本同；孔本同；退斋校同。』","note_type":"『章：[^』]*』","start_index":264,"tongjian_id":"8c2b9d07-db0e-11ef-a173-a0d3651f611f"}],"note_content":"索隱曰：大良造，卽大上造。余謂大良造，大上造之良者也。按史記·秦紀：孝公十年，衞鞅爲大良造，將兵圍魏安邑，降之。又按六國年表，秦孝公之十年，顯王之十七年，所謂大良造伐魏，卽衞鞅將兵也。是時魏都安邑，其兵猶強，龐涓、太子申、公子卬未敗，安邑不應遽降於秦。至顯王二十九年，卬軍旣敗，魏獻河西之地於秦，始去安邑徙都大梁。史記·六國表不書徙大梁而世家書之，魏世家於是年不書安邑降秦而秦紀孝公十年書之。通鑑從魏世家，於顯王二十九年書魏去安邑，徙大梁，而是年不書魏安邑降秦，蓋亦疑而除去之。但大良造之下當有「衞鞅」二字，意謂傳寫通鑑者逸之。","note_content_jianti_auto":"索隐曰：大良造，即大上造。余谓大良造，大上造之良者也。按史记·秦纪：孝公十年，衞鞅为大良造，将兵围魏安邑，降之。又按六国年表，秦孝公之十年，显王之十七年，所谓大良造伐魏，即衞鞅将兵也。是时魏都安邑，其兵犹强，庞涓、太子申、公子卬未败，安邑不应遽降于秦。至显王二十九年，卬军既败，魏献河西之地于秦，始去安邑徙都大梁。史记·六国表不书徙大梁而世家书之，魏世家于是年不书安邑降秦而秦纪孝公十年书之。通鉴从魏世家，于显王二十九年书魏去安邑，徙大梁，而是年不书魏安邑降秦，盖亦疑而除去之。但大良造之下当有「衞鞅」二字，意谓传写通鉴者逸之。","note_type":"hu_note","start_index":8,"tongjian_id":"8c2b9cdb-db0e-11ef-bef1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"大良造","official_note":"大良造是战国时期秦国的高级官职，负责军事指挥和行政事务，此处表示秦国以大良造为统帅征伐魏国。","official_rank":"未知","source_snippet":"秦大良造伐魏","start_index":1,"tongjian_id":"801b6c29-dcdb-4d34-84dd-5079ec614baf"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府栎阳，陕西临潼","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c2b9d0b-db0e-11ef-b8f8-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"府安邑，山西夏县","resolved_place_entity_id":1,"start_index":6,"tongjian_id":"8c2b9d0c-db0e-11ef-a1b6-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"河西之战（后期）","tongjian_id":"war_N0507"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1秦大良造伐魏。","content_fanyi":"秦国的大良造卫鞅领兵攻打魏国。","content_jianti_auto":"1秦大良造伐魏。","dtjl_paragraph_links":[],"dtjl_references":[],"id":145,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id"