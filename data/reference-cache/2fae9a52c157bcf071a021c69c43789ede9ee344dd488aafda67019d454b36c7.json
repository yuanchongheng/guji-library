hildren_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":7,"tongjian_id":"9e549e8c-db0e-11ef-b4e2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷七十五）","excerpts":[{"context_after":"永嘉四年，征南将军山简为群盗严嶷所迫，自襄阳徙屯夏口。建...","context_before":"...图，遂奔魏。又天纪二年，夏口督孙慎略晋江夏千余家而还]。","source_end_index":791,"source_paragraph_tongjian_id":"c1f1d4b7-3617-565d-b543-e0885b2bf0a3","source_start_index":749,"source_text":"晋永兴二年，陈敏谋据扬州。时刘弘镇荆州，遣陶侃屯于夏口。敏遣其弟恢寇武昌，侃败却之。"}],"path":"湖广方舆纪要/〇、封域山川险要（卷七十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"太宰顒以張光爲順陽太守，帥步騎五千詣荊州討敏。劉弘遣江夏太守陶侃、武陵太守苗光屯夏口，又遣南平太守汝南應詹督水軍以繼之。","content_fanyi":"太宰司马颙任命张光为顺阳太守，让张光率领步兵、骑兵五千人前往荆州讨伐陈敏。刘弘派江夏太守陶侃、武陵太守苗光驻守夏口，又派南平太守汝南人应詹统领水军随后接应。","content_jianti_auto":"太宰颙以张光为顺阳太守，帅步骑五千诣荆州讨敏。刘弘遣江夏太守陶侃、武陵太守苗光屯夏口，又遣南平太守汝南应詹督水军以继之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7312,"path":"资治通鉴 : 卷第八十六 (晉紀八) / 孝惠皇帝下 / 永興二年 / 第 22 段","reading_annotation_sources":[],"start_index":21,"tongjian_id":"9e549e76-db0e-11ef-ba31-a0d3651f611f","year_int":305},"tongjian_id":"9e549e76-db0e-11ef-ba31-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"葭萌縣","place_name_jianti_auto":"葭萌县","start_index":0,"tongjian_id":"9e7741e5-db0e-11ef-8466-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"9e7741e6-db0e-11ef-939f-a0d3651f611f"},{"place_name":"廣漢郡","place_name_jianti_auto":"广汉郡","start_index":6,"tongjian_id":"9e7741e7-db0e-11ef-b5ff-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":10,"tongjian_id":"9e7741e8-db0e-11ef-9595-a0d3651f611f"},{"place_name":"漢壽縣","place_name_jianti_auto":"汉寿县","start_index":13,"tongjian_id":"9e7741e9-db0e-11ef-a186-a0d3651f611f"},{"place_name":"梓潼郡","place_name_jianti_auto":"梓潼郡","start_index":18,"tongjian_id":"9e7741ea-db0e-11ef-8b38-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":22,"tongjian_id":"9e7741eb-db0e-11ef-b9d4-a0d3651f611f"},{"place_name":"漢壽","place_name_jianti_auto":"汉寿","start_index":25,"tongjian_id":"9e7741ec-db0e-11ef-9ea2-a0d3651f611f"},{"place_name":"晉壽","place_name_jianti_auto":"晋寿","start_index":28,"tongjian_id":"9e7741ed-db0e-11ef-bc02-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"葭萌縣，漢屬廣漢郡，蜀改爲漢壽縣，屬梓潼郡；晉又改漢壽曰晉壽。","note_content_jianti_auto":"葭萌县，汉属广汉郡，蜀改为汉寿县，属梓潼郡；晋又改汉寿曰晋寿。","note_type":"hu_note","start_index":13,"tongjian_id":"9e7741e4-db0e-11ef-9fb8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"沔水","place_name_jianti_auto":"沔水","start_index":0,"tongjian_id":"9e7741ef-db0e-11ef-aa55-a0d3651f611f"},{"place_name":"梁州","place_name_jianti_auto":"梁州","start_index":3,"tongjian_id":"9e7741f0-db0e-11ef-a764-a0d3651f611f"},{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":6,"tongjian_id":"9e7741f1-db0e-11ef-aa90-a0d3651f611f"},{"place_name":"荊沔","place_name_jianti_auto":"荆沔","start_index":10,"tongjian_id":"9e7741f2-db0e-11ef-99e1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"沔水自梁州入荊州界爲荊沔。","note_content_jianti_auto":"沔水自梁州入荆州界为荆沔。","note_type":"hu_note","start_index":26,"tongjian_id":"9e7741ee-db0e-11ef-9406-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":17,"chapter_name":"民心篇第十七","chenzhu_chapter":"民心者人民心理之向背也。人民心理之向背，大抵以政治之善恶为依归，夷夏之防，有时并不足恃，是可惕然者也，故《胡注》恒注意及之。孟子曰：“三代之得天下也，得其民也，得其民者，得其心也。”恩泽不下于民，而责人民之不爱国，不可得也。夫国必有可爱之道，而後能令人爱之，天下有轻去其国，而甘心讬庇于他政权之下者矣。《硕鼠》之诗人曰：“逝将去汝，适彼乐国。”何为出此言乎？其故可深长思也。故《夷夏篇》後，继以《民心》。","chenzhu_index_in_chapter":9,"chenzhu_text":"民主政治未建立之时，以天下为私物，忌疆吏之得众，然则疆吏之虐用其民，乃君主所深喜也。呜呼！忌同种之刘璠，而其害乃在异种之刘渊，岂山简之徒所及料哉！靖康元年，李邦彦等之谮罢李纲也，太学生上书请留，军民数万，挝鼓喧呼，唾邦彦，杀内侍，义出众愤，而贼臣即以此中纲，谓纲为民心所归，帝亦愈疑纲而不可解，宋遂不得不南渡矣。","created_at":"2025-12-31 08:50:44","seq_in_chapter":30,"tongjian_id":"CH17-CZ009"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"璠","people_name_jianti_auto":"璠","start_index":0,"tongjian_id":"9e7741f4-db0e-11ef-a351-a0d3651f611f"},{"people_name":"弘","people_name_jianti_auto":"弘","start_index":2,"tongjian_id":"9e7741f5-db0e-11ef-91d3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":14,"tongjian_id":"9e7741f6-db0e-11ef-8121-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"璠父弘之喪未終，起之於苫塊；荊州之民懷其父，故翕然歸其子。璠，扶元翻。","note_content_jianti_auto":"璠父弘之丧未终，起之于苫块；荆州之民怀其父，故翕然归其子。璠，扶元翻。","note_type":"hu_note","start_index":62,"tongjian_id":"9e7741f3-db0e-11ef-8a96-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9e7741e3-db0e-11ef-ac43-a0d3651f611f","pinyin":"fán","source_anchor_text":"禁詔起劉璠為順陽內","source_key":"baiyang_epub","start_index":46,"text":"璠","tongjian_id":"2f714293-b0be-5419-99a2-bc273be7dd34"}],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":48,"tongjian_id":"9e774201-db0e-11ef-8591-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、保宁府（卷六十八）","excerpts":[{"context_after":"太元十五年，置晋寿郡。宋元嘉十年，仇池氐王杨难当寇梁州，...","context_before":"...使诸国敛兵退守，于是令督汉中胡济却住汉寿。晋改曰晋寿县。","source_end_index":98,"source_paragraph_tongjian_id":"3bd9e879-fb64-5971-ad97-157ac4d0df85","source_start_index":74,"source_text":"永兴以后，李雄据蜀，使其将李凤屯晋寿，屡窥汉中。"}],"path":"四川方舆纪要/二、保宁府（卷六十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"20成平寇將軍李鳳屯晉壽，屢寇漢中，漢中民東走荊沔。詔以張光爲梁州刺史。荊州寇盜不禁，詔起劉璠爲順陽內史，江、漢間翕然歸之。","content_fanyi":"成汉平寇将军李凤驻兵晋寿，多次进犯汉中，汉中民众向东逃往荆州、沔水一带。朝廷诏令以张光为梁州刺史。荆州盗贼不能禁绝，诏令起用刘璠为顺阳内史，江、汉之间的百姓一致归附刘璠。","content_jianti_auto":"20成平寇将军李凤屯晋寿，屡寇汉中，汉中民东走荆沔。诏以张光为梁州刺史。荆州寇盗不禁，诏起刘璠为顺阳内史，江、汉间翕然归之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7400,"number":20,"path":"资治通鉴 : 卷第八十六 (晉紀八) / 孝懷皇帝上 / 二年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"9e7741e3-db0e-11ef-ac43-a0d3651f611f","year_int":308},"tongjian_id":"9e7741e3-db0e-11ef-ac43-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"略","people_name_jianti_auto":"略","start_index":1,"tongjian_id":"9e8a078d-db0e-11ef-a211-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"代略也。","note_content_jianti_auto":"代略也。","note_type":"hu_note","start_index":47,"tongjian_id":"9e8a078c-db0e-11ef-8b3b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":17,"chapter_name":"民心篇第十七","chenzhu_chapter":"民心者人民心理之向背也。人民心理之向背，大抵以政治之善恶为依归，夷夏之防，有时并不足恃，是可惕然者也，故《胡注》恒注意及之。孟子曰：“三代之得天下也，得其民也，得其民者，得其心也。”恩泽不下于民，而责人民之不爱国，不可得也。夫国必有可爱之道，而後能令人爱之，天下有轻去其国，而甘心讬庇于他政权之下者矣。《硕鼠》之诗人曰：“逝将去汝，适彼乐国。”何为出此言乎？其故可深长思也。故《夷夏篇》後，继以《民心》。","chenzhu_index_in_chapter":9,"chenzhu_text":"民主政治未建立之时，以天下为私物，忌疆吏之得众，然则疆吏之虐用其民，乃君主所深喜也。呜呼！忌同种之刘璠，而其害乃在异种之刘渊，岂山简之徒所及料哉！靖康元年，李邦彦等之谮罢李纲也，太学生上书请留，军民数万，挝鼓喧呼，唾邦彦，杀内侍，义出众愤，而贼臣即以此中纲，谓纲为民心所归，帝亦愈疑纲而不可解，宋遂不得不南渡矣。","created_at":"2025-12-31 08:50:44","seq_in_chapter":30,"tongjian_id":"CH17-CZ009"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉弘","people_name_jianti_auto":"刘弘","start_index":2,"tongjian_id":"9e8a0790-db0e-11ef-96a3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":7,"tongjian_id":"9e8a0791-db0e-11ef-ba7a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":9,"tongjian_id":"9e8a0792-db0e-11ef-9948-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言劉弘父子得江、漢間民心。","note_content_jianti_auto":"史言刘弘父子得江、汉间民心。","note_type":"hu_note","start_index":108,"tongjian_id":"9e8a078f-db0e-11ef-8107-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":64,"tongjian_id":"9e8a07a0-db0e-11ef-8ef6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、襄阳府（卷七十九）","excerpts":[{"context_after":"亦曰高阳池。府东五里又有黑龙池]。","context_before":"...旁，所谓渔浦城也。又有习家池，在府南百里，后汉习郁所穿。","source_end_index":242,"source_paragraph_tongjian_id":"f39e9fc1-d6e4-5b6b-b612-62afb27d8374","source_start_index":230,"source_text":"晋山简镇襄阳，每饮于此。"}],"path":"湖广方舆纪要/八、襄阳府（卷七十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2三月，戊申，高密孝王略薨。以尚書左僕射山簡爲征南將軍、都督荊·湘·交·廣四州諸軍事，鎭襄陽。簡，濤之子也，嗜酒，不恤政事；表「順陽內史劉璠得衆心，恐百姓劫璠爲主」。詔徵璠爲越騎校尉。南州由是遂亂，父老莫不追思劉弘。","content_fanyi":"三月戊申日，高密孝王司马略去世。任命尚书左仆射山简为征南将军、都督荆、湘、交、广四州诸军事，镇守襄阳。山简是山涛的儿子，嗜酒，不关心政事；他上表说：“顺阳内史刘璠很得人心，恐怕百姓会劫持他拥立为主。”朝廷下诏征召刘璠为越骑校尉。南州从此大乱，父老们无不追思刘璠的父亲刘弘。","content_jianti_auto":"2三月，戊申，高密孝王略薨。以尚书左仆射山简为征南将军、都督荆·湘·交·广四州诸军事，镇襄阳。简，涛之子也，嗜酒，不恤政事；表「顺阳内史刘璠得众心，恐百姓劫璠为主」。诏征璠为越骑校尉。南州由是遂乱，父老莫不追思刘弘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7402,"number":2,"path":"资治通鉴 : 卷第八十七 (晉紀九) / 孝懷皇帝中 / 永嘉三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"9e8a078b-db0e-11ef-8ad2-a0d3651f611f","year_int":309},"tongjian_id":"9e8a078b-db0e-11ef-8ad2-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"羊祜","people_name_jianti_auto":"羊祜","start_index":19,"tongjian_id":"9f257fdc-db0e-11ef-a9a6-a0d3651f611f"},{"people_name":"晉惠帝","people_name_jianti_auto":"晋惠帝","start_index":27,"tongjian_id":"9f257fdd-db0e-11ef-a378-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沔水","place_name_jianti_auto":"沔水","start_index":4,"tongjian_id":"9f257fde-db0e-11ef-951d-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","start_index":8,"tongjian_id":"9f257fdf-db0e-11ef-b062-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":18,"tongjian_id":"9f257fe0-db0e-11ef-b111-a0d3651f611f"},{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":22,"tongjian_id":"9f257fe1-db0e-11ef-bbec-a0d3651f611f"},{"place_name":"江夏","place_name_jianti_auto":"江夏","start_index":36,"tongjian_id":"9f257fe2-db0e-11ef-9621-a0d3651f611f"},{"place_name":"竟陵郡","place_name_jianti_auto":"竟陵郡","start_index":43,"tongjian_id":"9f257fe3-db0e-11ef-945c-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","start_index":48,"tongjian_id":"9f257fe4-db0e-11ef-a872-a0d3651f611f"},{"place_name":"郢州","place_name_jianti_auto":"郢州","start_index":52,"tongjian_id":"9f257fe5-db0e-11ef-bb32-a0d3651f611f"},{"place_name":"長壽縣","place_name_jianti_auto":"长寿县","start_index":54,"tongjian_id":"9f257fe6-db0e-11ef-876a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"水經註：沔水南逕石城西；城因山爲固，晉羊祜鎭荊州，立。晉惠帝元康九年，分江夏西部都尉置竟陵郡，治石城。今郢州長壽縣卽其地。","note_content_jianti_auto":"水经注：沔水南迳石城西；城因山为固，晋羊祜镇荆州，立。晋惠帝元康九年，分江夏西部都尉置竟陵郡，治石城。今郢州长寿县即其地。","note_type":"hu_note","start_index":65,"tongjian_id":"9f257fdb-db0e-11ef-bd00-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1606,"start_index":97,"tongjian_id":"9f257ff8-db0e-11ef-8663-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、承天府（卷七十七）","excerpts":[{"context_after":"咸康五年，庾亮欲移镇石城，不果。既而石虎将夔安南寇，围石...","context_before":"...亦置戍焉。惠帝元康九年，分江夏西部都尉置竟陵郡，治石城。","source_end_index":119,"source_paragraph_tongjian_id":"a242a8cb-1349-52d2-9b70-e896125cc445","source_start_index":100,"source_text":"建兴三年，陶侃围杜曾于石城，为曾所败。"}],"path":"湖广方舆纪要/四、承天府（卷七十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"陶侃旣破杜弢，乘勝進擊曾，有輕曾之志。司馬魯恬諫曰：「凡戰，當先料其將。今使君諸將，無及曾者，未易可逼也。」侃不從，進圍曾於石城。曾軍多騎兵，密開門突侃陳，出其後，反擊之，侃兵死者數百人。曾將趨順陽，下馬拜侃，告辭而去。","content_fanyi":"陶侃打败杜弢以后，乘胜进军攻击杜曾，心里不免有些轻视杜曾。司马鲁恬劝谏说：“凡是用兵作战，都应当先估量对方将领。如今您帐下诸将，没有谁能比得上杜曾，不可轻易进逼。”陶侃不肯听从，进兵到石城把杜曾包围。杜曾军中骑兵很多，暗中打开城门突击陶侃军阵，绕到阵后反攻，陶侃士兵战死数百人。杜曾准备前往顺阳，便下马向陶侃下拜告辞，然后离去。","content_jianti_auto":"陶侃既破杜弢，乘胜进击曾，有轻曾之志。司马鲁恬谏曰：「凡战，当先料其将。今使君诸将，无及曾者，未易可逼也。」侃不从，进围曾于石城。曾军多骑兵，密开门突侃陈，出其后，反击之，侃兵死者数百人。曾将趋顺阳，下马拜侃，告辞而去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7647,"path":"资治通鉴 : 卷第八十九 (晉紀十一) / 孝愍皇帝下 / 三年 / 第 20 段","reading_annotation_sources":[],"start_index":19,"tongjian_id":"9f257fd9-db0e-11ef-9c43-a0d3651f611f","year_int":315},"tongjian_id":"9f257fd9-db0e-11ef-9c43-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"魏該","people_name_jianti_auto":"魏该","start_index":0,"tongjian_id":"9f7d31f7-db0e-11ef-924e-a0d3651f611f"},{"people_name":"懷帝","people_name_jianti_auto":"怀帝","start_index":3,"tongjian_id":"9f7d31f8-db0e-11ef-a5f8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宜陽","place_name_jianti_auto":"宜阳","start_index":7,"tongjian_id":"9f7d31f9-db0e-11ef-a42a-a0d3651f611f"},{"place_name":"一泉塢","place_name_jianti_auto":"一泉坞","start_index":10,"tongjian_id":"9f7d31fa-db0e-11ef-a788-a0d3651f611f"},{"place_name":"宜陽縣","place_name_jianti_auto":"宜阳县","start_index":14,"tongjian_id":"9f7d31fb-db0e-11ef-a7aa-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":19,"tongjian_id":"9f7d31fc-db0e-11ef-b723-a0d3651f611f"},{"place_name":"新野縣","place_name_jianti_auto":"新野县","start_index":23,"tongjian_id":"9f7d31fd-db0e-11ef-aeda-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":27,"tongjian_id":"9f7d31fe-db0e-11ef-82c1-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":29,"tongjian_id":"9f7d31ff-db0e-11ef-b873-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":33,"tongjian_id":"9f7d3200-db0e-11ef-bfc9-a0d3651f611f"},{"place_name":"義陽郡","place_name_jianti_auto":"义阳郡","start_index":35,"tongjian_id":"9f7d3201-db0e-11ef-982d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏該自懷帝末屯宜陽界一泉塢。宜陽縣，屬弘農郡。新野縣，漢屬南陽郡，晉屬義陽郡。","note_content_jianti_auto":"魏该自怀帝末屯宜阳界一泉坞。宜阳县，属弘农郡。新野县，汉属南阳郡，晋属义阳郡。","note_type":"hu_note","start_index":18,"tongjian_id":"9f7d31f6-db0e-11ef-9eef-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":28,"tongjian_id":"9f7d3208-db0e-11ef-9216-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"盖其地险固可凭也。《水经注》：洛水经卢氏县南，又东过一合...","context_before":"...乙合坞。晋永嘉末，魏浚屯洛北石梁坞，族子该聚众屯一泉坞。","source_end_index":58,"source_paragraph_tongjian_id":"5d9d3f5c-7523-5874-b466-655e744fe327","source_start_index":42,"source_text":"大兴初，谈始自宜阳帅众南迁新野。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"盖其地险固可凭也。《水经注》：洛水经卢氏县南，又东过一合...","context_before":"...乙合坞。晋永嘉末，魏浚屯洛北石梁坞，族子该聚众屯一泉坞。","source_end_index":58,"source_paragraph_tongjian_id":"f315f3af-1867-5cf7-842b-45b0705f182d","source_start_index":42,"source_text":"大兴初，谈始自宜阳帅众南迁新野。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"魏該爲胡寇所逼，自宜陽率衆南遷新野，助周訪討杜曾有功，拜順陽太守。","content_fanyi":"魏该为胡族敌寇所逼迫，自宜阳率部众南迁新野，因协助周访讨伐杜曾有功，拜为顺阳太守。","content_jianti_auto":"魏该为胡寇所逼，自宜阳率众南迁新野，助周访讨杜曾有功，拜顺阳太守。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7786,"path":"资治通鉴 : 卷第九十一 (晉紀十三) / 中宗元皇帝中 / 太興二年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"9f7d31f5-db0e-11ef-9b6b-a0d3651f611f","year_int":319},"tongjian_id":"9f7d31f5-db0e-11ef-9b6b-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"甘卓","people_name_jianti_auto":"甘卓","start_index":2,"tongjian_id":"9fab554c-db0e-11ef-838a-a0d3651f611f"},{"people_name":"魏該","people_name_jianti_auto":"魏该","start_index":6,"tongjian_id":"9fab554d-db0e-11ef-8d3d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言甘卓不如魏該之忠果。","note_content_jianti_auto":"史言甘卓不如魏该之忠果。","note_type":"hu_note","start_index":57,"tongjian_id":"9fab554b-db0e-11ef-8101-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":7,"tongjian_id":"9fab5551-db0e-11ef-85e2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"卓使人以敦旨告順陽太守魏該，該曰：「我所以起兵拒胡賊者，正欲忠於王室耳。今王公舉兵向天子，非吾所宜與也。」遂絕之。","content_fanyi":"甘卓派人把王敦的意图告知顺阳太守魏该，魏该说：“我所以起兵抗击胡人寇贼，正是想要效忠王室。如今王敦举兵指向天子，这不是我应当参与的。”便拒绝了。","content_jianti_auto":"卓使人以敦旨告顺阳太守魏该，该曰：「我所以起兵拒胡贼者，正欲忠于王室耳。今王公举兵向天子，非吾所宜与也。」遂绝之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7859,"path":"资治通鉴 : 卷第九十二 (晉紀十四) / 中宗元皇帝下 / 永昌元年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"9fab5549-db0e-11ef-9efc-a0d3651f611f","year_int":322},"tongjian_id":"9fab5549-db0e-11ef-9efc-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"酇縣","place_name_jianti_auto":"酂县","start_index":0,"tongjian_id":"9ff6a91b-db0e-11ef-8b01-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":3,"tongjian_id":"9ff6a91c-db0e-11ef-8929-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":5,"tongjian_id":"9ff6a91d-db0e-11ef-bd42-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":10,"tongjian_id":"9ff6a91e-db0e-11ef-80b9-a0d3651f611f"},{"place_name":"順陽郡","place_name_jianti_auto":"顺阳郡","start_index":14,"tongjian_id":"9ff6a91f-db0e-11ef-8180-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"酇縣，漢屬南陽郡，及晉，分爲順陽郡治所。酇，音贊。","note_content_jianti_auto":"酂县，汉属南阳郡，及晋，分为顺阳郡治所。酂，音赞。","note_type":"hu_note","start_index":10,"tongjian_id":"9ff6a91a-db0e-11ef-950b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":10,"tongjian_id":"9ff6a925-db0e-11ef-af62-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"11趙將黃秀等寇酇，順陽太守魏該帥衆奔襄陽。","content_fanyi":"前赵将领黄秀等人侵犯酂县，顺阳太守魏该率领部众逃奔襄阳。","content_jianti_auto":"11赵将黄秀等寇酂，顺阳太守魏该帅众奔襄阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7999,"number":11,"path":"资治通鉴 : 卷第九十三 (晉紀十五) / 顯宗成皇帝上之上 / 咸和元年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"9ff6a919-db0e-11ef-9a05-a0d3651f611f","year_int":326},"tongjian_id":"9ff6a919-db0e-11ef-9a05-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"成帝","people_name_jianti_auto":"成帝","start_index":0,"tongjian_id":"a1d90363-db0e-11ef-9c94-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","start_index":3,"tongjian_id":"a1d90364-db0e-11ef-a8ef-a0d3651f611f"},{"place_name":"南鄕郡","place_name_jianti_auto":"南鄕郡","start_index":6,"tongjian_id":"a1d90365-db0e-11ef-8bf7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"成帝改順陽曰南鄕郡，旣而復舊。","note_content_jianti_auto":"成帝改顺阳曰南鄕郡，既而复旧。","note_type":"hu_note","start_index":21,"tongjian_id":"a1d90362-db0e-11ef-b17c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":7,"tongjian_id":"a1d9036a-db0e-11ef-b0eb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"溫之屯灞上也，順陽太守薛珍勸溫徑進逼長安；溫弗從。珍以偏師獨濟，頗有所獲。及溫退，乃還，顯言於衆，自矜其勇而咎溫之持重；溫殺之。","content_fanyi":"桓温屯驻灞上时，顺阳太守薛珍劝他径直进逼长安，桓温没有听从。薛珍率领偏师独自渡过灞水，颇有收获。等到桓温退兵，他才返回，在士兵面前公开扬言，夸耀自己勇敢，责怪桓温过于持重；桓温便杀了他。","content_jianti_auto":"温之屯灞上也，顺阳太守薛珍劝温径进逼长安；温弗从。珍以偏师独济，颇有所获。及温退，乃还，显言于众，自矜其勇而咎温之持重；温杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8653,"path":"资治通鉴 : 卷第九十九 (晉紀二十一) / 孝宗穆皇帝中之上 / 十年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"a1d90361-db0e-11ef-9c26-a0d3651f611f","year_int":354},"tongjian_id":"a1d90361-db0e-11ef-9c26-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"順陽","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"順陽郡","place_name_jianti_auto":"顺阳郡","start_index":9,"tongjian_id":"a2e96dfc-db0e-11ef-90f9-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":13,"tongjian_id":"a2e96dfd-db0e-11ef-8093-a0d3651f611f"},{"place_name":"鄧州","place_name_jianti_auto":"邓州","start_index":14,"tongjian_id":"a2e96dfe-db0e-11ef-ba0e-a0d3651f611f"},{"place_name":"臨湍","place_name_jianti_auto":"临湍","start_index":16,"tongjian_id":"a2e96dff-db0e-11ef-be20-a0d3651f611f"},{"place_name":"菊潭","place_name_jianti_auto":"菊潭","start_index":19,"tongjian_id":"a2e96e00-db0e-11ef-afd6-a0d3651f611f"},{"place_name":"順陽","place_name_jianti_auto":"顺阳","start_index":25,"tongjian_id":"a2e96e01-db0e-11ef-89cd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉志曰：太康中，置順陽郡；唐鄧州臨湍、菊潭二縣，古順陽地。","note_content_jianti_auto":"晋志曰：太康中，置顺阳郡；唐邓州临湍、菊潭二县，古顺阳地。","note_type":"hu_note","start_index":10,"tongjian_id":"a2e96dfb-db0e-11ef-ac76-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"順陽","place_name_jianti_auto":"顺阳","resolved_place_entity_id":1607,"start_index":7,"tongjian_id":"a2e96e05-db0e-11ef-bdec-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"秦將軍慕容越拔順陽，執太守譙國丁穆。堅欲官之，穆固辭不受。堅以中壘將軍梁成爲荊州刺史，配兵一萬，鎭襄陽，選其才望，禮而用之。","content_fanyi":"前秦将军慕容越攻下顺阳，俘获了太守、谯国人丁穆。苻坚想授予他官职，丁穆坚决推辞，不肯接受。苻坚任命中垒将军梁成为荆州刺史，给他配备一万兵力镇守襄阳，并挑选当地有才能、有名望的人，以礼相待，加以任用。","content_jianti_auto":"秦将军慕容越拔顺阳，执太守谯国丁穆。坚欲官之，穆固辞不受。坚以中垒将军梁成为荆州刺史，配兵一万，镇襄阳，选其才望，礼而用之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9155,"path":"资治通鉴 : 卷第一百四 (晉紀二十六) / 烈宗孝武皇帝上之中 / 四年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"a2e96dfa-db0e-11ef-a825-a0d3651f611f","year_int":379},"tongjian_id":"a2e96dfa-db0e-11ef-a825-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":2,"total_paragraphs":15},"place_name":"順陽"},"message":"success","success":true}