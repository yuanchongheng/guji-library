ngjian_id":"8c451add-db0e-11ef-a370-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":29,"tongjian_id":"8c451ade-db0e-11ef-839f-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":36,"tongjian_id":"8c451adf-db0e-11ef-a1c4-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","start_index":42,"tongjian_id":"8c451ae0-db0e-11ef-af6f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，陝縣屬弘農郡，故虢國。北虢在大陽，東虢在滎陽，西虢在雍州。周、召分陝而治，卽此陝也。帥，讀曰率。陝，失冉翻。召，讀曰邵。","note_content_jianti_auto":"班志，陕县属弘农郡，故虢国。北虢在大阳，东虢在荥阳，西虢在雍州。周、召分陕而治，即此陕也。帅，读曰率。陕，失冉翻。召，读曰邵。","note_type":"hu_note","start_index":12,"tongjian_id":"8c451ad2-db0e-11ef-ae5b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":2,"tongjian_id":"8c451ae2-db0e-11ef-9e28-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c451ae3-db0e-11ef-acf8-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":7,"tongjian_id":"8c451ae4-db0e-11ef-98e7-a0d3651f611f"},{"place_name":"陝","place_name_jianti_auto":"陕","resolved_place_entity_id":307,"start_index":10,"tongjian_id":"8c451ae5-db0e-11ef-a942-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"汉置县，属弘农郡。后汉兴平二年，李傕等作乱，帝崎岖至陕，...","context_before":"○废陕县[今州治。《史记》：秦孝公元年，东围陕城。","source_end_index":49,"source_paragraph_tongjian_id":"130fc105-e44e-5456-8f8c-b32e52a7dc60","source_start_index":25,"source_text":"又惠文君十三年，使张仪伐魏，取陕，出其人以与魏。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"汉置县，属弘农郡。后汉兴平二年，李傕等作乱，帝崎岖至陕，...","context_before":"○废陕县[今州治。《史记》：秦孝公元年，东围陕城。","source_end_index":49,"source_paragraph_tongjian_id":"d955e798-8ff6-599a-87be-d827c91d83ca","source_start_index":25,"source_text":"又惠文君十三年，使张仪伐魏，取陕，出其人以与魏。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1秦張儀帥師伐魏，取陝。","content_fanyi":"秦国的张仪率领秦军攻打魏国，夺取了陕邑。","content_jianti_auto":"1秦张仪帅师伐魏，取陕。","dtjl_paragraph_links":[],"dtjl_references":[],"id":210,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c451ad1-db0e-11ef-a8d5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕，因肩翻。易，音如字。說，式芮翻。諡法：好更改舊曰易。註：變故改常。","note_content_jianti_auto":"燕，因肩翻。易，音如字。说，式芮翻。谥法：好更改旧曰易。注：变故改常。","note_type":"hu_note","start_index":50,"tongjian_id":"8c451ae7-db0e-11ef-be53-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":16,"source_start_index":6,"source_text":"爲後齊大夫殺蘇秦張本","target_paragraph_tongjian_id":"8c5c61d7-db0e-11ef-849f-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":12,"tongjian_id":"8c451aeb-db0e-11ef-b1c5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":8,"tongjian_id":"8c451aec-db0e-11ef-aa78-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。爲後齊大夫殺蘇秦張本。","note_content_jianti_auto":"说，式芮翻。为后齐大夫杀苏秦张本。","note_type":"hu_note","start_index":94,"tongjian_id":"8c451aea-db0e-11ef-9534-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"客卿","official_note":"客卿是战国时期诸侯国授予外来人才的官职，通常无固定品秩，用于招揽贤能，此处齐宣王任命苏秦为客卿，以利用其才能。","official_rank":"未知","source_snippet":"齊宣王以爲客卿","start_index":54,"tongjian_id":"55abda3f-da51-4da2-a7f4-be3b2b51fddb"}],"ExtRef_Children_people":[{"link_death_year":-284,"link_td_description":"苏秦，己姓，蘇氏，字季子，東周雒邑（今河南洛陽東）乘軒里人，相传为鬼谷子徒弟。战国时期纵横家和谋略官。","link_td_id":"Q10001054","link_td_number_id":133739,"people_name":"蘇秦","people_name_jianti_auto":"苏秦","people_xingming":"苏秦","start_index":1,"tongjian_id":"8c451aed-db0e-11ef-946e-a0d3651f611f"},{"link_death_year":-333,"link_td_description":"燕后文公，即燕文侯，中国战国时期的燕国君主，继燕后桓公之位，在位二十九年，秦惠文王将女儿嫁给燕太子。文公卒，燕易王立。齐宣王趁新君不稳攻讨之，取燕十座城池。武安君苏秦为燕说齐王，说服了齐宣王把城池又还给燕国。二十九年（前333年），文公去世，太子即位，是为燕易王。","link_td_id":"Q10000603","link_td_number_id":319373,"people_name":"燕文公","people_name_jianti_auto":"燕文公","people_xingming":"燕文公","start_index":5,"tongjian_id":"8c451aee-db0e-11ef-9ec1-a0d3651f611f"},{"link_death_year":-321,"link_td_description":"燕易王，姬姓，燕氏，本名不详，中国战国时期的燕国君主，燕后文公之子。在位期间称王。","link_td_id":"Q10008537","link_td_number_id":316112,"people_name":"易王","people_name_jianti_auto":"易王","people_xingming":"燕易王","start_index":12,"tongjian_id":"8c451aef-db0e-11ef-9847-a0d3651f611f"},{"link_death_year":-284,"link_td_description":"苏秦，己姓，蘇氏，字季子，東周雒邑（今河南洛陽東）乘軒里人，相传为鬼谷子徒弟。战国时期纵横家和谋略官。","link_td_id":"Q10001054","link_td_number_id":133739,"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":17,"tongjian_id":"8c451af0-db0e-11ef-9c3f-a0d3651f611f"},{"link_death_year":-321,"link_td_description":"燕易王，姬姓，燕氏，本名不详，中国战国时期的燕国君主，燕后文公之子。在位期间称王。","link_td_id":"Q10008537","link_td_number_id":316112,"people_name":"易王","people_name_jianti_auto":"易王","start_index":23,"tongjian_id":"8c451af1-db0e-11ef-9b38-a0d3651f611f"},{"link_dea