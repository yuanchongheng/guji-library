eople_name":"鞠彭","people_name_jianti_auto":"鞠彭","start_index":65,"tongjian_id":"a09b0100-db0e-11ef-bd29-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":77,"tongjian_id":"a09b0101-db0e-11ef-a6cd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"樂浪","place_name_jianti_auto":"乐浪","start_index":0,"tongjian_id":"a09b0102-db0e-11ef-b4cf-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"a09b0103-db0e-11ef-ace3-a0d3651f611f"},{"place_name":"樂浪","place_name_jianti_auto":"乐浪","start_index":35,"tongjian_id":"a09b0104-db0e-11ef-9d36-a0d3651f611f"},{"place_name":"冀陽","place_name_jianti_auto":"冀阳","start_index":38,"tongjian_id":"a09b0105-db0e-11ef-98b2-a0d3651f611f"},{"place_name":"營丘郡","place_name_jianti_auto":"营丘郡","start_index":41,"tongjian_id":"a09b0106-db0e-11ef-a193-a0d3651f611f"},{"place_name":"朝鮮","place_name_jianti_auto":"朝鲜","start_index":45,"tongjian_id":"a09b0107-db0e-11ef-8d6e-a0d3651f611f"},{"place_name":"武寧","place_name_jianti_auto":"武宁","start_index":48,"tongjian_id":"a09b0108-db0e-11ef-8ada-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":56,"tongjian_id":"a09b0109-db0e-11ef-8524-a0d3651f611f"},{"place_name":"遼西郡","place_name_jianti_auto":"辽西郡","start_index":57,"tongjian_id":"a09b010a-db0e-11ef-9651-a0d3651f611f"},{"place_name":"柳城縣","place_name_jianti_auto":"柳城县","start_index":60,"tongjian_id":"a09b010b-db0e-11ef-b9d0-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":71,"tongjian_id":"a09b010c-db0e-11ef-be46-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"樂浪，非漢古郡地也，慕容廆所置，見八十八卷愍帝建興元年。以五代志考之，樂浪、冀陽、營丘郡、朝鮮、武寧等縣，當盡在隋遼西郡柳城縣界。鞠彭率鄕人歸燕，見九十卷元帝太興二年。樂浪，音洛琅。","note_content_jianti_auto":"乐浪，非汉古郡地也，慕容廆所置，见八十八卷愍帝建兴元年。以五代志考之，乐浪、冀阳、营丘郡、朝鲜、武宁等县，当尽在隋辽西郡柳城县界。鞠彭率鄕人归燕，见九十卷元帝太兴二年。乐浪，音洛琅。","note_type":"hu_note","start_index":200,"tongjian_id":"a09b00fd-db0e-11ef-a7e1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f","pinyin":"jū","source_anchor_text":"樂浪太守鞠彭以境內","source_key":"baiyang_epub","start_index":178,"text":"鞠","tongjian_id":"d284e56c-fde3-585c-96c0-1671fdf37deb"}],"ExtRef_Children_places":[{"place_name":"成周","place_name_jianti_auto":"成周","resolved_place_entity_id":3196,"start_index":12,"tongjian_id":"a09b011d-db0e-11ef-b8af-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"虎遣使四出，招誘民夷，燕成周內史崔燾、居就令游泓、武原令常霸、東夷校尉封抽、護軍宋晃等皆應之，凡得三十六城。泓，邃之兄子也。冀陽流寓之士共殺太守宋燭以降於趙。燭，晃之從兄也。營丘內史鮮于屈亦遣使降趙；武寧令廣平孫興曉諭吏民共收屈，數其罪而殺之，閉城拒守。朝鮮令昌黎孫泳帥衆拒趙。大姓王清等密謀應趙，泳收斬之；同謀數百人惶怖請罪，泳皆釋之，與同拒守。樂浪太守鞠彭以境內皆叛，選鄕里壯士二百餘人共還棘城。","content_fanyi":"石虎派遣使者四面出动，招诱百姓和夷人，前燕成周内史崔焘、居就县令游泓、武原县令常霸、东夷校尉封抽、护军宋晃等人都响应石虎，共取得三十六座城。游泓是游邃兄长的儿子。冀阳的侨居士人共同杀死太守宋烛，向后赵投降。宋烛是宋晃的堂兄。营丘内史鲜于屈也派使者向后赵投降；武宁县令、广平人孙兴明白晓谕官吏和百姓，一起收捕鲜于屈，列举他的罪状后将他杀死，然后关闭城门拒守。朝鲜县令、昌黎人孙泳率领士众抵御后赵军队。大姓王清等人密谋响应后赵，孙泳将他们收捕斩首；参与同谋的数百人惊惶恐惧，向孙泳请罪，孙泳把他们全部释放，不予追究，并与他们共同拒守。乐浪太守鞠彭因为境内士民都已背叛，挑选同乡壮士二百多人，一同返回棘城。","content_jianti_auto":"虎遣使四出，招诱民夷，燕成周内史崔焘、居就令游泓、武原令常霸、东夷校尉封抽、护军宋晃等皆应之，凡得三十六城。泓，邃之兄子也。冀阳流寓之士共杀太守宋烛以降于赵。烛，晃之从兄也。营丘内史鲜于屈亦遣使降赵；武宁令广平孙兴晓谕吏民共收屈，数其罪而杀之，闭城拒守。朝鲜令昌黎孙泳帅众拒赵。大姓王清等密谋应赵，泳收斩之；同谋数百人惶怖请罪，泳皆释之，与同拒守。乐浪太守鞠彭以境内皆叛，选鄕里壮士二百余人共还棘城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8244,"path":"资治通鉴 : 卷第九十六 (晉紀十八) / 顯宗成皇帝中之下 / 咸康四年 / 第 15 段","reading_annotation_sources":[],"start_index":14,"tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f","year_int":338},"tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"成周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":5,"tongjian_id":"a7ec07a7-db0e-11ef-a1ff-a0d3651f611f"},{"place_name":"營州","place_name_jianti_auto":"营州","start_index":8,"tongjian_id":"a7ec07a8-db0e-11ef-a450-a0d3651f611f"},{"place_name":"和龍城","place_name_jianti_auto":"和龙城","start_index":11,"tongjian_id":"a7ec07a9-db0e-11ef-8ee4-a0d3651f611f"},{"place_name":"建德","place_name_jianti_auto":"建德","start_index":16,"tongjian_id":"a7ec07aa-db0e-11ef-ba4f-a0d3651f611f"},{"place_name":"冀陽","place_name_jianti_auto":"冀阳","start_index":19,"tongjian_id":"a7ec07ab-db0e-11ef-addd-a0d3651f611f"},{"place_name":"遼東","place_name_jianti_auto":"辽东","start_index":22,"tongjian_id":"a7ec07ac-db0e-11ef-90e3-a0d3651f611f"},{"place_name":"樂浪","place_name_jianti_auto":"乐浪","start_index":25,"tongjian_id":"a7ec07ad-db0e-11ef-85b4-a0d3651f611f"},{"place_name":"營丘","place_name_jianti_auto":"营丘","start_index":28,"tongjian_id":"a7ec07ae-db0e-11ef-8c7c-a0d3651f611f"},{"place_name":"龍城","place_name_jianti_auto":"龙城","start_index":33,"tongjian_id":"a7ec07af-db0e-11ef-a11a-a0d3651f611f"},{"place_name":"大興","place_name_jianti_auto":"大兴","start_index":36,"tongjian_id":"a7ec07b0-db0e-11ef-963b-a0d3651f611f"},{"place_name":"永樂","place_name_jianti_auto":"永乐","start_index":39,"tongjian_id":"a7ec07b1-db0e-11ef-9bb8-a0d3651f611f"},{"place_name":"帶方","place_name_jianti_auto":"带方","start_index":42,"tongjian_id":"a7ec07b2-db0e-11ef-a8e6-a0d3651f611f"},{"place_name":"定荒","place_name_jianti_auto":"定荒","start_index":45,"tongjian_id":"a7ec07b3-db0e-11ef-8d3d-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","start_index":48,"tongjian_id":"a7ec07b4-db0e-11ef-b7aa-a0d3651f611f"},{"place_name":"廣都","place_name_jianti_auto":"广都","start_index":51,"tongjian_id":"a7ec07b5-db0e-11ef-804d-a0d3651f611f"},{"place_name":"陽武","place_name_jianti_auto":"阳武","start_index":54,"tongjian_id":"a7ec07b6-db0e-11ef-956f-a0d3651f611f"},{"place_name":"襄平","place_name_jianti_auto":"襄平","start_index":57,"tongjian_id":"a7ec07b7-db0e-11ef-adaa-a0d3651f611f"},{"place_name":"新昌","place_name_jianti_auto":"新昌","start_index":60,"tongjian_id":"a7ec07b8-db0e-11ef-a09c-a0d3651f611f"},{"place_name":"平剛","place_name_jianti_auto":"平刚","start_index":63,"tongjian_id":"a7ec07b9-db0e-11ef-a8fa-a0d3651f611f"},{"place_name":"柳城","place_name_jianti_auto":"柳城","start_index":66,"tongjian_id":"a7ec07ba-db0e-11ef-9e86-a0d3651f611f"},{"place_name":"富平","place_name_jianti_auto":"富平","start_index":69,"tongjian_id":"a7ec07bb-db0e-11ef-aeae-a0d3651f611f"},{"place_name":"燕國","place_name_jianti_auto":"燕国","start_index":75,"tongjian_id":"a7ec07bc-db0e-11ef-82c0-a0d3651f611f"},{"place_name":"慕容","place_name_jianti_auto":"慕容","start_index":78,"tongjian_id":"a7ec07bd-db0e-11ef-9867-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","start_index":88,"tongjian_id":"a7ec07be-db0e-11ef-875c-a0d3651f611f"},{"place_name":"玄菟郡","place_name_jianti_auto":"玄菟郡","start_index":109,"tongjian_id":"a7ec07bf-db0e-11ef-801d-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","start_index":116,"tongjian_id":"a7ec07c0-db0e-11ef-8437-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志曰：後魏置營州於和龍城，領建德、冀陽、遼東、樂浪、營丘等郡，龍城、大興、永樂、帶方、定荒、石城、廣都、陽武、襄平、新昌、平剛、柳城、富平等縣。蓋燕國自慕容以來，分置郡縣於遼西，其後或省或倂，爲郡爲縣，皆不可考；如玄菟郡亦當置於遼西也。驃，匹妙翻。騎，奇寄翻。樂浪，音洛琅。菟，同都翻。","note_content_jianti_auto":"五代志曰：后魏置营州于和龙城，领建德、冀阳、辽东、乐浪、营丘等郡，龙城、大兴、永乐、带方、定荒、石城、广都、阳武、襄平、新昌、平刚、柳城、富平等县。盖燕国自慕容以来，分置郡县于辽西，其后或省或倂，为郡为县，皆不可考；如玄菟郡亦当置于辽西也。骠，匹妙翻。骑，奇寄翻。乐浪，音洛琅。菟，同都翻。","note_type":"hu_note","start_index":41,"tongjian_id":"a7ec07a6-db0e-11ef-ae8a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"成周","place_name_jianti_auto":"成周","resolved_place_entity_id":3196,"start_index":17,"tongjian_id":"a7ec07c4-db0e-11ef-a930-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"是也。高齐废平刚等县，以冀阳郡寄治龙城。隋初郡废。土垠，...","context_before":"...流人置成周郡，并州流人置唐国郡，又于平州界内置乐浪等郡。","source_end_index":506,"source_paragraph_tongjian_id":"9409ee79-7415-54cb-b99d-fda62f1a73ae","source_start_index":455,"source_text":"宋元嘉九年，魏主焘攻北燕和龙，不克。引兵西还，徙营丘、成周、辽东、乐浪、带方、玄菟六郡民三万家于幽州。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"九月，乙卯，魏主引兵西還，徙營丘、成周、遼東、樂浪、帶方、玄菟六郡民三萬家於幽州。","content_fanyi":"九月乙卯日，北魏国主拓跋焘率军向西返回，将营丘、成周、辽东、乐浪、带方、玄菟六郡百姓三万家迁往幽州。","content_jianti_auto":"九月，乙卯，魏主引兵西还，徙营丘、成周、辽东、乐浪、带方、玄菟六郡民三万家于幽州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11235,"path":"资治通鉴 : 卷第一百二十二 (宋紀四) / 太祖文皇帝上之下 / 九年 / 第 24 段","reading_annotation_sources":[],"start_index":23,"tongjian_id":"a7ec07a5-db0e-11ef-8cff-a0d3651f611f","year_int":432},"tongjian_id":"a7ec07a5-db0e-11ef-8cff-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"成周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":14,"tongjian_id":"aceb9d54-db0e-11ef-801b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"aceb9d55-db0e-11ef-99e9-a0d3651f611f"},{"place_name":"沃野縣","place_name_jianti_auto":"沃野县","start_index":1,"tongjian_id":"aceb9d56-db0e-11ef-b6b3-a0d3651f611f"},{"place_name":"朔方郡","place_name_jianti_auto":"朔方郡","start_index":5,"tongjian_id":"aceb9d57-db0e-11ef-b6ea-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":9,"tongjian_id":"aceb9d58-db0e-11ef-8f67-a0d3651f611f"},{"place_name":"偏城郡","place_name_jianti_auto":"偏城郡","start_index":23,"tongjian_id":"aceb9d59-db0e-11ef-8ec7-a0d3651f611f"},{"place_name":"沃野縣","place_name_jianti_auto":"沃野县","start_index":27,"tongjian_id":"aceb9d5a-db0e-11ef-a47d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢沃野縣屬朔方郡，後魏爲鎭。魏收志，太和元年置偏城郡，沃野縣屬焉。此時鎭猶未廢也，註已見前。","note_content_jianti_auto":"汉沃野县属朔方郡，后魏为镇。魏收志，太和元年置偏城郡，沃野县属焉。此时镇犹未废也，注已见前。","note_type":"hu_note","start_index":14,"tongjian_id":"aceb9d53-db0e-11ef-a0ea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隨須者，隨軍行之所須以爲用者也。","note_content_jianti_auto":"随须者，随军行之所须以为用者也。","note_type":"hu_note","start_index":44,"tongjian_id":"aceb9d5d-db0e-11ef-b75b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"代","place_name_jianti_auto":"代","place_note":"故都平城【山西大同】","start_index":0,"tongjian_id":"aceb9d5f-db0e-11ef-9a97-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":4,"tongjian_id":"aceb9d60-db0e-11ef-9afe-a0d3651f611f"},{"place_name":"代都","place_name_jianti_auto":"代都","start_index":5,"tongjian_id":"aceb9d61-db0e-11ef-b33a-a0d3651f611f"},{"place_name":"高車","place_name_jianti_auto":"高车","start_index":16,"tongjian_id":"aceb9d62-db0e-11ef-b937-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"代表，謂魏代都之塞外也。諸國，謂高車諸部。夏，戶雅翻。恆，戶登翻。上，時掌翻。","note_content_jianti_auto":"代表，谓魏代都之塞外也。诸国，谓高车诸部。夏，户雅翻。恒，户登翻。上，时掌翻。","note_type":"hu_note","start_index":149,"tongjian_id":"aceb9d5e-db0e-11ef-b04c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"成周","place_name_jianti_auto":"成周","place_note":"洛阳","resolved_place_entity_id":3195,"start_index":132,"tongjian_id":"aceb9d71-db0e-11ef-87b8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"正光四年，沃野镇民破六韩拔陵畔，其党卫可孤围武川镇，遂攻...","context_before":"...镇，如抚宣镇，复如柔玄镇。胡氏以为此六镇自西徂东之次第。","source_end_index":212,"source_paragraph_tongjian_id":"6d6fe9e8-3929-563d-b896-15ac052914f4","source_start_index":121,"source_text":"正始初，柔然侵魏之沃野及怀朔镇，诏原怀出行北边，怀还至恒、代，按视诸镇左右要害可以筑城置戍之处，欲东西为九城，储积粮伏，为犬牙相救之势，使游骑之寇，终不敢攻城，亦不敢越城南出。从之。"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十、突厥（卷四十五）","excerpts":[{"context_after":"三年，请和于魏，魏主不许。五年，复请和于魏，既而为高车所...","context_before":"...去。时柔然浸衰，高车诸部皆叛之。景明三年，柔然复犯魏边。","source_end_index":466,"source_paragraph_tongjian_id":"676ebf45-84a9-53d3-906e-34861111f5bf","source_start_index":446,"source_text":"正始初，又侵魏之沃野、怀朔二镇，寻遁去。"}],"path":"山西方舆纪要/十、突厥（卷四十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十、榆林镇（卷六十一）","excerpts":[{"context_after":"正光四年，沃野镇民破六韩拔陵叛。其党卫可孤，围武川镇，遂...","context_before":"...原镇。寻改曰怀朔，为六镇之一。太和十八年，魏主如怀朔镇。","source_end_index":247,"source_paragraph_tongjian_id":"9dc9f2c4-6339-5b97-8571-9ee63a6df623","source_start_index":213,"source_text":"正始初，柔玄侵魏之沃野及怀朔镇，命源怀出行北边，怀至云中，柔然遁去。"}],"path":"陕西方舆纪要/十、榆林镇（卷六十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"16柔然侵魏之沃野及懷朔鎭，詔車騎大將軍源懷出行北邊，指授方略，隨須徵發，皆以便宜從事。懷至雲中，柔然遁去。懷以爲用夏制夷，莫如城郭，還，至恆、代，按視諸鎭左右要害之地，可以築城置戍之處，欲東西爲九城，及儲糧積仗之宜，犬牙相救之勢，凡五十八條，表上之，曰：「今定鼎成周，去北遙遠，代表諸國頗或外叛，仍遭旱饑，戎馬甲兵十分闕八。謂宜準舊鎭，東西相望，令形勢相接，築城置戍，分兵要害，勸農積粟，警急之日，隨便翦討。彼遊騎之寇，終不敢攻城，亦不敢越城南出。如此，北方無憂矣。」魏主從之。","content_fanyi":"柔然入侵北魏的沃野和怀朔镇，北魏宣武帝下诏命车骑大将军源怀巡行北部边境，布置方略，根据需要征调人力物资，都由他相机决断。源怀抵达云中，柔然随即逃遁。源怀认为用华夏的制度制约夷狄，没有比修筑城郭更好的办法，于是折返，来到恒、代一带，逐一察看各镇附近要害之地和可以筑城设戍的地点，计划自东向西修筑九座城池，并规划储粮积械的适宜办法和犬牙交错互相救援的态势，共五十八条，上表陈奏说：“如今定都洛阳，距离北方极为遥远，旧都代京以北的各部族多已叛离，又连遭旱灾饥荒，战马和甲胄兵器已缺十分之八。臣认为应当参照旧有军镇，使东西彼此相望，形势互相衔接，筑城设戍，分兵把守要害，劝课农耕积蓄粮食，遇有紧急情况时，即可视机出击讨伐。那些游骑敌寇，终究不敢攻打城池，也不敢越过城垒向南进犯。这样，北方便可无忧了。”魏宣武帝采纳了他的建议。","content_jianti_auto":"16柔然侵魏之沃野及怀朔镇，诏车骑大将军源怀出行北边，指授方略，随须征发，皆以便宜从事。怀至云中，柔然遁去。怀以为用夏制夷，莫如城郭，还，至恒、代，按视诸镇左右要害之地，可以筑城置戍之处，欲东西为九城，及储粮积仗之宜，犬牙相救之势，凡五十八条，表上之，曰：「今定鼎成周，去北遥远，代表诸国颇或外叛，仍遭旱饥，戎马甲兵十分阙八。谓宜准旧镇，东西相望，令形势相接，筑城置戍，分兵要害，劝农积粟，警急之日，随便翦讨。彼游骑之寇，终不敢攻城，亦不敢越城南出。如此，北方无忧矣。」魏主从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":13725,"number":16,"path":"资治通鉴 : 卷第一百四十五 (梁紀一) / 高祖武皇帝 / 三年 / 第 28 段","reading_annotation_sources":[],"start_index":27,"tongjian_id":"aceb9d52-db0e-11ef-a383-a0d3651f611f","year_int":504},"tongjian_id":"aceb9d52-db0e-11ef-a383-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"成周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"ba6f2b83-db0e-11ef-aa44-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「明」作「朝」；乙十一行本同。』","note_content_jianti_auto":"『章：十二行本「明」作「朝」；乙十一行本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"ba6f2b82-db0e-11ef-aeb4-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":9,"tongjian_id":"ba6f2b81-db0e-11ef-9379-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐六典：尚藥局屬殿中省，有侍御醫四人，從六品上。璆，音求。","note_content_jianti_auto":"唐六典：尚药局属殿中省，有侍御医四人，从六品上。璆，音求。","note_type":"hu_note","start_index":87,"tongjian_id":"ba6f2b86-db0e-11ef-8918-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宣","people_name_jianti_auto":"宣","start_index":3,"tongjian_id":"ba6f2b8c-db0e-11ef-8507-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":15,"tongjian_id":"ba6f2b8d-db0e-11ef-a5bf-a0d3651f611f"},{"people_name":"漢武","people_name_jianti_auto":"汉武","start_index":33,"tongjian_id":"ba6f2b8e-db0e-11ef-bf51-a0d3651f611f"},{"people_name":"姚璹","people_name_jianti_auto":"姚璹","start_index":48,"tongjian_id":"ba6f2b8f-db0e-11ef-a1cf-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"成周","place_name_jianti_auto":"成周","start_index":9,"tongjian_id":"ba6f2b90-db0e-11ef-9ebf-a0d3651f611f"},{"place_name":"宣榭","place_name_jianti_auto":"宣榭","start_index":11,"tongjian_id":"ba6f2b91-db0e-11ef-a57b-a0d3651f611f"},{"place_name":"宣","place_name_jianti_auto":"宣","start_index":27,"tongjian_id":"ba6f2b92-db0e-11ef-a7df-a0d3651f611f"},{"place_name":"柏梁臺","place_name_jianti_auto":"柏梁台","start_index":37,"tongjian_id":"ba6f2b93-db0e-11ef-9191-a0d3651f611f"},{"place_name":"建章","place_name_jianti_auto":"建章","start_index":45,"tongjian_id":"ba6f2b94-db0e-11ef-9af8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：宣十五年夏，成周宣榭火。班書曰：榭，所以藏樂器；宣，其名也。漢武時，柏梁臺災，及大營建章。姚璹引二事，傅以己說，以逢君之惡。","note_content_jianti_auto":"左传：宣十五年夏，成周宣榭火。班书曰：榭，所以藏乐器；宣，其名也。汉武时，柏梁台灾，及大营建章。姚璹引二事，傅以己说，以逢君之恶。","note_type":"hu_note","start_index":210,"tongjian_id":"ba6f2b8b-db0e-11ef-9097-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"懷義","people_name_jianti_auto":"怀义","start_index":100,"tongjian_id":"ba6f2b99-db0e-11ef-aebe-a0d3651f611f"},{"people_name":"懷義","people_name_jianti_auto":"怀义","start_index":122,"tongjian_id":"ba6f2b9a-db0e-11ef-b850-a0d3651f611f"},{"people_name":"懷義","people_name_jianti_auto":"怀义","start_index":141,"tongjian_id":"ba6f2b9b-db0e-11ef-a46c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"神都","place_name_jianti_auto":"神都","start_index":0,"tongjian_id":"ba6f2b9c-db0e-11ef-b222-a0d3651f611f"},{"place_name":"豫州","place_name_jianti_auto":"豫州","start_index":4,"tongjian_id":"ba6f2b9d-db0e-11ef-a982-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":19,"tongjian_id":"ba6f2b9e-db0e-11ef-a580-a0d3651f611f"},{"place_name":"武興","place_name_jianti_auto":"武兴","start_index":23,"tongjian_id":"ba6f2b9f-db0e-11ef-a24b-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":26,"tongjian_id":"ba6f2ba0-db0e-11ef-856d-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":30,"tongjian_id":"ba6f2ba1-db0e-11ef-8a48-a0d3651f611f"},{"place_name":"兗州","place_name_jianti_auto":"兖州","start_index":33,"tongjian_id":"ba6f2ba2-db0e-11ef-8a90-a0d3651f611f"},{"place_name":"日觀","place_name_jianti_auto":"日观","start_index":37,"tongjian_id":"ba6f2ba3-db0e-11ef-a288-a0d3651f611f"},{"place_name":"青州","place_name_jianti_auto":"青州","start_index":40,"tongjian_id":"ba6f2ba4-db0e-11ef-a31b-a0d3651f611f"},{"place_name":"少陽","place_name_jianti_auto":"少阳","start_index":44,"tongjian_id":"ba6f2ba5-db0e-11ef-971d-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":47,"tongjian_id":"ba6f2ba6-db0e-11ef-a527-a0d3651f611f"},{"place_name":"車源","place_name_jianti_auto":"车源","start_index":51,"tongjian_id":"ba6f2ba7-db0e-11ef-a633-a0d3651f611f"},{"place_name":"揚州","place_name_jianti_auto":"扬州","start_index":54,"tongjian_id":"ba6f2ba8-db0e-11ef-b4ee-a0d3651f611f"},{"place_name":"江都","place_name_jianti_auto":"江都","start_index":58,"tongjian_id":"ba6f2ba9-db0e-11ef-9764-a0d3651f611f"},{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":61,"tongjian_id":"ba6f2baa-db0e-11ef-a508-a0d3651f611f"},{"place_name":"江陵","place_name_jianti_auto":"江陵","start_index":65,"tongjian_id":"ba6f2bab-db0e-11ef-924d-a0d3651f611f"},{"place_name":"梁州","place_name_jianti_auto":"梁州","start_index":68,"tongjian_id":"ba6f2bac-db0e-11ef-b1e8-a0d3651f611f"},{"place_name":"咸都","place_name_jianti_auto":"咸都","start_index":72,"tongjian_id":"ba6f2bad-db0e-11ef-a0e7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"神都鼎曰豫州，高一丈八尺，受千八百石。冀州鼎曰武興，雍州鼎曰長安，兗州鼎曰日觀，青州鼎曰少陽，徐州鼎曰車源，揚州鼎曰江都，荊州鼎曰江陵，梁州鼎曰咸都；八州鼎高一丈四尺，各受千二百石。考異曰：舊傳云：「懷義帥人作號頭安置之。」按天冊萬歲元年二月，懷義死，神功元年九鼎始成，舊傳誤也，或懷義死時方鑄耳。","note_content_jianti_auto":"神都鼎曰豫州，高一丈八尺，受千八百石。冀州鼎曰武兴，雍州鼎曰长安，兖州鼎曰日观，青州鼎曰少阳，徐州鼎曰车源，扬州鼎曰江都，荆州鼎曰江陵，梁州鼎曰咸都；八州鼎高一丈四尺，各受千二百石。考异曰：旧传云：「怀义帅人作号头安置之。」按天册万岁元年二月，怀义死，神功元年九鼎始成，旧传误也，或怀义死时方铸耳。","note_type":"hu_note","start_index":266,"tongjian_id":"ba6f2b98-db0e-11ef-bcf1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"十二神：子屬鼠，丑屬牛，寅屬虎，卯屬兔，辰屬龍，巳屬蛇，午屬馬，未屬羊，申屬猴，酉屬雞，戌屬狗，亥屬豬。","note_content_jianti_auto":"十二神：子属鼠，丑属牛，寅属虎，卯属兔，辰属龙，巳属蛇，午属马，未属羊，申属猴，酉属鸡，戌属狗，亥属猪。","note_type":"hu_note","start_index":271,"tongjian_id":"ba6f2bb1-db0e-11ef-8f1a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"ba6f2b80-db0e-11ef-ac10-a0d3651f611f","pinyin":"qiú","source_anchor_text":"御醫沈南璆亦得幸於","source_key":"baiyang_epub","start_index":86,"text":"璆","tongjian_id":"96ff6340-3c66-5fc8-86c0-3f1d2d530e44"}],"ExtRef_Children_places":[{"place_name":"成周","place_name_jianti_auto":"成周","resolved_place_entity_id":3195,"start_index":190,"tongjian_id":"ba6f2bba-db0e-11ef-bd54-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"乙未，作無遮會於明堂，鑿地爲阬，深五丈，結綵爲宮殿，佛像皆於阬中引出之，云自地涌出。又殺牛取血，畫大像，首高二百尺，云懷義刺膝血爲之。丙申，張像於天津橋南，設齋。時御醫沈南璆亦得幸於太后，懷義心慍，是夕，密燒天堂，延及明堂，火照城中如晝，比明皆盡，暴風裂血像爲數百段。太后恥而諱之，但云內作工徒誤燒麻主，遂涉明堂。時方酺宴，左拾遺劉承慶請輟朝停酺以答天譴，太后將從之。姚璹曰：「昔成周宣榭，卜代愈隆；漢武建章，盛德彌永。今明堂布政之所，非宗廟也，不應自貶損。」太后乃御端門，觀酺如平日。命更造明堂、天堂，仍以懷義充使。又鑄銅爲九州鼎及十二神，皆高一丈，各置其方。","content_fanyi":"乙未日，在明堂举办无遮法会，挖地为坑，深五丈，用彩绸搭成宫殿，佛像都从深坑中牵出，说是从地下涌出。又杀牛取血，画成一幅大佛像，佛像头部高二百尺，说是和尚怀义刺破膝盖取血绘成。丙申日，把大佛像张挂在天津桥南，陈设斋供。当时御医沈南璆也得到太后宠幸，和尚怀义对此心怀恼怒，当晚秘密放火烧天堂，火势蔓延到明堂，火光照得洛阳城中如同白昼，到天亮时天堂、明堂都已烧尽，暴风把牛血画成的佛像撕裂成数百段。太后感到羞耻而讳言实情，只说是在天堂里干活的工匠误烧了麻布佛像，因而延及明堂。当时洛阳城中正举行酺宴，左拾遗刘承庆请求立即停止朝会、停办酺宴以回应上天的谴责，太后准备听从。姚璹说：“从前成周宣榭失火，占卜却显示国运更加兴隆；汉武帝柏梁台失火后另建建章宫，盛德更加长久。如今明堂是发布政令的场所，不是宗庙，不应自我贬抑。”太后于是登上端门，如同平日一样观看酺宴。下令重新建造明堂、天堂，仍让和尚怀义充任督造使。又用铜铸造九州鼎和十二属相神，都高一丈，各自安放在所属方位。","content_jianti_auto":"乙未，作无遮会于明堂，凿地为阬，深五丈，结彩为宫殿，佛像皆于阬中引出之，云自地涌出。又杀牛取血，画大像，首高二百尺，云怀义刺膝血为之。丙申，张像于天津桥南，设斋。时御医沈南璆亦得幸于太后，怀义心愠，是夕，密烧天堂，延及明堂，火照城中如昼，比明皆尽，暴风裂血像为数百段。太后耻而讳之，但云内作工徒误烧麻主，遂涉明堂。时方酺宴，左拾遗刘承庆请辍朝停酺以答天谴，太后将从之。姚璹曰：「昔成周宣榭，卜代愈隆；汉武建章，盛德弥永。今明堂布政之所，非宗庙也，不应自贬损。」太后乃御端门，观酺如平日。命更造明堂、天堂，仍以怀义充使。又铸铜为九州鼎及十二神，皆高一丈，各置其方。","dtjl_paragraph_links":[],"dtjl_references":[],"id":20363,"path":"资治通鉴 : 卷第二百五 (唐紀二十一) / 則天順聖皇后中之上 / 天冊萬歲元年 / 第 4 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"ba6f2b80-db0e-11ef-ac10-a0d3651f611f","year_int":695},"tongjian_id":"ba6f2b80-db0e-11ef-ac10-a0d3651f611f"},"paragraph_order":4}],"page_size":10,"total_pages":1,"total_paragraphs":4},"place_name":"成周"},"message":"success","success":true}