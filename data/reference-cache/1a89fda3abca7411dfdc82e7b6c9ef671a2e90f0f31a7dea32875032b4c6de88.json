x":26,"tongjian_id":"969827ba-db0e-11ef-bfd4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：大臣獄重，故曰重問。成帝時，丞相薛宣、御史大夫翟方進有罪，上使五二千石雜問。音義云：大臣獄重，故以二千石五人同問之。","note_content_jianti_auto":"贤曰：大臣狱重，故曰重问。成帝时，丞相薛宣、御史大夫翟方进有罪，上使五二千石杂问。音义云：大臣狱重，故以二千石五人同问之。","note_type":"hu_note","start_index":104,"tongjian_id":"969827b6-db0e-11ef-a3ed-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言當速救之也。","note_content_jianti_auto":"言当速救之也。","note_type":"hu_note","start_index":144,"tongjian_id":"969827bd-db0e-11ef-898a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"三公","official_note":"三公是汉代最高官职，通常指太尉、司徒、司空，负责辅佐皇帝处理国家政务。在上下文中，李固提到三公地位尊贵，不应轻易受审，以强调王龚（王公）作为高官不应被诬陷，这反映了三公在汉代政治中的崇高地位和特权。","official_rank":"正一品","source_snippet":"夫三公尊重","start_index":68,"tongjian_id":"025260b5-efbd-469a-82c2-211f3e6e37f0"}],"ExtRef_Children_people":[{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","link_td_number_id":4553632,"people_name":"龔","people_name_jianti_auto":"龚","people_xingming":"王龚","start_index":0,"tongjian_id":"969827be-db0e-11ef-8af2-a0d3651f611f"},{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","link_td_number_id":4553632,"people_name":"龔","people_name_jianti_auto":"龚","people_xingming":"王龚","start_index":21,"tongjian_id":"969827bf-db0e-11ef-98cf-a0d3651f611f"},{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","link_td_number_id":4553632,"people_name":"龔","people_name_jianti_auto":"龚","people_xingming":"王龚","start_index":26,"tongjian_id":"969827c0-db0e-11ef-a8fd-a0d3651f611f"},{"link_birth_year":93,"link_death_year":147,"link_td_description":"李固，字子坚，汉中郡南郑县人，东汉太尉，司徒李郃之子。少有奇表，好学交贤，后数次以恩信平叛，推举良臣。于皇储之争上，两次反对外戚大将军梁冀立幼不立长，被梁冀陷害致死。","link_td_id":"Q10008531","link_td_number_id":311808,"people_name":"李固","people_name_jianti_auto":"李固","people_xingming":"李固","start_index":31,"tongjian_id":"969827c1-db0e-11ef-bce3-a0d3651f611f"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"梁商，字伯夏，安定郡乌氏县（今宁夏固原）人，东汉政治人物、外戚，官至大将军。","link_td_id":"Q10007463","link_td_number_id":4553697,"people_name":"梁商","people_name_jianti_auto":"梁商","people_xingming":"梁商","start_index":36,"tongjian_id":"969827c2-db0e-11ef-bd50-a0d3651f611f"},{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","link_td_number_id":4553632,"people_name":"王公","people_name_jianti_auto":"王公","people_xingming":"王龚","start_index":41,"tongjian_id":"969827c3-db0e-11ef-9e92-a0d3651f611f","wl_zhushi":"[王龚]"},{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","link_td_number_id":4553632,"people_name":"王公","people_name_jianti_auto":"王公","people_xingming":"王龚","start_index":104,"tongjian_id":"969827c4-db0e-11ef-8bbd-a0d3651f611f","wl_zhushi":"[王龚]"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"梁商，字伯夏，安定郡乌氏县（今宁夏固原）人，东汉政治人物、外戚，官至大将军。","link_td_id":"Q10007463","link_td_number_id":4553697,"people_name":"商","people_name_jianti_auto":"商","people_xingming":"梁商","start_index":150,"tongjian_id":"969827c5-db0e-11ef-a617-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"龔疾宦官專權，上書極言其狀。諸黃門使客誣奏龔罪；上命龔亟自實。李固奏記於梁商曰：「王公以堅貞之操，橫爲讒佞所構，衆人聞知，莫不歎慄。夫三公尊重，無詣理訴冤之義，纖微感慨，輒引分決，是以舊典不有大罪，不至重問。王公卒有他變，則朝廷獲害賢之名，羣臣無救護之節矣！語曰：『善人在患，飢不及餐。』斯其時也！」商卽言之於帝，事乃得釋。","content_fanyi":"王龚痛恨宦官专权，上书极力陈述他们的罪状。黄门宦官们指使门客上奏诬告王龚有罪；顺帝命令王龚赶快自行说明实情。李固向梁商呈上奏记说：“王公凭着坚贞的操守，却横遭谗佞小人陷害，众人听说后，无不叹息恐惧。三公地位尊贵，没有前往司法官署申诉冤屈的道理；稍有细微的感慨和愤激，往往就自行引决。因此旧典规定，不是犯有大罪，不致深加审问。王公突然发生其他意外，朝廷就会落得杀害贤良的恶名，群臣也没有救助保护忠良的节操了！俗话说：‘善人处于患难，饥饿也来不及吃饭。’现在正是这样的时候！”梁商随即向顺帝进言，事情才得以平息。","content_jianti_auto":"龚疾宦官专权，上书极言其状。诸黄门使客诬奏龚罪；上命龚亟自实。李固奏记于梁商曰：「王公以坚贞之操，横为谗佞所构，众人闻知，莫不叹栗。夫三公尊重，无诣理诉冤之义，纤微感慨，辄引分决，是以旧典不有大罪，不至重问。王公卒有他变，则朝廷获害贤之名，群臣无救护之节矣！语曰：『善人在患，饥不及餐。』斯其时也！」商即言之于帝，事乃得释。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4367,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"969827b1-db0e-11ef-bef2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"如何应对儿子梁冀的非法行为","decision_tongjian_id":"DECISION_969827C6DB0E11EF8528A0D3651F611F_01"},{"decision_name":"如何掩盖刺杀吕放的罪行","decision_tongjian_id":"DECISION_969827C6DB0E11EF8528A0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"冀","people_name_jianti_auto":"冀","start_index":8,"tongjian_id":"969827c9-db0e-11ef-a85c-a0d3651f611f"},{"people_name":"放","people_name_jianti_auto":"放","start_index":23,"tongjian_id":"969827ca-db0e-11ef-bf32-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"推，吐雷翻。惡自冀出，欲嫁之他人，故託其辭，疑放之怨仇爲之。","note_content_jianti_auto":"推，吐雷翻。恶自冀出，欲嫁之他人，故托其辞，疑放之怨仇为之。","note_type":"hu_note","start_index":75,"tongjian_id":"969827c8-db0e-11ef-9c5b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"969827cc-db0e-11ef-be31-a0d3651f611f"},{"people_name":"放","people_name_jianti_auto":"放","start_index":5,"tongjian_id":"969827cd-db0e-11ef-ab6c-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":15,"tongjian_id":"969827ce-db0e-11ef-a701-a0d3651f611f"},{"people_name":"冀","people_name_jianti_auto":"冀","start_index":20,"tongjian_id":"969827cf-db0e-11ef-a85c-a0d3651f611f"},{"people_name":"商","people_name_jianti_auto":"商","start_index":23,"tongjian_id":"969827d0-db0e-11ef-b74a-a0d3651f611f"},{"people_name":"放","people_name_jianti_auto":"放","start_index":26,"tongjian_id":"969827d1-db0e-11ef-ad76-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":41,"tongjian_id":"969827d2-db0e-11ef-925e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：安慰放家，欲以滅口。余謂賢說非也。冀請於商，以放弟爲令，謂必急於捕賊，而陰使禹滅其兄之宗親賓客以快己忿耳。","note_content_jianti_auto":"贤曰：安慰放家，欲以灭口。余谓贤说非也。冀请于商，以放弟为令，谓必急于捕贼，而阴使禹灭其兄之宗亲宾客以快己忿耳。","note_type":"hu_note","start_index":89,"tongjian_id":"969827cb-db0e-11ef-b082-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"執金吾","official_note":"執金吾是汉代负责京城治安和皇帝出巡护卫的官职，此处梁冀担任此职，后转任河南尹，显示其权势。","official_rank":"九卿级别，约正三品","source_snippet":"以執金吾梁冀爲河南尹","start_index":6,"tongjian_id":"03825e81-e1f9-418d-a755-79d03540fded"},{"confidence":0.95,"official_category":"地方行政","official_name":"河南尹","official_note":"河南尹是汉代管理河南郡（今洛阳一带）的最高行政长官，此处梁冀被任命此职，表明其从中央调任地方要职。","official_rank":"郡守级别，约正三品","source_snippet":"以執金吾梁冀爲河南尹","start_index":12,"tongjian_id":"759b3f7e-303e-4641-a7c4-ea6979cceab4"},{"confidence":0.9,"official_category":"地方行政","official_name":"雒陽令","official_note":"雒陽令是汉代洛阳县的县令，负责地方治理，此处吕放担任此职，并向梁商报告梁冀的违法行为。","official_rank":"县令级别，约正七品","source_snippet":"父商所親客雒陽令呂放以告商","start_index":36,"tongjian_id":"eaf31233-7f15-4549-aa8a-259733692e8d"},{"confidence":0.9,"official_category":"地方行政","official_name":"雒陽令","official_note":"此处梁冀请求任命吕放的弟弟吕禹为雒陽令，以掩盖刺杀吕放的罪行，显示官职被用作政治工具。","official_rank":"县令级别，约正七品","source_snippet":"請以放弟禹爲雒陽令","start_index":66,"tongjian_id":"5b6c7103-2e99-4ce4-bcd2-46b3ae8bb64b"}],"ExtRef_Children_people":[{"link_birth_year":88,"link_death_year":159,"link_td_description":"梁冀，字伯卓，安定郡乌氏县（今宁夏固原）人，中国东汉时期外戚出身的权臣。妻孙寿。","link_td_id":"Q10007199","link_t