s":[],"ExtRef_Children_zhang_notes":[],"note_content":"象林縣，屬日南郡。晉、宋以下爲林邑國。","note_content_jianti_auto":"象林县，属日南郡。晋、宋以下为林邑国。","note_type":"hu_note","start_index":11,"tongjian_id":"969827a8-db0e-11ef-ae0e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"象林","place_name_jianti_auto":"象林","resolved_place_entity_id":5315,"start_index":5,"tongjian_id":"969827ae-db0e-11ef-bb48-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二十六、占城（卷一百十二）","excerpts":[{"context_after":"晋时，日南郡治象林，盖羁属而已。刘宋仍属日南郡。元嘉中，...","context_before":"...象林县，属日南郡。后汉因之。永元十四年，置象林将兵长史。","source_end_index":68,"source_paragraph_tongjian_id":"78b6118c-ed23-54ad-8218-c969c6d9a6c3","source_start_index":41,"source_text":"永和元年，象林蛮区怜等反。怜，亦曰连。自是遂为林邑国。"}],"path":"广西方舆纪要/二十六、占城（卷一百十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"4十二月，象林蠻夷反。","content_fanyi":"十二月，象林蛮夷反叛。","content_jianti_auto":"4十二月，象林蛮夷反。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4365,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"969827a7-db0e-11ef-9de8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司空","official_note":"司空是汉代三公之一，负责土木工程和水利事务，此处表示王龔之前担任的官职。","official_rank":"正一品","source_snippet":"以前司空王龔","start_index":5,"tongjian_id":"0b1e80fe-c5d4-477d-9a89-7128f0e687b4"},{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处表示王龔被任命为太尉。","official_rank":"正一品","source_snippet":"爲太尉","start_index":11,"tongjian_id":"6e145563-afa3-481a-97ce-9ad4c5b540d1"}],"ExtRef_Children_people":[{"link_td_description":"王龚，字伯宗，东汉山阳郡高平县（今山东省鱼台县北）人，生卒年均不详。","link_td_id":"Q10007247","lin