_id":7106,"start_index":21,"tongjian_id":"91e7b369-db0e-11ef-83b0-a0d3651f611f"},{"place_name":"昌陵縣","place_name_jianti_auto":"昌陵县","resolved_place_entity_id":7256,"start_index":24,"tongjian_id":"91e7b36a-db0e-11ef-9f1c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"其后置驿于此。延陵，见咸阳县。今县治西为新丰驿。又有安幕...","context_before":"昌亭驿[在县东南三十里。","source_end_index":103,"source_paragraph_tongjian_id":"cc00e019-8613-58d4-82ad-2c30d26e4ddc","source_start_index":12,"source_text":"汉成帝鸿嘉元年，于新丰戏乡置昌陵县以奉初陵。永始元年罢。《关中记》：昌陵在霸陵城东二十里。成帝作初陵，或言不便，乃于步昌亭起昌陵。取土成山，与粟同价，靡费巨万，积年无成，乃复还延陵。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"2二月，壬午，上行幸初陵，赦作徒；以新豐之戲鄕爲昌陵縣，奉初陵。","content_fanyi":"二月壬午日，汉成帝亲临初陵，赦免在那里服劳役的囚徒；又将新丰的戏乡设置为昌陵县，以供奉初陵。","content_jianti_auto":"2二月，壬午，上行幸初陵，赦作徒；以新丰之戏鄕为昌陵县，奉初陵。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2429,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"91e7b362-db0e-11ef-91b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":0,"tongjian_id":"91e7b36d-db0e-11ef-aebd-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張晏曰：出入市里，不復警蹕，若微賤者之所爲，故曰微行。","note_content_jianti_auto":"张晏曰：出入市里，不复警跸，若微贱者之所为，故曰微行。","note_type":"hu_note","start_index":7,"tongjian_id":"91e7b36c-db0e-11ef-b8b9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","start_index":6,"tongjian_id":"91e7b370-db0e-11ef-819c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"旁縣，諸縣環長安旁者也。","note_content_jianti_auto":"旁县，诸县环长安旁者也。","note_type":"hu_note","start_index":38,"tongjian_id":"91e7b36f-db0e-11ef-a45e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":0,"tongjian_id":"91e7b373-db0e-11ef-9d7b-a0d3651f611f"},{"people_name":"成帝","people_name_jianti_auto":"成帝","start_index":7,"tongjian_id":"91e7b374-db0e-11ef-972d-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":12,"tongjian_id":"91e7b375-db0e-11ef-b758-a0d3651f611f"},{"people_name":"敬武公主","people_name_jianti_auto":"敬武公主","start_index":16,"tongjian_id":"91e7b376-db0e-11ef-85bb-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":21,"tongjian_id":"91e7b377-db0e-11ef-85d9-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":26,"tongjian_id":"91e7b378-db0e-11ef-9ac4-a0d3651f611f"},{"people_name":"元后","people_name_jianti_auto":"元后","start_index":57,"tongjian_id":"91e7b379-db0e-11ef-84ca-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":64,"tongjian_id":"91e7b37a-db0e-11ef-a17c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鉅鹿郡","place_name_jianti_auto":"巨鹿郡","start_index":73,"tongjian_id":"91e7b37b-db0e-11ef-b025-a0d3651f611f"},{"place_name":"敬武縣","place_name_jianti_auto":"敬武县","start_index":77,"tongjian_id":"91e7b37c-db0e-11ef-b4b1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文穎曰：公主，成帝姊也。臣瓚曰：敬武公主是元帝姊也。師古曰：二說皆非也。薛宣傳云：主怒曰：「嫂何以取妹殺之！」旣謂元后爲嫂，是卽元帝妹也。地理志，鉅鹿郡有敬武縣。","note_content_jianti_auto":"文颖曰：公主，成帝姊也。臣瓒曰：敬武公主是元帝姊也。师古曰：二说皆非也。薛宣传云：主怒曰：「嫂何以取妹杀之！」既谓元后为嫂，是即元帝妹也。地理志，巨鹿郡有敬武县。","note_type":"hu_note","start_index