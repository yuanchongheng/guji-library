u6280\u4e0d","source_key":"baiyang_epub","start_index":119,"text":"\u9004","tongjian_id":"eec76690-776b-574b-88e7-c0dfaebf5a84"}],"ExtRef_Children_places":[{"place_name":"\u7f8c","place_name_jianti_auto":"\u7f8c","resolved_place_entity_id":140,"start_index":146,"tongjian_id":"8f600f2a-db0e-11ef-bbfb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"\u4e0a\u53c8\u597d\u81ea\u64ca\u718a\u3001\u8c55\uff0c\u99b3\u9010\u91ce\u7378\u3002\u53f8\u99ac\u76f8\u5982\u4e0a\u758f\u8aeb\u66f0\uff1a\u300c\u81e3\u805e\u7269\u6709\u540c\u985e\u800c\u6b8a\u80fd\u8005\uff0c\u6545\u529b\u7a31\u70cf\u7372\uff0c\u6377\u8a00\u6176\u5fcc\uff0c\u52c7\u671f\u8cc1\u3001\u80b2\u3002\u81e3\u4e4b\u611a\uff0c\u7aca\u4ee5\u7232\u4eba\u8aa0\u6709\u4e4b\uff0c\u7378\u4ea6\u5b9c\u7136\u3002\u4eca\u965b\u4e0b\u597d\u9675\u963b\u96aa\uff0c\u5c04\u731b\u7378\uff0c\u5352\u7136\u9047\u9038\u6750\u4e4b\u7378\uff0c\u99ed\u4e0d\u5b58\u4e4b\u5730\uff0c\u72af\u5c6c\u8eca\u4e4b\u6e05\u5875\uff0c\u8f3f\u4e0d\u53ca\u9084\u8f45\uff0c\u4eba\u4e0d\u6687\u65bd\u5de7\uff0c\u96d6\u6709\u70cf\u7372\u3001\u9004\u8499\u4e4b\u6280\u4e0d\u5f97\u7528\uff0c\u67af\u6728\u5de7\u682a\uff0c\u76e1\u7232\u96e3\u77e3\u3002\u662f\u80e1\u3001\u8d8a\u8d77\u65bc\u8f42\u4e0b\u800c\u7f8c\u3001\u5937\u63a5\u8eeb\u4e5f\uff0c\u8c48\u4e0d\u6b86\u54c9\uff01\u96d6\u842c\u5168\u800c\u7121\u60a3\uff0c\u7136\u672c\u975e\u5929\u5b50\u4e4b\u6240\u5b9c\u8fd1\u4e5f\u3002\u4e14\u592b\u6e05\u9053\u800c\u5f8c\u884c\uff0c\u4e2d\u8def\u800c\u99b3\uff0c\u7336\u6642\u6709\u929c\u6a5b\u4e4b\u8b8a\uff1b\u6cc1\u4e4e\u6d89\u8c50\u8349\uff0c\u9a01\u4e18\u589f\uff0c\u524d\u6709\u5229\u7378\u4e4b\u6a02\u800c\u5167\u7121\u5b58\u8b8a\u4e4b\u610f\uff0c\u5176\u7232\u5bb3\u4e5f\u4e0d\u96e3\u77e3\u3002\u592b\u8f15\u842c\u4e58\u4e4b\u91cd\u4e0d\u4ee5\u7232\u5b89\uff0c\u6a02\u51fa\u842c\u6709\u4e00\u5371\u4e4b\u5857\u4ee5\u7232\u5a1b\uff0c\u81e3\u7aca\u7232\u965b\u4e0b\u4e0d\u53d6\u3002\u84cb\u660e\u8005\u9060\u898b\u65bc\u672a\u840c\u800c\u77e5\u8005\u907f\u5371\u65bc\u7121\u5f62\uff0c\u798d\u56fa\u591a\u85cf\u65bc\u96b1\u5fae\u800c\u767c\u65bc\u4eba\u4e4b\u6240\u5ffd\u8005\u4e5f\u3002\u6545\u9119\u8afa\u66f0\uff1a\u300e\u5bb6\u7d2f\u5343\u91d1\uff0c\u5750\u4e0d\u5782\u5802\u3002\u300f\u6b64\u8a00\u96d6\u5c0f\uff0c\u53ef\u4ee5\u8aed\u5927\u3002\u300d\u4e0a\u5584\u4e4b\u3002","content_fanyi":"\u6c49\u6b66\u5e1d\u53c8\u559c\u6b22\u4eb2\u624b\u51fb\u6740\u718a\u548c\u91ce\u732a\uff0c\u7eb5\u9a6c\u8ffd\u9010\u91ce\u517d\u3002\u53f8\u9a6c\u76f8\u5982\u4e0a\u758f\u529d\u8c0f\u8bf4\uff1a\u201c\u6211\u542c\u8bf4\uff0c\u6709\u4e9b\u4e1c\u897f\u7c7b\u522b\u76f8\u540c\u800c\u672c\u9886\u5374\u4e0d\u540c\uff0c\u6240\u4ee5\u8bba\u529b\u6c14\u8981\u6570\u4e4c\u83b7\uff0c\u8bba\u654f\u6377\u8981\u63d0\u5e86\u5fcc\uff0c\u8bba\u52c7\u731b\u8981\u6570\u5b5f\u8d32\u3001\u590f\u80b2\u3002\u4f9d\u81e3\u611a\u89c1\uff0c\u81e3\u79c1\u4e0b\u8ba4\u4e3a\u4eba\u786e\u5b9e\u5982\u6b64\uff0c\u91ce\u517d\u4e5f\u5e94\u5f53\u5982\u6b64\u3002\u5982\u4eca\u965b\u4e0b\u559c\u6b22\u767b\u4e0a\u9669\u963b\u4e4b\u5730\uff0c\u5c04\u6740\u731b\u517d\uff0c\u7a81\u7136\u906d\u9047\u7279\u522b\u51f6\u608d\u7684\u91ce\u517d\uff0c\u5b83\u5728\u65e0\u5904\u5b58\u8eab\u7684\u7edd\u5883\u4e2d\u53d7\u5230\u60ca\u5413\uff0c\u62fc\u6b7b\u51b2\u72af\u965b\u4e0b\u7684\u968f\u884c\u8f66\u9a7e\uff0c\u8f66\u8f86\u6765\u4e0d\u53ca\u6389\u8f6c\u65b9\u5411\uff0c\u4eba\u4e5f\u6765\u4e0d\u53ca\u65bd\u5c55\u6280\u5de7\uff0c\u5373\u4f7f\u6709\u4e4c\u83b7\u3001\u9004\u8499\u90a3\u6837\u7684\u672c\u4e8b\u4e5f\u65e0\u6cd5\u4f7f\u7528\uff0c\u67af\u6811\u673d\u6728\u90fd\u4f1a\u9020\u6210\u7978\u5bb3\u3002\u8fd9\u5c31\u7b49\u4e8e\u80e1\u4eba\u3001\u8d8a\u4eba\u7a81\u7136\u4ece\u4eac\u57ce\u5192\u51fa\uff0c\u7f8c\u4eba\u3001\u5937\u4eba\u7d27\u6328\u8f66\u540e\uff0c\u96be\u9053\u4e0d\u5371\u9669\u5417\uff01\u5373\u4f7f\u4e07\u65e0\u4e00\u5931\u800c\u4e0d\u4f1a\u51fa\u4e8b\uff0c\u8fd9\u672c\u6765\u4e5f\u4e0d\u662f\u5929\u5b50\u5e94\u5f53\u63a5\u8fd1\u7684\u5730\u65b9\u3002\u51b5\u4e14\u5728\u6e05\u9053\u6212\u4e25\u4e4b\u540e\u624d\u51fa\u884c\uff0c\u5728\u9053\u8def\u6b63\u4e2d\u9a70\u9a8b\uff0c\u8fd8\u65f6\u5e38\u4f1a\u6709\u9a6c\u56bc\u5b50\u3001\u8f66\u94a9\u6298\u65ad\u6216\u8f66\u8f6e\u8131\u51fa\u4e4b\u7c7b\u7684\u610f\u5916\uff1b\u66f4\u4f55\u51b5\u7a7f\u8d8a\u8302\u5bc6\u7684\u91ce\u8349\uff0c\u9a70\u9a8b\u4e18\u9675\u5e9f\u589f\uff0c\u773c\u524d\u6709\u730e\u53d6\u731b\u517d\u7684\u4e50\u8da3\uff0c\u5fc3\u91cc\u5374\u6ca1\u6709\u9632\u8303\u53d8\u6545\u7684\u5ff5\u5934\uff0c\u8981\u9020\u6210\u7978\u5bb3\u4e5f\u5c31\u4e0d\u96be\u4e86\u3002\u8f7b\u89c6\u4e07\u4e58\u4e4b\u5c0a\u800c\u4e0d\u4ee5\u6b64\u4e3a\u5b89\u7a33\uff0c\u53cd\u800c\u559c\u6b22\u8d70\u5728\u4e07\u5206\u4e4b\u4e00\u5371\u9669\u7684\u9053\u8def\u4e0a\u5bfb\u6b22\u4f5c\u4e50\uff0c\u81e3\u79c1\u4e0b\u8ba4\u4e3a\u965b\u4e0b\u4e0d\u5e94\u8fd9\u6837\u505a\u3002\u5927\u51e1\u806a\u660e\u7684\u4eba\u5728\u4e8b\u60c5\u5c1a\u672a\u840c\u53d1\u65f6\u5c31\u80fd\u9884\u89c1\uff0c\u667a\u6167\u7684\u4eba\u5728\u5371\u9669\u5c1a\u672a\u663e\u5f62\u65f6\u5c31\u80fd\u907f\u5f00\uff0c\u7978\u60a3\u672c\u6765\u5927\u591a\u9690\u85cf\u5728\u7ec6\u5fae\u9690\u7ea6\u4e4b\u5904\uff0c\u53d1\u751f\u5728\u4eba\u4eec\u758f\u5ffd\u7684\u65f6\u5019\u3002\u6240\u4ee5\u6c11\u95f4\u8c1a\u8bed\u8bf4\uff1a\u2018\u5bb6\u4e2d\u79ef\u7d2f\u4e86\u5343\u91d1\u5bb6\u4ea7\uff0c\u5c31\u4e0d\u5750\u5728\u5802\u5c4b\u6a90\u4e0b\u3002\u2019\u8fd9\u53e5\u8bdd\u8bf4\u7684\u867d\u7136\u662f\u5c0f\u4e8b\uff0c\u5374\u53ef\u4ee5\u7528\u6765\u6bd4\u55bb\u5927\u4e8b\u3002\u201d\u6b66\u5e1d\u8ba4\u4e3a\u4ed6\u8bf4\u5f97\u5f88\u597d\u3002","content_jianti_auto":"\u4e0a\u53c8\u597d\u81ea\u51fb\u718a\u3001\u8c55\uff0c\u9a70\u9010\u91ce\u517d\u3002\u53f8\u9a6c\u76f8\u5982\u4e0a\u758f\u8c0f\u66f0\uff1a\u300c\u81e3\u95fb\u7269\u6709\u540c\u7c7b\u800c\u6b8a\u80fd\u8005\uff0c\u6545\u529b\u79f0\u4e4c\u83b7\uff0c\u6377\u8a00\u5e86\u5fcc\uff0c\u52c7