0e-11ef-8f9d-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":114,"tongjian_id":"8c224d58-db0e-11ef-b87c-a0d3651f611f"},{"place_name":"萬年","place_name_jianti_auto":"万年","start_index":121,"tongjian_id":"8c224d59-db0e-11ef-980d-a0d3651f611f"},{"place_name":"鄣丘","place_name_jianti_auto":"鄣丘","start_index":124,"tongjian_id":"8c224d5a-db0e-11ef-b239-a0d3651f611f"},{"place_name":"宣武","place_name_jianti_auto":"宣武","start_index":127,"tongjian_id":"8c224d5b-db0e-11ef-97de-a0d3651f611f"},{"place_name":"廣陽縣","place_name_jianti_auto":"广阳县","start_index":133,"tongjian_id":"8c224d5c-db0e-11ef-aaf9-a0d3651f611f"},{"place_name":"萬年","place_name_jianti_auto":"万年","start_index":141,"tongjian_id":"8c224d5d-db0e-11ef-a239-a0d3651f611f"},{"place_name":"高陵","place_name_jianti_auto":"高陵","start_index":144,"tongjian_id":"8c224d5e-db0e-11ef-b76c-a0d3651f611f"},{"place_name":"廣陽","place_name_jianti_auto":"广阳","start_index":147,"tongjian_id":"8c224d5f-db0e-11ef-9eb2-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":154,"tongjian_id":"8c224d60-db0e-11ef-8351-a0d3651f611f"},{"place_name":"萬年縣","place_name_jianti_auto":"万年县","start_index":160,"tongjian_id":"8c224d61-db0e-11ef-b592-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":164,"tongjian_id":"8c224d62-db0e-11ef-8c6e-a0d3651f611f"},{"place_name":"廣陽","place_name_jianti_auto":"广阳","start_index":172,"tongjian_id":"8c224d63-db0e-11ef-8d4b-a0d3651f611f"},{"place_name":"櫟陽","place_name_jianti_auto":"栎阳","start_index":175,"tongjian_id":"8c224d64-db0e-11ef-bf75-a0d3651f611f"},{"place_name":"景陵","place_name_jianti_auto":"景陵","start_index":192,"tongjian_id":"8c224d65-db0e-11ef-94aa-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記：秦獻公二年，始治櫟陽。徐廣註曰：卽漢萬年縣。余按漢志，櫟陽、萬年爲兩縣，皆屬馮翊，後漢始省倂。宋白曰：櫟陽，秦舊縣。漢高祖旣葬太上皇於萬年陵，仍分櫟陽置萬年縣以爲陵邑，理櫟陽城中，故櫟陽城亦名萬年城。後漢省櫟陽縣入萬年縣。後魏大統中，分萬年置鄣丘、宣武，又分置廣陽縣。周明帝省萬年入高陵、廣陽二縣，更於長安城中別置萬年縣。唐武德元年，又改廣陽爲櫟陽，元和十五年，並移隸奉先縣以奉景陵。櫟，音藥。","note_content_jianti_auto":"史记：秦献公二年，始治栎阳。徐广注曰：即汉万年县。余按汉志，栎阳、万年为两县，皆属冯翊，后汉始省倂。宋白曰：栎阳，秦旧县。汉高祖既葬太上皇于万年陵，仍分栎阳置万年县以为陵邑，理栎阳城中，故栎阳城亦名万年城。后汉省栎阳县入万年县。后魏大统中，分万年置鄣丘、宣武，又分置广阳县。周明帝省万年入高陵、广阳二县，更于长安城中别置万年县。唐武德元年，又改广阳为栎阳，元和十五年，并移隶奉先县以奉景陵。栎，音药。","note_type":"hu_note","start_index":122,"tongjian_id":"8c224d3f-db0e-11ef-ac94-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂裂地以封之，使各有分土。分，扶問翻。","note_content_jianti_auto":"谓裂地以封之，使各有分土。分，扶问翻。","note_type":"hu_note","start_index":179,"tongjian_id":"8c224d69-db0e-11ef-a0d5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-429,"link_td_description":"秦躁公，嬴姓，战国时期秦国君主。秦厉共公之子，秦怀公之兄，在位14年。","link_td_id":"Q10008521","link_td_number_id":310443,"people_name":"躁","people_name_jianti_auto":"躁","people_xingming":"null","start_index":70,"tongjian_id":"8c22eb04-db0e-11ef-927d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"。孝公作为咸阳，徙都之[今西安府咸阳县东三十里咸阳故城也...","context_before":"...德公初居雍城大郑宫。《括地志》：雍县南七里故雍城是也]，","source_end_index":331,"source_paragraph_tongjian_id":"8af1a4eb-f6b5-56b2-9166-5ff1503f97c4","source_start_index":308,"source_text":"献公徙栎阳[即今西安府临潼县北五十里故栎阳县]"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"其尽得河西，则犀首张仪之力也]。《吕氏春秋》：吴起去西河...","context_before":"...摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也[吕氏曰：","source_end_index":442,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":430,"source_text":"秦孝公用商鞅，取河西地。"},{"context_after":"十年，东地渡洛[此即渭北之洛川，所谓自郑滨洛者也]。贾生...","context_before":"...削，秦日益大。《秦纪》：穆公时，常得河西地，而晋复取之。","source_end_index":593,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":566,"source_text":"故孝公元年下令曰：三晋攻夺我河西地。于是出兵东围陕城。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"项羽入秦，封司马欣为塞王，都栎阳。颜氏曰：国以塞名者，取...","context_before":"...公十一年，秦取我栎，是也。杜氏《释例》云：栎，盖在河北。","source_end_index":75,"source_paragraph_tongjian_id":"e341f74b-6355-5c69-bea9-c5cd15021b12","source_start_index":53,"source_text":"《史记》：秦献公二年，自雍徙都栎阳，因城之。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1孝公下令國中曰：「昔我穆公，自岐、雍之間修德行武，東平晉亂，以河爲界，西霸戎翟，廣地千里，天子致伯，諸侯畢賀，爲後世開業甚光美。會往者厲、躁、簡公、出子之不寧，國家內憂，未遑外事。三晉攻奪我先君河西地，醜莫大焉。獻公卽位，鎭撫邊境，徙治櫟陽，且欲東伐，復穆公之故地，修穆公之政令。寡人思念先君之意，常痛於心。賓客羣臣有能出奇計強秦者，吾且尊官，與之分土。」於是衞公孫鞅聞是令下，乃西入秦。","content_fanyi":"秦孝公向全国下令说：“从前我们的穆公，在岐山、雍地之间修治德政、整饬武备，向东平息了晋国的内乱，以黄河为界，向西称霸于戎、翟各部，开拓疆土上千里；周天子授予方伯之位，诸侯都来祝贺，为后世开创的基业非常光辉美好。恰逢过去厉公、躁公、简公、出子时期政局不安，国家内部忧患，无暇顾及对外事务。魏、赵、韩三国攻占了我先君留下的河西土地，耻辱没有比这更大的了。献公即位后，镇抚边境，迁都到栎阳，并准备向东征伐，恢复穆公原有的土地，整饬穆公的政令。我追念先君的遗志，常常痛在心头。宾客和群臣中，有能献出奇计使秦国强盛的人，我将授给他尊贵的官职，分封给他土地。”于是卫国的公孙鞅听说这道命令颁布，就西行进入秦国。","content_jianti_auto":"1孝公下令国中曰：「昔我穆公，自岐、雍之间修德行武，东平晋乱，以河为界，西霸戎翟，广地千里，天子致伯，诸侯毕贺，为后世开业甚光美。会往者厉、躁、简公、出子之不宁，国家内忧，未遑外事。三晋攻夺我先君河西地，丑莫大焉。献公即位，镇抚边境，徙治栎阳，且欲东伐，复穆公之故地，修穆公之政令。寡人思念先君之意，常痛于心。宾客群臣有能出奇计强秦者，吾且尊官，与之分土。」于是衞公孙鞅闻是令下，乃西入秦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":124,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 八年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c20515d-db0e-11ef-9a71-a0d3651f611f","year_int":-361},"tongjian_id":"8c20515d-db0e-11ef-9a71-a0d3651f611f"},"paragraph_order":1}],"page_size":7,"total_pages":1,"total_paragraphs":1},"profile":{"alias_list":["秦趮公"],"biography":"秦躁公，嬴姓，战国时期秦国君主。秦厉共公之子，秦怀公之兄，在位14年。","death_year":-429,"link_td_id":"Q10008521","name":"秦躁公","number_id":310443},"relationships":[{"direction":"forward","rank":"normal","relation_detail":"父子关系，来源文本：秦厲共公之子","r