ian_id":"bce13ab2-db0e-11ef-b69f-a0d3651f611f"},{"place_name":"祁連城","place_name_jianti_auto":"祁连城","place_note":"甘肃民乐","resolved_place_entity_id":8548,"start_index":16,"tongjian_id":"bce13ab3-db0e-11ef-b143-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":22,"tongjian_id":"bce13ab4-db0e-11ef-9add-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":47,"tongjian_id":"bce13ab7-db0e-11ef-904e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十二、陕西行都指挥使司（卷六十三）","excerpts":[{"context_after":"胡氏曰：城在祁连山旁]。","context_before":"...祚置汉阳县，以守牧地。张玄靓改为祁连郡。吕光因之。后废。","source_end_index":155,"source_paragraph_tongjian_id":"3c216e0b-b9d7-56f3-9603-7900293b9332","source_start_index":122,"source_text":"唐开元十六年，吐蕃寇甘州。凉州将杜宾客破吐蕃于祁连城下，即故城也。"}],"path":"陕西方舆纪要/十二、陕西行都指挥使司（卷六十三）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"9辛卯，左金吾將軍杜賓客破吐蕃于祁連城下。時吐蕃復入寇，蕭嵩遣賓客將強弩四千擊之。戰自辰至暮，吐蕃大潰，獲其大將一人；虜散走投山，哭聲四合。","content_fanyi":"九月辛卯日，左金吾将军杜宾客在祁连城下击败吐蕃军队。当时吐蕃再次入侵，萧嵩派遣杜宾客率领四千名强弩手迎击敌军。战斗从辰时一直打到傍晚，吐蕃军队大败溃散，唐军俘获吐蕃大将一人；残敌四散逃入山中，哭喊声从四面八方传来。","content_jianti_auto":"9辛卯，左金吾将军杜宾客破吐蕃于祁连城下。时吐蕃复入寇，萧嵩遣宾客将强弩四千击之。战自辰至暮，吐蕃大溃，获其大将一人；虏散走投山，哭声四合。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21440,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"bce13aa8-db0e-11ef-8ac5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"溫泉宮","place_name_jianti_auto":"温泉宫","start_index":15,"tongjian_id":"bce13aba-db0e-11ef-b2b2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：實錄十二月丁卯又云「幸溫泉宮」。不言其還。唐曆，「丁卯幸溫泉，丁丑還宮。」按此月已幸溫泉，恐重複，不取。","note_content_jianti_auto":"考异曰：实录十二月丁卯又云「幸温泉宫」。不言其还。唐历，「丁卯幸温泉，丁丑还宫。」按此月已幸温泉，恐重复，不取。","note_type":"hu_note","start_index":23,"tongjian_id":"bce13ab9-db0e-11ef-abbe-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"驪山","place_name_jianti_auto":"骊山","resolved_place_entity_id":616,"start_index":12,"tongjian_id":"bce13abe-db0e-11ef-878f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10冬，十月，己卯，上幸驪山溫泉；己丑，還宮。","content_fanyi":"冬季，十月十七日己卯，唐玄宗前往骊山温泉；十月二十七日己丑，回到宫中。","content_jianti_auto":"10冬，十月，己卯，上幸骊山温泉；己丑，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21441,"number":10,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":9,"tongjian_id":"bce13ab8-db0e-11ef-aef8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"河西節度副大使","official_note":"河西節度副大使是唐代在河西地区设立的军事官职，负责边防和军事指挥，此处表示萧嵩担任此职后被调任。","official_rank":"未知","source_snippet":"以河西節度副大使蕭嵩爲兵部尚書、同平章事。","start_index":11,"tongjian_id":"a08d77d4-ea8e-4152-8f21-90054b820f5c"},{"confidence":0.95,"official_category":"中枢机构","official_name":"兵部尚書","official_note":"兵部尚書是唐代六部之一兵部的长官，掌管全国军事行政，此处表示萧嵩被任命为此职。","official_rank":"正三品","source_snippet":"以河西節度副大使蕭嵩爲兵部尚書、同平章事。","start_index":22,"tongjian_id":"6584761c-cda1-45da-8bea-f46ca9c8f65f"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代的宰相官职，参与国家政务决策，此处表示萧嵩兼任此职，进入中枢权力核心。","official_rank":"宰相级","source_snippet":"以河西節度副大使蕭嵩爲兵部尚書、同平章事。","start_index":28,"tongjian_id":"92be2c7c-a575-40c6-bf53-48aa7b090632"}],"ExtRef_Children_people":[{"link_birth_year":660,"link_death_year":749,"link_td_description":"萧嵩，后梁明帝萧岿的玄孙，曾祖父萧珣。唐玄宗时代大臣。","link_td_id":"Q10010088","link_td_number_id":951211,"people_name":"蕭嵩","people_name_jianti_auto":"萧嵩","people_xingming":"萧嵩","start_index":17,"tongjian_id":"bce13ac0-db0e-11ef-8905-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河西","place_name_jianti_auto":"河西","resolved_place_entity_id":214,"start_index":10,"tongjian_id":"bce13ac1-db0e-11ef-8a3c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"11十一月，癸巳，以河西節度副大使蕭嵩爲兵部尚書、同平章事。","content_fanyi":"十一月初一癸巳日，唐玄宗任命河西节度副大使萧嵩为兵部尚书、同平章事。","content_jianti_auto":"11十一月，癸巳，以河西节度副大使萧嵩为兵部尚书、同平章事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21442,"number":11,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"bce13abf-db0e-11ef-985b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"12十二月，丙寅，敕：「長征兵無有還期，人情難堪；宜分五番，歲遣一番還家洗沐，五年酬勳五轉。」","content_fanyi":"十二月初五日丙寅，唐玄宗下敕令说：“长期征戍的士兵没有还乡的日期，人情上实在难以承受；应当把他们分成五批，每年派一批回家洗沐休整，五年间迁转勋级五次。”","content_jianti_auto":"12十二月，丙寅，敕：「长征兵无有还期，人情难堪；宜分五番，岁遣一番还家洗沐，五年酬勋五转。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":21443,"number":12,"reading_annotation_sources":[],"start_index":11,"tongjian_id":"bce13ac2-db0e-11ef-8d7e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"13是歲，制戶籍三歲一定，分爲九等。","content_fanyi":"这一年，唐玄宗颁布制书，规定户籍每三年核定一次，把户口分为九等。","content_jianti_auto":"13是岁，制户籍三岁一定，分为九等。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21444,"number":13,"reading_annotation_sources":[],"start_index":12,"tongjian_id":"bce13ac3-db0e-11ef-9fe3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"偏裨","official_note":"偏裨指副将或低级军官，在唐代军事体系中常协助主将指挥部队。此处描述杨思勗的部下向他报告事务时因畏惧而不敢抬头，反映了杨思勗的严厉性格。","official_rank":"未知","source_snippet":"偏裨白事者不敢仰視","start_index":68,"tongjian_id":"6d3f80b0-3622-48f8-8046-2934660dfaaf"}],"ExtRef_Children_people":[{"link_birth_year":653,"link_death_year":740,"link_td_description":"杨思勖，罗州石城县人，唐朝宦官，本为苏姓，随养父姓氏。少年时为给事内侍省，跟随唐玄宗讨韦后、太平公主，擢升为左监门卫将军，唐玄宗倚重他。","link_td_id":"Q10003743","link_td_number_id":1461237,"people_name":"楊思勗","people_name_jianti_auto":"杨思勗","people_xingming":"杨思勖","start_index":2,"tongjian_id":"bce13ac6-db0e-11ef-a6ea-a0d3651f611f"},{"people_name":"陳行範","people_name_jianti_auto":"陈行范","people_xingming":"陈行范","start_index":6,"tongjian_id":"bce13ac7-db0e-11ef-8380-a0d3651f611f"},{"people_name":"何遊魯","people_name_jianti_auto":"何游鲁","people_xingming":"何游鲁","start_index":18,"tongjian_id":"bce13ac8-db0e-11ef-a699-a0d3651f611f"},{"people_name":"馮璘","people_name_jianti_auto":"冯璘","people_xingming":"冯璘","start_index":22,"tongjian_id":"bce13ac9-db0e-11ef-871c-a0d3651f611f"},{"people_name":"行範","people_name_jianti_auto":"行范","people_xingming":"陈行范","start_index":25,"tongjian_id":"bce13aca-db0e-11ef-ab36-a0d3651f611f"},{"link_birth_year":653,"link_death_year":740,"link_td_description":"杨思勖，罗州石城县人，唐朝宦官，本为苏姓，随养父姓氏。少年时为给事内侍省，跟随唐玄宗讨韦后、太平公主，擢升为左监门卫将军，唐玄宗倚重他。","link_td_id":"Q10003743","link_td_number_id":1461237,"people_name":"思勗","people_name_jianti_auto":"思勗","people_xingming":"杨思勖","start_index":37,"tongjian_id":"bce13acb-db0e-11ef-bc67-a0d3651f611f"},{"link_birth_year":653,"link_death_year":740,"link_td_description":"杨思勖，罗州石城县人，唐朝宦官，本为苏姓，随养父姓氏。少年时为给事内侍省，跟随唐玄宗讨韦后、太平公主，擢升为左监门卫将军，唐玄宗倚重他。","link_td_id":"Q10003743","link_td_number_id":1461237,"people_name":"思勗","people_name_jianti_auto":"思勗","people_xingming":"杨思勖","start_index":55,"tongjian_id":"bce13acc-db0e-11ef-86f1-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bce13ac4-db0e-11ef-822d-a0d3651f611f","pinyin":"shuāng","source_anchor_text":"陳行範至瀧州破之擒","source_key":"baiyang_epub","start_index":11,"text":"瀧","tongjian_id":"3aa74650-d895-5f50-bfbf-e4b7ef300fde"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bce13ac4-db0e-11ef-822d-a0d3651f611f","pinyin":"lí","source_anchor_text":"皮或以刀剺髮際掣去","source_key":"baiyang_epub","start_index":98,"text":"剺","tongjian_id":"c5f8cb61-ba6a-5e2d-8989-d32161036826"}],"ExtRef_Children_places":[{"place_name":"瀧州","place_name_jianti_auto":"泷州","place_note":"广东罗定南","resolved_place_entity_id":2700,"start_index":11,"tongjian_id":"bce13acd-db0e-11ef-9dd2-a0d3651f611f"},{"place_name":"雲際","place_name_jianti_auto":"云际","resolved_place_entity_id":9740,"start_index":29,"tongjian_id":"bce13ace-db0e-11ef-b589-a0d3651f611f"},{"place_name":"盤遼","place_name_jianti_auto":"盘辽","resolved_place_entity_id":8447,"start_index":32,"tongjian_id":"bce13acf-db0e-11ef-9fba-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、罗定州（卷一百一）","excerpts":[{"context_after":"今州西有云致猺山，或曰即云际之讹也]。","context_before":"云际峒[在州西。旧为蛮峒地。又有盘辽峒。","source_end_index":56,"source_paragraph_tongjian_id":"bc5a1f47-2317-558e-994f-6b32f0b37ea6","source_start_index":20,"source_text":"唐开元十六年，泷州叛獠陈行范兵败，逃于云际、盘辽二峒，官都杨师勖追擒之。"}],"path":"广东方舆纪要/三、罗定州（卷一百一）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"14楊思勗討陳行範，至瀧州，破之，擒何遊魯、馮璘。行範逃於雲際、盤遼二洞，思勗追捕，竟生擒，斬之，凡斬首六萬。思勗爲人嚴，偏裨白事者不敢仰視，故用兵所向有功。然性忍酷，所得俘虜，或生剝面皮，或以刀剺髮際，掣去頭皮；蠻夷憚之。","content_fanyi":"杨思勖讨伐陈行范，到达泷州后将其击败，擒获何游鲁、冯璘。陈行范逃入云际、盘辽二洞，杨思勖追捕搜寻，最终将他活捉后斩首，这次征讨共斩首六万。杨思勖为人严厉，手下偏裨将领向他报告事情时不敢抬头仰视，所以率军出征所到之处都能立下战功。但他性情残忍酷烈，所抓获的俘虏，有的被活生生剥去脸皮，有的被用刀割开发际、扯去头皮；蛮夷都很畏惧他。","content_jianti_auto":"14杨思勗讨陈行范，至泷州，破之，擒何游鲁、冯璘。行范逃于云际、盘辽二洞，思勗追捕，竟生擒，斩之，凡斩首六万。思勗为人严，偏裨白事者不敢仰视，故用兵所向有功。然性忍酷，所得俘虏，或生剥面皮，或以刀剺发际，掣去头皮；蛮夷惮之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21445,"number":14,"reading_annotation_sources":[],"start_index":13,"tongjian_id":"bce13ac4-db0e-11ef-822d-a0d3651f611f"}],"reign_name":"十六年","reign_name_jianti_auto":"十六年","start_index":2,"tongjian_id":"bcdf7412-db0e-11ef-8a9b-a0d3651f611f","year_anno":"（戊辰、七二八）","year_int":728},"message":"success","success":true}