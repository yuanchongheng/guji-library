ef-8af3-a0d3651f611f"},{"place_name":"河州","place_name_jianti_auto":"河州","start_index":61,"tongjian_id":"a4cbba47-db0e-11ef-80e7-a0d3651f611f"},{"place_name":"北河州","place_name_jianti_auto":"北河州","start_index":64,"tongjian_id":"a4cbba48-db0e-11ef-93a1-a0d3651f611f"},{"place_name":"乞伏氏","place_name_jianti_auto":"乞伏氏","start_index":68,"tongjian_id":"a4cbba49-db0e-11ef-95ed-a0d3651f611f"},{"place_name":"枹罕","place_name_jianti_auto":"枹罕","start_index":76,"tongjian_id":"a4cbba4a-db0e-11ef-b313-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「屋弘」，當作「屋引」。魏書·官氏志，內入諸姓有屋引氏，後改爲房氏。張駿分興晉、金城、武始、南安、永晉、大夏、武成、漢中爲河州。北河州，乞伏氏所置也，治枹罕。鎭衞將軍，劉聰所置。","note_content_jianti_auto":"「屋弘」，当作「屋引」。魏书·官氏志，内入诸姓有屋引氏，后改为房氏。张骏分兴晋、金城、武始、南安、永晋、大夏、武成、汉中为河州。北河州，乞伏氏所置也，治枹罕。镇衞将军，刘聪所置。","note_type":"hu_note","start_index":39,"tongjian_id":"a4cbba3a-db0e-11ef-ac4a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張茂","people_name_jianti_auto":"张茂","start_index":0,"tongjian_id":"a4cbba4d-db0e-11ef-9000-a0d3651f611f"},{"people_name":"張氏","people_name_jianti_auto":"张氏","start_index":22,"tongjian_id":"a4cbba4e-db0e-11ef-8fc0-a0d3651f611f"},{"people_name":"張駿","people_name_jianti_auto":"张骏","start_index":51,"tongjian_id":"a4cbba4f-db0e-11ef-8d07-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"武興","place_name_jianti_auto":"武兴","start_index":3,"tongjian_id":"a4cbba50-db0e-11ef-b80e-a0d3651f611f"},{"place_name":"金城","place_name_jianti_auto":"金城","start_index":6,"tongjian_id":"a4cbba51-db0e-11ef-970f-a0d3651f611f"},{"place_name":"西平","place_name_jianti_auto":"西平","start_index":9,"tongjian_id":"a4cbba52-db0e-11ef-85d2-a0d3651f611f"},{"place_name":"安故","place_name_jianti_auto":"安故","start_index":12,"tongjian_id":"a4cbba53-db0e-11ef-967d-a0d3651f611f"},{"place_name":"定州","place_name_jianti_auto":"定州","start_index":15,"tongjian_id":"a4cbba54-db0e-11ef-bffe-a0d3651f611f"},{"place_name":"興晉郡","place_name_jianti_auto":"兴晋郡","start_index":18,"tongjian_id":"a4cbba55-db0e-11ef-b5a7-a0d3651f611f"},{"place_name":"枹罕縣","place_name_jianti_auto":"枹罕县","start_index":26,"tongjian_id":"a4cbba56-db0e-11ef-98fd-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":30,"tongjian_id":"a4cbba57-db0e-11ef-bccc-a0d3651f611f"},{"place_name":"金城郡","place_name_jianti_auto":"金城郡","start_index":32,"tongjian_id":"a4cbba58-db0e-11ef-8b6a-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":36,"tongjian_id":"a4cbba59-db0e-11ef-b744-a0d3651f611f"},{"place_name":"隴西郡","place_name_jianti_auto":"陇西郡","start_index":39,"tongjian_id":"a4cbba5a-db0e-11ef-9d16-a0d3651f611f"},{"place_name":"西平郡","place_name_jianti_auto":"西平郡","start_index":47,"tongjian_id":"a4cbba5b-db0e-11ef-a541-a0d3651f611f"},{"place_name":"晉興郡","place_name_jianti_auto":"晋兴郡","start_index":55,"tongjian_id":"a4cbba5c-db0e-11ef-81b0-a0d3651f611f"},{"place_name":"興晉郡","place_name_jianti_auto":"兴晋郡","start_index":63,"tongjian_id":"a4cbba5d-db0e-11ef-84be-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張茂分武興、金城、西平、安故爲定州。興晉郡亦張氏置。枹罕縣，漢屬金城郡，後漢屬隴西郡，後又分屬西平郡，張駿分屬晉興郡，後又分置興晉郡。瑥，音溫。枹，音膚。","note_content_jianti_auto":"张茂分武兴、金城、西平、安故为定州。兴晋郡亦张氏置。枹罕县，汉属金城郡，后汉属陇西郡，后又分属西平郡，张骏分属晋兴郡，后又分置兴晋郡。瑥，音温。枹，音肤。","note_type":"hu_note","start_index":55,"tongjian_id":"a4cbba4c-db0e-11ef-9b0a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"定州","place_name_jianti_auto":"定州","resolved_place_entity_id":320,"start_index":39,"tongjian_id":"a4cbba65-db0e-11ef-83ea-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、临洮府（卷六十）","excerpts":[{"context_after":"炽磐永康元年，迁于枹罕。暮末永弘二年，焚城邑东走，故地皆...","context_before":"...春秋》：乾归太初二年，枹罕羌彭奚念来归，以为北河州刺史。","source_end_index":327,"source_paragraph_tongjian_id":"d94c1326-098a-5c19-86ef-0c958a1656aa","source_start_index":306,"source_text":"九年，奚念入朝，以翟瑥为兴晋太守，镇枹罕。"}],"path":"陕西方舆纪要/九、临洮府（卷六十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"16六月，西秦王乾歸徵北河州刺史彭奚念爲鎭衞將軍；以鎭西將軍屋弘破光爲河州牧；定州刺史翟瑥爲興晉太守，鎭枹罕。","content_fanyi":"六月，西秦王乞伏乾归征召北河州刺史彭奚念，授以镇卫将军之职；镇西将军屋弘破光被任命为河州牧；定州刺史翟瑥调任兴晋太守，驻守枹罕。","content_jianti_auto":"16六月，西秦王干归征北河州刺史彭奚念为镇衞将军；以镇西将军屋弘破光为河州牧；定州刺史翟瑥为兴晋太守，镇枹罕。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9759,"number":16,"path":"资治通鉴 : 卷第一百九 (晉紀三十一) / 安皇帝甲 / 隆安元年 / 第 53 段","reading_annotation_sources":[],"start_index":52,"tongjian_id":"a4cbba39-db0e-11ef-9b96-a0d3651f611f","year_int":397},"tongjian_id":"a4cbba39-db0e-11ef-9b96-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"定州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"珪","people_name_jianti_auto":"珪","start_index":2,"tongjian_id":"a726aa14-db0e-11ef-996b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":0,"tongjian_id":"a726aa15-db0e-11ef-a346-a0d3651f611f"},{"place_name":"安州","place_name_jianti_auto":"安州","start_index":8,"tongjian_id":"a726aa16-db0e-11ef-894c-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":11,"tongjian_id":"a726aa17-db0e-11ef-8df0-a0d3651f611f"},{"place_name":"定州","place_name_jianti_auto":"定州","start_index":20,"tongjian_id":"a726aa18-db0e-11ef-9d10-a0d3651f611f"},{"place_name":"西山","place_name_jianti_auto":"西山","start_index":23,"tongjian_id":"a726aa19-db0e-11ef-80eb-a0d3651f611f"},{"place_name":"曲陽","place_name_jianti_auto":"曲阳","start_index":27,"tongjian_id":"a726aa1a-db0e-11ef-bebc-a0d3651f611f"},{"place_name":"西山","place_name_jianti_auto":"西山","start_index":29,"tongjian_id":"a726aa1b-db0e-11ef-9347-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏主珪皇始二年置安州于中山，天興三年改曰定州。西山，卽曲陽西山也。","note_content_jianti_auto":"魏主珪皇始二年置安州于中山，天兴三年改曰定州。西山，即曲阳西山也。","note_type":"hu_note","start_index":22,"tongjian_id":"a726aa13-db0e-11ef-8d0c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"定州","place_name_jianti_auto":"定州","resolved_place_entity_id":319,"start_index":3,"tongjian_id":"a726aa1e-db0e-11ef-b5b9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"二十年，北魏主焘自平城如恒山之阳。隋大业四年，祠恒岳。唐...","context_before":"...，北魏主嗣谋侵宋，将诸国兵南出天关[即天门也]，逾恒岭。","source_end_index":770,"source_paragraph_tongjian_id":"435eff47-1b32-5f8b-85be-b05773833451","source_start_index":735,"source_text":"元嘉五年，定州丁零鲜于台阳等二千余家，叛入西山，北魏将叔孙建复讨降之。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"16魏定州丁零鮮于臺陽等二千餘家叛，入西山，州郡不能討；閏月，魏主遣鎭南將軍叔孫建討之。","content_fanyi":"北魏定州丁零部落酋长鲜于台阳等率领两千多家背叛北魏，进入西山，地方州郡都无力讨伐；闰十月，北魏国主拓跋焘命令镇南将军叔孙建前往征讨。","content_jianti_auto":"16魏定州丁零鲜于台阳等二千余家叛，入西山，州郡不能讨；闰月，魏主遣镇南将军叔孙建讨之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11065,"number":16,"path":"资治通鉴 : 卷第一百二十一 (宋紀三) / 太祖文皇帝上之中 / 元嘉五年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"a726aa12-db0e-11ef-b8fc-a0d3651f611f","year_int":428},"tongjian_id":"a726aa12-db0e-11ef-b8fc-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"定州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"定州","place_name_jianti_auto":"定州","resolved_place_entity_id":319,"start_index":8,"tongjian_id":"a800a99a-db0e-11ef-bccc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"22甲辰，魏主如定州；十一月，乙丑，如冀州；己巳，畋于廣川；丙子，如鄴。","content_fanyi":"甲辰日，北魏国主前往定州；十一月乙丑日，前往冀州；己巳日，在广川狩猎；丙子日，前往邺县。","content_jianti_auto":"22甲辰，魏主如定州；十一月，乙丑，如冀州；己巳，畋于广川；丙子，如邺。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11335,"number":22,"path":"资治通鉴 : 卷第一百二十二 (宋紀四) / 太祖文皇帝上之下 / 十二年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"a800a998-db0e-11ef-8f12-a0d3651f611f","year_int":435},"tongjian_id":"a800a998-db0e-11ef-8f12-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"定州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":6,"tongjian_id":"a810cffd-db0e-11ef-b60a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"莎泉","place_name_jianti_auto":"莎泉","start_index":0,"tongjian_id":"a810cffe-db0e-11ef-ae32-a0d3651f611f"},{"place_name":"靈丘","place_name_jianti_auto":"灵丘","start_index":3,"tongjian_id":"a810cfff-db0e-11ef-afa0-a0d3651f611f"},{"place_name":"靈丘郡","place_name_jianti_auto":"灵丘郡","start_index":12,"tongjian_id":"a810d000-db0e-11ef-b535-a0d3651f611f"},{"place_name":"莎泉縣","place_name_jianti_auto":"莎泉县","start_index":16,"tongjian_id":"a810d001-db0e-11ef-9a9c-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":20,"tongjian_id":"a810d002-db0e-11ef-b982-a0d3651f611f"},{"place_name":"靈丘","place_name_jianti_auto":"灵丘","start_index":22,"tongjian_id":"a810d003-db0e-11ef-8371-a0d3651f611f"},{"place_name":"莎泉","place_name_jianti_auto":"莎泉","start_index":28,"tongjian_id":"a810d004-db0e-11ef-b880-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"莎泉在靈丘。魏收地形志：靈丘郡有莎泉縣。隋廢靈丘爲縣，倂莎泉入焉。莎，素何翻。","note_content_jianti_auto":"莎泉在灵丘。魏收地形志：灵丘郡有莎泉县。隋废灵丘为县，倂莎泉入焉。莎，素何翻。","note_type":"hu_note","start_index":23,"tongjian_id":"a810cffc-db0e-11ef-9ff7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"定州","place_name_jianti_auto":"定州","resolved_place_entity_id":319,"start_index":11,"tongjian_id":"a810d009-db0e-11ef-ab74-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"后齐废]。","context_before":"...九十三里。○莎泉城，在县东北。后魏置莎泉县，属北灵丘郡。","source_end_index":211,"source_paragraph_tongjian_id":"68b38bcf-9b22-5072-9020-9f29fcd92dc3","source_start_index":188,"source_text":"魏主焘太延二年，遣将张黎发定州兵通莎泉道，即此"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"14魏主遣廣平公張黎發定州兵一萬二千通莎泉道。","content_fanyi":"北魏主拓跋焘派遣广平公张黎征发定州军队一万二千人，开通莎泉道。","content_jianti_auto":"14魏主遣广平公张黎发定州兵一万二千通莎泉道。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11358,"number":14,"path":"资治通鉴 : 卷第一百二十三 (宋紀五) / 太祖文皇帝中之上 / 元嘉十三年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"a810cffb-db0e-11ef-8b98-a0d3651f611f","year_int":436},"tongjian_id":"a810cffb-db0e-11ef-8b98-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"定州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"定州","place_name_jianti_auto":"定州","resolved_place_entity_id":319,"start_index":4,"tongjian_id":"a817a0c9-d