ople_name":"張","people_name_jianti_auto":"张","start_index":26,"tongjian_id":"8cf0c178-db0e-11ef-b825-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":30,"tongjian_id":"8cf0c179-db0e-11ef-9c26-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十一行本「於」作「爲」；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：十一行本「于」作「为」；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8cf0c175-db0e-11ef-b825-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":110,"tongjian_id":"8cf0c174-db0e-11ef-aece-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲，于僞翻。樂，音洛；下同。","note_content_jianti_auto":"为，于伪翻。乐，音洛；下同。","note_type":"hu_note","start_index":117,"tongjian_id":"8cf0c17a-db0e-11ef-856b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"城市邑，言邑之有城市者，指言大邑也。","note_content_jianti_auto":"城市邑，言邑之有城市者，指言大邑也。","note_type":"hu_note","start_index":124,"tongjian_id":"8cf0c17b-db0e-11ef-a820-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"甚禍者，言甚以爲禍也。","note_content_jianti_auto":"甚祸者，言甚以为祸也。","note_type":"hu_note","start_index":156,"tongjian_id":"8cf0c17c-db0e-11ef-a3b4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛晃","people_name_jianti_auto":"毛晃","start_index":0,"tongjian_id":"8cf0c17e-db0e-11ef-b082-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"毛晃曰：推惡與人曰嫁怨、嫁禍。推，吐雷翻。","note_content_jianti_auto":"毛晃曰：推恶与人曰嫁怨、嫁祸。推，吐雷翻。","note_type":"hu_note","start_index":218,"tongjian_id":"8cf0c17d-db0e-11ef-b3b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":8,"chapter_name":"评论篇第八","chenzhu_chapter":"注中有论，由来尚矣，毛公之训《诗》，安国之传《书》，郑君之释《礼》，王弼之解《易》，皆有时参以论议。马、班而降，史论尤繁，荀悦曰论，陈寿曰评，裴松之引孙盛、徐众之书，亦皆以评为号，则评论实注家之一体也。胡注《通鉴》，评论亦众，此篇之外，散见于《史事》各篇者，大抵皆评论也。自清代文字狱迭兴，学者避之，始群趋于考据，以空言为大戒。不知言为心声，觇古人者宜莫善于此，胡明仲之《管见》，王船山之《鉴论》，皆足代表一时言议，岂得概以空言视之，《通鉴注》中之评论，亦犹是也。","chenzhu_index_in_chapter":2,"chenzhu_text":"此深有感于端平入洛之师也。元有吞天下之心，使宋无端平入洛之师，而元既灭金，亦必转而攻宋。故宋之祸不在于欲复三京，而在于赵葵、赵范之先无预备。","created_at":"2025-12-31 08:50:44","seq_in_chapter":7,"tongjian_id":"CH08-CZ002"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙括","people_name_jianti_auto":"赵括","start_index":42,"tongjian_id":"8cf2f752-db0e-11ef-9d5f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8cf2f753-db0e-11ef-812b-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":9,"tongjian_id":"8cf2f754-db0e-11ef-bfd1-a0d3651f611f"},{"place_name":"上黨","place_name_jianti_auto":"上党","start_index":12,"tongjian_id":"8cf2f755-db0e-11ef-85d1-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":15,"tongjian_id":"8cf2f756-db0e-11ef-bfde-a0d3651f611f"},{"place_name":"上黨","place_name_jianti_auto":"上党","start_index":22,"tongjian_id":"8cf2f757-db0e-11ef-9d90-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":26,"tongjian_id":"8cf2f758-db0e-11ef-addd-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":29,"tongjian_id":"8cf2f759-db0e-11ef-959c-a0d3651f611f"},{"place_name":"上黨","place_name_jianti_auto":"上党","start_index":36,"tongjian_id":"8cf2f75a-db0e-11ef-a7f1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦有吞天下之心，使趙不受上黨而秦得之，亦必據上黨而攻趙。故趙之禍不在於受上黨而在於用趙括。","note_content_jianti_auto":"秦有吞天下之心，使赵不受上党而秦得之，亦必据上党而攻赵。故赵之祸不在于受上党而在于用赵括。","note_type":"hu_note","start_index":289,"tongjian_id":"8cf0c17f-db0e-11ef-85fe-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"太守","official_note":"太守是秦漢時期郡的最高行政長官，負責一郡的政務、軍事和司法。在《資治通鑑》此段中，趙王封上黨太守為華陽君，顯示趙國接收上黨後對原韓國官員的安撫和封賞，以穩定新佔領地區。","official_rank":"郡級長官","source_snippet":"以萬戶都三封其太守爲華陽君","start_index":285,"tongjian_id":"df643160-a86c-405f-a13d-a5d1192ebf83"},{"confidence":0.95,"official_category":"地方行政","official_name":"縣令","official_note":"縣令是秦漢時期縣的最高行政長官，掌管一縣的民政、賦稅和治安。在此段中，趙王封上黨的縣令為侯，作為接收上黨後對基層官員的獎勵，旨在爭取地方支持，鞏固統治。","official_rank":"縣級長官","source_snippet":"以千戶都三封其縣令爲侯","start_index":295,"tongjian_id":"0f8ee9ea-1c4c-415c-830e-19e00f9d9c0f"}],"ExtRef_Children_people":[{"link_birth_year":-332,"link_death_year":-257,"link_td_description":"白起，芈姓白氏，郿县人，战国时代军事家、秦国名将，兵家代表人物。担任秦国将领30多年，攻城70余座，被封为武安君。","link_td_id":"Q10008015","link_td_number_id":19391,"people_name":"武安君","people_name_jianti_auto":"武安君","people_xingming":"白起","start_index":1,"tongjian_id":"8cf2f75d-db0e-11ef-a5aa-a0d3651f611f","wl_zhushi":"[白起]"},{"link_death_year":-260,"link_td_description":"冯亭，战国时期韩国地方官员，继靳黈之后担任韩国的上党郡守，后降赵，封为华阳君。","link_td_id":"Q10009699","link_td_number_id":805418,"people_name":"馮亭","people_name_jianti_auto":"冯亭","people_xingming":"冯亭","start_index":19,"tongjian_id":"8cf2f761-db0e-11ef-bc49-a0d3651f611f"},{"link_death_year":-245,"link_td_description":"赵孝成王，是中国战国时期赵国君主，原名赵丹，赵惠文王之子。","link_td_id":"Q10000660","link_td_number_id":334708,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"赵丹","start_index":133,"tongjian_id":"8cf2f776-db0e-11ef-971d-a0d3651f611f","wl_zhushi":"[赵丹]"},{"link_td_description":"赵豹，中国战国时期赵国的公子，赵惠文王的同母弟，平原君異母兄弟，母为赵惠后。","link_td_id":"Q1