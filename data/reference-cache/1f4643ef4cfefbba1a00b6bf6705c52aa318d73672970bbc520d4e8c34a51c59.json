Ref_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不勝爲負。","note_content_jianti_auto":"不胜为负。","note_type":"hu_note","start_index":281,"tongjian_id":"8bf676b0-db0e-11ef-9b8f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8bf676b3-db0e-11ef-bc3a-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8bf676b4-db0e-11ef-846f-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「子」下有「之」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「子」下有「之」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8bf676b2-db0e-11ef-b425-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":287,"tongjian_id":"8bf676b1-db0e-11ef-9276-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"比，毗至翻。阿黨爲比。","note_content_jianti_auto":"比，毗至翻。阿党为比。","note_type":"hu_note","start_index":305,"tongjian_id":"8bf676b5-db0e-11ef-ac32-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李克","people_name_jianti_auto":"李克","start_index":0,"tongjian_id":"8bf676b7-db0e-11ef-9148-a0d3651f611f"},{"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","start_index":6,"tongjian_id":"8bf676b8-db0e-11ef-b8bb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李克自叙其答魏文侯之言也。","note_content_jianti_auto":"李克自叙其答魏文侯之言也。","note_type":"hu_note","start_index":317,"tongjian_id":"8bf676b6-db0e-11ef-9e74-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":0,"tongjian_id":"8bf676ba-db0e-11ef-8948-a0d3651f611f"},{"people_name":"鄭","people_name_jianti_auto":"郑","start_index":12,"tongjian_id":"8bf676bb-db0e-11ef-8944-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孔穎達曰：祿者，穀也。故鄭註司祿云：祿也言穀，年穀豐然後制祿。授神契云：祿者，錄也。白虎通曰：上以收錄接下，下以名錄謹以事上是也。六斛四斗爲一鍾。","note_content_jianti_auto":"孔颖达曰：禄者，谷也。故郑注司禄云：禄也言谷，年谷丰然后制禄。授神契云：禄者，录也。白虎通曰：上以收录接下，下以名录谨以事上是也。六斛四斗为一钟。","note_type":"hu_note","start_index":335,"tongjian_id":"8bf676b9-db0e-11ef-93c5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":22,"tongjian_id":"8bf676c1-db0e-11ef-bcf4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"逡，七倫翻。逡巡，却退貌。卒，子恤翻，終也。孔穎達曰：先生，師也。謂師爲先生者，言彼先己而生，其德多厚也。自稱爲弟子者，言己自處如弟子，則尊其師如父兄也。","note_content_jianti_auto":"逡，七伦翻。逡巡，却退貌。卒，子恤翻，终也。孔颖达曰：先生，师也。谓师为先生者，言彼先己而生，其德多厚也。自称为弟子者，言己自处如弟子，则尊其师如父兄也。","note_type":"hu_note","start_index":418,"tongjian_id":"8bf676c0-db0e-11ef-9534-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.85,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期诸侯国的最高行政长官，相当于宰相，此处文侯与李克讨论任命相国之事，涉及魏成和翟璜的候选。","official_rank":"未知","source_snippet":"卜相","start_index":172,"tongjian_id":"70c798e4-5748-4ca0-8cdf-526050da409e"},{"confidence":0.9,"official_category":"地方行政","official_name":"西河守","official_note":"西河守是战国时期魏国的地方官职，负责西河地区的行政和军事事务，此处翟璜提及吴起担任此职以展示自己的推荐功绩。","official_rank":"未知","source_snippet":"西河守吳起","start_index":184,"tongjian_id":"3765a725-e740-4228-a519-c95c8c916a40"},{"confidence":0.8,"official_category":"文教","official_name":"傅","official_note":"傅是古代负责教导君主或贵族子弟的官职，此处翟璜提到推荐屈侯鮒担任文侯之子的傅，以显示自己的贡献。","official_rank":"未知","source_snippet":"君之子無傅","start_index":224,"tongjian_id":"159d2913-40fa-424c-85b9-7d20dcbd6e65"}],"ExtRef_Children_people":[{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"璜","people_name_jianti_auto":"璜","people_xingming":"翟璜","start_index":35,"tongjian_id":"8bf7ce70-db0e-11ef-8227-a0d3651f611f"},{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"翟璜","people_name_jianti_auto":"翟璜","start_index":161,"tongjian_id":"8bf7ce76-db0e-11ef-9ef8-a0d3651f611f"},{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"翟璜","people_name_jianti_auto":"翟璜","start_index":164,"tongjian_id":"8bf7ce77-db0e-11ef-be3b-a0d3651f611f"},{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"翟璜","people_name_jianti_auto":"翟璜","people_xingming":"翟璜","start_index":194,"tongjian_id":"8bf7ce79-db0e-11ef-bbf6-a0d3651f611f"},{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"翟璜","people_name_jianti_auto":"翟璜","people_xingming":"翟璜","start_index":393,"tongjian_id":"8bf7ce8d-db0e-11ef-95bd-a0d3651f611f"},{"link_td_description":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","link_td_number_id":2733946,"people_name":"璜","people_name_jianti_auto":"璜","people_xingming":"翟璜","start_index":402,"tongjian_id":"8bf7ce8e-db0e-11ef-b5c8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"文侯謂李克曰：「先生嘗有言曰：『家貧思良妻，國亂思良相。』今所置非成則璜，二子何如？」對曰：「卑不謀尊，疏不謀戚。臣在闕門之外，不敢當命。」文侯曰：「先生臨事勿讓！」克曰：「君弗察故也。居視其所親，富視其所與，達視其所舉，窮視其所不爲，貧視其所不取，五者足以定之矣，何待克哉！」文侯曰：「先生就舍，吾之相定矣。」李克出，見翟璜。翟璜曰：「今者聞君召先生而卜相，果誰爲之？」克曰：「魏成。」翟璜忿然作色曰：「西河守吳起，臣所進也。君內以鄴爲憂，臣進西門豹。君欲伐中山，臣進樂羊。中山已拔，無使守之，臣進先生。君之子無傅，臣進屈侯鮒。以耳目之所睹記，臣何負於魏成！」李克曰：「子言克於子之君者，豈將比周以求大官哉？君問相於克，克之對如是。所以知君之必相魏成者，魏成食祿千鍾，什九在外，什一在內；是以東得卜子夏、田子方、段干木。此三人者，君皆師之；子所進五人者，君皆臣之。子惡得與魏成比也！」翟璜逡巡再拜曰：「璜，鄙人也，失對，願卒爲子弟！」","content_fanyi":"魏文侯对李克说：“先生曾经说过：‘家贫时想着良妻，国乱时想着良相。’现在所要选任的国相，不是魏成就是翟璜，你看两人怎么样？”李克回答说：“地位卑下的人不谋议尊上的事，关系疏远的人不谋议亲近者的事。臣身在宫门之外，不敢参与议论。”魏文侯说：“先生遇到国事就不要推辞了！”李克说：“这是您没有仔细考察的缘故。平时看他亲近什么人，富有时看他交往什么人，显达时看他举荐什么人，困厄时看他不肯做什么，贫穷时看他不拿取什么。这五点就足以确定国相了，哪里用得着等我李克来定呢！”魏文侯说：“先生请回府吧，我的国相已经定了。”李克出来后，见到翟璜。翟璜问道：“刚才听说主君召先生去商议国相人选，到底定了谁做国相？”李克说：“魏成。”翟璜立刻气得变了脸色，说：“西河守吴起，是我举荐的；主君为国内的邺地忧虑，我举荐了西门豹；主君想攻伐中山，我举荐了乐羊；中山攻下之后，没有人可派去镇守，我举荐了先生；主君的儿子没有师傅，我举荐了屈侯鲋。凭这些耳闻目睹的事实，我哪里比不上魏成！”李克说：“你向主君推荐我李克，难道是为了结党营私来求取大官吗？主君向我询问国相人选，我就是这样回答的。我之所以知道主君必定会让魏成做国相，是因为魏成享受千钟俸禄，十分之九用在外面结交贤士，十分之一才用在家里；因此他在东边得到了卜子夏、田子方、段干木。这三个人，主君都当作老师；你所举荐的五个人，主君都当作臣下。你怎么能和魏成相比呢！”翟璜惭愧不安地拜了两拜说：“我翟璜是个鄙陋的人，方才答对失礼，情愿终身做先生的弟子！”","content_jianti_auto":"文侯谓李克曰：「先生尝有言曰：『家贫思良妻，国乱思良相。』今所置非成则璜，二子何如？」对曰：「卑不谋尊，疏不谋戚。臣在阙门之外，不敢当命。」文侯曰：「先生临事勿让！」克曰：「君弗察故也。居视其所亲，富视其所与，达视其所举，穷视其所不为，贫视其所不取，五者足以定之矣，何待克哉！」文侯曰：「先生就舍，吾之相定矣。」李克出，见翟璜。翟璜曰：「今者闻君召先生而卜相，果谁为之？」克曰：「魏成。」翟璜忿然作色曰：「西河守吴起，臣所进也。君内以邺为忧，臣进西门豹。君欲伐中山，臣进乐羊。中山已拔，无使守之，臣进先生。君之子无傅，臣进屈侯鲋。以耳目之所睹记，臣何负于魏成！」李克曰：「子言克于子之君者，岂将比周以求大官哉？君问相于克，克之对如是。所以知君之必相魏成者，魏成食禄千钟，什九在外，什一在内；是以东得卜子夏、田子方、段干木。此三人者，君皆师之；子所进五人者，君皆臣之。子恶得与魏成比也！」翟璜逡巡再拜曰：「璜，鄙人也，失对，愿卒为子弟！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":26,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 26 段","reading_annotation_sources":[],"start_index":25,"tongjian_id":"8bf67679-db0e-11ef-b621-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000344"},"tongjian_id":"8bf67679-db0e-11ef-b621-a0d3651f611f"},"paragraph_order":2}],"page_size":7,"total_pages":1,"total_paragraphs":2},"profile":{"alias_list":["翟触","翟黄"],"biography":"翟璜，又名翟触、翟黄，战国时期魏国绛（今山西绛县）人，为魏国的国相，辅佐魏文侯。","link_td_id":"Q10004901","name":"翟璜","number_id":2733946},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"被推荐给魏文侯担任邺令，来源文本：魏文侯在位期間，受翟璜推薦擔任鄴令","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10001343","source_person_name":"西门豹","source_person_number_id":693793,"statement_id":"S-Q10001343-P100061-Q10004901","target_person_id":"Q10004901","target_person_name":"翟璜","target_person_number_id":2733946},{"direction":"reverse","rank":"normal","relation_detail":"竞争相位关系，来源文本：魏文侯让李克拿定是魏成还是翟璜为相。最后是以魏成为相。翟璜不服，质问李克","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10002987","source_person_name":"魏成","source_person_number_id":1522959,"statement_id":"S-Q10002987-P100061-Q10004901","target_person_id":"Q10004901","target_person_name":"翟璜","target_person_number_id":2733946},{"direction":"reverse","rank":"normal","relation_detail":"任命为上卿，来源文本：以翟璜為上卿","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10008342","source_person_name":"魏文侯","source_person_number_id":211476,"statement_id":"S-Q10008342-P100061-Q10004901","target_person_id":"Q10004901","target_person_name":"翟璜","target_person_number_id":2733946}]},"message":"success","success":true}