a84d-0b278daa1417"},{"confidence":0.9,"official_category":"军事指挥","official_name":"客卿","official_note":"客卿是战国时期秦国任用外国人才担任的官职，此处客卿通率军救援楚国，体现了秦国的军事干预。","official_rank":"未知","source_snippet":"秦客卿通將兵救楚","start_index":28,"tongjian_id":"1f3b4140-816a-419c-8607-31eb9cc01283"}],"ExtRef_Children_people":[{"link_birth_year":-355,"link_death_year":-296,"link_td_description":"楚怀王，芈姓，熊氏，名槐，楚国君主。父为楚威王，怀王任用佞臣令尹子兰、上官大夫靳尚，宠爱郑袖，为人利令智昏，国事日非。最后被秦昭襄王所骗，监禁于秦国至死，楚人皆悲之。","link_td_id":"Q10000652","link_td_number_id":335220,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈槐","start_index":18,"tongjian_id":"8c83a4b1-db0e-11ef-a372-a0d3651f611f","wl_zhushi":"[芈槐]"},{"link_birth_year":-329,"link_death_year":-263,"link_td_description":"楚顷襄王，简称楚顷王或楚襄王，又作楚庄王（与其远祖楚庄王有别），芈姓，熊氏，名横，楚怀王之子，生母为郑袖。","link_td_id":"Q10000653","link_td_number_id":335229,"people_name":"橫","people_name_jianti_auto":"横","people_xingming":"芈横","start_index":23,"tongjian_id":"8c83a4b2-db0e-11ef-af1c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":1,"tongjian_id":"8c83a4ad-db0e-11ef-9828-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":3,"tongjian_id":"8c83a4ae-db0e-11ef-8164-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":5,"tongjian_id":"8c83a4af-db0e-11ef-9e0a-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":7,"tongjian_id":"8c83a4b0-db0e-11ef-99d0-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":16,"tongjian_id":"8c83a4b3-db0e-11ef-a9fc-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":27,"tongjian_id":"8c83a4b4-db0e-11ef-a5d1-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"都咸阳，陕西咸阳","resolved_place_entity_id":18,"start_index":32,"tongjian_id":"8c83a4b5-db0e-11ef-8c32-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":39,"tongjian_id":"8c83a4b6-db0e-11ef-8ef2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"3齊、韓、魏以楚負其從親，合兵伐楚。楚王使太子橫爲質於秦以請救。秦客卿通將兵救楚，三國引兵去。","content_fanyi":"齐国、韩国、魏国以楚国背弃合纵盟约为由，联合发兵讨伐楚国。楚王派太子横到秦国做人质，请求秦国出兵救援。秦国客卿通率军救楚，齐、韩、魏三国军队于是撤离楚国。","content_jianti_auto":"3齐、韩、魏以楚负其从亲，合兵伐楚。楚王使太子横为质于秦以请救。秦客卿通将兵救楚，三国引兵去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":279,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c81957a-db0e-11ef-9935-a0d3651f611f"}],"reign_name":"十二年","reign_name_jianti_auto":"十二年","start_index":11,"tongjian_id":"8c819547-db0e-11ef-90fa-a0d3651f611f","year_anno":"（戊午、前三○三）","year_int":-303},"message":"success","success":true}