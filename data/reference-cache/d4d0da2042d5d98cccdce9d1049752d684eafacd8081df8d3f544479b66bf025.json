ple_xingming":"李惴","start_index":10,"tongjian_id":"c4c180f6-db0e-11ef-a5aa-a0d3651f611f"},{"people_name":"棣王","people_name_jianti_auto":"棣王","people_xingming":"棣王","start_index":12,"tongjian_id":"c4c180f7-db0e-11ef-a8ff-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"12十一月，立憲宗子惴爲棣王。","content_fanyi":"十一月，将唐宪宗之子李惴立为棣王。","content_jianti_auto":"12十一月，立宪宗子惴为棣王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25394,"number":12,"reading_annotation_sources":[],"start_index":14,"tongjian_id":"c4c180f3-db0e-11ef-bab0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"繁會，謂人物浩繁，舟車所會之地。","note_content_jianti_auto":"繁会，谓人物浩繁，舟车所会之地。","note_type":"hu_note","start_index":66,"tongjian_id":"c4c180fa-db0e-11ef-84b7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"止今所謂度牒者。","note_content_jianti_auto":"止今所谓度牒者。","note_type":"hu_note","start_index":96,"tongjian_id":"c4c180fb-db0e-11ef-a9c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"公驗者，自本州給公文，所至以爲照驗。","note_content_jianti_auto":"公验者，自本州给公文，所至以为照验。","note_type":"hu_note","start_index":115,"tongjian_id":"c4c180fc-db0e-11ef-aa76-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"中書門下","official_note":"中書門下是唐代中后期的宰相机构，负责处理国家政务，此处表示该机构上奏关于度僧和造寺的管理建议。","official_rank":"未知","source_snippet":"中書門下奏","start_index":4,"tongjian_id":"6b9091a9-4983-4b22-a792-7876537c9161"},{"confidence":0.9,"official_category":"文教","official_name":"祠部","official_note":"祠部是唐代尚书省下的部门，掌管祭祀、宗教事务，此处表示官度僧尼的牒文需由祠部颁发。","official_rank":"未知","source_snippet":"仍申祠部給牒","start_index":78,"tongjian_id":"5a1a578f-dc10-4cf0-a7e9-67c61b8a8590"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"13十二月，中書門下奏：「度僧不精，則戒法墮壞；造寺無節，則損費過多。請自今諸州準元敕許置寺外，有勝地靈迹許脩復，繁會之縣許置一院。嚴禁私度僧、尼；若官度僧、尼有闕，則擇人補之，仍申祠部給牒。其欲遠遊尋師者，須有本州公驗。」從之。","content_fanyi":"十二月，中书门下上奏说：“剃度僧人如果不精心拣择，戒法就会败坏；修建寺院如果不加节制，耗费的钱财就会过多。请求自今以后，各州除按照原来敕令允许设置的佛寺外，有名胜或灵迹的地方准许修复，繁华都会所在的县准许设置一所寺院。严厉禁止私自剃度僧、尼；如果官府剃度的僧、尼名额出现空缺，就挑选合适的人补上，同时申报祠部发给度牒。僧、尼中想要远游寻师的人，必须持有本州发给的公文作凭证。”宣宗听从了这一建议。","content_jianti_auto":"13十二月，中书门下奏：「度僧不精，则戒法堕坏；造寺无节，则损费过多。请自今诸州准元敕许置寺外，有胜地灵迹许修复，繁会之县许置一院。严禁私度僧、尼；若官度僧、尼有阙，则择人补之，仍申祠部给牒。其欲远游寻师者，须有本州公验。」从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25395,"number":13,"reading_annotation_sources":[],"start_index":15,"tongjian_id":"c4c180f8-db0e-11ef-8354-a0d3651f611f"}],"reign_name":"六年","reign_name_jianti_auto":"六年","start_index":2,"tongjian_id":"c4bf3753-db0e-11ef-a088-a0d3651f611f","year_anno":"（壬申、八五二）","year_int":852},"message":"success","success":true}