{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛丑、前三二○）","note_content_jianti_auto":"（辛丑、前三二○）","note_type":"hu_note","start_index":0,"tongjian_id":"8c57be0c-db0e-11ef-8dc7-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":2,"chapter_name":"书法篇第二","chenzhu_chapter":"《通鉴》书法，不尽关褒贬，故不如《春秋》之严。温公谦不敢法《春秋》，而志在续《左氏传》，有所感触，亦仿左氏设辞“君子曰”而称“臣光曰”以发之。馀则据事直书，使人随其时地之异而评其得失，以为鉴戒，非有一定不易之书法也。旧传温公《修书前例》一卷，公曾孙伋曾梓行之，然脱落已甚，不皆可据。兹篇所录，则身之推论《通鉴》之书法为多，其有关全书义例及史文构造、史料采取，亦隶焉，固与《通鉴纲目》等之所谓书法，涵义颇殊也。","chenzhu_index_in_chapter":4,"chenzhu_text":"显王四十六年，赵武灵王不肯称王，令国人谓己曰君，至是又有卫贬号曰君之事。知温公之改称梁惠王曰君，不为无意也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":15,"tongjian_id":"CH02-CZ004"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":0,"tongjian_id":"8c57be0f-db0e-11ef-b80a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"衞","place_name_jianti_auto":"衞","start_index":7,"tongjian_id":"8c57be10-db0e-11ef-a908-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":16,"tongjian_id":"8c57be11-db0e-11ef-beb3-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":18,"tongjian_id":"8c57be12-db0e-11ef-a024-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"顯王二十三年，衞已貶號曰侯；介於秦、魏之間，國日以削弱，因更貶其號曰君。更，居孟翻。貶，悲檢翻。","note_content_jianti_auto":"显王二十三年，衞已贬号曰侯；介于秦、魏之间，国日以削弱，因更贬其号曰君。更，居孟翻。贬，悲检翻。","note_type":"hu_note","start_index":8,"tongjian_id":"8c57be0e-db0e-11ef-a491-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"衞","place_name_jianti_auto":"衞","resolved_place_entity_id":613,"start_index":1,"tongjian_id":"8c57be13-db0e-11ef-8712-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1衞更貶號曰君。","content_fanyi":"卫国国君再次把爵位从侯贬降为君。","content_jianti_auto":"1衞更贬号曰君。","dtjl_paragraph_links":[],"dtjl_references":[],"id":224,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c57be0d-db0e-11ef-8a2e-a0d3651f611f"}],"reign_name":"元年","reign_name_jianti_auto":"元年","start_index":0,"tongjian_id":"8c57be0b-db0e-11ef-9842-a0d3651f611f","year_anno":"（辛丑、前三二○）","year_int":-320},"message":"success","success":true}