tities":[],"ExtRef_Children_zhang_notes":[],"note_content":"盼，匹莧翻，又披班翻。按丁度集韻，盼，與盻同。盼子，齊之同姓，卽田盼也。班志，高唐縣屬平原郡。杜預曰：祝阿西北有高唐城。宋白曰：齊州章丘縣，古高唐，春秋、戰國之時爲齊邑，故城在廢禹城縣西四十里。唐之禹城，漢祝阿也。","note_content_jianti_auto":"盼，匹苋翻，又披班翻。按丁度集韵，盼，与盻同。盼子，齐之同姓，即田盼也。班志，高唐县属平原郡。杜预曰：祝阿西北有高唐城。宋白曰：齐州章丘县，古高唐，春秋、战国之时为齐邑，故城在废禹城县西四十里。唐之禹城，汉祝阿也。","note_type":"hu_note","start_index":144,"tongjian_id":"8c27e661-db0e-11ef-9c27-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黔敖","people_name_jianti_auto":"黔敖","start_index":5,"tongjian_id":"8c27e67b-db0e-11ef-ab78-a0d3651f611f"},{"people_name":"黔","people_name_jianti_auto":"黔","start_index":9,"tongjian_id":"8c27e67c-db0e-11ef-b81d-a0d3651f611f"},{"people_name":"司馬彪","people_name_jianti_auto":"司马彪","start_index":19,"tongjian_id":"8c27e67d-db0e-11ef-a07f-a0d3651f611f"},{"people_name":"丁度","people_name_jianti_auto":"丁度","start_index":41,"tongjian_id":"8c27e67e-db0e-11ef-b1ce-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":3,"tongjian_id":"8c27e67f-db0e-11ef-96f8-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":24,"tongjian_id":"8c27e680-db0e-11ef-9377-a0d3651f611f"},{"place_name":"薛縣","place_name_jianti_auto":"薛县","start_index":26,"tongjian_id":"8c27e681-db0e-11ef-b69e-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":29,"tongjian_id":"8c27e682-db0e-11ef-9db0-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":33,"tongjian_id":"8c27e683-db0e-11ef-ab3e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：齊有黔敖、則黔亦姓也，音其淹翻。司馬彪曰：魯國薛縣，六國時曰徐州。徐，音舒。丁度集韻「徐」作「俆」，音同。","note_content_jianti_auto":"姓谱：齐有黔敖、则黔亦姓也，音其淹翻。司马彪曰：鲁国薛县，六国时曰徐州。徐，音舒。丁度集韵「徐」作「俆」，音同。","note_type":"hu_note","start_index":156,"tongjian_id":"8c27e67a-db0e-11ef-ad72-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈逵","people_name_jianti_auto":"贾逵","start_index":12,"tongjian_id":"8c27e687-db0e-11ef-b189-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":0,"tongjian_id":"8c27e688-db0e-11ef-81f0-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":2,"tongjian_id":"8c27e689-db0e-11ef-bb6c-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":6,"tongjian_id":"8c27e68a-db0e-11ef-bdad-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":8,"tongjian_id":"8c27e68b-db0e-11ef-8089-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":16,"tongjian_id":"8c27e68c-db0e-11ef-90f2-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":18,"tongjian_id":"8c27e68d-db0e-11ef-a00c-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":20,"tongjian_id":"8c27e68e-db0e-11ef-85b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕在齊之北，趙在齊之西。賈逵曰：燕、趙畏齊，故祭以求福。燕，因肩翻。","note_content_jianti_auto":"燕在齐之北，赵在齐之西。贾逵曰：燕、赵畏齐，故祭以求福。燕，因肩翻。","note_type":"hu_note","start_index":169,"tongjian_id":"8c27e686-db0e-11ef-8cee-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏惠王","people_name_jianti_auto":"魏惠王","people_xingming":"魏罃","start_index":5,"tongjian_id":"8c27e691-db0e-11ef-a949-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"惠王","people_name_jianti_auto":"惠王","people_xingming":"魏罃","start_index":13,"tongjian_id":"8c27e692-db0e-11ef-9f33-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"惠王","people_name_jianti_auto":"惠王","people_xingming":"魏罃","start_index":34,"tongjian_id":"8c27e694-db0e-11ef-93df-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"惠王","people_name_jianti_auto":"惠王","people_xingming":"魏罃","start_index":214,"tongjian_id":"8c295c81-db0e-11ef-a1de-a0d3651f611f","wl_zhushi":"[魏罃]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"又鲁仲连谓田巴：今楚军南阳，赵伐高唐者也。汉置高唐县于此...","context_before":"...：齐庄公初，晋伐齐，至高唐。又赵肃侯六年，攻齐，拔高唐。","source_end_index":220,"source_paragraph_tongjian_id":"6d8917ea-a72f-567c-bf0a-f131ed834127","source_start_index":181,"source_text":"齐威王三十四年，与魏惠王会。威王曰：吾臣有盻子者，使守高唐，赵人不敢东渔于河。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"又宣王八年，与魏襄王会徐州，诸侯相王也。十年，楚围我徐州...","context_before":"...》作徐州。又句践平吴，以兵北渡淮，与齐、晋诸侯会于徐州。","source_end_index":329,"source_paragraph_tongjian_id":"7a04b6d6-ac2b-54ee-a7d6-8d8a39f95109","source_start_index":308,"source_text":"又齐威王谓魏惠王，吾吏有黔夫者，使守徐州。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"是也。汉置南城县，属东海郡，亦曰南成。武帝封城阳共王子贞...","context_before":"...武城。《孟子》：曾子居武城，有越寇。皆此。后亦谓之南城。","source_end_index":183,"source_paragraph_tongjian_id":"cfc5e774-3cb9-5008-982a-e7e85ce41520","source_start_index":156,"source_text":"齐威王谓魏惠王，吾臣有檀子者，使守南城，楚人不敢为寇。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1齊威王、魏惠王會田于郊。惠王曰：「齊亦有寶乎？」威王曰：「無有。」惠王曰：「寡人國雖小，尚有徑寸之珠，照車前後各十二乘者十枚。豈以齊大國而無寶乎？」威王曰：「寡人之所以爲寶者與王異。吾臣有檀子者，使守南城，則楚人不敢爲寇，泗上十二諸侯皆來朝。吾臣有盼子者，使守高唐，則趙人不敢東漁于河。吾吏有黔夫者，使守徐州，則燕人祭北門，趙人祭西門，徙而從者七千餘家。吾臣有種首者，使備盜賊，則道不拾遺。此四臣者，將照千里，豈特十二乘哉！」惠王有慚色。","content_fanyi":"齐威王、魏惠王在郊外相会并一同打猎。魏惠王问：“齐国也有值得称为宝物的东西吗？”齐威王说：“没有。”魏惠王说：“寡人的国家虽然狭小，尚且有十颗直径一寸、能照亮前后各十二辆车子的明珠。难道以齐国的大国地位，反而没有宝物吗？”齐威王说：“寡人所认为的宝物，与大王不同。我的臣子中有个叫檀子的，派他镇守南城，楚国人便不敢前来侵扰，泗水一带的十二个诸侯都来朝见。我的臣子中有个叫盼子的，派他镇守高唐，赵国人便不敢向东到黄河里捕鱼。我的官吏中有个叫黔夫的，派他镇守徐州，燕国人祭祀北门，赵国人祭祀西门，迁来跟随他的有七千多家。我的臣子中有个叫种首的，派他防范盗贼，道路上便没有人拾取他人遗失的东西。这四位臣子，光芒将照耀千里，哪里只是照亮十二辆车子呢！”魏惠王露出惭愧的神色。","content_jianti_auto":"1齐威王、魏惠王会田于郊。惠王曰：「齐亦有宝乎？」威王曰：「无有。」惠王曰：「寡人国虽小，尚有径寸之珠，照车前后各十二乘者十枚。岂以齐大国而无宝乎？」威王曰：「寡人之所以为宝者与王异。吾臣有檀子者，使守南城，则楚人不敢为寇，泗上十二诸侯皆来朝。吾臣有盼子者，使守高唐，则赵人不敢东渔于河。吾吏有黔夫者，使守徐州，则燕人祭北门，赵人祭西门，徙而从者七千余家。吾臣有种首者，使备盗贼，则道不拾遗。此四臣者，将照千里，岂特十二乘哉！」惠王有惭色。","dtjl_paragraph_links":[],"dtjl_references":[],"id":135,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c27e657-db0e-11ef-a241-a0d3651f611f","year_int":-355,"zhang_TJZJ_id":"zttjzj_000362"},"tongjian_id":"8c27e657-db0e-11ef-a241-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c295c84-db0e-11ef-aa4e-a0d3651f611f"},{"people_name":"嬰","people_name_jianti_auto":"婴","start_index":25,"tongjian_id":"8c295c85-db0e-11ef-b6d1-a0d3651f611f"},{"people_name":"昌平侯","people_name_jianti_auto":"昌平侯","start_index":27,"tongjian_id":"8c295c86-db0e-11ef-84c8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":3,"tongjian_id":"8c295c87-db0e-11ef-bf19-a0d3651f611f"},{"place_name":"杜陵縣","place_name_jianti_auto":"杜陵县","start_index":6,"tongjian_id":"8c295c88-db0e-11ef-a144-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":11,"tongjian_id":"8c295c89-db0e-11ef-a91e-a0d3651f611f"},{"place_name":"杜伯國","place_name_jianti_auto":"杜伯国","start_index":13,"tongjian_id":"8c295c8a-db0e-11ef-b9b9-a0d3651f611f"},{"place_name":"杜平鄕","place_name_jianti_auto":"杜平鄕","start_index":33,"tongjian_id":"8c295c8b-db0e-11ef-940f-a0d3651f611f"},{"place_name":"杜平","place_name_jianti_auto":"杜平","place_note":"陝西澄城縣","start_index":41,"tongjian_id":"8c295c8c-db0e-11ef-a12d-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":44,"tongjian_id":"8c295c8d-db0e-11ef-9f2e-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","start_index":46,"tongjian_id":"8c295c8e-db0e-11ef-bdbb-a0d3651f611f"},{"place_name":"澄城縣","place_name_jianti_auto":"澄城县","start_index":48,"tongjian_id":"8c295c8f-db0e-11ef-bf38-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，京兆有杜陵縣，故周之杜伯國也。史記·灌嬰傳：嬰以昌平侯食邑於杜平鄕。正義曰：杜平在唐之同州澄城縣界。魏世家作「社平」。","note_content_jianti_auto":"班志，京兆有杜陵县，故周之杜伯国也。史记·灌婴传：婴以昌平侯食邑于杜平鄕。正义曰：杜平在唐之同州澄城县界。魏世家作「社平」。","note_type":"hu_note","start_index":13,"tongjian_id":"8c295c83-db0e-11ef-afec-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_num