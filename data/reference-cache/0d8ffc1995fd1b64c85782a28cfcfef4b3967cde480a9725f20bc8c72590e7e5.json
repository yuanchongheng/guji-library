:2335,"start_index":30,"tongjian_id":"95cbe876-db0e-11ef-9e13-a0d3651f611f"},{"place_name":"鍾羌","place_name_jianti_auto":"钟羌","resolved_place_entity_id":2752,"start_index":34,"tongjian_id":"95cbe877-db0e-11ef-aa6d-a0d3651f611f"},{"place_name":"臨洮縣","place_name_jianti_auto":"临洮县","resolved_place_entity_id":8809,"start_index":38,"tongjian_id":"95cbe878-db0e-11ef-a809-a0d3651f611f"},{"place_name":"隴西","place_name_jianti_auto":"陇西","resolved_place_entity_id":342,"start_index":43,"tongjian_id":"95cbe879-db0e-11ef-8097-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、临洮府（卷六十）","excerpts":[{"context_after":"永建初，校尉马贤大破钟羌于临洮。于是凉州复安。钟羌，盖羌...","context_before":"...因之。建初二年，羌豪布桥等围南部都尉于临洮。马防讨破之。","source_end_index":70,"source_paragraph_tongjian_id":"f5dab46b-26c3-5ac9-881e-1cf7b1b04d6b","source_start_index":58,"source_text":"永初三年，钟羌破临洮县。"}],"path":"陕西方舆纪要/九、临洮府（卷六十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"晋省]。","context_before":"...羌城，在镇西北。汉宣帝神爵二年置县，属金城郡。后汉因之。","source_end_index":163,"source_paragraph_tongjian_id":"b61bd122-4c87-5cea-8bd5-5c66de384a38","source_start_index":147,"source_text":"永和三年，叛羌攻没破羌县，是也。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2遣騎都尉任仁督諸郡屯兵救三輔。仁戰數不利，當煎、勒姐羌攻沒破羌縣，鍾羌攻沒臨洮縣，執隴西南部都尉。","content_fanyi":"朝廷派骑都尉任仁督率各郡驻军救援三辅。任仁多次作战不利，当煎羌、勒姐羌攻陷破羌县，钟羌攻陷临洮县，活捉了陇西南部都尉。","content_jianti_auto":"2遣骑都尉任仁督诸郡屯兵救三辅。仁战数不利，当煎、勒姐羌攻没破羌县，钟羌攻没临洮县，执陇西南部都尉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3989,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"95cbe869-db0e-11ef-91b2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"變，改也；改過以復於善也。","note_content_jianti_auto":"变，改也；改过以复于善也。","note_type":"hu_note","start_index":35,"tongjian_id":"95cbe87b-db0e-11ef-9189-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公卿","official_note":"公卿泛指高级官员，如三公九卿，此处表示朝廷高官集体向皇帝请罪，反映灾情严重。","official_rank":"未知","source_snippet":"公卿詣闕謝","start_index":12,"tongjian_id":"518b8c4b-fc73-43d5-a175-6bb57eb5fe1a"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":4,"tongjian_id":"95cbe87c-db0e-11ef-be9a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3三月，京師大饑，民相食。壬辰，公卿詣闕謝；詔「務思變復，以助不逮。」","content_fanyi":"三月，京城洛阳发生大饥荒，百姓人吃人。三月初二日壬辰，三公九卿到宫门前向皇帝谢罪；皇帝下诏说：“务必用心思考如何消灾补过，以弥补朕能力不足的地方。”","content_jianti_auto":"3三月，京师大饥，民相食。壬辰，公卿诣阙谢；诏「务思变复，以助不逮。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":3990,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"95cbe87a-db0e-11ef-8439-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"和帝","people_name_jianti_auto":"和帝","start_index":0,"tongjian_id":"95cbe87f-db0e-11ef-9552-a0d3651f611f"},{"people_name":"恭","people_name_jianti_auto":"恭","start_index":8,"tongjian_id":"95cbe880-db0e-11ef-b819-a0d3651f611f"},{"people_name":"呂蓋","people_name_jianti_auto":"吕盖","start_index":10,"tongjian_id":"95cbe881-db0e-11ef-b828-a0d3651f611f"},{"people_name":"梁鮪","people_name_jianti_auto":"梁鲔","start_index":23,"tongjian_id":"95cbe882-db0e-11ef-9c3e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"和帝永元十二年，恭代呂蓋爲司徒；永初元年，復代梁鮪爲司徒。","note_content_jianti_auto":"和帝永元十二年，恭代吕盖为司徒；永初元年，复代梁鲔为司徒。","note_type":"hu_note","start_index":16,"tongjian_id":"95cbe87e-db0e-11ef-95ab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"恭","people_name_jianti_auto":"恭","start_index":2,"tongjian_id":"95cbe884-db0e-11ef-90b8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此謂恭府掾屬之高第也。守，手又翻。","note_content_jianti_auto":"此谓恭府掾属之高第也。守，手又翻。","note_type":"hu_note","start_index":31,"tongjian_id":"95cbe883-db0e-11ef-ac60-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"耆，老也。","note_content_jianti_auto":"耆，老也。","note_type":"hu_note","start_index":36,"tongjian_id":"95cbe885-db0e-11ef-b4a0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":3,"tongjian_id":"95cbe887-db0e-11ef-8d93-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"論語載孔子之言。","note_content_jianti_auto":"论语载孔子之言。","note_type":"hu_note","start_index":65,"tongjian_id":"95cbe886-db0e-11ef-8e46-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95cbe88a-db0e-11ef-906c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：言人患學之不習耳，若能究習，自有鄕里之舉，豈要待三公之辟乎！","note_content_jianti_auto":"贤曰：言人患学之不习耳，若能究习，自有鄕里之举，岂要待三公之辟乎！","note_type":"hu_note","start_index":75,"tongjian_id":"95cbe889-db0e-11ef-b242-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒为三公之一，掌管教化，此处指鲁恭被免去司徒官职。","official_rank":"正一品","source_snippet":"司徒魯恭罷","start_index":4,"tongjian_id":"dd5b1066-b81c-491e-8c55-7e9b14a0112d"},{"confidence":0.9,"official_category":"中枢机构","official_name":"列卿","official_note":"列卿指九卿等中央高级官员，此处表示鲁恭选拔的人才官至列卿。","official_rank":"未知","source_snippet":"選辟高第至列卿、郡守者數十人","start_index":22,"tongjian_id":"acb71dc8-31df-47dd-8c05-0469d12b9cb9"},{"confidence":0.9,"official_category":"地方行政","official_name":"郡守","official_note":"郡守为郡级行政长官，此处表示鲁恭选拔的人才官至郡守。","official_rank":"未知","source_snippet":"選辟高第至列卿、郡守者數十人","start_index":26,"tongjian_id":"4d896b4a-2a21-4aeb-a3fd-8e1b49522613"}],"ExtRef_Children_people":[{"link_birth_year":32,"link_death_year":112,"link_td_description":"鲁恭，字仲康，东汉扶风郡平陵县（陕西省咸阳市西）人，东汉大臣。","link_td_id":"Q10004311","link_td_number_id":4551770,"people_name":"魯恭","people_name_jianti_auto":"鲁恭","people_xingming":"鲁恭","start_index":6,"tongjian_id":"95cbe88c-db0e-11ef-9870-a0d3651f611f"},{"link_birth_year":32,"link_death_year":112,"link_td_description":"鲁恭，字仲康，东汉扶风郡平陵县（陕西省咸阳市西）人，东汉大臣。","link_td_id":"Q10004311","link_td_number_id":4551770,"people_name":"恭","people_name_jianti_auto":"恭","people_xingming":"鲁恭","start_index":10,"tongjian_id":"95cbe88d-db0e-11ef-aa14-a0d3651f611f"},{"link_birth_year":32,"link_death_year":112,"link_td_description":"鲁恭，字仲康，东汉扶风郡平陵县（陕西省咸阳市西）人，东汉大臣。","link_td_id":"Q10004311","link_td_number_id":4551770,"people_name":"恭","people_name_jianti_auto":"恭","people_xingming":"鲁恭","start_index":48,"tongjian_id":"95cbe88e-db0e-11ef-97bc-a0d3651f611f"},{"link_birth_year":32,"link_death_year":112,"link_td_description":"鲁恭，字仲康，东汉扶风郡平陵县（陕西省咸阳市西）人，东汉大臣。","link_td_id":"Q10004311","link_td_number_id":4551770,"people_name":"魯公","people_name_jianti_auto":"鲁公","people_xingming":"鲁恭","start_index":112,"tongjian_id":"95cbe88f-db0e-11ef-9627-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4壬寅，司徒魯恭罷。恭再在公位，選辟高第至列卿、郡守者數十人，而門下耆生或不蒙薦舉，至有怨望者。恭聞之，曰：「學之不講，是吾憂也，諸生不有鄕舉者乎！」終無所言，亦不借之議論。學者受業，必窮核問難，道成，然後謝遣之。學者曰：「魯公謝與議論，不可虛得。」","content_fanyi":"三月十二日壬寅，司徒鲁恭被免职。鲁恭两次身居三公之位，他所选拔征辟的高第人才中，后来官至列卿、郡守的有数十人；但他门下的老弟子中，有的却得不到荐举，以致有人心怀怨恨。鲁恭听说后，说：“学问没有讲明，这是我所忧虑的；各位儒生不是有郡县乡里举荐的机会吗！”这些人终于不再发出怨言，也不借此议论了。学生们前来受业，鲁恭一定要让他们穷尽义理、反复考核问难，直到学业有所成，然后才加以称许并送别离去。学生们说：“鲁公的称许和议论，都不可能凭空得到。”","content_jianti_auto":"4壬寅，司徒鲁恭罢。恭再在公位，选辟高第至列卿、郡守者数十人，而门下耆生或不蒙荐举，至有怨望者。恭闻之，曰：「学之不讲，是吾忧也，诸生不有鄕举者乎！」终无所言，亦不借之议论。学者受业，必穷核问难，道成，然后谢遣之。学者曰：「鲁公谢与议论，不可虚得。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":3991,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"95cbe87d-db0e-11ef-a5ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"大鴻臚","official_note":"大鴻臚是汉代九卿之一，负责接待宾客和礼仪事务，此处表示夏勤原任此职，后被任命为司徒。","official_rank":"九卿之一","source_snippet":"以大鴻臚九江夏勤爲司徒","start_index":8,"tongjian_id":"4574397b-2f10-4ea7-a883-563f4d1f85ee"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是汉代三公之一，掌管民政和教育，此处表示夏勤被任命为此职。","official_rank":"三公之一","source_snippet":"以大鴻臚九江夏勤爲司徒","start_index":17,"tongjian_id":"db4a0d92-0506-4943-bfeb-1cbcb19457ab"}],"ExtRef_Children_people":[{"link_td_description":"夏勤，字伯宗，九江郡寿春县（今安徽省寿县）人，东汉司徒。","link_td_id":"Q10007319","link_td_number_id":5359170,"people_name":"夏勤","people_name_jianti_auto":"夏勤","people_xingming":"夏勤","start_index":15,"tongjian_id":"95cbe891-db0e-11ef-807a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"九江","place_name_jianti_auto":"九江","resolved_place_entity_id":721,"start_index":13,"tongjian_id":"95cbe892-db0e-11ef-bdd1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"5夏，四月，丙寅，以大鴻臚九江夏勤爲司徒。","content_fanyi":"夏季四月丙寅，也就是初七日，任命大鸿胪九江人夏勤为司徒。","content_jianti_auto":"5夏，四月，丙寅，以大鸿胪九江夏勤为司徒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3992,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"95cbe890-db0e-11ef-9e7b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":36,"tongjian_id":"95cbe895-db0e-11ef-b725-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五官，亦郞也。大夫，光祿、太中、中散、諫議大夫也。官府吏，給事諸官府者。賢曰：續漢志曰：執金吾，緹騎二百人。緹，赤黃色。營士，謂五校營士也。緹，丁禮翻，又丁奚翻。","note_content_jianti_auto":"五官，亦郞也。大夫，光禄、太中、中散、谏议大夫也。官府吏，给事诸官府者。贤曰：续汉志曰：执金吾，缇骑二百人。缇，赤黄色。营士，谓五校营士也。缇，丁礼翻，又丁奚翻。","note_type":"hu_note","start_index":48,"tongjian_id":"95cbe894-db0e-11ef-a073-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"關內侯","official_note":"關內侯是漢代的爵位，通常授予有功之臣，此處表示吏民可通過捐錢穀獲得此爵位。","official_rank":"未知","source_snippet":"關內侯","start_index":18,"tongjian_id":"ef5faa1b-9d10-42c4-ab68-7b1a33999623"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"虎賁","official_note":"虎賁是漢代禁衛軍官職，負責宮廷護衛，此處表示吏民可通過捐錢穀擔任此職。","official_rank":"未知","source_snippet":"虎賁","start_index":22,"tongjian_id":"b1a7b62c-4cfc-438