[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惕，懼也；厲，危也。","note_content_jianti_auto":"惕，惧也；厉，危也。","note_type":"hu_note","start_index":95,"tongjian_id":"953f2642-db0e-11ef-9563-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"廖","people_name_jianti_auto":"廖","start_index":9,"tongjian_id":"953f2645-db0e-11ef-a24b-a0d3651f611f"},{"people_name":"廖","people_name_jianti_auto":"廖","start_index":28,"tongjian_id":"953f2646-db0e-11ef-a2db-a0d3651f611f"},{"people_name":"廖","people_name_jianti_auto":"廖","start_index":48,"tongjian_id":"953f2647-db0e-11ef-acfe-a0d3651f611f"},{"people_name":"廖","people_name_jianti_auto":"廖","start_index":65,"tongjian_id":"953f2648-db0e-11ef-a687-a0d3651f611f"},{"people_name":"廖","people_name_jianti_auto":"廖","start_index":73,"tongjian_id":"953f2649-db0e-11ef-9674-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：皇后紀稱「廖等並辭讓，願就關內侯，太后聞之云云；廖等不得已受封爵。」按太后之辭，皆不欲封廖等之意，而史家文勢，反似太后欲令廖等受封。今輒移廖等辭讓於太后語下，使文勢有序，讀者易解。","note_content_jianti_auto":"考异曰：皇后纪称「廖等并辞让，愿就关内侯，太后闻之云云；廖等不得已受封爵。」按太后之辞，皆不欲封廖等之意，而史家文势，反似太后欲令廖等受封。今辄移廖等辞让于太后语下，使文势有序，读者易解。","note_type":"hu_note","start_index":164,"tongjian_id":"953f2644-db0e-11ef-8897-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"衞尉","official_note":"衞尉是汉代九卿之一，负责宫廷警卫和宫门守卫，此处指马廖担任此职，在封侯前为衞尉。","official_rank":"九卿之一，秩中二千石","source_snippet":"封衞尉廖爲順陽侯","start_index":28,"tongjian_id":"fc9c5923-2f76-466e-b16b-b0cb81c65d50"},{"confidence":0.95,"official_category":"军事指挥","official_name":"車騎將軍","official_note":"車騎將軍是汉代高级军事官职，常负责征伐或护卫，此处指马防担任此职，在封侯前为車騎將軍。","official_rank":"高级将军，位次大将军","source_snippet":"車騎將軍防爲潁陽侯","start_index":38,"tongjian_id":"f49e05fd-b619-4cf8-95f9-2016f2870153"},{"confidence":0.95,"official_category":"军事指挥","official_name":"執金吾","official_note":"執金吾是汉代九卿之一，负责京城治安和巡逻，此处指马光担任此职，在封侯前为執金吾。","official_rank":"九卿之一，秩中二千石","source_snippet":"執金吾光爲許侯","start_index":48,"tongjian_id":"dc8a40ec-ea8b-4762-80e0-3a7238ea91ff"},{"confidence":0.9,"official_category":"爵位","official_name":"關內侯","official_note":"關內侯是汉代爵位，有食邑但无封国，此处廖等辞让封侯，希望接受较低的關內侯爵位。","official_rank":"二十等爵中的第十九级","source_snippet":"願就關內侯","start_index":116,"tongjian_id":"36f9de93-760d-4eb6-8052-de410a014655"},{"confidence":0.9,"official_category":"荣誉官职","official_name":"特進","official_note":"特進是汉代加官，授予退休或退隐的高级官员以示尊荣，此处防、廖、光受封后以特進身份退居府第。","official_rank":"加官，无固定品秩","source_snippet":"皆以特進就第","start_index":184,"tongjian_id":"b0bbe6e2-cbeb-4655-83e1-374e3d9bbd7a"}],"ExtRef_Children_people":[{"link_death_year":92,"link_td_description":"马廖，字敬平，扶风郡茂陵县（今陕西省兴平县）人，东汉政治人物。东汉开国功臣马援的长子，明德马皇后的长兄。","link_td_id":"Q10007482","link_td_number_id":1661456,"people_name":"廖","people_name_jianti_auto":"廖","people_xingming":"马廖","start_index":32,"tongjian_id":"953f264c-db0e-11ef-9ebc-a0d3651f611f"},{"link_death_year":92,"link_td_description":"马廖，字敬平，扶风郡茂陵县（今陕西省兴平县）人，东汉政治人物。东汉开国功臣马援的长子，明德马皇后的长兄。","link_td_id":"Q10007482","link_td_number_id":1661456,"people_name":"順陽侯","people_name_jianti_auto":"顺阳侯","people_xingming":"马廖","start_index":34,"tongjian_id":"953f264d-db0e-11ef-972a-a0d3651f611f"},{"people_name":"防","people_name_jianti_auto":"防","people_xingming":"马防","start_index":42,"tongjian_id":"953f264e-db0e-11ef-82c7-a0d3651f611f"},{"people_name":"潁陽侯","people_name_jianti_auto":"颍阳侯","people_xingming":"马防","start_index":44,"tongjian_id":"953f264f-db0e-11ef-b455-a0d3651f611f"},{"link_death_year":94,"link_td_description":"马光，字叔山，扶风郡茂陵县（今陕西省兴平市东北）人，马援三子，东汉许侯。","link_td_id":"Q10007483","link_td_number_id":5759959,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"马光","start_index":51,"tongjian_id":"953f2650-db0e-11ef-9601-a0d3651f611f"},{"link_death_year":94,"link_td_description":"马光，字叔山，扶风郡茂陵县（今陕西省兴平市东北）人，马援三子，东汉许侯。",