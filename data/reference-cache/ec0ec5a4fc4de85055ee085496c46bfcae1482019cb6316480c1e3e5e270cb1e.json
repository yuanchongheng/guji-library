ildren_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：永巷宮人，宮婢也。","note_content_jianti_auto":"贤曰：永巷宫人，宫婢也。","note_type":"hu_note","start_index":74,"tongjian_id":"953f265e-db0e-11ef-bb4d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"財政","official_name":"大司農","official_note":"大司農是漢代掌管國家財政、倉儲和賦稅的中央高級官員，屬於九卿之一。在原文中，提到大司農提供黃金千斤，這反映了其在財政管理中的角色，負責國庫物資的調配，用於太后喪事相關的賞賜或開支。","official_rank":"九卿之一，秩中二千石","source_snippet":"大司農黃金千斤","start_index":85,"tongjian_id":"394aea59-96b1-4710-ac30-ab07aa1a4e7e"}],"ExtRef_Children_people":[{"link_birth_year":40,"link_death_year":79,"link_td_description":"明德皇后，伏波将军马援小女，母蔺氏，名不详，汉明帝刘庄的皇后，撰《显宗起居注》。","link_td_id":"Q10001122","link_td_number_id":501420,"people_name":"馬氏","people_name_jianti_auto":"马氏","people_xingming":"马氏","start_index":10,"tongjian_id":"953f2660-db0e-11ef-ad05-a0d3651f611f"},{"link_birth_year":40,"link_death_year":79,"link_td_description":"明德皇后，伏波将军马援小女，母蔺氏，名不详，汉明帝刘庄的皇后，撰《显宗起居注》。","link_td_id":"Q10001122","link_td_number_id":501420,"people_name":"馬氏","people_name_jianti_auto":"马氏","people_xingming":"马氏","start_index":24,"tongjian_id":"953f2661-db0e-11ef-9ecb-a0d3651f611f"},{"link_td_description":"贾贵人，贾姓，真名失传，中国东汉时期皇族女性，出身南阳郡。为汉明帝刘庄贵人，汉章帝刘炟生母。","link_td_id":"Q10010336","link_td_number_id":1020352,"people_name":"賈貴人","people_name_jianti_auto":"贾贵人","people_xingming":"贾贵人","start_index":31,"tongjian_id":"953f2662-db0e-11ef-8d6a-a0d3651f611f"},{"people_name":"賈氏","people_name_jianti_auto":"贾氏","people_xingming":"贾氏","start_index":39,"tongjian_id":"953f2663-db0e-11ef-bdb4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"7六月，癸丑，皇太后馬氏崩。帝旣爲太后所養，專以馬氏爲外家，故賈貴人不登極位，賈氏親族無受寵榮者。及太后崩，但加貴人王赤綬，安車一駟，永巷宮人二百，御府雜帛二萬匹，大司農黃金千斤，錢二千萬而已。","content_fanyi":"六月三十日癸丑，皇太后马氏去世。汉章帝是由马太后抚养长大的，便只以马氏为外家，所以贾贵人不能登上太后尊位，贾氏亲族中也没有人蒙受过恩宠荣耀。等到太后去世，章帝只是加赐贾贵人诸侯王赤绶、四马安车一辆、永巷宫女二百人、御府杂色帛二万匹、大司农黄金千斤、钱二千万而已。","content_jianti_auto":"7六月，癸丑，皇太后马氏崩。帝既为太后所养，专以马氏为外家，故贾贵人不登极位，贾氏亲族无受宠荣者。及太后崩，但加贵人王赤绶，安车一驷，永巷宫人二百，御府杂帛二万匹，大司农黄金千斤，钱二千万而已。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3677,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"953f265b-db0e-11ef-a811-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"953f2666-db0e-11ef-9cf9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：諡法：中和純淑曰德。","note_content_jianti_auto":"贤曰：谥法：中和纯淑曰德。","note_type":"hu_note","start_index":15,"tongjian_id":"953f2665-db0e-11ef-b3b7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":40,"link_death_year":79,"link_td_description":"明德皇后，伏波将军马援小女，母蔺氏，名不详，汉明帝刘庄的皇后，撰《显宗起居注》。","link_td_id":"Q10001122","link_td_number_id":501420,"people_name":"明德皇后","people_name_jianti_auto":"明德皇后","people_xingming":"马太后","start_index":10,"tongjian_id":"953f2668-db0e-11ef-ad33-a0d3651f611f","wl_zhushi":"[马太后]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8秋，七月，壬戌，葬明德皇后。","content_fanyi":"秋季，七月初九日壬戌，安葬明德马皇后。","content_jianti_auto":"8秋，七月，壬戌，葬明德皇后。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3678,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"953f2664-db0e-11ef-a11c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":10,"source_start_index":0,"source_text":"事見二十七卷甘露三年","target_paragraph_tongjian_id":"913d484d-db0e-11ef-8457-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見二十七卷甘露三年。","note_content_jianti_auto":"事见二十七卷甘露三年。","note_type":"hu_note","start_index":26,"tongjian_id":"953f266a-db0e-11ef-ad1f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"句斷。","note_content_jianti_auto":"句断。","note_type":"hu_note","start_index":82,"tongjian_id":"953f266d-db0e-11ef-8223-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蘭臺","place_name_jianti_auto":"兰台","start_index":59,"tongjian_id":"953f266f-db0e-11ef-8d11-a0d3651f611f"},{"place_name":"東觀","place_name_jianti_auto":"东观","start_index":62,"tongjian_id":"953f2670-db0e-11ef-9e28-a0d3651f611f"},{"place_name":"白虎觀","place_name_jianti_auto":"白虎观","start_index":69,"tongjian_id":"953f2671-db0e-11ef-aa01-a0d3651f611f"},{"place_name":"北宮","place_name_jianti_auto":"北宫","start_index":73,"tongjian_id":"953f2672-db0e-11ef-bdad-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻。將，三署及虎賁、羽林中郞將也。大夫，光祿、太中、中散、諫議大夫也。博士，五經博士也。郞官，五署郞及尚書郞、蘭臺、東觀校書郞也。白虎觀在北宮。觀，古玩翻。","note_content_jianti_auto":"将，即亮翻。将，三署及虎贲、羽林中郞将也。大夫，光禄、太中、中散、谏议大夫也。博士，五经博士也。郞官，五署郞及尚书郞、兰台、东观校书郞也。白虎观在北宫。观，古玩翻。","note_type":"hu_note","start_index":108,"tongjian_id":"953f266e-db0e-11ef-bb89-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"校書郞","official_note":"校書郞是負責校勘書籍的官員，屬於文教類職務，在漢代常設於秘書監等機構。此處楊終以校書郞身份提出建議，推動了白虎觀會議的召開。","official_rank":"未知","source_snippet":"校書郞楊終建言","start_index":0,"tongjian_id":"4ee6ac5c-5bce-4d22-ad2d-b4f41bf72d0f"},{"confidence":0.9,"official_category":"中枢机构","official_name":"太常","official_note":"太常是漢代九卿之一，掌管禮儀、祭祀和文教事務。此處皇帝下詔給太常，指示其組織白虎觀會議，體現了太常在學術活動中的協調作用。","official_rank":"九卿之一","source_snippet":"詔太常","start_index":73,"tongjian_id":"198da5f5-d0b8-4d51-812d-201e93bbdfee"},{"confidence":0.8,"official_category":"军事指挥","official_name":"將","official_note":"將泛指軍事將領，在漢代可能指將軍等職。此處作為參與白虎觀會議的官員之一，反映了會議的廣泛參與性。","official_rank":"未知","source_snippet":"將、大夫、博士、郞官及諸儒會白虎觀","start_index":76,"tongjian_id":"869ed22a-8899-408f-a5a5-13168710706e"},{"confidence":0.85,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是漢代高級官員的泛稱，如光祿大夫等，常參與議政。此處作為會議參與者，顯示了朝廷對學術討論的重視。","official_rank":"未知","source_snippet":"將、大夫、博士、郞官及諸儒會白虎觀","start_index":78,"tongjian_id":"30f1ee65-7423-4e9f-8e75-3ddb78646564"},{"confidence":0.95,"official_category":"文教","official_name":"博士","official_note":"博士是漢代學官，負責教授經學和參與議政。此處博士參與白虎觀會議，直接體現了其在經學討論中的核心角色。","official_rank":"未知","source_snippet":"將、大夫、博士、郞官及諸儒會白虎觀","start_index":81,"tongjian_id":"6bfdff12-0564-449c-8926-e654ff5d3c07"},{"confidence":0.85,"official_category":"中枢机构","official_name":"郞官","official_note":"郞官是漢代宮廷侍從官員的統稱，如郞中、侍郎等，常參與政務。此處作為會議參與者，反映了年輕官員在學術活動中的參與。","official_rank":"未知","source_snippet":"將、大夫、博士、郞官及諸儒會白虎觀","start_index":84,"tongjian_id":"585629a8-8bce-4868-a029-f54e65a24dd8"},{"confidence":0.9,"official_category":"军事指挥","official_name":"五官中郞將","official_note":"五官中郞將是漢代禁軍將領，隸屬光祿勳，負責宮廷警衛。此處魏應以五官中郞將身份承制提問，在白虎觀會議中擔任重要職責。","official_rank":"比二千石","source_snippet":"使五官中郞將魏應承制問","start_index":98,"tongjian_id":"6d6bdae0-e366-4f86-8491-e0062a4f5bad"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"侍中","official_note":"侍中是漢代近臣，掌管詔命和顧問，常出入禁中。此處淳于恭以侍中身份上奏，在會議中負責傳達和記錄事宜。","official_rank":"比二千石","source_snippet":"侍中淳于恭奏","start_index":110,"tongjian_id":"04a19ef7-f5b6-450d-832b-37e56c649788"},{"confidence":0.85,"official_category":"地方行政","official_name":"廣平王","official_note":"廣平王是漢代封爵，屬於諸侯王，掌管封地事務。此處劉羨以廣平王身份參與白虎觀會議，顯示了皇室成員對經學討論的參與。","official_rank":"王爵","source_snippet":"廣平王羨皆與焉","start_index":140,"tongjian_id":"1518a964-659b-49bb-80e0-fcae3be1ef5e"}],"ExtRef_Children_people":[{"link_death_year":100,"link_td_description":"杨终，字子山，蜀郡成都（今四川省成都市）人。东汉校书郎，著《春秋外传》十二篇，改定章句十五万字。","link_td_id":"Q10019191","link_td_number_id":5759221,"people_name":"楊終","people_name_jianti_auto":"杨终","people_xingming":"杨终","start_index":4,"tongjian_id":"953f2675-db0e-11ef-a4e2-a0d3651f611f"},{"link_birth_year":-91,"link_death_year":-48,"link_td_description":"汉宣帝刘询，原名刘病已，字次卿，即位九年后改名询，汉朝皇帝（前74年9月10日－前48年1月10日在位），其正式谥号为「孝宣皇帝」，后世省略「孝」字称「汉宣帝」。汉武帝的曾孙，戾太子刘据的长孙，史皇孙刘进的长子，生母为王翁须。","link_td_id":"Q10000317","link_td_number_id":99982,"people_name":"宣帝","people_name_jianti_auto":"宣帝","start_index":10,"tongjian_id":"953f2676-db0e-11ef-b3d2-a0d3651f611f","wl_zhushi":"[刘病已•刘询]"},{"people_name":"魏應","people_name_jianti_auto":"魏应","people_xingming":"魏应","start_index":114,"tongjian_id":"953f267c-db0e-11ef-af97-a0d3651f611f"},{"link_death_year":80,"link_td_description":"淳于恭，字孟孫，北海郡淳于（今山東省安丘縣）人。善於講解《老子》，清靜不慕榮利。東漢侍中。","link_td_id":"Q10007333","link_td_number_id":5667936,"people_name":"淳于恭","people_name_jianti_auto":"淳于恭","people_xingming":"淳于恭","start_index":122,"tongjian_id":"953f267d-db0e-11ef-ba82-a0d3651f611f"},{"link_death_year":94,"link_td_description":"丁鸿，字孝公，颍川郡定陵县（河南省郾城区西）人，东汉初期大臣。","link_td_id":"Q10007291","link_td_number_id":4035731,"people_name":"丁鴻","people_name_jianti_auto":"丁鸿","people_xingming":"丁鸿","start_index":142,"tongjian_id":"953f267e-db0e-11ef-9da1-a0d3651f611f"},{"link_birth_year":21,"link_death_year":100,"link_td_description":"楼望，字次子，陈留郡雍丘县（今河南省开封市）人。年轻时研读《严氏春秋》。操节清白，在乡里有名气。","link_td_id":"Q10007352","link_td_number_id":5657781,"people_name":"樓望","people_name_jianti_auto":"楼望","people_xingming":"楼望","start_index":145,"tongjian_id":"953f267f-db0e-11ef-95a7-a0d3651f611f"},{"people_name":"成封","people_name_jianti_auto":"成封","people_xingming":"成封","start_index":148,"tongjian_id":"953f2680-db0e-11ef-9222-a0d3651f611f"},{"link_td_description":"桓郁，字仲恩，沛国龙亢人，东汉官员，儒学名士太常桓荣之子。","link_td_id":"Q10007374","link_td_number_id":1761030,"people_name":"桓郁","people_name_jianti_auto":"桓郁","people_xingming":"桓郁","start_index":151,"tongjian_id":"953f2681-db0e-11ef-a93a-a0d3651f611f"},{"link_birth_year":32,"link_death_year":92,"link_td_description":"班固，字孟坚，扶风安陵（今陕西咸阳）人，东汉历史学家，《汉书》作者。","link_td_id":"Q10004773","link_td_number_id":12023,"people_name":"班固","people_name_jianti_auto":"班固","people_xingming":"班固","start_index":154,"tongjian_id":"953f2682-db0e-11ef-aaa6-a0d3651f611f"},{"link_birth_year":30,"link_death_year":100,"link_td_description":"贾逵，字景伯。祖为洛阳贾氏，生于扶风郡平陵县（今陕西省咸阳市西北），东汉经学家、天文学家。历官郎中、左中郎将、侍中、骑都尉等职。乃贾谊九世孙，父亲是贾徽。","link_td_id":"Q10001397","link_td_number_id":167712,"people_name":"賈逵","people_name_jianti_auto":"贾逵","people_xingming":"贾逵","start_index":157,"tongjian_id":"953f2683-db0e-11ef-950e-a0d3651f611f"},{"link_death_year":97,"link_td_description":"刘羡，东汉明帝的第二子，生母不详。","link_td_id":"Q10002850","link_td_number_id":1570222,"people_name":"廣平王","people_name_jianti_auto":"广平王","people_xingming":"刘羡","start_index":160,"tongjian_id":"953f2684-db0e-11ef-b9b2-a0d3651f611f","wl_zhushi":"[刘]"},{"link_death_year":97,"link_td_description":"刘羡，东汉明帝的第二子，生母不详。","link_td_id":"Q10002850","link_td_number_id":1570222,"people_name":"羨","people_name_jianti_auto":"羡","people_xingming":"刘羡","start_index":163,"tongjian_id":"953f2685-db0e-11ef-a1f0-a0d3651f611f"},{"link_birth_year":32,"link_death_year":92,"link_td_description":"班固，字孟坚，扶风安陵（今陕西咸阳）人，东汉历史学家，《汉书》作者。","link_td_id":"Q10004773","link_td_number_id":12023,"people_name":"固","people_name_jianti_auto":"固","people_xingming":"班固","start_index":168,"tongjian_id":"953f2686-db0e-11ef-90f0-a0d3651f611f"},{"link_birth_year":32,"link_death_year":102,"link_td_description":"班超，字仲升，右扶风平陵县（今陕西省咸阳市秦都区）人，东汉将领、外交家。是开拓和维持汉代与西域关系的重要人物。","link_td_id":"Q10007410","link_td_number_id":13520,"people_name":"超","people_name_jianti_auto":"超","people_xingming":"班超","start_index":170,"tongjian_id":"953f2687-db0e-11ef-9b50-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石渠閣","place_name_jianti_auto":"石渠阁","resolved_place_entity_id":5073,"start_index":22,"tongjian_id":"953f2677-db0e-11ef-98a5-a0d3651f611f"},{"place_name":"石渠","place_name_jianti_auto":"石渠","resolved_place_entity_id":5073,"start_index":53,"tongjian_id":"953f2679-db0e-11ef-8e71-a0d3651f611f"},{"place_name":"白虎觀","place_name_jianti_auto":"白虎观","resolved_place_entity_id":8384,"start_index":97,"tongjian_id":"953f267a-db0e-11ef-836b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"9校書郞楊終建言：「宣帝博徵羣儒，論定五經於石渠閣。方今天下少事，學者得成其業，而章句之徒，破壞大體。宜如石渠故事，永爲後世則。」帝從之。冬，十一月，壬戌，詔太常：「將、大夫、博士、郞官及諸儒會白虎觀，議五經同異。」使五官中郞將魏應承制問，侍中淳于恭奏，帝親稱制臨決，作白虎議奏，名儒丁鴻、樓望、成封、桓郁、班固、賈逵及廣平王羨皆與焉。固，超之兄也。","content_fanyi":"校书郎杨终进言说：“宣帝曾广召群儒，在石渠阁论定《五经》。现在天下太平，学者能够完成自己的学业，但那些只知辨析章节句读的人，破坏了经书的大义。应当依照石渠阁的旧例，永久作为后世的法则。”汉章帝采纳了他的意见。冬季，十一月十一日壬戌，汉章帝下诏给太常说：“将军、大夫、博士、郎官以及各位儒者会集白虎观，讨论《五经》的异同。”又命五官中郎将魏应奉旨提问，侍中淳于恭将讨论结果上奏给汉章帝，汉章帝亲自以皇帝名义批复，并临白虎观裁决，撰成《白虎议奏》，名儒丁鸿、楼望、成封、桓郁、班固、贾逵以及广平王刘羡都参与了。班固是班超的哥哥。","content_jianti_auto":"9校书郞杨终建言：「宣帝博征群儒，论定五经于石渠阁。方今天下少事，学者得成其业，而章句之徒，破坏大体。宜如石渠故事，永为后世则。」帝从之。冬，十一月，壬戌，诏太常：「将、大夫、博士、郞官及诸儒会白虎观，议五经同异。」使五官中郞将魏应承制问，侍中淳于恭奏，帝亲称制临决，作白虎议奏，名儒丁鸿、楼望、成封、桓郁、班固、贾逵及广平王羡皆与焉。固，超之兄也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3679,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"953f2669-db0e-11ef-8f71-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000714"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":3,"tongjian_id":"953f2618-db0e-11ef-94c2-a0d3651f611f","year_anno":"（己卯、七九）","year_int":79},"message":"success","success":true}