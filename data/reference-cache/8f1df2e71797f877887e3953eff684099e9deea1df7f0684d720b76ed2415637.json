{"data":{"current_mention_tongjian_id":"8c39b18e-db0e-11ef-b820-a0d3651f611f","current_paragraph_tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"白溝","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁尚","people_name_jianti_auto":"袁尚","start_index":0,"tongjian_id":"99189ef0-db0e-11ef-b6c6-a0d3651f611f"},{"people_name":"操","people_name_jianti_auto":"操","start_index":5,"tongjian_id":"99189ef1-db0e-11ef-95ff-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":15,"tongjian_id":"99189ef2-db0e-11ef-9a65-a0d3651f611f"},{"people_name":"曹操","people_name_jianti_auto":"曹操","start_index":27,"tongjian_id":"99189ef3-db0e-11ef-a440-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":3,"tongjian_id":"99189ef4-db0e-11ef-a286-a0d3651f611f"},{"place_name":"淇水","place_name_jianti_auto":"淇水","start_index":19,"tongjian_id":"99189ef5-db0e-11ef-bcf6-a0d3651f611f"},{"place_name":"黎陽","place_name_jianti_auto":"黎阳","start_index":22,"tongjian_id":"99189ef6-db0e-11ef-80ed-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":25,"tongjian_id":"99189ef7-db0e-11ef-b9a3-a0d3651f611f"},{"place_name":"淇水","place_name_jianti_auto":"淇水","start_index":41,"tongjian_id":"99189ef8-db0e-11ef-bcc6-a0d3651f611f"},{"place_name":"白溝","place_name_jianti_auto":"白沟","start_index":45,"tongjian_id":"99189ef9-db0e-11ef-9f80-a0d3651f611f"},{"place_name":"淇水","place_name_jianti_auto":"淇水","start_index":53,"tongjian_id":"99189efa-db0e-11ef-89bf-a0d3651f611f"},{"place_name":"內黃縣","place_name_jianti_auto":"内黄县","start_index":57,"tongjian_id":"99189efb-db0e-11ef-ac89-a0d3651f611f"},{"place_name":"白溝","place_name_jianti_auto":"白沟","start_index":63,"tongjian_id":"99189efc-db0e-11ef-990e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"袁尚在鄴，操將攻之，故通糧道。班志曰：淇水至黎陽入河。曹操於水口下大枋木以成堰，遏淇水東入白溝。水經註曰：淇水東過內黃縣南，爲白溝。","note_content_jianti_auto":"袁尚在邺，操将攻之，故通粮道。班志曰：淇水至黎阳入河。曹操于水口下大枋木以成堰，遏淇水东入白沟。水经注曰：淇水东过内黄县南，为白沟。","note_type":"hu_note","start_index":22,"tongjian_id":"99189eef-db0e-11ef-80f6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"白溝","place_name_jianti_auto":"白沟","resolved_place_entity_id":5040,"start_index":15,"tongjian_id":"99189f02-db0e-11ef-a60a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"隋大业四年，又引白沟为永济渠，亦曰御河。自是卫河专有御河...","context_before":"...之白沟。淇水入焉，亦谓之宿胥渎。《志》云：卫水，小水也。","source_end_index":157,"source_paragraph_tongjian_id":"38b36b1e-d250-512c-acdd-23275394d122","source_start_index":90,"source_text":"后汉建安九年，曹操于淇水口下大枋木，遏淇水东入白沟。是时，淇水入大河，故操遏使东北流，以便漕运。卫河乃附淇水而东[淇水，见河南淇县]。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、大名府（卷十六）","excerpts":[{"context_after":"《志》云：县西南十里，旧有外郎河，或谓之黎水，盖即卫河故...","context_before":"...宇记》：卫河、淇水合流，亦曰黎水，亦曰濬水，又谓之白沟。","source_end_index":146,"source_paragraph_tongjian_id":"0c506082-de84-5f08-9711-9f1359fea7fd","source_start_index":115,"source_text":"魏武遏淇水东入白沟，盖昔时淇水南入河，堰之使东入卫，以通漕也。"},{"context_after":"虚，即殷墟，见河南安阳县。顿丘，见前]。","context_before":"...《战国策》：苏代曰：决宿胥之口，魏无虚、顿丘。即是渎也。","source_end_index":307,"source_paragraph_tongjian_id":"640e946c-057e-5e70-822e-e25fff782885","source_start_index":284,"source_text":"《魏志》：武帝因宿胥故渎，开白沟导清淇水入焉。"}],"path":"北直方舆纪要/七、大名府（卷十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1春，正月，曹操濟河，遏淇水入白溝以通糧道。","content_fanyi":"春季，正月，曹操渡过黄河，派人筑起堤坝，把淇水导入白沟，用来沟通运粮的水道。","content_jianti_auto":"1春，正月，曹操济河，遏淇水入白沟以通粮道。","dtjl_paragraph_links":[],"dtjl_references":[],"id":5537,"number":1,"path":"资治通鉴 : 卷第六十四 (漢紀五十六) / 孝獻皇帝己 / 九年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"99189eee-db0e-11ef-b94b-a0d3651f611f","year_int":204},"tongjian_id":"99189eee-db0e-11ef-b94b-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"白溝","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"中山","place_name_jianti_auto":"中山","start_index":4,"tongjian_id":"cd590887-db0e-11ef-9038-a0d3651f611f"},{"place_name":"蒲陰縣","place_name_jianti_auto":"蒲阴县","start_index":6,"tongjian_id":"cd590888-db0e-11ef-9b52-a0d3651f611f"},{"place_name":"陽城","place_name_jianti_auto":"阳城","start_index":10,"tongjian_id":"cd590889-db0e-11ef-9d74-a0d3651f611f"},{"place_name":"博水","place_name_jianti_auto":"博水","start_index":17,"tongjian_id":"cd59088a-db0e-11ef-aaf0-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":20,"tongjian_id":"cd59088b-db0e-11ef-8e5f-a0d3651f611f"},{"place_name":"望都縣","place_name_jianti_auto":"望都县","start_index":22,"tongjian_id":"cd59088c-db0e-11ef-a5f1-a0d3651f611f"},{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":28,"tongjian_id":"cd59088d-db0e-11ef-895c-a0d3651f611f"},{"place_name":"陽城澱","place_name_jianti_auto":"阳城淀","start_index":40,"tongjian_id":"cd59088e-db0e-11ef-9802-a0d3651f611f"},{"place_name":"陽城","place_name_jianti_auto":"阳城","place_note":"河北顺平县东南二十公里","start_index":44,"tongjian_id":"cd59088f-db0e-11ef-9ef5-a0d3651f611f"},{"place_name":"蒲陰縣","place_name_jianti_auto":"蒲阴县","start_index":47,"tongjian_id":"cd590890-db0e-11ef-8ce8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"續漢志：中山蒲陰縣有陽城。水經註：博水出中山望都縣，東逕陽城縣，散爲澤渚，世謂之陽城澱。陽城在蒲陰縣東南三十里。","note_content_jianti_auto":"续汉志：中山蒲阴县有阳城。水经注：博水出中山望都县，东迳阳城县，散为泽渚，世谓之阳城淀。阳城在蒲阴县东南三十里。","note_type":"hu_note","start_index":28,"tongjian_id":"cd590886-db0e-11ef-98c7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范成大","people_name_jianti_auto":"范成大","start_index":60,"tongjian_id":"cd590894-db0e-11ef-a17b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"南白溝","place_name_jianti_auto":"南白沟","start_index":1,"tongjian_id":"cd590895-db0e-11ef-9eff-a0d3651f611f"},{"place_name":"淇水","place_name_jianti_auto":"淇水","start_index":11,"tongjian_id":"cd590896-db0e-11ef-a0bc-a0d3651f611f"},{"place_name":"白溝","place_name_jianti_auto":"白沟","start_index":16,"tongjian_id":"cd590897-db0e-11ef-83fa-a0d3651f611f"},{"place_name":"北白溝","place_name_jianti_auto":"北白沟","start_index":21,"tongjian_id":"cd590898-db0e-11ef-8409-a0d3651f611f"},{"place_name":"涿州","place_name_jianti_auto":"涿州","start_index":25,"tongjian_id":"cd590899-db0e-11ef-8ade-a0d3651f611f"},{"place_name":"新城縣","place_name_jianti_auto":"新城县","start_index":27,"tongjian_id":"cd59089a-db0e-11ef-8729-a0d3651f611f"},{"place_name":"宋","place_name_jianti_auto":"宋","start_index":35,"tongjian_id":"cd59089b-db0e-11ef-bcba-a0d3651f611f"},{"place_name":"雄州","place_name_jianti_auto":"雄州","start_index":44,"tongjian_id":"cd59089c-db0e-11ef-b2e5-a0d3651f611f"},{"place_name":"界河","place_name_jianti_auto":"界河","start_index":49,"tongjian_id":"cd59089d-db0e-11ef-8374-a0d3651f611f"},{"place_name":"白溝驛","place_name_jianti_auto":"白沟驿","start_index":55,"tongjian_id":"cd59089e-db0e-11ef-8b18-a0d3651f611f"},{"place_name":"安肅軍","place_name_jianti_auto":"安肃军","start_index":69,"tongjian_id":"cd59089f-db0e-11ef-9b4b-a0d3651f611f"},{"place_name":"白溝河","place_name_jianti_auto":"白沟河","start_index":80,"tongjian_id":"cd5908a0-db0e-11ef-8c4c-a0d3651f611f"},{"place_name":"涿州","place_name_jianti_auto":"涿州","start_index":90,"tongjian_id":"cd5908a1-db0e-11ef-9af0-a0d3651f611f"},{"place_name":"北白溝","place_name_jianti_auto":"北白沟","start_index":95,"tongjian_id":"cd5908a2-db0e-11ef-8b36-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此南白溝也；水經註所謂淇水北出爲白溝者也。北白溝在涿州新城縣南六十里。宋人北使行程記曰：雄州之北，界河之南，有白溝驛。又范成大北使錄曰：自安肅軍出北門十五里，至白溝河，又一百五里至涿州。此言北白溝也。","note_content_jianti_auto":"此南白沟也；水经注所谓淇水北出为白沟者也。北白沟在涿州新城县南六十里。宋人北使行程记曰：雄州之北，界河之南，有白沟驿。又范成大北使录曰：自安肃军出北门十五里，至白沟河，又一百五里至涿州。此言北白沟也。","note_type":"hu_note","start_index":55,"tongjian_id":"cd590893-db0e-11ef-8858-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"白溝","place_name_jianti_auto":"白沟","place_note":"河北省海河支流","resolved_place_entity_id":5040,"start_index":50,"tongjian_id":"cd5908af-db0e-11ef-9071-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、保定府（卷十二）","excerpts":[{"context_after":"盖自此逾河而北也。《邑志》县东南有王大本口堤，昔人筑此以...","context_before":"...容城县界流入境，亦曰拒马河。宋人与辽分界于此，亦曰界河。","source_end_index":71,"source_paragraph_tongjian_id":"189dd604-164d-5dce-ba16-9f68006e0223","source_start_index":43,"source_text":"石晋开运二年，契丹入寇，晋兵败之于阳城，契丹逾白沟而去。"},{"context_after":"《水经注》：博水出中山望都县，东径阳城，散为渚泽，世谓之...","context_before":"...慕容德于邺，珪以军食不给，命仪去邺，徙屯巨鹿，积租阳城。","source_end_index":136,"source_paragraph_tongjian_id":"cec2f8ae-617d-5d99-8225-32f109ab024e","source_start_index":113,"source_text":"石晋开运二年，契丹入寇，晋军与战于阳城，败去。"},{"context_after":"旧史作白檀卫村]。","context_before":"白团卫村[在故阳城南四十里。","source_end_index":96,"source_paragraph_tongjian_id":"3dd844a9-c706-5371-a726-5c7f6294ce50","source_start_index":14,"source_text":"石晋开运二年，败契丹于阳城。师还至白团卫村，契丹复至，遂大战于此，契丹败却，晋兵逐北二十余里。契丹散卒至阳城东南水上，稍复布列，晋人前击，皆渡水遁去。晋师还保定州。"}],"path":"北直方舆纪要/二、保定府（卷十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"戊午，契丹至泰州。己未，晉軍南行，契丹踵之。晉軍至陽城，庚申，契丹大至。晉軍與戰，逐北十餘里，契丹踰白溝而去。","content_fanyi":"三月二十二日戊午，契丹军抵达泰州。三月二十三日己未，晋军向南撤退，契丹兵紧随其后。晋军到达阳城，三月二十四日庚申，契丹大部队逼近。晋军与契丹兵交战，将契丹兵向北驱逐了十多里，契丹兵越过白沟退走了。","content_jianti_auto":"戊午，契丹至泰州。己未，晋军南行，契丹踵之。晋军至阳城，庚申，契丹大至。晋军与战，逐北十余里，契丹逾白沟而去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":29789,"path":"资治通鉴 : 卷第二百八十四 (後晉紀五) / 齊王中 / 二年 / 第 29 段","reading_annotation_sources":[],"start_index":28,"tongjian_id":"cd590885-db0e-11ef-a996-a0d3651f611f","year_int":945},"tongjian_id":"cd590885-db0e-11ef-a996-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"白溝"},"message":"success","success":true}