{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚戌、五○）","note_content_jianti_auto":"（庚戌、五○）","note_type":"hu_note","start_index":0,"tongjian_id":"94e85700-db0e-11ef-adb1-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百官志：大將軍、三公奉，月三百五十斛；秩中二千石奉，月百八十斛；二千石，月百二十斛；比二千石，月百斛；千石，月九十斛；比千石，月八十斛；六百石，月七十斛；比六百石，月五十五斛；四百石，月五十斛；比四百石，月四十五斛；三百石，月四十斛；比三百石，月三十七斛；二百石，月三十斛；比二百石，月二十七斛；百石，月十六斛；斗食，月十一斛；佐史，月八斛。凡諸受奉，錢、穀各半。奉，音扶用翻。","note_content_jianti_auto":"百官志：大将军、三公奉，月三百五十斛；秩中二千石奉，月百八十斛；二千石，月百二十斛；比二千石，月百斛；千石，月九十斛；比千石，月八十斛；六百石，月七十斛；比六百石，月五十五斛；四百石，月五十斛；比四百石，月四十五斛；三百石，月四十斛；比三百石，月三十七斛；二百石，月三十斛；比二百石，月二十七斛；百石，月十六斛；斗食，月十一斛；佐史，月八斛。凡诸受奉，钱、谷各半。奉，音扶用翻。","note_type":"hu_note","start_index":10,"tongjian_id":"94e85702-db0e-11ef-a770-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"百官","official_note":"百官泛指朝廷中的各级官员，此处指光武帝下诏增加所有官员的俸禄，反映了东汉初年对官员待遇的调整。","official_rank":"未知","source_snippet":"詔增百官奉","start_index":4,"tongjian_id":"93d0b7e2-1e8a-4746-ae35-f694aeb422fb"},{"confidence":0.85,"official_category":"财政","official_name":"千石","official_note":"千石是汉代官员的俸禄等级，对应一定的品秩，此处指俸禄在千石及以上的官员，他们的俸禄被减少，以区别于西汉旧制。","official_rank":"中高级官员","source_snippet":"其千石已上","start_index":10,"tongjian_id":"3f512576-ec52-433d-a105-4f37590519fa"},{"confidence":0.85,"official_category":"财政","official_name":"六百石","official_note":"六百石是汉代官员的俸禄等级，对应较低的品秩，此处指俸禄在六百石及以下的官员，他们的俸禄被增加，以调整官员待遇结构。","official_rank":"中低级官员","source_snippet":"六百石已下","start_index":19,"tongjian_id":"1124c5b7-db16-418c-950c-6ddb7af31830"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西京","place_name_jianti_auto":"西京","resolved_place_entity_id":454,"start_index":18,"tongjian_id":"94e85704-db0e-11ef-ad99-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1正月，詔增百官奉，其千石已上，減於西京舊制，六百石已下，增於舊秩。","content_fanyi":"正月，光武帝下诏增加百官俸禄，其中千石以上的官员，低于西汉旧制；六百石以下的官员，高于西汉旧制。","content_jianti_auto":"1正月，诏增百官奉，其千石已上，减于西京旧制，六百石已下，增于旧秩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3455,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"94e85701-db0e-11ef-87a0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94e85707-db0e-11ef-b748-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"壽陵","place_name_jianti_auto":"寿陵","start_index":13,"tongjian_id":"94e85708-db0e-11ef-b276-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：初作陵，未有名，故號壽陵，蓋取久長之義也。","note_content_jianti_auto":"贤曰：初作陵，未有名，故号寿陵，盖取久长之义也。","note_type":"hu_note","start_index":6,"tongjian_id":"94e85706-db0e-11ef-bb99-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"赤眉","people_name_jianti_auto":"赤眉","start_index":1,"tongjian_id":"94e8570a-db0e-11ef-a554-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","start_index":4,"tongjian_id":"94e8570b-db0e-11ef-bdcf-a0d3651f611f"},{"place_name":"霸陵","place_name_jianti_auto":"霸陵","start_index":8,"tongjian_id":"94e8570c-db0e-11ef-a8f2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂赤眉入長安，惟霸陵不掘。","note_content_jianti_auto":"谓赤眉入长安，惟霸陵不掘。","note_type":"hu_note","start_index":76,"tongjian_id":"94e85709-db0e-11ef-b263-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"94e8570f-db0e-11ef-aaca-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":24,"tongjian_id":"94e85710-db0e-11ef-9ce1-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「無」下有「爲」字；乙十一行本同；張校同。』","note_content_jianti_auto":"『章：十二行本「无」下有「为」字；乙十一行本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"94e8570e-db0e-11ef-81e5-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":87,"tongjian_id":"94e8570d-db0e-11ef-a20b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94e85712-db0e-11ef-b1cf-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：言不起山陵，裁令封土陂池不停水而已。陂，音普何翻。池，音徒河翻。","note_content_jianti_auto":"贤曰：言不起山陵，裁令封土陂池不停水而已。陂，音普何翻。池，音徒河翻。","note_type":"hu_note","start_index":99,"tongjian_id":"94e85711-db0e-11ef-a5d0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"迭興，謂易姓而王者。","note_content_jianti_auto":"迭兴，谓易姓而王者。","note_type":"hu_note","start_index":112,"tongjian_id":"94e85713-db0e-11ef-a97c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"太宗","people_name_jianti_auto":"太宗","people_xingming":"刘恒","start_index":40,"tongjian_id":"94e85715-db0e-11ef-8ce7-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-188,"link_death_year":-141,"link_td_description":"汉景帝刘启，为汉朝皇帝（前157年7月14日－前141年3月9日在位），在位16年，享年48岁，其正式谥号为「孝景皇帝」，后世省略「孝」字称「汉景帝」。为汉文帝刘恒长子，母窦皇后。他在位期间，主要是削诸侯封地，平定七国之乱，巩固中央集权，勤俭治国，发展生产，他和其父亲文帝的统治时期合称文景之治，为中国自大一统以来的首个太平盛世。","link_td_id":"Q10000365","link_td_number_id":90408,"people_name":"景帝","people_name_jianti_auto":"景帝","people_xingming":"刘启","start_index":48,"tongjian_id":"94e85716-db0e-11ef-bf74-a0d3651f611f","wl_zhushi":"[刘启]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94e85705-db0e-11ef-b13b-a0d3651f611f","pinyin":"bēi","source_anchor_text":"頃無山陵陂池裁令流","source_key":"baiyang_epub","start_index":89,"text":"陂","tongjian_id":"0c764dcf-d072-597a-8529-cf086ff53315"}],"ExtRef_Children_places":[{"place_name":"壽陵","place_name_jianti_auto":"寿陵","resolved_place_entity_id":2593,"start_index":3,"tongjian_id":"94e85714-db0e-11ef-b0e3-a0d3651f611f"},{"place_name":"霸陵","place_name_jianti_auto":"霸陵","resolved_place_entity_id":1716,"start_index":63,"tongjian_id":"94e85717-db0e-11ef-8e55-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2初作壽陵。帝曰：「古者帝王之葬，皆陶人、瓦器、木車、茅馬，使後世之人不知其處。太宗識終始之義，景帝能述遵孝道，遭天下反覆，而霸陵獨完受其福，豈不美哉！今所制地不過二三頃，無山陵陂池，裁令流水而已。使迭興之後，與丘隴同體。」","content_fanyi":"开始营建寿陵。光武帝说：“古代帝王下葬时，随葬的尽是陶人、瓦器、木车、茅马，这些东西容易腐朽，使后世之人不知道陵墓所在。汉文帝懂得人生终始的道理，汉景帝能够遵循孝道，历经天下动乱，霸陵却独自保全并享受福泽，难道不是很好吗！如今所划定的土地不超过二三顷，不筑山陵、不挖陂池，只让流水畅通罢了。使朝代更替之后，陵墓仍与丘陇同为一体。”","content_jianti_auto":"2初作寿陵。帝曰：「古者帝王之葬，皆陶人、瓦器、木车、茅马，使后世之人不知其处。太宗识终始之义，景帝能述遵孝道，遭天下反复，而霸陵独完受其福，岂不美哉！今所制地不过二三顷，无山陵陂池，裁令流水而已。使迭兴之后，与丘陇同体。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":3456,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"94e85705-db0e-11ef-b13b-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000678"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":14,"tongjian_id":"94e8571d-db0e-11ef-a008-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"五原","place_name_jianti_auto":"五原","start_index":4,"tongjian_id":"94e8571e-db0e-11ef-bef8-a0d3651f611f"},{"place_name":"田辟","place_name_jianti_auto":"田辟","start_index":11,"tongjian_id":"94e8571f-db0e-11ef-b55b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志，五原西部都尉治田辟。師古曰：辟，讀曰壁。","note_content_jianti_auto":"地理志，五原西部都尉治田辟。师古曰：辟，读曰壁。","note_type":"hu_note","start_index":33,"tongjian_id":"94e8571c-db0e-11ef-bfa9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94e85722-db0e-11ef-b2d5-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":15,"tongjian_id":"94e85723-db0e-11ef-882a-a0d3651f611f"},{"people_name":"趙武侯","people_name_jianti_auto":"赵武侯","start_index":38,"tongjian_id":"94e85724-db0e-11ef-9d3a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"雲中","place_name_jianti_auto":"云中","start_index":3,"tongjian_id":"94e85725-db0e-11ef-9b0c-a0d3651f611f"},{"place_name":"勝州","place_name_jianti_auto":"胜州","start_index":11,"tongjian_id":"94e85726-db0e-11ef-a4d1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":19,"tongjian_id":"94e85727-db0e-11ef-9feb-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","start_index":20,"tongjian_id":"94e85728-db0e-11ef-98d1-a0d3651f611f"},{"place_name":"勝州","place_name_jianti_auto":"胜州","start_index":26,"tongjian_id":"94e85729-db0e-11ef-bcc4-a0d3651f611f"},{"place_name":"榆林縣","place_name_jianti_auto":"榆林县","start_index":33,"tongjian_id":"94e8572a-db0e-11ef-9040-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：雲中，郡名，在今勝州北。宋白曰：漢雲中故城，在勝州東北四十里榆林縣界，趙武侯所築。","note_content_jianti_auto":"贤曰：云中，郡名，在今胜州北。宋白曰：汉云中故城，在胜州东北四十里榆林县界，赵武侯所筑。","note_type":"hu_note","start_index":99,"tongjian_id":"94e85721-db0e-11ef-a4f5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代高級武官，負責統領禁軍或執行特殊任務，此處指段彬被派遣出使南匈奴，體現其外交和軍事職能。","official_rank":"未知","source_snippet":"詔遣中郞將段彬","start_index":3,"tongjian_id":"9e861b16-507b-41ce-8c7b-afdccfadf2d5"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"副校尉","official_note":"副校尉是校尉的副職，協助管理軍隊，此處王郁作為副手隨段彬出使南匈奴，參與外交和護衛任務。","official_rank":"未知","source_snippet":"副校尉王郁","start_index":10,"tongjian_id":"da9fc735-4a60-41cf-8088-3ef86f74c705"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"使匈奴中郞將","official_note":"使匈奴中郞將是漢朝為管理匈奴事務而特設的官職，負責護衛南單于並處理邊疆外交，此處標誌著漢朝對南匈奴的直接控制加強。","official_rank":"未知","source_snippet":"始置使匈奴中郞將","start_index":94,"tongjian_id":"f8b8762b-6e8a-485a-925d-753c3b5cc14b"}],"ExtRef_Children_people":[{"people_name":"段彬","people_name_jianti_auto":"段彬","people_xingming":"段彬","start_index":6,"tongjian_id":"94e8572b-db0e-11ef-9df2-a0d3651f611f"},{"people_name":"王郁","people_name_jianti_auto":"王郁","people_xingming":"王郁","start_index":12,"tongjian_id":"94e8572c-db0e-11ef-ae12-a0d3651f611f"},{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"挛鞮比","start_index":91,"tongjian_id":"94e8572f-db0e-11ef-ad58-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"南匈奴","place_name_jianti_auto":"南匈奴","resolved_place_entity_id":1075,"start_index":15,"tongjian_id":"94e8572d-db0e-11ef-b1ab-a0d3651f611f"},{"place_name":"五原","place_name_jianti_auto":"五原","resolved_place_entity_id":554,"start_index":24,"tongjian_id":"94e8572e-db0e-11ef-875d-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","resolved_place_entity_id":379,"start_index":96,"tongjian_id":"94e85730-db0e-11ef-95d8-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":102,"tongjian_id":"94e85731-db0e-11ef-a8c3-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"今离石之左国城，单于所徙庭也。晋成都王颖拜刘渊为北单于，...","context_before":"左国城[州东北二十里。晋时匈奴左部所居城也。《载记》：","source_end_index":44,"source_paragraph_tongjian_id":"636fe591-959e-5644-8481-2a2a1665e5ce","source_start_index":27,"source_text":"后汉建武初，南单于入居西河之美稷。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":["外交","内政"],"content":"3詔遣中郞將段彬、副校尉王郁使南匈奴，立其庭，去五原西部塞八十里。使者令單于伏拜受詔，單于顧望有頃，乃伏稱臣。拜訖，令譯曉使者曰：「單于新立，誠慙於左右，願使者衆中無相屈折也。」詔聽南單于入居雲中，始置使匈奴中郞將，將兵衞護之。","content_fanyi":"光武帝下诏派遣中郎将段彬、副校尉王郁出使南匈奴，为南匈奴建立王庭，距五原郡西部边塞八十里。使者命令单于伏地跪拜接受诏书，单于左顾右盼、犹豫了一会儿，才伏地下拜自称臣属。行礼完毕，单于让译者告诉使者说：“单于刚刚即位，在左右臣属面前实在感到羞愧，希望使者在众人面前不要再让单于屈身难堪。”光武帝下诏准许南单于进入云中郡居住，汉朝开始设置使匈奴中郎将，率兵护卫南单于。","content_jianti_auto":"3诏遣中郞将段彬、副校尉王郁使南匈奴，立其庭，去五原西部塞八十里。使者令单于伏拜受诏，单于顾望有顷，乃伏称臣。拜讫，令译晓使者曰：「单于新立，诚慙于左右，愿使者众中无相屈折也。」诏听南单于入居云中，始置使匈奴中郞将，将兵衞护之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3457,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"94e85718-db0e-11ef-9d86-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓氏骨都侯","people_name_jianti_auto":"韩氏骨都侯","start_index":0,"tongjian_id":"94e85734-db0e-11ef-bc14-a0d3651f611f"},{"people_name":"當于骨都侯","people_name_jianti_auto":"当于骨都侯","start_index":6,"tongjian_id":"94e85735-db0e-11ef-b223-a0d3651f611f"},{"people_name":"呼衍骨都侯","people_name_jianti_auto":"呼衍骨都侯","start_index":12,"tongjian_id":"94e85736-db0e-11ef-8ddb-a0d3651f611f"},{"people_name":"郞氏骨都侯","people_name_jianti_auto":"郞氏骨都侯","start_index":18,"tongjian_id":"94e85737-db0e-11ef-b121-a0d3651f611f"},{"people_name":"粟藉骨都侯","people_name_jianti_auto":"粟藉骨都侯","start_index":24,"tongjian_id":"94e85738-db0e-11ef-be8c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓氏骨都侯、當于骨都侯、呼衍骨都侯、郞氏骨都侯、粟藉骨都侯，凡五。薁，音郁。鞬，居言翻。","note_content_jianti_auto":"韩氏骨都侯、当于骨都侯、呼衍骨都侯、郞氏骨都侯、粟藉骨都侯，凡五。薁，音郁。鞬，居言翻。","note_type":"hu_note","start_index":25,"tongjian_id":"94e85733-db0e-11ef-84b2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"南单于","start_index":3,"tongjian_id":"94e8573a-db0e-11ef-8e50-a0d3651f611f"},{"link_death_year":50,"link_td_description":"薁鞬左贤王，为北匈奴蒲奴单于之弟，担任薁鞬左贤王。","link_td_id":"Q10001790","link_td_number_id":914952,"people_name":"薁鞬左賢王","people_name_jianti_auto":"薁鞬左贤王","people_xingming":"薁鞬左贤王","start_index":10,"tongjian_id":"94e8573b-db0e-11ef-8b97-a0d3651f611f"},{"people_name":"骨都侯","people_name_jianti_auto":"骨都侯","start_index":22,"tongjian_id":"94e8573c-db0e-11ef-b02a-a0d3651f611f"},{"people_name":"骨都侯","people_name_jianti_auto":"骨都侯","people_xingming":"骨都侯","start_index":57,"tongjian_id":"94e8573e-db0e-11ef-b696-a0d3651f611f"},{"link_death_year":50,"link_td_description":"薁鞬左贤王，为北匈奴蒲奴单于之弟，担任薁鞬左贤王。","link_td_id":"Q10001790","link_td_number_id":914952,"people_name":"左賢王","people_name_jianti_auto":"左贤王","people_xingming":"薁鞬左贤王","start_index":63,"tongjian_id":"94e8573f-db0e-11ef-82ab-a0d3651f611f"},{"people_name":"骨都侯","people_name_jianti_auto":"骨都侯","people_xingming":"骨都侯","start_index":70,"tongjian_id":"94e85740-db0e-11ef-8a67-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94e85732-db0e-11ef-a4b8-a0d3651f611f","pinyin":"yù","source_anchor_text":"所獲北虜薁鞬左賢王","source_key":"baiyang_epub","start_index":10,"text":"薁","tongjian_id":"e05adae3-13a4-5b3f-8835-a349d7b30eb7"}],"ExtRef_Children_places":[{"place_name":"北庭","place_name_jianti_auto":"北庭","resolved_place_entity_id":635,"start_index":34,"tongjian_id":"94e8573d-db0e-11ef-8c29-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"4夏，南單于所獲北虜薁鞬左賢王將其衆及南部五骨都侯合三萬餘人畔歸，去北庭三百餘里，自立爲單于。月餘，日更相攻擊，五骨都侯皆死，左賢王自殺，諸骨都侯子各擁兵自守。","content_fanyi":"夏季，南单于先前俘获的北匈奴薁鞬左贤王率领他的部众和南匈奴五位骨都侯，合计三万余人叛归北方，在距北匈奴王庭三百多里处自立为单于。一个多月里，他们每天相互攻击，五位骨都侯全部死去，左贤王自杀，各骨都侯的儿子各自拥兵自守。","content_jianti_auto":"4夏，南单于所获北虏薁鞬左贤王将其众及南部五骨都侯合三万余人畔归，去北庭三百余里，自立为单于。月余，日更相攻击，五骨都侯皆死，左贤王自杀，诸骨都侯子各拥兵自守。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3458,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"94e85732-db0e-11ef-a4b8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":13,"tongjian_id":"94e85743-db0e-11ef-8cfb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":36,"tongjian_id":"94e85744-db0e-11ef-b1e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"南匈奴傳：黃金璽，盭緺綬。賢曰：盭，音戾，草名；以戾草染綬，因以爲名，別漢諸侯王制。戾，綠色。緺，紫青色，音瓜。璽，斯氏翻。綬，音受。","note_content_jianti_auto":"南匈奴传：黄金玺，盭緺绶。贤曰：盭，音戾，草名；以戾草染绶，因以为名，别汉诸侯王制。戾，绿色。緺，紫青色，音瓜。玺，斯氏翻。绶，音受。","note_type":"hu_note","start_index":21,"tongjian_id":"94e85742-db0e-11ef-bb5c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94e85747-db0e-11ef-9d0d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：古之師行，二五爲什，食器之類必供之，故曰什物、什具。今人通謂生生之具爲什物。","note_content_jianti_auto":"贤曰：古之师行，二五为什，食器之类必供之，故曰什物、什具。今人通谓生生之具为什物。","note_type":"hu_note","start_index":33,"tongjian_id":"94e85746-db0e-11ef-a0be-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"段彬","people_name_jianti_auto":"段彬","start_index":45,"tongjian_id":"94e8574a-db0e-11ef-8252-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":53,"tongjian_id":"94e8574b-db0e-11ef-959f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"弛刑者，弛刑徒也。說文：弓解曰弛。此謂解其罪而輸作者。處，昌呂翻。考異曰：帝紀：今年春，使段彬賜璽綬，置使匈奴中郞將。據匈奴傳，賜璽綬在秋，其置中郞將亦未知決在何時。或者今春置之，至是更爲之約束制度耳。","note_content_jianti_auto":"弛刑者，弛刑徒也。说文：弓解曰弛。此谓解其罪而输作者。处，昌吕翻。考异曰：帝纪：今年春，使段彬赐玺绶，置使匈奴中郞将。据匈奴传，赐玺绶在秋，其置中郞将亦未知决在何时。或者今春置之，至是更为之约束制度耳。","note_type":"hu_note","start_index":82,"tongjian_id":"94e85749-db0e-11ef-a37b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":3,"tongjian_id":"94e85752-db0e-11ef-b1e6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"前此避匈奴內徙者，令皆歸復本土。","note_content_jianti_auto":"前此避匈奴内徙者，令皆归复本土。","note_type":"hu_note","start_index":167,"tongjian_id":"94e85751-db0e-11ef-9678-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻；下同。治，直之翻。","note_content_jianti_auto":"将，即亮翻；下同。治，直之翻。","note_type":"hu_note","start_index":180,"tongjian_id":"94e85753-db0e-11ef-86f8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":8,"source_start_index":0,"source_text":"徙民見上卷十五年","target_paragraph_tongjian_id":"948330cc-db0e-11ef-9d2e-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徙民見上卷十五年。","note_content_jianti_auto":"徙民见上卷十五年。","note_type":"hu_note","start_index":222,"tongjian_id":"94e85754-db0e-11ef-9ec1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代武官，負責宮廷侍衛或軍事指揮，此處指派中郞將帶領弛刑人員隨南單于監察動靜，體現漢朝對邊疆的控制。","official_rank":"未知","source_snippet":"令中郞將將弛刑五十人","start_index":68,"tongjian_id":"431740ee-05ea-4298-ad99-230b2d0ccae4"},{"confidence":0.85,"official_category":"文教或禮儀","official_name":"謁者","official_note":"謁者是漢代官職，負責傳達詔令或接待賓客，此處指派謁者護送南單于的侍子返回，顯示漢朝的外交禮儀和邊疆管理。","official_rank":"未知","source_snippet":"漢遣謁者送前侍子還單于庭","start_index":103,"tongjian_id":"8c30f732-3c38-4149-b94a-e805b9f63faa"},{"confidence":0.85,"official_category":"文教或禮儀","official_name":"謁者","official_note":"謁者在此處負責帶領弛刑人員修復城郭，體現其在邊疆事務中的執行角色。","official_rank":"未知","source_snippet":"遣謁者分將弛刑","start_index":156,"tongjian_id":"17b9c7e3-4b74-4852-b2be-e49a7da626f4"}],"ExtRef_Children_people":[{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"南单于","start_index":3,"tongjian_id":"94e85755-db0e-11ef-bb9d-a0d3651f611f"},{"people_name":"左","people_name_jianti_auto":"左","people_xingming":"左贤王","start_index":117,"tongjian_id":"94e85757-db0e-11ef-a86e-a0d3651f611f"},{"people_name":"右賢王","people_name_jianti_auto":"右贤王","people_xingming":"右贤王","start_index":119,"tongjian_id":"94e85758-db0e-11ef-882a-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94e85741-db0e-11ef-8e96-a0d3651f611f","pinyin":"bèi","source_anchor_text":"轉河東米糒二萬五千","source_key":"baiyang_epub","start_index":38,"text":"糒","tongjian_id":"48ec3ae7-5a12-5b6c-81d6-0942df3ac850"}],"ExtRef_Children_places":[{"place_name":"河東","place_name_jianti_auto":"河东","resolved_place_entity_id":105,"start_index":35,"tongjian_id":"94e85756-db0e-11ef-ae21-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":97,"tongjian_id":"94e85759-db0e-11ef-9190-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","resolved_place_entity_id":379,"start_index":137,"tongjian_id":"94e8575a-db0e-11ef-8a0c-a0d3651f611f"},{"place_name":"五原","place_name_jianti_auto":"五原","resolved_place_entity_id":554,"start_index":140,"tongjian_id":"94e8575b-db0e-11ef-9748-a0d3651f611f"},{"place_name":"朔方","place_name_jianti_auto":"朔方","resolved_place_entity_id":206,"start_index":143,"tongjian_id":"94e8575c-db0e-11ef-8c82-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","resolved_place_entity_id":457,"start_index":146,"tongjian_id":"94e8575d-db0e-11ef-a9c4-a0d3651f611f"},{"place_name":"定襄","place_name_jianti_auto":"定襄","resolved_place_entity_id":968,"start_index":149,"tongjian_id":"94e8575e-db0e-11ef-9735-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","resolved_place_entity_id":496,"start_index":152,"tongjian_id":"94e8575f-db0e-11ef-8767-a0d3651f611f"},{"place_name":"上谷","place_name_jianti_auto":"上谷","resolved_place_entity_id":502,"start_index":155,"tongjian_id":"94e85760-db0e-11ef-93d7-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","resolved_place_entity_id":239,"start_index":158,"tongjian_id":"94e85761-db0e-11ef-b9f5-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","内政"],"content":"5秋，南單于遣子入侍。詔賜單于冠帶、璽綬、車馬、金帛、甲兵、什器。又轉河東米糒二萬五千斛，牛羊三萬六千頭以贍給之。令中郞將將弛刑五十人，隨單于所處，參辭訟，察動靜。單于歲盡輒遣奉奏，送侍子入朝，漢遣謁者送前侍子還單于庭，賜單于及閼氏、左·右賢王以下繒綵合萬匹，歲以爲常。於是雲中、五原、朔方、北地、定襄、鴈門、上谷、代八郡民歸於本土。遣謁者分將弛刑，補治城郭，發遣邊民在中國者布還諸縣，皆賜以裝錢，轉給糧食。時城郭丘墟，掃地更爲，上乃悔前徙之。","content_fanyi":"秋季，南匈奴单于派儿子入京为质。光武帝下诏赏赐南匈奴单于冠带、玺绶、车马、金帛、甲兵和日用器物，又从河东郡调运二万五千斛米粮、三万六千头牛羊供给他们。命令中郎将率领减刑囚徒五十人，随从单于，协助单于处理诉讼案件，暗中侦察其动静。每到年终，单于就派使者呈送奏书，护送侍子入京朝见，汉朝则派谒者把前一名侍子送回单于王庭，赏赐单于、阏氏、左、右贤王以下共一万匹彩色丝绸，并作为每年的常例。于是云中、五原、朔方、北地、定襄、雁门、上谷、代八郡百姓都返回故乡。汉朝又派谒者分路率领减刑囚徒修补城郭，遣送内迁中原的边民返回原属各县，都赐给安家费用，并转运粮食供给他们。当时城郭已成废墟，一切都要从头重建，光武帝于是后悔当初不该强迫边民内迁。","content_jianti_auto":"5秋，南单于遣子入侍。诏赐单于冠带、玺绶、车马、金帛、甲兵、什器。又转河东米糒二万五千斛，牛羊三万六千头以赡给之。令中郞将将弛刑五十人，随单于所处，参辞讼，察动静。单于岁尽辄遣奉奏，送侍子入朝，汉遣谒者送前侍子还单于庭，赐单于及阏氏、左·右贤王以下缯彩合万匹，岁以为常。于是云中、五原、朔方、北地、定襄、鴈门、上谷、代八郡民归于本土。遣谒者分将弛刑，补治城郭，发遣边民在中国者布还诸县，皆赐以装钱，转给粮食。时城郭丘墟，扫地更为，上乃悔前徙之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3459,"number":5,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":4,"tongjian_id":"94e85741-db0e-11ef-8e96-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":15,"tongjian_id":"94e85765-db0e-11ef-ad4c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":1,"tongjian_id":"94e85766-db0e-11ef-b627-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","start_index":10,"tongjian_id":"94e85767-db0e-11ef-a51d-a0d3651f611f"},{"place_name":"美稷","place_name_jianti_auto":"美稷","start_index":12,"tongjian_id":"94e85768-db0e-11ef-a65a-a0d3651f611f"},{"place_name":"汾州","place_name_jianti_auto":"汾州","start_index":19,"tongjian_id":"94e85769-db0e-11ef-bf69-a0d3651f611f"},{"place_name":"隰城縣","place_name_jianti_auto":"隰城县","start_index":21,"tongjian_id":"94e8576a-db0e-11ef-ab93-a0d3651f611f"},{"place_name":"美稷鄕","place_name_jianti_auto":"美稷鄕","start_index":25,"tongjian_id":"94e8576b-db0e-11ef-a20f-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":30,"tongjian_id":"94e8576c-db0e-11ef-99a5-a0d3651f611f"},{"place_name":"美稷縣","place_name_jianti_auto":"美稷县","start_index":31,"tongjian_id":"94e8576d-db0e-11ef-85ed-a0d3651f611f"},{"place_name":"隰城","place_name_jianti_auto":"隰城","start_index":36,"tongjian_id":"94e8576e-db0e-11ef-95b7-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":39,"tongjian_id":"94e8576f-db0e-11ef-bafd-a0d3651f611f"},{"place_name":"茲氏縣","place_name_jianti_auto":"兹氏县","start_index":41,"tongjian_id":"94e85770-db0e-11ef-b345-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"使匈奴中郞將自是亦屯西河美稷。杜佑曰：汾州隰城縣有美稷鄕，卽漢美稷縣也。隰城，漢之茲氏縣也。","note_content_jianti_auto":"使匈奴中郞将自是亦屯西河美稷。杜佑曰：汾州隰城县有美稷鄕，即汉美稷县也。隰城，汉之兹氏县也。","note_type":"hu_note","start_index":75,"tongjian_id":"94e85764-db0e-11ef-8d93-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"西河長史","official_note":"西河長史是西河郡的長史，負責輔佐郡守處理政務，在漢代地方行政體系中屬於中級官員。在上下文中，西河長史被命令每年率領騎兵和弛刑人員協助中郞將保護南單于，顯示其在邊疆防務中的輔助角色。","official_rank":"未知","source_snippet":"令西河長史歲將騎二千、弛刑五百人助中郞將衞護單于","start_index":68,"tongjian_id":"9933b561-1125-4ae6-a81c-5878597a263a"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代的高級武官，負責宮廷禁衛或軍事指揮，常參與邊疆防務。在上下文中，中郞將負責衞護南單于，體現其在邊疆安全中的核心軍事職責。","official_rank":"未知","source_snippet":"令西河長史歲將騎二千、弛刑五百人助中郞將衞護單于","start_index":78,"tongjian_id":"ada1cd14-0ab1-4f94-a09e-5c6a5fb58acb"}],"ExtRef_Children_people":[{"people_name":"骨都侯","people_name_jianti_auto":"骨都侯","people_xingming":"骨都侯","start_index":7,"tongjian_id":"94e9dde9-db0e-11ef-9d02-a0d3651f611f"},{"people_name":"北單于","people_name_jianti_auto":"北单于","people_xingming":"挛鞮蒲奴","start_index":22,"tongjian_id":"94e9ddea-db0e-11ef-966f-a0d3651f611f","wl_zhushi":"[挛鞮蒲奴]"},{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"挛鞮比","start_index":35,"tongjian_id":"94e9ddeb-db0e-11ef-b7a2-a0d3651f611f","wl_zhushi":"[挛鞮比]"},{"people_name":"段彬","people_name_jianti_auto":"段彬","people_xingming":"段彬","start_index":63,"tongjian_id":"94e9ddef-db0e-11ef-9bee-a0d3651f611f"},{"people_name":"王郁","people_name_jianti_auto":"王郁","people_xingming":"王郁","start_index":66,"tongjian_id":"94e9ddf0-db0e-11ef-887b-a0d3651f611f"},{"people_name":"南單于","people_name_jianti_auto":"南单于","start_index":111,"tongjian_id":"94ea0528-db0e-11ef-99f8-a0d3651f611f","wl_zhushi":"[挛鞮比]"},{"people_name":"北單于","people_name_jianti_auto":"北单于","start_index":164,"tongjian_id":"94ea0533-db0e-11ef-ae4a-a0d3651f611f","wl_zhushi":"[挛鞮蒲奴]"},{"people_name":"薁鞬日逐","people_name_jianti_auto":"薁鞬日逐","people_xingming":"挛鞮比","start_index":203,"tongjian_id":"94ea0536-db0e-11ef-bb25-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94e85762-db0e-11ef-ba86-a0d3651f611f","pinyin":"yù","source_anchor_text":"自擊亡虜薁鞬日逐耳","source_key":"baiyang_epub","start_index":203,"text":"薁","tongjian_id":"243b2fc5-61f3-5d8c-ad73-0e979dfaf84b"}],"ExtRef_Children_places":[{"place_name":"南匈奴","place_name_ji