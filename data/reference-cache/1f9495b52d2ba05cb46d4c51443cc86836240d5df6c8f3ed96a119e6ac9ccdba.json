ntent":"1秦衞鞅圍魏固陽，降之。","content_fanyi":"秦国卫鞅率兵围攻魏国固阳，迫使固阳投降。","content_jianti_auto":"1秦衞鞅围魏固阳，降之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":147,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c2b9d2a-db0e-11ef-8a05-a0d3651f611f","year_int":-351},"tongjian_id":"8c2b9d2a-db0e-11ef-8a05-a0d3651f611f"},"paragraph_order":1}],"page_size":10,"total_pages":1,"total_paragraphs":1},"place_name":"固陽","resolved_profile":{"entity_id":6289,"entry_list_str":"固陽","intro":"战国时期魏国北部边城，位于上郡北境，后属秦。汉代为五原郡稒阳县，是中原与匈奴交界的重要军事据点。","lat_max":42.0,"lat_min":41.0,"lon_max":110.5,"lon_min":109.5,"modern_location":"今内蒙古自治区包头市固阳县一带","show_map":true,"standard_name":"固阳","type_code":"settlement"}},"message":"success","success":true}