"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡的最高行政长官，负责治理郡内事务。在上下文中，叛乱后太守不敢到郡治办公，显示安全威胁，导致行政中心临时迁移。","official_rank":"郡级长官","source_snippet":"太守不敢之郡","start_index":13,"tongjian_id":"c295a348-bae4-41c4-aa8a-6319696dc30c"},{"confidence":0.9,"official_category":"地方行政","official_name":"越巂太守","official_note":"越巂太守是汉代越巂郡的行政长官，负责管理该郡事务。在上下文中，汉主任命张嶷为越巂太守，以平定叛乱、安抚蛮夷，恢复郡内秩序，最终使郡界悉平并返回旧治。","official_rank":"郡级长官","source_snippet":"漢主以巴西張嶷爲越巂太守","start_index":35,"tongjian_id":"9c89dc26-f40c-4193-859b-622dd711d33d"}],"ExtRef_Children_people":[{"link_death_year":254,"link_td_description":"张嶷，字伯岐，益州巴郡南充国（今四川省南充市）人，三国时期蜀汉将领。","link_td_id":"Q10004275","link_td_number_id":326459,"people_name":"張嶷","people_name_jianti_auto":"张嶷","people_xingming":"张嶷","start_index":40,"tongjian_id":"9b3b1fbc-db0e-11ef-8cc7-a0d3651f611f"},{"link_death_year":254,"link_td_description":"张嶷，字伯岐，益州巴郡南充国（今四川省南充市）人，三国时期蜀汉将领。","link_td_id":"Q10004275","link_td_number_id":326459,"people_name":"嶷","people_name_jianti_auto":"嶷","people_xingming":"张嶷","start_index":48,"tongjian_id":"9b3b1fbd-db0e-11ef-b559-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9b3b1fab-db0e-11ef-8ccf-a0d3651f611f","pinyin":"yí","source_anchor_text":"以巴西張嶷為越巂太","source_key":"baiyang_epub","start_index":41,"text":"嶷","tongjian_id":"45573a29-6e92-5b33-af93-c1f6903788a3"}],"ExtRef_Children_places":[{"place_name":"越巂","place_name_jianti_auto":"越巂","resolved_place_entity_id":1139,"start_index":1,"tongjian_id":"9b3b1fb9-db0e-11ef-a78e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":11,"start_index":7,"tongjian_id":"9b3b1fba-db0e-11ef-8ed8-a0d3651f611f"},{"place_name":"安定縣","place_name_jianti_auto":"安定县","resolved_place_entity_id":304,"start_index":24,"tongjian_id":"9b3b1fbb-db0e-11ef-b4d5-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":11,"start_index":35,"tongjian_id":"9b3b1fbe-db0e-11ef-8a6