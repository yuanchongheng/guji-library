":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夷，殺也；夷宗者，殺其同宗也。","note_content_jianti_auto":"夷，杀也；夷宗者，杀其同宗也。","note_type":"hu_note","start_index":67,"tongjian_id":"8c04673c-db0e-11ef-af59-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"令尹","official_note":"令尹是楚国的最高行政长官，相当于宰相，负责国家政务。在上下文中，肃王即位后命令令尹诛杀作乱的贵戚大臣，体现了令尹在楚国政治中的核心执法和行政职能。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"使令尹盡誅爲亂者","start_index":48,"tongjian_id":"15bb7c0c-6acd-4db3-917a-cb4ab1c03760"}],"ExtRef_Children_people":[{"link_death_year":-381,"link_td_description":"楚悼王，出土楚国文献作悼折王，原名熊疑，楚声王之子。","link_td_id":"Q10001878","link_td_number_id":335210,"people_name":"楚悼王","people_name_jianti_auto":"楚悼王","people_xingming":"芈疑","start_index":1,"tongjian_id":"8c04673d-db0e-11ef-96f8-a0d3651f611f","wl_zhushi":"[芈疑]"},{"link_birth_year":-440,"link_death_year":-381,"link_td_description":"吴起，中国春秋末期战国初期军事家、政治家、改革家，兵家代表人物。卫国左氏（今山东省定陶县，一说山东省曹县东北）人。","link_td_id":"Q10000069","link_td_number_id":1134,"people_name":"吳起","people_name_jianti_auto":"吴起","people_xingming":"吴起","start_index":14,"tongjian_id":"8c04673e-db0e-11ef-81b7-a0d3651f611f"},{"link_birth_year":-440,"link_death_year":-381,"link_td_description":"吴起，中国春秋末期战国初期军事家、政治家、改革家，兵家代表人物。卫国左氏（今山东省定陶县，一说山东省曹县东北）人。","link_td_id":"Q10000069","link_td_number_id":1134,"people_name":"起","people_name_jianti_auto":"起","people_xingming":"吴起","start_index":17,"tongjian_id":"8c04673f-db0e-11ef-8929-a0d3651f611f"},{"link_birth_year":-440,"link_death_year":-381,"link_td_description":"吴起，中国春秋末期战国初期军事家、政治家、改革家，兵家代表人物。卫国左氏（今山东省定陶县，一说山东省曹县东北）人。","link_td_id":"Q10000069","link_td_number_id":1134,"people_name":"起","people_name_jianti_auto":"起","people_xingming":"吴起","start_index":27,"tongjian_id":"8c046740-db0e-11ef-bcd1-a0d3651f611f"},{"link_birth_year":-440,"link_death_year":-381,"link_td_description":"吴起，中国春秋末期战国初期军事家、政治家、改革家，兵家代表人物。卫国左氏（今山东省定陶县，一说山东省曹县东北）人。","link_td_id":"Q10000069","link_td_number_id":1134,"people_name":"起","people_name_jianti_auto":"起","people_xingming":"吴起","start_index":33,"tongjian_id":"8c046741-db0e-11ef-861f-a0d3651f611f"},{"link_death_year":-370,"link_td_description":"楚肃王，原名熊臧，楚悼王子。","link_td_id":"Q10000651","link_td_number_id":335212,"people_name":"肅王","people_name_jianti_auto":"肃王","people_xingming":"芈臧","start_index":43,"tongjian_id":"8c046742-db0e-11ef-ac0a-a0d3651f611f","wl_zhushi":"[芈臧]"},{"link_birth_year":-440,"link_death_year":-381,"link_td_description":"吴起，中国春秋末期战国初期军事家、政治家、改革家，兵家代表人物。卫国左氏（今山东省定陶县，一说山东省曹县东北）人。","link_td_id":"Q10000069","link_td_number_id":1134,"people_name":"起","people_name_jianti_auto":"起","people_xingming":"吴起","start_index":58,"tongjian_id":"8c046743-db0e-11ef-81cd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"1楚悼王薨。貴戚大臣作亂，攻吳起；起走之王尸而伏之。擊起之徒因射刺起，並中王尸。旣葬，肅王卽位，使令尹盡誅爲亂者；坐起夷宗者七十餘家。","content_fanyi":"楚悼王去世。楚国贵戚大臣们发动叛乱，围攻吴起；吴起逃到楚悼王尸体处，伏在尸体上面。攻击吴起的人于是用箭射刺吴起，连楚悼王的尸体也被射中。丧葬完毕后，楚肃王即位，命令令尹将作乱的人全部诛杀；因攻打吴起之事受牵连而被灭族的有七十余家。","content_jianti_auto":"1楚悼王薨。贵戚大臣作乱，攻吴起；起走之王尸而伏之。击起之徒因射刺起，并中王尸。既葬，肃王即位，使令尹尽诛为乱者；坐起夷宗者七十余家。","dtjl_paragraph_links":[],"dtjl_references":[],"id":73,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c046735-db0e-11ef-a257-a0d3651f611f"}],"reign_name":"二十一年","reign_name_jianti_auto":"二十一年","start_index":16,"tongjian_id":"8c046733-db0e-11ef-aaea-a0d3651f611f","year_anno":"（庚子、前三八一）","year_int":-381},"message":"success","success":true}