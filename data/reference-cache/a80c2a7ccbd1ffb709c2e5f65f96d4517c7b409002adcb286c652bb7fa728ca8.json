als":[],"ExtRef_Children_people":[{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":1,"tongjian_id":"8d6bcf2c-db0e-11ef-8046-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隴西","place_name_jianti_auto":"陇西","place_note":"甘肅臨洮","resolved_place_entity_id":342,"start_index":4,"tongjian_id":"8d6bcf2d-db0e-11ef-af47-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","place_note":"甘肅西峰","resolved_place_entity_id":457,"start_index":7,"tongjian_id":"8d6bcf2e-db0e-11ef-a609-a0d3651f611f"},{"place_name":"雞頭山","place_name_jianti_auto":"鸡头山","place_note":"甘肃泾源北","resolved_place_entity_id":4143,"start_index":11,"tongjian_id":"8d6bcf2f-db0e-11ef-8403-a0d3651f611f"},{"place_name":"回中","place_name_jianti_auto":"回中","place_note":"陕西陇县西北","resolved_place_entity_id":2241,"start_index":16,"tongjian_id":"8d6bcf30-db0e-11ef-a371-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、凤翔府（卷五十五）","excerpts":[{"context_after":"汉文帝十四年，匈奴入萧关，使奇兵烧回中宫。武帝元封四年，...","context_before":"○回中宫[州西北百二十里，秦建。","source_end_index":31,"source_paragraph_tongjian_id":"f4231fee-505c-5ea6-95f3-255923db092f","source_start_index":16,"source_text":"始皇二十七年，巡陇西，过回中。"}],"path":"陕西方舆纪要/三、凤翔府（卷五十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、平凉府（卷五十八）","excerpts":[{"context_after":"后汉建武七年，隗嚣攻来歙于略阳，使其将王孟塞鸡头道。晋咸...","context_before":"...笄头之山。郦道元曰：幵头山，大陇之异名也，或谓之鸡头山。","source_end_index":86,"source_paragraph_tongjian_id":"7de342cb-9c68-5b3b-98b8-deff64395249","source_start_index":68,"source_text":"秦始皇二十七年，巡陇西北地，至鸡头。"}],"path":"陕西方舆纪要/七、平凉府（卷五十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1始皇巡隴西、北地，至雞頭山，過回中焉。","content_fanyi":"秦始皇巡行陇西、北地，到达鸡头山后返回，途中经过回中宫。","content_jianti_auto":"1始皇巡陇西、北地，至鸡头山，过回中焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":558,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d6bcf00-db0e-11ef-a229-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"極廟","place_name_jianti_auto":"极庙","start_index":23,"tongjian_id":"8d6bcf33-db0e-11ef-996b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"作宮已成而更名也。索隱曰：言爲宮廟象天極，故曰極廟；天官書：中宮曰天極，是也。","note_content_jianti_auto":"作宫已成而更名也。索隐曰：言为宫庙象天极，故曰极庙；天官书：中宫曰天极，是也。","note_type":"hu_note","start_index":15,"tongjian_id":"8d6bcf32-db0e-11ef-a588-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"始皇","people_name_jianti_auto":"始皇","start_index":31,"tongjian_id":"8d6bcf37-db0e-11ef-9b6a-a0d3651f611f"},{"people_name":"漢武帝","people_name_jianti_auto":"汉武帝","start_index":53,"tongjian_id":"8d6bcf38-db0e-11ef-b5cd-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":130,"tongjian_id":"8d6bcf39-db0e-11ef-8048-a0d3651f611f"},{"people_name":"賈山","people_name_jianti_auto":"贾山","start_index":147,"tongjian_id":"8d6bcf3a-db0e-11ef-90a1-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":209,"tongjian_id":"8d6bcf3b-db0e-11ef-8804-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":229,"tongjian_id":"8d6bcf3c-db0e-11ef-b418-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉宮","place_name_jianti_auto":"甘泉宫","start_index":6,"tongjian_id":"8d6bcf3d-db0e-11ef-9f8a-a0d3651f611f