_death_year":820,"link_td_description":"唐宪宗李纯，原名李淳，唐朝皇帝，805年－820年在位。唐宪宗通过宦官俱文珍等人的协助，迫使父亲唐顺宗让位予自己，即“永贞内禅”。即位后，曾一度讨平不服朝廷的藩镇，短暂终结藩镇割据，重新统一中国，史称“元和中兴”。","link_td_id":"Q10000089","link_td_number_id":53576,"people_name":"憲宗","people_name_jianti_auto":"宪宗","people_xingming":"李纯","start_index":17,"tongjian_id":"c50ad4ff-db0e-11ef-b5d2-a0d3651f611f","wl_zhushi":"[李漼（李温）本年三十三岁]"},{"people_name":"王皞","people_name_jianti_auto":"王皞","people_xingming":"王皞","start_index":22,"tongjian_id":"c50ad500-db0e-11ef-b440-a0d3651f611f","wl_zhushi":"[李漼（李温）本年三十三岁]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c50ad4fa-db0e-11ef-b3b0-a0d3651f611f","pinyin":"hào","source_anchor_text":"宗室時王皞復為禮院","source_key":"baiyang_epub","start_index":23,"text":"皞","tongjian_id":"bd2e6c34-eab3-5cbd-a560-cb974d467c5b"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，丁巳，始以懿安皇后配饗憲宗室。時王皞復爲禮院檢討官，更申前議，朝廷竟從之。","content_fanyi":"春季，正月丁巳，才将懿安皇后的神位配飨于宪宗庙室。当时王皞再次担任礼院检讨官，重新申述此前将懿安皇后配飨宪宗的建议，朝廷最终采纳了他的意见。","content_jianti_auto":"1春，正月，丁巳，始以懿安皇后配飨宪宗室。时王皞复为礼院检讨官，更申前议，朝廷竟从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25610,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c50ad4fa-db0e-11ef-b3b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"c50ad503-db0e-11ef-8411-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐時諸道歲進閹兒，號曰私白。","note_content_jianti_auto":"唐时诸道岁进阉儿，号曰私白。","note_type":"hu_note","start_index":8,"tongjian_id":"c50ad502-db0e-11ef-b068-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"福建觀察使","official_note":"福建觀察使是唐代地方行政官职，负责福建地区的监察和行政事务，此处指杜宣猷担任此职，负责管理福建地区。","official_rank":"未知","source_snippet":"福建觀察使杜宣猷","start_index":18,"tongjian_id":"4a0f43a9-2bb9-402b-9595-a60509cd3c4f"},{"confidence":0.9,"official_category":"地方行政","official_name":"宣歙觀察使","official_note":"宣歙觀察使是唐代地方行政官职，负责宣州和歙州地区的监察和行政事务，此处表示杜宣猷被任命为此职，反映了官职调动。","official_rank":"未知","source_snippet":"以宣猷爲宣歙觀察使","start_index":45,"tongjian_id":"22a5bc03-813c-4889-987d-e9312b1d0d6b"}],"ExtRef_Children_people":[{"people_name":"杜宣猷","people_name_jianti_auto":"杜宣猷","people_xingming":"杜宣猷","start_index":25,"tongjian_id":"c50ad504-db0e-11ef-b373-a0d3651f611f"},{"people_name":"宣猷","people_name_jianti_auto":"宣猷","people_xingming":"杜宣猷","start_index":48,"tongjian_id":"c50ad505-db0e-11ef-87bb-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c50ad501-db0e-11ef-80ab-a0d3651f611f","pinyin":"yóu","source_anchor_text":"察使杜宣猷每寒食遣","source_key":"baiyang_epub","start_index":27,"text":"猷","tongjian_id":"2a583017-ebe2-510a-bb48-9756bc9d9f30"}],"ExtRef_Children_places":[{"place_name":"閩中","place_name_jianti_auto":"闽中","resolved_place_entity_id":2205,"start_index":8,"tongjian_id":"c50ad506-db0e-11ef-8ddc-a0d3651f611f"},{"place_name":"閩","place_name_jianti_auto":"闽","resolved_place_entity_id":300,"start_index":17,"tongjian_id":"c50ad507-db0e-11ef-83a7-a0d3651f611f"},{"place_name":"福建","place_name_jianti_auto":"福建","place_note":"首府设福州【福建省福州市】","resolved_place_entity_id":954,"start_index":20,"tongjian_id":"c50ad508-db0e-11ef-854c-a0d3651f611f"},{"place_name":"宣歙","place_name_jianti_auto":"宣歙","resolved_place_entity_id":985,"start_index":51,"tongjian_id":"c50ad509-db0e-11ef-9f54-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"2諸道進私白者，閩中爲多，故宦官多閩人。福建觀察使杜宣猷每寒食遣吏分祭其先壠，宦官德之，庚申，以宣猷爲宣歙觀察使，時人謂之「敕使墓戶」。","content_fanyi":"各道进献被阉割的男童，以闽中最多，所以宦官大多是闽人。福建观察使杜宣猷每年寒食都派属吏分别祭扫宦官祖先的坟墓，宦官们因此感激他，二月初九日庚申，皇上将杜宣猷调任为宣歙观察使，当时人称他为“敕使墓户”。","content_jianti_auto":"2诸道进私白者，闽中为多，故宦官多闽人。福建观察使杜宣猷每寒食遣吏分祭其先垅，宦官德之，庚申，以宣猷为宣歙观察使，时人谓之「敕使墓户」。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25611,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c50ad501-db0e-11ef-80ab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"中書侍郞","official_note":"中書侍郞是中書省的副長官，負責協助中書令處理政務，在唐代為宰相之一。此處蕭寘擔任此職，表明其為朝廷高官，參與決策。","official_rank":"正四品上","source_snippet":"中書侍郞、同平章事蕭寘薨","start_index":3,"tongjian_id":"c40bf2f0-9b2a-42a3-9150-a03c288c2237"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代的宰相職銜，意為參與平章政事，通常授予其他官職者以行使宰相權力。此處蕭寘以此職輔佐皇帝處理國家大事。","official_rank":"宰相級別","source_snippet":"中書侍郞、同平章事蕭寘薨","start_index":8,"tongjian_id":"e2ecc931-c2f4-4f58-8984-a62ec4426709"}],"ExtRef_Children_people":[{"people_name":"蕭寘","people_name_jianti_auto":"萧寘","people_xingming":"萧寘","start_index":13,"tongjian_id":"c50ad50b-db0e-11ef-8e66-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3三月，中書侍郞、同平章事蕭寘薨。","content_fanyi":"三月，中书侍郎、同平章事萧寘去世。","content_jianti_auto":"3三月，中书侍郞、同平章事萧寘薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25612,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"c50ad50a-db0e-11ef-8968-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{