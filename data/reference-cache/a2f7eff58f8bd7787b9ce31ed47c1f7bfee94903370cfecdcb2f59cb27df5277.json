ef-8d82-a0d3651f611f"},{"place_name":"㟭山","place_name_jianti_auto":"㟭山","start_index":30,"tongjian_id":"9b0cc95f-db0e-11ef-8ada-a0d3651f611f"},{"place_name":"都安縣","place_name_jianti_auto":"都安县","start_index":36,"tongjian_id":"9b0cc960-db0e-11ef-a693-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":46,"tongjian_id":"9b0cc961-db0e-11ef-baab-a0d3651f611f"},{"place_name":"都安縣","place_name_jianti_auto":"都安县","start_index":55,"tongjian_id":"9b0cc962-db0e-11ef-8ce6-a0d3651f611f"},{"place_name":"桃關","place_name_jianti_auto":"桃关","start_index":59,"tongjian_id":"9b0cc963-db0e-11ef-8de3-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":62,"tongjian_id":"9b0cc964-db0e-11ef-b8f1-a0d3651f611f"},{"place_name":"湔塴","place_name_jianti_auto":"湔塴","start_index":74,"tongjian_id":"9b0cc965-db0e-11ef-b28e-a0d3651f611f"},{"place_name":"湔堰","place_name_jianti_auto":"湔堰","start_index":79,"tongjian_id":"9b0cc966-db0e-11ef-bfc1-a0d3651f611f"},{"place_name":"觀阪","place_name_jianti_auto":"观阪","start_index":82,"tongjian_id":"9b0cc967-db0e-11ef-8f86-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":116,"tongjian_id":"9b0cc968-db0e-11ef-a6dd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"湔，卽漢之湔氐道，屬蜀郡。汶水，卽㟭江水也。㟭江出氐道西徼外㟭山，東流歷都安縣。沈約曰：縣，蜀所立。水經註曰：都安縣有桃關，蜀守李冰作大堰于此，謂之湔塴，亦曰湔堰；觀阪在其上。裴松之曰：湔，音翦。晉書音義：汶，讀與㟭同。諸葛亮旣沒，漢主游觀，莫之敢止。","note_content_jianti_auto":"湔，即汉之湔氐道，属蜀郡。汶水，即㟭江水也。㟭江出氐道西徼外㟭山，东流历都安县。沈约曰：县，蜀所立。水经注曰：都安县有桃关，蜀守李冰作大堰于此，谓之湔塴，亦曰湔堰；观阪在其上。裴松之曰：湔，音翦。晋书音义：汶，读与㟭同。诸葛亮既没，汉主游观，莫之敢止。","note_type":"hu_note","start_index":21,"tongjian_id":"9b0cc952-db0e-11ef-8e11-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汶水","place_name_jianti_auto":"汶水","resolved_place_entity_id":3876,"start_index":16,"tongjian_id":"9b0cc96f-db0e-11ef-a13c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"晋泰始八年，皇甫晏为益州刺史，讨汶山白马叛胡，至观坂，为...","context_before":"观坂[在县西。","source_end_index":30,"source_paragraph_tongjian_id":"37cc7880-e256-5643-82a9-837712a7e262","source_start_index":7,"source_text":"蜀汉建兴十四年，幸湔登观坂，观汶水之流，是也。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3夏，四月，漢主至湔，登觀阪，觀汶水之流，旬日而還。","content_fanyi":"夏季四月，蜀汉后主刘禅到达湔氐道，登上观阪，观看汶水的水流，停留十日后返回。","content_jianti_auto":"3夏，四月，汉主至湔，登观阪，观汶水之流，旬日而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6207,"number":3,"path":"资治通鉴 : 卷第七十三 (魏紀五) / 烈祖明皇帝中之下 / 四年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"9b0cc951-db0e-11ef-9b56-a0d3651f611f","year_int":236},"tongjian_id":"9b0cc951-db0e-11ef-9b56-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"汶水","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"汴水","place_name_jianti_auto":"汴水","start_index":5,"tongjian_id":"a26f2318-db0e-11ef-a71c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"兵亂之餘，汴水塡淤，未嘗有人浚治，故淺。汴，皮變翻。","note_content_jianti_auto":"兵乱之余，汴水塡淤，未尝有人浚治，故浅。汴，皮变翻。","note_type":"hu_note","start_index":24,"tongjian_id":"a26f2317-db0e-11ef-8426-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":1,"chapter_name":"本朝篇第一","chenzhu_chapter":"本朝谓父母国。人莫不有父母国，观其对本朝之称呼，即知其对父母国之厚薄。胡身之今本《通鉴注》，撰于宋亡以後，故《四库提要》称之为元人。然观其对宋朝之称呼，实未尝一日忘宋也。大抵全书自四十卷至二百三十二卷之间，恒称宋为“我朝”或“我宋”，而前後则率称“宋”或“宋朝”，吾颇疑为元末镂板时所改，其作内词者，身之原文也。试顺全书卷次，条举其例如下：","chenzhu_index_in_chapter":8,"chenzhu_text":"全注称“我宋”者始见于此。以前文例之，此“我”字亦刊削未尽者。","created_at":"2025-12-31 08:50:44","seq_in_chapter":29,"tongjian_id":"CH01-CZ008"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"金鄕縣","place_name_jianti_auto":"金鄕县","start_index":0,"tongjian_id":"a27123be-db0e-11ef-a4e5-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":4,"tongjian_id":"a27123bf-db0e-11ef-9ed4-a0d3651f611f"},{"place_name":"山陽郡","place_name_jianti_auto":"山阳郡","start_index":7,"tongjian_id":"a27123c0-db0e-11ef-88db-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":11,"tongjian_id":"a27123c1-db0e-11ef-ac0d-a0d3651f611f"},{"place_name":"高平郡","place_name_jianti_auto":"高平郡","start_index":13,"tongjian_id":"a27123c2-db0e-11ef-a02d-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":17,"tongjian_id":"a27123c3-db0e-11ef-be51-a0d3651f611f"},{"place_name":"濟陰郡","place_name_jianti_auto":"济阴郡","start_index":19,"tongjian_id":"a27123c4-db0e-11ef-a747-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":23,"tongjian_id":"a27123c5-db0e-11ef-af26-a0d3651f611f"},{"place_name":"兗州","place_name_jianti_auto":"兖州","start_index":25,"tongjian_id":"a27123c6-db0e-11ef-839d-a0d3651f611f"},{"place_name":"宋","place_name_jianti_auto":"宋","start_index":29,"tongjian_id":"a27123c7-db0e-11ef-a2e1-a0d3651f611f"},{"place_name":"濟州","place_name_jianti_auto":"济州","start_index":31,"tongjian_id":"a27123c8-db0e-11ef-aa7d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"金鄕縣，後漢屬山陽郡，晉屬高平郡，隋屬濟陰郡，唐屬兗州，我宋屬濟州，縣在州東南九十里。","note_content_jianti_auto":"金鄕县，后汉属山阳郡，晋属高平郡，隋属济阴郡，唐属兖州，我宋属济州，县在州东南九十里。","note_type":"hu_note","start_index":46,"tongjian_id":"a26f2319-db0e-11ef-b5c3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班固","people_name_jianti_auto":"班固","start_index":0,"tongjian_id":"a2713768-db0e-11ef-a470-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":65,"tongjian_id":"a2713769-db0e-11ef-8fcf-a0d3651f611f"},{"people_name":"王莽","people_name_jianti_auto":"王莽","start_index":73,"tongjian_id":"a271376a-db0e-11ef-8361-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汶水","place_name_jianti_auto":"汶水","start_index":6,"tongjian_id":"a271376b-db0e-11ef-8e83-a0d3651f611f"},{"place_name":"泰山","place_name_jianti_auto":"泰山","start_index":9,"tongjian_id":"a271376c-db0e-11ef-9186-a0d3651f611f"},{"place_name":"萊蕪縣","place_name_jianti_auto":"莱芜县","start_index":11,"tongjian_id":"a271376d-db0e-11ef-bc7d-a0d3651f611f"},{"place_name":"濟","place_name_jianti_auto":"济","start_index":18,"tongjian_id":"a271376e-db0e-11ef-8328-a0d3651f611f"},{"place_name":"濟水","place_name_jianti_auto":"济水","start_index":24,"tongjian_id":"a271376f-db0e-11ef-809e-a0d3651f611f"},{"place_name":"鉅野","place_name_jianti_auto":"巨野","start_index":29,"tongjian_id":"a2713770-db0e-11ef-b923-a0d3651f611f"},{"place_name":"洪水","place_name_jianti_auto":"洪水","start_index":40,"tongjian_id":"a2713771-db0e-11ef-8a7a-a0d3651f611f"},{"place_name":"洪水","place_name_jianti_auto":"洪水","start_index":43,"tongjian_id":"a2713772-db0e-11ef-a82b-a0d3651f611f"},{"place_name":"鉅野","place_name_jianti_auto":"巨野","start_index":47,"tongjian_id":"a2713773-db0e-11ef-ae73-a0d3651f611f"},{"place_name":"薛訓渚","place_name_jianti_auto":"薛训渚","start_index":49,"tongjian_id":"a2713774-db0e-11ef-83e0-a0d3651f611f"},{"place_name":"桓公瀆","place_name_jianti_auto":"桓公渎","start_index":55,"tongjian_id":"a2713775-db0e-11ef-89df-a0d3651f611f"},{"place_name":"濟","place_name_jianti_auto":"济","start_index":59,"tongjian_id":"a2713776-db0e-11ef-8e3a-a0d3651f611f"},{"place_name":"濟水","place_name_jianti_auto":"济水","start_index":69,"tongjian_id":"a2713777-db0e-11ef-a492-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":81,"tongjian_id":"a2713778-db0e-11ef-b66d-a0d3651f611f"},{"place_name":"東平","place_name_jianti_auto":"东平","start_index":85,"tongjian_id":"a2713779-db0e-11ef-9165-a0d3651f611f"},{"place_name":"濟南","place_name_jianti_auto":"济南","start_index":88,"tongjian_id":"a271377a-db0e-11ef-a851-a0d3651f611f"},{"place_name":"淄川","place_name_jianti_auto":"淄川","start_index":91,"tongjian_id":"a271377b-db0e-11ef-84fa-a0d3651f611f"},{"place_name":"北海","place_name_jianti_auto":"北海","start_index":94,"tongjian_id":"a271377c-db0e-11ef-af6d-a0d3651f611f"},{"place_name":"清河","place_name_jianti_auto":"清河","start_index":106,"tongjian_id":"a271377d-db0e-11ef-9940-a0d3651f611f"},{"place_name":"菏澤","place_name_jianti_auto":"菏泽","start_index":110,"tongjian_id":"a271377e-db0e-11ef-811d-a0d3651f611f"},{"place_name":"汶水","place_name_jianti_auto":"汶水","start_index":113,"tongjian_id":"a271377f-db0e-11ef-880b-a0d3651f611f"},{"place_name":"濟河","place_name_jianti_auto":"济河","start_index":120,"tongjian_id":"a2713780-db0e-11ef-92b9-a0d3651f611f"},{"place_name":"濟水","place_name_jianti_auto":"济水","start_index":129,"tongjian_id":"a2713781-db0e-11ef-b036-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班固地理志，汶水出泰山萊蕪縣西南，入濟。水經註：濟水東北入鉅野，其故瀆又東北右合洪水；洪水上承鉅野薛訓渚，謂之桓公瀆，濟自是北注。杜佑曰：濟水，因王莽末渠涸不復截河過，今東平、濟南、淄川、北海界中有水流入海，謂之清河，實菏澤、汶水合流，亦曰濟河，蓋因舊名，非濟水也。汶，音問。","note_content_jianti_auto":"班固地理志，汶水出泰山莱芜县西南，入济。水经注：济水东北入巨野，其故渎又东北右合洪水；洪水上承巨野薛训渚，谓之桓公渎，济自是北注。杜佑曰：济水，因王莽末渠涸不复截河过，今东平、济南、淄川、北海界中有水流入海，谓之清河，实菏泽、汶水合流，亦曰济河，盖因旧名，非济水也。汶，音问。","note_type":"hu_note","start_index":77,"tongjian_id":"a27123c9-db0e-11ef-ae79-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛寶","people_name_jianti_auto":"毛宝","start_index":0,"tongjian_id":"a2713785-db0e-11ef-9092-a0d3651f611f"},{"people_name":"蘇峻","people_name_jianti_auto":"苏峻","start_index":5,"tongjian_id":"a2713786-db0e-11ef-9196-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"毛寶預有平蘇峻之功。註又見前。","note_content_jianti_auto":"毛宝预有平苏峻之功。注又见前。","note_type":"hu_note","start_index":85,"tongjian_id":"a2713784-db0e-11ef-bcf7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"清水","place_name_jianti_auto":"清水","start_index":1,"tongjian_id":"a2715246-db0e-11ef-8e3f-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":4,"tongjian_id":"a2715247-db0e-11ef-824a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自清水入河，皆是泝流，又道里回遠，故言難以通運。","note_content_jianti_auto":"自清水入河，皆是溯流，又道里回远，故言难以通运。","note_type":"hu_note","start_index":116,"tongjian_id":"a2713788-db0e-11ef-bc54-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賖，遠也。","note_content_jianti_auto":"賖，远也。","note_type":"hu_note","start_index":272,"tongjian_id":"a271524c-db0e-11ef-8271-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"愆，差爽也。乏，匱竭也。此言糧運。","note_content_jianti_auto":"愆，差爽也。乏，匮竭也。此言粮运。","note_type":"hu_note","start_index":300,"tongjian_id":"a271524e-db0e-11ef-b7e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"郗超","people_name_jianti_auto":"郗超","start_index":0,"tongjian_id":"a2715252-db0e-11ef-a1c4-a0d3651f611f"},{"people_name":"桓溫","people_name_jianti_auto":"桓温","start_index":14,"tongjian_id":"a2715253-db0e-11ef-a881-a0d3651f611f"},{"people_name":"溫","people_name_jianti_auto":"温","start_index":41,"tongjian_id":"a2715254-db0e-11ef-b260-a0d3651f611f"},{"people_name":"溫","people_name_jianti_auto":"温","start_index":62,"tongjian_id":"a2715255-db0e-11ef-86d9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄴城","place_name_jianti_auto":"邺城","start_index":31,"tongjian_id":"a2715256-db0e-11ef-bff2-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":48,"tongjian_id":"a2715257-db0e-11ef-9d00-a0d3651f611f"},{"place_name":"濟","place_name_jianti_auto":"济","start_index":50,"tongjian_id":"a2715258-db0e-11ef-ad7c-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":57,"tongjian_id":"a2715259-db0e-11ef-8427-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郗超之謀略，豈常人所及哉，宜桓溫重之也。重之而不從其計者，直趨鄴城，決勝負於一戰，溫所不敢；頓兵河、濟以待來年，使燕得爲備，溫亦不爲也。","note_content_jianti_auto":"郗超之谋略，岂常人所及哉，宜桓温重之也。重之而不从其计者，直趋邺城，决胜负于一战，温所不敢；顿兵河、济以待来年，使燕得为备，温亦不为也。","note_type":"hu_note","start_index":352,"tongjian_id":"a2715251-db0e-11ef-8d9b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汶水","place_name_jianti_auto":"汶水","resolved_place_entity_id":3875,"start_index":70,"tongjian_id":"a2715265-db0e-11ef-9241-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"[刘氏攽曰：时清水入河，亦即在碻磝、东阿间，非《禹贡》浮...","context_before":"...入于河，不复绝流而南。其余流自东平以东北者，皆谓之清水。","source_end_index":626,"source_paragraph_tongjian_id":"3e31c231-5b21-5f8d-a97e-2c7fe823b090","source_start_index":539,"source_text":"晋太和四年，桓温自兖州伐燕，至金乡，凿巨野三百里，导汶水会于清水，温引舟师自清入河。郗超曰：清水入河，难以通运，若寇不战，运道又绝，因敌为资，复无所得，此危道也。温不听，败还"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"今堙。○获麟渡，《志》云：在县东南漕河旁，地名大长沟]。","context_before":"桓公沟[在县东门外。旧《志》：沟在济宁州西四十里萌山下。","source_end_index":64,"source_paragraph_tongjian_id":"a5a7bdab-dd1e-5246-8ae1-4b19869d14b8","source_start_index":28,"source_text":"晋太和中，桓温伐燕，遣冠军将军毛虎生凿巨野通济水，道出此，南入鱼台县界。"},{"context_after":"又义熙十四年，刘裕伐秦，遣王仲德督前锋，开巨野入河，进据...","context_before":"...渔于巨野泽中，为群盗。汉元光中，河决瓠子，东南注于巨野。","source_end_index":161,"source_paragraph_tongjian_id":"d04836ae-a846-52f7-bcf9-666a77a51ee7","source_start_index":121,"source_text":"晋太和四年，桓温伐燕，至金乡，遣毛虎生凿巨野三百里，引汶水合清水，引舟自济入河。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"后魏曰武阳县。隋因之。唐曰朝城。五代梁开平五年，晋将周德...","context_before":"...是也。升平二年，泰山太守诸葛攸攻燕东郡，入武阳，寻败还。","source_end_index":176,"source_paragraph_tongjian_id":"ba91fc78-2d5b-50d3-ad4c-acb8c7cb0150","source_start_index":152,"source_text":"太和四年，桓温伐燕，引舟师自清入河，军于东武阳。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷四十六）","excerpts":[{"context_after":"刘裕伐秦，浚之，始有湍流东注。而岸善崩溃，裕更于北十里疏...","context_before":"...涧中东流而出，济水至此乃绝。惟汴渠首受旃然水，谓之鸿渠。","source_end_index":1007,"source_paragraph_tongjian_id":"8cf5a83b-3950-57a7-9660-45588893ba38","source_start_index":947,"source_text":"桓温将通之而不果[晋太和中，桓温自兖州伐燕。郗超曰：道远，汴水又浅，恐漕运难通。盖兵乱之余，汴水填淤，未经浚治而浅也]。"}],"path":"河南方舆纪要/〇、封域山川险要（卷四十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3大司馬溫自兗州伐燕。郗超曰：「道遠，汴水又淺，恐漕運難通。」溫不從。六月，辛丑，溫至金鄕，天旱，水道絕，溫使冠軍將軍毛虎生鑿鉅野三百里，引汶水會于清水。虎生，寶之子也。溫引舟師自清水入河，舳艫數百里。郗超曰：「清水入河，難以通運。若寇不戰，運道又絕，因敵爲資，復無所得，此危道也。不若盡舉見衆直趨鄴城，彼畏公威名，必望風逃潰，北歸遼、碣。若能出戰，則事可立決。若欲城鄴而守之，則當此盛夏，難爲功力，百姓布野，盡爲官有，易水以南必交臂請命矣。但恐明公以此計輕銳，勝負難必，欲務持重，則若頓兵河、濟，控引漕運，俟資儲充備，至來夏乃進兵；雖如賖遲，然期於成功而已。捨此二策而連軍北上，進不速決，退必愆乏。賊因此勢以日月相引，漸及秋冬，水更澀滯。且北土早寒，三軍裘褐者少，恐於時所憂，非獨無食而已。」溫又不從。","content_fanyi":"大司马桓温从兖州出兵讨伐前燕。郗超说：“路途遥远，汴水又浅，恐怕漕运难以畅通。”桓温没有听从。六月辛丑日，桓温到达金乡，因天旱，水道断绝，桓温命冠军将军毛虎生开凿钜野三百里水道，引汶水汇入清水。毛虎生是毛宝的儿子。桓温率领水军从清水进入黄河，船只首尾相连达数百里。郗超说：“从清水进入黄河，难以保障粮运畅通。如果敌人不出战，运输通道又被切断，想借敌人的物资来补给，也不会有什么收获，这是危险的做法。不如尽率现有全部人马直扑邺城，他们畏惧您的声威，必定望风溃逃，向北退回辽东、碣石一带。如果他们能出城迎战，那么大事可以立即决出胜负。如果敌人想据守邺城，那么当下正是盛夏，难以大兴工役，田野间布满百姓，都将归入官府所有，易水以南的人必定会拱手听命。只是担心明公认为这个计策轻锐，胜负难以保证，想要力求持重，那就不如驻军于黄河、济水一带，控制漕运，等待物资储备充足，到明年夏天再进兵；虽然显得迟缓，但目的只是期望成功而已。舍弃这两种策略而让大军连续北上，进攻不能迅速决出胜负，后退必定会因失误而物资匮乏。敌人借此形势拖延时日，渐渐到了秋冬，水路会更加阻塞不畅。况且北方寒冷来得早，三军之中有皮裘粗衣御寒衣物的人很少，恐怕到那时所担忧的，不只是没有粮食而已。”桓温仍然没有听从。","content_jianti_auto":"3大司马温自兖州伐燕。郗超曰：「道远，汴水又浅，恐漕运难通。」温不从。六月，辛丑，温至金鄕，天旱，水道绝，温使冠军将军毛虎生凿巨野三百里，引汶水会于清水。虎生，宝之子也。温引舟师自清水入河，舳舻数百里。郗超曰：「清水入河，难以通运。若寇不战，运道又绝，因敌为资，复无所得，此危道也。不若尽举见众直趋邺城，彼畏公威名，必望风逃溃，北归辽、碣。若能出战，则事可立决。若欲城邺而守之，则当此盛夏，难为功力，百姓布野，尽为官有，易水以南必交臂请命矣。但恐明公以此计轻锐，胜负难必，欲务持重，则若顿兵河、济，控引漕运，俟资储充备，至来夏乃进兵；虽如賖迟，然期于成功而已。舍此二策而连军北上，进不速决，退必愆乏。贼因此势以日月相引，渐及秋冬，水更涩滞。且北土早寒，三军裘褐者少，恐于时所忧，非独无食而已。」温又不从。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8939,"number":3,"path":"资治通鉴 : 卷第一百二 (晉紀二十四) / 海西公下 / 太和四年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"a26f2316-db0e-11ef-8c75-a0d3651f611f","year_int":369},"tongjian_id":"a26f2316-db0e-11ef-8c75-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"汶水","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"汶水","place_name_jianti_auto":"汶水","place_note":"流经郓州城南","start_index":0,"tongjian_id":"cb166677-db0e-11ef-a1dd-a0d3651f611f"},{"place_name":"鄆城","place_name_jianti_auto":"郓城","start_index":3,"tongjian_id":"cb166678-db0e-11ef-b0d5-a0d3651f611f"},{"place_name":"鄆","place_name_jianti_auto":"郓","start_index":10,"tongjian_id":"cb166679-db0e-11ef-99de-a0d3651f611f"},{"place_name":"讙","place_name_jianti_auto":"讙","start_index":12,"tongjian_id":"cb16667a-db0e-11ef-a98f-a0d3651f611f"},{"place_name":"龜陰","place_name_jianti_auto":"龟阴","start_index":14,"tongjian_id":"cb16667b-db0e-11ef-98af-a0d3651f611f"},{"place_name":"汶陽","place_name_jianti_auto":"汶阳","start_index":17,"tongjian_id":"cb16667c-db0e-11ef-af11-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"汶水過鄆城南。春秋以鄆、讙、龜陰爲汶陽之田是也。汶，音問。","note_content_jianti_auto":"汶水过郓城南。春秋以郓、讙、龟阴为汶阳之田是也。汶，音问。","note_type":"hu_note","start_index":14,"tongjian_id":"cb166676-db0e-11ef-8611-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"薛","people_name_jianti_auto":"薛","start_index":10,"tongjian_id":"cb16667f-db0e-11ef-bbc8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"敗，補邁翻。考異曰：薛史作「遞公鎭」。今從實錄。","note_content_jianti_auto":"败，补迈翻。考异曰：薛史作「递公镇」。今从实录。","note_type":"hu_note","start_index":36,"tongjian_id":"cb16667e-db0e-11ef-b3a7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":81,"tongjian_id":"cb166684-db0e-11ef-b72a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄆州","place_name_jianti_auto":"郓州","start_index":8,"tongjian_id":"cb166685-db0e-11ef-bc17-a0d3651f611f"},{"place_name":"中都縣","place_name_jianti_auto":"中都县","start_index":10,"tongjian_id":"cb166686-db0e-11ef-b0b1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":14,"tongjian_id":"cb166687-db0e-11ef-8517-a0d3651f611f"},{"place_name":"平陸縣","place_name_jianti_auto":"平陆县","start_index":15,"tongjian_id":"cb166688-db0e-11ef-a22b-a0d3651f611f"},{"place_name":"殷密城","place_name_jianti_auto":"殷密城","start_index":21,"tongjian_id":"cb166689-db0e-11ef-8a5a-a0d3651f611f"},{"place_name":"中都縣","place_name_jianti_auto":"中都县","start_index":40,"tongjian_id":"cb16668a-db0e-11ef-8e1b-a0d3651f611f"},{"place_name":"中都縣","place_name_jianti_auto":"中都县","start_index":53,"tongjian_id":"cb16668b-db0e-11ef-bd90-a0d3651f611f"},{"place_name":"鄆州","place_name_jianti_auto":"郓州","start_index":57,"tongjian_id":"cb16668c-db0e-11ef-a48c-a0d3651f611f"},{"place_name":"中都","place_name_jianti_auto":"中都","start_index":68,"tongjian_id":"cb16668d-db0e-11ef-9b2f-a0d3651f611f"},{"place_name":"汶上縣","place_name_jianti_auto":"汶上县","start_index":71,"tongjian_id":"cb16668e-db0e-11ef-afd1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"舊唐書·地理志：鄆州中都縣，漢平陸縣，舊治殷密城，在今治西三十九里；天寶元年改爲中都縣，移於今治。九域志：中都縣在鄆州東南六十里。近世改中都爲汶上縣。「殷密城」，宋白續通典作「致密城」。","note_content_jianti_auto":"旧唐书·地理志：郓州中都县，汉平陆县，旧治殷密城，在今治西三十九里；天宝元年改为中都县，移于今治。九域志：中都县在郓州东南六十里。近世改中都为汶上县。「殷密城」，宋白续通典作「致密城」。","note_type":"hu_note","start_index":56,"tongjian_id":"cb166683-db0e-11ef-bbd8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"朝城","place_name_jianti_auto":"朝城","start_index":1,"tongjian_id":"cb166693-db0e-11ef-9374-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":7,"tongjian_id":"cb166694-db0e-11ef-896a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自朝城行營遣歸魏州。","note_content_jianti_auto":"自朝城行营遣归魏州。","note_type":"hu_note","start_index":102,"tongjian_id":"cb166692-db0e-11ef-85d9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汶水","place_name_jianti_auto":"汶水","place_note":"流经郓州城南","resolved_place_entity_id":3875,"start_index":6,"tongjian_id":"cb166696-db0e-11ef-9d0b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"宋嘉定十三年，李全攻东平，与金将张林夹汶水而军。是也。又...","context_before":"...，而为分水河，今导为运河。西北流，经州西南，而接安民湖。","source_end_index":157,"source_paragraph_tongjian_id":"ca934d94-d050-50b6-b3cc-75c72bbe4aa0","source_start_index":92,"source_text":"五代唐同光初，李嗣源守郓，梁将王彦章引兵逾汶，将攻郓。嗣源遣李从珂逆战，败之。既而唐主至郓州，遂进军逾汶，击梁军，追至中都，拔之。"},{"context_after":"《薛史》作递坊]。","context_before":"...下东阿，至安山镇，守者以州迎降。是也。○递坊镇，在州南。","source_end_index":148,"source_paragraph_tongjian_id":"9ce7cfcb-6f39-52ad-af23-2cf3c6f13bfc","source_start_index":111,"source_text":"后唐初，李嗣源入郓，梁王彦章逾汶来攻，嗣源遣李从珂逆战，败其前锋于递坊镇。"},{"context_after":"○平陆城，在县北。战国时齐邑。孟子之平陆，又处于平陆。是...","context_before":"...曰：中都本治致密城，在今县西三十九里。天宝中，移于今治。","source_end_index":117,"source_paragraph_tongjian_id":"a638e79b-241e-5774-b51e-f1e9519aa5b4","source_start_index":86,"source_text":"后唐同光初，梁王彦章袭郓州，不克，还保中都，唐主袭执之，即此。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"王彥章引兵踰汶水，將攻鄆州，李嗣源遣李從珂將騎兵逆戰，敗其前鋒於遞坊鎭，獲將士三百人，斬首二百級，彥章退保中都。戊辰，捷奏至朝城，帝大喜，謂郭崇韜曰：「鄆州告捷，足壯吾氣。」己巳，命將士悉遣其家屬歸興唐。","content_fanyi":"王彦章率军渡过汶水，准备进攻郓州，李嗣源派李从珂率领骑兵迎战，在递坊镇打败了梁军前锋部队，俘获将士三百人，斩首二百级，王彦章退守中都。九月二十七日戊辰，捷报上奏到朝城，后唐庄宗大为高兴，对郭崇韬说：“郓州首战告捷，足以振奋我们的士气。”九月二十八日己巳，命令将士们把家属全部送回兴唐府。","content_jianti_auto":"王彦章引兵逾汶水，将攻郓州，李嗣源遣李从珂将骑兵逆战，败其前锋于递坊镇，获将士三百人，斩首二百级，彦章退保中都。戊辰，捷奏至朝城，帝大喜，谓郭崇韬曰：「郓州告捷，足壮吾气。」己巳，命将士悉遣其家属归兴唐。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28261,"path":"资治通鉴 : 卷第二百七十二 (後唐紀一) / 莊宗光聖神閔孝皇帝上 / 同光元年 / 第 40 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":39,"tongjian_id":"cb166675-db0e-11ef-a685-a0d3651f611f","year_int":923},"tongjian_id":"cb166675-db0e-11ef-a685-a0d3651f611f"},"paragraph_order":3}],"page_size":10,"total_pages":1,"total_paragraphs":3},"place_name":"汶水"},"message":"success","success":true}