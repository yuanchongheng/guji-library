n_id":"a146b0d8-db0e-11ef-9cbe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"溫","people_name_jianti_auto":"温","start_index":7,"tongjian_id":"a146b0dc-db0e-11ef-adc0-a0d3651f611f"},{"people_name":"庾翼","people_name_jianti_auto":"庾翼","start_index":15,"tongjian_id":"a146b0dd-db0e-11ef-836e-a0d3651f611f"},{"people_name":"翼","people_name_jianti_auto":"翼","start_index":34,"tongjian_id":"a146b0de-db0e-11ef-876d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"臨淮","place_name_jianti_auto":"临淮","start_index":9,"tongjian_id":"a146b0df-db0e-11ef-b125-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":26,"tongjian_id":"a146b0e0-db0e-11ef-b94a-a0d3651f611f"},{"place_name":"安陸","place_name_jianti_auto":"安陆","start_index":39,"tongjian_id":"a146b0e1-db0e-11ef-b66e-a0d3651f611f"},{"place_name":"夏口","place_name_jianti_auto":"夏口","start_index":43,"tongjian_id":"a146b0e2-db0e-11ef-a5cb-a0d3651f611f"},{"place_name":"武昌","place_name_jianti_auto":"武昌","start_index":56,"tongjian_id":"a146b0e3-db0e-11ef-8f3d-a0d3651f611f"},{"place_name":"夏口","place_name_jianti_auto":"夏口","start_index":64,"tongjian_id":"a146b0e4-db0e-11ef-a80c-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":72,"tongjian_id":"a146b0e5-db0e-11ef-a4cb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：帝紀，溫入臨淮，下云「庾翼爲征討大都督，遷鎭襄陽」。按翼傳，翼先表移鎭安陸，至夏口上表云：「九月十九日發武昌，二十四日達夏口。」始請徙鎭襄陽，始詔加都督征討諸軍事，故知不在此月。","note_content_jianti_auto":"考异曰：帝纪，温入临淮，下云「庾翼为征讨大都督，迁镇襄阳」。按翼传，翼先表移镇安陆，至夏口上表云：「九月十九日发武昌，二十四日达夏口。」始请徙镇襄阳，始诏加都督征讨诸军事，故知不在此月。","note_type":"hu_note","start_index":91,"tongjian_id":"a146b0db-db0e-11ef-a7b6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":3,"tongjian_id":"a146b0ea-db0e-11ef-bed3-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","start_index":5,"tongjian_id":"a146b0eb-db0e-11ef-ac57-a0d3651f611f"},{"place_name":"司","place_name_jianti_auto":"司","start_index":7,"tongjian_id":"a146b0ec-db0e-11ef-820f-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","start_index":9,"tongjian_id":"a146b0ed-db0e-11ef-851c-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":11,"tongjian_id":"a146b0ee-db0e-11ef-a97e-a0d3651f611f"},{"place_name":"益","place_name_jianti_auto":"益","start_index":13,"tongjian_id":"a146b0ef-db0e-11ef-9166-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"六州，江、荊、司、雍、梁、益也。","note_content_jianti_auto":"六州，江、荆、司、雍、梁、益也。","note_type":"hu_note","start_index":109,"tongjian_id":"a146b0e9-db0e-11ef-acbe-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹水","place_name_jianti_auto":"丹水","resolved_place_entity_id":3069,"start_index":71,"tongjian_id":"a146b0fb-db0e-11ef-a4d7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、南阳府（卷五十一）","excerpts":[{"context_after":"宋、齐皆属顺阳郡。后魏置丹川郡于此。后周郡废。隋以县属析...","context_before":"...丹水。汉亦为丹水县，属弘农郡。后汉属南阳郡。晋属顺阳郡。","source_end_index":166,"source_paragraph_tongjian_id":"97ecd6bc-b7d4-5fc8-8f1e-f11e228a15f2","source_start_index":129,"source_text":"建元初，庾翼欲经略中原，表桓宣为梁州刺史，前趣丹水，为石赵将李罴所败而还。"}],"path":"河南方舆纪要/八、南阳府（卷五十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、德安府（卷七十七）","excerpts":[{"context_after":"自是南北分强，未尝不以安陆为棋劫之地。梁、陈不竞，周、隋...","context_before":"...安陆石阳，斩获而还。时安陆已属魏，吴人遂不能得志于襄阳。","source_end_index":173,"source_paragraph_tongjian_id":"038db482-a66c-5c16-ba5f-79701bf556ce","source_start_index":126,"source_text":"晋庾翼图北伐，议移荆州镇安陆，盖顾瞻河、洛，指臂淮、汝，进可战，退可守，安陆形胜，实为利便矣！"}],"path":"湖广方舆纪要/五、德安府（卷七十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"秋，七月，趙汝南太守戴開帥數千人詣翼降。丁巳，下詔議經略中原。翼欲悉所部之衆北伐，表桓宣爲都督司·雍·梁三州·荊州之四郡諸軍事、梁州刺史，前趣丹水；桓溫爲前鋒小督、假節，帥衆入臨淮；並發所統六州奴及車牛驢馬，百姓嗟怨。","content_fanyi":"秋季七月，后赵汝南太守戴开率领数千人前来向庾翼投降。丁巳日，皇帝下诏，让朝廷商议经略中原事宜。庾翼准备率领所部全部兵众北伐，上表推荐桓宣为都督司、雍、梁三州及荆州四郡诸军事、梁州刺史，前赴丹水；任命桓温为前锋小督、假节，率领部众进入临淮；同时征发所统六州的奴仆及车牛驴马，百姓叹息怨恨。","content_jianti_auto":"秋，七月，赵汝南太守戴开帅数千人诣翼降。丁巳，下诏议经略中原。翼欲悉所部之众北伐，表桓宣为都督司·雍·梁三州·荆州之四郡诸军事、梁州刺史，前趣丹水；桓温为前锋小督、假节，帅众入临淮；并发所统六州奴及车牛驴马，百姓嗟怨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8366,"path":"资治通鉴 : 卷第九十七 (晉紀十九) / 康皇帝 / 建元元年 / 第 6 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"a146b0c3-db0e-11ef-ad49-a0d3651f611f","year_int":343},"tongjian_id":"a146b0c3-db0e-11ef-ad49-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"丹水","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"沈約","people_name_jianti_auto":"沈约","start_index":0,"tongjian_id":"a14e0b94-db0e-11ef-8be3-a0d3651f611f"},{"people_name":"晉孝武","people_name_jianti_auto":"晋孝武","start_index":8,"tongjian_id":"a14e0b95-db0e-11ef-8f97-a0d3651f611f"},{"people_name":"陶侃","people_name_jianti_auto":"陶侃","start_index":48,"tongjian_id":"a14e0b96-db0e-11ef-8042-a0d3651f611f"},{"people_name":"宣","people_name_jianti_auto":"宣","start_index":51,"tongjian_id":"a14e0b97-db0e-11ef-915d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"義成郡","place_name_jianti_auto":"义成郡","start_index":4,"tongjian_id":"a14e0b98-db0e-11ef-b854-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":14,"tongjian_id":"a14e0b99-db0e-11ef-bab7-a0d3651f611f"},{"place_name":"襄陽郡","place_name_jianti_auto":"襄阳郡","start_index":22,"tongjian_id":"a14e0b9a-db0e-11ef-bad3-a0d3651f611f"},{"place_name":"穀城縣","place_name_jianti_auto":"谷城县","start_index":25,"tongjian_id":"a14e0b9b-db0e-11ef-b4d5-a0d3651f611f"},{"place_name":"義城","place_name_jianti_auto":"义城","start_index":31,"tongjian_id":"a14e0b9c-db0e-11ef-82d0-a0d3651f611f"},{"place_name":"義城郡","place_name_jianti_auto":"义城郡","start_index":35,"tongjian_id":"a14e0b9d-db0e-11ef-ac48-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":53,"tongjian_id":"a14e0b9e-db0e-11ef-97b1-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","start_index":58,"tongjian_id":"a14e0b9f-db0e-11ef-830d-a0d3651f611f"},{"place_name":"義成郡","place_name_jianti_auto":"义成郡","start_index":63,"tongjian_id":"a14e0ba0-db0e-11ef-ae21-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"沈約曰：義成郡，晉孝武立，治襄陽。五代志曰：襄陽郡穀城縣，舊曰義城，置義城郡。又按晉書·桓宣傳，陶侃使宣鎭襄陽，以其淮南部曲立義成郡；則此郡立於咸和中明矣。「城」，當作「成」。","note_content_jianti_auto":"沈约曰：义成郡，晋孝武立，治襄阳。五代志曰：襄阳郡谷城县，旧曰义城，置义城郡。又按晋书·桓宣传，陶侃使宣镇襄阳，以其淮南部曲立义成郡；则此郡立于咸和中明矣。「城」，当作「成」。","note_type":"hu_note","start_index":65,"tongjian_id":"a14e0b93-db0e-11ef-a1cb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"西城縣","place_name_jianti_auto":"西城县","start_index":0,"tongjian_id":"a14e0ba4-db0e-11ef-ab4a-a0d3651f611f"},{"place_name":"魏興郡","place_name_jianti_auto":"魏兴郡","start_index":6,"tongjian_id":"a14e0ba5-db0e-11ef-b92b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西城縣，時屬魏興郡。","note_content_jianti_auto":"西城县，时属魏兴郡。","note_type":"hu_note","start_index":97,"tongjian_id":"a14e0ba3-db0e-11ef-8796-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a14d9658-db0e-11ef-b760-a0d3651f611f","pinyin":"pí","source_anchor_text":"擊趙將李羆於丹水為","source_key":"baiyang_epub","start_index":18,"text":"羆","tongjian_id":"567ce85a-d15f-564d-aece-ef116698e7dd"}],"ExtRef_Children_places":[{"place_name":"丹水","place_name_jianti_auto":"丹水","resolved_place_entity_id":3069,"start_index":20,"tongjian_id":"a14e0bac-db0e-11ef-bd7e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、南阳府（卷五十一）","excerpts":[{"context_after":"宋、齐皆属顺阳郡。后魏置丹川郡于此。后周郡废。隋以县属析...","context_before":"...丹水。汉亦为丹水县，属弘农郡。后汉属南阳郡。晋属顺阳郡。","source_end_index":166,"source_paragraph_tongjian_id":"97ecd6bc-b7d4-5fc8-8f1e-f11e228a15f2","source_start_index":129,"source_text":"建元初，庾翼欲经略中原，表桓宣为梁州刺史，前趣丹水，为石赵将李罴所败而还。"}],"path":"河南方舆纪要/八、南阳府（卷五十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、襄阳府（卷七十九）","excerpts":[{"context_after":"宋嘉定十年，金兵犯襄阳，复围枣阳，孟宗政午发岘首，迟明抵...","context_before":"...祖为孙坚所败，窜岘山中。羊祜镇襄阳，尝登此，亦曰岘首山。","source_end_index":88,"source_paragraph_tongjian_id":"399cdaf9-20b6-5b19-ba74-409fce3e9f0b","source_start_index":60,"source_text":"晋建元二年，梁州刺史桓宣击赵将李罴，败于丹水，移戍岘山。"}],"path":"湖广方舆纪要/八、襄阳府（卷七十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"9征西將軍庾翼使梁州刺史桓宣擊趙將李羆於丹水，爲羆所敗，翼貶宣爲建威將軍。宣慚憤成疾，秋，八月，庚辰，卒。翼以長子方之爲義城太守，代領宣衆；又以司馬應誕爲襄陽太守，參軍司馬勳爲梁州刺史，戍西城。","content_fanyi":"东晋征西将军庾翼派梁州刺史桓宣到丹水进攻后赵将领李罴，却被李罴打败，庾翼把桓宣贬为建威将军。桓宣为此惭愧愤恨，染上疾病，于秋季八月初七庚辰日去世。庾翼任命长子庾方之为义城太守，代领桓宣的部众；又任命司马应诞为襄阳太守，参军司马勋为梁州刺史，戍守西城。","content_jianti_auto":"9征西将军庾翼使梁州刺史桓宣击赵将李罴于丹水，为罴所败，翼贬宣为建威将军。宣惭愤成疾，秋，八月，庚辰，卒。翼以长子方之为义城太守，代领宣众；又以司马应诞为襄阳太守，参军司马勋为梁州刺史，戍西城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8385,"number":9,"path":"资治通鉴 : 卷第九十七 (晉紀十九) / 康皇帝 / 二年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"a14d9658-db0e-11ef-b760-a0d3651f611f","year_int":344},"tongjian_id":"a14d9658-db0e-11ef-b760-a0d3651f611f"},"paragraph_order":4}],"page_size":10,"total_pages":1,"total_paragraphs":4},"place_name":"丹水"},"message":"success","success":true}