9d93-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，丹水縣屬弘農郡。括地志曰：故丹城，在鄧州內鄕縣西南百二十里，南去丹水二百步。汲冢紀年曰：后稷放帝子丹朱於丹水。輿地志云：卽秦時丹水縣。","note_content_jianti_auto":"班志，丹水县属弘农郡。括地志曰：故丹城，在邓州内鄕县西南百二十里，南去丹水二百步。汲冢纪年曰：后稷放帝子丹朱于丹水。舆地志云：即秦时丹水县。","note_type":"hu_note","start_index":13,"tongjian_id":"8dbc2e24-db0e-11ef-94ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":21,"tongjian_id":"8dbc2e36-db0e-11ef-8f6a-a0d3651f611f"},{"people_name":"王陵","people_name_jianti_auto":"王陵","start_index":27,"tongjian_id":"8dbc2e37-db0e-11ef-b0f0-a0d3651f611f"},{"people_name":"安國侯","people_name_jianti_auto":"安国侯","start_index":30,"tongjian_id":"8dbc2e38-db0e-11ef-914d-a0d3651f611f"},{"people_name":"陵","people_name_jianti_auto":"陵","start_index":34,"tongjian_id":"8dbc2e39-db0e-11ef-b1bc-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":68,"tongjian_id":"8dbc2e3a-db0e-11ef-a291-a0d3651f611f"},{"people_name":"韓成","people_name_jianti_auto":"韩成","start_index":73,"tongjian_id":"8dbc2e3b-db0e-11ef-97c3-a0d3651f611f"},{"people_name":"穰侯","people_name_jianti_auto":"穰侯","start_index":76,"tongjian_id":"8dbc2e3c-db0e-11ef-af47-a0d3651f611f"},{"people_name":"陵","people_name_jianti_auto":"陵","start_index":85,"tongjian_id":"8dbc2e3d-db0e-11ef-94b3-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":90,"tongjian_id":"8dbc2e3e-db0e-11ef-8855-a0d3651f611f"},{"people_name":"王陵","people_name_jianti_auto":"王陵","start_index":94,"tongjian_id":"8dbc2e3f-db0e-11ef-acd5-a0d3651f611f"},{"people_name":"安國","people_name_jianti_auto":"安国","start_index":98,"tongjian_id":"8dbc2e40-db0e-11ef-ad9f-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":102,"tongjian_id":"8dbc2e41-db0e-11ef-b1d9-a0d3651f611f"},{"people_name":"王陵","people_name_jianti_auto":"王陵","start_index":122,"tongjian_id":"8dbc2e42-db0e-11ef-882b-a0d3651f611f"},{"people_name":"安國侯","people_name_jianti_auto":"安国侯","start_index":125,"tongjian_id":"8dbc2e43-db0e-11ef-995b-a0d3651f611f"},{"people_name":"襄侯","people_name_jianti_auto":"襄侯","start_index":142,"tongjian_id":"8dbc2e44-db0e-11ef-965e-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":147,"tongjian_id":"8dbc2e45-db0e-11ef-a2e3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":25,"tongjian_id":"8dbc2e46-db0e-11ef-aeaa-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":39,"tongjian_id":"8dbc2e47-db0e-11ef-a77f-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":42,"tongjian_id":"8dbc2e48-db0e-11ef-9e92-a0d3651f611f"},{"place_name":"穰縣","place_name_jianti_auto":"穰县","start_index":45,"tongjian_id":"8dbc2e49-db0e-11ef-96e4-a0d3651f611f"},{"place_name":"江夏","place_name_jianti_auto":"江夏","start_index":79,"tongjian_id":"8dbc2e4a-db0e-11ef-8916-a0d3651f611f"},{"place_name":"襄","place_name_jianti_auto":"襄","start_index":82,"tongjian_id":"8dbc2e4b-db0e-11ef-90b8-a0d3651f611f"},{"place_name":"江夏","place_name_jianti_auto":"江夏","start_index":154,"tongjian_id":"8dbc2e4c-db0e-11ef-81e7-a0d3651f611f"},{"place_name":"襄","place_name_jianti_auto":"襄","start_index":157,"tongjian_id":"8dbc2e4d-db0e-11ef-b21c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鰓，音魚鰓之鰓，先才翻；人名也，史失其姓。韋昭曰：漢封王陵爲安國侯。陵初起兵在南陽，南陽有穰縣，疑「襄」當爲「穰」，而無「禾」，字省耳。臣瓚曰：時韓成封穰侯。江夏有襄，是陵所封也。師古曰：王陵亦非安國者；韋昭改「襄」爲「穰」，蓋亦穿鑿。索隱曰：王陵封安國侯，是定天下爲丞相時封耳；此言襄侯，當如臣瓚解，蓋初封江夏之襄也。","note_content_jianti_auto":"鳃，音鱼鳃之鳃，先才翻；人名也，史失其姓。韦昭曰：汉封王陵为安国侯。陵初起兵在南阳，南阳有穰县，疑「襄」当为「穰」，而无「禾」，字省耳。臣瓒曰：时韩成封穰侯。江夏有襄，是陵所封也。师古曰：王陵亦非安国者；韦昭改「襄」为「穰」，盖亦穿凿。索隐曰：王陵封安国侯，是定天下为丞相时封耳；此言襄侯，当如臣瓒解，盖初封江夏之襄也。","note_type":"hu_note","start_index":24,"tongjian_id":"8dbc2e35-db0e-11ef-916f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"梅","people_name_jianti_auto":"梅","start_index":3,"tongjian_id":"8dbc2e50-db0e-11ef-9a4c-a0d3651f611f"},{"people_name":"子","people_name_jianti_auto":"子","start_index":6,"tongjian_id":"8dbc2e51-db0e-11ef-87a3-a0d3651f611f"},{"people_name":"梅伯","people_name_jianti_auto":"梅伯","start_index":11,"tongjian_id":"8dbc2e52-db0e-11ef-9a1f-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":15,"tongjian_id":"8dbc2e53-db0e-11ef-aceb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"殷","place_name_jianti_auto":"殷","start_index":9,"tongjian_id":"8dbc2e54-db0e-11ef-bff0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：梅本自子姓，殷有梅伯，爲紂所醢。","note_content_jianti_auto":"姓谱：梅本自子姓，殷有梅伯，为纣所醢。","note_type":"hu_note","start_index":37,"tongjian_id":"8dbc2e4f-db0e-11ef-8645-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8dbc2e57-db0e-11ef-bc63-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":36,"tongjian_id":"8dbc2e58-db0e-11ef-bef6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":3,"tongjian_id":"8dbc2e59-db0e-11ef-8a42-a0d3651f611f"},{"place_name":"湖陽縣","place_name_jianti_auto":"湖阳县","start_index":7,"tongjian_id":"8dbc2e5a-db0e-11ef-a61b-a0d3651f611f"},{"place_name":"廖國","place_name_jianti_auto":"廖国","start_index":12,"tongjian_id":"8dbc2e5b-db0e-11ef-857d-a0d3651f611f"},{"place_name":"析縣","place_name_jianti_auto":"析县","start_index":15,"tongjian_id":"8dbc2e5c-db0e-11ef-b00d-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":18,"tongjian_id":"8dbc2e5d-db0e-11ef-8ae6-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":23,"tongjian_id":"8dbc2e5e-db0e-11ef-8f4f-a0d3651f611f"},{"place_name":"酈縣","place_name_jianti_auto":"郦县","start_index":29,"tongjian_id":"8dbc2e5f-db0e-11ef-8fce-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":32,"tongjian_id":"8dbc2e60-db0e-11ef-b803-a0d3651f611f"},{"place_name":"析","place_name_jianti_auto":"析","start_index":40,"tongjian_id":"8dbc2e61-db0e-11ef-933d-a0d3651f611f"},{"place_name":"內鄕縣","place_name_jianti_auto":"内鄕县","start_index":43,"tongjian_id":"8dbc2e62-db0e-11ef-8488-a0d3651f611f"},{"place_name":"酈","place_name_jianti_auto":"郦","place_note":"河南南阳西北","start_index":47,"tongjian_id":"8dbc2e63-db0e-11ef-abfb-a0d3651f611f"},{"place_name":"菊潭縣","place_name_jianti_auto":"菊潭县","start_index":50,"tongjian_id":"8dbc2e64-db0e-11ef-b504-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，南陽郡有湖陽縣，故廖國。析縣屬弘農郡，本楚之白羽也。酈縣屬南陽郡。師古曰：析，今內鄕縣；酈，今菊潭縣。鋗，呼玄翻。析，先歷翻。酈，直益翻，又郞益翻。廖，力救翻。","note_content_jianti_auto":"班志，南阳郡有湖阳县，故廖国。析县属弘农郡，本楚之白羽也。郦县属南阳郡。师古曰：析，今内鄕县；郦，今菊潭县。𫓶，呼玄翻。析，先历翻。郦，直益翻，又郞益翻。廖，力救翻。","note_type":"hu_note","start_index":47,"tongjian_id":"8dbc2e56-db0e-11ef-bda1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"亡，古毋、無二字通。鹵，與虜同。","note_content_jianti_auto":"亡，古毋、无二字通。卤，与虏同。","note_type":"hu_note","start_index":54,"tongjian_id":"8dbc2e66-db0e-11ef-a134-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹水","place_name_jianti_auto":"丹水","place_note":"河南淅川","resolved_place_entity_id":3069,"start_index":10,"tongjian_id":"8dbc2e67-db0e-11ef-9847-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"《汉志》注：丹水出上雒冢岭山，东至析入钧。《水经注》：丹...","context_before":"...乡县界。《吕氏春秋》：尧有丹水之战，以服南蛮。《史记》：","source_end_index":63,"source_paragraph_tongjian_id":"3256286a-264f-5110-96e2-3fa6b8efad3d","source_start_index":49,"source_text":"汉高入秦，王陵起丹水以应之。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降。還攻胡陽，遇番君別將梅鋗，與偕攻析、酈，皆降。所過亡得鹵掠，秦民皆喜。","content_fanyi":"刘邦率军西进，沿途城邑没有不归附的。到达丹水后，高武侯戚鳃、襄侯王陵都投降了。刘邦又回军攻打胡阳，遇到番君属下的别将梅鋗，与他一同攻打析、郦，二地都归降了。刘邦下令所过之处不得抢掠，秦地百姓都很喜悦。","content_jianti_auto":"引兵西，无不下者。至丹水，高武侯鳃、襄侯王陵降。还攻胡阳，遇番君别将梅𫓶，与偕攻析、郦，皆降。所过亡得卤掠，秦民皆喜。","dtjl_paragraph_links":[],"dtjl_references":[],"id":679,"path":"资治通鉴 : 卷第八 (秦紀三) / 二世皇帝下 / 三年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"8dbc2e23-db0e-11ef-84bf-a0d3651f611f","year_int":-207},"tongjian_id":"8dbc2e23-db0e-11ef-84bf-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"丹水","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":24,"tongjian_id":"9f258012-db0e-11ef-a13d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"丹水縣","place_name_jianti_auto":"丹水县","start_index":0,"tongjian_id":"9f258013-db0e-11ef-a550-a0d3651f611f"},{"place_name":"前漢","place_name_jianti_auto":"前汉","start_index":4,"tongjian_id":"9f258014-db0e-11ef-a840-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":7,"tongjian_id":"9f258015-db0e-11ef-9c27-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":11,"tongjian_id":"9f258016-db0e-11ef-b973-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":14,"tongjian_id":"9f258017-db0e-11ef-94c2-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":18,"tongjian_id":"9f258018-db0e-11ef-b89e-a0d3651f611f"},{"place_name":"順陽郡","place_name_jianti_auto":"顺阳郡","start_index":20,"tongjian_id":"9f258019-db0e-11ef-9c75-a0d3651f611f"},{"place_name":"丹水","place_name_jianti_auto":"丹水","start_index":27,"tongjian_id":"9f25801a-db0e-11ef-a1ef-a0d3651f611f"},{"place_name":"鄧州","place_name_jianti_auto":"邓州","start_index":34,"tongjian_id":"9f25801b-db0e-11ef-bbd2-a0d3651f611f"},{"place_name":"內鄕縣","place_name_jianti_auto":"内鄕县","start_index":36,"tongjian_id":"9f25801c-db0e-11ef-888e-a0d3651f611f"},{"place_name":"丹水","place_name_jianti_auto":"丹水","start_index":43,"tongjian_id":"9f25801d-db0e-11ef-bef3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"丹水縣，前漢屬弘農郡，後漢屬南陽郡，晉屬順陽郡。賢曰：丹水故城，在今鄧州內鄕縣，西南臨丹水。復，扶又翻；下同。","note_content_jianti_auto":"丹水县，前汉属弘农郡，后汉属南阳郡，晋属顺阳郡。贤曰：丹水故城，在今邓州内鄕县，西南临丹水。复，扶又翻；下同。","note_type":"hu_note","start_index":16,"tongjian_id":"9f258011-db0e-11ef-bd16-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陸璣","people_name_jianti_auto":"陆玑","start_index":19,"tongjian_id":"9f25801f-db0e-11ef-83ca-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":74,"tongjian_id":"9f258020-db0e-11ef-950a-a0d3651f611f"},{"people_name":"陸璣","people_name_jianti_auto":"陆玑","start_index":121,"tongjian_id":"9f258021-db0e-11ef-9e62-a0d3651f611f"},{"people_name":"賈誼","people_name_jianti_auto":"贾谊","start_index":146,"tongjian_id":"9f258022-db0e-11ef-846f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","start_index":29,"tongjian_id":"9f258023-db0e-11ef-841e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":170,"tongjian_id":"9f258024-db0e-11ef-9df7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"梟，堅堯翻；一曰流離，爾雅作「𪅳鷅」，陸璣草木疏曰：梟也，關西人謂之流離，大則食其母。爾雅有茅鴟，今鴟鳩也。似鷹而白；怪鴟，卽鴟鵂也；梟鴟，土梟也。孔穎達曰：鴞，惡聲之鳥，一名鵩，與梟一名鴟。詩·瞻卬云「爲鴟爲梟」，是也，俗說以爲土梟，非也。陸璣疏云：鴞大如班鳩，綠色，惡聲之鳥也，入人家凶，賈誼所謂服鳥是也。其肉甚美，可爲羹𦞦，又可爲炙。漢供御物，各隨其時，唯鴞冬夏常施之，以其美故也。遺，于季翻。","note_content_jianti_auto":"枭，坚尧翻；一曰流离，尔雅作「𪅳𫛽」，陆玑草木疏曰：枭也，关西人谓之流离，大则食其母。尔雅有茅鸱，今鸱鸠也。似鹰而白；怪鸱，即鸱鸺也；枭鸱，土枭也。孔颖达曰：鸮，恶声之鸟，一名𫛳，与枭一名鸱。诗·瞻卬云「为鸱为枭」，是也，俗说以为土枭，非也。陆玑疏云：鸮大如班鸠，绿色，恶声之鸟也，入人家凶，贾谊所谓服鸟是也。其肉甚美，可为羹𦞦，又可为炙。汉供御物，各随其时，唯鸮冬夏常施之，以其美故也。遗，于季翻。","note_type":"hu_note","start_index":44,"tongjian_id":"9f25801e-db0e-11ef-ac3c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9f258010-db0e-11ef-9836-a0d3651f611f","pinyin":"chī","source_anchor_text":"凶狡所謂鴟梟食母之","source_key":"baiyang_epub","start_index":36,"text":"鴟","tongjian_id":"89e0b3ce-94ef-5c21-bb0a-44c460481d50"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9f258010-db0e-11ef-9836-a0d3651f611f","pinyin":"xiāo","source_anchor_text":"狡所謂鴟梟食母之物","source_key":"baiyang_epub","start_index":37,"text":"梟","tongjian_id":"2d934e73-dd38-5bf3-bb1e-9f723ba8956d"}],"ExtRef_Children_places":[{"place_name":"丹水","place_name_jianti_auto":"丹水","resolved_place_entity_id":3069,"start_index":9,"tongjian_id":"9f258031-db0e-11ef-85b4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"曾復致牋於崧，求討丹水賊以自效，崧許之。陶侃遺崧書曰：「杜曾凶狡，所謂『鴟梟食母之物。』此人不死，州土未寧，足下當識吾言！」崧以宛中兵少，藉曾爲外援，不從。曾復帥流亡二千餘人圍襄陽，數日，不克而還。","content_fanyi":"杜曾又写信给荀崧，请求讨伐丹水县的贼寇，来为自己效力，荀崧同意了。陶侃写信给荀崧说：“杜曾凶残狡猾，正像人们所说的‘鸱枭是吞食自己母亲的鸟’，他就是这样的人。此人不死，荆州境内就不会安宁，您务必记住我的话！”荀崧因为宛城中的兵力少，想借杜曾作为外援，没有听从。杜曾又率领流亡的两千多人包围襄阳，一连几天，没能攻克，便回师了。","content_jianti_auto":"曾复致牋于崧，求讨丹水贼以自效，崧许之。陶侃遗崧书曰：「杜曾凶狡，所谓『鸱枭食母之物。』此人不死，州土未宁，足下当识吾言！」崧以宛中兵少，藉曾为外援，不从。曾复帅流亡二千余人围襄阳，数日，不克而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7649,"path":"资治通鉴 : 卷第八十九 (晉紀十一) / 孝愍皇帝下 / 三年 / 第 22 段","reading_annotation_sources":[],"start_index":21,"tongjian_id":"9f258010-db0e-11ef-9836-a0d3651f611f","year_int":315},"tongjian_id":"9f258010-db0e-11ef-9836-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"丹水","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":0,"tongjian_id":"a146b0c6-db0e-11ef-bc09-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":5,"tongjian_id":"a146b0c7-db0e-11ef-ad50-a0d3651f611f"},{"place_name":"新野","place_name_jianti_auto":"新野","start_index":8,"tongjian_id":"a146b0c8-db0e-11ef-88fb-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":11,"tongjian_id":"a146b0c9-db0e-11ef-a49a-a0d3651f611f"},{"place_name":"南鄕","place_name_jianti_auto":"南鄕","start_index":14,"tongjian_id":"a146b0ca-db0e-11ef-afa7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"荊州四郡，南陽、新野、襄陽、南鄕也。雍，於用翻。","note_content_jianti_auto":"荆州四郡，南阳、新野、襄阳、南鄕也。雍，于用翻。","note_type":"hu_note","start_index":69,"tongjian_id":"a146b0c5-db0e-11ef-b502-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":24,"tongjian_id":"a146b0cc-db0e-11ef-8df2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"丹水縣","place_name_jianti_auto":"丹水县","start_index":0,"tongjian_id":"a146b0cd-db0e-11ef-a925-a0d3651f611f"},{"place_name":"前漢","place_name_jianti_auto":"前汉","start_index":4,"tongjian_id":"a146b0ce-db0e-11ef-90c0-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":7,"ton