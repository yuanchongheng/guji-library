tart_index":5,"tongjian_id":"b43cdf96-db0e-11ef-b51c-a0d3651f611f"}],"reign_name":"三年","reign_name_jianti_auto":"三年","start_index":3,"tongjian_id":"b43a95df-db0e-11ef-b8e2-a0d3651f611f","year_anno":"（癸亥、六○三）","year_int":603},"message":"success","success":true}