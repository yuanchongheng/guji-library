{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（癸亥、六○三）","note_content_jianti_auto":"（癸亥、六○三）","note_type":"hu_note","start_index":0,"tongjian_id":"b43a95e0-db0e-11ef-9d89-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"幽州總管","official_note":"幽州總管是隋朝時期的地方軍事和行政長官，負責幽州地區的治理和防務，此處指燕榮擔任此職，因嚴酷行為被賜死，顯示其職權在地方上的重要性。","official_rank":"未知","source_snippet":"賜幽州總管燕榮死","start_index":12,"tongjian_id":"754a2bf1-6c7f-4a60-98c1-cd6de857232d"}],"ExtRef_Children_people":[{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"燕榮","people_name_jianti_auto":"燕荣","people_xingming":"燕荣","start_index":14,"tongjian_id":"b43a95e4-db0e-11ef-b1b7-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":18,"tongjian_id":"b43a95e6-db0e-11ef-9349-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":62,"tongjian_id":"b43a95e7-db0e-11ef-84cd-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":103,"tongjian_id":"b43a95e8-db0e-11ef-a747-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"幽州","place_name_jianti_auto":"幽州","place_note":"总部设幽州【北京市】","resolved_place_entity_id":102,"start_index":10,"tongjian_id":"b43a95e5-db0e-11ef-9fdc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1秋，八月，壬申，賜幽州總管燕榮死。榮性嚴酷，鞭撻左右，動至千數。嘗見道次叢荊，以爲堪作杖，命取之，輒以試人。人或自陳無罪，榮曰：「後有罪，當免汝。」旣而有犯，將杖之，人曰：「前日被杖，使君許以有罪宥之。」榮曰：「無罪尚爾，況有罪邪！」杖之自若。","content_fanyi":"秋季八月壬申日，文帝将幽州总管燕荣赐死。燕荣性情严厉残酷，鞭打左右之人，动辄达到上千下。他曾看见路旁丛生的荆条，认为适合制作刑杖，命人取来，立即在人身上试打。有人自己陈述无罪，燕荣说：“往后你有罪时，就免去这次杖责。”不久这人犯了过错，将要杖打他，那人说：“前些天我挨了杖打，您答应我有罪时宽恕我。”燕荣说：“没有罪尚且这样打，何况有罪呢！”照旧杖打不误。","content_jianti_auto":"1秋，八月，壬申，赐幽州总管燕荣死。荣性严酷，鞭挞左右，动至千数。尝见道次丛荆，以为堪作杖，命取之，辄以试人。人或自陈无罪，荣曰：「后有罪，当免汝。」既而有犯，将杖之，人曰：「前日被杖，使君许以有罪宥之。」荣曰：「无罪尚尔，况有罪邪！」杖之自若。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17415,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"b43a95e1-db0e-11ef-a604-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":24,"tongjian_id":"b43a95eb-db0e-11ef-889d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"平原郡","place_name_jianti_auto":"平原郡","start_index":3,"tongjian_id":"b43a95ec-db0e-11ef-8975-a0d3651f611f"},{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":6,"tongjian_id":"b43a95ed-db0e-11ef-8ce9-a0d3651f611f"},{"place_name":"勃海郡","place_name_jianti_auto":"勃海郡","start_index":12,"tongjian_id":"b43a95ee-db0e-11ef-9279-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":16,"tongjian_id":"b43a95ef-db0e-11ef-b5fa-a0d3651f611f"},{"place_name":"觀州","place_name_jianti_auto":"观州","start_index":21,"tongjian_id":"b43a95f0-db0e-11ef-9289-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋志：平原郡東光縣，舊置勃海郡，隋廢郡，置觀州。杜佑曰：開皇三年，改別駕、治中爲長史、司馬。觀，古玩翻。長，知兩翻。","note_content_jianti_auto":"隋志：平原郡东光县，旧置勃海郡，隋废郡，置观州。杜佑曰：开皇三年，改别驾、治中为长史、司马。观，古玩翻。长，知两翻。","note_type":"hu_note","start_index":7,"tongjian_id":"b43a95ea-db0e-11ef-ac69-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"觀州長史","official_note":"長史是地方州郡的佐官，負責輔助刺史處理政務。在隋朝，長史通常為州級行政官員，此處觀州長史表示元弘嗣在觀州擔任此職。","official_rank":"未知","source_snippet":"觀州長史元弘嗣遷幽州長史","start_index":0,"tongjian_id":"3c49fd6e-a211-456d-a94f-81f48b1372c9"},{"confidence":0.9,"official_category":"地方行政","official_name":"幽州長史","official_note":"幽州長史是幽州的佐官，元弘嗣從觀州長史調任至此，顯示其職務變動。幽州在隋朝為重要邊州，長史職責包括輔助刺史管理地方事務。","official_rank":"未知","source_snippet":"觀州長史元弘嗣遷幽州長史","start_index":8,"tongjian_id":"dabce5ff-0386-4a61-ab80-7b13925c692d"}],"ExtRef_Children_people":[{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"元弘嗣","people_name_jianti_auto":"元弘嗣","people_xingming":"元弘嗣","start_index":4,"tongjian_id":"b43cdf59-db0e-11ef-b2d0-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":15,"tongjian_id":"b43cdf5b-db0e-11ef-ab25-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","start_index":24,"tongjian_id":"b43cdf5c-db0e-11ef-9f3d-a0d3651f611f"},{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"弘嗣","people_name_jianti_auto":"弘嗣","people_xingming":"元弘嗣","start_index":28,"tongjian_id":"b43cdf5d-db0e-11ef-8f3e-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":42,"tongjian_id":"b43cdf5e-db0e-11ef-8f40-a0d3651f611f"},{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"弘嗣","people_name_jianti_auto":"弘嗣","people_xingming":"元弘嗣","start_index":58,"tongjian_id":"b43cdf5f-db0e-11ef-8fe2-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":104,"tongjian_id":"b43cdf61-db0e-11ef-bacf-a0d3651f611f"},{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"弘嗣","people_name_jianti_auto":"弘嗣","people_xingming":"元弘嗣","start_index":107,"tongjian_id":"b43cdf62-db0e-11ef-8e90-a0d3651f611f"},{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"弘嗣","people_name_jianti_auto":"弘嗣","people_xingming":"元弘嗣","start_index":117,"tongjian_id":"b43cdf63-db0e-11ef-bdd6-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":140,"tongjian_id":"b43cdf64-db0e-11ef-a12c-a0d3651f611f"},{"link_td_description":"元弘嗣，河南郡洛阳县（今河南省洛阳市东）人，追尊魏昭成帝拓跋什翼犍的后裔，隋朝官员。","link_td_id":"Q10017792","link_td_number_id":5284063,"people_name":"元弘嗣","people_name_jianti_auto":"元弘嗣","people_xingming":"元弘嗣","start_index":155,"tongjian_id":"b43cdf65-db0e-11ef-98d4-a0d3651f611f"},{"link_death_year":603,"link_td_description":"燕荣，字贵公，隋朝将领，华阴弘农人。","link_td_id":"Q10020801","link_td_number_id":6804060,"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"燕荣","start_index":159,"tongjian_id":"b43cdf66-db0e-11ef-98bc-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"觀州","place_name_jianti_auto":"观州","place_note":"河北东光县","resolved_place_entity_id":4060,"start_index":0,"tongjian_id":"b43cdf5a-db0e-11ef-b3b0-a0d3651f611f"},{"place_name":"幽州","place_name_jianti_auto":"幽州","resolved_place_entity_id":102,"start_index":8,"tongjian_id":"b43cdf60-db0e-11ef-bb9c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"觀州長史元弘嗣遷幽州長史，懼爲榮所辱，固辭。上敕榮曰：「弘嗣杖十已上罪，皆須奏聞。」榮忿曰：「豎子何敢玩我！」於是遣弘嗣監納倉粟，颺得一糠一粃，皆罰之。每笞雖不滿十，然一日之中，或至三數。如是歷年，怨隙日構。榮遂收弘嗣付獄，禁絕其糧，弘嗣抽絮雜水咽之。其妻詣闕稱冤，上遣使按驗，奏榮暴虐，贓穢狼籍；徵還，賜死。元弘嗣代榮爲政，酷又甚之。","content_fanyi":"观州长史元弘嗣被调任幽州长史，因害怕受燕荣凌辱，坚决推辞。文帝敕令燕荣说：“元弘嗣凡犯有应受杖刑十下以上的罪，都必须奏报朕知。”燕荣愤怒地说：“这小子怎敢戏弄我！”于是派元弘嗣监督粮仓收粟，只要簸扬出一点糠秕，就责罚他。每次杖打虽不满十下，但一天之内有时多达数次。如此持续多年，两人之间的怨恨日益加深。燕荣于是逮捕元弘嗣投入狱中，断绝他的口粮，元弘嗣抽出棉絮掺水吞下。元弘嗣的妻子到宫阙前喊冤，文帝派使者调查核实，回奏燕荣暴虐残酷，贪赃纳贿，劣迹斑斑；于是将燕荣召回朝廷，赐令自杀。元弘嗣接替燕荣治理该地，残酷程度又超过了他。","content_jianti_auto":"观州长史元弘嗣迁幽州长史，惧为荣所辱，固辞。上敕荣曰：「弘嗣杖十已上罪，皆须奏闻。」荣忿曰：「竖子何敢玩我！」于是遣弘嗣监纳仓粟，飏得一糠一粃，皆罚之。每笞虽不满十，然一日之中，或至三数。如是历年，怨隙日构。荣遂收弘嗣付狱，禁绝其粮，弘嗣抽絮杂水咽之。其妻诣阙称冤，上遣使按验，奏荣暴虐，赃秽狼籍；征还，赐死。元弘嗣代荣为政，酷又甚之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17416,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"b43a95e9-db0e-11ef-ac68-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"開皇初，置義倉，今置常平官掌之。","note_content_jianti_auto":"开皇初，置义仓，今置常平官掌之。","note_type":"hu_note","start_index":12,"tongjian_id":"b43cdf68-db0e-11ef-ae5e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"财政","official_name":"常平官","official_note":"常平官是隋朝设置的官职，负责管理常平仓，以平抑粮价、调节市场，此处表示在603年九月设立此官职以稳定经济。","official_rank":"未知","source_snippet":"置常平官","start_index":6,"tongjian_id":"e0402b65-839a-475f-9b2a-83fc4dbc0326"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2九月，壬戌，置常平官。","content_fanyi":"九月壬戌日，设立常平官。","content_jianti_auto":"2九月，壬戌，置常平官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17417,"number":2,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"b43cdf67-db0e-11ef-a733-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"龍門縣","place_name_jianti_auto":"龙门县","start_index":3,"tongjian_id":"b43cdf6b-db0e-11ef-9213-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":7,"tongjian_id":"b43cdf6c-db0e-11ef-94da-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋志：龍門縣屬河東郡。","note_content_jianti_auto":"隋志：龙门县属河东郡。","note_type":"hu_note","start_index":17,"tongjian_id":"b43cdf6a-db0e-11ef-83bc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"b43cdf75-db0e-11ef-b52b-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":33,"tongjian_id":"b43cdf76-db0e-11ef-98bb-a0d3651f611f"}],"ExtRef_Child