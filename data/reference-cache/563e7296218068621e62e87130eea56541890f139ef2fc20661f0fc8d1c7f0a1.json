f-8bc9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":1,"tongjian_id":"8c636627-db0e-11ef-bc99-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","resolved_place_entity_id":458,"start_index":121,"tongjian_id":"8c6379e8-db0e-11ef-9a86-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":127,"tongjian_id":"8c6379e9-db0e-11ef-bced-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":129,"tongjian_id":"8c6379eb-db0e-11ef-99a0-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":140,"tongjian_id":"8c6379ec-db0e-11ef-9bd9-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"齐破燕之战","tongjian_id":"war_N0515"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/燕非强国","excerpts":[{"context_after":"，后赖五国之力，乐毅为将，然后胜齐，然卒于得七十城不能守...","context_before":"...春秋时最为僻小，能自见于中国者，不过三四，大率制命于齐。","source_end_index":40,"source_paragraph_tongjian_id":"736aac77-1802-441e-9402-8cea82e51826","source_start_index":31,"source_text":"七雄之际，为齐所取"}],"path":"四笔/卷三/燕非强国","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"燕昭王以乐毅为将，合秦、赵、韩、魏之师，而后能雪耻于齐。...","context_before":"...犹且纳女归赂于齐，诚畏之也。战国时，齐、燕有不两立之势。","source_end_index":594,"source_paragraph_tongjian_id":"dafc8a02-71dc-5f44-b839-5f297d454005","source_start_index":572,"source_text":"子哙之乱，齐宣以五都之兵伐之，五旬而遂举燕。"}],"path":"山东方舆纪要/序","source_name":"读史方舆纪要"}],"class_tags":["军事","权争"],"content":"3燕子之爲王三年，國內大亂。將軍市被與太子平謀攻子之。齊王令人謂太子曰：「寡人聞太子將飭君臣之義，明父子之位，寡人之國唯太子所以令之。」太子因要黨聚衆，使市被攻子之，不克。市被反攻太子。搆難數月，死者數萬人，百姓恫恐。齊王令章子將五都之兵，因北地之衆以伐燕。燕士卒不戰，城門不閉。齊人取子之，醢之，遂殺燕王噲。","content_fanyi":"子之在燕国为王三年，国内大乱。将军市被与太子姬平谋划攻打子之。齐王派人对燕太子说：“我听说太子将要整饬君臣大义、彰明父子名位，我齐国愿意听从您的命令。”燕太子于是邀集党羽、聚合部众，派市被攻打子之，没有攻克。市被反过来攻打太子。祸乱持续数月，死亡数万人，百姓惶恐不安。齐王命令章子率领五都的军队，并借助北方地区的兵众讨伐燕国。燕国士兵不肯交战，城门也不关闭。齐国人俘获子之，把他剁成肉酱，随后杀死燕王姬哙。","content_jianti_auto":"3燕子之为王三年，国内大乱。将军市被与太子平谋攻子之。齐王令人谓太子曰：「寡人闻太子将饬君臣之义，明父子之位，寡人之国唯太子所以令之。」太子因要党聚众，使市被攻子之，不克。市被反攻太子。搆难数月，死者数万人，百姓恫恐。齐王令章子将五都之兵，因北地之众以伐燕。燕士卒不战，城门不闭。齐人取子之，醢之，遂杀燕王哙。","dtjl_paragraph_links":[],"dtjl_references":[],"id":238,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c627621-db0e-11ef-9905-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古者天子之地方千里，出兵車萬乘。七國兼幷以強大，於時皆爲萬乘之國。乘，繩證翻。","note_content_jianti_auto":"古者天子之地方千里，出兵车万乘。七国兼幷以强大，于时皆为万乘之国。乘，绳证翻。","note_type":"hu_note","start_index":34,"tongjian_id":"8c6379ef-db0e-11ef-b74a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"十日爲旬，五旬，五十日。","note_content_jianti_auto":"十日为旬，五旬，五十日。","note_type":"hu_note","start_index":40,"tongjian_id":"8c6379f0-db0e-11ef-8fc9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"殃，咎也，禍也。","note_content_jianti_auto":"殃，咎也，祸也。","note_type":"hu_note","start_index":55,"tongjian_id":"8c6379f1-db0e-11ef-a517-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"簞，竹器也；圓曰簞，方曰笥。簞，音丹。食，祥吏翻，熟食也。漿，水也，酢漿也。笥，相吏翻。酢，倉故翻。","note_content_jianti_auto":"箪，竹器也；圆曰箪，方曰笥。箪，音丹。食，祥吏翻，熟食也。浆，水也，酢浆也。笥，相吏翻。酢，仓故翻。","note_type":"hu_note","start_index":134,"tongjian_id":"8c6379f2-db0e-11ef-99ed-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":6,"tongjian_id":"8c6379f4-db0e-11ef-a25f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"運，轉也。言燕之民將轉而之他國也。","note_content_jianti_auto":"运，转也。言燕之民将转而之他国也。","note_type":"hu_note","start_index":161,"tongjian_id":"8c6379f3-db0e-11ef-9627-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"齐王","start_index":0,"tongjian_id":"8c6379f5-db0e-11ef-a879-a0d3651f611f"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟子","start_index":3,"tongjian_id":"8c6379f6-db0e-11ef-8f18-a0d3651f611f"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","start_index":61,"tongjian_id":"8c6379f8-db0e-11ef-a73b-a0d3651f611f"},{"link_birth_year":-1076,"link_death_year":-1043,"link_td_description":"周武王，姬姓，名发，谥武，又名为珷帝日丁。西周创建者，第一代天子，是西伯昌与太姒的嫡次子。","link_td_id":"Q10000452","link_td_number_id":3566,"people_name":"武王","people_name_jianti_auto":"武王","people_xingming":"姬发","start_index":85,"tongjian_id":"8c6379f9-db0e-11ef-ac8e-a0d3651f611f","wl_zhushi":"[姬发]"},{"link_birth_year":-1112,"link_death_year":-1050,"link_td_description":"周文王，姬姓，周氏，名昌，又称西伯昌。中国商朝末期诸侯国周国君主。后世视之为道统的传人之一。","link_td_id":"Q10000441","link_td_number_id":15568,"people_name":"文王","people_name_jianti_auto":"文王","people_xingming":"姬昌","start_index":109,"tongjian_id":"8c6379fa-db0e-11ef-bfa9-a0d3651f611f","wl_zhushi":"[姬昌]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":14,"tongjian_id":"8c6379f7-db0e-11ef-81af-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":70,"tongjian_id":"8c6379fb-db0e-11ef-9659-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":93,"tongjian_id":"8c6379fc-db0e-11ef-b882-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"齐破燕之战","tongjian_id":"war_N0515"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"燕昭王以乐毅为将，合秦、赵、韩、魏之师，而后能雪耻于齐。...","context_before":"...犹且纳女归赂于齐，诚畏之也。战国时，齐、燕有不两立之势。","source_end_index":594,"source_paragraph_tongjian_id":"dafc8a02-71dc-5f44-b839-5f297d454005","source_start_index":572,"source_text":"子哙之乱，齐宣以五都之兵伐之，五旬而遂举燕。"}],"path":"山东方舆纪要/序","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、青州府（卷三十五）","excerpts":[{"context_after":"又《晏子春秋》：齐侯见晏子于雪宫。《志》云：齐城内有故王...","context_before":"...田，晏子侍于遄台。今俗呼为歇马台。○雪宫，在县东北五里，","source_end_index":155,"source_paragraph_tongjian_id":"5a08aafc-fd8d-51c9-bca6-5728fdc9a088","source_start_index":146,"source_text":"即齐宣王见孟子处。"}],"path":"山东方舆纪要/五、青州府（卷三十五）","source_name":"读史方舆纪要"}],"class_tags":["内政","史论"],"content":"齊王問孟子曰：「或謂寡人勿取燕，或謂寡人取之。以萬乘之國伐萬乘之國，五旬而舉之，人力不至於此；不取，必有天殃。取之何如？」孟子對曰：「取之而燕民悅則取之，古之人有行之者，武王是也。取之而燕民不悅則勿取，古之人有行之者，文王是也。以萬乘之國伐萬乘之國，簞食壺漿以迎王師，豈有他哉？避水火也。如水益深，如火益熱，亦運而已矣！」","content_fanyi":"齐王向孟子问道：“有人对我说不要夺取燕国，有人对我说要夺取它。凭着拥有万辆兵车的大国去攻打同样拥有万辆兵车的大国，五十天就攻了下来，光靠人力是到不了这一步的；如果不夺取，必定会有上天降下的灾祸。现在夺取它怎么样？”孟子回答说：“夺取它如果燕国百姓高兴，就夺取它，古人有这样做过的，周武王就是。夺取它如果燕国百姓不高兴，就不要夺取，古人有这样做过的，周文王就是。凭着拥有万辆兵车的大国去攻打同样拥有万辆兵车的大国，百姓却用竹筐盛饭、用壶盛浆来迎接您的军队，这难道还有别的原因吗？只是为了逃避水深火热的暴政罢了。假如水更深，火更热，那他们也只会转而盼望别人来解救罢了。”","content_jianti_auto":"齐王问孟子曰：「或谓寡人勿取燕，或谓寡人取之。以万乘之国伐万乘之国，五旬而举之，人力不至于此；不取，必有天殃。取之何如？」孟子对曰：「取之而燕民悦则取之，古之人有行之者，武王是也。取之而燕民不悦则勿取，古之人有行之者，文王是也。以万乘之国伐万乘之国，箪食壶浆以迎王师，岂有他哉？避水火也。如水益深，如火益热，亦运而已矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":239,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c6379ee-db0e-11ef-8873-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"書·仲虺之誥之辭。徯，戶禮翻，待也。后，君也。","note_content_jianti_auto":"书·仲虺之诰之辞。徯，户礼翻，待也。后，君也。","note_type":"hu_note","start_index":74,"tongjian_id":"8c6379fe-db0e-11ef-a53a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙岐","people_name_jianti_auto":"赵岐","start_index":0,"tongjian_id":"8c637a02-db0e-11ef-894f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"趙岐曰：係累，縛結也。係，戶計翻。累，力追翻。","note_content_jianti_auto":"赵岐曰：系累，缚结也。系，户计翻。累，力追翻。","note_type":"hu_note","start_index":120,"tongjian_id":"8c637a01-db0e-11ef-98cc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"重器，國之寶鎭。","note_content_jianti_auto":"重器，国之宝镇。","note_type":"hu_note","start_index":130,"tongjian_id":"8c637a03-db0e-11ef-b56e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":0,"tongjian_id":"8c637a05-db0e-11ef-81ae-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":2,"tongjian_id":"8c637a06-db0e-11ef-8bcc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"齊幷燕則地倍其舊。燕，因肩翻。","note_content_jianti_auto":"齐幷燕则地倍其旧。燕，因肩翻。","note_type":"hu_note","start_index":150,"tongjian_id":"8c637a04-db0e-11ef-9618-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙岐","people_name_jianti_auto":"赵岐","start_index":6,"tongjian_id":"8c637a08-db0e-11ef-89ba-a0d3651f611f"},{"people_name":"陸德明","people_name_jianti_auto":"陆德明","start_index":20,"tongjian_id":"8c637a09-db0e-11ef-b370-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令，力政翻。趙岐曰：旄，老旄；倪，弱小。陸德明曰：倪，謂翳倪小兒也。記·曲禮曰：八十、九十曰耄，註云：耄，惛忘也。旄，讀曰耄。倪，五兮翻。翳，與繄同，音煙兮翻。","note_content_jianti_auto":"令，力政翻。赵岐曰：旄，老旄；倪，弱小。陆德明曰：倪，谓翳倪小儿也。记·曲礼曰：八十、九十曰耄，注云：耄，惛忘也。旄，读曰耄。倪，五兮翻。翳，与繄同，音烟兮翻。","note_type":"hu_note","start_index":174,"tongjian_id":"8c637a07-db0e-11ef-94a3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田辟彊","start_index":7,"tongjian_id":"8c637a0c-db0e-11ef-b65b-a0d3651f611f","wl_zhushi":"[田辟彊]"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟子","start_index":10,"tongjian_id":"8c637a0d-db0e-11ef-9627-a0d3651f611f"},{"link_birth_year":-1670,"link_death_year":-1587,"link_td_description":"商汤，商朝开国之君，子姓，名履。","link_td_id":"Q10000014","link_td_number_id":6813,"people_name":"湯","people_name_jianti_auto":"汤","people_xingming":"子天乙","start_index":46,"tongjian_id":"8c637a0e-db0e-11ef-baf4-a0d3651f611f","wl_zhushi":"[子天乙]"},{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田辟彊","start_index":199,"tongjian_id":"8c637a13-db0e-11ef-b965-a0d3651f611f","wl_zhushi":"[田辟彊]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":5,"tongjian_id":"8c637a0f-db0e-11ef-9b9f-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":75,"tongjian_id":"8c637a11-db0e-11ef-8c24-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":141,"tongjian_id":"8c637a12-db0e-11ef-ac1d-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":181,"tongjian_id":"8c637a14-db0e-11ef-9c5f-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"齐破燕之战","tongjian_id":"war_N0515"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","内政"],"content":"諸侯將謀救燕，齊王謂孟子曰：「諸侯多謀伐寡人者，何以待之？」對曰：「臣聞七十里爲政於天下者，湯是也；未聞以千里畏人者也。書曰：『徯我后，后來其蘇。』今燕虐其民，王往而征之，民以爲將拯己於水火之中也，簞食壺漿以迎王師。若殺其父兄，係累其子弟，毀其宗廟，遷其重器。如之何其可也！天下固畏齊之強也，今又倍地而不行仁政，是動天下之兵也。王速出令，反其旄倪，止其重器，謀於燕衆，置君而後去之，則猶可及止也。」齊王不聽。","content_fanyi":"诸侯们将要谋划援救燕国。齐王对孟子说：“诸侯中有很多在谋划讨伐我，该怎么应对？”孟子回答说：“我听说凭借七十里土地在天下推行政令的，是商王汤；从没听说拥有千里土地反而畏惧别人的。《尚书》说：‘等待我们的君主，君主来了，百姓就能复苏。’如今燕国虐待自己的百姓，大王前往征伐，燕国百姓认为您将把自己从水深火热中拯救出来，于是用竹筐盛着饭食、用壶盛着浆水迎接大王的军队。如果杀害他们的父兄，捆绑他们的子弟，毁坏他们的宗庙，搬走他们的重器，这怎么可以呢！天下本来畏惧齐国的强大，现在又扩大了一倍土地却不施行仁政，这是促使天下各国出兵啊。大王赶快发布命令，放回燕国的老人和孩子，停止搬运他们的重器，与燕国民众商议，选立新的国君然后离开，这样还来得及制止各国出兵。”齐王不肯听从。","content_jianti_auto":"诸侯将谋救燕，齐王谓孟子曰：「诸侯多谋伐寡人者，何以待之？」对曰：「臣闻七十里为政于天下者，汤是也；未闻以千里畏人者也。书曰：『徯我后，后来其苏。』今燕虐其民，王往而征之，民以为将拯己于水火之中也，箪食壶浆以迎王师。若杀其父兄，系累其子弟，毁其宗庙，迁其重器。如之何其可也！天下固畏齐之强也，今又倍地而不行仁政，是动天下之兵也。王速出令，反其旄倪，止其重器，谋于燕众，置君而后去之，则犹可及止也。」齐王不听。","dtjl_paragraph_links":[],"dtjl_references":[],"id":240,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8c6379fd-db0e-11ef-83c3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"平","people_name_jianti_auto":"平","start_index":9,"tongjian_id":"8c637a17-db0e-11ef-847f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":2,"tongjian_id":"8c637a18-db0e-11ef-95fd-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":16,"tongjian_id":"8c637a19-db0e-11ef-a74f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"是時燕人雖未立太子平，固已相帥叛齊矣。","note_content_jianti_auto":"是时燕人虽未立太子平，固已相帅叛齐矣。","note_type":"hu_note","start_index":6,"tongjian_id":"8c637a16-db0e-11ef-ad47-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":5,"chapter_name":"避讳篇第五","chenzhu_chapter":"避讳为民国以前吾国特有之体制，故史书上之记载，有待于以避讳解释者甚众，不讲避讳学，不足以读中国之史也，吾昔撰《史讳举例》问世，职为是焉。胡身之生避讳最盛之朝，熟谙避讳掌故。其撰《通鉴释文辨误後序》，谓：“海陵所刊公休《释文》，以乌桓为乌元。宋朝钦宗讳桓，靖康之初，公休没久矣，安得预为钦宗讳！”即利用避讳以证史书伪讬之一法。其注《通鉴》，以避讳为训释者尤多。兹所采不过数十条，而避讳常识已略具于是矣。","chenzhu_index_in_chapter":3,"chenzhu_text":"此亦避讳称异名。宋太祖父名弘殷。","created_at":"2025-12-31 08:50:44","seq_in_chapter":10,"tongjian_id":"CH05-CZ003"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陳賈","people_name_jianti_auto":"陈贾","start_index":31,"tongjian_id":"8c637a1b-db0e-11ef-8397-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"殷","place_name_jianti_auto":"殷","start_index":1,"tongjian_id":"8c637a1c-db0e-11ef-8bae-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":3,"tongjian_id":"8c637a1d-db0e-11ef-99f1-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":7,"tongjian_id":"8c637a1e-db0e-11ef-b34d-a0d3651f611f"},{"place_name":"殷","place_name_jianti_auto":"殷","start_index":17,"tongjian_id":"8c637a1f-db0e-11ef-89d4-a0d3651f611f"},{"place_name":"亳","place_name_jianti_auto":"亳","start_index":22,"tongjian_id":"8c637a20-db0e-11ef-beb1-a0d3651f611f"},{"place_name":"宋","place_name_jianti_auto":"宋","start_index":50,"tongjian_id":"8c637a21-db0e-11ef-956a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古殷、商通稱，商者，以始封爲國號，殷者，以都亳爲國號。按孟子，陳賈只云「監殷」，今通鑑云「監商」，避宋廟諱也。監，古銜翻。","note_content_jianti_auto":"古殷、商通称，商者，以始封为国号，殷者，以都亳为国号。按孟子，陈贾只云「监殷」，今通鉴云「监商」，避宋庙讳也。监，古衔翻。","note_type":"hu_note","start_index":66,"tongjian_id":"8c637a1a-db0e-11ef-8d29-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"畔，與叛同。與，讀曰歟，下同。","note_content_jianti_auto":"畔，与叛同。与，读曰欤，下同。","note_type":"hu_note","start_index":85,"tongjian_id":"8c637a24-db0e-11ef-8611-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟子","start_index":14,"tongjian_id":"8c637a27-db0e-11ef-bc56-a0d3651f611f"},{"link_td_description":"陈贾，战国时期齐国官员。","link_td_id":"Q10023408","link_td_number_id":8332835,"people_name":"陳賈","people_name_jianti_auto":"陈贾","people_xingming":"陈贾","start_index":18,"tongjian_id":"8c637a28-db0e-11ef-b8e2-a0d3651f611f"},{"lin