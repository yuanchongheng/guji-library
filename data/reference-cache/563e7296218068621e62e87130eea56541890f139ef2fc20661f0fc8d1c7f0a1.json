{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁未、前三一四）","note_content_jianti_auto":"（丁未、前三一四）","note_type":"hu_note","start_index":0,"tongjian_id":"8c6275f4-db0e-11ef-90d7-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":10,"tongjian_id":"8c6275f7-db0e-11ef-8526-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"義渠","place_name_jianti_auto":"义渠","place_note":"甘肅西峰","start_index":0,"tongjian_id":"8c6275f8-db0e-11ef-a8b7-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":17,"tongjian_id":"8c6275f9-db0e-11ef-b990-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","start_index":19,"tongjian_id":"8c6275fa-db0e-11ef-8c0d-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","start_index":31,"tongjian_id":"8c6275fb-db0e-11ef-8111-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":50,"tongjian_id":"8c6275fc-db0e-11ef-ae9c-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","start_index":52,"tongjian_id":"8c6275fd-db0e-11ef-a12b-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":65,"tongjian_id":"8c6275fe-db0e-11ef-9814-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","place_note":"甘肅西峰","start_index":67,"tongjian_id":"8c6275ff-db0e-11ef-ac6e-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":75,"tongjian_id":"8c627600-db0e-11ef-94d5-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","place_note":"甘肅西峰","start_index":90,"tongjian_id":"8c627601-db0e-11ef-9846-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":101,"tongjian_id":"8c627602-db0e-11ef-b8b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"義渠，戎國名。按上卷顯王四十二年，秦縣義渠，以其君爲臣，是已得義渠矣。今又侵得二十五城，何也？蓋先此秦以義渠爲縣，君爲臣，雖臣屬於秦，義渠之國未滅也，秦稍蠶食侵其地。今得二十五城，義渠之國所餘無幾矣。蓋秦兼幷諸侯，不盡其國不止也。左傳：有鐘鼓曰伐，無曰侵。穀梁傳：苞人民、驅牛馬曰侵。斬樹木、壞宮室曰伐。無幾，居豈翻。傳，直戀翻。壞，音怪。","note_content_jianti_auto":"义渠，戎国名。按上卷显王四十二年，秦县义渠，以其君为臣，是已得义渠矣。今又侵得二十五城，何也？盖先此秦以义渠为县，君为臣，虽臣属于秦，义渠之国未灭也，秦稍蚕食侵其地。今得二十五城，义渠之国所余无几矣。盖秦兼幷诸侯，不尽其国不止也。左传：有钟鼓曰伐，无曰侵。谷梁传：苞人民、驱牛马曰侵。斩树木、坏宫室曰伐。无几，居岂翻。传，直恋翻。坏，音怪。","note_type":"hu_note","start_index":13,"tongjian_id":"8c6275f6-db0e-11ef-b70c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c627605-db0e-11ef-a717-a0d3651f611f"},{"place_name":"義渠","place_name_jianti_auto":"义渠","place_note":"甘肅西峰","resolved_place_entity_id":2723,"start_index":4,"tongjian_id":"8c627606-db0e-11ef-8cd9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1秦人侵義渠，得二十五城。","content_fanyi":"秦国侵犯义渠，攻取了二十五座城池。","content_jianti_auto":"1秦人侵义渠，得二十五城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":236,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c6275f5-db0e-11ef-9d3a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":16,"tongjian_id":"8c627609-db0e-11ef-b675-a0d3651f611f"}],"E