[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4九月，戊寅，扶風武王駿薨。","content_fanyi":"九月戊寅日，扶风武王司马骏逝世。","content_jianti_auto":"4九月，戊寅，扶风武王骏薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6990,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"9d0a5e4b-db0e-11ef-85f6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"都督關中諸軍事","official_note":"都督是魏晋南北朝时期的高级军事官职，负责特定区域的军事指挥和防御。此处“都督關中諸軍事”表示隴西王泰被任命为关中地区的军事都督，负责该地区的军事事务，反映了晋朝对关中地区的军事控制。","official_rank":"未知","source_snippet":"都督關中諸軍事","start_index":18,"tongjian_id":"c8773db2-449d-4b47-bc92-d81a7c572fce"}],"ExtRef_Children_people":[{"link_death_year":299,"link_td_description":"司马泰，字子舒，司马馗之子，彭城穆王司马权之弟。","link_td_id":"Q10010354","link_td_number_id":1026418,"people_name":"隴西王","people_name_jianti_auto":"陇西王","people_xingming":"司马泰","start_index":11,"tongjian_id":"9d0a5e50-db0e-11ef-b108-a0d3651f611f"},{"link_death_year":299,"link_td_description":"司马泰，字子舒，司马馗之子，彭城穆王司马权之弟。","link_td_id":"Q10010354","link_td_number_id":1026418,"people_name":"泰","people_name_jianti_auto":"泰","start_index":14,"tongjian_id":"9d0a5e51-db0e-11ef-b624-a0d3651f611f"},{"link_death_year":299,"link_td_description":"司马泰，字子舒，司马馗之子，彭城穆王司马权之弟。","link_td_id":"Q10010354","link_td_number_id":1026418,"people_name":"泰","people_name_jianti_auto":"泰","people_xingming":"司马泰","start_index":23,"tongjian_id":"9d0a5e52-db0e-11ef-892c-a0d3651f611f"},{"link_birth_year":179,"link_death_year":251,"link_td_description":"司马懿，字仲达，河内郡温县（今河南省焦作市温县）人，三国时期曹魏太傅、政治家、军事家，亦是日后西晋的奠基人。","link_td_id":"Q10000082","link_td_number_id":49432,"people_name":"宣帝","people_name_jianti_auto":"宣帝","people_xingming":"司马懿","start_index":25,"tongjian_id":"9d0a5e53-d