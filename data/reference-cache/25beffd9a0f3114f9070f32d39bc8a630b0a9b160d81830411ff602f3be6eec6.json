{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丙午、二八六）","note_content_jianti_auto":"（丙午、二八六）","note_type":"hu_note","start_index":0,"tongjian_id":"9d089d0c-db0e-11ef-8f41-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"舒","people_name_jianti_auto":"舒","start_index":4,"tongjian_id":"9d089d0f-db0e-11ef-9c28-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舒遜位，紀、傳皆無年月。本傳曰：「以災異遜位，帝不聽；後因正旦朝罷還第，表送章綬。」本傳又曰：「遜位之際，人莫知者。」若今年正旦日食遜位，至他年正旦乃送章綬，不云「人無知者」。蓋止因今者正旦朝罷，遂以災異遜位，不復起耳。","note_content_jianti_auto":"考异曰：舒逊位，纪、传皆无年月。本传曰：「以灾异逊位，帝不听；后因正旦朝罢还第，表送章绶。」本传又曰：「逊位之际，人莫知者。」若今年正旦日食逊位，至他年正旦乃送章绶，不云「人无知者」。盖止因今者正旦朝罢，遂以灾异逊位，不复起耳。","note_type":"hu_note","start_index":52,"tongjian_id":"9d089d0e-db0e-11ef-95f2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"瓘","people_name_jianti_auto":"瓘","start_index":0,"tongjian_id":"9d089d16-db0e-11ef-83ba-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"瓘言亦欲遜位，與共論此事，日復一日，未果如言。","note_content_jianti_auto":"瓘言亦欲逊位，与共论此事，日复一日，未果如言。","note_type":"hu_note","start_index":74,"tongjian_id":"9d089d15-db0e-11ef-a192-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"顏淵","people_name_jianti_auto":"