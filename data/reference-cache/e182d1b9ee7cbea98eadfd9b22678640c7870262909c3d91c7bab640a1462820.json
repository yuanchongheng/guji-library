{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛卯、前一五○）","note_content_jianti_auto":"（辛卯、前一五○）","note_type":"hu_note","start_index":0,"tongjian_id":"8f340bda-db0e-11ef-a628-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"储君","official_name":"太子","official_note":"太子是皇位继承人，此处指刘荣被废黜太子之位，改封为临江王，反映了汉景帝时期的宫廷斗争。","official_rank":"未知","source_snippet":"廢太子榮爲臨江王","start_index":12,"tongjian_id":"af4c37ee-f8a0-4509-8af5-0eb0c6d4020c"},{"confidence":0.9,"official_category":"地方行政","official_name":"臨江王","official_note":"临江王是汉代封爵，属于地方诸侯王，此处表示刘荣被废黜太子后改封此爵，体现了政治地位的下降。","official_rank":"诸侯王","source_snippet":"廢太子榮爲臨江王","start_index":17,"tongjian_id":"d1a5bf54-909c-4b2c-9633-74c6748ed983"},{"confidence":0.85,"official_category":"文教","official_name":"太子太傅","official_note":"太子太傅是负责教导太子的官员，此处窦婴作为太子太傅为刘荣力争但失败，反映了他在宫廷中的角色和影响力。","official_rank":"高级官员","source_snippet":"太子太傅竇嬰力爭不能得","start_index":22,"tongjian_id":"1f2ea540-f048-4724-8ff8-78e30da7ebbe"}],"ExtRef_Children_people":[{"people_name":"榮","people_name_jianti_auto":"荣","people_xingming":"刘荣","start_index":13,"tongjian_id":"8f340bdc-db0e-11ef-a790-a0d3651f611f"},{"people_name":"臨江王","people_name_jianti_auto":"临江王","people_xingming":"刘荣","start_index":15,"tongjian_id":"8f340bdd-db0e-11ef-a088-a0d3651f611f"},{"link_death_year":-131,"link_td_description":"窦婴，清河郡觀津縣（今河北省衡水市武邑县）人，西汉政治人物，是汉文帝皇后窦氏堂兄之子，以军功封魏其侯，后因与武安侯田蚡不和，被以「伪造诏书罪」斩首。","link_td_id":"Q10000764","link_td_number_id":358768,"people_name":"竇嬰","people_name_jianti_auto":"窦婴","people_xingming":"窦婴","start_index":23,"tongjian_id":"8f340bde-db0e-11ef-a5d9-a0d3651f611f"},{"link_death_year":-148,"link_td_description":"栗姬，汉景帝姬妾之一，齐国人，美貌出众，她为景帝生下刘荣、刘德、刘阏于三个儿子。","link_td_id":"Q10008273","link_td_number_id":183170,"people_name":"栗姬","people_name_jianti_auto":"栗姬","people_xingming":"栗姬","start_index":36,"tongjian_id":"8f340bdf-db0e-11ef-b6a2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"1冬，十一月，己酉，廢太子榮爲臨江王。太子太傅竇嬰力爭不能得，乃謝病免。栗姬恚恨而死。","content_fanyi":"冬季，十一月，己酉（疑误），汉景帝刘启将太子刘荣废去，改封为临江王。太子太傅窦婴极力谏争，仍不能改变汉景帝的决定，便自称有病，请求免职。栗姬愤恨而死。","content_jianti_auto":"1冬，十一月，己酉，废太子荣为临江王。太子太傅窦婴力争不能得，乃谢病免。栗姬恚恨而死。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1287,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f340bdb-db0e-11ef-ac5b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2庚寅晦，日有食之。","content_fanyi":"十一月三十日庚寅晦，出现日食。","content_jianti_auto":"2庚寅晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1288,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f340be0-db0e-11ef-8b81-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处陶青被免职，表示人事变动。","official_rank":"正一品","source_snippet":"丞相陶青免","start_index":3,"tongjian_id":"d7d14eb3-c96c-4158-a657-e1026a35f672"},{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代最高军事长官，掌管全国军事，此处周亚夫由太尉转任丞相，显示官职调整。","official_rank":"正一品","source_snippet":"太尉周亞夫爲丞相","start_index":12,"tongjian_id":"c05e4d27-6b01-40b3-9156-5058a921b3e0"},{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，此处周亚夫被任命为丞相，接替陶青的职位。","official_rank":"正一品","source_snippet":"太尉周亞夫爲丞相","start_index":18,"tongjian_id":"efd72bd4-e330-4049-a295-733c8ad085fb"},{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代最高军事长官，此处官职被废除，反映汉代官制改革或权力调整。","official_rank":"正一品","source_snippet":"罷太尉官","start_index":21,"tongjian_id":"063e5809-5556-425a-90a5-43d93fa818f1"}],"ExtRef_Children_people":[{"link_death_year":-148,"link_td_description":"陶青，西汉丞相，第二代开封侯，谥曰夷。","link_td_id":"Q10012612","link_td_number_id":1492351,"people_name":"陶青","people_name_jianti_auto":"陶青","people_xingming":"陶青","start_index":6,"tongjian_id":"8f340be2-db0e-11ef-af10-a0d3651f611f"},{"link_death_year":-143,"link_td_description":"周亚夫，西汉沛郡丰县（今江苏省徐州市丰县）人，为太尉周勃之子。汉文帝时，曾任河内郡太守，获封条侯。汉文帝后元六年为将军，领兵驻守细柳，防备入侵的匈奴大军，期间治军严谨，深获汉文帝赞赏。汉景帝即位后，周亚夫为车骑将军，并于七国之乱时，率军平定吴王刘濞、楚王刘戊等反叛的诸国联军，五年后接替陶青担任丞相，任上因不赞同废黜栗太子刘荣，以及反对封王信、唯徐卢等人为列侯得罪于汉景帝，加上梁孝王刘武多次在窦太后面前说周亚夫的不是，由此日渐失势而罢相。其后周亚夫因儿子遭人控告谋反受牵连，被关入监狱交由廷尉审判，最终周亚夫在狱中绝食五日，呕血而死。","link_td_id":"Q10008095","link_td_number_id":95189,"people_name":"周亞夫","people_name_jianti_auto":"周亚夫","people_xingming":"周亚夫","start_index":15,"tongjian_id":"8f340be3-db0e-11ef-a7b4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉景帝忍杀","excerpts":[{"context_after":"，昧于敬礼大臣之义，卒以非罪置之死，悲哉！光武遣冯异征赤...","context_before":"...比三百石以上皆杀，无有所置，敢有议诏及不如诏者，皆要斩。","source_end_index":204,"source_paragraph_tongjian_id":"cacd21d2-9a03-4795-b052-6d39a46cbef6","source_start_index":170,"source_text":"周亚夫以功为丞相，坐争封匈奴降将事病免，心恶之，赐食不置箸，叱之使起"}],"path":"随笔/卷十一/汉景帝忍杀","source_name":"容斋随笔"}],"class_tags":["人事"],"content":"3二月，丞相陶青免。乙巳，太尉周亞夫爲丞相。罷太尉官。","content_fanyi":"二月，丞相陶青被罢免。十六日乙巳，太尉周亚夫出任丞相。汉景帝下诏罢黜太尉这一官职。","content_jianti_auto":"3二月，丞相陶青免。乙巳，太尉周亚夫为丞相。罢太尉官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1289,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f340be1-db0e-11ef-bcd4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-126,"link_td_description":"孝景皇后王娡，右扶风槐里人，汉景帝刘启第二任皇后。生修成君金俗、平阳公主、汉武帝刘彻、南宫公主、隆虑公主。","link_td_id":"Q10002434","link_td_number_id":116887,"people_name":"王氏","people_name_jianti_auto":"王氏","people_xingming":"王娡","start_index":12,"tongjian_id":"8f340be5-db0e-11ef-b3ac-a0d3651f611f","wl_zhushi":"[王娡]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4夏，四月，乙巳，立皇后王氏。","content_fanyi":"夏季四月，乙巳日，也就是十七日，汉景帝立王氏为皇后。","content_jianti_auto":"4夏，四月，乙巳，立皇后王氏。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1290,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8f340be4-db0e-11ef-a44e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"膠東王","people_name_jianti_auto":"胶东王","people_xingming":"刘彻","start_index":5,"tongjian_id":"8f340be7-db0e-11ef-b618-a0d3651f611f"},{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"徹","people_name_jianti_auto":"彻","people_xingming":"刘彻","start_index":8,"tongjian_id":"8f340be8-db0e-11ef-81b3-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"5丁巳，立膠東王徹爲皇太子。","content_fanyi":"四月二十九日丁巳，汉景帝将胶东王刘彻立为皇太子。","content_jianti_auto":"5丁巳，立胶东王彻为皇太子。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1291,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8f340be6-db0e-11ef-b886-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉舍","people_name_jianti_auto":"刘舍","start_index":0,"tongjian_id":"8f340beb-db0e-11ef-a964-a0d3651f611f"},{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":3,"tongjian_id":"8f340bec-db0e-11ef-b107-a0d3651f611f"},{"people_name":"桃安侯","people_name_jianti_auto":"桃安侯","start_index":7,"tongjian_id":"8f340bed-db0e-11ef-82b7-a0d3651f611f"},{"people_name":"劉襄","people_name_jianti_auto":"刘襄","start_index":10,"tongjian_id":"8f340bee-db0e-11ef-ad59-a0d3651f611f"},{"people_name":"襄","people_name_jianti_auto":"襄","start_index":15,"tongjian_id":"8f340bef-db0e-11ef-969f-a0d3651f611f"},{"people_name":"項氏","people_name_jianti_auto":"项氏","start_index":17,"tongjian_id":"8f340bf0-db0e-11ef-9a56-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉舍，高祖功臣桃安侯劉襄之子。襄本項氏，親賜姓。","note_content_jianti_auto":"刘舍，高祖功臣桃安侯刘襄之子。襄本项氏，亲赐姓。","note_type":"hu_note","start_index":15,"tongjian_id":"8f340bea-db0e-11ef-97dd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"濟南王","people_name_jianti_auto":"济南王","start_index":0,"tongjian_id":"8f340bf2-db0e-11ef-87f8-a0d3651f611f"},{"people_name":"辟光","people_name_jianti_auto":"辟光","start_index":3,"tongjian_id":"8f340bf3-db0e-11ef-b875-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"郅","place_name_jianti_auto":"郅","start_index":22,"tongjian_id":"8f340bf4-db0e-11ef-97cf-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":24,"tongjian_id":"8f340bf5-db0e-11ef-95f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"濟南王辟光反，國除爲郡。郅，之日翻。風俗通：郅，商時侯國，後以爲氏。","note_content_jianti_auto":"济南王辟光反，国除为郡。郅，之日翻。风俗通：郅，商时侯国，后以为氏。","note_type":"hu_note","start_index":25,"tongjian_id":"8f340bf1-db0e-11ef-b5d6-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"太僕","official_note":"太僕是汉代九卿之一，掌管皇帝车马及马政，此处刘舍从太僕升迁为御史大夫，反映了官职变动。","official_rank":"九卿之一","source_snippet":"以太僕劉舍爲御史大夫","start_index":6,"tongjian_id":"bad839a8-0c9c-4de5-8fdc-621a84b3efdd"},{"confidence":0.9,"official_category":"监察","official_name":"御史大夫","official_note":"御史大夫是汉代三公之一，负责监察百官，此处刘舍被任命为此职，显示其晋升至高级官职。","official_rank":"三公之一","source_snippet":"以太僕劉舍爲御史大夫","start_index":12,"tongjian_id":"702ad2a8-d2f2-474c-b2c9-b2792e9c76bf"},{"confidence":0.9,"official_category":"地方行政","official_name":"濟南太守","official_note":"濟南太守是汉代地方行政长官，掌管济南郡事务，此处郅都由此职调任为中尉，体现了地方与中央官职的调动。","official_rank":"郡守","source_snippet":"濟南太守郅都爲中尉","start_index":18,"tongjian_id":"e339c409-0d93-4057-b16b-0cb678bdacd5"},{"confidence":0.9,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉是汉代九卿之一，负责京师治安和军事，此处郅都被任命为此职，可能与其执法严酷的历史背景相关。","official_rank":"九卿之一","source_snippet":"濟南太守郅都爲中尉","start_index":24,"tongjian_id":"f5b98dc8-f687-4191-872a-e4058451d574"}],"ExtRef_Children_people":[{"link_death_year":-140,"link_td_description":"刘舍，西汉丞相，桃哀侯。本项羽之亲，项羽败亡后，其宗亲皆赦不诛。刘舍之父项襄以功封桃侯，并被赐姓刘氏。","link_td_id":"Q10012626","link_td_number_id":1492352,"people_name":"劉舍","people_name_jianti_auto":"刘舍","people_xingming":"刘舍","start_index":7,"tongjian_id":"8f340bf7-db0e-11ef-8615-a0d3651f611f"},{"link_death_year":-145,"link_td_description":"郅都，河东郡杨县（今山西省洪洞县东南）人，西汉政治家、军事家。汉文帝时任郎官，汉景帝时先后任中郎将、济南郡太守、中尉、雁门郡太守。郅都任中尉时执法严格、不避权贵，人称“苍鹰”；任雁门太守时使匈奴闻名丧胆，被称为“战克之将，国之爪牙”。","link_td_id":"Q10008878","link_td_number_id":433642,"people_name":"郅都","people_name_jianti_auto":"郅都","people_xingming":"郅都","start_index":19,"tongjian_id":"8f340bf8-db0e-11ef-9a3b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"濟南","place_name_jianti_auto":"济南","place_note":"山东章丘","resolved_place_entity_id":859,"start_index":15,"tongjian_id":"8f340bf9-db0e-11ef-b632-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"6是歲，以太僕劉舍爲御史大夫，濟南太守郅都爲中尉。","content_fanyi":"这一年，汉景帝任命太仆刘舍担任御史大夫，任命济南郡太守郅都担任中尉。","content_jianti_auto":"6是岁，以太仆刘舍为御史大夫，济南太守郅都为中尉。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，则假法于残忍之小人，姑宽为之法，以使愚民轻于蹈阱，而幸...","context_before":"...不能决，移谳廷尉，谳而后谳不当，谳者不为失，立法宽矣。乃","source_end_index":91,"source_paragraph_tongjian_id":"a6dc567b-e40a-4e7d-974e-980e04d582a3","source_start_index":81,"source_text":"郅都、宁成相继为中尉"}],"title":"五 法宽而任鸷击之吏不如法严而任宽仁之吏"}],"id":1292,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8f340be9-db0e-11ef-b5f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈姬","people_name_jianti_auto":"贾姬","start_index":0,"tongjian_id":"8f340bfc-db0e-11ef-a65e-a0d3651f611f"},{"people_name