":"智氏","people_name_jianti_auto":"智氏","start_index":61,"tongjian_id":"8be647cc-db0e-11ef-bef6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":8,"tongjian_id":"8be647cd-db0e-11ef-9f55-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：智宣子，晉卿荀躒之子申也。瑤，宣子之子智伯也，諡曰襄子。智果，智氏之族也。宵，宣子之庶子也。按諡法：聖善周聞曰宣。智氏溢美也。","note_content_jianti_auto":"韦昭曰：智宣子，晋卿荀跞之子申也。瑶，宣子之子智伯也，谥曰襄子。智果，智氏之族也。宵，宣子之庶子也。按谥法：圣善周闻曰宣。智氏溢美也。","note_type":"hu_note","start_index":22,"tongjian_id":"8be647bf-db0e-11ef-b90b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8be647d0-db0e-11ef-aa07-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：不仁也。","note_content_jianti_auto":"韦昭曰：不仁也。","note_type":"hu_note","start_index":37,"tongjian_id":"8be647cf-db0e-11ef-b414-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8be647d5-db0e-11ef-84e1-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":13,"tongjian_id":"8be647d6-db0e-11ef-a648-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本正作「鬢」；孔本同。乙十一行本作「鬚」。』","note_content_jianti_auto":"『章：十二行本正作「鬓」；孔本同。乙十一行本作「须」。』","note_type":"『章：[^』]*』","start_index":28,"tongjian_id":"8be647d4-db0e-11ef-b8d9-a0d3651f611f"}],"note_content":"通鑑俗傳寫者多作「美鬚」，非也。國語作「美鬢」，今從之。","note_content_jianti_auto":"通鉴俗传写者多作「美须」，非也。国语作「美鬓」，今从之。","note_type":"hu_note","start_index":44,"tongjian_id":"8be647d1-db0e-11ef-a73e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8be647d8-db0e-11ef-8f71-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：給，足也。巧文，巧於文辭。伎，渠綺翻。","note_content_jianti_auto":"韦昭曰：给，足也。巧文，巧于文辞。伎，渠绮翻。","note_type":"hu_note","start_index":65,"tongjian_id":"8be647d7-db0e-11ef-9e37-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8be647da-db0e-11ef-8e7e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：待，猶假也。","note_content_jianti_auto":"韦昭曰：待，犹假也。","note_type":"hu_note","start_index":99,"tongjian_id":"8be647d9-db0e-11ef-9015-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"哀公","people_name_jianti_auto":"哀公","start_index":9,"tongjian_id":"8be7f567-db0e-11ef-b7a8-a0d3651f611f"},{"people_name":"荀瑤","people_name_jianti_auto":"荀瑶","start_index":17,"tongjian_id":"8be7f568-db0e-11ef-af50-a0d3651f611f"},{"people_name":"哀","people_name_jianti_auto":"哀","start_index":27,"tongjian_id":"8be7f569-db0e-11ef-af85-a0d3651f611f"},{"people_name":"元王","people_name_jianti_auto":"元王","start_index":35,"tongjian_id":"8be7f56a-db0e-11ef-9bc2-a0d3651f611f"},{"people_name":"荀躒","people_name_jianti_auto":"荀跞","start_index":41,"tongjian_id":"8be7f56b-db0e-11ef-8b90-a0d3651f611f"},{"people_name":"智文子","people_name_jianti_auto":"智文子","start_index":44,"tongjian_id":"8be7f56c-db0e-11ef-af5c-a0d3651f611f"},{"people_name":"定","people_name_jianti_auto":"定","start_index":49,"tongjian_id":"8be7f56d-db0e-11ef-a339-a0d3651f611f"},{"people_name":"智文子","people_name_jianti_auto":"智文子","start_index":54,"tongjian_id":"8be7f56e-db0e-11ef-90a9-a0d3651f611f"},{"people_name":"智宣子","people_name_jianti_auto":"智宣子","start_index":62,"tongjian_id":"8be7f56f-db0e-11ef-8488-a0d3651f611f"},{"people_name":"瑤","people_name_jianti_auto":"瑶","start_index":74,"tongjian_id":"8be7f570-db0e-11ef-964e-a0d3651f611f"},{"people_name":"元王","people_name_jianti_auto":"元王","start_index":80,"tongjian_id":"8be7f571-db0e-11ef-89c2-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":87,"tongjian_id":"8be7f572-db0e-11ef-af0d-a0d3651f611f"},{"people_name":"鄭司農","people_name_jianti_auto":"郑司农","start_index":115,"tongjian_id":"8be7f573-db0e-11ef-be52-a0d3651f611f"},{"people_name":"韓宣子","people_name_jianti_auto":"韩宣子","start_index":127,"tongjian_id":"8be7f574-db0e-11ef-8515-a0d3651f611f"},{"people_name":"賈公彥","people_name_jianti_auto":"贾公彦","start_index":159,"tongjian_id":"8be7f575-db0e-11ef-a100-a0d3651f611f"},{"people_name":"智果","people_name_jianti_auto":"智果","start_index":205,"tongjian_id":"8be7f576-db0e-11ef-b94c-a0d3651f611f"},{"people_name":"智氏","people_name_jianti_auto":"智氏","start_index":209,"tongjian_id":"8be7f577-db0e-11ef-b07e-a0d3651f611f"},{"people_name":"宋祁","people_name_jianti_auto":"宋祁","start_index":221,"tongjian_id":"8be7f578-db0e-11ef-a6fe-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":16,"tongjian_id":"8be7f579-db0e-11ef-b6ec-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":20,"tongjian_id":"8be7f57a-db0e-11ef-bb36-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":131,"tongjian_id":"8be7f57b-db0e-11ef-8c25-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":187,"tongjian_id":"8be7f57c-db0e-11ef-a711-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此事見國語。按左傳哀公二十三年，晉荀瑤伐齊，始見于傳。哀二十三年，史記元王五年也。荀躒，智文子也。定十四年，智文子猶見于傳。智宣子之事，傳無所考。立瑤之議，當在元王五年之前。韋昭曰：太史掌氏姓，周禮春官之屬；小史掌定世繫，辨昭穆。鄭司農註云：史官主書，故韓宣子聘魯，觀書于太史。世繫，謂帝繫、世本之屬是也；小史主定之。賈公彥疏曰：註引太史證之者，太史史官之長，共其事故也。蓋周之制，小史定姓氏，其書則太史掌之。智果欲避智氏之禍，故於太史別族。宋祁國語補音：別，彼列翻；又如字。","note_content_jianti_auto":"此事见国语。按左传哀公二十三年，晋荀瑶伐齐，始见于传。哀二十三年，史记元王五年也。荀跞，智文子也。定十四年，智文子犹见于传。智宣子之事，传无所考。立瑶之议，当在元王五年之前。韦昭曰：太史掌氏姓，周礼春官之属；小史掌定世系，辨昭穆。郑司农注云：史官主书，故韩宣子聘鲁，观书于太史。世系，谓帝系、世本之属是也；小史主定之。贾公彦疏曰：注引太史证之者，太史史官之长，共其事故也。盖周之制，小史定姓氏，其书则太史掌之。智果欲避智氏之祸，故于太史别族。宋祁国语补音：别，彼列翻；又如字。","note_type":"hu_note","start_index":126,"tongjian_id":"8be647db-db0e-11ef-9d40-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"荀申，中国春秋时期晋国政治人物，荀氏、智氏（知氏）第六代家主，又称知申、智申，当时晋国的中军将荀跞之子。公元前493年，荀跞去世后，荀申继承知氏之位，为下军佐，与赵鞅一起执政。荀申去世后，谥号知宣子、智宣子。","link_td_id":"Q10002710","link_td_number_id":1521072,"people_name":"智宣子","people_name_jianti_auto":"智宣子","people_xingming":"智申","start_index":3,"tongjian_id":"8be87e8c-db0e-11ef-8b4a-a0d3651f611f","wl_zhushi":"[智申]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2初，智宣子將以瑤爲後，智果曰：「不如宵也。瑤之賢於人者五，其不逮者一也。美鬢長大則賢，射御足力則賢，伎藝畢給則賢，巧文辯惠則賢，強毅果敢則賢；如是而甚不仁。夫以其五賢陵人而以不仁行之，其誰能待之？若果立瑤也，智宗必滅。」弗聽。智果別族於太史，爲輔氏。","content_fanyi":"当初，晋国的智宣子准备立智瑶为继承人，智果说：“不如立智宵。智瑶比别人贤能的地方有五项，不如别人的地方只有一项：鬓发漂亮、身材高大，是贤能；射箭驾车很有力气，是贤能；各种技艺无不齐备，是贤能；文辞巧妙、论辩聪慧，是贤能；坚强果敢、刚毅果断，是贤能。即使这样，他却很不仁。如果凭这五项贤能凌驾别人，又用不仁的方式去做，谁还能容得下他呢？如果果真立智瑶为继承人，智氏宗族必定灭亡。”智宣子不听。智果就到太史那里办理脱离智族姓氏的手续，自立为辅氏。","content_jianti_auto":"2初，智宣子将以瑶为后，智果曰：「不如宵也。瑶之贤于人者五，其不逮者一也。美鬓长大则贤，射御足力则贤，伎艺毕给则贤，巧文辩惠则贤，强毅果敢则贤；如是而甚不仁。夫以其五贤陵人而以不仁行之，其谁能待之？若果立瑶也，智宗必灭。」弗听。智果别族于太史，为辅氏。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"8be647be-db0e-11ef-8cea-a0d3651f611f","year_int":-403},"tongjian_id":"8be647be-db0e-11ef-8cea-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否采纳智国的谏言，防备韩、魏的报复","decision_tongjian_id":"DECISION_8BE8AB8BDB0E11EF8705A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉國","place_name_jianti_auto":"晋国","start_index":14,"tongjian_id":"8be8ab8e-db0e-11ef-8da1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：有勞定國曰襄。爲政，爲晉國之政。","note_content_jianti_auto":"谥法：有劳定国曰襄。为政，为晋国之政。","note_type":"hu_note","start_index":12,"tongjian_id":"8be8ab8d-db0e-11ef-9e7c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓康子","people_name_jianti_auto":"韩康子","start_index":0,"tongjian_id":"8be8ab91-db0e-11ef-a031-a0d3651f611f"},{"people_name":"韓宣子","people_name_jianti_auto":"韩宣子","start_index":4,"tongjian_id":"8be8ab92-db0e-11ef-b38e-a0d3651f611f"},{"people_name":"莊子","people_name_jianti_auto":"庄子","start_index":10,"tongjian_id":"8be8ab93-db0e-11ef-aacd-a0d3651f611f"},{"people_name":"魏桓子","people_name_jianti_auto":"魏桓子","start_index":18,"tongjian_id":"8be8ab94-db0e-11ef-bf18-a0d3651f611f"},{"people_name":"魏獻子","people_name_jianti_auto":"魏献子","start_index":22,"tongjian_id":"8be8ab95-db0e-11ef-a69f-a0d3651f611f"},{"people_name":"曼多","people_name_jianti_auto":"曼多","start_index":27,"tongjian_id":"8be8ab96-db0e-11ef-88c9-a0d3651f611f"},{"people_name":"駒","people_name_jianti_auto":"驹","start_index":31,"tongjian_id":"8be8ab97-db0e-11ef-9e97-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓康子，韓宣子之曾孫莊子之子虔虎也。魏桓子，魏獻子之子曼多之孫駒也。諡法：溫柔好樂曰康；辟土服遠曰桓。爾雅：四方而高曰臺。","note_content_jianti_auto":"韩康子，韩宣子之曾孙庄子之子虔虎也。魏桓子，魏献子之子曼多之孙驹也。谥法：温柔好乐曰康；辟土服远曰桓。尔雅：四方而高曰台。","note_type":"hu_note","start_index":25,"tongjian_id":"8be8ab90-db0e-11ef-89a0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"段","people_name_jianti_auto":"段","start_index":3,"tongjian_id":"8be8ab9b-db0e-11ef-8ac6-a0d3651f611f"},{"people_name":"鄭共叔段","people_name_jianti_auto":"郑共叔段","start_index":5,"tongjian_id":"8be8ab9c-db0e-11ef-9824-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：段，鄭共叔段之後。","note_content_jianti_auto":"姓谱：段，郑共叔段之后。","note_type":"hu_note","start_index":35,"tongjian_id":"8be8ab9a-db0e-11ef-aff3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8be8aba0-db0e-11ef-a424-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本無「難」字；乙十一行本同。』","note_content_jianti_auto":"『章：十二行本无「难」字；乙十一行本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8be8ab9f-db0e-11ef-bb07-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":49,"tongjian_id":"8be8ab9e-db0e-11ef-9d29-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":0,"tongjian_id":"8be8aba2-db0e-11ef-a0de-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋以來，大夫之家臣謂大夫曰主。難，乃旦翻；下同。","note_content_jianti_auto":"春秋以来，大夫之家臣谓大夫曰主。难，乃旦翻；下同。","note_type":"hu_note","start_index":55,"tongjian_id":"8be8aba1-db0e-11ef-8a3f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"書·五子之歌之辭。夏，戶雅翻。見，賢遍翻，發見也，著也，形也。","note_content_jianti_auto":"书·五子之歌之辞。夏，户雅翻。见，贤遍翻，发见也，著也，形也。","note_type":"hu_note","start_index":105,"tongjian_id":"8be8aba3-db0e-11ef-a656-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"段規","people_name_jianti_auto":"段规","start_index":5,"tongjian_id":"8be8aba6-db0e-11ef-80cb-a0d3651f611f"},{"people_name":"韓康子","people_name_jianti_auto":"韩康子","start_index":8,"tongjian_id":"8be8aba7-db0e-11ef-92ba-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。段規，韓康子之相也。相，息醬翻；下同。","note_content_jianti_auto":"夫，音扶。段规，韩康子之相也。相，息酱翻；下同。","note_type":"hu_note","start_index":129,"tongjian_id":"8be8aba5-db0e-11ef-86f7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋祁","people_name_jianti_auto":"宋祁","start_index":0,"tongjian_id":"8be8aba9-db0e-11ef-ab05-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府雍县，陕西凤翔","start_index":18,"tongjian_id":"8be8abaa-db0e-11ef-9f4b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宋祁曰：蜹，如銳翻；又字林：人劣翻。秦人謂蚊爲蜹。今按：蜹，小蟲，日中羣集人之肌膚而嘬其血，蚊之類也。蜂，細腰而能螫人。蠆亦毒蟲，長尾，音丑邁翻。","note_content_jianti_auto":"宋祁曰：蜹，如锐翻；又字林：人劣翻。秦人谓蚊为蜹。今按：蜹，小虫，日中群集人之肌肤而嘬其血，蚊之类也。蜂，细腰而能螫人。虿亦毒虫，长尾，音丑迈翻。","note_type":"hu_note","start_index":160,"tongjian_id":"8be8aba8-db0e-11ef-8afb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"荀申，中国春秋时期晋国政治人物，荀氏、智氏（知氏）第六代家主，又称知申、智申，当时晋国的中军将荀跞之子。公元前493年，荀跞去世后，荀申继承知氏之位，为下军佐，与赵鞅一起执政。荀申去世后，谥号知宣子、智宣子。","link_td_id":"Q10002710","link_td_number_id":1521072,"people_name":"智宣子","people_name_jianti_auto":"智宣子","people_xingming":"智申","start_index":1,"tongjian_id":"8be8abac-db0e-11ef-a399-a0d3651f611f","wl_zhushi":"[智申]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8be8ab8b-db0e-11ef-8705-a0d3651f611f","pinyin":"ruì","source_anchor_text":"乃不可乎蜹蟻蜂蠆皆","source_key":"baiyang_epub","start_index":147,"text":"蜹","tongjian_id":"6e49d4c5-6e05-5bba-b663-2472eb174c39"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"及智宣子卒，智襄子爲政，與韓康子、魏桓子宴於藍臺。智伯戲康子而侮段規。智國聞之，諫曰：「主不備難，難必至矣！」智伯曰：「難將由我。我不爲難，誰敢興之！」對曰：「不然。夏書有之：『一人三失，怨豈在明，不見是圖。』夫君子能勤小物，故無大患。今主一宴而恥人之君相，又弗備，曰『不敢興難』，無乃不可乎！蜹、蟻、蜂、蠆，皆能害人，況君相乎！」弗聽。","content_fanyi":"智宣子去世后，智襄子智瑶执掌国政，与韩康子、魏桓子在蓝台宴饮。席间智瑶戏弄韩康子，又羞辱韩康子的家相段规。智瑶的家臣智国听说后，进谏说：“主公如果不防备祸难，祸难一定会到来！”智瑶说：“祸难由我作主。我不降祸，谁敢发难！”智国回答说：“并非如此。《夏书》上有这样的话：‘一个人屡次犯错，怨仇岂会只在明处，应在尚未显现时就设法防备。’君子能够勤谨地对待小事，所以没有大的祸患。如今主公因一次宴饮就羞辱人家的国君与国相，又不加防备，还说‘他们不敢发难’，恐怕不可以吧！蚊子、蚂蚁、黄蜂、蝎子都能伤害人，何况是国君和国相呢！”智瑶不听。","content_jianti_auto":"及智宣子卒，智襄子为政，与韩康子、魏桓子宴于蓝台。智伯戏康子而侮段规。智国闻之，谏曰：「主不备难，难必至矣！」智伯曰：「难将由我。我不为难，谁敢兴之！」对曰：「不然。夏书有之：『一人三失，怨岂在明，不见是图。』夫君子能勤小物，故无大患。今主一宴而耻人之君相，又弗备，曰『不敢兴难』，无乃不可乎！蜹、蚁、蜂、虿，皆能害人，况君相乎！」弗听。","dtjl_paragraph_links":[],"dtjl_references":[],"id":12,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 12 段","reading_annotation_sources":[],"start_index":11,"tongjian_id":"8be8ab8b-db0e-11ef-8705-a0d3651f611f","year_int":-403},"tongjian_id":"8be8ab8b-db0e-11ef-8705-a0d3651f611f"},"paragraph_order":2}],"page_size":7,"total_pages":1,"total_paragraphs":2},"profile":{"alias_list":["智申","知申","智宣子","知宣子"],"biography":"荀申，中国春秋时期晋国政治人物，荀氏、智氏（知氏）第六代家主，又称知申、智申，当时晋国的中军将荀跞之子。公元前493年，荀跞去世后，荀申继承知氏之位，为下军佐，与赵鞅一起执政。荀申去世后，谥号知宣子、智宣子。","link_td_id":"Q10002710","name":"荀申","number_id":1521072},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"来源文本：|父= 荀申（亦作知申、智申）","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10001342","source_person_name":"荀瑶","source_person_number_id":961231,"statement_id":"S-Q10001342-P100023-Q10002710","target_person_id":"Q10002710","target_person_name":"荀申","target_person_number_id":1521072},{"direction":"forward","rank":"normal","relation_detail":"来源文本：|父= 荀跞（亦作知跞、智躒）","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10002710","source_person_name":"荀申","source_person_number_id":1521072,"statement_id":"S-Q10002710-P100023-Q10002627","target_person_id":"Q10002627","target_person_name":"荀跞","target_person_number_id":1479928},{"direction":"reverse","rank":"normal","relation_detail":"来源文本：|子女= 智申（亦作知申、荀申）","relation_property_display_template":"{subject}的子是{value}","relation_property_id":"P100025","relation_property_label":"子","source_person_id":"Q10002627","source_person_name":"荀跞","source_person_number_id":1479928,"statement_id":"S-Q10002627-P100025-Q10002710","target_person_id":"Q10002710","target_person_name":"荀申","target_person_number_id":1521072},{"direction":"forward","rank":"normal","relation_detail":"荀申的儿子，来源文本：|子女= 知宵、荀瑤（亦作智瑤、知瑤）","relation_property_display_template":"{subject}的子是{value}","relation_property_id":"P100025","relation_property_label":"子","source_person_id":"Q10002710","source_person_name":"荀申","source_person_number_id":1521072,"statement_id":"S-Q10002710-P100025-Q10001342","target_person_id":"Q10001342","target_person_name":"荀瑶","target_person_number_id":961231}]},"message":"success","success":true}