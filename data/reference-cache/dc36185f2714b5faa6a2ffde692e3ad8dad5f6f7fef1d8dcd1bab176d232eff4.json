d":"Q10001144","link_td_number_id":94116,"people_name":"李廣","people_name_jianti_auto":"李广","people_xingming":"李广","start_index":143,"tongjian_id":"8f694c50-db0e-11ef-b6dc-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"李廣","people_name_jianti_auto":"李广","people_xingming":"李广","start_index":194,"tongjian_id":"8f694c51-db0e-11ef-b9be-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"李廣","people_name_jianti_auto":"李广","people_xingming":"李广","start_index":205,"tongjian_id":"8f694c52-db0e-11ef-bf61-a0d3651f611f"},{"link_td_description":"程不识，是中国汉朝军事人物，封霸成侯。","link_td_id":"Q10014374","link_td_number_id":2872196,"people_name":"程不識","people_name_jianti_auto":"程不识","people_xingming":"程不识","start_index":209,"tongjian_id":"8f694c53-db0e-11ef-8d80-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雲中","place_name_jianti_auto":"云中","place_note":"內蒙托克托","resolved_place_entity_id":379,"start_index":12,"tongjian_id":"8f691d25-db0e-11ef-b700-a0d3651f611f"},{"place_name":"雁門","place_name_jianti_auto":"雁门","place_note":"山西右玉","resolved_place_entity_id":496,"start_index":27,"tongjian_id":"8f6930d2-db0e-11ef-a46a-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":191,"tongjian_id":"8f694c54-db0e-11ef-867b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","人事"],"content":"2衞尉李廣爲驍騎將軍，屯雲中，中尉程不識爲車騎將軍，屯雁門；六月，罷。廣與程不識俱以邊太守將兵，有名當時。廣行無部伍、行陳，就善水草舍止，人人自便，不擊刁斗以自衞，莫府省約文書；然亦遠斥候，未嘗遇害。程不識正部曲、行伍、營陳，擊刁斗，士吏治軍簿至明，軍不得休息；然亦未嘗遇害。不識曰：「李廣軍極簡易，然虜卒犯之，無以禁也；而其士卒亦佚樂，咸樂爲之死。我軍雖煩擾，然虜亦不得犯我。」然匈奴畏李廣之略，士卒亦多樂從李廣而苦程不識。","content_fanyi":"卫尉李广担任骁骑将军，屯驻云中；中尉程不识担任车骑将军，屯驻雁门。六月，两人都被罢去将军职务。李广和程不识都以边郡太守的身份统兵，当时都很有名。李广行军时没有部伍编制和行列阵势，选择水草丰美的地方宿营，士兵人人自便，不敲击刁斗来警戒自卫，幕府文书也简约省便；但他也远派斥候，从未遭遇祸害。程不识整顿部曲、行伍和营阵，敲击刁斗巡夜，军中士吏办理军簿直到天亮，军队不能休息；但也不曾遭遇祸害。程不识说：“李广治军极其简易，但敌人如果突然来犯，就没有办法抵御；而他的士兵也安逸快乐，都乐意为他效死。我军虽然事务烦扰，但敌人也不能侵犯我。”然而匈奴畏惧李广的谋略，士兵们也大多乐于跟随李广，而以跟随程不识为苦。","content_jianti_auto":"2衞尉李广为骁骑将军，屯云中，中尉程不识为车骑将军，屯雁门；六月，罢。广与程不识俱以边太守将兵，有名当时。广行无部伍、行陈，就善水草舍止，人人自便，不击刁斗以自衞，莫府省约文书；然亦远斥候，未尝遇害。程不识正部曲、行伍、营陈，击刁斗，士吏治军簿至明，军不得休息；然亦未尝遇害。不识曰：「李广军极简易，然虏卒犯之，无以禁也；而其士卒亦佚乐，咸乐为之死。我军虽烦扰，然虏亦不得犯我。」然匈奴畏李广之略，士卒亦多乐从李广而苦程不识。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1424,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f66f502-db0e-11ef-a0a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王弼","people_name_jianti_auto":"王弼","start_index":14,"tongjian_id":"8f694c57-db0e-11ef-9c63-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"否，音鄙。易·師卦初六爻辭。王弼註曰：齊衆以律，失律則散；故師出以律。律不可失；失律而臧，何異於否！失令有功，法所不赦。故師出不以律，否臧皆凶。","note_content_jianti_auto":"否，音鄙。易·师卦初六爻辞。王弼注曰：齐众以律，失律则散；故师出以律。律不可失；失律而臧，何异于否！失令有功，法所不赦。故师出不以律，否臧皆凶。","note_type":"hu_note","start_index":18,"tongjian_id":"8f694c56-db0e-11ef-a8a7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8f694c5b-db0e-11ef-8103-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"李廣","people_name_jianti_auto":"李广","people_xingming":"李广","start_index":31,"tongjian_id":"8f694c5d-db0e-11ef-9387-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"廣","people_name_jianti_auto":"广","people_xingming":"李广","start_index":43,"tongjian_id":"8f694c5e-db0e-11ef-ad58-a0d3651f611f"},{"link_td_description":"程不识，是中国汉朝军事人物，封霸成侯。","link_td_id":"Q10014374","link_td_number_id":2872196,"people_name":"程不識","people_name_jianti_auto":"程不识","people_xingming":"程不识","start_index":98,"tongjian_id":"8f694c5f-db0e-11ef-b554-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"廣","people_name_jianti_auto":"广","people_xingming":"李广","start_index":108,"tongjian_id":"8f694c60-db0e-11ef-91a2-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"廣","people_name_jianti_auto":"广","people_xingming":"李广","start_index":128,"tongjian_id":"8f694c61-db0e-11ef-bea1-a0d3651f611f"},{"link_td_description":"程不识，是中国汉朝军事人物，封霸成侯。","link_td_id":"Q10014374","link_td_number_id":2872196,"people_name":"程不識","people_name_jianti_auto":"程不识","people_xingming":"程不识","start_index":164,"tongjian_id":"8f694c62-db0e-11ef-84b1-a0d3651f611f"},{"link_death_year":-119,"link_td_description":"李广，陇西成纪人，西汉时武将。一生与匈奴交战四十余年，大小七十余战，匈奴人畏其英勇，称之为“飞将军”。","link_td_id":"Q10001144","link_td_number_id":94116,"people_name":"李廣","people_name_jianti_auto":"李广","start_index":177,"tongjian_id":"8f694c63-db0e-11ef-8b46-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论","军事"],"content":"臣光曰：易曰：「師出以律，否臧凶。」言治衆而不用法，無不凶也。李廣之將，使人人自便。以廣之材，如此焉可也；然不可以爲法。何則？其繼者難也；況與之並時而爲將乎！夫小人之情，樂於安肆而昧於近禍，彼旣以程不識爲煩擾而樂於從廣，且將仇其上而不服。然則簡易之害，非徒廣軍無以禁虜之倉卒而已也！故曰「兵事以嚴終」，爲將者，亦嚴而已矣。然則傚程不識，雖無功，猶不敗；傚李廣，鮮不覆亡哉！","content_fanyi":"臣司马光说：《易经》说：“军队出动要依律令而行，纪律不好就凶险。”这是说治理众人却不运用法度，没有不凶险的。李广统率军队，让将士人人自便。凭李广的才能，这样做还可以；但不能把这作为法度。为什么？因为后继者难以做到；何况是与他同时担任将领的人呢！大凡普通人的性情，喜欢安乐放纵而对眼前的祸害昏昧不觉，那些士兵既然认为程不识管束烦扰，而乐于跟随李广，就会仇视自己的上司而不服从。既然这样，简便粗率的害处，不只是李广军队无法遏制敌人突然袭击而已啊！所以说“军事靠严整而得以善终”，做将领的，也只是严整罢了。那么效法程不识，即使没有战功，还不至于失败；效法李广，很少有不覆亡的啊！","content_jianti_auto":"臣光曰：易曰：「师出以律，否臧凶。」言治众而不用法，无不凶也。李广之将，使人人自便。以广之材，如此焉可也；然不可以为法。何则？其继者难也；况与之并时而为将乎！夫小人之情，乐于安肆而昧于近祸，彼既以程不识为烦扰而乐于从广，且将仇其上而不服。然则简易之害，非徒广军无以禁虏之仓卒而已也！故曰「兵事以严终」，为将者，亦严而已矣。然则傚程不识，虽无功，犹不败；傚李广，鲜不覆亡哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":1425,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f694c55-db0e-11ef-ae62-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3夏，四月，赦天下。","content_fanyi":"夏季四月，大赦天下。","content_jianti_auto":"3夏，四月，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1426,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8f694c64-db0e-11ef-866c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4五月，詔舉賢良、文學，上親策之。","content_fanyi":"五月，武帝下诏令举荐贤良、文学之士，并亲自加以策问。","content_jianti_auto":"4五月，诏举贤良、文学，上亲策之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1427,"number":4,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8f694c65-db0e-11ef-858d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5秋，七月，癸未，日有食之。","content_fanyi":"秋季，七月，癸未日，发生日食。","content_jianti_auto":"5秋，七月，癸未，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1428,"number":5,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8f694c66-db0e-11ef-b751-a0d3651f611f"}],"reign_name":"元光元年","reign_name_jianti_auto":"元光元年","start_index":6,"tongjian_id":"8f66f4fc-db0e-11ef-9553-a0d3651f611f","year_anno":"（丁未、前一三四）","year_int":-134},"message":"success","success":true}