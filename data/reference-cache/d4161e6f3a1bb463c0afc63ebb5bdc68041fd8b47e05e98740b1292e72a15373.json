{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁未、前一九四）","note_content_jianti_auto":"（丁未、前一九四）","note_type":"hu_note","start_index":0,"tongjian_id":"8e847f8b-db0e-11ef-b396-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8e847f8f-db0e-11ef-8fd8-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":21,"tongjian_id":"8e847f90-db0e-11ef-a102-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十五行本無「年」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：甲十五行本无「年」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8e847f8e-db0e-11ef-a882-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":15,"tongjian_id":"8e847f8d-db0e-11ef-856c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范成大","people_name_jianti_auto":"范成大","start_index":47,"tongjian_id":"8e847f92-db0e-11ef-b24b-a0d3651f611f"},{"people_name":"陸佃","people_name_jianti_auto":"陆佃","start_index":191,"tongjian_id":"8e847f93-db0e-11ef-b136-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"邕州朝天鋪","place_name_jianti_auto":"邕州朝天铺","start_index":55,"tongjian_id":"8e847f94-db0e-11ef-b1f2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"廣志：鴆鳥大如鴞，毛紫綠色，有毒；頸長七八寸，食蝮蛇。雄名運日，雌名陰諧。以其毛歷飲食則殺人。范成大曰：鴆，聞邕州朝天鋪及山深處有之，形如鵶差大，黑身，赤目，音如羯鼓；唯食毒蛇，遇蛇則鳴聲邦邦然。蛇入石穴，則於穴外禹步作法；有頃，石碎，啄蛇吞之。山有鴆，草木不生。秋冬之間脫羽。往時人以銀作爪拾取，著銀瓶中；否則手爛墮。鴆矢着人立死；集於石，石亦裂。此禽至兇極毒。所謂酖，卽鴆酒也。陸佃埤雅曰：鴆，似鷹而紫黑，喙長七八寸，作銅色。食蛇，蛇入口輒爛；屎溺著石，石亦爲之爛。羽翮有毒，以櫟酒，飲殺人；惟犀角可以解，故有鴆處必有犀。飲，於禁翻。","note_content_jianti_auto":"广志：鸩鸟大如鸮，毛紫绿色，有毒；颈长七八寸，食蝮蛇。雄名运日，雌名阴谐。以其毛历饮食则杀人。范成大曰：鸩，闻邕州朝天铺及山深处有之，形如鵶差大，黑身，赤目，音如羯鼓；唯食毒蛇，遇蛇则鸣声邦邦然。蛇入石穴，则于穴外禹步作法；有顷，石碎，啄蛇吞之。山有鸩，草木不生。秋冬之间脱羽。往时人以银作爪拾取，著银瓶中；否则手烂堕。鸩矢着人立死；集于石，石亦裂。此禽至凶极毒。所谓酖，即鸩酒也。陆佃埤雅曰：鸩，似鹰而紫黑，喙长七八寸，作铜色。食蛇，蛇入口辄烂；屎溺著石，石亦为之烂。羽翮有毒，以栎酒，饮杀人；惟犀角可以解，故有鸩处必有犀。饮，于禁翻。","note_type":"hu_note","start_index":31,"tongjian_id":"8e847f91-db0e-11ef-9803-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":0,"tongjian_id":"8e847f98-db0e-11ef-931f-a0d3651f611f"},{"people_name":"呂靜","people_name_jianti_auto":"吕静","start_index":27,"tongjian_id":"8e847f99-db0e-11ef-820a-a0d3651f611f"},{"people_name":"程大昌","people_name_jianti_auto":"程大昌","start_index":40,"tongjian_id":"8e847f9a-db0e-11ef-a8aa-a0d3651f611f"},{"people_name":"徐","people_name_jianti_auto":"徐","start_index":45,"tongjian_id":"8e847f9b-db0e-11ef-a6d7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徐廣曰：犂，猶比也；比至天明也。諸言犂明者，將明時也。呂靜曰：犂，結也，力奚翻。程大昌曰：徐說非也。犂、黎，古字通。黎，黑也；黑與明相雜，欲曉未曉之交也，猶曰昧爽也。昧，暗也；爽，明也；亦明暗相雜也。遲明，卽未及乎明也。厥明、質明，則已曉也。康云力追切。未知何據。","note_content_jianti_auto":"徐广曰：犂，犹比也；比至天明也。诸言犂明者，将明时也。吕静曰：犂，结也，力奚翻。程大昌曰：徐说非也。犂、黎，古字通。黎，黑也；黑与明相杂，欲晓未晓之交也，犹曰昧爽也。昧，暗也；爽，明也；亦明暗相杂也。迟明，即未及乎明也。厥明、质明，则已晓也。康云力追切。未知何据。","note_type":"hu_note","start_index":34,"tongjian_id":"8e847f97-db0e-11ef-bca9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":12,"tongjian_id":"8e847f9d-db0e-11ef-9306-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"斷，丁管翻。去，羌呂翻。師古曰：去其眼睛，以藥薰耳令聾也。瘖，不能言也；以瘖藥飲之。瘖，於今翻。","note_content_jianti_auto":"断，丁管翻。去，羌吕翻。师古曰：去其眼睛，以药薰耳令聋也。瘖，不能言也；以瘖药饮之。瘖，于今翻。","note_type":"hu_note","start_index":62,"tongjian_id":"8e847f9c-db0e-11ef-9144-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8e847f9f-db0e-11ef-bd1e-a0d3651f611f"},{"people_name":"惠帝","people_name_jianti_auto":"惠帝","start_index":19,"tongjian_id":"8e847fa0-db0e-11ef-b4d6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：令太后治事，己自如太子然。余謂惠帝之意，蓋以謂身爲太后子而不能容父之寵姬，是終不能治天下也。治，直之翻。","note_content_jianti_auto":"师古曰：令太后治事，己自如太子然。余谓惠帝之意，盖以谓身为太后子而不能容父之宠姬，是终不能治天下也。治，直之翻。","note_type":"hu_note","start_index":136,"tongjian_id":"8e847f9e-db0e-11ef-b2ee-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-205,"link_death_year":-194,"link_td_description":"刘如意，汉朝宗室，汉高祖刘邦与宠妃戚夫人所生之子，十岁时受封赵王，被嫡母吕后谋杀，谥号称赵隐王。","link_td_id":"Q10009390","link_td_number_id":653561,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"刘如意","start_index":12,"tongjian_id":"8e847fa2-db0e-11ef-a12f-a0d3651f611f"},{"link_birth_year":-205,"link_death_year":-194,"link_td_description":"刘如意，汉朝宗室，汉高祖刘邦与宠妃戚夫人所生之子，十岁时受封赵王，被嫡母吕后谋杀，谥号称赵隐王。","link_td_id":"Q10009390","link_td_number_id":653561,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"刘如意","start_index":37,"tongjian_id":"8e86b582-db0e-11ef-936f-a0d3651f611f"},{"link_death_year":-194,"link_td_description":"戚夫人，又称戚姬，定陶县（今山东省菏泽市定陶区），汉高祖刘邦宠妃，赵王刘如意生母，屡次恃宠而骄企图以庶夺嫡。刘邦死后，戚夫人被吕后虐杀于茅房，死状甚惨，其子刘如意也被吕后谋害。","link_td_id":"Q10000899","link_td_number_id":419485,"people_name":"戚夫人","people_name_jianti_auto":"戚夫人","people_xingming":"戚夫人","start_index":46,"tongjian_id":"8e86b583-db0e-11ef-96cb-a0d3651f611f"},{"link_death_year":-194,"link_td_description":"戚夫人，又称戚姬，定陶县（今山东省菏泽市定陶区），汉高祖刘邦宠妃，赵王刘如意生母，屡次恃宠而骄企图以庶夺嫡。刘邦死后，戚夫人被吕后虐杀于茅房，死状甚惨，其子刘如意也被吕后谋害。","link_td_id":"Q10000899","link_td_number_id":419485,"people_name":"戚夫人","people_name_jianti_auto":"戚夫人","people_xingming":"戚夫人","start_index":91,"tongjian_id":"8e86b584-db0e-11ef-b594-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8e847f8c-db0e-11ef-b35f-a0d3651f611f","pinyin":"xūn","source_anchor_text":"手足去眼煇耳飲瘖藥","source_key":"baiyang_epub","start_index":55,"text":"煇","tongjian_id":"c2ef4745-8490-51ad-b49f-1aec6f027efd"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8e847f8c-db0e-11ef-b35f-a0d3651f611f","pinyin":"yīn","source_anchor_text":"眼煇耳飲瘖藥使居廁","source_key":"baiyang_epub","start_index":59,"text":"瘖","tongjian_id":"4c1a24f9-6dba-5c3a-a3e6-f4e52e20d397"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉唐三君知子","excerpts":[{"context_after":"，恪为长孙无忌所害，钦陷张博之事，殆于不免。此三王行事，...","context_before":"...早失母，故弗忍。唐太宗以吴王恪英果类我，欲以代雉奴。其后","source_end_index":129,"source_paragraph_tongjian_id":"9209e643-9180-45dc-93f1-bbc53238cd25","source_start_index":122,"source_text":"如意为吕母所戕"}],"path":"四笔/卷十二/汉唐三君知子","source_name":"容斋随笔"}],"class_tags":["权争"],"content":"1冬，十二月，帝晨出射。趙王年少，不能蚤起；太后使人持酖飲之。犂明，帝還，趙王已死。太后遂斷戚夫人手足，去眼，煇耳，飲瘖藥，使居廁中，命曰「人彘」。居數日，乃召帝觀人彘。帝見，問知其戚夫人，乃大哭，因病，歲餘不能起。使人請太后曰：「此非人所爲。臣爲太后子，終不能治天下。」帝以此日飲爲淫樂，不聽政。","content_fanyi":"冬季，十二月，汉惠帝刘盈清晨外出射猎。赵王年纪尚小，不能早起同去；吕太后便派人拿着毒酒让赵王喝下。黎明，汉惠帝回到宫中，赵王已经死了。吕太后又砍断戚夫人的手脚，挖去眼珠，熏聋耳朵，灌下哑药，让她住在厕所中，称她为“人彘”。过了几天，吕太后召汉惠帝来看“人彘”。汉惠帝看见后，询问得知这就是戚夫人，于是放声大哭，并因此患病，一年多不能起身。他派人向吕太后请求说：“这不是人能做出来的事。我虽然是太后您的儿子，终究不能治理天下。”汉惠帝从此每天饮酒作乐，不理朝政。","content_jianti_auto":"1冬，十二月，帝晨出射。赵王年少，不能蚤起；太后使人持酖饮之。犂明，帝还，赵王已死。太后遂断戚夫人手足，去眼，𪸩耳，饮瘖药，使居厕中，命曰「人彘」。居数日，乃召帝观人彘。帝见，问知其戚夫人，乃大哭，因病，岁余不能起。使人请太后曰：「此非人所为。臣为太后子，终不能治天下。」帝以此日饮为淫乐，不听政。","dtjl_paragraph_links":[],"dtjl_references":[],"id":948,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8e847f8c-db0e-11ef-b35f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見記·曲禮。號，戶高翻。","note_content_jianti_auto":"见记·曲礼。号，户高翻。","note_type":"hu_note","start_index":28,"tongjian_id":"8e86e2e8-db0e-11ef-92a1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8e86e2ea-db0e-11ef-bb8e-a0d3651f611f"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高祖","people_name_jianti_auto":"高祖","people_xingming":"刘邦","start_index":31,"tongjian_id":"8e86e2eb-db0e-11ef-b12a-a0d3651f611f"},{"link_birth_year":-211,"link_death_year":-188,"link_td_description":"汉惠帝刘盈，汉朝开国皇帝汉高帝刘邦和皇后吕氏之子，汉朝皇帝，于前195年6月26日—前188年9月26日在位，在位7年，其正式谥号为“孝惠皇帝”。","link_td_id":"Q10000195","link_td_number_id":106737,"people_name":"孝惠","people_name_jianti_auto":"孝惠","people_xingming":"刘盈","start_index":65,"tongjian_id":"8e86e2ec-db0e-11ef-969c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：爲人子者，父母有過則諫；諫而不聽，則號泣而隨之。安有守高祖之業，爲天下之主，不忍母之殘酷，遂棄國家而不恤，縱酒色以傷生！若孝惠者，可謂篤於小仁而未知大誼也。","content_fanyi":"臣司马光评论说：作为儿子，父母有了过错就应当劝谏；劝谏而不被听从，就应当号哭着跟随。哪里有继承汉高祖的基业、身为天下君主，却因为不能容忍母亲的残酷，就抛弃国家而不顾惜、纵情酒色伤害自己身体的道理！像汉惠帝这样，可以说只是固执于小的仁爱，却不懂得大义啊。","content_jianti_auto":"臣光曰：为人子者，父母有过则谏；谏而不听，则号泣而随之。安有守高祖之业，为天下之主，不忍母之残酷，遂弃国家而不恤，纵酒色以伤生！若孝惠者，可谓笃于小仁而未知大谊也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":949,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8e86e2e7-db0e-11ef-9cba-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":0,"tongjian_id":"8e86e2ef-db0e-11ef-8a96-a0d3651f611f"},{"people_name":"友","people_name_jianti_auto":"友","start_index":7,"tongjian_id":"8e86e2f0-db0e-11ef-a1c3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"淮陽","place_name_jianti_auto":"淮阳","start_index":9,"tongjian_id":"8e86e2f1-db0e-11ef-95dc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高祖十一年，封友於淮陽。","note_content_jianti_auto":"高祖十一年，封友于淮阳。","note_type":"hu_note","start_index":10,"tongjian_id":"8e86e2ee-db0e-11ef-8ec6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-181,"link_td_description":"刘友，刘邦的儿子，汉高祖十一年三月受封淮阳王；汉惠帝元年十二月徙封赵王。正妻为吕后之侄女，因刘友另有爱妾而失宠，遂向吕后诬告刘友欲叛。吕后七年正月，召刘友入京，一到长安便被软禁，断绝粮食，活活饿死，以平民之礼下葬。汉文帝继位后，追谥为幽王。","link_td_id":"Q10009395","link_td_number_id":653592,"people_name":"淮陽王友","people_name_jianti_auto":"淮阳王友","people_xingming":"刘友","start_index":2,"tongjian_id":"8e86e2f2-db0e-11ef-a0f8-a0d3651f611f"},{"link_death_year":-181,"link_td_description":"刘友，刘邦的儿子，汉高祖十一年三月受封淮阳王；汉惠帝元年十二月徙封赵王。正妻为吕后之侄女，因刘友另有爱妾而失宠，遂向吕后诬告刘友欲叛。吕后七年正月，召刘友入京，一到长安便被软禁，断绝粮食，活活饿死，以平民之礼下葬。汉文帝继位后，追谥为幽王。","link_td_id":"Q10009395","link_td_number_id":653592,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"刘友","start_index":7,"tongjian_id":"8e86e2f3-db0e-11ef-b244-a0d3651f611f","wl_zhushi":"[府邯郸]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2徙淮陽王友爲趙王。","content_fanyi":"朝廷将淮阳王刘友改封为赵王。","content_jianti_auto":"2徙淮阳王友为赵王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":950,"number":2,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8e86e2ed-db0e-11ef-b884-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蕭何","people_name_jianti_auto":"萧何","start_index":5,"tongjian_id":"8e86e2f6-db0e-11ef-a372-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":34,"tongjian_id":"8e86e2f7-db0e-11ef-a959-a0d3651f611f"},{"people_name":"惠帝","people_name_jianti_auto":"惠帝","start_index":38,"tongjian_id":"8e86e2f8-db0e-11ef-9cdc-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"8e86e2f9-db0e-11ef-ae46-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":2,"tongjian_id":"8e86e2fa-db0e-11ef-bcd8-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":42,"tongjian_id":"8e86e2fb-db0e-11ef-a6ff-a0d3651f611f"},{"place_name":"大興城","place_name_jianti_auto":"大兴城","start_index":48,"tongjian_id":"8e86e2fc-db0e-11ef-91e3-a0d3651f611f"},{"place_name":"北苑","place_name_jianti_auto":"北苑","start_index":52,"tongjian_id":"8e86e2fd-db0e-11ef-be59-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢都長安，蕭何雖治宮室，未暇築城，帝始築之，至五年乃畢，故書以始事。杜佑曰：惠帝所築長安城，在今大興城西北苑中。","note_content_jianti_auto":"汉都长安，萧何虽治宫室，未暇筑城，帝始筑之，至五年乃毕，故书以始事。杜佑曰：惠帝所筑长安城，在今大兴城西北苑中。","note_type":"hu_note","start_index":15,"tongjian_id":"8e86e2f5-db0e-11ef-abed-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長安城","place_name_jianti_auto":"长安城","resolved_place_entity_id":1318,"start_index":8,"tongjian_id":"8e86e2fe-db0e-11ef-aa42-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3春，正月，始作長安城西北方。","content_fanyi":"春季，正月，开始修筑长安城西北面的城墙。","content_jianti_auto":"3春，正月，始作长安城西北方。","dtjl_paragraph_links":[],"dtjl_references":[],"id":951,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8e86e2f4-db0e-11ef-a4a8-a0d3651f611f"}],"reign_name":"元年","reign_name_jianti_auto":"元年","start_index":0,"tongjian_id":"8e847f8a-db0e-11ef-b35a-a0d3651f611f","year_anno":"（丁未、前一九四）","year_int":-194},"message":"success","success":true}