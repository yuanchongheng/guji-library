{"data":{"current_mention_tongjian_id":"8c611dcb-db0e-11ef-be0c-a0d3651f611f","current_paragraph_tongjian_id":"8c5eb45e-db0e-11ef-b22e-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":10,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":3,"tongjian_id":"8c5eb460-db0e-11ef-90ab-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":7,"tongjian_id":"8c5eb461-db0e-11ef-9fdc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三年，蘇秦死於齊。","note_content_jianti_auto":"三年，苏秦死于齐。","note_type":"hu_note","start_index":6,"tongjian_id":"8c5eb45f-db0e-11ef-b7cc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉伯莊","people_name_jianti_auto":"刘伯庄","start_index":0,"tongjian_id":"8c5eb466-db0e-11ef-a76a-a0d3651f611f"},{"people_name":"鹿毛壽","people_name_jianti_auto":"鹿毛寿","start_index":5,"tongjian_id":"8c5eb467-db0e-11ef-9156-a0d3651f611f"},{"people_name":"潘壽","people_name_jianti_auto":"潘寿","start_index":15,"tongjian_id":"8c5eb468-db0e-11ef-8a3e-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":29,"tongjian_id":"8c5eb469-db0e-11ef-aa07-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":41,"tongjian_id":"8c5eb46a-db0e-11ef-9bb9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"清河","place_name_jianti_auto":"清河","start_index":61,"tongjian_id":"8c5eb46b-db0e-11ef-986b-a0d3651f611f"},{"place_name":"厝縣","place_name_jianti_auto":"厝县","start_index":64,"tongjian_id":"8c5eb46c-db0e-11ef-8de6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉伯莊曰：鹿毛壽，人姓名；又曰潘壽。春秋後語作「唐毛壽」。徐廣曰：一作「厝毛」。如徐廣一作之說，當作「厝」。厝，音秦昔翻。清河有厝縣。","note_content_jianti_auto":"刘伯庄曰：鹿毛寿，人姓名；又曰潘寿。春秋后语作「唐毛寿」。徐广曰：一作「厝毛」。如徐广一作之说，当作「厝」。厝，音秦昔翻。清河有厝县。","note_type":"hu_note","start_index":99,"tongjian_id":"8c5eb465-db0e-11ef-9cf2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"禹","people_name_jianti_auto":"禹","start_index":4,"tongjian_id":"8c610a0e-db0e-11ef-b5f4-a0d3651f611f"},{"people_name":"益","people_name_jianti_auto":"益","start_index":6,"tongjian_id":"8c610a0f-db0e-11ef-a332-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":10,"tongjian_id":"8c610a10-db0e-11ef-b17d-a0d3651f611f"},{"people_name":"益","people_name_jianti_auto":"益","start_index":19,"tongjian_id":"8c610a11-db0e-11ef-bdfa-a0d3651f611f"},{"people_name":"啓","people_name_jianti_auto":"启","start_index":22,"tongjian_id":"8c610a12-db0e-11ef-8724-a0d3651f611f"},{"people_name":"啓","people_name_jianti_auto":"启","start_index":46,"tongjian_id":"8c610a13-db0e-11ef-8ed1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟子曰：禹薦益於天，禹崩，天下之人不之益而之啓，曰：「吾君之子也。」索隱曰：人，猶臣也。謂以啓臣爲益吏。索，山客翻。","note_content_jianti_auto":"孟子曰：禹荐益于天，禹崩，天下之人不之益而之启，曰：「吾君之子也。」索隐曰：人，犹臣也。谓以启臣为益吏。索，山客翻。","note_type":"hu_note","start_index":160,"tongjian_id":"8c61034f-db0e-11ef-8f88-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"伊尹","people_name_jianti_auto":"伊尹","start_index":11,"tongjian_id":"8c610a18-db0e-11ef-8a50-a0d3651f611f"},{"people_name":"太甲","people_name_jianti_auto":"太甲","start_index":14,"tongjian_id":"8c610a19-db0e-11ef-bb74-a0d3651f611f"},{"people_name":"伊尹","people_name_jianti_auto":"伊尹","start_index":23,"tongjian_id":"8c610a1a-db0e-11ef-bba7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"桐","place_name_jianti_auto":"桐","start_index":20,"tongjian_id":"8c610a1b-db0e-11ef-a8a1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按或曰一段事，與師春紀伊尹放太甲，潛出自桐，殺伊尹，事頗相類，古書雜記固多也。","note_content_jianti_auto":"按或曰一段事，与师春纪伊尹放太甲，潜出自桐，杀伊尹，事颇相类，古书杂记固多也。","note_type":"hu_note","start_index":205,"tongjian_id":"8c610a17-db0e-11ef-9e36-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"三王","people_name_jianti_auto":"三王","start_index":9,"tongjian_id":"8c610a1e-db0e-11ef-a447-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":39,"tongjian_id":"8c610a1f-db0e-11ef-9d92-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":64,"tongjian_id":"8c610a20-db0e-11ef-983c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":66,"tongjian_id":"8c610a21-db0e-11ef-8011-a0d3651f611f"},{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":164,"tongjian_id":"8c610a22-db0e-11ef-81d1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":182,"tongjian_id":"8c610a23-db0e-11ef-9c97-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢書·輿服志曰：三王俗化雕文，詐僞漸生，始有印綬，以檢姦萌。周禮掌節有璽節，鄭氏註云：今之印章也。綬，組綬。古者佩玉以綬貫之。漢承秦制，乘輿璽綬；諸王以下，印以金、銀、銅爲差，綬以赤、紫、青、黑、黃爲差。印，信也，刻文合信也。綬，受也，轉相授受也。三百石吏，銅印，黑綬或黃綬。王制：諸侯大國之卿，食祿以田計之，爲三十二夫之入。戰國之卿，食祿萬鍾，其僭差不度甚矣。漢制：三公秩萬石，至於斗食佐吏，凡十六等。三百石吏，第十等，奉月四十斛。綬，音受。璽，斯氏翻。組，祖五翻。乘，繩證翻。奉，與俸同，音扶用翻。","note_content_jianti_auto":"后汉书·舆服志曰：三王俗化雕文，诈伪渐生，始有印绶，以检奸萌。周礼掌节有玺节，郑氏注云：今之印章也。绶，组绶。古者佩玉以绶贯之。汉承秦制，乘舆玺绶；诸王以下，印以金、银、铜为差，绶以赤、紫、青、黑、黄为差。印，信也，刻文合信也。绶，受也，转相授受也。三百石吏，铜印，黑绶或黄绶。王制：诸侯大国之卿，食禄以田计之，为三十二夫之入。战国之卿，食禄万锺，其僭差不度甚矣。汉制：三公秩万石，至于斗食佐吏，凡十六等。三百石吏，第十等，奉月四十斛。绶，音受。玺，斯氏翻。组，祖五翻。乘，绳证翻。奉，与俸同，音扶用翻。","note_type":"hu_note","start_index":255,"tongjian_id":"8c610a1d-db0e-11ef-94f1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"顧，反也。噲，苦夬翻。","note_content_jianti_auto":"顾，反也。哙，苦夬翻。","note_type":"hu_note","start_index":275,"tongjian_id":"8c610a28-db0e-11ef-bb15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":6,"source_start_index":0,"source_text":"爲後燕亂張本","target_paragraph_tongjian_id":"8c627621-db0e-11ef-9905-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":2,"tongjian_id":"8c611db9-db0e-11ef-8572-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲後燕亂張本。","note_content_jianti_auto":"为后燕乱张本。","note_type":"hu_note","start_index":283,"tongjian_id":"8c610a29-db0e-11ef-afcb-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"燕相","official_note":"燕相是燕国的宰相，负责辅佐君主处理国政。在上下文中，子之担任燕相，并试图通过联姻和游说获取更多权力，最终导致燕王让位，子之实际掌权。","official_rank":"未知","source_snippet":"燕相子之與蘇代婚","start_index":24,"tongjian_id":"5b11e882-b77b-4532-80d2-0775319a26b3"},{"confidence":0.8,"official_category":"地方行政","official_name":"吏","official_note":"吏泛指官员或官吏，负责执行行政事务。在上下文中，禹任命启的人为吏，以辅助益，但后来启夺权，反映了权力斗争。","official_rank":"未知","source_snippet":"以啓人爲吏","start_index":156,"tongjian_id":"bc3c03d1-72b7-44e7-94a4-521e7f1f29ba"},{"confidence":0.85,"official_category":"地方行政","official_name":"三百石吏","official_note":"三百石吏指俸禄为三百石的官员，属于低级官吏。在上下文中，燕王将这类官员的印绶交给子之，象征子之获得行政控制权。","official_rank":"低级官员","source_snippet":"自三百石吏已上而效之子之","start_index":228,"tongjian_id":"029b45f0-27da-4d16-94d7-efaa7ed67b5