art_index":66,"tongjian_id":"93203a27-db0e-11ef-8ef0-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","resolved_place_entity_id":655,"start_index":88,"tongjian_id":"93203a2d-db0e-11ef-ae96-a0d3651f611f"},{"place_name":"貉","place_name_jianti_auto":"貉","resolved_place_entity_id":3427,"start_index":119,"tongjian_id":"93203a2e-db0e-11ef-80d6-a0d3651f611f"},{"place_name":"夫餘","place_name_jianti_auto":"夫余","resolved_place_entity_id":2823,"start_index":155,"tongjian_id":"93203a2f-db0e-11ef-87d1-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":164,"tongjian_id":"93203a30-db0e-11ef-aac8-a0d3651f611f"},{"place_name":"夫餘","place_name_jianti_auto":"夫余","resolved_place_entity_id":2823,"start_index":169,"tongjian_id":"93203a31-db0e-11ef-8593-a0d3651f611f"},{"place_name":"濊貉","place_name_jianti_auto":"濊貉","resolved_place_entity_id":8087,"start_index":172,"tongjian_id":"93203a32-db0e-11ef-b0ef-a0d3651f611f"},{"place_name":"濊貉","place_name_jianti_auto":"濊貉","resolved_place_entity_id":8087,"start_index":188,"tongjian_id":"93203a38-db0e-11ef-ad0f-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":212,"tongjian_id":"93203a39-db0e-11ef-b368-a0d3651f611f"},{"place_name":"高句驪","place_name_jianti_auto":"高句骊","resolved_place_entity_id":226,"start_index":221,"tongjian_id":"93203a3b-db0e-11ef-aa34-a0d3651f611f"},{"place_name":"下句驪","place_name_jianti_auto":"下句骊","resolved_place_entity_id":5681,"start_index":225,"tongjian_id":"93203a3c-db0e-11ef-831c-a0d3651f611f"},{"place_name":"貉","place_name_jianti_auto":"貉","resolved_place_entity_id":3427,"start_index":231,"tongjian_id":"93203a3d-db0e-11ef-93ca-a0d3651f611f"},{"place_name":"西南夷","place_name_jianti_auto":"西南夷","resolved_place_entity_id":1702,"start_index":241,"tongjian_id":"93203a3e-db0e-11ef-bfcf-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、临安府（卷一百十五）","excerpts":[{"context_after":"莽天凤三年，遣兵击句町，不克]。后汉仍属牂牁郡。蜀汉属兴...","context_before":"...、漏卧相攻。牂牁太守陈立斩夜郎王兴，句町、漏卧震恐受命。","source_end_index":153,"source_paragraph_tongjian_id":"2ee76921-42bb-52b8-9810-4fcac11e80c7","source_start_index":116,"source_text":"莽始建国初，遣使南出隃徼外，历益州，改句町王为侯。句町不服，因起兵为边患。"}],"path":"云南方舆纪要/四、临安府（卷一百十五）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"6初，五威將帥出西南夷，改句町王爲侯，王邯怨怒不附。莽諷牂柯大尹周歆詐殺邯。邯弟承起兵殺歆，州郡擊之，不能服。莽又發高句驪兵擊匈奴；高句驪不欲行，郡強迫，皆亡出塞，因犯法爲寇。遼西大尹田譚追擊之，爲所殺。州郡歸咎於高句驪侯騶，嚴尤奏言：「貉人犯法，不從騶起；正有他心，宜令州郡且尉安之。今猥被以大罪，恐其遂畔，夫餘之屬必有和者。匈奴未克，夫餘、濊貉復起，此大憂也。」莽不尉安，濊貉遂反；詔尤擊之。尤誘高句驪侯騶至而斬焉，傳首長安。莽大說，更名高句驪爲下句驪。於是貉人愈犯邊，東、北與西南夷皆亂。莽志方盛，以爲四夷不足吞滅，專念稽古之事，復下書：「以此年二月東巡狩，具禮儀調度。」旣而以文母太后體不安，且止待後。","content_fanyi":"起初，五威将帅出使西南夷，把句町王改封为侯，句町王邯怨恨愤怒，不肯归附。王莽示意牂柯郡大尹周歆用欺骗手段杀死句町王邯。邯的弟弟承起兵杀死周歆，王莽命州郡发兵讨伐承，却无法使他降服。王莽又调发高句骊军队去进攻匈奴；高句骊人不愿前往，郡府强迫他们出发，他们便都逃出边塞，于是触犯法令，在当地劫掠为寇。辽西大尹田谭追击他们，反被他们杀死。州郡官府把罪责归到高句骊侯驺身上，严尤上奏说：“貉人犯法，并不是从驺开始的；如果驺另有异心，也应当命令州郡暂且安抚他们。如今突然把大罪加在他们头上，恐怕他们会就此反叛，夫余等部族必定会有响应的。匈奴尚未平定，夫余、濊貉又起来作乱，这是很大的忧患。”王莽不肯安抚，濊貉于是反叛；王莽下诏命令严尤进击他们。严尤引诱高句骊侯驺前来，将他斩首，并把首级传送到长安。王莽非常高兴，把高句骊改名为下句骊。从此貉人更加侵犯边境，东部、北部和西南的各蛮夷都作乱。王莽正志得意满，认为四方蛮夷不值得去吞并消灭，一心研习古事并加以仿效，又下诏说：“在本年二月，我要到东方巡视，有关部门要开列礼仪程序。”随后因文母太后身体不适，便暂缓出发，等待以后。","content_jianti_auto":"6初，五威将帅出西南夷，改句町王为侯，王邯怨怒不附。莽讽牂柯大尹周歆诈杀邯。邯弟承起兵杀歆，州郡击之，不能服。莽又发高句骊兵击匈奴；高句骊不欲行，郡强迫，皆亡出塞，因犯法为寇。辽西大尹田谭追击之，为所杀。州郡归咎于高句骊侯驺，严尤奏言：「貉人犯法，不从驺起；正有他心，宜令州郡且尉安之。今猥被以大罪，恐其遂畔，夫余之属必有和者。匈奴未克，夫余、濊貉复起，此大忧也。」莽不尉安，濊貉遂反；诏尤击之。尤诱高句骊侯驺至而斩焉，传首长安。莽大说，更名高句骊为下句骊。于是貉人愈犯边，东、北与西南夷皆乱。莽志方盛，以为四夷不足吞灭，专念稽古之事，复下书：「以此年二月东巡狩，具礼仪调度。」既而以文母太后体不安，且止待后。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2856,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"931dd0bb-db0e-11ef-b9f9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否毁坏汉元帝庙并另建太后庙","decision_tongjian_id":"DECISION_93203A41DB0E11EFB644A0D3651F611F_01"},{"decision_name":"是否改变汉朝服饰与祭祀历法","decision_tongjian_id":"DECISION_93203A41DB0E11EFB644A0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":8,"source_start_index":0,"source_text":"事見上卷元始四年","target_paragraph_tongjian_id":"92dae981-db0e-11ef-bb18-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷元始四年。","note_content_jianti_auto":"事见上卷元始四年。","note_type":"hu_note","start_index":31,"tongjian_id":"93203a42-db0e-11ef-9321-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"93203a44-db0e-11ef-a45d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：夫婦一體也。墮，毀也，音火規翻。壞，音怪。","note_content_jianti_auto":"师古曰：夫妇一体也。堕，毁也，音火规翻。坏，音怪。","note_type":"hu_note","start_index":74,"tongjian_id":"93203a43-db0e-11ef-afc8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":8,"tongjian_id":"93203a46-db0e-11ef-9561-a0d3651f611f"},{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":17,"tongjian_id":"93203a47-db0e-11ef-99c0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"置，捨也，留也。孟康曰：篹，音撰。晉灼曰：篹，具也。","note_content_jianti_auto":"置，舍也，留也。孟康曰：篹，音撰。晋灼曰：篹，具也。","note_type":"hu_note","start_index":98,"tongjian_id":"93203a45-db0e-11ef-9a19-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"93203a49-db0e-11ef-94eb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：與，讀曰預。言此何罪於汝，無所干預，何爲毀壞之！壞，音怪。","note_content_jianti_auto":"师古曰：与，读曰预。言此何罪于汝，无所干预，何为毁坏之！坏，音怪。","note_type":"hu_note","start_index":166,"tongjian_id":"93203a48-db0e-11ef-a939-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":3,"tongjian_id":"93203a4b-db0e-11ef-9897-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"釋名：吳人謂祭爲饋。","note_content_jianti_auto":"释名：吴人谓祭为馈。","note_type":"hu_note","start_index":204,"tongjian_id":"93203a4a-db0e-11ef-9b9c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"祐，福也。神，助也。","note_content_jianti_auto":"祐，福也。神，助也。","note_type":"hu_note","start_index":225,"tongjian_id":"93203a4d-db0e-11ef-a280-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"93203a51-db0e-11ef-afc9-a0d3651f611f"},{"people_name":"莽","people_name_jianti_auto":"莽","start_index":11,"tongjian_id":"93203a52-db0e-11ef-8681-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":13,"tongjian_id":"93203a53-db0e-11ef-acf8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：侍中所著貂也，莽改漢制服黃。更，音工衡翻。著，音陟略翻。","note_content_jianti_auto":"孟康曰：侍中所著貂也，莽改汉制服黄。更，音工衡翻。著，音陟略翻。","note_type":"hu_note","start_index":270,"tongjian_id":"93203a50-db0e-11ef-83ef-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"安漢公","official_note":"安漢公是王莽在西漢末年獲得的爵位，屬於加官性質，位在三公之上，實際掌握朝政大權。在《資治通鑑》此段中，描述王莽在擔任安漢公時期的行為，顯示其當時已具備極高的政治影響力。","official_rank":"未知","source_snippet":"莽爲安漢公時","start_index":2,"tongjian_id":"f4c493dd-d265-4ffb-af0b-0c70369e4f8d"},{"confidence":0.9,"official_category":"皇室","official_name":"太皇太后","official_note":"太皇太后是皇帝祖母的尊號，在漢代具有崇高的地位，常參與或影響朝政。此處指王莽試圖討好太皇太后（即元帝皇后王政君），以鞏固自己的權力。","official_rank":"未知","source_snippet":"欲諂太皇太后","start_index":11,"tongjian_id":"bd940d1f-1500-47b3-a025-92551fd1dd3f"},{"confidence":0.85,"official_category":"皇室","official_name":"太后","official_note":"太后是皇帝母親的尊號，此處仍指太皇太后王政君，在文中多次出現，顯示王莽與其之間的權力互動。","official_rank":"未知","source_snippet":"太后晏駕後","start_index":24,"tongjian_id":"ea03ec28-8578-4ac1-b906-ea8ee5b9e14c"}],"ExtRef_Children_people":[{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":3,"tongjian_id":"93203a54-db0e-11ef-87ef-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"安漢公","people_name_jianti_auto":"安汉公","people_xingming":"王莽","start_index":5,"tongjian_id":"93203a55-db0e-11ef-83c3-a0d3651f61