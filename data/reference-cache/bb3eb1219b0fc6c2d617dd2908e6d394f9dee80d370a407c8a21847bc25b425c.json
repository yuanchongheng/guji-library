f-973c-a0d3651f611f"},{"place_name":"亳社","place_name_jianti_auto":"亳社","resolved_place_entity_id":5806,"start_index":73,"tongjian_id":"92e8ad93-db0e-11ef-b980-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":120,"tongjian_id":"92e8ad9b-db0e-11ef-b039-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"紹從弟竦與崇族父嘉詣闕自歸；莽赦弗罪。竦因爲嘉作奏，稱莽德美，罪狀劉崇：「願爲宗室倡始，父子兄弟負籠荷鍤，馳之南陽，豬崇宮室，令如古制；及崇社宜如亳社，以賜諸侯，用永監戒！」於是莽大說，封嘉爲率禮侯，嘉子七人皆賜爵關內侯；後又封竦爲淑德侯。長安爲之語曰：「欲求封，過張伯松。力戰鬭，不如巧爲奏。」自後謀反皆汙池云。","content_fanyi":"张绍的堂弟张竦与刘崇的族伯父刘嘉到宫阙前自首归附；王莽赦免他们，不加治罪。张竦趁机替刘嘉撰写奏章，称颂王莽的美德，列举刘崇的罪状说：“我们愿意为宗室带头倡导，父子兄弟背着土笼、扛着铁锹，赶赴南阳，将刘崇的宫室毁成污池，使它合于古制；刘崇的社坛也应像亳社那样毁掉，分赐给诸侯，作为永久的鉴戒！”王莽因此大喜，封刘嘉为率礼侯，刘嘉的七个儿子都赐爵关内侯；后来又封张竦为淑德侯。长安人为此编成俗语说：“想要求得封爵，去拜访张伯松；奋力作战，不如巧妙上奏。”从此以后，谋反者的住宅都被毁作污池。","content_jianti_auto":"绍从弟竦与崇族父嘉诣阙自归；莽赦弗罪。竦因为嘉作奏，称莽德美，罪状刘崇：「愿为宗室倡始，父子兄弟负笼荷锸，驰之南阳，猪崇宫室，令如古制；及崇社宜如亳社，以赐诸侯，用永监戒！」于是莽大说，封嘉为率礼侯，嘉子七人皆赐爵关内侯；后又封竦为淑德侯。长安为之语曰：「欲求封，过张伯松。力战鬭，不如巧为奏。」自后谋反皆污池云。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2774,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"92e6637c-db0e-11ef-9581-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"假皇帝","official_note":"假皇帝是王莽在居摄元年（公元6年）被太后诏命使用的称号，表示他作为摄政或代理皇帝行使权力，但非正式皇帝。在《资治通鉴》此段中，此官职反映了王莽在汉朝末期的政治地位上升，是篡位前的过渡性职务。","official_rank":"未知","source_snippet":"太后詔莽朝見太后稱「假皇帝」","start_index":38,"tongjian_id":"2ede8f8c-5f7e-4153-86a0-c7fe430da144"}],"ExtRef_Children_people":[{"link_birth_year":-50,"link_death_year":7,"link_td_description":"刘宠，南阳安众人，西汉宗室，安众侯，长沙定王刘发之子安众康侯刘丹的六世孙，因古籍传写笔误被记载为刘崇。","link_td_id":"Q10004726","link_td_number_id":6007806,"people_name":"劉崇","people_name_jianti_auto":"刘崇","people_xingming":"刘崇","start_index":6,"tongjian_id":"92e8ada0-db0e-11ef-ab9f-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":14,"tongjian_id":"92e8ada1-db0e-11ef-ba5f-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":37,"tongjian_id":"92e8ada2-db0e-11ef-9b57-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"羣臣復曰：「劉崇等謀逆者，以莽權輕也；宜尊重以塡海內。」五月，甲辰，太后詔莽朝見太后稱「假皇帝」。","content_fanyi":"群臣再次上奏说：“刘崇等人谋反，是因为王莽的权位太轻；应当提高他的尊崇地位，以镇服天下。”五月甲辰日，太皇太后下诏，命王莽在朝见太后时自称“假皇帝”。","content_jianti_auto":"群臣复曰：「刘崇等谋逆者，以莽权轻也；宜尊重以塡海内。」五月，甲辰，太后诏莽朝见太后称「假皇帝」。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2775,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"92e8ad9c-db0e-11ef-b082-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5冬，十月，丙辰朔，日有食之。","content_fanyi":"冬季，十月，丙辰朔这一天，出现了日食。","content_jianti_auto":"5冬，十月，丙辰朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2776,"number":5,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"92e8ada3-db0e-11ef-bffb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"廬，殿中止宿之舍。府，治事之所。第，所居也。","note_content_jianti_auto":"庐，殿中止宿之舍。府，治事之所。第，所居也。","note_type":"hu_note","start_index":31,"tongjian_id":"92e8ada5-db0e-11ef-a123-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"安漢公","official_note":"安漢公是王莽的封爵，在漢朝末年由漢平帝封賜，象徵其權力地位，此處用於指代王莽，在上下文中表示羣臣奏請以安漢公的廬、府、第改為攝省、攝殿、攝宮，反映了王莽攝政時期的權力擴張。","official_rank":"未知","source_snippet":"安漢公","start_index":8,"tongjian_id":"11a07370-85a2-4de5-97b2-55657ab9176c"}],"ExtRef_Children_people":[{"people_name":"安漢公","people_name_jianti_auto":"安汉公","people_xingming":"安汉公","start_index":10,"tongjian_id":"92e8ada6-db0e-11ef-a7ef-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"6十二月，羣臣奏請以安漢公廬爲攝省，府爲攝殿，第爲攝宮。奏可。","content_fanyi":"十二月，群臣上奏请求将安汉公在皇宫中的庐舍改称摄省，府署改称摄殿，宅第改称摄宫。奏请获得准许。","content_jianti_auto":"6十二月，群臣奏请以安汉公庐为摄省，府为摄殿，第为摄宫。奏可。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2777,"number":6,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"92e8ada4-db0e-11ef-8c1c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92e8ada9-db0e-11ef-b7f4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：幡，音敷元翻。","note_content_jianti_auto":"师古曰：幡，音敷元翻。","note_type":"hu_note","start_index":12,"tongjian_id":"92e8ada8-db0e-11ef-9bba-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"西海太守","official_note":"西海太守是漢朝在西海郡設置的地方行政長官，負責管理該郡的民政和軍事事務。在《資治通鑑》此段中，西海太守程永因西羌反攻而奔走，後被王莽誅殺，這反映了王莽時期對地方官員的嚴厲控制。","official_rank":"未知","source_snippet":"西海太守程永","start_index":18,"tongjian_id":"e45ffb3f-3ccc-41fa-81e0-28d6ba041117"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"護羌校尉","official_note":"護羌校尉是漢朝設置的軍事官職，專門負責鎮壓和管理羌族事務，維護邊疆穩定。在《資治通鑑》此段中，王莽派遣護羌校尉竇況擊之，以應對西羌的反叛，顯示了該官職在處理民族衝突中的軍事作用。","official_rank":"未知","source_snippet":"護羌校尉竇況","start_index":30,"tongjian_id":"baeee637-32c0-4054-a3ff-c9fcfb3d14b4"}],"ExtRef_Children_people":[{"people_name":"龐恬","people_name_jianti_auto":"庞恬","people_xingming":"庞恬","start_index":6,"tongjian_id":"92e8adaa-db0e-11ef-a2d5-a0d3651f611f"},{"people_name":"傅幡","people_name_jianti_auto":"傅幡","people_xingming":"傅幡","start_index":9,"tongjian_id":"92e8adab-db0e-11ef-9791-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":13,"tongjian_id":"92e8adad-db0e-11ef-a302-a0d3651f611f"},{"people_name":"程永","people_name_jianti_auto":"程永","people_xingming":"程永","start_index":24,"tongjian_id":"92e8adae-db0e-11ef-