{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"莽","people_name_jianti_auto":"莽","start_index":6,"tongjian_id":"92e6633e-db0e-11ef-a4b8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丙寅、六）莽旣攝政，遂改元爲居攝。","note_content_jianti_auto":"（丙寅、六）莽既摄政，遂改元为居摄。","note_type":"hu_note","start_index":0,"tongjian_id":"92e6633d-db0e-11ef-8f71-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":2,"chapter_name":"书法篇第二","chenzhu_chapter":"《通鉴》书法，不尽关褒贬，故不如《春秋》之严。温公谦不敢法《春秋》，而志在续《左氏传》，有所感触，亦仿左氏设辞“君子曰”而称“臣光曰”以发之。馀则据事直书，使人随其时地之异而评其得失，以为鉴戒，非有一定不易之书法也。旧传温公《修书前例》一卷，公曾孙伋曾梓行之，然脱落已甚，不皆可据。兹篇所录，则身之推论《通鉴》之书法为多，其有关全书义例及史文构造、史料采取，亦隶焉，固与《通鉴纲目》等之所谓书法，涵义颇殊也。","chenzhu_index_in_chapter":6,"chenzhu_text":"《通鉴》不书莽改正朔，身之因其阙文，而推论之如此。","created_at":"2025-12-31 08:50:44","seq_in_chapter":25,"tongjian_id":"CH02-CZ006"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王莽","people_name_jianti_auto":"王莽","start_index":11,"tongjian_id":"92e66341-db0e-11ef-a078-a0d3651f611f"},{"people_name":"王莽","people_name_jianti_auto":"王莽","start_index":24,"tongjian_id":"92e66342-db0e-11ef-a6d6-a0d3651f611f"},{"people_name":"莽","people_name_jianti_auto":"莽","start_index":40,"tongjian_id":"92e66343-db0e-11ef-9a20-a0d3651f611f"},{"people_name":"呂后","people_name_jianti_auto":"吕后","start_index":48,"tongjian_id":"92e66344-db0e-11ef-8eae-a0d3651f611f"},{"people_name":"武后","people_name_jianti_auto":"武后","start_index":51,"tongjian_id":"92e66345-db0e-11ef-968d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"上無天子，通鑑不得不以王莽繫年。不書假皇帝而直書王莽者，不與其攝也。及其旣篡也書莽，不與其篡也。呂后、武后書「太后」，其義亦然。","note_content_jianti_auto":"上无天子，通鉴不得不以王莽系年。不书假皇帝而直书王莽者，不与其摄也。及其既篡也书莽，不与其篡也。吕后、武后书「太后」，其义亦然。","note_type":"hu_note","start_index":28,"tongjian_id":"92e66340-db0e-11ef-92ba-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"王莽","people_name_jianti_auto":"王莽","people_xingming":"王莽","start_index":6,"tongjian_id":"92e66347-db0e-11ef-b3f1-a0d3651f611f","wl_zhushi":"[时年五十一]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，王莽祀上帝於南郊，又行迎春、大射、養老之禮。","content_fanyi":"春季正月，王莽在长安南郊祭祀上帝，又举行迎春、大射、养老之礼。","content_jianti_auto":"1春，正月，王莽祀上帝于南郊，又行迎春、大射、养老之礼。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2770,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"92e6633f-db0e-11ef-b30a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周公","people_name_jianti_auto":"周公","start_index":2,"tongjian_id":"92e6634a-db0e-11ef-80aa-a0d3651f611f"},{"people_name":"成王","people_name_jianti_auto":"成王","start_index":5,"tongjian_id":"92e6634b-db0e-11ef-a6ae-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"亦因周公輔成王，二叔流言曰，「公將不利於孺子」，而爲此號。","note_content_jianti_auto":"亦因周公辅成王，二叔流言曰，「公将不利于孺子」，而为此号。","note_type":"hu_note","start_index":23,"tongjian_id":"92e66349-db0e-11ef-9ad0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚孝王","people_name_jianti_auto":"楚孝王","start_index":0,"tongjian_id":"92e6634d-db0e-11ef-8d6f-a0d3651f611f"},{"people_name":"勳","people_name_jianti_auto":"勋","start_index":4,"tongjian_id":"92e6634e-db0e-11ef-9327-a0d3651f611f"},{"people_name":"廣戚侯","people_name_jianti_auto":"广戚侯","start_index":6,"tongjian_id":"92e6634f-db0e-11ef-99fd-a0d3651f611f"},{"people_name":"顯","people_name_jianti_auto":"显","start_index":10,"tongjian_id":"92e66350-db0e-11ef-a141-a0d3651f611f"},{"people_name":"勳","people_name_jianti_auto":"勋","start_index":12,"tongjian_id":"92e66351-db0e-11ef-927d-a0d3651f611f"},{"people_name":"廣戚侯","people_name_jianti_auto":"广戚侯","start_index":24,"tongjian_id":"92e66352-db0e-11ef-8873-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","start_index":21,"tongjian_id":"92e66353-db0e-11ef-8f11-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楚孝王子勳封廣戚侯，顯則勳之子也。地理志，沛郡有廣戚侯國。","note_content_jianti_auto":"楚孝王子勋封广戚侯，显则勋之子也。地理志，沛郡有广戚侯国。","note_type":"hu_note","start_index":33,"tongjian_id":"92e6634c-db0e-11ef-a167-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"皇储","official_name":"皇太子","official_note":"皇太子是皇帝的继承人，此处指立刘婴为皇太子，以确立储君地位。","official_rank":"未知","source_snippet":"立宣帝玄孫嬰爲皇太子","start_index":8,"tongjian_id":"ed05e024-6734-4fa3-ae71-51b445468c35"},{"confidence":0.9,"official_category":"地方行政","official_name":"廣戚侯","official_note":"廣戚侯是汉代的侯爵封号，此处指刘婴的父亲刘显的爵位，表明其出身。","official_rank":"侯爵","source_snippet":"廣戚侯顯之子也","start_index":22,"tongjian_id":"f55c353c-8ca2-4b47-985a-345ea8908d0c"},{"confidence":0.85,"official_category":"宫廷","official_name":"皇后","official_note":"皇后是皇帝的正妻，此处被尊为皇太后，表示其地位提升。","official_rank":"未知","source_snippet":"尊皇后曰皇太后","start_index":44,"tongjian_id":"eed32c2b-9165-47e8-ab91-31ef74bb37c7"},{"confidence":0.85,"official_category":"宫廷","official_name":"皇太后","official_note":"皇太后是皇帝的母亲或祖母，此处指尊皇后为皇太后，以确立其新身份。","official_rank":"未知","source_snippet":"尊皇后曰皇太后","start_index":44,"tongjian_id":"c5b8ca90-ea5f-4689-94e3-5d513765f045"}],"ExtRef_Children_people":[{"link_birth_year":-91,"link_death_year":-48,"link_td_description":"汉宣帝刘询，原名刘病已，字次卿，即位九年后改名询，汉朝皇帝（前74年9月10日－前48年1月10日在位），其正式谥号为「孝宣皇帝」，后世省略「孝」字称「汉宣帝」。汉武帝的曾孙，戾太子刘据的长孙，史皇孙刘进的长子，生母为王翁须。","link_td_id":"Q10000317","link_td_number_id":99982,"people_name":"宣帝","people_name_jianti_auto":"宣帝","people_xingming":"刘病已","start_index":8,"tongjian_id":"92e66356-db0e-11ef-a6d5-a0d3651f611f","wl_zhushi":"[刘病已]"},{"link_birth_year":5,"link_death_year":25,"link_td_description":"刘婴，西汉末代君主、皇太子（6年4月17日－9年1月15日为皇太子，未正式即位），号孺子，故称孺子婴，是汉宣帝的玄孙、楚孝王刘嚣曾孙、广戚炀侯刘勋孙、广戚侯刘显子。","link_td_id":"Q10000184","link_td_number_id":100333,"people_name":"嬰","people_name_jianti_auto":"婴","people_xingming":"刘婴","start_index":12,"tongjian_id":"92e66357-db0e-11ef-abd0-a0d3651f611f"},{"link_birth_year":5,"link_death_year":25,"link_td_description":"刘婴，西汉末代君主、皇太子（6年4月17日－9年1月15日为皇太子，未正式即位），号孺子，故称孺子婴，是汉宣帝的玄孙、楚孝王刘嚣曾孙、广戚炀侯刘勋孙、广戚侯刘显子。","link_td_id":"Q10000184","link_td_number_id":100333,"people_name":"孺子","people_name_jianti_auto":"孺子","people_xingming":"刘婴","start_index":20,"tongjian_id":"92e66358-db0e-11ef-8372-a0d3651f611f"},{"link_birth_year":5,"link_death_year":25,"link_td_description":"刘婴，西汉末代君主、皇太子（6年4月17日－9年1月15日为皇太子，未正式即位），号孺子，故称孺子婴，是汉宣帝的玄孙、楚孝王刘嚣曾孙、广戚炀侯刘勋孙、广戚侯刘显子。","link_td_id":"Q10000184","link_td_number_id":100333,"people_name":"嬰","people_name_jianti_auto":"婴","people_xingming":"刘婴","start_index":23,"tongjian_id":"92e66359-db0e-11ef-876d-a0d3651f611f"},{"link_death_year":-25,"link_td_description":"刘嚣，是汉朝宗室，汉宣帝的第三子，其生母是卫婕妤。","link_td_id":"Q10005066","link_td_number_id":1010345,"people_name":"廣戚侯","people_name_jianti_auto":"广戚侯","people_xingming":"刘显","start_index":25,"tongjian_id":"92e6635a-db0e-11ef-a5bb-a0d3651f611f"},{"link_death_year":-25,"link_td_description":"刘嚣，是汉朝宗室，汉宣帝的第三子，其生母是卫婕妤。","link_td_id":"Q10005066","link_td_number_id":1010345,"people_name":"顯","people_name_jianti_auto":"显","people_xingming":"刘显","start_index":28,"tongjian_id":"92e6635b-db0e-11ef-a79d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2三月，己丑，立宣帝玄孫嬰爲皇太子，號曰孺子。嬰，廣戚侯顯之子也。年二歲；託以卜相最吉，立之。尊皇后曰皇太后。","content_fanyi":"三月己丑日，册立宣帝的玄孙刘婴为皇太子，称为孺子。刘婴是广戚侯刘显的儿子，年仅两岁；王莽假托占卜看相的结果最吉，于是立他为皇太子。尊奉王皇后为皇太后。","content_jianti_auto":"2三月，己丑，立宣帝玄孙婴为皇太子，号曰孺子。婴，广戚侯显之子也。年二岁；托以卜相最吉，立之。尊皇后曰皇太后。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2771,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"92e66348-db0e-11ef-8642-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"92e6635e-db0e-11ef-81f0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：拂，讀曰弼。","note_content_jianti_auto":"师古曰：拂，读曰弼。","note_type":"hu_note","start_index":20,"tongjian_id":"92e6635d-db0e-11ef-b449-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"四少，少師、少傅、少阿、少保也。少，詩照翻。","note_content_jianti_auto":"四少，少师、少傅、少阿、少保也。少，诗照翻。","note_type":"hu_note","start_index":40,"tongjian_id":"92e6635f-db0e-11ef-8822-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"太傅","official_note":"太傅是古代三公之一，负责辅佐皇帝，此处王莽任命王舜为太傅，以加强其摄政时期的权力基础。","official_rank":"正一品","source_snippet":"以王舜爲太傅、左輔","start_index":1,"tongjian_id":"296a6016-8bbc-47ef-90d4-fc9b39910540"},{"confidence":0.85,"official_category":"中枢机构","official_name":"左輔","official_note":"左輔是辅助官职，可能指左辅弼，在王莽时期作为近臣辅佐摄政，此处与太傅并列任命给王舜。","official_rank":"未知","source_snippet":"以王舜爲太傅、左輔","start_index":7,"tongjian_id":"c90b8ee3-2478-43ce-a676-53748076d415"},{"confidence":0.8,"official_category":"中枢机构","official_name":"太阿","official_note":"太阿是古代官职，可能指太阿衡，负责辅政或军事，此处王莽任命甄豐为太阿，以巩固其统治。","official_rank":"未知","source_snippet":"甄豐爲太阿、右拂","start_index":12,"tongjian_id":"408c26ae-4817-45a1-b722-7bda97ef43ea"},{"confidence":0.85,"official_category":"中枢机构","official_name":"右拂","official_note":"右拂是辅助官职，可能指右辅弼，与左輔对称，在王莽时期作为近臣辅佐摄政，此处与太阿并列任命给甄豐。","official_rank":"未知","source_snippet":"甄豐爲太阿、右拂","start_index":16,"tongjian_id":"9190cd01-7625-40a5-944b-34a4908cee66"},{"confidence":0.95,"official_category":"中枢机构","official_name":"太保","official_note":"太保是古代三公之一，负责监护皇帝，此处王莽任命甄邯为太保，以增强其摄政时期的权威。","official_rank":"正一品","source_snippet":"甄邯爲太保、後承","start_index":21,"tongjian_id":"06307053-9098-4bb6-a493-c7efe121cfeb"},{"confidence":0.8,"official_category":"中枢机构","official_name":"後承","official_note":"後承是辅助官职，可能指后承继或辅佐，在王莽时期作为近臣辅佐摄政，此处与太保并列任命给甄邯。","official_rank":"未知","source_snippet":"甄邯爲太保、後承","start_index":25,"tongjian_id":"ee99b620-9d08-4946-9f76-f5d826605456"},{"confidence":0.9,"official_category":"中枢机构","official_name":"四少","official_note":"四少是王莽设置的官职，可能指少傅、少保等辅助三公的官职，秩二千石表示其俸禄等级，此处用于扩充官僚体系以支持摄政。","official_rank":"二千石","source_snippet":"又置四少，秩皆二千石","start_index":29,"tongjian_id":"b4df02a0-f601-408e-8dee-6512059771c1"}],"ExtRef_Children_people":[{"link_death_year":16,"link_td_description":"王舜，魏郡元城人，西汉末年官员、外戚。","link_td_id":"Q10012817","link_td_number_id":1509134,"people_name":"王舜","people_name_jianti_a