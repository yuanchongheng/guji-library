s_tags":[],"content":"3夏，四月，丙子，車駕幸九成宮。","content_fanyi":"夏季，四月二十一日丙子，高宗的车驾来到九成宫。","content_jianti_auto":"3夏，四月，丙子，车驾幸九成宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19849,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"b9c71787-db0e-11ef-8428-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"胡嶠","people_name_jianti_auto":"胡峤","start_index":0,"tongjian_id":"b9c7178b-db0e-11ef-9477-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"黑車子","place_name_jianti_auto":"黑车子","start_index":4,"tongjian_id":"b9c7178c-db0e-11ef-bfdd-a0d3651f611f"},{"place_name":"牛蹄突厥","place_name_jianti_auto":"牛蹄突厥","start_index":11,"tongjian_id":"b9c7178d-db0e-11ef-8a1d-a0d3651f611f"},{"place_name":"瓠𤬘河","place_name_jianti_auto":"瓠𤬘河","start_index":28,"tongjian_id":"b9c7178e-db0e-11ef-9add-a0d3651f611f"},{"place_name":"瓠蘆河","place_name_jianti_auto":"瓠芦河","start_index":66,"tongjian_id":"b9c7178f-db0e-11ef-bc7d-a0d3651f611f"},{"place_name":"高麗","place_name_jianti_auto":"高丽","start_index":71,"tongjian_id":"b9c71790-db0e-11ef-a501-a0d3651f611f"},{"place_name":"新羅","place_name_jianti_auto":"新罗","place_note":"首都金城【韩国庆州市】","start_index":76,"tongjian_id":"b9c71791-db0e-11ef-b47e-a0d3651f611f"},{"place_name":"七重城","place_name_jianti_auto":"七重城","start_index":78,"tongjian_id":"b9c71792-db0e-11ef-acf6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"胡嶠曰：黑車子之北，有牛蹄突厥，人身牛足。其地尤寒，水曰瓠𤬘河，夏秋冰厚二尺，秋冬冰徹底，常燒器銷冰，乃得飲。余按唐書·劉仁軌傳，此瓠蘆河當在高麗南界，新羅七重城之北。燕，因肩翻；下同。","note_content_jianti_auto":"胡峤曰：黑车子之北，有牛蹄突厥，人身牛足。其地尤寒，水曰瓠𤬘河，夏秋冰厚二尺，秋冬冰彻底，常烧器销冰，乃得饮。余按唐书·刘仁轨传，此瓠芦河当在高丽南界，新罗七重城之北。燕，因肩翻；下同。","note_type":"hu_note","start_index":33,"tongjian_id":"b9c7178a-db0e-11ef-9cb1-a0d3651f611f"},{"ExtRef_Childr