f-956e-a0d3651f611f"},{"place_name":"興慶宮","place_name_jianti_auto":"兴庆宫","start_index":311,"tongjian_id":"c4a3a5a3-db0e-11ef-aae2-a0d3651f611f"},{"place_name":"勤政樓","place_name_jianti_auto":"勤政楼","start_index":325,"tongjian_id":"c4a3a5a4-db0e-11ef-a862-a0d3651f611f"},{"place_name":"景陵","place_name_jianti_auto":"景陵","place_note":"李纯墓•陕西省蒲城县西北金炽山","start_index":407,"tongjian_id":"c4a3a5a5-db0e-11ef-b604-a0d3651f611f"},{"place_name":"潤州","place_name_jianti_auto":"润州","start_index":445,"tongjian_id":"c4a3a5a6-db0e-11ef-9467-a0d3651f611f"},{"place_name":"句容縣","place_name_jianti_auto":"句容县","start_index":447,"tongjian_id":"c4a3a5a7-db0e-11ef-992e-a0d3651f611f"},{"place_name":"西川","place_name_jianti_auto":"西川","start_index":591,"tongjian_id":"c4a3a5a8-db0e-11ef-acb1-a0d3651f611f"},{"place_name":"黔中","place_name_jianti_auto":"黔中","start_index":600,"tongjian_id":"c4a3a5a9-db0e-11ef-8a79-a0d3651f611f"},{"place_name":"西川","place_name_jianti_auto":"西川","start_index":606,"tongjian_id":"c4a3a5aa-db0e-11ef-b455-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":729,"tongjian_id":"c4a3a5ab-db0e-11ef-a8d6-a0d3651f611f"},{"place_name":"延英","place_name_jianti_auto":"延英","start_index":828,"tongjian_id":"c4a3a5ac-db0e-11ef-8ae3-a0d3651f611f"},{"place_name":"黔中","place_name_jianti_auto":"黔中","start_index":860,"tongjian_id":"c4a3a5ad-db0e-11ef-bc57-a0d3651f611f"},{"place_name":"西川","place_name_jianti_auto":"西川","start_index":875,"tongjian_id":"c4a3a5ae-db0e-11ef-b154-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：實錄：「五月，戊寅，以太皇太后寢疾，權不聽政，宰臣帥百寮問太后起居。己卯，復問起居，下遺令。是日，太后崩。初，上纂位，以憲宗遇弒，頗疑后在黨中，至是，暴得疾崩，帝之志也。甲申，白敏中帥百寮上表請聽政，不許。乙酉，又上表，不許。丙戌，三上表，乃依。六月，貶禮院檢討官王皞爲潤州句容令。」舊傳曰：「宣宗繼統，卽后之諸子也，恩禮愈異於前朝。大中年崩，祔景陵。后歷位七朝，五居太母之尊，人君行子孫之禮，福壽隆貴四十餘年，雖漢之馬、鄧無以加焉，識者以爲汾陽社稷之功未泯，復鍾慶於懿安焉。」裴延裕東觀奏記曰：「憲宗皇帝晏駕之夕，上雖幼，頗記其事，追恨光陵商臣之酷，卽位後，誅鉏惡黨，無漏網者。郭太后以上英察孝果，且懷慚懼，時居興慶宮，一日，與一二侍兒同升勤政樓，倚衡而望，便欲殞於樓下，欲成上過；左右急持之，卽聞於上。上大怒，其夕，太后暴崩，上志也。」又曰：「懿安郭太后旣崩，喪服許如故事。禮院檢討官王皞抗疏，請后合葬景陵，配饗憲宗廟室。旣入，上大怒。宰臣白敏中召皞詰其事。皞對云云。翌日，皞貶潤州句容縣令；周墀亦免相。」按實錄所言暴崩事，皆出於東觀奏記。若實有此事，則旣云是夕暴崩，何得前一日先下詔云，以太后寢疾，權不聽政。若無此事，則廷裕豈敢輒誣宣宗！或者郭后實以病終，而宣宗以平日疑忿之心，欲黜其禮，故皞爭之。疑以傳疑，今參取之。東觀奏記又曰：「杜悰通貴日久，門下有術士姓李。悰任西川節度使，馬植罷黔中赴闕，至西川，李術士一見植，謂悰曰：『馬中丞非常人也，相公厚遇之。』悰未之信。術士一日密言於悰曰：『相公將有甚禍，非馬中丞不能救，乞厚結之。』悰始驚信。發日，厚幣贈之，仍令邸吏爲植於闕下買宅，生生之費無闕焉。植至門，方知感悰，不知其旨。尋除光祿卿，報狀至蜀，悰謂術士曰：『貴人到闕作光祿勳矣。』術士曰：『姑待之。』稍進大理卿，又遷刑部侍郞，充諸道鹽鐵使。悰始驚憂。俄而作相。懿安皇太后崩後，悰，懿安子壻也，忽一日，內榜子索檢責宰相元載故事。植諭旨。翌日延英，上前萬端營救。植素辯，能回上旨，事遂中寢。按植，會昌中已自黔中入爲大理卿。悰今年二月始爲西川節度。今不取。按裴延裕後作「廷裕」，必有一誤。","note_content_jianti_auto":"考异曰：实录：「五月，戊寅，以太皇太后寝疾，权不听政，宰臣帅百寮问太后起居。己卯，复问起居，下遗令。是日，太后崩。初，上纂位，以宪宗遇弑，颇疑后在党中，至是，暴得疾崩，帝之志也。甲申，白敏中帅百寮上表请听政，不许。乙酉，又上表，不许。丙戌，三上表，乃依。六月，贬礼院检讨官王皞为润州句容令。」旧传曰：「宣宗继统，即后之诸子也，恩礼愈异于前朝。大中年崩，祔景陵。后历位七朝，五居太母之尊，人君行子孙之礼，福寿隆贵四十余年，虽汉之马、邓无以加焉，识者以为汾阳社稷之功未泯，复钟庆于懿安焉。」裴延裕东观奏记曰：「宪宗皇帝晏驾之夕，上虽幼，颇记其事，追恨光陵商臣之酷，即位后，诛鉏恶党，无漏网者。郭太后以上英察孝果，且怀惭惧，时居兴庆宫，一日，与一二侍儿同升勤政楼，倚衡而望，便欲殒于楼下，欲成上过；左右急持之，即闻于上。上大怒，其夕，太后暴崩，上志也。」又曰：「懿安郭太后既崩，丧服许如故事。礼院检讨官王皞抗疏，请后合葬景陵，配飨宪宗庙室。既入，上大怒。宰臣白敏中召皞诘其事。皞对云云。翌日，皞贬润州句容县令；周墀亦免相。」按实录所言暴崩事，皆出于东观奏记。若实有此事，则既云是夕暴崩，何得前一日先下诏云，以太后寝疾，权不听政。若无此事，则廷裕岂敢辄诬宣宗！或者郭后实以病终，而宣宗以平日疑忿之心，欲黜其礼，故皞争之。疑以传疑，今参取之。东观奏记又曰：「杜悰通贵日久，门下有术士姓李。悰任西川节度使，马植罢黔中赴阙，至西川，李术士一见植，谓悰曰：『马中丞非常人也，相公厚遇之。』悰未之信。术士一日密言于悰曰：『相公将有甚祸，非马中丞不能救，乞厚结之。』悰始惊信。发日，厚币赠之，仍令邸吏为植于阙下买宅，生生之费无阙焉。植至门，方知感悰，不知其旨。寻除光禄卿，报状至蜀，悰谓术士曰：『贵人到阙作光禄勋矣。』术士曰：『姑待之。』稍进大理卿，又迁刑部侍郞，充诸道盐铁使。悰始惊忧。俄而作相。懿安皇太后崩后，悰，懿安子壻也，忽一日，内榜子索检责宰相元载故事。植谕旨。翌日延英，上前万端营救。植素辩，能回上旨，事遂中寝。按植，会昌中已自黔中入为大理卿。悰今年二月始为西川节度。今不取。按裴延裕后作「廷裕」，必有一误。","note_type":"hu_note","start_index":212,"tongjian_id":"c4a3a56a-db0e-11ef-b851-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"景陵","place_name_jianti_auto":"景陵","place_note":"李纯墓•陕西省蒲城县西北金炽山","resolved_place_entity_id":2644,"start_index":20,"tongjian_id":"c4a3a5bf-db0e-11ef-8c00-a0d3651f611f"},{"place_name":"景陵","place_name_jianti_auto":"景陵","place_note":"李纯墓•陕西省蒲城县西北金炽山","resolved_place_entity_id":2644,"start_index":30,"tongjian_id":"c4a3a5c0-db0e-11ef-ade9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/郭令公","excerpts":[{"context_after":"，自是支胄不复振。及本朝庆历四年，访求厥后，仅得裔孙元亨...","context_before":"唐人功名富贵之盛，未有出郭汾阳之右者。然至","source_end_index":48,"source_paragraph_tongjian_id":"0a0a776a-3907-4792-9c73-232050aed9ee","source_start_index":21,"source_text":"其女孙为宪宗正妃，历五朝，母天下，终以不得志于宣宗而死"}],"path":"续笔/卷十三/郭令公","source_name":"容斋随笔"}],"class_tags":[],"content":"上以鄭太后故，不欲以郭后祔憲宗，有司請葬景陵外園；皞奏宜合葬景陵，神主配憲宗室，奏入，上大怒。白敏中召皞詰之，皞曰：「太皇太后，汾陽王之孫，憲宗在東宮爲正妃，逮事順宗爲婦。憲宗厭代之夕，事出曖昧；太皇太后母天下，歷五朝，豈得以曖昧之事遽廢正嫡之禮乎！」敏中怒甚，皞辭氣愈厲。諸相會食，周墀立於敏中之門以俟之，敏中使謝曰：「方爲一書生所苦，公弟先行。」墀入，至敏中廳問其事，見皞爭辨方急，墀舉手加顙，歎皞孤直。明日，皞坐貶官。","content_fanyi":"宣宗因为郑太后的缘故，不愿意让郭太后祔葬于宪宗陵寝；主管丧礼的官员请求把郭太后葬在景陵外园；王皞上奏说应当与宪宗合葬于景陵，神主也应配享于宪宗室。奏疏交入，宣宗大怒。白敏中召来王皞责问，王皞说：“太皇太后是汾阳王郭子仪的孙女，宪宗在东宫为太子时是正妃，又曾作为媳妇侍奉顺宗。宪宗去世的那个夜晚，死因暧昧不明；太皇太后身为天下之母，前后经历穆宗、敬宗、文宗、武宗、宣宗五朝，怎么能因为暧昧不明的事情就骤然废弃正嫡的礼制呢！”白敏中更加愤怒，王皞的言辞语气却更加严厉。诸宰相在政事堂会食时，周墀站在白敏中门前等候他，白敏中派人辞谢说：“方才正被一个书生气得厉害，您请先走吧。”周墀进去后，到白敏中厅中询问此事原委，看见王皞正争辩得急切，便把手举到额前，感叹王皞孤直可敬。第二天，王皞因此被贬官。","content_jianti_auto":"上以郑太后故，不欲以郭后祔宪宗，有司请葬景陵外园；皞奏宜合葬景陵，神主配宪宗室，奏入，上大怒。白敏中召皞诘之，皞曰：「太皇太后，汾阳王之孙，宪宗在东宫为正妃，逮事顺宗为妇。宪宗厌代之夕，事出暧昧；太皇太后母天下，历五朝，岂得以暧昧之事遽废正嫡之礼乎！」敏中怒甚，皞辞气愈厉。诸相会食，周墀立于敏中之门以俟之，敏中使谢曰：「方为一书生所苦，公弟先行。」墀入，至敏中厅问其事，见皞争辨方急，墀举手加颡，叹皞孤直。明日，皞坐贬官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25321,"path":"资治通鉴 : 卷第二百四十八 (唐紀六十四) / 宣宗元聖至明成武獻文睿智章仁神聰懿道大孝皇帝上 / 二年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"c4a3a55f-db0e-11ef-aa79-a0d3651f611f","year_int":848},"tongjian_id":"c4a3a55f-db0e-11ef-aa79-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"景陵","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"憲宗","people_name_jianti_auto":"宪宗","start_index":4,"tongjian_id":"c4a5efe0-db0e-11ef-9cbd-a0d3651f611f"},{"people_name":"宣宗","people_name_jianti_auto":"宣宗","start_index":14,"tongjian_id":"c4a5efe1-db0e-11ef-acf4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"非禮也。憲宗不爲正其始，以致宣宗不爲正其終。","note_content_jianti_auto":"非礼也。宪宗不为正其始，以致宣宗不为正其终。","note_type":"hu_note","start_index":16,"tongjian_id":"c4a5efdf-db0e-11ef-ab99-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"景陵","place_name_jianti_auto":"景陵","resolved_place_entity_id":2644,"start_index":11,"tongjian_id":"c4a5efe3-db0e-11ef-ace0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"13壬午，葬懿安皇后於景陵之側。","content_fanyi":"十一月二十六日壬午，将懿安皇后安葬在景陵的旁边。","content_jianti_auto":"13壬午，葬懿安皇后于景陵之侧。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25325,"number":13,"path":"资治通鉴 : 卷第二百四十八 (唐紀六十四) / 宣宗元聖至明成武獻文睿智章仁神聰懿道大孝皇帝上 / 二年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"c4a5efde-db0e-11ef-a4a3-a0d3651f611f","year_int":848},"tongjian_id":"c4a5efde-db0e-11ef-a4a3-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"景陵","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孝明皇后","people_name_jianti_auto":"孝明皇后","start_index":0,"tongjian_id":"c50f722e-db0e-11ef-800e-a0d3651f611f"},{"people_name":"宣宗","people_name_jianti_auto":"宣宗","start_index":5,"tongjian_id":"c50f722f-db0e-11ef-990d-a0d3651f611f"},{"people_name":"鄭太后","people_name_jianti_auto":"郑太后","start_index":8,"tongjian_id":"c50f7230-db0e-11ef-9dfe-a0d3651f611f"},{"people_name":"懿安郭后","people_name_jianti_auto":"懿安郭后","start_index":13,"tongjian_id":"c50f7231-db0e-11ef-91f3-a0d3651f611f"},{"people_name":"憲宗","people_name_jianti_auto":"宪宗","start_index":18,"tongjian_id":"c50f7232-db0e-11ef-9eba-a0d3651f611f"},{"people_name":"鄭后","people_name_jianti_auto":"郑后","start_index":31,"tongjian_id":"c50f7233-db0e-11ef-903b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孝明皇后，宣宗母鄭太后也，懿安郭后，憲宗之元妃也，配食于太廟，鄭后，側室也，祔別廟，禮也。","note_content_jianti_auto":"孝明皇后，宣宗母郑太后也，懿安郭后，宪宗之元妃也，配食于太庙，郑后，侧室也，祔别庙，礼也。","note_type":"hu_note","start_index":20,"tongjian_id":"c50f722d-db0e-11ef-bd0a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"景陵","place_name_jianti_auto":"景陵","place_note":"李纯墓•陕西省蒲城县西北金炽山","resolved_place_entity_id":2644,"start_index":10,"tongjian_id":"c50f7235-db0e-11ef-8895-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6五月，葬孝明皇后於景陵之側，主祔別廟。","content_fanyi":"五月，孝明皇后安葬在景陵旁，神主祔入别庙。","content_jianti_auto":"6五月，葬孝明皇后于景陵之侧，主祔别庙。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25629,"number":6,"path":"资治通鉴 : 卷第二百五十 (唐紀六十六) / 懿宗昭聖恭惠孝皇帝上 / 七年 / 第 8 段","reading_annotation_sources":[],"start_index":7,"tongjian_id":"c50f722c-db0e-11ef-b27d-a0d3651f611f","year_int":866},"tongjian_id":"c50f722c-db0e-11ef-b27d-a0d3651f611f"},"paragraph_order":6}],"page_size":10,"total_pages":1,"total_paragraphs":6},"place_name":"景陵"},"message":"success","success":true}