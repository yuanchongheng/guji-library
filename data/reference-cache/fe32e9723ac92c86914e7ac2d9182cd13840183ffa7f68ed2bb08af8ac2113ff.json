i_auto":"赫连","start_index":88,"tongjian_id":"c9ee7cb5-db0e-11ef-9e9c-a0d3651f611f"},{"place_name":"統萬鎭","place_name_jianti_auto":"统万镇","start_index":93,"tongjian_id":"c9ee7cb6-db0e-11ef-ba2e-a0d3651f611f"},{"place_name":"東夏州","place_name_jianti_auto":"东夏州","start_index":99,"tongjian_id":"c9ee7cb7-db0e-11ef-a046-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","start_index":105,"tongjian_id":"c9ee7cb8-db0e-11ef-883a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宋白曰：丹州，秦上郡地，苻、姚時爲三堡鎭，後魏大統三年割鄜、延二州地置汾州，理三堡鎭；廢帝以河東汾州同名，改爲丹州，因丹楊川以爲名。延州，項羽以董翳爲翟王，都高奴，卽其地。魏滅赫連，以爲統萬鎭，後爲東夏州，後改延州。","note_content_jianti_auto":"宋白曰：丹州，秦上郡地，苻、姚时为三堡镇，后魏大统三年割鄜、延二州地置汾州，理三堡镇；废帝以河东汾州同名，改为丹州，因丹杨川以为名。延州，项羽以董翳为翟王，都高奴，即其地。魏灭赫连，以为统万镇，后为东夏州，后改延州。","note_type":"hu_note","start_index":22,"tongjian_id":"c9ee7c9d-db0e-11ef-a939-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹","place_name_jianti_auto":"丹","place_note":"陕西省宜川县","resolved_place_entity_id":2373,"start_index":18,"tongjian_id":"c9ee7cbb-db0e-11ef-a2ca-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6庚辰，帝至河中，發步騎會高萬興兵取丹、延。","content_fanyi":"三月十五日庚辰，后梁太祖抵达河中，征调步兵、骑兵与高万兴的军队会合，攻取丹州、延州。","content_jianti_auto":"6庚辰，帝至河中，发步骑会高万兴兵取丹、延。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27629,"number":6,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 三年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"c9ee7c9c-db0e-11ef-8122-a0d3651f611f","year_int":909},"tongjian_id":"c9ee7c9c-db0e-11ef-8122-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"丹","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":17,"source_start_index":13,"source_text":"事見上卷","target_paragraph_tongjian_id":"c9d5365f-db0e-11ef-8428-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","start_index":3,"tongjian_id":"c9f3109f-db0e-11ef-9d52-a0d3651f611f"},{"place_name":"匡國軍","place_name_jianti_auto":"匡国军","start_index":5,"tongjian_id":"c9f310a0-db0e-11ef-9c40-a0d3651f611f"},{"place_name":"忠武軍","place_name_jianti_auto":"忠武军","start_index":9,"tongjian_id":"c9f310a1-db0e-11ef-8228-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年更同州匡國軍爲忠武軍，事見上卷。","note_content_jianti_auto":"去年更同州匡国军为忠武军，事见上卷。","note_type":"hu_note","start_index":14,"tongjian_id":"c9f3109e-db0e-11ef-a6f4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河東","place_name_jianti_auto":"河东","place_note":"首都太原府","start_index":0,"tongjian_id":"c9f310a3-db0e-11ef-b827-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":4,"tongjian_id":"c9f310a4-db0e-11ef-951a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"河東，謂晉。","note_content_jianti_auto":"河东，谓晋。","note_type":"hu_note","start_index":48,"tongjian_id":"c9f310a2-db0e-11ef-9c20-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"知俊","people_name_jianti_auto":"知俊","start_index":13,"tongjian_id":"c9f310a8-db0e-11ef-8794-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鳳翔","place_name_jianti_auto":"凤翔","start_index":59,"tongjian_id":"c9f310a9-db0e-11ef-a19e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：實錄：「六月庚戌，知俊據本郡反，削奪官爵，興師討伐。」編遺錄：「六月，乙未，初奏本道軍民遮留，尋聞擒使臣及將送鳳翔。」蓋編遺據奏到之日，實錄據削奪之日也。","note_content_jianti_auto":"考异曰：实录：「六月庚戌，知俊据本郡反，削夺官爵，兴师讨伐。」编遗录：「六月，乙未，初奏本道军民遮留，寻闻擒使臣及将送凤翔。」盖编遗据奏到之日，实录据削夺之日也。","note_type":"hu_note","start_index":156,"tongjian_id":"c9f310a7-db0e-11ef-a8ea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","start_index":4,"tongjian_id":"c9f310b0-db0e-11ef-9b73-a0d3651f611f"},{"place_name":"華州","place_name_jianti_auto":"华州","place_note":"陕西省华县","start_index":8,"tongjian_id":"c9f310b1-db0e-11ef-9ac9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：同州南至華州七十里。華，戶化翻。","note_content_jianti_auto":"九域志：同州南至华州七十里。华，户化翻。","note_type":"hu_note","start_index":186,"tongjian_id":"c9f310af-db0e-11ef-a4ff-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","start_index":6,"tongjian_id":"c9f310b5-db0e-11ef-8d2f-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":13,"tongjian_id":"c9f310b6-db0e-11ef-ae6d-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":15,"tongjian_id":"c9f310b7-db0e-11ef-98e2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"遺，唯季翻。長安可以言取；梁都洛陽未易取也。","note_content_jianti_auto":"遗，唯季翻。长安可以言取；梁都洛阳未易取也。","note_type":"hu_note","start_index":260,"tongjian_id":"c9f310b4-db0e-11ef-b0ea-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹","place_name_jianti_auto":"丹","resolved_place_entity_id":2373,"start_index":72,"tongjian_id":"c9f310c3-db0e-11ef-a0e9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"汉乾祐初，乱将赵思绾据长安。虢州伶人靖边廷杀州将，驱掠州...","context_before":"...。承范方分兵守禁坑，而贼已入矣。贼夹攻潼关，关上兵皆溃。","source_end_index":3749,"source_paragraph_tongjian_id":"2f224efe-0b68-55c9-b219-0c7bdf27567a","source_start_index":3700,"source_text":"朱梁开平三年，刘知俊以同州附于李茂贞，又袭华州，以兵守潼关。刘厓讨之，乘间入关，华州降，知俊遂遁。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"20忠武節度使兼侍中劉知俊，功名浸盛，以帝猜忍日甚，內不自安；及王重師誅，知俊益懼。帝將伐河東，急徵知俊入朝，欲以爲河東西面行營都統；且以知俊有丹、延之功，厚賜之。知俊弟右保勝指揮使知浣從帝在洛陽，密使人語知俊云：「入必死。」又白帝，請帥弟姪往迎知俊，帝許之。六月，乙未朔，知俊奏「爲軍民所留」，遂以同州附於岐。執監軍及將佐之不從者，皆械送於岐。遣兵襲華州，逐刺史蔡敬思，以兵守潼關。潛遣人以重利啗長安諸將，執劉捍，送於岐，殺之。知俊遣使請兵於岐，亦遣使請晉人出兵攻晉、絳，遺晉王書曰：「不過旬日，可取兩京，復唐社稷。」","content_fanyi":"忠武节度使兼侍中刘知俊，功名日渐显赫，因为后梁太祖猜忌残忍日甚一日，内心很不安稳；到王重师被杀后，刘知俊更加恐惧。太祖准备讨伐河东，紧急征召刘知俊入朝，想任命他为河东西面行营都统；又因刘知俊有攻取丹、延二州的功劳，准备厚加赏赐。刘知俊的弟弟、右保胜指挥使刘知浣正跟随太祖在洛阳，暗中派人告诉刘知俊说：“入朝必死。”他又禀报太祖，请求带领兄弟子侄前去迎接刘知俊，太祖同意了。六月初一乙未，刘知俊上奏说“被军民挽留，无法入朝”，随即带领同州军民归附岐王李茂贞。他逮捕监军以及不服从命令的将领、佐吏，全部戴上刑具送往凤翔。又派兵袭击华州，驱逐刺史蔡敬思，并派兵防守潼关。暗中派人用重利引诱长安诸位将领，捉住刘捍，送到凤翔后杀掉。刘知俊派遣使者向岐王李茂贞请求增兵，又派使者到晋阳请求晋王李存勖出兵攻打晋州、绛州，并致信晋王说：“不出十天，就能攻取两京，恢复大唐社稷。”","content_jianti_auto":"20忠武节度使兼侍中刘知俊，功名浸盛，以帝猜忍日甚，内不自安；及王重师诛，知俊益惧。帝将伐河东，急征知俊入朝，欲以为河东西面行营都统；且以知俊有丹、延之功，厚赐之。知俊弟右保胜指挥使知浣从帝在洛阳，密使人语知俊云：「入必死。」又白帝，请帅弟姪往迎知俊，帝许之。六月，乙未朔，知俊奏「为军民所留」，遂以同州附于岐。执监军及将佐之不从者，皆械送于岐。遣兵袭华州，逐刺史蔡敬思，以兵守潼关。潜遣人以重利啗长安诸将，执刘捍，送于岐，杀之。知俊遣使请兵于岐，亦遣使请晋人出兵攻晋、绛，遗晋王书曰：「不过旬日，可取两京，复唐社稷。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":27647,"number":20,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 三年 / 第 24 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":23,"tongjian_id":"c9f3109d-db0e-11ef-ac8a-a0d3651f611f","year_int":909},"tongjian_id":"c9f3109d-db0e-11ef-ac8a-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"丹","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","start_index":0,"tongjian_id":"ce08378c-db0e-11ef-a032-a0d3651f611f"},{"place_name":"夏州","place_name_jianti_auto":"夏州","start_index":4,"tongjian_id":"ce08378d-db0e-11ef-86ba-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"延州北至夏州三百八十里。二鎭接境，違言易生。難，乃旦翻。","note_content_jianti_auto":"延州北至夏州三百八十里。二镇接境，违言易生。难，乃旦翻。","note_type":"hu_note","start_index":22,"tongjian_id":"ce08378b-db0e-11ef-9045-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹","place_name_jianti_auto":"丹","place_note":"陕西宜川","resolved_place_entity_id":2373,"start_index":37,"tongjian_id":"ce083797-db0e-11ef-92bc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"43彰武節度使高允權與定難節度使李彝殷有隙，李守貞密求援於彝殷，發兵屯延、丹境上，聞官軍圍河中，乃退。甲辰，允權以狀聞，彝殷亦自訴，朝廷和解之。","content_fanyi":"彰武节度使高允权与定难节度使李彝殷有仇怨。李守贞暗中向李彝殷求救，李彝殷便发兵屯驻在延州、丹州边境上，得知官军已包围河中，于是退兵。十月二十九日甲辰，高允权将这一情况奏报朝廷，李彝殷也亲自为此事申诉，朝廷出面调解，使二人和解。","content_jianti_auto":"43彰武节度使高允权与定难节度使李彝殷有隙，李守贞密求援于彝殷，发兵屯延、丹境上，闻官军围河中，乃退。甲辰，允权以状闻，彝殷亦自诉，朝廷和解之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30221,"number":43,"path":"资治通鉴 : 卷第二百八十八 (後漢紀三) / 高祖睿文聖武昭肅孝皇帝下 / 乾祐元年 / 第 66 段","reading_annotation_sources":[],"start_index":65,"tongjian_id":"ce08378a-db0e-11ef-a33d-a0d3651f611f","year_int":948},"tongjian_id":"ce08378a-db0e-11ef-a33d-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"丹","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"丹州","place_name_jianti_auto":"丹州","start_index":0,"tongjian_id":"ce8e967f-db0e-11ef-9cc2-a0d3651f611f"},{"place_name":"龍門","place_name_jianti_auto":"龙门","start_index":3,"tongjian_id":"ce8e9680-db0e-11ef-a675-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":5,"tongjian_id":"ce8e9681-db0e-11ef-b26b-a0d3651f611f"},{"place_name":"慈州","place_name_jianti_auto":"慈州","start_index":9,"tongjian_id":"ce8e9682-db0e-11ef-ae2b-a0d3651f611f"},{"place_name":"龍門","place_name_jianti_auto":"龙门","start_index":12,"tongjian_id":"ce8e9683-db0e-11ef-82c2-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":14,"tongjian_id":"ce8e9684-db0e-11ef-9472-a0d3651f611f"},{"place_name":"宋朝","place_name_jianti_auto":"宋朝","start_index":18,"tongjian_id":"ce8e9685-db0e-11ef-b042-a0d3651f611f"},{"place_name":"慈州","place_name_jianti_auto":"慈州","start_index":25,"tongjian_id":"ce8e9686-db0e-11ef-93bc-a0d3651f611f"},{"place_name":"吉鄕縣","place_name_jianti_auto":"吉鄕县","start_index":29,"tongjian_id":"ce8e9687-db0e-11ef-99c4-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":33,"tongjian_id":"ce8e9688-db0e-11ef-9dab-a0d3651f611f"},{"place_name":"吉鄕縣","place_name_jianti_auto":"吉鄕县","start_index":40,"tongjian_id":"ce8e9689-db0e-11ef-b286-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":44,"tongjian_id":"ce8e968a-db0e-11ef-9fdf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"丹州在龍門河之西，慈州在龍門河之東。宋朝熙寧五年廢慈州，以吉鄕縣屬隰州。九域志：吉鄕縣在隰州西南一百六十里。","note_content_jianti_auto":"丹州在龙门河之西，慈州在龙门河之东。宋朝熙宁五年废慈州，以吉鄕县属隰州。九域志：吉鄕县在隰州西南一百六十里。","note_type":"hu_note","start_index":20,"tongjian_id":"ce8e967e-db0e-11ef-a504-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"丹","place_name_jianti_auto":"丹","place_note":"陕西宜川","resolved_place_entity_id":2373,"start_index":16,"tongjian_id":"ce8e9690-db0e-11ef-80d6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"36東自青、徐，南至安、復，西至丹、慈，北至貝、鎭，皆大水。","content_fanyi":"东起青州、徐州，南到安州、复州，西到丹州、慈州，北到贝州、镇州，各地都发生了大水。","content_jianti_auto":"36东自青、徐，南至安、复，西至丹、慈，北至贝、镇，皆大水。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30577,"number":36,"path":"资治通鉴 : 卷第二百九十一 (後周紀二) / 太祖聖神恭肅文武孝皇帝中 / 三年 / 第 37 段","reading_annotation_sources":[],"start_index":36,"tongjian_id":"ce8e967d-db0e-11ef-8edf-a0d3651f611f","year_int":953},"tongjian_id":"ce8e967d-db0e-11ef-8edf-a0d3651f611f"},"paragraph_order":7}],"page_size":10,"total_pages":1,"total_paragraphs":7},"place_name":"丹"},"message":"success","success":true}