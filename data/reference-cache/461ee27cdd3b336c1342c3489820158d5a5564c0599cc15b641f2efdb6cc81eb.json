ngjian_id":"8ea4afe7-db0e-11ef-814a-a0d3651f611f"},{"people_name":"祿","people_name_jianti_auto":"禄","start_index":85,"tongjian_id":"8ea4afe8-db0e-11ef-94be-a0d3651f611f"},{"people_name":"不疑","people_name_jianti_auto":"不疑","start_index":93,"tongjian_id":"8ea4afe9-db0e-11ef-8ead-a0d3651f611f"},{"people_name":"不疑","people_name_jianti_auto":"不疑","start_index":104,"tongjian_id":"8ea4afea-db0e-11ef-a260-a0d3651f611f"},{"people_name":"呂台","people_name_jianti_auto":"吕台","start_index":107,"tongjian_id":"8ea4afeb-db0e-11ef-9552-a0d3651f611f"},{"people_name":"產","people_name_jianti_auto":"产","start_index":156,"tongjian_id":"8ea4afec-db0e-11ef-a360-a0d3651f611f"},{"people_name":"祿","people_name_jianti_auto":"禄","start_index":158,"tongjian_id":"8ea4afed-db0e-11ef-ab2d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：史記·本紀：「高后元年，立孝惠子不疑爲恆山王，呂台爲呂王。」「二年，恆山王薨。」「十一月，呂王台薨。」年表，二人皆以元年薨。漢書·本紀：「元年，立不疑、呂台、產、祿通爲王。二年，不疑薨。」年表，元年，不疑及呂台爲王，二年皆薨。蓋史記·年表「薨」字應在二年，誤書於元年耳。其實二人皆以二年薨；漢書·本紀云「產、祿通爲王」，亦誤也。","note_content_jianti_auto":"考异曰：史记·本纪：「高后元年，立孝惠子不疑为恒山王，吕台为吕王。」「二年，恒山王薨。」「十一月，吕王台薨。」年表，二人皆以元年薨。汉书·本纪：「元年，立不疑、吕台、产、禄通为王。二年，不疑薨。」年表，元年，不疑及吕台为王，二年皆薨。盖史记·年表「薨」字应在二年，误书于元年耳。其实二人皆以二年薨；汉书·本纪云「产、禄通为王」，亦误也。","note_type":"hu_note","start_index":13,"tongjian_id":"8ea4afdc-db0e-11ef-81a7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-187,"link_td_description":"吕台，汉朝诸侯王，西汉第一代吕王。","link_td_id":"Q10005295","link_td_number_id":1449063,"people_name":"呂肅王台","people_name_jianti_auto":"吕肃王台","people_xingming":"吕台","start_index":7,"tongjian_id":"8ea4aff5-db0e-11ef-b4d5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1冬，十一月，呂肅王台薨。","content_fanyi":"冬季，十一月，吕肃王吕台去世。","content_jianti_auto":"1冬，十一月，吕肃王台薨。","dtjl_paragraph_links":[]