8d20281-db0e-11ef-9e6d-a0d3651f611f"},{"people_name":"嗣昭","people_name_jianti_auto":"嗣昭","start_index":147,"tongjian_id":"c8d20282-db0e-11ef-b495-a0d3651f611f"},{"people_name":"葛從周","people_name_jianti_auto":"葛从周","start_index":154,"tongjian_id":"c8d20283-db0e-11ef-8def-a0d3651f611f"},{"people_name":"嗣昭","people_name_jianti_auto":"嗣昭","start_index":162,"tongjian_id":"c8d20284-db0e-11ef-b607-a0d3651f611f"},{"people_name":"嗣昭","people_name_jianti_auto":"嗣昭","start_index":176,"tongjian_id":"c8d20285-db0e-11ef-a4c7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"洺州","place_name_jianti_auto":"洺州","start_index":16,"tongjian_id":"c8d20286-db0e-11ef-8b0c-a0d3651f611f"},{"place_name":"洺州","place_name_jianti_auto":"洺州","start_index":40,"tongjian_id":"c8d20287-db0e-11ef-a318-a0d3651f611f"},{"place_name":"汴","place_name_jianti_auto":"汴","start_index":44,"tongjian_id":"c8d20288-db0e-11ef-bd74-a0d3651f611f"},{"place_name":"汴州","place_name_jianti_auto":"汴州","start_index":70,"tongjian_id":"c8d20289-db0e-11ef-8405-a0d3651f611f"},{"place_name":"黃龍鎭","place_name_jianti_auto":"黄龙镇","start_index":103,"tongjian_id":"c8d2028a-db0e-11ef-b891-a0d3651f611f"},{"place_name":"洺","place_name_jianti_auto":"洺","start_index":112,"tongjian_id":"c8d2028b-db0e-11ef-a725-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":116,"tongjian_id":"c8d2028c-db0e-11ef-9c69-a0d3651f611f"},{"place_name":"洺州","place_name_jianti_auto":"洺州","start_index":123,"tongjian_id":"c8d2028d-db0e-11ef-92e1-a0d3651f611f"},{"place_name":"汴","place_name_jianti_auto":"汴","start_index":136,"tongjian_id":"c8d2028e-db0e-11ef-9cea-a0d3651f611f"},{"place_name":"洺州","place_name_jianti_auto":"洺州","start_index":144,"tongjian_id":"c8d2028f-db0e-11ef-8a64-a0d3651f611f"},{"place_name":"青山口","place_name_jianti_auto":"青山口","start_index":158,"tongjian_id":"c8d20290-db0e-11ef-be9b-a0d3651f611f"},{"place_name":"洺州","place_name_jianti_auto":"洺州","start_index":179,"tongjian_id":"c8d20291-db0e-11ef-88d0-a0d3651f611f"},{"place_name":"青山口","place_name_jianti_auto":"青山口","place_note":"河北省邢台市西北","start_index":184,"tongjian_id":"c8d20292-db0e-11ef-8b1e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：唐太祖紀年錄：「葛從周攻洺州，嗣昭棄城而歸。是役也，王郃郞、楊師悅陷賊，洺州復爲汴有。」唐末見聞錄：「九月二日，嗣昭兵士失利卻回，被汴州捉到王郃郞。」編遺錄、薛居正五代史·梁紀：「八月，帝遣葛從周屯黃龍鎭，親領中軍涉洺而寨，晉人懼而宵遁，洺州復平。」唐紀：「九月，汴帥自將兵三萬圍洺州，嗣昭棄城而歸，葛從周伏青山口，嗣昭軍不利。」實錄：「九月，嗣昭棄洺州，敗於青山口。」今從唐末見聞錄、唐紀、實錄。按考異所錄唐紀，蓋後唐紀。","note_content_jianti_auto":"考异曰：唐太祖纪年录：「葛从周攻洺州，嗣昭弃城而归。是役也，王郃郞、杨师悦陷贼，洺州复为汴有。」唐末见闻录：「九月二日，嗣昭兵士失利却回，被汴州捉到王郃郞。」编遗录、薛居正五代史·梁纪：「八月，帝遣葛从周屯黄龙镇，亲领中军涉洺而寨，晋人惧而宵遁，洺州复平。」唐纪：「九月，汴帅自将兵三万围洺州，嗣昭弃城而归，葛从周伏青山口，嗣昭军不利。」实录：「九月，嗣昭弃洺州，败于青山口。」今从唐末见闻录、唐纪、实录。按考异所录唐纪，盖后唐纪。","note_type":"hu_note","start_index":59,"tongjian_id":"c8d20279-db0e-11ef-9c7d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄴縣","place_name_jianti_auto":"邺县","place_note":"河北省临漳县西南邺镇","resolved_place_entity_id":5379,"start_index":9,"tongjian_id":"c8d202a3-db0e-11ef-b549-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、顺德府（卷十五）","excerpts":[{"context_after":"后唐清泰三年，唐兵攻太原，为石敬瑭及契丹所败。诏天雄帅范...","context_before":"...从周所败，退入青山。从周追之，将扼其归路，李嗣源击却之。","source_end_index":229,"source_paragraph_tongjian_id":"93d43a13-b8ff-51f0-b325-330e532944ce","source_start_index":185,"source_text":"光化三年，李嗣昭拔洺州，朱全忠引兵来争，嗣昭弃城走，葛从周设伏于青山口，邀击嗣昭，大败。"}],"path":"北直方舆纪要/五、顺德府（卷十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/六、广平府（卷十五）","excerpts":[{"context_after":"《金人疆域图》永年县有黄龙镇]。","context_before":"黄龙镇[在府西南。","source_end_index":74,"source_paragraph_tongjian_id":"030bbe78-4cbc-5ae2-90a5-d9d62c81b3be","source_start_index":9,"source_text":"唐光化三年，李克用将李嗣昭拔洺州。朱全忠遣其将葛从周击之，自邺县渡漳水，营于黄龙镇。全忠自将中军涉洺水，置营以逼嗣昭，嗣昭弃城走。"}],"path":"北直方舆纪要/六、广平府（卷十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"16九月，葛從周自鄴縣渡漳水，營於黃龍鎭；朱全忠自將中軍三萬涉洺水置營。李嗣昭棄城走，從周設伏於青山口，邀擊，大破之。","content_fanyi":"九月，葛从周自邺县渡过漳水，在黄龙镇立营；朱全忠亲自率领中军三万人渡过洺水扎下营寨。李嗣昭弃守洺州城逃跑，葛从周在青山口布置伏兵拦击，大破李嗣昭所部。","content_jianti_auto":"16九月，葛从周自邺县渡漳水，营于黄龙镇；朱全忠自将中军三万涉洺水置营。李嗣昭弃城走，从周设伏于青山口，邀击，大破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27067,"number":16,"path":"资治通鉴 : 卷第二百六十二 (唐紀七十八) / 昭宗聖穆景文孝皇帝中之中 / 光化三年 / 第 16 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":15,"tongjian_id":"c8d20276-db0e-11ef-9f6e-a0d3651f611f","year_int":900},"tongjian_id":"c8d20276-db0e-11ef-9f6e-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"鄴縣","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉昫","people_name_jianti_auto":"刘昫","start_index":16,"tongjian_id":"cd5037f9-db0e-11ef-8159-a0d3651f611f"},{"people_name":"隋文","people_name_jianti_auto":"隋文","start_index":28,"tongjian_id":"cd5037fa-db0e-11ef-9790-a0d3651f611f"},{"people_name":"尉遲迥","people_name_jianti_auto":"尉迟迥","start_index":33,"tongjian_id":"cd5037fb-db0e-11ef-ad09-a0d3651f611f"},{"people_name":"隋煬帝","people_name_jianti_auto":"隋炀帝","start_index":70,"tongjian_id":"cd5037fc-db0e-11ef-bde6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":0,"tongjian_id":"cd5037fd-db0e-11ef-8587-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":2,"tongjian_id":"cd5037fe-db0e-11ef-add2-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府","start_index":6,"tongjian_id":"cd5037ff-db0e-11ef-a1c4-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","start_index":8,"tongjian_id":"cd503800-db0e-11ef-b545-a0d3651f611f"},{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":20,"tongjian_id":"cd503801-db0e-11ef-b231-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":22,"tongjian_id":"cd503802-db0e-11ef-91c2-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","start_index":23,"tongjian_id":"cd503803-db0e-11ef-96e9-a0d3651f611f"},{"place_name":"鄴城","place_name_jianti_auto":"邺城","start_index":46,"tongjian_id":"cd503804-db0e-11ef-80c1-a0d3651f611f"},{"place_name":"安陽城","place_name_jianti_auto":"安阳城","start_index":61,"tongjian_id":"cd503805-db0e-11ef-ab07-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","start_index":65,"tongjian_id":"cd503806-db0e-11ef-b7f7-a0d3651f611f"},{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":74,"tongjian_id":"cd503807-db0e-11ef-94df-a0d3651f611f"},{"place_name":"大慈寺","place_name_jianti_auto":"大慈寺","start_index":77,"tongjian_id":"cd503808-db0e-11ef-991e-a0d3651f611f"},{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":81,"tongjian_id":"cd503809-db0e-11ef-8637-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府","start_index":84,"tongjian_id":"cd50380a-db0e-11ef-bda2-a0d3651f611f"},{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":104,"tongjian_id":"cd50380b-db0e-11ef-8ea5-a0d3651f611f"},{"place_name":"五代","place_name_jianti_auto":"五代","start_index":109,"tongjian_id":"cd50380c-db0e-11ef-899f-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府","start_index":112,"tongjian_id":"cd50380d-db0e-11ef-bca6-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":114,"tongjian_id":"cd50380e-db0e-11ef-a6a8-a0d3651f611f"},{"place_name":"鄴都","place_name_jianti_auto":"邺都","start_index":118,"tongjian_id":"cd50380f-db0e-11ef-add7-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":123,"tongjian_id":"cd503810-db0e-11ef-89d6-a0d3651f611f"},{"place_name":"大名府","place_name_jianti_auto":"大名府","start_index":125,"tongjian_id":"cd503811-db0e-11ef-8771-a0d3651f611f"},{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":132,"tongjian_id":"cd503812-db0e-11ef-b573-a0d3651f611f"},{"place_name":"契丹","place_name_jianti_auto":"契丹","start_index":140,"tongjian_id":"cd503813-db0e-11ef-961c-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":143,"tongjian_id":"cd503814-db0e-11ef-8146-a0d3651f611f"},{"place_name":"鄴都","place_name_jianti_auto":"邺都","start_index":154,"tongjian_id":"cd503815-db0e-11ef-9867-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","start_index":161,"tongjian_id":"cd503816-db0e-11ef-abbb-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","start_index":178,"tongjian_id":"cd503817-db0e-11ef-8754-a0d3651f611f"},{"place_name":"鄴都","place_name_jianti_auto":"邺都","start_index":186,"tongjian_id":"cd503818-db0e-11ef-a3fa-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄴，漢古縣，唐屬相州，在州東北。劉昫曰：鄴，魏相州治所；隋文輔政，尉遲迥舉兵，旣討平之，乃焚鄴城，徙其居人南遷四十五里，以安陽城爲相州治所。隋煬帝於鄴故都大慈寺置鄴縣。唐貞觀八年，始築今治所小城。余按，此皆言鄴縣也。若五代、唐、晉之所謂鄴都，則今魏州大名府是也，非鄴縣也。夷考此時契丹與晉兵相距本末，前所謂入鄴都境，當作入相州境。一說，虜騎散漫，大勢兵馬向相州，遊騎亦有入鄴都境者。","note_content_jianti_auto":"邺，汉古县，唐属相州，在州东北。刘昫曰：邺，魏相州治所；隋文辅政，尉迟迥举兵，既讨平之，乃焚邺城，徙其居人南迁四十五里，以安阳城为相州治所。隋炀帝于邺故都大慈寺置邺县。唐贞观八年，始筑今治所小城。余按，此皆言邺县也。若五代、唐、晋之所谓邺都，则今魏州大名府是也，非邺县也。夷考此时契丹与晋兵相距本末，前所谓入邺都境，当作入相州境。一说，虏骑散漫，大势兵马向相州，游骑亦有入邺都境者。","note_type":"hu_note","start_index":57,"tongjian_id":"cd5037f8-db0e-11ef-abdc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陳，讀曰陣；下同。","note_content_jianti_auto":"陈，读曰阵；下同。","note_type":"hu_note","start_index":108,"tongjian_id":"cd503819-db0e-11ef-892d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"還，從宣翻；下同。","note_content_jianti_auto":"还，从宣翻；下同。","note_type":"hu_note","start_index":198,"tongjian_id":"cd50381b-db0e-11ef-a80d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄴縣","place_name_jianti_auto":"邺县","place_note":"河北临漳西南邺镇","resolved_place_entity_id":5379,"start_index":54,"tongjian_id":"cd503825-db0e-11ef-8a06-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、彰德府（卷四十九）","excerpts":[{"context_after":"胡氏曰：洹水经安阳县而东流，谓之安阳河]。","context_before":"...阳河。唐乾元二年，九节度之师与史思明战于安阳河北，溃还。","source_end_index":229,"source_paragraph_tongjian_id":"cf4dece8-8550-55f9-8d87-fe80eb9c3731","source_start_index":169,"source_text":"石晋开运二年，契丹入寇相州境，晋军陈于安阳水南，是也。既而契丹陈于安阳水北，复逾水，环相州而南，至汤阴，晋军驰救，乃还。"},{"context_after":"岁久桥坏。元至元间，伐石改建，东徙里许。亦曰洹水桥，旧名...","context_before":"安阳桥[在府北四里安阳河上。","source_end_index":98,"source_paragraph_tongjian_id":"db21078b-0920-536e-8f23-4f41668e4445","source_start_index":14,"source_text":"石晋开运二年，契丹犯相州，晋军陈于安阳河南，既而诸军东趣黎阳，留步卒五百人守安阳桥。知相州苻彦伦以桥非五百人所能守，召入乘城为备，至曙，契丹果数万骑陈于安阳水北，是也。"},{"context_after":"○白沙镇，在故邺县东南。晋成都王颖使孙惠为白沙督，是也]...","context_before":"榆林店[在县西南四十里。","source_end_index":86,"source_paragraph_tongjian_id":"68ebaac4-3bef-5d09-85d7-392c3bbd451a","source_start_index":12,"source_text":"石晋开运二年，契丹入寇，至相州境，晋军陈于安阳水南。皇甫遇等觇贼，至邺，将度漳水，契丹数万奄至，遇且战且却，至榆林店，布陈力战，安阳救者至，乃得还。"}],"path":"河南方舆纪要/五、彰德府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"壬子，張從恩、馬全節、安審琦悉以行營兵數萬，陳於相州安陽水之南。皇甫遇與濮州刺史慕容彥超將數千騎前覘契丹，至鄴縣，將渡漳水，遇契丹數萬，遇等且戰且卻；至榆林店，契丹大至，二將謀曰：「吾屬今走，死無遺矣！」乃止，布陳，自午至未，力戰百餘合，相殺傷甚衆。遇馬斃，因步戰；其僕杜知敏以所乘馬授之，遇乘馬復戰。久之，稍解；顧知敏已爲契丹所擒，遇曰：「知敏義士，不可棄也。」與彥超躍馬入契丹陳，取知敏而還。俄而契丹繼出新兵來戰，二將曰：「吾屬勢不可走，以死報國耳。」","content_fanyi":"正月十五日壬子，张从恩、马全节、安审琦率领全部数万行营兵马，在相州安阳水南岸列阵。皇甫遇与濮州刺史慕容彦超带领数千骑兵前往前方侦察契丹军情，到达邺县，正要渡过漳水时，遭遇数万契丹兵，皇甫遇等边战边退；退到榆林店，契丹大队人马赶来，两位将领商议说：“我们如果现在退走，就会全被杀死，一个也不剩！”于是停止后退，摆开阵势，从午时到未时，力战百余回合，双方都死伤惨重。皇甫遇的战马战死，只好徒步作战；他的仆人杜知敏把自己所骑的马让给皇甫遇，皇甫遇骑上马继续作战。经过很久，战况稍稍缓解；回头看到杜知敏已被契丹军擒获，皇甫遇说：“杜知敏是义士，不能丢下他不管。”于是与慕容彦超策马冲入契丹军阵，把杜知敏救了回来。不一会儿，契丹军又派出新兵前来交战，两位将领说：“以我们这些人的情势，已经不可能逃走，只能以死报效国家了。”","content_jianti_auto":"壬子，张从恩、马全节、安审琦悉以行营兵数万，陈于相州安阳水之南。皇甫遇与濮州刺史慕容彦超将数千骑前觇契丹，至邺县，将渡漳水，遇契丹数万，遇等且战且却；至榆林店，契丹大至，二将谋曰：「吾属今走，死无遗矣！」乃止，布陈，自午至未，力战百余合，相杀伤甚众。遇马毙，因步战；其仆杜知敏以所乘马授之，遇乘马复战。久之，稍解；顾知敏已为契丹所擒，遇曰：「知敏义士，不可弃也。」与彦超跃马入契丹陈，取知敏而还。俄而契丹继出新兵来战，二将曰：「吾属势不可走，以死报国耳。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":29762,"path":"资治通鉴 : 卷第二百八十四 (後晉紀五) / 齊王中 / 二年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"cd5037f5-db0e-11ef-a0e2-a0d3651f611f","year_int":945},"tongjian_id":"cd5037f5-db0e-11ef-a0e2-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"鄴縣"},"message":"success","success":true}