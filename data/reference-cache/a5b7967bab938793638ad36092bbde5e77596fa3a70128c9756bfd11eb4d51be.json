{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙丑、前一七六）","note_content_jianti_auto":"（乙丑、前一七六）","note_type":"hu_note","start_index":0,"tongjian_id":"8ed42e12-db0e-11ef-882f-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"潁陰懿侯","official_note":"潁陰懿侯是漢代的爵位，表示封地在潁陰，諡號為懿，此處用於指代灌嬰的爵位，在上下文中標示其身份和地位。","official_rank":"侯爵","source_snippet":"潁陰懿侯灌嬰薨","start_index":6,"tongjian_id":"af30c121-3544-4fd0-9829-15c8059777c9"}],"ExtRef_Children_people":[{"link_death_year":-176,"link_td_description":"灌婴，睢阳（今河南商丘）人。汉朝开国功臣，官至太尉、丞相，封颍阴侯，谥号为懿侯。","link_td_id":"Q10007779","link_td_number_id":584869,"people_name":"潁陰懿侯","people_name_jianti_auto":"颍阴懿侯","people_xingming":"灌婴","start_index":7,"tongjian_id":"8ed42e14-db0e-11ef-8ee4-a0d3651f611f"},{"link_death_year":-176,"link_td_description":"灌婴，睢阳（今河南商丘）人。汉朝开国功臣，官至太尉、丞相，封颍阴侯，谥号为懿侯。","link_td_id":"Q10007779","link_td_number_id":584869,"people_name":"灌嬰","people_name_jianti_auto":"灌婴","people_xingming":"灌婴","start_index":11,"tongjian_id":"8ed42e15-db0e-11ef-9a42-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1冬，十二月，潁陰懿侯灌嬰薨。","content_fanyi":"冬季，十二月，颍阴懿侯灌婴去世。","content_jianti_auto":"1冬，十二月，颍阴懿侯灌婴薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1111,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8ed42e13-db0e-11ef-b8b3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8ed42e18-db0e-11ef-8f35-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陽武縣","place_name_jianti_auto":"阳武县","start_index":3,"tongjian_id":"8ed42e19-db0e-11ef-890b-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":7,"tongjian_id":"8ed42e1a-db0e-11ef-bceb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：陽武縣屬河南郡。","note_content_jianti_auto":"班志：阳武县属河南郡。","note_type":"hu_note","start_index":22,"tongjian_id":"8ed42e17-db0e-11ef-932a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"监察","official_name":"御史大夫","official_note":"御史大夫是秦汉时期的高级官职，负责监察百官，位列三公之一，此处表示张苍从御史大夫升任丞相。","official_rank":"正三品","source_snippet":"以御史大夫陽武張蒼爲丞相","start_index":10,"tongjian_id":"783e3698-f42d-4c92-a266-b620a11ef1e0"},{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是秦汉时期的最高行政长官，总揽朝政，此处表示张苍被任命为丞相。","official_rank":"正一品","source_snippet":"以御史大夫陽武張蒼爲丞相","start_index":19,"tongjian_id":"821296c0-acd6-4d16-b685-b1b2e347c7ec"}],"ExtRef_Children_people":[{"link_birth_year":-252,"link_death_year":-152,"link_td_description":"张苍，阳武（今河南原阳县东南）人，秦末汉初之际的科学家、儒家、阴阳家，曾师从荀子。西汉学者、开国功臣，官至丞相，封北平侯，谥号文。","link_td_id":"Q10007802","link_td_number_id":202577,"people_name":"張蒼","people_name_jianti_auto":"张苍","people_xingming":"张苍","start_index":16,"tongjian_id":"8ed42e1d-db0e-11ef-919f-a0d3651f611f"},{"link_birth_year":-252,"link_death_year":-152,"link_td_description":"张苍，阳武（今河南原阳县东南）人，秦末汉初之际的科学家、儒家、阴阳家，曾师从荀子。西汉学者、开国功臣，官至丞相，封北平侯，谥号文。","link_td_id":"Q10007802","link_td_number_id":202577,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"张苍","start_index":22,"tongjian_id":"8ed42e1f-db0e-11ef-9ac1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"陽武","place_name_jianti_auto":"阳武","place_note":"河南原阳","resolved_place_entity_id":1971,"start_index":14,"tongjian_id":"8ed42e1e-db0e-11ef-b847-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2春，正月，甲午，以御史大夫陽武張蒼爲丞相。蒼好書，博聞，尤邃律曆。","content_fanyi":"春季，正月初四甲午日，汉文帝刘恒将御史大夫、阳武县人张苍任命为丞相。张苍爱好读书，博学多闻，对律历之学尤为精通。","content_jianti_auto":"2春，正月，甲午，以御史大夫阳武张苍为丞相。苍好书，博闻，尤邃律历。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1112,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8ed42e16-db0e-11ef-b867-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河東","place_name_jianti_auto":"河东","place_note":"山西夏縣","start_index":0,"tongjian_id":"8ed42e22-db0e-11ef-b5b0-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":3,"tongjian_id":"8ed42e23-db0e-11ef-bc8a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":5,"tongjian_id":"8ed42e24-db0e-11ef-8f0b-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":9,"tongjian_id":"8ed42e25-db0e-11ef-a579-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"河東本韓、魏之地，秦置郡。","note_content_jianti_auto":"河东本韩、魏之地，秦置郡。","note_type":"hu_note","start_index":9,"tongjian_id":"8ed42e21-db0e-11ef-8e16-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"8ed42e27-db0e-11ef-be0e-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":11,"tongjian_id":"8ed42e28-db0e-11ef-ba70-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：使酒，酗酒也。師古曰：言因酒霑洽而使氣也。近，謂附近天子而爲大臣。近，其靳翻。","note_content_jianti_auto":"应劭曰：使酒，酗酒也。师古曰：言因酒沾洽而使气也。近，谓附近天子而为大臣。近，其靳翻。","note_type":"hu_note","start_index":29,"tongjian_id":"8ed42e26-db0e-11ef-9c1d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8ed42e2a-db0e-11ef-915b-a0d3651f611f"},{"people_name":"貢父","people_name_jianti_auto":"贡父","start_index":14,"tongjian_id":"8ed42e2b-db0e-11ef-8bf2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：旣引見而罷令還郡也。貢父曰：見罷，猶言見逐、見棄耳，非引見也。","note_content_jianti_auto":"师古曰：既引见而罢令还郡也。贡父曰：见罢，犹言见逐、见弃耳，非引见也。","note_type":"hu_note","start_index":39,"tongjian_id":"8ed42e29-db0e-11ef-a588-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8ed42e2d-db0e-11ef-87ae-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：謂妄言其賢，故云欺也。","note_content_jianti_auto":"师古曰：谓妄言其贤，故云欺也。","note_type":"hu_note","start_index":75,"tongjian_id":"8ed42e2c-db0e-11ef-862a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"河東守","official_note":"河東守是漢代河東郡的最高行政長官，負責管理該郡的民政、司法等事務。在《資治通鑑》此段中，季布原任河東守，被漢文帝召見，後因有人進言而未被任命為御史大夫，這反映了漢代官員的任免受輿論影響。","official_rank":"郡守（二千石）","source_snippet":"上召河東守季布","start_index":3,"tongjian_id":"7d7815e9-d302-46de-9870-821c54455456"},{"confidence":0.95,"official_category":"中枢机构","official_name":"御史大夫","official_note":"御史大夫是漢代三公之一，負責監察百官、掌管文書，地位僅次於丞相。在此段中，漢文帝原本想任命季布為御史大夫，但因有人批評季布的性格而作罷，這顯示了御史大夫職位的重要性及其任命的慎重性。","official_rank":"三公之一（副丞相）","source_snippet":"欲以爲御史大夫","start_index":10,"tongjian_id":"f6e14f53-6ea8-4230-9877-a987d745b3ff"}],"ExtRef_Children_people":[{"link_birth_year":-235,"link_death_year":-165,"link_td_description":"季布，秦末楚地下相（今江苏省宿迁市宿城区）人，曾效力于项羽，并于多次战役中崭露头角，击败刘邦军队。项羽败亡后，被汉高祖刘邦悬赏缉拿。后在夏侯婴说情下，刘邦饶赦了他，并拜他为郎中。惠帝时，官至中郎将。文帝时，任河东郡守。","link_td_id":"Q10008897","link_td_number_id":444236,"people_name":"季布","people_name_jianti_auto":"季布","people_xingming":"季布","start_index":6,"tongjian_id":"8ed42e2f-db0e-11ef-b44a-a0d3651f611f"},{"link_birth_year":-235,"link_death_year":-165,"link_td_description":"季布，秦末楚地下相（今江苏省宿迁市宿城区）人，曾效力于项羽，并于多次战役中崭露头角，击败刘邦军队。项羽败亡后，被汉高祖刘邦悬赏缉拿。后在夏侯婴说情下，刘邦饶赦了他，并拜他为郎中。惠帝时，官至中郎将。文帝时，任河东郡守。","link_td_id":"Q10008897","link_td_number_id":444236,"people_name":"季布","people_name_jianti_auto":"季布","start_index":39,"tongjian_id":"8ed42e31-db0e-11ef-96e2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河東","place_name_jianti_auto":"河东","place_note":"山西夏縣","resolved_place_entity_id":105,"start_index":3,"tongjian_id":"8ed42e30-db0e-11ef-91ac-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","resolved_place_entity_id":105,"start_index":54,"tongjian_id":"8ed42e32-db0e-11ef-9294-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","place_note":"山西夏縣","resolved_place_entity_id":105,"start_index":147,"tongjian_id":"8ed42e33-db0e-11ef-8adf-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"3上召河東守季布，欲以爲御史大夫。有言其勇、使酒、難近者；至，留邸一月，見罷。季布因進曰：「臣無功竊寵，待罪河東，陛下無故召臣，此人必有以臣欺陛下者。今臣至，無所受事，罷去，此人必有毀臣者。夫陛下以一人之譽而召臣，以一人之毀而去臣，臣恐天下有識聞之，有以闚陛下之淺深也！」上默然，慚，良久曰：「河東，吾股肱郡，故特召君耳。」","content_fanyi":"汉文帝征召河东郡郡守季布来京，想任命他为御史大夫。有人说季布勇武而难以约束、好酒任性，不适合担任皇帝身边的近臣；季布到京后，在官邸停留了一个月，才被召见，随后被遣回原任。季布于是进言说：“我本无功劳而侥幸受到陛下宠信，在河东郡担任郡守待罪，陛下无故召我入京，这一定是有人在陛下面前夸大其词地举荐我。如今我到了京城，没有接受新的任命，仍被遣回原任，这一定是有人诋毁我。陛下凭一个人的称誉就召我前来，又凭一个人的诋毁就让我离去，我担心天下有识之士听说此事，会有人借此窥测陛下的深浅得失啊！”文帝默然不语，面露惭色，过了很久才说：“河东郡对我来说如同股肱，是重要而得力的郡，所以才特意召您来面谈。”","content_jianti_auto":"3上召河东守季布，欲以为御史大夫。有言其勇、使酒、难近者；至，留邸一月，见罢。季布因进曰：「臣无功窃宠，待罪河东，陛下无故召臣，此人必有以臣欺陛下者。今臣至，无所受事，罢去，此人必有毁臣者。夫陛下以一人之誉而召臣，以一人之毁而去臣，臣恐天下有识闻之，有以闚陛下之浅深也！」上默然，惭，良久曰：「河东，吾股肱郡，故特召君耳。」","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，天下将窥其浅深。虽然，何病？人主威福之大权，岂以天下莫...","context_before":"","source_end_index":19,"source_paragraph_tongjian_id":"0ff91514-d652-4804-998e-025d5534a69d","source_start_index":0,"source_text":"以一人之誉而召季布，以一人之毁而遣季布"},{"context_after":"，其不足以为御史大夫，明矣。使酒难近之实，自露而不可掩矣...","context_before":"...深。虽然，何病？人主威福之大权，岂以天下莫能窥为不测哉！","source_end_index":70,"source_paragraph_tongjian_id":"0ff91514-d652-4804-998e-025d5534a69d","source_start_index":54,"source_text":"布之悻悻于罢去，而仰诘人主以取快"},{"context_after":"所以养臣子之耻也，非惭也。如其惭邪，抑以轻于召布而愧其知...","context_before":"...。慎用大臣而不吝于改过，闻人之言，迟之一月，而察其非诬，","source_end_index":166,"source_paragraph_tongjian_id":"0ff91514-d652-4804-998e-025d5534a69d","source_start_index":144,"source_text":"默然良久，而曰：“河东吾股肱郡，故特召君。”"}],"title":"六 文帝之失在轻于召季布也"}],"id":1113,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8ed42e20-db0e-11ef-a5ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"長沙王","people_name_jianti_auto":"长沙王","start_index":0,"tongjian_id":"8ed42e37-db0e-11ef-817c-a0d3651f611f"},{"people_name":"吳差","people_name_jianti_auto":"吴差","start_index":4,"tongjian_id":"8ed42e38-db0e-11ef-be7b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":8,"tongjian_id":"8ed42e39-db0e-11ef-8b0a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"長沙王，吳差也。漢制：諸侯王國有太傅輔王。疏，與疎同。","note_content_jianti_auto":"长沙王，吴差也。汉制：诸侯王国有太傅辅王。疏，与疎同。","note_type":"hu_note","start_index":63,"tongjian_id":"8ed42e36-db0e-11ef-84ef-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公卿","official_note":"公卿泛指高级官员，如三公九卿，此处表示贾谊被提议担任高级官职。","official_rank":"未知","source_snippet":"公卿之位","start_index":6,"tongjian_id":"65294a84-fe6a-462a-89c0-6240bdb68d68"},{"confidence":0.95,"official_category":"地方行政","official_name":"長沙王太傅","official_note":"太傅是诸侯王的师傅，负责教导和辅佐，此处表示贾谊被任命为长沙王的太傅。","official_rank":"未知","source_snippet":"長沙王太傅","start_index":55,"tongjian_id":"f1f683c7-865b-4cc1-9cf3-2e9705a6f295"}],"ExtRef_Children_people":[{"link_birth_year":-200,"link_death_year":-168,"link_td_description":"贾谊，雒阳（今河南省洛阳市东）人，西汉政论家、思想家、文学家。","link_td_id":"Q10000180","link_td_number_id":101935,"people_name":"賈誼","people_name_jianti_auto":"贾谊","people_xingming":"贾谊","start_index":4,"tongjian_id":"8ed42e3a-db0e-11ef-8e39-a0d3651f611f"},{"people_name":"長沙王","people_name_jianti_auto":"长沙王","people_xingming":"吴差","start_index":57,"tongjian_id":"8ed42e3c-db0e-11ef-b52c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"洛陽","place_name_jianti_auto":"洛阳","resolved_place_entity_id":54,"start_index":20,"tongjian_id":"8ed42e3b-db0e-11ef-b40e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/琵琶亭诗","excerpts":[{"context_after":"，前所云少误矣。吾州馀干县东干越亭有琵琶洲在下，唐刘长卿...","context_before":"...旧匡庐翠扫天。”郭君，成都人，隆兴癸未登科，仕不甚达。但","source_end_index":352,"source_paragraph_tongjian_id":"235aaa27-765b-406b-96e0-93027e34d5e8","source_start_index":337,"source_text":"贾谊自长沙召还，后为梁王傅乃卒"}],"path":"三笔/卷六/琵琶亭诗","source_name":"容斋随笔"}],"class_tags":["人事"],"content":"4上議以賈誼任公卿之位。大臣多短之曰：「洛陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，以爲長沙王太傅。","content_fanyi":"汉文帝提议让贾谊出任公卿之位。许多大臣指责贾谊说：“这个洛阳人，年纪轻，学问不深，一心只想独揽大权，扰乱朝廷政事。”于是文帝后来也疏远了贾谊，不采纳他的意见，把他外放为长沙王太傅。","content_jianti_auto":"4上议以贾谊任公卿之位。大臣多短之曰：「洛阳之人，年少初学，专欲擅权，纷乱诸事。」于是天子后亦疏之，不用其议，以为长沙王太傅。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"于谊为诬，于轼允当之矣。藉授以幼主危邦，恶足以知其所终哉...","context_before":"...吾老聃矣，吾瞿昙矣。若此者，谊之所不屑，抑贽之所不屑也。","source_end_index":209,"source_paragraph_tongjian_id":"c1693e83-85de-4fdd-a542-944d2b5b8b84","source_start_index":194,"source_text":"绛、灌之非谊曰：“擅权纷乱。”"}],"title":"七 贾谊、陆贽与苏轼"}],"id":1114,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8ed42e34-db0e-11ef-84b6-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000486"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"8ed42e3f-db0e-11ef-8a37-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":2,"tongjian_id":"8ed42e40-db0e-11ef-8ab9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢承秦制，郡有守，有尉；守掌治其郡，尉掌佐守典武職甲卒。行縣，循行屬縣也。行，下孟翻。","note_content_jianti_auto":"汉承秦制，郡有守，有尉；守掌治其郡，尉掌佐守典武职甲卒。行县，循行属县也。行，下孟翻。","note_type":"hu_note","start_index":20,"tongjian_id":"8ed42e3e-db0e-11ef-8b7b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8ed42e44-db0e-11ef-9649-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：置，立也。辭，對獄之辭。","note_content_jianti_auto":"师古曰：置，立也。辞，对狱之辞。","note_type":"hu_note","start_index":71,"tongjian_id":"8ed42e43-db0e-11ef-90c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8ed42e47-db0e-11ef-b11a-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"8ed42e48-db0e-11ef-8ae4-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十五行本下「吏」字上重「獄」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：甲十五行本下「吏」字上重「狱」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8ed42e46-db0e-11ef-a0df-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":86,"tongjian_id":"8ed42e45-db0e-11ef-a9ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李奇","people_name_jianti_auto":"李奇","start_index":11,"tongjian_id":"8ed42e4a-db0e-11ef-a563-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":22,"tongjian_id":"8ed42e4b-db0e-11ef-aea3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":45,"tongjian_id":"8ed42e4c-db0e-11ef-a59a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"牘，木簡也，以書獄辭。李奇曰：牘，吏所執簿。韋昭曰：牘，版也。索隱曰：簿，卽牘也；故魏志「秦宓以簿擊頰」，則亦簡牘之類也。","note_content_jianti_auto":"牍，木简也，以书狱辞。李奇曰：牍，吏所执簿。韦昭曰：牍，版也。索隐曰：簿，即牍也；故魏志「秦宓以簿击颊」，则亦简牍之类也。","note_type":"hu_note","start_index":94,"tongjian_id":"8ed42e49-db0e-11ef-ad7d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8ed42e50-db0e-11ef-b53f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：尚，奉也，不敢言娶也。","note_content_jianti_auto":"韦昭曰：尚，奉也，不敢言娶也。","note_type":"hu_note","start_index":118,"tongjian_id":"8ed42e4f-db0e-11ef-97df-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"8ed42e52-db0e-11ef-a1cf-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":12,"tongjian_id":"8ed42e53-db0e-11ef-ba9b-a0d3651f611f"},{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":30,"tongjian_id":"8ed42e54-db0e-11ef-8386-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":47,"tongjian_id":"8ed42e55-db0e-11ef-ad1a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：冒絮，陌頟絮也。如淳曰：太后恚怒，遭得左右物提之也。晉灼曰：巴蜀異物志謂頭上巾爲冒絮。師古曰：冒，覆也；老人所以覆其頭。提，擊之也。提，徒計翻；索隱音抵，擲也。","note_content_jianti_auto":"应劭曰：冒絮，陌頟絮也。如淳曰：太后恚怒，遭得左右物提之也。晋灼曰：巴蜀异物志谓头上巾为冒絮。师古曰：冒，覆也；老人所以覆其头。提，击之也。提，徒计翻；索隐音抵，掷也。","note_type":"hu_note","start_index":143,"tongjian_id":"8ed42e51-db0e-11ef-ad21-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"河東守","official_note":"河東守是漢代河東郡的郡守，負責地方行政和軍事，此處指河東郡的官員巡行至絳縣，監察周勃。","official_rank":"郡守級別","source_snippet":"每河東守、尉行縣至絳","start_index":12,"tongjian_id":"5df6c596-c454-4b4a-9d3e-af0708a6bd98"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"尉","official_note":"尉是漢代郡級軍事官員，協助郡守管理地方治安和軍事，此處與河東守一同巡行，可能涉及監視周勃。","official_rank":"郡尉級別","source_snippet":"每河東守、尉行縣至絳","start_index":15,"tongjian_id":"584113dc-93df-4a01-9858-223109aaf925"},{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是漢代中央司法機構的長官，負責審理重大案件，此處指周勃被指控謀反後，案件交由廷尉處理。","official_rank":"九卿之一","source_snippet":"下廷尉；廷尉逮捕勃","start_index":40,"tongjian_id":"b08470b8-1dbd-4a6d-9e7b-c374dba34b59"},{"confidence":0.8,"official_category":"司法","official_name":"獄吏","official_note":"獄吏是監獄中的低級官員，負責管理囚犯和獄務，此處周勃賄賂獄吏以獲取幫助，顯示獄吏在司法系統中的影響力。","official_rank":"低級官吏","source_snippet":"勃以千金與獄吏","start_index":78,"tongjian_id":"dfb7503d-7f80-4bef-9e8b-9d5ceda214f4"}],"ExtRef_Children_people":[{"people_name":"絳侯","people_name_jianti_auto":"绛侯","start_index":1,"tongjian_id":"8ed56ebd-db0e-11ef-902e-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"周勃","people_name_jianti_auto":"周勃","people_xingming":"周勃","start_index":3,"tongjian_id":"8ed56ebe-db0e-11ef-a10a-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"勃","people_name_jianti_auto":"勃","people_xingming":"周勃","start_index":20,"tongjian_id":"8ed56ec1-db0e-11ef-b182-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"勃","people_name_jianti_auto":"勃","start_index":46,"tongjian_id":"8ed56ec2-db0e-11ef-b777-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"勃","people_name_jianti_auto":"勃","start_index":58,"tongjian_id":"8ed56ec3-db0e-11ef-9784-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"勃","people_name_jianti_auto":"勃","start_index":63,"tongjian_id":"8ed56ec4-db0e-11ef-8aae-a0d3651f611f"},{"link_death_year":-169,"link_td_description":"