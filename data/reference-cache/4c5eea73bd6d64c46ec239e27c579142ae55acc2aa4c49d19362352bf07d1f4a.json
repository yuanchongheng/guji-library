":"汉中","start_index":95,"tongjian_id":"9b0cc989-db0e-11ef-95b6-a0d3651f611f"},{"place_name":"武都","place_name_jianti_auto":"武都","start_index":100,"tongjian_id":"9b0cc98a-db0e-11ef-b2af-a0d3651f611f"},{"place_name":"秦川","place_name_jianti_auto":"秦川","start_index":105,"tongjian_id":"9b0cc98b-db0e-11ef-bfa5-a0d3651f611f"},{"place_name":"楊氐","place_name_jianti_auto":"杨氐","start_index":110,"tongjian_id":"9b0cc98c-db0e-11ef-9f28-a0d3651f611f"},{"place_name":"苻氐","place_name_jianti_auto":"苻氐","start_index":120,"tongjian_id":"9b0cc98d-db0e-11ef-a4be-a0d3651f611f"},{"place_name":"楊氐","place_name_jianti_auto":"杨氐","start_index":123,"tongjian_id":"9b0cc98e-db0e-11ef-ab17-a0d3651f611f"},{"place_name":"苻氐","place_name_jianti_auto":"苻氐","start_index":126,"tongjian_id":"9b0cc98f-db0e-11ef-9dc5-a0d3651f611f"},{"place_name":"略陽","place_name_jianti_auto":"略阳","start_index":130,"tongjian_id":"9b0cc990-db0e-11ef-b3f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以此觀之，諸氐固先有苻姓矣，不待蒲堅以背文「草付」之祥乃姓苻也。杜佑曰：氐者，西戎別種，漢武帝開武都郡，排其種人，分竄山谷，或在上祿，或在河、隴左右。魏武令夏侯淵討叛氐阿貴、千萬等，後因拔棄漢中，遂徙武都之種於秦川，是曰楊氐。苻堅之先，是曰苻氐。楊氐、苻氐同出略陽，世爲婚姻。降，戶江翻。","note_content_jianti_auto":"以此观之，诸氐固先有苻姓矣，不待蒲坚以背文「草付」之祥乃姓苻也。杜佑曰：氐者，西戎别种，汉武帝开武都郡，排其种人，分窜山谷，或在上禄，或在河、陇左右。魏武令夏侯渊讨叛氐阿贵、千万等，后因拔弃汉中，遂徙武都之种于秦川，是曰杨氐。苻坚之先，是曰苻氐。杨氐、苻氐同出略阳，世为婚姻。降，户江翻。","note_type":"hu_note","start_index":11,"tongjian_id":"9b0cc976-db0e-11ef-905d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":317,"link_death_year":355,"link_td_description":"苻健，字建业，略阳临渭（今甘肃秦安）人，氐族，苻洪第三子，十六国前秦开国皇帝。","link_td_id":"Q10004076","link_td_number_id":131528,"people_name":"苻健","people_name_jianti_auto":"苻健","people_xingming":"苻健","start_index":4,"tongjian_id":"9b0cc992-db0e-11ef-85e5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"武都氐","place_name_jianti_auto":"武都氐","resolved_place_entity_id":2458,"start_index":1,"tongjian_id":"9b0cc991-db0e-11ef-906a-a0d3651f611