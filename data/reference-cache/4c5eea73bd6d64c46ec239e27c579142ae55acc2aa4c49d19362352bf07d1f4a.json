ex":62,"tongjian_id":"9b0cc964-db0e-11ef-b8f1-a0d3651f611f"},{"place_name":"湔塴","place_name_jianti_auto":"湔塴","start_index":74,"tongjian_id":"9b0cc965-db0e-11ef-b28e-a0d3651f611f"},{"place_name":"湔堰","place_name_jianti_auto":"湔堰","start_index":79,"tongjian_id":"9b0cc966-db0e-11ef-bfc1-a0d3651f611f"},{"place_name":"觀阪","place_name_jianti_auto":"观阪","start_index":82,"tongjian_id":"9b0cc967-db0e-11ef-8f86-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":116,"tongjian_id":"9b0cc968-db0e-11ef-a6dd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"湔，卽漢之湔氐道，屬蜀郡。汶水，卽㟭江水也。㟭江出氐道西徼外㟭山，東流歷都安縣。沈約曰：縣，蜀所立。水經註曰：都安縣有桃關，蜀守李冰作大堰于此，謂之湔塴，亦曰湔堰；觀阪在其上。裴松之曰：湔，音翦。晉書音義：汶，讀與㟭同。諸葛亮旣沒，漢主游觀，莫之敢止。","note_content_jianti_auto":"湔，即汉之湔氐道，属蜀郡。汶水，即㟭江水也。㟭江出氐道西徼外㟭山，东流历都安县。沈约曰：县，蜀所立。水经注曰：都安县有桃关，蜀守李冰作大堰于此，谓之湔塴，亦曰湔堰；观阪在其上。裴松之曰：湔，音翦。晋书音义：汶，读与㟭同。诸葛亮既没，汉主游观，莫之敢止。","note_type":"hu_note","start_index":21,"tongjian_id":"9b0cc952-db0e-11ef-8e11-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":11,"start_index":6,"tongjian_id":"9b0cc96c-db0e-11ef-bd86-a0d3651f611f"},{"place_name":"湔","place_name_jianti_auto":"湔","resolved_place_entity_id":7980,"start_index":9,"tongjian_id":"9b0cc96d-db0e-11ef-8227-a0d3651f611f"},{"place_name":"觀阪","place_name_jianti_auto":"观阪","resolved_place_entity_id":5308,"start_index":12,"tongjian_id":"9b0cc96e-db0e-11ef-baaf-a0d3651f611f"},{"place_name":"汶水","place_name_jianti_auto":"汶水","resolved_place_entity_id":3876,"start_index":16,"tongjian_id":"9b0cc96f-db0e-11ef-a13c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"晋泰始八年，皇甫晏为益州刺史，讨汶山白马叛胡，至观坂，为...","context_before":"观坂[在县西。","source_end_index":30,"source_paragraph_tongjian_id":"37cc7880-e256-5643-82a9-837712a7e262","source_start_index":7,"source_text":"蜀汉建兴十四年，幸湔登观坂，观汶水之流，是也。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3夏，四月，漢主至湔，登觀阪，觀汶水之流，旬日而還。","content_fanyi":"夏季四月，蜀汉后主刘禅到达湔氐道，登上观阪，观看汶水的水流，停留十日后返回。","content_jianti_auto":"3夏，四月，汉主至湔，登观阪，观汶水之流，旬日而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6207,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9b0cc951-db0e-11ef-9b56-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"9b0cc973-db0e-11ef-844a-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":25,"tongjian_id":"9b0cc974-db0e-11ef-8369-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":29,"tongjian_id":"9b0cc975-db0e-11ef-ac4f-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十六行本「氐」下有「王」字；乙十一行本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：甲十六行本「氐」下有「王」字；乙十一行本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"9b0cc972-db0e-11ef-8005-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":4,"tongjian_id":"9b0cc971-db0e-11ef-bb1b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"苻","people_name_jianti_auto":"苻","start_index":10,"tongjian_id":"9b0cc977-db0e-11ef-901e-a0d3651f611f"},{"people_name":"蒲堅","people_name_jianti_auto":"蒲坚","start_index":16,"tongjian_id":"9b0cc978-db0e-11ef-8f42-a0d3651f611f"}