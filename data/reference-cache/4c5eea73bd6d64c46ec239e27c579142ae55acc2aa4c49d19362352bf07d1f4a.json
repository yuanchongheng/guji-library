er_id":668594,"people_name":"昶","people_name_jianti_auto":"昶","people_xingming":"王昶","start_index":30,"tongjian_id":"9b0f4683-db0e-11ef-a0fb-a0d3651f611f"},{"people_name":"默","people_name_jianti_auto":"默","people_xingming":"王默","start_index":41,"tongjian_id":"9b0f4684-db0e-11ef-aed1-a0d3651f611f"},{"link_death_year":266,"link_td_description":"王沈，字处道，太原郡晋阳县人。是三国时期魏晋的政治家。","link_td_id":"Q10003184","link_td_number_id":772508,"people_name":"沈","people_name_jianti_auto":"沈","people_xingming":"王沈","start_index":44,"tongjian_id":"9b0f4685-db0e-11ef-9703-a0d3651f611f"},{"link_birth_year":223,"link_death_year":297,"link_td_description":"王浑，太原晋阳人，三国时曹魏及西晋时期将领，曹魏司空王昶之子，曾参与攻灭东吴的战争，协助西晋统一中国，王浑在西晋官至司徒。","link_td_id":"Q10003189","link_td_number_id":1064497,"people_name":"渾","people_name_jianti_auto":"浑","people_xingming":"王浑","start_index":50,"tongjian_id":"9b0f4686-db0e-11ef-8564-a0d3651f611f"},{"link_death_year":259,"link_td_description":"王昶，字文舒，太原郡晋阳县（今山西省太原市）人，东汉、曹魏官员。","link_td_id":"Q10004543","link_td_number_id":668594,"people_name":"深","people_name_jianti_auto":"深","people_xingming":"王深","start_index":53,"tongjian_id":"9b0f4687-db0e-11ef-8306-a0d3651f611f"},{"link_birth_year":-551,"link_death_year":-479,"link_td_description":"孔丘，春秋末期鲁国的教育家与哲学家，儒家创始人兼主要代表人物。","link_td_id":"Q10000008","link_td_number_id":484,"people_name":"孔子","people_name_jianti_auto":"孔子","people_xingming":"孔子","start_index":166,"tongjian_id":"9b0f4689-db0e-11ef-84bd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"兗州","place_name_jianti_auto":"兖州","resolved_place_entity_id":211,"start_index":19,"tongjian_id":"9b0f4681-db0e-11ef-9455-a0d3651f611f"},{"place_name":"太原","place_name_jianti_auto":"太原","resolved_place_entity_id":192,"start_index":23,"tongjian_id":"9b0f4682-db0e-11ef-b377-a0d3651f611f"},{"place_name":"闕黨","place_name_jianti_auto":"阙党","resolved_place_entity_id":9602,"start_index":124,"tongjian_id":"9b0f4688-db0e-11ef-8e98-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"10詔公卿舉才德兼備者各一人，司馬懿以兗州刺史太原王昶應選。昶爲人謹厚，名其兄子曰默，曰沈，名其子曰渾，曰深，爲書戒之曰：「吾以四者爲名，欲使汝曹顧名思義，不敢違越也。夫物速成則疾亡，晚就而善終，朝華之草，夕而零落，松柏之茂，隆寒不衰，是以君子戒於闕黨也。夫能屈以爲伸，讓以爲得，弱以爲強，鮮不遂矣。夫毀譽者，愛惡之原而禍福之機也。孔子曰：『吾之於人，誰毀誰譽。』以聖人之德猶尚如此，況庸庸之徒而輕毀譽哉！人或毀己，當退而求之於身。若己有可毀之行，則彼言當矣；若己無可毀之行，則彼言妄矣。當則無怨於彼，妄則無害於身，又何反報焉！諺曰：『救寒莫如重裘，止謗莫如自脩』，斯言信矣。」","content_fanyi":"魏明帝下诏让公卿每人举荐一名才德兼备的人，司马懿推荐兖州刺史太原人王昶应选。王昶为人谨慎厚道，给哥哥的儿子起名为王默、王沈，给自己的儿子起名为王浑、王深，并写信告诫他们说：“我用这四个字给你们取名，是想让你们顾名思义，不敢违背和逾越其中的含义。事物速成就会迅速消亡，晚成则能善终；早晨开花的草，傍晚就凋零；松柏茂盛，隆冬严寒也不衰败，所以君子以阙党童子急于求成为戒。能把屈曲当作伸展，把谦让当作获得，把柔弱当作刚强的人，很少不能如愿成功。毁谤和赞誉，是喜爱与厌恶的根源，也是祸福的契机。孔子说：‘我对于别人，诋毁过谁，赞誉过谁呢？’以圣人的德行尚且如此，何况平庸之辈，怎能轻率地诋毁或赞誉别人呢！有人诋毁自己，应当退而反省自身。如果自己有值得诋毁的行为，那么对方的话就是恰当的；如果自己没有值得诋毁的行为，那么对方的话就是虚妄的。对方说得恰当就不必怨恨他，说得虚妄也对自己没有伤害，又何必反过来报复呢！谚语说：‘御寒莫过于厚皮衣，止谤莫过于自我修养’，这话确实可信。”","content_jianti_auto":"10诏公卿举才德兼备者各一人，司马懿以兖州刺史太原王昶应选。昶为人谨厚，名其兄子曰默，曰沈，名其子曰浑，曰深，为书戒之曰：「吾以四者为名，欲使汝曹顾名思义，不敢违越也。夫物速成则疾亡，晚就而善终，朝华之草，夕而零落，松柏之茂，隆寒不衰，是以君子戒于阙党也。夫能屈以为伸，让以为得，弱以为强，鲜不遂矣。夫毁誉者，爱恶之原而祸福之机也。孔子曰：『吾之于人，谁毁谁誉。』以圣人之德犹尚如此，况庸庸之徒而轻毁誉哉！人或毁己，当退而求之于身。若己有可毁之行，则彼言当矣；若己无可毁之行，则彼言妄矣。当则无怨于彼，妄则无害于身，又何反报焉！谚曰：『救寒莫如重裘，止谤莫如自修』，斯言信矣。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":6215,"number":10,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"9b0f4662-db0e-11ef-979f-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":1,"tongjian_id":"9b0cc945-db0e-11ef-96b1-a0d3651f611f","year_anno":"（丙辰、二三六）","year_int":236},"message":"success","success":true}