{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚辰、前三四一）","note_content_jianti_auto":"（庚辰、前三四一）","note_type":"hu_note","start_index":0,"tongjian_id":"8c304393-db0e-11ef-ba38-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄒忌","people_name_jianti_auto":"邹忌","start_index":0,"tongjian_id":"8c304396-db0e-11ef-b2b6-a0d3651f611f"},{"people_name":"成侯","people_name_jianti_auto":"成侯","start_index":7,"tongjian_id":"8c304397-db0e-11ef-ba80-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":3,"tongjian_id":"8c304398-db0e-11ef-bf4b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄒忌爲齊相，封成侯。","note_content_jianti_auto":"邹忌为齐相，封成侯。","note_type":"hu_note","start_index":43,"tongjian_id":"8c304395-db0e-11ef-8de4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見亡，言見有亡國之勢也。愬，告愬也。","note_content_jianti_auto":"见亡，言见有亡国之势也。愬，告愬也。","note_type":"hu_note","start_index":121,"tongjian_id":"8c30439b-db0e-11ef-919a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陰，闇也。使，疏吏翻。","note_content_jianti_auto":"阴，暗也。使，疏吏翻。","note_type":"hu_note","start_index":163,"tongjian_id":"8c30439c-db0e-11ef-8a4e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"齊威王","official_note":"齊威王是齊國的君主，在戰國時期齊國為諸侯國，此處作為決策者召集大臣商議救韓事宜。","official_rank":"王","source_snippet":"齊威王召大臣而謀曰","start_index":12,"tongjian_id":"2eae980a-7884-4c7f-9fd8-6ba0cdc66ef4"},{"confidence":0.85,"official_category":"未知","official_name":"成侯","official_note":"成侯是齊國的大臣或貴族，在此段中提供軍事建議反對救援韓國。","official_rank":"侯","source_snippet":"成侯曰：「不如勿救。」","start_index":28,"tongjian_id":"b7da5638-4eea-4ecd-8857-d2051e638c8d"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"田忌","official_note":"田忌是齊國的將領，以軍事才能著稱，此處主張及早救援韓國以避免其被魏國吞併。","official_rank":"將軍","source_snippet":"田忌曰：「弗救則韓且折而入於魏，不如蚤救之。」","start_index":44,"tongjian_id":"3c1a5756-f7d7-4e89-b05b-e76d4a234e7f"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"孫臏","official_note":"孫臏是齊國的軍事家，以智謀聞名，此處提出延遲救援以利用魏韓戰爭的疲弊，為齊國謀取利益。","official_rank":"軍師","source_snippet":"孫臏曰：「夫韓、魏之兵未弊而救之。是吾代韓受魏之兵，顧反聽命於韓也。且魏有破國之志，韓見亡，必東面而愬於齊矣。吾因深結韓之親而晚承魏之弊，則可受重利而得尊名也。」","start_index":78,"tongjian_id":"caff9714-a0c0-4eb5-b126-f6a834ed1437"}],"ExtRef_Children_people":[{"link_birth_year":-385,"link_death_year":-342,"link_td_description":"庞涓，活跃于战国中期的魏国将军。因妒贤迫害同仕魏国的同学孙膑，孙膑逃至齐国。前354年在桂陵之战被孙膑俘虏，通过调停后释放。前342年马陵之战与太子申一并败于田盼，于此战阵亡。","link_td_id":"Q10001045","link_td_number_id":20613,"people_name":"龐涓","people_name_jianti_auto":"庞涓","people_xingming":"庞涓","start_index":2,"tongjian_id":"8c30439d-db0e-11ef-9ee9-a0d3651f611f"},{"link_birth_year":-378,"link_death_year":-320,"link_td_description":"齐威王，妫姓，田氏，名因齐，战国策作婴齐，出土文物作陈侯因齐，田齐君主，为田齐桓公之子。","link_td_id":"Q10002279","link_td_number_id":327054,"people_name":"齊威王","people_name_jianti_auto":"齐威王","people_xingming":"田因齐","start_index":13,"tongjian_id":"8c30439e-db0e-11ef-9b1b-a0d3651f611f","wl_zhushi":"[田因齐]"},{"link_td_description":"邹忌，中国战国时代齐国人。《史记》中亦作驺忌，齐威王时为相，后封于下邳（今江苏省睢宁县古邳镇），号成侯。后又事齐宣王。","link_td_id":"Q10002184","link_td_number_id":173434,"people_name":"成侯","people_name_jianti_auto":"成侯","people_xingming":"邹忌","start_index":32,"tongjian_id":"8c30439f-db0e-11ef-af26-a0d3651f611f"},{"link_td_description":"田忌，妫姓，田氏，名忌，字期，又作陈忌、田臣思、田期思，中国战国时期齐国公子。","link_td_id":"Q10002204","link_td_number_id":667220,"people_name":"田忌","people_name_jianti_auto":"田忌","people_xingming":"田忌","start_index":43,"tongjian_id":"8c3043a4-db0e-11ef-b49c-a0d3651f611f"},{"link_birth_year":-382,"link_death_year":-316,"link_td_description":"孙膑，战国中期军事家，兵家代表人物。","link_td_id":"Q10000349","link_td_number_id":1137,"people_name":"孫臏","people_name_jianti_auto":"孙膑","people_xingming":"孙膑","start_index":66,"tongjian_id":"8c3043a7-db0e-11ef-a655-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"府安邑，山西夏县","resolved_place_entity_id":1,"start_index":1,"tongjian_id":"8c3043a0-db0e-11ef-8539-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"府新郑，河南新鄭","resolved_place_entity_id":301,"start_index":5,"tongjian_id":"8c3043a1-db0e-11ef-9675-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":7,"tongjian_id":"8c3043a2-db0e-11ef-b731-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":11,"tongjian_id":"8c3043a3-db0e-11ef-8ff1-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":51,"tongjian_id":"8c3043a5-db0e-11ef-bdd9-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":57,"tongjian_id":"8c3043a6-db0e-11ef-b6cf-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":72,"tongjian_id":"8c3043a8-db0e-11ef-b22d-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"府安邑，山西夏县","resolved_place_entity_id":