en_places":[{"place_name":"臨淄","place_name_jianti_auto":"临淄","resolved_place_entity_id":1515,"start_index":67,"tongjian_id":"8c30440f-db0e-11ef-b524-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"郢都，湖北省江陵县","resolved_place_entity_id":130,"start_index":79,"tongjian_id":"8c304411-db0e-11ef-b3a6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2成侯鄒忌惡田忌，使人操十金，卜於市，曰：「我，田忌之人也。我爲將三戰三勝，欲行事，可乎？」卜者出，因使人執之。田忌不能自明，率其徒攻臨淄，求成侯；不克，出奔楚。","content_fanyi":"齐国成侯邹忌憎恶田忌，暗中派人带着十镒黄金到集市上占卜，说：“我是田忌的部下，田忌让我担任将领，三战三胜，想在齐国举兵夺取政权，可以吗？”等占卜的人出来，成侯就派人把他抓了起来。田忌没有机会替自己辩白，便率领自己的部属攻打国都临淄，想抓获成侯邹忌；没有攻下，于是出逃投奔楚国。","content_jianti_auto":"2成侯邹忌恶田忌，使人操十金，卜于市，曰：「我，田忌之人也。我为将三战三胜，欲行事，可乎？」卜者出，因使人执之。田忌不能自明，率其徒攻临淄，求成侯；不克，出奔楚。","dtjl_paragraph_links":[],"dtjl_references":[],"id":165,"number":2,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c3043f8-db0e-11ef-9580-a0d3651f611f"}],"reign_name":"二十八年","reign_name_jianti_auto":"二十八年","start_index":21,"tongjian_id":"8c304392-db0e-11ef-851c-a0d3651f611f","year_anno":"（庚辰、前三四一）","year_int":-341},"message":"success","success":true}