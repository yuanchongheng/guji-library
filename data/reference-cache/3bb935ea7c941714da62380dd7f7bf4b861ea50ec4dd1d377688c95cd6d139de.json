gjian_id":"9d3464c4-db0e-11ef-bbe4-a0d3651f611f"},{"place_name":"宣漢","place_name_jianti_auto":"宣汉","start_index":126,"tongjian_id":"9d3464c5-db0e-11ef-897e-a0d3651f611f"},{"place_name":"漢昌","place_name_jianti_auto":"汉昌","start_index":129,"tongjian_id":"9d3464c6-db0e-11ef-854d-a0d3651f611f"},{"place_name":"宕渠郡","place_name_jianti_auto":"宕渠郡","start_index":135,"tongjian_id":"9d3464c7-db0e-11ef-9616-a0d3651f611f"},{"place_name":"巴西郡","place_name_jianti_auto":"巴西郡","start_index":146,"tongjian_id":"9d3464c8-db0e-11ef-bff6-a0d3651f611f"},{"place_name":"宕渠","place_name_jianti_auto":"宕渠","start_index":151,"tongjian_id":"9d3464c9-db0e-11ef-8001-a0d3651f611f"},{"place_name":"巴西","place_name_jianti_auto":"巴西","start_index":155,"tongjian_id":"9d3464ca-db0e-11ef-b8fc-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":159,"tongjian_id":"9d3464cb-db0e-11ef-82f0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宕渠縣，漢屬巴郡；蜀先主分置宕渠郡；晉屬巴西郡；唐爲渠州。今渠州流江縣東北七十里有古賨國城。李氏之先，廩君之苗裔也，世居巴中。秦幷天下，以爲黔中郡，薄賦斂之，口歲出錢四十。巴人呼賦爲賨，因謂之賨人焉。又按晉志：劉璋分巴郡墊江置巴西郡。劉備割巴郡之宕渠、宣漢、漢昌三縣，置宕渠郡，尋省，以縣並屬巴西郡。則宕渠之屬巴西，蓋晉時也。賨，徂宗翻。宕，徒浪翻。","note_content_jianti_auto":"宕渠县，汉属巴郡；蜀先主分置宕渠郡；晋属巴西郡；唐为渠州。今渠州流江县东北七十里有古賨国城。李氏之先，廪君之苗裔也，世居巴中。秦幷天下，以为黔中郡，薄赋敛之，口岁出钱四十。巴人呼赋为賨，因谓之賨人焉。又按晋志：刘璋分巴郡垫江置巴西郡。刘备割巴郡之宕渠、宣汉、汉昌三县，置宕渠郡，寻省，以县并属巴西郡。则宕渠之属巴西，盖晋时也。賨，徂宗翻。宕，徒浪翻。","note_type":"hu_note","start_index":22,"tongjian_id":"9d3464a9-db0e-11ef-a5f4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"漢獻帝","people_name_jianti_auto":"汉献帝","start_index":6,"tongjian_id":"9d3464ce-db0e-11ef-9fcc-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見六十八卷漢獻帝建安二十年。","note_content_jianti_auto":"事见六十八卷汉献帝建安二十年。","note_type":"hu_note","start_index":29,"tongjian_id":"9d3464cd-db0e-11ef-b1ca-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":0,"tongjian_id":"9d3464d0-db0e-11ef-b75b-a0d3651f611f"},{"place_name":"臨渭","place_name_jianti_auto":"临渭","start_index":2,"tongjian_id":"9d3464d1-db0e-11ef-b929-a0d3651f611f"},{"place_name":"平襄","place_name_jianti_auto":"平襄","start_index":5,"tongjian_id":"9d3464d2-db0e-11ef-9263-a0d3651f611f"},{"place_name":"略陽","place_name_jianti_auto":"略阳","start_index":8,"tongjian_id":"9d3464d3-db0e-11ef-8527-a0d3651f611f"},{"place_name":"清水","place_name_jianti_auto":"清水","start_index":11,"tongjian_id":"9d3464d4-db0e-11ef-9c6a-a0d3651f611f"},{"place_name":"廣魏郡","place_name_jianti_auto":"广魏郡","start_index":17,"tongjian_id":"9d3464d5-db0e-11ef-badc-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":21,"tongjian_id":"9d3464d6-db0e-11ef-8b61-a0d3651f611f"},{"place_name":"略陽郡","place_name_jianti_auto":"略阳郡","start_index":28,"tongjian_id":"9d3464d7-db0e-11ef-90f0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏分臨渭、平襄、略陽、清水四縣，置廣魏郡；晉泰始中，更名略陽郡。","note_content_jianti_auto":"魏分临渭、平襄、略阳、清水四县，置广魏郡；晋泰始中，更名略阳郡。","note_type":"hu_note","start_index":56,"tongjian_id":"9d3464cf-db0e-11ef-a9a9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"將軍","official_note":"將軍是古代軍事職務，此處指李氏被任命為將軍，表示其歸附魏武帝後獲得軍事職位。","official_rank":"未知","source_snippet":"拜爲將軍","start_index":38,"tongjian_id":"ab3bfa1e-d86a-4ef1-baa1-20bde336bba6"}],"ExtRef_Children_people":[{"link_death_year":216,"link_td_description":"张鲁，沛国丰县（今属江苏丰县）人，汉末割据汉中的军阀，五斗米道天师张陵之孙，张衡子，世为天师道第三代天师（称系师）。","link_td_id":"Q10000648","link_td_number_id":113564,"people_name":"張魯","people_name_jianti_auto":"张鲁","people_xingming":"张鲁","start_index":3,"tongjian_id":"9d3464d9-db0e-11ef-9a1a-a0d3651f611f"},{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":11,"tongjian_id":"9d3464da-db0e-11ef-9f03-a0d3651f611f"},{"link_birth_year":155,"link_death_year":220,"link_td_description":"曹操，字孟德，小字阿瞒，沛国谯县（今安徽亳州）人。东汉末年丞相、外戚、军事家、政治家、文学家和诗人，东汉末年主要群雄之一，职位为丞相，为汉末实际上的最高掌权者，亦是三国时代曹魏奠基者。","link_td_id":"Q10000017","link_td_number_id":2870,"people_name":"魏武帝","people_name_jianti_auto":"魏武帝","people_xingming":"曹操","start_index":22,"tongjian_id":"9d3464df-db0e-11ef-8f8c-a0d3651f611f","wl_zhushi":"[曹操]"},{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":29,"tongjian_id":"9d3464e1-db0e-11ef-aac9-a0d3651f611f"},{"people_name":"特","people_name_jianti_auto":"特","people_xingming":"李特","start_index":58,"tongjian_id":"9d3464e4-db0e-11ef-9c09-a0d3651f611f"},{"link_birth_year":247,"link_death_year":301,"link_td_description":"李庠，字玄序，巴西宕渠人（今中国四川省渠县）。三国至西晋时期巴氐人（一说为賨人）。为成汉开国君主李雄的三叔，成汉奠基者李特之弟。","link_td_id":"Q10007174","link_td_number_id":1536105,"people_name":"庠","people_name_jianti_auto":"庠","people_xingming":"李庠","start_index":60,"tongjian_id":"9d3464e5-db0e-11ef-9610-a0d3651f611f"},{"link_birth_year":248,"link_death_year":303,"link_td_description":"李流，字玄通，西晋末年巴氐人（一说为賨人），十六国时期成汉国建立者李雄之叔父，成汉政权奠基者李特之四弟。","link_td_id":"Q10008843","link_td_number_id":393894,"people_name":"流","people_name_jianti_auto":"流","people_xingming":"李流","start_index":62,"tongjian_id":"9d3464e6-db0e-11ef-a276-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9d3464a8-db0e-11ef-982d-a0d3651f611f","pinyin":"cóng","source_anchor_text":"魯在漢中賨人李氏自","source_key":"baiyang_epub","start_index":9,"text":"賨","tongjian_id":"2775efc4-2dd1-5c15-9595-5ed9ceb836d0"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9d3464a8-db0e-11ef-982d-a0d3651f611f","pinyin":"xiáng","source_anchor_text":"氐其孫特庠流皆有材","source_key":"baiyang_epub","start_index":60,"text":"庠","tongjian_id":"1a099ade-bd1b-572a-986d-77e448ba6f33"}],"ExtRef_Children_places":[{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"start_index":6,"tongjian_id":"9d3464db-db0e-11ef-b3af-a0d3651f611f"},{"place_name":"賨","place_name_jianti_auto":"賨","resolved_place_entity_id":3002,"start_index":9,"tongjian_id":"9d3464dc-db0e-11ef-9d30-a0d3651f611f"},{"place_name":"巴西","place_name_jianti_auto":"巴西","resolved_place_entity_id":647,"start_index":14,"tongjian_id":"9d3464dd-db0e-11ef-a667-a0d3651f611f"},{"place_name":"宕渠","place_name_jianti_auto":"宕渠","resolved_place_entity_id":2603,"start_index":16,"tongjian_id":"9d3464de-db0e-11ef-b4b9-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"start_index":26,"tongjian_id":"9d3464e0-db0e-11ef-8f11-a0d3651f611f"},{"place_name":"略陽","place_name_jianti_auto":"略阳","resolved_place_entity_id":702,"start_index":46,"tongjian_id":"9d3464e2-db0e-11ef-8221-a0d3651f611f"},{"place_name":"巴氐","place_name_jianti_auto":"巴氐","resolved_place_entity_id":6842,"start_index":53,"tongjian_id":"9d3464e3-db0e-11ef-a874-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"西晋末年流民起义","tongjian_id":"war_N0692"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、晋 十六国（卷三）","excerpts":[{"context_after":"[賨，赋名也。蜀人谓赋为賨，盖蛮户之赋。宕渠，见前蜀汉梁...","context_before":"李雄据蜀称成，李寿寻改称汉[亦谓之后蜀]。\n【史略】","source_end_index":42,"source_paragraph_tongjian_id":"00b2f71c-7e1d-5560-b73d-5a32389c11ef","source_start_index":26,"source_text":"汉末，賨人李氏自巴西、宕渠徙汉中"},{"context_after":"元康中，关中乱，岁饥，李特等帅流民就谷汉川，寻入剑阁[见...","context_before":"...名也。蜀人谓赋为賨，盖蛮户之赋。宕渠，见前蜀汉梁州置]，","source_end_index":95,"source_paragraph_tongjian_id":"00b2f71c-7e1d-5560-b73d-5a32389c11ef","source_start_index":74,"source_text":"依张鲁。及魏武克汉中，复迁略阳，谓之巴氐。"}],"path":"历代州域形势纪要/三、晋 十六国（卷三）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"3初，張魯在漢中，賨人李氏自巴西宕渠往依之。魏武帝克漢中，李氏將五百餘家歸之，拜爲將軍，遷于略陽北土，號曰巴氐。其孫特、庠、流，皆有材武，善騎射，性任俠，州黨多附之。","content_fanyi":"当初，张鲁在汉中时，賨人李氏从巴西宕渠前去依附他。魏武帝攻克汉中后，李氏率领五百多家归顺，被任命为将军，迁往略阳以北，号称巴氐。他的孙子李特、李庠、李流，都有才能和勇力，擅长骑马射箭，性情仗义行侠，州中同乡多来归附他们。","content_jianti_auto":"3初，张鲁在汉中，賨人李氏自巴西宕渠往依之。魏武帝克汉中，李氏将五百余家归之，拜为将军，迁于略阳北土，号曰巴氐。其孙特、庠、流，皆有材武，善骑射，性任侠，州党多附之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7094,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9d3464a8-db0e-11ef-982d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"荐，才甸翻。爾雅：仍饑爲荐。","note_content_jianti_auto":"荐，才甸翻。尔雅：仍饥为荐。","note_type":"hu_note","start_index":11,"tongjian_id":"9d3464e8-db0e-11ef-8865-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李特","people_name_jianti_auto":"李特","start_index":0,"tongjian_id":"9d3464ee-db0e-11ef-8a91-a0d3651f611f"},{"people_name":"特","people_name_jianti_auto":"特","start_index":52,"tongjian_id":"9d3464ef-db0e-11ef-9173-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","start_index":19,"tongjian_id":"9d3464f0-db0e-11ef-9ce7-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":26,"tongjian_id":"9d3464f1-db0e-11ef-9fd1-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":56,"tongjian_id":"9d3464f2-db0e-11ef-9db3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李特事始此。考異曰：帝紀：「元康七年，關中饑；八年，雍州有年。」而華陽國志、三十國、晉春秋，皆云「八年，特就穀入蜀。」今從之。","note_content_jianti_auto":"李特事始此。考异曰：帝纪：「元康七年，关中饥；八年，雍州有年。」而华阳国志、三十国、晋春秋，皆云「八年，特就谷入蜀。」今从之。","note_type":"hu_note","start_index":198,"tongjian_id":"9d3464ed-db0e-11ef-8926-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"监察","official_name":"侍御史","official_note":"侍御史是御史台的官员，负责监察百官、弹劾不法，此处李苾受命持节慰劳流民并监察其动向，以防止流民进入剑阁地区。","official_rank":"从六品","source_snippet":"遣侍御史李苾持節慰勞","start_index":78,"tongjian_id":"aab4e9ae-1a97-48aa-bfdf-c3461c7f37c2"}],"ExtRef_Children_people":[{"link_death_year":299,"link_td_description":"齐万年，西晋时期氐族首领。","link_td_id":"Q10001706","link_td_number_id":189746,"people_name":"齊萬年","people_name_jianti_auto":"齐万年","people_xingming":"齐万年","start_index":1,"tongjian_id":"9d3464f8-db0e-11ef-adeb-a0d3651f611f"},{"people_name":"特","people_name_jianti_auto":"特","people_xingming":"李特","start_index":40,"tongjian_id":"9d3464fa-db0e-11ef-9300-a0d3651f611f"},{"people_name":"李苾","people_name_jianti_auto":"李苾","people_xingming":"李苾","start_index":80,"tongjian_id":"9d3464fb-db0e-11ef-9974-a0d3651f611f"},{"people_name":"苾","people_name_jianti_auto":"苾","people_xingming":"李苾","start_index":98,"tongjian_id":"9d346502-db0e-11ef-b9e9-a0d3651f611f"},{"people_name":"李特","people_name_jianti_auto":"李特","people_xingming":"李特","start_index":163,"tongjian_id":"9d346507-db0e-11ef-b534-a0d3651f611f"},{"link_birth_year":207,"link_death_year":271,"link_td_description":"刘禅，字公嗣，又字升之，幼名阿斗，汉昭烈帝刘备之子，蜀汉最后一位皇帝。","link_td_id":"Q10000148","link_td_number_id":1200845,"people_name":"劉禪","people_name_jianti_auto":"刘禅","people_xingming":"刘禅","start_index":174,"tongjian_id":"9d346508-db0e-11ef-9453-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9d3464e7-db0e-11ef-b573-a0d3651f611f","pinyin":"bì","source_anchor_text":"侍御史李苾持節慰勞","source_key":"baiyang_epub","start_index":81,"text":"苾","tongjian_id":"6a4c3296-c695-5bc2-8aff-1f9898afc304"}],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":133,"start_index":6,"tongjian_id":"9d3464f9-db0e-11ef-b1ad-a0d3651f611f"},{"place_name":"略陽","place_name_jianti_auto":"略阳","resolved_place_entity_id":702,"start_index":11,"tongjian_id":"9d3464fc-db0e-11ef-b3f2-a0d3651f611f"},{"place_name":"天水","place_name_jianti_auto":"天水","resolved_place_entity_id":548,"start_index":14,"tongjian_id":"9d3464fd-db0e-11ef-a883-a0d3651f611f"},{"place_name":"漢川","place_name_jianti_auto":"汉川","resolved_place_entity_id":1475,"start_index":24,"tongjian_id":"9d3464fe-db0e-11ef-a830-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"start_index":59,"tongjian_id":"9d3464ff-db0e-11ef-9591-a0d3651f611f"},{"place_name":"巴","place_name_jianti_auto":"巴","resolved_place_entity_id":39,"start_index":67,"tongjian_id":"9d346500-db0e-11ef-84e4-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","resolved_place_entity_id":38,"start_index":69,"tongjian_id":"9d346501-db0e-11ef-8ed5-a0d3651f611f"},{"place_name":"劍閣","place_name_jianti_auto":"剑阁","resolved_place_entity_id":1369,"start_index":95,"tongjian_id":"9d346503-db0e-11ef-804a-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"start_index":100,"tongjian_id":"9d346504-db0e-11ef-a623-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","resolved_place_entity_id":294,"start_index":120,"tongjian_id":"9d346505-db0e-11ef-8086-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","resolved_place_entity_id":38,"start_index":129,"tongjian_id":"9d346506-db0e-11ef-bc20-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","resolved_place_entity_id":123,"start_index":154,"tongjian_id":"9d346509-db0e-11ef-98e8-a0d3651f611f"},{"place_name":"益","place_name_jianti_auto":"益","resolved_place_entity_id":204,"start_index":156,"tongjian_id":"9d34650a-db0e-11ef-b054-a0d3651f611f"},{"place_name":"劍閣","place_name_jianti_auto":"剑阁","resolved_place_entity_id":1369,"start_index":166,"tongjian_id":"9d34650b-db0e-11ef-bd76-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"西晋末年流民起义","tongjian_id":"war_N0692"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、晋 十六国（卷三）","excerpts":[{"context_after":"[见前三国蜀胡氏论剑门]。会益州刺史赵袴据州叛，特等依之...","context_before":"...蜀汉梁州置]，依张鲁。及魏武克汉中，复迁略阳，谓之巴氐。","source_end_index":121,"source_paragraph_tongjian_id":"00b2f71c-7e1d-5560-b73d-5a32389c11ef","source_start_index":95,"source_text":"元康中，关中乱，岁饥，李特等帅流民就谷汉川，寻入剑阁"}],"path":"历代州域形势纪要/三、晋 十六国（卷三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷六十六）","excerpts":[{"context_after":"升平三年，梁州刺史司马勋叛，引兵入剑阁，攻涪[今绵州]，...","context_before":"...屯剑阁以拒会，列营守险，会不能克。今大剑山犹有姜维故垒。","source_end_index":430,"source_paragraph_tongjian_id":"11168d3d-ef06-5410-b3a1-2bff3caf3885","source_start_index":386,"source_text":"晋元康八年，李特帅关中流民就食巴蜀，过剑阁，太息曰：刘禅有如此地，面缚于人，岂非庸才耶？"}],"path":"四川方舆纪要/〇、封域 山川险要（卷六十六）","source_name":"读史方舆纪要"}],"class_tags":["内政","人事"],"content":"及齊萬年反，關中荐饑，略陽、天水六郡民流移就穀入漢川者數萬家，道路有疾病窮乏者，特兄弟常營護振救之，由是得衆心。流民至漢中，上書求寄食巴、蜀，朝議不許，遣侍御史李苾持節慰勞，且監察之，不令入劍閣。苾至漢中，受流民賂，表言：「流民十萬餘口，非漢中一郡所能振贍；蜀有倉儲，人復豐稔，宜令就食。」朝廷從之。由是散在梁、益，不可禁止。李特至劍閣，太息曰：「劉禪有如此地，面縛於人，豈非庸才邪！」聞者異之。","content_fanyi":"等到齐万年反叛时，关中连年饥荒，略阳、天水等六郡流亡迁徙、寻找粮食而进入汉川的百姓有数万家。道路上有患病穷困的人，李特兄弟常常照料保护、赈济救助他们，因此深得流民之心。流民到达汉中后，上书请求到巴、蜀寄食，朝廷商议后没有准许，派侍御史李苾持节前去慰劳，同时监察他们，不让他们进入剑阁。李苾到达汉中后，收受流民的贿赂，上表说：“流民有十万余口，不是汉中一郡所能赈济供养的；蜀地有仓库储备，百姓又丰收富足，应当让他们前去就食。”朝廷听从了他的建议。从此流民散布在梁州、益州，无法禁止。李特到了剑阁，长叹说：“刘禅拥有这样的地方，却双手反绑向人投降，难道不是庸才吗？”听到这话的人都觉得他不一般。","content_jianti_auto":"及齐万年反，关中荐饥，略阳、天水六郡民流移就谷入汉川者数万家，道路有疾病穷乏者，特兄弟常营护振救之，由是得众心。流民至汉中，上书求寄食巴、蜀，朝议不许，遣侍御史李苾持节慰劳，且监察之，不令入剑阁。苾至汉中，受流民赂，表言：「流民十万余口，非汉中一郡所能振赡；蜀有仓储，人复丰稔，宜令就食。」朝廷从之。由是散在梁、益，不可禁止。李特至剑阁，太息曰：「刘禅有如此地，面缚于人，岂非庸才邪！」闻者异之。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"夫特亦介晋之乱耳，使其非然，则亦赵韪、李顺而已。董璋、王...","context_before":"...焉，非果以夔门、剑阁之险，肥沃盐米之薮，为可恃而恃之也。","source_end_index":118,"source_paragraph_tongjian_id":"c63d5d58-1c9c-4a1e-916a-6cbb172bcf5e","source_start_index":97,"source_text":"李特睨剑阁而叹曰：“刘禅有此而不知自存。”"}],"title":"二三 险要之地不可恃"},{"excerpts":[{"context_after":"，草窃之智，乘晋乱以苟延尔。谯纵、王建、孟知祥、明玉珍蹶...","context_before":"...，而亘数百里之山崖溪谷，皆可度越，阴平一旅，亦赘疣而已。","source_end_index":174,"source_paragraph_tongjian_id":"f2952a99-42c6-42b9-9d7b-06a1f076f9d3","source_start_index":161,"source_text":"李特过剑阁而叹刘禅之不能守"}],"title":"三七 蜀汉恃险弃德而亡"}],"id":7095,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"9d3464e7-db0e-11ef-b573-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"雍容，和緩自得之貌。驕貴，以貴而自驕也。師久不決，坐自困敝爲老。言二王不任軍事。","note_content_jianti_auto":"雍容，和缓自得之貌。骄贵，以贵而自骄也。师久不决，坐自困敝为老。言二王不任军事。","note_type":"hu_note","start_index":30,"tongjian_id":"9d36c890-db0e-11ef-86f5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"趙王","official_note":"趙王是西晉的諸侯王爵位，通常授予皇室成員，擁有封地和相應的權力。在《資治通鑑》此段中，趙王與梁王被提及在關中地區，可能指擔任地方長官或軍事指揮，但原文未明確說明具體職務，僅描述其行為。","official_rank":"王爵","source_snippet":"趙王","start_index":8,"tongjian_id":"ec6ed219-db37-4948-9f29-26daf5ac8d22"},{"confidence":0.9,"official_category":"地方行政","official_name":"梁王","official_note":"梁王是西晉的諸侯王爵位，通常授予皇室成員，擁有封地和相應的權力。在《資治通鑑》此段中，梁王與趙王被提及在關中地區，可能指擔任地方長官或軍事指揮，但原文未明確說明具體職務，僅描述其行為。","official_rank":"王爵","source_snippet":"梁王","start_index":11,"tongjian_id":"14082783-00b9-426f-90b4-b95a2ee678eb"}],"ExtRef_Children_people":[{"link_birth_year":232,"link_death_year":300,"link_td_description":"张华，字茂先，范阳方城（今河北固安县）人。西晋文学家、诗人、政治家。","link_td_id":"Q10000597","link_td_number_id":104349,"people_name":"張華","people_name_jianti_auto":"张华","people_xingming":"张华","start_index":1,"tongjian_id":"9d36c892-db0e-11ef-b9ca-a0d3651f611f"},{"link_death_year":300,"link_td_description":"陈准，字道基，颍川郡许昌县（今河南省许昌市建安区）人。西晋官员。官至太尉。出身颍川陈氏，青州刺史陈佐之子，曹魏司空陈群族孙，曾祖父是陈群的叔叔陈谌。","link_td_id":"Q10003834","link_td_number_id":4779272,"people_name":"陳準","people_name_jianti_auto":"陈准","people_xingming":"陈准","start_index":4,"tongjian_id":"9d36c893-db0e-11ef-aa4f-a0d3651f611f"},{"link_death_year":301,"link_td_description":"司马伦，字子彝，晋朝宗室，司马懿第九子，母为柏夫人。司马伦是参与八王之乱的八王之一，一度自立为西晋皇帝。","link_td_id":"Q10000768","link_td_number_id":305485,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"司马伦","start_index":7,"tongjian_id":"9d36c894-db0e-11ef-a391-a0d3651f611f","wl_zhushi":"[司马伦]"},{"people_name":"梁王","people_name_jianti_auto":"梁王","people_xingming":"司马肜","start_index":10,"tongjian_id":"9d36c895-db0e-11ef-96b0-a0d3651f611f","wl_zhushi":"[司马肜]"},{"link_death_year":301,"link_td_description":"孟观，字叔时，渤海郡东光县（今河北省沧州市东光县）人。西晋将领，长期在禁中任将，并曾经获委派领兵平定氐人齐万年的叛乱。后孟观因天象支持篡位的司马伦，却失败被杀。","link_td_id":"Q10010332","link_td_number_id":1017989,"people_name":"孟觀","people_name_jianti_auto":"孟观","people_xingming":"孟观","start_index":32,"tongjian_id":"9d36c897-db0e-11ef-aaba-a0d3651f611f"},{"link_death_year":299,"link_td_description":"齐万年，西晋时期氐族首领。","link_td_id":"Q10001706","link_td_number_id":189746,"people_name":"齊萬年","people_name_jianti_auto":"齐万年","people_xingming":"齐万年","start_index":43,"tongjian_id":"9d36c898-db0e-11ef-8129-a0d3651f611f"},{"link_death_year":301,"link_td_description":"孟观，字叔时，渤海郡东光县（今河北省沧州市东光县）人。西晋将领，长期在禁中任将，并曾经获委派领兵平定氐人齐万年的叛乱。后孟观因天象支持篡位的司马伦，却失败被杀。","link_td_id":"Q10010332","link_td_number_id":1017989,"people_name":"觀","people_name_jianti_auto":"观","people_xingming":"孟观","start_index":47,"tongjian_id":"9d36c899-db0e-11ef-a573-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":133,"start_index":16,"tongjian_id":"9d36c896-db0e-11ef-825d-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"西晋末年流民起义","tongjian_id":"war_N0692"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、晋 十六国（卷三）","excerpts":[{"context_after":"江统复作《徙戎论》警朝廷，朝廷不能用[统议：徙冯翊、北地...","context_before":"...鄙，峻四夷出入之防，明先王荒服之制，此万世长策也。不听。","source_end_index":361,"source_paragraph_tongjian_id":"6809cfbf-e585-5071-8068-f3ac6e7f5c30","source_start_index":345,"source_text":"元康末，关中氐齐万年等叛，事平。"}],"path":"历代州域形势纪要/三、晋 十六国（卷三）","source_name":"读史方舆纪要"}],"class_tags":["人事","军事"],"content":"4張華、陳準以趙王、梁王，相繼在關中，皆雍容驕貴，師老無功，乃薦孟觀沈毅文武才用，使討齊萬年。觀身當矢石，大戰十數，皆破之。","content_fanyi":"张华、陈准认为，赵王、梁王先后驻守关中，都显得从容骄纵、不治军务，军队久驻疲惫而没有战功，于是推荐孟观，说他沉稳坚毅、文武兼备，派他讨伐齐万年。孟观亲身迎着箭矢飞石，大战十余次，每次都击败敌人。","content_jianti_auto":"4张华、陈准以赵王、梁王，相继在关中，皆雍容骄贵，师老无功，乃荐孟观沈毅文武才用，使讨齐万年。观身当矢石，大战十数，皆破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7096,"number":4,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9d36c88f-db0e-11ef-9d18-a0d3651f611f"}],"reign_name":"八年","reign_name_jianti_auto":"八年","start_index":8,"tongjian_id":"9d34649f-db0e-11ef-af2c-a0d3651f611f","year_anno":"（戊午、二九八）","year_int":298},"message":"success","success":true}