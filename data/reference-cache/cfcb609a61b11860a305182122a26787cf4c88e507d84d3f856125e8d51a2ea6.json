4,"tongjian_id":"8c39b1b4-db0e-11ef-8f4e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：肅侯，名語。諡法：剛德克就曰肅；執心決斷曰肅。說，與悅同。","note_content_jianti_auto":"索隐曰：肃侯，名语。谥法：刚德克就曰肃；执心决断曰肃。说，与悦同。","note_type":"hu_note","start_index":340,"tongjian_id":"8c39b1b3-db0e-11ef-9a0e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f","pinyin":"qì","source_anchor_text":"以秦權恐愒諸侯以求","source_key":"baiyang_epub","start_index":211,"text":"愒","tongjian_id":"af28d81d-0984-5074-afa9-e8e46b0e48d8"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f","pinyin":"náo","source_anchor_text":"出銳師或橈秦或救之","source_key":"baiyang_epub","start_index":291,"text":"橈","tongjian_id":"6fcbf7b7-a654-56bb-972c-d94eefe4573d"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f","pinyin":"lài","source_anchor_text":"秦尊寵賜賚之以約于","source_key":"baiyang_epub","start_index":348,"text":"賚","tongjian_id":"f94f9a26-0eaa-5b85-a79e-60cc93e8ae1e"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":246,"tongjian_id":"8c3bd45c-db0e-11ef-88ad-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/苏张说六国","excerpts":[{"context_after":"。谓燕地方二千余里，带甲数十万，车六百乘，骑六千匹；谓赵...","context_before":"...鬼谷，而其从横之辩，如冰炭水火之不同，盖所以设心者异耳。","source_end_index":50,"source_paragraph_tongjian_id":"1db2313c-c7f2-4053-bd18-4454471f59de","source_start_index":36,"source_text":"苏欲六国合从以摈秦，故言其强"}],"path":"续笔/卷二/苏张说六国","source_name":"容斋随笔"},{"display_title":"容斋随笔/史记渊妙处","excerpts":[{"context_after":"：“择交而得则民安，择交而不得则民终身不安。齐、秦为两敌...","context_before":"...必德魏爱魏重魏畏魏，韩必不敢反魏。”十余语之间五用魏字。","source_end_index":133,"source_paragraph_tongjian_id":"ff748093-973f-4703-9034-c5df6bb8c260","source_start_index":126,"source_text":"苏秦说赵肃侯曰"}],"path":"五笔/卷五/史记渊妙处","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/凡例 二十六则","excerpts":[{"context_after":"萧何入关，先收图籍。邓禹、马援，亦以此事光武成功名。儒者...","context_before":"...而下，职方、司书、司险之官，俱以地图周知险阻，辨正名物。","source_end_index":95,"source_paragraph_tongjian_id":"fd3a4a2a-0ba3-5ce2-9bd2-91de10298ef5","source_start_index":73,"source_text":"战国时，苏秦、甘茂之徒，皆据图而言天下险易。"}],"path":"叙、凡例和目次/凡例 二十六则","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"令天下之将相，会于洹水之上[洹水，一名安阳河，出河南林县...","context_before":"《战国策》：","source_end_index":132,"source_paragraph_tongjian_id":"0c55195f-f31a-5b63-8747-6b2d876695cd","source_start_index":6,"source_text":"苏秦曰：当今之时，山东之建国，莫如赵强。赵地方三千里，西有常山[常山，即恒山。见前]，南有河、漳[河，见前《禹贡》。漳，见前《职方》]，东有清河[清河，在北直广平府清河县西境，今湮]，北有燕国。为大王计，莫如一韩、魏、齐、楚、燕、赵六国从亲，以摈畔秦。"},{"context_after":"三国与秦壤界而患急，齐不与秦壤界而患缓，是以天下之势，不...","context_before":"...平、顺德府之境]，则赵、魏亦危矣。赵、魏危，非齐之利也。","source_end_index":446,"source_paragraph_tongjian_id":"1ce54d3a-f726-5dd3-9c48-497593cd268b","source_start_index":413,"source_text":"韩、魏、楚、赵，恐秦兼天下而臣其君，故专心一志以逆秦[逆，拒也]。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/六、广平府（卷十五）","excerpts":[{"context_after":"张仪说赵曰：秦告齐使兴师渡清河，军于邯郸之东。是也。汉因...","context_before":"...，又东北过广宗县，为清河。又东北入蓚县界，与张甲故渎合。","source_end_index":67,"source_paragraph_tongjian_id":"5f4d28f0-cf1b-5b5d-b4e3-119a09bb33cb","source_start_index":50,"source_text":"《战国策》苏秦说赵曰：赵东有清河。"}],"path":"北直方舆纪要/六、广平府（卷十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"，汉以关中定三河，苻秦以关中亡慕容燕，宇文周以关中亡高齐...","context_before":"...自古及今，河南之祸，中于关中者什之七，中于河北者什之九。","source_end_index":431,"source_paragraph_tongjian_id":"ae7dff9c-1cfe-5f7c-a7d6-c36731fd88aa","source_start_index":422,"source_text":"秦人以关中并韩、魏"}],"path":"河南方舆纪要/序","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"张仪曰：秦攻新城、宜阳，以临二周之郊。又说韩曰：秦下甲据...","context_before":"○宜阳城[在县东北十四里，韩城也。","source_end_index":53,"source_paragraph_tongjian_id":"c6cba627-a9d9-5dec-9de3-c71783a832ff","source_start_index":17,"source_text":"苏秦说赵曰：韩弱则效宜阳，宜阳效则上郡绝。说韩曰：韩西有宜阳、商阪之塞。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、怀庆府（卷四十九）","excerpts":[{"context_after":"苏代曰：秦下轵道、南阳而伐魏。又苏厉曰：齐反温、轵、高平...","context_before":"轵城[县南十三里。","source_end_index":25,"source_paragraph_tongjian_id":"9bed0e43-0f4c-5e03-9e47-84161658ad03","source_start_index":9,"source_text":"苏秦说赵曰：秦下轵道，则南阳动。"}],"path":"河南方舆纪要/三、怀庆府（卷四十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、彰德府（卷四十九）","excerpts":[{"context_after":"曹操攻邺，进军至洹水。又尔朱兆等攻高欢于邺，夹洹水而军。...","context_before":"...内黄县界永和镇而入卫水。《左传》叔孙声伯梦涉洹水，是也。","source_end_index":97,"source_paragraph_tongjian_id":"cf4dece8-8550-55f9-8d87-fe80eb9c3731","source_start_index":77,"source_text":"苏秦说赵肃侯：令天下将相，会于洹水之上。"}],"path":"河南方舆纪要/五、彰德府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"文公從之，資蘇秦車馬，以說趙肅侯曰：「當今之時，山東之建國莫強於趙，秦之所害亦莫如趙。然而秦不敢舉兵伐趙者，畏韓、魏之議其後也。秦之攻韓、魏也，無有名山大川之限，稍蠶食之，傅國都而止。韓、魏不能支秦，必入臣於秦；秦無韓、魏之規則禍中於趙矣。臣以天下地圖案之，諸侯之地五倍於秦，料度諸侯之卒十倍於秦。六國爲一，幷力西鄕而攻秦，秦必破矣。夫衡人者皆欲割諸侯之地以與秦，秦成則其身富榮，國被秦患而不與其憂，是以衡人日夜務以秦權恐愒諸侯，以求割地。故願大王熟計之也！竊爲大王計，莫如一韓、魏、齊、楚、燕、趙爲從親以畔秦，令天下之將相會於洹水之上，通質結盟，約曰：『秦攻一國，五國各出銳師，或橈秦，或救之。有不如約者，五國共伐之！』諸侯從親以擯秦，秦甲必不敢出於函谷以害山東矣。」肅侯大說，厚待蘇秦，尊寵賜賚之，以約於諸侯。","content_fanyi":"燕文公听从了苏秦的建议，给他车马，让他去游说赵肃侯说：\"当今之时，华山以东的山东各国没有哪个比赵国强大，秦国所忌惮的也没有哪个国家比得上赵国。然而秦国不敢发兵攻打赵国，是畏惧韩、魏在背后算计它。秦国攻打韩、魏两国，没有名山大川的阻隔，逐渐蚕食它们的土地，直到逼近两国都城为止。韩、魏抵挡不住秦国，一定向秦国称臣；秦国没有了韩、魏在背后的牵制，祸患就会降临到赵国头上。我根据天下地图来考察，诸侯的土地是秦国的五倍，估计诸侯的兵力是秦国的十倍。六国联合为一，合力向西攻打秦国，秦国必定会被攻破。那些主张连横的人，都想割取诸侯的土地献给秦国；秦国一旦成功，他们自身便得到富贵荣耀，国家遭受秦国的祸患，他们却不为国家分担忧患，因此他们日夜竭力用秦国的权势来恐吓诸侯，以逼迫诸侯割让土地。所以希望大王仔细考虑这件事！我私下为大王谋划，不如联合韩、魏、齐、楚、燕、赵六国合纵抗秦，让各国将相在洹水岸边相会，互派人质，缔结盟约，约定说：'如果秦国攻打其中一国，其他五国各自派出精锐军队，有的袭扰牵制秦军，有的前往救援该国。有不履行盟约的，五国共同讨伐它！'诸侯合纵相亲、共同排斥秦国，秦军必定不敢出函谷关来侵害山东各国了。\"赵肃侯听后非常高兴，厚待苏秦，尊敬宠信并赐给他财物，让他去与诸侯缔结合纵盟约。","content_jianti_auto":"文公从之，资苏秦车马，以说赵肃侯曰：「当今之时，山东之建国莫强于赵，秦之所害亦莫如赵。然而秦不敢举兵伐赵者，畏韩、魏之议其后也。秦之攻韩、魏也，无有名山大川之限，稍蚕食之，傅国都而止。韩、魏不能支秦，必入臣于秦；秦无韩、魏之规则祸中于赵矣。臣以天下地图案之，诸侯之地五倍于秦，料度诸侯之卒十倍于秦。六国为一，幷力西鄕而攻秦，秦必破矣。夫衡人者皆欲割诸侯之地以与秦，秦成则其身富荣，国被秦患而不与其忧，是以衡人日夜务以秦权恐愒诸侯，以求割地。故愿大王熟计之也！窃为大王计，莫如一韩、魏、齐、楚、燕、赵为从亲以畔秦，令天下之将相会于洹水之上，通质结盟，约曰：『秦攻一国，五国各出锐师，或桡秦，或救之。有不如约者，五国共伐之！』诸侯从亲以摈秦，秦甲必不敢出于函谷以害山东矣。」肃侯大说，厚待苏秦，尊宠赐赉之，以约于诸侯。","dtjl_paragraph_links":[],"dtjl_references":[],"id":186,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f","year_int":-333},"tongjian_id":"8c39b171-db0e-11ef-b42d-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"燕","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","place_note":"府蓟城，北京","resolved_place_entity_id":69,"start_index":35,"tongjian_id":"8c407ae2-db0e-11ef-af69-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1秦惠王使犀首欺齊、魏，與共伐趙，以敗從約，趙肅侯讓蘇秦，蘇秦恐，請使燕，必報齊。蘇秦去趙而從約皆解。趙人決河水以灌齊、魏之師，齊、魏之師乃去。","content_fanyi":"秦惠王派犀首去欺骗齐国、魏国，使它们与秦国联合起来出兵攻打赵国，想借此破坏合纵盟约，赵肃侯责备苏秦，苏秦心中害怕，请求出使燕国，一定要报复齐国。苏秦离开赵国后，合纵盟约随即完全瓦解。赵国人挖开黄河堤防，放河水淹灌齐、魏两国的军队，齐、魏两国的军队于是撤退。","content_jianti_auto":"1秦惠王使犀首欺齐、魏，与共伐赵，以败从约，赵肃侯让苏秦，苏秦恐，请使燕，必报齐。苏秦去赵而从约皆解。赵人决河水以灌齐、魏之师，齐、魏之师乃去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":197,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十七年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c407ad7-db0e-11ef-bc5a-a0d3651f611f","year_int":-332},"tongjian_id":"8c407ad7-db0e-11ef-bc5a-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"燕","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":4,"tongjian_id":"8c42d02e-db0e-11ef-b7d8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3齊王伐燕，取十城；已而復歸之。","content_fanyi":"齐宣王出兵攻打燕国，夺取十座城邑；不久又归还给燕国。","content_jianti_auto":"3齐王伐燕，取十城；已而复归之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":199,"number":3,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十七年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c42d02c-db0e-11ef-abc7-a0d3651f611f","year_int":-332},"tongjian_id":"8c42d02c-db0e-11ef-abc7-a0d3651f611f"},"paragraph_order":8},{"mention_count":5,"paragraph_brief":{"brief_for":"燕","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕，因肩翻。易，音如字。說，式芮翻。諡法：好更改舊曰易。註：變故改常。","note_content_jianti_auto":"燕，因肩翻。易，音如字。说，式芮翻。谥法：好更改旧曰易。注：变故改常。","note_type":"hu_note","start_index":50,"tongjian_id":"8c451ae7-db0e-11ef-be53-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":16,"source_start_index":6,"source_text":"爲後齊大夫殺蘇秦張本","target_paragraph_tongjian_id":"8c5c61d7-db0e-11ef-849f-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":12,"tongjian_id":"8c451aeb-db0e-11ef-b1c5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":8,"tongjian_id":"8c451aec-db0e-11ef-aa78-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。爲後齊大夫殺蘇秦張本。","note_content_jianti_auto":"说，式芮翻。为后齐大夫杀苏秦张本。","note_type":"hu_note","start_index":94,"tongjian_id":"8c451aea-db0e-11ef-9534-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":30,"tongjian_id":"8c451af3-db0e-11ef-ab24-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":34,"tongjian_id":"8c451af4-db0e-11ef-adf8-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":41,"tongjian_id":"8c451af6-db0e-11ef-9da2-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":55,"tongjian_id":"8c451afa-db0e-11ef-a08a-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":92,"tongjian_id":"8c451afd-db0e-11ef-b5d8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2蘇秦通於燕文公之夫人，易王知之。蘇秦恐，乃說易王曰：「臣居燕不能使燕重，而在齊則燕重。」易王許之。乃僞得罪於燕而奔齊，齊宣王以爲客卿。蘇秦說齊王高宮室，大苑囿，以明得意，欲以敝齊而爲燕。","content_fanyi":"苏秦与燕文公的夫人私通，燕易王得知了此事。苏秦很害怕，便对燕易王说：“我留在燕国不能使燕国增加威望，如果到了齐国，就能使燕国增加威望。”燕易王答应了他的请求。于是苏秦假装在燕国犯下罪过，逃到齐国，齐宣王任用他为客卿。苏秦劝齐王修建高大的宫室，扩大苑囿园池，借以显示自己的得意与地位，想使齐国国力衰敝，为燕国谋利益。","content_jianti_auto":"2苏秦通于燕文公之夫人，易王知之。苏秦恐，乃说易王曰：「臣居燕不能使燕重，而在齐则燕重。」易王许之。乃伪得罪于燕而奔齐，齐宣王以为客卿。苏秦说齐王高宫室，大苑囿，以明得意，欲以敝齐而为燕。","dtjl_paragraph_links":[],"dtjl_references":[],"id":211,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c451ae6-db0e-11ef-b0c4-a0d3651f611f","year_int":-324},"tongjian_id":"8c451ae6-db0e-11ef-b0c4-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"燕","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙武靈王","people_name_jianti_auto":"赵武灵王","start_index":0,"tongjian_id":"8c451b24-db0e-11ef-9989-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"趙武靈王之不肯稱王，非守君臣之分，居之以謙也，將求其所大欲而力未能稱心也。處，昌呂翻。令，力丁翻，使也；又力正翻，命令也。分，扶問翻。稱，尺證翻。","note_content_jianti_auto":"赵武灵王之不肯称王，非守君臣之分，居之以谦也，将求其所大欲而力未能称心也。处，昌吕翻。令，力丁翻，使也；又力正翻，命令也。分，扶问翻。称，尺证翻。","note_type":"hu_note","start_index":38,"tongjian_id":"8c451b23-db0e-11ef-a5cb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","place_note":"府蓟城，北京","resolved_place_entity_id":69,"start_index":3,"tongjian_id":"8c451b27-db0e-11ef-a5e8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2韓、燕皆稱王。趙武靈王獨不肯，曰：「無其實，敢處其名乎？」令國人謂己曰君。","content_fanyi":"韩国、燕国都称王了。只有赵武灵王不愿意称王，他说：“没有称王的实力，怎敢接受王的名号呢？”命令国内的人称自己为君。","content_jianti_auto":"2韩、燕皆称王。赵武灵王独不肯，曰：「无其实，敢处其名乎？」令国人谓己曰君。","dtjl_paragraph_links":[],"dtjl_references":[],"id":213,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十六年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c451b22-db0e-11ef-89fe-a0d3651f611f","year_int":-323},"tongjian_id":"8c451b22-db0e-11ef-89fe-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":65,"total_paragraphs":647},"place_name":"燕","resolved_profile":{"entity_id":69,"entry_list_str":"燕,燕國","intro":"战国七雄之一，姬姓诸侯国，都蓟（今北京），公元前222年为秦所灭。","lat_max":43.0,"lat_min":39.0,"lon_max":123.0,"lon_min":115.0,"modern_location":"今北京市及河北北部、辽宁西部一带","seat":"蓟","show_map":true,"standard_name":"燕国","type_code":"polity"}},"message":"success","success":true}