t_index":24,"tongjian_id":"8f4038ab-db0e-11ef-b6fd-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":26,"tongjian_id":"8f4038ac-db0e-11ef-9f8c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：此論語載孔子之辭也。言今此時之人，亦夏、殷、周之所馭，以政化淳壹，故能直道而行。傷今不然。","note_content_jianti_auto":"师古曰：此论语载孔子之辞也。言今此时之人，亦夏、殷、周之所驭，以政化淳壹，故能直道而行。伤今不然。","note_type":"hu_note","start_index":26,"tongjian_id":"8f4038a7-db0e-11ef-93e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f4038af-db0e-11ef-b2f0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：不可勝。","note_content_jianti_auto":"师古曰：不可胜。","note_type":"hu_note","start_index":46,"tongjian_id":"8f4038ae-db0e-11ef-8a36-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f4038b1-db0e-11ef-b20e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：黎，衆也。醇，不澆雜。","note_content_jianti_auto":"师古曰：黎，众也。醇，不浇杂。","note_type":"hu_note","start_index":94,"tongjian_id":"8f4038b0-db0e-11ef-88d9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":32,"link_death_year":92,"link_td_description":"班固，字孟坚，扶风安陵（今陕西咸阳）人，东汉历史学家，《汉书》作者。","link_td_id":"Q10004773","link_td_number_id":12023,"people_name":"班固","people_name_jianti_auto":"班固","people_xingming":"班固","start_index":0,"tongjian_id":"8f4038b2-db0e-11ef-83aa-a0d3651f611f"},{"link_birth_year":-551,"link_death_year":-479,"link_td_description":"孔丘，春秋末期鲁国的教育家与哲学家，儒家创始人兼主要代表人物。","link_td_id":"Q10000008","link_td_number_id":484,"people_name":"孔子","people_name_jianti_auto":"孔子","people_xingming":"孔子","start_index":5,"tongjian_id":"8f4038b3-db0e-11ef-afc4-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"孝文","people_name_jianti_auto":"孝文","people_xingming":"刘恒","start_index":61,"tongjian_id":"8f4038b7-db0e-11ef-a581-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-188,"link_death_year":-141,"link_td_description":"汉景帝刘启，为汉朝皇帝（前157年7月14日－前141年3月9日在位），在位16年，享年48岁，其正式谥号为「孝景皇帝」，后世省略「孝」字称「汉景帝」。为汉文帝刘恒长子，母窦皇后。他在位期间，主要是削诸侯封地，平定七国之乱，巩固中央集权，勤俭治国，发展生产，他和其父亲文帝的统治时期合称文景之治，为中国自大一统以来的首个太平盛世。","link_td_id":"Q10000365","link_td_number_id":90408,"people_name":"孝景","people_name_jianti_auto":"孝景","people_xingming":"刘启","start_index":70,"tongjian_id":"8f4038b8-db0e-11ef-b18a-a0d3651f611f","wl_zhushi":"[刘启]"},{"link_birth_year":-1055,"link_death_year":-1020,"link_td_description":"周成王，姬姓，名誦，西周第二代天子，周武王之子。","link_td_id":"Q10000237","link_td_number_id":138310,"people_name":"成","people_name_jianti_auto":"成","people_xingming":"姬诵","start_index":96,"tongjian_id":"8f4038ba-db0e-11ef-b013-a0d3651f611f","wl_zhushi":"[姬诵]"},{"link_birth_year":-1040,"link_death_year":-996,"link_td_description":"周康王，姬姓，名钊，西周第三代天子，周成王之子。","link_td_id":"Q10000236","link_td_number_id":138316,"people_name":"康","people_name_jianti_auto":"康","people_xingming":"姬钊","start_index":98,"tongjian_id":"8f4038bb-db0e-11ef-ba6b-a0d3651f611f","wl_zhushi":"[姬钊]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"文","people_name_jianti_auto":"文","people_xingming":"刘恒","start_index":102,"tongjian_id":"8f4038bc-db0e-11ef-abe1-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-188,"link_death_year":-141,"link_td_description":"汉景帝刘启，为汉朝皇帝（前157年7月14日－前141年3月9日在位），在位16年，享年48岁，其正式谥号为「孝景皇帝」，后世省略「孝」字称「汉景帝」。为汉文帝刘恒长子，母窦皇后。他在位期间，主要是削诸侯封地，平定七国之乱，巩固中央集权，勤俭治国，发展生产，他和其父亲文帝的统治时期合称文景之治，为中国自大一统以来的首个太平盛世。","link_td_id":"Q10000365","link_td_number_id":90408,"people_name":"景","people_name_jianti_auto":"景","people_xingming":"刘启","start_index":104,"tongjian_id":"8f4038bd-db0e-11ef-b1e8-a0d3651f611f","wl_zhushi":"[刘启]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","resolved_place_entity_id":878,"start_index":14,"tongjian_id":"8f4038b4-db0e-11ef-956b-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","resolved_place_entity_id":79,"start_index":29,"tongjian_id":"8f4038b5-db0e-11ef-a841-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":19,"start_index":31,"tongjian_id":"8f4038b6-db0e-11ef-8f0a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":46,"tongjian_id":"8f4038b9-db0e-11ef-a319-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","resolved_place_entity_id":79,"start_index":94,"tongjian_id":"8f4038be-db0e-11ef-91be-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":100,"tongjian_id":"8f4038bf-db0e-11ef-b643-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"班固贊曰：孔子稱：「斯民也，三代之所以直道而行也。」信哉！周、秦之敝，罔密文峻，而姦軌不勝。漢興，掃除煩苛，與民休息；至于孝文，加之以恭儉；孝景遵業。五六十載之間，至於移風易俗，黎民醇厚。周云成、康，漢言文、景，美矣！","content_fanyi":"班固评论说：孔子曾说：“现在的百姓，正是三代圣王能够依靠他们而推行正道、实现大治的百姓。”这话确实可信！周、秦两代的弊病，在于法网严密、政令苛刻，但奸邪盗寇仍然防不胜防。汉朝兴起后，废除了繁琐苛刻的法令，让百姓休养生息；到了汉孝文帝，又加上恭谨节俭的作风；汉孝景帝遵守大业成规而不改。五六十年之间，便达到了移风易俗，百姓淳朴厚道。谈到天下大治的时代，周代要数成王、康王，汉代要数文帝、景帝，真是美好啊！","content_jianti_auto":"班固赞曰：孔子称：「斯民也，三代之所以直道而行也。」信哉！周、秦之敝，罔密文峻，而奸轨不胜。汉兴，扫除烦苛，与民休息；至于孝文，加之以恭俭；孝景遵业。五六十载之间，至于移风易俗，黎民醇厚。周云成、康，汉言文、景，美矣！","dtjl_paragraph_links":[],"dtjl_references":[],"id":1355,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"8f4038a6-db0e-11ef-b189-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"四馬一色，謂之鈞駟。","note_content_jianti_auto":"四马一色，谓之钧驷。","note_type":"hu_note","start_index":25,"tongjian_id":"8f4038c1-db0e-11ef-8e0d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f4038c3-db0e-11ef-96ee-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":12,"tongjian_id":"8f4038c4-db0e-11ef-945f-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":20,"tongjian_id":"8f4038c5-db0e-11ef-a7a2-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":22,"tongjian_id":"8f4038c6-db0e-11ef-885d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：以牛駕車也。余據漢時以牛車爲賤，魏、晉以後，王公始多乘牛車。","note_content_jianti_auto":"师古曰：以牛驾车也。余据汉时以牛车为贱，魏、晋以后，王公始多乘牛车。","note_type":"hu_note","start_index":33,"tongjian_id":"8f4038c2-db0e-11ef-ab90-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇林","people_name_jianti_auto":"苏林","start_i