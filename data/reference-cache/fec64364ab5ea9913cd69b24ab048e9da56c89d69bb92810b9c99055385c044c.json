":[],"ExtRef_Children_people":[{"link_death_year":366,"link_td_description":"庾道怜，晋废帝司马奕的皇后，颍川郡鄢陵县人，父即晋成帝时辅政大臣庾冰，伯父庾亮，姑母明帝皇后庾文君。","link_td_id":"Q10009744","link_td_number_id":816316,"people_name":"庾氏","people_name_jianti_auto":"庾氏","people_xingming":"庾道怜","start_index":11,"tongjian_id":"a2546927-db0e-11ef-9026-a0d3651f611f","wl_zhushi":"[庾道怜]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3夏，五月，戊寅，皇后庾氏崩。","content_fanyi":"夏季五月戊寅日，东晋皇后庾氏去世。","content_jianti_auto":"3夏，五月，戊寅，皇后庾氏崩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8892,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"a2546926-db0e-11ef-85f7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大司馬","official_note":"大司馬是古代高級軍事長官，掌管全國軍事，在晉朝常為權臣擔任，如桓溫。此處指桓溫，負責處理司馬勳叛亂的後續事宜。","official_rank":"正一品","source_snippet":"送大司馬溫","start_index":22,"tongjian_id":"bc5fe615-dbae-4cdd-ad7a-f8b48c7ffbbf"}],"ExtRef_Children_people":[{"link_death_year":393,"link_td_description":"朱序，字次伦，义阳郡平氏县（今河南省桐柏县西北）人，东晋重要将领，参加过多场战事并屡建功勋，虽然曾被俘并仕于前秦，但在淝水之战时却协助东晋战胜前秦，及后亦继续在前线为东晋抵抗北方外族政权的侵袭。","link_td_id":"Q10011847","link_td_number_id":1382246,"people_name":"朱序","people_name_jianti_auto":"朱序","people_xingming":"朱序","start_index":1,"tongjian_id":"a254c350-db0e-11ef-a919-a0d3651f611f"},{"people_name":"周楚","people_name_jianti_auto":"周楚","people_xingming":"周楚","start_index":4,"tongjian_id":"a254c351-db0e-11ef-a8f4-a0d3651f611f"},{"link_death_year":366,"link_td_description":"司马勋，字伟长，河内温县人。晋朝宗室，司马懿弟弟司马恂玄孙。东晋梁州刺史，后起兵叛乱失败，被杀。","link_td_id":"Q10003316","link_td_number_id":1594568,"people_name":"司馬勳","people_name_jianti_auto":"司马勋","people_xingming":"司马勋","start_index":7,"tongjian_id":"