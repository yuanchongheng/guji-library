_note":"揚武將軍是秦國的軍事官職，可能負責激勵士氣或特殊任務，此處姚萇擔任此職，參與進攻荊州。","official_rank":"未知","source_snippet":"揚武將軍姚萇","start_index":14,"tongjian_id":"20221a95-0dce-4471-9314-c2be2fc11929"},{"confidence":0.95,"official_category":"地方行政","official_name":"荊州刺史","official_note":"荊州刺史是晉朝的地方行政官職，負責荊州的治理和防務，此處桓豁擔任此職，率軍救援南鄕郡。","official_rank":"未知","source_snippet":"荊州刺史桓豁","start_index":32,"tongjian_id":"b6dec6b2-8f25-40d4-85ea-c47da63d9c5d"}],"ExtRef_Children_people":[{"link_birth_year":325,"link_death_year":375,"link_td_description":"王猛，字景略，北海郡剧县（今山东潍坊市昌乐县西）人，后移家魏郡。十六国时期重要政治家、军事家，于前秦官至丞相，爵封清河武侯。对前秦富国强兵，统一北方有重要影响。其辅佐前秦朝政长达18年有余，对内整饬法纪、选拔贤才、富国兴邦、兴建水利、打压世族以中央集权，对外首先平定前秦五公之乱，而后统兵先平定西陲诸部，攻灭东面强敌前燕，一役而获157郡，246万户，990万人的广阔领土，故宋书称其为“王猛之相苻坚也，北人以方之诸葛亮”。","link_td_id":"Q10008301","link_td_number_id":198616,"people_name":"王猛","people_name_jianti_auto":"王猛","people_xingming":"王猛","start_index":6,"tongjian_id":"a254c373-db0e-11ef-a5e3-a0d3651f611f"},{"link_td_description":"杨安，略阳清水（今甘肃省清水县）氐族人，为前秦名将及前仇池国王子。","link_td_id":"Q10007534","link_td_number_id":7409104,"people_name":"楊安","people_name_jianti_auto":"杨安","people_xingming":"杨安","start_index":12,"tongjian_id":"a254c374-db0e-11ef-aaf9-a0d3651f611f"},{"link_birth_year":330,"link_death_year":394,"link_td_description":"姚苌，字景茂，南安郡赤亭（今甘肃省陇西县西）人，十六国时期后秦政权的开国君主。","link_td_id":"Q10000812","link_td_number_id":203782,"people_name":"姚萇","people_name_jianti_auto":"姚苌","people_xingming":"姚苌","start_index":19,"tongjian_id":"a254c375-db0e-11ef-bac9-a0d3651f611f"},{"link_birth_year":320,"link_death_year":377,"link_td_description":"桓豁，字朗子，谯国龙亢（今安徽怀远）人。晋朝重要将领，桓彝之子，大司马桓温之弟。桓豁于桓温内镇姑孰后接替他任荆州刺史，任内努力助东晋抵抗前秦，在前秦多场对荆州、蜀地或前凉的战事中都有出兵抵抗或支援。","link_td_id":"Q10012345","link_td_number_id":1464852,"people_name":"桓豁","people_name_jianti_auto":"桓豁","people_xingming":"桓豁","start_index":39,"tongjian_id":"a254c379-db0e-11ef-91b8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":20,"start_index":1,"