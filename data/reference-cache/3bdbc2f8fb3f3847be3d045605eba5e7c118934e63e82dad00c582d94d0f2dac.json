tart_index":44,"tongjian_id":"9b606f7e-db0e-11ef-961f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"繁縣","place_name_jianti_auto":"繁县","start_index":6,"tongjian_id":"9b606f7f-db0e-11ef-b294-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":35,"tongjian_id":"9b606f80-db0e-11ef-aeec-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":42,"tongjian_id":"9b606f81-db0e-11ef-9ba9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蜀志曰：居于繁縣。據姜維傳，則白虎文與治無戴二人也。又魏志，曹眞討破叛胡治元多，蓋諸胡有治姓也。","note_content_jianti_auto":"蜀志曰：居于繁县。据姜维传，则白虎文与治无戴二人也。又魏志，曹真讨破叛胡治元多，盖诸胡有治姓也。","note_type":"hu_note","start_index":67,"tongjian_id":"9b606f79-db0e-11ef-bd84-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"雍州刺史","official_note":"雍州刺史是魏国在雍州地区的最高行政长官，负责地方治理和军事防御，此处郭淮作为雍州刺史参与对蜀汉姜维的作战。","official_rank":"未知","source_snippet":"雍州刺史郭淮","start_index":28,"tongjian_id":"403e1bcd-d993-49b7-ac58-f3d40c13faca"},{"confidence":0.9,"official_category":"军事指挥","official_name":"討蜀護軍","official_note":"討蜀護軍是魏国针对蜀汉设立的军事官职，负责指挥对蜀作战，此处夏侯霸担任此职与郭淮共同抵御姜维的进攻。","official_rank":"未知","source_snippet":"討蜀護軍夏侯霸","start_index":33,"tongjian_id":"ced4c8ca-308f-46d4-9d5b-8c38a9acbba8"}],"ExtRef_Children_people":[{"link_birth_year":202,"link_death_year":264,"link_td_description":"姜维，字伯约，凉州天水郡冀县（今甘肃省天水市甘谷县）人。三国时期蜀汉著名军事家。","link_td_id":"Q10000081","link_td_number_id":6121,"people_name":"姜維","people_name_jianti_auto":"姜维","people_xingming":"姜维","start_index":14,"tongjian_id":"9b606f8a-db0e-11ef-83d3-a0d3651f611f"},{"link_death_year":255,"link_td_description":"郭淮，字伯济，太原郡阳曲县（今山西省太原市）人，三国时代曹魏重要将领，曾经多次与陈泰一起抵抗蜀汉姜维的进攻。255年去世，死后魏少帝曹髦追封他为大将军，谥曰贞侯。","link_td_id":"Q10004273","link_td_number_id":621442,"people_name":"郭淮","people_name_jianti_auto":"郭淮","people_xingming":"郭淮","start_index":30,"tongjian_id":"9b606f8b-db0e-11ef-9caf-a0d3651f611f"},{"link_death_year":259,"link_td