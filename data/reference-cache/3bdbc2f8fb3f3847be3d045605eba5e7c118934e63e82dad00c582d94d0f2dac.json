d":"9b606f46-db0e-11ef-ba77-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"尚書","official_note":"尚書是中央行政机构的重要官职，掌管文书和政令，此处何晏以尚書身份上言建议皇帝从大臣游宴，体现了其参与朝政的职能。","official_rank":"正三品","source_snippet":"尚書何晏上言","start_index":28,"tongjian_id":"652b26f0-2e0a-4fb3-b3b0-c2c9be9e7be3"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"散騎常侍","official_note":"散騎常侍是皇帝身边的侍从官，负责顾问和谏议，此处孔乂以散騎常侍身份上言劝谏皇帝行为，反映了其监察和进谏的职责。","official_rank":"正三品","source_snippet":"散騎常侍、諫議大夫孔乂上言","start_index":78,"tongjian_id":"8f71643c-42fa-4f35-b649-f6bedc14dc6b"},{"confidence":0.9,"official_category":"监察","official_name":"諫議大夫","official_note":"諫議大夫是专门负责向皇帝进谏的官职，此处孔乂兼任此职上言，强调其劝谏皇帝以保天下太平的作用。","official_rank":"正五品","source_snippet":"散騎常侍、諫議大夫孔乂上言","start_index":78,"tongjian_id":"e715434b-7d5c-431e-8334-60c613ac0223"}],"ExtRef_Children_people":[{"link_birth_year":196,"link_death_year":249,"link_td_description":"何晏，字平叔，南阳宛（今河南南阳）人，东汉末年大将军何进孙，曹操的婿養子，三国时期玄学家，魏晋玄学贵无派创始人，与王弼并称“王何”，玄学代表人物之一，在高平陵之变与曹爽等同被司马氏诛杀，卒于正始十年（249年）。何晏以俊美著稱，有“何郎粉”、“傅粉何郎”之语，代指美男子。","link_td_id":"Q10005760","link_td_number_id":98676,"people_name":"何晏","people_name_jianti_auto":"何晏","people_xingming":"何晏","start_index":20,"tongjian_id":"9b606f4a-db0e-11ef-b0cd-a0d3651f611f"},{"link_td_description":"孔乂，字元儁，鲁国（治今山东省曲阜）人，三国时曹魏官员。","link_td_id":"Q10019626","link_td_number_id":5964530,"people_name":"孔乂","people_name_jianti_auto":"孔乂","people_xingming":"孔乂","start_index":76,"tongjian_id":"9b606f4c-db0e-11ef-9331-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9b606f40-db0e-11ef-bb34-a0d3651f611f","pinyin":"xiè","source_anchor_text":"騭卒帝好褻近群小遊","source_key":"baiyang_epub","start_index":3,"text":"褻","tongjian_id":"d978b651-b353-5807-9b43-21dd084b2aa5"}],"ExtRef_Children_places":[{"place_name":"式乾殿","place_name_jianti_auto":"式干殿","resolved_place_entity_id":2628,"start_index":30,"tongjian_id":"9b606f4b-db0e-11ef-b825-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6帝好褻近羣小，遊宴後園。秋，七月，尚書何晏上言：「自今御幸式乾殿及遊豫後園，宜皆從大臣，詢謀政事，講論經義，爲萬世法。」冬，十二月，散騎常侍、諫議大夫孔乂上言：「今天下已平，陛下可絕後園習騎乘馬，出必御輦乘車，天下之福，臣子之願也。」帝皆不聽。","content_fanyi":"魏帝曹芳喜好亲近宠信一帮小人，在后园游乐宴饮。秋季，七月，尚书何晏上疏说：“从今以后，陛下前往式乾殿及到后园游乐时，都应让大臣随从，询问商议政事，讲论经书义理，作为万世效法的准则。”冬季，十二月，散骑常侍、谏议大夫孔乂又上疏说：“如今天下已经太平，陛下可以不再到后园练习骑马，外出一定要乘坐辇车，这是天下人的福分，也是臣子的心愿。”魏帝都没有听从他们的意见。","content_jianti_auto":"6帝好亵近群小，游宴后园。秋，七月，尚书何晏上言：「自今御幸式干殿及游豫后园，宜皆从大臣，询谋政事，讲论经义，为万世法。」冬，十二月，散骑常侍、谏议大夫孔乂上言：「今天下已平，陛下可绝后园习骑乘马，出必御辇乘车，天下之福，臣子之愿也。」帝皆不听。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6372,"number":6,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"9b606f40-db0e-11ef-bb34-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"安豐縣","place_name_jianti_auto":"安丰县","start_index":0,"tongjian_id":"9b606f4f-db0e-11ef-915c-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"9b606f50-db0e-11ef-aca1-a0d3651f611f"},{"place_name":"六安國","place_name_jianti_auto":"六安国","start_index":6,"tongjian_id":"9b606f51-db0e-11ef-a1c3-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":10,"tongjian_id":"9b606f52-db0e-11ef-af21-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":13,"tongjian_id":"9b606f53-db0e-11ef-9b1a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":17,"tongjian_id":"9b606f54-db0e-11ef-9831-a0d3651f611f"},{"place_name":"安豐郡","place_name_jianti_auto":"安丰郡","start_index":20,"tongjian_id":"9b606f55-db0e-11ef-bbf4-a0d3651f611f"},{"place_name":"豫州","place_name_jianti_auto":"豫州","start_index":25,"tongjian_id":"9b606f56-db0e-11ef-861b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"安豐縣，漢屬六安國，後漢屬廬江郡，魏分置安豐郡，屬豫州。策之者，計之也。","note_content_jianti_auto":"安丰县，汉属六安国，后汉属庐江郡，魏分置安丰郡，属豫州。策之者，计之也。","note_type":"hu_note","start_index":33,"tongjian_id":"9b606f4e-db0e-11ef-b5b1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"揚州刺史","official_note":"揚州刺史是三国时期魏国的地方行政长官，负责扬州地区的治理和军事事务。在上下文中，诸葛诞作为扬州刺史，负责应对吴国的军事动向，体现了其地方行政和军事指挥的职能。","official_rank":"未知","source_snippet":"揚州刺史諸葛誕使安豐太守王基策之","start_index":18,"tongjian_id":"9c6ac04f-a47e-4139-a56c-e34b83bc66a3"},{"confidence":0.95,"official_category":"地方行政","official_name":"安豐太守","official_note":"安豐太守是三国时期魏国的地方行政官员，负责安豐郡的治理。在上下文中，王基作为安豐太守，被诸葛诞派遣去分析吴国的军事意图，显示了其在地方行政和军事咨询中的作用。","official_rank":"未知","source_snippet":"揚州刺史諸葛誕使安豐太守王基策之","start_index":24,"tongjian_id":"961b1ee9-1ed6-4cec-941c-606775529b62"}],"ExtRef_Children_people":[{"link_death_year":258,"link_td_description":"诸葛诞，琅邪郡阳都县（今山东省临沂市沂南县）人，三国时曹魏后期的重要将领，官至征东大将军，诸葛丰之后，诸葛亮和诸葛瑾的族弟，是青龙年间中原名士“四聪八达三豫”中“四聪”之一，与夏侯玄、邓飏等人并列；后于寿春发动叛乱，兵败被杀。","link_td_id":"Q10001364","link_td_number_id":511411,"people_name":"諸葛誕","people_name_jianti_auto":"诸葛诞","people_xingming":"诸葛诞","start_index":20,"tongjian_id":"9b606f5a-db0e-11ef-ae3b-a0d3651f611f"},{"link_birth_year":190,"link_death_year":261,"link_td_description":"王基，字伯舆，东莱曲城人。三国时曹魏重要将领，曾长期镇守与东吴接壤的州郡，且平定毌丘俭之乱和诸葛诞之乱。","link_td_id":"Q10010098","link_td_number_id":952615,"people_name":"王基","people_name_jianti_auto":"王基","people_xingming":"王基","start_index":28,"tongjian_id":"9b606f5b-db0e-11ef-9cbc-a0d3651f611f"},{"link_birth_year":190,"link_death_year":261,"link_td_description":"王基，字伯舆，东莱曲城人。三国时曹魏重要将领，曾长期镇守与东吴接壤的州郡，且平定毌丘俭之乱和诸葛诞之乱。","link_td_id":"Q10010098","link_td_number_id":952615,"people_name":"基","people_name_jianti_auto":"基","people_xingming":"王基","start_index":33,"tongjian_id":"9b606f60-db0e-11ef-9678-a0d3651f611f"},{"link_birth_year":183,"link_death_year":245,"link_td_description":"陆逊，本名陆议，字伯言，吴郡吴县（今江苏省苏州市）人，三国时代吴国军事家、政治家，负责统领吴国军事和政治多年，并同时掌管民事，辅佐太子等。历任吴国大都督、上大将军、丞相。63岁去世，孙休时追谥昭侯。","link_td_id":"Q10001155","link_td_number_id":87746,"people_name":"陸遜","people_name_jianti_auto":"陆逊","people_xingming":"陆逊","start_index":38,"tongjian_id":"9b606f61-db0e-11ef-a588-a0d3651f611f"},{"link_birth_year":182,"link_death_year":252,"link_td_description":"东汉末至三国时期孙吴政治家、战略家，同时是孙吴开国皇帝，六朝开拓者之首。","link_td_id":"Q10000076","link_td_number_id":16462,"people_name":"孫權","people_name_jianti_auto":"孙权","people_xingming":"孙权","start_index":44,"tongjian_id":"9b606f62-db0e-11ef-991e-a0d3651f611f"},{"link_birth_year":182,"link_death_year":252,"link_td_description":"东汉末至三国时期孙吴政治家、战略家，同时是孙吴开国皇帝，六朝开拓者之首。","link_td_id":"Q10000076","link_td_number_id":16462,"people_name":"權","people_name_jianti_auto":"权","people_xingming":"孙权","start_index":59,"tongjian_id":"9b606f63-db0e-11ef-b75d-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9b606f4d-db0e-11ef-bbe2-a0d3651f611f","pinyin":"jū","source_anchor_text":"釁卒起癰疽發潰遣將","source_key":"baiyang_epub","start_index":70,"text":"疽","tongjian_id":"714ec6c0-dab7-59dc-b72e-3a377486322f"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","resolved_place_entity_id":33,"start_index":1,"tongjian_id":"9b606f5c-db0e-11ef-bd14-a0d3651f611f"},{"place_name":"建業","place_name_jianti_auto":"建业","resolved_place_entity_id":792,"start_index":7,"tongjian_id":"9b606f5d-db0e-11ef-8948-a0d3651f611f"},{"place_name":"揚州","place_name_jianti_auto":"扬州","resolved_place_entity_id":155,"start_index":16,"tongjian_id":"9b606f5e-db0e-11ef-bc43-a0d3651f611f"},{"place_name":"安豐","place_name_jianti_auto":"安丰","resolved_place_entity_id":2601,"start_index":24,"tongjian_id":"9b606f5f-db0e-11ef-80a9-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","resolved_place_entity_id":33,"start_index":105,"tongjian_id":"9b606f64-db0e-11ef-bd06-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"7吳主大發衆集建業，揚聲欲入寇，揚州刺史諸葛誕使安豐太守王基策之。基曰：「今陸遜等已死，孫權年老，內無賢嗣，中無謀主。權自出則懼內釁卒起，癰疽發潰；遣將則舊將已盡，新將未信。此不過欲補䘺支黨，還自保護耳。」已而吳果不出。","content_fanyi":"吴主大规模征调兵众集结在建业，扬言准备入侵魏国。扬州刺史诸葛诞让安丰太守王基为此出谋划策。王基说：“如今陆逊等人已经去世，孙权年事已高，内部没有贤能的继承人，朝中没有主谋之人。孙权如果亲自率兵出动，就害怕内部变乱突然爆发，像痈疽溃烂一样；如果派遣将领出征，旧将已经凋零，新将又尚未取得信任。这不过是想弥合内部派系、巩固亲信党羽，借以自我保护罢了。”不久，吴国果然没有出兵。","content_jianti_auto":"7吴主大发众集建业，扬声欲入寇，扬州刺史诸葛诞使安丰太守王基策之。基曰：「今陆逊等已死，孙权年老，内无贤嗣，中无谋主。权自出则惧内衅卒起，痈疽发溃；遣将则旧将已尽，新将未信。此不过欲补䘺支党，还自保护耳。」已而吴果不出。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6373,"number":7,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"9b606f4d-db0e-11ef-bbe2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"洮水","place_name_jianti_auto":"洮水","start_index":4,"tongjian_id":"9b606f68-db0e-11ef-8909-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":7,"tongjian_id":"9b606f69-db0e-11ef-b6bb-a0d3651f611f"},{"place_name":"白水","place_name_jianti_auto":"白水","start_index":8,"tongjian_id":"9b606f6a-db0e-11ef-92d5-a0d3651f611f"},{"place_name":"西傾山","place_name_jianti_auto":"西倾山","start_index":12,"tongjian_id":"9b606f6b-db0e-11ef-82e9-a0d3651f611f"},{"place_name":"白水","place_name_jianti_auto":"白水","start_index":19,"tongjian_id":"9b606f6c-db0e-11ef-a0f6-a0d3651f611f"},{"place_name":"洮水","place_name_jianti_auto":"洮水","start_index":26,"tongjian_id":"9b606f6d-db0e-11ef-9360-a0d3651f611f"},{"place_name":"洮水","place_name_jianti_auto":"洮水","start_index":30,"tongjian_id":"9b606f6e-db0e-11ef-a08e-a0d3651f611f"},{"place_name":"吐谷渾","place_name_jianti_auto":"吐谷浑","start_index":35,"tongjian_id":"9b606f6f-db0e-11ef-94fb-a0d3651f611f"},{"place_name