ren_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"傅太后","people_name_jianti_auto":"傅太后","start_index":0,"tongjian_id":"92966987-db0e-11ef-bf4d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"永信宮","place_name_jianti_auto":"永信宫","start_index":4,"tongjian_id":"92966988-db0e-11ef-9f92-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"傅太后稱永信宮。","note_content_jianti_auto":"傅太后称永信宫。","note_type":"hu_note","start_index":74,"tongjian_id":"92966986-db0e-11ef-837a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"衞武公","people_name_jianti_auto":"衞武公","start_index":1,"tongjian_id":"9296698a-db0e-11ef-8987-a0d3651f611f"},{"people_name":"鄭武公","people_name_jianti_auto":"郑武公","start_index":5,"tongjian_id":"9296698b-db0e-11ef-9805-a0d3651f611f"},{"people_name":"莊公","people_name_jianti_auto":"庄公","start_index":9,"tongjian_id":"9296698c-db0e-11ef-ac5a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如衞武公、鄭武公、莊公是也。","note_content_jianti_auto":"如衞武公、郑武公、庄公是也。","note_type":"hu_note","start_index":131,"tongjian_id":"92966989-db0e-11ef-8fa4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9296698e-db0e-11ef-93c2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：塡，讀曰鎭；音竹刃翻。","note_content_jianti_auto":"师古曰：塡，读曰镇；音竹刃翻。","note_type":"hu_note","start_index":147,"tongjian_id":"9296698d-db0e-11ef-bc43-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","resolved_place_entity_id":704,"start_index":91,"tongjian_id":"92966996-db0e-11ef-afc8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"頃之，傅太后使謁者賤買執金吾官婢八人，隆奏言：「買賤，請更平直。」上於是制詔丞相、御史：「隆位九卿，旣無以匡朝廷之不逮，而反奏請與永信宮爭貴賤之賈，傷化失俗。以隆前有安國之言，左遷爲沛郡都尉。」初，成帝末，隆爲諫大夫，嘗奏封事言：「古者選諸侯入爲公卿，以褒功德，宜徵定陶王使在國邸，以塡萬方。」故上思其言而宥之。","content_fanyi":"不久，傅太后让谒者用低价买下执金吾官署的八名官婢。毋将隆上奏说：“买价太低，请改为公平价格。”哀帝于是下诏给丞相、御史说：“毋将隆身为九卿，既不能匡正朝廷的缺失，反而上奏请求与永信宫争较价格高低，伤教化、坏风俗。念及毋将隆先前有安定国家的言论，降职为沛郡都尉。”当初，成帝末年，毋将隆任谏大夫，曾上密封奏书说：“古时挑选诸侯入朝担任公卿，是为了褒奖功德，应当征召定陶王，让他在京城的定陶王府邸居住，以镇抚天下。”所以哀帝记起他的话而宽免了他。","content_jianti_auto":"顷之，傅太后使谒者贱买执金吾官婢八人，隆奏言：「买贱，请更平直。」上于是制诏丞相、御史：「隆位九卿，既无以匡朝廷之不逮，而反奏请与永信宫争贵贱之贾，伤化失俗。以隆前有安国之言，左迁为沛郡都尉。」初，成帝末，隆为谏大夫，尝奏封事言：「古者选诸侯入为公卿，以褒功德，宜征定陶王使在国邸，以塡万方。」故上思其言而宥之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2649,"path":"资治通鉴 : 卷第三十四 (漢紀二十六) / 孝哀皇帝中 / 四年 / 第 11 段","reading_annotation_sources":[],"start_index":10,"tongjian_id":"92966983-db0e-11ef-ba82-a0d3651f611f","year_int":-3},"tongjian_id":"92966983-db0e-11ef-ba82-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"沛郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言以疾篤稽留道上，不進于行也。任，音壬。","note_content_jianti_auto":"言以疾笃稽留道上，不进于行也。任，音壬。","note_type":"hu_note","start_index":54,"tongjian_id":"9438cd6a-db0e-11ef-98f1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"揚雄","people_name_jianti_auto":"扬雄","start_index":0,"tongjian_id":"9438cd6c-db0e-11ef-8111-a0d3651f611f"},{"people_name":"郭景純","people_name_jianti_auto":"郭景纯","start_index":20,"tongjian_id":"9438cd6d-db0e-11ef-8a89-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":13,"tongjian_id":"9438cd6e-db0e-11ef-b67b-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":15,"tongjian_id":"9438cd6f-db0e-11ef-a6bf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"揚雄方言曰：屑屑，不安也；秦、晉曰屑屑。郭景純曰：往來貌。","note_content_jianti_auto":"扬雄方言曰：屑屑，不安也；秦、晋曰屑屑。郭景纯曰：往来貌。","note_type":"hu_note","start_index":91,"tongjian_id":"9438cd6b-db0e-11ef-86a8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","resolved_place_entity_id":704,"start_index":4,"tongjian_id":"9438cd73-db0e-11ef-8f13-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"王良後歷沛郡太守、大司徒司直，在位恭儉，布被瓦器，妻子不入官舍。後以病歸，一歲復徵；至滎陽，疾篤，不任進道，過其友人。友人不肯見，曰：「不有忠言奇謀而取大位，何其往來屑屑不憚煩也！」遂拒之。良慙，自後連徵不應，卒於家。","content_fanyi":"王良后来相继担任沛郡太守、大司徒司直，在位时恭谨节俭，盖的是布做的被子，用的是泥土烧制而成的瓦器，妻子儿女从不进入官舍。后来因病回乡，一年后再次被征召；行至荥阳，病情加重，无法继续赶路，便去拜访朋友。朋友不肯见他，说：“没有忠直的言论和奇妙的谋略却取得高位，怎么还这样频繁往来、不嫌烦扰呢！”于是拒绝了他。王良感到惭愧，此后接连被征召，他都不再应召，最后在家中去世。","content_jianti_auto":"王良后历沛郡太守、大司徒司直，在位恭俭，布被瓦器，妻子不入官舍。后以病归，一岁复征；至荥阳，疾笃，不任进道，过其友人。友人不肯见，曰：「不有忠言奇谋而取大位，何其往来屑屑不惮烦也！」遂拒之。良慙，自后连征不应，卒于家。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，虽无殊猷，而恭俭以居大位，于君子之道尚不远矣。故君子者...","context_before":"","source_end_index":7,"source_paragraph_tongjian_id":"4e176ee1-904e-4ed2-b42e-9998ad30441b","source_start_index":0,"source_text":"王良应召而受禄"}],"title":"一七 胆敢对抗皇帝的严光和周党"}],"id":3209,"path":"资治通鉴 : 卷第四十一 (漢紀三十三) / 世祖光武皇帝上之下 / 五年 / 第 45 段","reading_annotation_sources":[],"start_index":44,"tongjian_id":"9438cd68-db0e-11ef-b1a5-a0d3651f611f","year_int":29},"tongjian_id":"9438cd68-db0e-11ef-b1a5-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"沛郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","place_note":"安徽淮北","start_index":4,"tongjian_id":"947f5f15-db0e-11ef-b262-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":7,"tongjian_id":"947f5f16-db0e-11ef-a291-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志，沛郡在雒陽東南一千二百里。","note_content_jianti_auto":"郡国志，沛郡在雒阳东南一千二百里。","note_type":"hu_note","start_index":19,"tongjian_id":"947f5f14-db0e-11ef-be70-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","place_note":"安徽淮北","resolved_place_entity_id":704,"start_index":8,"tongjian_id":"947f5f19-db0e-11ef-b85e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7三月，辛未，以沛郡太守韓歆爲大司徒。","content_fanyi":"三月十二日辛未，光武帝任命沛郡太守韩歆为大司徒。","content_jianti_auto":"7三月，辛未，以沛郡太守韩歆为大司徒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3332,"number":7,"path":"资治通鉴 : 卷第四十三 (漢紀三十五) / 世祖光武皇帝中之下 / 十三年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"947f5f13-db0e-11ef-8c8c-a0d3651f611f","year_int":37},"tongjian_id":"947f5f13-db0e-11ef-8c8c-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"沛郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","resolved_place_entity_id":704,"start_index":16,"tongjian_id":"a2811806-db0e-11ef-8561-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1春，正月，己亥，袁眞以梁國內史沛郡朱憲及弟汝南內史斌陰通大司馬溫，殺之。","content_fanyi":"春季，正月二十四日己亥，袁真因梁国内史沛郡人朱宪和其弟汝南内史朱斌暗通大司马桓温，将二人杀死。","content_jianti_auto":"1春，正月，己亥，袁真以梁国内史沛郡朱宪及弟汝南内史斌阴通大司马温，杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8969,"number":1,"path":"资治通鉴 : 卷第一百二 (晉紀二十四) / 海西公下 / 五年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"a28117ff-db0e-11ef-b2c4-a0d3651f611f","year_int":370},"tongjian_id":"a28117ff-db0e-11ef-b2c4-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"沛郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"𨔵","people_name_jianti_auto":"𨔵","start_index":0,"tongjian_id":"a2e71e9a-db0e-11ef-987c-a0d3651f611f"},{"people_name":"楊正衡","people_name_jianti_auto":"杨正衡","start_index":11,"tongjian_id":"a2e71e9b-db0e-11ef-8d21-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沛郡","place_name_jianti_auto":"沛郡","start_index":2,"tongjian_id":"a2e71e9c-db0e-11ef-84e9-a0d3651f611f"},{"place_name":"彭城","place_name_jianti_auto":"彭城","start_index":8,"tongjian_id":"a2e71e9d-db0e-11ef-aa69-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"𨔵領沛郡太守，戍彭城。楊正衡曰：𨔵，古遁字。","note_content_jianti_auto":"𨔵领沛郡太守，戍彭城。杨正衡曰：𨔵，古遁字。","note_type":"hu_note","start_index":20,"tongjian_id":"a2e71e99-db0e-11ef-909a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"苻丕","people_name_jianti_auto":"苻丕","start_index":4,"tongjian_id":"a2e71e9f-db0e-11ef-a112-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":13,"tongjian_id":"a2e71ea0-db0e-11ef-bf4b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"征南，謂苻丕也，時督諸軍攻襄陽。棊劫者，以棊勢喻兵勢也。圍棊者，攻其右而敵手應之，則擊其左取之，謂之劫。","note_content_jianti_auto":"征南，谓苻丕也，时督诸军攻襄阳。棋劫者，以棋势喻兵势也。围棋者，攻其右而敌手应之，则击其左取之，谓之劫。","note_type":"hu_note","start_index":43,"tongjian_id":"a2e71e9e-db0e-11ef-a136-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":0,"tongjian_id":"a2e71ea2-db0e-11ef-aa0c-a0d3651f611f"},{"place_name":"建康","place_name_jianti_auto":"建康","start_index":2,"tongjian_id":"a2e71ea3-db0e-11ef-8bd8-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":5,"tongjian_id":"a2e71ea4-db0e-11ef-bb09-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","start_index":6,"tongjian_id":"a2e71ea5-db0e-11ef-956a-a0d3651f611f"},{"place_name":"秣陵縣","place_name_jianti_auto":"秣陵县","start_index":8,"tongjian_id":"a2e71ea6-db0e-11ef-b82d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉都建康，漢丹陽秣陵縣地。","note_content_jianti_auto":"晋都建康，汉丹阳秣陵县地。","note_type":"hu_note","start_index":56,"tongjian_id":"a2e71ea1-db0e-11ef-b187-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"俱","people_name_jianti_auto":"俱","start_index":0,"tongjian_id":"a2e736f1-db0e-11ef-bfce-a0d3651f611f"},{"people_name":"鄧羌","people_name_jianti_auto":"邓羌","start_index":35,"tongjian_id":"a2e736f2-db0e-11ef-a9a6-a0d36