{"data":{"current_mention_tongjian_id":"8c021a86-db0e-11ef-9dd8-a0d3651f611f","current_paragraph_tongjian_id":"8c021a7c-db0e-11ef-8a54-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":2,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周成王","people_name_jianti_auto":"周成王","start_index":0,"tongjian_id":"8bf8ca46-db0e-11ef-8b36-a0d3651f611f"},{"people_name":"熊繹","people_name_jianti_auto":"熊绎","start_index":4,"tongjian_id":"8bf8ca47-db0e-11ef-821b-a0d3651f611f"},{"people_name":"羋氏","people_name_jianti_auto":"芈氏","start_index":10,"tongjian_id":"8bf8ca48-db0e-11ef-b526-a0d3651f611f"},{"people_name":"熊繹","people_name_jianti_auto":"熊绎","start_index":42,"tongjian_id":"8bf8ca49-db0e-11ef-a166-a0d3651f611f"},{"people_name":"熊繹","people_name_jianti_auto":"熊绎","start_index":72,"tongjian_id":"8bf8ca4a-db0e-11ef-abf3-a0d3651f611f"},{"people_name":"聲王","people_name_jianti_auto":"声王","start_index":75,"tongjian_id":"8bf8ca4b-db0e-11ef-9753-a0d3651f611f"},{"people_name":"聲王","people_name_jianti_auto":"声王","start_index":85,"tongjian_id":"8bf8ca4c-db0e-11ef-b49b-a0d3651f611f"},{"people_name":"當","people_name_jianti_auto":"当","start_index":89,"tongjian_id":"8bf8ca4d-db0e-11ef-b1c1-a0d3651f611f"},{"people_name":"悼王","people_name_jianti_auto":"悼王","start_index":91,"tongjian_id":"8bf8ca4e-db0e-11ef-bfec-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":7,"tongjian_id":"8bf8ca4f-db0e-11ef-a860-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","start_index":14,"tongjian_id":"8bf8ca50-db0e-11ef-9968-a0d3651f611f"},{"place_name":"枝江縣","place_name_jianti_auto":"枝江县","start_index":18,"tongjian_id":"8bf8ca51-db0e-11ef-adc6-a0d3651f611f"},{"place_name":"丹陽城","place_name_jianti_auto":"丹阳城","start_index":22,"tongjian_id":"8bf8ca52-db0e-11ef-8a68-a0d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":33,"tongjian_id":"8bf8ca53-db0e-11ef-be98-a0d3651f611f"},{"place_name":"秭歸縣","place_name_jianti_auto":"秭归县","start_index":35,"tongjian_id":"8bf8ca54-db0e-11ef-933d-a0d3651f611f"},{"place_name":"丹陽城","place_name_jianti_auto":"丹阳城","start_index":38,"tongjian_id":"8bf8ca55-db0e-11ef-85c6-a0d3651f611f"},{"place_name":"汝","place_name_jianti_auto":"汝","start_index":57,"tongjian_id":"8bf8ca56-db0e-11ef-89cc-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":61,"tongjian_id":"8bf8ca57-db0e-11ef-b7af-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","start_index":63,"tongjian_id":"8bf8ca58-db0e-11ef-8e3b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周成王封熊繹於楚，姓羋氏，居丹陽，今枝江縣故丹陽城是也。括地志曰：歸州秭歸縣丹陽城，熊繹之始國。其後強大，北封畛於汝，南幷吳、越，地方五千里。自熊繹至聲王三十世。索隱曰：聲王，名當。悼王，名疑。諡法：不生其國曰聲。註云：生於外家。年中早夭曰悼。註云：年不稱志。又云：恐懼從處曰悼。註云：從處，言險圮也。","note_content_jianti_auto":"周成王封熊绎于楚，姓芈氏，居丹阳，今枝江县故丹阳城是也。括地志曰：归州秭归县丹阳城，熊绎之始国。其后强大，北封畛于汝，南幷吴、越，地方五千里。自熊绎至声王三十世。索隐曰：声王，名当。悼王，名疑。谥法：不生其国曰声。注云：生于外家。年中早夭曰悼。注云：年不称志。又云：恐惧从处曰悼。注云：从处，言险圮也。","note_type":"hu_note","start_index":15,"tongjian_id":"8bf8ca45-db0e-11ef-9723-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-381,"link_td_description":"楚悼王，出土楚国文献作悼折王，原名熊疑，楚声王之子。","link_td_id":"Q10001878","link_td_number_id":335210,"people_name":"悼王","people_name_jianti_auto":"悼王","people_xingming":"芈疑","start_index":12,"tongjian_id":"8bf8ca60-db0e-11ef-b441-a0d3651f611f","wl_zhushi":"[芈疑]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2盜殺楚聲王，國人立其子悼王。","content_fanyi":"强盗杀死楚国声王，楚国人拥立他的儿子即位，是为悼王。","content_jianti_auto":"2盗杀楚声王，国人立其子悼王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":31,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十四年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bf8ca44-db0e-11ef-916c-a0d3651f611f","year_int":-402},"tongjian_id":"8bf8ca44-db0e-11ef-916c-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相，息亮翻。灋，古法字。","note_content_jianti_auto":"相，息亮翻。灋，古法字。","note_type":"hu_note","start_index":21,"tongjian_id":"8c021a7d-db0e-11ef-a243-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":54,"tongjian_id":"8c021a7f-db0e-11ef-9a59-a0d3651f611f"},{"place_name":"山","place_name_jianti_auto":"山","start_index":65,"tongjian_id":"8c021a80-db0e-11ef-a7c8-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":76,"tongjian_id":"8c021a81-db0e-11ef-a453-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"捐，余專翻，弃也，除去也。漢書音義曰：以利合曰從，以威力相脅曰橫。或曰：南北曰從，從者，連南北爲一，西鄕以擯秦。東西曰橫，橫者，離山東之交，使之西鄕以事秦。說，式芮翻。從，卽容翻。「橫」，亦作「衡」，音同。","note_content_jianti_auto":"捐，余专翻，弃也，除去也。汉书音义曰：以利合曰从，以威力相胁曰横。或曰：南北曰从，从者，连南北为一，西鄕以摈秦。东西曰横，横者，离山东之交，使之西鄕以事秦。说，式芮翻。从，即容翻。「横」，亦作「衡」，音同。","note_type":"hu_note","start_index":56,"tongjian_id":"8c021a7e-db0e-11ef-bf99-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8c021a84-db0e-11ef-aa88-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"越","place_name_jianti_auto":"越","start_index":4,"tongjian_id":"8c021a85-db0e-11ef-b836-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：越有百邑。","note_content_jianti_auto":"韦昭曰：越有百邑。","note_type":"hu_note","start_index":63,"tongjian_id":"8c021a83-db0e-11ef-8241-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期楚国的最高行政官职，相当于宰相，负责辅佐君主处理国家政务。在上下文中，楚悼王任命吴起为相，以推行改革，加强军事力量。","official_rank":"未知","source_snippet":"任之爲相","start_index":12,"tongjian_id":"7d1ad9b1-690a-463c-99bf-dfb81a5f0e2c"},{"confidence":0.7,"official_category":"未知","official_name":"官","official_note":"官泛指官职或官员，在上下文中指吴起改革时裁撤不必要的官职，以精简行政机构。","official_rank":"未知","source_snippet":"捐不急之官","start_index":24,"tongjian_id":"bd4c985e-d492-4d21-85f7-74d71dec5775"},{"confidence":0.8,"official_category":"中枢机构","official_name":"大臣","official_note":"大臣指高级官员，在上下文中指楚国的贵族和高级官员对吴起改革产生怨恨。","official_rank":"未知","source_snippet":"貴戚大臣","start_index":78,"tongjian_id":"e734ffae-9e08-4499-ba76-724a5301399c"}],"ExtRef_Children_people":[{"link_death_year":-381,"link_td_description":"楚悼王，出土楚国文献作悼折王，原名熊疑，楚声王之子。","link_td_id":"Q10001878","link_td_number_id":335210,"people_name":"楚悼王","people_name_jianti_auto":"楚悼王","people_xingming":"疑","start_index":0,"tongjian_id":"8c021a86-db0e-11ef-9dd8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/秦用他国人","excerpts":[{"context_after":"，盖卫人也。","context_before":"...也。燕昭王任郭隗、剧辛、乐毅，几灭强齐，辛、毅皆赵人也。","source_end_index":194,"source_paragraph_tongjian_id":"6e15c2e4-f2d3-4bfd-b268-aaf88f22dfd7","source_start_index":179,"source_text":"楚悼王任吴起为相，诸侯患楚之强"}],"path":"随笔/卷二/秦用他国人","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷七十五）","excerpts":[{"context_after":"是也。洞庭湖中有君山，亦名洞庭山[在岳州府西南十五里]，...","context_before":"...乐于洞庭之野。《楚辞》：邅吾道兮洞庭。《后汉·南蛮传》：","source_end_index":666,"source_paragraph_tongjian_id":"a96e70ac-6008-5c4a-bde3-4b3988b35d8b","source_start_index":647,"source_text":"吴起相悼王，南并蛮越，遂有洞庭、苍梧。"}],"path":"湖广方舆纪要/〇、封域山川险要（卷七十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十二、赣州府（卷八十八）","excerpts":[{"context_after":"自秦迄汉，皆出五岭威百粤，赣之不能无事可知也。晋之末造，...","context_before":"...阻，为岭海之关键，江湖之要枢。江右有事，此其必争之所也。","source_end_index":58,"source_paragraph_tongjian_id":"32fe911c-0099-52fd-ae31-cda76c22f71c","source_start_index":43,"source_text":"战国时，楚尝使吴起南平百粤矣。"}],"path":"江西方舆纪要/十二、赣州府（卷八十八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷一百）","excerpts":[{"context_after":"孔氏曰：越在扬州南境，故曰扬越]。其在天文，则牵牛、婺女...","context_before":"...南裔。或曰：今海南琼州府是其地]。后为百越地，亦曰扬越[","source_end_index":124,"source_paragraph_tongjian_id":"ad9e4357-0094-5a58-a945-de8298f56271","source_start_index":94,"source_text":"《国策》：吴起为楚悼王相，攻扬越。《史记》起本传作南平百越。"}],"path":"广东方舆纪要/〇、封域山川险要（卷一百）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷一百六）","excerpts":[{"context_after":"其属有瓯越、雒越，种类甚蕃，故曰百越。后又谓之扬越。今详...","context_before":"...蛮夷国，所谓百越地也，亦谓之南越[杜佑曰：南越亦曰蛮越。","source_end_index":60,"source_paragraph_tongjian_id":"e6a47c83-e7b4-5370-85b4-a597218ad08e","source_start_index":45,"source_text":"战国时吴起相楚，南并蛮越是也。"}],"path":"广西方舆纪要/〇、封域山川险要（卷一百六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"楚悼王素聞其賢，至則任之爲相。起明灋審令，捐不急之官，廢公族疏遠者，以撫養戰鬬之士，要在強兵，破遊說之言從橫者。於是南平百越，北卻三晉，西伐秦，諸侯皆患楚之強；而楚之貴戚大臣多怨吳起者。","content_fanyi":"楚悼王一向听说吴起贤能，吴起一到楚国，就被任用为国相。吴起严明法度，审察政令，裁撤冗杂不急的官职，废除公族中关系疏远者的爵禄，用来供养和奖赏作战将士，要旨在于强兵，推行强国方略，并破除游说之士所宣扬的合纵连横言论。于是，楚国向南平定百越，向北逼退韩、赵、魏三晋，向西攻伐秦国，各国诸侯都畏惧楚国的强盛；而楚国的贵戚大臣中，很多人怨恨吴起。","content_jianti_auto":"楚悼王素闻其贤，至则任之为相。起明灋审令，捐不急之官，废公族疏远者，以抚养战鬬之士，要在强兵，破游说之言从横者。于是南平百越，北却三晋，西伐秦，诸侯皆患楚之强；而楚之贵戚大臣多怨吴起者。","dtjl_paragraph_links":[],"dtjl_references":[],"id":61,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 十五年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"8c021a7c-db0e-11ef-8a54-a0d3651f611f","year_int":-387},"tongjian_id":"8c021a7c-db0e-11ef-8a54-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"之，往也，往赴王尸而伏其側。","note_content_jianti_auto":"之，往也，往赴王尸而伏其侧。","note_type":"hu_note","start_index":26,"tongjian_id":"8c046736-db0e-11ef-a02e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：剛德克就曰肅；執心決斷曰肅。","note_content_jianti_auto":"谥法：刚德克就曰肃；执心决断曰肃。","note_type":"hu_note","start_index":48,"tongjian_id":"8c046738-db0e-11ef-bf91-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，湖北江陵","start_index":3,"tongjian_id":"8c04673b-db0e-11ef-a663-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令尹，楚相也。","note_content_jianti_auto":"令尹，楚相也。","note_type":"hu_note","start_index":57,"tongjian_id":"8c04673a-db0e-11ef-91df-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夷，殺也；夷宗者，殺其同宗也。","note_content_jianti_auto":"夷，杀也；夷宗者，杀其同宗也。","note_type":"hu_note","start_index":67,"tongjian_id":"8c04673c-db0e-11ef-af59-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"令尹","official_note":"令尹是楚国的最高行政长官，相当于宰相，负责国家政务。在上下文中，肃王即位后命令令尹诛杀作乱的贵戚大臣，体现了令尹在楚国政治中的核心执法和行政职能。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"使令尹盡誅爲亂者","start_index":48,"tongjian_id":"15bb7c0c-6acd-4db3-917a-cb4ab1c03760"}],"ExtRef_Children_people":[{"link_death_year":-381,"link_td_description":"楚悼王，出土楚国文献作悼折王，原名熊疑，楚声王之子。","link_td_id":"Q10001878","link_td_number_id":335210,"people_name":"楚悼王","people_name_jianti_auto":"楚悼王","people_xingming":"芈疑","start_index":1,"tongjian_id":"8c04673d-db0e-11ef-96f8-a0d3651f611f","wl_zhushi":"[芈疑]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1楚悼王薨。貴戚大臣作亂，攻吳起；起走之王尸而伏之。擊起之徒因射刺起，並中王尸。旣葬，肅王卽位，使令尹盡誅爲亂者；坐起夷宗者七十餘家。","content_fanyi":"楚悼王去世。楚国贵戚大臣们发动叛乱，围攻吴起；吴起逃到楚悼王尸体处，伏在尸体上面。攻击吴起的人于是用箭射刺吴起，连楚悼王的尸体也被射中。丧葬完毕后，楚肃王即位，命令令尹将作乱的人全部诛杀；因攻打吴起之事受牵连而被灭族的有七十余家。","content_jianti_auto":"1楚悼王薨。贵戚大臣作乱，攻吴起；起走之王尸而伏之。击起之徒因射刺起，并中王尸。既葬，肃王即位，使令尹尽诛为乱者；坐起夷宗者七十余家。","dtjl_paragraph_links":[],"dtjl_references":[],"id":73,"number":1,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 二十一年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c046735-db0e-11ef-a257-a0d3651f611f","year_int":-381},"tongjian_id":"8c046735-db0e-11ef-a257-a0d3651f611f"},"paragraph_order":3}],"page_size":7,"total_pages":1,"total_paragraphs":3},"profile":{"alias_list":["熊疑","悼折王","楚悼折王"],"biography":"楚悼王，出土楚国文献作悼折王，原名熊疑，楚声王之子。","death_year":-381,"link_td_id":"Q10001878","name":"楚悼王","number_id":335210},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"来源文本：楚肅王（？—前370年），原名熊臧，楚悼王子。","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10000651","source_person_name":"楚肃王","source_person_number_id":335212,"statement_id":"S-Q10000651-P100023-Q10001878","target_person_id":"Q10001878","target_person_name":"楚悼王","target_person_number_id":335210},{"direction":"forward","rank":"normal","relation_detail":"来源文本：原名熊疑，楚聲王之子。","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10001878","source_person_name":"楚悼王","source_person_number_id":335210,"statement_id":"S-Q10001878-P100023-Q10000656","target_person_id":"Q10000656","target_person_name":"楚声王","target_person_number_id":335254},{"direction":"reverse","rank":"normal","relation_detail":"太子疑是楚声王的儿子，来源文本：死后太子疑和王子定争位，最后太子疑继位为楚悼王。","relation_property_display_template":"{subject}的子是{value}","relation_property_id":"P100025","relation_property_label":"子","source_person_id":"Q10000656","source_person_name":"楚声王","source_person_number_id":335254,"statement_id":"S-Q10000656-P100025-Q10001878","target_person_id":"Q10001878","target_person_name":"楚悼王","target_person_number_id":335210},{"direction":"reverse","rank":"normal","relation_detail":"曾侍奉的君主，来源文本：仕楚时主持改革，史称吴起变法。前381年，楚悼王去世后，楚国贵族发动兵变杀害吴起。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10000069","source_person_name":"吴起","source_person_number_id":1134,"statement_id":"S-Q10000069-P100061-Q10001878","target_person_id":"Q10001878","target_person_name":"楚悼王","target_person_number_id":335210}]},"message":"success","success":true}