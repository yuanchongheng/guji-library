_auto":"魏","place_note":"府大梁，河南开封","resolved_place_entity_id":1,"start_index":60,"tongjian_id":"8c407ae8-db0e-11ef-8da1-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":64,"tongjian_id":"8c407ae9-db0e-11ef-975b-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"府大梁，河南开封","resolved_place_entity_id":1,"start_index":66,"tongjian_id":"8c407aea-db0e-11ef-ae54-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"1秦惠王使犀首欺齊、魏，與共伐趙，以敗從約，趙肅侯讓蘇秦，蘇秦恐，請使燕，必報齊。蘇秦去趙而從約皆解。趙人決河水以灌齊、魏之師，齊、魏之師乃去。","content_fanyi":"秦惠王派犀首去欺骗齐国、魏国，使它们与秦国联合起来出兵攻打赵国，想借此破坏合纵盟约，赵肃侯责备苏秦，苏秦心中害怕，请求出使燕国，一定要报复齐国。苏秦离开赵国后，合纵盟约随即完全瓦解。赵国人挖开黄河堤防，放河水淹灌齐、魏两国的军队，齐、魏两国的军队于是撤退。","content_jianti_auto":"1秦惠王使犀首欺齐、魏，与共伐赵，以败从约，赵肃侯让苏秦，苏秦恐，请使燕，必报齐。苏秦去赵而从约皆解。赵人决河水以灌齐、魏之师，齐、魏之师乃去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":197,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c407ad7-db0e-11ef-bc5a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c407aed-db0e-11ef-963d-a0d3651f611f"},{"people_name":"惠文王","people_name_jianti_auto":"惠文王","start_index":11,"tongjian_id":"8c407aee-db0e-11ef-8462-a0d3651f611f"},{"people_name":"漢高帝","people_name_jianti_auto":"汉高帝","start_index":21,"tongjian_id":"8c407aef-db0e-11ef-95c6-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":44,"tongjian_id":"8c407af0-db0e-11ef-a4a0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"華陰","place_name_jianti_auto":"华阴","place_note":"陕西华阴东南","start_index":3,"tongjian_id":"8c407af1-db0e-11ef-b802-a0d3651f611f