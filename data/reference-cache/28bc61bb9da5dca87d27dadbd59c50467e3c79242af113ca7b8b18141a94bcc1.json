{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁酉，六三七）","note_content_jianti_auto":"（丁酉，六三七）","note_type":"hu_note","start_index":0,"tongjian_id":"b873ad83-db0e-11ef-80da-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"鄶王","official_note":"鄶王是唐朝宗室封爵，属于地方藩王。在《资治通鉴》中，此处记载唐太宗贞观十一年（637年）正月，将鄶王李元裕改封为鄧王，反映了唐朝对宗室封爵的调整。","official_rank":"王爵","source_snippet":"徙鄶王元裕爲鄧王","start_index":6,"tongjian_id":"6a17fda7-69cf-4eb0-8749-c803f95e309d"},{"confidence":0.95,"official_category":"地方行政","official_name":"鄧王","official_note":"鄧王是唐朝宗室封爵，属于地方藩王。在《资治通鉴》中，此处记载唐太宗贞观十一年（637年）正月，将鄶王李元裕改封为鄧王，这是唐朝宗室封爵变动的一部分。","official_rank":"王爵","source_snippet":"徙鄶王元裕爲鄧王","start_index":12,"tongjian_id":"ace8fbe6-5e25-4427-96ff-bd9ba9de7deb"},{"confidence":0.95,"official_category":"地方行政","official_name":"譙王","official_note":"譙王是唐朝宗室封爵，属于地方藩王。在《资治通鉴》中，此处记载唐太宗贞观十一年（637年）正月，将譙王李元名改封为舒王，体现了唐朝对宗室管理的调整。","official_rank":"王爵","source_snippet":"譙王元名爲舒王","start_index":16,"tongjian_id":"75fee44c-3e08-4157-9c28-b1e052066ac8"},{"confidence":0.95,"official_category":"地方行政","official_name":"舒王","official_note":"舒王是唐朝宗室封爵，属于地方藩王。在《资治通鉴》中，此处记载唐太宗贞观十一年（637年）正月，将譙王李元名改封为舒王，这是唐朝宗室封爵制度中的常见变动。","official_rank":"王爵","source_snippet":"譙王元名爲舒王","start_index":20,"tongjian_id":"b8bf97a7-a656-411d-b44c-c96ecf7d4d31"}],"ExtRef_Children_people":[{"link_birth_year":624,"link_death_year":665,"link_td_description":"李元裕，唐朝皇子，唐高祖李渊第十七子。","link_td_id":"Q10003688","link_td_number_id":1206550,"people_name":"鄶王","people_name_jianti_auto":"郐王","people_xingming":"李元裕","start_index":7,"tongjian_