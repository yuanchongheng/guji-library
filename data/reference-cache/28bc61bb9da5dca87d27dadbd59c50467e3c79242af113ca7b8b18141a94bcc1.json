ti_auto":"洛阳西苑，北距北邙，西至孝水，南带洛水支渠，谷、洛二水会于其间，虑其泛溢，为三陂以御之：一曰积翠，二曰月陂，三曰上阳。苑墙周回一百二十六里。","note_type":"hu_note","start_index":17,"tongjian_id":"b8751182-db0e-11ef-8565-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":13,"source_start_index":0,"source_text":"築西苑見一百八十卷大業元年","target_paragraph_tongjian_id":"b467ec6f-db0e-11ef-af0b-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"築西苑見一百八十卷大業元年。","note_content_jianti_auto":"筑西苑见一百八十卷大业元年。","note_type":"hu_note","start_index":36,"tongjian_id":"b875118c-db0e-11ef-abe0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"隋煬帝","people_name_jianti_auto":"隋炀帝","start_index":1,"tongjian_id":"b875118e-db0e-11ef-a106-a0d3651f611f"},{"people_name":"宇文愷","people_name_jianti_auto":"宇文恺","start_index":10,"tongjian_id":"b875118f-db0e-11ef-8429-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":14,"tongjian_id":"b8751190-db0e-11ef-a71e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按隋煬帝大業二年，令宇文愷作洛陽西苑。「述」恐當作「愷」。","note_content_jianti_auto":"按隋炀帝大业二年，令宇文恺作洛阳西苑。「述」恐当作「恺」。","note_type":"hu_note","start_index":74,"tongjian_id":"b875118d-db0e-11ef-9dbe-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢近臣","official_name":"侍臣","official_note":"侍臣泛指在皇帝身边侍奉的近臣，可能包括侍中、侍郎等官职，此处用于指代唐太宗身边的官员，表示皇帝在宴会上对近臣发表言论。","official_rank":"未知","source_snippet":"顧謂侍臣曰","start_index":28,"tongjian_id":"77ae9c21-27d8-46c9-b3d7-d4f12bdf6363"}],"ExtRef_Children_people":[{"link_birth_year":569,"link_death_year":618,"link_td_description":"隋炀帝杨广，又名英，小字阿𡡉，隋文帝杨坚和文献皇后独孤伽罗的次子，唐高祖的表弟，是隋朝第二位皇帝。","link_td_id":"