c114-db0e-11ef-826c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"四十三年，黃歇與楚太子爲質於秦。應，於陵翻。相，息亮翻。乘，繩證翻。歇，許竭翻。","note_content_jianti_auto":"四十三年，黄歇与楚太子为质于秦。应，于陵翻。相，息亮翻。乘，绳证翻。歇，许竭翻。","note_type":"hu_note","start_index":71,"tongjian_id":"8cf0c111-db0e-11ef-a913-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂死也。卒，終也，音子恤翻。","note_content_jianti_auto":"谓死也。卒，终也，音子恤翻。","note_type":"hu_note","start_index":173,"tongjian_id":"8cf0c117-db0e-11ef-93e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"逃去爲亡。使，疏吏翻。","note_content_jianti_auto":"逃去为亡。使，疏吏翻。","note_type":"hu_note","start_index":207,"tongjian_id":"8cf0c118-db0e-11ef-8daf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":11,"tongjian_id":"8cf0c11a-db0e-11ef-b1c5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歇，許竭翻。守舍者，守楚太子所寓館舍。常爲，于僞翻。度，徒洛翻。","note_content_jianti_auto":"歇，许竭翻。守舍者，守楚太子所寓馆舍。常为，于伪翻。度，徒洛翻。","note_type":"hu_note","start_index":250,"tongjian_id":"8cf0c119-db0e-11ef-8afb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"歇","people_name_jianti_auto":"歇","start_index":5,"tongjian_id":"8cf0c11c-db0e-11ef-b0e1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":11,"tongjian_id":"8cf0c11d-db0e-11ef-8ec6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言無以罪加歇，而歸之於楚，以結其和親也。應，於陵翻。","note_content_jianti_auto":"言无以罪加歇，而归之于楚，以结其和亲也。应，于陵翻。","note_type":"hu_note","start_index":314,"tongjian_id":"8cf0c11b-db0e-11ef-b8d1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"考烈王","people_name_jianti_auto":"考烈王","start_index":12,"tongjian_id":"8cf0c11f-db0e-11ef-a594-a0d3651f611f"},{"people_name":"完","people_name_jianti_auto":"完","start_index":19,"tongjian_id":"8cf0c120-db0e-11ef-bf45-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"頃，音傾。秋，卽是年秋。考烈王，卽太子完。","note_content_jianti_auto":"顷，音倾。秋，即是年秋。考烈王，即太子完。","note_type":"hu_note","start_index":343,"tongjian_id":"8cf0c11e-db0e-11ef-a909-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"歇","people_name_jianti_auto":"歇","start_index":3,"tongjian_id":"8cf0c122-db0e-11ef-996c-a0d3651f611f"},{"people_name":"春申君","people_name_jianti_auto":"春申君","start_index":6,"tongjian_id":"8cf0c123-db0e-11ef-bf59-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"淮","place_name_jianti_auto":"淮","start_index":11,"tongjian_id":"8cf0c124-db0e-11ef-84d1-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":20,"tongjian_id":"8cf0c125-db0e-11ef-b1b6-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":25,"tongjian_id":"8cf0c126-db0e-11ef-a528-a0d3651f611f"},{"place_name":"蘇州","place_name_jianti_auto":"苏州","start_index":34,"tongjian_id":"8cf0c127-db0e-11ef-bf4d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記，歇初封春申君，賜淮北十四縣；後徙封江東，因城吳故墟以爲都邑，今蘇州是也。相，息亮翻。","note_content_jianti_auto":"史记，歇初封春申君，赐淮北十四县；后徙封江东，因城吴故墟以为都邑，今苏州是也。相，息亮翻。","note_type":"hu_note","start_index":361,"tongjian_id":"8cf0c121-db0e-11ef-aad0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"太子之傅","official_note":"太子之傅是太子的老师或辅佐官，负责教导太子，此处秦王命令太子之傅先去楚国探问楚王病情，作为外交行动的一部分。","official_rank":"未知","source_snippet":"令太子之傅先往問疾","start_index":78,"tongjian_id":"4b4728f8-15b8-4400-9ce9-ee5f1fae0748"},{"confidence":0.95,"official_category":"中枢机构","official_name":"相","official_note":"相是楚国的最高行政长官，相当于宰相，此处黄歇被任命为相，封春申君，表明他在楚国获得重要权力。","official_rank":"正一品或高位","source_snippet":"以黃歇爲相","start_index":324,"tongjian_id":"958516f5-4975-44bd-80a1-cc1ae1d888d7"}],"ExtRef_Children_people":[{"link_birth_year":-329,"link_death_year":-263,"link_td_description":"楚顷襄王，简称楚顷王或楚襄王，又作楚庄王（与其远祖楚庄王有别），芈姓，熊氏，名横，楚怀王之子，生母为郑袖。","link_td_id":"Q10000653","link_td_number_id":335229,"people_name":"楚頃襄王","people_name_jianti_auto":"楚顷襄王","people_xingming":"芈横","start_index":1,"tongjian_id":"8cf0c129-db0e-11ef-9590-a0d3651f611f","wl_zhushi":"[芈横]"},{"link_death_year":-238,"link_td_description":"春申君，本名黄歇，中国战国时代政治家，楚国黃邑人。楚考烈王时期官至楚国令尹，和平原君赵胜、孟尝君田文、信陵君魏无忌合称为“战国四公子”。","link_td_id":"Q10000284","link_td_number_id":191045,"people_name":"黃歇","people_name_jianti_auto":"黄歇","people_xingming":"黄歇","start_index":8,"tongjian_id":"8cf0c12a-db0e-11ef-8580-a0d3651f611f"},{"link_death_year":-255,"link_td_description":"范雎，姬姓、范氏，字叔，化名为张禄，芮城（今山西芮城）人，东周战国时魏国政治家、军事谋略家，秦昭襄王宰相。封地在应城（今河南鲁山东），所以又称为应侯。","link_td_id":"Q10001749","link_td_number_id":304624,"people_name":"應侯","people_name_jianti_auto":"应侯","people_xingming":"范睢","start_index":12,"tongjian_id":"8cf0c12b-db0e-11ef-9a83-a0d3651f611f","wl_zhushi":"[范睢]"},{"link_birth_year":-329,"link_death_year":-263,"link_td_description":"楚顷襄王，简称楚顷王或楚襄王，又作楚庄王（与其远祖楚庄王有别），芈姓，熊氏，名横，楚怀王之子，生母为郑袖。","link_td_id":"Q10000653","link_td_number_id":335229,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈横","start_index":18,