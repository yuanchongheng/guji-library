zhang_notes":[],"note_content":"湣，讀曰閔。楚滅陳、蔡，封畛於汝，滅越，取吳故地，幷有古徐夷之地，皆在淮北，卽楚所謂「下東國」。","note_content_jianti_auto":"湣，读曰闵。楚灭陈、蔡，封畛于汝，灭越，取吴故地，幷有古徐夷之地，皆在淮北，即楚所谓「下东国」。","note_type":"hu_note","start_index":118,"tongjian_id":"8c87204c-db0e-11ef-92ee-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":5,"tongjian_id":"8c872058-db0e-11ef-9d9b-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":20,"tongjian_id":"8c872059-db0e-11ef-85b8-a0d3651f611f"},{"people_name":"平王","people_name_jianti_auto":"平王","start_index":32,"tongjian_id":"8c87205a-db0e-11ef-a341-a0d3651f611f"},{"people_name":"子囊","people_name_jianti_auto":"子囊","start_index":99,"tongjian_id":"8c87205b-db0e-11ef-82bf-a0d3651f611f"},{"people_name":"劉昫","people_name_jianti_auto":"刘昫","start_index":107,"tongjian_id":"8c87205c-db0e-11ef-a7b4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"郢","place_name_jianti_auto":"郢","start_index":0,"tongjian_id":"8c87205d-db0e-11ef-b575-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":2,"tongjian_id":"8c87205e-db0e-11ef-a845-a0d3651f611f"},{"place_name":"南郡","place_name_jianti_auto":"南郡","start_index":8,"tongjian_id":"8c87205f-db0e-11ef-b1fb-a0d3651f611f"},{"place_name":"江陵縣","place_name_jianti_auto":"江陵县","start_index":10,"tongjian_id":"8c872060-db0e-11ef-ac27-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":15,"tongjian_id":"8c872061-db0e-11ef-b053-a0d3651f611f"},{"place_name":"郢","place_name_jianti_auto":"郢","start_index":16,"tongjian_id":"8c872062-db0e-11ef-9f66-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":19,"tongjian_id":"8c872063-db0e-11ef-b405-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","start_index":23,"tongjian_id":"8c872064-db0e-11ef-bcc3-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto"