_content":"相國之官始此，秦、漢因之；漢、魏以降，其位望尊於丞相。相，息亮翻。","note_content_jianti_auto":"相国之官始此，秦、汉因之；汉、魏以降，其位望尊于丞相。相，息亮翻。","note_type":"hu_note","start_index":42,"tongjian_id":"8c83cc9e-db0e-11ef-874a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"主父","people_name_jianti_auto":"主父","start_index":0,"tongjian_id":"8c83cca4-db0e-11ef-919b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"主父，言爲國之主之父也。一曰，言其子主國而己則父也。","note_content_jianti_auto":"主父，言为国之主之父也。一曰，言其子主国而己则父也。","note_type":"hu_note","start_index":52,"tongjian_id":"8c83cca3-db0e-11ef-88de-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賓主相見，交際之禮已，方怪其非人臣。","note_content_jianti_auto":"宾主相见，交际之礼已，方怪其非人臣。","note_type":"hu_note","start_index":129,"tongjian_id":"8c83cca7-db0e-11ef-a343-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":5,"tongjian_id":"8c83cca9-db0e-11ef-b240-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂已脫身出秦關也。","note_content_jianti_auto":"谓已脱身出秦关也。","note_type":"hu_note","start_index":151,"tongjian_id":"8c83cca8-db0e-11ef-beea-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相國","official_note":"相國是战国时期赵国的最高行政官职，相当于宰相，负责辅佐君主处理国家政务。在《资治通鉴》此段中，肥義被任命为相国，表明他在赵武灵王时期担任重要职务，协助治理国家。","official_rank":"正一品或高位","source_snippet":"肥義爲相國","start_index":34,"tongjian_id":"4ae61560-f430-4fc8-9ecd-4dcf00c866cf"}],"ExtRef_Children_people":[{"link_birth_year":-310,"link_death_year":-266,"link_td_description":"赵惠文王，亦称文王。名何，赵武灵王次子，周朝战国时期赵国君主。在位时有蔺相如、廉颇、李牧、赵奢等文武大臣，政治清明，武力强大。","link_td_id":"Q10000661","link_td_number_id":334704,"people_name":"何","people_name_jianti_auto":"何","people_xingming":"赵何","start_index":14,"tongjian_id":"8c83ccaa-db0e-11ef-a55d-a0d3651f611f"},{"link_death_year":-295,"link_td_description":"肥义，战国时代赵国大臣，历仕赵肃侯、赵武灵王、赵惠文王三代，沙丘之乱时，为保护赵惠文王而殉难。","link_td_id":"Q10004659","link_td_number_id":2818574,"people_name":"肥義","people_name_jianti_auto":"肥义","people_xingming":"肥义","start_index":32,"tongjian_id":"8c83ccab-db0e-11ef-bcfe-a0d3651f611f"},{"link_birth_year":-356,"link_death_year":-295,"link_td_description":"赵武灵王，嬴姓，赵氏，名雍，中国战国中后期赵国的君主。死后谥号武灵。","link_td_id":"Q10000536","link_td_number_id":193810,"people_name":"武靈王","people_name_jianti_auto":"武灵王","people_xingming":"赵武灵王","start_index":42,"tongjian_id":"8c86162e-db0e-11ef-b363-a0d3651f611f"},{"link_birth_year":-356,"link_death_year":-295,"link_td_description":"赵武灵王，嬴姓，赵氏，名雍，中国战国中后期赵国的君主。死后谥号武灵。","link_td_id":"Q10000536","link_td_number_id":193810,"people_name":"主父","people_name_jianti_auto":"主父","people_xingming":"赵武灵王","start_index":52,"tongjian_id":"8c861e9f-db0e-11ef-a2ae-a0d3651f611f"},{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴稷","start_index":104,"tongjian_id":"8c863266-db0e-11ef-a317-a0d3651f611f","wl_zhushi":"[嬴稷]"},{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴稷","start_index":110,"tongjian_id":"8c863267-db0e-11ef-b8e2-a0d3651f611f","wl_zhushi":"[嬴稷]"},{"link_birth_year":-356,"link_death_year":-295,"link_td_description":"赵武灵王，嬴姓，赵氏，名雍，中国战国中后期赵国的君主。死后谥号武灵。","link_td_id":"Q100