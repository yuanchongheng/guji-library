11ef-8362-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張皓見五十卷安帝延光三年。","note_content_jianti_auto":"张皓见五十卷安帝延光三年。","note_type":"hu_note","start_index":137,"tongjian_id":"9695dd27-db0e-11ef-8dd3-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷内侍","official_name":"中官","official_note":"中官指宦官，在汉代常担任宫廷内侍，此处涉及允许宦官养子继承爵位，反映宦官势力上升。","official_rank":"未知","source_snippet":"初聽中官得以養子襲爵","start_index":5,"tongjian_id":"437eb533-5b8d-44d1-93f9-a46f838c2a16"},{"confidence":0.95,"official_category":"监察","official_name":"御史","official_note":"御史是汉代监察官员，负责弹劾和进谏，此处张纲上书批评宦官滥封官爵，体现其监察职能。","official_rank":"未知","source_snippet":"御史張綱上書曰","start_index":48,"tongjian_id":"b9c45d14-2b1d-4895-bc23-bacb06bba10e"},{"confidence":0.85,"official_category":"宫廷内侍","official_name":"常侍","official_note":"常侍是汉代宦官官职，常侍从皇帝左右，此处提及文、明二帝时期常侍人数有限，以对比当前宦官泛滥。","official_rank":"未知","source_snippet":"中官常侍，不過兩人","start_index":68,"tongjian_id":"1f7b443f-d0d1-44a7-8754-83c8987c1e90"}],"ExtRef_Children_people":[{"link_birth_year":108,"link_death_year":143,"link_td_description":"张纲，字文纪，东汉犍为郡武阳（今四川省彭山东）人，张晧之子。","link_td_id":"Q10005777","link_td_number_id":3508704,"people_name":"張綱","people_name_jianti_auto":"张纲","people_xingming":"张纲","start_index":43,"tongjian_id":"9695dd2a-db0e-11ef-a9e6-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"文","people_name_jianti_auto":"文","people_xingming":"刘恒","start_index":52,"tongjian_id":"9695dd2b-db0e-11ef-894e-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":28,"link_death_year":75,"link_td_description":"汉明帝刘庄，原名刘阳，字子丽，东汉皇帝，在位十八年。谥“孝明皇帝”，后世省略“孝”字称“汉明帝”，庙号显宗。汉光武帝刘秀的第四子，母亲为光烈皇后阴丽华。","link_td_id":"Q10000366","link_td_number_id":54706,"people_name":"明","people_name_jianti_auto":"明","people_xingming":"刘庄","start_index":54,"tongjian_id":"9695dd2c-db0e-11ef-b2f9-a0d3651f611f","wl_zhushi":"[刘庄]"},{"link_birth_year":108,"link_death_year":143,"link_td_description":"张纲，字文纪，东汉犍为郡武阳（今四川省彭山东）人，张晧之子。","link_td_id":"Q10005777","link_td_number_id":3508704,"people_name":"綱","people_name_jianti_auto":"纲","people_xingming":"张纲","start_index":130,"tongjian_id":"9695dd2d-db0e-11ef-98c1-a0d3651f611f"},{"link_birth_year":50,"link_death_year":132,"link_td_description":"张晧，字叔明，犍为郡武阳（今四川省彭山东）人，东汉政治人物。张良六世孙。","link_td_id":"Q10003767","link_td_number_id":3987237,"people_name":"皓","people_name_jianti_auto":"皓","people_xingming":"张皓","start_index":132,"tongjian_id":"9695dd2e-db0e-11ef-b8c4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"2二月，丙子，初聽中官得以養子襲爵。初，帝之復位，宦官之力也，由是有寵，參與政事。御史張綱上書曰：「竊尋文、明二帝，德化尤盛，中官常侍，不過兩人，近倖賞賜，裁滿數金，惜費重民，故家給人足。而頃者以來，無功小人，皆有官爵，非愛民重器、承天順道者也。」書奏，不省。綱，皓之子也。","content_fanyi":"二月十六日丙子，开始允许宦官以养子承袭爵位。当初，汉顺帝能够恢复皇位，是靠宦官的力量；宦官因此得到宠信，得以参与朝廷政事。御史张纲上书说：“臣私下考察发现，汉文帝、汉明帝在位时，道德教化尤为隆盛，设置的宦官常侍不过两人；赏赐给亲信近臣的财物，才不过数万钱。他们爱惜费用，重视百姓，所以家家富足。可是近年来，没有功劳的小人都得到官职爵位，这不是爱惜百姓、重视国家、顺应天心的做法。”奏章呈上后，汉顺帝不加理睬。张纲是张皓的儿子。","content_jianti_auto":"2二月，丙子，初听中官得以养子袭爵。初，帝之复位，宦官之力也，由是有宠，参与政事。御史张纲上书曰：「窃寻文、明二帝，德化尤盛，中官常侍，不过两人，近幸赏赐，裁满数金，惜费重民，故家给人足。而顷者以来，无功小人，皆有官爵，非爱民重器、承天顺道者也。」书奏，不省。纲，皓之子也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4353,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9695dd20-db0e-11ef-93d2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"Ex