f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":145,"tongjian_id":"8fe1a30b-db0e-11ef-8900-a0d3651f611f"},{"place_name":"后土祠","place_name_jianti_auto":"后土祠","start_index":156,"tongjian_id":"8fe1a30c-db0e-11ef-8ed1-a0d3651f611f"},{"place_name":"汾水","place_name_jianti_auto":"汾水","start_index":231,"tongjian_id":"8fe1a30d-db0e-11ef-aab5-a0d3651f611f"},{"place_name":"泰山","place_name_jianti_auto":"泰山","start_index":244,"tongjian_id":"8fe1a30e-db0e-11ef-8569-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":249,"tongjian_id":"8fe1a30f-db0e-11ef-b9f2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙丑、前一一六）應劭曰：得寶鼎故，因是改元。考異曰：漢書·武紀，此年云「得鼎汾水上」，漢紀云「六月得寶鼎于河東汾水上，吾丘壽王對云云。」按封禪書，欒大封樂通侯之歲，其夏六月，「汾陰巫錦爲民祠魏脽后土營旁得鼎，詔曰：『間者巡祭后土云云』。」武紀：「元鼎四年，十月，幸汾陰。十一月，立后土祠於汾陰脽上。六月，得寶鼎后土祠旁。」禮樂志又云「元鼎五年得寶鼎」。恩澤侯表，「元鼎四年四月乙巳，欒大封侯。」然則得鼎應在四年。蓋武紀因今年改元而誤增此得鼎一事耳，非兩曾得鼎於汾水上也。封禪書：「天子封泰山反，至甘泉。有司言寶鼎出爲元鼎，以今年爲元封元年。」然則元鼎年號亦如建元、元光，皆後來追改之耳。","note_content_jianti_auto":"（乙丑、前一一六）应劭曰：得宝鼎故，因是改元。考异曰：汉书·武纪，此年云「得鼎汾水上」，汉纪云「六月得宝鼎于河东汾水上，吾丘寿王对云云。」按封禅书，栾大封乐通侯之岁，其夏六月，「汾阴巫锦为民祠魏脽后土营旁得鼎，诏曰：『间者巡祭后土云云』。」武纪：「元鼎四年，十月，幸汾阴。十一月，立后土祠于汾阴脽上。六月，得宝鼎后土祠旁。」礼乐志又云「元鼎五年得宝鼎」。恩泽侯表，「元鼎四年四月乙巳，栾大封侯。」然则得鼎应在四年。盖武纪因今年改元而误增此得鼎一事耳，非两曾得鼎于汾水上也。封禅书：「天子封泰山反，至甘泉。有司言宝鼎出为元鼎，以今年为元封元年。」然则元鼎年号亦如建元、元光，皆后来追改之耳。","note_type":"hu_note","start_index":0,"tongjian_id":"8fe17ba3-db0e-11ef-86c6-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1夏，五月，赦天下。","content_fanyi":"夏季，五月，大赦天下。","content_jianti_auto":"1夏，五月，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1612,"number":1,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":0,"tongjian_id":"8fe1a319-db0e-11ef-b925-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"彭離","people_name_jianti_auto":"彭离","start_index":0,"tongjian_id":"8fe1a31c-db0e-11ef-a9f3-a0d3651f611f"},{"people_name":"梁孝王","people_name_jianti_auto":"梁孝王","start_index":3,"tongjian_id":"8fe1a31d-db0e-11ef-b832-a0d3651f611f"},{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":8,"tongjian_id":"8fe1a31e-db0e-11ef-8b5e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"彭離，梁孝王子，景帝中六年受封。濟，子禮翻。悍，下罕翻；又侯旰翻。","note_content_jianti_auto":"彭离，梁孝王子，景帝中六年受封。济，子礼翻。悍，下罕翻；又侯旰翻。","note_type":"hu_note","start_index":9,"tongjian_id":"8fe1a31b-db0e-11ef-bf62-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"8fe1a320-db0e-11ef-ad10-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：以是爲好喜之事也。剽，匹妙翻，劫也。好，呼到翻。","note_content_jianti_auto":"如淳曰：以是为好喜之事也。剽，匹妙翻，劫也。好，呼到翻。","note_type":"hu_note","start_index":35,"tongjian_id":"8fe1a31f-db0e-11ef-9af0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8fe1a322-db0e-11ef-a6dd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"上庸縣","place_name_jianti_auto":"上庸县","start_index":3,"tongjian_id":"8fe1a323-db0e-11ef-b4ad-a0d3651f611f"},{"place_name":"漢中郡","place_name_jianti_auto":"汉中郡","start_index":7,"tongjian_id":"8fe1a324-db0e-11ef-aa00-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，上庸縣屬漢中郡。","note_content_jianti_auto":"班志，上庸县属汉中郡。","note_type":"hu_note","start_index":51,"tongjian_id":"8fe1a321-db0e-11ef-be0b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"刘彭离，汉朝宗室，西汉济东王。","link_td_id":"Q10012402","link_td_number_id":1474334,"people_name":"濟東王","people_name_jianti_auto":"济东王","people_xingming":"刘彭离","start_index":1,"tongjian_id":"8fe1a326-db0e-11ef-a0ca-a0d3651f611f"},{"link_td_description":"刘彭离，汉朝宗室，西汉济东王。","link_td_id":"Q10012402","link_td_number_id":1474334,"people_name":"彭離","people_name_jianti_auto":"彭离","people_xingming":"刘彭离","start_index":4,"tongjian_id":"8fe1a327-db0e-11ef-91c2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"上庸","place_name_jianti_auto":"上庸","place_note":"湖北竹山西南田家坝","resolved_place_entity_id":1539,"start_index":48,"tongjian_id":"8fe1d39a-db0e-11ef-b939-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2濟東王彭離驕悍，昏暮，與其奴、亡命少年數十人行剽殺人，取財物以爲好，所殺發覺者百餘人，坐廢，徙上庸。","content_fanyi":"济东王刘彭离骄横凶悍，每到黄昏时分，就带着家奴和亡命少年几十人抢劫杀人，夺取财物，并以此为乐；被发觉遭他杀害的有一百多人，他因此获罪被废去王爵，流放到上庸。","content_jianti_auto":"2济东王彭离骄悍，昏暮，与其奴、亡命少年数十人行剽杀人，取财物以为好，所杀发觉者百余人，坐废，徙上庸。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1613,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8fe1a31a-db0e-11ef-a8e2-a0d3651f611f"}],"reign_name":"元鼎元年","reign_name_jianti_auto":"元鼎元年","start_index":2,"tongjian_id":"8fe17ba2-db0e-11ef-964f-a0d3651f611f","year_anno":"（乙丑、前一一六）","year_int":-116},"message":"success","success":true}