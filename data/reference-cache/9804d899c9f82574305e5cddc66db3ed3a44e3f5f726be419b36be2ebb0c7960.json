{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（壬子、二九二）","note_content_jianti_auto":"（壬子、二九二）","note_type":"hu_note","start_index":0,"tongjian_id":"9d2b3cc8-db0e-11ef-9867-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"如何处置已故杨太后的后事以防其诉冤","decision_tongjian_id":"DECISION_9D2B3CC9DB0E11EF9E7EA0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"厭，益涉翻，伏也。劾，胡得翻。治鬼曰劾。","note_content_jianti_auto":"厌，益涉翻，伏也。劾，胡得翻。治鬼曰劾。","note_type":"hu_note","start_index":78,"tongjian_id":"9d2b3ccb-db0e-11ef-8c91-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":259,"link_death_year":292,"link_td_description":"杨芷，字季兰，小字男胤，弘农华阴（今陕西省华阴市）人，太尉杨震幼子杨奉的后裔，东莱太守、蓩亭侯杨众的曾孙女，太傅杨骏与嫡妻高都县君庞氏之女。杨芷是西晋晋武帝的第二任皇后、晋惠帝时期的皇太后，武元皇后杨艳堂妹。","link_td_id":"Q10004495","link_td_number_id":464682,"people_name":"楊太后","people_name_jianti_auto":"杨太后","people_xingming":"杨芷","start_index":10,"tongjian_id":"9d2b3ccc-db0e-11ef-8240-a0d3651f611f","wl_zhushi":"[杨芷]"},{"link_birth_year":257,"link_death_year":300,"link_td_description":"贾南风，小名峕，字南风。平阳郡襄陵县（今山西省襄汾县）人。西晋开国元勋贾充的三女（其后妻郭槐的長女），西晋晋惠帝的皇后，又称惠贾皇后、贾后，史書形容她外貌「黑、醜」。賈南風在皇后位置十年，其間因晉惠帝懦弱无能而得以專權，直至在政变中被皇族討伐、杀害。其专权与失势是引发八王之亂并最终导致战乱升级的导火索之一。","link_td_id":"Q10000333","link_td_number_id":116083,"people_name":"賈后","people_name_jianti_auto":"贾后","people_xingming":"贾南风","start_index":32,"tongjian_id":"9d2b3ccd-db0e-11ef-981b-a0d3651f611f","wl_zhushi":"[贾南风]"},{"link_birth_year":257,"link_death_year":300,"link_td_description":"贾南风，小名峕，字南风。平阳郡襄陵县（今山西省襄汾县）人。西晋开国元勋贾充的三女（其后妻郭槐的長女），西晋晋惠帝的皇后，又称惠贾皇后、贾后，史書形容她外貌「黑、醜」。賈南風在皇后位置十年，其間因晉惠帝懦弱无能而得以專權，直至在政变中被皇族討伐、杀害。其专权与失势是引发八王之亂并最终导致战乱升级的导火索之一。","link_td_id":"Q10000333","link_td_number_id":116083,"people_name":"賈后","people_name_jianti_auto":"贾后","start_index":45,"tongjian_id":"9d2b3ccf-db0e-11ef-8ef9-a0d3651f611f","wl_zhushi":"[贾南风]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"金墉城","place_name_jianti_auto":"金墉城","resolved_place_entity_id":914,"start_index":15,"tongjian_id":"9d2b3cce-db0e-11ef-b504-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"八王之乱","tongjian_id":"war_N0691"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"1春，二月，己酉，故楊太后卒于金墉城。是時，太后尚有侍御十餘人，賈后悉奪之，絕膳八日而卒。賈后恐太后有靈，或訴冤於先帝，乃覆而殯之，仍施諸厭劾符書、藥物等。","content_fanyi":"春季，二月己酉日，被废的杨太后在金墉城去世。此时，太后身边还有十多名侍从，贾皇后把他们全部夺走，太后绝食八天后身亡。贾皇后担心太后死后有灵，会向先帝晋武帝诉说冤屈，于是将她的尸体翻转过来殡葬，又施加各种镇邪劾鬼的符书、药物等。","content_jianti_auto":"1春，二月，己酉，故杨太后卒于金墉城。是时，太后尚有侍御十余人，贾后悉夺之，绝膳八日而卒。贾后恐太后有灵，或诉冤于先帝，乃覆而殡之，仍施诸厌劾符书、药物等。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7061,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9d2b3cc9-db0e-11ef-9e7e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2秋，八月，壬子，赦天下。","content_fanyi":"秋季，八月壬子日，大赦天下。","content_jianti_auto":"2秋，八月，壬子，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7062,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9d2b3cd0-db0e-11ef-b35d-a0d3651f611f"}],"reign_name":"二年","reign_name_jianti_auto":"二年","start_index":2,"tongjian_id":"9d2b3cc7-db0e-11ef-80a2-a0d3651f611f","year_anno":"（壬子、二九二）","year_int":292},"message":"success","success":true}