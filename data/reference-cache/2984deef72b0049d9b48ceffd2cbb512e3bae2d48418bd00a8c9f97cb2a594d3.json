{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲戌、一三四）","note_content_jianti_auto":"（甲戌、一三四）","note_type":"hu_note","start_index":0,"tongjian_id":"9693a604-db0e-11ef-941b-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"9693a608-db0e-11ef-9393-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":25,"tongjian_id":"9693a609-db0e-11ef-87a0-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十六行本「奴」下有「等」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：甲十六行本「奴」下有「等」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"9693a607-db0e-11ef-8c64-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":18,"tongjian_id":"9693a606-db0e-11ef-8035-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"司馬","official_note":"司馬是漢代軍事官職，負責軍隊指揮和作戰，此處為車師後部的司馬，率領後王加特奴攻擊北匈奴，顯示其在邊疆地區的軍事指揮角色。","official_rank":"未知","source_snippet":"車師後部司馬","start_index":8,"tongjian_id":"7927ff34-45c9-4845-a4d6-2164bcbc7a42"}],"ExtRef_Children_people":[{"people_name":"後王","people_name_jianti_auto":"后王","people_xingming":"后王","start_index":13,"tongjian_id":"9693a60b-db0e-11ef-8572-a0d3651f611f"},{"people_name":"加特奴","people_name_jianti_auto":"加特奴","people_xingming":"加特奴","start_index":15,"tongjian_id":"9693a60c-db0e-11ef-b391-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"車師後部","place_name_jianti_auto":"车师后部","resolved_place_entity_id":3174,"start_index":6,"tongjian_id":"9693a60d-db0e-11ef-b004-a0d3651f611f"},{"place_name":"北匈奴","place_name_jianti_auto":"北匈奴","resolved_place_entity_id":943,"start_index":20,"tongjian_id":"9693a60e-db0e-11ef-ade5-a0d3651f611f"},{"place_name":"閶吾陸谷","place_name_jianti_auto":"阊吾陆谷","resolved_place_entity_id":9592,"start_index":24,"tongjian_id":"9693a60f-db0e-11ef-adeb-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与西域各国的战争","tongjian_id":"war_N0614"},{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"，是也]。","context_before":"...。唐显庆初，程知节败西突厥于此。○阊吾陆谷，在庭州西北。","source_end_index":78,"source_paragraph_tongjian_id":"88112227-ebae-54f7-8b3c-1e747bc6c8e1","source_start_index":43,"source_text":"后汉阳嘉三年，车师后部司马率后王加特奴兵，掩击北匈奴于阊吾陆谷，大破之"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1夏，四月，車師後部司馬率後王加特奴掩擊北匈奴於閶吾陸谷，大破之；獲單于母。","content_fanyi":"夏季四月，汉朝驻车师后国的车师后部司马率领后国国王加特奴，在阊吾陆谷突袭北匈奴，大破北匈奴；俘获单于的母亲。","content_jianti_auto":"1夏，四月，车师后部司马率后王加特奴掩击北匈奴于阊吾陆谷，大破之；获单于母。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4345,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9693a605-db0e-11ef-ac67-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范","people_name_jianti_auto":"范","start_index":1,"tongjian_id":"9693a612-db0e-11ef-b1bd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"德陽殿","place_name_jianti_auto":"德阳殿","start_index":8,"tongjian_id":"9693a613-db0e-11ef-bd58-a0d3651f611f"},{"place_name":"北宮","place_name_jianti_auto":"北宫","start_index":12,"tongjian_id":"9693a614-db0e-11ef-b5a2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按范書·桓帝紀：德陽殿在北宮掖庭中。","note_content_jianti_auto":"按范书·桓帝纪：德阳殿在北宫掖庭中。","note_type":"hu_note","start_index":31,"tongjian_id":"9693a611-db0e-11ef-8a2c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂露坐無益。","note_content_jianti_auto":"谓露坐无益。","note_type":"hu_note","start_index":128,"tongjian_id":"9693a617-db0e-11ef-8265-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9693a619-db0e-11ef-9d8a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：緣木求魚，孟子之文。韓詩外傳曰：夫明鏡所以照形，往古所以知今。惡知往古之所以危亡，無異卻行而求達於前人也。","note_content_jianti_auto":"贤曰：缘木求鱼，孟子之文。韩诗外传曰：夫明镜所以照形，往古所以知今。恶知往古之所以危亡，无异却行而求达于前人也。","note_type":"hu_note","start_index":151,"tongjian_id":"9693a618-db0e-11ef-9349-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":29,"tongjian_id":"9693a61d-db0e-11ef-b419-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"易稽覽圖·中孚傳曰：陽感天不旋日，諸侯不旋時，大夫不過朞。鄭玄註云：陽者，天子。爲善一日，天立應以善；爲惡一日，天立應以惡。一說，不旋時立應之。重，直龍翻。傳，直戀翻。","note_content_jianti_auto":"易稽览图·中孚传曰：阳感天不旋日，诸侯不旋时，大夫不过朞。郑玄注云：阳者，天子。为善一日，天立应以善；为恶一日，天立应以恶。一说，不旋时立应之。重，直龙翻。传，直恋翻。","note_type":"hu_note","start_index":192,"tongjian_id":"9693a61c-db0e-11ef-aef3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"舉","people_name_jianti_auto":"举","start_index":0,"tongjian_id":"9693a622-db0e-11ef-9a8c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":2,"tongjian_id":"9693a623-db0e-11ef-bb78-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"舉自冀州刺史徵拜尚書。","note_content_jianti_auto":"举自冀州刺史征拜尚书。","note_type":"hu_note","start_index":257,"tongjian_id":"9693a621-db0e-11ef-a758-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"尚書","official_note":"尚書是漢代中央行政機構中的重要官職，掌管文書和政令，此處指周舉擔任尚書一職，在文中被皇帝特加策問以應對旱災。","official_rank":"未知","source_snippet":"以尚書周舉才學優深","start_index":28,"tongjian_id":"059a4c50-709a-43a4-b3c2-e252b54aac12"},{"confidence":0.85,"official_category":"宫廷事务","official_name":"太官","official_note":"太官是漢代負責宮廷膳食的官職，此處周舉建議皇帝節省太官的開支以應對旱災。","official_rank":"未知","source_snippet":"除太官重膳之費","start_index":140,"tongjian_id":"fc758503-86dc-4058-9a0f-e596372116a9"}],"ExtRef_Children_people":[{"link_death_year":149,"link_td_description":"周举，字宣光，汝南郡汝阳县（今河南省驻马店市）人。东汉光禄大夫、侍中、大鸿胪。","link_td_id":"Q10007323","link_td_number_id":5671679,"people_name":"周舉","people_name_jianti_auto":"周举","people_xingming":"周举","start_index":34,"tongjian_id":"9693a626-db0e-11ef-aa5f-a0d3651f611f"},{"link_death_year":149,"link_td_description":"周举，字宣光，汝南郡汝阳县（今河南省驻马店市）人。东汉光禄大夫、侍中、大鸿胪。","link_td_id":"Q10007323","link_td_number_id":5671679,"people_name":"舉","people_name_jianti_auto":"举","people_xingming":"周举","start_index":46,"tongjian_id":"9693a627-db0e-11ef-9714-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"文帝","people_name_jianti_auto":"文帝","people_xingming":"刘恒","start_index":67,"tongjian_id":"9693a628-db0e-11ef-9d73-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-5,"link_death_year":57,"link_td_description":"汉光武帝刘秀，字文叔，南阳郡蔡阳县人（今湖北省枣阳市），祖籍沛丰邑中阳里，东汉开国皇帝，25年8月5日至57年3月29日在位。庙号世祖，谥号光武皇帝。","link_td_id":"Q10000030","link_td_number_id":17001,"people_name":"光武","people_name_jianti_auto":"光武","people_xingming":"刘秀","start_index":70,"tongjian_id":"9693a629-db0e-11ef-9d44-a0d3651f611f","wl_zhushi":"[刘秀]"},{"link_death_year":149,"link_td_description":"周举，字宣光，汝南郡汝阳县（今河南省驻马店市）人。东汉光禄大夫、侍中、大鸿胪。","link_td_id":"Q10007323","link_td_number_id":5671679,"people_name":"舉","people_name_jianti_auto":"举","people_xingming":"周举","start_index":204,"tongjian_id":"9693a62c-db0e-11ef-80f7-a0d3651f611f"},{"link_death_year":149,"link_td_description":"周举，字宣光，汝南郡汝阳县（今河南省驻马店市）人。东汉光禄大夫、侍中、大鸿胪。","link_td_id":"Q10007323","link_td_number_id":5671679,"people_name":"舉","people_name_jianti_auto":"举","people_xingming":"周举","start_index":210,"tongjian_id":"9693a62d-db0e-11ef-8375-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"德陽殿","place_name_jianti_auto":"德阳殿","resolved_place_entity_id":3179,"start_index":23,"tongjian_id":"9693a625-db0e-11ef-83e2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":19,"start_index":78,"tongjian_id":"9693a62a-db0e-11ef-a8f5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"2五月，戊戌，詔以春夏連旱，赦天下。上親自露坐德陽殿東廂請雨。以尚書周舉才學優深，特加策問。舉對曰：「臣聞陰陽閉隔，則二氣否塞。陛下廢文帝、光武之法，而循亡秦奢侈之欲，內積怨女，外有曠夫。自枯旱以來，彌歷年歲，未聞陛下改過之效，徒勞至尊暴露風塵，誠無益也，陛下但務其華，不尋其實，猶緣木希魚，欲行求前。誠宜推信革政，崇道變惑，出後宮不御之女，除太官重膳之費。易傳曰：『陽感天不旋日。』惟陛下留神裁察！」帝復召舉面問得失，舉對以「宜愼官人，去貪汙，遠佞邪。」帝曰：「官貪汙、佞邪者爲誰乎？」對曰：「臣從下州超備機密，不足以別羣臣。然公鄕大臣數有直言者，忠貞也；阿諛苟容者，佞邪也。」","content_fanyi":"五月戊戌日，顺帝下诏，因春夏两季接连干旱，大赦天下。顺帝亲自露天坐在德阳殿东厢庭院中求雨。因尚书周举才学优异深厚，特意下策书向他询问。周举回答说：“臣听说阴阳阻隔，二气就会闭塞不通。陛下废弃了文帝、光武帝的法度，却沿袭灭亡秦朝的奢侈欲望，使宫内积聚心怀怨愤的女子，宫外则有成年不能婚配的男子。自从干旱以来，已经过了一年又一年，没有听说陛下有改过的实效，只是白白让陛下暴露在风尘之中，实在没有益处。陛下只追求表面华美，不探求实际，就像攀到树上捉鱼，想要前进却反而后退。实在应当推诚布信、改革政事，尊崇正道、改变迷乱，放出后宫未曾侍寝的女子，减省太官制作盛宴的费用。《易传》说：‘阳气感应上天，不须一天。’希望陛下留心裁断审察！”顺帝又召见周举当面询问朝政得失，周举回答说：“应当谨慎选用官员，去除贪污，疏远奸佞邪恶。”顺帝问：“官员中贪污、奸佞邪恶的人是谁？”周举回答说：“臣从地方州郡越级充任机要职位，还不足以辨别群臣。不过公卿大臣中多次敢于直言的，就是忠贞的人；阿谀奉承、苟且取容的，就是奸佞邪恶的人。”","content_jianti_auto":"2五月，戊戌，诏以春夏连旱，赦天下。上亲自露坐德阳殿东厢请雨。以尚书周举才学优深，特加策问。举对曰：「臣闻阴阳闭隔，则二气否塞。陛下废文帝、光武之法，而循亡秦奢侈之欲，内积怨女，外有旷夫。自枯旱以来，弥历年岁，未闻陛下改过之效，徒劳至尊暴露风尘，诚无益也，陛下但务其华，不寻其实，犹缘木希鱼，欲行求前。诚宜推信革政，崇道变惑，出后宫不御之女，除太官重膳之费。易传曰：『阳感天不旋日。』惟陛下留神裁察！」帝复召举面问得失，举对以「宜愼官人，去贪污，远佞邪。」帝曰：「官贪污、佞邪者为谁乎？」对曰：「臣从下州超备机密，不足以别群臣。然公鄕大臣数有直言者，忠贞也；阿谀苟容者，佞邪也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":4346,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9693a610-db0e-11ef-a7f8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周禮：王以八柄馭羣臣：一曰爵，以馭其貴；二曰祿，以馭其富；三曰予，以馭其幸；四曰置，以馭其行；五曰生，以馭其福；六曰奪，以馭其貧；七曰廢，以馭其罪；八曰誅，以馭其過。","note_content_jianti_auto":"周礼：王以八柄驭群臣：一曰爵，以驭其贵；二曰禄，以驭其富；三曰予，以驭其幸；四曰置，以驭其行；五曰生，以驭其福；六曰夺，以驭其贫；七曰废，以驭其罪；八曰诛，以驭其过。","note_type":"hu_note","start_index":88,"tongjian_id":"9693a62f-db0e-11ef-9de1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"太史令","official_note":"太史令是漢代掌管天文、曆法、占卜等事務的官員，屬於文教類職務。在《資治通鑑》此段中，張衡擔任太史令，上疏討論地震等災異現象，體現其職責涉及觀察天象和提供諮詢。此信息基於歷史常識，太史令在漢代通常隸屬於太常或類似機構。","official_rank":"未知","source_snippet":"太史令張衡亦上疏言","start_index":0,"tongjian_id":"427fc8b6-0aaf-49c2-bb86-7a90b76db1d6"}],"ExtRef_Children_people":[{"link_birth_year":78,"link_death_year":139,"link_td_description":"张衡，字平子，南阳郡西鄂县（今河南省南阳市南召县南）人，东汉士大夫、天文学家、地理学家、数学家、科学家、发明家及文学家，官至太史令、侍中、尚书。","link_td_id":"Q10000212","link_td_number_id":33296,"people_name":"張衡","people_name_jianti_auto":"张衡","people_xingming":"张衡","start_index":3,"tongjian_id":"9693a632-db0e-11ef-b89c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":13,"tongjian_id":"9693a633-db0e-11ef-814e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","权争"],"content":"太史令張衡亦上疏言：「前年京師地震土裂，裂者，威分；震者，民擾也。竊懼聖思厭倦，制不專己，恩不忍割，與衆共威。威不可分，德不可共。願陛下思惟所以稽古率舊，勿使刑德八柄不由天子，然後神望允塞，災消不至矣！」","content_fanyi":"太史令张衡也上疏说：“前年京师洛阳发生地震，土地裂开。裂开，意味着权威被分散；地震，意味着民众受到惊扰。我私下担心陛下思虑已经倦怠，政令不能由自己专断，私恩不忍割舍，而与他人共同执掌威权。威权不可分割，恩德不可共享。希望陛下思考如何考察古制、遵循旧有的典章，不要让刑、德八种权柄不掌握在天子手中；然后，神圣的威严才能得到充实，灾异才会消除，不再降临。”","content_jianti_auto":"太史令张衡亦上疏言：「前年京师地震土裂，裂者，威分；震者，民扰也。窃惧圣思厌倦，制不专己，恩不忍割，与众共威。威不可分，德不可共。愿陛下思惟所以稽古率旧，勿使刑德八柄不由天子，然后神望允塞，灾消不至矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":4347,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9693a62e-db0e-11ef-8d79-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"緯，七緯也。七緯者，易緯，稽覽圖、乾鑿度、坤靈圖、通卦驗、是類謀、辯終備也；書緯，璇璣鈐、考靈耀、刑德放、帝命驗、運期授也；詩緯，推度災、氾歷樞、含神霧也；禮緯，含文嘉、稽命徵、斗威儀也；樂緯，動聲儀、稽耀嘉、汁國徵也；孝經緯，援神契、鉤命決也；春秋緯，演孔圖、元命包、文耀鉤、運斗樞、感精符、合誠圖、考異郵、保乾圖、漢含孳、佑助期、握誠圖、潛潭巴、說題辭也。","note_content_jianti_auto":"纬，七纬也。七纬者，易纬，稽览图、干凿度、坤灵图、通卦验、是类谋、辩终备也；书纬，璇玑钤、考灵耀、刑德放、帝命验、运期授也；诗纬，推度灾、泛历枢、含神雾也；礼纬，含文嘉、稽命征、斗威仪也；乐纬，动声仪、稽耀嘉、汁国征也；孝经纬，援神契、钩命决也；春秋纬，演孔图、元命包、文耀钩、运斗枢、感精符、合诚图、考异邮、保乾图、汉含孳、佑助期、握诚图、潜潭巴、说题辞也。","note_type":"hu_note","start_index":15,"tongjian_id":"9693a635-db0e-11ef-b19b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9693a664-db0e-11ef-8de3-a0d3651f611f"},{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":6,"tongjian_id":"9693a665-db0e-11ef-9478-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"益州","place_name_jianti_auto":"益州","start_index":10,"tongjian_id":"9693a666-db0e-11ef-88c8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：前書：武帝始置益州。","note_content_jianti_auto":"贤曰：前书：武帝始置益州。","note_type":"hu_note","start_index":54,"tongjian_id":"9693a663-db0e-11ef-a61c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9693a669-db0e-11ef-9614-a0d3651f611f"},{"people_name":"成","people_name_jianti_auto":"成","start_index":3,"tongjian_id":"9693a66a-db0e-11ef-b32c-a0d3651f611f"},{"people_name":"哀","people_name_jianti_auto":"哀","start_index":5,"tongjian_id":"9693a66b-db0e-11ef-88a7-a0d3651f611f"},{"people_name":"劉向","people_name_jianti_auto":"刘向","start_index":8,"tongjian_id":"9693a66c-db0e-11ef-817e-a0d3651f611f"},{"people_name":"歆","people_name_jianti_auto":"歆","start_index":12,"tongjian_id":"9693a66d-db0e-11ef-8d82-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：成、哀時，劉向及子歆爲祕書，校定經傳、諸子等。九流，謂儒家、道家、陰陽家、法家、名家、墨家、縱橫家、雜家、農家，見藝文志；並無讖說。讖，楚譖翻。","note_content_jianti_auto":"贤曰：成、哀时，刘向及子歆为秘书，校定经传、诸子等。九流，谓儒家、道家、阴阳家、法家、名家、墨家、纵横家、杂家、农家，见艺文志；并无谶说。谶，楚谮翻。","note_type":"hu_note","start_index":74,"tongjian_id":"9693a668-db0e-11ef-b058-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":0,"tongjian_id":"9693a672-db0e-11ef-9a93-a0d3651f611f"},{"people_name":"伶倫","people_name_jianti_auto":"伶伦","start_index":3,"tongjian_id":"9693a673-db0e-11ef-a8dc-a0d3651f611f"},{"people_name":"大撓","people_name_jianti_auto":"大挠","start_index":8,"tongjian_id":"9693a674-db0e-11ef-93f7-a0d3651f611f"},{"people_name":"容成","people_name_jianti_auto":"容成","start_index":14,"tongjian_id":"9693a675-db0e-11ef-9606-a0d3651f611f"},{"people_name":"京房","people_name_jianti_auto":"京房","start_index":27,"tongjian_id":"9693a676-db0e-11ef-9525-a0d3651f611f"},{"people_name":"伏羲","people_name_jianti_auto":"伏羲","start_index":49,"tongjian_id":"9693a677-db0e-11ef-80f2-a0d3651f611f"},{"people_name":"伏羲","people_name_jianti_auto":"伏羲","start_index":87,"tongjian_id":"9693a678-db0e-11ef-aaf4-a0d3651f611f"},{"people_name":"太一","people_name_jianti_auto":"太一","start_index":144,"tongjian_id":"9693a679-db0e-11ef-95a7-a0d3651f611f"},{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":154,"tongjian_id":"9693a67a-db0e-11ef-ad06-a0d3651f611f"},{"people_name":"太一","people_name_jianti_auto":"太一","start_index":159,"tongjian_id":"9693a67b-db0e-11ef-ab9f-a0d3651f611f"},{"people_name":"太一","people_name_jianti_auto":"太一","start_index":224,"tongjian_id":"9693a67c-db0e-11ef-badf-a0d3651f611f"},{"people_name":"太一","people_name_jianti_auto":"太一","start_index":320,"tongjian_id":"9693a67d-db0e-11ef-ad62-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":360,"tongjian_id":"9693a67e-db0e-11ef-9258-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":60,"tongjian_id":"9693a67f-db0e-11ef-b6e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"黃帝命伶倫吹律，大撓作甲子，容成造曆，而律曆之學傳矣。京房分六十四卦，更直日用事，以風雨寒溫爲候。伏羲之時，龍馬負圖出於河，戴九履一，左三右七，二四爲肩，六八爲足，而五居中。伏羲觀河圖而畫八卦。陰陽家謂之九宮，一、六、八爲白，二黑、三綠、四碧、五黃、七赤、九紫，至今承用之。又易乾鑿度曰：太一取其數而行九宮。鄭玄註云：太一者，北辰神名也；下行八卦之宮，每四乃還於中央。中央者，地神之所居，故謂之九宮。天數大分以陽出，以陰入，陽起於子，陰起於午，是以太一下九宮從坎宮始。自此而從於坤宮，又自此而從於震宮，又自此而從於巽宮，所以從半矣，還息於中央之宮。旣又自此而從於乾宮，又自此而從於兌宮，又自此而從於艮宮，又自此而從於離宮，行則周矣。上遊息於太一之星，而反於紫宮。行起從坎宮始，終於離宮也。此雖緯書之說，而九宮定位則一也。賢曰：風角，謂候四方四隅之風，以占吉凶。","note_content_jianti_auto":"黄帝命伶伦吹律，大挠作甲子，容成造历，而律历之学传矣。京房分六十四卦，更直日用事，以风雨寒温为候。伏羲之时，龙马负图出于河，戴九履一，左三右七，二四为肩，六八为足，而五居中。伏羲观河图而画八卦。阴阳家谓之九宫，一、六、八为白，二黑、三绿、四碧、五黄、七赤、九紫，至今承用之。又易干凿度曰：太一取其数而行九宫。郑玄注云：太一者，北辰神名也；下行八卦之宫，每四乃还于中央。中央者，地神之所居，故谓之九宫。天数大分以阳出，以阴入，阳起于子，阴起于午，是以太一下九宫从坎宫始。自此而从于坤宫，又自此而从于震宫，又自此而从于巽宫，所以从半矣，还息于中央之宫。既又自此而从于干宫，又自此而从于兑宫，又自此而从于艮宫，又自此而从于离宫，行则周矣。上游息于太一之星，而反于紫宫。行起从坎宫始，终于离宫也。此虽纬书之说，而九宫定位则一也。贤曰：风角，谓候四方四隅之风，以占吉凶。","note_type":"hu_note","start_index":120,"tongjian_id":"9693a671-db0e-11ef-b220-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"數，所角翻；下同。","note_content_jianti_auto":"数，所角翻；下同。","note_type":"hu_note","start_index":125,"tongjian_id":"9693a684-db0e-11ef-8e92-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9693a686-db0e-11ef-a55a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：謂競稱讖家也。","note_content_jianti_auto":"贤曰：谓竞称谶家也。","note_type":"hu_note","start_index":138,"tongjian_id":"9693a685-db0e-11ef-b49e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊王","people_name_jianti_auto":"齐王","start_index":24,"tongjian_id":"9693a688-db0e-11ef-a38c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惡，烏路翻。好，呼到翻。魅，音媚。韓子曰：客有爲齊王畫者，問：「畫孰難？」對曰：「狗、馬最難。」「孰易？」曰：「鬼、魅最易。狗、馬，人所知也，故難；鬼、魅無形，故易也。」","note_content_jianti_auto":"恶，乌路翻。好，呼到翻。魅，音媚。韩子曰：客有为齐王画者，问：「画孰难？」对曰：「狗、马最难。」「孰易？」曰：「鬼、魅最易。狗、马，人所知也，故难；鬼、魅无形，故易也。」","note_type":"hu_note","start_index":165,"tongjian_id":"9693a687-db0e-11ef-b969-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":78,"link_death_year":139,"link_td_description":"张衡，字平子，南阳郡西鄂县（今河南省南阳市南召县南）人，东汉士大夫、天文学家、地理学家、数学家、科学家、发明家及文学家，官至太史令、侍中、尚书。","link_td_id":"Q10000212","link_td_number_id":33296,"people_name":"衡","people_name_jianti_auto":"衡","people_xingming":"张衡","start_index":0,"tongjian_id":"9695dcec-db0e-11ef-afab-a0d3651f611f"},{"link_birth_year":-507,"link_death_year":-444,"link_td_description":"公输班，姬姓公输氏，名班，字依智，春秋末叶著名工匠家，被后世尊为中国工匠师祖。","link_td_id":"Q10000277","link_td_number_id":23678,"people_name":"公輸班","people_name_jianti_auto":"公输班","people_xingming":"公输班","start_index":26,"tongjian_id":"9695dcee-db0e-11ef-a45a-a0d3651f611f"},{"link_birth_year":-468,"link_death_year":-376,"link_td_description":"墨子，子姓，墨氏，名翟，春秋末战国初期宋国（今河南商丘）人，一说鲁国（今山东滕州木石鎮）人，是中国著名思想家、科学家、教育家、军事家、通才。","link_td_id":"Q10000006","link_td_number_id":5850,"people_name":"墨翟","people_name_jianti_auto":"墨翟","people_xingming":"墨翟","start_index":30,"tongjian_id":"9695dcef-db0e-11ef-ab28-a0d3651f611f"},{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"劉向","people_name_jianti_auto":"刘向","people_xingming":"刘向","start_index":55,"tongjian_id":"9695dcf5-db0e-11ef-9a8e-a0d3651f611f"},{"link_birth_year":-25,"link_death_year":-1,"link_td_description":"汉哀帝刘欣，汉朝皇帝，在位6年，其正式谥号为“孝哀皇帝”，后世省略“孝”字称“汉哀帝”。刘欣是汉元帝孙，汉成帝弟定陶恭王刘康之子，母丁氏。","link_td_id":"Q10000834","link_td_number_id":39803,"people_name":"哀","people_name_jianti_auto":"哀","people_xingming":"刘欣","start_index":80,"tongjian_id":"9695dcf7-db0e-11ef-b9e7-a0d3651f611f","wl_zhushi":"[刘欣]"},{"link_birth_year":-9,"link_death_year":6,"link_td_description":"汉平帝刘衎，原名刘箕子，后改名衎，汉朝皇帝（公元前1年10月17日－公元6年2月3日在位），其正式谥号为“孝平皇帝”，后世省略“孝”字称“汉平帝”。","link_td_id":"Q10000138","link_td_number_id":84032,"people_name":"平","people_name_jianti_auto":"平","start_index":82,"tongjian_id":"9695dcf8-db0e-11ef-a53f-a0d3651f611f","wl_zhushi":"[刘箕子•刘衎]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"戰國","place_name_jianti_auto":"战国","resolved_place_entity_id":1860,"start_index":35,"tongjian_id":"9695dcf0-db0e-11ef-9137-a0d3651f611f"},{"place_name":"益州","place_name_jianti_auto":"益州","resolved_place_entity_id":204,"start_index":42,"tongjian_id":"9695dcf1-db0e-11ef-84dd-a0d3651f611f"},{"place_name":"益州","place_name_jianti_auto":"益州","resolved_place_entity_id":204,"start_index":45,"tongjian_id":"9695dcf2-db0e-11ef-8435-a0d3651f611f"},{"place_name":"漢世","place_name_jianti_auto":"汉世","resolved_place_entity_id":9,"start_index":51,"tongjian_id":"9695dcf3-db0e-11ef-850a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/小学不讲","excerpts":[{"context_after":"许叔重收集篆、籀、古文诸家之学，就隶为训注，谓之《说文》...","context_before":"...字，乃得为吏。以六体试之。吏人上书，字或不正，辄有举劾。","source_end_index":108,"source_paragraph_tongjian_id":"6eeaa165-5472-4a2d-a739-f63b60128f7b","source_start_index":75,"source_text":"刘子政父子校中秘书，自《史籀》以下凡十家，序为小学，次于六艺之末。"}],"path":"四笔/卷十二/小学不讲","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"衡又以中興之後，儒者爭學圖緯，上疏言：「春秋元命包有公輸班與墨翟，事見戰國；又言別有益州，益州之置在於漢世。又劉向父子領校祕書，閱定九流，亦無讖錄。則知圖讖成於哀、平之際，皆虛僞之徒以要世取資，欺罔較然，莫之糾禁。且律曆、卦候、九宮、風角，數有徵效，世莫肯學，而競稱不占之書，譬猶畫工惡圖犬馬而好作鬼魅，誠以實事難形而虛僞不窮也！宜收藏圖讖，一禁絕之，則朱紫無所眩，典籍無瑕玷矣！」","content_fanyi":"张衡又因中兴以后，儒生们争相学习图谶纬书，上疏说：“《春秋元命包》里记有公输班和墨翟，他们的事迹见于战国；又说别有益州，而益州是到了汉代才设置的。又刘向、刘歆父子主持校理皇家图书，审定九流时，也没有谶录。由此可知，图谶形成于哀帝、平帝之际，都是虚伪之徒用来迎合世俗、骗取名利，欺骗蒙蔽已很明显，却无人加以纠察禁止。况且律历、卦候、九宫、风角，屡有应验，世人却不肯学习，反而争相称扬不可占验之书，就像画工厌恶画狗马而喜好画鬼魅，确是因为实际事物难以描绘，而虚假的东西没有穷尽。应当把图谶全部收缴、一律禁绝，那么朱色与紫色就不会混淆，典籍也不会有污点了。”","content_jianti_auto":"衡又以中兴之后，儒者争学图纬，上疏言：「春秋元命包有公输班与墨翟，事见战国；又言别有益州，益州之置在于汉世。又刘向父子领校秘书，阅定九流，亦无谶录。则知图谶成于哀、平之际，皆虚伪之徒以要世取资，欺罔较然，莫之纠禁。且律历、卦候、九宫、风角，数有征效，世莫肯学，而竞称不占之书，譬犹画工恶图犬马而好作鬼魅，诚以实事难形而虚伪不穷也！宜收藏图谶，一禁绝之，则朱紫无所眩，典籍无瑕玷矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":4348,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"9693a634-db0e-11ef-a733-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"校尉","official_note":"校尉是汉代军事官职，负责统领军队或特定任务，此处指马贤曾任校尉，后受命为谒者。","official_rank":"未知","source_snippet":"前校尉馬賢","start_index":18,"tongjian_id":"2e186f19-9e0f-4a3b-8d0a-35d2ad601b81"},{"confidence":0.85,"official_category":"中枢近臣","official_name":"謁者","official_note":"谒者是汉代官职，负责传达诏命或礼仪事务，此处表示马贤被任命为谒者以镇抚羌族。","official_rank":"未知","source_snippet":"詔拜前校尉馬賢爲謁者","start_index":21,"tongjian_id":"ee9ec48d-f639-47f7-a22d-d04773880c22"},{"confidence":0.95,"official_category":"军事指挥","official_name":"護羌校尉","official_note":"护羌校尉是汉代专门负责羌族事务的军事官职，此处指马续派遣军队攻击良封。","official_rank":"未知","source_snippet":"護羌校尉馬續","start_index":33,"tongjian_id":"99296ff9-e10a-49cd-90bc-21db6f5da5e8"}],"ExtRef_Children_people":[{"people_name":"良封","people_name_jianti_auto":"良封","people_xingming":"良封","start_index":8,"tongjian_id":"9695dcfe-db0e-11ef-a48b-a0d3651f611f"},{"link_death_year":141,"link_td_description":"马贤，东汉将领、官员。马贤初任骑都尉，后历任护羌校尉、弘农太守、征西将军。马贤在担任护羌校尉期间，多次击败羌人各部落，为陇右、凉州地区安定巨大贡献。","link_td_id":"Q10016947","link_td_number_id":4472671,"people_name":"馬賢","people_name_jianti_auto":"马贤","people_xingming":"马贤","start_index":24,"tongjian_id":"9695dd02-db0e-11ef-b161-a0d3651f611f"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"马续，东汉军事人物，马援侄孙，马融之兄，拜护羌都尉。","link_t