y":"中枢机构","official_name":"司空","official_note":"司空是汉代三公之一，负责水土工程和监察，此处孔扶被免职，与司徒刘崎一同因周举之言被罢免。","official_rank":"正一品","source_snippet":"司空孔扶免","start_index":13,"tongjian_id":"b62b9eca-6613-45b9-9622-0fcff142c880"},{"confidence":0.95,"official_category":"财政","official_name":"大司農","official_note":"大司农是汉代九卿之一，掌管国家财政和粮食，此处黄尚由大司农升任司徒，显示官职晋升。","official_rank":"正二品","source_snippet":"以大司農黃尚爲司徒","start_index":28,"tongjian_id":"f76f8f82-ff17-4092-b5e1-d240dcc523a4"},{"confidence":0.95,"official_category":"中枢近臣","official_name":"光祿勳","official_note":"光禄勋是汉代九卿之一，负责宫廷侍卫和礼仪，此处王卓由光禄勋升任司空，反映了朝廷官员的调动。","official_rank":"正二品","source_snippet":"光祿勳河東王卓爲司空","start_index":38,"tongjian_id":"d239828c-dccb-4605-bd45-a3d477379166"}],"ExtRef_Children_people":[{"people_name":"劉崎","people_name_jianti_auto":"刘崎","people_xingming":"刘崎","start_index":10,"tongjian_id":"9695dd08-db0e-11ef-b46f-a0d3651f611f"},{"link_td_description":"孔扶，表字仲渊，鲁国（今山东省曲阜市）人，东汉时期的大臣。孔扶是孔子的十九代孙。官至太常。汉顺帝阳嘉二年（133年）六月初二被任命为司空，阳嘉三年（134年）十一月十一被免职。","link_td_id":"Q10007273","link_td_number_id":5292456,"people_name":"孔扶","people_name_jianti_auto":"孔扶","people_xingming":"孔扶","start_index":15,"tongjian_id":"9695dd09-db0e-11ef-808d-a0d3651f611f"},{"link_death_year":149,"link_td_description":"周举，字宣光，汝南郡汝阳县（今河南省驻马店市）人。东汉光禄大夫、侍中、大鸿胪。","link_td_id":"Q10007323","link_td_number_id":5671679,"people_name":"周舉","people_name_jianti_auto":"周举","people_xingming":"周举","start_index":20,"tongjian_id":"9695dd0a-db0e-11ef-8d54-a0d3651f611f"},{"link_td_description":"黄尚，字伯河，南郡邔县（今湖北省宜城市）人。中国东汉时期官员，官至司徒。","link_td_id":"Q10007292","link_td_number_id":3745332,"people_name":"黃尚","people_name_jianti_auto":"黄尚","people_xingming":"黄尚","start_index":33,"tongjian_id":"9695dd0b-db0e-11ef-bce9-a0d3651f611f"},{"link_death_year":137,"link_td_description":"王卓，字仲辽，河东郡解县（今山西省临猗县东南）人，东汉时期的大臣。","link_td_id":"Q10003900","link_td_number_id":5214848,"people_name":"王卓","people_name_jianti_auto":"王卓","people_xingming":"王卓","start_index":44,"tongjian_id":"9695dd0c-db0e-11ef-8