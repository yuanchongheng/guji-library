{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丙寅、前二三五）","note_content_jianti_auto":"（丙寅、前二三五）","note_type":"hu_note","start_index":0,"tongjian_id":"8d4b74cb-db0e-11ef-a91d-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鴆鳥出南方，噉蝮蛇，以其羽畫酒中，飲之立死。酖，直禁翻。","note_content_jianti_auto":"鸩鸟出南方，噉蝮蛇，以其羽画酒中，饮之立死。酖，直禁翻。","note_type":"hu_note","start_index":8,"tongjian_id":"8d4b74cd-db0e-11ef-8195-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"文信侯","official_note":"文信侯是吕不韦的封爵，在秦朝属于高级爵位，此处指吕不韦因政治斗争被赐死，反映了秦朝中央集权下的权力清洗。","official_rank":"侯爵","source_snippet":"文信侯飲酖死","start_index":1,"tongjian_id":"5e3fe7f6-e661-4bb5-b808-07b121f669c5"}],"ExtRef_Children_people":[{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"文信侯","people_name_jianti_auto":"文信侯","people_xingming":"吕不韦","start_index":1,"tongjian_id":"8d4b74d0-db0e-11ef-95cb-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-238,"link_td_description":"嫪毐，战国末年秦国人，长信侯，秦始皇母亲赵姬的情夫，冒充宦官与赵姬通奸生子，后欲发动兵变以杀秦王政，事败，被灭族。","link_td_id":"Q10008196","link_td_number_id":134607,"people_name":"嫪毐","people_name_jianti_auto":"嫪毐","people_xingming":"嫪毐","start_index":37,"tongjian_id":"8d4b74d1-db0e-11ef-a949-a0d3651f611f"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"不韋","people_name_jianti_auto":"不韦","people_xingming":"吕不韦","start_index":40,"tongjian_id":"8d4b74d2-db0e-11ef-b82a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"1文信侯飲酖死，竊葬。其舍人臨者，皆逐遷之。且曰：「自今以來，操國事不道如嫪毐、不韋者，籍其門，視此！」","content_fanyi":"秦国文信侯吕不韦饮毒酒自杀身亡，他的家人偷偷将他埋葬。秦王政下令，吕不韦的舍人凡参加哭吊的，一律驱逐、迁徙出境；并且说：“从今以后，操持国政而不守正道、如同嫪毐、吕不韦那样淫乱无道的，将其家族财产全部没收入官，照此办理！”","content_jianti_auto":"1文信侯饮酖死，窃葬。其舍人临者，皆逐迁之。且曰：「自今以来，操国事不道如嫪毐、不韦者，籍其门，视此！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":503,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d4b74cc-db0e-11ef-929e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"穿，穿壁；窬，穿牆。窬，音諭，又音俞。","note_content_jianti_auto":"穿，穿壁；窬，穿墙。窬，音谕，又音俞。","note_type":"hu_note","start_index":52,"tongjian_id":"8d4b74d4-db0e-11ef-812f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":10,"tongjian_id":"8d4b74d6-db0e-11ef-90d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「擔」，亦作「儋」，齊人名小罌爲儋，音都濫翻。石，斗石也。罌，於耕翻。","note_content_jianti_auto":"「担」，亦作「儋」，齐人名小罂为儋，音都滥翻。石，斗石也。罂，于耕翻。","note_type":"hu_note","start_index":63,"tongjian_id":"8d4b74d5-db0e-11ef-9fc5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-53,"link_death_year":18,"link_td_description":"扬雄，字子云，姓名又作杨雄，蜀郡成都（今四川成都郫都区）人，西汉哲学家、文学家、语言学家。","link_td_id":"Q10000105","link_td_number_id":68672,"people_name":"揚子","people_name_jianti_auto":"扬子","people_xingming":"扬雄","start_index":0,"tongjian_id":"8d4b74d7-db0e-11ef-a233-a0d3651f611f"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"呂不韋","people_name_jianti_auto":"吕不韦","people_xingming":"吕不韦","start_index":10,"tongjian_id":"8d4b74d8-db0e-11ef-adb0-a0d3651f611f"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"不韋","people_name_jianti_auto":"不韦","people_xingming":"吕不韦","start_index":29,"tongjian_id":"8d4b74d9-db0e-11ef-9f6c-a0d3651f611f"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"呂不韋","people_name_jianti_auto":"吕不韦","people_xingming":"吕不韦","start_index":40,"tongjian_id":"8d4b74da-db0e-11ef-98a0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雒陽","place_name_jianti_auto":"雒阳","resolved_place_entity_id":56,"start_index":65,"tongjian_id":"8d4b74dc-db0e-11ef-a386-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"揚子法言曰：或問：「呂不韋其智矣乎？以人易貨。」曰：「誰謂不韋智者歟！以國易宗。呂不韋之盜，穿窬之雄乎！穿窬也者，吾見擔石矣，未見雒陽也。」","content_fanyi":"扬雄《法言》说：“有人问：‘吕不韦聪明吗？拿人当货物，进行交易。’回答说：‘谁说吕不韦是聪明人啊！用封国换取了宗族的灭亡。吕不韦这个窃贼，是穿墙行窃的奸雄啊！穿墙行窃的人，我见过偷取一担一石小财物的，没见过偷取洛阳的。’”","content_jianti_auto":"扬子法言曰：或问：「吕不韦其智矣乎？以人易货。」曰：「谁谓不韦智者欤！以国易宗。吕不韦之盗，穿窬之雄乎！穿窬也者，吾见担石矣，未见雒阳也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":504,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8d4b74d3-db0e-11ef-a007-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2自六月不雨，至于八月。","content_fanyi":"秦国从六月起，直到八月，一直没有下雨。","content_jianti_auto":"2自六月不雨，至于八月。","dtjl_paragraph_links":[],"dtjl_references":[],"id":505,"number":2,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8d4b74dd-db0e-11ef-a552-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","start_index":1,"tongjian_id":"8d4b74e0-db0e-11ef-82bb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"發關東四郡兵也。","note_content_jianti_auto":"发关东四郡兵也。","note_type":"hu_note","start_index":10,"tongjian_id":"8d4b74df-db0e-11ef-a5bc-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"都大梁，河南开封","resolved_place_entity_id":1,"start_index":6,"tongjian_id":"8d4b74e1-db0e-11ef-a7d9-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，安徽寿县","resolved_place_entity_id":130,"start_index":8,"tongjian_id":"8d4b74e2-db0e-11ef-95e4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"3發四郡兵助魏伐楚。","content_fanyi":"秦国征发四个郡的兵力，援助魏国讨伐楚国。","content_jianti_auto":"3发四郡兵助魏伐楚。","dtjl_paragraph_links":[],"dtjl_references":[],"id":506,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8d4b74de-db0e-11ef-a6a8-a0d3651f611f"}],"reign_name":"十二年","reign_name_jianti_auto":"十二年","start_index":11,"tongjian_id":"8d4b74ca-db0e-11ef-afd7-a0d3651f611f","year_anno":"（丙寅、前二三五）","year_int":-235},"message":"success","success":true}