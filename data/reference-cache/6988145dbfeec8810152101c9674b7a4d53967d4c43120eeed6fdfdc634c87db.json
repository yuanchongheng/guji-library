Ref_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c4b8524a-db0e-11ef-b081-a0d3651f611f","pinyin":"kuí","source_anchor_text":"司馬溫裕戣之兄子也","source_key":"baiyang_epub","start_index":47,"text":"戣","tongjian_id":"f3390c4e-e665-5c0e-a739-e75b5df12056"}],"ExtRef_Children_places":[{"place_name":"党項","place_name_jianti_auto":"党项","place_note":"陕西省北部","resolved_place_entity_id":345,"start_index":1,"tongjian_id":"c4b85251-db0e-11ef-aacd-a0d3651f611f"},{"place_name":"柳州","place_name_jianti_auto":"柳州","place_note":"广西柳州市","resolved_place_entity_id":2444,"start_index":39,"tongjian_id":"c4b85252-db0e-11ef-b97d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"7党項爲邊患，發諸道兵討之，連年無功，戍饋不已；右補闕孔溫裕上疏切諫，上怒，貶柳州司馬。溫裕，戣之兄子也。","content_fanyi":"党项成为唐朝边境的祸患，朝廷征发诸道军队讨伐他们，连年没有功绩，戍边所需的粮饷运输也一直不停；右补阙孔温裕上疏恳切劝谏，皇上发怒，将他贬为柳州司马。温裕，是孔戣兄长的儿子。","content_jianti_auto":"7党项为边患，发诸道兵讨之，连年无功，戍馈不已；右补阙孔温裕上疏切谏，上怒，贬柳州司马。温裕，戣之兄子也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25356,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"c4b8524a-db0e-11ef-b081-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"左南津","place_name_jianti_auto":"左南津","start_index":4,"tongjian_id":"c4b85255-db0e-11ef-999a-a0d3651f611f"},{"place_name":"白土城","place_name_jianti_auto":"白土城","start_index":12,"tongjian_id":"c4b85256-db0e-11ef-b8bb-a0d3651f611f"},{"place_name":"白土川水","place_name_jianti_auto":"白土川水","start_index":20,"tongjian_id":"c4b85257-db0e-11ef-81e7-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":28,"tongjian_id":"c4b85258-db0e-11ef-9e50-a0d3651f611f"},{"place_name":"河州","place_name