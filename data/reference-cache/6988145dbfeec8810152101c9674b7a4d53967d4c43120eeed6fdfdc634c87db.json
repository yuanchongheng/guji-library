-8f64-a0d3651f611f"},{"place_name":"鄯州","place_name_jianti_auto":"鄯州","resolved_place_entity_id":1212,"start_index":197,"tongjian_id":"c4b8528a-db0e-11ef-a22a-a0d3651f611f"},{"place_name":"瓜州","place_name_jianti_auto":"瓜州","place_note":"甘肃省安西县","resolved_place_entity_id":1407,"start_index":210,"tongjian_id":"c4b8528b-db0e-11ef-bc28-a0d3651f611f"},{"place_name":"鄯州","place_name_jianti_auto":"鄯州","resolved_place_entity_id":1212,"start_index":217,"tongjian_id":"c4b8528d-db0e-11ef-bbd4-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","resolved_place_entity_id":214,"start_index":223,"tongjian_id":"c4b8528e-db0e-11ef-9d42-a0d3651f611f"},{"place_name":"鄯","place_name_jianti_auto":"鄯","resolved_place_entity_id":1212,"start_index":225,"tongjian_id":"c4b8528f-db0e-11ef-b8a4-a0d3651f611f"},{"place_name":"廓","place_name_jianti_auto":"廓","place_note":"青海省化隆县","resolved_place_entity_id":2270,"start_index":227,"tongjian_id":"c4b85290-db0e-11ef-9083-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、临洮府（卷六十）","excerpts":[{"context_after":"胡氏曰：关在河州界。又河蓝关，亦在州西北，近黄河岸。《唐...","context_before":"鸡项关[在州西北。","source_end_index":41,"source_paragraph_tongjian_id":"96c3ae43-0a67-5ca4-9d41-4616ec5048b3","source_start_index":9,"source_text":"唐大中四年，吐蕃叛将论恐热遣兵于鸡项关南造桥，以击尚婢婢于鄯州。"}],"path":"陕西方舆纪要/九、临洮府（卷六十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"氂牛峡，在临番西北。○白水城，在临番西六十里。唐开元五年...","context_before":"...志》：河源军西六十里有临番军，盖开元中所置，后没于吐蕃。","source_end_index":90,"source_paragraph_tongjian_id":"c4285d57-1a58-5d5f-85a9-e3a8cfb85971","source_start_index":38,"source_text":"大中四年，吐蕃鄯州刺史尚婢婢遣兵据临番城，拒叛将论恐热于白土岭，不利。复遣将据氂牛峡以拒之，为恐热所败。"},{"context_after":"胡氏曰：岭在河州凤林县西。○星岭，在故龙支城西北。隋大业...","context_before":"...即此。姐，音子。又白土岭，在卫东南，岭盖与白土故城相近。","source_end_index":158,"source_paragraph_tongjian_id":"ce7880c1-505b-510b-b44a-114c861a954a","source_start_index":131,"source_text":"唐大中四年，吐蕃叛将论恐热遣兵击鄯州帅尚婢婢于白土岭。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"8吐蕃論恐熱遣僧莽羅藺眞將兵於雞項關南造橋，以擊尚婢婢，軍於白土嶺。婢婢遣其將尚鐸羅榻藏將兵據臨蕃軍以拒之，不利，復遣磨離羆子、燭盧鞏力將兵據氂牛峽以拒之。鞏力請「按兵拒險，勿與戰，以奇兵絕其糧道，使進不得戰，退不得還，不過旬月，其衆必潰。」羆子不從。鞏力曰：「吾寧爲不用之人，不爲敗軍之將。」稱疾，歸鄯州。羆子逆戰，敗死。婢婢糧乏，留拓跋懷光守鄯州，帥部落三千餘人就水草於甘州西。恐熱聞婢婢棄鄯州，自將輕騎五千追之，至瓜州，聞懷光守鄯州，遂大掠河西鄯、廓等八州，殺其丁壯，劓刖其羸老及婦人，以槊貫嬰兒爲戲，焚其室廬，五千里間，赤地殆盡。","content_fanyi":"吐蕃论恐热派遣僧人莽罗蔺真率兵在鸡项关南面架桥，用来进攻尚婢婢，并驻军于白土岭。尚婢婢派部将尚铎罗榻藏率兵据守临蕃军进行抵抗，作战失利，又派磨离罴子、烛卢巩力率兵据守氂牛峡进行抵御。烛卢巩力请求说：“按兵不动，凭险拒守，不要与敌军交战，另派奇兵截断敌军粮道，使他们进不能战，退不能还，不出一个月，其部众必定溃散。”磨离罴子不听从。烛卢巩力说：“我宁肯做个不被任用的人，也不做败军之将。”于是称病返回鄯州。磨离罴子迎战，战败而死。尚婢婢粮食匮乏，留下拓跋怀光守卫鄯州，自己率领部落三千余人到甘州西边逐水草就食。论恐热听说尚婢婢放弃鄯州，亲自率领五千轻骑追赶，到达瓜州时，听说拓跋怀光守卫鄯州，于是在河西的鄯州、廓州等八州大肆抢掠，杀死当地丁壮，将老弱和妇女割鼻断足，用长矛刺穿婴儿取乐，焚烧百姓房屋，河西五千里范围内几乎全成赤地。","content_jianti_auto":"8吐蕃论恐热遣僧莽罗蔺真将兵于鸡项关南造桥，以击尚婢婢，军于白土岭。婢婢遣其将尚铎罗榻藏将兵据临蕃军以拒之，不利，复遣磨离罴子、烛卢巩力将兵据牦牛峡以拒之。巩力请「按兵拒险，勿与战，以奇兵绝其粮道，使进不得战，退不得还，不过旬月，其众必溃。」罴子不从。巩力曰：「吾宁为不用之人，不为败军之将。」称疾，归鄯州。罴子逆战，败死。婢婢粮乏，留拓跋怀光守鄯州，帅部落三千余人就水草于甘州西。恐热闻婢婢弃鄯州，自将轻骑五千追之，至瓜州，闻怀光守鄯州，遂大掠河西鄯、廓等八州，杀其丁壮，劓刖其羸老及妇人，以槊贯婴儿为戏，焚其室庐，五千里间，赤地殆尽。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25357,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"c4b85253-db0e-11ef-9236-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊紀在十一月。今從實錄、新紀。","note_content_jianti_auto":"考异曰：旧纪在十一月。今从实录、新纪。","note_type":"hu_note","start_index":29,"tongjian_id":"c4bab5da-db0e-11ef-9956-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"翰林學士承旨","official_note":"翰林學士承旨是唐代翰林院的高级官职，负责起草诏令和参与机密事务，此处表示令狐綯在担任此职。","official_rank":"未知","source_snippet":"翰林學士承旨","start_index":9,"tongjian_id":"b0c55d7f-4b48-48d4-b5f5-963f630ad098"},{"confidence":0.9,"official_category":"军事指挥","official_name":"兵部侍郞","official_note":"兵部侍郞是唐代兵部的副长官，协助兵部尚书管理军事事务，此处表示令狐綯兼任此职。","official_rank":"正四品下","source_snippet":"兵部侍郞","start_index":16,"tongjian_id":"eef02b04-1b28-4776-a433-03facdc8840f"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代的宰相官职，参与国家最高决策，此处表示令狐綯被任命为此职。","official_rank":"宰相级","source_snippet":"同平章事","start_index":22,"tongjian_id":"d42a1825-da24-41dd-b782-401eaf9021ce"}],"ExtRef_Children_people":[{"link_birth_year":795,"link_death_year":872,"link_td_description":"令狐绹，字子直，晚唐政治家。","link_td_id":"Q10005004","link_td_number_id":283585,"people_name":"令狐綯","people_name_jianti_auto":"令狐绹","people_xingming":"令狐綯","start_index":21,"tongjian_id":"c4bab5df-db0e-11ef-b388-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"9冬，十月，辛未，以翰林學士承旨、兵部侍郞令狐綯同平章事。","content_fanyi":"冬季，十月，辛未日，朝廷任命翰林学士承旨、兵部侍郎令狐绹为同平章事。","content_jianti_auto":"9冬，十月，辛未，以翰林学士承旨、兵部侍郞令狐绹同平章事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25358,"number":9,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":8,"tongjian_id":"c4bab5d9-db0e-11ef-a1ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"翰林學士","official_note":"翰林學士是唐代中樞機構中的文職官員，負責起草詔書、參與機要，常為皇帝近臣。在《資治通鑑》此段中，劉瑑原任翰林學士，後被任命為京西招討党項行營宣慰使，顯示其從文職轉為軍事或地方宣慰職務。","official_rank":"未知","source_snippet":"翰林學士劉瑑","start_index":10,"tongjian_id":"02dc9298-012a-4316-b408-1eccbee1a7d1"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"京西招討党項行營宣慰使","official_note":"京西招討党項行營宣慰使是唐代為應對党項族