8-db0e-11ef-9ac4-a0d3651f611f"},{"people_name":"張允伸","people_name_jianti_auto":"张允伸","start_index":55,"tongjian_id":"c4b85239-db0e-11ef-8c24-a0d3651f611f"},{"people_name":"張允伸","people_name_jianti_auto":"张允伸","start_index":78,"tongjian_id":"c4b8523a-db0e-11ef-9708-a0d3651f611f"},{"people_name":"周綝","people_name_jianti_auto":"周𬘭","start_index":102,"tongjian_id":"c4b8523b-db0e-11ef-923a-a0d3651f611f"},{"people_name":"允伸","people_name_jianti_auto":"允伸","start_index":108,"tongjian_id":"c4b8523c-db0e-11ef-86dc-a0d3651f611f"},{"people_name":"周綝","people_name_jianti_auto":"周𬘭","start_index":136,"tongjian_id":"c4b8523d-db0e-11ef-98f6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"幽州","place_name_jianti_auto":"幽州","start_index":43,"tongjian_id":"c4b8523e-db0e-11ef-8c08-a0d3651f611f"},{"place_name":"幽州","place_name_jianti_auto":"幽州","start_index":70,"tongjian_id":"c4b8523f-db0e-11ef-a66e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：四年七月，周綝薨，張允伸爲留後。註曰：舊紀亦無朝廷命綝爲節度使年月。至此但云「幽州節度使周綝卒，軍人立張允伸爲留後。」實錄：「九月，幽州大將表請押衙張允伸知留後事。」舊·允伸傳曰：「大中四年，戎帥周綝寢疾，表允伸爲留後。朝廷可其奏。」今參取之。註曰：今按通鑑書八月周綝薨。考異以爲七月。","note_content_jianti_auto":"考异曰：四年七月，周𬘭薨，张允伸为留后。注曰：旧纪亦无朝廷命𬘭为节度使年月。至此但云「幽州节度使周𬘭卒，军人立张允伸为留后。」实录：「九月，幽州大将表请押衙张允伸知留后事。」旧·允伸传曰：「大中四年，戎帅周𬘭寝疾，表允伸为留后。朝廷可其奏。」今参取之。注曰：今按通鉴书八月周𬘭薨。考异以为七月。","note_type":"hu_note","start_index":41,"tongjian_id":"c4b85234-db0e-11ef-8b10-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"盧龍節度使","official_note":"盧龍節度使是唐朝在河北地區設置的節度使，掌管盧龍地區的軍政大權，此處指周綝擔任此職並去世。","official_rank":"正三品","source_snippet":"盧龍節度使周綝薨","start_index":0,"tongjian_id":"63d2638e-478a-46c0-91f1-1d13a59bb877"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"押牙","official_note":"押牙是唐朝節度使屬下的武官，負責管理軍隊事務，此處張允伸兼任此職。","official_rank":"未知","source_snippet":"押牙兼馬步都知兵馬使張允伸","start_index":18,"tongjian_id":"570dbe6f-93d0-4d51-b7f2-581cd45da3f3"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"馬步都知兵馬使","official_note":"馬步都知兵馬使是節度使屬下的高級武官，統領步兵和騎兵，此處張允伸兼任此職。","official_rank":"未知","source_snippet":"押牙兼馬步都知兵馬使張允伸","start_index":21,"tongjian_id":"7a0f3810-3348-404b-b1a7-13435902332c"},{"confidence":0.9,"official_category":"地方行政","official_name":"留後","official_note":"留後是唐朝節度使去世或離職後，由軍中推舉的臨時代理職務，此處指張允伸被推舉為盧龍節度使的代理。","official_rank":"未知","source_snippet":"張允伸爲留後","start_index":30,"tongjian_id":"ee829567-4c36-41c5-9d17-a81f79571033"}],"ExtRef_Children_people":[{"link_death_year":850,"link_td_description":"周綝，唐朝军事人物。","link_td_id":"Q10012157","link_td_number_id":1449159,"people_name":"周綝","people_name_jianti_auto":"周𬘭","people_xingming":"周綝","start_index":6,"tongjian_id":"c4b85247-db0e-11ef-b032-a0d3651f611f"},{"link_birth_year":785,"link_death_year":872,"link_td_description":"张允伸，字逢昌，幽州范阳（今北京城西南）人。唐朝幽州节度使，封爵燕国公，谥忠烈。","link_td_id":"Q10002675","link_td_number_id":1449158,"people_name":"張允伸","people_name_jianti_auto":"张允伸","people_xingming":"张允伸","start_index":25,"tongjian_id":"c4b85248-db0e-11ef-9096-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"盧龍","place_name_jianti_auto":"卢龙","place_note":"总部设幽州【北京市】","resolved_place_entity_id":431,"start_index":1,"tongjian_id":"c4b85249-db0e-11ef-9954-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"6盧龍節度使周綝薨，軍中表請以押牙兼馬步都知兵馬使張允伸爲留後，九月，丁酉，從之。","content_fanyi":"卢龙节度使周綝去世，军中上表请求任命押牙兼马步都知兵马使张允伸为留后，九月丁酉日，皇上批准了这一请求。","content_jianti_auto":"6卢龙节度使周𬘭薨，军中表请以押牙兼马步都知兵马使张允伸为留后，九月，丁酉，从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25355,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"c4b85233-db0e-11ef-868c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef