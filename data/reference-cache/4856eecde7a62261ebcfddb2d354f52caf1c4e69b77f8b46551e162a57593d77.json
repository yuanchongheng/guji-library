政"],"content":"7閏月，辛酉，北宮東掖庭永巷署災。","content_fanyi":"闰九月辛酉日，洛阳北宫东掖庭永巷署失火。","content_jianti_auto":"7闰月，辛酉，北宫东掖庭永巷署灾。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4971,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"97a058ee-db0e-11ef-98b4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁","people_name_jianti_auto":"袁","start_index":4,"tongjian_id":"97a058f2-db0e-11ef-aa19-a0d3651f611f"},{"people_name":"楊賜","people_name_jianti_auto":"杨赐","start_index":13,"tongjian_id":"97a058f3-db0e-11ef-9f41-a0d3651f611f"},{"people_name":"陳耽","people_name_jianti_auto":"陈耽","start_index":22,"tongjian_id":"97a058f4-db0e-11ef-b0b0-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":48,"tongjian_id":"97a058f5-db0e-11ef-9974-a0d3651f611f"},{"people_name":"范","people_name_jianti_auto":"范","start_index":68,"tongjian_id":"97a058f6-db0e-11ef-acb9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：袁紀：「三年閏月，楊賜久病罷。十月，陳耽爲司徒。」蓋誤置閏於去年。按長曆，此年閏十月，以袁紀考之，閏九月爲是，恐長曆差一月。今從范書·帝紀。","note_content_jianti_auto":"考异曰：袁纪：「三年闰月，杨赐久病罢。十月，陈耽为司徒。」盖误置闰于去年。按长历，此年闰十月，以袁纪考之，闰九月为是，恐长历差一月。今从范书·帝纪。","note_type":"hu_note","start_index":20,"tongjian_id":"97a058f1-db0e-11ef-a243-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是东汉三公之一，负责民政和教化，此处表示杨赐被罢免司徒职务。","official_rank":"正一品","source_snippet":"司徒楊賜罷","start_index":0,"tongjian_id":"a6b1d803-d754-4ca6-bda3-58011872cdd8"},{"confidence":0.95,"official_category":"文教","official_name":"太常","official_note":"太常是九卿之一，掌管宗庙礼仪和祭祀，此处表示陈耽从太常升任为司徒。","official_rank":"正三品","source_snippet":"太常陳耽爲司徒","start_index":11,"tongjian_id":"65458a04-18eb-49f4-9597-9ddf35b5c644"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是东汉三公之一，负责民政和教化，此处表示陈耽被任命为司徒。","official_rank":"正一品","source_snippet":"太常陳耽爲司徒","start_index":16,"tongjian_id":"9dda8716-c0cd-4d3c-8473-3e1eb48b0215"}],"ExtRef_Children_people":[{"link_death_year":185,"link_td_description":"杨赐，字伯献，弘农郡华阴县人，东汉大臣，出身自东汉世族“弘农杨氏”，祖父杨震，父亲杨秉，杨赐以及儿子杨彪皆位至太尉，时人有“四世太尉”之称。","link_td_id":"Q10007282","link_td_number_id":4560049,"people_name":"楊賜","people_name_jianti_auto":"杨赐","people_xingming":"杨赐","start_index":3,"tongjian_id":"97a058fd-db0e-11ef-95fb-a0d3651f611f"},{"link_death_year":185,"link_td_description":"陈耽，字汉公，东海（今山东郯城北）人，汉灵帝时以忠著称，历位三司。因进言帝十常侍祸国殃民，下狱，与刘陶俱遭十常侍谋杀。","link_td_id":"Q10007252","link_td_number_id":887355,"people_name":"陳耽","people_name_jianti_auto":"陈耽","people_xingming":"陈耽","start_index":14,"tongjian_id":"97a058fe-db0e-11ef-a15f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"8司徒楊賜罷；冬，十月，太常陳耽爲司徒。","content_fanyi":"司徒杨赐被罢免；冬季十月，太常陈耽出任司徒。","content_jianti_auto":"8司徒杨赐罢；冬，十月，太常陈耽为司徒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4972,"number":8,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":7,"tongjian_id":"97a058f0-db0e-11ef-a2e4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":136,"link_death_year":181,"link_td_description":"檀石槐，是中国东汉时期的鲜卑首领之一。","link_td_id":"Q10008747","link_td_number_id":375777,"people_name":"檀石槐","people_name_jianti_auto":"檀石槐","people_xingming":"檀石槐","start_index":10,"tongjian_id":"97a05902-db0e-11ef-a2c8-a0d3651f611f"},{"link_td_description":"和连，鲜卑人，是活跃于二世纪末的其中一位鲜卑部落首领。","link_td_