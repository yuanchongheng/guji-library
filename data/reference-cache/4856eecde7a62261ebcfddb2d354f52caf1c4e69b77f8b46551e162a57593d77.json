f-b7ab-a0d3651f611f"},{"place_name":"幽","place_name_jianti_auto":"幽","resolved_place_entity_id":102,"start_index":4,"tongjian_id":"97a05906-db0e-11ef-b9b3-a0d3651f611f"},{"place_name":"幷","place_name_jianti_auto":"幷","resolved_place_entity_id":186,"start_index":6,"tongjian_id":"97a05907-db0e-11ef-a34b-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","resolved_place_entity_id":457,"start_index":35,"tongjian_id":"97a05908-db0e-11ef-be47-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","resolved_place_entity_id":457,"start_index":38,"tongjian_id":"97a05909-db0e-11ef-8337-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与鲜卑的战争","tongjian_id":"war_N0613"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","内政"],"content":"9鮮卑寇幽、幷二州。檀石槐死，子和連代立。和連才力不及父而貪淫，後出攻北地，北地人射殺之。其子騫曼尚幼，兄子魁頭立。後騫曼長大，與魁頭爭國，衆遂離散。魁頭死，弟步度根立。","content_fanyi":"鲜卑侵犯幽、并二州。鲜卑首领檀石槐去世，其子和连继位。和连的才能与勇力不如父亲，而且贪婪淫乱，后来出兵攻打北地，被北地人射杀。他的儿子骞曼年纪尚幼，便由他哥哥的儿子魁头继立。后来骞曼长大，与魁头争夺首领之位，部众因此离散。魁头死后，其弟步度根继立。","content_jianti_auto":"9鲜卑寇幽、幷二州。檀石槐死，子和连代立。和连才力不及父而贪淫，后出攻北地，北地人射杀之。其子骞曼尚幼，兄子魁头立。后骞曼长大，与魁头争国，众遂离散。魁头死，弟步度根立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4973,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"97a058ff-db0e-11ef-93ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"著，陟略翻；下同。賈，音古。","note_content_jianti_auto":"著，陟略翻；下同。贾，音古。","note_type":"hu_note","start_index":33,"tongjian_id":"97a05912-db0e-11ef-a9c3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97a05915-db0e-11ef-b94f-a0d3651f611f"},{"people_name":"靈帝","people_name_jianti_auto":"灵帝","start_index":36,"tongjian_id":"97a05916-db0e-11ef-852c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：三禮圖曰：進賢冠，文官服之，前高七寸，後高三寸，長八寸。續漢志曰：靈帝寵用便嬖子弟，轉相汲引，賣關內侯，直五百萬。強者貪如豺狼，弱者略不類物，眞狗而冠也。綬，音受。","note_content_jianti_auto":"贤曰：三礼图曰：进贤冠，文官服之，前高七寸，后高三寸，长八寸。续汉志曰：灵帝宠用便嬖子弟，转相汲引，卖关内侯，直五百万。强者贪如豺狼，弱者略不类物，真狗而冠也。绶，音受。","note_type":"hu_note","start_index":55,"tongjian_id":"97a05914-db0e-11ef-98d5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"續漢志曰：驢者，乃服重致遠，上下山谷，野人之所用耳，何有帝王君子而驂駕之乎！天意若曰，國且大亂，賢愚倒植，凡執政者皆如驢也。操，千高翻。","note_content_jianti_auto":"续汉志曰：驴者，乃服重致远，上下山谷，野人之所用耳，何有帝王君子而骖驾之乎！天意若曰，国且大乱，贤愚倒植，凡执政者皆如驴也。操，千高翻。","note_type":"hu_note","start_index":71,"tongjian_id":"97a05919-db0e-11ef-aaf7-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"進賢冠","official_note":"進賢冠是漢代官員的禮冠，象徵文官身份，常用於朝會或正式場合。在《資治通鑑》此段中，描述漢靈帝在西園弄狗時戴著進賢冠，這是一種諷刺性的描寫，顯示皇帝行為失當，不尊重官職禮儀。此信息基於歷史常識，進賢冠在漢代為文官冠飾。","official_rank":"未知","source_snippet":"著進賢冠","start_index":48,"tongjian_id":"93670613-442a-4489-9e2a-e5ce456aa910"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西園","place_name_jianti_auto":"西园","resolved_place_entity_id":2189,"start_index":42,"tongjian_id":"97a0591b-db0e-11ef-92bb-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":71,"tongjian_id":"97a0591c-db0e-11ef-bc0f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"10是歲，帝作列肆於後宮，使諸采女販賣，更相盜竊爭鬭；帝著商賈服，從之飲宴爲樂。又於西園弄狗，著進賢冠，帶綬。又駕四驢，帝躬自操轡，驅馳周旋；京師轉相倣效，驢價遂與馬齊。","content_fanyi":"这一年，灵帝在后宫开设了许多店铺，让众多采女在其中贩卖物品，她们互相偷盗、争斗；灵帝穿上商贾的衣服，和她们一起饮酒宴乐。他又在西园玩狗，给狗戴上文官所戴的进贤冠，系上绶带；又用四头驴驾车，灵帝亲自握着缰绳，在园中驱车奔驰绕圈；京城洛阳的人纷纷互相仿效，驴价于是与马价相等。","content_jianti_auto":"10是岁，帝作列肆于后宫，使诸采女贩卖，更相盗窃争鬭；帝著商贾服，从之饮宴为乐。又于西园弄狗，著进贤冠，带绶。又驾四驴，帝躬自操辔，驱驰周旋；京师转相倣效，驴价遂与马齐。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4974,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"97a05910-db0e-11ef-b6dd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"好，呼倒翻。稸，與蓄同。","note_content_jianti_auto":"好，呼倒翻。稸，与蓄同。","note_type":"hu_note","start_index":6,"tongjian_id":"97a0591e-db0e-11ef-88f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97a05920-db0e-11ef-83a4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：中署，內署也。導，引也。貢獻外別有所入，以爲所獻希之導引也。","note_content_jianti_auto":"贤曰：中署，内署也。导，引也。贡献外别有所入，以为所献希之导引也。","note_type":"hu_note","start_index":32,"tongjian_id":"97a0591f-db0e-11ef-825e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97a05922-db0e-11ef-8b08-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：萬物稟陰陽而生。","note_content_jianti_auto":"贤曰：万物禀阴阳而生。","note_type":"hu_note","start_index":55,"tongjian_id":"97a05921-db0e-11ef-940b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"中尚方、中御府，皆屬少府，天子私藏也。繒，慈陵翻。","note_content_jianti_auto":"中尚方、中御府，皆属少府，天子私藏也。缯，慈陵翻。","note_type":"hu_note","start_index":85,"tongjian_id":"97a05923-db0e-11ef-9773-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"中廏，卽騄驥廏。","note_content_jianti_auto":"中廏，即𫘧骥廏。","note_type":"hu_note","start_index":101,"tongjian_id":"97a05924-db0e-11ef-a4fb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三府選其人而舉之；尚書受其奏以進御。","note_content_jianti_auto":"三府选其人而举之；尚书受其奏以进御。","note_type":"hu_note","start_index":176,"tongjian_id":"97a05927-db0e-11ef-8a2b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詔用者，不由三公、尚書，徑以詔書用之也。","note_content_jianti_auto":"诏用者，不由三公、尚书，径以诏书用之也。","note_type":"hu_note","start_index":262,"tongjian_id":"97a0592b-db0e-11ef-a6d9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢近臣","official_name":"中常侍","official_note":"中常侍是东汉时期的宦官官职，负责侍从皇帝、传达诏令，常参与朝政。在上下文中，吕强作为中常侍上疏谏言，反映了宦官在政治中的角色。","official_rank":"未知","source_snippet":"中常侍呂強上疏諫曰","start_index":38,"tongjian_id":"1c429523-3e92-47e7-8d8e-bb7d65210496"},{"confidence":0.9,"official_category":"中枢机构","official_name":"尚書","official_note":"尚书是汉代中央行政机构的重要官职，负责处理文书、奏章等事务。在上下文中，尚书被提及为选举制度中的一环，负责接收奏章。","official_rank":"未知","source_snippet":"尚書受奏御而已","start_index":176,"tongjian_id":"33061720-f1eb-44cd-9eb2-1a7ed8b28fd5"},{"confidence":0.9,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是汉代最高司法官员，负责审理案件和覆核虚实。在上下文中，廷尉被提及为选举制度中处理罪罚的机构。","official_rank":"未知","source_snippet":"請下廷尉覆按虛實","start_index":194,"tongjian_id":"40f2f63b-c579-4d9b-b1d4-f855467e5c0a"},{"confidence":0.85,"official_category":"中枢机构","official_name":"三公","official_note":"三公是汉代最高行政长官，通常指太尉、司徒、司空，负责国家政务。在上下文中，三公被提及为选举制度中的负责机构。","official_rank":"未知","source_snippet":"於是三公每有所選","start_index":210,"tongjian_id":"f745f5d6-5203-4abd-8b02-f1f40e3b68d3"}],"ExtRef_Children_people":[{"link_death_year":184,"link_td_description":"吕强，字汉盛，河南成皋（今河南荥阳）人，东汉时的宦官。","link_td_id":"Q10007646","link_td_number_id":1056082,"people_name":"呂強","people_name_jianti_auto":"吕强","people_xingming":"吕强","start_index":35,"tongjian_id":"97a0592d-db0e-11ef-b036-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西園","place_name_jianti_auto":"西园","resolved_place_entity_id":2189,"start_index":85,"tongjian_id":"97a2a287-db0e-11ef-bc5e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"帝好爲私稸，收天下之珍貨，每郡國貢獻，先輸中署，名爲「導行費」。中常侍呂強上疏諫曰：「天下之財，莫不生之陰陽，歸之陛下，豈有公私！而今中尚方斂諸郡之寶，中御府積天下之繒，西園引司農之藏，中廏聚太僕之馬，而所輸之府，輒有導行之財，調廣民困，費多獻少，姦吏因其利，百姓受其敝。又，阿媚之臣，好獻其私，容諂姑息，自此而進。舊典：選舉委任三府，尚書受奏御而已；受試任用，責以成功，功無可察，然後付之尚書舉劾，請下廷尉覆按虛實，行其罪罰；於是三公每有所選，參議掾屬，咨其行狀，度其器能；然猶有曠職廢官，荒穢不治。今但任尚書，或有詔用，如是，三公得免選舉之負，尚書亦復不坐，責賞無歸，豈肯空自勞苦乎！」書奏，不省。","content_fanyi":"灵帝喜欢积蓄私人财物，收集天下的珍宝奇货，每逢各郡、国进贡，都先选出一部分贡品送入中署，称为“导行费”。中常侍吕强上疏劝谏说：“天下的财物，无不产生于阴阳，全部归陛下所有，难道还有公私之分！而今中尚方搜敛各郡的珍宝，中御府聚积天下出产的缯帛，西园调用本该由大司农掌管的库藏，中厩聚集本该由太仆管理的马匹，而各地向朝廷输送贡品时，又总要另缴导行费；征调增多，百姓穷困，耗费多而贡物少，奸吏借此获利，百姓受其损害。加之阿谀献媚的臣子，喜欢进献私人财物，陛下容忍谄媚、一味姑息，这些人由此得以进用。按照旧有制度：选拔和委任官员由三府负责，尚书只是接受奏章呈报皇帝而已；经过试用后加以任用，要求他们取得政绩，如果没有政绩可以考察，然后交给尚书检举弹劾，再请求交付廷尉审察虚实，执行惩罚；因此三公每逢选拔人才，都要与掾属商议，询问其品行事迹，衡量其才干能力；即使如此，仍有旷废官职、政事荒废而不能治理的现象。如今只由尚书负责选拔官员，有时还由诏书直接任用，这样，三公可以免除选举不当的责任，尚书也不再因此获罪，责罚与赏赐都无人承担，谁还肯白白劳苦呢！”奏疏呈上，灵帝不予省察。","content_jianti_auto":"帝好为私稸，收天下之珍货，每郡国贡献，先输中署，名为「导行费」。中常侍吕强上疏谏曰：「天下之财，莫不生之阴阳，归之陛下，岂有公私！而今中尚方敛诸郡之宝，中御府积天下之缯，西园引司农之藏，中廏聚太仆之马，而所输之府，辄有导行之财，调广民困，费多献少，奸吏因其利，百姓受其敝。又，阿媚之臣，好献其私，容谄姑息，自此而进。旧典：选举委任三府，尚书受奏御而已；受试任用，责以成功，功无可察，然后付之尚书举劾，请下廷尉复按虚实，行其罪罚；于是三公每有所选，参议掾属，咨其行状，度其器能；然犹有旷职废官，荒秽不治。今但任尚书，或有诏用，如是，三公得免选举之负，尚书亦复不坐，责赏无归，岂肯空自劳苦乎！」书奏，不省。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4975,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"97a0591d-db0e-11ef-9027-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":150,"link_death_year":189,"link_td_description":"灵思皇后，何姓，真名失传。东汉灵帝第二任皇后。何进异母妹，何苗同母妹。另有一妹为张让儿媳（或为张奉妻）。","link_td_id":"Q10000847","link_td_number_id":378955,"people_name":"何皇后","people_name_jianti_auto":"何皇后","people_xingming":"何皇后","start_index":2,"tongjian_id":"97a2a289-db0e-11ef-93a1-a0d3651f611f"},{"people_name":"王美人","people_name_jianti_auto":"王美人","people_xingming":"王美人","start_index":11,"tongjian_id":"97a2a28a-db0e-11ef-a14f-a0d3651f611f"},{"link_birth_year":181,"link_death_year":234,"link_td_description":"汉献帝刘协，字伯和，司隶雒阳人。刘协是东汉皇帝，汉灵帝刘宏之子、后少帝刘辩之弟。189年至220年在位，是东汉乃至汉朝的最后一任皇帝。","link_td_id":"Q10000125","link_td_number_id":15855,"people_name":"協","people_name_jianti_auto":"协","people_xingming":"刘协","start_index":17,"tongjian_id":"97a2a28b-db0e-11ef-8821-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97a2a288-db0e-11ef-9e18-a0d3651f611f","pinyin":"zhèn","source_anchor_text":"皇子協后酖殺美人帝","source_key":"baiyang_epub","start_index":20,"text":"酖","tongjian_id":"517da738-8701-59b9-b799-fd65b2457612"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"11何皇后性強忌，後宮王美人生皇子協，后酖殺美人。帝大怒，欲廢后；諸中官固請，得止。","content_fanyi":"何皇后生性强悍而嫉妒，后宫王美人生下皇子刘协，皇后便用毒酒毒死了王美人。灵帝大怒，打算废黜皇后；众宦官坚持请求，灵帝才作罢。","content_jianti_auto":"11何皇后性强忌，后宫王美人生皇子协，后酖杀美人。帝大怒，欲废后；诸中官固请，得止。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4976,"number":11,"reading_annotation_sources":[],"start_index":11,"tongjian_id":"97a2a288-db0e-11ef-9e18-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"華容縣","place_name_jianti_auto":"华容县","start_index":0,"tongjian_id":"97a2a28e-db0e-11ef-966f-a0d3651f611f"},{"place_name":"南郡","place_name_jianti_auto":"南郡","start_index":5,"tongjian_id":"97a2a28f-db0e-11ef-91cd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"華容縣，屬南郡。","note_content_jianti_auto":"华容县，属南郡。","note_type":"hu_note","start_index":12,"tongjian_id":"97a2a28d-db0e-11ef-aead-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"宫廷内侍","official_name":"大長秋","official_note":"大長秋是漢代皇后宮中的高級宦官官職，負責管理皇后宮中事務，此處曹節擔任此職，趙忠接替。","official_rank":"未知","source_snippet":"大長秋華容侯曹節卒；中常侍趙忠代領大長秋。","start_index":2,"tongjian_id":"b3037294-209c-4ddb-9688-fec009e3155c"},{"confidence":0.95,"official_category":"宫廷内侍","official_name":"中常侍","official_note":"中常侍是漢代皇帝身邊的宦官官職，負責傳達詔令和侍從皇帝，此處趙忠以此職代領大長秋。","official_rank":"未知","source_snippet":"中常侍趙忠代領大長秋。","start_index":15,"tongjian_id":"916fd1cf-ad44-47e9-8bab-744062adc207"}],"ExtRef_Children_people":[{"link_death_year":181,"link_td_description":"曹节，字汉丰，南阳郡新野县人，是汉灵帝时有权势的宦官，曾参与诛杀窦武、陈蕃。","lin