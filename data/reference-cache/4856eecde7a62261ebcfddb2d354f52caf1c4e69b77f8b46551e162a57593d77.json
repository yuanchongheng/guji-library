{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛酉、一八一）","note_content_jianti_auto":"（辛酉、一八一）","note_type":"hu_note","start_index":0,"tongjian_id":"97a058c8-db0e-11ef-92df-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97a058cb-db0e-11ef-b330-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：騄驥，善馬也。調，謂徵發也。調，徒釣翻；下同。","note_content_jianti_auto":"贤曰：𫘧骥，善马也。调，谓征发也。调，徒钓翻；下同。","note_type":"hu_note","start_index":20,"tongjian_id":"97a058ca-db0e-11ef-b5fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"前書音義曰：辜，障也。榷，專也。謂障餘人買賣而自取其利。榷，古岳翻。","note_content_jianti_auto":"前书音义曰：辜，障也。榷，专也。谓障余人买卖而自取其利。榷，古岳翻。","note_type":"hu_note","start_index":25,"tongjian_id":"97a058cc-db0e-11ef-85c9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"财政","official_name":"騄驥廏丞","official_note":"騄驥廏丞是东汉光和四年新设的官职，负责管理騄驥廏（皇家马厩），并领受郡国调马，用于宫廷或军事用途。在上下文中，此官职的设立与豪右辜榷（权贵垄断）导致马价高涨有关，反映了当时马政管理的调整。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"初置騄驥廏丞","start_index":5,"tongjian_id":"d40ad7ce-e216-41d7-8bc4-dc5e73d1109c"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97a058c9-db0e-11ef-aa44-a0d3651f611f","pinyin":"lù","source_anchor_text":"正月初置騄驥厩丞領","source_key":"baiyang_epub","start_index":8,"text":"騄","tongjian_id":"88087d7c-581e-5b47-8800-4256262d12e9"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97a058c9-db0e-11ef-aa44-a0d3651f611f","pinyin":"jì","source_anchor_text":"月初置騄驥厩丞領受","source_key":"baiyang_epub","start_index":9,"text":"驥","tongjian_id":"1e937150-6ec3-5dbb-8bdb-cddd60229ac4"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97a058c9-db0e-11ef-aa44-a0d3651f611f","pinyin":"què","source_anchor_text":"馬豪右辜榷馬一匹至","source_key":"baiyang_epub","start_index":23,"text":"榷","tongjian_id":"0ff81b17-dd62-572f-9c9e-2cda335b732c"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，初置騄驥廏丞，領受郡國調馬。豪右辜榷，馬一匹至二百萬。","content_fanyi":"春季，正月，初次设置騄骥厩丞，负责接收并饲养各郡、国征调来的马匹。豪强垄断马匹买卖，一匹马的价格高达二百万钱。","content_jianti_auto":"1春，正月，初置𫘧骥廏丞，领受郡国调马。豪右辜榷，马一匹至二百万。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4965,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"97a058c9-db0e-11ef-aa44-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2夏，四月，庚子，赦天下。","content_fanyi":"夏季，四月，庚子日，大赦天下。","content_jianti_auto":"2夏，四月，庚子，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4966,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"97a058ce-db0e-11ef-a497-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"烏滸蠻","place_name_jianti_auto":"乌浒蛮","start_index":0,"tongjian_id":"97a058d1-db0e-11ef-afcb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"烏滸蠻反事始上卷光和元年。滸，呼古翻。","note_content_jianti_auto":"乌浒蛮反事始上卷光和元年。浒，呼古翻。","note_type":"hu_note","start_index":10,"tongjian_id":"97a058d0-db0e-11ef-b780-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蘭陵縣","place_name_jianti_auto":"兰陵县","start_index":0,"tongjian_id":"97a058d4-db0e-11ef-aea7-a0d3651f611f"},{"place_name":"東海郡","place_name_jianti_auto":"东海郡","start_index":5,"tongjian_id":"97a058d5-db0e-11ef-a412-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蘭陵縣，屬東海郡。會，古外翻。","note_content_jianti_auto":"兰陵县，属东海郡。会，古外翻。","note_type":"hu_note","start_index":45,"tongjian_id":"97a058d3-db0e-11ef-b4b8-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"牧守","official_note":"牧守泛指州牧和郡守，是汉代地方行政长官，负责治理地方、维护治安。在上下文中，指交趾地区的官员未能平定叛乱，导致局势恶化。","official_rank":"未知","source_snippet":"牧守不能禁","start_index":12,"tongjian_id":"d62f813c-5f1c-4fd8-b3ba-6daf7e9036f0"},{"confidence":0.95,"official_category":"地方行政","official_name":"蘭陵令","official_note":"蘭陵令是兰陵县的县令，汉代县级行政长官，负责管理地方事务。在上下文中，朱儁原任此职，后被任命为交趾刺史去平定叛乱。","official_rank":"未知","source_snippet":"詔拜蘭陵令會稽朱儁爲交趾刺史","start_index":28,"tongjian_id":"3171a43c-5e63-4742-8dd7-95cc8e1ffbe6"},{"confidence":0.95,"official_category":"地方行政","official_name":"交趾刺史","official_note":"交趾刺史是汉代交趾地区的监察和行政长官，负责监督地方官员、处理政务。在上下文中，朱儁被任命此职以平定梁龙叛乱，并成功完成任务。","official_rank":"未知","source_snippet":"詔拜蘭陵令會稽朱儁爲交趾刺史","start_index":35,"tongjian_id":"e8d89a3a-18ef-43e2-b61d-82ba96c37c40"},{"confidence":0.9,"official_category":"封爵","official_name":"都亭侯","official_note":"都亭侯是汉代的一种侯爵封号，属于列侯，通常授予有功之臣以示奖赏。在上下文中，朱儁因平定叛乱有功而被封此爵。","official_rank":"侯爵","source_snippet":"以功封都亭侯","start_index":58,"tongjian_id":"3c2b25c2-a579-4a52-bc39-715508afc07d"},{"confidence":0.95,"official_category":"文教/谏官","official_name":"諫議大夫","official_note":"諫議大夫是汉代中央官职，负责向皇帝进谏、议论朝政，属于文官系统。在上下文中，朱儁因功被征召担任此职，表示其晋升至中央机构。","official_rank":"未知","source_snippet":"徵爲諫議大夫","start_index":64,"tongjian_id":"3d2c0152-3581-4bab-8551-22629ce1829d"}],"ExtRef_Children_people":[{"people_name":"梁龍","people_name_jianti_auto":"梁龙","people_xingming":"梁龙","start_index":19,"tongjian_id":"97a058d9-db0e-11ef-9134-a0d3651f611f"},{"link_death_year":195,"link_td_description":"朱儁，字公伟，会稽郡上虞县人（今浙江省绍兴市境）。中国东汉末年将领，曾领兵平定东汉末交趾的民变以及黄巾之乱。","link_td_id":"Q10000966","link_td_number_id":505228,"people_name":"朱儁","people_name_jianti_auto":"朱俊","people_xingming":"朱儁","start_index":37,"tongjian_id":"97a058db-db0e-11ef-bf44-a0d3651f611f"},{"people_name":"梁龍","people_name_jianti_auto":"梁龙","people_xingming":"梁龙","start_index":47,"tongjian_id":"97a058df-db0e-11ef-98d0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"交趾","place_name_jianti_auto":"交趾","resolved_place_entity_id":578,"start_index":1,"tongjian_id":"97a058d7-db0e-11ef-bacb-a0d3651f611f"},{"place_name":"烏滸蠻","place_name_jianti_auto":"乌浒蛮","resolved_place_entity_id":4986,"start_index":3,"tongjian_id":"97a058d8-db0e-11ef-95b0-a0d3651f611f"},{"place_name":"交趾","place_name_jianti_auto":"交趾","resolved_place_entity_id":578,"start_index":16,"tongjian_id":"97a058da-db0e-11ef-bbf9-a0d3651f611f"},{"place_name":"蘭陵","place_name_jianti_auto":"兰陵","resolved_place_entity_id":1084,"start_index":32,"tongjian_id":"97a058dc-db0e-11ef-b94b-a0d3651f611f"},{"place_name":"會稽","place_name_jianti_auto":"会稽","resolved_place_entity_id":285,"start_index":35,"tongjian_id":"97a058dd-db0e-11ef-82e3-a0d3651f611f"},{"place_name":"交趾","place_name_jianti_auto":"交趾","resolved_place_entity_id":578,"start_index":40,"tongjian_id":"97a058de-db0e-11ef-907b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/七、南宁府（卷一百十）","excerpts":[{"context_after":"盖是时乌浒于诸种蛮为最盛也。杜佑曰：乌浒在南海之西南、安...","context_before":"...。后汉建兴三年，郁林太守谷永招降乌浦人十余万，开置七县。","source_end_index":77,"source_paragraph_tongjian_id":"a03946c1-ae6a-5df3-b9bf-cf3fd419fa34","source_start_index":51,"source_text":"熹平末，合浦、交趾乌浦蛮反。光和四年，刺史朱㒞破之。"}],"path":"广西方舆纪要/七、南宁府（卷一百十）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"3交趾烏滸蠻久爲亂，牧守不能禁，交趾人梁龍等復反，攻破郡縣。詔拜蘭陵令會稽朱儁爲交趾刺史，擊斬梁龍，降者數萬人，旬月盡定；以功封都亭侯，徵爲諫議大夫。","content_fanyi":"交趾的乌浒蛮作乱已久，州牧、郡守都无法制止。交趾人梁龙等又起兵反叛，攻破郡县。灵帝下诏任命兰陵令、会稽人朱儁为交趾刺史。朱儁率兵进击，斩杀梁龙，投降者有数万人，不到一个月便全部平定；他因功被封为都亭侯，并被征召入朝任谏议大夫。","content_jianti_auto":"3交趾乌浒蛮久为乱，牧守不能禁，交趾人梁龙等复反，攻破郡县。诏拜兰陵令会稽朱俊为交趾刺史，击斩梁龙，降者数万人，旬月尽定；以功封都亭侯，征为谏议大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4967,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"97a058cf-db0e-11ef-a2c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4六月，庚辰，雨雹如雞子。","content_fanyi":"六月庚辰日，下起了鸡蛋大小的冰雹。","content_jianti_auto":"4六月，庚辰，雨雹如鸡子。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4968,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"97a058e0-db0e-11ef-b959-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5秋，九月，庚寅朔，日有食之。","content_fanyi":"秋季九月庚寅朔日，发生了日食。","content_jianti_auto":"5秋，九月，庚寅朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4969,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"97a058e2-db0e-11ef-9390-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁","people_name_jianti_auto":"袁","start_index":10,"tongjian_id":"97a058e5-db0e-11ef-954c-a0d3651f611f"},{"people_name":"許郁","people_name_jianti_auto":"许郁","start_index":17,"tongjian_id":"97a058e6-db0e-11ef-b48e-a0d3651f611f"},{"people_name":"楊賜","people_name_jianti_auto":"杨赐","start_index":27,"tongjian_id":"97a058e7-db0e-11ef-a767-a0d3651f611f"},{"people_name":"范","people_name_jianti_auto":"范","start_index":36,"tongjian_id":"97a058e8-db0e-11ef-ab08-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"𢒰，於六翻。考異曰：袁紀：「十月，許郁坐辟召錯繆，免。楊賜爲太尉。」今從范書。","note_content_jianti_auto":"𢒰，于六翻。考异曰：袁纪：「十月，许郁坐辟召错缪，免。杨赐为太尉。」今从范书。","note_type":"hu_note","start_index":15,"tongjian_id":"97a058e4-db0e-11ef-9930-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处表示刘宽被免去太尉职务。","official_rank":"正一品","source_snippet":"太尉劉寬免","start_index":0,"tongjian_id":"2ecae79e-4670-45a0-9589-1ff53dc6b935"},{"confidence":0.95,"official_category":"军事指挥","official_name":"衞尉","official_note":"衞尉是汉代九卿之一，掌管宫门警卫，此处表示许𢒰从衞尉升任太尉。","official_rank":"正三品","source_snippet":"衞尉許𢒰爲太尉","start_index":6,"tongjian_id":"b2bad85c-26ef-4229-be19-d57948b7c9c4"},{"confidence":0.95,"of