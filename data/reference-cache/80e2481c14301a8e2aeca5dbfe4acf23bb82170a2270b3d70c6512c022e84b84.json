_entity_id":101,"start_index":47,"tongjian_id":"8d443718-db0e-11ef-bba5-a0d3651f611f"},{"place_name":"安陽","place_name_jianti_auto":"安阳","place_note":"河南安陽","resolved_place_entity_id":1379,"start_index":49,"tongjian_id":"8d443719-db0e-11ef-8905-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"邺之战 (前236年)","tongjian_id":"war_N0541"},{"title":"秦灭赵之战","tongjian_id":"war_N0546"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、沁州（卷四十三）","excerpts":[{"context_after":"又汉二年，韩信破代，擒代相夏说于阏与，即此处也。《后汉志...","context_before":"...战国时，赵将赵奢大破秦军，解阏与之围，其地在河南武安县。","source_end_index":67,"source_paragraph_tongjian_id":"a4680c43-ffae-5f4e-a79f-592f16fff64e","source_start_index":51,"source_text":"秦始皇十一年，王翦攻阏与及轑阳。"}],"path":"山西方舆纪要/六、沁州（卷四十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、辽州（卷四十三）","excerpts":[{"context_after":"汉为涅氏县地，属上党郡。晋置轑阳县，属乐平郡。后魏曰辽阳...","context_before":"○辽山废县[今州治。","source_end_index":38,"source_paragraph_tongjian_id":"ac303fd3-c3a7-569a-a732-8f27b688de97","source_start_index":10,"source_text":"战国时赵地，亦曰轑阳。秦始皇十一年，王翦攻赵轑阳，即此。"}],"path":"山西方舆纪要/七、辽州（卷四十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、彰德府（卷四十九）","excerpts":[{"context_after":"《晋土地记》：安阳城，在邺城南四十里。永安初，东海王越奉...","context_before":"...年，至新中，即此。胡氏曰：故城在今县西北十里。秦曰安阳。","source_end_index":89,"source_paragraph_tongjian_id":"bd0c3578-a821-5bcf-ac0d-0cc5200ea5de","source_start_index":72,"source_text":"始皇十六年，桓旂攻赵，取邺、安阳。"},{"context_after":"汉高十二年，置魏郡，治邺县。后汉初，更始将谢躬屯邺，光武...","context_before":"...止壁于邺。又赵悼襄王六年，魏与赵邺。九年，秦攻邺，拔之。","source_end_index":132,"source_paragraph_tongjian_id":"a9e2ed2e-8f5c-58a2-bf37-303dc59d9bfe","source_start_index":114,"source_text":"又秦始皇十一年，王翦等攻邺，取八城。"}],"path":"河南方舆纪要/五、彰德府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1趙人伐燕，取貍陽。兵未罷，將軍王翦、桓齮、楊端和伐趙，攻鄴，取九城。王翦攻閼與、轑陽，桓齮取鄴、安陽。","content_fanyi":"赵国人攻打燕国，夺取了狸阳。战事尚未结束，秦国将军王翦、桓齮、杨端和已率军进攻赵国，攻打邺地，夺取九城。其中王翦率军攻打阏与、轑阳，桓齮率军夺取邺城、安阳。","content_jianti_auto":"1赵人伐燕，取貍阳。兵未罢，将军王翦、桓𬺈、杨端和伐赵，攻邺，取九城。王翦攻阏与、轑阳，桓𬺈取邺、安阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":500,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d4436d3-db0e-11ef-9975-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":6,"source_start_index":0,"source_text":"爲遷亡趙張本","target_paragraph_tongjian_id":"8d4ff53a-db0e-11ef-9b75-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"遷","people_name_jianti_auto":"迁","start_index":1,"tongjian_id":"8d443720-db0e-11ef-88f6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙","place_name_jianti_auto":"赵","start_index":3,"tongjian_id":"8d443721-db0e-11ef-87b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲遷亡趙張本。行，下孟翻。","note_content_jianti_auto":"为迁亡赵张本。行，下孟翻。","note_type":"hu_note","start_index":46,"tongjian_id":"8d44371f-db0e-11ef-82f3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-236,"link_td_description":"赵悼襄王是中国战国时期赵国君主，原名赵偃，赵孝成王之子。","link_td_id":"Q10000659","link_td_number_id":334710,"people_name":"趙悼襄王","people_name_jianti_auto":"赵悼襄王","people_xingming":"赵偃","start_index":1,"tongjian_id":"8d491c59-db0e-11ef-8659-a0d3651f611f","wl_zhushi":"[赵偃]"},{"link_birth_year":-245,"link_death_year":-222,"link_td_description":"赵幽缪王，又称赵王迁，是中国战国时期赵国君主，本名赵迁，赵悼襄王之子。为宋朝皇族的始祖。","link_td_id":"Q10000658","link_td_number_id":327776,"people_name":"幽繆王遷","people_name_jianti_auto":"幽缪王迁","people_xingming":"赵迁","start_index":8,"tongjian_id":"8d491c5a-db0e-11ef-b0be-a0d3651f611f"},{"link_death_year":-236,"link_td_description":"赵悼襄王是中国战国时期赵国君主，原名赵偃，赵孝成王之子。","link_td_id":"Q10000659","link_td_number_id":334710,"people_name":"悼襄王","people_name_jianti_auto":"悼襄王","people_xingming":"赵偃","start_index":22,"tongjian_id":"8d491c5b-db0e-11ef-83b7-a0d3651f611f","wl_zhushi":"[赵偃]"},{"link_death_year":-236,"link_td_description":"赵悼襄王是中国战国时期赵国君主，原名赵偃，赵孝成王之子。","link_td_id":"Q10000659","link_td_number_id":334710,"people_name":"悼襄王","people_name_jianti_auto":"悼襄王","people_xingming":"赵偃","start_index":26,"tongjian_id":"8d4b352c-db0e-11ef-981b-a0d3651f611f","wl_zhushi":"[赵偃]"},{"people_name":"嘉","people_name_jianti_auto":"嘉","people_xingming":"赵嘉","start_index":32,"tongjian_id":"8d4b352d-db0e-11ef-8926-a0d3651f611f"},{"link_birth_year":-245,"link_death_year":-222,"link_td_description":"赵幽缪王，又称赵王迁，是中国战国时期赵国君主，本名赵迁，赵悼襄王之子。为宋朝皇族的始祖。","link_td_id":"Q10000658","link_td_number_id":327776,"people_name":"遷","people_name_jianti_auto":"迁","people_xingming":"赵迁","start_index":37,"tongjian_id":"8d4b352e-db0e-11ef-a154-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[{"title":"秦灭赵之战","tongjian_id":"war_N0546"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2趙悼襄王薨，子幽繆王遷立。其母，倡也，嬖於悼襄王，悼襄王廢嫡子嘉而立之。遷素以無行聞於國。","content_fanyi":"赵悼襄王赵偃去世，他的儿子赵迁继位，是为幽缪王。赵迁的母亲原为妓女，很受悼襄王宠幸，悼襄王因此废掉正妻所生的嫡长子赵嘉，改立赵迁为太子。赵迁一向因品行不端而闻名全国。","content_jianti_auto":"2赵悼襄王薨，子幽缪王迁立。其母，倡也，嬖于悼襄王，悼襄王废嫡子嘉而立之。迁素以无行闻于国。","dtjl_paragraph_links":[],"dtjl_references":[],"id":501,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8d44371a-db0e-11ef-b3c5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"文信侯","official_note":"文信侯是吕不韦的封爵，源自《资治通鉴》记载，此处表示吕不韦的封号，在上下文中指代吕不韦本人，用于描述其被贬谪的情况。","official_rank":"侯爵","source_snippet":"文信侯就國歲餘","start_index":0,"tongjian_id":"b9de693f-6a56-447d-82b8-4f6341f4c176"}],"ExtRef_Children_people":[{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"文信侯","people_name_jianti_auto":"文信侯","people_xingming":"吕不韦","start_index":1,"tongjian_id":"8d4b74c2-db0e-11ef-9d29-a0d3651f611f","wl_zhushi":"[吕不韦]"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"文信侯","people_name_jianti_auto":"文信侯","people_xingming":"吕不韦","start_index":31,"tongjian_id":"8d4b74c3-db0e-11ef-9103-a0d3651f611f","wl_zhushi":"[吕不韦]"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"仲父","people_name_jianti_auto":"仲父","people_xingming":"吕不韦","start_index":61,"tongjian_id":"8d4b74c4-db0e-11ef-857e-a0d3651f611f"},{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"文信侯","people_name_jianti_auto":"文信侯","people_xingming":"吕不韦","start_index":73,"tongjian_id":"8d4b74c9-db0e-11ef-9f51-a0d3651f611f","wl_zhushi":"[吕不韦]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":42,"tongjian_id":"8d4b74c5-db0e-11ef-a248-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","resolved_place_entity_id":59,"start_index":46,"tongjian_id":"8d4b74c6-db0e-11ef-914c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":57,"tongjian_id":"8d4b74c7-db0e-11ef-b1bd-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","place_note":"四川成都","resolved_place_entity_id":38,"start_index":70,"tongjian_id":"8d4b74c8-db0e-11ef-8cf5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"3文信侯就國歲餘，諸侯賓客使者相望於道，請之。王恐其爲變，乃賜文信侯書曰：「君何功於秦，封君河南，食十萬戶？何親於秦，號稱仲父？其與家屬徙處蜀！」文信侯自知稍侵，恐誅。","content_fanyi":"秦国文信侯吕不韦回到封国一年多，各诸侯国的宾客、使者络绎不绝，在道路上前后相望，纷纷前来请他。秦王嬴政担心他会发动变乱，于是赐给文信侯一封信说：“您对秦国有什么功劳，竟被封在河南，食邑十万户？您与秦国又有什么亲缘关系，却号称仲父？您还是与家属一起迁往蜀地居住吧！”文信侯自知逐渐受到侵逼，害怕被杀害。","content_jianti_auto":"3文信侯就国岁余，诸侯宾客使者相望于道，请之。王恐其为变，乃赐文信侯书曰：「君何功于秦，封君河南，食十万户？何亲于秦，号称仲父？其与家属徙处蜀！」文信侯自知稍侵，恐诛。","dtjl_paragraph_links":[],"dtjl_references":[],"id":502,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8d4b48e7-db0e-11ef-9a1c-a0d3651f611f"}],"reign_name":"十一年","reign_name_jianti_auto":"十一年","start_index":10,"tongjian_id":"8d4436d1-db0e-11ef-8fa5-a0d3651f611f","year_anno":"（乙丑、前二三六）","year_int":-236},"message":"success","success":true}