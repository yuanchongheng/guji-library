f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":15,"tongjian_id":"8d4436fd-db0e-11ef-9b83-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":25,"tongjian_id":"8d4436fe-db0e-11ef-a2c5-a0d3651f611f"},{"place_name":"轑陽","place_name_jianti_auto":"轑阳","place_note":"山西左权","start_index":33,"tongjian_id":"8d4436ff-db0e-11ef-bac6-a0d3651f611f"},{"place_name":"上黨","place_name_jianti_auto":"上党","start_index":36,"tongjian_id":"8d443700-db0e-11ef-bfe8-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":46,"tongjian_id":"8d443701-db0e-11ef-bda9-a0d3651f611f"},{"place_name":"樂平郡","place_name_jianti_auto":"乐平郡","start_index":47,"tongjian_id":"8d443702-db0e-11ef-8b3e-a0d3651f611f"},{"place_name":"遼州","place_name_jianti_auto":"辽州","start_index":54,"tongjian_id":"8d443703-db0e-11ef-8bc1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閼，於曷翻。與，音預，又音余。徐廣曰：轑，音老，在幷州。十三州志：轑陽在上黨西北百八十里，蓋唐樂平郡地，今之遼州也。據十三州志，轑，當音遼。","note_content_jianti_auto":"阏，于曷翻。与，音预，又音余。徐广曰：轑，音老，在幷州。十三州志：轑阳在上党西北百八十里，盖唐乐平郡地，今之辽州也。据十三州志，轑，当音辽。","note_type":"hu_note","start_index":44,"tongjian_id":"8d4436fc-db0e-11ef-8a7f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鄴縣","place_name_jianti_auto":"邺县","start_index":0,"tongjian_id":"8d443707-db0e-11ef-b307-a0d3651f611f"},{"place_name":"安陽城","place_name_jianti_auto":"安阳城","start_index":3,"tongjian_id":"8d443708-db0e-11ef-bf87-a0d3651f611f"},{"place_name":"曹魏","place_name_jianti_auto":"曹魏","start_index":7,"tongjian_id":"8d443709-db0e-11ef-8ad4-a0d3651f611f"},{"place_name":"安陽縣","place_name_jianti_auto":"安阳县","start_index":10,"tongjian_id":"8d44370a-db0e-11ef-83e8-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":15,"tongjian_id":"8d44370b-db0e-11ef-964e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄴縣有安陽城，曹魏置安陽縣，屬魏郡。","note_content_jianti_auto":"邺县有安阳城，曹魏置安阳县，属魏郡。","note_type":"hu_note","start_index":52,"tongjian_id":"8d443706-db0e-11ef-8f45-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"將軍","official_note":"將軍是秦漢時期的高級軍事指揮官，負責統領軍隊作戰。在《資治通鑑》此段中，王翦、桓齮、楊端和擔任將軍，率軍攻打趙國，體現了秦國在統一戰爭中的軍事行動。此信息基於《資治通鑑》原文和秦漢官制常識。","official_rank":"未知","source_snippet":"將軍王翦、桓齮、楊端和伐趙","start_index":12,"tongjian_id":"d5cd39e1-4d54-4e52-b604-35d9c6d0ba3e"}],"ExtRef_Children_people":[{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","people_xingming":"王翦","start_index":16,"tongjian_id":"8d44370f-db0e-11ef-bcfd-a0d3651f611f"},{"link_birth_year":-279,"link_death_year":-229,"link_td_description":"战国末年秦国将军。","link_td_id":"Q10007896","link_td_number_id":316660,"people_name":"桓齮","people_name_jianti_auto":"桓𬺈","people_xingming":"桓齮","start_index":19,"tongjian_id":"8d443710-db0e-11ef-9f41-a0d3651f611f"},{"link_td_description":"杨端和，即杨翁子，中国秦代武将，生活在秦昭襄王至秦始皇建立秦朝后的时代。","link_td_id":"Q10012233","link_td_number_id":1451710,"people_name":"楊端和","people_name_jianti_auto":"杨端和","people_xingming":"杨端和","start_index":22,"tongjian_id":"8d443711-db0e-11ef-b834-a0d3651f611f"},{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","people_xingming":"王翦","start_index":35,"tongjian_id":"8d443713-db0e-11ef-94ad-a0d3651f611f"},{"link_birth_year":-279,"link_death_year":-229