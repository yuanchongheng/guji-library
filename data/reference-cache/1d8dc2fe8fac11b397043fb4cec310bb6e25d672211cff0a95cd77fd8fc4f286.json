":12,"tongjian_id":"9030a6ee-db0e-11ef-b940-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"9030a6f5-db0e-11ef-b290-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"昆明","place_name_jianti_auto":"昆明","place_note":"云南中部","start_index":4,"tongjian_id":"9030a6f6-db0e-11ef-9f77-a0d3651f611f"},{"place_name":"越巂","place_name_jianti_auto":"越巂","start_index":7,"tongjian_id":"9030a6f7-db0e-11ef-82f2-a0d3651f611f"},{"place_name":"爨","place_name_jianti_auto":"爨","start_index":13,"tongjian_id":"9030a6f8-db0e-11ef-a17d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：昆明在越巂西南，諸爨所居。","note_content_jianti_auto":"杜佑曰：昆明在越巂西南，诸爨所居。","note_type":"hu_note","start_index":37,"tongjian_id":"9030a6f4-db0e-11ef-943d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"拔胡將軍","official_note":"拔胡將軍是漢武帝時期為征伐匈奴等北方民族而設置的臨時性軍事職務，屬於雜號將軍的一種。在《資治通鑑》此段中，漢武帝派遣拔胡將軍郭昌率軍攻擊昆明地區的阻礙勢力，以打通通往大夏的交通路線，這反映了漢朝對外擴張和軍事行動的組織。","official_rank":"未知","source_snippet":"遣拔胡將軍郭昌將以擊之","start_index":55,"tongjian_id":"810930da-5965-44bc-9152-050acf49512d"}],"ExtRef_Children_people":[{"link_td_description":"郭昌，西汉将军，云中郡（治今内蒙古托克托东北）人。","link_td_id":"Q10012748","link_td_number_id":1502641,"people_name":"郭昌","people_name_jianti_auto":"郭昌","people_xingming":"郭昌","start_index":64,"tongjian_id":"90331566-db0e-11ef-95c7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":1,"tongjian_id":"9032f78c-db0e-11ef-9fec-a0d3651f611f"},{"place_name":"西南夷","place_name_jianti_auto":"西南夷","resolved_place_entity_id":1702,"start_index":4,"tongjian_id":"9032f78d-db0e-11ef-ae81-a0d3651f611f"},{"place_name":"大夏","place_name_jianti_auto":"大夏","place_note":"阿富汗东北部","resolved_place_entity_id":1550,"start_index":18,"tongjian_id":"9032f78e-db0e-11ef-bd14-a0d3651f611f"},{"place_name":"昆明","place_name_jianti_auto":"昆明","place_note":"云南中部","resolved_place_entity_id":1753,"start_index":34,"tongjian_id":"9032f78f-db0e-11ef-adf6-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":43,"start_index":50,"tongjian_id":"90331567-db0e-11ef-985a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二十五、四川行都指挥使司（卷七十四）","excerpts":[{"context_after":"后周为定莋镇地。唐置昆明县，盖以汉昆明地而名。天宝中，置...","context_before":"...定莋县地，以南接昆明夷而名。颜师古曰：昆明，在巂州西南。","source_end_index":99,"source_paragraph_tongjian_id":"ffc153ed-1c3f-551c-b4d8-17d3062780ba","source_start_index":39,"source_text":"汉武求身毒道，南方闭巂昆明。元封六年，复欲通大夏，遣使十余辈，皆闭昆明，乃命将郭昌击之，斩首数十万。后复遣使，竟不得通。"}],"path":"四川方舆纪要/二十五、四川行都指挥使司（卷七十四）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"4漢旣通西南夷，開五郡，欲地接以前通大夏，歲遣使十餘輩出此初郡，皆閉昆明，爲所殺，奪幣物。於是天子赦京師亡命，令從軍，遣拔胡將軍郭昌將以擊之，斬首數十萬。後復遣使，竟不得通。","content_fanyi":"汉朝在打通西南夷之后，又新设五个郡，想在这一带寻得通往大夏国的路线，每年派出十几批使者从这些初设的郡出发，却都在昆明被拦阻，使者被杀，所带财物被抢。于是汉武帝赦免京城中的死刑犯人，命他们从军，派拔胡将军郭昌率军前往攻打昆明，斩首数十万级。此后再派使者，终究无法通过此地。","content_jianti_auto":"4汉既通西南夷，开五郡，欲地接以前通大夏，岁遣使十余辈出此初郡，皆闭昆明，为所杀，夺币物。于是天子赦京师亡命，令从军，遣拔胡将军郭昌将以击之，斩首数十万。后复遣使，竟不得通。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1713,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"9030a6ed-db0e-11ef-a6a4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5秋，大旱，蝗。","content_fanyi":"秋季，大旱，同时蝗虫成灾。","content_jianti_auto":"5秋，大旱，蝗。","dtjl_parag