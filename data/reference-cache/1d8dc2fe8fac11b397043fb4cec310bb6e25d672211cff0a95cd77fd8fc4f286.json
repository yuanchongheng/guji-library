e":"hu_note","start_index":219,"tongjian_id":"90331579-db0e-11ef-950e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昆莫","people_name_jianti_auto":"昆莫","start_index":7,"tongjian_id":"90331580-db0e-11ef-80bc-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":10,"tongjian_id":"90331581-db0e-11ef-a7d5-a0d3651f611f"},{"people_name":"昆莫","people_name_jianti_auto":"昆莫","start_index":14,"tongjian_id":"90331582-db0e-11ef-84df-a0d3651f611f"},{"people_name":"獵驕靡","people_name_jianti_auto":"猎骄靡","start_index":22,"tongjian_id":"90331583-db0e-11ef-a6dd-a0d3651f611f"},{"people_name":"昆莫","people_name_jianti_auto":"昆莫","start_index":38,"tongjian_id":"90331584-db0e-11ef-9935-a0d3651f611f"},{"people_name":"獵驕靡","people_name_jianti_auto":"猎骄靡","start_index":49,"tongjian_id":"90331585-db0e-11ef-9867-a0d3651f611f"},{"people_name":"昆莫","people_name_jianti_auto":"昆莫","start_index":61,"tongjian_id":"90331586-db0e-11ef-a259-a0d3651f611f"},{"people_name":"驕靡","people_name_jianti_auto":"骄靡","start_index":66,"tongjian_id":"90331587-db0e-11ef-94ba-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"烏孫","place_name_jianti_auto":"乌孙","place_note":"都赤谷城，伊塞克湖东南","start_index":0,"tongjian_id":"90331588-db0e-11ef-962a-a0d3651f611f"},{"place_name":"顏","place_name_jianti_auto":"颜","start_index":34,"tongjian_id":"90331589-db0e-11ef-9c9a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"烏孫建國之王曰昆莫。班史云：昆莫，王號也，名獵驕靡，後書「昆彌」云。顏註曰：昆莫本是王號，而其人名獵驕靡，故書云昆彌；昆取昆莫，彌取驕靡，彌、靡音有輕重耳，蓋本一也。後遂以昆彌爲王號。滅，綿結翻。","note_content_jianti_auto":"乌孙建国之王曰昆莫。班史云：昆莫，王号也，名猎骄靡，后书「昆弥」云。颜注曰：昆莫本是王号，而其人名猎骄靡，故书云昆弥；昆取昆莫，弥取骄靡，弥、靡音有轻重耳，盖本一也。后遂以昆弥为王号。灭，绵结翻。","note_type":"hu_note","start_index":269,"tongjian_id":"9033157f-db0e-11ef-9efc-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"江都王","official_note":"江都王是漢朝分封的諸侯王，此處指劉建，其女細君被選為公主嫁往烏孫，以加強漢朝與烏孫的聯盟關係。","official_rank":"王爵","source_snippet":"漢以江都王建女細君爲公主","start_index":78,"tongjian_id":"cb1f4223-b6ea-4699-b372-0b2d7495d885"},{"confidence":0.85,"official_category":"宫廷内职","official_name":"右夫人","official_note":"右夫人是烏孫王昆莫的配偶稱號，此處指漢朝公主細君被立為右夫人，以顯示漢朝在烏孫的地位高於匈奴。","official_rank":"未知","source_snippet":"烏孫王昆莫以爲右夫人","start_index":96,"tongjian_id":"da207433-e7af-40c9-ad84-b9ae63c60870"},{"confidence":0.85,"official_category":"宫廷内职","official_name":"左夫人","official_note":"左夫人是烏孫王昆莫的另一配偶稱號，此處指匈奴女子被立為左夫人，反映匈奴與烏孫的聯姻關係。","official_rank":"未知","source_snippet":"匈奴亦遣女妻昆莫，以爲左夫人","start_index":108,"tongjian_id":"60587ce3-0cab-4b2f-8f9e-757273caf3f9"},{"confidence":0.9,"official_category":"地方行政","official_name":"昆彌","official_note":"昆彌是烏孫國王的稱號，此處指岑娶繼承王位，成為新的烏孫王，延續與漢朝的聯盟。","official_rank":"王爵","source_snippet":"岑娶代立，爲昆彌","start_index":265,"tongjian_id":"53c8dc7b-e850-4145-8c0a-214e8baa260a"}],"ExtRef_Children_people":[{"link_death_year":-121,"link_td_description":"刘建，西汉宗室，是汉景帝之孙，江都易王刘非的儿子，后来继承父亲爵位，成为第二任江都王。他是刘细君的父亲。元狩二年（公元前121年），他企图谋反，事情暴露后畏罪自杀。","link_td_id":"Q10003855","link_td_number_id":341916,"people_name":"江都王","people_name_jianti_auto":"江都王","people_xingming":"刘建","start_index":93,"tongjian_id":"9033ae77-db0e-11ef-a466-a0d3651f611f"},{"link_death_year":-121,"link_td_description":"刘建，西汉宗室，是汉景帝之孙，江都易王刘非的儿子，后来继承父亲爵位，成为第二任江都王。他是刘细君的父亲。元狩二年（公元前121年），他企图谋反，事情暴露后畏罪自杀。","link_td_id":"Q10003855","link_td_number_id":341916,"people_name":"建","people_name_jianti_auto":"建","people_xingming":"刘建","start_index":96,"tongjian_id":"9033ae78-db0e-11ef-a5ce-a0d3651f611f","wl_zhushi":"[景帝刘启孙]"},{"link_birth_year":-130,"link_death_year":-101,"link_td_description":"刘细君，汉朝时江都王刘建的女儿，被称为江都公主。元封六年（前105年），汉武帝以刘细君和亲公主，嫁予乌孙国皇帝昆莫猎骄靡，以和乌孙结为兄弟之邦，共制匈奴，因此世称为乌孙公主。是历史上第一位留下姓名的女诗人及和亲公主。","link_td_id":"Q10001012","link_td_number_id":162597,"people_name":"細君","people_name_jianti_auto":"细君","people_xingming":"刘细君","start_index":98,"tongjian_id":"9033ae79-db0e-11ef-9efd