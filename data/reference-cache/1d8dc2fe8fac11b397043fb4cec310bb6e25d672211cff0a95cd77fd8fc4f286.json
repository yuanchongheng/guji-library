n_id":"90337749-db0e-11ef-8d0f-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","place_note":"都赤谷城，伊塞克湖东南","resolved_place_entity_id":402,"start_index":51,"tongjian_id":"9033774a-db0e-11ef-8cd3-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":62,"tongjian_id":"9033774b-db0e-11ef-a2d6-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","place_note":"都赤谷城，伊塞克湖东南","resolved_place_entity_id":402,"start_index":80,"tongjian_id":"9033774c-db0e-11ef-9143-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":88,"tongjian_id":"9033ae7a-db0e-11ef-b40a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":91,"tongjian_id":"9033ae7b-db0e-11ef-bccf-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":106,"tongjian_id":"9033ae7c-db0e-11ef-8f0c-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":125,"tongjian_id":"9033ae80-db0e-11ef-a5aa-a0d3651f611f"},{"place_name":"烏孫","place_name_jianti_auto":"乌孙","resolved_place_entity_id":402,"start_index":242,"tongjian_id":"9033ae88-db0e-11ef-8f33-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"6烏孫使者見漢廣大，歸報其國，其國乃益重漢。匈奴聞烏孫與漢通，怒，欲擊之；又其旁大宛、月氏之屬皆事漢；烏孫於是恐，使使願得尚漢公主，爲昆弟。天子與羣臣議，許之。烏孫以千匹馬往聘漢女。漢以江都王建女細君爲公主，往妻烏孫，贈送甚盛；烏孫王昆莫以爲右夫人。匈奴亦遣女妻昆莫，以爲左夫人。公主自治宮室居，歲時一再與昆莫會，置酒飲食。昆莫年老，言語不通，公主悲愁思歸，天子聞而憐之，間歲遣使者以帷帳錦繡給遺焉。昆莫曰：「我老，」欲使其孫岑娶尚公主。公主不聽，上書言狀。天子報曰：「從其國俗，欲與烏孫共滅胡。」岑娶遂妻公主。昆莫死，岑娶代立，爲昆彌。","content_fanyi":"乌孙使者看到汉朝疆域广大，回国后报告本国，乌孙国因此更加看重汉朝。匈奴听说乌孙与汉朝往来，大怒，想要攻打乌孙；而乌孙旁边的大宛、月氏等国又都事奉汉朝；乌孙因此感到恐惧，派使者表示希望迎娶汉朝公主，与汉朝结为兄弟。汉武帝与群臣商议后，答应了。乌孙用一千匹马作为聘礼，前往汉朝迎娶汉朝公主。汉武帝封江都王刘建的女儿刘细君为公主，把她嫁给乌孙王，并赠送了十分丰厚的陪嫁；乌孙王昆莫把她立为右夫人。匈奴也送一名女子嫁给昆莫为妻，昆莫把她立为左夫人。公主自己修建宫室居住，每年只与昆莫会面一两次，一同饮酒进餐。昆莫年老，彼此语言不通，公主悲伤忧愁，思念故乡，汉武帝听说后很怜惜她，每隔一年派使者给她送去帷帐、锦绣等物。昆莫说：‘我老了，’想让他的孙子岑娶军须靡娶公主。公主不肯依从，上书汉武帝说明情况。汉武帝回复说：‘你应顺从乌孙国的风俗，因为朕想与乌孙共同灭掉匈奴。’岑娶军须靡于是娶公主为妻。昆莫去世后，岑娶军须靡继立，号为昆弥王。","content_jianti_auto":"6乌孙使者见汉广大，归报其国，其国乃益重汉。匈奴闻乌孙与汉通，怒，欲击之；又其旁大宛、月氏之属皆事汉；乌孙于是恐，使使愿得尚汉公主，为昆弟。天子与群臣议，许之。乌孙以千匹马往聘汉女。汉以江都王建女细君为公主，往妻乌孙，赠送甚盛；乌孙王昆莫以为右夫人。匈奴亦遣女妻昆莫，以为左夫人。公主自治宫室居，岁时一再与昆莫会，置酒饮食。昆莫年老，言语不通，公主悲愁思归，天子闻而怜之，间岁遣使者以帷帐锦绣给遗焉。昆莫曰：「我老，」欲使其孙岑娶尚公主。公主不听，上书言状。天子报曰：「从其国俗，欲与乌孙共灭胡。」岑娶遂妻公主。昆莫死，岑娶代立，为昆弥。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1715,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"90331569-db0e-11ef-b922-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"9033ae8b-db0e-11ef-b19f-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":13,"tongjian_id":"9033ae8c-db0e-11ef-976d-a0d3651f611f"},{"people_name":"郭義恭","people_name_jianti_auto":"郭义恭","start_index":28,"tongjian_id":"9033ae8d-db0e-11ef-a152-a0d3651f611f"},{"people_name":"魚豢","people_name_jianti_auto":"鱼豢","start_index":142,"tongjian_id":"9033ae8e-db0e-11ef-9c8e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"黎軒","place_name_jianti_auto":"黎轩","place_note":"托勒密王朝埃及","start_index":78,"tongjian_id":"9033ae8f-db0e-11ef-a960-a0d3651f611f"},{"place_name":"黎靬","place_name_jianti_auto":"黎靬","start_index":83,"tongjian_id":"9033ae90-db0e-11ef-aeba-a0d3651f611f"},{"place_name":"東漢","place_name_jianti_auto":"东汉","start_index":86,"tongjian_id":"9033ae91-db0e-11ef-a921-a0d3651f611f"},{"place_name":"大秦國","place_name_jianti_auto":"大秦国","start_index":89,"tongjian_id":"9033ae92-db0e-11ef-b165-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":93,"tongjian_id":"9033ae93-db0e-11ef-8c3c-a0d3651f611f"},{"place_name":"拂菻國","place_name_jianti_auto":"拂菻国","start_index":95,"tongjian_id":"9033ae94-db0e-11ef-91f9-a0d3651f611f"},{"place_name":"安息","place_name_jianti_auto":"安息","start_index":100,"tongjian_id":"9033ae95-db0e-11ef-8e09-a0d3651f611f"},{"place_name":"烏弋","place_name_jianti_auto":"乌弋","start_index":103,"tongjian_id":"9033ae96-db0e-11ef-a72c-a0d3651f611f"},{"place_name":"大秦國","place_name_jianti_auto":"大秦国","start_index":148,"tongjian_id":"9033ae97-db0e-11ef-85f1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：大鳥卵如一二石甕。師古曰：如汲水甕，無一二石也。郭義恭廣志曰：大爵，頸及身、膺、蹄都似橐駝，舉頭高七八尺，張翅丈餘，食大麥，其卵如甕，卽今之駝鳥也。黎軒，亦曰黎靬，東漢爲大秦國，唐爲拂菻國，在安息、烏弋之西，隔大海。眩，與幻同，卽今吞刀、吐火、植瓜、種樹、屠人、截馬之術皆是。魚豢魏略曰：大秦國，俗善幻，口中出火，自縛自解，跳十二丸，巧妙非常。靬，音軒，又鉅連翻。","note_content_jianti_auto":"应劭曰：大鸟卵如一二石瓮。师古曰：如汲水瓮，无一二石也。郭义恭广志曰：大爵，颈及身、膺、蹄都似橐驼，举头高七八尺，张翅丈余，食大麦，其卵如瓮，即今之驼鸟也。黎轩，亦曰黎靬，东汉为大秦国，唐为拂菻国，在安息、乌弋之西，隔大海。眩，与幻同，即今吞刀、吐火、植瓜、种树、屠人、截马之术皆是。鱼豢魏略曰：大秦国，俗善幻，口中出火，自缚自解，跳十二丸，巧妙非常。靬，音轩，又巨连翻。","note_type":"hu_note","start_index":33,"tongjian_id":"9033ae8a-db0e-11ef-a93d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"驩潛","place_name_jianti_auto":"驩潜","place_note":"中亚阿姆河下游东岸","start_index":4,"tongjian_id":"9033ae9b-db0e-11ef-b1d4-a0d3651f611f"},{"place_name":"大益","place_name_jianti_auto":"大益","start_index":7,"tongjian_id":"9033ae9c-db0e-11ef-ba11-a0d3651f611f"},{"place_name":"大宛","place_name_jianti_auto":"大宛","start_index":10,"tongjian_id":"9033ae9d-db0e-11ef-8130-a0d3651f611f"},{"place_name":"扜冞國","place_name_jianti_auto":"扜冞国","start_index":14,"tongjian_id":"9033ae9e-db0e-11ef-a6a8-a0d3651f611f"},{"place_name":"扜冞城","place_name_jianti_auto":"扜冞城","start_index":18,"tongjian_id":"9033ae9f-db0e-11ef-8b9a-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":23,"tongjian_id":"9033aea0-db0e-11ef-aba1-a0d3651f611f"},{"place_name":"于窴","place_name_jianti_auto":"于窴","start_index":35,"tongjian_id":"9033aea1-db0e-11ef-9734-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":43,"tongjian_id":"9033aea2-db0e-11ef-a3c1-a0d3651f611f"},{"place_name":"寧冞","place_name_jianti_auto":"宁冞","start_index":46,"tongjian_id":"9033aea3-db0e-11ef-b942-a0d3651f611f"},{"place_name":"蘇䪥","place_name_jianti_auto":"苏䪥","start_index":49,"tongjian_id":"9033aea4-db0e-11ef-bee2-a0d3651f611f"},{"place_name":"康居","place_name_jianti_auto":"康居","start_index":52,"tongjian_id":"9033aea5-db0e-11ef-8dda-a0d3651f611f"},{"place_name":"蘇䪥","place_name_jianti_auto":"苏䪥","start_index":59,"tongjian_id":"9033aea6-db0e-11ef-87ff-a0d3651f611f"},{"place_name":"陽關","place_name_jianti_auto":"阳关","start_index":64,"tongjian_id":"9033aea7-db0e-11ef-94c1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"據史記，驩潛、大益在大宛西。扜冞國治扜冞城，去長安九千二百八十里，西通于窴二百九十里，後漢曰寧冞。蘇䪥，康居小王國，治蘇䪥城，去陽關凡八千二十五里。扜，音烏。冞，與彌同。䪥，下戒翻。","note_content_jianti_auto":"据史记，驩潜、大益在大宛西。扜冞国治扜冞城，去长安九千二百八十里，西通于窴二百九十里，后汉曰宁冞。苏䪥，康居小王国，治苏䪥城，去阳关凡八千二十五里。扜，音乌。冞，与弥同。䪥，下戒翻。","note_type":"hu_note","start_index":54,"tongjian_id":"9033ae9a-db0e-11ef-9d28-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9033aeab-db0e-11ef-b808-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：遞互來去，前後不絕。更，工衡翻。","note_content_jianti_auto":"师古曰：递互来去，前后不绝。更，工衡翻。","note_type":"hu_note","start_index":76,"tongjian_id":"9033aeaa-db0e-11ef-a6db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9033aead-db0e-11ef-a639-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言示之，令其觀覽。","note_content_jianti_auto":"师古曰：言示之，令其观览。","note_type":"hu_note","start_index":121,"tongjian_id":"9033aeac-db0e-11ef-81a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9033aeaf-db0e-11ef-a04e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：聚都邑人令觀看，以誇示之。觀，工喚翻；下同。","note_content_jianti_auto":"师古曰：聚都邑人令观看，以夸示之。观，工唤翻；下同。","note_type":"hu_note","start_index":138,"tongjian_id":"9033aeae-db0e-11ef-bfe2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"嚴","people_name_jianti_auto":"严","start_index":1,"tongjian_id":"9033aeb2-db0e-11ef-b2bb-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『嚴：「名」改「各」。』","note_content_jianti_auto":"『严：「名」改「各」。』","note_type":"『嚴：[^』]*』","start_index":0,"tongjian_id":"9033aeb1-db0e-11ef-bb0d-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":154,"tongjian_id":"9033aeb0-db0e-11ef-bc41-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9033aeb4-db0e-11ef-8753-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：見，顯示也。藏，徂浪翻。","note_content_jianti_auto":"师古曰：见，显示也。藏，徂浪翻。","note_type":"hu_note","start_index":171,"tongjian_id":"9033aeb3-db0e-11ef-becd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"苜蓿，草名。苜，音目。蓿，音宿。","note_content_jianti_auto":"苜蓿，草名。苜，音目。蓿，音宿。","note_type":"hu_note","start_index":188,"tongjian_id":"9033aeb5-db0e-11ef-b262-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9033ae89-db0e-11ef-aa97-a0d3651f611f","pinyin":"yū","source_anchor_text":"大益車師扜冞蘇䪥之","source_key":"baiyang_epub","start_index":47,"text":"扜","tongjian_id":"7a7d5ef5-7245-5c90-80b5-34307c85e328"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9033ae89-db0e-11ef-aa97-a0d3651f611f","pinyin":"mí","source_anchor_text":"益車師扜冞蘇䪥之屬","source_key":"baiyang_epub","start_index":48,"text":"冞","tongjian_id":"37ac7ab7-2431-5576-bc7b-5bf8baaed462"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9033ae89-db0e-11ef-aa97-a0d3651f611f","pinyin":"xiè","source_anchor_text":"師扜冞蘇䪥之屬皆隨","source_key":"baiyang_epub","start_index":51,"text":"䪥","tongjian_id":"26ee3c36-ee8c-5555-a4c8-c19929b14d52"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":3,"tongjian_id":"9033aeb7-db0e-11ef-9fb9-a0d3651f611f"},{"place_name":"葱嶺","place_name_jianti_auto":"葱岭","resolved_place_entity_id":2180,"start_index":7,"tongjian_id":"9033aeb8-db0e-11ef-b5ca-a0d3651f611f"},{"place_name":"安息","place_name_jianti_auto":"安息","place_note":"伊朗","resolved_place_entity_id":2003,"start_index":11,"tongjian_id":"9033aeb9-db0e-11ef-8ca9-a0d3651f611f"},{"place_name":"安息","place_name_jianti_auto":"安息","place_note":"伊朗","resolved_place_entity_id":2003,"start_index":14,"tongjian_id":"9033aeba-db0e-11ef-b643-a0d3651f611f"},{"place_name":"黎軒","place_name_jianti_auto":"黎轩","place_note":"托勒密王朝埃及","resolved_place_entity_id":10082,"start_index":24,"tongjian_id":"9033aebb-db0e-11ef-b517-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":31,"tongjian_id":"9033aebc-db0e-11ef-bc2f-a0d3651f611f"},{"place_name":"驩潛","place_name_jianti_auto":"驩潜","place_note":"中亚阿姆河下游东岸","resolved_place_entity_id":9903,"start_index":37,"tongjian_id":"9033aebd-db0e-11ef-ad58-a0d3651f611f"},{"place_name":"大益","place_name_jianti_auto":"大益","resolved_place_entity_id":6422,"start_index":40,"tongjian_id":"9033aebe-db0e-11ef-b02e-a0d3651f611f"},{"place_name":"車姑師","place_name_jianti_auto":"车姑师","resolved_place_entity_id":759,"start_index":43,"tongjian_id":"9033aebf-db0e-11ef-a635-a0d3651f611f"},{"place_name":"扜冞","place_name_jianti_auto":"扜冞","place_note":"拘彌，新疆于田東","resolved_place_entity_id":7113,"start_index":47,"tongjian_id":"9033aec0-db0e-11ef-acda-a0d3651f611f"},{"place_name":"蘇䪥","place_name_jianti_auto":"苏䪥","resolved_place_entity_id":9043,"start_index":50,"tongjian_id":"9033aec1-db0e-11ef-bec2-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":56,"tongjian_id":"9033aec2-db0e-11ef-898e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":116,"tongjian_id":"9033aec3-db0e-11ef-a9bd-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":162,"tongjian_id":"9033aec4-db0e-11ef-b6e6-a0d3651f611f"},{"place_name":"大宛","place_name_jianti_auto":"大宛","place_note":"都贵山城，中亚纳曼干市西北卡散赛城","resolved_place_entity_id":377,"start_index":171,"tongjian_id":"9033aec5-db0e-11ef-8ebb-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":193,"tongjian_id":"9033aec6-db0e-11ef-9fc6-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":216,"tongjian_id":"9033aec7-db0e-11ef-ad70-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":220,"tongjian_id":"9033aec8-db0e-11ef-bf0d-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":225,"tongjian_id":"9033aec9-db0e-11ef-a8be-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":233,"tongjian_id":"9033aeca-db0e-11ef-ab7b-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉攻大宛之战","tongjian_id":"war_N0584"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"又郁成国，大宛东边小国也。汉太初元年，李广利伐大宛，攻郁...","context_before":"...，亦名苏对沙舟国。○驩潜国，在大宛西。其相近又有大益国。","source_end_index":327,"source_paragraph_tongjian_id":"1eb9b0d2-4867-5a72-bd49-7cf11bd8789b","source_start_index":300,"source_text":"汉元封六年，安息及诸小国驩潜、大益之属，皆随汉使献见。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["外交","内政"],"content":"是時，漢使西踰葱嶺，抵安息。安息發使，以大鳥卵及黎軒善眩人獻于漢，及諸小國驩潛、大益、車姑師、扜冞、蘇䪥之屬皆隨漢使獻見天子，天子大悅。西國使更來更去，天子每巡狩海上，悉從外國客，大都、多人則過之，散財帛以賞賜，厚具以饒給之，以覽示漢富厚焉。大角抵，出奇戲、諸怪物，多聚觀者。行賞賜，酒池肉林，令外國客徧觀名倉庫府藏之積，見漢之廣大，傾駭之。大宛左右多蒲萄，可以爲酒；多苜蓿，天馬嗜之；漢使采其實以來，天子種之於離宮別觀旁，極望。然西域以近匈奴，常畏匈奴使，待之過於漢使焉。","content_fanyi":"这时，汉朝使者向西越过葱岭，抵达安息国。安息国派出使者，把鸵鸟蛋和黎轩国擅长幻术的人进献给汉朝，以及驩潜、大益、车姑师、扜冞、苏䪥（䪥字中贝换成页）等小国也都跟随汉朝使者入朝进献、朝见天子，天子大为高兴。西域各国使者交替往来，天子每次巡狩沿海地区都让外国客人全部随行，经过大城市和人口众多之处，便散发财帛赏赐他们，用丰厚的物资充分供给，借以显示汉朝的富厚。举行大规模角抵表演，推出奇戏和各种珍怪之物，招来众多围观的人。进行赏赐，摆出酒池肉林，让外国客人遍观各处仓库府藏的积蓄，看到汉朝的广大，使他们倾心震骇。大宛附近多产葡萄，可以酿酒；又多产苜蓿，天马爱吃；汉朝使者采集它们的种子带回来，天子将它们种在离宫别馆旁边，一眼望不到边。然而西域各国因为靠近匈奴，常常畏惧匈奴使者，对待他们超过了对待汉朝使者。","content_jianti_auto":"是时，汉使西逾葱岭，抵安息。安息发使，以大鸟卵及黎轩善眩人献于汉，及诸小国驩潜、大益、车姑师、扜冞、苏䪥之属皆随汉使献见天子，天子大悦。西国使更来更去，天子每巡狩海上，悉从外国客，大都、多人则过之，散财帛以赏赐，厚具以饶给之，以览示汉富厚焉。大角抵，出奇戏、诸怪物，多聚观者。行赏赐，酒池肉林，令外国客徧观名仓库府藏之积，见汉之广大，倾骇之。大宛左右多蒲萄，可以为酒；多苜蓿，天马嗜之；汉使采其实以来，天子种之于离宫别观旁，极望。然西域以近匈奴，常畏匈奴使，待之过于汉使焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1716,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"9033ae89-db0e-11ef-aa97-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"9033aece-db0e-11ef-81bd-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"9033aecf-db0e-11ef-acc6-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十四行本「敦」作「燉」；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十四行本「敦」作「炖」；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"9033aecd-db0e-11ef-8c58-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":55,"tongjian_id":"9033aecc-db0e-11ef-8657-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":0,"tongjian_id":"9033aed1-db0e-11ef-bd97-a0d3651f611f"},{"place_name":"上谷","place_name_jianti_auto":"上谷","start_index":7,"tongjian_id":"9033aed2-db0e-11ef-b220-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":16,"tongjian_id":"9033aed3-db0e-11ef-9e12-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","start_index":25,"tongjian_id":"9033aed4-db0e-11ef-bc02-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","place_note":"內蒙托克托","start_index":27,"tongjian_id":"9033aed5-db0e-11ef-a52f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"匈奴左方兵本直上谷以東，右方兵直上郡以西，單于庭直代、雲中；今徙去而西北，故左右方亦徙。","note_content_jianti_auto":"匈奴左方兵本直上谷以东，右方兵直上郡以西，单于庭直代、云中；今徙去而西北，故左右方亦徙。","note_type":"hu_note","start_index":58,"tongjian_id":"9033aed0-db0e-11ef-8c82-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-105,"link_td_description":"乌维单于，是匈奴单于，前任伊稚斜单于的长子。","link_td_id":"Q10008112","link_td_number_id":98977,"people_name":"烏維單于","people_name_jianti_auto":"乌维单于","people_xingming":"乌维单于","start_index":6,"tongjian_id":"9033aed6-db0e-11ef-a296-a0d3651f611f"},{"link_death_year":-102,"link_td_description":"儿单于（？－前102年四月），本名乌师庐（《汉书》作詹师庐），在前105年－前102年任匈奴单于。乌师庐是前任匈奴单于乌维单于之子。因为他成为单于时年纪尚小，故被称为“儿单于”。","link_td_id":"Q10000892","link_td_number_id":98981,"people_name":"烏師廬","people_name_jianti_auto":"乌师庐","people_xingming":"乌师庐","start_index":13,"tongjian_id":"9033aed7-db0e-11ef-a5f1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":4,"tongjian_id":"9033aed8-db0e-11ef-8027-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","place_note":"內蒙托克托","resolved_place_entity_id":379,"start_index":44,"tongjian_id":"9033aed9-db0e-11ef-a209-a0d3651f611f"},{"place_name":"酒泉","place_name_jianti_auto":"酒泉","resolved_place_entity_id":520,"start_index":51,"tongjian_id":"9033aeda-db0e-11ef-93b4-a0d3651f611f"},{"place_name":"敦","place_name_jianti_auto":"敦","resolved_place_entity_id":334,"start_index":54,"tongjian_id":"9033aedb-db0e-11ef-a27f-a0d3651f611f"},{"place_name":"煌郡","place_name_jianti_auto":"煌郡","resolved_place_entity_id":334,"start_index":55,"tongjian_id":"9033aedc-db0e-11ef-af39-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","军事"],"content":"7是歲，匈奴烏維單于死，子烏師廬立，年少，號「兒單于」。自此之後，單于益西北徙，左方兵直雲中，右方兵直酒泉、敦煌郡。","content_fanyi":"这一年，匈奴乌维单于亡故，他的儿子乌师庐成为单于，年龄尚幼，被人称为“儿单于”。从此之后，单于越来越向西北迁徙，其左翼兵力面向云中一带，右翼兵力面向酒泉、敦煌郡地区。","content_jianti_auto":"7是岁，匈奴乌维单于死，子乌师庐立，年少，号「儿单于」。自此之后，单于益西北徙，左方兵直云中，右方兵直酒泉、敦煌郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1717,"number":7,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"9033aecb-db0e-11ef-b96d-a0d3651f611f"}],"reign_name":"六年","reign_name_jianti_auto":"六年","start_index":4,"tongjian_id":"9030a6d9-db0e-11ef-b283-a0d3651f611f","year_anno":"（丙子、前一○五）","year_int":-105},"message":"success","success":true}