ame":"武遂","place_name_jianti_auto":"武遂","place_note":"山西垣曲东南","start_index":30,"tongjian_id":"8c7cd9c7-db0e-11ef-b682-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":40,"tongjian_id":"8c7cd9c8-db0e-11ef-ad78-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","start_index":42,"tongjian_id":"8c7cd9c9-db0e-11ef-ae9f-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":47,"tongjian_id":"8c7cd9ca-db0e-11ef-aed0-a0d3651f611f"},{"place_name":"武遂","place_name_jianti_auto":"武遂","start_index":49,"tongjian_id":"8c7cd9cb-db0e-11ef-946e-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":56,"tongjian_id":"8c7cd9cc-db0e-11ef-bf1f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：武遂本屬韓，近平陽。楚世家云：韓先王之墓在平陽，武遂去之七十里。去年秦拔宜陽，因涉河城武遂，今復歸之韓。復，音如字。","note_content_jianti_auto":"史记正义曰：武遂本属韩，近平阳。楚世家云：韩先王之墓在平阳，武遂去之七十里。去年秦拔宜阳，因涉河城武遂，今复归之韩。复，音如字。","note_type":"hu_note","start_index":36,"tongjian_id":"8c7cd9c1-db0e-11ef-956e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8c7cd9d1-db0e-11ef-a4df-a0d3651f611f"},{"people_name":"蒲","people_name_jianti_auto":"蒲","start_index":13,"tongjian_id":"8c7cd9d2-db0e-11ef-a975-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":15,"tongjian_id":"8c7cd9d3-db0e-11ef-8592-a0d3651f611f"},{"people_name":"秦始皇","people_name_jianti_auto":"秦始皇","start_index":19,"tongjian_id":"8c7cd9d4-db0e-11ef-812e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蒲阪縣","place_name_jianti_auto":"蒲阪县","start_index":3,"tongjian_id":"8c7cd9d5-db0e-11ef-90f5-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":7,"tongjian_id":"8c7cd9d6-db0e-11ef-a15c-a0d3651f611f"},{"place_name":"蒲阪","place_name_jianti_auto":"蒲阪","