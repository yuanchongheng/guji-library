","resolved_place_entity_id":887,"start_index":12,"tongjian_id":"c261aff1-db0e-11ef-bd5e-a0d3651f611f"},{"place_name":"蔡","place_name_jianti_auto":"蔡","place_note":"河南汝南县","resolved_place_entity_id":612,"start_index":14,"tongjian_id":"c261aff2-db0e-11ef-bb8e-a0d3651f611f"},{"place_name":"彰義","place_name_jianti_auto":"彰义","resolved_place_entity_id":887,"start_index":17,"tongjian_id":"c261aff3-db0e-11ef-9f91-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，二月，乙亥，名申、光、蔡軍曰彰義。","content_fanyi":"春季，二月二十四日乙亥，朝廷将申、光、蔡军命名为彰义军。","content_jianti_auto":"1春，二月，乙亥，名申、光、蔡军曰彰义。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23689,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c261afe9-db0e-11ef-ba2d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"磧，沙磧。鹵，鹹鹵。鹹鹵之地，五穀不生。磧，七迹翻。","note_content_jianti_auto":"碛，沙碛。卤，咸卤。咸卤之地，五谷不生。碛，七迹翻。","note_type":"hu_note","start_index":56,"tongjian_id":"c261aff6-db0e-11ef-97aa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓全義","people_name_jianti_auto":"韩全义","start_index":2,"tongjian_id":"c261aff9-db0e-11ef-9e09-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言韓全義駑怯無御衆之略，徒以憑結宦官致節鉞。","note_content_jianti_auto":"史言韩全义驽怯无御众之略，徒以凭结宦官致节钺。","note_type":"hu_note","start_index":84,"tongjian_id":"c261aff8-db0e-11ef-aca6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"德宗","people_name_jianti_auto":"德宗","start_index":15,"tongjian_id":"c261affb-db0e-11ef-8781-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"口宣聖旨而授之官，使掌兵。史言德宗重宦臣而輕詔命。","note_content_jianti_auto":"口宣圣旨而授之官，使掌兵。史言德宗重宦臣而轻诏命。","note_type":"hu_note","start_index":136,"tongjian_id":"c261affa-db0e-11ef-8167-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"神策行營節度使","official_note":"神策行營節度使是唐代神策军的军事指挥官，负责行营事务，此处韩全義担任此职，后改任夏、綏、銀、宥節度使。","official_rank":"未知","source_snippet":"以神策行營節度使韓全義爲夏、綏、銀、宥節度使","start_index":8,"tongjian_id":"02bb4d10-5cf6-4f14-96d4-2576001d2d5e"},{"confidence":0.9,"official_category":"地方行政与军事指挥","official_name":"夏、綏、銀、宥節度使","official_note":"夏、綏、銀、宥節度使是唐代地方军政长官，管辖夏州、绥州、银州、宥州等地区，此处韩全義被任命为此职。","official_rank":"未知","source_snippet":"以神策行營節度使韓全義爲夏、綏、銀、宥節度使","start_index":20,"tongjian_id":"c82052db-a4d0-4300-92b9-126835e63ff5"},{"confidence":0.85,"official_category":"军事指挥","official_name":"大將","official_note":"大將是军队中的高级将领，此处王栖巖担任此职，在军乱中被杀。","official_rank":"未知","source_snippet":"殺大將王栖巖","start_index":67,"tongjian_id":"ec467e4b-ed02-4309-8efe-1594accb7ca0"},{"confidence":0.9,"official_category":"军事指挥","official_name":"都虞候","official_note":"都虞候是唐代军队中的执法和监察官员，负责维持军纪，此处高崇文担任此职，诛杀叛乱者。","official_rank":"未知","source_snippet":"都虞候高崇文誅首亂者","start_index":77,"tongjian_id":"c1e64001-2a21-4222-a82e-7afa42e85ce8"},{"confidence":0.9,"official_category":"军事指挥","official_name":"長武城都知兵馬使","official_note":"長武城都知兵馬使是唐代地方军事指挥官，负责长武城的兵马事务，此处高崇文被任命为此职。","official_rank":"未知","source_snippet":"以崇文爲長武城都知兵馬使","start_index":108,"tongjian_id":"e3db1d5d-8e7f-4f7b-8915-85391b836116"},{"confidence":0.85,"official_category":"中枢近臣","official_name":"中使","official_note":"中使是皇帝派出的宦官使者，负责传达诏令，此处中使口头宣授高崇文官职。","official_rank":"未知","source_snippet":"令中使口宣授之","start_index":126,"tongjian_id":"7475596a-af9a-4a28-96d7-bd3342577ad3"}],"ExtRef_Children_people":[{"link_death_year":805,"link_td_description":"韩全义，早年在神策军中效力，宦官窦文场对他很有好感，起用全义为帐中偏将，典禁兵驻守长武城，后任夏绥节度使，全义无能，多赖高崇文。","link_td_id":"Q10001590","link_td_number_id":855171,"people_name":"韓全義","people_name_jianti_auto":"韩全义","people_xingming":"韩全义","start_index":18,"tongjian_id":"c261affc-db0e-11ef-8a7c-a0d3651f611f"},{"link_death_year":805,"link_td_description":"韩全义，早年在神策军中效力，宦官窦文场对他很有好感，起用全义为帐中偏将，典禁兵驻守长武城，后任夏绥节度使，全义无能，多赖高崇文。","link_td_id":"Q10001590","link_td_number_id":855171,"people_name":"全義","people_name_jianti_auto":"全义","people_xingming":"韩全义","start_index":33,"tongjian_id":"c261affd-db0e-11ef-aee6-a0d3651f611f"},{"people_name":"王栖巖","people_name_jianti_auto":"王栖岩","people_xingming":"王栖岩","start_index":74,"tongjian_id":"c261b004-db0e-11ef-b2f3-a0d3651f611f"},{"link_death_year":805,"link_td_description":"韩全义，早年在神策军中效力，宦官窦文场对他很有好感，起用全义为帐中偏将，典禁兵驻守长武城，后任夏绥节度使，全义无能，多赖高崇文。","link_td_id":"Q10001590","link_td_number_id":855171,"people_name":"全義","people_name_jianti_auto":"全义","people_xingming":"韩全义","start_index":78,"tongjian_id":"c261b005-db0e-11ef-907e-a0d3651f611f"},{"link_birth_year":746,"link_death_year":809,"link_td_description":"高崇文，唐代名将，幽州人。先祖是渤海郡（今河北省沧州市）人。崇文不识字，朴实庄重、沉默寡言。曾大破吐蕃、收复西川，官至同中书门下平章事，封南平郡王，赠司徒。","link_td_id":"Q10004882","link_td_number_id":855126,"people_name":"高崇文","people_name_jianti_auto":"高崇文","people_xingming":"高崇文","start_index":87,"tongjian_id":"c261b006-db0e-11ef-9d83-a0d3651f611f"},{"link_birth_year":746,"link_death_year":809,"link_td_description":"高崇文，唐代名将，幽州人。先祖是渤海郡（今河北省沧州市）人。崇文不识字，朴实庄重、沉默寡言。曾大破吐蕃、收复西川，官至同中书门下平章事，封南平郡王，赠司徒。","link_td_id":"Q10004882","link_td_number_id":855126,"people_name":"崇文","people_name_jianti_auto":"崇文","people_xingming":"高崇文","start_index":100,"tongjian_id":"c261b007-db0e-11ef-a898-a0d3651f611f"},{"link_birth_year":746,"link_death_year":809,"link_td_description":"高崇文，唐代名将，幽州人。先祖是渤海郡（今河北省沧州市）人。崇文不识字，朴实庄重、沉默寡言。曾大破吐蕃、收复西川，官至同中书门下平章事，封南平郡王，赠司徒。","link_td_id":"Q10004882","link_td_number_id":855126,"people_name":"崇文","people_name_jianti_auto":"崇文","people_xingming":"高崇文","start_index":112,"tongjian_id":"c261b008-db0e-11ef-910c-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c261aff4-db0e-11ef-8ddb-a0d3651f611f","pinyin":"qì","source_anchor_text":"卒以夏州磧鹵又盛夏","source_key":"baiyang_epub","start_index":53,"text":"磧","tongjian_id":"f9eacc64-a45b-522d-a12a-f1ccd5acb707"}],"ExtRef_Children_places":[{"place_name":"夏","place_name_jianti_auto":"夏","resolved_place_entity_id":267,"start_index":22,"tongjian_id":"c261affe-db0e-11ef-8608-a0d3651f611f"},{"place_name":"綏","place_name_jianti_auto":"绥","resolved_place_entity_id":2176,"start_index":24,"tongjian_id":"c261afff-db0e-11ef-9b80-a0d3651f611f"},{"place_name":"銀","place_name_jianti_auto":"银","resolved_place_entity_id":1874,"start_index":26,"tongjian_id":"c261b000-db0e-11ef-ac2c-a0d3651f611f"},{"place_name":"宥","place_name_jianti_auto":"宥","resolved_place_entity_id":3139,"start_index":28,"tongjian_id":"c261b001-db0e-11ef-bd03-a0d3651f611f"},{"place_name":"長武城","place_name_jianti_auto":"长武城","place_note":"陕西长武县西北","resolved_place_entity_id":2531,"start_index":37,"tongjian_id":"c261b002-db0e-11ef-8cf0-a0d3651f611f"},{"place_name":"夏州","place_name_jianti_auto":"夏州","resolved_place_entity_id":267,"start_index":51,"tongjian_id":"c261b003-db0e-11ef-846c-a0d3651f611f"},{"place_name":"幽州","place_name_jianti_auto":"幽州","place_note":"北京市","resolved_place_entity_id":102,"start_index":103,"tongjian_id":"c261b009-db0e-11ef-a9a2-a0d3651f611f"},{"place_name":"長武城","place_name_jianti_auto":"长武城","resolved_place_entity_id":2531,"start_index":115,"tongjian_id":"c261b00a-db0e-11ef-9901-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","人事"],"content":"2夏，閏五月，庚申，以神策行營節度使韓全義爲夏、綏、銀、宥節度使。全義時屯長武城，詔帥其衆赴鎭。士卒以夏州磧鹵，又盛夏，不樂徙居；辛酉，軍亂，殺大將王栖巖，全義踰城走。都虞候高崇文誅首亂者，衆然後定。崇文，幽州人也。丙子，以崇文爲長武城都知兵馬使，不降敕，令中使口宣授之。","content_fanyi":"夏季，闰五月十一日庚申，德宗任命神策行营节度使韩全义担任夏、绥、银、宥四州节度使。当时韩全义正屯驻长武城，德宗下诏命他率领本部人马赶赴镇所就任。士兵们认为夏州是盐碱沙碛的不毛之地，又正逢盛夏酷暑，都不愿迁居；闰五月十二日辛酉，军中发生叛乱，士兵杀了大将王栖岩，韩全义翻过城墙逃走。都虞候高崇文诛杀了带头作乱的人，部众这才安定下来。高崇文是幽州人。闰五月二十七日丙子，德宗任命高崇文为长武城都知兵马使，不颁布敕书，而是让宫中宦官使者口头宣布任命。","content_jianti_auto":"2夏，闰五月，庚申，以神策行营节度使韩全义为夏、绥、银、宥节度使。全义时屯长武城，诏帅其众赴镇。士卒以夏州碛卤，又盛夏，不乐徙居；辛酉，军乱，杀大将王栖岩，全义逾城走。都虞候高崇文诛首乱者，众然后定。崇文，幽州人也。丙子，以崇文为长武城都知兵马使，不降敕，令中使口宣授之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23690,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c261aff4-db0e-11ef-8ddb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"給事中","official_note":"給事中是唐代门下省的重要官职，负责审议诏令、驳正违失，属于谏官系统。在《资治通鉴》此段中，趙宗儒原任給事中兼同平章事，后被罢免，表明其曾担任中枢要职。","official_rank":"正五品上","source_snippet":"給事中、同平章事趙宗儒罷爲右庶子","start_index":8,"tongjian_id":"b4c0d86c-dff2-49ab-bc9e-e6590e1edd57"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代的宰相职衔，意为参与平章政事，通常由其他官职兼任，负责处理国家政务。在此段中，趙宗儒以給事中身份兼任同平章事，显示其宰相地位。","official_rank":"宰相级","source_snippet":"給事中、同平章事趙宗儒罷爲右庶子","start_index":12,"tongjian_id":"4d07808b-1e1e-4d94-9141-c6a6bf7b9269"},{"confidence":0.95,"official_category":"东宫官属","official_name":"右庶子","official_note":"右庶子是唐代东宫（太子府）的官职，负责辅佐太子，属于文教官。在此段中，趙宗儒被罢免給事中和同平章事后，改任右庶子，表示其官职降调。","official_rank":"正四品下","source_snippet":"給事中、同平章事趙宗儒罷爲右庶子","start_index":22,"tongjian_id":"7e889c28-f601-4091-9e9b-a44de2d54616"},{"confidence":0.95,"official_category":"财政","official_name":"工部侍郞","official_note":"工部侍郞是唐代工部的副长官，负责工程、工匠、屯田等事务，属于财政类官职。在此段中，鄭餘慶原任工部侍郞，后被任命为中书侍郎兼同平章事，显示其晋升。","official_rank":"正四品下","source_snippet":"以工部侍郞鄭餘慶爲中書侍郞、同平章事","start_index":30,"tongjian_id":"8ff93728-da97-4531-bcfe-b092980ae60b"},{"confidence":0.95,"official_category":"中枢机构","official_name":"中書侍郞","official_note":"中書侍郞是唐代中书省的副长官，负责起草诏令、参与决策，是重要的中枢官职。在此段中，鄭餘慶被任命为中书侍郎兼同平章事，表明其进入宰相行列。","official_rank":"正三品","source_snippet":"以工部侍郞鄭餘慶爲中書侍郞、同平章事","start_index":37,"tongjian_id":"0d47acaf-1a9d-4a73-8008-bc73a3a4f003"},{"confidence":0.95,"official_category":"中枢机构","official_name":"同平章事","official_note":"同平章事是唐代的宰相职衔，意为参与平章政事，通常由其他官职兼任。在此段中，鄭餘慶以中书侍郎身份兼任同平章事，显示其担任宰相职务。","official_rank":"宰相级","source_snippet":"以工部侍郞鄭餘慶爲中書侍郞、同平章事","start_index":42,"tongjian_id":"09e39ff3-a0be-4db8-bc1e-077c86d7000d"}],"ExtRef_Children_people":[{"link_birth_year":746,"link_death_year":832,"link_td_description":"赵宗儒，字秉文，唐代邓州穰县（今河南南阳）人。唐德宗时任宰相。","link_td_id":"Q10010739","link_td_number_id":1125133,"people_name":"趙宗儒","people_name_jianti_auto":"赵宗儒","people_xingming":"赵宗儒","start_index":17,"tongjian_id":"c261b00c-db0e-11ef-8814-a0d3651f611f"},{"people_name":"鄭餘慶","people_name_jianti_auto":"郑余庆","people_xingming":"郑余庆","start_index":31,"tongjian_id":"c261b00d-db0e-11ef-950a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"3秋，七月，壬申，給事中、同平章事趙宗儒罷爲右庶子，以工部侍郞鄭餘慶爲中書侍郞、同平章事。","content_fanyi":"秋季七月壬申，即二十五日，给事中、同平章事赵宗儒被解除宰相职务，降为右庶子；德宗将工部侍郎郑余庆提拔为中书侍郎、同平章事。","content_jianti_auto":"3秋，七月，壬申，给事中、同平章事赵宗儒罢为右庶子，以工部侍郞郑余庆为中书侍郞、同平章事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23691,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"c261b00b-db0e-11ef-9d17-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"觀此則知神策在六軍之外。","note_content_jianti_auto":"观此则知神策在六军之外。","note_type":"hu_note","start_index":14,"tongjian_id":"c261b00f-db0e-11ef-af1e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"稟，給也。","note_content_jianti_auto":"禀，给也。","note_type":"hu_note","start_index":25,"tongjian_id":"c261b010-db0e-11ef-9265-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"左、右神策統軍","official_note":"左、右神策統軍是唐代神策军的高级军官，负责统领神策军。神策军是唐代中后期重要的禁军，由宦官掌控，此处设置此官职反映了德宗时期神策军势力的扩张。","official_rank":"未知","source_snippet":"初置左、右神策統軍","start_index":2,"tongjian_id":"7e23b585-8727-4833-9785-f663d8504c09"},{"confidence":0.9,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉在唐代通常指神策军中尉，是神策军的最高指挥官，由宦官担任，掌握禁军实权。此处表明神策军行营皆归中尉统辖，凸显宦官对军队的控制。","official_rank":"未知","source_snippet":"皆統於中尉","start_index":39,"tongjian_id":"2d9e11aa-3b6f-421d-a819-86d2dcdb4801"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4八月，初置左、右神策統軍。時禁軍戍邊，稟賜優厚，諸將多請遙隸神策軍，稱行營，皆統於中尉，其軍遂至十五萬人。","content_fanyi":"八月，朝廷开始设置左、右神策军统军的职务。当时中央禁军戍守边疆，粮饷等给养和赏赐十分优厚，其他各镇的将领多请求隶属于神策军，受其遥控，称为行营，都归神策军护军中尉统辖，神策军的数量于是增至十五万人。","content_jianti_auto":"4八月，初置左、右神策统军。时禁军戍边，禀赐优厚，诸将多请遥隶神策军，称行营，皆统于中尉，其军遂至十五万人。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23692,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"c261b00e-db0e-11ef-af1e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_anno