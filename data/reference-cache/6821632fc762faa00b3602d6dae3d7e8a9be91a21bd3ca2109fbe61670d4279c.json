b0e-11ef-b3e5-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":94,"tongjian_id":"8c08f83f-db0e-11ef-b73c-a0d3651f611f"},{"place_name":"陽翟","place_name_jianti_auto":"阳翟","start_index":97,"tongjian_id":"8c08f840-db0e-11ef-b81b-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":103,"tongjian_id":"8c08f841-db0e-11ef-8822-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":106,"tongjian_id":"8c08f842-db0e-11ef-9ff4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓本都平陽，其地屬漢之河東郡；中間徙都陽翟。鄭都新鄭，其地屬漢之河南郡。鄭桓公始封於鄭，其地屬漢之京兆；後滅虢、鄶而國於溱、洧之間，故曰新鄭，左傳鄭莊公所謂「吾先君新邑於此」是也。今韓旣滅鄭，自陽翟徙都之。韓旣都鄭，故時人亦謂韓王爲鄭王，考之戰國策、韓非子可見。","note_content_jianti_auto":"韩本都平阳，其地属汉之河东郡；中间徙都阳翟。郑都新郑，其地属汉之河南郡。郑桓公始封于郑，其地属汉之京兆；后灭虢、郐而国于溱、洧之间，故曰新郑，左传郑庄公所谓「吾先君新邑于此」是也。今韩既灭郑，自阳翟徙都之。韩既都郑，故时人亦谓韩王为郑王，考之战国策、韩非子可见。","note_type":"hu_note","start_index":10,"tongjian_id":"8c08f828-db0e-11ef-a78d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":1,"tongjian_id":"8c08f846-db0e-11ef-96a0-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","resolved_place_entity_id":512,"start_index":3,"tongjian_id":"8c08f847-db0e-11ef-93e0-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"韩灭郑之战","tongjian_id":"war_N0505"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"]，哀侯徙新郑[故郑都也。哀侯二年，灭郑，自阳翟徙都之。...","context_before":"...贞子徙平阳[即尧都也]，景侯徙阳翟[阳翟，今河南禹州也。","source_end_index":99,"source_paragraph_tongjian_id":"7c3860cb-3b48-5998-be04-a3cb4fcd5376","source_start_index":82,"source_text":"本郑地，为韩所并，于是韩亦兼郑之称"},{"context_after":"或云懿侯复迁于阳翟]。","context_before":"...翟，今河南禹州也。本郑地，为韩所并，于是韩亦兼郑之称]，","source_end_index":127,"source_paragraph_tongjian_id":"7c3860cb-3b48-5998-be04-a3cb4fcd5376","source_start_index":101,"source_text":"哀侯徙新郑[故郑都也。哀侯二年，灭郑，自阳翟徙都之。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"秦始皇十七年灭韩，置颍川郡[《战国策》：游滕谓向寿，公何...","context_before":"...[《汲冢周书》：禹都阳城，后居阳翟]。春秋时，郑栎邑也。","source_end_index":45,"source_paragraph_tongjian_id":"a5ee382e-ea53-5b6a-90c4-07e4ea8938cc","source_start_index":33,"source_text":"战国属韩，自新郑徙都此。"},{"context_after":"秦置阳翟县，为颍川郡治。二世三年，沛公拔颍川，令韩王成留...","context_before":"...。战国初，入于韩。《郑世家》：繻公二十三年，围韩之阳翟。","source_end_index":180,"source_paragraph_tongjian_id":"b3150123-8266-5d64-af2a-a2acbc28d9d6","source_start_index":161,"source_text":"既而韩灭郑，都新郑，后复自新郑徙都焉。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2韓滅鄭，因徙都之。","content_fanyi":"韩国灭掉郑国，于是把国都迁到新郑。","content_jianti_auto":"2韩灭郑，因徙都之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":90,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c08f827-db0e-11ef-8245-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-410,"link_death_year":-375,"link_td_description":"赵敬侯，是中国战国时期赵国的君主，原名赵章，赵烈侯之子。","link_td_id":"Q10000668","link_td_number_id":334831,"people_name":"趙敬侯","people_name_jianti_auto":"赵敬侯","people_xingming":"章","start_index":1,"tongjian_id":"8c08f84a-db0e-11ef-a0f6-a0d3651f611f"},{"link_death_year":-350,"link_td_description":"赵成侯，中国战国时期赵国的君主，姓赵，名种，赵敬侯之子。","link_td_id":"Q10000669","link_td_number_id":334822,"people_name":"成侯","people_name_jianti_auto":"成侯","people_xingming":"赵种","start_index":7,"tongjian_id":"8c08f84b-db0e-11ef-bd6e-a0d3651f611f"},{"link_death_year":-350,"link_td_description":"赵成侯，中国战国时期赵国的君主，姓赵，名种，赵敬侯之子。","link_td_id":"Q10000669","link_td_number_id":334822,"people_name":"種","people_name_jianti_auto":"种"