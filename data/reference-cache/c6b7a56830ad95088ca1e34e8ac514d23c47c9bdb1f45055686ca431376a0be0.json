start_index":13,"tongjian_id":"903a2374-db0e-11ef-9145-a0d3651f611f"},{"place_name":"朔方","place_name_jianti_auto":"朔方","place_note":"內蒙杭锦旗北黄河南岸","resolved_place_entity_id":206,"start_index":26,"tongjian_id":"903a2375-db0e-11ef-991d-a0d3651f611f"},{"place_name":"浚稽山","place_name_jianti_auto":"浚稽山","place_note":"蒙古阿尔泰山","resolved_place_entity_id":3301,"start_index":37,"tongjian_id":"903a2376-db0e-11ef-9423-a0d3651f611f"},{"place_name":"受降城","place_name_jianti_auto":"受降城","resolved_place_entity_id":1496,"start_index":90,"tongjian_id":"903a237c-db0e-11ef-af32-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":97,"tongjian_id":"903a237d-db0e-11ef-8d0c-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":115,"tongjian_id":"903a237e-db0e-11ef-9244-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":149,"tongjian_id":"903a2380-db0e-11ef-bac2-a0d3651f611f"},{"place_name":"受降城","place_name_jianti_auto":"受降城","resolved_place_entity_id":1496,"start_index":163,"tongjian_id":"903a2381-db0e-11ef-9003-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"明都燕京，乃废大宁，弃开平，孰得而孰失哉？叶向高尝言：自...","context_before":"...，遂弃其地。驯致宣、蓟艰危，关门浅露，而窥伺及于畿辅矣。","source_end_index":98,"source_paragraph_tongjian_id":"ab97f8a9-f61e-5948-bc13-5135bbcfd15c","source_start_index":82,"source_text":"夫汉、唐都关中，开朔方、城受降。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"又天汉二年，诏李陵出遮虏障，至东浚稽山南龙勒水上，陵出居...","context_before":"浚稽山[亦在居延塞外。","source_end_index":39,"source_paragraph_tongjian_id":"4780ce02-d5b9-5ab0-a7c1-f651bfc62f03","source_start_index":11,"source_text":"汉太初二年，遣赵破奴出朔方西北二千余里，期至浚稽山而还。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"7上猶以受降城去匈奴遠，遣浚稽將軍趙破奴將二萬餘騎出朔方西北二千餘里，期至浚稽山而還。浞野侯旣至期，左大都尉欲發而覺，單于誅之，發左方兵擊浞野侯。浞野侯行捕首虜，得數千人，還，未至受降城四百里，匈奴兵八萬騎圍之。浞野侯夜自出求水，匈奴間捕生得浞野侯，因急擊其軍，軍吏畏亡將而誅，莫相勸歸者，軍遂沒於匈奴。兒單于大喜，因遣奇兵攻受降城，不能下，乃寇入邊而去。","content_fanyi":"汉武帝仍觉得受降城距匈奴太远，于是派浚稽将军赵破奴率领二万多骑兵从朔方郡出塞，向西北行进两千余里，准备到浚稽山接应匈奴左大都尉后返回。浞野侯按期到达后，匈奴左大都尉正要起事却被单于察觉，单于将他杀死，并调发左翼军队攻击浞野侯。浞野侯沿途捕杀敌军，俘获数千人，随后回师；行至距受降城还有四百里处，被匈奴八万骑兵包围。浞野侯夜间亲自出营寻找水源，被匈奴侦察骑兵活捉；匈奴军乘势猛攻汉军，汉军军吏害怕主将丧亡后自己会因此被诛杀，没有人鼓励同伴突围归汉，全军于是覆没于匈奴。儿单于大喜，于是派出奇兵攻打受降城，未能攻下，便侵入边境抢掠后离去。","content_jianti_auto":"7上犹以受降城去匈奴远，遣浚稽将军赵破奴将二万余骑出朔方西北二千余里，期至浚稽山而还。浞野侯既至期，左大都尉欲发而觉，单于诛之，发左方兵击浞野侯。浞野侯行捕首虏，得数千人，还，未至受降城四百里，匈奴兵八万骑围之。浞野侯夜自出求水，匈奴间捕生得浞野侯，因急击其军，军吏畏亡将而诛，莫相劝归者，军遂没于匈奴。儿单于大喜，因遣奇兵攻受降城，不能下，乃寇入边而去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1736,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"903a2363-db0e-11ef-9cd6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-103,"link_td_description":"儿宽，千乘（今山东滨州、东营一带）人，西汉政治家。","link_td_id":"Q10002404","link_td_number_id":345926,"people_name":"兒寬","people_name_jianti_auto":"儿宽","people_xingming":"兒宽","start_index":7,"tongjian_id":"903a2384-db0e-11ef-9b76-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8冬，十二月，兒寬卒。","content_fanyi":"冬季十二月，御史大夫兒宽去世。","content_jianti_auto":"8冬，十二月，儿宽卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1737,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"903a2382-db0e-11ef-bad3-a0d3651f611f"}],"reign_name":"二年","reign_name_jianti_auto":"二年","start_index":6,"tongjian_id":"9038978d-db0e-11ef-88c4-a0d3651f611f","year_anno":"（戊寅、前一○三）","year_int":-103},"message":"success","success":true}