,"start_index":9,"tongjian_id":"97796bd6-db0e-11ef-915b-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『張：「月」下脫「堅從」二字。』","note_content_jianti_auto":"『张：「月」下脱「坚从」二字。』","note_type":"『張：[^』]*』","start_index":0,"tongjian_id":"97796bd4-db0e-11ef-abbc-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":32,"tongjian_id":"97796bd3-db0e-11ef-95ae-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"司馬","official_note":"司馬是漢代地方郡國的軍事官員，負責輔佐郡守處理軍務。在《資治通鑑》此段中，孫堅擔任吳郡司馬，負責招募士兵協助討伐叛亂，體現其軍事職能。此信息基於漢代官制常識。","official_rank":"未知","source_snippet":"吳郡司馬富春孫堅召募精勇","start_index":2,"tongjian_id":"cb26915c-96ef-4d34-8901-95c4115bc18e"}],"ExtRef_Children_people":[{"link_birth_year":155,"link_death_year":191,"link_td_description":"孙坚，字文臺，吴郡富春县（今浙江省杭州市富陽区）人，东汉末年軍閥諸侯将领，是孙吴勢力的首創者，奠基者孫策和建國者孫權的父親，漢破虏將軍、封乌程侯、领豫州刺史、長沙太守。在討伐董卓期間擔任先鋒建立許多戰功，諸如斬殺華雄、擊敗呂布、率先進入洛陽、迫使董卓求和等事蹟。史载其“容貌不凡，性阔达，好奇节”。后在军阀混战中阵亡。其次子孫權稱帝後，追尊為武烈皇帝，庙号始祖。","link_td_id":"Q10000075","link_td_number_id":17470,"people_name":"孫堅","people_name_jianti_auto":"孙坚","people_xingming":"孙坚","start_index":7,"tongjian_id":"97796bd8-db0e-11ef-bae5-a0d3651f611f"},{"people_name":"許生","people_name_jianti_auto":"许生","people_xingming":"许生","start_index":23,"tongjian_id":"97796bd9-db0e-11ef-95b1-a0d3651f611f","wl_zhushi":"[阳明皇帝]"},{"link_td_description":"臧旻，徐州广陵郡射阳（今江苏省宝应东北射阳湖镇）人，东汉政治人物。汉灵帝时代的将领，历任扬州刺史。对西域的土地、风俗、人物非常熟悉。臧洪之父。","link_td_id":"Q10013827","link_td_number_id":1628895,"people_name":"臧旻","people_name_jianti_auto":"臧旻","people_xingming":"臧旻","start_index":32,"tongjian_id":"97796bdc-db0e-11ef-817a-a0d3651f611f"},{"link_td_description":"陈寅，陈氏，名寅，中国春秋时期宋国乐祁的家宰（家臣之首）。","link_td_id":"Q10024576","link_td_number_id":8986230,"people_name":"陳寅","people_name_jianti_auto":"陈寅","people_xingming":"陈寅","start_index":35,"tongjian_id":"97796bdd-db0e-11ef-b161-a0d3651f611f"},{"people_name":"生","people_name_jianti_auto":"生","people_xingming":"许生","start_index":39,"tongjian_id":"97796bde-