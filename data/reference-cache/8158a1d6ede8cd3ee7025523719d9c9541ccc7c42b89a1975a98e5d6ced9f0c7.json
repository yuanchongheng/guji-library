ldren_zhang_notes":[],"note_content":"暢，中山簡王焉之曾孫。焉，光武子。考異曰：本傳云：「子節王稚嗣，無子，國除。」與帝紀異，未知孰是，又不知稚薨在何年，今且從帝紀。","note_content_jianti_auto":"畅，中山简王焉之曾孙。焉，光武子。考异曰：本传云：「子节王稚嗣，无子，国除。」与帝纪异，未知孰是，又不知稚薨在何年，今且从帝纪。","note_type":"hu_note","start_index":17,"tongjian_id":"97772220-db0e-11ef-957e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"刘畅，东汉光武帝刘秀兄长刘縯的曾孙、齐炀王刘石之子。","link_td_id":"Q10020237","link_td_number_id":6187707,"people_name":"中山穆王","people_name_jianti_auto":"中山穆王","people_xingming":"刘畅","start_index":4,"tongjian_id":"9777222d-db0e-11ef-942d-a0d3651f611f"},{"link_td_description":"刘畅，东汉光武帝刘秀兄长刘縯的曾孙、齐炀王刘石之子。","link_td_id":"Q10020237","link_td_number_id":6187707,"people_name":"暢","people_name_jianti_auto":"畅","people_xingming":"刘畅","start_index":8,"tongjian_id":"9777222e-db0e-11ef-937b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3三月，中山穆王暢薨，無子，國除。","content_fanyi":"三月，中山穆王刘畅去世，没有子嗣，封国被撤销。","content_jianti_auto":"3三月，中山穆王畅薨，无子，国除。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4869,"number":3,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":2,"tongjian_id":"9777221f-db0e-11ef-a191-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"康","people_name_jianti_auto":"康","start_index":8,"tongjian_id":"97772231-db0e-11ef-a3e3-a0d3651f611f"},{"people_name":"孝仁皇","people_name_jianti_auto":"孝仁皇","start_index":10,"tongjian_id":"97772232-db0e-11ef-a348-a0d3651f611f"},{"people_name":"利","people_name_jianti_auto":"利","start_index":15,"tongjian_id":"97772233-db0e-11ef-8e04-a0d3651f611f"}],"ExtRef_C