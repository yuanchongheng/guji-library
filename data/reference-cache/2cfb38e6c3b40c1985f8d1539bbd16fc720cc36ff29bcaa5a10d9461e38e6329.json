":37,"tongjian_id":"9221184f-db0e-11ef-9e92-a0d3651f611f"},{"place_name":"長楊","place_name_jianti_auto":"长杨","resolved_place_entity_id":3019,"start_index":59,"tongjian_id":"92211850-db0e-11ef-b7c2-a0d3651f611f"},{"place_name":"射熊館","place_name_jianti_auto":"射熊馆","resolved_place_entity_id":4517,"start_index":61,"tongjian_id":"92211851-db0e-11ef-9fb9-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":78,"tongjian_id":"92211852-db0e-11ef-9fc3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"五柞宫门外有柞树五。又南有清梧观，观前有梧桐三，因名。○...","context_before":"...杨宫赋》，谓此宫门有射熊馆。元帝永元五年，幸长杨射熊馆。","source_end_index":144,"source_paragraph_tongjian_id":"e2754594-5c16-503d-9db0-4935d9647266","source_start_index":129,"source_text":"成帝元延三年，校猎长杨射熊馆。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"4上將大誇胡人以多禽獸，秋，命右扶風發民入南山，西自褒、斜，東至弘農，南敺漢中，張羅罔罝罘，捕熊羆禽獸，載以檻車，輸之長楊射熊館，以罔爲周阹，縱禽獸其中，令胡人手搏之，自取其獲，上親臨觀焉。","content_fanyi":"汉成帝想要向胡人使节贵宾夸耀苑囿中禽兽众多，秋季，命令右扶风郡守征发百姓进入终南山，西起褒、斜两谷，东到弘农郡，南达汉中，在绵延千里的山峦中张设罗网罝罘等网具，捕捉熊罴等禽兽，用槛车装载，运送到长杨宫的射熊馆，用网做成四面围障，把捕捉到的禽兽放入其中，让胡人徒手与它们搏斗，捕获的猎物归本人所有。汉成帝亲自到场观看取乐。","content_jianti_auto":"4上将大夸胡人以多禽兽，秋，命右扶风发民入南山，西自褒、斜，东至弘农，南敺汉中，张罗罔罝罘，捕熊罴禽兽，载以槛车，输之长杨射熊馆，以罔为周阹，纵禽兽其中，令胡人手搏之，自取其获，上亲临观焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2531,"number":4,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"9221181f-db0e-11ef-a4b4-a0d3651f611f"}],"reign_name":"三年","reign_name_jianti_auto":"三年","start_index":3,"tongjian_id":"922117cb-db0e-11ef-ad99-a0d3651f611f","year_anno":"（辛亥、前一○）","year_int":-10},"message":"success","success":true}