ngjian_id":"922117d9-db0e-11ef-a98f-a0d3651f611f"},{"place_name":"大江","place_name_jianti_auto":"大江","start_index":66,"tongjian_id":"922117da-db0e-11ef-8833-a0d3651f611f"},{"place_name":"羊膊嶺","place_name_jianti_auto":"羊膊岭","start_index":71,"tongjian_id":"922117db-db0e-11ef-8f34-a0d3651f611f"},{"place_name":"白馬嶺","place_name_jianti_auto":"白马岭","start_index":99,"tongjian_id":"922117dc-db0e-11ef-b6a7-a0d3651f611f"},{"place_name":"天彭關","place_name_jianti_auto":"天彭关","start_index":105,"tongjian_id":"922117dd-db0e-11ef-a0e8-a0d3651f611f"},{"place_name":"天谷","place_name_jianti_auto":"天谷","start_index":112,"tongjian_id":"922117de-db0e-11ef-ba90-a0d3651f611f"},{"place_name":"天彭山","place_name_jianti_auto":"天彭山","start_index":115,"tongjian_id":"922117df-db0e-11ef-b2e5-a0d3651f611f"},{"place_name":"天彭門","place_name_jianti_auto":"天彭门","start_index":130,"tongjian_id":"922117e0-db0e-11ef-8060-a0d3651f611f"},{"place_name":"江水","place_name_jianti_auto":"江水","start_index":134,"tongjian_id":"922117e1-db0e-11ef-b7b4-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":153,"tongjian_id":"922117e2-db0e-11ef-8fe6-a0d3651f611f"},{"place_name":"岷山","place_name_jianti_auto":"岷山","start_index":158,"tongjian_id":"922117e3-db0e-11ef-a965-a0d3651f611f"},{"place_name":"江水","place_name_jianti_auto":"江水","start_index":163,"tongjian_id":"922117e4-db0e-11ef-ba32-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志，岷山，在蜀郡湔氐道西徼外。禹貢所謂岷山導江，卽此山也。水經註曰：岷山，卽瀆山，水曰瀆水，亦曰汶阜山，在氐道徼外，江水所導也。大江泉源發羊膊嶺下，緣崖散漫，小大百數，殆未濫觴，東南下百餘里，至白馬嶺西，歷天彭關，亦謂之天谷。天彭山兩山相對，其高若闕，謂之天彭門。江水自此以上至微弱，所謂其源濫觴者也。漢元延中，岷山崩，壅江水三日不流，卽其處。岷，音武巾翻。","note_content_jianti_auto":"地理志，岷山，在蜀郡湔氐道西徼外。禹贡所谓岷山导江，即此山也。水经注曰：岷山，即渎山，水曰渎水，亦曰汶阜山，在氐道徼外，江水所导也。大江泉源发羊膊岭下，缘崖散漫，小大百数，殆未滥觞，东南下百余里，至白马岭西，历天彭关，亦谓之天谷。天彭山两山相对，其高若阙，谓之天彭门。江水自此以上至微弱，所谓其源滥觞者也。汉元延中，岷山崩，壅江水三日不流，即其处。岷，音武巾翻。","note_type":"hu_note","start_index":15,"tongjian_id":"922117ce-db0e-11ef-ac78-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惡，音烏路翻；惡其徵異也。","note_content_jianti_auto":"恶，音乌路翻；恶其征异也。","note_type":"hu_note","start_index":30,"tongjian_id":"922117e8-db0e-11ef-9119-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周幽王","people_name_jianti_auto":"周幽王","start_index":0,"tongjian_id":"922117ea-db0e-11ef-9315-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":14,"tongjian_id":"922117eb-db0e-11ef-a8a5-a0d3651f611f"},{"people_name":"幽王","people_name_jianti_auto":"幽王","start_index":38,"tongjian_id":"922117ec-db0e-11ef-b8b9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"三川","place_name_jianti_auto":"三川","start_index":6,"tongjian_id":"922117ed-db0e-11ef-a686-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":10,"tongjian_id":"922117ee-db0e-11ef-922f-a0d3651f611f"},{"place_name":"三川","place_name_jianti_auto":"三川","start_index":18,"tongjian_id":"922117ef-db0e-11ef-9817-a0d3651f611f"},{"place_name":"涇","place_name_jianti_auto":"泾","start_index":21,"tongjian_id":"922117f0-db0e-11ef-b6e6-a0d3651f611f"},{"place_name":"渭","place_name_jianti_auto":"渭","start_index":23,"tongjian_id":"922117f1-db0e-11ef-9023-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":25,"tongjian_id":"922117f2-db0e-11ef-8da5-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":28,"tongjian_id":"922117f3-db0e-11ef-b38e-a0d3651f611f"},{"place_name":"漆","place_name_jianti_auto":"漆","start_index":31,"tongjian_id":"922117f4-db0e-11ef-afce-a0d3651f611f"},{"place_name":"沮","place_name_jianti_auto":"沮","start_index":33,"tongjian_id":"922117f5-db0e-11ef-aaab-a0d3651f611f"},{"place_name":"犬戎","place_name_jianti_auto":"犬戎","start_index":48,"tongjian_id":"922117f6-db0e-11ef-a339-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周幽王二年，三川竭，岐山崩。師古曰：三川，涇、渭、洛也。洛，卽漆、沮也。余按幽王時有是異，後卒爲犬戎所殺。","note_content_jianti_auto":"周幽王二年，三川竭，岐山崩。师古曰：三川，泾、渭、洛也。洛，即漆、沮也。余按幽王时有是异，后卒为犬戎所杀。","note_type":"hu_note","start_index":48,"tongjian_id":"922117e9-db0e-11ef-a693-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"太王","people_name_jianti_auto":"太王","start_index":2,"tongjian_id":"922117f8-db0e-11ef-bdae-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":0,"tongjian_id":"922117f9-db0e-11ef-a10b-a0d3651f611f"},{"place_name":"狄","place_name_jianti_auto":"狄","start_index":5,"tongjian_id":"922117fa-db0e-11ef-93c8-a0d3651f611f"},{"place_name":"豳","place_name_jianti_auto":"豳","start_index":7,"tongjian_id":"922117fb-db0e-11ef-adff-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":12,"tongjian_id":"922117fc-db0e-11ef-9bf7-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":17,"tongjian_id":"922117fd-db0e-11ef-8c84-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周自太王避狄去豳，而邑于岐山之下，周之王業遂興於此。","note_content_jianti_auto":"周自太王避狄去豳，而邑于岐山之下，周之王业遂兴于此。","note_type":"hu_note","start_index":57,"tongjian_id":"922117f7-db0e-11ef-92f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":0,"tongjian_id":"922117ff-db0e-11ef-ac28-a0d3651f611f"},{"people_name":"項羽","people_name_jianti_auto":"项羽","start_index":15,"tongjian_id":"92211800-db0e-11ef-9d0b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢中","place_name_jianti_auto":"汉中","start_index":4,"tongjian_id":"92211801-db0e-11ef-9d42-a0d3651f611f"},{"place_name":"三秦","place_name_jianti_auto":"三秦","start_index":11,"tongjian_id":"92211802-db0e-11ef-a3e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高帝始王漢中，起兵還定三秦，誅項羽，遂有天下。","note_content_jianti_auto":"高帝始王汉中，起兵还定三秦，诛项羽，遂有天下。","note_type":"hu_note","start_index":66,"tongjian_id":"922117fe-db0e-11ef-b266-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":109,"tongjian_id":"92211804-db0e-11ef-a77a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"天文志：房南衆星曰騎官，左角理，右角將。大角者，天王帝坐庭，其兩旁各有三星鼎足句之，曰攝提。攝提者，直斗杓所指，以建時節，故曰攝提格。晉·天文志：參十星，於辰在申。至辰者，至大火也。自氐五度至尾九度，爲大火，於辰在卯。如淳曰：孛星尾長及攝提大角，始發於參至辰也。孛，蒲內翻。參，疏簪翻。","note_content_jianti_auto":"天文志：房南众星曰骑官，左角理，右角将。大角者，天王帝坐庭，其两旁各有三星鼎足句之，曰摄提。摄提者，直斗杓所指，以建时节，故曰摄提格。晋·天文志：参十星，于辰在申。至辰者，至大火也。自氐五度至尾九度，为大火，于辰在卯。如淳曰：孛星尾长及摄提大角，始发于参至辰也。孛，蒲内翻。参，疏簪翻。","note_type":"hu_note","start_index":92,"tongjian_id":"92211803-db0e-11ef-951d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-77,"link_death_year":-6,"link_td_description":"刘向，字子政，原名更生，西汉宗室。著有《别录》《新序》《说苑》《列女传》《洪范五行传论》《五纪论》等书，并且编订了《战国策》《楚辞》《孙卿新书》。刘向曾官中垒校尉，故世称刘中垒。","link_td_id":"Q10002065","link_td_number_id":107320,"people_name":"劉向","people_name_jianti_auto":"刘向","people_xingming":"刘更生","start_index":24,"tongjian_id":"92211809-db0e-11ef-bb83-a0d3651f611f","wl_zhushi":"[刘更生]"},{"link_birth_year":-796,"link_death_year":-771,"link_td_description":"周幽王，姬姓，名宫涅，《史记》作宫湦。周宣王之子，西周第十二代君王，也是西周的亡国之君。自前782年至前771年间在位，共11年，谥幽。","link_td_id":"Q10004248","link_td_number_id":177776,"people_name":"幽王","people_name_jianti_auto":"幽王","people_xingming":"姬宫湦","start_index":44,"tongjian_id":"9221180c-db0e-11ef-9de5-a0d3651f611f","wl_zhushi":"[姬宫湦]"}],"ExtRef_Chi