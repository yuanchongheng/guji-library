hildren_places":[{"place_name":"汀州","place_name_jianti_auto":"汀州","place_note":"福建长汀县","start_index":5,"tongjian_id":"cab7f100-db0e-11ef-9a73-a0d3651f611f"},{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":9,"tongjian_id":"cab7f101-db0e-11ef-807c-a0d3651f611f"},{"place_name":"汀州","place_name_jianti_auto":"汀州","place_note":"福建长汀县","start_index":20,"tongjian_id":"cab7f102-db0e-11ef-9d7e-a0d3651f611f"},{"place_name":"虔","place_name_jianti_auto":"虔","start_index":26,"tongjian_id":"cab7f103-db0e-11ef-b7ae-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按九域志，汀州北至虔州四百八十里。移兵屯汀州，示將救虔也。","note_content_jianti_auto":"按九域志，汀州北至虔州四百八十里。移兵屯汀州，示将救虔也。","note_type":"hu_note","start_index":217,"tongjian_id":"cab7f0ff-db0e-11ef-bff8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"cab7f0ed-db0e-11ef-a94a-a0d3651f611f","pinyin":"yú","source_anchor_text":"亭閩兵屯雩都以救之","source_key":"baiyang_epub","start_index":105,"text":"雩","tongjian_id":"20b1b05a-3dd8-5860-95cc-50c4754fb69b"}],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","place_note":"江苏苏州","resolved_place_entity_id":714,"start_index":202,"tongjian_id":"cab7f122-db0e-11ef-ab21-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十二、赣州府（卷八十八）","excerpts":[{"context_after":"○东桥，在府城东建春门外贡水上，旧名东津渡。宋绍兴中，郡...","context_before":"古亭[在府西。","source_end_index":53,"source_paragraph_tongjian_id":"e855618c-5f5b-54ec-98f9-934fa1014e55","source_start_index":7,"source_text":"五代梁贞明四年，淮南攻虔州，州将谭全播求救于楚，楚遣兵屯古亭以救之，为淮南将张宣所破，即此。"},{"context_after":"旧有土城，宋绍兴十五年甃以砖石，明年为水所圮，开禧三年补...","context_before":"...。唐贞观中大水，安抚大使任怀玉移治南康古郡城，即今治也。","source_end_index":117,"source_paragraph_tongjian_id":"70b423fe-5f3c-5c32-afeb-f930f1becca6","source_start_index":90,"source_text":"五代梁贞明四年，淮南攻虔州，闽兵屯雩都以救之，寻引退。"}],"path":"江西方舆纪要/十二、赣州府（卷八十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"18虔州險固，吳軍攻之，久不下，軍中大疫，王祺病，吳以鎭南節度使劉信爲虔州行營招討使，未幾，祺卒。譚全播求救於吳越、閩、楚。吳越王鏐以統軍使傳球爲西南面行營應援使，將兵二萬攻信州；楚將張可求將萬人屯古亭，閩兵屯雩都以救之。信州兵纔數百，逆戰，不利；吳越兵圍其城。刺史周本，啓關張虛幕於門內，召僚佐登城樓作樂宴飲，飛矢雨集，安坐不動；吳越疑有伏兵，中夜，解圍去。吳以前舒州刺史陳璋爲東南面應援招討使，將兵侵蘇、湖，錢傳球自信州南屯汀州。晉王遣間使持帛書會兵於吳，吳人辭以虔州之難。","content_fanyi":"虔州城险要坚固，吴军围攻很久仍未能攻下，军中瘟疫流行，王祺也染病，吴国只好任命镇南节度使刘信为虔州行营招讨使，不久，王祺去世。谭全播向吴越、闽、楚三国求救。吴越王钱镠任命统军使钱传球为西南面行营应援使，率领二万名士兵进攻吴国的信州；楚国将领张可求率领一万名士兵驻扎在古亭，闽军驻扎在雩都，准备救援谭全播。吴国信州守军只有几百人，出城迎战，交战不利；吴越军于是包围了信州城。信州刺史周本打开城门，在门内张设空帐篷，召集僚佐登上城楼奏乐宴饮，城外射来的箭像雨点一样密集，周本等人安坐不动；吴越军怀疑城中有伏兵，到了半夜，解围撤走。吴国任命前舒州刺史陈璋为东南面应援招讨使，率兵侵入吴越境内的苏州、湖州，钱传球从信州南下驻扎在汀州。晋王派遣密使携带帛书前往吴国约请会师攻梁，吴人以虔州战事推辞。","content_jianti_auto":"18虔州险固，吴军攻之，久不下，军中大疫，王祺病，吴以镇南节度使刘信为虔州行营招讨使，未几，祺卒。谭全播求救于吴越、闽、楚。吴越王镠以统军使传球为西南面行营应援使，将兵二万攻信州；楚将张可求将万人屯古亭，闽兵屯雩都以救之。信州兵才数百，逆战，不利；吴越兵围其城。刺史周本，启关张虚幕于门内，召僚佐登城楼作乐宴饮，飞矢雨集，安坐不动；吴越疑有伏兵，中夜，解围去。吴以前舒州刺史陈璋为东南面应援招讨使，将兵侵苏、湖，钱传球自信州南屯汀州。晋王遣间使持帛书会兵于吴，吴人辞以虔州之难。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28071,"number":18,"path":"资治通鉴 : 卷第二百七十 (後梁紀五) / 均王中 / 四年 / 第 31 段","reading_annotation_sources":[],"start_index":30,"tongjian_id":"cab7f0ed-db0e-11ef-a94a-a0d3651f611f","year_int":918},"tongjian_id":"cab7f0ed-db0e-11ef-a94a-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"蘇","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楊溥","people_name_jianti_auto":"杨溥","start_index":13,"tongjian_id":"cefbb4ef-db0e-11ef-a134-a0d3651f611f"},{"people_name":"徐溫","people_name_jianti_auto":"徐温","start_index":23,"tongjian_id":"cefbb4f0-db0e-11ef-8d1c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"迎鑾鎭","place_name_jianti_auto":"迎銮镇","start_index":0,"tongjian_id":"cefbb4f1-db0e-11ef-9a84-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":5,"tongjian_id":"cefbb4f2-db0e-11ef-8351-a0d3651f611f"},{"place_name":"白沙","place_name_jianti_auto":"白沙","start_index":7,"tongjian_id":"cefbb4f3-db0e-11ef-85f7-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":11,"tongjian_id":"cefbb4f4-db0e-11ef-b910-a0d3651f611f"},{"place_name":"白沙","place_name_jianti_auto":"白沙","start_index":16,"tongjian_id":"cefbb4f5-db0e-11ef-9a5c-a0d3651f611f"},{"place_name":"金陵","place_name_jianti_auto":"金陵","start_index":26,"tongjian_id":"cefbb4f6-db0e-11ef-a743-a0d3651f611f"},{"place_name":"白沙","place_name_jianti_auto":"白沙","start_index":33,"tongjian_id":"cefbb4f7-db0e-11ef-8611-a0d3651f611f"},{"place_name":"迎鑾鎭","place_name_jianti_auto":"迎銮镇","start_index":36,"tongjian_id":"cefbb4f8-db0e-11ef-a8da-a0d3651f611f"},{"place_name":"白沙","place_name_jianti_auto":"白沙","start_index":40,"tongjian_id":"cefbb4f9-db0e-11ef-8072-a0d3651f611f"},{"place_name":"江都","place_name_jianti_auto":"江都","start_index":47,"tongjian_id":"cefbb4fa-db0e-11ef-854d-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府【江苏南京】","start_index":50,"tongjian_id":"cefbb4fb-db0e-11ef-a799-a0d3651f611f"},{"place_name":"江都","place_name_jianti_auto":"江都","start_index":52,"tongjian_id":"cefbb4fc-db0e-11ef-8a38-a0d3651f611f"},{"place_name":"永貞縣","place_name_jianti_auto":"永贞县","start_index":55,"tongjian_id":"cefbb4fd-db0e-11ef-be70-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":59,"tongjian_id":"cefbb4fe-db0e-11ef-8ca2-a0d3651f611f"},{"place_name":"迎鑾鎭","place_name_jianti_auto":"迎銮镇","start_index":61,"tongjian_id":"cefbb4ff-db0e-11ef-b17e-a0d3651f611f"},{"place_name":"宋","place_name_jianti_auto":"宋","start_index":65,"tongjian_id":"cefbb500-db0e-11ef-be9c-a0d3651f611f"},{"place_name":"眞州","place_name_jianti_auto":"真州","start_index":67,"tongjian_id":"cefbb501-db0e-11ef-b6b1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"迎鑾鎭，本唐之白沙也。吳主楊溥至白沙，閱舟師，徐溫自金陵來見，因以白沙爲迎鑾鎭。白沙之地，本屬江都，唐分江都置永貞縣，吳爲迎鑾鎭，宋爲眞州。","note_content_jianti_auto":"迎銮镇，本唐之白沙也。吴主杨溥至白沙，阅舟师，徐温自金陵来见，因以白沙为迎銮镇。白沙之地，本属江都，唐分江都置永贞县，吴为迎銮镇，宋为真州。","note_type":"hu_note","start_index":11,"tongjian_id":"cefbb4ee-db0e-11ef-b7ec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":22,"tongjian_id":"cefbb503-db0e-11ef-ba20-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"東㳍洲","place_name_jianti_auto":"东㳍洲","start_index":0,"tongjian_id":"cefbb504-db0e-11ef-a514-a0d3651f611f"},{"place_name":"泰州","place_name_jianti_auto":"泰州","start_index":5,"tongjian_id":"cefbb505-db0e-11ef-aaaa-a0d3651f611f"},{"place_name":"大江","place_name_jianti_auto":"大江","start_index":9,"tongjian_id":"cefbb506-db0e-11ef-9efb-a0d3651f611f"},{"place_name":"東㳍洲","place_name_jianti_auto":"东㳍洲","start_index":26,"tongjian_id":"cefbb507-db0e-11ef-ad64-a0d3651f611f"},{"place_name":"通州","place_name_jianti_auto":"通州","start_index":30,"tongjian_id":"cefbb508-db0e-11ef-8ad1-a0d3651f611f"},{"place_name":"通州","place_name_jianti_auto":"通州","start_index":35,"tongjian_id":"cefbb509-db0e-11ef-91f2-a0d3651f611f"},{"place_name":"海門縣","place_name_jianti_auto":"海门县","start_index":37,"tongjian_id":"cefbb50a-db0e-11ef-ab08-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東㳍洲，在泰州東南大江中，元是海嶼沙島之地。宋白曰：東㳍洲在通州東南，通州海門縣界。㳍，音布。「州」，當作「洲」。","note_content_jianti_auto":"东㳍洲，在泰州东南大江中，元是海屿沙岛之地。宋白曰：东㳍洲在通州东南，通州海门县界。㳍，音布。「州」，当作「洲」。","note_type":"hu_note","start_index":49,"tongjian_id":"cefbb502-db0e-11ef-bbba-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楊行密","people_name_jianti_auto":"杨行密","start_index":3,"tongjian_id":"cefbb50c-db0e-11ef-9a33-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府【江苏南京】","start_index":0,"tongjian_id":"cefbb50d-db0e-11ef-8ced-a0d3651f611f"},{"place_name":"廬州","place_name_jianti_auto":"庐州","start_index":7,"tongjian_id":"cefbb50e-db0e-11ef-bf44-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":20,"tongjian_id":"cefbb50f-db0e-11ef-b676-a0d3651f611f"},{"place_name":"淮","place_name_jianti_auto":"淮","start_index":23,"tongjian_id":"cefbb510-db0e-11ef-b9f6-a0d3651f611f"},{"place_name":"舒","place_name_jianti_auto":"舒","place_note":"安徽潜山","start_index":25,"tongjian_id":"cefbb511-db0e-11ef-bbb0-a0d3651f611f"},{"place_name":"蘄","place_name_jianti_auto":"蕲","place_note":"湖北蕲春","start_index":27,"tongjian_id":"cefbb512-db0e-11ef-9b96-a0d3651f611f"},{"place_name":"黃","place_name_jianti_auto":"黄","place_note":"湖北黄州","start_index":29,"tongjian_id":"cefbb513-db0e-11ef-bf69-a0d3651f611f"},{"place_name":"廬","place_name_jianti_auto":"庐","start_index":36,"tongjian_id":"cefbb514-db0e-11ef-8d8a-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":45,"tongjian_id":"cefbb515-db0e-11ef-8b73-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐末，楊行密自廬州起，旣建國，遂爲重鎭。周師渡淮，舒、蘄、黃先皆款附，獨廬未下，蓋宿兵多，周師不敢輕犯也。趣，七喻翻。","note_content_jianti_auto":"唐末，杨行密自庐州起，既建国，遂为重镇。周师渡淮，舒、蕲、黄先皆款附，独庐未下，盖宿兵多，周师不敢轻犯也。趣，七喻翻。","note_type":"hu_note","start_index":106,"tongjian_id":"cefbb50b-db0e-11ef-bf0e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","resolved_place_entity_id":714,"start_index":44,"tongjian_id":"cefdfeeb-db0e-11ef-8726-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、扬州府（卷二十三）","excerpts":[{"context_after":"宋建隆初，太祖平李重进于扬州，令诸军习战舰于迎銮镇。南唐...","context_before":"...年，杨溥如白沙观楼船，徐温自金陵来朝，因号白沙为迎銮镇。","source_end_index":170,"source_paragraph_tongjian_id":"bc994217-a944-5aea-9eca-6f9dee2501f8","source_start_index":147,"source_text":"周显德五年，周主如迎銮镇，屡至江口，破唐水军。"},{"context_after":"《纪胜》云：大安镇即东布洲也，本海中沙岛，后涨成陆地，民...","context_before":"布洲夹[州南四十里。有南布洲、东布洲，大海中沙涨为洲也。","source_end_index":91,"source_paragraph_tongjian_id":"5622b465-5cb3-5a53-baaa-eaeb6b75134b","source_start_index":28,"source_text":"五代周显德五年，取唐淮南，驻军迎銮镇，闻唐战舰数百艘泊东布洲，将趣海口，扼苏杭路，周主遣慕容延钊等将水陆两军循江而下，击破之。"}],"path":"南直方舆纪要/四、扬州府（卷二十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"18辛卯，上如迎鑾鎭，屢至江口，遣水軍擊唐兵，破之。上聞唐戰艦數百艘泊東㳍州，將趣海口扼蘇、杭路，遣殿前都虞候慕容延釗將步騎，右神武統軍宋延渥將水軍，循江而下。甲午，延釗奏大破唐兵於東㳍州；上遣李重進將兵趣廬州。","content_fanyi":"三月十日辛卯，后周世宗前往迎銮镇，多次到达长江口，派遣水军进攻南唐军队，并将其击败。世宗听说南唐数百艘战舰停泊在东㳍州，将要直趋入海口以扼守通往苏州、杭州的道路，便派殿前都虞候慕容延钊率领步兵和骑兵，右神武统军宋延渥率领水军，顺长江而下。三月十三日甲午，慕容延钊奏报在东㳍州大败南唐军队；世宗派遣李重进率兵奔赴庐州。","content_jianti_auto":"18辛卯，上如迎銮镇，屡至江口，遣水军击唐兵，破之。上闻唐战舰数百艘泊东㳍州，将趣海口扼苏、杭路，遣殿前都虞候慕容延钊将步骑，右神武统军宋延渥将水军，循江而下。甲午，延钊奏大破唐兵于东㳍州；上遣李重进将兵趣庐州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30881,"number":18,"path":"资治通鉴 : 卷第二百九十四 (後周紀五) / 世宗睿武孝文皇帝下 / 顯德五年 / 第 18 段","reading_annotation_sources":[],"start_index":17,"tongjian_id":"cefbb4ed-db0e-11ef-9270-a0d3651f611f","year_int":958},"tongjian_id":"cefbb4ed-db0e-11ef-9270-a0d3651f611f"},"paragraph_order":6}],"page_size":10,"total_pages":1,"total_paragraphs":6},"place_name":"蘇"},"message":"success","success":true}