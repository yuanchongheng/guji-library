a0d3651f611f"},{"place_name":"湖","place_name_jianti_auto":"湖","place_note":"浙江湖州","start_index":31,"tongjian_id":"bea407e2-db0e-11ef-b758-a0d3651f611f"},{"place_name":"昇州","place_name_jianti_auto":"升州","start_index":36,"tongjian_id":"bea407e3-db0e-11ef-832a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"浙西道節度使兼江寧軍使，領昇、潤、宣、歙、饒、江、蘇、常、杭、湖十州，治昇州。","note_content_jianti_auto":"浙西道节度使兼江宁军使，领升、润、宣、歙、饶、江、苏、常、杭、湖十州，治升州。","note_type":"hu_note","start_index":33,"tongjian_id":"bea407d6-db0e-11ef-8f9c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"浙東道","place_name_jianti_auto":"浙东道","start_index":0,"tongjian_id":"bea407e5-db0e-11ef-a61e-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","start_index":7,"tongjian_id":"bea407e6-db0e-11ef-9531-a0d3651f611f"},{"place_name":"睦","place_name_jianti_auto":"睦","start_index":9,"tongjian_id":"bea407e7-db0e-11ef-a3a9-a0d3651f611f"},{"place_name":"衢","place_name_jianti_auto":"衢","place_note":"浙江衢州","start_index":11,"tongjian_id":"bea407e8-db0e-11ef-b63a-a0d3651f611f"},{"place_name":"婺","place_name_jianti_auto":"婺","place_note":"浙江金华","start_index":13,"tongjian_id":"bea407e9-db0e-11ef-8b8c-a0d3651f611f"},{"place_name":"台","place_name_jianti_auto":"台","place_note":"浙江临海","start_index":15,"tongjian_id":"bea407ea-db0e-11ef-9f8f-a0d3651f611f"},{"place_name":"明","place_name_jianti_auto":"明","place_note":"浙江宁波","start_index":17,"tongjian_id":"bea407eb-db0e-11ef-982c-a0d3651f611f"},{"place_name":"處","place_name_jianti_auto":"处","place_note":"括州【浙江丽水】","start_index":19,"tongjian_id":"bea407ec-db0e-11ef-b9bb-a0d3651f611f"},{"place_name":"溫","place_name_jianti_auto":"温","place_note":"浙江温州","start_index":21,"tongjian_id":"bea407ed-db0e-11ef-af9a-a0d3651f611f"},{"place_name":"越州","place_name_jianti_auto":"越州","start_index":26,"tongjian_id":"bea407ee-db0e-11ef-8b7a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"浙東道節度使領越、睦、衢、婺、台、明、處、溫八州，治越州。","note_content_jianti_auto":"浙东道节度使领越、睦、衢、婺、台、明、处、温八州，治越州。","note_type":"hu_note","start_index":63,"tongjian_id":"bea407e4-db0e-11ef-8d80-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李峘","people_name_jianti_auto":"李峘","start_index":12,"tongjian_id":"bea407f0-db0e-11ef-b816-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此宜參考下卷上元元年都統李峘註。","note_content_jianti_auto":"此宜参考下卷上元元年都统李峘注。","note_type":"hu_note","start_index":70,"tongjian_id":"bea407ef-db0e-11ef-b1b5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bea407d5-db0e-11ef-8fbc-a0d3651f611f","pinyin":"huán","source_anchor_text":"部尚書李峘為之兼淮","source_key":"baiyang_epub","start_index":59,"text":"峘","tongjian_id":"6ddf2295-2652-54fa-abc8-38f4f9ee9211"}],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","place_note":"江苏苏州","resolved_place_entity_id":714,"start_index":15,"tongjian_id":"bea407f3-db0e-11ef-a53c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"37甲辰，置浙江西道節度使，領蘇、潤等十州，以昇州刺史韋黃裳爲之。庚戌，置浙江東道節度使，領越、睦等八州，以戶部尚書李峘爲之，兼淮南節度使。","content_fanyi":"甲辰日，即十二月初六日，朝廷设置浙江西道节度使，管辖苏州、润州等十个州，任命升州刺史韦黄裳为浙江西道节度使。庚戌日，即十二月十二日，朝廷设置浙江东道节度使，管辖越州、睦州等八个州，任命户部尚书李峘为浙江东道节度使，兼任淮南节度使。","content_jianti_auto":"37甲辰，置浙江西道节度使，领苏、润等十州，以升州刺史韦黄裳为之。庚戌，置浙江东道节度使，领越、睦等八州，以户部尚书李峘为之，兼淮南节度使。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22256,"number":37,"path":"资治通鉴 : 卷第二百二十 (唐紀三十六) / 肅宗文明武德大聖大宣孝皇帝中之下 / 乾元元年 / 第 43 段","reading_annotation_sources":[],"start_index":42,"tongjian_id":"bea407d5-db0e-11ef-8fbc-a0d3651f611f","year_int":758},"tongjian_id":"bea407d5-db0e-11ef-8fbc-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"蘇","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"處，昌呂翻；下處置同。","note_content_jianti_auto":"处，昌吕翻；下处置同。","note_type":"hu_note","start_index":96,"tongjian_id":"c2b1ef31-db0e-11ef-adda-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"釘，丁定翻。舷，胡田翻。船邊曰舷。","note_content_jianti_auto":"钉，丁定翻。舷，胡田翻。船边曰舷。","note_type":"hu_note","start_index":224,"tongjian_id":"c2b1ef38-db0e-11ef-94de-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","resolved_place_entity_id":714,"start_index":160,"tongjian_id":"c2b1ef53-db0e-11ef-9837-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/占术致祸","excerpts":[{"context_after":"。五代李守贞为河中节度使，有术者善听人声，闻其子妇符氏声...","context_before":"...当生天子，豹闻言心喜，因背汉，致夷灭，而其应乃在汉文帝。","source_end_index":338,"source_paragraph_tongjian_id":"c0d295b0-f71f-40b2-97d0-198e3cfa7603","source_start_index":290,"source_text":"唐李锜据润州反，有相者言，丹阳郑氏女当生天子，锜闻之，纳为侍人。锜败，没入掖庭，得幸宪宗而生宣宗"}],"path":"三笔/卷二/占术致祸","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、应天府（卷二十）","excerpts":[{"context_after":"宋绍兴初，议者以建康城西隅，据石头冈阜之脊，以立城基，险...","context_before":"...，起建业，抵京岘，雉堞相望以自固。又于城中穿井，皆百尺。","source_end_index":2293,"source_paragraph_tongjian_id":"a0bad11e-ca9b-52a9-b02a-9dee3b6fcb82","source_start_index":2267,"source_text":"元和二年，李锜为镇海节度使，遣兵修筑石头，谋据江左。"}],"path":"南直方舆纪要/一、应天府（卷二十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"冬，十月，己未，詔徵錡爲左僕射，以御史大夫李元素爲鎭海節度使。庚申，錡表言軍變，殺留後、大將。先是錡選腹心五人爲所部五州鎭將，姚志安處蘇州，李深處常州，趙惟忠處湖州，丘自昌處杭州，高肅處睦州，各有兵數千，伺察刺史動靜。至是，錡各使殺其刺史，遣牙將庾伯良將兵三千治石頭。常州刺史顏防用客李雲計，矯制稱招討副使，斬李深，傳檄蘇、杭、湖、睦，請同進討。湖州刺史辛祕潛募鄕閭子弟數百，夜襲趙惟忠營，斬之。蘇州刺史李素爲姚志安所敗，生致於錡，具桎梏釘於船舷，未及京口，會錡敗，得免。","content_fanyi":"冬季，十月初五日己未，宪宗下诏征召李锜入朝担任左仆射，任命御史大夫李元素为镇海节度使。十月初六日庚申，李锜上表朝廷，称军队发生哗变，杀死留后和大将。在此之前，李锜挑选五名心腹担任所辖五州的镇将，姚志安在苏州，李深在常州，赵惟忠在湖州，丘自昌在杭州，高肃在睦州，各拥兵数千，监视刺史的动静。到这时，李锜派人命令他们各自杀死本州刺史，并派牙将庾伯良率兵三千修筑石头城。常州刺史颜防采用宾客李云的计策，诈称奉制命为招讨副使，斩杀李深，向苏州、杭州、湖州、睦州传送檄文，请求共同进兵讨伐。湖州刺史辛秘暗中招募乡闾子弟数百人，乘夜袭击赵惟忠军营，斩杀赵惟忠。苏州刺史李素被姚志安打败，姚志安将李素活着押送给李锜，给他戴上枷锁镣铐，钉在船舷上；还没到达京口，正逢李锜兵败，李素得以幸免。","content_jianti_auto":"冬，十月，己未，诏征锜为左仆射，以御史大夫李元素为镇海节度使。庚申，锜表言军变，杀留后、大将。先是锜选腹心五人为所部五州镇将，姚志安处苏州，李深处常州，赵惟忠处湖州，丘自昌处杭州，高肃处睦州，各有兵数千，伺察刺史动静。至是，锜各使杀其刺史，遣牙将庾伯良将兵三千治石头。常州刺史颜防用客李云计，矫制称招讨副使，斩李深，传檄苏、杭、湖、睦，请同进讨。湖州刺史辛秘潜募鄕闾子弟数百，夜袭赵惟忠营，斩之。苏州刺史李素为姚志安所败，生致于锜，具桎梏钉于船舷，未及京口，会锜败，得免。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23944,"path":"资治通鉴 : 卷第二百三十七 (唐紀五十三) / 憲宗昭文章武大聖至神孝皇帝上之上 / 二年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"c2b1ef2f-db0e-11ef-8978-a0d3651f611f","year_int":807},"tongjian_id":"c2b1ef2f-db0e-11ef-8978-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"蘇","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陶隱居","people_name_jianti_auto":"陶隐居","start_index":62,"tongjian_id":"c56e108c-db0e-11ef-be07-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"通州","place_name_jianti_auto":"通州","start_index":1,"tongjian_id":"c56e108d-db0e-11ef-a13e-a0d3651f611f"},{"place_name":"靜海縣","place_name_jianti_auto":"静海县","start_index":3,"tongjian_id":"c56e108e-db0e-11ef-a72a-a0d3651f611f"},{"place_name":"狼山","place_name_jianti_auto":"狼山","start_index":8,"tongjian_id":"c56e108f-db0e-11ef-ac1e-a0d3651f611f"},{"place_name":"大江","place_name_jianti_auto":"大江","start_index":18,"tongjian_id":"c56e1090-db0e-11ef-9f23-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":27,"tongjian_id":"c56e1091-db0e-11ef-b201-a0d3651f611f"},{"place_name":"蘇州","place_name_jianti_auto":"苏州","start_index":32,"tongjian_id":"c56e1092-db0e-11ef-9919-a0d3651f611f"},{"place_name":"常熟縣","place_name_jianti_auto":"常熟县","start_index":34,"tongjian_id":"c56e1093-db0e-11ef-9298-a0d3651f611f"},{"place_name":"福山鎭","place_name_jianti_auto":"福山镇","start_index":37,"tongjian_id":"c56e1094-db0e-11ef-8c72-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":42,"tongjian_id":"c56e1095-db0e-11ef-bd6f-a0d3651f611f"},{"place_name":"崇明沙","place_name_jianti_auto":"崇明沙","start_index":45,"tongjian_id":"c56e1096-db0e-11ef-866d-a0d3651f611f"},{"place_name":"明州","place_name_jianti_auto":"明州","start_index":56,"tongjian_id":"c56e1097-db0e-11ef-ade0-a0d3651f611f"},{"place_name":"定海縣","place_name_jianti_auto":"定海县","start_index":58,"tongjian_id":"c56e1098-db0e-11ef-83fb-a0d3651f611f"},{"place_name":"狼","place_name_jianti_auto":"狼","start_index":68,"tongjian_id":"c56e1099-db0e-11ef-b146-a0d3651f611f"},{"place_name":"句章","place_name_jianti_auto":"句章","start_index":72,"tongjian_id":"c56e109a-db0e-11ef-a9d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"今通州靜海縣南有狼山，五山相連，上接大江，下達巨海，絕江南渡，抵蘇州常熟縣福山鎭，順江東至崇明沙，揚帆乘順，南抵明州定海縣，陶隱居所謂「狼五山對句章岸」者也。","note_content_jianti_auto":"今通州静海县南有狼山，五山相连，上接大江，下达巨海，绝江南渡，抵苏州常熟县福山镇，顺江东至崇明沙，扬帆乘顺，南抵明州定海县，陶隐居所谓「狼五山对句章岸」者也。","note_type":"hu_note","start_index":20,"tongjian_id":"c56e108b-db0e-11ef-8e9a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","start_index":0,"tongjian_id":"c56e109d-db0e-11ef-ad5e-a0d3651f611f"},{"place_name":"常","place_name_jianti_auto":"常","place_note":"江苏省常州市","start_index":2,"tongjian_id":"c56e109e-db0e-11ef-be9d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蘇、常，二州名，相去一百八十里。","note_content_jianti_auto":"苏、常，二州名，相去一百八十里。","note_type":"hu_note","start_index":63,"tongjian_id":"c56e109c-db0e-11ef-8bb1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":13,"tongjian_id":"c56e10a0-db0e-11ef-a11f-a0d3651f611f"},{"people_name":"宋皓","people_name_jianti_auto":"宋皓","start_index":27,"tongjian_id":"c56e10a1-db0e-11ef-9da9-a0d3651f611f"},{"people_name":"郢","people_name_jianti_auto":"郢","start_index":39,"tongjian_id":"c56e10a2-db0e-11ef-a886-a0d3651f611f"},{"people_name":"魯寔","people_name_jianti_auto":"鲁寔","start_index":41,"tongjian_id":"c56e10a3-db0e-11ef-a276-a0d3651f611f"},{"people_name":"皓","people_name_jianti_auto":"皓","start_index":46,"tongjian_id":"c56e10a4-db0e-11ef-b174-a0d3651f611f"},{"people_name":"程匡柔","people_name_jianti_auto":"程匡柔","start_index":56,"tongjian_id":"c56e10a5-db0e-11ef-8594-a0d3651f611f"},{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":72,"tongjian_id":"c56e10a6-db0e-11ef-8980-a0d3651f611f"},{"people_name":"李繪","people_name_jianti_auto":"李绘","start_index":98,"tongjian_id":"c56e10a7-db0e-11ef-8546-a0d3651f611f"},{"people_name":"郢","people_name_jianti_auto":"郢","start_index":102,"tongjian_id":"c56e10a8-db0e-11ef-a358-a0d3651f611f"},{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":122,"tongjian_id":"c56e10a9-db0e-11ef-94c2-a0d3651f611f"},{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":150,"tongjian_id":"c56e10aa-db0e-11ef-9968-a0d3651f611f"},{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":169,"tongjian_id":"c56e10ab-db0e-11ef-b060-a0d3651f611f"},{"people_name":"王郢","people_name_jianti_auto":"王郢","start_index":191,"tongjian_id":"c56e10ac-db0e-11ef-9650-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"浙西","place_name_jianti_auto":"浙西","place_note":"镇海战区，总部设润州【江苏省镇江市】","start_index":8,"tongjian_id":"c56e10ad-db0e-11ef-9d5e-a0d3651f611f"},{"place_name":"浙西","place_name_jianti_auto":"浙西","place_note":"镇海战区，总部设润州【江苏省镇江市】","start_index":68,"tongjian_id":"c56e10ae-db0e-11ef-9f85-a0d3651f611f"},{"place_name":"蘇","place_name_jianti_auto":"苏","start_index":83,"tongjian_id":"c56e10af-db0e-11ef-ab71-a0d3651f611f"},{"place_name":"常","place_name_jianti_auto":"常","place_note":"江苏省常州市","start_index":85,"tongjian_id":"c56e10b0-db0e-11ef-bdf0-a0d3651f611f"},{"place_name":"蘇州","place_name_jianti_auto":"苏州","start_index":94,"tongjian_id":"c56e10b1-db0e-11ef-8434-a0d3651f611f"},{"place_name":"浙西","place_name_jianti_auto":"浙西","start_index":126,"tongjian_id":"c56e10b2-db0e-11ef-b2cc-a0d3651f611f"},{"place_name":"浙西","place_name_jianti_auto":"浙西","place_note":"镇海战区，总部设润州【江苏省镇江市】","start_index":144,"tongjian_id":"c56e10b3-db0e-11ef-85b1-a0d3651f611f"},{"place_name":"浙西","place_name_jianti_auto":"浙西","place_note":"镇海战区，总部设润州【江苏省镇江市】","start_index":166,"tongjian_id":"c56e10b4-db0e-11ef-83d5-a0d3651f611f"},{"place_name":"兩浙","place_name_jianti_auto":"两浙","start_index":194,"tongjian_id":"c56e10b5-db0e-11ef-9722-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：新紀：「浙西突陳將王郢反。五月，遣右龍武大將軍宋皓討之。」按四年二月，郢執魯寔，始命皓討之。置此，誤也。程匡柔唐補紀曰：「六月，浙西突將王郢反，聚黨萬衆，燒劫蘇、常。三年，正月，貶蘇州刺史李繪，以郢亂棄城故也。」舊紀：「二年，四月，海賊王郢攻剽浙西郡邑。」實錄：「乾符三年，二月，浙西奏突陳將王郢等六十九人劫庫兵爲亂。三月，浙西奏王郢聚衆萬人，攻陷州縣。」續寶運錄：「元年，王郢於兩浙叛，敕差山北兵士討之，不逾月而剋，乃組頸于闕下。」今從舊紀。","note_content_jianti_auto":"考异曰：新纪：「浙西突陈将王郢反。五月，遣右龙武大将军宋皓讨之。」按四年二月，郢执鲁寔，始命皓讨之。置此，误也。程匡柔唐补纪曰：「六月，浙西突将王郢反，聚党万众，烧劫苏、常。三年，正月，贬苏州刺史李绘，以郢乱弃城故也。」旧纪：「二年，四月，海贼王郢攻剽浙西郡邑。」实录：「干符三年，二月，浙西奏突陈将王郢等六十九人劫库兵为乱。三月，浙西奏王郢聚众万人，攻陷州县。」续宝运录：「元年，王郢于两浙叛，敕差山北兵士讨之，不逾月而克，乃组颈于阙下。」今从旧纪。","note_type":"hu_note","start_index":88,"tongjian_id":"c56e109f-db0e-11ef-981c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","place_note":"江苏省苏州市","resolved_place_entity_id":714,"start_index":59,"tongjian_id":"c56e10c2-db0e-11ef-a6bc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、扬州府（卷二十三）","excerpts":[{"context_after":"又狼山之外即大江，亦名狼山江。梁贞明五年，吴越将钱传瓘帅...","context_before":"...抵明州定海，顷刻可至，陶隐居所谓“狼五山对勾章岸”者也。","source_end_index":213,"source_paragraph_tongjian_id":"25ca8a71-1f91-5438-9415-cb829fc54885","source_start_index":153,"source_text":"唐乾符二年，浙西狼山镇遏使王郢等有战功，怒节帅赵隐赏薄，据狼山作乱，攻陷苏、常，沿江入海，转掠二浙，南及福建，大为民患。"}],"path":"南直方舆纪要/四、扬州府（卷二十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"10浙西狼山鎭遏使王郢等六十九人有戰功，節度使趙隱賞以職名而不給衣糧，郢等論訴不獲，遂劫庫兵作亂，行收黨衆近萬人，攻陷蘇、常，乘舟往來，泛江入海，轉掠二浙，南及福建，大爲人患。","content_fanyi":"浙西狼山镇遏使王郢等六十九人立有战功，节度使赵隐只赏给职名，却不发给衣服、粮食，王郢等人论理申诉仍无结果，于是抢劫国家府库中的兵器发动叛乱，沿途收聚党众近万人，攻陷苏州、常州，乘船往来，泛舟长江，驶入大海，辗转劫掠两浙地区，南面达到福建，成为百姓的一大祸患。","content_jianti_auto":"10浙西狼山镇遏使王郢等六十九人有战功，节度使赵隐赏以职名而不给衣粮，郢等论诉不获，遂劫库兵作乱，行收党众近万人，攻陷苏、常，乘舟往来，泛江入海，转掠二浙，南及福建，大为人患。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25831,"number":10,"path":"资治通鉴 : 卷第二百五十二 (唐紀六十八) / 僖宗惠聖恭定孝皇帝上之上 / 二年 / 第 12 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":11,"tongjian_id":"c56e108a-db0e-11ef-a793-a0d3651f611f","year_int":875},"tongjian_id":"c56e108a-db0e-11ef-a793-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"蘇","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"錢氏","people_name_jianti_auto":"钱氏","start_index":5,"tongjian_id":"c713777f-db0e-11ef-b6e0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蘇州","place_name_jianti_auto":"苏州","place_note":"江苏省苏州市","start_index":0,"tongjian_id":"c7137780-db0e-11ef-bd4c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蘇州自此爲錢氏所有。復，扶又翻。","note_content_jianti_auto":"苏州自此为钱氏所有。复，扶又翻。","note_type":"hu_note","start_index":25,"tongjian_id":"c713777e-db0e-11ef-80b1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"蘇","place_name_jianti_auto":"苏","place_note":"江苏苏州市","resolved_place_entity_id":714,"start_index":6,"tongjian_id":"c7137784-db0e-11ef-bc85-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、唐下 五代九国附（卷六）","excerpts":[{"context_after":"大顺二年，贼将孙儒渡江据苏州，寻屯广德，与杨行密相持，祇...","context_before":"...而授之。临安，今杭州府属县。石镜镇，在今临安县东三里]，","source_end_index":147,"source_paragraph_tongjian_id":"2bb90b8b-7592-5eb8-ac43-bf528e7e9b9f","source_start_index":115,"source_text":"会镇海军乱，祇遣兵取常、润及苏州[既而三州为杨行密及孙儒所取]。"},{"context_after":"景福初，诏以祇为武胜军防御使[时置武胜军于杭州，既又以镠...","context_before":"...乱，祇遣兵取常、润及苏州[既而三州为杨行密及孙儒所取]。","source_end_index":183,"source_paragraph_tongjian_id":"2bb90b8b-7592-5eb8-ac43-bf528e7e9b9f","source_start_index":147,"source_text":"大顺二年，贼将孙儒渡江据苏州，寻屯广德，与杨行密相持，祇因遣兵复取苏州。"}],"path":"历代州域形势纪要/六、唐下 五代九国附（卷六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、苏州府（卷二十四）","excerpts":[{"context_after":"乾宁三年，又为淮南将台濛所克。五年，镠复攻克之。朱梁开平...","context_before":"...破走之。大顺初，杨行密将李友取苏州。旋为贼将孙儒所陷。","source_end_index":586,"source_paragraph_tongjian_id":"93a723f6-13ae-55fe-ba00-122a474ace28","source_start_index":576,"source_text":"二年，钱镠复取苏州。"}],"path":"南直方舆纪要/五、苏州府（卷二十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"35孫儒焚掠蘇、常，引兵逼宣州，錢鏐復遣兵據蘇州。儒屢破楊行密之兵，旌旗輜重亙百餘里。行密求救於錢鏐，鏐以兵食助之。","content_fanyi":"孙儒在苏州、常州一带焚烧抢掠，随后率军进逼宣州，钱镠再次派兵占据苏州。孙儒屡次击败杨行密的军队，旌旗和辎重绵延一百多里。杨行密向钱镠求救，钱镠便用兵力和粮食援助他。","content_jianti_auto":"35孙儒焚掠苏、常，引兵逼宣州，钱镠复遣兵据苏州。儒屡破杨行密之兵，旌旗辎重亘百余里。行密求救于钱镠，镠以兵食助之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":26636,"number":35,"path":"资治通鉴 : 卷第二百五十八 (唐紀七十四) / 昭宗聖穆景文孝皇帝上之上 / 二年 / 第 46 段","reading_annotation_sources":[],"start_index":45,"tongjian_id":"c713777d-db0e-11ef-80cb-a0d3651f611f","year_int":891},"tongjian_id":"c713777d-db0e-11ef-80cb-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"蘇","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":5,"tongjian_id":"cab7f0ef-db0e-11ef-864b-a0d3651f611f"},{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":7,"tongjian_id":"cab7f0f0-db0e-11ef-8a8e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"是年二月，吳攻虔州。","note_content_jianti_auto":"是年二月，吴攻虔州。","note_type":"hu_note","start_index":16,"tongjian_id":"cab7f0ee-db0e-11ef-b8e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"吳越","place_name_jianti_auto":"吴越","place_note":"首都杭州","start_index":4,"tongjian_id":"cab7f0f3-db0e-11ef-9e70-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"統軍使，吳越所置官。","note_content_jianti_auto":"统军使，吴越所置官。","note_type":"hu_note","start_index":90,"tongjian_id"