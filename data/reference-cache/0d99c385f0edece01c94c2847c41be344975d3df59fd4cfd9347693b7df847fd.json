ype":"hu_note","start_index":12,"tongjian_id":"b955a742-db0e-11ef-aea0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"嬙，慈良翻，婦官也。迕，五故翻。逆而視之，謂之迕目。","note_content_jianti_auto":"嫱，慈良翻，妇官也。迕，五故翻。逆而视之，谓之迕目。","note_type":"hu_note","start_index":90,"tongjian_id":"b955a746-db0e-11ef-a30c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":16,"source_start_index":3,"source_text":"事見二十七卷漢宣帝甘露三年","target_paragraph_tongjian_id":"913f91dc-db0e-11ef-ac0f-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"政君","people_name_jianti_auto":"政君","start_index":0,"tongjian_id":"b955a748-db0e-11ef-a212-a0d3651f611f"},{"people_name":"漢宣帝","people_name_jianti_auto":"汉宣帝","start_index":9,"tongjian_id":"b955a749-db0e-11ef-8265-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"政君，事見二十七卷漢宣帝甘露三年。","note_content_jianti_auto":"政君，事见二十七卷汉宣帝甘露三年。","note_type":"hu_note","start_index":112,"tongjian_id":"b955a747-db0e-11ef-91de-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":624,"link_death_year":705,"link_td_description":"武则天是中国历史上唯一的女皇帝，唐太宗的才人、唐高宗的皇后，以及武周的开国皇帝。","link_td_id":"Q10000024","link_td_number_id":2917,"people_name":"武氏","people_name_jianti_auto":"武氏","people_xingming":"武曌","start_index":18,"tongjian_id":"b955a74a-db0e-11ef-b79f-a0d3651f611f"},{"link_birth_year":624,"link_death_year":705,"link_td_description":"武则天是中国历史上唯一的女皇帝，唐太宗的才人、唐高宗的皇后，以及武周的开国皇帝。","link_td_id":"Q10000024","link_td_number_id":2917,"people_name":"武氏","people_name_jianti_auto":"武氏","start_index":102,"tongjian_id":"b957f0ef-db0e-11ef-905c-a0d3651f611f"},{"link_birth_year":-71,"link_death_year":13,"link_td_description":"王政君，魏郡元城县（今河北省大名县）人，汉元帝刘奭皇后，汉成帝刘骜生母。父王禁，母李亲。她是中国历史上寿命最长的皇后之一。其身居后位（包含皇后、皇太后、太皇太后）时间长达61年（公元前49年—公元13年在位）。王政君是王莽的姑姑。","link_td_id":"Q10008478","link_td_number_id":279744,"people_name":"政君","people_name_jianti_auto":"政君","people_xingming":"王政君","start_index":109,"tongjian_id":"b957f0f0-db0e-11ef-b099-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"乙卯，百官上表請立中宮，乃下詔曰：「武氏門著勳庸，地華纓黻，往以才行選入後庭，譽重椒闈，德光蘭掖。朕昔在儲貳，特荷先慈，常得侍從，弗離朝夕，宮壼之內，恆自飭躬，嬪嬙之間，未嘗迕目，聖情鑒悉，每垂賞歎，遂以武氏賜朕，事同政君，可立爲皇后。」","content_fanyi":"乙卯日，百官上表请求册立中宫皇后，于是下诏说：“武氏门第功勋卓著，家世华贵，累代官宦，从前因才学品行被选入后宫，美名重于椒房，德行光耀掖庭。朕往日为太子时，特别承蒙先帝慈爱，她常常得以随从侍奉，朝夕不离。宫闱之内，她总是整饬自身；嫔妃之间，从不曾有过失礼不逊之色。先帝圣心明察，每每加以赞赏，于是把武氏赐给朕，如同王政君旧事，可以立为皇后。”","content_jianti_auto":"乙卯，百官上表请立中宫，乃下诏曰：「武氏门著勋庸，地华缨黻，往以才行选入后庭，誉重椒闱，德光兰掖。朕昔在储贰，特荷先慈，常得侍从，弗离朝夕，宫壸之内，恒自饬躬，嫔嫱之间，未尝迕目，圣情鉴悉，每垂赏叹，遂以武氏赐朕，事同政君，可立为皇后。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":19534,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"b955a741-db0e-11ef-8e83-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":4,"source_start_index":0,"source_text":"事見上卷","target_paragraph_tongjian_id":"b94203cc-db0e-11ef-9c63-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷上年。瑗，于眷翻。折，之舌翻。爭，讀曰諍。","note_content_jianti_auto":"事见上卷上年。瑗，于眷翻。折，之舌翻。争，读曰诤。","note_type":"hu_note","start_index":36,"tongjian_id":"b957f0f2-db0e-11ef-8792-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷内职","official_name":"宸妃","official_note":"宸妃是唐代宫廷中的妃嫔称号，通常为皇帝妃子之一，此处指武则天曾被封为宸妃，反映了她在宫廷中的地位提升。","official_rank":"未知","source_snippet":"陛下前以妾爲宸妃","start_index":18,"tongjian_id":"95b0f396-9bb3-4311-91b1-4a552e23389a"}],"ExtRef_Children_people":[{"link_birth_year":606,"link_death_year":659,"link_td_description":"韩瑗，字伯玉，京兆三原（今陕西省三原县）人。","link_td_id":"Q10005665","link_td_number_id":1248379,"people_name":"韓瑗","people_name_jianti_auto":"韩瑗","people_xingming":"韩瑗","start_index":26,"tongjian_id":"b957f0f4-db0e-11ef-ba33-a0d3651f611f"},{"link_birth_year":610,"link_death_year":662,"link_td_description":"来济，扬州人，唐朝官员，唐高宗时期的宰相。他因为反对唐高宗立武昭仪为皇后，被派到西域为官。662年，他在抵抗西突厥部落入侵时阵亡，他的哥哥来恒之后也被任命为宰相。","link_td_id":"Q10011699","link_td_number_id":1298798,"people_name":"來濟","people_name_jianti_auto":"来济","people_xingming":"来济","start_index":29,"tongjian_id":"b957f0f5-db0e-11ef-87aa-a0d3651f611f"},{"link_birth_year":606,"link_death_year":659,"link_td_description":"韩瑗，字伯玉，京兆三原（今陕西省三原县）人。","link_td_id":"Q10005665","link_td_number_id":1248379,"people_name":"瑗","people_name_jianti_auto":"瑗","people_xingming":"韩瑗","start_index":60,"tongjian_id":"b957f0f6-db0e-11ef-8b79-a0d3651f611f"},{"link_birth_year":606,"link_death_year":659,"link_td_description":"韩瑗，字伯玉，京兆三原（今陕西省三原县）人。","link_td_id":"Q10005665","link_td_number_id":1248379,"people_name":"瑗","people_name_jianti_auto":"瑗","people_xingming":"韩瑗","start_index":63,"tongjian_id":"b957f0f7-db0e-11ef-ba7d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"丁巳，赦天下。是日，皇后上表稱：「陛下前以妾爲宸妃，韓瑗、來濟面折庭爭，此旣事之極難，豈非深情爲國，乞加褒賞。」上以表示瑗等，瑗等彌憂懼，屢請去位，上不許。","content_fanyi":"丁巳日，大赦天下。当日，武皇后上表说：“陛下此前想让我做宸妃，韩瑗、来济在朝堂上当面驳斥力争，这已是极难做到的事情，难道不正是他们深心为国的表现吗？请求加以褒奖赏赐。”皇上将表文拿给韩瑗等人看，韩瑗等人愈发忧虑恐惧，多次请求辞去官位，皇上不答应。","content_jianti_auto":"丁巳，赦天下。是日，皇后上表称：「陛下前以妾为宸妃，韩瑗、来济面折庭争，此既事之极难，岂非深情为国，乞加褒赏。」上以表示瑗等，瑗等弥忧惧，屡请去位，上不许。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19535,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"b957f0f1-db0e-11ef-b25e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"司空","official_note":"司空是唐代三公之一，负责监察和礼仪事务，此处李勣以司空身份受命册封皇后，体现了其高位和朝廷的重视。","official_rank":"正一品","source_snippet":"司空李勣","start_index":12,"tongjian_id":"988a7bf9-fc8a-400d-a799-eac0d5fbbafd"},{"confidence":0.85,"official_category":"宫廷","official_name":"皇后","official_note":"皇后是皇帝的正妻，在宫廷中地位最高，此处武氏被册封为皇后，标志着其政治地位的提升。","official_rank":"未知","source_snippet":"皇后武氏","start_index":20,"tongjian_id":"dc6d924a-60b4-4406-8829-54bdd751a142"},{"confidence":0.8,"official_category":"地方行政","official_name":"百官","official_note":"百官泛指朝廷中的各级官员，此处表示官员们朝见新册封的皇后，体现了册封仪式的正式性和皇后的权威。","official_rank":"未知","source_snippet":"百官朝皇后","start_index":28,"tongjian_id":"20e081fe-395e-401c-9d86-e48020752452"}],"ExtRef_Children_people":[{"people_name":"李勣","people_name_jianti_auto":"李𪟝","people_xingming":"李勣","start_index":13,"tongjian_id":"b957f0fa-db0e-11ef-908a-a0d3651f611f"},{"link_birth_year":624,"link_death_year":705,"link_td_description":"武则天是中国历史上唯一的女皇帝，唐太宗的才人、唐高宗的皇后，以及武周的开国皇帝。","link_td_id":"Q10000024","link_td_number_id":2917,"people_name":"武氏","people_name_jianti_auto":"武氏","people_xingming":"武则天","start_index":21,"tongjian_id":"b957f0fb-db0e-11ef-86e8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"肅義門","place_name_jianti_auto":"肃义门","resolved_place_entity_id":8774,"start_index":33,"tongjian_id":"b957f0fc-db0e-11ef-b399-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"十一月，丁卯朔，臨軒命司空李勣齎璽綬冊皇后武氏。是日，百官朝皇后於肅義門。","content_fanyi":"十一月丁卯朔日，皇帝临轩命司空李勣持玺绶册立武氏为皇后。当日，百官在肃义门朝见皇后。","content_jianti_auto":"十一月，丁卯朔，临轩命司空李𪟝赍玺绶册皇后武氏。是日，百官朝皇后于肃义门。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19536,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"b957f0f8-db0e-11ef-aeb9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"b957f103-db0e-11ef-9975-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"b957f104-db0e-11ef-b6c3-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":26,"tongjian_id":"b957f105-db0e-11ef-81db-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「捉」作「投」；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：十二行本「捉」作「投」；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"b957f102-db0e-11ef-9fad-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":151,"tongjian_id":"b957f101-db0e-11ef-9039-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蟒，莫朗翻。蛇最大者曰蟒。","note_content_jianti_auto":"蟒，莫朗翻。蛇最大者曰蟒。","note_type":"hu_note","start_index":256,"tongjian_id":"b957f108-db0e-11ef-80f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高宗","people_name_jianti_auto":"高宗","start_index":63,"tongjian_id":"b957f10b-db0e-11ef-8af1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"大明宮","place_name_j