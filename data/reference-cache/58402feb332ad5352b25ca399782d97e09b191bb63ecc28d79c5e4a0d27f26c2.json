_number_id":356836,"people_name":"英","people_name_jianti_auto":"英","people_xingming":"刘英","start_index":135,"tongjian_id":"9514ae3c-db0e-11ef-a42d-a0d3651f611f"},{"link_death_year":71,"link_td_description":"刘英，东汉楚王，为光武帝和许美人所生，是已知中国贵族中最早的佛教信徒。","link_td_id":"Q10002430","link_td_number_id":356836,"people_name":"英","people_name_jianti_auto":"英","people_xingming":"刘英","start_index":147,"tongjian_id":"9514ae3d-db0e-11ef-9258-a0d3651f611f"},{"link_death_year":71,"link_td_description":"虞延，字子大，陈留郡东昏县（河南省兰考县）人，东汉初期大臣。","link_td_id":"Q10007298","link_td_number_id":4035728,"people_name":"延","people_name_jianti_auto":"延","people_xingming":"虞延","start_index":155,"tongjian_id":"9514ae3e-db0e-11ef-9a63-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"漁陽","place_name_jianti_auto":"渔阳","resolved_place_entity_id":598,"start_index":28,"tongjian_id":"9514ae33-db0e-11ef-9198-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","resolved_place_entity_id":558,"start_index":80,"tongjian_id":"9514ae36-db0e-11ef-af09-a0d3651f611f"},{"place_name":"涇縣","place_name_jianti_auto":"泾县","resolved_place_entity_id":819,"start_index":82,"tongjian_id":"9514ae37-db0e-11ef-a0a8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"3楚王英與方士作金龜、玉鶴，刻文字爲符瑞。男子燕廣告英與漁陽王平、顏忠等造作圖書，有逆謀；事下案驗。有司奏「英大逆不道，請誅之。」帝以親親不忍。十一月，廢英，徙丹陽涇縣，賜湯沐邑五百戶；男女爲侯、主者，食邑如故；許太后勿上璽綬，留住楚宮。先是有私以英謀告司徒虞延者，延以英藩戚至親，不然其言。及英事覺，詔書切讓延。","content_fanyi":"楚王刘英与方士制作金龟、玉鹤，并在上面刻写文字，作为符命祥瑞。男子燕广告发刘英与渔阳人王平、颜忠等制造图谶，有谋反企图；朝廷将此事下交有关部门审验。主管官员上奏说：“刘英大逆不道，请处以死刑。”汉明帝因顾念骨肉亲情，不忍心杀他。十一月，明帝废去刘英的王爵，把他迁到丹阳郡泾县，赐给汤沐邑五百户；他的儿子封侯、女儿封公主的，食邑照旧不变；许太后不必缴回玺绶，仍留住楚国宫中。在此之前，有人暗中把刘英的谋划报告给司徒虞延，虞延认为刘英是藩王至亲，不相信那人的话。等到刘英阴谋败露，朝廷下诏严厉责备虞延。","content_jianti_auto":"3楚王英与方士作金龟、玉鹤，刻文字为符瑞。男子燕广告英与渔阳王平、颜忠等造作图书，有逆谋；事下案验。有司奏「英大逆不道，请诛之。」帝以亲亲不忍。十一月，废英，徙丹阳泾县，赐汤沐邑五百户；男女为侯、主者，食邑如故；许太后勿上玺绶，留住楚宫。先是有私以英谋告司徒虞延者，延以英藩戚至亲，不然其言。及英事觉，诏书切让延。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"。夫三王者诚狂悖矣；乃观北海王睦遣中大夫入觐，大夫欲称其...","context_before":"","source_end_index":21,"source_paragraph_tongjian_id":"7a9301fe-80ad-4f91-9fc8-bac14aea4a32","source_start_index":0,"source_text":"广陵王荆、楚王英、淮阳王延，以逆谋或诛或削"},{"context_after":"，延以舜之待象者望帝，意至深厚也，而不保其生。寒朗曰：“...","context_before":"...而奸人乘之以告讦，则亦恶知当日之狱辞，非附会而增益之哉？","source_end_index":72,"source_paragraph_tongjian_id":"5f37fc4f-3f22-4d80-9cee-f98551013e02","source_start_index":64,"source_text":"楚狱兴而虞延以死"}],"title":"八 明帝猜忌兄弟"}],"id":3590,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9514ae1d-db0e-11ef-ab12-a0d3651f611f"}],"reign_name":"十三年","reign_name_jianti_auto":"十三年","start_index":9,"tongjian_id":"95138b49-db0e-11ef-9485-a0d3651f611f","year_anno":"（庚午、七○）","year_int":70},"message":"success","success":true}