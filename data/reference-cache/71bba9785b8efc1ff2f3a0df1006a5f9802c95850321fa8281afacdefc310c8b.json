x":98,"tongjian_id":"948330ea-db0e-11ef-b496-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"平陰","place_name_jianti_auto":"平阴","start_index":0,"tongjian_id":"948330ed-db0e-11ef-80f3-a0d3651f611f"},{"place_name":"緱氏","place_name_jianti_auto":"缑氏","start_index":3,"tongjian_id":"948330ee-db0e-11ef-9157-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":10,"tongjian_id":"948330ef-db0e-11ef-b011-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"平陰、緱氏二縣，皆屬河南尹。緱，工侯翻。","note_content_jianti_auto":"平阴、缑氏二县，皆属河南尹。缑，工侯翻。","note_type":"hu_note","start_index":135,"tongjian_id":"948330ec-db0e-11ef-966e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"梁郡","place_name_jianti_auto":"梁郡","start_index":0,"tongjian_id":"948330f1-db0e-11ef-b98c-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":4,"tongjian_id":"948330f2-db0e-11ef-9789-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"梁郡，在雒陽東南八百五十里。","note_content_jianti_auto":"梁郡，在雒阳东南八百五十里。","note_type":"hu_note","start_index":144,"tongjian_id":"948330f0-db0e-11ef-8802-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":4,"tongjian_id":"948330f4-db0e-11ef-a3a9-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":9,"tongjian_id":"948330f5-db0e-11ef-afec-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志：弘農郡，在雒陽西南四百五十里。","note_content_jianti_auto":"郡国志：弘农郡，在雒阳西南四百五十里。","note_type":"hu_note","start_index":151,"tongjian_id":"948330f3-db0e-11ef-94b5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"948330e7-db0e-11ef-9886-a0d3651f611f","pinyin":"yì","source_anchor_text":"子輔為右翊公英為楚","source_key":"baiyang_epub","start_index":15,"text":"翊","tongjian_id":"83eb5d79-e77f-57ee-a7d2-404e9de38304"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"948330e7-db0e-11ef-9886-a0d3651f611f","pinyin":"gōu","source_anchor_text":"平陰令興緱氏令其後","source_key":"baiyang_epub","start_index":131,"text":"緱","tongjian_id":"ba3ef10d-40e3-5706-a700-6ab428e7a257"}],"ExtRef_Children_places":[{"place_name":"緱氏","place_name_jianti_auto":"缑氏","resolved_place_entity_id":2336,"start_index":131,"tongjian_id":"94833115-db0e-11ef-9ef2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5夏，四月，丁巳，封皇子輔爲右翊公，英爲楚公，陽爲東海公，康爲濟南公，蒼爲東平公，延爲淮陽公，荊爲山陽公，衡爲臨淮公，焉爲左翊公，京爲琅邪公。癸丑，追諡兄縯爲齊武公，兄仲爲魯哀公。帝感縯功業不就，撫育二子章、興，恩愛甚篤；以其少貴，欲令親吏事，使章試守平陰令，興緱氏令；其後章遷梁郡太守，興遷弘農太守。","content_fanyi":"夏季四月丁巳日，光武帝册封皇子刘辅为右翊公，刘英为楚公，刘阳为东海公，刘康为济南公，刘苍为东平公，刘延为淮阳公，刘荆为山阳公，刘衡为临淮公，刘焉为左翊公，刘京为琅邪公。癸丑日，追谥兄长刘縯为齐武公，兄长刘仲为鲁哀公。光武帝感念刘縯功业未成，对刘縯的两个儿子刘章、刘兴加以抚育，十分疼爱；他们年少而身居尊位，光武帝想让他们熟悉官府事务，于是让刘章试任平阴县令，让刘兴试任缑氏县令；后来刘章升任梁郡太守，刘兴升任弘农太守。","content_jianti_auto":"5夏，四月，丁巳，封皇子辅为右翊公，英为楚公，阳为东海公，康为济南公，苍为东平公，延为淮阳公，荆为山阳公，衡为临淮公，焉为左翊公，京为琅邪公。癸丑，追谥兄𬙂为齐武公，兄仲为鲁哀公。帝感𬙂功业不就，抚育二子章、兴，恩爱甚笃；以其少贵，欲令亲吏事，使章试守平阴令，兴缑氏令；其后章迁梁郡太守，兴迁弘农太守。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3350,"number":5,"path":"资治通鉴 : 卷第四十三 (漢紀三十五) / 世祖光武皇帝中之下 / 十五年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"948330e7-db0e-11ef-9886-a0d3651f611f","year_int":39},"tongjian_id":"948330e7-db0e-11ef-9886-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"緱氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":9,"tongjian_id":"95abc494-db0e-11ef-8d77-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"緱氏縣","place_name_jianti_auto":"缑氏县","start_index":0,"tongjian_id":"95abc495-db0e-11ef-b411-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":5,"tongjian_id":"95abc496-db0e-11ef-8f30-a0d3651f611f"},{"place_name":"柏岯山","place_name_jianti_auto":"柏岯山","start_index":13,"tongjian_id":"95abc497-db0e-11ef-9d6d-a0d3651f611f"},{"place_name":"洛州","place_name_jianti_auto":"洛州","start_index":19,"tongjian_id":"95abc498-db0e-11ef-8ea2-a0d3651f611f"},{"place_name":"緱氏縣","place_name_jianti_auto":"缑氏县","start_index":21,"tongjian_id":"95abc499-db0e-11ef-93d3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"緱氏縣，屬河南尹。賢曰：卽柏岯山也，在洛州緱氏縣南。爾雅云：山一成曰岯。緱，工侯翻。岯，平眉翻。","note_content_jianti_auto":"缑氏县，属河南尹。贤曰：即柏岯山也，在洛州缑氏县南。尔雅云：山一成曰岯。缑，工侯翻。岯，平眉翻。","note_type":"hu_note","start_index":19,"tongjian_id":"95abc493-db0e-11ef-a0ef-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95abc492-db0e-11ef-8b8c-a0d3651f611f","pinyin":"gōu","source_anchor_text":"丑帝行幸緱氏登百岯","source_key":"baiyang_epub","start_index":11,"text":"緱","tongjian_id":"c7fc5edc-de28-5a15-bba6-aef2b0005bfa"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95abc492-db0e-11ef-8b8c-a0d3651f611f","pinyin":"pī","source_anchor_text":"緱氏登百岯山北匈奴","source_key":"baiyang_epub","start_index":16,"text":"岯","tongjian_id":"9b6cce2a-b0e2-5dca-9382-c5565e97a852"}],"ExtRef_Children_places":[{"place_name":"緱氏","place_name_jianti_auto":"缑氏","resolved_place_entity_id":2336,"start_index":11,"tongjian_id":"95abc49b-db0e-11ef-986e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"县西南三十五里又有半石山，合水出焉。○首阳山，在县西北二...","context_before":"...釜堆，相传周灵王太子晋升仙之所。又百岯山，在县南五十里。","source_end_index":64,"source_paragraph_tongjian_id":"7751c382-98fe-5575-a7b2-4b8547a3db87","source_start_index":43,"source_text":"汉和帝永元十六年，幸缑氏，登百岯山，是也。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"县西南三十五里又有半石山，合水出焉。○首阳山，在县西北二...","context_before":"...釜堆，相传周灵王太子晋升仙之所。又百岯山，在县南五十里。","source_end_index":64,"source_paragraph_tongjian_id":"4ff776c1-ee65-5877-a855-f22d38cef105","source_start_index":43,"source_text":"汉和帝永元十六年，幸缑氏，登百岯山，是也。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"4十一月，己丑，帝行幸緱氏，登百岯山。","content_fanyi":"十一月己丑日，和帝巡幸缑氏，登上百岯山。","content_jianti_auto":"4十一月，己丑，帝行幸缑氏，登百岯山。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3921,"number":4,"path":"资治通鉴 : 卷第四十八 (漢紀四十) / 孝和皇帝下 / 十六年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"95abc492-db0e-11ef-8b8c-a0d3651f611f","year_int":104},"tongjian_id":"95abc492-db0e-11ef-8b8c-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"緱氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"洛城","place_name_jianti_auto":"洛城","start_index":2,"tongjian_id":"9db9a857-db0e-11ef-bbf2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"橋在洛城西，去城十三里，因以爲名。","note_content_jianti_auto":"桥在洛城西，去城十三里，因以为名。","note_type":"hu_note","start_index":10,"tongjian_i