{"data":{"current_mention_tongjian_id":"8c2b9cb2-db0e-11ef-9d7a-a0d3651f611f","current_paragraph_tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"緱氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"皇甫謐","people_name_jianti_auto":"皇甫谧","start_index":0,"tongjian_id":"8d23bddd-db0e-11ef-824a-a0d3651f611f"},{"people_name":"后稷","people_name_jianti_auto":"后稷","start_index":25,"tongjian_id":"8d23bdde-db0e-11ef-abeb-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":33,"tongjian_id":"8d23bddf-db0e-11ef-a810-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":5,"tongjian_id":"8d23bde0-db0e-11ef-8ae4-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":19,"tongjian_id":"8d23bde1-db0e-11ef-aa4a-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":54,"tongjian_id":"8d23bde2-db0e-11ef-826a-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":61,"tongjian_id":"8d23bde3-db0e-11ef-95ab-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":68,"tongjian_id":"8d23bde4-db0e-11ef-adb4-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":72,"tongjian_id":"8d23bde5-db0e-11ef-bc70-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":98,"tongjian_id":"8d23bde6-db0e-11ef-a30f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"皇甫謐曰：周凡三十七王，八百六十七年。周有天下，祀后稷以配天，宗祀文王於明堂以配上帝，宗廟血食八百六十餘年。西周已亡，猶幸東周能守其祀，東周又爲秦所滅，則盡不祀矣。索隱曰：旣，盡也。日食盡曰旣。言周祚盡滅，無主祭祀。","note_content_jianti_auto":"皇甫谧曰：周凡三十七王，八百六十七年。周有天下，祀后稷以配天，宗祀文王于明堂以配上帝，宗庙血食八百六十余年。西周已亡，犹幸东周能守其祀，东周又为秦所灭，则尽不祀矣。索隐曰：既，尽也。日食尽曰既。言周祚尽灭，无主祭祀。","note_type":"hu_note","start_index":35,"tongjian_id":"8d23bddc-db0e-11ef-b708-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d23bdea-db0e-11ef-bf2e-a0d3651f611f"},{"people_name":"周武王","people_name_jianti_auto":"周武王","start_index":11,"tongjian_id":"8d23bdeb-db0e-11ef-8a31-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":18,"tongjian_id":"8d23bdec-db0e-11ef-bd5f-a0d3651f611f"},{"people_name":"平王","people_name_jianti_auto":"平王","start_index":30,"tongjian_id":"8d23bded-db0e-11ef-a275-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":38,"tongjian_id":"8d23bdee-db0e-11ef-ac1d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":51,"tongjian_id":"8d23bdef-db0e-11ef-a057-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":63,"tongjian_id":"8d23bdf0-db0e-11ef-a969-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":80,"tongjian_id":"8d23bdf1-db0e-11ef-b0c8-a0d3651f611f"},{"people_name":"魏文帝","people_name_jianti_auto":"魏文帝","start_index":153,"tongjian_id":"8d23bdf2-db0e-11ef-a4bf-a0d3651f611f"},{"people_name":"劉昭","people_name_jianti_auto":"刘昭","start_index":161,"tongjian_id":"8d23bdf3-db0e-11ef-ba61-a0d3651f611f"},{"people_name":"帝嚳","people_name_jianti_auto":"帝喾","start_index":168,"tongjian_id":"8d23bdf4-db0e-11ef-bc11-a0d3651f611f"},{"people_name":"盤庚","people_name_jianti_auto":"盘庚","start_index":173,"tongjian_id":"8d23bdf5-db0e-11ef-ac36-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":195,"tongjian_id":"8d23bdf6-db0e-11ef-a593-a0d3651f611f"},{"people_name":"劉子","people_name_jianti_auto":"刘子","start_index":206,"tongjian_id"