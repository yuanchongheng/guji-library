ndex":200,"tongjian_id":"8d23be17-db0e-11ef-80bb-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":203,"tongjian_id":"8d23be18-db0e-11ef-844e-a0d3651f611f"},{"place_name":"緱氏","place_name_jianti_auto":"缑氏","place_note":"河南偃師縣南緱氏鎮","start_index":214,"tongjian_id":"8d23be19-db0e-11ef-9c97-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":217,"tongjian_id":"8d23be1a-db0e-11ef-8283-a0d3651f611f"},{"place_name":"滑國","place_name_jianti_auto":"滑国","start_index":220,"tongjian_id":"8d23be1b-db0e-11ef-969d-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":228,"tongjian_id":"8d23be1c-db0e-11ef-8ea0-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":231,"tongjian_id":"8d23be1d-db0e-11ef-b6b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：河南縣故郟鄏地，周武王遷九鼎，周公營以爲都，是爲王城；平王居之。洛陽，周公遷殷民於此，是爲成周。師古曰：穀城，卽今新安。應劭曰：平陰，在平城北，故曰平陰。班志：河南郡之平縣，卽平城也。括地志曰：故穀城在洛州河南縣西北十八里苑中。河陰縣城本漢平陰縣，在洛州洛陽縣東北五十里。十三州志曰：在平津大河之南，魏文帝改曰河陰。劉昭曰：偃師，帝嚳所都。盤庚復南亳，是爲西亳。鞏，古鞏伯國，周之東，周公所居。緱氏，周大夫劉子邑。宋白曰：緱氏，春秋之滑國。已上七邑，漢皆屬河南郡。緱，工侯翻。郟，音夾。鄏，音辱。","note_content_jianti_auto":"班志：河南县故郏鄏地，周武王迁九鼎，周公营以为都，是为王城；平王居之。洛阳，周公迁殷民于此，是为成周。师古曰：谷城，即今新安。应劭曰：平阴，在平城北，故曰平阴。班志：河南郡之平县，即平城也。括地志曰：故谷城在洛州河南县西北十八里苑中。河阴县城本汉平阴县，在洛州洛阳县东北五十里。十三州志曰：在平津大河之南，魏文帝改曰河阴。刘昭曰：偃师，帝喾所都。盘庚复南亳，是为西亳。巩，古巩伯国，周之东，周公所居。缑氏，周大夫刘子邑。宋白曰：缑氏，春秋之滑国。已上七邑，汉皆属河南郡。缑，工侯翻。郏，音夹。鄏，音辱。","note_type":"hu_note","start_index":64,"tongjian_id":"8d23bde9-db0e-11ef-8a58-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d23bdda-db0e-11ef-95fa-a0d3651f611f","pinyin":"gōu","source_anchor_text":"陰偃師鞏緱氏以河南","source_key":"baiyang_epub","start_index":61,"text":"緱","tongjian_id":"797ad8a5-1a12-5e84-9d31-7c03cbcdfe50"}],"ExtRef_Children_places":[{"place_name":"緱氏","place_name_jianti_auto":"缑氏","place_note":"河南偃師縣南緱氏鎮","resolved_place_entity_id":2336,"start_index":61,"tongjian_id":"8d23be2e-db0e-11ef-985d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"","context_before":"","source_end_index":93,"source_paragraph_tongjian_id":"3f49e613-d477-5ab1-8e54-913727cf6b8d","source_start_index":0,"source_text":"周室衰微，所有者，河南[即王城也]、洛阳[即下都也]、穀城[今河南府城西北十八里，有故穀城]、平阴[故城在今孟津县东]、偃师[今县]、巩[今县]、缑氏[故城在今偃师县南二十里]七城而已。"},{"context_after":"","context_before":"","source_end_index":19,"source_paragraph_tongjian_id":"fe014630-cf8b-5b9c-8a59-cef7fabc1fbc","source_start_index":0,"source_text":"既又分为东西二周，秦人入寇，周遂先亡。"},{"context_after":"○吴氏曰：敬王四年，子朝奔楚[事在《春秋》昭二十六年]，...","context_before":"...洛阳、平阴、偃师、巩四邑，属东周]，于是东西周同于列国。","source_end_index":248,"source_paragraph_tongjian_id":"476fcff8-ee12-5c17-ad87-261bd7d244eb","source_start_index":222,"source_text":"显王特寄居东周之洛阳而已，赧王复迁于西周，而周乃亡。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"汉三年，项羽拔成皋欲西，汉兵距之巩，令其不得西。后置县于...","context_before":"...有河山之固也。《史记》：西周惠公封少子班于此，为东周公。","source_end_index":105,"source_paragraph_tongjian_id":"83e67a19-f753-548a-b5dc-fafc264a98f1","source_start_index":78,"source_text":"秦庄襄元年，蒙骜伐韩，韩献成皋、巩。盖东周亡于是年也。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/九、汝州（卷五十一）","excerpts":[{"context_after":"东汉初平二年，孙坚讨董卓，移屯梁东，为卓将徐荣所败。坚复...","context_before":"...在梁县西四十里。《战国策》：郑强矫以新城、阳人与韩太子。","source_end_index":138,"source_paragraph_tongjian_id":"cbacbfe8-c49d-5ac8-b445-6a4a3c76150d","source_start_index":109,"source_text":"《史记》：秦庄襄王元年，灭东周，不绝其祀，以阳人地赐周君。"}],"path":"河南方舆纪要/九、汝州（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2東周君與諸侯謀伐秦；王使相國帥師討滅之，遷東周君於陽人聚。周旣不祀。周比亡，凡有七邑：河南、洛陽、穀城、平陰、偃師、鞏、緱氏。","content_fanyi":"东周国国君与各诸侯国共同谋划攻打秦国；秦庄襄王因此派相国吕不韦统率军队讨灭东周，将东周国君迁往阳人聚。周王朝至此灭亡，再无人主持祭祀。周朝到灭亡时共有七邑：河南、洛阳、穀城、平阴、偃师、巩、缑氏。","content_jianti_auto":"2东周君与诸侯谋伐秦；王使相国帅师讨灭之，迁东周君于阳人聚。周既不祀。周比亡，凡有七邑：河南、洛阳、谷城、平阴、偃师、巩、缑氏。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，晋之篡魏而吞吴也，谋唯恐其不险，力唯恐其不竞，日进阴鸷...","context_before":"...旋弢，天下以为实获我心，可澡雪以见荣于文治。秦之并六国、","source_end_index":204,"source_paragraph_tongjian_id":"fb026fa1-8ca9-40fe-916e-87600bf196cb","source_start_index":201,"source_text":"灭宗周"}],"title":"一三 罢兵不可操之过急"}],"id":453,"number":2,"path":"资治通鉴 : 卷第六 (秦紀一) / 莊襄王 / 元年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8d23bdda-db0e-11ef-95fa-a0d3651f611f","year_int":-249},"tongjian_id":"8d23bdda-db0e-11ef-95fa-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"緱氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"荀","people_name_jianti_auto":"荀","start_index":23,"tongjian_id":"90051a0a-db0e-11ef-a4ac-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：封禪書、郊祀志作「三月」；漢書·武紀及荀紀皆作「正月」，今從之。","note_content_jianti_auto":"考异曰：封禅书、郊祀志作「三月」；汉书·武纪及荀纪皆作「正月」，今从之。","note_type":"hu_note","start_index":12,"tongjian_id":"90051a09-db0e-11ef-bf55-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"荀悅","people_name_jianti_auto":"荀悦","start_index":0,"tongjian_id":"90051a11-db0e-11ef-bf59-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"荀悅曰：萬歲，神稱之也。從，才用翻。","note_content_jianti_auto":"荀悦曰：万岁，神称之也。从，才用翻。","note_type":"hu_note","start_index":35,"tongjian_id":"90051a10-db0e-11ef-b7b6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"90051a08-db0e-11ef-9f2b-a0d3651f611f","pinyin":"gōu","source_anchor_text":"月上行幸緱氏禮祭中","source_key":"baiyang_epub","start_index":9,"text":"緱","tongjian_id":"3da59ab6-297a-54c9-9c97-e74d4478695b"}],"ExtRef_Children_places":[{"place_name":"緱氏","place_name_jianti_auto":"缑氏","resolved_place_entity_id":2336,"start_index":9,"tongjian_id":"90051a13-db0e-11ef-bf77-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷四十六）","excerpts":[{"context_after":"[即今登封县]。其西为少室山。戴延之《述征记》：少室高与...","context_before":"...，九州之险也[又楚椒举曰：周幽王为太室之盟，戎狄叛之]。","source_end_index":165,"source_paragraph_tongjian_id":"ab05e77a-b60a-5470-8dbe-6133a5d23eeb","source_start_index":143,"source_text":"《汉书》：武帝礼祭中岳太室，置奉邑，名曰嵩高"}],"path":"河南方舆纪要/〇、封域山川险要（卷四十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"4春，正月，上行幸緱氏，禮祭中嶽太室，從官在山下聞若有言「萬歲」者三。詔祠官加增太室祠，禁無伐其草木，以山下戶三百爲之奉邑。","content_fanyi":"春季，正月，汉武帝巡行到缑氏，祭祀中岳太室；随行官员在山下隐约听见好像有人三次呼喊“万岁”。他下诏让祠官扩建太室祠，禁止砍伐山上的草木，并把山下三百户人家拨给该祠作为奉邑。","content_jianti_auto":"4春，正月，上行幸缑氏，礼祭中岳太室，从官在山下闻若有言「万岁」者三。诏祠官加增太室祠，禁无伐其草木，以山下户三百为之奉邑。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1670,"number":4,"path":"资治通鉴 : 卷第二十 (漢紀十二) / 世宗孝武皇帝中之下 / 元封元年 / 第 4 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"90051a08-db0e-11ef-9f2b-a0d3651f611f","year_int":-110,"zhang_TJZJ_id":"zttjzj_000546"},"tongjian_id":"90051a08-db0e-11ef-9f2b-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"緱氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"緱氏縣","place_name_jianti_auto":"缑氏县","start_index":0,"tongjian_id":"945e2894-db0e-11ef-b90c-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":5,"tongjian_id":"945e2895-db0e-11ef-b8ea-a0d3651f611f"},{"place_name":"緱氏山","place_name_jianti_auto":"缑氏山","start_index":11,"tongjian_id":"945e2896-db0e-11ef-8674-a0d3651f611f"},{"place_name":"轘轅山","place_name_jianti_auto":"轘辕山","start_index":15,"tongjian_id":"945e2897-db0e-11ef-a4a4-a0d3651f611f"},{"place_name":"轘轅坂","place_name_jianti_auto":"轘辕坂","start_index":19,"tongjian_id":"945e2898-db0e-11ef-b068-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":25,"tongjian_id":"945e2899-db0e-11ef-a5b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"緱氏縣，屬河南尹；縣有緱氏山、轘轅山、轘轅坂，並在雒陽之東南。緱，工侯翻。轘，音環。","note_content_jianti_auto":"缑氏县，属河南尹；县有缑氏山、轘辕山、轘辕坂，并在雒阳之东南。缑，工侯翻。轘，音环。","note_type":"hu_note","start_index":18,"tongjian_id":"945e2893-db0e-11ef-b8cf-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"945e2892-db0e-11ef-818f-a0d3651f611f","pinyin":"gōu","source_anchor_text":"丙戌帝幸緱氏登轘轅","source_key":"baiyang_epub","start_index":11,"text":"緱","tongjian_id":"d68b67d4-1ed5-54e5-b73e-6a29439ad788"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"945e2892-db0e-11ef-818f-a0d3651f611f","pinyin":"huán","source_anchor_text":"幸緱氏登轘轅吳漢率","source_key":"baiyang_epub","start_index":15,"text":"轘","tongjian_id":"b7e33c86-7af0-5a1e-a40e-2dbc5ab48c14"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"945e2892-db0e-11ef-818f-a0d3651f611f","pinyin":"yuán","source_anchor_text":"緱氏登轘轅吳漢率王","source_key":"baiyang_epub","start_index":16,"text":"轅","tongjian_id":"5def1c9b-1ca5-587b-83b2-c924792c64a7"}],"ExtRef_Children_places":[{"place_name":"緱氏","place_name_jianti_auto":"缑氏","resolved_place_entity_id":2336,"start_index":11,"tongjian_id":"945e289a-db0e-11ef-8b01-a0d