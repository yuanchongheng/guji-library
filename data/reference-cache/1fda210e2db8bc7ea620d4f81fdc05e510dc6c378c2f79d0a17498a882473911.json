7-db0e-11ef-850e-a0d3651f611f"},{"place_name":"遼","place_name_jianti_auto":"辽","resolved_place_entity_id":493,"start_index":127,"tongjian_id":"950c8e88-db0e-11ef-bd41-a0d3651f611f"},{"place_name":"黎陽","place_name_jianti_auto":"黎阳","resolved_place_entity_id":421,"start_index":133,"tongjian_id":"950c8e89-db0e-11ef-90dc-a0d3651f611f"},{"place_name":"五原","place_name_jianti_auto":"五原","resolved_place_entity_id":554,"start_index":140,"tongjian_id":"950c8e8a-db0e-11ef-9ec0-a0d3651f611f"},{"place_name":"曼柏","place_name_jianti_auto":"曼柏","resolved_place_entity_id":3801,"start_index":142,"tongjian_id":"950c8e8b-db0e-11ef-b7b3-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十、榆林镇（卷六十一）","excerpts":[{"context_after":"永元六年，南单于安国欲诛其右谷蠡王师子，师子遁入曼柏城。...","context_before":"曼柏城[在故胜州西。汉县，属五原郡。后汉因之。","source_end_index":49,"source_paragraph_tongjian_id":"beeac401-fb65-5322-9b6f-bb7d1991c770","source_start_index":23,"source_text":"永平十八年，置度辽将军屯营于此，以防南北匈奴交通也。"}],"path":"陕西方舆纪要/十、榆林镇（卷六十一）","source_name":"读史方舆纪要"}],"class_tags":["军事","内政"],"content":"初，大司農耿國上言：「宜置度遼將軍屯五原，以防南匈奴逃亡，」朝廷不從。南匈奴須卜骨都侯等知漢與北虜交使，內懷嫌怨，欲畔，密使人詣北虜，令遣兵迎之。鄭衆出塞，疑有異；伺候，果得須卜使人。乃上言：「宜更置大將，以防二虜交通。」由是始置度遼營，以中郞將吳棠行度遼將軍事，將黎陽虎牙營士屯五原曼柏。","content_fanyi":"当初，大司农耿国曾上书说：“应当设置度辽将军驻守五原郡，以防备南匈奴逃亡。”朝廷没有采纳。南匈奴须卜骨都侯等人知道汉朝与北匈奴互派使臣，内心怀有怨恨，想要反叛，便秘密派人到北匈奴那里，要求他们发兵接应。郑众出使塞外，怀疑情况有变；便派人伺机侦察，果然抓获了须卜骨都侯派来的使者。郑众于是上书说：“应当再设大将，以防备南、北匈奴互相交往。”从此开始设置度辽营，任命中郎将吴棠代理度辽将军职事，率领黎阳虎牙营士兵屯驻五原郡曼柏县。","content_jianti_auto":"初，大司农耿国上言：「宜置度辽将军屯五原，以防南匈奴逃亡，」朝廷不从。南匈奴须卜骨都侯等知汉与北虏交使，内怀嫌怨，欲畔，密使人诣北虏，令遣兵迎之。郑众出塞，疑有异；伺候，果得须卜使人。乃上言：「宜更置大将，以防二虏交通。」由是始置度辽营，以中郞将吴棠行度辽将军事，将黎阳虎牙营士屯五原曼柏。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3567,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"950c8e65-db0e-11ef-bcda-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4秋，郡國十四大水。","content_fanyi":"秋季，十四个郡国发生大水。","content_jianti_auto":"4秋，郡国十四大水。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3568,"number":4,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"950c8e8c-db0e-11ef-9679-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"北宮","place_name_jianti_auto":"北宫","resolved_place_entity_id":1235,"start_index":6,"tongjian_id":"950c8e8e-db0e-11ef-8266-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5冬，十月，北宮成。","content_fanyi":"冬季，十月，北宫修建完成。","content_jianti_auto":"5冬，十月，北宫成。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3569,"number":5,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"950c8e8d-db0e-11ef-a90a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"漢成帝","people_name_jianti_auto":"汉成帝","start_index":0,"tongjian_id":"950c8e91-db0e-11ef-bdb4-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":31,"tongjian_id":"950c8e92-db0e-11ef-845a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢成帝王國省內史，令相治民，職如太守，秩二千石。紈，今之絹也。師古曰：紈，素也；縑，幷絲絹也。相，息亮翻。","note_content_jianti_auto":"汉成帝王国省内史，令相治民，职如太守，秩二千石。纨，今之绢也。师古曰：纨，素也；缣，幷丝绢也。相，息亮翻。","note_type":"hu_note","start_index":41,"tongjian_id":"950c8e90-db0e-11ef-a7ff-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"國相","official_note":"國相是漢代諸侯國的行政長官，負責輔佐諸侯王管理封國事務，此處楚王英向國相報告贖罪事宜，顯示國相在地方行政中的監管角色。","official_rank":"未知","source_snippet":"楚王英奉黃縑、白紈詣國相曰","start_index":32,"tongjian_id":"f43f530b-1e3a-4aba-82aa-ab4b40c11abb"}],"ExtRef_Children_people":[{"link_death_year":71,"link_td_description":"刘英，东汉楚王，为光武帝和许美人所生，是已知中国贵族中最早的佛教信徒。","link_td_id":"Q10002430","link_td_number_id":356836,"people_name":"楚王","people_name_jianti_auto":"楚王","start_index":27,"tongjian_id":"950c8e95-db0e-11ef-bcfb-a0d3651f611f"},{"link_death_year":71,"link_td_description":"刘英，东汉楚王，为光武帝和许美人所生，是已知中国贵族中最早的佛教信徒。","link_td_id":"Q10002430","link_td_number_id":356836,"people_name":"英","people_name_jianti_auto":"英","people_xingming":"刘英","start_index":29,"tongjian_id":"950c8e96-db0e-11ef-81b7-a0d3651f611f"},{"link_death_year":71,"link_td_description":"刘英，东汉楚王，为光武帝和许美人所生，是已知中国贵族中最早的佛教信徒。","link_td_id":"Q10002430","link_td_number_id":356836,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"刘英","start_index":78,"tongjian_id":"950c8e98-db0e-11ef-9ba7-a0d3651f611f"},{"link_td_description":"黄帝，中国古代部落联盟首领，为《史记》中五帝之首。","link_td_id":"Q10000032","link_td_number_id":10961,"people_name":"黃","people_name_jianti_auto":"黄","people_xingming":"姬轩辕","start_index":81,"tongjian_id":"950c8e99-db0e-11ef-8499-a0d3651f611f","wl_zhushi":"[姬轩辕]"},{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"李耳","start_index":83,"tongjian_id":"950c8e9a-db0e-11ef-9d94-a0d3651f611f","wl_zhushi":"[李耳]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"遼","place_name_jianti_auto":"辽","resolved_place_entity_id":493,"start_index":11,"tongjian_id":"950c8e97-db0e-11ef-ad8a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6丙子，募死罪繫囚詣度遼營；有罪亡命者，令贖罪各有差。楚王英奉黃縑、白紈詣國相曰：「託在藩輔，過惡累積，歡喜大恩，奉送縑帛，以贖愆罪。」國相以聞，詔報曰：「楚王誦黃、老之微言，尚浮屠之仁慈，潔齊三月，與神爲誓，何嫌何疑，當有悔吝！其還贖，以助伊蒲塞、桑門之盛饌。」","content_fanyi":"十月初四日丙子，朝廷招募关押在牢中的死刑犯前往度辽营；有罪而逃亡的人，按照罪情轻重定出不同等级，让他们从军赎罪。楚王刘英拿着黄色细绢和白色薄绸，来见楚国国相，说：“我身在藩国辅佐之列，过失和罪恶积累很多，幸蒙天子大恩，特此奉上缣帛，用来赎回罪过。”楚国国相把这件事奏报汉明帝，汉明帝下诏回答说：“楚王诵读黄帝、老子精微的言论，崇尚佛陀的仁慈，斋戒沐浴三个月，与神明立下誓言，哪有什么嫌疑和疑忌，该当悔恨呢！退还他送来的赎罪之物，用来资助在家修行的伊蒲塞和出家的桑门置办丰盛饭食。”","content_jianti_auto":"6丙子，募死罪系囚诣度辽营；有罪亡命者，令赎罪各有差。楚王英奉黄缣、白纨诣国相曰：「托在藩辅，过恶累积，欢喜大恩，奉送缣帛，以赎愆罪。」国相以闻，诏报曰：「楚王诵黄、老之微言，尚浮屠之仁慈，洁齐三月，与神为誓，何嫌何疑，当有悔吝！其还赎，以助伊蒲塞、桑门之盛馔。」","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"；笮融课民盛饰以事浮屠，而以劫掠死于锋刃；梁武帝舍身事浮...","context_before":"","source_end_index":13,"source_paragraph_tongjian_id":"70b3d447-98e1-4117-9031-029b4f31086e","source_start_index":0,"source_text":"楚王英始事浮屠，而以反自杀"}],"title":"五 事浮屠致祸"}],"id":3570,"number":6,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"950c8e8f-db0e-11ef-b1ee-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁宏","people_name_jianti_auto":"袁宏","start_index":0,"tongjian_id":"950c8e9d-db0e-11ef-8b7b-a0d3651f611f"},{"people_name":"明帝","people_name_jianti_auto":"明帝","start_index":93,"tongjian_id":"950c8e9e-db0e-11ef-b70f-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":150,"tongjian_id":"950c8e9f-db0e-11ef-bc17-a0d3651f611f"},{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":214,"tongjian_id":"950c8ea0-db0e-11ef-83f0-a0d3651f611f"},{"people_name":"漢武帝","people_name_