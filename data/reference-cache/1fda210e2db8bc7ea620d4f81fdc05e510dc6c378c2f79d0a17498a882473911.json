1f611f"},{"place_name":"遼","place_name_jianti_auto":"辽","start_index":46,"tongjian_id":"950c8e78-db0e-11ef-af1c-a0d3651f611f"},{"place_name":"曼柏縣","place_name_jianti_auto":"曼柏县","start_index":56,"tongjian_id":"950c8e79-db0e-11ef-b95c-a0d3651f611f"},{"place_name":"勝州","place_name_jianti_auto":"胜州","start_index":62,"tongjian_id":"950c8e7a-db0e-11ef-914e-a0d3651f611f"},{"place_name":"銀城縣","place_name_jianti_auto":"银城县","start_index":64,"tongjian_id":"950c8e7b-db0e-11ef-822f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢官儀曰：光武以幽、冀兵克定天下，故於黎陽立營，以謁者監領，兵騎千人。賢曰：昭帝拜范明友爲度遼將軍，至此復置焉。曼柏縣，在今勝州銀城縣界。","note_content_jianti_auto":"汉官仪曰：光武以幽、冀兵克定天下，故于黎阳立营，以谒者监领，兵骑千人。贤曰：昭帝拜范明友为度辽将军，至此复置焉。曼柏县，在今胜州银城县界。","note_type":"hu_note","start_index":145,"tongjian_id":"950c8e70-db0e-11ef-a816-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"財政","official_name":"大司農","official_note":"大司農是漢代掌管國家財政、農業、倉儲等事務的中央高級官員，屬於九卿之一。在原文中，大司農耿國向朝廷提出設置度遼將軍的建議，體現其參與邊防政策的職能。","official_rank":"九卿之一，秩中二千石","source_snippet":"大司農耿國上言","start_index":3,"tongjian_id":"487e1ddc-56ba-4c31-8636-a34327bd88c4"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"度遼將軍","official_note":"度遼將軍是漢代為防禦匈奴等北方民族而設置的雜號將軍，負責屯兵邊境。原文中耿國建議設置此職以防南匈奴逃亡，後因鄭衆建議而實際設立，體現其在邊防中的軍事指揮作用。","official_rank":"雜號將軍，秩比二千石或以上","source_snippet":"宜置度遼將軍屯五原","start_index":12,"tongjian_id":"a9d0f77e-1c1b-4540-9dc3-2c3ca72c8264"},{"confidence":0.92,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代禁軍將領，常負責宮廷守衛或出征。在原文中，中郞將吳棠被任命代理度遼將軍職務，率軍屯駐五原，顯示其臨時承擔邊防軍事職責。","official_rank":"比二千石","source_snippet":"以中郞將吳棠行度遼將軍事","start_index":113,"tongjian_id":"416c6300-71be-4fa9-a6d6-b2244e4be981"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"度遼將軍","official_note":"此處度遼將軍作為官職名稱再次出現，指吳棠代理的職務。原文中朝廷採納鄭衆建議設置度遼營，並以中郞將吳棠行度遼將軍事，體現該職在防範匈奴交通中的關鍵作用。","official_rank":"雜號將軍，秩比二千石或以上","source_snippet":"以中郞將吳棠行度遼將軍事","start_index":119,"tongjian_id"