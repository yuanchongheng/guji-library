{"data":{"current_mention_tongjian_id":"8c295cd0-db0e-11ef-a040-a0d3651f611f","current_paragraph_tongjian_id":"8c295cbe-db0e-11ef-9d0a-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"有殷","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蔡邕","people_name_jianti_auto":"蔡邕","start_index":0,"tongjian_id":"956796bb-db0e-11ef-9537-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蔡邕獨斷曰：少帝卽位，太后卽代攝政，臨前殿，朝羣臣，太后東面，少帝西面。羣臣上書奏事，皆爲兩通，一詣太后，一詣少帝。","note_content_jianti_auto":"蔡邕独断曰：少帝即位，太后即代摄政，临前殿，朝群臣，太后东面，少帝西面。群臣上书奏事，皆为两通，一诣太后，一诣少帝。","note_type":"hu_note","start_index":6,"tongjian_id":"956796ba-db0e-11ef-8e5a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"956796be-db0e-11ef-8081-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：幹，主也，或曰：幹，古管字也。","note_content_jianti_auto":"贤曰：干，主也，或曰：干，古管字也。","note_type":"hu_note","start_index":16,"tongjian_id":"956796bd-db0e-11ef-b2a1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩·周頌·振鷺之辭，言庶幾於夙夜匪懈，以終保令名於有永也。","note_content_jianti_auto":"诗·周颂·振鹭之辞，言庶几于夙夜匪懈，以终保令名于有永也。","note_type":"hu_note","start_index":120,"tongjian_id":"956796c2-db0e-11ef-8dc3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"馮野王","people_name_jianti_auto":"冯野王","start_index":0,"tongjian_id":"956796c5-db0e-11ef-8fed-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":5,"tongjian_id":"956796c6-db0e-11ef-9771-a0d3651f611f"},{"people_name":"野王","people_name_jianti_auto":"野王","start_index":15,"tongjian_id":"956796c7-db0e-11ef-8592-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"馮野王妹爲元帝昭儀，於九卿中，野王行能第一。","note_content_jianti_auto":"冯野王妹为元帝昭仪，于九卿中，野王行能第一。","note_type":"hu_note","start_index":135,"tongjian_id":"956796c4-db0e-11ef-9970-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陰衞尉","people_name_jianti_auto":"阴衞尉","start_index":0,"tongjian_id":"956796c9-db0e-11ef-9f51-a0d3651f611f"},{"people_name":"興","people_name_jianti_auto":"兴","start_index":4,"tongjian_id":"956796ca-db0e-11ef-bb42-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陰衞尉，興也，謂讓侯爵，又讓大司馬也。","note_content_jianti_auto":"阴衞尉，兴也，谓让侯爵，又让大司马也。","note_type":"hu_note","start_index":149,"tongjian_id":"956796c8-db0e-11ef-8bdc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"呂氏","people_name_jianti_auto":"吕氏","start_index":6,"tongjian_id":"956796cc-db0e-11ef-8fd3-a0d3651f611f"},{"people_name":"張氏","people_name_jianti_auto":"张氏","start_index":9,"tongjian_id":"956796cd-db0e-11ef-b4fb-a0d3651f611f"},{"people_name":"薄氏","people_name_jianti_auto":"薄氏","start_index":12,"tongjian_id":"956796ce-db0e-11ef-a3dd-a0d3651f611f"},{"people_name":"竇氏","people_name_jianti_auto":"窦氏","start_index":15,"tongjian_id":"956796cf-db0e-11ef-