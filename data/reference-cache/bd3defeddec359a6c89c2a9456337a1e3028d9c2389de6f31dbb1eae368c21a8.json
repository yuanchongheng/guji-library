-db0e-11ef-8a08-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","start_index":38,"tongjian_id":"8c0467a6-db0e-11ef-bc75-a0d3651f611f"},{"place_name":"靈丘","place_name_jianti_auto":"灵丘","start_index":50,"tongjian_id":"8c0467a7-db0e-11ef-8475-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":62,"tongjian_id":"8c0467a8-db0e-11ef-b2a7-a0d3651f611f"},{"place_name":"千乘","place_name_jianti_auto":"千乘","start_index":66,"tongjian_id":"8c0467a9-db0e-11ef-afc1-a0d3651f611f"},{"place_name":"清河","place_name_jianti_auto":"清河","start_index":69,"tongjian_id":"8c0467aa-db0e-11ef-8372-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":74,"tongjian_id":"8c0467ab-db0e-11ef-8aa6-a0d3651f611f"},{"place_name":"清河郡","place_name_jianti_auto":"清河郡","start_index":75,"tongjian_id":"8c0467ac-db0e-11ef-8617-a0d3651f611f"},{"place_name":"靈縣","place_name_jianti_auto":"灵县","start_index":79,"tongjian_id":"8c0467ad-db0e-11ef-9565-a0d3651f611f"},{"place_name":"清河北","place_name_jianti_auto":"清河北","start_index":82,"tongjian_id":"8c0467ae-db0e-11ef-9607-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":86,"tongjian_id":"8c0467af-db0e-11ef-8b51-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":88,"tongjian_id":"8c0467b0-db0e-11ef-bbfe-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：靈丘，河東蔚州縣。余按蔚州之靈丘，卽漢代郡之靈丘，此時齊境安能至代北邪！此卽孟子謂蚳鼃辭靈丘請士師之地。班志曰：齊地北有千乘、清河以南。漢清河郡有靈縣，清河北接趙、魏之境，此爲近之。蚳，音遲。鼃，烏花翻。","note_content_jianti_auto":"史记正义曰：灵丘，河东蔚州县。余按蔚州之灵丘，即汉代郡之灵丘，此时齐境安能至代北邪！此即孟子谓蚳鼃辞灵丘请士师之地。班志曰：齐地北有千乘、清河以南。汉清河郡有灵县，清河北接赵、魏之境，此为近之。蚳，音迟。鼃，乌花翻。","note_type":"hu_note","start_index":13,"tongjian_id":"8c046799-db0e-11ef-9b8c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"靈丘","place_name_jianti_auto":"灵丘","place_note":"山東茌平","resolved_place_entity_id":3479,"start_index":10,"tongjian_id":"8c0467b7-db0e-11ef-8cf9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"《赵世家》：惠文王十四年，相国乐毅将赵、秦、韩、魏、燕之...","context_before":"灵县城[在州东北。胡氏以为即齐灵丘邑。","source_end_index":42,"source_paragraph_tongjian_id":"585d48f1-0a41-542a-b2f7-241fcce9b618","source_start_index":19,"source_text":"《史记·齐世家》：威王元年，三晋伐我，至灵丘。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2魏、韓、趙伐齊，至靈丘。","content_fanyi":"魏、韩、赵三国讨伐齐国，军队进至灵丘。","content_jianti_auto":"2魏、韩、赵伐齐，至灵丘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":79,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 二十四年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c046798-db0e-11ef-a831-a0d3651f611f","year_int":-378},"tongjian_id":"8c046798-db0e-11ef-a831-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"靈丘","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"靈丘縣","place_name_jianti_auto":"灵丘县","start_index":0,"tongjian_id":"a90d79e1-db0e-11ef-8a65-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"a90d79e2-db0e-11ef-9eed-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":8,"tongjian_id":"a90d79e3-db0e-11ef-a38c-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":11,"tongjian_id":"a90d79e4-db0e-11ef-b03e-a0d3651f611f"},{"place_name":"蔚州","place_name_jianti_auto":"蔚州","start_index":13,"tongjian_id":"a90d79e5-db0e-11ef-83fe-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"靈丘縣自漢以來屬代郡，唐爲蔚州。","note_content_jianti_auto":"灵丘县自汉以来属代郡，唐为蔚州。","note_type":"hu_note","start_index":35,"tongjian_id":"a90d79e0-db0e-11ef-b324-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"靈丘","place_name_jianti_auto":"灵丘","resolved_place_entity_id":3479,"start_index":32,"tongjian_id":"a90d79e9-db0e-11ef-bcaa-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"19冬，十一月，戊戌，魏主如中山，遂如信都；十二月，丙子，還，幸靈丘，至溫泉宮；庚辰，還平城。","content_fanyi":"冬季，十一月初五日戊戌，魏文成帝前往中山，接着又去信都。十二月十四日丙子，魏文成帝动身返回，途中巡幸灵丘，再到温泉宫。十二月十八日庚辰，回到平城。","content_jianti_auto":"19冬，十一月，戊戌，魏主如中山，遂如信都；十二月，丙子，还，幸灵丘，至温泉宫；庚辰，还平城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11908,"number":19,"path":"资治通鉴 : 卷第一百二十八 (宋紀十) / 世祖孝武皇帝上 / 孝建元年 / 第 42 段","reading_annotation_sources":[],"start_index":41,"tongjian_id":"a90d79df-db0e-11ef-bf8f-a0d3651f611f","year_int":454},"tongjian_id":"a90d79df-db0e-11ef-bf8f-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"靈丘","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"左城","place_name_jianti_auto":"左城","place_note":"河北唐县西","start_index":5,"tongjian_id":"adfb6cec-db0e-11ef-b33c-a0d3651f611f"},{"place_name":"博陵","place_name_jianti_auto":"博陵","start_index":9,"tongjian_id":"adfb6ced-db0e-11ef-bade-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":18,"tongjian_id":"adfb6cee-db0e-11ef-8f06-a0d3651f611f"},{"place_name":"唐縣","place_name_jianti_auto":"唐县","start_index":20,"tongjian_id":"adfb6cef-db0e-11ef-acd9-a0d3651f611f"},{"place_name":"左人城","place_name_jianti_auto":"左人城","start_index":23,"tongjian_id":"adfb6cf0-db0e-11ef-92c2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按楊津傳，左城當在博陵界。又水經註，中山唐縣有左人城。帥，讀曰率。","note_content_jianti_auto":"按杨津传，左城当在博陵界。又水经注，中山唐县有左人城。帅，读曰率。","note_type":"hu_note","start_index":22,"tongjian_id":"adfb6ceb-db0e-11ef-9941-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"靈丘縣","place_name_jianti_auto":"灵丘县","start_index":0,"tongjian_id":"adfb6cf4-db0e-11ef-868c-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"adfb6cf5-db0e-11ef-820c-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":6,"tongjian_id":"adfb6cf6-db0e-11ef-b368-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":9,"tongjian_id":"adfb6cf7-db0e-11ef-86fb-a0d3651f611f"},{"place_name":"蔚州","place_name_jianti_auto":"蔚州","start_index":11,"tongjian_id":"adfb6cf8-db0e-11ef-a199-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"靈丘縣，漢屬代郡，唐爲蔚州。","note_content_jianti_auto":"灵丘县，汉属代郡，唐为蔚州。","note_type":"hu_note","start_index":46,"tongjian_id":"adfb6cf3-db0e-11ef-9cae-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"手，首又翻。此以記·檀弓「子手弓」釋文爲據。","note_content_jianti_auto":"手，首又翻。此以记·檀弓「子手弓」释文为据。","note_type":"hu_note","start_index":85,"tongjian_id":"adfb6cf9-db0e-11ef-b1d6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"靈丘","place_name_jianti_auto":"灵丘","place_note":"山西灵丘","resolved_place_entity_id":3479,"start_index":43,"tongjian_id":"adfb6d03-db0e-11ef-a921-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、保定府（卷十二）","excerpts":[{"context_after":"盖谓左人城。刘昫曰：唐县旧治左人城。圣历初，移于今所]。","context_before":"...晋语》：赵襄子使新稚穆子攻翟，胜左人、中人。即此左人也。","source_end_index":66,"source_paragraph_tongjian_id":"c874ae1f-bb22-5ebf-8833-8c6d35ed9ee3","source_start_index":40,"source_text":"后魏孝昌三年，五原降户鲜于修礼等帅北镇流民反于左城。"}],"path":"北直方舆纪要/二、保定府（卷十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、真定府（卷十四）","excerpts":[{"context_after":"五鹿，在县东，盖滹沱河旁地名]。","context_before":"○滹沱河[县北十里。自山西盂县流入界，又东入灵寿县境。","source_end_index":75,"source_paragraph_tongjian_id":"ad81fcb4-c0b0-5965-8565-795463f5a243","source_start_index":27,"source_text":"北魏孝昌三年，五原降户鲜于修礼叛，攻定州。诏长孙稚等讨之。稚前至滹沱，修礼邀击之于五鹿，稚大败。"},{"context_after":"五代唐天成三年，王晏球围王都于定州，契丹趣救，晏球逆战，...","context_before":"...灵丘县高是山，东南过中山上曲阳县，又东过唐县，谓之唐河。","source_end_index":106,"source_paragraph_tongjian_id":"4fbdf9f6-fb8f-5ade-80f7-2eee7b38da52","source_start_index":75,"source_text":"后魏孝昌初，五原降户鲜于修礼叛，攻定州，其党宇文肱战死于唐河。"}],"path":"北直方舆纪要/四、真定府（卷十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"五原降戶鮮于脩禮等帥北鎭流民反於定州之左城，改元魯興，引兵向州城，州兵禦之不利。楊津至靈丘，聞定州危迫，引兵救之，入據州城。脩禮至，津欲出擊之，長史許被不聽，津手劍擊之，被走得免。津開門出戰，斬首數百，賊退，人心少安。詔尋以津爲定州刺史兼北道行臺。魏以揚州刺史長孫稚爲大都督北討諸軍事，與河間王琛共討脩禮。","content_fanyi":"五原降户鲜于脩礼等人率领北镇流民在定州左城反叛，改年号为鲁兴，随后领兵向州城进逼，州兵抵御失利。杨津到达灵丘，听说定州形势危急，便率兵前往救援，入城据守。鲜于脩礼来到后，杨津准备出城迎战，长史许被不同意，杨津拔剑刺向许被，许被逃开得以免死。杨津打开城门出城交战，斩首数百人，贼军退走，人心才渐渐安定。不久朝廷下诏任命杨津为定州刺史兼北道行台。北魏任命扬州刺史长孙稚为大都督北讨诸军事，与河间王元琛共同讨伐鲜于脩礼。","content_jianti_auto":"五原降户鲜于修礼等帅北镇流民反于定州之左城，改元鲁兴，引兵向州城，州兵御之不利。杨津至灵丘，闻定州危迫，引兵救之，入据州城。修礼至，津欲出击之，长史许被不听，津手剑击之，被走得免。津开门出战，斩首数百，贼退，人心少安。诏寻以津为定州刺史兼北道行台。魏以扬州刺史长孙稚为大都督北讨诸军事，与河间王琛共讨修礼。","dtjl_paragraph_links":[],"dtjl_references":[],"id":14271,"path":"资治通鉴 : 卷第一百五十一 (梁紀七) / 高祖武皇帝七 / 普通七年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"adfb6cea-db0e-11ef-b92b-a0d3651f611f","year_int":526},"tongjian_id":"adfb6cea-db0e-11ef-b92b-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"靈丘","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"單于府","place_name_jianti_auto":"单于府","start_index":3,"tongjian_id":"b15c8f8b-db0e-11ef-9187-a0d3651f611f"},{"place_name":"金河縣","place_name_jianti_auto":"金河县","start_index":7,"tongjian_id":"b15c8f8c-db0e-11ef-921f-a0d3651f611f"},{"place_name":"金川","place_name_jianti_auto":"金川","start_index":13,"tongjian_id":"b15c8f8d-db0e-11ef-9c3f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐志：單于府帶金河縣。其卽金川歟。帥，讀曰率。","note_content_jianti_auto":"唐志：单于府带金河县。其即金川欤。帅，读曰率。","note_type":"hu_note","start_index":26,"tongjian_id":"b15c8f8a-db0e-11ef-88fb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"靈丘","place_name_jianti_auto":"灵丘","place_note":"山西省灵丘县","resolved_place_entity_id":3479,"start_index":38,"tongjian_id":"b15c8f95-db0e-11ef-b2b1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"隋大业三年，北巡，发榆林，历云中，溯金河，幸突厥启民牙帐...","context_before":"...。杜佑曰：金河上承紫河之水，南流入大河，是也。亦曰金川，","source_end_index":56,"source_paragraph_tongjian_id":"c92c0fff-0a6c-55d0-8696-a09cedb02254","source_start_index":35,"source_text":"北齐主洋天保五年，邀柔然于金川，柔然远遁。"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"22柔然帥餘衆東徙，且欲南寇，齊主帥輕騎邀之於金川。柔然聞之，遠遁，營州刺史靈丘王峻設伏擊之，獲其名王數十人。","content_fanyi":"柔然首领率领残余部众向东迁徙，并想寻找机会向南侵犯。北齐国主高洋率领轻骑在金川截击他们。柔然人听到消息后远远逃遁，营州刺史灵丘人王峻设下埋伏袭击柔然，俘获柔然名王数十人。","content_jianti_auto":"22柔然帅余众东徙，且欲南寇，齐主帅轻骑邀之于金川。柔然闻之，远遁，营州刺史灵丘王峻设伏击之，获其名王数十人。","dtjl_paragraph_links":[],"dtjl_references":[],"id":15573,"number":22,"path":"资治通鉴 : 卷第一百六十五 (梁紀二十一) / 世祖孝元皇帝下 / 三年 / 第 22 段","reading_annotation_sources":[],"start_index":21,"tongjian_id":"b15c8f89-db0e-11ef-86e6-a0d3651f611f","year_int":554},"tongjian_id":"b15c8f89-db0e-11ef-86e6-a0d3651f611f"},"paragraph_order":4}],"page_size":10,"total_pages":1,"total_paragraphs":4},"place_name":"靈丘","resolved_profile":{"entity_id":3479,"entry_list_str":"靈丘","intro":"战国至南北朝时期的重要城邑，汉代属代郡，唐代属蔚州，位于今山西省大同市灵丘县。","lat_max":39.7,"lat_min":39.2,"lon_max":114.5,"lon_min":113.9,"modern_location":"今山西省大同市灵丘县","show_map":true,"standard_name":"灵丘","type_code":"settlement"}},"message":"success","success":true}