,"start_index":0,"tongjian_id":"9c8a44b8-db0e-11ef-804c-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":57,"tongjian_id":"9c8a44b7-db0e-11ef-a8e0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":259,"link_death_year":307,"link_td_description":"晋惠帝司马衷，字正度，晋武帝司马炎和武元皇后杨艳所生的嫡次子，西晋皇帝，290年至307年在位，其正式谥号为“孝惠皇帝”，后世省略“孝”字称“晋惠帝”，在他的统治期间发生八王之乱，西晋走向衰落。","link_td_id":"Q10000121","link_td_number_id":82821,"people_name":"衷","people_name_jianti_auto":"衷","people_xingming":"司马衷","start_index":11,"tongjian_id":"9c8a44ba-db0e-11ef-b994-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"1春，正月，丁卯，立子衷爲皇太子。詔以「近世每立太子必有赦。今世運將平，當示之以好惡，使百姓絕多幸之望。曲惠小人，朕無取焉！」遂不赦。","content_fanyi":"春季，正月，丁卯（疑误），晋武帝立其子司马衷为皇太子。随后下诏说：“近代每当册立太子，必定大赦天下。如今世事盛衰的变化将要走向清平，应当向百姓表明好恶，使百姓断绝侥幸的指望。曲意施予微小的恩惠，为朕所不取。”于是没有实行大赦。","content_jianti_auto":"1春，正月，丁卯，立子衷为皇太子。诏以「近世每立太子必有赦。今世运将平，当示之以好恶，使百姓绝多幸之望。曲惠小人，朕无取焉！」遂不赦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6709,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9c8a44a3-db0e-11ef-8a03-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩·鄭國風·羔裘之辭。","note_content_jianti_auto":"诗·郑国风·羔裘之辞。","note_type":"hu_note","start_index":112,"tongjian_id":"9c8a44bf-db0e-11ef-9417-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":11,"source_start_index":0,"source_text":"事見四十二卷建武十一年","target_paragraph_tongjian_id":"94651c9f-db0e-11ef-94d1-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見四十二卷建武十一年。","note_content_jianti_auto":"事见四十二卷建武十一年。","note_type":"hu_note","start_index":129,"tongjian_id":"9c8a44c1-db0e-11ef-b05d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"监察","official_name":"司隸校尉","official_note":"司隸校尉是漢代至魏晉時期的監察官，負責監察京師及周邊地區的官員，此處李憙擔任此職，彈劾其他官員的違法行為，顯示其監察職能。","official_rank":"未知","source_snippet":"司隸校尉上黨李憙劾故立進令劉友","start_index":0,"tongjian_id":"6ce4798d-23cd-4824-97a5-f084908260d8"},{"confidence":0.9,"official_category":"地方行政","official_name":"立進令","official_note":"立進令是地方縣令的官職，負責管理立進縣的行政事務，此處劉友曾任此職，但已被彈劾，顯示其涉及地方治理問題。","official_rank":"未知","source_snippet":"故立進令劉友","start_index":9,"tongjian_id":"efec9d69-aa4d-47ce-8236-6b131a1bc910"},{"confidence":0.92,"official_category":"中枢机构","official_name":"尚書","official_note":"尚書是魏晉時期中央行政機構的重要官員，掌管文書和政令，此處山濤曾任此職，但已被彈劾，顯示其可能涉及中央政務失誤。","official_rank":"未知","source_snippet":"前尚書山濤","start_index":15,"tongjian_id":"29202ffb-ccc9-47ca-9365-545ced48cd85"},{"confidence":0.88,"official_category":"封爵","official_name":"中山王","official_note":"中山王是封爵，表示睦被封為中山地區的王，此處睦被彈劾，顯示封爵官員也可能涉及違法行為。","official_rank":"王爵","source_snippet":"中山王睦","start_index":21,"tongjian_id":"6bb2c99e-4c1b-40d5-826e-0dee477bdd87"},{"confidence":0.93,"official_category":"中枢机构","official_name":"尚書僕射","official_note":"尚書僕射是尚書省的副長官，協助尚書處理政務，此處武陔曾任此職，但已去世，顯示其職位在彈劾中仍被提及。","official_rank":"未知","source_snippet":"尚書僕射武陔","start_index":25,"tongjian_id":"75791edd-8a32-470e-a157-107bab704a29"}],"ExtRef_Children_people":[{"link_td_description":"李憙，字季和，上党郡铜鞮县（今山西省沁县南）人。","link_td_id":"Q10016570","link_td_number_id":3950309,"people_name":"李憙","people_name_jianti_auto":"李憙","people_xingming":"李憙","start_index":7,"tongjian_id":"9c8a44c3-db0e-11ef-aa89-a0d3651f611f"},{"people_name":"劉友","people_name_ji