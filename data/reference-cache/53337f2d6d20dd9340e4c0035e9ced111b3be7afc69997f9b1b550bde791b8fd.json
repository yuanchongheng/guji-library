h_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"9c8a450b-db0e-11ef-8298-a0d3651f611f"},{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":16,"tongjian_id":"9c8a450c-db0e-11ef-97fb-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":26,"tongjian_id":"9c8a450d-db0e-11ef-b2a7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":4,"tongjian_id":"9c8a450e-db0e-11ef-8b4e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：齊人名小甕曰甔，受二斛。晉灼曰：石，斗石也。師古曰：甔，音都濫翻。","note_content_jianti_auto":"应劭曰：齐人名小瓮曰甔，受二斛。晋灼曰：石，斗石也。师古曰：甔，音都滥翻。","note_type":"hu_note","start_index":321,"tongjian_id":"9c8a450a-db0e-11ef-9428-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"中書丞","official_note":"中書丞是中書省的官員，負責文書處理和詔令起草，在晉代及三國時期屬於中央行政機構。在上下文中，華覈以中書丞身份上疏勸諫吳主，反映了其作為諫官或文職官員的角色。","official_rank":"未知","source_snippet":"中書丞華覈上疏曰","start_index":78,"tongjian_id":"98a13545-c880-4bba-a11c-52bdbf1543fa"}],"ExtRef_Children_people":[{"link_birth_year":198,"link_death_year":269,"link_td_description":"陆凯，字敬风，吴郡吴县（今江苏省苏州市）人，陆逊族子。三国时孙吴后期重臣，官至左丞相。","link_td_id":"Q10005796","link_td_number_id":1069290,"people_name":"陸凱","people_name_jianti_auto":"陆凯","people_xingming":"陆凯","start_index":53,"tongjian_id":"9c8be661-db0e-11ef-8d57-a0d3651f611f"},{"link_birth_year":219,"link_death_year":278,"link_td_description":"华覈，字永先，吴郡武进人。三国时孙吴史官，与韦昭、薛莹等人合力编撰《吴书》五十五卷。","link_td_id":"Q10007105","link_td_number_id":799708,"people_name":"華覈","people_name_jianti_auto":"华核","people_xingming":"华覈","start_index":63,"tongjian_id":"9c8be662-db0e-11ef-9cdd-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是