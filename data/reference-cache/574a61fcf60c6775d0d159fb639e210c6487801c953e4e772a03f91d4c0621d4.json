2d488d61f8"}],"ExtRef_Children_people":[{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"杜欽","people_name_jianti_auto":"杜钦","people_xingming":"杜钦","start_index":39,"tongjian_id":"91c07ca1-db0e-11ef-978b-a0d3651f611f"},{"link_death_year":-8,"link_td_description":"谷永，西汉大臣，字子云，原名并，长安人。","link_td_id":"Q10013197","link_td_number_id":1572704,"people_name":"谷永","people_name_jianti_auto":"谷永","people_xingming":"谷永","start_index":45,"tongjian_id":"91c07ca2-db0e-11ef-a981-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"未央宮","place_name_jianti_auto":"未央宫","resolved_place_entity_id":782,"start_index":19,"tongjian_id":"91c07ca3-db0e-11ef-99b7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5十二月，戊申朔，日有食之。其夜，地震未央宮殿中。詔舉賢良方正能直言極諫之士。杜欽及太常丞谷永上對，皆以爲後宮女寵太盛，嫉妬專上，將害繼嗣之咎。","content_fanyi":"十二月初一日戊申，发生日食。当天夜里，未央宫宫殿中发生地震。汉成帝下诏，要求举荐贤良方正、能直言极谏的士人。杜钦和太常丞谷永上奏，都认为后宫美女过于受宠，互相嫉妒，又想专揽皇上，将会造成危害继嗣的祸患。","content_jianti_auto":"5十二月，戊申朔，日有食之。其夜，地震未央宫殿中。诏举贤良方正能直言极谏之士。杜钦及太常丞谷永上对，皆以为后宫女宠太盛，嫉妬专上，将害继嗣之咎。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2353,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"91c07c9a-db0e-11ef-9070-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"91c0a19c-db0e-11ef-b756-a0d3651f611f","pinyin":"suǐ","source_anchor_text":"嗣之咎越巂山崩丁丑","source_key":"baiyang_epub","start_index":2,"text":"巂","tongjian_id":"f0e45ffd-b168-59e0-b57f-ff3811bb5328"}],"ExtRef_Children_places":[{"place_name":"越巂","place_name_jianti_aut