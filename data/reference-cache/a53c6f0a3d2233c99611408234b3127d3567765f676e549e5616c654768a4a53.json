ndex":4,"tongjian_id":"96d36a40-db0e-11ef-a912-a0d3651f611f"},{"place_name":"脩武","place_name_jianti_auto":"修武","resolved_place_entity_id":2507,"start_index":40,"tongjian_id":"96d36a43-db0e-11ef-8b5b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"冀遣書詣樂安太守陳蕃，有所請託，不得通。使者詐稱他客求謁蕃；蕃怒，笞殺之。坐左轉脩武令。","content_fanyi":"梁冀写信给乐安郡太守陈蕃，托他办事，但没有成功。梁冀派去的使者又冒称其他宾客求见陈蕃；陈蕃大怒，将使者笞打而死。他因此获罪，被降职为修武县令。","content_jianti_auto":"冀遣书诣乐安太守陈蕃，有所请托，不得通。使者诈称他客求谒蕃；蕃怒，笞杀之。坐左转修武令。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4520,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"96d36a34-db0e-11ef-8583-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"吳普","people_name_jianti_auto":"吴普","start_index":0,"tongjian_id":"96d36a47-db0e-11ef-8aa7-a0d3651f611f"},{"people_name":"陶弘景","people_name_jianti_auto":"陶弘景","start_index":53,"tongjian_id":"96d36a48-db0e-11ef-b5ba-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"吳普本草曰：牛黃，牛出入呻者有之。夜有光，走角中；牛死，入膽中，如雞子黃。神農本草曰：療驚癇，除邪、逐鬼。陶弘景曰：舊云神牛出入鳴吼者有之，伺其出角上，以盆水盛而吐之，卽墮落水中；今人多就膽中得之。藥中之貴，莫復過此。本草圖經曰：伺其吐出，乃喝迫，卽落水中。旣得之，陰乾百日。一云：子如雞子黃，其重疊可揭，輕虛而氛香爲佳。又云：此有四種：喝迫而得者名生黃；其殺死而在角中得者名角中黃；心中剝得者名心黃，肝膽中得之者名肝黃：大抵不及喝迫得者最勝。","note_content_jianti_auto":"吴普本草曰：牛黄，牛出入呻者有之。夜有光，走角中；牛死，入胆中，如鸡子黄。神农本草曰：疗惊痫，除邪、逐鬼。陶弘景曰：旧云神牛出入鸣吼者有之，伺其出角上，以盆水盛而吐之，即堕落水中；今人多就胆中得之。药中之贵，莫复过此。本草图经曰：伺其吐出，乃喝迫，即落水中。既得之，阴干百日。一云：子如鸡子黄，其重叠可揭，轻虚而氛香为佳。又云：此有四种：喝迫而得者名生黄；其杀死而在角中得者名角中黄；心中剥得者名心黄，肝胆中得之者名肝黄：大抵不及喝迫得者最胜。","note_type":"hu_note","start_index":27,"tongjian_id":"96d36a46-db0e-11ef-9c4a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"京兆尹","official_note":"京兆尹是漢代京畿地區的行政長官，負責首都長安及其周邊事務，此處指延篤，他因處理梁冀派客事件而免官，顯示其職責包括司法和治安。","official_rank":"正三品或高級地方官","source_snippet":"京兆尹南陽延篤","start_index":32,"tongjian_id":"35f8ad0c-eb66-43f7-a140-f0ba05a4ecc2"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代高級軍事長官，常掌兵權，此處指梁冀，他在和平元年（150年）擔任大將軍，權傾朝野，文中提及他與皇子疾病相關，顯示其政治影響力。","official_rank":"正一品或高級武官","source_snippet":"大將軍椒房外家","start_index":48,"tongjian_id":"03f615df-7533-48b6-b509-a530e3d6628b"}],"ExtRef_Children_people":[{"link_birth_year":88,"link_death_year":159,"link_td_description":"梁冀，字伯卓，安定郡乌氏县（今宁夏固原）人，中国东汉时期外戚出身的权臣。妻孙寿。","link_td_id":"Q10007199","link_td_number_id":237020,"people_name":"冀","people_name_jianti_auto":"冀","people_xingming":"梁冀","start_index":14,"tongjian_id":"96d36a4c-db0e-11ef-986e-a0d3651f611f"},{"link_death_year":167,"link_td_description":"延笃，字叔坚，一字叔固，南阳犨（今河南鲁山东南）人。","link_td_id":"Q10013257","link_td_number_id":1580149,"people_name":"延篤","people_name_jianti_auto":"延笃","people_xingming":"延笃","start_index":32,"tongjian_id":"96d36a4e-db0e-11ef-8cef-a0d3651f611f"},{"link_birth_year":88,"link_death_year":159,"link_td_description":"梁冀，字伯卓，安定郡乌氏县（今宁夏固原）人，中国东汉时期外戚出身的权臣。妻孙寿。","link_td_id":"Q10007199","link_td_number_id":237020,"people_name":"冀","people_name_jianti_auto":"冀","people_xingming":"梁冀","start_index":78,"tongjian_id":"96d36a4f-db0e-11ef-990e-a0d3651f611f"},{"link_death_year":167,"link_td_description":"延笃，字叔坚，一字叔固，南阳犨（今河南鲁山东南）人。","link_td_id":"Q10013257","link_td_number_id":1580149,"people_name":"篤","people_name_jianti_auto":"笃","people_xingming":"延笃","start_index":93,"tongjian_id":"96d36a50-db0e-11ef-9320-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"96d36a44-db0e-11ef-abf2-a0d3651f611f","pinyin":"jī","source_anchor_text":"而冀遣客齎書诣京兆","source_key":"baiyang_epub","start_index":17,"text":"齎","tongjian_id":"d7c64314-1f50-5b89-b311-81bcc51fd875"}],"ExtRef_Children_places":[{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":19,"tongjian_id":"96d36a4d-db0e-11ef-98cd-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":27,"tongjian_id":"96d36a51-db0e-11ef-9a08-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","resolved_place_entity_id":235,"start_index":30,"tongjian_id":"96d36a52-db0e-11ef-984d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"時皇子有疾，下郡縣市珍藥；而冀遣客齎書京兆，幷貨牛黃，京兆尹南陽延篤發書收客，曰：「大將軍椒房外家，而皇子有疾，必應陳進醫方，豈當使客千里求利乎！」遂殺之。冀慙而不得言。有司承旨求其事，篤以病免。","content_fanyi":"这时皇子患病，朝廷下令各郡县采购珍贵药材；梁冀却派门客带着他的书信前往京兆，同时贩卖牛黄。京兆尹南阳人延笃打开书信后逮捕了那名门客，说：“大将军身为皇后外戚，皇子有病，理应进献医方，怎么能让门客远赴千里谋取私利呢！”于是将门客处死。梁冀感到羞惭却无法开口。有关官员秉承梁冀的意旨追究此事，延笃便因病被免职。","content_jianti_auto":"时皇子有疾，下郡县市珍药；而冀遣客赍书京兆，幷货牛黄，京兆尹南阳延笃发书收客，曰：「大将军椒房外家，而皇子有疾，必应陈进医方，岂当使客千里求利乎！」遂杀之。冀慙而不得言。有司承旨求其事，笃以病免。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4521,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"96d36a44-db0e-11ef-abf2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"德陽前殿","place_name_jianti_auto":"德阳前殿","start_index":5,"tongjian_id":"96d36a55-db0e-11ef-91df-a0d3651f611f"},{"place_name":"永樂宮","place_name_jianti_auto":"永乐宫","start_index":17,"tongjian_id":"96d36a56-db0e-11ef-b109-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"續漢志曰：德陽前殿西北，入門內，有永樂宮。樂，音洛；下長樂同。","note_content_jianti_auto":"续汉志曰：德阳前殿西北，入门内，有永乐宫。乐，音洛；下长乐同。","note_type":"hu_note","start_index":25,"tongjian_id":"96d36a54-db0e-11ef-a985-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"太僕","official_note":"太僕是汉代九卿之一，掌管皇帝车马及全国马政，此处设置太僕是为了仿照长乐宫制度，为孝崇后建立类似宫廷机构。","official_rank":"九卿之一","source_snippet":"置太僕、少府以下","start_index":23,"tongjian_id":"85b46171-9356-4ac6-9eb3-7fbdfac33f33"},{"confidence":0.9,"official_category":"中枢机构","official_name":"少府","official_note":"少府是汉代九卿之一，负责皇室财政和宫廷事务，此处设置少府是为了仿照长乐宫制度，为孝崇后建立类似宫廷机构。","official_rank":"九卿之一","source_snippet":"置太僕、少府以下","start_index":26,"tongjian_id":"796e03f1-8eee-4897-bfef-aa4a808583ed"}],"ExtRef_Children_people":[{"link_death_year":152,"link_td_description":"匽明，是东汉蠡吾侯刘翼的媵妾，生汉桓帝刘志。","link_td_id":"Q10011581","link_td_number_id":1280606,"people_name":"博園匽貴人","people_name_jianti_auto":"博园匽贵人","people_xingming":"匽明","start_index":10,"tongjian_id":"96d36a58-db0e-11ef-886b-a0d3651f611f","wl_zhushi":"[匽明]"},{"link_death_year":152,"link_td_description":"匽明，是东汉蠡吾侯刘翼的媵妾，生汉桓帝刘志。","link_td_id":"Q10011581","link_td_number_id":1280606,"people_name":"孝崇后","people_name_jianti_auto":"孝崇后","people_xingming":"匽明","start_index":16,"tongjian_id":"96d36a59-db0e-11ef-8677-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"永樂","place_name_jianti_auto":"永乐","resolved_place_entity_id":2308,"start_index":22,"tongjian_id":"96d36a5a-db0e-11ef-a9e9-a0d3651f611f"},{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","resolved_place_entity_id":797,"start_index":36,"tongjian_id":"96d36a5b-db0e-11ef-915a-a0d3651f611f"},{"place_name":"鉅鹿","place_name_jianti_auto":"巨鹿","resolved_place_entity_id":757,"start_index":43,"tongjian_id":"96d36a5c-db0e-11ef-8e5c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5夏，五月，庚辰，尊博園匽貴人曰孝崇后，宮曰永樂；置太僕、少府以下，皆如長樂宮故事。分鉅鹿九縣爲后湯沐邑。","content_fanyi":"夏季五月庚辰日，桓帝尊奉其母博园匽贵人为孝崇后，将她居住的宫室称为永乐宫；设置太仆、少府以下官员，全部依照西汉长乐宫的旧例。又分割钜鹿郡九个县作为孝崇后的汤沐邑，用当地赋税供她私人奉养。","content_jianti_auto":"5夏，五月，庚辰，尊博园匽贵人曰孝崇后，宫曰永乐；置太仆、少府以下，皆如长乐宫故事。分巨鹿九县为后汤沐邑。","dtjl_paragraph_links"