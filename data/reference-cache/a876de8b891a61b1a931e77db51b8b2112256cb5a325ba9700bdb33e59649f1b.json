tart_index":110,"tongjian_id":"b7a1b065-db0e-11ef-9fb8-a0d3651f611f"},{"place_name":"隆城","place_name_jianti_auto":"隆城","start_index":138,"tongjian_id":"b7a1b066-db0e-11ef-9bc9-a0d3651f611f"},{"place_name":"隆州","place_name_jianti_auto":"隆州","start_index":145,"tongjian_id":"b7a1b067-db0e-11ef-8e94-a0d3651f611f"},{"place_name":"晉城縣","place_name_jianti_auto":"晋城县","start_index":148,"tongjian_id":"b7a1b068-db0e-11ef-bc6c-a0d3651f611f"},{"place_name":"閬中","place_name_jianti_auto":"阆中","start_index":152,"tongjian_id":"b7a1b069-db0e-11ef-b18f-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":156,"tongjian_id":"b7a1b06a-db0e-11ef-9aa4-a0d3651f611f"},{"place_name":"木蘭郡","place_name_jianti_auto":"木兰郡","start_index":158,"tongjian_id":"b7a1b06b-db0e-11ef-b698-a0d3651f611f"},{"place_name":"西魏","place_name_jianti_auto":"西魏","start_index":162,"tongjian_id":"b7a1b06c-db0e-11ef-bec0-a0d3651f611f"},{"place_name":"西充國","place_name_jianti_auto":"西充国","start_index":168,"tongjian_id":"b7a1b06d-db0e-11ef-a9ab-a0d3651f611f"},{"place_name":"晉城","place_name_jianti_auto":"晋城","start_index":172,"tongjian_id":"b7a1b06e-db0e-11ef-801d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"洋州，洋川郡，治西鄕縣。西鄕，漢成固縣，蜀立西鄕縣，後魏於此置洋州，以水爲名。洋，音祥。集州，符陽郡，武德元年，析梁州之難江、巴州之符陽·長池·白石置。隆州，巴西郡，漢閬中地。劉昫曰：西魏置隆州於閬中，隋爲巴西郡，唐復爲隆州。宋白曰：取其連岡地勢高隆爲名。後魏典略云：此州古有隆城堅險，因置隆州。晉城縣亦閬中地，梁置木蘭郡，西魏廢郡，改西充國曰晉城。獠，魯皓翻。","note_content_jianti_auto":"洋州，洋川郡，治西鄕县。西鄕，汉成固县，蜀立西鄕县，后魏于此置洋州，以水为名。洋，音祥。集州，符阳郡，武德元年，析梁州之难江、巴州之符阳·长池·白石置。隆州，巴西郡，汉阆中地。刘昫曰：西魏置隆州于阆中，隋为巴西郡，唐复为隆州。宋白曰：取其连冈地势高隆为名。后魏典略云：此州古有隆城坚险，因置隆州。晋城县亦阆中地，梁置木兰郡，西魏废郡，改西充国曰晋城。獠，鲁皓翻。","note_type":"hu_note","start_index":19,"tongjian_id":"b7a196c2-db0e-11ef-ac35-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"晉城","place_name_jianti_auto":"晋城","place_note":"四川省南部县西","resolved_place_entity_id":4713,"start_index":16,"tongjian_id":"b7a1b074-db0e-11ef-a5f3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"13戊辰，洋、集二州獠反，陷隆州晉城。","content_fanyi":"二月二十八日戊辰，洋州、集州的僚人起兵反叛，攻破隆州晋城。","content_jianti_auto":"13戊辰，洋、集二州獠反，陷隆州晋城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18467,"number":13,"path":"资治通鉴 : 卷第一百九十 (唐紀六) / 高祖神堯大聖光孝皇帝中之下 / 七年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"b7a196c1-db0e-11ef-ba3c-a0d3651f611f","year_int":624},"tongjian_id":"b7a196c1-db0e-11ef-ba3c-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"晉城"},"message":"success","success":true}