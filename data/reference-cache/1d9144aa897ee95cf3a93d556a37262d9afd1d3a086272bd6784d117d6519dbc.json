yin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c5c61c6-db0e-11ef-afb4-a0d3651f611f","pinyin":"sōu","source_anchor_text":"級虜其將䱸申差于濁","source_key":"baiyang_epub","start_index":18,"text":"䱸","tongjian_id":"4292cb97-4f25-5386-8a75-39ba6aa1f15e"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"晋永康二年，赵王伦篡位，王盛等聚众于浊泽，谋讨伦，为伦将...","context_before":"...侯。又齐威王败魏于浊泽，围魏，魏请献观以和。《韩世家》：","source_end_index":117,"source_paragraph_tongjian_id":"5e9ac492-dda2-57cd-bba3-59b5a33204fb","source_start_index":95,"source_text":"宣惠王十六年，秦败我修鱼，虏将昚申差于浊泽。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦敗韓師于脩魚，斬首八萬級，虜其將䱸、申差于濁澤。諸侯振恐。","content_fanyi":"秦军在修鱼击败韩军，斩首八万人，并在浊泽俘虏了韩军将领䱸和申差。各国诸侯都因此震动恐惧。","content_jianti_auto":"1秦败韩师于修鱼，斩首八万级，虏其将𫠑、申差于浊泽。诸侯振恐。","dtjl_paragraph_links":[],"dtjl_references":[],"id":229,"number":1,"path":"资治通鉴 : 卷第三 (周紀三) / 愼靚王 / 四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c5c61c6-db0e-11ef-afb4-a0d3651f611f","year_int":-317},"tongjian_id":"8c5c61c6-db0e-11ef-afb4-a0d3651f611f"},"paragraph_order":1}],"page_size":7,"total_pages":1,"total_paragraphs":1},"profile":{"alias_list":[],"biography":"申差，战国时期韩国的军事人物，在韩宣惠王属下。","link_td_id":"Q10023156","name":"申差","number_id":8173889},"relationships":[{"direction":"forward","rank":"normal","relation_detail":"君臣关系（君主与属下），来源文本：申差（?－?），战国时期韩国的军事人物，在韩宣惠王属下。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10023156","source_person_name":"申差","source_person_number_id":8173889,"statement_id":"S-Q10023156-P100061-Q10000620","target_person_id":"Q10000620","target_person_name":"韩宣惠王","target_person_number_id":334590},{"direction":"forward","rank":"normal","relation_detail":"敌对军事关系（被俘虏），来源文本：派遣庶长樗里疾率秦军出函谷关反击韩赵魏联军，于修鱼大败赵、韩联军...俘虏韩将䱸（一作鲠）、申差","relation_property_id":"P100061","relati