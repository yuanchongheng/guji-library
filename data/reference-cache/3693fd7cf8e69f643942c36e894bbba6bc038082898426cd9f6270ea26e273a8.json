e-11ef-82fd-a0d3651f611f"},{"place_name":"赤狄","place_name_jianti_auto":"赤狄","start_index":53,"tongjian_id":"c0db3bb6-db0e-11ef-8450-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","place_note":"陕西省南部","start_index":58,"tongjian_id":"c0db3bb7-db0e-11ef-adf7-a0d3651f611f"},{"place_name":"北屈縣","place_name_jianti_auto":"北屈县","start_index":60,"tongjian_id":"c0db3bb8-db0e-11ef-b912-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":64,"tongjian_id":"c0db3bb9-db0e-11ef-bd7c-a0d3651f611f"},{"place_name":"汾州","place_name_jianti_auto":"汾州","start_index":66,"tongjian_id":"c0db3bba-db0e-11ef-9109-a0d3651f611f"},{"place_name":"文城郡","place_name_jianti_auto":"文城郡","start_index":72,"tongjian_id":"c0db3bbb-db0e-11ef-94ab-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"伊祁放勋","start_index":76,"tongjian_id":"c0db3bbc-db0e-11ef-bdec-a0d3651f611f"},{"place_name":"慈州","place_name_jianti_auto":"慈州","start_index":80,"tongjian_id":"c0db3bbd-db0e-11ef-89b2-a0d3651f611f"},{"place_name":"慈烏戍","place_name_jianti_auto":"慈乌戍","start_index":89,"tongjian_id":"c0db3bbe-db0e-11ef-947d-a0d3651f611f"},{"place_name":"吉鄕縣","place_name_jianti_auto":"吉鄕县","start_index":97,"tongjian_id":"c0db3bbf-db0e-11ef-b0de-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","place_note":"陕西省南部","start_index":101,"tongjian_id":"c0db3bc0-db0e-11ef-82fd-a0d3651f611f"},{"place_name":"北屈縣","place_name_jianti_auto":"北屈县","start_index":102,"tongjian_id":"c0db3bc1-db0e-11ef-b719-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉、隰、慈三州，皆與馬燧巡屬接壤，故得說下之。宋白曰：慈州文城郡，赤狄廧咎如之國，郡西南有采桑津，晉里克敗赤狄之地。漢爲北屈縣，隋爲汾州，大業爲文城郡；唐貞觀爲慈州；以州城內舊有慈烏戍，因名；治吉鄕縣，漢北屈縣也。說，式芮翻。","note_content_jianti_auto":"晋、隰、慈三州，皆与马燧巡属接壤，故得说下之。宋白曰：慈州文城郡，赤狄𪪞咎如之国，郡西南有采桑津，晋里克败赤狄之地。汉为北屈县，隋为汾州，大业为文城郡；唐贞观为慈州；以州城内旧有慈乌戍，因名；治吉鄕县，汉北屈县也。说，式芮翻。","note_type":"hu_note","start_index":113,"tongjian_id":"c0db3ba9-db0e-11ef-b259-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":49,"source_start_index":41,"source_text":"事見二百二十九卷","target_paragraph_tongjian_id":"c09ab26b-db0e-11ef-83a1-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"康日知","people_name_jianti_auto":"康日知","start_index":37,"tongjian_id":"c0db3bc3-db0e-11ef-8164-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"奉誠軍","place_name_jianti_auto":"奉诚军","start_index":28,"tongjian_id":"c0db3bc4-db0e-11ef-90b3-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","start_index":32,"tongjian_id":"c0db3bc5-db0e-11ef-a694-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"渾，戶混翻，又戶本翻。瑊，古咸翻。華，戶化翻。是年正月置奉誠軍於同州，以授康日知，事見二百二十九卷。帥，所類翻。陝，失冉翻。使，疏吏翻。","note_content_jianti_auto":"浑，户混翻，又户本翻。瑊，古咸翻。华，户化翻。是年正月置奉诚军于同州，以授康日知，事见二百二十九卷。帅，所类翻。陕，失冉翻。使，疏吏翻。","note_type":"hu_note","start_index":169,"tongjian_id":"c0db3bc2-db0e-11ef-8e00-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"肅宗","people_name_jianti_auto":"肃宗","start_index":0,"tongjian_id":"c0db3bc7-db0e-11ef-93b8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鎭國","place_name_jianti_auto":"镇国","start_index":8,"tongjian_id":"c0db3bc8-db0e-11ef-98b9-a0d3651f611f"},{"place_name":"華州","place_name_jianti_auto":"华州","start_index":13,"tongjian_id":"c0db3bc9-db0e-11ef-8f92-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"肅宗上元二年，置鎭國節度於華州，廣德元年罷，今復置。","note_content_jianti_auto":"肃宗上元二年，置镇国节度于华州，广德元年罢，今复置。","note_type":"hu_note","start_index":179,"tongjian_id":"c0db3bc6-db0e-11ef-a990-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c0db3b99-db0e-11ef-a975-a0d3651f611f","pinyin":"yáng","source_anchor_text":"牙將毛朝敭守隰州鄭","source_key":"baiyang_epub","start_index":93,"text":"敭","tongjian_id":"365fdf61-30e3-52ac-93e0-b22f7847bc88"}],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西隰县","resolved_place_entity_id":1526,"start_index":95,"tongjian_id":"c0dd7220-db0e-11ef-b50c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"宋李永奇曰：同州入南山，乃金人往来驿路。盖关中襟要，莫如...","context_before":"...郭子仪自洛交引兵趣河东，分兵先取冯翊，河东遂翻城迎官军。","source_end_index":302,"source_paragraph_tongjian_id":"2676776a-9d7b-507a-a89b-617b75c0dee1","source_start_index":258,"source_text":"兴元初，李怀光以河中叛。官军扼其同州，怀光遂不振。李晟曰：河中去长安三百里，同州当其冲。"},{"context_after":"贞元初，马燧、浑瑊破怀光兵于宫南，遂掘堑围宫城。庭光犹复...","context_before":"...收入长春宫。二十九年，敕新丰、朝邑屯田，令长春宫使检校。","source_end_index":246,"source_paragraph_tongjian_id":"d947e1a4-d41d-5ec8-937f-68205b00310e","source_start_index":215,"source_text":"兴元初，李怀光将徐庭光军于长春宫。浑瑊等自同州进攻，数为所败。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"26先是，上命渾瑊、駱元光討李懷光軍于同州，懷光遣其將徐庭光以精卒六千軍于長春宮以拒之，瑊等數爲所敗，不能進。時度支用度不給，議者多請赦懷光，上不許。李懷光遣其妹壻要廷珍守晉州，牙將毛朝敭守隰州，鄭抗守慈州，馬燧皆遣人說下之。上乃加渾瑊河中、絳州節度使，充河中、同華、陝虢行營副元帥，加馬燧奉誠軍、晉·慈·隰節度使，充管內諸軍行營副元帥，與鎭國節度使駱元光、鄜坊節度使唐朝臣合兵討懷光。","content_fanyi":"先前，德宗命令浑瑊、骆元光讨伐同州的李怀光军，李怀光派其部将徐庭光率领精兵六千人驻扎在长春宫抵御浑瑊、骆元光等，浑瑊、骆元光等多次被徐庭光击败，无法前进一步。当时度支开支浩大、供给不足，朝中议论此事的人大多请求赦免李怀光，德宗没有答应。李怀光派遣他的妹夫要廷珍防守晋州，牙将毛朝敭防守隰州，郑抗防守慈州，马燧都派人前去劝说，使他们全都归顺了马燧。德宗于是加封浑瑊为河中、绛州节度使，充任河中、同华、陕虢行营副元帅，加封马燧为奉诚军及晋、慈、隰节度使，充任所辖区域内诸军行营副元帅，让他们与镇国军节度使骆元光、鄜坊镇节度使唐朝臣合兵讨伐李怀光。","content_jianti_auto":"26先是，上命浑瑊、骆元光讨李怀光军于同州，怀光遣其将徐庭光以精卒六千军于长春宫以拒之，瑊等数为所败，不能进。时度支用度不给，议者多请赦怀光，上不许。李怀光遣其妹壻要廷珍守晋州，牙将毛朝敭守隰州，郑抗守慈州，马燧皆遣人说下之。上乃加浑瑊河中、绛州节度使，充河中、同华、陕虢行营副元帅，加马燧奉诚军、晋·慈·隰节度使，充管内诸军行营副元帅，与镇国节度使骆元光、鄜坊节度使唐朝臣合兵讨怀光。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23315,"number":26,"path":"资治通鉴 : 卷第二百三十一 (唐紀四十七) / 德宗神武聖文皇帝六 / 興元元年 / 第 43 段","reading_annotation_sources":[],"start_index":42,"tongjian_id":"c0db3b99-db0e-11ef-a975-a0d3651f611f","year_int":784},"tongjian_id":"c0db3b99-db0e-11ef-a975-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c8ed94af-db0e-11ef-8f9c-a0d3651f611f","pinyin":"guī","source_anchor_text":"州刺史張瓌降之閏月","source_key":"baiyang_epub","start_index":41,"text":"瓌","tongjian_id":"e901da48-037a-5259-8143-542dc67a0be7"}],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","resolved_place_entity_id":1526,"start_index":23,"tongjian_id":"c8ed94b6-db0e-11ef-937d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"梁开平三年，晋将周德威等复出阴地关攻晋州。又贞明二年，梁...","context_before":"...克用，会诸道兵于晋州，出阴地关，游骑至汾州，为河东所败。","source_end_index":119,"source_paragraph_tongjian_id":"2fb74df0-d530-525c-8078-807bd09bbd49","source_start_index":62,"source_text":"光化五年，朱全忠攻太原，遣其将侯言以慈、隰、晋、绛兵入自阴地，取汾州。既而克用遣将李嗣昭等出阴地关，取隰、慈等州。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"20李克用遣其將李嗣昭、周德威將兵出陰地關，攻隰州，刺史唐禮降之；進攻慈州，刺史張瓌降之。","content_fanyi":"李克用派遣部将李嗣昭、周德威率兵出阴地关，攻打隰州，刺史唐礼投降；接着进攻慈州，刺史张瓌也投降了。","content_jianti_auto":"20李克用遣其将李嗣昭、周德威将兵出阴地关，攻隰州，刺史唐礼降之；进攻慈州，刺史张瓌降之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27118,"number":20,"path":"资治通鉴 : 卷第二百六十二 (唐紀七十八) / 昭宗聖穆景文孝皇帝中之中 / 天復元年 / 第 30 段","reading_annotation_sources":[],"start_index":29,"tongjian_id":"c8ed94af-db0e-11ef-8f9c-a0d3651f611f","year_int":901},"tongjian_id":"c8ed94af-db0e-11ef-8f9c-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"胡敬璋","people_name_jianti_auto":"胡敬璋","start_index":29,"tongjian_id":"c9e9e63d-db0e-11ef-8954-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","start_index":6,"tongjian_id":"c9e9e63e-db0e-11ef-a331-a0d3651f611f"},{"place_name":"石樓縣","place_name_jianti_auto":"石楼县","start_index":8,"tongjian_id":"c9e9e63f-db0e-11ef-84a2-a0d3651f611f"},{"place_name":"上平關","place_name_jianti_auto":"上平关","start_index":12,"tongjian_id":"c9e9e640-db0e-11ef-852f-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","start_index":17,"tongjian_id":"c9e9e641-db0e-11ef-b535-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":21,"tongjian_id":"c9e9e642-db0e-11ef-a9d5-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":34,"tongjian_id":"c9e9e643-db0e-11ef-b7cd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"金人疆域圖：隰州石樓縣有上平關。按延州東至隰州百三十里耳，胡敬璋蓋渡河來寇也。","note_content_jianti_auto":"金人疆域图：隰州石楼县有上平关。按延州东至隰州百三十里耳，胡敬璋盖渡河来寇也。","note_type":"hu_note","start_index":70,"tongjian_id":"c9e9e63c-db0e-11ef-93d2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉州","place_name_jianti_auto":"晋州","place_note":"山西省临汾市","start_index":4,"tongjian_id":"c9e9e646-db0e-11ef-8277-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":9,"tongjian_id":"c9e9e647-db0e-11ef-bec1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志，晉州西北至隰州二百五十五里。","note_content_jianti_auto":"九域志，晋州西北至隰州二百五十五里。","note_type":"hu_note","start_index":94,"tongjian_id":"c9e9e645-db0e-11ef-bfc6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","resolved_place_entity_id":1526,"start_index":91,"tongjian_id":"c9e9e657-db0e-11ef-941b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"向有巡司戍守]。","context_before":"○上平关[县西北九十里，下临黄河，路出陕西绥德州。","source_end_index":60,"source_paragraph_tongjian_id":"101ccb87-41b1-5d67-8086-8b833d7120bd","source_start_index":25,"source_text":"五代梁开平二年，李茂贞遣延州帅胡敬璋攻上平关，为梁将刘知俊所败，即此。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3晉周德威、李嗣昭將兵三萬出陰地關，攻晉州，刺史徐懷玉拒守；帝自將救之，丁丑，發大梁，乙酉，至陝州。戊子，岐王所署延州節度使胡敬璋寇上平關，劉知俊擊破之。周德威等聞帝將至，乙未，退保隰州。","content_fanyi":"晋国的周德威、李嗣昭率领三万军队从阴地关出击，攻打晋州，晋州刺史徐怀玉坚守抵抗；皇帝亲自带兵救援晋州，丁丑日从大梁出发，乙酉日到达陕州。戊子日，岐王所任命的延州节度使胡敬璋进犯上平关，刘知俊将其击败。周德威等人听说皇帝即将到来，乙未日，退兵据守隰州。","content_jianti_auto":"3晋周德威、李嗣昭将兵三万出阴地关，攻晋州，刺史徐怀玉拒守；帝自将救之，丁丑，发大梁，乙酉，至陕州。戊子，岐王所署延州节度使胡敬璋寇上平关，刘知俊击破之。周德威等闻帝将至，乙未，退保隰州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27609,"number":3,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 開平二年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"c9e9e63a-db0e-11ef-8219-a0d3651f611f","year_int":908},"tongjian_id":"c9e9e63a-db0e-11ef-8219-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"永和縣","place_name_jianti_auto":"永和县","start_index":0,"tongjian_id":"ca4432e7-db0e-11ef-9870-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":4,"tongjian_id":"ca4432e8-db0e-11ef-bca7-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":7,"tongjian_id":"ca4432e9-db0e-11ef-b4c2-a0d3651f611f"},{"place_name":"狐讘縣","place_name_jianti_auto":"狐讘县","start_index":8,"tongjian_id":"ca4432ea-db0e-11ef-8060-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":13,"tongjian_id":"ca4432eb-db0e-11ef-a67e-a0d3651f611f"},{"place_name":"永和縣","place_name_jianti_auto":"永和县","start_index":15,"tongjian_id":"ca4432ec-db0e-11ef-9a45-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"永和縣屬隰州，漢狐讘縣地，隋爲永和縣。九域志：在州西一百里。","note_content_jianti_auto":"永和县属隰州，汉狐讘县地，隋为永和县。九域志：在州西一百里。","note_type":"hu_note","start_index":36,"tongjian_id":"ca4432e6-db0e-11ef-ba39-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西隰县","resolved_place_entity_id":1526,"start_index":5,"tongjian_id":"ca4432f1-db0e-11ef-aa71-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"45是歲，隰州都將劉訓殺刺史，以州降晉，晉王以爲瀛州刺史。訓，永和人也。","content_fanyi":"当年，隰州都将刘训杀死刺史，献出隰州归降晋王李存勖，晋王委任他为瀛州刺史。刘训是永和人。","content_jianti_auto":"45是岁，隰州都将刘训杀刺史，以州降晋，晋王以为瀛州刺史。训，永和人也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27843,"number":45,"path":"资治通鉴 : 卷第二百六十八 (後梁紀三) / 太祖神武元聖孝皇帝下 / 二年 / 第 59 段","reading_annotation_sources":[],"start_index":58,"tongjian_id":"ca4432e5-db0e-11ef-a165-a0d3651f611f","year_int":912},"tongjian_id":"ca4432e5-db0e-11ef-a165-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"絳州","place_name_jianti_auto":"绛州","place_note":"山西省新绛县","start_index":5,"tongjian_id":"ca7bb785-db0e-11ef-b7a9-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":10,"tongjian_id":"ca7bb786-db0e-11ef-8c90-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","start_index":19,"tongjian_id":"ca7bb787-db0e-11ef-8019-a0d3651f611f"},{"place_name":"慈州","place_name_jianti_auto":"慈州","start_index":24,"tongjian_id":"ca7bb788-db0e-11ef-b2d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按九域志，絳州西北至隰州五百一十四里，隰州西南至慈州一百六十里。","note_content_jianti_auto":"按九域志，绛州西北至隰州五百一十四里，隰州西南至慈州一百六十里。","note_type":"hu_note","start_index":26,"tongjian_id":"ca7bb784-db0e-11ef-a3da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"歐","people_name_jianti_auto":"欧","start_index":1,"tongjian_id":"ca7bb78b-db0e-11ef-a74f-a0d3651f611f"},{"people_name":"李巖","people_name_jianti_auto":"李岩","start_index":47,"tongjian_id":"ca7bb78c-db0e-11ef-b9d6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"梁","place_name_jianti_auto":"梁","start_index":8,"tongjian_id":"ca7bb78d-db0e-11ef-84db-a0d3651f611f"},{"place_name":"昭義軍","place_name_jianti_auto":"昭义军","start_index":10,"tongjian_id":"ca7bb78e-db0e-11ef-91bb-a0d3651f611f"},{"place_name":"宣義","place_name_jianti_auto":"宣义","start_index":22,"tongjian_id":"ca7bb78f-db0e-11ef-9684-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":40,"tongjian_id":"ca7bb790-db0e-11ef-a20f-a0d3651f611f"},{"place_name":"澶州","place_name_jianti_auto":"澶州","start_index":43,"tongjian_id":"ca7bb791-db0e-11ef-b1ed-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按歐史·職方考，梁無昭義軍。參考賀瓌傳，蓋爲宣義留後也。「昭」當作「宣」。先是，晉襲取澶州，以李巖守之。","note_content_jianti_auto":"按欧史·职方考，梁无昭义军。参考贺瓌传，盖为宣义留后也。「昭」当作「宣」。先是，晋袭取澶州，以李岩守之。","note_type":"hu_note","start_index":50,"tongjian_id":"ca7bb78a-db0e-11ef-9ef0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","resolved_place_entity_id":1526,"start_index":11,"tongjian_id":"ca7bb798-db0e-11ef-a456-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10絳州刺史尹皓攻晉之隰州，八月，又攻慈州，皆不克。王檀與昭義留後賀瓌攻澶州，拔之，執李巖，送東都。帝以楊師厚故將楊延直爲澶州刺史，使將兵萬人助劉鄩，且招誘魏人。","content_fanyi":"绛州刺史尹皓进攻晋国的隰州，八月，又进攻慈州，都没能攻克。王檀与昭义留后贺瓌进攻澶州，攻克了澶州，俘获李岩，押送到东都。后梁末帝任命杨师厚的旧将杨延直为澶州刺史，让他率领一万士兵前去援助刘鄩，并招诱魏州人。","content_jianti_auto":"10绛州刺史尹皓攻晋之隰州，八月，又攻慈州，皆不克。王檀与昭义留后贺瓌攻澶州，拔之，执李岩，送东都。帝以杨师厚故将杨延直为澶州刺史，使将兵万人助刘𬩽，且招诱魏人。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27944,"number":10,"path":"资治通鉴 : 卷第二百六十九 (後梁紀四) / 均王上 / 貞明元年 / 第 24 段","reading_annotation_sources":[],"start_index":23,"tongjian_id":"ca7bb783-db0e-11ef-a0e6-a0d3651f611f","year_int":915},"tongjian_id":"ca7bb783-db0e-11ef-a0e6-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"侯益","people_name_jianti_auto":"侯益","start_index":1,"tongjian_id":"ce05f093-db0e-11ef-9b8e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"怨侯益之毀己於朝也。","note_content_jianti_auto":"怨侯益之毁己于朝也。","note_type":"hu_note","start_index":16,"tongjian_id":"ce05f092-db0e-11ef-917d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"凡擇乳母，必取新生子者，許之攜子，故得以易。","note_content_jianti_auto":"凡择乳母，必取新生子者，许之携子，故得以易。","note_type":"hu_note","start_index":67,"tongjian_id":"ce05f094-db0e-11ef-b4bb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","resolved_place_entity_id":1526,"start_index":41,"tongjian_id":"ce05f09e-db0e-11ef-b3fd-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"40王景崇盡殺侯益家屬七十餘人，益子前天平行軍司馬仁矩先在外，得免。庚申，以仁矩爲隰州刺史。仁矩子延廣，尚在襁褓，乳母劉氏以己子易之，抱延廣而逃，乞食至于大梁，歸于益家。","content_fanyi":"王景崇将侯益的家属七十余人全部杀掉，侯益的儿子、前任天平行军司马侯仁矩事前正在外面，得以免死。九月十五日庚申，后汉隐帝任命侯仁矩为隰州刺史。侯仁矩的儿子侯延广当时还是个襁褓中的婴儿，乳母刘氏用自己的儿子将他换下，抱着侯延广逃走，沿途乞讨到达大梁，回到侯益家中。","content_jianti_auto":"40王景崇尽杀侯益家属七十余人，益子前天平行军司马仁矩先在外，得免。庚申，以仁矩为隰州刺史。仁矩子延广，尚在襁褓，乳母刘氏以己子易之，抱延广而逃，乞食至于大梁，归于益家。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30214,"number":40,"path":"资治通鉴 : 卷第二百八十八 (後漢紀三) / 高祖睿文聖武昭肅孝皇帝下 / 乾祐元年 / 第 59 段","reading_annotation_sources":[],"start_index":58,"tongjian_id":"ce05f091-db0e-11ef-bd4e-a0d3651f611f","year_int":948},"tongjian_id":"ce05f091-db0e-11ef-bd4e-a0d3651f611f"},"paragraph_order":9},{"mention_count":2,"paragraph_brief":{"brief_for":"隰州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉州","place_name_jianti_auto":"晋州","start_index":4,"tongjian_id":"ce543964-db0e-11ef-9225-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":9,"tongjian_id":"ce543965-db0e-11ef-b503-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：晉州西北至隰州二百五十里。","note_content_jianti_auto":"九域志：晋州西北至隰州二百五十里。","note_type":"hu_note","start_index":82,"tongjian_id":"ce543963-db0e-11ef-80fe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"首都金陵府【江苏南京】","start_index":0,"tongjian_id":"ce543968-db0e-11ef-b8b5-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":7,"tongjian_id":"ce543969-db0e-11ef-9f54-a0d3651f611f"},{"place_name":"石樓","place_name_jianti_auto":"石楼","start_index":9,"tongjian_id":"ce54396a-db0e-11ef-8037-a0d3651f611f"},{"place_name":"長壽縣","place_name_jianti_auto":"长寿县","start_index":12,"tongjian_id":"ce54396b-db0e-11ef-9b73-a0d3651f611f"},{"place_name":"石樓","place_name_jianti_auto":"石楼","start_index":22,"tongjian_id":"ce54396c-db0e-11ef-a873-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐武德二年，分隰州石樓置長壽縣，貞觀元年省入石樓。","note_content_jianti_auto":"唐武德二年，分隰州石楼置长寿县，贞观元年省入石楼。","note_type":"hu_note","start_index":111,"tongjian_id":"ce543967-db0e-11ef-bd02-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西隰县","resolved_place_entity_id":1526,"start_index":79,"tongjian_id":"ce543979-db0e-11ef-bcbe-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西隰县","resolved_place_entity_id":1526,"start_index":85,"tongjian_id":"ce54397c-db0e-11ef-8658-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"《寰宇记》：县北六里有夷吾馆，即晋公子夷吾所居也。后魏孝...","context_before":"...：武德初，置长寿县，属西德州。贞观初，县废，谓之长寿村。","source_end_index":87,"source_paragraph_tongjian_id":"058dd35e-e1fa-54e7-9399-7e7c38bb186e","source_start_index":42,"source_text":"五代周广顺初，北汉刘承钧自攻晋州，不克，移军隰州。隰州将孙继业迎击之于长寿村，败之，即此。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"20戊戌，北漢兵五道攻晉州，節度使王晏閉城不出。劉承鈞以爲怯，蟻附登城。晏伏兵奮擊，北漢兵死傷者千餘人。承鈞遣副兵馬使安元寶焚晉州西城，元寶來降。承鈞乃移軍攻隰州。癸卯，隰州刺史許遷遣步軍都指揮使耿繼業迎擊北漢兵於長壽村，執其將程筠等，殺之。未幾，北漢兵攻州城，數日不克，死傷甚衆，乃引去。遷，鄆州人也。","content_fanyi":"二月六日戊戌，北汉军队分五路进攻晋州，节度使王晏关闭城门不出战。刘承钧认为他胆怯，命令士兵像蚂蚁一样攀附城墙登城。王晏预设的伏兵奋力出击，北汉兵死伤一千多人。刘承钧派副兵马使安元宝焚烧晋州西城，安元宝前来投降。刘承钧于是转移军队进攻隰州。二月十一日癸卯，隰州刺史许迁派遣步军都指挥使耿继业在长寿村迎击北汉军队，抓获其将领程筠等人，杀掉他们。不久，北汉军队攻打州城，接连数日不能攻克，死伤很多，于是撤离。许迁是郓州人。","content_jianti_auto":"20戊戌，北汉兵五道攻晋州，节度使王晏闭城不出。刘承钧以为怯，蚁附登城。晏伏兵奋击，北汉兵死伤者千余人。承钧遣副兵马使安元宝焚晋州西城，元宝来降。承钧乃移军攻隰州。癸卯，隰州刺史许迁遣步军都指挥使耿继业迎击北汉兵于长寿村，执其将程筠等，杀之。未几，北汉兵攻州城，数日不克，死伤甚众，乃引去。迁，郓州人也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30410,"number":20,"path":"资治通鉴 : 卷第二百九十 (後周紀一) / 太祖聖神恭肅文武孝皇帝上 / 廣順元年 / 第 26 段","reading_annotation_sources":[],"start_index":25,"tongjian_id":"ce543962-db0e-11ef-be8a-a0d3651f611f","year_int":951},"tongjian_id":"ce543962-db0e-11ef-be8a-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":2,"total_paragraphs":11},"place_name":"隰州"},"message":"success","success":true}