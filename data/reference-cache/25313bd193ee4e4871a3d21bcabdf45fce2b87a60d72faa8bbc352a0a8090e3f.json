{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛丑、二八一）","note_content_jianti_auto":"（辛丑、二八一）","note_type":"hu_note","start_index":0,"tongjian_id":"9cfad974-db0e-11ef-aa6d-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉志曰：羊車，一名輦車，上如軺，伏兔箱，漆畫輪軛。","note_content_jianti_auto":"晋志曰：羊车，一名辇车，上如轺，伏兔箱，漆画轮轭。","note_type":"hu_note","start_index":45,"tongjian_id":"9cfb147b-db0e-11ef-a9b3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"羊嗜竹葉而喜鹹，故以二者引帝車。","note_content_jianti_auto":"羊嗜竹叶而喜咸，故以二者引帝车。","note_type":"hu_note","start_index":74,"tongjian_id":"9cfb147d-db0e-11ef-b30e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"數，所角翻；下同。","note_content_jianti_auto":"数，所角翻；下同。","note_type":"hu_note","start_index":119,"tongjian_id":"9cfb147f-db0e-11ef-9c5e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"外戚","official_name":"后父","official_note":"后父指皇后的父亲，在晋代常作为外戚身份，此处杨骏作为晋武帝皇后杨艳的父亲，开始掌握权力，影响朝政。","official_rank":"未知","source_snippet":"而后父楊駿及弟珧、濟始用事","start_index":85,"tongjian_id":"0cb5af03-ba6a-4fbd-8851-b192f29e865b"}],"ExtRef_Children_people":[{"link_birth_year":242,"link_death_year":284,"link_td_description":"吴末帝孙皓，字元宗，幼名彭祖，又字皓宗，《三国志》原名为孙晧。为废太子孙和之子，吴大帝孙权之孙，在位约十六年（264年—280年），是三国时期东吴的第四位，同时也是三国最后一位皇帝。","link_td_id":"Q10000136","link_td_number_id":38112,"people_name":"孫晧","people_name_jianti_auto":"孙晧","people_xingming":"孙晧","start_index":8,"tongjian_id":"9cfb1480-db0e-11ef-ad9c-a0d3651f611f"},{"link_death_year":291,"link_td_description":"杨骏，字文长，弘农华阴（今陕西省华阴市），太尉杨震幼子杨奉的后裔，东莱太守、蓩亭侯杨众的孙子。晋武帝武悼皇后杨芷之父。","link_td_id":"Q10000932","link_td_number_id":461571,"people_name":"楊駿","people_name_jianti_auto":"杨骏","people_xingming":"杨骏","start_index":77,"tongjian_id":"9cfb1482-db0e-11ef-b212-a0d3651f611f"},{"link_death_year":291,"link_td_description":"杨珧，字文琚，弘农华阴人，晋武帝武悼皇后杨芷之叔父、杨骏之弟。历任尚书令、卫将军。","link_td_id":"Q10008936","link_td_number_id":462755,"people_name":"珧","people_name_jianti_auto":"珧","people_xingming":"杨珧","start_index":81,"tongjian_id":"9cfb1483-db0e-11ef-8141-a0d3651f611f"},{"link_death_year":291,"link_td_description":"杨济，字文通，弘农华阴人。晋武帝武悼皇后杨芷之叔父、杨骏之弟。历任镇南、征北将军，迁太子太傅。","link_td_id":"Q10008958","link_td_number_id":466197,"people_name":"濟","people_name_jianti_auto":"济","people_xingming":"杨济","start_index":83,"tongjian_id":"9cfb1484-db0e-11ef-ab25-a0d3651f611f"},{"people_name":"楊","people_name_jianti_auto":"杨","start_index":103,"tongjian_id":"9cfb1485-db0e-11ef-9243-a0d3651f611f"},{"link_birth_year":205,"link_death_year":283,"link_td_description":"山涛，字巨源，河内郡怀县（今河南武陟西）人，「竹林七贤」之一。","link_td_id":"Q10006865","link_td_number_id":98467,"people_name":"山濤","people_name_jianti_auto":"山涛","people_xingming":"山涛","start_index":112,"tongjian_id":"9cfb1486-db0e-11ef-9dcb-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9cfb147a-db0e-11ef-88d1-a0d3651f611f","pinyin":"yáo","source_anchor_text":"楊駿及弟珧濟始用事","source_key":"baiyang_epub","start_index":81,"text":"珧","tongjian_id":"39cb6c75-f997-561d-8d77-6c099c66f753"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","resolved_place_entity_id":33,"start_index":21,"tongjian_id":"9cfb1481-db0e-11ef-a1b2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十九）","excerpts":[{"context_after":"，治建邺]，渡江后，扬州遂为王畿[时侨置州郡，参错其间。...","context_before":"...南为吴地[已上见第二卷。后仿此]。晋亦置扬州[初治寿春。","source_end_index":249,"source_paragraph_tongjian_id":"7723b3e0-0d4a-5a69-bf82-92dc16e4062f","source_start_index":246,"source_text":"平吴后"}],"path":"南直方舆纪要/〇、封域 山川险要（卷十九）","source_name":"读史方舆纪要"}],"class_tags":["内政","人事"],"content":"1春，三月，詔選孫晧宮人五千人入宮。帝旣平吳，頗事遊宴，怠於政事，掖庭殆將萬人。常乘羊車，恣其所之，至便宴寢；宮人競以竹葉插戶，鹽汁灑地，以引帝車。而后父楊駿及弟珧、濟始用事，交通請謁，勢傾內外，時人謂之三楊，舊臣多被疏退。山濤數有規諷，帝雖知而不能改。","content_fanyi":"春季，三月，晋武帝下诏选取孙皓宫中的宫女五千人入宫。晋武帝平定吴国之后，很醉心于游乐宴饮，对政事懈怠，宫中妃嫔将近万人。他常乘坐羊车，听凭羊随意去往，到了哪里就在哪里宴饮就寝；宫女们争着把竹叶插在门上，把盐水洒在地上，用来把皇帝的车子引到自己门前。此后，皇后的父亲杨骏及其弟杨珧、杨济开始掌权，他们互相交结、相互利用，权势倾动内外，当时的人称他们为“三杨”，朝中旧臣大多被疏远贬退。山涛多次规劝讽谏，晋武帝虽然心里明白却不能改正。","content_jianti_auto":"1春，三月，诏选孙晧宫人五千人入宫。帝既平吴，颇事游宴，怠于政事，掖庭殆将万人。常乘羊车，恣其所之，至便宴寝；宫人竞以竹叶插户，盐汁洒地，以引帝车。而后父杨骏及弟珧、济始用事，交通请谒，势倾内外，时人谓之三杨，旧臣多被疏退。山涛数有规讽，帝虽知而不能改。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6945,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9cfb147a-db0e-11ef-88d1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否侵犯晋朝昌黎郡","decision_tongjian_id":"DECISION_9CFB1487DB0E11EFB350A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"太武","people_name_jianti_auto":"太武","start_index":21,"tongjian_id":"9cfb1489-db0e-11ef-9963-a0d3651f611f"},{"people_name":"莫護跋","people_name_jianti_auto":"莫护跋","start_index":43,"tongjian_id":"9cfb148a-db0e-11ef-9034-a0d3651f611f"},{"people_name":"宣帝","people_name_jianti_auto":"宣帝","start_index":47,"tongjian_id":"9cfb148b-db0e-11ef-9f94-a0d3651f611f"},{"people_name":"公孫氏","people_name_jianti_auto":"公孙氏","start_index":50,"tongjian_id":"9cfb148c-db0e-11ef-8bb9-a0d3651f611f"},{"people_name":"率義王","people_name_jianti_auto":"率义王","start_index":57,"tongjian_id":"9cfb148d-db0e-11ef-aa4d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"棘城","place_name_jianti_auto":"棘城","start_index":0,"tongjian_id":"9cfb148e-db0e-11ef-bf1f-a0d3651f611f"},{"place_name":"昌黎縣","place_name_jianti_auto":"昌黎县","start_index":3,"tongjian_id":"9cfb148f-db0e-11ef-8bef-a0d3651f611f"},{"place_name":"慕容氏","place_name_jianti_auto":"慕容氏","start_index":10,"tongjian_id":"9cfb1490-db0e-11ef-8241-a0d3651f611f"},{"place_name":"棘城縣","place_name_jianti_auto":"棘城县","start_index":14,"tongjian_id":"9cfb1491-db0e-11ef-b047-a0d3651f611f"},{"place_name":"拓跋魏","place_name_jianti_auto":"拓跋魏","start_index":18,"tongjian_id":"9cfb1492-db0e-11ef-a95a-a0d3651f611f"},{"place_name":"棘城","place_name_jianti_auto":"棘城","start_index":29,"tongjian_id":"9cfb1493-db0e-11ef-983c-a0d3651f611f"},{"place_name":"昌黎郡","place_name_jianti_auto":"昌黎郡","start_index":32,"tongjian_id":"9cfb1494-db0e-11ef-8bdd-a0d3651f611f"},{"place_name":"龍城縣","place_name_jianti_auto":"龙城县","start_index":35,"tongjian_id":"9cfb1495-db0e-11ef-8733-a0d3651f611f"},{"place_name":"棘城","place_name_jianti_auto":"棘城","start_index":65,"tongjian_id":"9cfb1496-db0e-11ef-9d4a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"棘城在昌黎縣界，是後慕容氏置棘城縣。拓跋魏太武眞君八年，倂棘城入昌黎郡龍城縣。載記曰：莫護跋從宣帝伐公孫氏有功，拜率義王，始建國于棘城之北。","note_content_jianti_auto":"棘城在昌黎县界，是后慕容氏置棘城县。拓跋魏太武真君八年，倂棘城入昌黎郡龙城县。载记曰：莫护跋从宣帝伐公孙氏有功，拜率义王，始建国于棘城之北。","note_type":"hu_note","start_index":21,"tongjian_id":"9cfb1488-db0e-11ef-9b73-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"漢桓帝","people_name_jianti_auto":"汉桓帝","start_index":4,"tongjian_id":"9cfb1499-db0e-11ef-80ca-a0d3651f611f"},{"people_name":"檀石槐","people_name_jianti_auto":"檀石槐","start_index":11,"tongjian_id":"9cfb149a-db0e-11ef-80b2-a0d3651f611f"},{"people_name":"柯最","people_name_jianti_auto":"柯最","start_index":31,"tongjian_id":"9cfb149b-db0e-11ef-9b6e-a0d3651f611f"},{"people_name":"闕居","people_name_jianti_auto":"阙居","start_index":34,"tongjian_id":"9cfb149c-db0e-11ef-acdb-a0d3651f611f"},{"people_name":"慕容","people_name_jianti_auto":"慕容","start_index":37,"tongjian_id":"9cfb149d-db0e-11ef-9fe9-a0d3651f611f"},{"people_name":"莫護跋","people_name_jianti_auto":"莫护跋","start_index":58,"tongjian_id":"9cfb149e-db0e-11ef-9443-a0d3651f611f"},{"people_name":"莫護跋","people_name_jianti_auto":"莫护跋","start_index":78,"tongjian_id":"9cfb149f-db0e-11ef-acd9-a0d3651f611f"},{"people_name":"慕容","people_name_jianti_auto":"慕容","start_index":130,"tongjian_id":"9cfb14a0-db0e-11ef-b8d5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":9,"tongjian_id":"9cfb14a1-db0e-11ef-af44-a0d3651f611f"},{"place_name":"慕容部","place_name_jianti_auto":"慕容部","start_index":47,"tongjian_id":"9cfb14a2-db0e-11ef-868b-a0d3651f611f"},{"place_name":"棘城","place_name_jianti_auto":"棘城","start_index":63,"tongjian_id":"9cfb14a3-db0e-11ef-bf65-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":69,"tongjian_id":"9cfb14a4-db0e-11ef-998a-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","start_index":71,"tongjian_id":"9cfb14a5-db0e-11ef-b6ca-a0d3651f611f"},{"place_name":"慕容","place_name_jianti_auto":"慕容","start_index":110,"tongjian_id":"9cfb14a6-db0e-11ef-a2e3-a0d3651f611f"},{"place_name":"慕容氏","place_name_jianti_auto":"慕容氏","start_index":148,"tongjian_id":"9cfb14a7-db0e-11ef-908e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏書曰：漢桓帝時，鮮卑檀石槐分其地爲東、中、西三部，中部大人曰柯最、闕居、慕容等，爲大帥，是則慕容部之始也。載記曰：莫護跋國于棘城之北，時燕、代多冠步搖冠，莫護跋見而好之，乃斂髮襲冠，諸部因呼之爲「步搖」，其後音訛，遂爲慕容。或云：慕二儀之德，繼三光之容，遂以慕容爲氏。余謂步搖之說誕；或云之說，慕容氏旣得中國，其臣子從而爲之辭。","note_content_jianti_auto":"魏书曰：汉桓帝时，鲜卑檀石槐分其地为东、中、西三部，中部大人曰柯最、阙居、慕容等，为大帅，是则慕容部之始也。载记曰：莫护跋国于棘城之北，时燕、代多冠步摇冠，莫护跋见而好之，乃敛发袭冠，诸部因呼之为「步摇」，其后音讹，遂为慕容。或云：慕二仪之德，继三光之容，遂以慕容为氏。余谓步摇之说诞；或云之说，慕容氏既得中国，其臣子从而为之辞。","note_type":"hu_note","start_index":27,"tongjian_id":"9cfb1498-db0e-11ef-9a19-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"范亨","people_name_jianti_auto":"范亨","start_index":76,"tongjian_id":"9cfb14ac-db0e-11ef-a040-a0d3651f611f"},{"people_name":"廆","people_name_jianti_auto":"廆","start_index":86,"tongjian_id":"9cfb14ad-db0e-11ef-85d5-a0d3651f611f"},{"people_name":"涉歸","people_name_jianti_auto":"涉归","start_index":101,"tongjian_id":"9cfb14ae-db0e-11ef-96ab-a0d3651f611f"},{"people_name":"涉歸","people_name_jianti_auto":"涉归","start_index":119,"tongjian_id":"9cfb14af-db0e-11ef-8dc0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"昌黎","place_name_jianti_auto":"昌黎","start_index":0,"tongjian_id":"9cfb14b0-db0e-11ef-b9f2-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":3,"tongjian_id":"9cfb14b1-db0e-11ef-9443-a0d3651f611f"},{"place_name":"交黎縣","place_name_jianti_auto":"交黎县","start_index":5,"tongjian_id":"9cfb14b2-db0e-11ef-9d57-a0d3651f611f"},{"place_name":"遼西郡","place_name_jianti_auto":"辽西郡","start_index":10,"tongjian_id":"9cfb14b3-db0e-11ef-a656-a0d3651f611f"},{"place_name":"東漢","place_name_jianti_auto":"东汉","start_index":14,"tongjian_id":"9cfb14b4-db0e-11ef-9783-a0d3651f611f"},{"place_name":"遼東屬國","place_name_jianti_auto":"辽东属国","start_index":17,"tongjian_id":"9cfb14b5-db0e-11ef-86c4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":24,"tongjian_id":"9cfb14b6-db0e-11ef-9b99-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":30,"tongjian_id":"9cfb14b7-db0e-11ef-b0e4-a0d3651f611f"},{"place_name":"遼東屬國","place_name_jianti_auto":"辽东属国","start_index":37,"tongjian_id":"9cfb14b8-db0e-11ef-a57c-a0d3651f611f"},{"place_name":"昌黎縣","place_name_jianti_auto":"昌黎县","start_index":43,"tongjian_id":"9cfb14b9-db0e-11ef-b7ec-a0d3651f611f"},{"place_name":"昌黎郡","place_name_jianti_auto":"昌黎郡","start_index":52,"tongjian_id":"9cfb14ba-db0e-11ef-aec9-a0d3651f611f"},{"place_name":"慕容氏","place_name_jianti_auto":"慕容氏","start_index":56,"tongjian_id":"9cfb14bb-db0e-11ef-8e7b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昌黎，漢之交黎縣，屬遼西郡，東漢屬遼東屬國都尉。魏正始五年，鮮卑內附，復置遼東屬國，立昌黎縣以居之，後立昌黎郡。慕容氏始此。考異曰：帝紀云「慕容廆」，按范亨燕書·武宣紀：「廆，泰始五年生，年十五，父單于涉歸卒，」太康四年也。此年入寇，當是涉歸。","note_content_jianti_auto":"昌黎，汉之交黎县，属辽西郡，东汉属辽东属国都尉。魏正始五年，鲜卑内附，复置辽东属国，立昌黎县以居之，后立昌黎郡。慕容氏始此。考异曰：帝纪云「慕容廆」，按范亨燕书·武宣纪：「廆，泰始五年生，年十五，父单于涉归卒，」太康四年也。此年入寇，当是涉归。","note_type":"hu_note","start_index":76,"tongjian_id":"9cfb14ab-db0e-11ef-85ae-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"大單于","official_note":"大單于是北方游牧民族首领的称号，在晋代常授予归附的少数民族首领，表示对其部落的统治权。此处涉归因‘数从征讨有功’被拜为大單于，体现了晋朝对慕容部的羁縻政策。","official_rank":"未知","source_snippet":"拜大單于","start_index":58,"tongjian_id":"6e250c20-a75d-4f3e-b04a-6da8f28884f9"}],"ExtRef_Children_people":[{"link_td_description":"莫护跋，慕容部鲜卑酋长。","link_td_id":"Q10001990","link_td_number_id":748322,"people_name":"莫護跋","people_name_jianti_auto":"莫护跋","people_xingming":"莫护跋","start_index":5,"tongjian_id":"9cfb14bf-db0e-11ef-bde4-a0d3651f611f"},{"link_td_description":"莫护跋，慕容部鲜卑酋长。","link_td_id":"Q10001990","link_td_number_id":748322,"people_name":"莫護跋","people_name_jianti_auto":"莫护跋","start_index":27,"tongjian_id":"9cfb14c4-db0e-11ef-9da2-a0d3651f611f"},{"link_td_description":"慕容木延，中国魏晋时期鲜卑部落慕容部的君主（245年—271年在位），即左贤王，其父为慕容部鲜卑初代酋长莫护跋，其子为慕容涉归、慕容删。因助毌丘俭东征高句丽有功，加号大都督。","link_td_id":"Q10009567","link_td_number_id":748324,"people_name":"木延","people_name_jianti_auto":"木延","people_xingming":"木延","start_index":31,"tongjian_id":"9cfb14c5-db0e-11ef-ab7f-a0d3651f611f"},{"link_td_description":"慕容木延，中国魏晋时期鲜卑部落慕容部的君主（245年—271年在位），即左贤王，其父为慕容部鲜卑初代酋长莫护跋，其子为慕容涉归、慕容删。因助毌丘俭东征高句丽有功，加号大都督。","link_td_id":"Q10009567","link_td_number_id":748324,"people_name":"木延","people_name_jianti_auto":"木延","start_index":34,"tongjian_id":"9cfb14c6-db0e-11ef-971b-a0d3651f611f"},{"link_death_year":283,"link_td_description":"慕容涉归，慕容部鲜卑初代酋长莫护跋之孙，慕容木延之子。","link_td_id":"Q10009565","link_td_number_id":748297,"people_name":"涉歸","people_name_jianti_auto":"涉归","people_xingming":"涉归","start_index":37,"tongjian_id":"9cfb14c7-db0e-11ef-9a2d-a0d3651f611f"},{"link_death_year":283,"link_td_description":"慕容涉归，慕容部鲜卑初代酋长莫护跋之孙，慕容木延之子。","link_td_id":"Q10009565","link_td_number_id":748297,"people_name":"涉歸","people_name_jianti_auto":"涉归","start_index":69,"tongjian_id":"9cfb14c9-db0e-11ef-aef2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","resolved_place_entity_id":218,"start_index":3,"tongjian_id":"9cfb14c0-db0e-11ef-8f0f-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","resolved_place_entity_id":655,"start_index":14,"tongjian_id":"9cfb14c1-db0e-11ef-b39e-a0d3651f611f"},{"place_name":"棘城","place_name_jianti_auto":"棘城","resolved_place_entity_id":1744,"start_index":16,"tongjian_id":"9cfb14c2-db0e-11ef-80f5-a0d3651f611f"},{"place_name":"慕容部","place_name_jianti_auto":"慕容部","resolved_place_entity_id":7076,"start_index":23,"tongjian_id":"9cfb14c3-db0e-11ef-b386-a0d3651f611f"},{"place_name":"遼東","place_name_jianti_auto":"辽东","resolved_place_entity_id":282,"start_index":42,"tongjian_id":"9cfb14c8-db0e-11ef-bf38-a0d3651f611f"},{"place_name":"昌黎","place_name_jianti_auto":"昌黎","resolved_place_entity_id":1078,"start_index":73,"tongjian_id":"9cfb14ca-db0e-11ef-87f1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、晋 十六国（卷三）","excerpts":[{"context_after":"再传至涉归，迁辽东之北，数从中国征讨有功，拜大单于。晋太...","context_before":"慕容氏据辽东称燕。\n【史略】","source_end_index":63,"source_paragraph_tongjian_id":"1cb48bc4-3d2c-5e61-af63-c13b19cd5c8e","source_start_index":14,"source_text":"三国魏景初中，鲜卑莫护跋自塞外入居辽西棘城之北[棘城，在今废大宁卫故柳城东南百七十里]，号慕容部。"},{"context_after":"晋太康二年，涉归始寇昌黎[昌黎故城，亦在柳城。东晋时，为...","context_before":"...之北[棘城，在今废大宁卫故柳城东南百七十里]，号慕容部。","source_end_index":89,"source_paragraph_tongjian_id":"1cb48bc4-3d2c-5e61-af63-c13b19cd5c8e","source_start_index":63,"source_text":"再传至涉归，迁辽东之北，数从中国征讨有功，拜大单于。"},{"context_after":"又再传至廆[廆，即涉归子也。涉归死，弟删篡立，寻为其下所...","context_before":"...部。再传至涉归，迁辽东之北，数从中国征讨有功，拜大单于。","source_end_index":122,"source_paragraph_tongjian_id":"1cb48bc4-3d2c-5e61-af63-c13b19cd5c8e","source_start_index":89,"source_text":"晋太康二年，涉归始寇昌黎[昌黎故城，亦在柳城。东晋时，为平州治]。"}],"path":"历代州域形势纪要/三、晋 十六国（卷三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"。父涉珪进拜鲜卑单于，迁邑辽东之北。晋太康中，廆嗣立。元...","context_before":"...建兴中，鲜卑慕容廆有其地[《燕录》：慕容廆，昌黎鲜卑也。","source_end_index":181,"source_paragraph_tongjian_id":"c329b039-2671-5998-a657-9184f1194383","source_start_index":145,"source_text":"曾祖莫护跋，魏初自塞外入辽西，从讨公孙渊有功，拜率义王，始建国于棘城之北"},{"context_after":"。晋太康中，廆嗣立。元康四年，徙于徒河之青山，又移居大棘...","context_before":"...塞外入辽西，从讨公孙渊有功，拜率义王，始建国于棘城之北。","source_end_index":198,"source_paragraph_tongjian_id":"c329b039-2671-5998-a657-9184f1194383","source_start_index":182,"source_text":"父涉珪进拜鲜卑单于，迁邑辽东之北"},{"context_after":"晋元康四年，莫护跋之孙慕容廆徙居大棘城，因置棘城县。咸康...","context_before":"棘城[在营州东南百七十里。汉交黎县地，属辽西郡。","source_end_index":61,"source_paragraph_tongjian_id":"23dca39e-11e6-5a6e-8e8a-5563fa0e5f6d","source_start_index":24,"source_text":"曹魏景初二年，鲜卑莫护跋从司马懿伐公孙渊有功，拜率义王，始建国于棘城之北。"},{"context_after":"延康二年，慕容皝以其弟仁据平郭，自昌黎东践冰而进，凡三百...","context_before":"...此。魏正始五年，鲜卑内附，置昌黎郡。晋因之，又为平州治。","source_end_index":103,"source_paragraph_tongjian_id":"4a7dc024-1682-552d-80b7-f66b64ae92c6","source_start_index":73,"source_text":"太康二年，鲜卑慕容涉归寇昌黎，既而安北将军严询败鲜卑于昌黎。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2初，鮮卑莫護跋始自塞外入居遼西棘城之北，號曰慕容部。莫護跋生木延，木延生涉歸，遷於遼東之北，世附中國，數從征討有功，拜大單于。冬，十月，涉歸始寇昌黎。","content_fanyi":"当初，鲜卑人莫护跋开始从塞外入居辽西棘城以北，称为慕容部。莫护跋生木延，木延生涉归，迁移到辽东以北，世代归附中原，多次随朝廷军队征讨有功，被授为大单于。冬季十月，涉归开始侵犯昌黎。","content_jianti_auto":"2初，鲜卑莫护跋始自塞外入居辽西棘城之北，号曰慕容部。莫护跋生木延，木延生涉归，迁于辽东之北，世附中国，数从征讨有功，拜大单于。冬，十月，涉归始寇昌黎。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6946,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"9cfb1487-db0e-11ef-b350-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"騫","people_name_jianti_auto":"骞","start_index":14,"tongjian_id":"9cfb14cd-db0e-11ef-b35b-a0d3651f611f"},{"people_name":"高平公","people_name_jianti_auto":"高平公","start_index":24,"tongjian_id":"9cfb14ce-db0e-11ef-b903-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：帝紀云「大司馬」。按騫以咸寧三年辭位，以高平公還第。","note_content_jianti_auto":"考异曰：帝纪云「大司马」。按骞以咸宁三年辞位，以高平公还第。","note_type":"hu_note","start_index":16,"tongjian_id":"9cfb14cc-db0e-11ef-8c4e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"高平武公","official_note":"高平武公是陈骞的爵位，表示其封地为高平，谥号为武，在《资治通鉴》中用于标识其身份和地位。","official_rank":"公爵","source_snippet":"高平武公陳騫薨","start_index":3,"tongjian_id":"e64869e2-6385-434f-9a87-c288cade826a"}],"ExtRef_Children_people":[{"link_birth_year":201,"link_death_year":281,"link_td_description":"陈骞，字休渊，临淮东阳（今安徽天长）人。三国时代曹魏司徒陈矫之子，是晋朝开国功臣，官至车骑将军。","link_td_id":"Q10009642","link_td_number_id":771464,"people_name":"高平武公","people_name_jianti_auto":"高平武公","people_xingming":"陈骞","start_index":8,"tongjian_id":"9cfb14d1-db0e-11ef-835e-a0d3651f611f"},{"link_birth_year":201,"link_death_yea