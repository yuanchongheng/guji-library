k_birth_year":543,"link_death_year":578,"link_td_description":"宇文邕，字祢罗突，代郡武川镇人，周文帝宇文泰第四子，北周第二代皇帝。","link_td_id":"Q10000260","link_td_number_id":111512,"people_name":"周高祖","people_name_jianti_auto":"周高祖","people_xingming":"宇文邕","start_index":45,"tongjian_id":"b3e6e340-db0e-11ef-894e-a0d3651f611f","wl_zhushi":"[宇文邕]"},{"people_name":"順陽公主","people_name_jianti_auto":"顺阳公主","people_xingming":"顺阳公主","start_index":49,"tongjian_id":"b3e6e341-db0e-11ef-8544-a0d3651f611f"},{"link_birth_year":544,"link_death_year":602,"link_td_description":"独孤伽罗，河南郡洛阳县（今河南省洛阳市东）人，北周太保、大宗伯独孤信的七女，母崔氏，隋朝开国皇帝隋文帝的妻子，北周宣帝皇后杨丽华、杨勇、隋炀帝杨广、杨俊、杨秀、杨谅的母亲，唐高祖李渊的姨母。隋文帝即位之后，封为皇后。","link_td_id":"Q10000639","link_td_number_id":287440,"people_name":"獨孤后","people_name_jianti_auto":"独孤后","people_xingming":"独孤伽罗","start_index":56,"tongjian_id":"b3e6e342-db0e-11ef-92a5-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":73,"tongjian_id":"b3e6e343-db0e-11ef-b3fb-a0d3651f611f"},{"link_birth_year":550,"link_death_year":591,"link_td_description":"杨瓒，字恒生，一名慧，隋文帝杨坚同母弟。","link_td_id":"Q10005331","link_td_number_id":1265219,"people_name":"瓚","people_name_jianti_auto":"瓒","people_xingming":"杨瓒","start_index":82,"tongjian_id":"b3e6e344-db0e-11ef-85df-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","resolved_place_entity_id":87,"start_index":17,"tongjian_id":"b3e6e33e-db0e-11ef-8b95-a0d3651f611f"},{"place_name":"栗園","place_name_jianti_auto":"栗园","resolved_place_entity_id":3241,"start_index":86,"tongjian_id":"b3e6e345-db0e-11ef-b869-a0d3651f611f"},{"place_name":"栗園","place_name_jianti_auto":"栗园","resolved_place_entity_id":3241,"start_index":105,"tongjian_id":"b3e6e346-db0e-11ef-8118-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"5初，帝微時，與滕穆王瓚不協。帝爲周相，以瓚爲大宗伯，瓚恐爲家禍，陰欲圖帝，帝隱之。瓚妃，周高祖妹順陽公主也，與獨孤后素不平，陰爲呪詛；帝命出之，瓚不可。秋，八月，瓚從帝幸栗園，暴薨，時人疑其遇鴆。乙亥，帝至自栗園。","content_fanyi":"起初，隋文帝微贱时，与滕穆王杨瓒不和。隋文帝任北周丞相时，任命杨瓒为大宗伯；杨瓒害怕招来灭族之祸，暗中想谋害文帝，文帝隐忍不言。杨瓒的王妃是北周高祖的妹妹顺阳公主，平素与独孤皇后不和，暗中诅咒；文帝命杨瓒休掉她，杨瓒不肯。秋季八月，杨瓒随文帝临幸栗园，突然去世，当时人们怀疑他是被毒死的。乙亥日，文帝从栗园返回。","content_jianti_auto":"5初，帝微时，与滕穆王瓒不协。帝为周相，以瓒为大宗伯，瓒恐为家祸，阴欲图帝，帝隐之。瓒妃，周高祖妹顺阳公主也，与独孤后素不平，阴为呪诅；帝命出之，瓒不可。秋，八月，瓒从帝幸栗园，暴薨，时人疑其遇鸩。乙亥，帝至自栗园。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17227,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"b3e6e326-db0e-11ef-b5e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"沛達公","official_note":"沛達公是隋朝时期的爵位，属于公爵，通常授予有功或贵族人物，此处用于描述郑译的身份。","official_rank":"未知","source_snippet":"沛達公鄭譯卒","start_index":0,"tongjian_id":"08523101-fc4a-459f-a0b7-6112e4ec9924"}],"ExtRef_Children_people":[{"link_birth_year":540,"link_death_year":591,"link_td_description":"郑译，字正议，一作正义，荥阳郡开封县（今河南省开封市祥符区）人，出自荥阳郑氏北祖第三房，北周、隋朝官员。","link_td_id":"Q10013611","link_td_number_id":1603591,"people_name":"沛達公","people_name_jianti_auto":"沛达公","people_xingming":"郑译","start_index":1,"tongjian_id":"b3e6e349-db0e-11ef-90d6-a0d3651f611f"},{"link_birth_year":540,"link_death_year":591,"link_td_description":"郑译，字正议，一作正义，荥阳郡开封县（今河南省开封市祥符区）人，出自荥阳郑氏北祖第三房，北周、隋朝官员。","link_td_id":"Q10013611","link_td_number_id":1603591,"people_name":"鄭譯","people_name_jianti_auto":"郑译","people_xingming":"郑译","start_index":4,"tongjian_id":"b3e6e34a-db0e-11ef-8a24-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6沛達公鄭譯卒。","content_fanyi":"沛达公郑译去世。","content_jianti_auto":"6沛达公郑译卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17228,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"b3e6e347-db0e-11ef-b5dd-a0d3651f611f"