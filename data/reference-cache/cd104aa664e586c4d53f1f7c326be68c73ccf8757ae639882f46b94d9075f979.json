{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲子、前二三七）","note_content_jianti_auto":"（甲子、前二三七）","note_type":"hu_note","start_index":0,"tongjian_id":"8d431180-db0e-11ef-adf9-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文信侯國","people_name_jianti_auto":"文信侯国","start_index":6,"tongjian_id":"8d431183-db0e-11ef-ae99-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河南","place_name_jianti_auto":"河南","start_index":11,"tongjian_id":"8d431184-db0e-11ef-aec8-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":13,"tongjian_id":"8d431185-db0e-11ef-b353-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相，息亮翻。文信侯國於河南洛陽。","note_content_jianti_auto":"相，息亮翻。文信侯国于河南洛阳。","note_type":"hu_note","start_index":16,"tongjian_id":"8d431182-db0e-11ef-be6d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相","official_note":"相是秦朝及战国时期最高行政长官，相当于丞相，负责辅佐君主处理国家政务。在《资治通鉴》此段中，文信侯（吕不韦）被免去相位，表明其失去中央权力，出就封国。","official_rank":"正一品","source_snippet":"文信侯免相","start_index":9,"tongjian_id":"475bc549-483e-43bc-9b41-b7c8cbb98e15"}],"ExtRef_Children_people":[{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"文信侯","people_name_jianti_auto":"文信侯","people_xingming":"吕不韦","start_index":6,"tongjian_id":"8d431186-db0e-11ef-bd72-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"1冬，十月，文信侯免相，出就國。","content_fanyi":"冬季，十月，文信侯吕不韦被罢免相国之职，离开京城，前往他的封国河南洛阳。","content_jianti_auto":"1冬，十月，文信侯免相，出就国。","dtjl_paragraph_links":[],"dtjl_references":[],"id":498,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d431181-db0e-11ef-9cc1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":5,"tongjian_id":"8d431189-db0e-11ef-9047-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂遊說以間秦之君臣。爲，于僞翻。間，古莧翻。","note_content_jianti_auto":"谓游说以间秦之君臣。为，于伪翻。间，古苋翻。","note_type":"hu_note","start_index":23,"tongjian_id":"8d431188-db0e-11ef-88bd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8d43118d-db0e-11ef-b2e9-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8d43118e-db0e-11ef-a923-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「里」下有「奚」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「里」下有「奚」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8d43118c-db0e-11ef-93ee-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":74,"tongjian_id":"8d43118b-db0e-11ef-af4f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":12,"chapter_name":"臣节篇第十二","chenzhu_chapter":"臣节者人臣事君之大节。《公羊·庄四年传》言：“国、君一体也。”故其时忠于君即忠于国。所谓忠于国者，国存与存，国亡与亡。国亡而不亡，必其无封疆之寄焉可也；国亡不亡，而犹欲保全其禄位，必顽钝无耻，贪利卖国之徒也。故《胡注》之论臣节，以能致其身为第一义，抗节不仕者次之，保禄位而背宗国者，在所必摈也，况助敌国以噬宗国者乎！","chenzhu_index_in_chapter":1,"chenzhu_text":"由余、韩非，均为本国使秦，而导秦以伐其宗国，二者皆贼臣也。由余前韩非四百年，其事为《通鉴》所不及载，注特详之，其有感于刘整、吕文焕诸人之事乎！刘整、吕文焕皆宋季疆臣，不得于宋，而降元以伐宋者也。昔乐毅不得于燕而走赵，赵王欲与之图燕，乐毅垂泣对曰：“臣事昭王，犹事大王。臣若获戾，放在他国，没世不忍谋赵之徒隶，况燕后嗣乎！”语见《魏志·武帝纪》汉建安十五年《注》。《通鉴》不载，朱子《纲目》周赧王三十六年条特采之。与乐毅，即不与由余也。韩非则温公已论之矣。万季野《书宋史吕文德传後》曰：“文德为宋名将，有功于封疆甚大。然许元人开榷场，驯致襄阳不可守，其悮国之罪亦不小。文德之后，其弟文焕、文福，子师夔、师孟，皆以文德故，授显官，委封疆重寄。乃相继叛降，反引敌入寇，导以取江南之策。此万世罪人，其罪视畏死失节者更加数等。昔廉颇负谤出奔，赵患用于他国为己害，使人视颇，对使者曰：‘颇得罪在他国，终身不敢谋赵之奴隶，况子孙乎！’世之为将，苟困守孤城，粮尽援绝，不得已而降，犹当守廉颇之义，终身不敢谋故国，君子或恕之；若既已负国，又引寇以覆其国，此与率寇雠而戕父母者何异？君子可轻其罪，不以昭示后世乎？”语见《群书疑辨》十一。《宋史》无吕文德传，当作《宋史新编》，廉颇当作乐毅，季野偶误记耳。","created_at":"2025-12-31 08:50:44","seq_in_chapter":6,"tongjian_id":"CH12-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"由余","people_name_jianti_auto":"由余","start_index":12,"tongjian_id":"8d443680-db0e-11ef-aa19-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":18,"tongjian_id":"8d443681-db0e-11ef-b6f9-a0d3651f611f"},{"people_name":"由余","people_name_jianti_auto":"由余","start_index":21,"tongjian_id":"8d443682-db0e-11ef-af4d-a0d3651f611f"},{"people_name":"由余","people_name_jianti_auto":"由余","start_index":40,"tongjian_id":"8d443683-db0e-11ef-bf6e-a0d3651f611f"},{"people_name":"由余","people_name_jianti_auto":"由余","start_index":43,"tongjian_id":"8d443684-db0e-11ef-9ced-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":52,"tongjian_id":"8d443685-db0e-11ef-a228-a0d3651f611f"},{"people_name":"由余","people_name_jianti_auto":"由余","start_index":59,"tongjian_id":"8d443686-db0e-11ef-a267-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":67,"tongjian_id":"8d443687-db0e-11ef-bb21-a0d3651f611f"},{"people_name":"晉獻公","people_name_jianti_auto":"晋献公","start_index":85,"tongjian_id":"8d443688-db0e-11ef-b5e8-a0d3651f611f"},{"people_name":"百里奚","people_name_jianti_auto":"百里奚","start_index":95,"tongjian_id":"8d443689-db0e-11ef-a14b-a0d3651f611f"},{"people_name":"百里奚","people_name_jianti_auto":"百里奚","start_index":104,"tongjian_id":"8d44368a-db0e-11ef-9683-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":112,"tongjian_id":"8d44368b-db0e-11ef-a6c2-a0d3651f611f"},{"people_name":"奚","people_name_jianti_auto":"奚","start_index":124,"tongjian_id":"8d44368c-db0e-11ef-9612-a0d3651f611f"},{"people_name":"蹇叔","people_name_jianti_auto":"蹇叔","start_index":128,"tongjian_id":"8d44368d-db0e-11ef-9a1b-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":131,"tongjian_id":"8d44368e-db0e-11ef-bb03-a0d3651f611f"},{"people_name":"惠公","people_name_jianti_auto":"惠公","start_index":147,"tongjian_id":"8d44368f-db0e-11ef-9ae0-a0d3651f611f"},{"people_name":"丕鄭","people_name_jianti_auto":"丕郑","start_index":152,"tongjian_id":"8d443690-db0e-11ef-95ed-a0d3651f611f"},{"people_name":"豹","people_name_jianti_auto":"豹","start_index":157,"tongjian_id":"8d443691-db0e-11ef-b460-a0d3651f611f"},{"people_name":"穆公","people_name_jianti_auto":"穆公","start_index":161,"tongjian_id":"8d443692-db0e-11ef-a0d0-a0d3651f611f"},{"people_name":"公孫支","people_name_jianti_auto":"公孙支","start_index":166,"tongjian_id":"8d443693-db0e-11ef-a0af-a0d3651f611f"},{"people_name":"子桑","people_name_jianti_auto":"子桑","start_index":170,"tongjian_id":"8d443694-db0e-11ef-9769-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":16,"tongjian_id":"8d443695-db0e-11ef-bee2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":65,"tongjian_id":"8d443696-db0e-11ef-b1cd-a0d3651f611f"},{"place_name":"虞","place_name_jianti_auto":"虞","start_index":89,"tongjian_id":"8d443697-db0e-11ef-b633-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":102,"tongjian_id":"8d443698-db0e-11ef-af22-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":108,"tongjian_id":"8d443699-db0e-11ef-98bf-a0d3651f611f"},{"place_name":"宛","place_name_jianti_auto":"宛","start_index":110,"tongjian_id":"8d44369a-db0e-11ef-898f-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":117,"tongjian_id":"8d44369b-db0e-11ef-8c08-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":146,"tongjian_id":"8d44369c-db0e-11ef-8679-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":159,"tongjian_id":"8d44369d-db0e-11ef-9738-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"上，時掌翻。史記：戎王使由余使於秦，穆公留由余而遺戎王以女樂，戎王受而說之，乃歸由余。由余諫戎王而不聽，穆公使人要之，由余遂去戎降秦。穆公用其謀伐戎，幷國十二，開地千里。晉獻公滅虞，虜其大夫百里奚，以媵於秦；百里奚亡秦走宛。穆公贖之於楚，授以國政；奚薦其友蹇叔，穆公使人厚幣迎之，以爲上大夫。晉惠公殺大夫丕鄭，其子豹奔秦，穆公用之。公孫支，子桑也。余使，疏吏翻。遺，于季翻。說，讀爲悅。要，一遙翻。降，戶江翻。媵，以證翻。宛，於元翻。","note_content_jianti_auto":"上，时掌翻。史记：戎王使由余使于秦，穆公留由余而遗戎王以女乐，戎王受而说之，乃归由余。由余谏戎王而不听，穆公使人要之，由余遂去戎降秦。穆公用其谋伐戎，幷国十二，开地千里。晋献公灭虞，虏其大夫百里奚，以媵于秦；百里奚亡秦走宛。穆公赎之于楚，授以国政；奚荐其友蹇叔，穆公使人厚币迎之，以为上大夫。晋惠公杀大夫丕郑，其子豹奔秦，穆公用之。公孙支，子桑也。余使，疏吏翻。遗，于季翻。说，读为悦。要，一遥翻。降，户江翻。媵，以证翻。宛，于元翻。","note_type":"hu_note","start_index":93,"tongjian_id":"8d43118f-db0e-11ef-bcd0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":4,"source_start_index":0,"source_text":"事並見前","target_paragraph_tongjian_id":"8ce9a73e-db0e-11ef-9a18-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事並見前。治，直吏翻。從，子容翻。睢，息隨翻。","note_content_jianti_auto":"事并见前。治，直吏翻。从，子容翻。睢，息随翻。","note_type":"hu_note","start_index":154,"tongjian_id":"8d44369f-db0e-11ef-8dff-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。色，女色也。","note_content_jianti_auto":"夫，音扶。色，女色也。","note_type":"hu_note","start_index":196,"tongjian_id":"8d4436a0-db0e-11ef-bdc0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8d4436a2-db0e-11ef-a565-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦謂民爲黔首。黔，其廉翻，黧黑也。","note_content_jianti_auto":"秦谓民为黔首。黔，其廉翻，黧黑也。","note_type":"hu_note","start_index":310,"tongjian_id":"8d4436a1-db0e-11ef-b509-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8d4436a5-db0e-11ef-99af-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8d4436a6-db0e-11ef-b7a7-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「兵」下有「而」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「兵」下有「而」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8d4436a4-db0e-11ef-a51a-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":324,"tongjian_id":"8d4436a3-db0e-11ef-8137-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"藉，慈夜翻，假也，惜也。齎，子兮翻，持遺也；或爲資，義亦通。","note_content_jianti_auto":"藉，慈夜翻，假也，惜也。赍，子兮翻，持遗也；或为资，义亦通。","note_type":"hu_note","start_index":331,"tongjian_id":"8d4436a7-db0e-11ef-9ad6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d4436a9-db0e-11ef-8c93-a0d3651f611f"},{"people_name":"漢高帝","people_name_jianti_auto":"汉高帝","start_index":26,"tongjian_id":"8d4436aa-db0e-11ef-a41f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":3,"tongjian_id":"8d4436ab-db0e-11ef-8f99-a0d3651f611f"},{"place_name":"新豐縣","place_name_jianti_auto":"新丰县","start_index":5,"tongjian_id":"8d4436ac-db0e-11ef-aa73-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":9,"tongjian_id":"8d4436ad-db0e-11ef-aac8-a0d3651f611f"},{"place_name":"驪邑","place_name_jianti_auto":"骊邑","start_index":11,"tongjian_id":"8d4436ae-db0e-11ef-9978-a0d3651f611f"},{"place_name":"驪戎國","place_name_jianti_auto":"骊戎国","start_index":15,"tongjian_id":"8d4436af-db0e-11ef-b741-a0d3651f611f"},{"place_name":"驪山","place_name_jianti_auto":"骊山","start_index":20,"tongjian_id":"8d4436b0-db0e-11ef-931e-a0d3651f611f"},{"place_name":"新豐","place_name_jianti_auto":"新丰","start_index":34,"tongjian_id":"8d4436b1-db0e-11ef-933c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，京兆新豐縣，秦之驪邑，古驪戎國也；驪山在其南。漢高帝七年，更名新豐。驪，呂支翻。還，從宣翻，又音如字。更，工衡翻。","note_content_jianti_auto":"班志，京兆新丰县，秦之骊邑，古骊戎国也；骊山在其南。汉高帝七年，更名新丰。骊，吕支翻。还，从宣翻，又音如字。更，工衡翻。","note_type":"hu_note","start_index":355,"tongjian_id":"8d4436a8-db0e-11ef-81b4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"客卿","official_note":"客卿是战国时期秦国授予外来士人的官职，负责参与国政和外交，此处李斯担任此职，表明他作为外来人才在秦国的地位，后因逐客令被逐，但最终被秦王召回并复官。","official_rank":"未知","source_snippet":"客卿楚人李斯亦在逐中","start_index":39,"tongjian_id":"0dab17b9-a070-466c-bc82-a4709ad08343"}],"ExtRef_Children_people":[{"link_birth_year":-280,"link_death_year":-208,"link_td_description":"李斯，楚国上蔡人，秦朝政治家、文学家和书法家，法家学说代表人物。曾任秦朝左丞相。","link_td_id":"Q10008012","link_td_number_id":13760,"people_name":"李斯","people_name_jianti_auto":"李斯","people_xingming":"李斯","start_index":42,"tongjian_id":"8d4436b4-db0e-11ef-afce-a0d3651f611f"},{"link_birth_year":-705,"link_death_year":-621,"link_td_description":"秦穆公，嬴姓，名任好，春秋时代秦国国君，在位三十九年（前659年－前621年），谥号穆，在《史记》中被认定为春秋五霸之一。","link_td_id":"Q10001800","link_td_number_id":278037,"people_name":"穆公","people_name_jianti_auto":"穆公","people_xingming":"嬴任好","start_index":58,"tongjian_id":"8d4436b5-db0e-11ef-a12d-a0d3651f611f","wl_zhushi":"[嬴任好]"},{"link_td_description":"由余，中国春秋时期帮助秦穆公成为霸主的大臣之一，原是中原晋国人，后奔入西戎成为绵诸国的大臣。","link_td_id":"Q10008326","link_td_number_id":208124,"people_name":"由余","people_name_jianti_auto":"由余","people_xingming":"由余","start_index":65,"tongjian_id":"8d4436b6-db0e-11ef-8f4f-a0d3651f611f"},{"link_birth_year":-725,"link_death_year":-621,"link_td_description":"百里奚，字井伯，百里氏，名奚，也称百里傒、百里子，世人称其为五羖大夫，春秋时代秦国著名政治家，虞国（今山西平陆北）人，原为虞国大夫。其子为孟明视。","link_td_id":"Q10001249","link_td_number_id":590959,"people_name":"百里","people_name_jianti_auto":"百里","people_xingming":"百里奚","start_index":72,"tongjian_id":"8d4436b7-db0e-11ef-9b29-a0d3651f611f"},{"link_td_description":"蹇叔，春秋时代秦国上大夫。宋国人，因与百里奚友善，曾多次使百里奚得脱于难，百里奚推荐其有大才，秦穆公拜之为上大夫。","link_td_id":"Q10012802","link_td_number_id":1508317,"people_name":"蹇叔","people_name_jianti_auto":"蹇叔","people_xingming":"蹇叔","start_index":78,"tongjian_id":"8d4436b9-db0e-11ef-b194-a0d3651f611f"},{"link_td_description":"丕豹，春秋时期晋国大夫丕郑之子，后投奔秦国，成为秦穆公的臣下。","link_td_id":"Q10015182","link_td_number_id":3365170,"people_name":"丕豹","people_name_jianti_auto":"丕豹","people_xingming":"丕豹","start_index":84,"tongjian_id":"8d4436ba-db0e-11ef-9198-a0d3651f611f"},{"link_td_description":"公孙枝，字子桑，岐人，为现今桑姓之先祖。","link_td_id":"Q10003571","link_td_number_id":2737210,"people_name":"公孫支","people_name_jianti_auto":"公孙支","people_xingming":"公孙支","start_index":87,"tongjian_id":"8d4436bb-db0e-11ef-8f93-a0d3651f611f"},{"link_birth_year":-382,"link_death_year":-338,"link_td_description":"秦孝公，战国时期秦国君主，秦献公之子，前362年－前338年在位，在位共25年。","link_td_id":"Q10001805","link_td_number_id":139181,"people_name":"孝公","people_name_jianti_auto":"孝公","people_xingming":"嬴渠梁","start_index":103,"tongjian_id":"8d4436bf-db0e-11ef-83f8-a0d3651f611f","wl_zhushi":"[嬴渠梁]"},{"link_birth_year":-390,"link_death_year":-338,"link_td_description":"商鞅（前390年—前338年），又称卫鞅或公孙鞅，是战国中期卫国人，公元前4世纪的重要政治家和军事家，也是法家代表人物之一，师从李悝。","link_td_id":"Q10000225","link_td_number_id":5851,"people_name":"商鞅","people_name_jianti_auto":"商鞅","people_xingming":"商鞅","start_index":106,"tongjian_id":"8d4436c0-db0e-11ef-ae3f-a0d3651f611f"},{"link_birth_year":-356,"link_death_year":-311,"link_td_description":"秦惠文王，又称秦惠王或秦惠文君，嬴姓，考古名骃，传世名驷，秦孝公之子，称王前为伯爵，称秦伯骃或秦伯驷。在位期间称王，秦国称王自嬴驷始，并重用樗里疾、张仪等人。","link_td_id":"Q10001806","link_td_number_id":176314,"people_name":"惠王","people_name_jianti_auto":"惠王","people_xingming":"嬴驷","start_index":121,"tongjian_id":"8d4436c1-db0e-11ef-8ab7-a0d3651f611f","wl_zhushi":"[嬴驷]"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":124,"tongjian_id":"8d4436c2-db0e-11ef-9889-a0d3651f611f"},{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"昭王","people_name_jianti_auto":"昭王","people_xingming":"嬴稷","start_index":140,"tongjian_id":"8d4436c3-db0e-11ef-bcba-a0d3651f611f","wl_zhushi":"[嬴稷]"},{"link_deat