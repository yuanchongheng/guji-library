rt_index":173,"tongjian_id":"8c021ac1-db0e-11ef-a15f-a0d3651f611f"},{"people_name":"改","people_name_jianti_auto":"改","start_index":182,"tongjian_id":"8c021ac2-db0e-11ef-97c1-a0d3651f611f"},{"people_name":"獻公","people_name_jianti_auto":"献公","start_index":184,"tongjian_id":"8c021ac3-db0e-11ef-8e74-a0d3651f611f"},{"people_name":"出子","people_name_jianti_auto":"出子","start_index":188,"tongjian_id":"8c021ac4-db0e-11ef-b8a3-a0d3651f611f"},{"people_name":"獻公","people_name_jianti_auto":"献公","start_index":209,"tongjian_id":"8c021ac5-db0e-11ef-8b53-a0d3651f611f"},{"people_name":"靈公","people_name_jianti_auto":"灵公","start_index":232,"tongjian_id":"8c021ac6-db0e-11ef-ac59-a0d3651f611f"},{"people_name":"獻公","people_name_jianti_auto":"献公","start_index":237,"tongjian_id":"8c021ac7-db0e-11ef-8d61-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":1,"tongjian_id":"8c021ac8-db0e-11ef-97c4-a0d3651f611f"},{"place_name":"西","place_name_jianti_auto":"西","start_index":195,"tongjian_id":"8c021ac9-db0e-11ef-9526-a0d3651f611f"},{"place_name":"秦州","place_name_jianti_auto":"秦州","start_index":198,"tongjian_id":"8c021aca-db0e-11ef-82eb-a0d3651f611f"},{"place_name":"西縣","place_name_jianti_auto":"西县","start_index":200,"tongjian_id":"8c021acb-db0e-11ef-bb1f-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":203,"tongjian_id":"8c021acc-db0e-11ef-aa60-a0d3651f611f"},{"place_name":"西縣","place_name_jianti_auto":"西县","start_index":212,"tongjian_id":"8c021acd-db0e-11ef-8366-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","start_index":224,"tongjian_id":"8c021ace-db0e-11ef-a808-a0d3651f611f"},{"place_name":"西縣","place_name_jianti_auto":"西县","start_index":228,"tongjian_id":"8c021acf-db0e-11ef-9321-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","start_index":245,"tongjian_id":"8c021ad0-db0e-11ef-8733-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","place_note":"甘肃中部","start_index":248,"tongjian_id":"8c021ad1-db0e-11ef-ae1c-a0d3651f611f"},{"place_name":"黃河","place_name_jianti_auto":"黄河","start_index":252,"tongjian_id":"8c021ad2-db0e-11ef-ac8a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":258,"tongjian_id":"8c021ad3-db0e-11ef-8370-a0d3651f611f"},{"place_name":"涼州","place_name_jianti_auto":"凉州","start_index":259,"tongjian_id":"8c021ad4-db0e-11ef-85c8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後秦制爵，一級曰公士，二上造，三簪裊，四不更，五大夫，六官大夫，七公大夫，八公乘，九五大夫，十左庶長，十一右庶長，十二左更，十三中更，十四右更，十五少上造，十六大上造，十七駟車庶長，十八大庶長，十九關內侯，二十徹侯。師古曰：庶長，言衆列之長。註又詳見下卷顯王十年前。據史記：威烈王十一年秦靈公卒，子獻公師隰不得立，立靈公季父悼子，是爲簡公。出子，簡公之孫也。今庶長改迎獻公而殺出子。正義曰：西者，秦州西縣，秦之舊地。時獻公在西縣，故迎立之。余謂此言河西，非西縣也。靈公之卒，獻公不得立，出居河西；河西者，黃河之西，蓋漢涼州之地。「裊」，當作「褭」，乃了翻。更，工衡翻。乘，繩證翻。長，知丈翻。","note_content_jianti_auto":"后秦制爵，一级曰公士，二上造，三簪袅，四不更，五大夫，六官大夫，七公大夫，八公乘，九五大夫，十左庶长，十一右庶长，十二左更，十三中更，十四右更，十五少上造，十六大上造，十七驷车庶长，十八大庶长，十九关内侯，二十彻侯。师古曰：庶长，言众列之长。注又详见下卷显王十年前。据史记：威烈王十一年秦灵公卒，子献公师隰不得立，立灵公季父悼子，是为简公。出子，简公之孙也。今庶长改迎献公而杀出子。正义曰：西者，秦州西县，秦之旧地。时献公在西县，故迎立之。余谓此言河西，非西县也。灵公之卒，献公不得立，出居河西；河西者，黄河之西，盖汉凉州之地。「袅」，当作「褭」，乃了翻。更，工衡翻。乘，绳证翻。长，知丈翻。","note_type":"hu_note","start_index":27,"tongjian_id":"8c021ab6-db0e-11ef-b1cb-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"庶長","official_note":"庶長是秦國早期的官職，主要負責軍事和行政事務，常由貴族擔任，在戰國時期權力較大。在此上下文中，庶長改參與了廢立秦獻公的事件，顯示其政治影響力。此信息基於《資治通鑑》記載和戰國秦國官制常識。","official_rank":"未知","source_snippet":"秦庶長改逆獻公于河西而立之","start_index":1,"tongjian_id":"baf0d20b-9a01-438d-9d52-e865efbe8eb7"}],"ExtRef_Children_people":[{"link_birth_year":-424,"link_death_year":-362,"link_td_description":"秦献公，嬴姓，战国时期秦国君主，秦灵公之子，在位23年。","link_td_id":"Q10001804","link_td_number_id":176315,"people_name":"獻公","people_name_jianti_auto":"献公","people_xingming":"嬴师隰","start_index":6,"tongjian_id":"8c04670a-db0e-11ef-9e61-a0d3651f611f","wl_zhushi":"[嬴师隰]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1秦庶長改逆獻公于河西而立之；殺出子及其母，沈之淵旁。","content_fanyi":"秦国庶长改到河西迎接秦灵公的儿子，把他拥立为国君，即秦献公；随后杀死出子及其母亲，把尸体沉入深潭。","content_jianti_auto":"1秦庶长改逆献公于河西而立之；杀出子及其母，沈之渊旁。","dtjl_paragraph_links":[],"dtjl_references":[],"id":67,"number":1,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 十七年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c021ab5-db0e-11ef-8379-a0d3651f611f","year_int":-385},"tongjian_id":"8c021ab5-db0e-11ef-8379-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"堯","people_name_jianti_auto":"尧","start_index":56,"tongjian_id":"8c1dc70c-db0e-11ef-a960-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"馮翊","place_name_jianti_auto":"冯翊","start_index":4,"tongjian_id":"8c1dc70d-db0e-11ef-8ab7-a0d3651f611f"},{"place_name":"雲陽縣","place_name_jianti_auto":"云阳县","start_index":6,"tongjian_id":"8c1dc70e-db0e-11ef-8d8b-a0d3651f611f"},{"place_name":"石門山","place_name_jianti_auto":"石门山","start_index":10,"tongjian_id":"8c1dc70f-db0e-11ef-8c73-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":19,"tongjian_id":"8c1dc710-db0e-11ef-be36-a0d3651f611f"},{"place_name":"三原縣","place_name_jianti_auto":"三原县","start_index":21,"tongjian_id":"8c1dc711-db0e-11ef-ad7a-a0d3651f611f"},{"place_name":"堯門山","place_name_jianti_auto":"尧门山","start_index":34,"tongjian_id":"8c1dc712-db0e-11ef-b893-a0d3651f611f"},{"place_name":"石門","place_name_jianti_auto":"石门","start_index":40,"tongjian_id":"8c1dc713-db0e-11ef-b919-a0d3651f611f"},{"place_name":"石門縣","place_name_jianti_auto":"石门县","start_index":74,"tongjian_id":"8c1dc714-db0e-11ef-adc7-a0d3651f611f"},{"place_name":"雲陽縣","place_name_jianti_auto":"云阳县","start_index":82,"tongjian_id":"8c1dc715-db0e-11ef-a2af-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"水經註：馮翊雲陽縣有石門山。括地志：在雍州三原縣西北三十二里。又曰：堯門山，俗名石門，上有路，其狀若門。故老云：堯鑿山爲門，因名之。武德中於此山南置石門縣，貞觀中改雲陽縣。","note_content_jianti_auto":"水经注：冯翊云阳县有石门山。括地志：在雍州三原县西北三十二里。又曰：尧门山，俗名石门，上有路，其状若门。故老云：尧凿山为门，因名之。武德中于此山南置石门县，贞观中改云阳县。","note_type":"hu_note","start_index":13,"tongjian_id":"8c1dc70b-db0e-11ef-b8d5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":22,"tongjian_id":"8c1dc719-db0e-11ef-a4ce-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"黼者，刺繡爲斧形；黻者，刺繡爲兩「己」相背。孔穎達曰：白與黑謂之黼，黑與青謂之黻。黼，音甫。黻，音弗。","note_content_jianti_auto":"黼者，刺绣为斧形；黻者，刺绣为两「己」相背。孔颖达曰：白与黑谓之黼，黑与青谓之黻。黼，音甫。黻，音弗。","note_type":"hu_note","start_index":26,"tongjian_id":"8c1dc718-db0e-11ef-b039-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-424,"link_death_year":-362,"link_td_description":"秦献公，嬴姓，战国时期秦国君主，秦灵公之子，在位23年。","link_td_id":"Q10001804","link_td_number_id":176315,"people_name":"秦獻公","people_name_jianti_auto":"秦献公","people_xingming":"嬴师隰","start_index":1,"tongjian_id":"8c1dc71a-db0e-11ef-8209-a0d3651f611f","wl_zhushi":"[嬴师隰]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"又有浮山，在县北二十里。○嶻嶭山，在县西北四十里，与泾阳...","context_before":"...山亦名石门山，两崖峻险，途出其中。相传尧凿山为门，因名。","source_end_index":75,"source_paragraph_tongjian_id":"5db673fd-276c-54a1-86a3-b953f509e05a","source_start_index":53,"source_text":"周显王五年，秦献公败三晋之师于石门，盖即此。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、西安府下（卷五十四）","excerpts":[{"context_after":"今有石门巡司]。","context_before":"...。谓此也。或云唐石门县，盖以山名。今两山壁立，其状如门。","source_end_index":106,"source_paragraph_tongjian_id":"422659a0-d2d4-5e4a-bd1d-19f79bc02f5f","source_start_index":80,"source_text":"《史记》：秦献公二十二年，与晋战于石门。疑即此地云。"}],"path":"陕西方舆纪要/二、西安府下（卷五十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦獻公敗三晉之師于石門，斬首六萬。王賜以黼黻之服。","content_fanyi":"秦献公率军在石门击败魏、韩、赵三国联军，斩首六万。周显王把绣有黑白、黑青相间黼黻花纹的礼服赏赐给秦献公。","content_jianti_auto":"1秦献公败三晋之师于石门，斩首六万。王赐以黼黻之服。","dtjl_paragraph_links":[],"dtjl_references":[],"id":118,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 五年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c1dc70a-db0e-11ef-b4ca-a0d3651f611f","year_int":-364},"tongjian_id":"8c1dc70a-db0e-11ef-b4ca-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"秦孝公发愤图强以改变秦国被孤立地位","decision_tongjian_id":"DECISION_8C1DC752DB0E11EF9AC7A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孝公","people_name_jianti_auto":"孝公","start_index":4,"tongjian_id":"8c1dc754-db0e-11ef-8747-a0d3651f611f"},{"people_name":"渠梁","people_name_jianti_auto":"渠梁","start_index":8,"tongjian_id":"8c1dc755-db0e-11ef-ba83-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：孝公，名渠梁。","note_content_jianti_auto":"索隐曰：孝公，名渠梁。","note_type":"hu_note","start_index":11,"tongjian_id":"8c1dc753-db0e-11ef-b3cb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":0,"tongjian_id":"8c1ffd56-db0e-11ef-8799-a0d3651f61