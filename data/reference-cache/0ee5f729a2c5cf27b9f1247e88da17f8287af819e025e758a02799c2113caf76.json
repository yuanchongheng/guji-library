ngjian_id":"8c1ffd67-db0e-11ef-83d1-a0d3651f611f"},{"place_name":"山","place_name_jianti_auto":"山","place_note":"华山","start_index":65,"tongjian_id":"8c1ffd68-db0e-11ef-8061-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"河自龍門上口，南抵華陰而東流，秦國在河之西。山自鳥鼠同穴連延爲長安南山，至於泰華，秦國在山之西。韓、魏、趙、齊、楚、燕六國皆在河、山以東。華，戶化翻。燕，因肩翻。","note_content_jianti_auto":"河自龙门上口，南抵华阴而东流，秦国在河之西。山自鸟鼠同穴连延为长安南山，至于泰华，秦国在山之西。韩、魏、赵、齐、楚、燕六国皆在河、山以东。华，户化翻。燕，因肩翻。","note_type":"hu_note","start_index":31,"tongjian_id":"8c1dc757-db0e-11ef-9968-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊威王","people_name_jianti_auto":"齐威王","start_index":64,"tongjian_id":"8c1ffd6a-db0e-11ef-8f4b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":0,"tongjian_id":"8c1ffd6b-db0e-11ef-ae47-a0d3651f611f"},{"place_name":"平氏縣","place_name_jianti_auto":"平氏县","start_index":3,"tongjian_id":"8c1ffd6c-db0e-11ef-b58b-a0d3651f611f"},{"place_name":"桐柏","place_name_jianti_auto":"桐柏","start_index":9,"tongjian_id":"8c201a43-db0e-11ef-bc8d-a0d3651f611f"},{"place_name":"大復山","place_name_jianti_auto":"大复山","start_index":12,"tongjian_id":"8c201a44-db0e-11ef-b6dc-a0d3651f611f"},{"place_name":"淮水","place_name_jianti_auto":"淮水","start_index":16,"tongjian_id":"8c201a45-db0e-11ef-bc8c-a0d3651f611f"},{"place_name":"淮陵","place_name_jianti_auto":"淮陵","start_index":24,"tongjian_id":"8c201a46-db0e-11ef-8b19-a0d3651f611f"},{"place_name":"泗水","place_name_jianti_auto":"泗水","start_index":29,"tongjian_id":"8c201a47-db0e-11ef-9abb-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":32,"tongjian_id":"8c201a48-db0e-11ef-8165-a0d3651f611f"},{"place_name":"卞縣","place_name_jianti_auto":"卞县","start_index":34,"tongjian_id":"8c201a49-db0e-11ef-8a8f-a0d3651f611f"},{"place_name":"沛","place_name_jianti_auto":"沛","start_index":43,"tongjian_id