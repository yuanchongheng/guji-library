jian_id":"8c20511d-db0e-11ef-9c71-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":112,"tongjian_id":"8c20511e-db0e-11ef-a748-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","place_note":"陝西延安","start_index":118,"tongjian_id":"8c20511f-db0e-11ef-bd21-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":121,"tongjian_id":"8c205120-db0e-11ef-aca6-a0d3651f611f"},{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":123,"tongjian_id":"8c205121-db0e-11ef-a43c-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":126,"tongjian_id":"8c205122-db0e-11ef-a75e-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":128,"tongjian_id":"8c205123-db0e-11ef-9491-a0d3651f611f"},{"place_name":"綏州","place_name_jianti_auto":"绥州","start_index":130,"tongjian_id":"8c205124-db0e-11ef-ba6b-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","start_index":133,"tongjian_id":"8c205125-db0e-11ef-8672-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府栎阳，陕西临潼","start_index":136,"tongjian_id":"8c205126-db0e-11ef-8a18-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":138,"tongjian_id":"8c205127-db0e-11ef-a662-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":140,"tongjian_id":"8c205128-db0e-11ef-a3ba-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄭縣，周宣王母弟鄭桓公封邑，班志屬京兆。洛，水名，非伊、洛之洛也。水經註：渭水東過華陰縣北，洛水入焉。洛水，古漆、沮之水也。又有長澗水，南出泰華之山側長城東而北流注於渭。史記所謂「魏築長城，自鄭濱洛」者也。宋白曰：今華州東南魏長城是也。上郡，漢屬幷州，隋、唐之綏州、延州，秦、漢之上郡地也。濱，音賓。","note_content_jianti_auto":"郑县，周宣王母弟郑桓公封邑，班志属京兆。洛，水名，非伊、洛之洛也。水经注：渭水东过华阴县北，洛水入焉。洛水，古漆、沮之水也。又有长涧水，南出泰华之山侧长城东而北流注于渭。史记所谓「魏筑长城，自郑滨洛」者也。宋白曰：今华州东南魏长城是也。上郡，汉属幷州，隋、唐之绥州、延州，秦、汉之上郡地也。滨，音宾。","note_type":"hu_note","start_index":64,"tongjian_id":"8c201a52-db0e-11ef-8f7f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Ch