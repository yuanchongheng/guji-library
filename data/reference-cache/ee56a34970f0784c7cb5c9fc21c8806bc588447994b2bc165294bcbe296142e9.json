x":54,"tongjian_id":"a4cdc612-db0e-11ef-b45f-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":57,"tongjian_id":"a4cdc613-db0e-11ef-b7d7-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":60,"tongjian_id":"a4cdc614-db0e-11ef-8fb3-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":72,"tongjian_id":"a4cdc615-db0e-11ef-9746-a0d3651f611f"},{"place_name":"上洛郡","place_name_jianti_auto":"上洛郡","start_index":77,"tongjian_id":"a4cdc616-db0e-11ef-9fc5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"置湖、陝二戍，見一百六卷孝武太元十一年。華山郡，晉分弘農之華陰、京兆之鄭、馮翊之夏陽、郃陽置。上洛縣，前漢屬弘農，後漢屬京兆；晉武帝泰始二年，分京兆南部置上洛郡。華，戶化翻。陝，失冉翻。","note_content_jianti_auto":"置湖、陕二戍，见一百六卷孝武太元十一年。华山郡，晋分弘农之华阴、京兆之郑、冯翊之夏阳、郃阳置。上洛县，前汉属弘农，后汉属京兆；晋武帝泰始二年，分京兆南部置上洛郡。华，户化翻。陕，失冉翻。","note_type":"hu_note","start_index":41,"tongjian_id":"a4cdc602-db0e-11ef-9fd2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"陝城","place_name_jianti_auto":"陕城","resolved_place_entity_id":1354,"start_index":30,"tongjian_id":"a4cff8b9-db0e-11ef-83b2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"义熙十二年，刘裕伐秦，前锋至成皋，秦将赵玄劝姚洸固守金墉...","context_before":"...太和五年，秦王猛克洛阳，使邓羌戍金墉。太元九年，复归晋。","source_end_index":322,"source_paragraph_tongjian_id":"2eefa106-9bee-5cd6-aee2-390e57139a5a","source_start_index":285,"source_text":"隆安初，姚兴遣姚崇寇洛阳，河南太守夏侯宗之固守金墉，崇不能克。久之，始陷。"},{"context_after":"后魏县废而城存。魏主修避高欢，西奔关中，至湖城。隋义宁二...","context_before":"...七年，河南太守杨涘期军于湖城，击苻登将窦冲于华阴，走之。","source_end_index":198,"source_paragraph_tongjian_id":"68a9bbee-55d5-5141-b290-277a1dae6a9e","source_start_index":176,"source_text":"隆安初，姚兴寇湖城，弘农、华山二郡皆降于兴。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"义熙十二年，刘裕伐秦，前锋至成皋，秦将赵玄劝姚洸固守金墉...","context_before":"...太和五年，秦王猛克洛阳，使邓羌戍金墉。太元九年，复归晋。","source_end_index":322,"source_paragraph_tongjian_id":"4b4c8807-d301-51ba-9ce5-1fd8de43d9c6","source_start_index":285,"source_text":"隆安初，姚兴遣姚崇寇洛阳，河南太守夏侯宗之固守金墉，崇不能克。久之，始陷。"},{"context_after":"后魏县废而城存。魏主修避高欢，西奔关中，至湖城。隋义宁二...","context_before":"...七年，河南太守杨涘期军于湖城，击苻登将窦冲于华阴，走之。","source_end_index":198,"source_paragraph_tongjian_id":"62b1979f-23f1-5c4f-baf7-de2fa25fd014","source_start_index":176,"source_text":"隆安初，姚兴寇湖城，弘农、华山二郡皆降于兴。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"23秦主興入寇湖城，弘農太守陶仲山、華山太守董邁皆降之；遂至陝城，進寇上洛，拔之。遣姚崇寇洛陽，河南太守夏侯宗之固守金墉，崇攻之不克，乃徙流民二萬餘戶而還。","content_fanyi":"后秦主姚兴率军侵入东晋的湖城，东晋弘农太守陶仲山、华山太守董迈都投降了他；后秦军队随即抵达陕城，又进犯上洛，并将其攻克。姚兴派遣姚崇进犯洛阳，河南太守夏侯宗之固守金墉，姚崇攻打不下，于是裹挟迁移流民二万余户撤回。","content_jianti_auto":"23秦主兴入寇湖城，弘农太守陶仲山、华山太守董迈皆降之；遂至陕城，进寇上洛，拔之。遣姚崇寇洛阳，河南太守夏侯宗之固守金墉，崇攻之不克，乃徙流民二万余户而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9772,"number":23,"path":"资治通鉴 : 卷第一百九 (晉紀三十一) / 安皇帝甲 / 隆安元年 / 第 66 段","reading_annotation_sources":[],"start_index":65,"tongjian_id":"a4cdc601-db0e-11ef-a96d-a0d3651f611f","year_int":397},"tongjian_id":"a4cdc601-db0e-11ef-a96d-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":2,"total_paragraphs":19},"place_name":"陝城"},"message":"success","success":true}