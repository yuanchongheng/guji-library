b8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，安徽寿县","resolved_place_entity_id":130,"start_index":4,"tongjian_id":"8d628b7c-db0e-11ef-8469-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","resolved_place_entity_id":130,"start_index":24,"tongjian_id":"8d628b7e-db0e-11ef-858a-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，安徽寿县","resolved_place_entity_id":130,"start_index":99,"tongjian_id":"8d628b86-db0e-11ef-9bb7-a0d3651f611f"},{"place_name":"頻陽","place_name_jianti_auto":"频阳","place_note":"陝西富平","resolved_place_entity_id":2769,"start_index":107,"tongjian_id":"8d628b87-db0e-11ef-bb47-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭楚之战","tongjian_id":"war_N0548"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"汉亦为频阳县，属左冯翊。更始初，邓晔遣其属王宪为校尉，将...","context_before":"...县东北六十里。秦厉公二十一年，初县频阳，以在频水南而名。","source_end_index":51,"source_paragraph_tongjian_id":"ac80ab2f-f859-5ec6-9d3c-0e0b0abb0c2f","source_start_index":33,"source_text":"始皇二十一年，王翦谢病归频阳，即此。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"2王賁伐楚，取十餘城。王問於將軍李信曰：「吾欲取荊，於將軍度用幾何人而足？」李信曰：「不過用二十萬。」王以問王翦，王翦曰：「非六十萬人不可。」王曰：「王將軍老矣，何怯也！」遂使李信、蒙恬將二十萬人伐楚；王翦因謝病歸頻陽。","content_fanyi":"秦将王贲进攻楚国，攻取十余座城邑。秦王政询问将军李信说：“我想要夺取楚国，你估计需要动用多少人才足够？”李信说：“不超过二十万人。”秦王政又拿这个问题询问王翦，王翦说：“非得六十万大军不可。”秦王政说：“王将军已经老了，怎么这样胆怯啊！”于是派李信、蒙恬率领二十万人进攻楚国；王翦便称病辞职，返回故乡频阳。","content_jianti_auto":"2王贲伐楚，取十余城。王问于将军李信曰：「吾欲取荆，于将军度用几何人而足？」李信曰：「不过用二十万。」王以问王翦，王翦曰：「非六十万人不可。」王曰：「王将军老矣，何怯也！」遂使李信、蒙恬将二十万人伐楚；王翦因谢病归频阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":532,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8d60415a-db0e-11ef-9eb0-a0d3651f611f"}],"reign_name":"二十一年","reign_name_jianti_auto":"二十一年","start_index":1,"tongjian_id":"8d604143-db0e-11ef-ba5d-a0d3651f611f","year_anno":"（乙亥、前二二六）","year_int":-226},"message":"success","success":true}