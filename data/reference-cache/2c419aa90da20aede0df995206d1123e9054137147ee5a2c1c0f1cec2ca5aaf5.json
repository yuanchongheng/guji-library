d62643a-db0e-11ef-b5bb-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":43,"tongjian_id":"8d62643b-db0e-11ef-b209-a0d3651f611f"},{"place_name":"頻陽縣","place_name_jianti_auto":"频阳县","start_index":44,"tongjian_id":"8d62643c-db0e-11ef-bbe5-a0d3651f611f"},{"place_name":"頻陽山","place_name_jianti_auto":"频阳山","start_index":65,"tongjian_id":"8d62643d-db0e-11ef-a29f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"王翦，頻陽人也。班志，頻陽縣屬京兆，秦厲公所置。應劭註曰：縣在頻水之陽。杜佑曰：美陽本漢頻陽縣，故城在縣西南三十里。宋白曰：因界內頻陽山而名。","note_content_jianti_auto":"王翦，频阳人也。班志，频阳县属京兆，秦厉公所置。应劭注曰：县在频水之阳。杜佑曰：美阳本汉频阳县，故城在县西南三十里。宋白曰：因界内频阳山而名。","note_type":"hu_note","start_index":110,"tongjian_id":"8d62642f-db0e-11ef-a670-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"將軍","official_note":"將軍是古代高级军事指挥官，负责统率军队作战。在《资治通鉴》此段中，秦王询问将军李信关于伐楚所需兵力，显示将军在军事决策中的关键角色。此信息基于历史常识。","official_rank":"高级将领","source_snippet":"王問於將軍李信曰","start_index":12,"tongjian_id":"7b5be8a0-7b4a-4716-b026-f1450080f963"}],"ExtRef_Children_people":[{"link_td_description":"王贲，频阳东乡（今陕西省富平县东北）人，秦代将领，通武侯，为名将王翦之子。在秦灭六国战争中，先后灭亡魏、燕、代、齐。","link_td_id":"Q10004662","link_td_number_id":326240,"people_name":"王賁","people_name_jianti_auto":"王贲","people_xingming":"王贲","start_index":1,"tongjian_id":"8d628b7b-db0e-11ef-bbab-a0d3651f611f"},{"link_td_description":"李信，字有成，槐里（今陕西咸阳兴平东）人，战国时代末期秦国的将军。先是跟随王翦在秦灭赵之战有功，之后领兵二十万攻打楚国，先是一路凯歌，后被楚将项燕大败。之后在秦灭燕之战中击败燕王喜立有大功，为汉飞将军李广的五世祖。","link_td_id":"Q10008870","link_td_number_id":427843,"people_name":"李信","people_name_jianti_auto":"李信","people_xingming":"李信","start_index":16,"tongjian_id":"8d628b7d-db0e-11ef-874a-a0d3651f611f"},{"link_td_description":"李信，字有成，槐里（今陕西咸阳兴平东）人，战国时代末期秦国的将军。先是跟随王翦在秦灭赵之战有功，之后领兵二十万攻打楚国，先是一路凯歌，后被楚将项燕大败。之后在秦灭燕之战中击败燕王喜立有大功，为汉飞将军李广的五世祖。","link_td_id":"Q10008870","link_td_number_id":427843,"people_name":"李信","people_name_jianti_auto":"李信","start_index":38,"tongjian_id":"8d628b7f-db0e-11ef-b