0e-11ef-8ca6-a0d3651f611f"},{"place_name":"遼東","place_name_jianti_auto":"辽东","place_note":"遼寧遼陽","resolved_place_entity_id":281,"start_index":22,"tongjian_id":"8d604154-db0e-11ef-b47c-a0d3651f611f"},{"place_name":"衍水","place_name_jianti_auto":"衍水","place_note":"辽宁辽阳市东北太子河","resolved_place_entity_id":9101,"start_index":49,"tongjian_id":"8d604157-db0e-11ef-91b1-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭燕之战","tongjian_id":"war_N0547"},{"title":"秦灭赵之战","tongjian_id":"war_N0546"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、辽东行都司（卷三十七）","excerpts":[{"context_after":"]。","context_before":"...马懿斩公孙渊父子于梁水之上，即此。或曰：太子河即故衍水，","source_end_index":106,"source_paragraph_tongjian_id":"f8d0940c-a690-53b1-87f3-7c7ff7474089","source_start_index":88,"source_text":"燕太子丹匿于衍水中，后人因名为太子河"}],"path":"山东方舆纪要/八、辽东行都司（卷三十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1冬，十月，王翦拔薊，燕王及太子率其精兵東保遼東，李信急追之。代王嘉遺燕王書，令殺太子丹以獻。丹匿衍水中，燕王使使斬丹，欲以獻王，王復進兵攻之。","content_fanyi":"冬季，十月，秦将王翦攻克燕国都城蓟城，燕王喜与太子丹带领本部精兵往东退守辽东，秦将李信领兵急速追击。代王赵嘉送信给燕王喜，让他杀掉太子丹以献给秦王。太子丹隐匿在衍水一带，燕王喜便派使臣到那里斩杀了太子丹，准备拿他的首级献给秦王政，但秦王政又继续发兵攻打燕国。","content_jianti_auto":"1冬，十月，王翦拔蓟，燕王及太子率其精兵东保辽东，李信急追之。代王嘉遗燕王书，令杀太子丹以献。丹匿衍水中，燕王使使斩丹，欲以献王，王复进兵攻之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":531,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d604145-db0e-11ef-bc20-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"伐楚兵力估算（二次咨询）","decision_tongjian_id":"DECISION_8D60415ADB0E11EF9EB0A0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"莊襄王","people_name_jianti_auto":"庄襄王","start_index":2,"tongjian_id":"8d62642a-db0e-11ef-8bb5-a0d3651f611f"},{"people_name":"楚","people_name_jianti_auto":"楚","start_index":6,"tongjian_id":"8d62642b-db