f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3韓昭侯以申不害爲相。","content_fanyi":"韩昭侯任命申不害为国相。","content_jianti_auto":"3韩昭侯以申不害为相。","dtjl_paragraph_links":[],"dtjl_references":[],"id":149,"number":3,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c2b9d62-db0e-11ef-afb6-a0d3651f611f","year_int":-351},"tongjian_id":"8c2b9d62-db0e-11ef-afb6-a0d3651f611f"},"paragraph_order":2},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃","people_name_jianti_auto":"黄","start_index":0,"tongjian_id":"8c2df145-db0e-11ef-bf6f-a0d3651f611f"},{"people_name":"老","people_name_jianti_auto":"老","start_index":2,"tongjian_id":"8c2df146-db0e-11ef-b758-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":4,"tongjian_id":"8c2df147-db0e-11ef-a663-a0d3651f611f"},{"people_name":"老子","people_name_jianti_auto":"老子","start_index":7,"tongjian_id":"8c2df148-db0e-11ef-96fe-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"黃、老，黃帝、老子之書。","note_content_jianti_auto":"黄、老，黄帝、老子之书。","note_type":"hu_note","start_index":24,"tongjian_id":"8c2df144-db0e-11ef-ac5f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期诸侯国的最高行政长官，负责辅佐君主处理政务。在《资治通鉴》此段中，申不害被韩昭侯任命为相，表明他成为韩国的核心官员，负责内政外交，如原文所述“内修政敎，外應諸侯”。","official_rank":"未知","source_snippet":"昭侯用爲相","start_index":24,"tongjian_id":"36774516-a98a-4c37-a2db-cec4b000e7da"}],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","people_xingming":"韩昭侯","start_index":21,"tongjian_id":"8c2df14d-db0e-11ef-9e36-a0d3651f611f"},{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","start_index":24,"tongjian_id":"8c2df14f-db0e-11ef-9e2b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"申不害者，鄭之賤臣也，學黃、老、刑名，以干昭侯。昭侯用爲相，內修政敎，外應諸侯，十五年，終申子之身，國治兵強。","content_fanyi":"申不害原是郑国的一介低级官吏，修习黄帝、老子和法家刑名之学，前去游说韩昭侯求取官职。韩昭侯任命他为国相，对内整饬政治教化，对外结交诸侯。申不害任相十五年间，直到去世，韩国政治清明，军队强大。","content_jianti_auto":"申不害者，郑之贱臣也，学黄、老、刑名，以干昭侯。昭侯用为相，内修政教，外应诸侯，十五年，终申子之身，国治兵强。","dtjl_paragraph_links":[],"dtjl_references":[],"id":150,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c2df143-db0e-11ef-a12e-a0d3651f611f","year_int":-351},"tongjian_id":"8c2df143-db0e-11ef-a12e-a0d3651f611f"},"paragraph_order":3},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，才用翻；羣從之從同。","note_content_jianti_auto":"从，才用翻；群从之从同。","note_type":"hu_note","start_index":9,"tongjian_id":"8c2df152-db0e-11ef-9de5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","people_xingming":"韩昭侯","start_index":9,"tongjian_id":"8c2df156-db0e-11ef-8314-a0d3651f611f"},{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","start_index":20,"tongjian_id":"8c2df158-db0e-11ef-91ea-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"申子嘗請仕其從兄，昭侯不許，申子有怨色。昭侯曰：「所爲學於子者，欲以治國也。今將聽子之謁而廢子之術乎，已其行子之術而廢子之請乎？子嘗敎寡人修功勞，視次第；今有所私求，我將奚聽乎？」申子乃辟舍請罪曰：「君眞其人也！」","content_fanyi":"申不害曾经替堂兄请求官职，韩昭侯没有答应，申不害脸上露出怨色。韩昭侯说：“我之所以向先生学习，是想用来治理国家。现在我是听从您的请托而废弃您的法术呢，还是实行您的法术而废弃您的请求呢？先生曾经教导我奖励建功立业的人，按照能力大小和功劳等第来任用；如今您却有私人的请求，我该听从哪一种呢？”申不害于是离开座席，向韩昭侯请罪说：“主君真是一位能践行刑名学说的好国君啊！”}","content_jianti_auto":"申子尝请仕其从兄，昭侯不许，申子有怨色。昭侯曰：「所为学于子者，欲以治国也。今将听子之谒而废子之术乎，已其行子之术而废子之请乎？子尝教寡人修功劳，视次第；今有所私求，我将奚听乎？」申子乃辟舍请罪曰：「君真其人也！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":151,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"8c2df151-db0e-11ef-bc00-a0d3651f611f","year_int":-351},"tongjian_id":"8c2df151-db0e-11ef-bc00-a0d3651f611f"},"paragraph_order":4},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昭侯","people_name_jianti_auto":"昭侯","start_index":30,"tongjian_id":"8c2df15d-db0e-11ef-991a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言袴雖弊，其直猶重，固不止於嚬咲也。然人主之嚬咲，所關甚大，昭侯姑以此爲言耳。爲，于僞翻。嚬，與顰同，愁蹙之貌。咲，古笑字。","note_content_jianti_auto":"言袴虽弊，其直犹重，固不止于嚬咲也。然人主之嚬咲，所关甚大，昭侯姑以此为言耳。为，于伪翻。嚬，与颦同，愁蹙之貌。咲，古笑字。","note_type":"hu_note","start_index":72,"tongjian_id":"8c2df15c-db0e-11ef-98ac-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","people_xingming":"韩昭侯","start_index":0,"tongjian_id":"8c2df15e-db0e-11ef-b047-a0d3651f611f"},{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"昭侯","people_name_jianti_auto":"昭侯","start_index":31,"tongjian_id":"8c2df15f-db0e-11ef-b17a-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c2df15a-db0e-11ef-b19a-a0d3651f611f","pinyin":"kù","source_anchor_text":"昭侯有弊袴命藏之侍","source_key":"baiyang_epub","start_index":4,"text":"袴","tongjian_id":"a2b5a230-38ef-5b79-8cf8-578b0bdff025"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c2df15a-db0e-11ef-b19a-a0d3651f611f","pinyin":"pín","source_anchor_text":"明主愛一嚬一咲嚬有","source_key":"baiyang_epub","start_index":42,"text":"嚬","tongjian_id":"51502f9d-7ef3-528d-b0f2-1b6c6e8ac41f"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c2df15a-db0e-11ef-b19a-a0d3651f611f","pinyin":"xiào","source_anchor_text":"愛一嚬一咲嚬有為嚬","source_key":"baiyang_epub","start_index":44,"text":"咲","tongjian_id":"667c2f67-9f5f-56f3-80f4-73e2a337f9fb"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"昭侯有弊袴，命藏之。侍者曰：「君亦不仁者矣，不賜左右而藏之！」昭侯曰：「吾聞明主愛一嚬一咲，嚬有爲嚬，咲有爲咲。今袴豈特嚬咲哉！吾必待有功者。」","content_fanyi":"韩昭侯有一条破旧裤子，命人把它收藏起来。侍从说：“主君也太吝惜了，不赏给身边的侍从，反而收藏起来！”韩昭侯说：“我听说贤明的君主爱惜一次皱眉、一次微笑，皱眉有该皱眉的事，微笑有该微笑的事。现在这条旧裤子哪里是一次皱眉、一次微笑所能比的呢！我一定要把它赏给有功劳的人。”","content_jianti_auto":"昭侯有弊袴，命藏之。侍者曰：「君亦不仁者矣，不赐左右而藏之！」昭侯曰：「吾闻明主爱一嚬一咲，嚬有为嚬，咲有为咲。今袴岂特嚬咲哉！吾必待有功者。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":152,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十八年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"8c2df15a-db0e-11ef-b19a-a0d3651f611f","year_int":-351,"zhang_TJZJ_id":"zttjzj_000364"},"tongjian_id":"8c2df15a-db0e-11ef-b19a-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"許愼","people_name_jianti_auto":"许愼","start_index":0,"tongjian_id":"8c372ca7-db0e-11ef-b235-a0d3651f611f"},{"people_name":"屈宜臼","people_name_jianti_auto":"屈宜臼","start_index":4,"tongjian_id":"8c372ca8-db0e-11ef-9f0e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":8,"tongjian_id":"8c372ca9-db0e-11ef-8c3d-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":14,"tongjian_id":"8c372caa-db0e-11ef-aef4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"許愼曰：屈宜臼，楚大夫，時在韓。屈，九勿翻。","note_content_jianti_auto":"许愼曰：屈宜臼，楚大夫，时在韩。屈，九勿翻。","note_type":"hu_note","start_index":21,"tongjian_id":"8c372ca6-db0e-11ef-b8b1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":11,"chapter_name":"治術篇第十一","chenzhu_chapter":"治術者致治之術，即身之之政论也。身之生平不喜滕口说，不喜上书言时事，国变以後，尤与政治绝缘。然其注《通鉴》，不能舍政治不谈，且有时陈古证今，谈言微中，颇得风人之旨，知其未尝忘情政治也。《表微》初拟立《君道》、《相业》诸篇，今特删併于《治術》，亦不多尚空言之意耳。","chenzhu_index_in_chapter":1,"chenzhu_text":"此盖为宋徽宗言之。《泊宅编》言：“崇、观以来，天下珍异，悉归禁中，四方梯航，殆无虚日，大则宠以爵禄，其次锡赉称是。宣和五年，平江府朱[img:Image00076.jpg] 造巨舰，载太湖石一块至京，以千人舁进，役夫各赐银碗并官，其四僕皆承节郎及金带，[img:Image00024.jpg] 遂为威远军节度使，而封石为槃固侯。”是时辽夏交侵，金人亦乘机思动，国家多难而势诎，政府渺不恤民，而举事反若有赢馀也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH11-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":6,"tongjian_id":"8c372cad-db0e-11ef-9ca7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詘，區勿翻。徐廣曰：時衰耗而作奢侈，言國家多難而勢詘，此時宜恤民之急，而舉事反若有贏餘者，失其所以爲國之道矣。「時詘舉贏」，蓋古語也。贏，怡成翻。","note_content_jianti_auto":"诎，区勿翻。徐广曰：时衰耗而作奢侈，言国家多难而势诎，此时宜恤民之急，而举事反若有赢余者，失其所以为国之道矣。「时诎举赢」，盖古语也。赢，怡成翻。","note_type":"hu_note","start_index":95,"tongjian_id":"8c372cac-db0e-11ef-9b1c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"韓昭侯","official_note":"韓昭侯是战国时期韩国的君主，属于地方行政长官，在上下文中作为对话的发起者出现，讨论修建高门之事。","official_rank":"侯爵","source_snippet":"韓昭侯作高門","start_index":2,"tongjian_id":"49961d37-6862-43a3-8d5b-e83d98b63e22"}],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"韓昭侯","people_name_jianti_auto":"韩昭侯","people_xingming":"韩昭侯","start_index":1,"tongjian_id":"8c372cae-db0e-11ef-a3db-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c372ca5-db0e-11ef-840e-a0d3651f611f","pinyin":"qū","source_anchor_text":"此所謂時詘舉贏者也","source_key":"baiyang_epub","start_index":89,"text":"詘","tongjian_id":"21177896-e1c7-5a50-8cca-bb964211c322"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2韓昭侯作高門，屈宜臼曰：「君必不出此門。何也？不時。吾所謂時者，非時日也。夫人固有利、不利時。往者君嘗利矣，不作高門。前年秦拔宜陽，今年旱，君不以此時恤民之急而顧益奢，此所謂時詘舉贏者也。故曰不時。」","content_fanyi":"韩昭侯修建高大的宫门，屈宜臼说：“您一定不要走出这座宫门。为什么呢？因为不合时宜。我所说的时宜，不是说时机。人本来就有有利时机和不利时机。从前您曾有过有利时机，却没有修建高门。前年秦国攻下宜阳，今年又遇上天旱，您不在这时体恤百姓的急难，反而更加奢侈，这正是所谓在时势艰难时去做时势顺利时的事。所以说不合时宜。”","content_jianti_auto":"2韩昭侯作高门，屈宜臼曰：「君必不出此门。何也？不时。吾所谓时者，非时日也。夫人固有利、不利时。往者君尝利矣，不作高门。前年秦拔宜阳，今年旱，君不以此时恤民之急而顾益奢，此所谓时诎举赢者也。故曰不时。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":181,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c372ca5-db0e-11ef-840e-a0d3651f611f","year_int":-334},"tongjian_id":"8c372ca5-db0e-11ef-840e-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"屈宜臼","people_name_jianti_auto":"屈宜臼","start_index":2,"tongjian_id":"8c39b13d-db0e-11ef-b438-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卒如屈宜臼言。卒，子恤翻。","note_content_jianti_auto":"卒如屈宜臼言。卒，子恤翻。","note_type":"hu_note","start_index":10,"tongjian_id":"8c39b13c-db0e-11ef-8b66-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宣惠","people_name_jianti_auto":"宣惠","start_index":0,"tongjian_id":"8c39b13f-db0e-11ef-a9e4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宣惠，複諡也。","note_content_jianti_auto":"宣惠，复谥也。","note_type":"hu_note","start_index":16,"tongjian_id":"8c39b13e-db0e-11ef-b1ca-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":21090