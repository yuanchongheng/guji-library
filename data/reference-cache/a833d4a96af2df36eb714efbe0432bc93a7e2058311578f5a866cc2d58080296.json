{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丙辰、前三○五）","note_content_jianti_auto":"（丙辰、前三○五）","note_type":"hu_note","start_index":0,"tongjian_id":"8c7f2dd9-db0e-11ef-addf-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":41,"tongjian_id":"8c7f2ddc-db0e-11ef-815f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"彗星，世所謂掃星，本類星，末類彗，小者數寸，長或竟天，見則兵起，主掃除，除舊布新。唐史臣曰：彗體無光，傅日以爲光，故夕見則東指，晨見則西指，或長或短，光芒所及則爲災。又曰：孛星，彗之屬也；偏指曰彗，氣四出曰孛。孛者孛孛，非常惡氣之所生，災甚於彗。天文書謂五星之精爲妖，歲星流爲蒼彗，熒惑、塡星散爲赤彗、黃彗，太白、辰星變爲白彗、黑彗。彗，祥歲翻，又徐醉翻，又旋芮翻。見，賢遍翻。掃，所報翻。傅，讀曰附。孛，蒲內翻。妖，於遙翻。塡，讀曰鎭。","note_content_jianti_auto":"彗星，世所谓扫星，本类星，末类彗，小者数寸，长或竟天，见则兵起，主扫除，除旧布新。唐史臣曰：彗体无光，傅日以为光，故夕见则东指，晨见则西指，或长或短，光芒所及则为灾。又曰：孛星，彗之属也；偏指曰彗，气四出曰孛。孛者孛孛，非常恶气之所生，灾甚于彗。天文书谓五星之精为妖，岁星流为苍彗，荧惑、塡星散为赤彗、黄彗，太白、辰星变为白彗、黑彗。彗，祥岁翻，又徐醉翻，又旋芮翻。见，贤遍翻。扫，所报翻。傅，读曰附。孛，蒲内翻。妖，于遥翻。塡，读曰镇。","note_type":"hu_note","start_index":5,"tongjian_id":"8c7f2ddb-db0e-11ef-8588-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1彗星見。","content_fanyi":"彗星显现。","content_jianti_auto":"1彗星见。","dtjl_paragraph_links":[],"dtjl_references":[],"id":273,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c7f2dda-db0e-11ef-8f14-a0d3651f611f"},{"ExtRef