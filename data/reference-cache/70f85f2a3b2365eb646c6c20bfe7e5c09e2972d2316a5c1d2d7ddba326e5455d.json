enzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"深井里","place_name_jianti_auto":"深井里","place_note":"河南济源东南十五公里","start_index":6,"tongjian_id":"8bfb155e-db0e-11ef-9847-a0d3651f611f"},{"place_name":"懷州","place_name_jianti_auto":"怀州","start_index":10,"tongjian_id":"8bfb155f-db0e-11ef-8839-a0d3651f611f"},{"place_name":"濟源縣","place_name_jianti_auto":"济源县","start_index":12,"tongjian_id":"8bfb1560-db0e-11ef-985c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：深井里在懷州濟源縣南三十里。","note_content_jianti_auto":"史记正义曰：深井里在怀州济源县南三十里。","note_type":"hu_note","start_index":154,"tongjian_id":"8bfb155d-db0e-11ef-a14b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"皮面，以刀剺面而去其皮。懸賞以募告者曰購。購，古候翻。嫈，烏莖翻。絕從之從，讀曰蹤，謂自絕其蹤跡。或曰：從，讀如字，謂絕其從坐之罪也。","note_content_jianti_auto":"皮面，以刀剺面而去其皮。悬赏以募告者曰购。购，古候翻。嫈，乌茎翻。绝从之从，读曰踪，谓自绝其踪迹。或曰：从，读如字，谓绝其从坐之罪也。","note_type":"hu_note","start_index":193,"tongjian_id":"8bfb1562-db0e-11ef-b898-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"韓相","official_note":"韓相是戰國時期韓國的最高行政長官，相當於宰相，負責輔佐君主處理國政。在上下文中，俠累擔任韓相，成為刺殺目標，顯示其政治地位和影響力。","official_rank":"未知","source_snippet":"盜殺韓相俠累","start_index":4,"tongjian_id":"aac5bf32-2444-413a-9ed1-1893ff41d6ee"}],"ExtRef_Children_people":[{"link_death_year":-397,"link_td_description":"聂政，战国轵邑（今日河南省济源市轹城镇）人，是战国时期刺客与音乐家，其事迹主要出自于《史记·刺客列传》。","link_td_id":"Q10009102","link_td_number_id":523601,"people_name":"聶政","people_name_jianti_auto":"聂政","people_xingming":"聂政","start_index":27,"tongjian_id":"8bfb1567-db0e-11ef-96b9-a0d3651f611f"},{"link_death_year":-397,"link_td_description":"聂政，战国轵邑（今日河南省济源市轹城镇）人，是战国时期刺客与音乐家，其事迹主要出自于《史记·刺客列传》。","link_td_id":"Q1000