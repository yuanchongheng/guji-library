ren_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"b22a7c76-db0e-11ef-b14e-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":26,"tongjian_id":"b22a7c77-db0e-11ef-a15e-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":30,"tongjian_id":"b22a7c78-db0e-11ef-a75a-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「尉」上有「甲午」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：十二行本「尉」上有「甲午」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"b22a7c75-db0e-11ef-b26e-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":14,"tongjian_id":"b22a7c74-db0e-11ef-b747-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","place_note":"府设武乡【陕西省大荔县】","resolved_place_entity_id":462,"start_index":25,"tongjian_id":"b22a7c85-db0e-11ef-9eed-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷四十六）","excerpts":[{"context_after":"齐主湛如洛阳，东至虎牢，自滑台如黎阳，还邺。隋大业初，置...","context_before":"...南临黎阳[见直隶濬县]，自虎牢济河至洛阳，由太行返晋阳。","source_end_index":1991,"source_paragraph_tongjian_id":"b082787f-7bb9-59b8-ad1b-1f69020d2286","source_start_index":1975,"source_text":"高齐河清二年，周人围洛阳，败去。"}],"path":"河南方舆纪要/〇、封域山川险要（卷四十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"隋大业九年，杨玄感围东都，代王侑自长安使卫文昇赴救。文昇...","context_before":"...泰寻自瀍曲夜登邙山以袭欢，为欢所败。明日，复战，欢败走。","source_end_index":634,"source_paragraph_tongjian_id":"f1b4056f-e49c-5074-bff5-b7bd22829eb6","source_start_index":533,"source_text":"后周保定四年，宇文护等伐齐，军于弘农，前锋尉迟迥围洛阳，宇文宪等军于邙山。久之，齐将段韶自晋阳驰救，济河至洛阳，登邙阪，观周军形势，与周军遇于太和谷，周师败遁，自邙山至穀水三十里中，军资器械，弥满山泽。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"隋大业九年，杨玄感围东都，代王侑自长安使卫文昇赴救。文昇...","context_before":"...泰寻自瀍曲夜登邙山以袭欢，为欢所败。明日，复战，欢败走。","source_end_index":634,"source_paragraph_tongjian_id":"5f2a2955-235f-5d67-886f-34f0b9d34743","source_start_index":533,"source_text":"后周保定四年，宇文护等伐齐，军于弘农，前锋尉迟迥围洛阳，宇文宪等军于邙山。久之，齐将段韶自晋阳驰救，济河至洛阳，登邙阪，观周军形势，与周军遇于太和谷，周师败遁，自邙山至穀水三十里中，军资器械，弥满山泽。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"27周晉公護進屯弘農。尉遲迥圍洛陽，雍州牧齊公憲、同州刺史達奚武、涇州總管王雄軍於邙山。","content_fanyi":"北周晋国公宇文护率军进屯弘农。尉迟迥围攻洛阳，雍州牧齐国公宇文宪、同州刺史达奚武、泾州总管王雄在邙山扎营。","content_jianti_auto":"27周晋公护进屯弘农。尉迟迥围洛阳，雍州牧齐公宪、同州刺史达奚武、泾州总管王雄军于邙山。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16093,"number":27,"path":"资治通鉴 : 卷第一百六十九 (陳紀三) / 世祖文皇帝下 / 五年 / 第 39 段","reading_annotation_sources":[],"start_index":38,"tongjian_id":"b22a7c73-db0e-11ef-bdb0-a0d3651f611f","year_int":564},"tongjian_id":"b22a7c73-db0e-11ef-bdb0-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"同州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":0,"tongjian_id":"b26e3ee2-db0e-11ef-b566-a0d3651f611f"},{"people_name":"李國昌","people_name_jianti_auto":"李国昌","start_index":66,"tongjian_id":"b26e3ee3-db0e-11ef-bc7a-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":86,"tongjian_id":"b26e3ee4-db0e-11ef-8100-a0d3651f611f"},{"people_name":"孝文帝","people_name_jianti_auto":"孝文帝","start_index":104,"tongjian_id":"b26e3ee5-db0e-11ef-bf09-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":4,"tongjian_id":"b26e3ee6-db0e-11ef-abec-a0d3651f611f"},{"place_name":"定陽縣","place_name_jianti_auto":"定阳县","start_index":12,"tongjian_id":"b26e3ee7-db0e-11ef-9453-a0d3651f611f"},{"place_name":"定陽郡","place_name_jianti_auto":"定阳郡","start_index":16,"tongjian_id":"b26e3ee8-db0e-11ef-a195-a0d3651f611f"},{"place_name":"文城郡","place_name_jianti_auto":"文城郡","start_index":24,"tongjian_id":"b26e3ee9-db0e-11ef-8297-a0d3651f611f"},{"place_name":"吉昌縣","place_name_jianti_auto":"吉昌县","start_index":27,"tongjian_id":"b26e3eea-db0e-11ef-b92c-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":31,"tongjian_id":"b26e3eeb-db0e-11ef-a576-a0d3651f611f"},{"place_name":"定陽縣","place_name_jianti_auto":"定阳县","start_index":34,"tongjian_id":"b26e3eec-db0e-11ef-af6d-a0d3651f611f"},{"place_name":"定陽郡","place_name_jianti_auto":"定阳郡","start_index":38,"tongjian_id":"b26e3eed-db0e-11ef-95e2-a0d3651f611f"},{"place_name":"文城郡","place_name_jianti_auto":"文城郡","start_index":42,"tongjian_id":"b26e3eee-db0e-11ef-8231-a0d3651f611f"},{"place_name":"東魏","place_name_jianti_auto":"东魏","start_index":46,"tongjian_id":"b26e3eef-db0e-11ef-8229-a0d3651f611f"},{"place_name":"南汾州","place_name_jianti_auto":"南汾州","start_index":49,"tongjian_id":"b26e3ef0-db0e-11ef-b280-a0d3651f611f"},{"place_name":"後周","place_name_jianti_auto":"后周","start_index":53,"tongjian_id":"b26e3ef1-db0e-11ef-b8f6-a0d3651f611f"},{"place_name":"汾州","place_name_jianti_auto":"汾州","start_index":57,"tongjian_id":"b26e3ef2-db0e-11ef-bb2a-a0d3651f611f"},{"place_name":"吉昌縣","place_name_jianti_auto":"吉昌县","start_index":59,"tongjian_id":"b26e3ef3-db0e-11ef-b344-a0d3651f611f"},{"place_name":"後唐","place_name_jianti_auto":"后唐","start_index":63,"tongjian_id":"b26e3ef4-db0e-11ef-a17d-a0d3651f611f"},{"place_name":"吉鄕縣","place_name_jianti_auto":"吉鄕县","start_index":74,"tongjian_id":"b26e3ef5-db0e-11ef-bff5-a0d3651f611f"},{"place_name":"汾州","place_name_jianti_auto":"汾州","start_index":83,"tongjian_id":"b26e3ef6-db0e-11ef-a847-a0d3651f611f"},{"place_name":"慈州","place_name_jianti_auto":"慈州","start_index":90,"tongjian_id":"b26e3ef7-db0e-11ef-aa43-a0d3651f611f"},{"place_name":"吉鄕縣","place_name_jianti_auto":"吉鄕县","start_index":92,"tongjian_id":"b26e3ef8-db0e-11ef-b1f3-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":97,"tongjian_id":"b26e3ef9-db0e-11ef-aaf9-a0d3651f611f"},{"place_name":"北屈縣","place_name_jianti_auto":"北屈县","start_index":98,"tongjian_id":"b26e3efa-db0e-11ef-9cb9-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":102,"tongjian_id":"b26e3efb-db0e-11ef-b9cd-a0d3651f611f"},{"place_name":"定陽郡","place_name_jianti_auto":"定阳郡","start_index":108,"tongjian_id":"b26e3efc-db0e-11ef-a4c0-a0d3651f611f"},{"place_name":"定陽縣","place_name_jianti_auto":"定阳县","start_index":112,"tongjian_id":"b26e3efd-db0e-11ef-8548-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","start_index":119,"tongjian_id":"b26e3efe-db0e-11ef-a18e-a0d3651f611f"},{"place_name":"定陽","place_name_jianti_auto":"定阳","start_index":121,"tongjian_id":"b26e3eff-db0e-11ef-8b41-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":123,"tongjian_id":"b26e3f00-db0e-11ef-9cd9-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":126,"tongjian_id":"b26e3f01-db0e-11ef-a79a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏收志：後魏延興四年，置定陽縣及定陽郡。五代志：文城郡吉昌縣，後魏置定陽縣及定陽郡。文城郡，東魏置南汾州，後周改曰汾州吉昌縣，後唐避李國昌諱，又改爲吉鄕縣。九域志：屬汾州。宋白曰：慈州吉鄕縣，本漢北屈縣，後魏孝文帝置定陽郡及定陽縣。時會有河西定陽胡人渡河居此，因以爲名。","note_content_jianti_auto":"魏收志：后魏延兴四年，置定阳县及定阳郡。五代志：文城郡吉昌县，后魏置定阳县及定阳郡。文城郡，东魏置南汾州，后周改曰汾州吉昌县，后唐避李国昌讳，又改为吉鄕县。九域志：属汾州。宋白曰：慈州吉鄕县，本汉北屈县，后魏孝文帝置定阳郡及定阳县。时会有河西定阳胡人渡河居此，因以为名。","note_type":"hu_note","start_index":14,"tongjian_id":"b26e3ee1-db0e-11ef-ad35-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","place_note":"府设武乡【陕西省大荔县】","resolved_place_entity_id":462,"start_index":44,"tongjian_id":"b26e3f13-db0e-11ef-bece-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"《志》云：州西南十里有倚梯城，在龙门上口，垒石为之，东北...","context_before":"南汾城[在州南。东魏置南汾州于定阳，后周取之，改为汾州。","source_end_index":50,"source_paragraph_tongjian_id":"433fae46-5a35-55d2-a3a9-ae11faa3f8ee","source_start_index":28,"source_text":"高齐武平初，斛律光围定阳，因筑南汾城以逼之。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"隋大业之末，唐乾符以后，太原南指，未有不以州为中顿；平阳...","context_before":"...事。迨于刘渊发难，中原陆沉，祸乱之征，未始不自西河始也。","source_end_index":84,"source_paragraph_tongjian_id":"55fb4691-9bb6-5fd4-bd7a-a603f6d522be","source_start_index":67,"source_text":"周、齐争胜于河、汾间，郡常为兵冲。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"隋大业十三年，李渊起义师，至龙门[亦谓河津县]。任瑰请从...","context_before":"...将。永熙末，高欢破潼关，屯华阴。龙门都督薛崇礼以城降欢。","source_end_index":596,"source_paragraph_tongjian_id":"116f5e80-0dbb-5c03-b2f5-aa76751688c9","source_start_index":520,"source_text":"宇文周太和五年，齐将斛律光侵汾北，围定阳[今吉州]，筑十三城，拓地五百里。宇文宪督诸将自龙门渡河，光退保华谷[华谷城，见山西稷山县]。宪攻拔其新筑五城。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"光進圍定陽，築南汾城以逼之。周人釋宜陽之圍以救汾北。晉公護問計於齊公憲，憲曰：「兄宜暫出同州以爲聲勢，憲請以精兵居前，隨機攻取。」護從之。","content_fanyi":"斛律光进军围困定阳，又修筑南汾城来逼迫定阳。北周军队解除对宜阳的包围，撤军救援汾北地区。晋国公宇文护向齐国公宇文宪询问用兵计策，宇文宪说：“兄长应当暂且出兵同州，以造成声势，我请求率领精兵作为前锋，相机攻取城池。”宇文护采纳了这一方略。","content_jianti_auto":"光进围定阳，筑南汾城以逼之。周人释宜阳之围以救汾北。晋公护问计于齐公宪，宪曰：「兄宜暂出同州以为声势，宪请以精兵居前，随机攻取。」护从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16331,"path":"资治通鉴 : 卷第一百七十 (陳紀四) / 高宗宣皇帝上之上 / 二年 / 第 40 段","reading_annotation_sources":[],"start_index":39,"tongjian_id":"b26e3ee0-db0e-11ef-902e-a0d3651f611f","year_int":570},"tongjian_id":"b26e3ee0-db0e-11ef-902e-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"同州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以兄弟齒。","note_content_jianti_auto":"以兄弟齿。","note_type":"hu_note","start_index":14,"tongjian_id":"b2876de6-db0e-11ef-a639-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周成王","people_name_jianti_auto":"周成王","start_index":0,"tongjian_id":"b2876de9-db0e-11ef-a10c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周成王作酒誥，戒毋彝酒，毋敢崇飲。","note_content_jianti_auto":"周成王作酒诰，戒毋彝酒，毋敢崇饮。","note_type":"hu_note","start_index":102,"tongjian_id":"b2876de8-db0e-11ef-824a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":7,"tongjian_id":"b2876dec-db0e-11ef-8db2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"記：天子搢珽。鄭玄曰：珽，亦笏也。珽之言珽然無所屈也。或謂之大圭，長三尺，杼上，終葵首。終葵首者，於杼上又廣其首如椎頭。隋志：今制，珽長尺二寸、方而不折，以球玉爲之。珽，他頂翻。","note_content_jianti_auto":"记：天子搢珽。郑玄曰：珽，亦笏也。珽之言珽然无所屈也。或谓之大圭，长三尺，杼上，终葵首。终葵首者，于杼上又广其首如椎头。隋志：今制，珽长尺二寸、方而不折，以球玉为之。珽，他顶翻。","note_type":"hu_note","start_index":136,"tongjian_id":"b2876deb-db0e-11ef-b71c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":2,"tongjian_id":"b2876df1-db0e-11ef-88c2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言周主勇決。","note_content_jianti_auto":"史言周主勇决。","note_type":"hu_note","start_index":189,"tongjian_id":"b2876df0-db0e-11ef-90d3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","place_note":"府设武乡【陕西大荔县】","resolved_place_entity_id":462,"start_index":31,"tongjian_id":"b2876df6-db0e-11ef-a300-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"帝每於禁中見護，常行家人禮，太后賜護坐，帝立侍於旁。丙辰，護自同州還長安，帝御文安殿見之。因引護入含仁殿謁太后，且謂之曰：「太后春秋高，頗好飲酒，雖屢諫，未蒙垂納。兄今入朝，願更啓請。」因出懷中酒誥授之，曰：「以此諫太后。」護旣入，如帝所戒讀酒誥；未畢，帝以玉珽自後擊之，護踣於地。帝令宦者何泉以御刀斫之，泉惶懼，斫不能傷。衞公直匿於戶內，躍出，斬之。時神舉等皆在外，更無知者。","content_fanyi":"武帝在宫中每次见到宇文护，常以兄弟之礼相待；太后赐宇文护坐，武帝仍立在一旁侍候。丙辰日，宇文护从同州回到长安，武帝亲临文安殿接见他。随后领宇文护进入含仁殿拜见太后，并对他说：“太后年事已高，很爱饮酒，我虽然多次劝谏，都未被接受。兄长今天入朝，希望您再向她启请。”于是从怀中取出《酒诰》交给宇文护，说：“用这篇《酒诰》劝谏太后。”宇文护入内后，按照武帝的告诫诵读《酒诰》；还没有读完，武帝用玉珽从身后击打他，宇文护跌倒在地。武帝命令宦官何泉用御刀砍杀宇文护，何泉惊慌恐惧，砍下去却没能伤到他。卫公宇文直藏在门内，跳出来斩杀了宇文护。当时宇文神举等人都在殿外，再没有别人知道。","content_jianti_auto":"帝每于禁中见护，常行家人礼，太后赐护坐，帝立侍于旁。丙辰，护自同州还长安，帝御文安殿见之。因引护入含仁殿谒太后，且谓之曰：「太后春秋高，颇好饮酒，虽屡谏，未蒙垂纳。兄今入朝，愿更启请。」因出怀中酒诰授之，曰：「以此谏太后。」护既入，如帝所戒读酒诰；未毕，帝以玉珽自后击之，护踣于地。帝令宦者何泉以御刀斫之，泉惶惧，斫不能伤。衞公直匿于户内，跃出，斩之。时神举等皆在外，更无知者。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16389,"path":"资治通鉴 : 卷第一百七十一 (陳紀五) / 高宗宣皇帝上之下 / 太建四年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"b2876de5-db0e-11ef-9123-a0d3651f611f","year_int":572},"tongjian_id":"b2876de5-db0e-11ef-9123-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"同州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蒲州","place_name_jianti_auto":"蒲州","start_index":1,"tongjian_id":"b289940e-db0e-11ef-833f-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","place_note":"府设武乡【陕西省大荔县】","start_index":6,"tongjian_id":"b289940f-db0e-11ef-ad6a-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","start_index":14,"tongjian_id":"b2899410-db0e-11ef-bbad-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":19,"tongjian_id":"b2899411-db0e-11ef-845f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自蒲州西南至同州一百三十里，同州西南至長安二百二十五里。傳，張戀翻。","note_content_jianti_auto":"自蒲州西南至同州一百三十里，同州西南至长安二百二十五里。传，张恋翻。","note_type":"hu_note","start_index":32,"tongjian_id":"b289940d-db0e-11ef-9d3e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"叱羅","people_name_jianti_auto":"叱罗","start_index":0,"tongjian_id":"b2899414-db0e-11ef-8754-a0d3651f611f"},{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":7,"tongjian_id":"b2899415-db0e-11ef-b3ac-a0d3651f611f"},{"people_name":"叱羅氏","people_name_jianti_auto":"叱罗氏","start_index":20,"tongjian_id":"b2899416-db0e-11ef-b6ef-a0d3651f611f"},{"people_name":"協","people_name_jianti_auto":"协","start_index":24,"tongjian_id":"b2899417-db0e-11ef-ae52-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"拓跋","place_name_jianti_auto":"拓跋","start_index":13,"tongjian_id":"b2899418-db0e-11ef-9266-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","start_index":27,"tongjian_id":"b2899419-db0e-11ef-ad2c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"叱羅，虜複姓。魏收官氏志：拓跋內入諸姓有叱羅氏。協時在同州。璽，斯氏翻。","note_content_jianti_auto":"叱罗，虏复姓。魏收官氏志：拓跋内入诸姓有叱罗氏。协时在同州。玺，斯氏翻。","note_type":"hu_note","start_index":68,"tongjian_id":"b2899413-db0e-11ef-9706-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"同州","place_name_jianti_auto":"同州","place_note":"府设武乡【陕西省大荔县】","resolved_place_entity_id":462,"start_index":26,"tongjian_id":"b2899420-db0e-11ef-8a86-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"護世子訓爲蒲州刺中，是夜，帝遣柱國越公盛乘傳徵訓，至同州，賜死。昌城公深使突厥未還，遣開府儀同三司宇文德齎璽書就殺之。護長史代郡叱羅協、司錄弘農馮遷及所親任者，皆除名。","content_fanyi":"宇文护的世子宇文训正担任蒲州刺史，当天夜里，武帝派柱国越公宇文盛乘驿车征召宇文训，到同州后，赐他自杀。昌城公宇文深出使突厥还没有返回，武帝派开府仪同三司宇文德带着玺书前去就地将他处死。宇文护的长史代郡人叱罗协、司录弘农人冯迁以及他所亲近信任的人，都被削除名籍。","content_jianti_auto":"护世子训为蒲州刺中，是夜，帝遣柱国越公盛乘传征训，至同州，赐死。昌城公深使突厥未还，遣开府仪同三司宇文德赍玺书就杀之。护长史代郡叱罗协、司录弘农冯迁及所亲任者，皆除名。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16393,"path":"资治通鉴 : 卷第一百七十一 (陳紀五) / 高宗宣皇帝上之下 / 太建四年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"b289940c-db0e-11ef-ba61-a0d3651f611f","year_int":572},"tongjian_id":"b289940c-db0e-11ef-ba61-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":8,"total_paragraphs":77},"place_name":"同州"},"message":"success","success":true}