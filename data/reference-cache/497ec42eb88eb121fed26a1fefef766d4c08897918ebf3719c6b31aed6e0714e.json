_auto":"耽","start_index":79,"tongjian_id":"97a2a29e-db0e-11ef-9882-a0d3651f611f"},{"people_name":"陳耽","people_name_jianti_auto":"陈耽","start_index":88,"tongjian_id":"97a2a29f-db0e-11ef-9110-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：劉陶傳：「光和五年，以謠言舉二千石。耽與議郞曹操上言。」按耽已爲司徒，不應與議郞同上言。王沈魏書曰：「是歲，以災異博問得失，太祖因此上書切諫」，不云與耽同上言也。今但云陳耽。","note_content_jianti_auto":"考异曰：刘陶传：「光和五年，以谣言举二千石。耽与议郞曹操上言。」按耽已为司徒，不应与议郞同上言。王沈魏书曰：「是岁，以灾异博问得失，太祖因此上书切谏」，不云与耽同上言也。今但云陈耽。","note_type":"hu_note","start_index":113,"tongjian_id":"97a2a298-db0e-11ef-a2a9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处许𢒰担任太尉，负责参与公卿举荐事务，但文中显示他承望内官、受取贿赂，导致举荐不公。","official_rank":"正一品","source_snippet":"太尉許𢒰","start_index":18,"tongjian_id":"c3e94f38-493d-4615-a352-765b95f242b6"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司空","official_note":"司空是汉代三公之一，主管土木工程和监察，此处张济担任司空，与太尉许𢒰一同承望内官、受取贿赂，在举荐中偏袒宦者子弟和宾客。","official_rank":"正一品","source_snippet":"司空張濟","start_index":22,"tongjian_id":"3b1fa796-1290-4692-a523-eee47c6d7326"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是汉代三公之一，掌管民政和教育，此处陈耽担任司徒，上言批评公卿举荐不公，指出他们党其私，导致放鴟梟而囚鸞鳳的现象。","official_rank":"正一品","source_snippet":"司徒陳耽","start_index":94,"tongjian_id":"900e3914-94f1-4656-8929-a6755b11c89d"},{"confidence":0.9,"official_category":"文教","official_name":"議郞","official_note":"议郎是汉代郎官的一种，负责顾问应对和议论政事，无固定职掌，此处表示因谣言被征召的人都被任命为议郎，作为对举荐不公的调整措施。","official_rank":"六品左右","source_snippet":"悉拜議郞","start_index":130,"tongjian_id":"8ca9fa82-22d0-4c02-9d51-ca903d6ce6d3"}],"ExtRef_Children_people":[{"people_name":"許𢒰","people_name_jianti_auto":"许𢒰","people_xingming":"许𢒰","start_index":22,"tongjian_id":"97a2a2a3-db0e-11ef-908f-a0d3651f611f"},{"link_td_description":"张济，字元江。汝南细阳人。东汉官员，官至司空。","link_td_id":"Q10003674","link_td_number_id":3814661,"people_name":"張濟","people_name_jianti_auto":"张济","people_xingming":"张济","start_index":27,"tongjian_id":"97a2a2a4-db0e-11ef-85f2-a0d3651f611f"},{"link_death_year":185,"link_td_description":"陈耽，字汉公，东海（今山东郯城北）人，汉灵帝时以忠著称，历位三司。因进言帝十常侍祸国殃民，下狱，与刘陶俱遭十常侍谋杀。","link_td_id":"Q10007252","link_td_number_id":887355,"people_name":"陳耽","people_name_jianti_auto":"陈耽","people_xingming":"陈耽","start_index":86,"tongjian_id":"97a2a2a5-db0e-11ef-9a95-a0d3651f611f"},{"people_name":"𢒰","people_name_jianti_auto":"𢒰","people_xingming":"许𢒰","start_index":116,"tongjian_id":"97a2a2a6-db0e-11ef-b8ad-a0d3651f611f"},{"link_td_description":"张济，字元江。汝南细阳人。东汉官员，官至司空。","link_td_id":"Q10003674","link_td_number_id":3814661,"people_name":"濟","people_name_jianti_auto":"济","people_xingming":"张济","start_index":118,"tongjian_id":"97a2a2a7-db0e-11ef-83ca-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"2詔公卿以謠言舉刺史、二千石爲民蠹害者。太尉許𢒰、司空張濟承望內官，受取貨賂，其宦者子弟、賓客，雖貪汙穢濁，皆不敢問，而虛糾邊遠小郡清修有惠化者二十六人，吏民詣闕陳訴。司徒陳耽上言：「公卿所舉，率黨其私，所謂放鴟梟而囚鸞鳳。」帝以讓𢒰、濟，由是諸坐謠言徵者，悉拜議郞。","content_fanyi":"灵帝下诏，命公卿根据民间歌谣举发祸害百姓的刺史和二千石官员。太尉许戫、司空张济迎合宦官意旨，收受财货贿赂，对宦官的子弟、宾客，即使贪污污浊，也都不敢查问，反而虚假举劾边远小郡中清廉修身、有惠民政绩的二十六名官员，这些官员的属吏和百姓到宫阙前为他们陈诉。司徒陈耽上奏说：“公卿们所举发的，大多偏私自己的党羽，正是所谓放走鸱枭、囚禁凤凰。”灵帝因此责备许戫、张济，于是所有因民谣被征召治罪的人，都被任命为议郎。","content_jianti_auto":"2诏公卿以谣言举刺史、二千石为民蠹害者。太尉许𢒰、司空张济承望内官，受取货赂，其宦者子弟、宾客，虽贪污秽浊，皆不敢问，而虚纠边远小郡清修有惠化者二十六人，吏民诣阙陈诉。司徒陈耽上言：「公卿所举，率党其私，所谓放鸱枭而囚鸾凤。」帝以让𢒰、济，由是诸坐谣言征者，悉拜议郞。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4979,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"97a2a296-db0e-11ef-927c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3二月，大疫。","content_fanyi":"二月，大规模瘟疫暴发。","content_jianti_auto":"3二月，大疫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4980,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"97a2a2a8-db0e-11ef-9dd8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是东汉三公之一，负责民政和教化，此处表示陈耽被免去司徒职务，反映了朝廷人事变动。","official_rank":"正一品","source_snippet":"司徒陳耽免","start_index":2,"tongjian_id":"04d5a51b-c967-4db9-ba9b-05a734295758"}],"ExtRef_Children_people":[{"link_death_year":185,"link_td_description":"陈耽，字汉公，东海（今山东郯城北）人，汉灵帝时以忠著称，历位三司。因进言帝十常侍祸国殃民，下狱，与刘陶俱遭十常侍谋杀。","link_td_id":"Q10007252","link_td_number_id":887355,"people_name":"陳耽","people_name_jianti_auto":"陈耽","people_xingming":"陈耽","start_index":6,"tongjian_id":"97a2a2aa-db0e-11ef-abe9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4三月，司徒陳耽免。","content_fanyi":"三月，司徒陈耽被免去官职。","content_jianti_auto":"4三月，司徒陈耽免。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4981,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"97a2a2a9-db0e-11ef-841b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5夏，四月，旱。","content_fanyi":"夏季四月，出现旱情。","content_jianti_auto":"5夏，四月，旱。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4982,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"97a2a2ab-db0e-11ef-9be6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"太常","official_note":"太常是汉代九卿之一，掌管宗庙礼仪、祭祀等事务。在《资治通鉴》此段中，袁隗以太常身份被任命为司徒，表明其从礼仪官职转任为三公之一，反映了东汉末年官员的升迁变动。","official_rank":"九卿之一","source_snippet":"以太常袁隗爲司徒","start_index":1,"tongjian_id":"2239a4cd-b7ea-4196-878b-ba65feeafc66"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是汉代三公之一，负责民政、教化等事务，地位崇高。在《资治通鉴》此段中，袁隗被任命为司徒，这是东汉末年重要的官职任命，可能涉及政治权力的调整。","official_rank":"三公之一","source_snippet":"以太常袁隗爲司徒","start_index":7,"tongjian_id":"85b417a7-ced5-4b05-836a-87b6a9184f45"}],"ExtRef_Children_people":[{"link_death_year":190,"link_td_description":"袁隗，字次阳。汝南郡汝阳县（今河南省汝南县）人。为东汉太傅，后因其兄长之子袁绍、袁术皆反董卓而被牵连，使其被董卓杀害，株连三族。","link_td_id":"Q10007190","link_td_number_id":1233021,"people_name":"袁隗","people_name_jianti_auto":"袁隗","people_xingming":"袁隗","start_index":4,"tongjian_id":"97a2a2ad-db0e-11ef-bd23-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"97a2a2ac-db0e-11ef-931b-a0d3651f611f","pinyin":"wěi","source_anchor_text":"以太常袁隗為司徒五","source_key":"baiyang_epub","start_index":5,"text":"隗","tongjian_id":"389314ab-5b4c-5de1-9b1f-e2aacc693ce5"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"6以太常袁隗爲司徒。","content_fanyi":"任命太常袁隗为司徒。","content_jianti_auto":"6以太常袁隗为司徒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4983,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"97a2a2ac-db0e-11ef-931b-a0d3651f611f"},{"Ext