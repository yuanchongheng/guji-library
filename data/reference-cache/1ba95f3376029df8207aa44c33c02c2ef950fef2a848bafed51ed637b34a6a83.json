id":"8ca1d52c-db0e-11ef-9e6d-a0d3651f611f"},{"place_name":"北平","place_name_jianti_auto":"北平","start_index":92,"tongjian_id":"8ca1d52d-db0e-11ef-93ba-a0d3651f611f"},{"place_name":"原城","place_name_jianti_auto":"原城","start_index":104,"tongjian_id":"8ca1d52e-db0e-11ef-9f6a-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":115,"tongjian_id":"8ca1d52f-db0e-11ef-a4d4-a0d3651f611f"},{"place_name":"濟水","place_name_jianti_auto":"济水","start_index":124,"tongjian_id":"8ca1d530-db0e-11ef-a9ff-a0d3651f611f"},{"place_name":"濟源","place_name_jianti_auto":"济源","start_index":135,"tongjian_id":"8ca1d531-db0e-11ef-9166-a0d3651f611f"},{"place_name":"濟源","place_name_jianti_auto":"济源","start_index":142,"tongjian_id":"8ca1d532-db0e-11ef-aec0-a0d3651f611f"},{"place_name":"垣","place_name_jianti_auto":"垣","start_index":145,"tongjian_id":"8ca1d533-db0e-11ef-9a3c-a0d3651f611f"},{"place_name":"新垣","place_name_jianti_auto":"新垣","start_index":151,"tongjian_id":"8ca1d534-db0e-11ef-899a-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":154,"tongjian_id":"8ca1d535-db0e-11ef-87d2-a0d3651f611f"},{"place_name":"垣縣","place_name_jianti_auto":"垣县","start_index":157,"tongjian_id":"8ca1d536-db0e-11ef-b7a0-a0d3651f611f"},{"place_name":"新垣","place_name_jianti_auto":"新垣","start_index":172,"tongjian_id":"8ca1d537-db0e-11ef-bb88-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：年表及括地志，曲陽故城在懷州濟源縣西四十里，新垣近曲陽，未詳端的之處。余按班志，王屋山在河東垣縣，沇水所出，東流爲濟。水經：濟水出河東垣縣王屋山爲沇水。註云：濟水重源出溫西北平地。水有二源，東源出原城東北，晉文公以信降原，卽此城也。俗以濟水重源所發，因復謂之濟源城。如此則濟源去垣不遠矣。蓋新垣卽河東之垣縣也；以縣有遷徙，謂其新邑爲新垣也。垣，于元翻。濟，子禮翻。沇，以轉翻。降，戶江翻。重，直龍翻。復，扶又翻。","note_content_jianti_auto":"史记正义曰：年表及括地志，曲阳故城在怀州济源县西四十里，新垣近曲阳，未详端的之处。余按班志，王屋山在河东垣县，沇水所出，东流为济。水经：济水出河东垣县王屋山为沇水。注云：济水重源出温西北平地。水有二源，东源出原城东北，晋文公以信降原，即此城也。俗以济水重源所发，因复谓之济源城。如此则济源去垣不远矣。盖新垣即河东之垣县也；以县有迁徙，谓其新邑为新垣也。垣，于元翻。济，子礼翻。沇，以转翻。降，户江翻。重，直龙翻。复，扶又翻。","note_type":"hu_note","start_index":12,"tongjian_id":"8ca1d519-db0e-11ef-b874-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8ca1d53e-db0e-11ef-a2a2-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":3,"tongjian_id":"8ca1d53f-db0e-11ef-a74a-a0d3651f611f"},{"place_name":"新垣","place_name_jianti_auto":"新垣","place_note":"山西垣曲","resolved_place_entity_id":7201,"start_index":6,"tongjian_id":"8ca1d540-db0e-11ef-9114-a0d3651f611f"},{"place_name":"曲陽","place_name_jianti_auto":"曲阳","place_note":"河南濟源西","resolved_place_entity_id":2655,"start_index":9,"tongjian_id":"8ca1d541-db0e-11ef-b949-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、怀庆府（卷四十九）","excerpts":[{"context_after":"杜预曰：野王县西南有阳城，故阳樊也，即河雍矣。胡三省曰：...","context_before":"...、原、攒、茅之田。《国语》王以阳樊赐晋，是也。后为曲阳。","source_end_index":113,"source_paragraph_tongjian_id":"b7ee7fc1-5241-5ca5-996a-12a3645f8a36","source_start_index":91,"source_text":"《史记》：魏昭王九年，秦拔我新垣、曲阳之城。"}],"path":"河南方舆纪要/三、怀庆府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1秦攻趙，拔新垣、曲陽。","content_fanyi":"秦国攻打赵国，攻克新垣、曲阳。","content_jianti_auto":"1秦攻赵，拔新垣、曲阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":329,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8ca1d513-db0e-11ef-a026-a0d3651f611f"}],"reign_name":"二十八年","reign_name_jianti_auto":"二十八年","start_index":10,"tongjian_id":"8ca1d511-db0e-11ef-bbde-a0d3651f611f","year_anno":"（甲戌、前二八七）","year_int":-287},"message":"success","success":true}