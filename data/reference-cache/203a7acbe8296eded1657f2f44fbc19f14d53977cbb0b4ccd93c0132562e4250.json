],"background_material_references":[],"class_tags":[],"content":"14\u521d\uff0c\u5b9b\u4eba\u5353\u8302\uff0c\u5bec\u4ec1\u606d\u611b\uff0c\u606c\u8569\u6a02\u9053\uff0c\u96c5\u5be6\u4e0d\u7232\u83ef\u8c8c\uff0c\u884c\u5df1\u5728\u65bc\u6e05\u6fc1\u4e4b\u9593\uff0c\u81ea\u675f\u9aee\u81f3\u767d\u9996\uff0c\u672a\u5617\u8207\u4eba\u6709\u722d\u7af6\uff0c\u9115\u9ee8\u6545\u820a\uff0c\u96d6\u884c\u80fd\u8207\u8302\u4e0d\u540c\uff0c\u800c\u7686\u611b\u6155\u6b23\u6b23\u7109\u3002\u54c0\u3001\u5e73\u9593\u7232\u5bc6\u4ee4\uff0c\u8996\u6c11\u5982\u5b50\uff0c\u8209\u5584\u800c\u654e\uff0c\u53e3\u7121\u60e1\u8a00\uff0c\u540f\u6c11\u89aa\u611b\uff0c\u4e0d\u5fcd\u6b3a\u4e4b\u3002\u6c11\u5617\u6709\u8a00\u90e8\u4ead\u9577\u53d7\u5176\u7c73\u8089\u907a\u8005\uff0c\u8302\u66f0\uff1a\u300c\u4ead\u9577\u7232\u5f9e\u6c5d\u6c42\u4e4e\uff0c\u7232\u6c5d\u6709\u4e8b\u56d1\u4e4b\u800c\u53d7\u4e4e\uff0c\u5c07\u5e73\u5c45\u81ea\u4ee5\u6069\u610f\u907a\u4e4b\u4e4e\uff1f\u300d\u6c11\u66f0\uff1a\u300c\u5f80\u907a\u4e4b\u8033\u3002\u300d\u8302\u66f0\uff1a\u300c\u907a\u4e4b\u800c\u53d7\uff0c\u4f55\u6545\u8a00\u90aa\uff1f\u300d\u6c11\u66f0\uff1a\u300c\u7aca\u805e\u8ce2\u660e\u4e4b\u541b\uff0c\u4f7f\u6c11\u4e0d\u754f\u540f\uff0c\u540f\u4e0d\u53d6\u6c11\u3002\u4eca\u6211\u754f\u540f\uff0c\u662f\u4ee5\u907a\u4e4b\uff1b\u540f\u65e3\u5352\u53d7\uff0c\u6545\u4f86\u8a00\u8033\u3002\u300d\u8302\u66f0\uff1a\u300c\u6c5d\u7232\u655d\u6c11\u77e3\uff01\u51e1\u4eba\u6240\u4ee5\u7fa3\u5c45\u4e0d\u4e82\uff0c\u7570\u65bc\u79bd\u7378\u8005\uff0c\u4ee5\u6709\u4ec1\u611b\u79ae\u7fa9\uff0c\u77e5\u76f8\u656c\u4e8b\u4e5f\u3002\u6c5d\u7368\u4e0d\u6b32\u8129\u4e4b\uff0c\u5be7\u80fd\u9ad8\u98db\u9060\u8d70\uff0c\u4e0d\u5728\u4eba\u9593\u90aa\uff01\u540f\u9867\u4e0d\u7576\u4e58\u5a01\u529b\u5f37\u8acb\u6c42\u8033\u3002\u4ead\u9577\u7d20\u5584\u540f\uff0c\u6b72\u6642\u907a\u4e4b\uff0c\u79ae\u4e5f\u3002\u300d\u6c11\u66f0\uff1a\u300c\u82df\u5982\u6b64\uff0c\u5f8b\u4f55\u6545\u7981\u4e4b\uff1f\u300d\u8302\u7b11\u66f0\uff1a\u300c\u5f8b\u8a2d\u5927\u6cd5\uff0c\u79ae\u9806\u4eba\u60c5\u3002\u4eca\u6211\u4ee5\u79ae\u654e\u6c5d\uff0c\u6c5d\u5fc5\u7121\u6028\u60e1\uff1b\u4ee5\u5f8b\u6cbb\u6c5d\uff0c\u6c5d\u4f55\u6240\u63aa\u5176\u624b\u8db3\u4e4e\uff01\u4e00\u9580\u4e4b\u5167\uff0c\u5c0f\u8005\u53ef\u8ad6\uff0c\u5927\u8005\u53ef\u6bba\u4e5f\u3002\u4e14\u6b78\u5ff5\u4e4b\uff01\u300d\u521d\uff0c\u8302\u5230\u7e23\uff0c\u6709\u6240\u5ee2\u7f6e\uff0c\u540f\u6c11\u7b11\u4e4b\uff0c\u9130\u57ce\u805e\u8005\u7686\u86a9\u5176\u4e0d\u80fd\u3002\u6cb3\u5357\u90e1\u7232\u7f6e\u5b88\u4ee4\uff1b\u8302\u4e0d\u7232\u5acc\uff0c\u6cbb\u4e8b\u81ea\u82e5\u3002\u6578\u5e74\uff0c\u654e\u5316\u5927\u884c\uff0c\u9053\u4e0d\u62fe\u907a\uff1b\u9077\u4eac\u90e8\u4e1e\uff0c\u5bc6\u4eba\u8001\u5c11\u7686\u6d95\u6ce3\u96a8\u9001\u3002\u53ca\u738b\u83bd\u5c45\u651d\uff0c\u4ee5\u75c5\u514d\u6b78\u3002\u4e0a\u537d\u4f4d\uff0c\u5148\u8a2a\u6c42\u8302\uff0c\u8302\u6642\u5e74\u4e03\u5341\u9918\u3002\u7532\u7533\uff0c\u8a54\u66f0\uff1a\u300c\u592b\u540d\u51a0\u5929\u4e0b\uff0c\u7576\u53d7\u5929\u4e0b\u91cd\u8cde\u3002\u4eca\u4ee5\u8302\u7232\u592a\u5085\uff0c\u5c01\u8912\u5fb7\u4faf\u3002\u300d","content_fanyi":"\u5f53\u521d\uff0c\u5b9b\u53bf\u4eba\u5353\u8302\uff0c\u4e3a\u4eba\u5bbd\u539a\u4ec1\u4e49\u3001\u606d\u8c26\u6148\u7231\uff0c\u6027\u60c5\u6de1\u6cca\u5766\u8361\uff0c\u4e50\u5b88\u5723\u8d24\u4e4b\u9053\uff0c\u96c5\u6b63\u6734\u5b9e\u800c\u4e0d\u8ffd\u6c42\u6d6e\u534e\u7684\u5916\u8868\uff0c\u7acb\u8eab\u5904\u4e16\u4ecb\u4e8e\u6e05\u6d4a\u4e4b\u95f4\uff0c\u4ece\u675f\u53d1\u5230\u767d\u5934\u4ece\u672a\u4e0e\u4eba\u4e89\u6267\uff0c\u540c\u4e61\u548c\u65e7\u53cb\u867d\u7136\u54c1\u884c\u624d\u80fd\u4e0e\u5353\u8302\u4e0d\u540c\uff0c\u4f46\u90fd\u6ee1\u5fc3\u6b22\u559c\u5730\u656c\u7231\u4ef0\u6155\u4ed6\u3002\u897f\u6c49\u54c0\u5e1d\u3001\u5e73\u5e1d\u5e74\u95f4\uff0c\u5353\u8302\u62c5\u4efb\u5bc6\u53bf\u4ee4\uff0c\u7231\u6c11\u5982\u5b50\uff0c\u63a8\u884c\u5584\u884c\u6765\u6559\u5316\u767e\u59d3\uff0c\u53e3\u4e2d\u6ca1\u6709\u6076\u8a00\uff0c\u5b98\u540f\u548c\u767e\u59d3\u90fd\u4eb2\u8fd1\u7231\u6234\u4ed6\uff0c\u4e0d\u5fcd\u5fc3\u6b3a\u9a97\u4ed6\u3002\u66fe\u7ecf\u6709\u4eba\u544a\u53d1\u8bf4\uff0c\u5353\u8302\u5c5e\u4e0b\u7684\u4ead\u957f\u63a5\u53d7\u4e86\u4ed6\u8d60\u9001\u7684\u7c73\u548c\u8089\u3002\u5353\u8302\u95ee\uff1a\u201c\u662f\u4ead\u957f\u5411\u4f60\u8981\u7684\u5462\uff0c\u8fd8\u662f\u4f60\u6709\u4e8b\u6258\u4ed6\u4ed6\u624d\u63a5\u53d7\u7684\u5462\uff0c\u8fd8\u662f\u5e73\u65f6\u4f60\u51fa\u4e8e\u60c5\u8c0a\u81ea\u5df1\u9001\u7ed9\u4ed6\u7684\u5462\uff1f\u201d\u90a3\u4eba\u8bf4\uff1a\u201c\u662f\u6211\u81ea\u5df1\u524d\u53bb\u9001\u7ed9\u4ed6\u7684\u3002\u201d\u5353\u8302\u8bf4\uff1a\u201c\u4f60\u9001\u7ed9\u4ed6\uff0c\u4ed6\u63a5\u53d7\u4e86\uff0c\u4e3a\u4ec0\u4e48\u8fd8\u8981\u6765\u544a\u53d1\u5462\uff1f\u201d\u90a3\u4eba\u8bf4\uff1a\u201c\u6211\u79c1\u4e0b\u542c\u8bf4\uff0c\u8d24\u660e\u7684\u541b\u4e3b\u8ba9\u767e\u59d3\u4e0d\u754f\u60e7\u5b98\u540f\uff0c\u5b98\u540f\u4e5f\u4e0d\u5411\u767e\u59d3\u7d22\u53d6\u8d22\u7269\u3002\u5982\u4eca\u6211\u5bb3\u6015\u5b98\u540f\uff0c\u6240\u4ee5\u9001\u4e1c\u897f\u7ed9\u4ed6\uff1b\u5b98\u540f\u7ec8\u7a76\u6536\u4e0b\u4e86\uff0c\u6240\u4ee5\u6765\u62a5\u544a\u3002\u201d\u5353\u8302\u8bf4\uff1a\u201c\u4f60\u771f\u662f\u4e2a\u5fb7\u884c\u6d45\u8584\u7684\u4eba\uff01\u4eba\u4e4b\u6240\u4ee5\u80fd\u6210\u7fa4\u5c45\u4f4f\u800c\u4e0d\u6df7\u4e71\uff0c\u4e0e\u79bd\u517d\u4e0d\u540c\uff0c\u662f\u56e0\u4e3a\u6709\u4ec1\u7231\u793c\u4e49\uff0c\u61c2\u5f97\u5f7c\u6b64\u656c\u91cd\u3002\u4f60\u504f\u504f\u4e0d\u80af\u4fee\u4e60\u8fd9\u4e9b\uff0c\u96be\u9053\u80fd\u8fdc\u8d70\u9ad8\u98de\u3001\u4e0d\u6d3b\u5728\u4eba\u95f4\u5417\uff01\u5b98\u540f\u5f53\u7136\u4e0d\u5e94\u5f53\u4ed7\u6043\u6743\u52bf\u5f3a\u6c42\u7d22\u53d6\u7f62\u4e86\u3002\u4ead\u957f\u4e00\u5411\u662f\u4e2a\u597d\u5b98\u540f\uff0c\u6bcf\u5e74\u6309\u65f6\u8282\u9001\u4ed6\u4e00\u70b9\u793c\u7269\uff0c\u662f\u5408\u4e4e\u793c\u7684\u3002\u201d\u90a3\u4eba\u8bf4\uff1a\u201c\u5982\u679c\u8fd9\u6837\uff0c\u6cd5\u5f8b\u4e3a\u4ec0\u4e48\u8fd8\u8981\u7981\u6b62\u5462\uff1f\u201d\u5353\u8302\u7b11\u7740\u8bf4\uff1a\u201c\u6cd5\u5f8b\u8bbe\u7acb\u91cd\u5927\u89c4\u8303\uff0c\u793c\u5219\u987a\u5e94\u4eba\u7684\u5e38\u60c5\u3002\u73b0\u5728\u6211\u7528\u793c\u6765\u6559\u5bfc\u4f60\uff0c\u4f60\u4e00\u5b9a\u6ca1\u6709\u6028\u6068\uff1b\u5982\u679c\u7528\u6cd5\u5f8b\u6765\u60e9\u529e\u4f60\uff0c\u4f60\u5c06\u8fde\u624b\u811a\u90fd\u65e0\u5904\u5b89\u653e\uff01\u540c\u4e00\u95e8\u7c7b\u4e2d\u7684\u4e8b\uff0c\u5f80\u5c0f\u5904\u8bf4\u53ef\u4ee5\u8bba\u7f6a\uff0c\u5f80\u5927\u5904\u8bf4\u53ef\u4ee5\u6740\u5934\u3002\u4f60\u6682\u4e14\u56de\u53bb\u597d\u597d\u60f3\u60f3\u5427\uff01\u201d\u5f53\u521d\uff0c\u5353\u8302\u521a\u5230\u5bc6\u53bf\u65f6\uff0c\u5bf9\u53bf\u4e2d\u653f\u52a1\u6709\u6240\u5174\u9769\uff0c\u5b98\u540f\u767e\u59d3\u5632\u7b11\u4ed6\uff0c\u90bb\u53bf\u7684\u4eba\u542c\u8bf4\u540e\u4e5f\u90fd\u8ba5\u7b11\u4ed6\u6ca1\u6709\u624d\u80fd\u3002\u6cb3\u5357\u90e1\u53c8\u7ed9\u5bc6\u53bf\u59d4\u6d3e\u4e86\u4e00\u4f4d\u4ee3\u7406\u53bf\u4ee4\uff0c\u4e0e\u5353\u8302\u5e73\u8d77\u5e73\u5750\uff1b\u5353\u8302\u5e76\u4e0d\u56e0\u6b64\u611f\u5230\u4e0d\u5feb\uff0c\u4ecd\u7167\u5e38\u5904\u7406\u653f\u52a1\u3002\u51e0\u5e74\u4e4b\u540e\uff0c\u6559\u5316\u5e7f\u6cdb\u63a8\u884c\uff0c\u9053\u8def\u4e0a\u9057\u5931\u7684\u4e1c\u897f\u6ca1\u6709\u4eba\u6361\u62fe\uff1b\u5353\u8302\u5347\u4efb\u4eac\u90e8\u4e1e\uff0c\u5bc6\u53bf\u8001\u5c11\u90fd\u6d41\u6cea\u8ddf\u968f\u76f8\u9001\u3002\u7b49\u5230\u738b\u83bd\u5c45\u6444\u65f6\uff0c\u5353\u8302\u56e0\u75c5\u514d\u804c\u56de\u4e61\u3002\u5149\u6b66\u5e1d\u5218\u79c0\u5373\u4f4d\u540e\uff0c\u9996\u5148\u5bfb\u8bbf\u5353\u8302\uff0c\u5f53\u65f6\u5353\u8302\u5df2\u4e03\u5341\u591a\u5c81\u3002\u7532\u7533\uff0c\u4e5f\u5c31\u662f\u4e5d\u6708\u5341\u4e5d\u65e5\uff0c\u5149\u6b66\u5e1d\u4e0b\u8bcf\u8bf4\uff1a\u201c\u540d\u671b\u51a0\u4e8e\u5929\u4e0b\u7684\u4eba\uff0c\u5e94\u5f53\u53d7\u5230\u5929\u4e0b\u6700\u91cd\u7684\u5c01\u8d4f\u3002\u73b0\u5728\u4efb\u547d\u5353\u8302\u4e3a\u592a\u5085\uff0c\u5c01\u4e3a\u8912\u5fb7\u4faf\u3002\u201d","content_jianti_auto":"14\u521d\uff0c\u5b9b\u4eba\u5353\u8302\uff0c\u5bbd\u4ec1\u606d\u7231\uff0c\u606c\u8361\u4e50\u9053\uff0c\u96c5\u5b9e\u4e0d\u4e3a\u534e\u8c8c\uff0c\u884c\u5df1\u5728\u4e8e\u6e05\u6d4a\u4e4b\u95f4\uff0c\u81ea\u675f\u53d1\u81f3\u767d\u9996\uff0c\u672a\u5c1d\u4e0e\u4eba\u6709\u4e89\u7ade\uff0c\u9115\u515a\u6545\u65e7\uff0c\u867d\u884c\u80fd\u4e0e\u8302\u4e0d\u540c\uff0c\u800c\u7686\u7231\u6155\u6b23\u6b23\u7109\u3002\u54c0\u3001\u5e73\u95f4\u4e3a\u5bc6\u4ee4\uff0c\u89c6\u6c11\u5982\u5b50\uff0c\u4e3e\u5584\u800c\u6559\uff0c\u53e3\u65e0\u6076\u8a00\uff0c\u540f\u6c11\u4eb2\u7231\uff0c\u4e0d\u5fcd\u6b3a\u4e4b\u3002\u6c11\u5c1d\u6709\u8a00\u90e8\u4ead\u957f\u53d7\u5176\u7c73\u8089\u9057\u8005\uff0c\u8302\u66f0\uff1a\u300c\u4ead\u957f\u4e3a\u4ece\u6c5d\u6c42\u4e4e\uff0c\u4e3a\u6c5d\u6709\u4e8b\u5631\u4e4b\u800c\u53d7\u4e4e\uff0c\u5c06\u5e73\u5c45\u81ea\u4ee5\u6069\u610f\u9057\u4e4b\u4e4e\uff1f\u300d\u6c11\u66f0\uff1a\u300c\u5f80\u9057\u4e4b\u8033\u3002\u300d\u8302\u66f0\uff1a\u300c\u9057\u4e4b\u800c\u53d7\uff0c\u4f55\u6545\u8a00\u90aa\uff1f\u300d\u6c11\u66f0\uff1a\u300c\u7a83\u95fb\u8d24\u660e\u4e4b\u541b\uff0c\u4f7f\u6c11\u4e0d\u754f\u540f\uff0c\u540f\u4e0d\u53d6\u6c11\u3002\u4eca\u6211\u754f\u540f\uff0c\u662f\u4ee5\u9057\u4e4b\uff1b\u540f\u65e2\u5352\u53d7\uff0c\u6545\u6765\u8a00\u8033\u3002\u300d\u8302\u66f0\uff1a\u300c\u6c5d\u4e3a\u655d\u6c11\u77e3\uff01\u51e1\u4eba\u6240\u4ee5\u7fa4\u5c45\u4e0d\u4e71\uff0c\u5f02\u4e8e\u79bd\u517d\u8005\uff0c\u4ee5\u6709\u4ec1\u7231\u793c\u4e49\uff0c\u77e5\u76f8\u656c\u4e8b\u4e5f\u3002\u6c5d\u72ec\u4e0d\u6b32\u4fee\u4e4b\uff0c\u5b81\u80fd\u9ad8\u98de\u8fdc\u8d70\uff0c\u4e0d\u5728\u4eba\u95f4\u90aa\uff01\u540f\u987e\u4e0d\u5f53\u4e58\u5a01\u529b\u5f3a\u8bf7\u6c42\u8033\u3002\u4ead\u957f\u7d20\u5584\u540f\uff0c\u5c81\u65f6\u9057\u4e4b\uff0c\u793c\u4e5f\u3002\u300d\u6c11\u66f0\uff1a\u300c\u82df\u5982\u6b64\uff0c\u5f8b\u4f55\u6545\u7981\u4e4b\uff1f\u300d\u8302\u7b11\u66f0\uff1a\u300c\u5f8b\u8bbe\u5927\u6cd5\uff0c\u793c\u987a\u4eba\u60c5\u3002\u4eca\u6211\u4ee5\u793c\u6559\u6c5d\uff0c\u6c5d\u5fc5\u65e0\u6028\u6076\uff1b\u4ee5\u5f8b\u6cbb\u6c5d\uff0c\u6c5d\u4f55\u6240\u63aa\u5176\u624b\u8db3\u4e4e\uff01\u4e00\u95e8\u4e4b\u5185\uff0c\u5c0f\u8005\u53ef\u8bba\uff0c\u5927\u8005\u53ef\u6740\u4e5f\u3002\u4e14\u5f52\u5ff5\u4e4b\uff01\u300d\u521d\uff0c\u8302\u5230\u53bf\uff0c\u6709\u6240\u5e9f\u7f6e\uff0c\u540f\u6c11\u7b11\u4e4b\uff0c\u90bb\u57ce\u95fb\u8005\u7686\u86a9\u5176\u4e0d\u80fd\u3002\u6cb3\u5357\u90e1\u4e3a\u7f6e\u5b88\u4ee4\uff1b\u8302\u4e0d\u4e3a\u5acc\uff0c\u6cbb\u4e8b\u81ea\u82e5\u3002\u6570\u5e74\uff0c\u6559\u5316\u5927\u884c\uff0c\u9053\u4e0d\u62fe\u9057\uff1b\u8fc1\u4eac\u90e8\u4e1e\uff0c\u5bc6\u4eba\u8001\u5c11\u7686\u6d95\u6ce3\u968f\u9001\u3002\u53ca\u738b\u83bd\u5c45\u6444\uff0c\u4ee5\u75c5\u514d\u5f52\u3002\u4e0a\u5373\u4f4d\uff0c\u5148\u8bbf\u6c42\u8302\uff0c\u8302\u65f6\u5e74\u4e03\u5341\u4f59\u3002\u7532\u7533\uff0c\u8bcf\u66f0\uff1a\u300c\u592b\u540d\u51a0\u5929\u4e0b\uff0c\u5f53\u53d7\u5929\u4e0b\u91cd\u8d4f\u3002\u4eca\u4ee5\u8302\u4e3a\u592a\u5085\uff0c\u5c01\u8912\u5fb7\u4faf\u3002\u300d","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"\uff0c\u540d\u4e0d\u7167\u4e8e\u5f53\u65f6\uff0c\u800c\u83bd\u65e0\u6c42\u7109\u3002\u81ea\u62d4\u4e8e\u6d41\u4fd7\uff0c\u800c\u5c45\u7ea6\u4ee5\u81ea\u6c61\uff0c\u6566...","context_before":"...\u975e\u76f4\u4e00\u4e25\u8be9\u4e5f\uff1b\u83bd\u7686\u4e50\u63a8\u4e4b\u4ee5\u8bf1\u5929\u4e0b\uff0c\u5f7c\u4ea6\u4e50\u9644\u83bd\u800c\u6210\u5176\u5229\u8fbe\u3002","source_end_index":188,"source_paragraph_tongjian_id":"16f84dc5-b991-4ea3-bb58-d2b9c384d8dd","source_start_index":180,"source_text":"\u83bd\u5c45\u6444\u800c\u8302\u4ee5\u75c5\u514d"},{"context_after":"\u6269\u611a\u8d31\u4e4b\u660f\u7780\uff0c\u800c\u793a\u4ee5\u5929\u7406\u6d41\u884c\u4e4b\u5b9