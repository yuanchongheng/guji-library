tart_index":1,"tongjian_id":"94945464-db0e-11ef-864d-a0d3651f611f"},{"link_td_description":"杼，姒姓，夏后氏，中国夏朝第七任君主，少康之子，槐的父亲，在位17年。","link_td_id":"Q10003074","link_td_number_id":87582,"people_name":"輿","people_name_jianti_auto":"舆","people_xingming":"舆","start_index":5,"tongjian_id":"94945465-db0e-11ef-a3a9-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":9,"tongjian_id":"94945466-db0e-11ef-9191-a0d3651f611f"},{"link_death_year":46,"link_td_description":"乌达鞮侯，挛鞮氏，为东汉初年匈奴单于。他是呼都而尸道皋若鞮单于之子，于46年继位，同年去世。","link_td_id":"Q10003037","link_td_number_id":403535,"people_name":"烏達鞮侯","people_name_jianti_auto":"乌达鞮侯","people_xingming":"乌达鞮侯","start_index":12,"tongjian_id":"94945467-db0e-11ef-960c-a0d3651f611f"},{"link_td_description":"蒲奴，1世纪北匈奴第一任单于，挛鞮氏。为匈奴呼都而尸道皋若鞮单于之子，乌达鞮侯的弟弟。","link_td_id":"Q10001305","link_td_number_id":470990,"people_name":"左賢王","people_name_jianti_auto":"左贤王","people_xingming":"蒲奴","start_index":22,"tongjian_id":"94945468-db0e-11ef-b834-a0d3651f611f"},{"link_td_description":"蒲奴，1世纪北匈奴第一任单于，挛鞮氏。为匈奴呼都而尸道皋若鞮单于之子，乌达鞮侯的弟弟。","link_td_id":"Q10001305","link_td_number_id":470990,"people_name":"蒲奴","people_name_jianti_auto":"蒲奴","people_xingming":"蒲奴","start_index":25,"tongjian_id":"94945469-db0e-11ef-8772-a0d3651f611f"},{"link_td_description":"李茂，朝鲜半岛族谱记载的中国唐朝将领。660年，唐朝苏定方征伐百济时，李茂担任中郎将。李茂在灭百济战争后归化新罗，成为朝鲜半岛氏族延安李氏的始祖。中国史书里没有对李茂的记载。","link_td_id":"Q10022576","link_td_number_id":7832361,"people_name":"李茂","people_name_jianti_auto":"李茂","people_xingming":"李茂","start_index":76,"tongjian_id":"9494546b-db0e-11ef-b919-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":29,"tongjian_id":"9494546a-db0e-11ef-83bf-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":56,"tongjian_id":"9494546c-db0e-11ef-ae26-a0d3651f611f"},{"place_name":"漁陽","place_name_jianti_auto":"渔阳","resolved_place_entity_id":598,"start_index":65,"tongjian_id":"9494546d-db0e-11ef-b546-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"6匈奴單于輿死，子左賢王烏達鞮侯立；復死，弟左賢王蒲奴立。匈奴中連年旱蝗，赤地數千里，人畜饑疫，死耗太半。單于畏漢乘其敝，乃遣使詣漁陽求和親；帝遣中郞將李茂報命。","content_fanyi":"匈奴单于舆去世，其子左贤王乌达鞮侯即位；不久乌达鞮侯又去世，其弟左贤王蒲奴即位。匈奴连年遭受旱灾和蝗灾，赤地数千里，人和牲畜饥饿疫病，死亡太半。单于畏惧汉朝趁其疲敝之机有所行动，便派使者到渔阳请求和亲；光武帝派中郎将李茂回访报命。","content_jianti_auto":"6匈奴单于舆死，子左贤王乌达鞮侯立；复死，弟左贤王蒲奴立。匈奴中连年旱蝗，赤地数千里，人畜饥疫，死耗太半。单于畏汉乘其敝，乃遣使诣渔阳求和亲；帝遣中郞将李茂报命。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3425,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"94945452-db0e-11ef-8d1a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"亭候","official_note":"亭候是汉代边境的军事官职，负责驻守边塞亭障，用于防御和警戒。在《资治通鉴》此段中，因匈奴北徙，边境压力减轻，光武帝下诏罢免亭候，以节省军力。此信息基于汉代军事制度常识。","official_rank":"未知","source_snippet":"詔罷諸邊郡亭候、吏卒","start_index":28,"tongjian_id":"edfcd86d-276f-49e5-95a0-41ddf15911f5"},{"confidence":0.85,"official_category":"军事指挥","official_name":"吏卒","official_note":"吏卒泛指边境的官吏和士兵，是基层军事人员。在此上下文中，光武帝罢免吏卒，作为调整边境防御政策的一部分，以应对匈奴北徙后的局势。此信息基于汉代军事制度常识。","official_rank":"未知","source_snippet":"詔罷諸邊郡亭候、吏卒","start_index":31,"tongjian_id":"d95ffaad-9fad-41c3-8c52-494bfa2ada25"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"烏桓","place_name_jianti_auto":"乌桓","resolved_place_entity_id":339,"start_index":1,"tongjian_id":"94945470-db0e-11ef-b1ae-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":4,"tongjian_id":"94945471-db0e-11ef-87af-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":13,"tongjian_id":"94969e38-db0e-11ef-ae6f-a0d3651f611f"},{"place_name":"烏桓","place_name_jianti_auto":"乌桓","resolved_place_entity_id":339,"start_index":42,"tongjian_id":"94969e39-db0e-11ef-b3bd-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","外交"],"content":"7烏桓乘匈奴之弱，擊破之，匈奴北徙數千里，幕南地空。詔罷諸邊郡亭候、吏卒，以幣帛招降烏桓。","content_fanyi":"乌桓乘着匈奴衰弱之机，出兵击败匈奴。匈奴向北迁徙数千里，大漠以南地区空无人烟。朝廷下诏撤销沿边各郡的哨所和戍卒，用币帛招降乌桓。","content_jianti_auto":"7乌桓乘匈奴之弱，击破之，匈奴北徙数千里，幕南地空。诏罢诸边郡亭候、吏卒，以币帛招降乌桓。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3426,"number":7,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"9494546e-db0e-11ef-a1db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":9,"tongjian_id":"94969e3c-db0e-11ef-91f3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"龜茲","place_name_jianti_auto":"龟兹","start_index":0,"tongjian_id":"94969e3d-db0e-11ef-9205-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"龜茲，前書音丘慈。賢曰：今龜，音丘勿翻；茲，音沮惟翻；蓋急言耳。","note_content_jianti_auto":"龟兹，前书音丘慈。贤曰：今龟，音丘勿翻；兹，音沮惟翻；盖急言耳。","note_type":"hu_note","start_index":39,"tongjian_id":"94969e3b-db0e-11ef-a5b8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。","note_content_jianti_auto":"复，扶又翻；下同。","note_type":"hu_note","start_index":54,"tongjian_id":"94969e3f-db0e-11ef-a117-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"任其所從。","note_content_jianti_auto":"任其所从。","note_type":"hu_note","start_index":103,"tongjian_id":"94969e40-db0e-11ef-bad4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"都護","official_note":"都護是漢朝在西域設置的軍事和行政長官，負責管理西域諸國，維護邊疆穩定。在《資治通鑑》此段中，莎車王賢因都護未到而攻擊鄯善和龜茲，顯示都護的缺席導致西域局勢動盪，鄯善王因此上書請求派遣都護以對抗匈奴壓力。","official_rank":"未知","source_snippet":"都護不至","start_index":28,"tongjian_id":"a309d125-6c35-4e56-9059-84d284433fb6"},{"confidence":0.9,"official_category":"地方行政","official_name":"都護","official_note":"都護是漢朝在西域設置的軍事和行政長官，負責管理西域諸國，維護邊疆穩定。在《資治通鑑》此段中，鄯善王上書請求派遣都護，以應對匈奴的威脅，顯示都護在維護西域秩序和漢朝影響力中的關鍵作用。","official_rank":"未知","source_snippet":"更請都護","start_index":48,"tongjian_id":"d7902a23-d2e9-4b2d-ae9d-ebd5c30b7bae"},{"confidence":0.9,"official_category":"地方行政","official_name":"都護","official_note":"都護是漢朝在西域設置的軍事和行政長官，負責管理西域諸國，維護邊疆穩定。在《資治通鑑》此段中，鄯善王指出都護未出，導致西域諸國被迫依附匈奴，強調都護在防禦外敵和穩定邊疆中的重要性。","official_rank":"未知","source_snippet":"都護不出","start_index":53,"tongjian_id":"4272b5bf-ce88-481e-80d3-85abeadcd66f"}],"ExtRef_Children_people":[{"people_name":"莎車王","people_name_jianti_auto":"莎车王","people_xingming":"贤","start_index":18,"tongjian_id":"9496c5d5-db0e-11ef-86e7-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","people_xingming":"贤","start_index":21,"tongjian_id":"9496c5d6-db0e-11ef-9066-a0d3651f611f"},{"people_name":"龜茲王","people_name_jianti_auto":"龟兹王","people_xingming":"龟兹王","start_index":35,"tongjian_id":"9496c5d7-db0e-11ef-b5f2-a0d3651f611f"},{"people_name":"鄯善王","people_name_jianti_auto":"鄯善王","people_xingming":"安","start_index":39,"tongjian_id":"9496c5db-db0e-11ef-9c45-a0d3651f611f"},{"people_name":"安","people_name_jianti_auto":"安","people_xingming":"安","start_index":42,"tongjian_id":"9496c5dc-db0e-11ef-90f4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":1,"tongjian_id":"9496c5d8-db0e-11ef-a902-a0d3651f611f"},{"place_name":"敦煌","place_name_jianti_auto":"敦煌","resolved_place_entity_id":334,"start_index":9,"tongjian_id":"9496c5d9-db0e-11ef-b946-a0d3651f611f"},{"place_name":"鄯善","place_name_jianti_auto":"鄯善","resolved_place_entity_id":960,"start_index":30,"tongjian_id":"9496c5da-db0e-11ef-a8a8-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":67,"tongjian_id":"94970569-db0e-11ef-a1ba-a0d3651f611f"},{"place_name":"鄯善","place_name_jianti_auto":"鄯善","resolved_place_entity_id":960,"start_index":105,"tongjian_id":"9497056a-db0e-11ef-b040-a0d3651f611f"},{"place_name":"車師","place_name_jianti_auto":"车师","resolved_place_entity_id":759,"start_index":108,"tongjian_id":"9497056b-db0e-11ef-b847-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":112,"tongjian_id":"9497056c-db0e-11ef-8185-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"},{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、哈密卫（卷六十五）","excerpts":[{"context_after":"永平十六年，班超使西域，击杀其使处也。元初末，北单于与车...","context_before":"...善以西南道。后汉建武二十一年，西域鄯善等八国俱遣子入侍。","source_end_index":259,"source_paragraph_tongjian_id":"f6763018-3fbd-57fc-b115-2951e167fad9","source_start_index":247,"source_text":"二十二年，莎车击破鄯善。"},{"context_after":"永平、建初间，与焉耆皆不附汉。永元三年，始与姑墨、温宿诸...","context_before":"...。王莽天凤三年，戊己校尉李崇为焉耆所败，收余士还保龟兹。","source_end_index":145,"source_paragraph_tongjian_id":"beab8f9b-93da-5c60-af81-c117c2ac9a7f","source_start_index":97,"source_text":"后汉建武二十一年，莎车攻龟兹，杀其王。匈奴复立龟兹质子建为王。建恃其威，据有北道，攻掠疏勒诸国。"},{"context_after":"永平三年，又以兵威逼，夺于阗、大宛、妫塞诸国，使其将守之...","context_before":"...有西域，莎车独不附。后汉建武中，莎车、鄯善，皆遣使奉献。","source_end_index":160,"source_paragraph_tongjian_id":"ff0f228c-dd37-5a98-b42e-e83e9fb2c672","source_start_index":137,"source_text":"既而稍贰于汉。二十一年，击破鄯善，攻杀龟兹王。"}],"path":"陕西方舆纪要/十四、哈密卫（卷六十五）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"8西域諸國侍子久留敦煌，皆愁思亡歸。莎車王賢知都護不至，擊破鄯善，攻殺龜茲王。鄯善王安上書：「願復遣子入侍，更請都護；都護不出，誠迫於匈奴。」帝報曰：「今使者大兵未能得出，如諸國力不從心，東西南北自在也。」於是鄯善、車師復附匈奴。","content_fanyi":"西域各国入侍的王子长期滞留在敦煌，都因忧愁而想逃回本国。莎车王贤知道汉朝都护不会前来，便击败鄯善，攻杀龟兹王。鄯善王安上书说：“希望再派儿子入朝侍奉，重新请求设置都护；都护如果不来，我们实在受匈奴逼迫。”光武帝答复说：“现在使者和军队还不能派出，如果各国力不从心，东西南北随你们自行选择。”于是鄯善、车师又归附了匈奴。","content_jianti_auto":"8西域诸国侍子久留敦煌，皆愁思亡归。莎车王贤知都护不至，击破鄯善，攻杀龟兹王。鄯善王安上书：「愿复遣子入侍，更请都护；都护不出，诚迫于匈奴。」帝报曰：「今使者大兵未能得出，如诸国力不从心，东西南北自在也。」于是鄯善、车师复附匈奴。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"灼见其不足为有无而决之矣。","context_before":"...入，抑何事南绕玉门万里而窥河西？则武帝、张骞之诬也较著。","source_end_index":154,"source_paragraph_tongjian_id":"5979f6db-21c5-4e1a-984a-4153b259d67a","source_start_index":134,"source_text":"光武闭关而绝之，曰：“东西南北自在也。”"}],"title":"三三 光武识西域不足为有无"},{"excerpts":[{"context_after":"，班固赞其盛德。超，固之弟也。尝读固之遗文，其往来报超于...","context_before":"","source_end_index":9,"source_paragraph_tongjian_id":"d2589941-6f75-4984-81e8-e2152d774a68","source_start_index":0,"source_text":"光武闭玉门，绝西域"}],"title":"九 班超平定西域不足为智勇"}],"id":3427,"number":8,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"94969e3a-db0e-11ef-a63e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"南羌","place_name_jianti_auto":"南羌","start_index":0,"tongjian_id":"94972835-db0e-11ef-a01a-a0d3651f611f"},{"place_name":"湟中","place_name_jianti_auto":"湟中","start_index":4,"tongjian_id":"94972836-db0e-11ef-873d-a0d3651f611f"},{"place_name":"羌","place_name_jianti_auto":"羌","start_index":7,"tongjian_id":"94972837-db0e-11ef-9a28-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"南羌，卽湟中諸羌。從，子容翻。","note_content_jianti_auto":"南羌，即湟中诸羌。从，子容翻。","note_type":"hu_note","start_index":27,"tongjian_id":"94972834-db0e-11ef-812f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"武威","place_name_jianti_auto":"武威","start_index":3,"tongjian_id":"94972839-db0e-11ef-b321-a0d3651f611f"},{"place_name":"張掖","place_name_jianti_auto":"张掖","start_index":6,"tongjian_id":"9497283a-db0e-11ef-9f73-a0d3651f611f"},{"place_name":"酒泉","place_name_jianti_auto":"酒泉","start_index":9,"tongjian_id":"9497283b-db0e-11ef-a89d-a0d3651f611f"},{"place_name":"敦煌","place_name_jianti_auto":"敦煌","start_index":12,"tongjian_id":"9497283c-db0e-11ef-bdb6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"四郡：武威、張掖、酒泉、敦煌也。","note_content_jianti_auto":"四郡：武威、张掖、酒泉、敦煌也。","note_type":"hu_note","start_index":35,"tongjian_id":"94972838-db0e-11ef-be1c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高","people_name_jianti_auto":"高","start_index":0,"tongjian_id":"9497283f-db0e-11ef-841c-a0d3651f611f"},{"people_name":"惠","people_name_jianti_auto":"惠","start_index":2,"tongjian_id":"94972840-db0e-11ef-922e-a0d3651f611f"},{"people_name":"呂后","people_name_jianti_auto":"吕后","start_index":4,"tongjian_id":"94972841-db0e-11ef-9ba8-a0d3651f611f"},{"people_name":"文","people_name_jianti_auto":"文","start_index":7,"tongjian_id":"94972842-db0e-11ef-858d-a0d3651f611f"},{"people_name":"景","people_name_jianti_auto":"景","start_index":9,"tongjian_id":"94972843-db0e-11ef-b809-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高、惠及呂后、文、景爲五世。","note_content_jianti_auto":"高、惠及吕后、文、景为五世。","note_type":"hu_note","start_index":88,"tongjian_id":"9497283e-db0e-11ef-a2b7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":6,"tongjian_id":"94972847-db0e-11ef-89ed-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"觀，古玩翻。師古曰：視，讀曰示，觀視之者，示之令觀也。","note_content_jianti_auto":"观，古玩翻。师古曰：视，读曰示，观视之者，示之令观也。","note_type":"hu_note","start_index":198,"tongjian_id":"94972846-db0e-11ef-8c8b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事並見武帝紀。","note_content_jianti_auto":"事并见武帝纪。","note_type":"hu_note","start_index":326,"tongjian_id":"9497284e-db0e-11ef-8c8c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"监察","official_name":"直指之使","official_note":"直指之使是漢代皇帝派出的特使，負責巡視地方、監察官員和處理緊急事務，通常有權直接處決違法者。在上下文中，這反映了漢武帝時期因財政困難和社會動盪，派遣特使到郡國進行鎮壓和整頓。","official_rank":"未知","source_snippet":"直指之使始出","start_index":279,"tongjian_id":"ba9c83e6-9ca9-497d-afe6-04030e07c696"}],"ExtRef_Children_people":[{"link_birth_year":32,"link_death_year":92,"link_td_description":"班固，字孟坚，扶风安陵（今陕西咸阳）人，东汉历史学家，《汉书》作者。","link_td_id":"Q10004773","link_td_number_id":12023,"people_name":"班固","people_name_jianti_auto":"班固","people_xingming":"班固","start_index":0,"tongjian_id":"94972850-db0e-11ef-b12b-a0d3651f611f"},{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"孝武","people_name_jianti_auto":"孝武","people_xingming":"刘彻","start_index":5,"tongjian_id":"94972851-db0e-11ef-b06e-a0d3651f611f","wl_zhushi":"[刘彻]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"文","people_name_jianti_auto":"文","people_xingming":"刘恒","start_index":77,"tongjian_id":"9497285a-db0e-11ef-8d19-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-188,"link_death_year":-141,"link_td_description":"汉景帝刘启，为汉朝皇帝（前157年7月14日－前141年3月9日在位），在位16年，享年48岁，其正式谥号为「孝景皇帝」，后世省略「孝」字称「汉景帝」。为汉文帝刘恒长子，母窦皇后。他在位期间，主要是削诸侯封地，平定七国之乱，巩固中央集权，勤俭治国，发展生产，他和其父亲文帝的统治时期合称文景之治，为中国自大一统以来的首个太平盛世。","link_td_id":"Q10000365","link_td_number_id":90408,"people_name":"景","people_name_jianti_auto":"景","people_xingming":"刘启","start_index":79,"tongjian_id":"9497285b-db0e-11ef-afae-a0d3651f611f","wl_zhushi":"[刘启]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":12,"tongjian_id":"94972852-db0e-11ef-93b1-a0d3651f611f"},{"place_name":"南羌","place_name_jianti_auto":"南羌","resolved_place_entity_id":2805,"start_index":24,"tongjian_id":"94972853-db0e-11ef-b0b4-a0d3651f611f"},{"place_name":"河曲","place_name_jianti_auto":"河曲","resolved_place_entity_id":1307,"start_index":29,"tongjian_id":"94972854-db0e-11ef-ad76-a0d3651f611f"},{"place_name":"玉門","place_name_jianti_auto":"玉门","resolved_place_entity_id":1583,"start_index":36,"tongjian_id":"94972855-db0e-11ef-896d-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":40,"tongjian_id":"94972856-db0e-11ef-a5d6-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":45,"tongjian_id":"94972857-db0e-11ef-abb9-a0d3651f611f"},{"place_name":"南羌","place_name_jianti_auto":"南羌","resolved_place_entity_id":2805,"start_index":52,"tongjian_id":"94972858-db0e-11ef-9ff1-a0d3651f611f"},{"place_name":"月氏","place_name_jianti_auto":"月氏","resolved_place_entity_id":1804,"start_index":55,"tongjian_id":"94972859-db0e-11ef-a0f0-a0d3651f611f"},{"place_name":"珠厓","place_name_jianti_auto":"珠厓","resolved_place_entity_id":2934,"start_index":109,"tongjian_id":"9497285c-db0e-11ef-8bbe-a0d3651f611f"},{"place_name":"牂柯","place_name_jianti_auto":"牂柯","resolved_place_entity_id":1410,"start_index":123,"tongjian_id":"9497285d-db0e-11ef-a4a0-a0d3651f611f"},{"place_name":"越巂","place_name_jianti_auto":"越巂","resolved_place_entity_id":1139,"start_index":126,"tongjian_id":"9497285e-db0e-11ef-868f-a0d3651f611f"},{"place_name":"大宛","place_name_jianti_auto":"大宛","resolved_place_entity_id":377,"start_index":138,"tongjian_id":"9497285f-db0e-11ef-bf43-a0d3651f611f"},{"place_name":"安息","place_name_jianti_auto":"安息","resolved_place_entity_id":2003,"start_index":141,"tongjian_id":"94972860-db0e-11ef-85e0-a0d3651f611f"},{"place_name":"輪臺","place_name_jianti_auto":"轮台","resolved_place_entity_id":2526,"start_index":306,"tongjian_id":"94972861-db0e-11ef-b194-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十二、陕西行都指挥使司（卷六十三）","excerpts":[{"context_after":"盖其地跨越边塞，保险阻，宜畜牧，自古称凉州之畜为天下饶也...","context_before":"镇河山襟带，扼束羌戎。","source_end_index":138,"source_paragraph_tongjian_id":"361617f7-5842-51c1-8783-450edf4bb5f8","source_start_index":11,"source_text":"汉武开河西，遏绝羌与匈奴相通之路，使不能解仇合约，为中国患。刘歆言：武帝西伐大宛，并三十六国，结乌孙，起敦煌、酒泉、张掖，以隔婼羌，裂匈奴之右臂[歆又云：孝武表河曲，列四郡，开玉门，通西域，以断匈奴右臂，隔绝南羌月氏。单于失援，繇是远遁，而幕南无王庭]。"}],"path":"陕西方舆纪要/十二、陕西行都指挥使司（卷六十三）","source_name":"读史方舆纪要"}],"class_tags":["史论"],"content":"班固論曰：孝武之世，圖制匈奴，患其兼從西國，結黨南羌，乃表河曲列四郡，開玉門，通西域，以斷匈奴右臂，隔絕南羌、月氏；單于失援，由是遠遁，而幕南無王庭。遭值文、景玄默，養民五世，財力有餘，士馬強盛，故能睹犀布、瑇瑁，則建珠厓七郡；感蒟醬、竹杖，則開牂柯、越巂；聞天馬、蒲陶，則通大宛、安息；自是殊方異物，四面而至。於是開苑囿，廣宮室，盛帷帳，美服玩，設酒池肉林以饗四夷之客，作魚龍角抵之戲以觀視之；及賂遺贈送，萬里相奉，師旅之費，不可勝計。至於用度不足，乃榷酒酤，筦鹽鐵，鑄白金，造皮幣，算至車船，租及六畜。民力屈，財用竭，因之以凶年，寇盜並起，道路不通，直指之使始出，衣繡杖斧，斷斬於郡國，然後勝之。是以末年遂棄輪臺之地而下哀痛之詔，豈非仁聖之所悔哉！","content_fanyi":"班固评论说：孝武皇帝时代，筹划制服匈奴，担心它兼并役使西域各国、与南羌结为同党，于是以河曲为边界标志，设置四郡，打开玉门关，打通西域，以切断匈奴右臂，隔绝南羌、月氏；单于失去援助，因此远远逃遁，大漠以南不再有匈奴王庭。当时正值文帝、景帝清静无为，养育百姓已历五世，财力有余，兵马强盛。所以能够看到犀牛皮、玳瑁，就设置珠崖等七郡；接触到蒟酱、竹杖，就开辟牂柯、越巂；听说天马、葡萄，就通好大宛、安息；从此远方异域的珍奇物品，从四方而来。于是开辟苑囿，扩建宫室，盛设帷帐，精饰服玩，设置酒池肉林来宴请四夷宾客，表演鱼龙、角抵之戏来供他们观赏；再加上馈赠、赠送之物，万里之间相互进献，军队的费用，无法尽算。等到用度不足，就实行酒类专卖，管制盐铁，铸造白金，制作皮币，征税至于车船，租赋及于六畜。民力耗尽，财用枯竭，接着又遇上荒年，盗贼并起，道路不通，直指使者开始派出，身穿绣衣、手持斧钺，在郡国中斩杀，这样之后才将盗贼平定。因此武帝末年终于放弃轮台一带，颁下哀痛诏书，这难道不是仁圣之君的悔悟吗！","content_jianti_auto":"班固论曰：孝武之世，图制匈奴，患其兼从西国，结党南羌，乃表河曲列四郡，开玉门，通西域，以断匈奴右臂，隔绝南羌、月氏；单于失援，由是远遁，而幕南无王庭。遭值文、景玄默，养民五世，财力有余，士马强盛，故能睹犀布、瑇瑁，则建珠厓七郡；感蒟酱、竹杖，则开牂柯、越巂；闻天马、蒲陶，则通大宛、安息；自是殊方异物，四面而至。于是开苑囿，广宫室，盛帷帐，美服玩，设酒池肉林以飨四夷之客，作鱼龙角抵之戏以观视之；及赂遗赠送，万里相奉，师旅之费，不可胜计。至于用度不足，乃榷酒酤，筦盐铁，铸白金，造皮币，算至车船，租及六畜。民力屈，财用竭，因之以凶年，寇盗并起，道路不通，直指之使始出，衣绣杖斧，断斩于郡国，然后胜之。是以末年遂弃轮台之地而下哀痛之诏，岂非仁圣之所悔哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":3428,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"94972833-db0e-11ef-9f26-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"禹","people_name_jianti_auto":"禹","start_index":19,"tongjian_id":"94972867-db0e-11ef-81e2-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":36,"tongjian_id":"94972868-db0e-11ef-a2e4-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":41,"tongjian_id":"94972869-db0e-11ef-8a7e-a0d3651f611f"},{"people_name":"成王","people_name_jianti_auto":"成王","start_index":44,"tongjian_id":"9497286a-db0e-11ef-ad6d-a0d3651f611f"},{"people_name":"成王","people_name_jianti_auto":"成王","start_index":58,"tongjian_id":"9497286b-db0e-11ef-8991-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":61,"tongjian_id":"9497286c-db0e-11ef-9f13-a0d3651f611f"},{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":167,"tongjian_id":"9497286d-db0e-11ef-a9a3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西戎","place_name_jianti_auto":"西戎","start_index":4,"tongjian_id":"9497286e-db0e-11ef-95d4-a0d3651f611f"},{"place_name":"越裳氏","place_name_jianti_auto":"越裳氏","start_index":47,"tongjian_id":"9497286f-db0e-11ef-94b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"禹貢曰：西戎卽序。卽，就也；序，次也。禹就而序之，非尚威服，致其貢物也。師古曰：昔周公相成王，越裳氏重九譯而獻白雉。成王問周公，公曰：「德不加焉，則君子不饗其質，政不施焉，則君子不臣其遠；吾何以獲此物也？」譯曰：「吾受命、國之黃耇曰：『久矣天之無烈風雷雨也，意者中國有聖人乎？』」然後歸之王，稱先王之神所致，以薦宗廟。卻走馬事見十三卷文帝元年。","note_content_jianti_auto":"禹贡曰：西戎即序。即，就也；序，次也。禹就而序之，非尚威服，致其贡物也。师古曰：昔周公相成王，越裳氏重九译而献白雉。成王问周公，公曰：「德不加焉，则君子不飨其质，政不施焉，则君子不臣其远；吾何以获此物也？」译曰：「吾受命、国之黄耇曰：『久矣天之无烈风雷雨也，意者中国有圣人乎？』」然后归之王，称先王之神所致，以荐宗庙。却走马事见十三卷文帝元年。","note_type":"hu_note","start_index":214,"tongjian_id":"94972866-db0e-11ef-9ef4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"杜欽","people_name_jianti_auto":"杜钦","people_xingming":"杜钦","start_index":29,"tongjian_id":"94972871-db0e-11ef-8787-a0d3651f611f"},{"link_birth_year":-53,"link_death_year":18,"link_td_description":"扬雄，字子云，姓名又作杨雄，蜀郡成都（今四川成都郫都区）人，西汉哲学家、文学家、语言学家。","link_td_id":"Q10000105","link_td_number_id":68672,"people_name":"揚雄","people_name_jianti_auto":"扬雄","people_xingming":"扬雄","start_index":32,"tongjian_id":"94972872-db0e-11ef-bca6-a0d3651f611f"},{"link_td_description":"禹，姒姓，夏后氏，传说名文命，后世尊称为大禹。远古时期中国神话人物，是黄帝轩辕氏八世孙，因在大禹治水中成功治理洪水之患的故事而广为人知。传说中，禹是中国历史上第一个家天下政权夏朝的开创者，定都于阳城（具体所在有多种说法）。禹在尧时被封为夏伯，故史书又称伯禹、夏禹。在道教信仰里，禹也被尊为水官大帝、水仙尊王。","link_td_id":"Q10000013","link_td_number_id":4218,"people_name":"大禹","people_name_jianti_auto":"大禹","people_xingming":"姒文命","start_index":188,"tongjian_id":"94972881-db0e-11ef-8bf3-a0d3651f611f","wl_zhushi":"[姒文命]"},{"link_td_description":"周公旦，姬姓，周氏，名旦，谥文，又称周文公、周公。周文王第四子、周武王之弟，西周初年政治家，封于周邑，为诸侯国鲁国之祖，创“礼乐制度”。武则天天授元年（690年）追封为“褒德王”，宋真宗大中祥符元年（1008年）追封为“文宪王”，后世多称其“元圣”。","link_td_id":"Q10000209","link_td_number_id":15573,"people_name":"周公","people_name_jianti_auto":"周公","people_xingming":"姬旦","start_index":195,"tongjian_id":"94972882-db0e-11ef-9e37-a0d3651f611f","wl_zhushi":"[姬旦]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"太宗","people_name_jianti_auto":"太宗","people_xingming":"刘恒","start_index":202,"tongjian_id":"94972883-db0e-11ef-9e8b-a0d3651f611f","wl_zhushi":"[刘恒]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":2,"tongjian_id":"94972873-db0e-11ef-8a57-a0d3651f611f"},{"place_name":"龍堆","place_name_jianti_auto":"龙堆","resolved_place_entity_id":10117,"start_index":7,"tongjian_id":"94972874-db0e-11ef-9296-a0d3651f611f"},{"place_name":"葱嶺","place_name_jianti_auto":"葱岭","resolved_place_entity_id":2180,"start_index":12,"tongjian_id":"94972875-db0e-11ef-b74d-a0d3651f611f"},{"place_name":"身熱","place_name_jianti_auto":"身热","resolved_place_entity_id":5345,"start_index":15,"tongjian_id":"94972876-db0e-11ef-897d-a0d3651f611f"},{"place_name":"頭痛","place_name_jianti_auto":"头痛","resolved_place_entity_id":9822,"start_index":18,"tongjian_id":"94972877-db0e-11ef-a970-a0d3651f611f"},{"place_name":"懸度","place_name_jianti_auto":"悬度","resolved_place_entity_id":7095,"start_index":21,"tongjian_id":"94972878-db0e-11ef-b1f9-a0d3651f611f"},{"place_name":"淮南","place_name_jianti_auto":"淮南","resolved_place_entity_id":108,"start_index":26,"tongjian_id":"94972879-db0e-11ef-ab70-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":55,"tongjian_id":"9497287a-db0e-11ef-abd0-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":77,"tongjian_id":"9497287b-db0e-11ef-8eaa-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":85,"tongjian_id":"9497287c-db0e-11ef-b5a6-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":107,"tongjian_id":"9497287d-db0e-11ef-a65f-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","resolved_place_entity_id":259,"start_index":145,"tongjian_id":"9497287e-db0e-11ef-9115-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":148,"tongjian_id":"9497287f-db0e-11ef-9f40-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":163,"tongjian_id":"94972880-db0e-11ef-92f2-a0d3651f611f"},{"place_name":"西戎","place_name_jianti_auto":"西戎","resolved_place_entity_id":927,"start_index":192,"tongjian_id":"94972884-db0e-11ef-a899-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"《后·西域传》：自敦煌西出玉门、阳关，涉鄯善，北通伊吾千...","context_before":"...玉门曰：军有敢入者，辄斩之。又遣军正任文屯玉门关，是也。","source_end_index":132,"source_paragraph_tongjian_id":"23e2d8a3-0e3b-5e62-bf03-9dae4ba5d5c8","source_start_index":115,"source_text":"后汉建武中，闭玉门关，谢西域之质。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":["外交","史论"],"content":"且通西域，近有龍堆，遠則葱嶺，身熱、頭痛、懸度之阨，淮南、杜欽、揚雄之論，皆以爲此天地所以界別區域，絕外內也。西域諸國，各有君長，兵衆分弱，無所統一，雖屬匈奴，不相親附；匈奴能得其馬畜、旃罽而不能統率，與之進退。與漢隔絕，道里又遠，得之不爲益，棄之不爲損，盛德在我，無取於彼。故自建武以來，西域思漢威德，咸樂內屬，數遣使置質于漢，願請都護。聖上遠覽古今，因時之宜，辭而未許；雖大禹之序西戎，周公之讓白雉，太宗之卻走馬，義兼之矣！","content_fanyi":"况且通使西域，近处有龙堆，远处有葱岭，又有身热、头痛、悬度等险阻；淮南王刘安、杜钦、扬雄的议论，都认为这是天地用来划分区域、隔绝内外的地方。西域各国各有君长，军队分散而弱小，没有统一；虽然隶属于匈奴，但并不真心归附。匈奴能从他们那里得到马匹牲畜和毡毯，却不能统率他们，与他们共同进退。西域与汉朝相互隔绝，路途又很遥远，得到它不算增益，放弃它不算损失；盛大的恩德在于我方，对他们并无所取。因此，自从建武年间以来，西域思念汉朝的声威和恩德，都乐于归附汉朝，多次派遣使者并送质子到汉朝，请求设置都护。光武帝纵观古今，顺应时势所宜，推辞而没有应允；即便是大禹安抚西戎、周公辞让白雉、太宗拒绝千里马，其意义也都兼而有之了。","content_jianti_auto":"且通西域，近有龙堆，远则葱岭，身热、头痛、悬度之阨，淮南、杜钦、扬雄之论，皆以为此天地所以界别区域，绝外内也。西域诸国，各有君长，兵众分弱，无所统一，虽属匈奴，不相亲附；匈奴能得其马畜、旃罽而不能统率，与之进退。与汉隔绝，道里又远，得之不为益，弃之不为损，盛德在我，无取于彼。故自建武以来，西域思汉威德，咸乐内属，数遣使置质于汉，愿请都护。圣上远览古今，因时之宜，辞而未许；虽大禹之序西戎，周公之让白雉，太宗之却走马，义兼之矣！","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"。超，固之弟也。尝读固之遗文，其往来报超于西域之书，述窦...","context_before":"光武闭玉门，绝西域，","source_end_index":16,"source_paragraph_tongjian_id":"d2589941-6f75-4984-81e8-e2152d774a68","source_start_index":10,"source_text":"班固赞其盛德"}],"title":"九 班超平定西域不足为智勇"}],"id":3429,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"94972862-db0e-11ef-a0ea-a0d3651f611f"}],"reign_name":"二十二年","reign_name_jianti_auto":"二十二年","start_index":10,"tongjian_id":"9494542b-db0e-11ef-b293-a0d3651f611f","year_anno":"（丙午、四六）","year_int":46},"message":"success","success":true}