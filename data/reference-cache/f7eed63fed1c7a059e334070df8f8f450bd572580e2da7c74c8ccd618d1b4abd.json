":"94945441-db0e-11ef-9d69-a0d3651f611f"},{"link_birth_year":-20,"link_death_year":57,"link_td_description":"刘昆，字桓公，陈留郡东昏县（今河南省兰考县）人，梁孝王刘武后人。","link_td_id":"Q10018634","link_td_number_id":5623036,"people_name":"昆","people_name_jianti_auto":"昆","people_xingming":"刘昆","start_index":57,"tongjian_id":"94945442-db0e-11ef-b930-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"陳留","place_name_jianti_auto":"陈留","resolved_place_entity_id":435,"start_index":2,"tongjian_id":"9494543e-db0e-11ef-90ac-a0d3651f611f"},{"place_name":"江陵","place_name_jianti_auto":"江陵","resolved_place_entity_id":183,"start_index":7,"tongjian_id":"9494543f-db0e-11ef-b3b8-a0d3651f611f"},{"place_name":"弘農","place_name_jianti_auto":"弘农","resolved_place_entity_id":472,"start_index":28,"tongjian_id":"94945443-db0e-11ef-83fc-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":38,"tongjian_id":"94945444-db0e-11ef-aa1c-a0d3651f611f"},{"place_name":"江陵","place_name_jianti_auto":"江陵","resolved_place_entity_id":183,"start_index":63,"tongjian_id":"94945445-db0e-11ef-93c1-a0d3651f611f"},{"place_name":"弘農","place_name_jianti_auto":"弘农","resolved_place_entity_id":472,"start_index":73,"tongjian_id":"94945446-db0e-11ef-bfa3-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":79,"tongjian_id":"94945447-db0e-11ef-aed3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"初，陳留劉昆爲江陵令，縣有火災，昆向火叩頭，火尋滅；後爲弘農太守，虎皆負子渡河。帝聞而異之，徵昆代林爲光祿勳。帝問昆曰：「前在江陵，反風滅火，後守弘農，虎北渡河，行何德政而致是事？」對曰：「偶然耳。」左右皆笑，帝歎曰：「此乃長者之言也！」顧命書諸策。","content_fanyi":"当初，陈留人刘昆担任江陵县令时，县中发生火灾，刘昆向着大火叩头，大火随即熄灭；后来担任弘农太守时，老虎都背着幼崽渡过黄河。光武帝听说后感到惊异，便征召刘昆接替杜林担任光禄勋。光武帝问刘昆说：“从前在江陵时，风反向而扑灭大火；后来治理弘农，老虎向北渡过黄河，你是施行了什么德政才招来这些事情？”刘昆回答说：“只是偶然罢了。”左右侍从都笑了起来，光武帝感叹说：“这真是年高有德者的话啊！”于是回头命令史官把这件事记载在简策上。","content_jianti_auto":"初，陈留刘昆为江陵令，县有火灾，昆向火叩头，火寻灭；后为弘农太守，虎皆负子渡河。帝闻而异之，征昆代林为光禄勋。帝问昆曰：「前在江陵，反风灭火，后守弘农，虎北渡河，行何德政而致是事？」对曰：「偶然耳。」左右皆笑，帝叹曰：「此乃长者之言也！」顾命书诸策。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3423,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"94945435-db0e-11ef-a52e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"青州","place_name_jianti_auto":"青州","start_index":0,"tongjian_id":"9494544a-db0e-11ef-b24f-a0d3651f611f"},{"place_name":"濟南","place_name_jianti_auto":"济南","start_index":3,"tongjian_id":"9494544b-db0e-11ef-8598-a0d3651f611f"},{"place_name":"平原","place_name_jianti_auto":"平原","start_index":6,"tongjian_id":"9494544c-db0e-11ef-95b3-a0d3651f611f"},{"place_name":"樂安","place_name_jianti_auto":"乐安","start_index":9,"tongjian_id":"9494544d-db0e-11ef-b7e0-a0d3651f611f"},{"place_name":"北海","place_name_jianti_auto":"北海","start_index":12,"tongjian_id":"9494544e-db0e-11ef-9663-a0d3651f611f"},{"place_name":"東萊","place_name_jianti_auto":"东莱","start_index":15,"tongjian_id":"9494544f-db0e-11ef-8351-a0d3651f611f"},{"place_name":"齊國","place_name_jianti_auto":"齐国","start_index":18,"tongjian_id":"94945450-db0e-11ef-9c5b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"青州部濟南、平原、樂安、北海、東萊、齊國。","note_content_jianti_auto":"青州部济南、平原、乐安、北海、东莱、齐国。","note_type":"hu_note","start_index":8,"tongjian_id":"94945449-db0e-11ef-90d0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"青州","place_name_jianti_auto":"青州","resolved_place_entity_id":242,"start_index":4,"tongjian_id":"94945451-db0e-11ef-a6e9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_refere