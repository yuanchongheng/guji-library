id":"8c5c61e3-db0e-11ef-849b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說文：亭，民所安定也，道路所舍也。障，堡障也，隔也，塞也，所以隔塞敵人也。","note_content_jianti_auto":"说文：亭，民所安定也，道路所舍也。障，堡障也，隔也，塞也，所以隔塞敌人也。","note_type":"hu_note","start_index":59,"tongjian_id":"8c5c61e8-db0e-11ef-a29d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":10,"source_start_index":0,"source_text":"事見上卷顯王二十六年","target_paragraph_tongjian_id":"8c3027e0-db0e-11ef-bf19-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":4,"tongjian_id":"8c5c61eb-db0e-11ef-aef5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷顯王二十六年。夫，音扶。從，子容翻。洹，于元翻。","note_content_jianti_auto":"事见上卷显王二十六年。夫，音扶。从，子容翻。洹，于元翻。","note_type":"hu_note","start_index":91,"tongjian_id":"8c5c61ea-db0e-11ef-b5d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"卷縣","place_name_jianti_auto":"卷县","start_index":4,"tongjian_id":"8c5c61ed-db0e-11ef-bd9b-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":7,"tongjian_id":"8c5c61ee-db0e-11ef-8787-a0d3651f611f"},{"place_name":"酸棗縣","place_name_jianti_auto":"酸枣县","start_index":11,"tongjian_id":"8c5c61ef-db0e-11ef-b599-a0d3651f611f"},{"place_name":"陳留郡","place_name_jianti_auto":"陈留郡","start_index":15,"tongjian_id":"8c5c61f0-db0e-11ef-8ffb-a0d3651f611f"},{"place_name":"河水","place_name_jianti_auto":"河水","start_index":23,"tongjian_id":"8c5c61f1-db0e-11ef-8d8b-a0d3651f611f"},{"place_name":"卷縣","place_name_jianti_auto":"卷县","start_index":26,"tongjian_id":"8c5c61f2-db0e-11ef-94ee-a0d3651f611f"},{"place_name":"酸棗","place_name_jianti_auto":"酸枣","start_index":33,"tongjian_id":"8c5c61f3-db0e-11ef-b955-a0d3651f611f"},{"place_name":"延津","place_name_jianti_auto":"延津","start_index":36,"tongjian_id":"8c5c61f4-db0e-11ef-abe1-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":42,"tongjian_id":"8c5c61f5-db0e-11ef-ab24-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢志：卷縣屬河南郡，酸棗縣屬陳留郡。水經註：河水逕卷縣北，又東至酸棗、延津，二邑皆河津之要也。卷，逵員翻。衍，以善翻。","note_content_jianti_auto":"后汉志：卷县属河南郡，酸枣县属陈留郡。水经注：河水迳卷县北，又东至酸枣、延津，二邑皆河津之要也。卷，逵员翻。衍，以善翻。","note_type":"hu_note","start_index":147,"tongjian_id":"8c5c61ec-db0e-11ef-bb86-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從道，謂約從之路也。從，子容翻。","note_content_jianti_auto":"从道，谓约从之路也。从，子容翻。","note_type":"hu_note","start_index":191,"tongjian_id":"8c5c61f8-db0e-11ef-916e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"人臣委身以事君，身非我之有矣，故於其乞退也，謂之乞骸骨。骸，戶皆翻。","note_content_jianti_auto":"人臣委身以事君，身非我之有矣，故于其乞退也，谓之乞骸骨。骸，户皆翻。","note_type":"hu_note","start_index":206,"tongjian_id":"8c5c61f9-db0e-11ef-a268-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":16,"source_start_index":7,"source_text":"見上卷顯王四十七年","target_paragraph_tongjian_id":"8c451b2a-db0e-11ef-b1a0-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"儀","people_name_jianti_auto":"仪","start_index":0,"tongjian_id":"8c5c61fc-db0e-11ef-b0cc-a0d3651f611f"},{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":10,"tongjian_id":"8c5c61fd-db0e-11ef-ba22-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":2,"tongjian_id":"8c5c61fe-db0e-11ef-b9a4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":5,"tongjian_id":"8c5c61ff-db0e-11ef-a53d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"儀罷秦相相魏，見上卷顯王四十七年。相，息亮翻。","note_content_jianti_auto":"仪罢秦相相魏，见上卷显王四十七年。相，息亮翻。","note_type":"hu_note","start_index":230,"tongjian_id":"8c5c61fb-db0e-11ef-a6ae-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期秦国的最高行政官职，相当于宰相，负责辅佐君主处理国家政务。在上下文中，张仪返回秦国后再次担任相职，表明他重新获得秦国的信任和重用，继续推行其外交政策。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"復相秦","start_index":228,"tongjian_id":"d1d552e0-69c7-4f16-8d9f-e157bd2294ac"}],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":1,"tongjian_id":"8c5c6200-db0e-11ef-a47b-a0d3651f611f"},{"link_death_year":-296,"link_td_description":"魏襄王，姬姓，魏氏，名嗣，魏惠王之子。","link_td_id":"Q10000502","link_td_number_id":334895,"people_name":"魏襄王","people_name_jianti_auto":"魏襄王","people_xingming":"魏嗣","start_index":4,"tongjian_id":"8c5c6201-db0e-11ef-9a8a-a0d3651f611f","wl_zhushi":"[魏嗣]"},{"link_death_year":-284,"link_td_description":"苏秦，己姓，蘇氏，字季子，東周雒邑（今河南洛陽東）乘軒里人，相传为鬼谷子徒弟。战国时期纵横家和谋略官。","link_td_id":"Q10001054","link_td_number_id":133739,"people_name":"蘇秦","people_name_jianti_auto":"苏秦","people_xingming":"苏秦","start_index":113,"tongjian_id":"8c5c6209-db0e-11ef-bad1-a0d3651f611f"},{"link_death_