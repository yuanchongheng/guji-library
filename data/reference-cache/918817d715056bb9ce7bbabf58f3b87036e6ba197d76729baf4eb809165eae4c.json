{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚寅、前三九一）","note_content_jianti_auto":"（庚寅、前三九一）","note_type":"hu_note","start_index":0,"tongjian_id":"8bfd6672-db0e-11ef-810d-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8bfd6675-db0e-11ef-8e1d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宜陽縣","place_name_jianti_auto":"宜阳县","start_index":3,"tongjian_id":"8bfd6676-db0e-11ef-9684-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":7,"tongjian_id":"8bfd6677-db0e-11ef-b460-a0d3651f611f"},{"place_name":"宜陽縣","place_name_jianti_auto":"宜阳县","start_index":17,"tongjian_id":"8bfd6678-db0e-11ef-8475-a0d3651f611f"},{"place_name":"河南府","place_name_jianti_auto":"河南府","start_index":24,"tongjian_id":"8bfd6679-db0e-11ef-a2f6-a0d3651f611f"},{"place_name":"福昌縣","place_name_jianti_auto":"福昌县","start_index":27,"tongjian_id":"8bfd667a-db0e-11ef-94ff-a0d3651f611f"},{"place_name":"韓城","place_name_jianti_auto":"韩城","start_index":36,"tongjian_id":"8bfd667b-db0e-11ef-aad8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，宜陽縣屬弘農郡。史記正義曰：宜陽縣故城，在河南府福昌縣東十四里，故韓城是也。此邑卽周禮「四井爲邑」之邑。","note_content_jianti_auto":"班志，宜阳县属弘农郡。史记正义曰：宜阳县故城，在河南府福昌县东十四里，故韩城是也。此邑即周礼「四井为邑」之邑。","note_type":"hu_note","start_index":11,"tongjian_id":"8bfd6674-db0e-11ef-b9bb-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8bfd667f-db0e-11ef-b370-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"府平阳，山西临汾","resolved_place_entity_id":301,"start_index":3,"tongjian_id":"8bfd6680-db0e-11ef-b118-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","resolved_place_entity_id":881,"start_index":4,"tongjian_id":"8bfd6681-db0e-11ef-83c3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1秦伐韓宜陽，取六邑。","content_fanyi":"秦国攻打韩国的宜阳，占领了六座城邑。","content_jianti_auto":"1秦伐韩宜阳，取六邑。","dtjl_paragraph_links":[],"dtjl_references":[],"id":49,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8bfd6673-db0e-11ef-8dd2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":5,"chapter_name":"避讳篇第五","chenzhu_chapter":"避讳为民国以前吾国特有之体制，故史书上之记载，有待于以避讳解释者甚众，不讲避讳学，不足以读中国之史也，吾昔撰《史讳举例》问世，职为是焉。胡身之生避讳最盛之朝，熟谙避讳掌故。其撰《通鉴释文辨误後序》，谓：“海陵所刊公休《释文》，以乌桓为乌元。宋朝钦宗讳桓，靖康之初，公休没久矣，安得预为钦宗讳！”即利用避讳以证史书伪讬之一法。其注《通鉴》，以避讳为训释者尤多。兹所采不过数十条，而避讳常识已略具于是矣。","chenzhu_index_in_chapter":1,"chenzhu_text":"此避讳改前人名。然宋真庙讳恒，仁庙讳祯，此以避讳为解释在第一卷而即误者。《鉴注自序》所谓“人苦不自觉，前注之失吾知之，吾注之失吾不能知也”。陈景雲、赵绍祖辈著书专纠《胡注》，对此亦无所举正，何耶！","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH05-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":3,"tongjian_id":"8bfd6684-db0e-11ef-864a-a0d3651f611f"},{"people_name":"田常","people_name_jianti_auto":"田常","start_index":9,"tongjian_id":"8bfd6685-db0e-11ef-a068-a0d3651f611f"},{"people_name":"陳成子恆","people_name_jianti_auto":"陈成子恒","start_index":15,"tongjian_id":"8bfd6686-db0e-11ef-bb13-a0d3651f611f"},{"people_name":"溫公","people_name_jianti_auto":"温公","start_index":21,"tongjian_id":"8bfd6687-db0e-11ef-afdf-a0d3651f611f"},{"people_name":"公子完","people_name_jianti_auto":"公子完","start_index":39,"tongjian_id":"8bfd6688-db0e-11ef-86e2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":2,"tongjian_id":"8bfd6689-db0e-11ef-87ad-a0d3651f611f"},{"place_name":"陳","place_name_jianti_auto":"陈","start_index":38,"tongjian_id":"8bfd668a-db0e-11ef-be1f-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":43,"tongjian_id":"8bfd668b-db0e-11ef-8730-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此序齊田氏之世也。田常，卽左傳陳成子恆也。溫公避仁廟諱，改「恆」曰「常」。自陳公子完奔齊，五世至常得政。諡法：勝敵志強曰莊。","note_content_jianti_auto":"此序齐田氏之世也。田常，即左传陈成子恒也。温公避仁庙讳，改「恒」曰「常」。自陈公子完奔齐，五世至常得政。谥法：胜敌志强曰庄。","note_type":"hu_note","start_index":22,"tongjian_id":"8bfd6683-db0e-11ef-92cf-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田恒，妫姓，田氏，名恒，原为陈恒，古音田、陈音近，也称为田恒。东周春秋战国时期齐国的权臣。是齐国田氏家族的第八任首领。","link_td_id":"Q10001998","link_td_number_id":1008974,"people_name":"田常","people_name_jianti_auto":"田常","people_xingming":"陈成子恒","start_index":3,"tongjian_id":"8bfd668e-db0e-11ef-9470-a0d3651f611f"},{"link_td_description":"田盘，春秋时期齐国的相。谥襄，又称田襄子。田常之子，田白之父。","link_td_id":"Q10002297","link_td_number_id":882155,"people_name":"襄子盤","people_name_jianti_auto":"襄子盘","people_xingming":"田盘","start_index":6,"tongjian_id":"8bfd668f-db0e-11ef-abf4-a0d3651f611f"},{"link_td_description":"田盘，春秋时期齐国的相。谥襄，又称田襄子。田常之子，田白之父。","link_td_id":"Q10002297","link_td_number_id":882155,"people_name":"盤","people_name_jianti_auto":"盘","people_xingming":"田盘","start_index":10,"tongjian_id":"8bfd6690-db0e-11ef-b432-a0d3651f611f"},{"link_death_year":-411,"link_td_description":"田庄子，名田白，父为田襄子田盘，陈完之九世孙，子为田悼子。在他的努力下，田氏控制了齐国的实权。","link_td_id":"Q10008996","link_td_number_id":489231,"people_name":"莊子白","people_name_jianti_auto":"庄子白","people_xingming":"田白","start_index":12,"tongjian_id":"8bfd6691-db0e-11ef-9c20-a0d3651f611f"},{"link_death_year":-411,"link_td_description":"田庄子，名田白，父为田襄子田盘，陈完之九世孙，子为田悼子。在他的努力下，田氏控制了齐国的实权。","link_td_id":"Q10008996","link_td_number_id":489231,"people_name":"白","people_name_jianti_auto":"白","people_xingming":"田白","start_index":16,"tongjian_id":"8bfd6692-db0e-11ef-8572-a0d3651f611f"},{"link_death_year":-384,"link_td_description":"田和，本名田和，为大夫时称子禾子，田氏齐国开国君主。其父为田莊子、兄为田悼子，其妻为齐君母、孝大妃。陈完之十世孙。","link_td_id":"Q10000615","link_td_number_id":326951,"people_name":"太公和","people_name_jianti_auto":"太公和","people_xingming":"田和","start_index":18,"tongjian_id":"8bfd6693-db0e-11ef-b592-a0d3651f611f"},{"link_death_year":-384,"link_td_description":"田和，本名田和，为大夫时称子禾子，田氏齐国开国君主。其父为田莊子、兄为田悼子，其妻为齐君母、孝大妃。陈完之十世孙。","link_td_id":"Q10000615","link_td_number_id":326951,"people_name":"田和","people_name_jianti_auto":"田和","people_xingming":"田和","start_index":26,"tongjian_id":"8bfd6694-db0e-11ef-b7be-a0d3651f611f"},{"link_death_year":-379,"link_td_description":"齐康公，姜姓，名贷。最后一任姜齐国君，在位时沉湎于酒色，以田完的后代田和为相，后田氏代齐。","link_td_id":"Q10001700","link_td_number_id":326948,"people_name":"齊康公","people_name_jianti_auto":"齐康公","people_xingming":"姜贷","start_index":29,"tongjian_id":"8bfd6695-db0e-11ef-bda0-a0d3651f611f","wl_zhushi":"[姜贷]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","place_note":"府临淄，山东淄博东临淄镇","resolved_place_entity_id":25,"start_index":25,"tongjian_id":"8bfd6696-db0e-11ef-aa2b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2初，田常生襄子盤，盤生莊子白，白生太公和。是歲，齊田和遷齊康公於海上，使食一城，以奉其先祀。","content_fanyi":"起初，田常生襄子田盘，田盘生庄子田白，田白生太公田和。这一年，齐国田和把齐康公迁到海上，给他一座城作食邑，让他以此供奉姜氏先人的祭祀。","content_jianti_auto":"2初，田常生襄子盘，盘生庄子白，白生太公和。是岁，齐田和迁齐康公于海上，使食一城，以奉其先祀。","dtjl_paragraph_links":[],"dtjl_references":[],"id":50,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bfd6682-db0e-11ef-812d-a0d3651f611f"}],"reign_name":"十一年","reign_name_jianti_auto":"十一年","start_index":8,"tongjian_id":"8bfd6671-db0e-11ef-8551-a0d3651f611f","year_anno":"（庚寅、前三九一）","year_int":-391},"message":"success","success":true}