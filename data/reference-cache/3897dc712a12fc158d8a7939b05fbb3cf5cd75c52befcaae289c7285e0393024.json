ed_place_entity_id":185,"start_index":7,"tongjian_id":"9d2b3d28-db0e-11ef-abfc-a0d3651f611f"},{"place_name":"青","place_name_jianti_auto":"青","resolved_place_entity_id":242,"start_index":9,"tongjian_id":"9d2b3d29-db0e-11ef-b559-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","resolved_place_entity_id":191,"start_index":11,"tongjian_id":"9d2b3d2a-db0e-11ef-acfb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2荊、揚、兗、豫、青、徐六州大水。","content_fanyi":"荆、扬、兖、豫、青、徐六州出现大水。","content_jianti_auto":"2荆、扬、兖、豫、青、徐六州大水。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7073,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9d2b3d24-db0e-11ef-ae52-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：三十國、晉春秋云「閏月」；宋、晉·五行志云「閏月庚寅」，今從晉書·帝紀。","note_content_jianti_auto":"考异曰：三十国、晋春秋云「闰月」；宋、晋·五行志云「闰月庚寅」，今从晋书·帝纪。","note_type":"hu_note","start_index":10,"tongjian_id":"9d2b3d2c-db0e-11ef-b6da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"趙王","people_name_jianti_auto":"赵王","start_index":4,"tongjian_id":"9d2b3d34-db0e-11ef-a961-a0d3651f611f"},{"people_name":"倫","people_name_jianti_auto":"伦","start_index":6,"tongjian_id":"9d2b3d35-db0e-11ef-9853-a0d3651f611f"},{"people_name":"孫秀","people_name_jianti_auto":"孙秀","start_index":8,"tongjian_id":"9d2b3d36-db0e-11ef-994b-a0d3651f611f"},{"people_name":"華","people_name_jianti_auto":"华","start_index":11,"tongjian_id":"9d2b3d37-db0e-11ef-8eab-a0d3651f611f"},{"people_name":"華","people_name_jianti_auto":"华","start_index":16,"tongjian_id":"9d2b3d38-db0e-11ef-8e6b-a0d3651f611f"},{"people_name":"華","people_name_jianti_auto":"华","start_index":24,"tongjian_id":"9d2b3d39-db0e-11ef-94e1-a0d3651f611f"},{"people_name":"漢高祖","people_name_jianti_auto":"汉高祖","start_index":47,"tongjian_id":"9d2b3d3a-db0e-11ef-8b1e-a0d3651f611f"},{"people_name":"王莽","people_name_jianti_auto":"王莽","start_index":55,"tongjian_id":"9d2b3d3b-db0e-11ef-ba5b-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":59,"tongjian_id":"9d2b3d3c-db0e-11ef-9448-a0d3651f611f"},{"people_name":"倫","people_name_jianti_auto":"伦","start_index":72,"tongjian_id":"9d2b3d3d-db0e-11ef-9d88-a0d3651f611f"},{"people_name":"秀","people_name_jianti_auto":"秀","start_index":74,"tongjian_id":"9d2b3d3e-db0e-11ef-9f5c-a0d3651f611f"},{"people_name":"華","people_name_jianti_auto":"华","start_index":96,"tongjian_id":"9d2b3d3f-db0e-11ef-9bbf-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"華傳曰：趙王倫、孫秀與華有隙，疾華如讎。武庫火，華懼因此變作，列兵固守，然後救之，故累代之寶及漢高祖斬白蛇劍、王莽頭、孔子屐等盡焚焉。據通鑑，則倫、秀之隙，開於明年。蓋數誅大臣，禍皆從中起，故華懼有變而列兵固守也。","note_content_jianti_auto":"华传曰：赵王伦、孙秀与华有隙，疾华如雠。武库火，华惧因此变作，列兵固守，然后救之，故累代之宝及汉高祖斩白蛇剑、王莽头、孔子屐等尽焚焉。据通鉴，则伦、秀之隙，开于明年。盖数诛大臣，祸皆从中起，故华惧有变而列兵固守也。","note_type":"hu_note","start_index":15,"tongjian_id":"9d2b3d33-db0e-11ef-b78a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3冬，十月，武庫火，焚累代之寶及二百萬人器械。十二月，丙戌，新作武庫，大調兵器。","content_fanyi":"冬季十月，兵器库失火，烧毁了历代珍宝和可供二百万人使用的兵器装备。十二月丙戌日，重新修建兵器库，并大量调拨兵器。","content_jianti_auto":"3冬，十月，武库火，焚累代之宝及二百万人器械。十二月，丙戌，新作武库，大调兵器。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7074,"number":3,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":2,"tongjian_id":"9d2b3d2b-db0e-11ef-bf52-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"太武","people_name_jianti_auto":"太武","start_index":18,"tongjian_id":"9d2b3d45-db0e-11ef-b4ee-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":25,"tongjian_id":"9d2b3d46-db0e-11ef-b948-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"濡水","place_name_jianti_auto":"濡水","start_index":4,"tongjian_id":"9d2b3d47-db0e-11ef-9fdf-a0d3651f611f"},{"place_name":"禦夷鎭","place_name_jianti_auto":"御夷镇","start_index":7,"tongjian_id":"9d2b3d48-db0e-11ef-88e2-a0d3651f611f"},{"place_name":"拓跋魏","place_name_jianti_auto":"拓跋魏","start_index":15,"tongjian_id":"9d2b3d49-db0e-11ef-bca5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"水經註：濡水出禦夷鎭東南；鎭，拓跋魏太武時所置也。師古曰：濡，音乃官翻。","note_content_jianti_auto":"水经注：濡水出御夷镇东南；镇，拓跋魏太武时所置也。师古曰：濡，音乃官翻。","note_type":"hu_note","start_index":28,"tongjian_id":"9d2b3d44-db0e-11ef-9f15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"參合陂","place_name_jianti_auto":"参合陂","start_index":0,"tongjian_id":"9d2b3d4c-db0e-11ef-b407-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":5,"tongjian_id":"9d2b3d4d-db0e-11ef-aa90-a0d3651f611f"},{"place_name":"參合縣","place_name_jianti_auto":"参合县","start_index":7,"tongjian_id":"9d2b3d4e-db0e-11ef-af81-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":11,"tongjian_id":"9d2b3d4f-db0e-11ef-80c2-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":14,"tongjian_id":"9d2b3d50-db0e-11ef-a187-a0d3651f611f"},{"place_name":"參合縣","place_name_jianti_auto":"参合县","start_index":16,"tongjian_id":"9d2b3d51-db0e-11ef-96e8-a0d3651f611f"},{"place_name":"拓跋魏","place_name_jianti_auto":"拓跋魏","start_index":20,"tongjian_id":"9d2b3d52-db0e-11ef-9924-a0d3651f611f"},{"place_name":"梁城郡","place_name_jianti_auto":"梁城郡","start_index":28,"tongjian_id":"9d2b3d53-db0e-11ef-93f5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"參合陂，在代郡參合縣。後漢、晉省參合縣，拓跋魏復置縣，屬梁城郡。","note_content_jianti_auto":"参合陂，在代郡参合县。后汉、晋省参合县，拓跋魏复置县，属梁城郡。","note_type":"hu_note","start_index":38,"tongjian_id":"9d2b3d4b-db0e-11ef-a280-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"定襄","place_name_jianti_auto":"定襄","start_index":0,"tongjian_id":"9d2b3d55-db0e-11ef-88b1-a0d3651f611f"},{"place_name":"盛樂","place_name_jianti_auto":"盛乐","start_index":3,"tongjian_id":"9d2b3d56-db0e-11ef-9cff-a0d3651f611f"},{"place_name":"雲中郡","place_name_jianti_auto":"云中郡","start_index":19,"tongjian_id":"9d2b3d57-db0e-11ef-8413-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":23,"tongjian_id":"9d2b3d58-db0e-11ef-b753-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":25,"tongjian_id":"9d2b3d59-db0e-11ef-9555-a0d3651f611f"},{"place_name":"拓跋魏","place_name_jianti_auto":"拓跋魏","start_index":28,"tongjian_id":"9d2b3d5a-db0e-11ef-9411-a0d3651f611f"},{"place_name":"盛樂郡","place_name_jianti_auto":"盛乐郡","start_index":33,"tongjian_id":"9d2b3d5b-db0e-11ef-b5dd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"定襄之盛樂，二漢志曰「成樂」；後漢志屬雲中郡，魏、晉省，拓跋魏後置盛樂郡。汗，音寒。㐌，徒河翻。","note_content_jianti_auto":"定襄之盛乐，二汉志曰「成乐」；后汉志属云中郡，魏、晋省，拓跋魏后置盛乐郡。汗，音寒。㐌，徒河翻。","note_type":"hu_note","start_index":60,"tongjian_id":"9d2b3d54-db0e-11ef-90ec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"箕商","people_name_jianti_auto":"箕商","start_index":3,"tongjian_id":"9d2b3d5f-db0e-11ef-904f-a0d3651f611f"},{"people_name":"箕子","people_name_jianti_auto":"箕子","start_index":6,"tongjian_id":"9d2b3d60-db0e-11ef-b8bd-a0d3651f611f"},{"people_name":"箕鄭父","people_name_jianti_auto":"箕郑父","start_index":16,"tongjian_id":"9d2b3d61-db0e-11ef-8bf2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":12,"tongjian_id":"9d2b3d62-db0e-11ef-b439-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：箕商，箕子之後。又晉有大夫箕鄭父。從，才用翻。","note_content_jianti_auto":"姓谱：箕商，箕子之后。又晋有大夫箕郑父。从，才用翻。","note_type":"hu_note","start_index":102,"tongjian_id":"9d2b3d5e-db0e-11ef-8d85-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":15,"chapter_name":"边事篇第十五","chenzhu_chapter":"边事犹今言国际之事，息息与本国相通，不可不知己知彼者也。南宋国势孱弱，百年大计，争持于和战之间，结果和与战皆失，驯至亡国，可慨也已！身之所论，大抵重在自强自治，不与人以可乘之机。纵不得已而求助于人，亦必慎所与而毋贻拒虎进狼之悔，斯可谓善于交邻者矣。","chenzhu_index_in_chapter":8,"chenzhu_text":"边郡之民，每徘徊两国之间，以求安全为鹄的。其人多能操两国语言，习知两国风俗，欲坚凝此边民之心，惟有政治修明，使之安居乐业，结其豪杰，使之不为人用而已。孟子曰：“域民不以封疆之界。”身之不责轻去其国之卫、箕，而致叹晋之无政，谅哉！洪景卢曰：“西夏李元昊之叛，其谋皆出于华州士人张元与吴昊，而其事本末，国史不书，比得田昼《承君集》，实纪其事，云：‘张元、吴昊、姚嗣宗，皆关中人，负气倜傥，有纵横才。尝薄游塞上，观山川风俗，有经略西鄙意。姚题诗崆峒山寺壁云：南粤干戈未息肩，五原金鼓又轰天，崆峒山叟笑无语，饱听松声春昼眠。范文正公巡边，见之大惊。又有踏破贺兰石，扫清西海尘之句。张为鹦鹉诗，卒章曰：好著金笼收拾取，莫教飞去别人家。吴亦有诗。将谒韩、范二帅，耻自屈，不肯往，乃砻大石，刻诗其上，使壮夫拽之于通衢，三人从后哭之，欲以鼓动二帅。既而果召与相见，踌躇未用间，张、吴径走西夏，范公以急骑追之不及，乃表姚入幕府。张、吴既至夏国，夏人倚为谋主，以抗朝廷。连兵十馀年，西方至为疲弊，职此二人为之。自是边帅始待士矣。’承君所记如此。予谓张、吴在夏国然后举事，不应韩、范作帅日犹在关中，岂非记其岁时先后不审乎！姚、张诗，《笔谈》诸书颇亦纪载，张、吴之名，正与羌酋二字同，盖非偶然也。”语见《容斋三笔》十一。然则结边民豪杰之心，亦必有道矣，张、吴即卫、箕之流也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":25,"tongjian_id":"CH15-CZ008"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"衞操","people_name_jianti_auto":"衞操","start_index":33,"tongjian_id":"9d2b3d65-db0e-11ef-aea1-a0d3651f611f"},{"people_name":"箕澹","people_name_jianti_auto":"箕澹","start_index":36,"tongjian_id":"9d2b3d66-db0e-11ef-9ade-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"拓跋氏","place_name_jianti_auto":"拓跋氏","start_index":2,"tongjian_id":"9d2b3d67-db0e-11ef-860c-a0d3651f611f"},{"place_name":"晉朝","place_name_jianti_auto":"晋朝","start_index":12,"tongjian_id":"9d2b3d68-db0e-11ef-93f6-a0d3651f611f"},{"place_name":"華","place_name_jianti_auto":"华","start_index":42,"tongjian_id":"9d2b3d69-db0e-11ef-9d40-a0d3651f611f"},{"place_name":"夷","place_name_jianti_auto":"夷","start_index":44,"tongjian_id":"9d2b3d6a-db0e-11ef-95ed-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":62,"tongjian_id":"9d2b3d6b-db0e-11ef-b6c9-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":117,"tongjian_id":"9d2b3d6c-db0e-11ef-a9f7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言拓跋氏益強。當是時，晉朝大臣、宗室雖已自相屠，而四方未爲變也，衞操、箕澹輩何爲去華就夷如是其早計也！中國之人可爲凜凜矣。漢嚴邊關之禁，懼有罪者亡命出塞耳。若無威刑之迫乎其後，一旦去桑梓而逐水草，是必有見也。邊關不之詰，朝廷不之虞，晉之無政，亦可知矣。說，輸芮翻；下之說同。","note_content_jianti_auto":"史言拓跋氏益强。当是时，晋朝大臣、宗室虽已自相屠，而四方未为变也，衞操、箕澹辈何为去华就夷如是其早计也！中国之人可为凛凛矣。汉严边关之禁，惧有罪者亡命出塞耳。若无威刑之迫乎其后，一旦去桑梓而逐水草，是必有见也。边关不之诘，朝廷不之虞，晋之无政，亦可知矣。说，输芮翻；下之说同。","note_type":"hu_note","start_index":136,"tongjian_id":"9d2b3d64-db0e-11ef-817d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":307,"link_td_description":"拓跋禄官，中国西晋时期鲜卑索头部首领，294年至307年在位，是南北朝时期北魏皇帝的先祖。其父为拓跋力微，拓跋沙漠汗、拓跋悉鹿、拓跋绰皆为其兄弟。294年，前任首领即禄官之侄拓跋弗去世，禄官因此继位。295年，禄官继位后将国土为三部：由自己统治东部；禄官之侄，即沙漠汗之子拓跋猗㐌统治中部；而沙漠汗另一子，猗㐌之弟拓跋猗卢统治西部。307年禄官去世，因猗㐌已于305年去世，因此猗卢便合并三部。北魏道武帝拓跋珪称帝时，将禄官追谥为昭皇帝。后代有拓跋颓。","link_td_id":"Q10008812","link_td_number_id":383668,"people_name":"拓跋祿官","people_name_jianti_auto":"拓跋禄官","people_xingming":"拓跋禄官","start_index":1,"tongjian_id":"9d2d86bd-db0e-11ef-bbb0-a0d3651f611f"},{"link_death_year":277,"link_td_description":"拓跋沙漠汗，中国三国后期至西晋初年的索头部鲜卑人，是南北朝时期北魏所追尊的先祖之一。","