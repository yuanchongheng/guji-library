Ref_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"五原","place_name_jianti_auto":"五原","resolved_place_entity_id":554,"start_index":20,"tongjian_id":"9594a10b-db0e-11ef-b93b-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":43,"tongjian_id":"9594a10c-db0e-11ef-bfa8-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":54,"tongjian_id":"9594a10d-db0e-11ef-a1c1-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","人事"],"content":"1春，正月，鄧鴻等軍還，馮柱將虎牙營留屯五原；鴻坐逗留失利，下獄死。後帝知朱徽、杜崇失胡和，又禁其上書，以致胡反，皆徵，下獄死。","content_fanyi":"春季，正月，邓鸿等人的军队返回，冯柱率领虎牙营留驻五原郡；邓鸿因逗留不进、迁延失期而贻误军机，被下狱处死。后来汉和帝知道朱徽、杜崇与匈奴不和，又禁止他们上书，以致胡人反叛，便将他们都征召入京，下狱处死。","content_jianti_auto":"1春，正月，邓鸿等军还，冯柱将虎牙营留屯五原；鸿坐逗留失利，下狱死。后帝知朱徽、杜崇失胡和，又禁其上书，以致胡反，皆征，下狱死。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3850,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9594a104-db0e-11ef-bdc1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2夏，四月，辛亥朔，日之食之。","content_fanyi":"夏季，四月初一日辛亥朔，发生了日食。","content_jianti_auto":"2夏，四月，辛亥朔，日之食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3851,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9594a10e-db0e-11ef-adf0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Childr