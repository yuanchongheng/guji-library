id":"950bedc2-db0e-11ef-a024-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見四十二卷光武建武七年。上，時掌翻。","note_content_jianti_auto":"见四十二卷光武建武七年。上，时掌翻。","note_type":"hu_note","start_index":102,"tongjian_id":"950bedc1-db0e-11ef-9ab2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蚩，笑也。","note_content_jianti_auto":"蚩，笑也。","note_type":"hu_note","start_index":139,"tongjian_id":"950bedc4-db0e-11ef-87b5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"三公","official_note":"三公是汉代最高官职，通常指太尉、司徒、司空，负责辅佐皇帝处理国家政务。在上下文中，皇帝赐帛给三公，以表彰其奉职得理，体现了对高级官员的赏赐和激励。","official_rank":"正一品","source_snippet":"其賜三公帛五十匹","start_index":58,"tongjian_id":"6b02265d-6c52-4ded-bf2f-65d72bf1f007"},{"confidence":0.9,"official_category":"中枢机构","official_name":"九卿","official_note":"九卿是汉代中央政府的九个主要部门长官，如太常、光禄勋等，负责具体行政事务。在上下文中，皇帝赐帛给九卿，但数量少于三公，反映了官职层级和赏赐的差异。","official_rank":"正三品至正五品","source_snippet":"九卿、二千石半之","start_index":64,"tongjian_id":"4805b30f-aa38-4d4e-93ce-04c7054c00d9"},{"confidence":0.85,"official_category":"地方行政","official_name":"二千石","official_note":"二千石是汉代郡守的俸禄级别，代指郡守等地方高级官员。在上下文中，皇帝赐帛给二千石官员，但数量少于九卿，体现了对地方官员的赏赐和层级关系。","official_rank":"郡守级","source_snippet":"九卿、二千石半之","start_index":67,"tongjian_id":"e9f8e980-98c2-4e81-827f-e8ded8bdc408"},{"confidence":0.88,"official_category":"中枢机构","official_name":"尚書","official_note":"尚书是汉代中枢机构官员，负责处理文书和诏令。在上下文中，皇帝命令尚书抑制浮词奏章，不予以审阅，以杜绝谄媚之风，体现了尚书在文书处理中的监督作用。","official_rank":"正三品至正五品","source_snippet":"尚書皆宜抑而不省","start_index":113,"tongjian_id":"401c915d-9a07-4352-8637-97282ba5c574"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"王雒山","place_name_jianti_auto":"王雒山","resolved_place_entity_id":8272,"start_index":6,"tongjian_id":"950bedc5-db0e-11ef-bbb0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，二月，王雒山出寶鼎，獻之。夏，四月，甲子，詔曰：「祥瑞之降，以應有德；方今政化多僻，何以致茲！易曰：『鼎象三公』，豈公卿奉職得其理邪！其賜三公帛五十匹，九卿、二千石半之。先帝詔書，禁人上事言『聖』，而間者章奏頗多浮詞；自今若有過稱虛譽，尚書皆宜抑而不省，示不爲諂子蚩也。」","content_fanyi":"春季，二月，王雒山出现宝鼎，当地人将它进献给朝廷。夏季，四月初七日甲子，汉明帝下诏说：“祥瑞降临，是为了应和有德之人；如今政务教化多有偏颇，怎么会有这样的祥瑞降临呢！《周易》说：‘鼎象征三公。’难道是公卿们履行职务很有条理吗？现在赐给三公每人五十匹帛，九卿、二千石官员减半，即每人二十五匹。先帝曾下诏书，禁止臣下上书称‘圣’，但近来章奏中多有浮夸溢美之词；从今以后，如果再有过度称颂、虚美不实的言辞，尚书都应予以制止，不予受理，以此表示不被谄媚者所嗤笑。”","content_jianti_auto":"1春，二月，王雒山出宝鼎，献之。夏，四月，甲子，诏曰：「祥瑞之降，以应有德；方今政化多僻，何以致兹！易曰：『鼎象三公』，岂公卿奉职得其理邪！其赐三公帛五十匹，九卿、二千石半之。先帝诏书，禁人上事言『圣』，而间者章奏颇多浮词；自今若有过称虚誉，尚书皆宜抑而不省，示不为谄子蚩也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":3558,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"950bedba-db0e-11ef-99d6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":0,"tongjian_id":"950bedc9-db0e-11ef-90b8-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":5,"tongjian_id":"950bedca-db0e-11ef-b4ac-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陽城縣，屬潁川。","note_content_jianti_auto":"阳城县，属颍川。","note_type":"hu_note","start_index":20,"tongjian_id":"950bedc8-db0e-11ef-8951-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魯","place_name_jianti_auto":"鲁","resolved_place_entity_id":506,"start_index":9,"tongjian_id":"950bedcb-db0e-11ef-af01-a0d3651f611f"},{"place_name":"陽城","place_name_jianti_auto":"阳城","resolved_place_entity_id":1106,"start_index":17,"tongjian_id":"950bedcc-db0e-11ef-ae04-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2冬，十月，上行幸魯；十二月，還幸陽城；壬午，還宮。","content_fanyi":"冬季，十月，汉明帝巡幸鲁地；十二月，归途中又巡幸阳城县；十二月二十九日壬午，返回宫中。","content_jianti_auto":"2冬，十月，上行幸鲁；十二月，还幸阳城；壬午，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3559,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"950bedc7-db0e-11ef-b62d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鞮，丁奚翻；下同。","note_content_jianti_auto":"鞮，丁奚翻；下同。","note_type":"hu_note","start_index":27,"tongjian_id":"950c8e1e-db0e-11ef-bc66-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。","note_content_jianti_auto":"复，扶又翻；下同。","note_type":"hu_note","start_index":33,"tongjian_id":"950c8e1f-db0e-11ef-a7fc-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"適","start_index":4,"tongjian_id":"950c8e20-db0e-11ef-8da4-a0d3651f611f"},{"link_death_year":63,"link_td_description":"䤈僮尸逐侯鞮单于，挛鞮氏，名适，南匈奴第四任单于，为匈奴䤈落尸逐鞮单于之子。","link_td_id":"Q10003206","link_td_number_id":911468,"people_name":"適","people_name_jianti_auto":"适","people_xingming":"適","start_index":7,"tongjian_id":"950c8e21-db0e-11ef-851d-a0d3651f611f"},{"people_name":"