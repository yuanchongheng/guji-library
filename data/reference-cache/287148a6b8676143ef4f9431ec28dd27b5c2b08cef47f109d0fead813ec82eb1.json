{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚寅、前一五一）","note_content_jianti_auto":"（庚寅、前一五一）","note_type":"hu_note","start_index":0,"tongjian_id":"8f31a94a-db0e-11ef-9260-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"雨三日以往爲霖。","note_content_jianti_auto":"雨三日以往为霖。","note_type":"hu_note","start_index":12,"tongjian_id":"8f31a94c-db0e-11ef-825f-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1冬，十二月，雷，霖雨。","content_fanyi":"冬季，十二月，天空打雷，降雨连绵多日。","content_jianti_auto":"1冬，十二月，雷，霖雨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1282,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f31a94b-db0e-11ef-90d7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-155,"link_td_description":"薄姬，或作薄夫人、薄太后、薄太皇太后，本名不详，中国西汉时期皇室成员，原为秦末魏王妾室，后为汉高祖刘邦妾侍，也是汉文帝刘恒的生母，在汉文帝即位后被奉为皇太后，汉景帝时被尊为太皇太后。薄太后是中国史上第一位被记入正史的太皇太后。后世追尊其为高祖高皇后。","link_td_id":"Q10001110","link_td_number_id":684072,"people_name":"薄太后","people_name_jianti_auto":"薄太后","people_xingming":"薄太后","start_index":8,"tongjian_id":"8f31a94e-db0e-11ef-a5bf-a0d3651f611f"},{"people_name":"薄氏","people_name_jianti_auto":"薄氏","people_xingming":"薄氏","start_index":12,"tongjian_id":"8f31a94f-db0e-11ef-93f0-a0d3651f611f"},{"people_name":"薄氏","people_name_jianti_auto":"薄氏","people_xingming":"薄氏","start_index":36,"tongjian_id":"8f31a950-db0e-11ef-95cf-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2初，上爲太子，薄太后以薄氏女爲妃；及卽位，爲皇后，無寵。秋，九月，皇后薄氏廢。","content_fanyi":"当初，汉景帝做太子时，薄太后把一位薄氏女子选为他的妃子；等到汉景帝即位后，薄氏被立为皇后，却得不到景帝的宠幸。秋季九月，皇后薄氏被废。","content_jianti_auto":"2初，上为太子，薄太后以薄氏女为妃；及即位，为皇后，无宠。秋，九月，皇后薄氏废。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1283,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f31a94d-db0e-11ef-ac5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-151,"link_td_description":"刘礼，汉朝宗室，西汉楚王。","link_td_id":"Q10002647","link_td_number_id":1486784,"people_name":"楚文王禮","people_name_jianti_auto":"楚文王礼","people_xingming":"刘礼","start_index":1,"tongjian_id":"8f31a952-db0e-11ef-8a73-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"3楚文王禮薨。","content_fanyi":"楚文王刘礼去世。","content_jianti_auto":"3楚文王礼薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1284,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f31a951-db0e-11ef-a836-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef