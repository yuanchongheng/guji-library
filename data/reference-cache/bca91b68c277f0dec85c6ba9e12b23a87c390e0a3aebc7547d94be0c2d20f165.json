0d3651f611f"},{"place_name":"羊膊嶺","place_name_jianti_auto":"羊膊岭","start_index":71,"tongjian_id":"922117db-db0e-11ef-8f34-a0d3651f611f"},{"place_name":"白馬嶺","place_name_jianti_auto":"白马岭","start_index":99,"tongjian_id":"922117dc-db0e-11ef-b6a7-a0d3651f611f"},{"place_name":"天彭關","place_name_jianti_auto":"天彭关","start_index":105,"tongjian_id":"922117dd-db0e-11ef-a0e8-a0d3651f611f"},{"place_name":"天谷","place_name_jianti_auto":"天谷","start_index":112,"tongjian_id":"922117de-db0e-11ef-ba90-a0d3651f611f"},{"place_name":"天彭山","place_name_jianti_auto":"天彭山","start_index":115,"tongjian_id":"922117df-db0e-11ef-b2e5-a0d3651f611f"},{"place_name":"天彭門","place_name_jianti_auto":"天彭门","start_index":130,"tongjian_id":"922117e0-db0e-11ef-8060-a0d3651f611f"},{"place_name":"江水","place_name_jianti_auto":"江水","start_index":134,"tongjian_id":"922117e1-db0e-11ef-b7b4-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":153,"tongjian_id":"922117e2-db0e-11ef-8fe6-a0d3651f611f"},{"place_name":"岷山","place_name_jianti_auto":"岷山","start_index":158,"tongjian_id":"922117e3-db0e-11ef-a965-a0d3651f611f"},{"place_name":"江水","place_name_jianti_auto":"江水","start_index":163,"tongjian_id":"922117e4-db0e-11ef-ba32-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志，岷山，在蜀郡湔氐道西徼外。禹貢所謂岷山導江，卽此山也。水經註曰：岷山，卽瀆山，水曰瀆水，亦曰汶阜山，在氐道徼外，江水所導也。大江泉源發羊膊嶺下，緣崖散漫，小大百數，殆未濫觴，東南下百餘里，至白馬嶺西，歷天彭關，亦謂之天谷。天彭山兩山相對，其高若闕，謂之天彭門。江水自此以上至微弱，所謂其源濫觴者也。漢元延中，岷山崩，壅江水三日不流，卽其處。岷，音武巾翻。","note_content_jianti_auto":"地理志，岷山，在蜀郡湔氐道西徼外。禹贡所谓岷山导江，即此山也。水经注曰：岷山，即渎山，水曰渎水，亦曰汶阜山，在氐道徼外，江水所导也。大江泉源发羊膊岭下，缘崖散漫，小大百数，殆未滥觞，东南下百余里，至白马岭西，历天彭关，亦谓之天谷。天彭山两山相对，其高若阙，谓之天彭门。江水自此以上至微弱，所谓其源滥觞者也。汉元延中，岷山崩，壅江水三日不流，即其处。岷，音武巾翻。","note_type":"hu_note","start_index":15,"tongjian_id":"922117ce-db0e-11ef-ac78-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惡，音烏路翻；惡其徵異也。","note_content_jianti_auto":"恶，音乌路翻；恶其征异也。","note_type":"hu_note","start_index":30,"tongjian_id":"922117e8-db0e-11ef-9119-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周幽王","people_name_jianti_auto":"周幽王","start_index":0,"tongjian_id":"922117ea-db0e-11ef-9315-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":14,"tongjian_id":"922117eb-db0e-11ef-a8a5-a0d3651f611f"},{"people_name":"幽王","people_name_jianti_auto":"幽王","start_index":38,"tongjian_id":"922117ec-db0e-11ef-b8b9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"三川","place_name_jianti_auto":"三川","start_index":6,"tongjian_id":"922117ed-db0e-11ef-a686-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":10,"tongjian_id":"922117ee-db0e-11ef-922f-a0d3651f611f"},{"place_name":"三川","place_name_jianti_auto":"三川","start_index":18,"tongjian_id":"922117ef-db0e-11ef-9817-a0d3651f611f"},{"place_name":"涇","place_name_jianti_auto":"泾","start_index":21,"tongjian_id":"922117f0-db0e-11ef-b6e6-a0d3651f611f"},{"place_name":"渭","place_name_jianti_auto":"渭","start_index":23,"tongjian_id":"922117f1-db0e-11ef-9023-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":25,"tongjian_id":"922117f2-db0e-11ef-8da5-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":28,"tongjian_id":"922117f3-db0e-11ef-b38e-a0d3651f611f"},{"place_name":"漆","place_name_jianti_auto":"漆","start_index":31,"tongjian_id":"922117f4-db0e-11ef-afce-a0d3651f611f"},{"place_name":"沮","place_name_jianti_auto":"沮","start_index":33,"tongjian_id":"922117f5-db0e-11ef-aaab-a0d3651f611f"},{"place_name":"犬戎","place_name_jianti_auto":"犬戎","start_index":48,"tongjian_id":"922117f6-db0e-11ef-a339-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周幽王二年，三川竭，岐山崩。師古曰：三川，涇、渭、洛也。洛，卽漆、沮也。余按幽王時有是異，後卒爲犬戎所殺。","note_content_jianti_auto":"周幽王二年，三川竭，岐山崩。师古曰：三川，泾、渭、洛也。洛，即漆、沮也。余按幽王时有是异，后卒为犬戎所杀。","note_type":"hu_note","start_index":48,"tongjian_id":"922117e9-db0e-11ef-a693-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"太王","people_name_jianti_auto":"太王","start_index":2,"tongjian_id":"922117f8-db0e-11ef-bdae-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":0,"tongjian_id":"922117f9-db0e-11ef-a10b-a0d3651f611f"},{"place_name":"狄","place_name_jianti_auto":"狄","start_index":5,"tongjian_id":"922117fa-db0e-11ef-93c8-a0d3651f611f"},{"place_name":"豳","place_name_jianti_auto":"豳","start_index":7,"tongjian_id":"922117fb-db0e-11ef-adff-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":12,"tongjian_id":"922117fc-db0e-11ef-9bf7-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":17,"tongjian_id":"922117fd-db0e-11ef-8c84-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周自太王避狄去豳，而邑于岐山之下，周之王業遂興於此。","note_content_jianti_auto":"周自太王避狄去豳，而邑于岐山之下，周之王业遂兴于此。","note_type":"hu_note","start_index":57,"tongjian_id":"922117f7-db0e-11ef-92f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":0,"tongjian_id":"922117ff-db0e-11ef-ac28-a0d3651f611f"},{"people_name":"項羽","people_name_jianti_auto":"项羽","start_index":15,"tongjian_id":"92211800-db0e-11ef-9d0b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢中","place_name_jianti_auto":"汉中","start_index":4,"tongjian_id":"92211801-db0e-11ef-9d42-a0d3651f611f"},{"place_name":"三秦","place_name_jianti_auto":"三秦","start_index":11,"tongjian_id":"92211802-db0e-11ef-a3e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高帝始王漢中，起兵還定三秦，誅項羽，遂有天下。","note_content_jianti_auto":"高帝始王汉中，起兵还定三秦，诛项羽，遂有天下。","note_type":"hu_note","start_index":66,"tongjian_id":"922117fe-db0e-11ef-b266-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":109,"tongjian_id":"92211804-db0e-11ef-a77a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"天文志：房南衆星曰騎官，左角理，右角將。大角者，天王帝坐庭，其兩旁各有三星鼎足句之，曰攝提。攝提者，直斗杓所指，以建時節，故曰攝提格。晉·天文志：參十星，於辰在申。至辰者，至大火也。自氐五度至尾九度，爲大火，於辰在卯。如淳曰：孛星尾長及攝提大角，始發於參至辰也。孛，蒲內翻。參，疏簪翻。","note_content_jianti_auto":"天文志：房南众星曰骑官，左角理，右角将。大角者，天王帝坐庭，其两旁各有三星鼎足句之，曰摄提。摄提者，直斗杓所指，以建时节，故曰摄提格。晋·天文志：参十星，于辰在申。至辰者，至大火也。自氐五度至尾九度，为大火，于辰在卯。如淳曰：孛星尾长及摄提大角，始发于参至辰也。孛，蒲内翻。参，疏簪翻。","note_type":"hu_note","start_index":92,"tongjian_id":"92211803-db0e-11ef-951d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"岐山","place_name_jianti_auto":"岐山","resolved_place_entity_id":592,"start_index":35,"tongjian_id":"9221180e-db0e-11ef-9a9b-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","resolved_place_entity_id":592,"start_index":48,"tongjian_id":"92211810-db0e-11ef-9b32-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"。","context_before":"...于西羌，汤起于亳。周之王也，以丰镐伐殷。秦之帝用雍州兴。","source_end_index":78,"source_paragraph_tongjian_id":"90e66767-1691-588a-baf5-a3aefa9a8794","source_start_index":72,"source_text":"汉之兴自蜀汉"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"[谓西周，韦昭以泾、渭、汭为三川。杜预曰：泾、渭、洛也。...","context_before":"...时，与泾、渭并为三川。《国语》：幽王三年，西周三川皆震。","source_end_index":495,"source_paragraph_tongjian_id":"99719864-4326-5621-bf72-0ba180539b6c","source_start_index":473,"source_text":"《左传》昭二十二年，苌弘曰：周之亡也，三川震"},{"context_after":"[《史记·六国表》：显王三年，秦败韩魏之师于洛阴]。又洛...","context_before":"...杨休之对高欢曰：河、洛、伊为三川，泾、渭、洛亦为三川]。","source_end_index":572,"source_paragraph_tongjian_id":"99719864-4326-5621-bf72-0ba180539b6c","source_start_index":553,"source_text":"汉刘向云：昔周岐山崩，三川竭，而幽王亡"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、凤翔府（卷五十五）","excerpts":[{"context_after":"又成王有岐阳之蒐。宣王亦大猎岐阳。幽王三年，三川竭，岐山...","context_before":"...“率西水浒，至于岐下”。又云“彼阻矣岐，有夷之行”者也。","source_end_index":88,"source_paragraph_tongjian_id":"331a9223-9183-5dc1-8d15-f3af54cb72fe","source_start_index":71,"source_text":"《传》云：周之兴也，鸑鷟鸣于岐山。"},{"context_after":"《吕氏春秋》：岐山，九山之一也。后汉建初七年，幸岐山。西...","context_before":"...之兴也，鸑鷟鸣于岐山。又成王有岐阳之蒐。宣王亦大猎岐阳。","source_end_index":118,"source_paragraph_tongjian_id":"331a9223-9183-5dc1-8d15-f3af54cb72fe","source_start_index":105,"source_text":"幽王三年，三川竭，岐山崩。"}],"path":"陕西方舆纪要/三、凤翔府（卷五十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1春，正月，丙寅，蜀郡岷山崩，壅江三日，江水竭。劉向大惡之，曰：「昔周岐山崩，三川竭，而幽王亡。岐山者，周所興也。漢家本起於蜀、漢，今所起之地，山崩川竭，星孛又及攝提、大角，從參至辰，殆必亡矣！」","content_fanyi":"春季，正月初十日丙寅，蜀郡岷山崩塌，土石壅塞岷江三天，下游江水枯竭。刘向对此非常震惊，说：“从前周朝岐山崩塌，泾水、渭水、洛水三条河流枯竭，周幽王因而灭亡。岐山是周朝兴起的地方。汉家本来兴起于蜀、汉之地，如今兴起之地山崩川竭，彗星尾巴又扫及摄提、大角，从参星一直扫到辰星，汉朝恐怕必定要灭亡了！”","content_jianti_auto":"1春，正月，丙寅，蜀郡岷山崩，壅江三日，江水竭。刘向大恶之，曰：「昔周岐山崩，三川竭，而幽王亡。岐山者，周所兴也。汉家本起于蜀、汉，今所起之地，山崩川竭，星孛又及摄提、大角，从参至辰，殆必亡矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":2528,"number":1,"path":"资治通鉴 : 卷第三十二 (漢紀二十四) / 孝成皇帝中 / 三年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"922117cd-db0e-11ef-a815-a0d3651f611f","year_int":-10},"tongjian_id":"922117cd-db0e-11ef-a815-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"岐山","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":8,"tongjian_id":"9546305d-db0e-11ef-8a2c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"槐里縣","place_name_jianti_auto":"槐里县","start_index":0,"tongjian_id":"9546305e-db0e-11ef-94d0-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":5,"tongjian_id":"9546305f-db0e-11ef-9161-a0d3651f611f"},{"place_name":"槐里","place_name_jianti_auto":"槐里","start_index":12,"tongjian_id":"95463060-db0e-11ef-9eca-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":15,"tongjian_id":"95463061-db0e-11ef-9a9a-a0d3651f611f"},{"place_name":"犬丘","place_name_jianti_auto":"犬丘","start_index":17,"tongjian_id":"95463062-db0e-11ef-a3a2-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":20,"tongjian_id":"95463063-db0e-11ef-b998-a0d3651f611f"},{"place_name":"廢丘","place_name_jianti_auto":"废丘","start_index":22,"tongjian_id":"95463064-db0e-11ef-879e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":25,"tongjian_id":"95463065-db0e-11ef-9129-a0d3651f611f"},{"place_name":"槐里","place_name_jianti_auto":"槐里","start_index":28,"tongjian_id":"95463066-db0e-11ef-b9d3-a0d3651f611f"},{"place_name":"岐山","place_name_jianti_auto":"岐山","start_index":31,"tongjian_id":"95463067-db0e-11ef-8621-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":35,"tongjian_id":"95463068-db0e-11ef-ac7b-a0d3651f611f"},{"place_name":"美陽縣","place_name_jianti_auto":"美阳县","start_index":37,"tongjian_id":"95463069-db0e-11ef-8ac7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"槐里縣，屬扶風。杜佑曰：槐里，周曰犬丘，秦曰廢丘，漢改曰槐里。岐山，在扶風美陽縣。","note_content_jianti_auto":"槐里县，属扶风。杜佑曰：槐里，周曰犬丘，秦曰废丘，汉改曰槐里。岐山，在扶风美阳县。","note_type":"hu_note","start_index":33,"tongjian_id":"9546305c-db0e-11ef-b975-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"岐山","place_name_jianti_auto":"岐山","resolved_place_entity_id":592,"start_index":30,"tongjian_id":"9546306f-db0e-11ef-8386-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/资治通鉴","excerpts":[{"context_after":"；又乙未幸东阿，北登太行山，至天井关，夏四月乙卯还宫。又...","context_before":"...昌宣王和其奴卒，皆无关于社稷治乱。而周勃薨，乃不书。及书","source_end_index":576,"source_paragraph_tongjian_id":"bed14566-6877-48d4-869c-49a53aaa7eeb","source_start_index":538,"source_text":"汉章帝行幸长安，进幸槐里、岐山，又幸长平，御池阳宫，东至高陵，十二月丁亥还宫"}],"path":"续笔/卷四/资治通鉴","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"]。","context_before":"...长安，宿长平阪。上自甘泉宿池阳宫，登长平阪，诏单于毋谒。","source_end_index":93,"source_paragraph_tongjian_id":"00313ef0-0d21-5276-bd66-1161099381a5","source_start_index":63,"source_text":"后汉建初七年，幸长平，御池阳宫，东至高陵，造舟于泾而还，是也"},{"context_after":"晋初为始平郡治。建兴四年，南阳王保镇上邽，遣其将胡崧救长...","context_before":"...丘。汉王引水灌之，废丘降，章邯自杀。汉三年，始置槐里县。","source_end_index":122,"source_paragraph_tongjian_id":"3b47a8b7-06d0-5cc3-8870-dbc2a2d09629","source_start_index":111,"source_text":"后汉建初七年，幸槐里。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、凤翔府（卷五十五）","excerpts":[{"context_after":"西魏大统十三年，宇文泰从魏主狩于岐阳。魏主廓三年，以岐阳...","context_before":"...王三年，三川竭，岐山崩。《吕氏春秋》：岐山，九山之一也。","source_end_index":145,"source_paragraph_tongjian_id":"331a9223-9183-5dc1-8d15-f3af54cb72fe","source_start_index":134,"source_text":"后汉建初七年，幸岐山。"}],"path":"陕西方舆纪要/三、凤翔府（卷五十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"6冬，十月，癸丑，帝行幸長安，封蕭何末孫熊爲酇侯。進幸槐里、岐山；又幸長平，御池陽宮，東至高陵；十二月，丁亥，還宮。","content_fanyi":"冬季，十月十九日癸丑，汉章帝出巡长安，封萧何的末代孙萧熊为酇侯。继而巡行槐里、岐山；又巡行长平，入住池阳宫，东行到达高陵县；十二月丁亥日（疑误），返回宫中。","content_jianti_auto":"6冬，十月，癸丑，帝行幸长安，封萧何末孙熊为酂侯。进幸槐里、岐山；又幸长平，御池阳宫，东至高陵；十二月，丁亥，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3697,"number":6,"path":"资治通鉴 : 卷第四十六 (漢紀三十八) / 肅宗孝章皇帝上 / 七年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"9546305b-db0e-11ef-863c-a0d3651f611f","year_int":82},"tongjian_id":"9546305b-db0e-11ef-863c-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"岐山","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":0,"tongjian_id":"bbc15a5d-db0e-11ef-a4df-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":3,"tongjian_id":"bbc15a5e-db0e-11ef-97c4-a0d3651f611f"},{"place_name":"雍縣","place_name_jianti_auto":"雍县","start_index":5,"tongjian_id":"bbc15a5f-db0e-11ef-9fc3-a0d3651f611f"},{"place_name":"平秦郡","place_name_jianti_auto":"平秦郡","start_index":8,"tongjian_id":"bbc15a60-db0e-11ef-97f4-a0d3651f611f"},{"place_name":"西魏","place_name_jianti_auto":"西魏","start_index":12,"tongjian_id":"bbc15a61-db0e-11ef-b1e6-a0d3651f611f"},{"place_name":"岐山郡","place_name_jianti_auto":"岐山郡","start_index":16,"tongjian_id":"bbc15a62-db0e-11ef-b91a-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":20,"tongjian_id":"bbc15a63-db0e-11ef-a9b5-a0d3651f611f"},{"place_name":"岐州","place_name_jianti_auto":"岐州","start_index":27,"tongjian_id":"bbc15a64-db0e-11ef-a58a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後魏分扶風雍縣置平秦郡，西魏改爲岐山郡，隋廢郡爲縣，屬岐州。","note_content_jianti_auto":"后魏分扶风雍县置平秦郡，西魏改为岐山郡，隋废郡为县，属岐州。","note_type":"hu_note","start_index":13,"tongjian_id":"bbc15a5c-db0e-11ef-a9d9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pin