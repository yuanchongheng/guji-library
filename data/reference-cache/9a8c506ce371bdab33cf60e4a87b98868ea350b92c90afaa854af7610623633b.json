{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚辰、二○）","note_content_jianti_auto":"（庚辰、二○）","note_type":"hu_note","start_index":0,"tongjian_id":"9340c692-db0e-11ef-8c8a-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/建武中元","excerpts":[{"context_after":"，兹二器各冠以始元者，自莽之制如此，亦犹其改易郡名不常，...","context_before":"...云：“新始建国地皇上戊二年。”按，王莽始建国之后改天凤，","source_end_index":279,"source_paragraph_tongjian_id":"958c6b13-293e-47ab-ad2d-91374864ff2e","source_start_index":275,"source_text":"又改地皇"}],"path":"随笔/卷六/建武中元","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"1春，正月，乙未，赦天下；改元曰地皇，從三萬六千歲曆號也。","content_fanyi":"春季正月乙未日，大赦天下；改年号为地皇，是依从三万六千年历法的历号。","content_jianti_auto":"1春，正月，乙未，赦天下；改元曰地皇，从三万六千岁历号也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2905,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9340c693-db0e-11ef-91f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9340c696-db0e-11ef-945e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：趨讙，謂趨走而讙譁也。須，待也。讙，許元翻。","note_content_jianti_auto":"师古曰：趋讙，谓趋走而讙哗也。须，待也。讙，许元翻。","note_type":"hu_note","start_index":29,"tongjian_id":"9340c695-db0e-11ef-90b6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"9340c698-db0e-11ef-bc12-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：不敢發言，以目相眄而已。","note_content_jianti_auto":"韦昭曰：不敢发言，以目相眄而已。","note_type":"hu_note","start_index":49,"tongjian_id":"9340c697-db0e-11ef-abd6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":1,"tongjian_id":"9340c699-db0e-11ef-bffd-a0d3651f611f","wl_zhushi":"[时年六十五]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","内政"],"content":"2莽下書曰：「方出軍行師，敢有趨讙犯法者輒論斬，毋須時！」於是春、夏斬人都市，百姓震懼，道路以目。","content_fanyi":"王莽下诏书说：“正当出兵行军之际，敢有奔跑喧哗、违反法令的，立即判处斩首，不必等待行刑时节！”于是春季、夏季都在都市处决犯人，百姓震惊恐惧，路上相遇只能用目光示意。","content_jianti_auto":"2莽下书曰：「方出军行师，敢有趋讙犯法者辄论斩，毋须时！」于是春、夏斩人都市，百姓震惧，道路以目。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2906,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9340c694-db0e-11ef-bafa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":6,"tongjian_id":"9340c69c-db0e-11ef-8c9d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻。師古曰：厭，音一葉翻。","note_content_jianti_auto":"复，扶又翻。师古曰：厌，音一叶翻。","note_type":"hu_note","start_index":14,"tongjian_id":"9340c69b-db0e-11ef-8a42-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"州牧爲大將軍；卒正、連率、大尹爲偏將軍；屬令、長爲裨將軍；縣宰爲校尉。","note_content_jianti_auto":"州牧为大将军；卒正、连率、大尹为偏将军；属令、长为裨将军；县宰为校尉。","note_type":"hu_note","start_index":136,"tongjian_id":"9340c69d-db0e-11ef-901d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9340c69f-db0e-11ef-b63a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：見，謂見在也。傳，知戀翻。見，賢遍翻。","note_content_jianti_auto":"师古曰：见，谓见在也。传，知恋翻。见，贤遍翻。","note_type":"hu_note","start_index":157,"tongjian_id":"9340c69e-db0e-11ef-820a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9340c6a1-db0e-11ef-ad71-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：於道中行者，卽執取之以充事也。","note_content_jianti_auto":"师古曰：于道中行者，即执取之以充事也。","note_type":"hu_note","start_index":171,"tongjian_id":"9340c6a0-db0e-11ef-8a6a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代及王莽時期的高級軍事指揮官，通常掌管全國軍隊，此處指黃帝擔任此職以定天下，用於王莽自比以強化權威。","official_rank":"高級將領","source_snippet":"將兵爲大將軍","start_index":24,"tongjian_id":"8bbbb5d3-b3a3-4a41-84e4-1652601e0ade"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"大司馬","official_note":"大司馬在漢代及王莽時期是最高軍事長官之一，常與大將軍並置，此處王莽設置五人以擴張軍事控制，反映其集權措施。","official_rank":"高級將領","source_snippet":"外置大司馬五人","start_index":31,"tongjian_id":"3e8a58b1-cbbe-4ac4-8ab7-31225538152b"},{"confidence":0.9,"official_category":"地方行政","official_name":"州牧","official_note":"州牧是漢代及王莽時期的地方行政長官，掌管一州事務，此處王莽賜予州牧軍事稱號以加強地方控制。","official_rank":"高級地方官","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":88,"tongjian_id":"46e5dd6a-160c-4675-80b0-e42a8010a37c"},{"confidence":0.9,"official_category":"地方行政","official_name":"縣宰","official_note":"縣宰是漢代及王莽時期的縣級行政長官，類似縣令，此處王莽賜予軍事稱號以整合地方權力。","official_rank":"基層地方官","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":91,"tongjian_id":"14ae84ee-5194-44de-97ae-04774410a0bc"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"大將軍","official_note":"此處大將軍作為賜予州牧和縣宰的稱號，而非實際職務，用於虛張聲勢以強化王莽的軍事威懾。","official_rank":"高級將領","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":94,"tongjian_id":"accef322-4b61-4333-8d88-b003bb3952c5"},{"confidence":0.8,"official_category":"軍事指揮","official_name":"偏","official_note":"偏是偏將軍的簡稱，漢代軍事職位，通常為副將或中級指揮官，此處作為賜號以提升地方官員的軍事地位。","official_rank":"中級將領","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":98,"tongjian_id":"5424b90a-9440-418f-af78-d7b8fb29215c"},{"confidence":0.8,"official_category":"軍事指揮","official_name":"裨","official_note":"裨是裨將軍的簡稱，漢代軍事職位，常為副將或輔助指揮官，此處作為賜號以增強地方軍事組織。","official_rank":"中級將領","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":100,"tongjian_id":"1e524016-fbbe-4e64-a983-059725f57df0"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"校尉","official_note":"校尉是漢代及王莽時期的中級軍官，掌管一部軍隊，此處作為賜予地方官員的稱號，以虛構軍事體系。","official_rank":"中級將領","source_snippet":"賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉","start_index":102,"tongjian_id":"7e40ef22-a4d8-4aa8-9df5-8372832b25e3"}],"ExtRef_Children_people":[{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":1,"tongjian_id":"9340c6a2-db0e-11ef-b122-a0d3651f611f"},{"link_td_description":"黄帝，中国古代部落联盟首领，为《史记》中五帝之首。","link_td_id":"Q10000032","link_td_number_id":10961,"people_name":"黃帝","people_name_jianti_auto":"黄帝","people_xingming":"黄帝","start_index":26,"tongjian_id":"9340c6a3-db0e-11ef-b102-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9340c69a-db0e-11ef-9d71-a0d3651f611f","pinyin":"pí","source_anchor_text":"大將軍偏裨校尉之號","source_key":"baiyang_epub","start_index":128,"text":"裨","tongjian_id":"12ced498-ffda-5468-86bf-7ce6d5601549"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[{"title":"绿林起义","tongjian_id":"war_N0589"},{"title":"赤眉起义","tongjian_id":"war_N0590"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3莽見四方盜賊多，復欲厭之，又下書曰：「予之皇初祖考黃帝定天下，將兵爲大將軍，內設大將，外置大司馬五人，大將軍至士吏凡七十三萬八千九百人，士千三百五十萬人。予受符命之文，稽前人，將條備焉。」於是置前、後、左、右、中大司馬之位，賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉。乘傳使者經歷郡國，日且十輩，倉無見穀以給；傳車馬不能足，賦取道中車馬，取辦於民。","content_fanyi":"王莽看到四方盗贼众多，又想加以压制，于是再次下诏书说：“我的皇初祖考黄帝平定天下，统兵担任大将军，朝内设大将，朝外设大司马五人，从大将军到士吏共七十三万八千九百人，士卒一千三百五十万人。我承受符命文辞，查考前人制度，将逐条设置齐备。”于是设置前、后、左、右、中大司马的职位，赐给各州牧直到县宰大将军、偏将、裨将、校尉的称号。乘坐传车的使者经过各个郡国，每天将近十批，仓库中没有现粮可供其食用；传车马匹不够用，就向民间征收调用沿途车马，由百姓置办解决。","content_jianti_auto":"3莽见四方盗贼多，复欲厌之，又下书曰：「予之皇初祖考黄帝定天下，将兵为大将军，内设大将，外置大司马五人，大将军至士吏凡七十三万八千九百人，士千三百五十万人。予受符命之文，稽前人，将条备焉。」于是置前、后、左、右、中大司马之位，赐诸州牧至县宰皆有大将军、偏、裨、校尉之号焉。乘传使者经历郡国，日且十辈，仓无见谷以给；传车马不能足，赋取道中车马，取办于民。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2907,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9340c69a-db0e-11ef-9d71-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"莽","people_name_jianti_auto":"莽","start_index":0,"tongjian_id":"9342e93d-db0e-11ef-84a2-a0d3651f611f"},{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":12,"tongjian_id":"9342e93e-db0e-11ef-9a8b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":2,"tongjian_id":"9342e93f-db0e-11ef-bd96-a0d3651f611f"},{"place_name":"王路堂","place_name_jianti_auto":"王路堂","start_index":8,"tongjian_id":"9342e940-db0e-11ef-bf77-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"莽改未央宮前殿曰王路堂。服虔曰：如言路寢也。路，大也。","note_content_jianti_auto":"莽改未央宫前殿曰王路堂。服虔曰：如言路寝也。路，大也。","note_type":"hu_note","start_index":13,"tongjian_id":"9342e93c-db0e-11ef-b4e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":27,"tongjian_id":"9342e942-db0e-11ef-9778-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"餔，食也。餔時，食時也。或曰：餔，卽晡時；日加申爲晡。師古曰：烈風，烈暴之風。折，而設翻。","note_content_jianti_auto":"𫗦，食也。𫗦时，食时也。或曰：𫗦，即晡时；日加申为晡。师古曰：烈风，烈暴之风。折，而设翻。","note_type":"hu_note","start_index":37,"tongjian_id":"9342e941-db0e-11ef-8078-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9342e944-db0e-11ef-a33c-a0d3651f611f"},{"people_name":"舜","people_name_jianti_auto":"舜","start_index":20,"tongjian_id":"9342e945-db0e-11ef-82fe-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：先言烈風雷雨，後言迷乃解矣，蓋取舜烈風雷雨弗迷以爲言也。","note_content_jianti_auto":"师古曰：先言烈风雷雨，后言迷乃解矣，盖取舜烈风雷雨弗迷以为言也。","note_type":"hu_note","start_index":52,"tongjian_id":"9342e943-db0e-11ef-9c7d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"9342fee7-db0e-11ef-82d2-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"9342fee8-db0e-11ef-a1af-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":28,"tongjian_id":"9342fee9-db0e-11ef-869f-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":32,"tongjian_id":"9342feea-db0e-11ef-9631-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「命」下有「文」字；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：十二行本「命」下有「文」字；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"9342fee6-db0e-11ef-ace7-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":55,"tongjian_id":"9342e946-db0e-11ef-aeab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言疾雖有瘳，不能平復如其初也。","note_content_jianti_auto":"言疾虽有瘳，不能平复如其初也。","note_type":"hu_note","start_index":116,"tongjian_id":"9342feeb-db0e-11ef-a025-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9342feed-db0e-11ef-848e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：鮮，少也。耗，減也。鮮，音先踐翻。","note_content_jianti_auto":"师古曰：鲜，少也。耗，减也。鲜，音先践翻。","note_type":"hu_note","start_index":144,"tongjian_id":"9342feec-db0e-11ef-8fa3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9342fef0-db0e-11ef-8468-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：征營，惶恐不自安之意也。錯，七故翻。","note_content_jianti_auto":"师古曰：征营，惶恐不自安之意也。错，七故翻。","note_type":"hu_note","start_index":165,"tongjian_id":"9342feef-db0e-11ef-848b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"9343129c-db0e-11ef-adce-a0d3651f611f"},{"people_name":"安","people_name_jianti_auto":"安","start_index":4,"tongjian_id":"9343129d-db0e-11ef-ad5b-a0d3651f611f"},{"people_name":"莽","people_name_jianti_auto":"莽","start_index":6,"tongjian_id":"9343129e-db0e-11ef-a3fc-a0d3651f611f"},{"people_name":"莽","people_name_jianti_auto":"莽","start_index":17,"tongjian_id":"9343129f-db0e-11ef-91d5-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":27,"tongjian_id":"934312a0-db0e-11ef-8b0a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汝南","place_name_jianti_auto":"汝南","start_index":19,"tongjian_id":"934312a1-db0e-11ef-80fc-a0d3651f611f"},{"place_name":"新蔡","