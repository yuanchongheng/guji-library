-db0e-11ef-9b66-a0d3651f611f"},{"people_name":"桓公","people_name_jianti_auto":"桓公","start_index":123,"tongjian_id":"8c26e32d-db0e-11ef-a65d-a0d3651f611f"},{"people_name":"曹沫","people_name_jianti_auto":"曹沫","start_index":130,"tongjian_id":"8c26e32e-db0e-11ef-b68f-a0d3651f611f"},{"people_name":"管仲","people_name_jianti_auto":"管仲","start_index":133,"tongjian_id":"8c26e32f-db0e-11ef-9ae4-a0d3651f611f"},{"people_name":"晉文公","people_name_jianti_auto":"晋文公","start_index":162,"tongjian_id":"8c26e330-db0e-11ef-92b9-a0d3651f611f"},{"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","start_index":226,"tongjian_id":"8c26e331-db0e-11ef-b43d-a0d3651f611f"},{"people_name":"威烈王","people_name_jianti_auto":"威烈王","start_index":233,"tongjian_id":"8c26e332-db0e-11ef-9af1-a0d3651f611f"},{"people_name":"沫","people_name_jianti_auto":"沫","start_index":272,"tongjian_id":"8c26e333-db0e-11ef-8586-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"邾","place_name_jianti_auto":"邾","start_index":30,"tongjian_id":"8c26e334-db0e-11ef-8227-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":68,"tongjian_id":"8c26e335-db0e-11ef-917c-a0d3651f611f"},{"place_name":"柯","place_name_jianti_auto":"柯","place_note":"山东阳谷东","start_index":84,"tongjian_id":"8c26e336-db0e-11ef-8870-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":103,"tongjian_id":"8c26e337-db0e-11ef-aa9b-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":144,"tongjian_id":"8c26e338-db0e-11ef-bf83-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":153,"tongjian_id":"8c26e339-db0e-11ef-afc8-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":166,"tongjian_id":"8c26e33a-db0e-11ef-9e37-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":174,"tongjian_id":"8c26e33b-db0e-11ef-91c2-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":188,"tongjian_id":"8c26e33c-db0e-11ef-a51c-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":209,"tongjian_id":"8c26e33d-db0e-11ef-923e-a0d3651f611f"},{"place_name":"原","place_name_jianti_auto":"原","start_index":223,"tongjian_id":"8c26e33e-db0e-11ef-b679-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：曹本自顓頊之玄孫陸終之子六安，是爲曹姓。周武王封曹狹於邾，故邾，曹姓也。又云：曹，叔振鐸之後，武王母弟也，後以爲氏。史記：齊桓公伐魯，魯莊公請平，桓公許之，與盟於柯。將盟，曹沫以匕首劫桓公於壇上，請反魯之侵地。桓公許之，曹沫去匕首而就臣位。桓公後悔，欲殺曹沫，管仲不可，遂反所侵地於魯。諸侯聞之，皆信齊而欲附焉。左傳：晉文公圍原，命三日之糧。原不降，命去之。諜出，曰：「原將降矣。」軍吏曰：「請待之。」公曰：「得原失信，所亡滋多。」退一舍而原降。魏文侯事見上卷威烈王二十三年。背，蒲妹翻。索隱曰：沫，音亡葛翻。左傳、穀梁並作「曹劌」。然則沫宜音劌，沫、劌聲相近而字異耳。","note_content_jianti_auto":"姓谱：曹本自颛顼之玄孙陆终之子六安，是为曹姓。周武王封曹狭于邾，故邾，曹姓也。又云：曹，叔振铎之后，武王母弟也，后以为氏。史记：齐桓公伐鲁，鲁庄公请平，桓公许之，与盟于柯。将盟，曹沫以匕首劫桓公于坛上，请反鲁之侵地。桓公许之，曹沫去匕首而就臣位。桓公后悔，欲杀曹沫，管仲不可，遂反所侵地于鲁。诸侯闻之，皆信齐而欲附焉。左传：晋文公围原，命三日之粮。原不降，命去之。谍出，曰：「原将降矣。」军吏曰：「请待之。」公曰：「得原失信，所亡滋多。」退一舍而原降。魏文侯事见上卷威烈王二十三年。背，蒲妹翻。索隐曰：沫，音亡葛翻。左传、谷梁并作「曹刿」。然则沫宜音刿，沫、刿声相近而字异耳。","note_type":"hu_note","start_index":177,"tongjian_id":"8c255ca8-db0e-11ef-a0b3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8c2711c8-db0e-11ef-ae5d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"○小韩寨，在县东北二十里，元知院官韩志所修筑，亦曰小韩寨...","context_before":"○会盟台[《志》云：在县治南，即齐桓公会江黄时所筑。","source_end_index":46,"source_paragraph_tongjian_id":"56de66aa-0aab-534e-8ccd-70d00bf6b363","source_start_index":26,"source_text":"又鲁将曹沫挟匕首劫齐桓公处，亦名阳穀亭。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、怀庆府（卷四十九）","excerpts":[{"context_after":"今名原乡]。","context_before":"...一作鮖柔，亦作平柔。○原城，在县西北十五里。周畿内国也。","source_end_index":315,"source_paragraph_tongjian_id":"d36eb168-24a5-5553-9709-227266f699e5","source_start_index":290,"source_text":"僖二十六年，晋文公代原示信，又赵衰为原大夫，即此。"}],"path":"河南方舆纪要/三、怀庆府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"臣光曰：夫信者，人君之大寶也。國保於民，民保於信；非信無以使民，非民無以守國。是故古之王者不欺四海，霸者不欺四鄰，善爲國者不欺其民，善爲家者不欺其親。不善者反之，欺其鄰國，欺其百姓，甚者欺其兄弟，欺其父子。上不信下，下不信上，上下離心，以至於敗。所利不能藥其所傷，所獲不能補其所亡，豈不哀哉！昔齊桓公不背曹沫之盟，晉文公不貪伐原之利，魏文侯不棄虞人之期，秦孝公不廢徙木之賞。此四君者道非粹白，而商君尤稱刻薄，又處戰攻之世，天下趨於詐力，猶且不敢忘信以畜其民，況爲四海治平之政者哉！","content_fanyi":"司马光说：信用，是君主的大宝。国家靠民众得以保全，民众靠信用得以保全；没有信用就无法役使民众，没有民众就无法守卫国家。因此，古代称王的人不欺骗天下，称霸的人不欺骗四邻，善于治国的人不欺骗自己的百姓，善于治家的人不欺骗自己的亲人。不善于如此的人反其道而行之：欺骗邻国，欺骗百姓，更严重的欺骗兄弟、欺骗父子。君主不信任臣下，臣下不信任君主，上下离心，最终走向败亡。所得到的好处不能医治所受到的伤害，所得的利益不能弥补所失去的，难道不可悲吗！从前，齐桓公不背弃与曹沫订立的盟约，晋文公不贪图攻伐原国的利益，魏文侯不放弃与虞人约定的打猎日期，秦孝公不取消搬移木杆者的赏赐。这四位君主，治国之道并非纯白无瑕，商鞅尤其以刻薄著称；又处在攻战不断的时代，天下趋向欺诈和武力，他们尚且不敢忘记用信用来安抚自己的人民，何况是治理天下、天下太平的执政者呢！","content_jianti_auto":"臣光曰：夫信者，人君之大宝也。国保于民，民保于信；非信无以使民，非民无以守国。是故古之王者不欺四海，霸者不欺四邻，善为国者不欺其民，善为家者不欺其亲。不善者反之，欺其邻国，欺其百姓，甚者欺其兄弟，欺其父子。上不信下，下不信上，上下离心，以至于败。所利不能药其所伤，所获不能补其所亡，岂不哀哉！昔齐桓公不背曹沫之盟，晋文公不贪伐原之利，魏文侯不弃虞人之期，秦孝公不废徙木之赏。此四君者道非粹白，而商君尤称刻薄，又处战攻之世，天下趋于诈力，犹且不敢忘信以畜其民，况为四海治平之政者哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":129,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c255ca4-db0e-11ef-996f-a0d3651f611f","year_int":-359},"tongjian_id":"8c255ca4-db0e-11ef-996f-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8c372c85-db0e-11ef-8f20-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本無「爲」字；乙十一行本同。』","note_content_jianti_auto":"『章：十二行本无「为」字；乙十一行本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8c372c84-db0e-11ef-8201-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":25,"tongjian_id":"8c372c83-db0e-11ef-b761-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8c372c87-db0e-11ef-9f13-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：子思、孟子之言，一也。夫唯仁者爲知仁義之爲利，不仁者不知也。故孟子對梁王直以仁義而不及利者，所與言之人異故也。","content_fanyi":"臣司马光评论说：子思和孟子的话，道理是一致的。只有仁德的人才能懂得仁义的利益所在，不仁德的人则不懂得这一点。所以孟子面对梁王，也就是魏惠王，只讲仁义而不谈利益，是因为所交谈的对象不同。","content_jianti_auto":"臣光曰：子思、孟子之言，一也。夫唯仁者为知仁义之为利，不仁者不知也。故孟子对梁王直以仁义而不及利者，所与言之人异故也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":178,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十三年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c372c82-db0e-11ef-90bb-a0d3651f611f","year_int":-336},"tongjian_id":"8c372c82-db0e-11ef-90bb-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"頤卦·彖辭也。爲，于僞翻。","note_content_jianti_auto":"颐卦·彖辞也。为，于伪翻。","note_type":"hu_note","start_index":30,"tongjian_id":"8c47746d-db0e-11ef-902e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"頓，謂整頓。夫，音扶。","note_content_jianti_auto":"顿，谓整顿。夫，音扶。","note_type":"hu_note","start_index":52,"tongjian_id":"8c47746f-db0e-11ef-a36b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8c477471-db0e-11ef-bf7b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：君子之養士，以爲民也。易曰：「聖人養賢，以及萬民。」夫賢者，其德足以敦化正俗，其才足以頓綱振紀，其明足以燭微慮遠，其強足以結仁固義；大則利天下，小則利一國。是以君子豐祿以富之，隆爵以尊之；養一人而及萬人者，養賢之道也。今孟嘗君之養士也，不恤智愚，不擇臧否，盜其君之祿，以立私黨，張虛譽，上以侮其君，下以蠹其民，是姦人之雄也，烏足尚哉！書曰：「受爲天下逋逃主、萃淵藪。」此之謂也。","content_fanyi":"臣司马光说：君子养士，是为了民众。《易经》说：“圣人养育贤才，从而惠及万民。”贤能的人，他的德行足以敦厚教化、匡正风俗，才能足以整顿纲纪，明智足以洞察细微、思虑长远，刚强足以团结仁人、巩固道义；从大处说可以有利于天下，从小处说可以有利于一国。因此君子用丰厚的俸禄使他们富裕，用高贵的爵位使他们尊贵；供养一个人而能使恩惠遍及万民，这才是养贤的道理。如今孟尝君养士，不管他们聪明还是愚笨，不辨别善良还是邪恶，盗用其国君的俸禄，来树立私人党羽、张扬虚名，对上欺侮他的国君，对下侵害他的民众，这是奸人中的魁首，哪里值得推崇呢！《尚书》说：“纣王是天下逃亡者的窝主、坏人聚集的渊薮。”说的就是这种人。","content_jianti_auto":"臣光曰：君子之养士，以为民也。易曰：「圣人养贤，以及万民。」夫贤者，其德足以敦化正俗，其才足以顿纲振纪，其明足以烛微虑远，其强足以结仁固义；大则利天下，小则利一国。是以君子丰禄以富之，隆爵以尊之；养一人而及万人者，养贤之道也。今孟尝君之养士也，不恤智愚，不择臧否，盗其君之禄，以立私党，张虚誉，上以侮其君，下以蠹其民，是奸人之雄也，乌足尚哉！书曰：「受为天下逋逃主、萃渊薮。」此之谓也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":220,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十八年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"8c47746c-db0e-11ef-9d4e-a0d3651f611f","year_int":-321},"tongjian_id":"8c47746c-db0e-11ef-9d4e-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛氏","people_name_jianti_auto":"毛氏","start_index":9,"tongjian_id":"8c477493-db0e-11ef-8eaf-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":24,"tongjian_id":"8c477494-db0e-11ef-b434-a0d3651f611f"},{"people_name":"陸璣","people_name_jianti_auto":"陆玑","start_index":79,"tongjian_id":"8c477495-db0e-11ef-a463-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":92,"tongjian_id":"8c477496-db0e-11ef-9ca4-a0d3651f611f"},{"people_name":"陸德明","people_name_jianti_auto":"陆德明","start_index":100,"tongjian_id":"8c477497-db0e-11ef-a2f9-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":137,"tongjian_id":"8c477498-db0e-11ef-a8ad-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":105,"tongjian_id":"8c477499-db0e-11ef-b85a-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":110,"tongjian_id":"8c47749a-db0e-11ef-a275-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩·邶·谷風之辭。毛氏傳曰：葑，須也。菲，芴也。鄭氏箋曰：此二菜，蔓菁與葍之類也，皆上下可食，然其根有美時，有惡時，采之者不可以根惡幷棄其葉。下體，謂根莖也。陸璣草木疏曰：葑，蕪菁也。郭璞曰：今菘菜。陸德明曰：江南有菘，江北有蔓菁，相似而異。爾雅曰：菲，芴；又曰：菲，息菜。郭璞曰：菲，芴，士瓜；息菜，似蕪菁，華紫赤色，可食。葍，大葉，白華，根如指，色白，可食。菲，敷尾翻。邶，蒲昧翻。芴，扶拂翻。蔓，謨官翻。葍，方六翻。","note_content_jianti_auto":"诗·邶·谷风之辞。毛氏传曰：葑，须也。菲，芴也。郑氏笺曰：此二菜，蔓菁与葍之类也，皆上下可食，然其根有美时，有恶时，采之者不可以根恶幷弃其叶。下体，谓根茎也。陆玑草木疏曰：葑，芜菁也。郭璞曰：今菘菜。陆德明曰：江南有菘，江北有蔓菁，相似而异。尔雅曰：菲，芴；又曰：菲，息菜。郭璞曰：菲，芴，士瓜；息菜，似芜菁，华紫赤色，可食。葍，大叶，白华，根如指，色白，可食。菲，敷尾翻。邶，蒲昧翻。芴，扶拂翻。蔓，谟官翻。葍，方六翻。","note_type":"hu_note","start_index":59,"tongjian_id":"8c477492-db0e-11ef-a8ab-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8c4774a0-db0e-11ef-a9a2-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：孟嘗君可謂能用諫矣。苟其言之善也，雖懷詐諼之心，猶將用之，況盡忠無私以事其上乎！詩云：「采葑采菲，無以下體。」孟嘗君有焉。","content_fanyi":"臣司马光说：孟尝君可以称得上是善于采纳谏言的人了。如果别人的话确有道理，即使说话人怀有欺诈之心，他尚且会采用，更何况是尽忠无私、事奉君上的人呢！《诗经》说：“采摘葑菜、菲菜，不要因为根部不好而连茎叶也丢掉。”孟尝君就有这种品德。","content_jianti_auto":"臣光曰：孟尝君可谓能用谏矣。苟其言之善也，虽怀诈谖之心，犹将用之，况尽忠无私以事其上乎！诗云：「采葑采菲，无以下体。」孟尝君有焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":222,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十八年 / 第 8 段","reading_annotation_sources":[],"start_index":7,"tongjian_id":"8c477490-db0e-11ef-b6ad-a0d3651f611f","year_int":-321},"tongjian_id":"8c477490-db0e-11ef-b6ad-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚懷王","people_name_jianti_auto":"楚怀王","start_index":1,"tongjian_id":"8ca0d68e-db0e-11ef-91e3-a0d3651f611f"},{"people_name":"秦王","people_name_jianti_auto":"秦王","start_index":12,"tongjian_id":"8ca0d68f-db0e-11ef-8136-a0d3651f611f"},{"people_name":"襄王","people_name_jianti_auto":"襄王","start_index":16,"tongjian_id":"8ca0d690-db0e-11ef-8f3c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":6,"tongjian_id":"8ca0d691-db0e-11ef-b832-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂楚懷王留於秦而以困死，秦王復遺襄王書，以兵威劫之。","note_content_jianti_auto":"谓楚怀王留于秦而以困死，秦王复遗襄王书，以兵威劫之。","note_type":"hu_note","start_index":20,"tongjian_id":"8ca0d68d-db0e-11ef-904d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":0,"tongjian_id":"8ca0d693-db0e-11ef-b164-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":21,"tongjian_id":"8ca0d694-db0e-11ef-9b8c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜預曰：競，強也。或曰：競，爭也，言不能與秦爭也。","note_content_jianti_auto":"杜预曰：竞，强也。或曰：竞，争也，言不能与秦争也。","note_type":"hu_note","start_index":26,"tongjian_id":"8ca0d692-db0e-11ef-8a5e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":4,"chapter_name":"解释篇第四","chenzhu_chapter":"解释者，以今言解古言，以今制释古制，其意义即为注，然注备众体，解释不过注之一端，广而言之，则全注均可谓之解释也。《胡注》之前，《通鉴》有《释文》数种，皆简略。身之始为广注九十七卷，亦仿释文体，乱后重注，将注散入正文，是为今本。前四史虽有旧注，不尽可从，自晋以至五代，则皆身之创为之。且每针对当时，以寓规讽，尤得以鉴名书之义。兹篇所谓解释，虽不过注之一端，亦足见其志之所存也。","chenzhu_index_in_chapter":1,"chenzhu_text":"此有憾于宋高宗之忘雠也。宋高宗父死于金，忍耻而与之和。《朱子文集》七五序魏元履编次《绍兴八年戊午谠议》曰：“君父之雠，不与共戴天，而为之说者曰，复雠可尽五世，则又以明夫苟未及五世之外，犹在乎必报之域也。虽然，此特庶民之事耳。若夫有天下者，承万世无疆之统，则亦有万世必报之雠，非若庶民五世则亲尽服穷而遂已也。”此明为南宋君臣言之，身之之解释，亦犹是耳。","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH04-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚襄王","people_name_jianti_auto":"楚襄王","start_index":1,"tongjian_id":"8ca0d696-db0e-11ef-bce2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":7,"tongjian_id":"8ca0d697-db0e-11ef-9eeb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂楚襄王父死於秦，是仇讎之國也，忍恥而與之婚。","note_content_jianti_auto":"谓楚襄王父死于秦，是仇雠之国也，忍耻而与之婚。","note_type":"hu_note","start_index":34,"tongjian_id":"8ca0d695-db0e-11ef-be9b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8ca0d699-db0e-11ef-adb8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：甚哉秦之無道也，殺其父而劫其子；楚之不競也，忍其父而婚其讎！烏呼，楚之君誠得其道，臣誠得其人，秦雖強，烏得陵之哉！善乎荀卿論之曰：「夫道，善用之則百里之地可以獨立，不善用之則楚六千里而爲讎人役。」故人主不務得道而廣有其勢，是其所以危也。","content_fanyi":"臣司马光说：秦国的无道实在太甚了，害死楚怀王，又威逼怀王的儿子顷襄王；楚国也太软弱不争气，忍下杀父之仇，竟与仇敌秦国通婚！唉，楚国国君如果真能遵行治国之道，臣子果真都是贤能之人，秦国虽然强大，又怎能欺凌楚国呢！荀卿评论得真好：“治国之道，善于运用，即使只有百里之地也可以独立；不善于运用，像楚国这样拥有六千里土地的国家也会被仇敌奴役。”所以君主不致力于求道，反而一味扩张自己的权势，这正是他危险的原因。","content_jianti_auto":"臣光曰：甚哉秦之无道也，杀其父而劫其子；楚之不竞也，忍其父而婚其雠！乌呼，楚之君诚得其道，臣诚得其人，秦虽强，乌得陵之哉！善乎荀卿论之曰：「夫道，善用之则百里之地可以独立，不善用之则楚六千里而为雠人役。」故人主不务得道而广有其势，是其所以危也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":320,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 二十三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8ca0d68c-db0e-11ef-8f40-a0d3651f611f","year_int":-292},"tongjian_id":"8ca0d68c-db0e-11ef-8f40-a0d3651f611f"},"paragraph_order":7}],"page_size":7,"total_pages":17,"total_paragraphs":118},"profile":{"alias