{"data":{"current_mention_tongjian_id":"8c477471-db0e-11ef-bf7b-a0d3651f611f","current_paragraph_tongjian_id":"8c47746c-db0e-11ef-9d4e-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":5,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"分，扶問翻；下同。","note_content_jianti_auto":"分，扶问翻；下同。","note_type":"hu_note","start_index":27,"tongjian_id":"8be19ed3-db0e-11ef-b204-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"公","official_note":"公是周代五等爵位（公、侯、伯、子、男）中的最高等级，通常授予王室成员或功勋卓著者，此处用于说明名分中的等级体系。","official_rank":"未知","source_snippet":"公、侯、卿、大夫是也","start_index":48,"tongjian_id":"a2f74aa3-27da-43ab-a435-d6f5fb8f267b"},{"confidence":0.9,"official_category":"爵位","official_name":"侯","official_note":"侯是周代五等爵位之一，次于公，通常授予诸侯国君主，此处用于说明名分中的等级体系。","official_rank":"未知","source_snippet":"公、侯、卿、大夫是也","start_index":50,"tongjian_id":"b2e9884c-ef76-4717-84aa-711cce1fbb71"},{"confidence":0.85,"official_category":"中枢机构","official_name":"卿","official_note":"卿是古代高级官职，通常指中央政府中的高官，如六卿，此处用于说明名分中的等级体系。","official_rank":"未知","source_snippet":"公、侯、卿、大夫是也","start_index":52,"tongjian_id":"6e676a05-7a57-44cc-8817-9814972b7dc7"},{"confidence":0.85,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是古代官职，低于卿，通常指中央政府中的中级官员，此处用于说明名分中的等级体系。","official_rank":"未知","source_snippet":"公、侯、卿、大夫是也","start_index":54,"tongjian_id":"1ca6544d-f628-487f-8967-2673a8857d33"}],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8be19ed4-db0e-11ef-924a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：臣聞天子之職莫大於禮，禮莫大於分，分莫大於名。何謂禮？紀綱是也。何謂分？君、臣是也。何謂名？公、侯、卿、大夫是也。","content_fanyi":"臣司马光说：我听说天子的职责中没有比礼更重大的，礼之中没有比君臣之分更重大的，君臣之分之中没有比名号更重大的。什么是礼？就是纲纪法度。什么是分？就是君与臣的分别。什么是名？就是公、侯、卿、大夫这些爵位名号。","content_jianti_auto":"臣光曰：臣闻天子之职莫大于礼，礼莫大于分，分莫大于名。何谓礼？纪纲是也。何谓分？君、臣是也。何谓名？公、侯、卿、大夫是也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8be19ed2-db0e-11ef-a31c-a0d3651f611f","year_int":-403},"tongjian_id":"8be19ed2-db0e-11ef-a31c-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔安國","people_name_jianti_auto":"孔安国","start_index":11,"tongjian_id":"8bf1afb8-db0e-11ef-b793-a0d3651f611f"},{"people_name":"楚王","people_name_jianti_auto":"楚王","start_index":28,"tongjian_id":"8bf1afb9-db0e-11ef-b52b-a0d3651f611f"},{"people_name":"鄭伯","people_name_jianti_auto":"郑伯","start_index":31,"tongjian_id":"8bf1afba-db0e-11ef-b42c-a0d3651f611f"},{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":39,"tongjian_id":"8bf1afbb-db0e-11ef-8391-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":53,"tongjian_id":"8bf1afbc-db0e-11ef-8d83-a0d3651f611f"},{"people_name":"祝穆","people_name_jianti_auto":"祝穆","start_index":67,"to