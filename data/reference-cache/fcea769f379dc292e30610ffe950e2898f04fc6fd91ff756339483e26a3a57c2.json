1ef-b592-a0d3651f611f"},{"place_name":"絳州","place_name_jianti_auto":"绛州","start_index":60,"tongjian_id":"8c438047-db0e-11ef-bc36-a0d3651f611f"},{"place_name":"龍門縣","place_name_jianti_auto":"龙门县","start_index":62,"tongjian_id":"8c438048-db0e-11ef-80d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，汾陰縣屬河東郡。皮氏縣，故耿國，晉獻公以封趙夙者也，亦屬河東郡。括地志：汾陰故城，在蒲州汾陰縣北九里，皮氏故城，在絳州龍門縣西百八十步。","note_content_jianti_auto":"班志，汾阴县属河东郡。皮氏县，故耿国，晋献公以封赵夙者也，亦属河东郡。括地志：汾阴故城，在蒲州汾阴县北九里，皮氏故城，在绛州龙门县西百八十步。","note_type":"hu_note","start_index":15,"tongjian_id":"8c43803a-db0e-11ef-88de-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"皮氏","place_name_jianti_auto":"皮氏","place_note":"山西河津縣西二里","resolved_place_entity_id":5053,"start_index":12,"tongjian_id":"8c43804f-db0e-11ef-b2fe-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"1秦伐魏，渡河，取汾陰、皮氏，拔焦。","content_fanyi":"秦军进攻魏国，渡过黄河，夺取汾阴、皮氏两城，进而攻克焦邑。","content_jianti_auto":"1秦伐魏，渡河，取汾阴、皮氏，拔焦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":201,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c438039-db0e-11ef-ba20-a0d3651f611f","year_int":-329},"tongjian_id":"8c438039-db0e-11ef-ba20-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"皮氏","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":9,"tongjian_id":"9706a62d-db0e-11ef-a6d1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"皮氏縣","place_name_jianti_auto":"皮氏县","start_index":0,"tongjian_id":"9706a62e-db0e-11ef-8ba8-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":5,"tongjian_id":"9706a62f-db0e-11ef-aa99-a0d3651f611f"},{"place_name":"絳州","place_name_jianti_auto":"绛州","start_index":16,"tongjian_id":"9706a630-db0e-11ef-8d35-a0d3651f611f"},{"place_name":"龍門縣","place_name_jianti_auto":"龙门县","start_index":18,"tongjian_id":"9706a631-db0e-11ef-a761-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"皮氏縣，屬河東郡。賢曰：故城在今絳州龍門縣西。長，知兩翻。","note_content_jianti_auto":"皮氏县，属河东郡。贤曰：故城在今绛州龙门县西。长，知两翻。","note_type":"hu_note","start_index":20,"tongjian_id":"9706a62c-db0e-11ef-8df6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"安丘縣","place_name_jianti_auto":"安丘县","start_index":0,"tongjian_id":"9706a635-db0e-11ef-8f14-a0d3651f611f"},{"place_name":"北海郡","place_name_jianti_auto":"北海郡","start_index":5,"tongjian_id":"9706a636-db0e-11ef-ae2f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"安丘縣，屬北海郡。","note_content_jianti_auto":"安丘县，属北海郡。","note_type":"hu_note","start_index":90,"tongjian_id":"9706a634-db0e-11ef-8edf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"岐","people_name_jianti_auto":"岐","start_index":6,"tongjian_id":"9706a638-db0e-11ef-9a7d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"今孟子古註，岐所註也，其發題辭亦敍逃難之事。","note_content_jianti_auto":"今孟子古注，岐所注也，其发题辞亦敍逃难之事。","note_type":"hu_note","start_index":113,"tongjian_id":"9706a637-db0e-11ef-8ac3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"皮氏","place_name_jianti_auto":"皮氏","resolved_place_entity_id":5053,"start_index":10,"tongjian_id":"970729e3-db0e-11ef-8b4c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"左悺兄勝爲河東太守，皮氏長京兆趙岐恥之，卽日棄官西歸。唐衡兄玹爲京兆尹，素與岐有隙，收岐家屬宗親，陷以重法，盡殺之。岐逃難四方，靡所不歷，自匿姓名，賣餅北海市中；安丘孫嵩見而異之，載與俱歸，藏於複壁中。及諸唐死，遇赦，乃敢出。","content_fanyi":"左悺的兄长左胜担任河东郡太守，皮氏县长京兆人赵岐把在他手下任职视为耻辱，当天就弃官向西归去。唐衡的兄长唐玹任京兆尹，向来与赵岐有仇怨，于是收捕赵岐的家属宗亲，诬陷他们触犯重法，全部杀害。赵岐四处逃难，没有哪里不曾到过，隐姓埋名，在北海郡的街市上卖饼为生；安丘县人孙嵩见到他，觉得他与众不同，便让他和自己同车回家，将他藏在夹墙当中。待到唐衡兄弟死后，遇上大赦，才敢出来。","content_jianti_auto":"左悺兄胜为河东太守，皮氏长京兆赵岐耻之，即日弃官西归。唐衡兄玹为京兆尹，素与岐有隙，收岐家属宗亲，陷以重法，尽杀之。岐逃难四方，靡所不历，自匿姓名，卖饼北海市中；安丘孙嵩见而异之，载与俱归，藏于复壁中。及诸唐死，遇赦，乃敢出。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4626,"path":"资治通鉴 : 卷第五十四 (漢紀四十六) / 孝桓皇帝上之下 / 三年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"9706a62b-db0e-11ef-9d88-a0d3651f611f","year_int":160},"tongjian_id":"9706a62b-db0e-11ef-9d88-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"皮氏","resolved_profile":{"entity_id":5053,"entry_list_str":"皮氏","intro":"战国魏邑，秦置县，属河东郡，县治在今山西河津市西。西汉置铁官。","lat_max":35.65,"lat_min":35.55,"lon_max":110.75,"lon_min":110.65,"modern_location":"山西省河津市西部汾河与黄河交汇地带","seat":"今山西河津市阳村乡太阳村东南","show_map":true,"standard_name":"皮氏县","type_code":"settlement"}},"message":"success","success":true}