xtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓景侯","people_name_jianti_auto":"韩景侯","start_index":25,"tongjian_id":"8d4dada6-db0e-11ef-af47-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","start_index":0,"tongjian_id":"8d4dada7-db0e-11ef-a29b-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","place_note":"府阳翟，河南禹州","start_index":6,"tongjian_id":"8d4dada8-db0e-11ef-a697-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":10,"tongjian_id":"8d4dada9-db0e-11ef-a0bc-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":14,"tongjian_id":"8d4dadaa-db0e-11ef-8a71-a0d3651f611f"},{"place_name":"平陽","place_name_jianti_auto":"平阳","start_index":16,"tongjian_id":"8d4dadab-db0e-11ef-8d6d-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":20,"tongjian_id":"8d4dadac-db0e-11ef-b748-a0d3651f611f"},{"place_name":"新鄭","place_name_jianti_auto":"新郑","start_index":22,"tongjian_id":"8d4dadad-db0e-11ef-ab67-a0d3651f611f"},{"place_name":"新鄭","place_name_jianti_auto":"新郑","start_index":30,"tongjian_id":"8d4dadae-db0e-11ef-accc-a0d3651f611f"},{"place_name":"陽翟","place_name_jianti_auto":"阳翟","start_index":34,"tongjian_id":"8d4dadaf-db0e-11ef-b4b0-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":37,"tongjian_id":"8d4dadb0-db0e-11ef-8ac0-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","place_note":"河南新郑","start_index":39,"tongjian_id":"8d4dadb1-db0e-11ef-a4fb-a0d3651f611f"},{"place_name":"陽翟縣","place_name_jianti_auto":"阳翟县","start_index":43,"tongjian_id":"8d4dadb2-db0e-11ef-b09b-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":47,"tongjian_id":"8d4dadb3-db0e-11ef-9262-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韓至是而亡。潁川郡，韓地也。韓自平陽徙都河南新鄭；韓景侯又自新鄭徙都陽翟。秦滅韓，遂以陽翟縣爲潁川郡治所。","note_content_jianti_auto":"韩至是而亡。颍川郡，韩地也。韩自平阳徙都河南新郑；韩景侯又自新郑徙都阳翟。秦灭韩，遂以阳翟县为颍川郡治所。","note_type":"hu_note","start_index":20,"tongjian_id":"8d4dada5-db0e-11ef-b903-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","place_note":"府阳翟，河南禹州","resolved_place_entity_id":910,"start_index":16,"tongjian_id":"8d4dadb7-db0e-11ef-b270-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/何韩同姓","excerpts":[{"context_after":"，子孙散居陈、楚，江、淮间，以韩为何，随声变为何氏，然不...","context_before":"...名世《姓氏书辩证》云：“何氏出自姬姓，食采韩原，为韩氏。","source_end_index":97,"source_paragraph_tongjian_id":"c1521559-9805-44fe-bc67-bcecf6735818","source_start_index":90,"source_text":"韩王建为秦所灭"}],"path":"三笔/卷五/何韩同姓","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"[《战国策》：游滕谓向寿，公何不以秦为韩求颍川于楚？此韩...","context_before":"...，后居阳翟]。春秋时，郑栎邑也。战国属韩，自新郑徙都此。","source_end_index":58,"source_paragraph_tongjian_id":"a5ee382e-ea53-5b6a-90c4-07e4ea8938cc","source_start_index":45,"source_text":"秦始皇十七年灭韩，置颍川郡"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1內史勝滅韓，虜韓王安，以其地置潁川郡。","content_fanyi":"内史胜灭亡韩国，俘虏了韩王安，将韩国故地设置为颍川郡。","content_jianti_auto":"1内史胜灭韩，虏韩王安，以其地置颍川郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":518,"number":1,"path":"资治通鉴 : 卷第六 (秦紀一) / 始皇帝上 / 十七年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d4dad98-db0e-11ef-9831-a0d3651f611f","year_int":-230},"tongjian_id":"8d4dad98-db0e-11ef-9831-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"潁川郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉羲叟","people_name_jianti_auto":"刘羲叟","start_index":20,"tongjian_id":"8e749660-db0e-11ef-ac72-a0d3651f611f"},{"people_name":"彭越","people_name_jianti_auto":"彭越","start_index":68,"tongjian_id":"8e749666-db0e-11ef-9627-a0d3651f611f"},{"people_name":"恢","people_name_jianti_auto":"恢","start_index":81,"tongjian_id":"8e749667-db0e-11ef-bd42-a0d3651f611f"},{"people_name":"梁王","people_name_jianti_auto":"梁王","start_index":83,"tongjian_id":"8e749668-db0e-11ef-b1aa-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：漢書·諸侯王表作「三月丙午」。按劉羲叟長曆：三月丙辰朔，無丙午；今從史記·年表。今按史記·年表作「二月丙午」，但通鑑先書「三月夷彭越三族」，方於此書「立子恢爲梁王」，則又是三月丙午。","note_content_jianti_auto":"考异曰：汉书·诸侯王表作「三月丙午」。按刘羲叟长历：三月丙辰朔，无丙午；今从史记·年表。今按史记·年表作「二月丙午」，但通鉴先书「三月夷彭越三族」，方于此书「立子恢为梁王」，则又是三月丙午。","note_type":"hu_note","start_index":12,"tongjian_id":"8e74965f-db0e-11ef-a491-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","place_note":"河南禹州","resolved_place_entity_id":910,"start_index":33,"tongjian_id":"8e749672-db0e-11ef-9e66-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/再书博古图","excerpts":[{"context_after":"，是为定陶共王。”予案恢正封梁王，后徙赵。所谓定陶共王者...","context_before":"...陶鼎曰：“汉初有天下，以定陶之地封彭越为梁王，越既叛命，","source_end_index":1325,"source_paragraph_tongjian_id":"acc5e29d-09fb-44de-a8a1-e3cb78c90b1f","source_start_index":1317,"source_text":"乃以封高祖之子恢"}],"path":"三笔/卷十三/再书博古图","source_name":"容斋随笔"}],"class_tags":[],"content":"7丙午，立皇子恢爲梁王；丙寅，立皇子友爲淮陽王。罷東郡，頗益梁；罷潁川郡，頗益淮陽。","content_fanyi":"三月丙午（三月无丙午日，疑误），高帝将皇子刘恢立为梁王；十一日丙寅，将皇子刘友立为淮阳王。废除东郡，使梁国得到较大扩充；废除颍川郡，使淮阳国得到较大扩充。","content_jianti_auto":"7丙午，立皇子恢为梁王；丙寅，立皇子友为淮阳王。罢东郡，颇益梁；罢颍川郡，颇益淮阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":916,"number":7,"path":"资治通鉴 : 卷第十二 (漢紀四) / 太祖高皇帝下 / 十一年 / 第 10 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":9,"tongjian_id":"8e74965e-db0e-11ef-ac66-a0d3651f611f","year_int":-196},"tongjian_id":"8e74965e-db0e-11ef-ac66-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"潁川郡","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"93967f2c-db0e-11ef-a26b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"父城","place_name_jianti_auto":"父城","start_index":3,"tongjian_id":"93967f2d-db0e-11ef-b391-a0d3651f611f"},{"place_name":"許州","place_name_jianti_auto":"许州","start_index":13,"tongjian_id":"93967f2e-db0e-11ef-b526-a0d3651f611f"},{"place_name":"葉縣","place_name_jianti_auto":"叶县","start_index":15,"tongjian_id":"93967f2f-db0e-11ef-86e2-a0d3651f611f"},{"place_name":"汝州","place_name_jianti_auto":"汝州","start_index":20,"tongjian_id":"93967f30-db0e-11ef-96bc-a0d3651f611f"},{"place_name":"郟城縣","place_name_jianti_auto":"郏城县","start_index":22,"tongjian_id":"93967f31-db0e-11ef-acd7-a0d3651f611f"},{"place_name":"父城","place_name_jianti_auto":"父城","start_index":27,"tongjian_id":"93967f32-db0e-11ef-81d7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：父城，縣名，故城在今許州葉縣東北。汝州郟城縣亦有父城。復，扶又翻；下同。","note_content_jianti_auto":"贤曰：父城，县名，故城在今许州叶县东北。汝州郏城县亦有父城。复，扶又翻；下同。","note_type":"hu_note","start_index":14,"tongjian_id":"93967f2b-db0e-11ef-8ebe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"93967f34-db0e-11ef-aef6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"巾車","place_name_jianti_auto":"巾车","start_index":3,"tongjian_id":"93967f35-db0e-11ef-b700-a0d3651f611f"},{"place_name":"父城","place_name_jianti_auto":"父城","start_index":11,"tongjian_id":"93967f36-db0e-11ef-b931-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：巾車，鄕名也，在父城界。","note_content_jianti_auto":"贤曰：巾车，鄕名也，在父城界。","note_type":"hu_note","start_index":20,"tongjian_id":"93967f33-db0e-11ef-846e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","resolved_place_entity_id":910,"start_index":20,"tongjian_id":"93967f3f-db0e-11ef-b7da-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、汝州（卷五十一）","excerpts":[{"context_after":"晋亦为父城县，属襄城郡。后废。司马彪曰：父城西南即巾车乡...","context_before":"...与蒙恬会城父，楚人随而破之，即此。汉置父城县，属颍川郡。","source_end_index":156,"source_paragraph_tongjian_id":"473adffd-65ed-58b1-a065-f9635f78c9ed","source_start_index":136,"source_text":"光武攻父城，不下，屯巾车乡，获冯异处也。"}],"path":"河南方舆纪要/九、汝州（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"9劉秀復徇潁川，攻父城不下，屯兵巾車鄕。潁川郡掾馮異監五縣，爲漢兵所獲。異曰：「異有老母在父城，願歸，據五城以效功報德！」秀許之。異歸，謂父城長苗萌曰：「諸將多暴橫，獨劉將軍所到不虜略，觀其言語舉止，非庸人也！」遂與萌率五縣以降。","content_fanyi":"刘秀再次向颍川一带进军，进攻父城县未能攻克，屯驻在巾车乡。颍川郡掾冯异督察五个县，被汉军生擒。冯异说：“我有老母在父城县，希望回去，献上五座县城，以报效功绩和恩德！”刘秀答应了他的请求。冯异回去后，对父城县长苗萌说：“刘玄麾下的各位将领大多凶暴蛮横，只有刘秀将军所到之处不掳掠百姓和财物。观察他的言谈举止，并非平庸之人！”于是冯异与苗萌一同率领五县官民投降刘秀。","content_jianti_auto":"9刘秀复徇颍川，攻父城不下，屯兵巾车鄕。颍川郡掾冯异监五县，为汉兵所获。异曰：「异有老母在父城，愿归，据五城以效功报德！」秀许之。异归，谓父城长苗萌曰：「诸将多暴横，独刘将军所到不虏略，观其言语举止，非庸人也！」遂与萌率五县以降。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2962,"number":9,"path":"资治通鉴 : 卷第三十九 (漢紀三十一) / 淮陽王 / 更始元年 / 第 12 段","reading_annotation_sources":[],"start_index":11,"tongjian_id":"93967f2a-db0e-11ef-b887-a0d3651f611f","year_int":23},"tongjian_id":"93967f2a-db0e-11ef-b887-a0d3651f611f"},"paragraph_order":3}],"page_size":10,"total_pages":1,"total_paragraphs":3},"place_name":"潁川郡"},"message":"success","success":true}