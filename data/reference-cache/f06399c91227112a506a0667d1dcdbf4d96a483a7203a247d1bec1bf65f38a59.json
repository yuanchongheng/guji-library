d66fb2647"}],"ExtRef_Children_places":[{"place_name":"九原","place_name_jianti_auto":"九原","place_note":"內蒙包頭","resolved_place_entity_id":2070,"start_index":9,"tongjian_id":"8d74f6c2-db0e-11ef-b11f-a0d3651f611f"},{"place_name":"雲陽","place_name_jianti_auto":"云阳","place_note":"陝西淳化","resolved_place_entity_id":1109,"start_index":13,"tongjian_id":"8d74f6c3-db0e-11ef-8d35-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷三十九）","excerpts":[{"context_after":"张仪之以秦胁燕也，曰：秦下甲云中、九原，驱赵而攻燕。唐范...","context_before":"...胜，莫若陕西，赵主父攘地至云中、九原，遂欲直南袭秦咸阳。","source_end_index":201,"source_paragraph_tongjian_id":"39bdc05b-cc10-5386-b121-93a7fe656d11","source_start_index":173,"source_text":"秦始皇巡北边，从上郡入，既又使蒙恬除直道，自九原抵云阳。"}],"path":"山西方舆纪要/〇、封域山川险要（卷三十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"汉亦为云阳县，属左冯翊。后汉建武二年，赤眉自陇坻大略而东...","context_before":"○云阳城[县西北五三十里。秦县。","source_end_index":47,"source_paragraph_tongjian_id":"d5b87cce-7692-53aa-a6e8-965ea9677926","source_start_index":16,"source_text":"始皇二十五年，使蒙恬通直道，自九原至云阳。既而徙五万家于云阳。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十、榆林镇（卷六十一）","excerpts":[{"context_after":"又三十七年，东巡道死，行从井陉抵九原，从直道至咸阳，是也...","context_before":"...黄河百三十里。是也。自古为戎狄地。战国属赵。秦属九原郡。","source_end_index":85,"source_paragraph_tongjian_id":"9dc9f2c4-6339-5b97-8571-9ee63a6df623","source_start_index":56,"source_text":"始皇三十五年，使蒙恬通道，自九原抵甘泉，堑山堙谷千八百里。"}],"path":"陕西方舆纪要/十、榆林镇（卷六十一）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"1使蒙恬除直道，道九原，抵雲陽。塹山堙谷，千八百里；數年不就。","content_fanyi":"秦始皇派蒙恬开通直道，从九原修到云阳。凿开山岭，填塞峡谷，全长一千八百里，历时数年仍未完工。","content_jianti_auto":"1使蒙恬除直道，道九原，抵云阳。堑山堙谷，千八百里；数年不就。","dtjl_paragraph_links":[],"dtjl_references":[],"id":574,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d74f6ba-db0e-11ef-9ca6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8d754630-db0e-11ef-b82b-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"8d754631-db0e-11ef-96a3-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「庭」作「廷」；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「庭」作「廷」；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8d75462f-db0e-11ef-9ffd-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":15,"tongjian_id":"8d75180c-db0e-11ef-ad56-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8d754633-db0e-11ef-938f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"咸陽","place_name_jianti_auto":"咸阳","start_index":12,"tongjian_id":"8d754634-db0e-11ef-9553-a0d3651f611f"},{"place_name":"阿房","place_name_jianti_auto":"阿房","start_index":18,"tongjian_id":"8d754635-db0e-11ef-bc76-a0d3651f611f"},{"place_name":"阿房","place_name_jianti_auto":"阿房","start_index":37,"tongjian_id":"8d754636-db0e-11ef-a61b-a0d3651f611f"},{"place_name":"阿","place_name_jianti_auto":"阿","start_index":51,"tongjian_id":"8d754637-db0e-11ef-abfb-a0d3651f611f"},{"place_name":"阿房","place_name_jianti_auto":"阿房","start_index":59,"tongjian_id":"8d754638-db0e-11ef-9a32-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":66,"tongjian_id":"8d754639-db0e-11ef-86e1-a0d3651f611f"},{"place_name":"阿房宮","place_name_jianti_auto":"阿房宫","start_index":67,"tongjian_id":"8d75463a-db0e-11ef-a2d1-a0d3651f611f"},{"place_name":"阿城","place_name_jianti_auto":"阿城","start_index":72,"tongjian_id":"8d75463b-db0e-11ef-a29c-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":76,"tongjian_id":"8d75463c-db0e-11ef-9543-a0d3651f611f"},{"place_name":"長安縣","place_name_jianti_auto":"长安县","start_index":78,"tongjian_id":"8d75463d-db0e-11ef-99b2-a0d3651f611f"},{"place_name":"上林宛","place_name_jianti_auto":"上林宛","start_index":96,"tongjian_id":"8d75463e-db0e-11ef-80f0-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":101,"tongjian_id":"8d75463f-db0e-11ef-983f-a0d3651f611f"},{"place_name":"阿房宮","place_name_jianti_auto":"阿房宫","start_index":110,"tongjian_id":"8d754640-db0e-11ef-8d6e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：阿，近也；以其去咸陽近，且號阿房。索隱曰：此以形名宮也；言其宮曰四阿房旁廣也。三輔黃圖曰：作宮阿基旁，天下謂之阿房。括地志：秦阿房宮亦曰阿城，在雍州長安縣西一十四里。史記正義曰：按宮在上林宛中；雍州郭城西南面，卽阿房宮城東南面也。房，白郞翻。","note_content_jianti_auto":"师古曰：阿，近也；以其去咸阳近，且号阿房。索隐曰：此以形名宫也；言其宫曰四阿房旁广也。三辅黄图曰：作宫阿基旁，天下谓之阿房。括地志：秦阿房宫亦曰阿城，在雍州长安县西一十四里。史记正义曰：按宫在上林宛中；雍州郭城西南面，即阿房宫城东南面也。房，白郞翻。","note_type":"hu_note","start_index":36,"tongjian_id":"8d754632-db0e-11ef-a4f2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","start_index":0,"tongjian_id":"8d754646-db0e-11ef-a8a5-a0d3651f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","start_index":3,"tongjian_id":"8d754647-db0e-11ef-acad-a0d3651f611f"},{"place_name":"北山","place_name_jianti_auto":"北山","place_note":"九嵕山","start_index":6,"tongjian_id":"8d754648-db0e-11ef-819c-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":10,"tongjian_id":"8d754649-db0e-11ef-945a-a0d3651f611f"},{"place_name":"巀嶭","place_name_jianti_auto":"巀嶭","start_index":15,"tongjian_id":"8d75464a-db0e-11ef-852f-a0d3651f611f"},{"place_name":"九嵕","place_name_jianti_auto":"九嵕","start_index":18,"tongjian_id":"8d75464b-db0e-11ef-a5fb-a0d3651f611f"},{"place_name":"北山","place_name_jianti_auto":"北山","start_index":21,"tongjian_id":"8d75464c-db0e-11ef-b67d-a0d3651f611f"},{"place_name":"終南","place_name_jianti_auto":"终南","start_index":25,"tongjian_id":"8d75464d-db0e-11ef-b4de-a0d3651f611f"},{"place_name":"太白","place_name_jianti_auto":"太白","start_index":28,"tongjian_id":"8d75464e-db0e-11ef-aad9-a0d3651f611f"},{"place_name":"商嶺","place_name_jianti_auto":"商岭","start_index":33,"tongjian_id":"8d75464f-db0e-11ef-94e0-a0d3651f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","start_index":36,"tongjian_id":"8d754650-db0e-11ef-a0e8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"關中有南山、北山：自甘泉連延至巀嶭、九嵕爲北山；自終南、太白連延至商嶺爲南山。","note_content_jianti_auto":"关中有南山、北山：自甘泉连延至巀嶭、九嵕为北山；自终南、太白连延至商岭为南山。","note_type":"hu_note","start_index":77,"tongjian_id":"8d754645-db0e-11ef-b05b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"天官書曰：天極後十七星，絕漢抵營室，曰閣道。北辰爲天極。營室二星，天子之宮也。","note_content_jianti_auto":"天官书曰：天极后十七星，绝汉抵营室，曰阁道。北辰为天极。营室二星，天子之宫也。","note_type":"hu_note","start_index":115,"tongjian_id":"8d754651-db0e-11ef-b541-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8d754655-db0e-11ef-89b5-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8d754656-db0e-11ef-9719-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":28,"tongjian_id":"8d754657-db0e-11ef-9573-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「十」下有「餘」字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：十二行本「十」下有「余」字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8d754654-db0e-11ef-b441-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":123,"tongjian_id":"8d754653-db0e-11ef-b19f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：餘刑見於市朝；宮刑，一百日隱於蔭室養之乃可，故曰隱宮，下蠶室是也。徒刑者，有罪旣加刑，復罰作之也。","note_content_jianti_auto":"史记正义曰：余刑见于市朝；宫刑，一百日隐于荫室养之乃可，故曰隐宫，下蚕室是也。徒刑者，有罪既加刑，复罚作之也。","note_type":"hu_note","start_index":126,"tongjian_id":"8d754658-db0e-11ef-b0ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"康","people_name_jianti_auto":"康","start_index":0,"tongjian_id":"8d75465b-db0e-11ef-9871-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"康曰：寫，四夜切；舍車解馬爲寫，或作「卸」。余謂此非舍車解馬之「卸」，卽前寫放宮室之「寫」，讀如字。","note_content_jianti_auto":"康曰：写，四夜切；舍车解马为写，或作「卸」。余谓此非舍车解马之「卸」，即前写放宫室之「写」，读如字。","note_type":"hu_note","start_index":150,"tongjian_id":"8d75465a-db0e-11ef-8b7c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"函關","place_name_jianti_auto":"函关","start_index":19,"tongjian_id":"8d75465d-db0e-11ef-ba98-a0d3651f611f"},{"place_name":"弘農郡","place_name_jianti_auto":"弘农郡","start_index":21,"tongjian_id":"8d75465e-db0e-11ef-b559-a0d3651f611f"},{"place_name":"靈寶縣","place_name_jianti_auto":"灵宝县","start_index":24,"tongjian_id":"8d75465f-db0e-11ef-a87d-a0d3651f611f"},{"place_name":"隴關","place_name_jianti_auto":"陇关","start_index":31,"tongjian_id":"8d754660-db0e-11ef-b0b4-a0d3651f611f"},{"place_name":"汧陽郡","place_name_jianti_auto":"汧阳郡","start_index":33,"tongjian_id":"8d754661-db0e-11ef-b7ca-a0d3651f611f"},{"place_name":"汧源縣","place_name_jianti_auto":"汧源县","start_index":36,"tongjian_id":"8d754662-db0e-11ef-b44c-a0d3651f611f"},{"place_name":"關","place_name_jianti_auto":"关","start_index":48,"tongjian_id":"8d754663-db0e-11ef-9969-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"或曰：「皆至」當屬上句。關中記云：東自函關弘農郡靈寶縣界，西至隴關汧陽郡汧源縣界，二關之間，謂之關中，東西千餘里。","note_content_jianti_auto":"或曰：「皆至」当属上句。关中记云：东自函关弘农郡灵宝县界，西至陇关汧阳郡汧源县界，二关之间，谓之关中，东西千余里。","note_type":"hu_note","start_index":160,"tongjian_id":"8d75465c-db0e-11ef-8e62-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d754666-db0e-11ef-afb1-a0d3651f611f"},{"people_name":"始皇","people_name_jianti_auto":"始皇","start_index":9,"tongjian_id":"8d754667-db0e-11ef-b7ef-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"東海郡","place_name_jianti_auto":"东海郡","start_index":3,"tongjian_id":"8d754668-db0e-11ef-ae2b-a0d3651f611f"},{"place_name":"朐縣","place_name_jianti_auto":"朐县","start_index":6,"tongjian_id":"8d754669-db0e-11ef-902d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：東海郡朐縣，始皇立石海上，以爲東門闕。朐，音劬。","note_content_jianti_auto":"班志：东海郡朐县，始皇立石海上，以为东门阙。朐，音劬。","note_type":"hu_note","start_index":183,"tongjian_id":"8d754665-db0e-11ef-8c27-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，方目翻，除也。不事者，不供征役之事。","note_content_jianti_auto":"复，方目翻，除也。不事者，不供征役之事。","note_type":"hu_note","start_index":204,"tongjian_id":"8d75466b-db0e-11ef-9aa4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":1,"tongjian_id":"8d75466c-db0e-11ef-ac92-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d75180b-db0e-11ef-b0d2-a0d3651f611f","pinyin":"qú","source_anchor_text":"石東海上朐界中以為","source_key":"baiyang_epub","start_index":173,"text":"朐","tongjian_id":"5827388d-a141-5190-b182-3869eb25fc09"}],"ExtRef_Children_places":[{"place_name":"咸陽","place_name_jianti_auto":"咸阳","resolved_place_entity_id":382,"start_index":5,"tongjian_id":"8d75466d-db0e-11ef-b0ba-a0d3651f611f"},{"place_name":"渭","place_name_jianti_auto":"渭","resolved_place_entity_id":399,"start_index":22,"tongjian_id":"8d75466e-db0e-11ef-b28b-a0d3651f611f"},{"place_name":"上林苑","place_name_jianti_auto":"上林苑","resolved_place_entity_id":1226,"start_index":24,"tongjian_id":"8d75466f-db0e-11ef-a172-a0d3651f611f"},{"place_name":"阿房","place_name_jianti_auto":"阿房","resolved_place_entity_id":2755,"start_index":33,"tongjian_id":"8d754670-db0e-11ef-9eea-a0d3651f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","place_note":"秦岭","resolved_place_entity_id":663,"start_index":74,"tongjian_id":"8d754671-db0e-11ef-9dbf-a0d3651f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","resolved_place_entity_id":663,"start_index":78,"tongjian_id":"8d754672-db0e-11ef-b761-a0d3651f611f"},{"place_name":"阿房","place_name_jianti_auto":"阿房","resolved_place_entity_id":2755,"start_index":91,"tongjian_id":"8d754673-db0e-11ef-8ae9-a0