_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0bb-db0e-11ef-b80c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：釋，廢也。樂成，謂已成之業，人情所樂也。樂，音洛。","note_content_jianti_auto":"师古曰：释，废也。乐成，谓已成之业，人情所乐也。乐，音洛。","note_type":"hu_note","start_index":260,"tongjian_id":"918df0ba-db0e-11ef-9c05-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"遵先帝之法制，揚先帝之功烈也。","note_content_jianti_auto":"遵先帝之法制，扬先帝之功烈也。","note_type":"hu_note","start_index":278,"tongjian_id":"918df0bc-db0e-11ef-b4ac-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0be-db0e-11ef-adf2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：大雅·文王之詩也。無念，念也。聿，述也。","note_content_jianti_auto":"师古曰：大雅·文王之诗也。无念，念也。聿，述也。","note_type":"hu_note","start_index":303,"tongjian_id":"918df0bd-db0e-11ef-95fe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"衡守詩學，此必詩傳之言。傳，直戀翻。好，呼到翻。惡，烏路翻。","note_content_jianti_auto":"衡守诗学，此必诗传之言。传，直恋翻。好，呼到翻。恶，乌路翻。","note_type":"hu_note","start_index":329,"tongjian_id":"918df0c0-db0e-11ef-b953-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":6,"tongjian_id":"918df0c4-db0e-11ef-9399-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"治，直之翻。師古曰：強，勉也，音其兩翻。","note_content_jianti_auto":"治，直之翻。师古曰：强，勉也，音其两翻。","note_type":"hu_note","start_index":348,"tongjian_id":"918df0c3-db0e-11ef-9cc4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0c8-db0e-11ef-bc40-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：湛，讀曰沈。忘，巫放翻。","note_content_jianti_auto":"师古曰：湛，读曰沈。忘，巫放翻。","note_type":"hu_note","start_index":409,"tongjian_id":"918df0c7-db0e-11ef-bc6c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"太子少傅","official_note":"太子少傅是负责教导太子的官员，属于东宫官属，在汉代通常由德高望重的学者担任，此处匡衡以太子少傅身份上疏进谏，体现了其作为太子教育者的职责和对国家政策的关注。","official_rank":"未知","source_snippet":"太子少傅匡衡上疏曰","start_index":45,"tongjian_id":"babd1a23-8245-46b8-9c94-6f9c7a9adc91"}],"ExtRef_Children_people":[{"link_birth_year":-91,"link_death_year":-48,"link_td_description":"汉宣帝刘询，原名刘病已，字次卿，即位九年后改名询，汉朝皇帝（前74年9月10日－前48年1月10日在位），其正式谥号为「孝宣皇帝」，后世省略「孝」字称「汉宣帝」。汉武帝的曾孙，戾太子刘据的长孙，史皇孙刘进的长子，生母为王翁须。","link_td_id":"Q10000317","link_td_number_id":99982,"people_name":"宣帝","people_name_jianti_auto":"宣帝","people_xingming":"刘询","start_index":11,"tongjian_id":"918df0ca-db0e-11ef-9fb1-a0d3651f611f"},{"link_death_year":-2,"link_td_description":"傅昭仪，为西汉汉元帝之妃、汉哀帝祖母。谥号孝元傅皇后。","link_td_id":"Q10002350","link_td_number_id":1184580,"people_name":"傅昭儀","people_name_jianti_auto":"傅昭仪","people_xingming":"傅昭仪","start_index":32,"tongjian_id":"918df0cb-db0e-11ef-8101-a0d3651f611f"},{"link_death_year":-23,"link_td_description":"定陶共王刘康，汉元帝次子，母傅昭仪。庶子刘欣即位后追尊共皇。","link_td_id":"Q10004634","link_td_number_id":1010863,"people_name":"濟陽王","people_name_jianti_auto":"济阳王","people_xingming":"刘康","start_index":37,"tongjian_id":"918df0cc-db0e-11ef-8b15-a0d3651f611f"},{"link_death_year":-23,"link_td_description":"定陶共王刘康，汉元帝次子，母傅昭仪。庶子刘欣即位后追尊共皇。","link_td_id":"Q10004634","link_td_number_id":1010863,"people_name":"康","people_name_jianti_auto":"康","people_xingming":"刘康","start_index":40,"tongjian_id":"918df0cd-db0e-11ef-9509-a0d3651f611f"},{"link_td_description":"匡衡，字稚圭，东海郡承县（今天的山东省兰陵县西南、枣庄一带）人。西汉经学家，元帝时位至丞相。","link_td_id":"Q10009100","link_td_number_id":522878,"people_name":"匡衡","people_name_jianti_auto":"匡衡","people_xingming":"匡衡","start_index":56,"tongjian_id":"918df0ce-db0e-11ef-bc98-a0d3651f611f"},{"link_birth_year":-1055,"link_death_year":-1020,"link_td_description":"周成王，姬姓，名誦，西周第二代天子，周武王之子。","link_td_id":"Q10000237","link_td_number_id":138310,"people_name":"成王","people_name_jianti_auto":"成王","people_xingming":"姬诵","start_index":119,"tongjian_id":"918df0cf-db0e-11ef-b431-a0d3651f611f","wl_zhushi":"[姬诵]"},{"link_birth_year":-1112,"link_death_year":-1050,"link_td_description":"周文王，姬姓，周氏，名昌，又称西伯昌。中国商朝末期诸侯国周国君主。后世视之为道统的传人之一。","link_td_id":"Q10000441","link_td_number_id":15568,"people_name":"文","people_name_jianti_auto":"文","people_xingming":"姬昌","start_index":127,"tongjian_id":"918df0d0-db0e-11ef-b5a4-a0d3651f611f","wl_zhushi":"[姬昌]"},{"link_birth_year":-1076,"link_death_year":-1043,"link_td_description":"周武王，姬姓，名发，谥武，又名为珷帝日丁。西周创建者，第一代天子，是西伯昌与太姒的嫡次子。","link_td_id":"Q10000452","link_td_number_id":3566,"people_name":"武","people_name_jianti_auto":"武","people_xingming":"姬发","start_index":129,"tongjian_id":"918df0d1-db0e-11ef-a43e-a0d3651f611f","wl_zhushi":"[姬发]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"918df09e-db0e-11ef-b402-a0d3651f611f","pinyin":"xīn","source_anchor_text":"是以上天歆享鬼神祐","source_key":"baiyang_epub","start_index":157,"text":"歆","tongjian_id":"b76b7771-6b91-52ed-9545-732874b8d702"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"918df09e-db0e-11ef-b402-a0d3651f611f","pinyin":"pī","source_anchor_text":"殆議者未丕揚先帝之","source_key":"baiyang_epub","start_index":194,"text":"丕","tongjian_id":"2b0a2fab-de8a-567b-a778-d1a19a690079"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"918df09e-db0e-11ef-b402-a0d3651f611f","pinyin":"yù","source_anchor_text":"無念爾祖聿脩厥德蓋","source_key":"baiyang_epub","start_index":297,"text":"聿","tongjian_id":"9d1ad9e6-ce4c-5e14-8690-7dd8295f91f4"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"918df09e-db0e-11ef-b402-a0d3651f611f","pinyin":"zhàn","source_anchor_text":"戒於無斷湛靜安舒者","source_key":"baiyang_epub","start_index":389,"text":"湛","tongjian_id":"be614cec-93c7-5f0a-9367-7e3c4c8fd76e"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"5上好儒術、文辭，頗改宣帝之政；言事者多進見，人人以爲得上意。又傅昭儀及子濟陽王康愛幸，逾於皇后、太子。太子少傅匡衡上疏曰：「臣聞治亂安危之機，在乎審所用心。蓋受命之王，務在創業垂統，傳之無窮；繼體之君，心存於承宣先王之德而褒大其功。昔者成王之嗣位，思述文、武之道以養其心，休烈盛美歸之二后，而不敢專其名，是以上天歆享，鬼神祐焉。陛下聖德天覆，子愛海內，然而陰陽未和、姦邪未禁者，殆議者未丕揚先帝之盛功，爭言制度不可用也，務變更之，所更或不可行而復復之，是以羣下更相是非，吏民無所信。臣竊恨國家釋樂成之業而虛爲此紛紛也！願陛下詳覽統業之事，留神於遵制揚功，以定羣下之心。詩·大雅曰：『無念爾祖，聿脩厥德，』蓋至德之本也。傳曰：『審好惡，理情性，而王道畢矣。』治性之道，必審己之所有餘而強其所不足，蓋聰明疏通者戒於太察，寡聞少見者戒於壅蔽，勇猛剛強者戒於太暴，仁愛溫良者戒於無斷，湛靜安舒者戒於後時，廣心浩大者戒於遺忘。必審己之所當戒而齊之以義，然後中和之化應，而巧僞之徒不敢比周而望進。唯陛下戒之，所以崇聖德也！","content_fanyi":"汉元帝喜好儒家学说和文章辞采，对宣帝时期的政令制度多有更改；上书议论政事的人大多被召见，人人都自以为合乎皇帝的心意。另外，傅昭仪和她所生的皇子济阳王刘康格外受到汉元帝宠爱，超过了皇后和皇太子刘骜。太子少傅匡衡上疏说：“我听说国家治乱安危的关键，在于君主能否审慎地用心。承受天命的开国之君，致力于开创基业并传给后世，直至无穷；继承基业的君主，则要用心继承和宣扬先王的德行，并褒扬光大先王的功业。从前周成王继承王位之后，追思周文王、周武王的治国之道来修养自己的心性，把盛美的功业和美好的声誉都归于文、武二王，而不敢独占美名；因此上天接受他的祭享，鬼神也都保佑他。陛下的圣德像天一样覆盖天下，像爱护子女一样爱护海内百姓；然而阴阳尚未调和、奸邪尚未禁绝，恐怕是因为议政的人未能大力宣扬先帝的盛大功业，反而争着说制度不可行，致力于更改制度，有的更改后行不通，又恢复原来的制度，因此群臣彼此争论是非，官吏和百姓无所信从。臣私下痛恨国家舍弃了众人乐于接受的成规，而去白白制造这些纷扰！希望陛下仔细考察先代传承帝业的大事，留心遵守先帝法度、弘扬先帝功业，以安定群臣之心。《诗经·大雅》说：‘思念你的先祖，继承发扬他们的德行’，这就是最高德行的根本。《诗传》说：‘审察好恶，调理性情，王道就完全实现了。’修养性情的方法，一定要看清自己的长处和不足，并努力加强不足之处。聪明通达的人要警惕对人过于苛察；见闻不广的人要警惕被蒙蔽；勇猛刚强的人要警惕过于粗暴；仁爱温和的人要警惕缺乏决断；沉静安闲的人要警惕迟疑而错失时机；心胸宽广的人要警惕疏忽遗漏。一定要看清自己应当戒除的缺点，用道义来匡正自己，然后才能保持中正平和，顺应变化，那些巧诈虚伪之徒才不敢结党营私、谋求进用。希望陛下对此加以警惕，这正是尊崇圣德的方法！”","content_jianti_auto":"5上好儒术、文辞，颇改宣帝之政；言事者多进见，人人以为得上意。又傅昭仪及子济阳王康爱幸，逾于皇后、太子。太子少傅匡衡上疏曰：「臣闻治乱安危之机，在乎审所用心。盖受命之王，务在创业垂统，传之无穷；继体之君，心存于承宣先王之德而褒大其功。昔者成王之嗣位，思述文、武之道以养其心，休烈盛美归之二后，而不敢专其名，是以上天歆享，鬼神祐焉。陛下圣德天覆，子爱海内，然而阴阳未和、奸邪未禁者，殆议者未丕扬先帝之盛功，争言制度不可用也，务变更之，所更或不可行而复复之，是以群下更相是非，吏民无所信。臣窃恨国家释乐成之业而虚为此纷纷也！愿陛下详览统业之事，留神于遵制扬功，以定群下之心。诗·大雅曰：『无念尔祖，聿修厥德，』盖至德之本也。传曰：『审好恶，理情性，而王道毕矣。』治性之道，必审己之所有余而强其所不足，盖聪明疏通者戒于太察，寡闻少见者戒于壅蔽，勇猛刚强者戒于太暴，仁爱温良者戒于无断，湛静安舒者戒于后时，广心浩大者戒于遗忘。必审己之所当戒而齐之以义，然后中和之化应，而巧伪之徒不敢比周而望进。唯陛下戒之，所以崇圣德也！","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"固已尽元帝之所短，而特不为矫枉之论，导之鸷击耳。夫可喻者...","context_before":"...奔越之祸豫为之防。夫岂不达于时变哉？以道豫立而变自消也。","source_end_index":187,"source_paragraph_tongjian_id":"f10898d4-bbff-4ae5-8736-c5ed630132db","source_start_index":151,"source_text":"且衡之言曰：“近忠正，远邪佞，寡闻少见者戒于壅蔽，仁爱温良者戒于无断。”"}],"title":"四 贡禹匡衡以学事君"}],"id":2269,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"918df09e-db0e-11ef-b402-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0d6-db0e-11ef-a8e1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：關雎美后妃之德，而爲國風之首。禮記·冠義曰：冠者，禮之始也。婚義曰：婚者，禮之本也。冠，古玩翻；下同。","note_content_jianti_auto":"师古曰：关雎美后妃之德，而为国风之首。礼记·冠义曰：冠者，礼之始也。婚义曰：婚者，礼之本也。冠，古玩翻；下同。","note_type":"hu_note","start_index":57,"tongjian_id":"918df0d5-db0e-11ef-86c1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0dc-db0e-11ef-a4e4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：適，讀曰嫡；下同。長，知兩翻。","note_content_jianti_auto":"师古曰：适，读曰嫡；下同。长，知两翻。","note_type":"hu_note","start_index":73,"tongjian_id":"918df0db-db0e-11ef-9fcc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0df-db0e-11ef-ab03-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：阼，主階也。醴，甘酒也，貴於衆酒。適，讀曰嫡。","note_content_jianti_auto":"师古曰：阼，主阶也。醴，甘酒也，贵于众酒。适，读曰嫡。","note_type":"hu_note","start_index":119,"tongjian_id":"918df0de-db0e-11ef-8a40-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0e2-db0e-11ef-821a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言凡物大小，高卑皆有次序。","note_content_jianti_auto":"师古曰：言凡物大小，高卑皆有次序。","note_type":"hu_note","start_index":179,"tongjian_id":"918df0e1-db0e-11ef-828c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0e5-db0e-11ef-83f6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：如，若也。","note_content_jianti_auto":"师古曰：如，若也。","note_type":"hu_note","start_index":201,"tongjian_id":"918df0e4-db0e-11ef-94af-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"918df0e7-db0e-11ef-ab6d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：易·家人卦之彖辭。","note_content_jianti_auto":"师古曰：易·家人卦之彖辞。","note_type":"hu_note","start_index":251,"tongjian_id":"918df0e6-db0e-11ef-8188-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"臣又聞室家之道脩，則天下之理得，故詩始國風，禮本冠、婚。始乎國風，原情性以明人倫也；本乎冠、婚，正基兆以防未然也；故聖王必愼妃后之際，別適長之位，禮之於內也。卑不踰尊，新不先故，所以統人情而理陰氣也；其尊適而卑庶也，適子冠乎阼，禮之用醴，衆子不得與列，所以貴正體而明嫌疑也。非虛加其禮文而已，乃中心與之殊異，故禮探其情而見之外也。聖人動靜游燕所親，物得其序，則海內自脩，百姓從化。如當親者疏，當尊者卑，則佞巧之姦因時而動，以亂國家。故聖人愼防其端，禁於未然，不以私恩害公義。傳曰：『正家而天下定矣！』」","content_fanyi":"臣又听说，能使家庭和睦安详，就找到了治理天下的道理，所以《诗经》以《国风》为始，《礼经》以冠礼、婚礼为本。以《国风》为始，是追溯性情的本原，用来揭示人伦关系；以冠礼、婚礼为本，是端正根本，用来防患于未然。所以圣明的君主一定慎重处理皇后与嫔妃之间的关系，区别嫡子与庶子的地位，把礼施行在家庭内部。卑贱者不得超越尊贵者，新来者不得抢在旧有者之前，这是用来统摄人情、使阴阳和顺的。尊重嫡子而压低庶子，具体是指嫡子行冠礼时要在阼阶上设置位次，用甜酒行礼；庶子们即使举行冠礼，也不能与嫡子同列同规格，这是为了尊崇正统的主体，明辨嫡庶之嫌，使嫡子处于不容置疑的地位。这并不是虚增礼仪形式而已，而是从内心对他们区别对待，所以用礼仪探求这份情意并把它表现出来。圣人的举止、游乐、宴饮和所亲近的人，都各得其次序，天下人自然修身正己，百姓也随之向化。如果应当亲近的反而疏远，应当尊贵的反而卑贱，那么奸巧邪恶之徒就会乘机而动，扰乱国家。所以圣人谨慎防范祸乱的端绪，在未发生前加以禁止，不以私人恩情损害公义。《易传》说：“端正了家庭，天下就安定了！”","content_jianti_auto":"臣又闻室家之道修，则天下之理得，故诗始国风，礼本冠、婚。始乎国风，原情性以明人伦也；本乎冠、婚，正基兆以防未然也；故圣王必愼妃后之际，别适长之位，礼之于内也。卑不逾尊，新不先故，所以统人情而理阴气也；其尊适而卑庶也，适子冠乎阼，礼之用醴，众子不得与列，所以贵正体而明嫌疑也。非虚加其礼文而已，乃中心与之殊异，故礼探其情而见之外也。圣人动静游燕所亲，物得其序，则海内自修，百姓从化。如当亲者疏，当尊者卑，则佞巧之奸因时而动，以乱国家。故圣人愼防其端，禁于未然，不以私恩害公义。传曰：『正家而天下定矣！』」","dtjl_paragraph_links":[],"dtjl_references":[],"id":2270,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"918df0d4-db0e-11ef-8f1a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":12,"source_start_index":0,"source_text":"事見二十一卷武帝元封二年","target_paragraph_tongjian_id":"90237c6b-db0e-11ef-873a-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":6,"tongjian_id":"918df0f1-db0e-11ef-b9c4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見二十一卷武帝元封二年。塞，悉則翻；下同。","note_content_jianti_auto":"事见二十一卷武帝元封二年。塞，悉则翻；下同。","note_type":"hu_note","start_index":10,"tongjian_id":"918df0f0-db0e-11ef-bea1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":51,"tongjian_id":"918df0f3-db0e-11ef-a0d3-a0d3651f611f"},{"people_name":"隋氏","people_name_jianti_auto":"隋氏","start_index":63,"tongjian_id":"918df0f4-db0e-11ef-b038-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"館陶縣","place_name_jianti_auto":"馆陶县","start_index":0,"tongjian_id":"918df0f5-db0e-11ef-8105-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":5,"tongjian_id":"918df0f6-db0e-11ef-bd54-a0d3651f611f"},{"place_name":"河水","place_name_jianti_auto":"河水","start_index":8,"tongjian_id":"918df0f7-db0e-11ef-8491-a0d3651f611f"},{"place_name":"屯氏河","place_name_jianti_auto":"屯氏河","start_index":15,"tongjian_id":"918df0f8-db0e-11ef-8520-a0d3651f611f"},{"place_name":"勃海","place_name_jianti_auto":"勃海","start_index":22,"tongjian_id":"918df0f9-db0e-11ef-9c5b-a0d3651f611f"},{"place_name":"章武縣","place_name_jianti_auto":"章武县","start_index":24,"tongjian_id":"918df0fa-db0e-11ef-927f-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":31,"tongjian_id":"918df0fb-db0e-11ef-80f4-a0d3651f611f"},{"place_name":"清河","place_name_jianti_auto":"清河","start_index":34,"tongjian_id":"918df0fc-db0e-11e