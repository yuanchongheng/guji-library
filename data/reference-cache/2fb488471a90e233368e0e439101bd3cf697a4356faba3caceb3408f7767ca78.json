ef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"武帝","people_name_jianti_auto":"武帝","people_xingming":"刘彻","start_index":3,"tongjian_id":"918df118-db0e-11ef-8414-a0d3651f611f","wl_zhushi":"[刘彻]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"918df0ef-db0e-11ef-a2af-a0d3651f611f","pinyin":"dī","source_anchor_text":"其自然不隄塞也是歲","source_key":"baiyang_epub","start_index":44,"text":"隄","tongjian_id":"38af754c-d489-54d1-aac5-cb424b639ac6"}],"ExtRef_Children_places":[{"place_name":"宣房","place_name_jianti_auto":"宣房","resolved_place_entity_id":6637,"start_index":7,"tongjian_id":"918df119-db0e-11ef-9539-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":11,"tongjian_id":"918df11a-db0e-11ef-9300-a0d3651f611f"},{"place_name":"館陶","place_name_jianti_auto":"馆陶","resolved_place_entity_id":1846,"start_index":16,"tongjian_id":"918df11b-db0e-11ef-abeb-a0d3651f611f"},{"place_name":"屯氏河","place_name_jianti_auto":"屯氏河","resolved_place_entity_id":4546,"start_index":21,"tongjian_id":"918df11c-db0e-11ef-ab34-a0d3651f611f"},{"place_name":"大河","place_name_jianti_auto":"大河","resolved_place_entity_id":42,"start_index":33,"tongjian_id":"918df11d-db0e-11ef-ae92-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":51,"tongjian_id":"918df11e-db0e-11ef-a9be-a0d3651f611f"},{"place_name":"清河","place_name_jianti_auto":"清河","resolved_place_entity_id":451,"start_index":54,"tongjian_id":"918df11f-db0e-11ef-b5d4-a0d3651f611f"},{"place_name":"靈鳴犢口","place_name_jianti_auto":"灵鸣犊口","resolved_place_entity_id":5484,"start_index":56,"tongjian_id":"918df120-db0e-11ef-ade2-a0d3651f611f"},{"place_name":"屯氏河","place_name_jianti_auto":"屯氏河","resolved_place_entity_id":4546,"start_index":62,"tongjian_id":"918df121-db0e-11ef-abef-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、广平府（卷十五）","excerpts":[{"context_after":"成帝建始初，清河都尉冯逡言：郡承河下流，无大害者，以屯氏...","context_before":"鸣犊口[在县东南。旧为大河所经。《汉书》：","source_end_index":43,"source_paragraph_tongjian_id":"1822ecfc-9a3c-5dd0-a196-1e9a74178381","source_start_index":21,"source_text":"元帝永光五年，河决清河灵鸣犊口，而屯氏河绝。"}],"path":"北直方舆纪要/六、广平府（卷十五）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、大名府（卷十六）","excerpts":[{"context_after":"按此盖屯氏别河，决于成帝时，泛滥兖、豫者，其后流绝。亦名...","context_before":"屯氏河[在府东。","source_end_index":41,"source_paragraph_tongjian_id":"26818442-9aa7-5f01-b8b6-d3a9e186ccc4","source_start_index":8,"source_text":"《志》云：《汉书》武帝塞宣防，后河复决于馆陶，分为屯氏。即此河也。"}],"path":"北直方舆纪要/七、大名府（卷十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十四、徐州（卷二十九）","excerpts":[{"context_after":"后汉初，王梁击佼强、苏茂于楚沛间，拔大梁、啮桑，是也]。","context_before":"...地也。战国周显王四十六年，秦张仪及齐、楚之相，会于啮桑。","source_end_index":82,"source_paragraph_tongjian_id":"18afb555-2c9a-5155-ad10-944e6a3ce351","source_start_index":52,"source_text":"汉武帝《瓠子歌》：啮桑浮兮淮泗满。及塞决口，而梁、楚无水灾。"}],"path":"南直方舆纪要/十四、徐州（卷二十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"今有水自县西南入境，经博平故城南，又经今城西北，东北至故...","context_before":"...自灵县别出为鸣犊河，所谓灵鸣犊口也。东北至蓚，入屯氏河。","source_end_index":105,"source_paragraph_tongjian_id":"fad31c79-1981-56eb-a042-1ab08137662b","source_start_index":90,"source_text":"汉元光五年，河决清河灵鸣犊口。"},{"context_after":"王莽时，河遂行漯川。今漯河自堂邑县流入境，绕县城而西，去...","context_before":"...亦曰漯川。《汉志》：河自馆陶分为屯氏河，与大河相并而行。","source_end_index":108,"source_paragraph_tongjian_id":"ef5e2c78-5930-5aa4-a973-e050be6c66ef","source_start_index":77,"source_text":"元帝永光五年，河决清河灵鸣犊口，分流入博州界，其下流与漯为一。"},{"context_after":"成帝建始初，清河都尉冯逡言：郡承河下流无大害者，以屯氏河...","context_before":"鸣犊口[在县东南。旧为大河所经。《汉书》：","source_end_index":43,"source_paragraph_tongjian_id":"81b42ff0-77cd-5beb-99e9-97f49b53cd79","source_start_index":21,"source_text":"元帝永光五年，河决清河灵鸣犊口，而屯氏河绝。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/◎川渎二大河上（卷一百二十五）","excerpts":[{"context_after":"[屯氏河，见馆陶县]。元帝永光五年，河决清河灵鸣犊口，而...","context_before":"...冠县间入馆陶界[冠县、馆陶俱山东属县]。《汉·沟洫志》：","source_end_index":98,"source_paragraph_tongjian_id":"e9d6ffd9-cf41-530c-ab82-90f0bfb282dc","source_start_index":36,"source_text":"自塞宣房[即瓠子河，见开州]后，河复北决于馆陶，分为屯氏河，东北经魏郡、清河、信都、勃海入海。广深与大河等，因其自然不堤塞也"},{"context_after":"[灵县，见山东博平县。鸣犊口，见直隶清河县]。成帝建始二...","context_before":"...海。广深与大河等，因其自然不堤塞也[屯氏河，见馆陶县]。","source_end_index":130,"source_paragraph_tongjian_id":"e9d6ffd9-cf41-530c-ab82-90f0bfb282dc","source_start_index":109,"source_text":"元帝永光五年，河决清河灵鸣犊口，而屯氏河绝"}],"path":"川渎/◎川渎二大河上（卷一百二十五）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"6初，武帝旣塞宣房，後河復北決於館陶，分爲屯氏河，東北入海，廣深與大河等，故因其自然，不隄塞也。是歲，河決於清河靈鳴犢口，而屯氏河絕。","content_fanyi":"当初，汉武帝在元封二年堵塞黄河瓠子决口，修建了宣房宫。后来，黄河又在北岸馆陶决口，分出屯氏河，向东北流入渤海，河床宽度和深度与黄河相等，所以便顺着它自然发展，不再筑堤堵塞。这一年，黄河在清河郡灵县鸣犊口决口，屯氏河下游因失去来水而干涸断绝。","content_jianti_auto":"6初，武帝既塞宣房，后河复北决于馆陶，分为屯氏河，东北入海，广深与大河等，故因其自然，不隄塞也。是岁，河决于清河灵鸣犊口，而屯氏河绝。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2271,"number":6,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"918df0ef-db0e-11ef-a2af-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":2,"tongjian_id":"918bba50-db0e-11ef-a4a7-a0d3651f611f","year_anno":"（壬午、前三九）","year_int":-39},"message":"success","success":true}