:"90b2bec9-db0e-11ef-86be-a0d3651f611f"},{"people_name":"昌水侯","people_name_jianti_auto":"昌水侯","start_index":277,"tongjian_id":"90b2beca-db0e-11ef-b643-a0d3651f611f"},{"people_name":"趙充國","people_name_jianti_auto":"赵充国","start_index":281,"tongjian_id":"90b2becb-db0e-11ef-a664-a0d3651f611f"},{"people_name":"營平侯","people_name_jianti_auto":"营平侯","start_index":285,"tongjian_id":"90b2becc-db0e-11ef-882c-a0d3651f611f"},{"people_name":"田延年","people_name_jianti_auto":"田延年","start_index":289,"tongjian_id":"90b2becd-db0e-11ef-8b42-a0d3651f611f"},{"people_name":"陽城侯","people_name_jianti_auto":"阳城侯","start_index":293,"tongjian_id":"90b2bece-db0e-11ef-a65e-a0d3651f611f"},{"people_name":"樂成","people_name_jianti_auto":"乐成","start_index":297,"tongjian_id":"90b2becf-db0e-11ef-9828-a0d3651f611f"},{"people_name":"爰氏侯","people_name_jianti_auto":"爰氏侯","start_index":300,"tongjian_id":"90b2bed0-db0e-11ef-9537-a0d3651f611f"},{"people_name":"王遷","people_name_jianti_auto":"王迁","start_index":304,"tongjian_id":"90b2bed1-db0e-11ef-b84a-a0d3651f611f"},{"people_name":"平丘侯","people_name_jianti_auto":"平丘侯","start_index":307,"tongjian_id":"90b2bed2-db0e-11ef-8f2f-a0d3651f611f"},{"people_name":"周德","people_name_jianti_auto":"周德","start_index":315,"tongjian_id":"90b2bed3-db0e-11ef-847c-a0d3651f611f"},{"people_name":"蘇武","people_name_jianti_auto":"苏武","start_index":318,"tongjian_id":"90b2bed4-db0e-11ef-b9d2-a0d3651f611f"},{"people_name":"李光","people_name_jianti_auto":"李光","start_index":321,"tongjian_id":"90b2bed5-db0e-11ef-9c13-a0d3651f611f"},{"people_name":"劉德","people_name_jianti_auto":"刘德","start_index":324,"tongjian_id":"90b2bed6-db0e-11ef-8b3b-a0d3651f611f"},{"people_name":"韋賢","people_name_jianti_auto":"韦贤","start_index":327,"tongjian_id":"90b2bed7-db0e-11ef-bf3f-a0d3651f611f"},{"people_name":"宋畸","people_name_jianti_auto":"宋畸","start_index":330,"tongjian_id":"90b2bed8-db0e-11ef-a577-a0d3651f611f"},{"people_name":"丙吉","people_name_jianti_auto":"丙吉","start_index":333,"tongjian_id":"90b2bed9-db0e-11ef-b91a-a0d3651f611f"},{"people_name":"趙廣漢","people_name_jianti_auto":"赵广汉","start_index":336,"tongjian_id":"90b2beda-db0e-11ef-8dfc-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昭帝始元二年，霍光以捕馬何羅功封博陸侯，二千三百五十戶，今益封萬七千二百戶。元鳳六年，張安世封富平侯，三千四十戶，今益封萬六百戶。楊敞始封安平侯，七百戶，今益封其子忠四千八百四十七戶。蔡義始封陽平侯，今益封，通前凡七百戶。范明友始封平陵侯，今益封，通前凡二千九百二十戶。韓增始紹封龍頟侯，今益封千戶。建平侯杜延年始封二千戶，今益封二千三百六十戶。蒲侯蘇昌始封千二十六戶，今益封。王譚始紹封宜春侯，今益封，通前凡一千一百八戶。魏聖始紹封當塗侯，今益封，通前凡二千二百戶。屠耆堂始紹封杜侯，千三百戶，今益封。夏侯勝始賜爵關內侯，今益封千戶。凡十人。封田廣明爲昌水侯，趙充國爲營平侯，田延年爲陽城侯，樂成爲爰氏侯，王遷爲平丘侯，凡五人。周德、蘇武、李光、劉德、韋賢、宋畸、丙吉、趙廣漢八人皆賜爵關內侯。","note_content_jianti_auto":"昭帝始元二年，霍光以捕马何罗功封博陆侯，二千三百五十户，今益封万七千二百户。元凤六年，张安世封富平侯，三千四十户，今益封万六百户。杨敞始封安平侯，七百户，今益封其子忠四千八百四十七户。蔡义始封阳平侯，今益封，通前凡七百户。范明友始封平陵侯，今益封，通前凡二千九百二十户。韩增始绍封龙頟侯，今益封千户。建平侯杜延年始封二千户，今益封二千三百六十户。蒲侯苏昌始封千二十六户，今益封。王谭始绍封宜春侯，今益封，通前凡一千一百八户。魏圣始绍封当涂侯，今益封，通前凡二千二百户。屠耆堂始绍封杜侯，千三百户，今益封。夏侯胜始赐爵关内侯，今益封千户。凡十人。封田广明为昌水侯，赵充国为营平侯，田延年为阳城侯，乐成为爰氏侯，王迁为平丘侯，凡五人。周德、苏武、李光、刘德、韦贤、宋畸、丙吉、赵广汉八人皆赐爵关内侯。","note_type":"hu_note","start_index":66,"tongjian_id":"90b2beae-db0e-11ef-8377-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代最高軍事長官，統領全國軍隊，位在三公之上。此處指霍光，因定策安宗廟有功而受封賞。","official_rank":"正一品或從一品","source_snippet":"大將軍光益封萬七千戶","start_index":15,"tongjian_id":"4dc4692a-3e55-4416-94b6-1429226e84ca"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"車騎將軍","official_note":"車騎將軍是漢代高級武官，地位僅次於大將軍和驃騎將軍，負責京師和宮廷警衛。此處指張安世，因功受封賞。","official_rank":"正二品或從二品","source_snippet":"車騎將軍富平侯安世以下益封者十人","start_index":30,"tongjian_id":"2155d23d-fe9b-41b3-a12d-0fd75d3c3210"},{"confidence":0.85,"official_category":"爵位","official_name":"關內侯","official_note":"關內侯是漢代二十等爵制中的第十九級，有食邑但無封國，地位較高。此處表示八人因功獲賜此爵位。","official_rank":"二十等爵第十九級","source_snippet":"賜爵關內侯者八人","start_index":52,"tongjian_id":"e4f92bab-b3ee-43f6-8a3c-0da1d4f7bb2e"}],"ExtRef_Children_people":[{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":17,"tongjian_id":"90b2bedb-db0e-11ef-acbd-a0d3651f611f","wl_zhushi":"[霍光]"},{"link_death_year":-62,"link_td_description":"张安世，西汉杜陵县（今陕西省西安市东南）人，为汉武帝至汉宣帝时代的三朝重臣。","link_td_id":"Q10004229","link_td_number_id":243494,"people_name":"富平侯","people_name_jianti_auto":"富平侯","people_xingming":"张安世","start_index":38,"tongjian_id":"90b2bedc-db0e-11ef-b6b0-a0d3651f611f"},{"link_death_year":-62,"link_td_description":"张安世，西汉杜陵县（今陕西省西安市东南）人，为汉武帝至汉宣帝时代的三朝重臣。","link_td_id":"Q10004229","link_td_number_id":243494,"people_name":"安世","people_name_jianti_auto":"安世","people_xingming":"张安世","start_index":41,"tongjian_id":"90b2bedd-db0e-11ef-b0b6-a0d3651f611f","wl_zhushi":"[张安世]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉重苏子卿","excerpts":[{"context_after":"。张晏曰：“旧关内侯无邑，以武守节外国，德宗室俊彦，胡特...","context_before":"...，数为燕王所讼，子又在谋中，廷尉奏请逮捕武，霍光寝其奏。","source_end_index":117,"source_paragraph_tongjian_id":"3ea99be9-799b-47bf-933e-5c35478c8560","source_start_index":90,"source_text":"宣帝立，录群臣定策功，赐爵关内侯者八人，刘德、苏武食邑"}],"path":"四笔/卷十六/汉重苏子卿","source_name":"容斋随笔"}],"class_tags":["人事"],"content":"1春，詔有司論定策安宗廟功。大將軍光益封萬七千戶，與故所食凡二萬戶。車騎將軍富平侯安世以下益封者十人，封侯者五人，賜爵關內侯者八人。","content_fanyi":"春季，汉宣帝下诏，命有关官员评定定策、安定宗庙的功劳。大将军霍光被加封一万七千户食邑，加上原来享有的食邑，共二万户。自车骑将军、富平侯张安世以下，加封食邑的有十人，封为列侯的有五人，赐给关内侯爵位的有八人。","content_jianti_auto":"1春，诏有司论定策安宗庙功。大将军光益封万七千户，与故所食凡二万户。车骑将军富平侯安世以下益封者十人，封侯者五人，赐爵关内侯者八人。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"。宣帝之为此，失君道矣。己为武帝曾孙，遭家不造，以贤而立...","context_before":"...若夫迎立宣帝，固以亲以贤，行其所无事者，非其论功之地也。","source_end_index":116,"source_paragraph_tongjian_id":"fea1fc95-3045-4c0f-b96c-305655b314f8","source_start_index":90,"source_text":"宣帝纪定策功，加封光以二万户，侯者五人，关内侯者八人"}],"title":"一 非淡泊无以明志"}],"id":1966,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"90b2bead-db0e-11ef-9512-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"霍光是否归还朝政大权","decision_tongjian_id":"DECISION_90B2BEDEDB0E11EF8A98A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"胡","place_name_jianti_auto":"胡","start_index":0,"tongjian_id":"90b2bee1-db0e-11ef-b03f-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","start_index":2,"tongjian_id":"90b2bee2-db0e-11ef-8b7b-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":5,"tongjian_id":"90b2bee3-db0e-11ef-aee0-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","start_index":8,"tongjian_id":"90b2bee4-db0e-11ef-a73b-a0d3651f611f"},{"place_name":"長樂","place_name_jianti_auto":"长乐","start_index":19,"tongjian_id":"90b2bee5-db0e-11ef-8dc6-a0d3651f611f"},{"place_name":"未央","place_name_jianti_auto":"未央","start_index":24,"tongjian_id":"90b2bee6-db0e-11ef-9a50-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"胡、越兵，胡騎及越騎也。東、西宮衞尉，長樂衞尉及未央衞尉也。侍中得入禁中，諸曹受尚書奏事，給事中給事禁中，皆加官也。下，胡稼翻。已甚，言過當也。","note_content_jianti_auto":"胡、越兵，胡骑及越骑也。东、西宫衞尉，长乐衞尉及未央衞尉也。侍中得入禁中，诸曹受尚书奏事，给事中给事禁中，皆加官也。下，胡稼翻。已甚，言过当也。","note_type":"hu_note","start_index":142,"tongjian_id":"90b2bee0-db0e-11ef-b5d1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代最高軍事長官，常掌朝政大權，此處指霍光，他在昭帝和宣帝時期權傾朝野，控制朝廷事務。","official_rank":"正一品或高級武官","source_snippet":"大將軍光稽首歸政","start_index":0,"tongjian_id":"30c3a917-4b55-406f-b91c-7bd5ecd412a6"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代禁軍將領，負責宮廷守衛，此處指