.8,"official_category":"中枢近臣","official_name":"給事中","official_note":"給事中是皇帝身邊的侍從官，負責文書和傳達命令，此處指霍光親屬擔任此職，加強在宮廷的日常事務控制。","official_rank":"比六百石或低級近臣","source_snippet":"爲諸曹、大夫、騎都尉、給事中","start_index":93,"tongjian_id":"24c64adf-a1b3-4845-b476-10dc6dc63a28"}],"ExtRef_Children_people":[{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","start_index":4,"tongjian_id":"90b2bee7-db0e-11ef-a992-a0d3651f611f"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":22,"tongjian_id":"90b2bee8-db0e-11ef-bf3a-a0d3651f611f"},{"link_birth_year":-94,"link_death_year":-74,"link_td_description":"汉昭帝刘弗陵，汉朝皇帝（前87年－前74年在位），其正式谥号为“孝昭皇帝”，后世省略“孝”字称“汉昭帝”，汉武帝幼子，母亲钩弋夫人。","link_td_id":"Q10000314","link_td_number_id":98999,"people_name":"昭帝","people_name_jianti_auto":"昭帝","people_xingming":"刘弗陵","start_index":30,"tongjian_id":"90b2bee9-db0e-11ef-9e49-a0d3651f611f","wl_zhushi":"[刘弗陵]"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":34,"tongjian_id":"90b2beea-db0e-11ef-a305-a0d3651f611f"},{"link_death_year":-66,"link_td_description":"霍禹，西汉政治人物，大司马。权臣霍光和妻子显之子、皇后霍成君的哥哥。","link_td_id":"Q10012812","link_td_number_id":1509123,"people_name":"禹","people_name_jianti_auto":"禹","people_xingming":"霍禹","start_index":36,"tongjian_id":"90b2beeb-db0e-11ef-9a30-a0d3651f611f"},{"link_death_year":-66,"link_td_description":"霍云，中国汉朝政治人物。霍去病的孙子，霍光的侄孙子，开始为中郎将。前68年，霍光去世，汉宣帝念其功德，封霍云兄霍山为乐平侯，次年又封霍云为冠阳侯。霍云为人骄纵，朝请时称病不去，却带着宾客外出围猎，让苍头朝谒，没人敢谴责。霍光的儿子博陆侯霍禹与霍山、霍云三人被汉宣帝设计，解除兵权，牢骚满腹。霍光之妻显告诉他们，她毒杀皇后许平君的事情。霍云的舅舅李竟因交通诸侯王获罪，宣帝下诏免去霍山、霍云的宿卫之职让他们回家。霍禹、霍云、霍山等人越来越害怕，打算发动兵变，计划杀害丞相魏相、平恩侯许广汉，罢黜汉宣帝，立霍禹为帝。还没有行动，霍云又被任为玄菟太守。前66年七月，事情败露，霍云、霍山自杀，霍禹被腰斩，霍家一族遭到满门抄斩。","link_td_id":"Q10012833","link_td_number_id":1509124,"people_name":"雲","people_name_jianti_auto":"云","people_xingming":"霍云","start_index":40,"tongjian_id":"90b2beec-db0e-11ef-8cd5-a0d3651f611f"},{"link_death_year":-66,"link_td_description":"霍云，中国汉朝政治人物。霍去病的孙子，霍光的侄孙子，开始为中郎将。前68年，霍光去世，汉宣帝念其功德，封霍云兄霍山为乐平侯，次年又封霍云为冠阳侯。霍云为人骄纵，朝请时称病不去，却带着宾客外出围猎，让苍头朝谒，没人敢谴责。霍光的儿子博陆侯霍禹与霍山、霍云三人被汉宣帝设计，解除兵权，牢骚满腹。霍光之妻显告诉他们，她毒杀皇后许平君的事情。霍云的舅舅李竟因交通诸侯王获罪，宣帝下诏免去霍山、霍云的宿卫之职让他们回家。霍禹、霍云、霍山等人越来越害怕，打算发动兵变，计划杀害丞相魏相、平恩侯许广汉，罢黜汉宣帝，立霍禹为帝。还没有行动，霍云又被任为玄菟太守。前66年七月，事情败露，霍云、霍山自杀，霍禹被腰斩，霍家一族遭到满门抄斩。","link_td_id":"Q10012833","link_td_number_id":1509124,"people_name":"雲","people_name_jianti_auto":"云","people_xingming":"霍云","start_index":47,"tongjian_id":"90b2beed-db0e-11ef-b2fb-a0d3651f611f"},{"people_name":"山","people_name_jianti_auto":"山","people_xingming":"霍山","start_index":49,"tongjian_id":"90b2beee-db0e-11ef-b966-a0d3651f611f"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":64,"tongjian_id":"90b2beef-db0e-11ef-9f4a-a0d3651f611f"},{"link_birth_year":-92,"link_death_year":-59,"link_td_description":"刘贺，曾任昌邑王、汉朝皇帝（前74年7月18日至8月14日在位）及海昏侯等。他原先继承父亲刘髆的昌邑王王位，后于汉昭帝突然死亡后，被霍光主政的朝廷指定继承皇位，但在位约27日又被霍光废黜，并送回原封地昌邑国。后来，他被皇位继任者汉宣帝授予海昏侯的爵位。","link_td_id":"Q10000835","link_td_number_id":10994,"people_name":"昌邑王","people_name_jianti_auto":"昌邑王","people_xingming":"刘贺","start_index":116,"tongjian_id":"90b2bef0-db0e-11ef-99f1-a0d3651f611f","wl_zhushi":"[刘贺]"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":121,"tongjian_id":"90b2bef1-db0e-11ef-9aa9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":59,"tongjian_id":"90b2bef2-db0e-11ef-a036-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","resolved_place_entity_id":357,"start_index":61,"tongjian_id":"90b2bef3-db0e-11ef-a82a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"2大將軍光稽首歸政，上謙讓不受；諸事皆先關白光，然後奏御。自昭帝時，光子禹及兄孫雲皆爲中郞將，雲弟山奉車都尉、侍中，領胡、越兵，光兩女壻爲東、西宮衞尉，昆弟、諸壻、外孫皆奉朝請，爲諸曹、大夫、騎都尉、給事中，黨親連體，根據於朝廷。及昌邑王廢，光權益重，每朝見，上虛己斂容，禮下之已甚。","content_fanyi":"大将军霍光叩头请求将朝政大权交还皇帝，汉宣帝谦让不肯接受；所有政务都要先禀报霍光，然后才上奏皇帝。早在汉昭帝时，霍光的儿子霍禹和他哥哥的孙子霍云都已担任中郎将，霍云的弟弟霍山担任奉车都尉、侍中，统领胡人、越人军队；霍光的两个女婿分别担任东宫、西宫卫尉，霍家的兄弟、女婿、外孙都获得奉朝请资格，出任诸曹、大夫、骑都尉、给事中等职，亲戚党羽连成一体，在朝廷中根基深固。昌邑王被废以后，霍光的权势更加重大，每逢朝见，汉宣帝都虚心庄重，对他谦恭礼遇得超过常度。","content_jianti_auto":"2大将军光稽首归政，上谦让不受；诸事皆先关白光，然后奏御。自昭帝时，光子禹及兄孙云皆为中郞将，云弟山奉车都尉、侍中，领胡、越兵，光两女壻为东、西宫衞尉，昆弟、诸壻、外孙皆奉朝请，为诸曹、大夫、骑都尉、给事中，党亲连体，根据于朝廷。及昌邑王废，光权益重，每朝见，上虚己敛容，礼下之已甚。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1967,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"90b2bede-db0e-11ef-8a98-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3夏，四月，庚午，地震。","content_fanyi":"夏季，四月庚午日，发生了地震。","content_jianti_auto":"3夏，四月，庚午，地震。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1968,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"90b2bef4-db0e-11ef-9d9b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_c