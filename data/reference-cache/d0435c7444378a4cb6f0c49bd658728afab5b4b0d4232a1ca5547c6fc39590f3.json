{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲寅、前一八七）","note_content_jianti_auto":"（甲寅、前一八七）","note_type":"hu_note","start_index":0,"tongjian_id":"8ea265d7-db0e-11ef-9771-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":0,"tongjian_id":"8ea265da-db0e-11ef-ba32-a0d3651f611f"},{"people_name":"劉氏","people_name_jianti_auto":"刘氏","start_index":13,"tongjian_id":"8ea265db-db0e-11ef-aa75-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高祖刑白馬與羣臣盟曰：「非劉氏不王，非有功不侯。」","note_content_jianti_auto":"高祖刑白马与群臣盟曰：「非刘氏不王，非有功不侯。」","note_type":"hu_note","start_index":31,"tongjian_id":"8ea265d9-db0e-11ef-ab36-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄒氏","people_name_jianti_auto":"邹氏","start_index":13,"tongjian_id":"8ea265e0-db0e-11ef-964e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"啑，所甲翻，小啜也。索隱引鄒氏，音使接翻。","note_content_jianti_auto":"啑，所甲翻，小啜也。索隐引邹氏，音使接翻。","note_type":"hu_note","start_index":132,"tongjian_id":"8ea265df-db0e-11ef-a605-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂當朝廷而諫諍。","note_content_jianti_auto":"谓当朝廷而谏诤。","note_type":"hu_note","start_index":184,"tongjian_id":"8ea265e3-db0e-11ef-910d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"右丞相","official_note":"右丞相是汉朝中央政府的最高行政长官之一，负责辅佐皇帝处理政务。在《资治通鉴》此段中，王陵担任右丞相，太后询问他关于立诸吕为王的意见，显示其作为重要决策顾问的角色。","official_rank":"正一品","source_snippet":"問右丞相陵","start_index":12,"tongjian_id":"db4b634b-8a16-43b5-b4c1-7bbee468b102"},{"confidence":0.95,"official_category":"中枢机构","official_name":"左丞相","official_note":"左丞相是汉朝中央政府的最高行政长官之一，与右丞相并列，共同辅佐皇帝。在此段中，陈平担任左丞相，太后询问他的意见，他支持太后立诸吕为王，反映了其政治立场和影响力。","official_rank":"正一品","source_snippet":"問左丞相平","start_index":48,"tongjian_id":"174a7c45-3782-4f01-af04-160f587afc45"},{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉朝的最高军事长官，负责全国军事事务。在此段中，周勃担任太尉，太后询问他的意见，他支持太后立诸吕为王，表明其军事和政治上的支持。","official_rank":"正一品","source_snippet":"太尉勃","start_index":52,"tongjian_id":"401bf764-c725-4702-ae42-9874a2456944"},{"confidence":0.9,"official_category":"文教","official_name":"帝太傅","official_note":"帝太傅是皇帝的老师，负责教导和辅佐皇帝，通常为荣誉性职务。在此段中，太后任命王陵为帝太傅，实际上是为了剥夺他的丞相权力，反映了政治斗争中的职务调整。","official_rank":"正一品","source_snippet":"太后以王陵爲帝太傅","start_index":184,"tongjian_id":"0a413f5c-a913-4029-a241-12974d8e769e"}],"ExtRef_Children_people":[{"link_birth_year":-241,"link_death_year":-180,"link_td_description":"吕雉，字娥姁，一说名雉，汉高祖刘邦皇后，山东单父（今单县）人，为中国历史上首位有正式记载姓名的皇后与皇太后。","link_td_id":"Q10000140","link_td_number_id":95981,"people_name":"呂","people_name_jianti_auto":"吕","people_xingming":"吕姓人","start_index":9,"tongjian_id":"8ea265e4-db0e-11ef-ba3c-a0d3651f611f"},{"link_death_year":-180,"link_td_description":"王陵，秦末汉初沛人。汉朝时，封安国侯，谥武。","link_td_id":"Q10012230","link_td_number_id":1451429,"people_name":"陵","people_name_jianti_auto":"陵","people_xingming":"王陵","start_index":17,"tongjian_id":"8ea265e5-db0e-11ef-80ff-a0d3651f611f","wl_zhushi":"[王陵]"},{"link_death_year":-180,"link_td_description":"王陵，秦末汉初沛人。汉朝时，封安国侯，谥武。","link_td_id":"Q10012230","link_td_number_id":1451429,"people_name":"陵","people_name_jianti_auto":"陵","start_index":19,"tongjian_id":"8ea265e6-db0e-11ef-941b-a0d3651f611f","wl_zhushi":"[王陵]"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高帝","people_name_jianti_auto":"高帝","people_xingming":"刘邦","start_index":23,"tongjian_id":"8ea265e7-db0e-11ef-96b4-a0d3651f611f","wl_zhushi":"[刘邦]"},{"people_name":"劉氏","people_name_jianti_auto":"刘氏","people_xingming":"刘姓人","start_index":33,"tongjian_id":"8ea265e8-db0e-11ef-a1cd-a0d3651f611f"},{"people_name":"呂氏","people_name_jianti_auto":"吕氏","people_xingming":"吕姓人","start_index":47,"tongjian_id":"8ea265e9-db0e-11ef-be28-a0d3651f611f"},{"link_death_year":-178,"link_td_description":"陈平，阳武户牖乡（今河南省兰考县）人，以谋略见长。在楚汉相争时，初在项羽手下做谋士。早期被项羽重用，因得罪亚父范增，逃归汉王刘邦帐下。曾多次出计策助刘邦。西汉建立后，任右丞相，后迁左丞相，曾先后受封户牖侯、曲逆侯（今河北顺平东），死后谥献侯。“反间计”、“离间计”，均出自其手。","link_td_id":"Q10000767","link_td_number_id":112434,"people_name":"平","people_name_jianti_auto":"平","people_xingming":"陈平","start_index":64,"tongjian_id":"8ea265ea-db0e-11ef-816c-a0d3651f611f","wl_zhushi":"[陈平]"},{"link_death_year":-169,"link_td_description":"周勃，沛县人，秦末汉初的军事家和政治家，汉高祖刘邦认为周勃“厚重少文”，可以托付大事，以军功高，封为绛侯。汉文帝时，拜右丞相。","link_td_id":"Q10008064","link_td_number_id":87097,"people_name":"勃","people_name_jianti_auto":"勃","people_xingming":"周勃","start_index":68,"tongjian_id":"8ea265eb-db0e-11ef-9185-a0d3651f611f","wl_zhushi":"[周勃]"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":74,"tongjian_id":"8ea265ec-db0e-11ef-a6e7-a0d3651f611f","wl_zh