mber_id":653561,"people_name":"趙隱王","people_name_jianti_auto":"赵隐王","people_xingming":"刘如意","start_index":6,"tongjian_id":"8ea2660e-db0e-11ef-8239-a0d3651f611f","wl_zhushi":"[刘如意]"},{"link_td_description":"赵尧，西汉官吏，曾继任周昌作为御史大夫。","link_td_id":"Q10007763","link_td_number_id":1137366,"people_name":"堯","people_name_jianti_auto":"尧","people_xingming":"赵尧","start_index":13,"tongjian_id":"8ea2660f-db0e-11ef-aa04-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"太后怨趙堯爲趙隱王謀，乃抵堯罪。","content_fanyi":"吕太后怨恨赵尧当年为高祖设谋保全赵王刘如意，便借故罗织罪名，罢免了他御史大夫的官职。","content_jianti_auto":"太后怨赵尧为赵隐王谋，乃抵尧罪。","dtjl_paragraph_links":[],"dtjl_references":[],"id":991,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8ea26605-db0e-11ef-b7d9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"任敖","people_name_jianti_auto":"任敖","start_index":0,"tongjian_id":"8ea26612-db0e-11ef-8507-a0d3651f611f"},{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":11,"tongjian_id":"8ea26613-db0e-11ef-be17-a0d3651f611f"},{"people_name":"呂后","people_name_jianti_auto":"吕后","start_index":19,"tongjian_id":"8ea26614-db0e-11ef-a28e-a0d3651f611f"},{"people_name":"敖","people_name_jianti_auto":"敖","start_index":27,"tongjian_id":"8ea26615-db0e-11ef-80a0-a0d3651f611f"},{"people_name":"呂后","people_name_jianti_auto":"吕后","start_index":31,"tongjian_id":"8ea26616-db0e-11ef-a58f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"沛","place_name_jianti_auto":"沛","start_index":3,"tongjian_id":"8ea26617-db0e-11ef-9251-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_conten