n_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8ea26638-db0e-11ef-9dc9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦爲威虐，罪之重者，戮及三族；過誤之語，以爲妖言；故皆除之。","note_content_jianti_auto":"秦为威虐，罪之重者，戮及三族；过误之语，以为妖言；故皆除之。","note_type":"hu_note","start_index":15,"tongjian_id":"8ea26637-db0e-11ef-8108-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2春，正月，除三族罪、妖言令。","content_fanyi":"春季，正月，太后下诏废除“三族罪”和“妖言令”。","content_jianti_auto":"2春，正月，除三族罪、妖言令。","dtjl_paragraph_links":[],"dtjl_references":[],"id":994,"number":2,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8ea26636-db0e-11ef-82b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-187,"link_td_description":"鲁元公主，名不详，《汉书》记载，吕后曾称其为鲁元，汉高祖刘邦和皇后吕雉的长女，为汉惠帝之姐。颇受母亲吕雉宠爱。嫁赵王张耳之子张敖为妻，生鲁王张偃。另有一女张氏，后来成为汉惠帝刘盈的皇后。","link_td_id":"Q10001659","link_td_number_id":203373,"people_name":"魯元公主","people_name_jianti_auto":"鲁元公主","people_xingming":"鲁元公主","start_index":6,"tongjian_id":"8ea2663a-db0e-11ef-a4ed-a0d3651f611f"},{"link_death_year":-173,"link_td_description":"张偃，汉朝诸侯王，西汉第一代鲁王。祖父张耳，母亲是汉高祖刘邦和吕后的女儿鲁元公主，其父张敖曾经封为赵王，后来废为宣平侯，姊姊为汉惠帝的张皇后。前187年，被外祖母吕后封为鲁王。前179年，汉文帝刘恒撤销鲁国，张偃改为南宫侯，薨逝，儿子张生（一说张欧）嗣位。","link_td_id":"Q10007770","link_td_number_id":1449045,"people_name":"張偃","people_name_jianti_auto":"张偃","people_xingming":"张偃","start_index":16,"tongjian_id":"8ea2663b-db0e-11ef-8a04-a0d3651f611f"},{"link_death_year":-173,"link_td_description":"张偃，汉朝诸侯王，西汉第一代鲁王。祖父张耳，母亲是汉高祖刘邦和吕后的女儿鲁元公主，其父张敖曾经封为赵王，后来废为宣平侯，姊姊为汉惠帝的张皇后。前187年