hildren_zhang_notes":[],"note_content":"惠帝元年，淮陽王友徙王趙，今以封彊。恆山郡本屬趙國，今割以封不疑。恆，戶登翻。","note_content_jianti_auto":"惠帝元年，淮阳王友徙王赵，今以封彊。恒山郡本属赵国，今割以封不疑。恒，户登翻。","note_type":"hu_note","start_index":28,"tongjian_id":"8ea26652-db0e-11ef-8e55-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張釋","people_name_jianti_auto":"张释","start_index":53,"tongjian_id":"8ea2665c-db0e-11ef-8d76-a0d3651f611f"},{"people_name":"顏師古","people_name_jianti_auto":"颜师古","start_index":82,"tongjian_id":"8ea2665d-db0e-11ef-af3a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"風，讀曰諷。考異曰：史記·文帝本紀及惠景間侯者表、漢書·匈奴傳皆作「澤」。史記·呂后本紀：「八年，中大謁者張釋」，漢書·紀作「釋卿」，恩澤侯表及周勃傳皆云「張釋」。顏師古註曰：荊燕吳傳云「張擇」。今從史記·呂后本紀、漢書·恩澤侯表。","note_content_jianti_auto":"风，读曰讽。考异曰：史记·文帝本纪及惠景间侯者表、汉书·匈奴传皆作「泽」。史记·吕后本纪：「八年，中大谒者张释」，汉书·纪作「释卿」，恩泽侯表及周勃传皆云「张释」。颜师古注曰：荆燕吴传云「张择」。今从史记·吕后本纪、汉书·恩泽侯表。","note_type":"hu_note","start_index":38,"tongjian_id":"8ea2665b-db0e-11ef-b08f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇林","people_name_jianti_auto":"苏林","start_index":0,"tongjian_id":"8ea2666b-db0e-11ef-ad3b-a0d3651f611f"},{"people_name":"台","people_name_jianti_auto":"台","start_index":4,"tongjian_id":"8ea2666c-db0e-11ef-9008-a0d3651f611f"},{"people_name":"鄭","people_name_jianti_auto":"郑","start_index":16,"tongjian_id":"8ea2666d-db0e-11ef-ba72-a0d3651f611f"},{"people_name":"鄒","people_name_jianti_auto":"邹","start_index":18,"tongjian_id":"8ea2666e-db0e-11ef-b620-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蘇林曰：台，音胞胎之胎。索隱曰：鄭、鄒並音怡。考異曰：漢書·外戚侯表及高五王傳皆作「鄜侯」。今從史記·本紀、功臣侯表。","note_content_jianti_auto":"苏林曰：台，音胞胎之胎。索隐曰：郑、邹并音怡。考异曰：汉书·外戚侯表及高五王传皆作「鄜侯」。今从史记·本纪、功臣侯表。","note_type":"hu_note","start_index":55,"tongjian_id":"8ea2666a-db0e-11ef-a249-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷礼仪","official_name":"大謁者","official_note":"大謁者是汉代负责宫廷礼仪、传达诏命的官职，此处太后派遣大謁者张释去暗示大臣，以推动吕氏封王之事。","official_rank":"未知","source_snippet":"使大謁者張釋風大臣","start_index":38,"tongjian_id":"25c4f7f4-52b3-43ec-9c18-f77aa0ba39e9"}],"ExtRef_Children_people":[{"people_name":"呂氏","people_name_jianti_auto":"吕氏","start_index":4,"tongjian_id":"8ea4afc1-db0e-11ef-a966-a0d3651f611f"},{"people_name":"孝惠","people_name_jianti_auto":"孝惠","people_xingming":"孝惠帝","start_index":12,"tongjian_id":"8ea4afc2-db0e-11ef-b389-a0d3651f611f"},{"link_death_year":-183,"link_td_description":"刘强，汉惠帝之子，生母不详。吕后元年（前187年）四月，被立为淮阳王。","link_td_id":"Q10004344","link_td_number_id":1296186,"people_name":"彊","people_name_jianti_auto":"彊","people_xingming":"刘彊","start_index":15,"tongjian_id":"8ea4afc3-db0e-11ef-8d33-a0d3651f611f"},{"link_death_year":-183,"link_td_description":"刘强，汉惠帝之子，生母不详。吕后元年（前187年）四月，被立为淮阳王。","link_td_id":"Q10004344","link_td_number_id":1296186,"people_name":"淮陽王","people_name_jianti_auto":"淮阳王","people_xingming":"刘彊","start_index":17,"tongjian_id":"8ea4afc4-db0e-11ef-8e1b-a0d3651f611f"},{"link_birth_year":-211,"link_death_year":-188,"link_td_description":"汉惠帝刘盈，汉朝开国皇帝汉高帝刘邦和皇后吕氏之子，汉朝皇帝，于前195年6月26日—前188年9月26日在位，在位7年，其正式谥号为“孝惠皇帝”。","link_td_id":"Q10000195","link_td_number_id":106737,"people_name":"不疑","people_name_jianti_auto":"不疑","people_xingming":"刘不疑","start_index":21,"tongjian_id":"8ea4afc5-db0e-11ef-b186-a0d3651f611f"},{"link_birth_year":-211,"link_death_year":-188,"link_td_description":"汉惠帝刘盈，汉朝开国皇帝汉高帝刘邦和皇后吕氏之子，汉朝皇帝，于前195年6月26日—前188年9月26日在位，在位7年，其正式谥号为“孝惠皇帝”。","link_td_id":"Q10000195","link_td_number_id":106737,"people_name":"恆山王","people_name_jianti_auto":"恒山王","people_xingming":"刘不疑","start_index":24,"tongjian_id":"8ea4afc6-db0e-11ef-ad6d-a0d3651f611f"},{"people_name":"張釋","people_name_jianti_auto":"张释","people_xingming":"张释","start_index":32,"tongjian_id":"8ea4afc7-db0e-11ef-926f-a0d3651f611f"},{"link_death_year":-199,"link_td_description":"吕泽，汉朝军事人物，吕雉的兄长，刘邦的妻舅，山阳郡单父县（今山东省单县）人。生于秦末，卒于西汉初。","link_td_id":"Q10017658","link_td_number_id":5210652,"people_name":"悼武王","people_name_jianti_auto":"悼武王","people_xingming":"吕泽","start_index":43,"tongjian_id":"8ea4afc8-db0e-11ef-927a-a0d3651f611f","wl_zhushi":"[吕泽]"},{"link_death_year":-187,"link_td_description":"吕台，汉朝诸侯王，西汉第一代吕王。","link_td_id":"Q10005295","link_td_number_id":1449063,"people_name":"酈侯","people_name_jianti_auto":"郦侯","people_xingming":"吕台","start_index":48,"tongjian_id":"8ea4afc9-db0e-11ef-a4cf-a0d3651f611f"},{"link_death_year":-187,"link_td_description":"吕台，汉朝诸侯王，西汉第一代吕王。","link_td_id":"Q10005295","link_td_number_id":1449063,"people_name":"台","people_name_jianti_auto":"台","people_xingming":"吕台","start_index":50,"tongjian_id":"8ea4afca-db0e-11ef-b2a7-a0d3651f611f"},{"link_death_year":-187,"link_td_description":"吕台，汉朝诸侯王，西汉第一代吕王。","link_td_id":"Q10005295","link_td_number_id":1449063,"people_name":"呂王","people_name_jianti_auto":"吕王","people_xingming":"吕台","start_index":52,"tongjian_id":"8ea4afcb-db0e-11ef-b696-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":56,"tongjian_id":"8ea4afcc-db0e-11ef-8d96-a0d3651f611f"},{"place_name":"濟南郡","place_name_jianti_auto":"济南郡","resolved_place_entity_id":859,"start_index":58,"tongjian_id":"8ea4afcd-db0e-11ef-8fd3-a0d3651f611f"},{"place_name":"呂國","place_name_jianti_auto":"吕国","resolved_place_entity_id":6218,"start_index":62,"tongjian_id":"8ea4afce-db0e-11ef-ae6f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"后汉省为吕都亭。延熹二年，以诛梁冀功，封尚书令虞放为吕都...","context_before":"吕都城[在州西南二十里。汉县，属济阴郡。","source_end_index":53,"source_paragraph_tongjian_id":"de6be433-e195-5287-8891-d4fd17474fb6","source_start_index":20,"source_text":"或曰：高后割济南郡为吕国，封吕台为吕王，此其所都也，后因置吕都县。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"}],"class_tags":["权争"],"content":"太后欲王呂氏，乃先立所名孝惠子彊爲淮陽王，不疑爲恆山王；使大謁者張釋風大臣。大臣乃請立悼武王長子酈侯台爲呂王，割齊之濟南郡爲呂國。","content_fanyi":"吕太后想让吕氏子弟封王，便先立号称是汉惠帝之子的刘彊为淮阳王、刘不疑为恒山王，以此安抚刘氏宗室；又通过担任大谒者的宦官张释，把封吕氏为王的意思含蓄地透露给大臣。大臣们于是上奏，请将悼武王吕泽的长子、郦侯吕台封为吕王，并割出齐国的济南郡作为吕国。","content_jianti_auto":"太后欲王吕氏，乃先立所名孝惠子彊为淮阳王，不疑为恒山王；使大谒者张释风大臣。大臣乃请立悼武王长子郦侯台为吕王，割齐之济南郡为吕国。","dtjl_paragraph_links":[],"dtjl_references":[],"id":997,"reading_annotation_sources":[{"count":2,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":8,"tongjian_id":"8ea26651-db0e-11ef-b619-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉昭","people_name_jianti_auto":"刘昭","start_index":0,"tongjian_id":"8ea4afd1-db0e-11ef-bb11-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙國","place_name_jianti_auto":"赵国","start_index":4,"tongjian_id":"8ea4afd2-db0e-11ef-b2cc-a0d3651f611f"},{"place_name":"邯鄲縣","place_name_jianti_auto":"邯郸县","start_index":6,"tongjian_id":"8ea4afd3-db0e-11ef-823d-a0d3651f611f"},{"place_name":"叢臺","place_name_jianti_auto":"丛台","start_index":10,"tongjian_id":"8ea4afd4-db0e-11ef-b168-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉昭志：趙國邯鄲縣有叢臺。","note_content_jianti_auto":"刘昭志：赵国邯郸县有丛台。","note_type":"hu_note","start_index":14,"tongjian_id":"8ea4afd0-db0e-11ef-ac0e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-181,"link_td_description":"刘友，刘邦的儿子，汉高祖十一年三月受封淮阳王；汉惠帝元年十二月徙封赵王。正妻为吕后之侄女，因刘友另有爱妾而失宠，遂向吕后诬告刘友欲叛。吕后七年正月，召刘友入京，一到长安便被软禁，断绝粮食，活活饿死，以平民之礼下葬。汉文帝继位后，追谥为幽王。","link_td_id":"Q10009395","link_td_number_id":653592,"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"赵王","start_index":7,"tongjian_id":"8ea4afd6-db0e-11ef-bb05-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"叢臺","place_name_jianti_auto":"丛台","resolved_place_entity_id":6157,"start_index":10,"tongjian_id":"8ea4afd7-db0e-11ef-b99c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、广平府（卷十五）","excerpts":[{"context_after":"更始二年，光武拔邯郸，置酒高会，与马武登丛台。是也。今有...","context_before":"...东。世传赵武灵王所筑。颜师古曰：以其连聚非一，故曰丛台。","source_end_index":45,"source_paragraph_tongjian_id":"7c379165-2943-54ae-bcc1-034512460928","source_start_index":34,"source_text":"汉高后元年，赵丛台灾。"}],"path":"北直方舆纪要/六、广平府（卷十五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"5五月，丙申，趙王宮叢臺災。","content_fanyi":"五月初四丙申日，赵王宫中的丛台失火。","content_jianti_auto":"5五月，丙申，赵王宫丛台灾。","dtjl_paragraph_links":[],"dtjl_references":[],"id":998,"number":5,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"8ea4afcf-db0e-11ef-8114-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6秋，桃、李華。","content_fanyi":"秋天，桃树和李树都不合时令地开了花。","content_jianti_auto":"6秋，桃、李华。","dtjl_paragraph_links":[],"dtjl_references":[],"id":999,"number":6,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"8ea4afd8-db0e-11ef-8fdc-a0d3651f611f"}],"reign_name":"元年","reign_name_jianti_auto":"元年","start_index":0,"tongjian_id":"8ea265d6-db0e-11ef-bf88-a0d3651f611f","year_anno":"（甲寅、前一八七）","year_int":-187},"message":"success","success":true}