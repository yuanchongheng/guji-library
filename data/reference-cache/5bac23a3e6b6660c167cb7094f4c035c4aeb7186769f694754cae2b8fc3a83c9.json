{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（己巳、一二九）","note_content_jianti_auto":"（己巳、一二九）","note_type":"hu_note","start_index":0,"tongjian_id":"96782131-db0e-11ef-8d1f-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，丙寅，赦天下。","content_fanyi":"春季，正月初一丙寅日，大赦天下。","content_jianti_auto":"1春，正月，丙寅，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4294,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"96782132-db0e-11ef-91c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2丙子，帝加元服。","content_fanyi":"正月十一日丙子，汉顺帝行成年加冠礼。","content_jianti_auto":"2丙子，帝加元服。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4295,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"96782133-db0e-11ef-bcb3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"御，進也。","note_content_jianti_auto":"御，进也。","note_type":"hu_note","start_index":35,"tongjian_id":"96782135-db0e-11ef-a172-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"桂陽郡","place_name_jianti_auto":"桂阳郡","start_index":4,"tongjian_id":"96782137-db0e-11ef-b9ba-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":9,"tongjian_id":"96782138-db0e-11ef-99f9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志：桂陽郡，在雒陽南三千九百里。礱，音力公翻。","note_content_jianti_auto":"郡国志：桂阳郡，在雒阳南三千九百里。砻，音力公翻。","note_type":"hu_note","start_index":43,"tongjian_id":"96782136-db0e-11ef-862b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言不思宣暢本朝遇災脩省之意也。朝，直遙翻。","note_content_jianti_auto":"言不思宣畅本朝遇灾修省之意也。朝，直遥翻。","note_type":"hu_note","start_index":52,"tongjian_id":"9678213a-db0e-11ef-9f6a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"礱","people_name_jianti_auto":"砻","start_index":2,"tongjian_id":"9678213c-db0e-11ef-89a5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不罪礱而但封還其珠，非所以昭德塞違也。","note_content_jianti_auto":"不罪砻而但封还其珠，非所以昭德塞违也。","note_type":"hu_note","start_index":69,"tongjian_id":"9678213b-db0e-11ef-acbc-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"桂陽太守","official_note":"桂陽太守是汉代地方官职，负责管理桂阳郡的行政事务，此处指文礱担任此职，在上下文中他因献珠行为被提及，反映了地方官员与朝廷的关系。","official_rank":"郡守（约二千石）","source_snippet":"桂陽太守文礱","start_index":45,"tongjian_id":"50c703ee-3fde-41fa-8218-b27fa0121658"}],"ExtRef_Children_people":[{"people_name":"文礱","people_name_jianti_auto":"文砻","people_xingming":"文砻","start_index":40,"tongjian_id":"9678213d-db0e-11ef-abb6-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"96782134-db0e-11ef-9f6e-a0d3651f611f","pinyin":"lóng","source_anchor_text":"陽太守文礱不惟竭忠","source_key":"baiyang_epub","start_index":41,"text":"礱","tongjian_id":"ac6e6edf-f330-5d4e-900d-5ee438f05a72"}],"ExtRef_Children_places":[{"place_name":"桂陽","place_name_jianti_auto":"桂阳","resolved_place_entity_id":931,"start_index":36,"tongjian_id":"9678213e-db0e-11ef-a4ab-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3夏，五月，壬辰，詔曰：「海內頗有災異，朝廷脩政，太官減膳，珍玩不御。而桂陽太守文礱，不惟竭忠宣暢本朝，而遠獻大珠以求幸媚，今封以還之！」","content_fanyi":"夏季，五月二十九日壬辰，汉顺帝下诏说：“天下灾异颇多，朝廷应当修整政事，太官减少膳食，珍奇玩物不再进用。而桂阳郡太守文砻，不领会应当竭尽忠诚、宣示本朝因遇灾害而厉行节俭的德音，反而从远方进献大珠来谄媚邀宠，现在将原物封好退还给他！”","content_jianti_auto":"3夏，五月，壬辰，诏曰：「海内颇有灾异，朝廷修政，太官减膳，珍玩不御。而桂阳太守文砻，不惟竭忠宣畅本朝，而远献大珠以求幸媚，今封以还之！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":4296,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"96782134-db0e-11ef-9f6e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4五州雨水。","content_fanyi":"五州雨水不止。","content_jianti_auto":"4五州雨水。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4297,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"