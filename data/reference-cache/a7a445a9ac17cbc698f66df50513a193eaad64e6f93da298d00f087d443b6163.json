611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":93,"tongjian_id":"95d75b28-db0e-11ef-849b-a0d3651f611f"},{"place_name":"池陽","place_name_jianti_auto":"池阳","start_index":96,"tongjian_id":"95d75b29-db0e-11ef-a10b-a0d3651f611f"},{"place_name":"衙","place_name_jianti_auto":"衙","start_index":99,"tongjian_id":"95d75b2a-db0e-11ef-b319-a0d3651f611f"},{"place_name":"馮翊","place_name_jianti_auto":"冯翊","start_index":104,"tongjian_id":"95d75b2b-db0e-11ef-a905-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：安定郡，今涇州也。美陽故城，在今武功縣北。北地郡，今寧州。池陽縣故城，在今涇陽縣北。上郡，今綏州也。衙縣故城，在今同州白水縣東北。左傳秦、晉戰于彭衙，卽此也。余按郡國志，美陽縣，屬扶風；池陽、衙二縣，屬馮翊。衙，音牙。","note_content_jianti_auto":"贤曰：安定郡，今泾州也。美阳故城，在今武功县北。北地郡，今宁州。池阳县故城，在今泾阳县北。上郡，今绥州也。衙县故城，在今同州白水县东北。左传秦、晋战于彭衙，即此也。余按郡国志，美阳县，属扶风；池阳、衙二县，属冯翊。衙，音牙。","note_type":"hu_note","start_index":125,"tongjian_id":"95d75b15-db0e-11ef-8e58-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"䠞，與蹙同。喪，息浪翻。","note_content_jianti_auto":"䠞，与蹙同。丧，息浪翻。","note_type":"hu_note","start_index":195,"tongjian_id":"95d75b30-db0e-11ef-b564-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"95d75b32-db0e-11ef-be4c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"羊頭山","place_name_jianti_auto":"羊头山","start_index":3,"tongjian_id":"95d75b33-db0e-11ef-85dc-a0d3651f611f"},{"place_name":"上黨郡","place_name_jianti_auto":"上党郡","start_index":8,"tongjian_id":"95d75b34-db0e-11ef-ab1d-a0d3651f611f"},{"place_name":"穀遠縣","place_name_jianti_auto":"谷远县","start_index":11,"tongjian_id":"95d75b35-db0e-11ef-af4d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：羊頭山，在上黨郡穀遠縣。復，扶又翻；下同。","note_content_jianti_auto":"贤曰：羊头山，在上党郡谷远县。复，扶又翻；下同。","note_type":"hu_note","start_index":216,"tongjian_id":"95d75b31-db0e-11ef-9629-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"北軍中候","official_note":"北軍中候是漢代禁軍北軍的監察官，負責監督北軍五營，此處朱寵被任命此職以率軍屯守孟津防禦羌寇。","official_rank":"未知","source_snippet":"使北軍中候朱寵將五營士屯孟津","start_index":24,"tongjian_id":"cdcf5458-0363-4eb4-8917-5fff4e100b9a"},{"confidence":0.85,"official_category":"地方行政","official_name":"二千石","official_note":"二千石是漢代郡守的俸祿級別，代指郡守等高級地方官員，此處指邊境地區的郡守缺乏守戰意願。","official_rank":"高級地方官","source_snippet":"而緣邊二千石、令、長多內郡人","start_index":73,"tongjian_id":"7665184f-4afc-4c89-b136-0364ff3cec87"},{"confidence":0.8,"official_category":"地方行政","official_name":"令","official_note":"令是漢代縣級行政長官，此處與二千石、長並列，指邊境縣令多為內郡人，不願守戰。","official_rank":"中級地方官","source_snippet":"而緣邊二千石、令、長多內郡人","start_index":78,"tongjian_id":"69e1a9c1-723d-461c-a26a-9de3c8ac2187"},{"confidence":0.8,"official_category":"地方行政","official_name":"長","official_note":"長是漢代縣級行政長官，通常指小縣的長官，此處指邊境縣長官多為內郡人，缺乏防禦意圖。","official_rank":"中級地方官","source_snippet":"而緣邊二千石、令、長多內郡人","start_index":80,"tongjian_id":"fff458d0-66c2-47e5-b405-42388a2d409e"},{"confidence":0.9,"official_category":"監察","official_name":"侍御史","official_note":"侍御史是漢代御史臺的官員，負責監察和彈劾，此處任尚被任命此職以率軍攻擊羌寇，顯示其臨時軍事職能。","official_rank":"未知","source_snippet":"復以任尚爲侍御史","start_index":184,"tongjian_id":"3fba4897-6d26-4e50-b926-8687f62ecd75"}],"ExtRef_Children_people":[{"link_td_description":"朱宠，字仲威，京兆（今西安市）人，东汉政治人物，生卒年均不详。","link_td_id":"Q10007405","link_td_number_id":4553448,"people_name":"朱寵","people_name_jianti_auto":"朱宠","people_xingming":"朱宠","start_index":28,"tongjian_id":"95d75b39-db0e-11ef-8567-a0d3651f611f"},{"link_death_year":119,"link_td_description":"任尚，东汉将领。","link_td_id":"Q10009347","link_td_number_id":630637,"people_name":"任尚","people_name_jianti_auto":"任尚","people_xingming":"任尚","star