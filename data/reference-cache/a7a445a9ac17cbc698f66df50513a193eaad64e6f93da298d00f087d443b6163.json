:"漢陽太守是漢代地方行政長官，負責治理漢陽郡，此處趙博派遣刺客刺殺杜琦，顯示其在地方治安和軍事行動中的角色。","official_rank":"郡守級別，約二千石","source_snippet":"漢陽太守趙博","start_index":38,"tongjian_id":"ce6a79cf-af75-4ef3-9591-3b703b85ce06"},{"confidence":0.9,"official_category":"爵位","official_name":"討姦侯","official_note":"討姦侯是封給杜習的爵位，以獎勵其刺殺杜琦的行動，屬於榮譽性封號，在漢代用於表彰功績。","official_rank":"侯爵，品秩不詳","source_snippet":"封習討姦侯","start_index":52,"tongjian_id":"9bbf5bca-94e4-40f2-a44e-af4dc8d92b47"}],"ExtRef_Children_people":[{"people_name":"杜琦","people_name_jianti_auto":"杜琦","people_xingming":"杜琦","start_index":9,"tongjian_id":"95d9a505-db0e-11ef-ad82-a0d3651f611f"},{"people_name":"季貢","people_name_jianti_auto":"季贡","people_xingming":"杜季贡","start_index":13,"tongjian_id":"95d9a506-db0e-11ef-8559-a0d3651f611f"},{"people_name":"王信","people_name_jianti_auto":"王信","people_xingming":"王信","start_index":18,"tongjian_id":"95d9a507-db0e-11ef-ad43-a0d3651f611f"},{"people_name":"趙博","people_name_jianti_auto":"赵博","people_xingming":"赵博","start_index":43,"tongjian_id":"95d9a508-db0e-11ef-9eb7-a0d3651f611f"},{"people_name":"杜習","people_name_jianti_auto":"杜习","people_xingming":"杜习","start_index":47,"tongjian_id":"95d9a509-db0e-11ef-8d57-a0d3651f611f"},{"people_name":"琦","people_name_jianti_auto":"琦","people_xingming":"杜琦","start_index":51,"tongjian_id":"95d9a50a-db0e-11ef-a805-a0d3651f611f"},{"people_name":"習","people_name_jianti_auto":"习","people_xingming":"杜习","start_index":54,"tongjian_id":"95d9a50f-db0e-11ef-a3c8-a0d3651f611f"},{"people_name":"討姦侯","people_name_jianti_auto":"讨奸侯","people_xingming":"杜习","start_index":55,"tongjian_id":"95d9a510-db0e-11ef-9847-a0d3651f611f"},{"people_name":"杜季貢","people_name_jianti_auto":"杜季贡","people_xingming":"杜季贡","start_index":59,"tongjian_id":"95d9a511-db0e-11ef-a0d4-a0d3651f611f"},{"people_name":"王信","people_name_jianti_auto":"王信","people_xingming":"王信","start_index":63,"tongjian_id":"95d9a512-db0e-11ef-954f-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"95d9a503-db0e-11ef-b8bc-a0d3651f611f","pinyin":"chū","source_anchor_text":"將其眾據樗泉營是歲","source_key":"baiyang_epub","start_index":70,"text":"樗","tongjian_id":"8772a31f-3a6f-50ec-8cbf-75c0256f44aa"}],"ExtRef_Children_places":[{"place_name":"漢陽","place_name_jianti_auto":"汉阳","resolved_place_entity_id":879,"start_index":6,"tongjian_id":"95d9a50b-db0e-11ef-9bff-a0d3651f611f"},{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":22,"tongjian_id":"95d9a50c-db0e-11ef-8923-a0d3651f611f"},{"place_name":"上邽","place_name_jianti_auto":"上邽","resolved_place_entity_id":508,"start_index":29,"tongjian_id":"95d9a50d-db0e-11ef-a013-a0d3651f611f"},{"place_name":"漢陽","place_name_jianti_auto":"汉阳","resolved_place_entity_id":879,"start_index":39,"tongjian_id":"95d9a50e-db0e-11ef-ba7f-a0d3651f611f"},{"place_name":"樗泉營","place_name_jianti_auto":"樗泉营","resolved_place_entity_id":7584,"start_index":70,"tongjian_id":"95d9a513-db0e-11ef-8335-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、巩昌府（卷五十九）","excerpts":[{"context_after":"○柔凶坞，在州西南。晋永嘉末，凉州刺史张轨遣其子寔等将兵...","context_before":"樗泉营[在州西北。","source_end_index":57,"source_paragraph_tongjian_id":"5943678f-a592-5c87-bf7e-fdec16a127f1","source_start_index":9,"source_text":"后汉永初五年，汉阳人杜琦等据上邽以叛。琦死，其党杜季贡等将其众据樗泉营，既而败降于滇零羌，是也。"}],"path":"陕西方舆纪要/八、巩昌府（卷五十九）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"8秋，九月，漢陽人杜琦及弟季貢、同郡王信等與羌通謀，聚衆據上邽城。冬，十二月，漢陽太守趙博遣客杜習刺殺琦；封習討姦侯。杜季貢、王信等將其衆據樗泉營。","content_fanyi":"秋季九月，汉阳郡人杜琦联合弟弟杜季贡、同郡王信等人，暗中与羌人串通合谋，聚集人众占领了上邽城。冬季十二月，汉阳郡太守赵博派门客杜习刺死了杜琦，朝廷封杜习为讨奸侯。杜季贡、王信等人带领部众据守樗泉营。","content_jianti_auto":"8秋，九月，汉阳人杜琦及弟季贡、同郡王信等与羌通谋，聚众据上邽城。冬，十二月，汉阳太守赵博遣客杜习刺杀琦；封习讨奸侯。杜季贡、王信等将其众据樗泉营。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4034,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"95d9a503-db0e-11ef-b8bc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"9是歲，九州蝗，郡國八雨水。","content_fanyi":"这一年，九州蝗虫成灾，八个郡国雨水泛滥。","content_jianti_auto":"9是岁，九州蝗，郡国八雨水。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4035,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"95d9a514-db0e-11ef-b8e4-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":4,"tongjian_id":"95d75af1-db0e-11ef-871c-a0d3651f611f","year_anno":"（辛亥、一一一）","year_int":111},"message":"success","success":true}