:4,"tongjian_id":"91bbcda3-db0e-11ef-8c0c-a0d3651f611f"},{"place_name":"北畤","place_name_jianti_auto":"北畤","start_index":28,"tongjian_id":"91bbcda4-db0e-11ef-962d-a0d3651f611f"},{"place_name":"五畤","place_name_jianti_auto":"五畤","start_index":36,"tongjian_id":"91bbcda5-db0e-11ef-8942-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","start_index":57,"tongjian_id":"91bbcda6-db0e-11ef-9c99-a0d3651f611f"},{"place_name":"五畤","place_name_jianti_auto":"五畤","start_index":61,"tongjian_id":"91bbcda7-db0e-11ef-966a-a0d3651f611f"},{"place_name":"陳寶","place_name_jianti_auto":"陈宝","start_index":64,"tongjian_id":"91bbcda8-db0e-11ef-9ba0-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":68,"tongjian_id":"91bbcda9-db0e-11ef-a827-a0d3651f611f"},{"place_name":"陳倉","place_name_jianti_auto":"陈仓","start_index":75,"tongjian_id":"91bbcdaa-db0e-11ef-83af-a0d3651f611f"},{"place_name":"陳寶","place_name_jianti_auto":"陈宝","start_index":133,"tongjian_id":"91bbcdab-db0e-11ef-9d37-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦作畤於雍，以祠上帝，有白、青、黃、赤帝之祠。至漢高帝立北畤，祠黑帝，而五畤具。有司進祠，上不親往。至文帝時，始幸雍，郊見五畤。陳寶者，秦文公獲若石於陳倉北阪上，祠之。其神來，常以夜，光輝若流星；從東方來，集於祠城，若雄雉，其聲殷殷云，野雞皆鳴以應之。祠以一牢，名曰陳寶。衡以爲不應禮，皆奏罷之。雍，於用翻。畤，音止。","note_content_jianti_auto":"秦作畤于雍，以祠上帝，有白、青、黄、赤帝之祠。至汉高帝立北畤，祠黑帝，而五畤具。有司进祠，上不亲往。至文帝时，始幸雍，郊见五畤。陈宝者，秦文公获若石于陈仓北阪上，祠之。其神来，常以夜，光辉若流星；从东方来，集于祠城，若雄雉，其声殷殷云，野鸡皆鸣以应之。祠以一牢，名曰陈宝。衡以为不应礼，皆奏罢之。雍，于用翻。畤，音止。","note_type":"hu_note","start_index":15,"tongjian_id":"91bbcd98-db0e-11ef-8f34-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"91bbcdad-db0e-11ef-951e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":7,"tongjian_id":"91bbcdae-db0e-11ef-aa4b-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":15,"tongjian_id":"91bbcdaf-db0e-11ef-bd5d-a0d3651f611f"},{"place_name":"長陵","place_name_jianti_auto":"长陵","start_index":19,"tongjian_id":"91bbcdb0-db0e-11ef-8c7c-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":45,"tongjian_id":"91bbcdb1-db0e-11ef-80d6-a0d3651f611f"},{"place_name":"長陵","place_name_jianti_auto":"长陵","start_index":48,"tongjian_id":"91bbcdb2-db0e-11ef-aa2d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：天郊在長安城南，地郊在長安城北長陵界中。二縣有奉郊之勤，故並赦之。余按帝紀，二縣，長安及長陵也。","note_content_jianti_auto":"应劭曰：天郊在长安城南，地郊在长安城北长陵界中。二县有奉郊之勤，故并赦之。余按帝纪，二县，长安及长陵也。","note_type":"hu_note","start_index":39,"tongjian_id":"91bbcdac-db0e-11ef-b705-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcdb5-db0e-11ef-bb1e-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":14,"tongjian_id":"91bbcdb6-db0e-11ef-b8a7-a0d3651f611f"},{"people_name":"杜林","people_name_jianti_auto":"杜林","start_index":48,"tongjian_id":"91bbcdb7-db0e-11ef-9d3b-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":73,"tongjian_id":"91bbcdb8-db0e-11ef-8ce6-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":88,"tongjian_id":"91bbcdb9-db0e-11ef-9f25-a0d3651f611f"},{"people_name":"應氏","people_name_jianti_auto":"应氏","start_index":93,"tongjian_id":"91bbcdba-db0e-11ef-8cbc-a0d3651f611f"},{"people_name":"如氏","people_name_jianti_auto":"如氏","start_index":103,"tongjian_id":"91bbcdbb-db0e-11ef-aa08-a0d3651f611f"},{"people_name":"宣曲侯","people_name_jianti_auto":"宣曲侯","start_index":150,"tongjian_id":"91bbcdbc-db0e-11ef-8000-a0d3651f611f"},{"people_name":"通","people_name_jianti_auto":"通","start_index":153,"tongjian_id":"91bbcdbd-db0e-11ef-8beb-a0d3651f611f"},{"people_name":"應氏","people_name_jianti_auto":"应氏","start_index":160,"tongjian_id":"91bbcdbe-db0e-11ef-93a5-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"中都","place_name_jianti_auto":"中都","start_index":4,"tongjian_id":"91bbcdbf-db0e-11ef-a805-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":8,"tongjian_id":"91bbcdc0-db0e-11ef-a94c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：中都官，京師諸官府。應劭曰：輕罪不至於髡，完其耏鬢，故曰耏。古耏字從「彡」，髮膚之意也。杜林以爲法度之字皆從「寸」，後改如是。耐，音若能。如淳曰：耐，猶任也，任其事也。師古曰：依應氏之說，耏當音而；如氏之說，則音乃代翻。其義亦兩通。耏，謂頰旁毛也。彡，毛髮貌也，音所廉翻，又先廉翻。而功臣表，宣曲侯通耏爲鬼薪。則應氏之說斯爲長矣。","note_content_jianti_auto":"师古曰：中都官，京师诸官府。应劭曰：轻罪不至于髡，完其耏鬓，故曰耏。古耏字从「彡」，发肤之意也。杜林以为法度之字皆从「寸」，后改如是。耐，音若能。如淳曰：耐，犹任也，任其事也。师古曰：依应氏之说，耏当音而；如氏之说，则音乃代翻。其义亦两通。耏，谓颊旁毛也。彡，毛发貌也，音所廉翻，又先廉翻。而功臣表，宣曲侯通耏为鬼薪。则应氏之说斯为长矣。","note_type":"hu_note","start_index":47,"tongjian_id":"91bbcdb4-db0e-11ef-95fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"91bbcdc3-db0e-11ef-95c5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：本算百二十，今減四十爲八十。","note_content_jianti_auto":"孟康曰：本算百二十，今减四十为八十。","note_type":"hu_note","start_index":57,"tongjian_id":"91bbcdc2-db0e-11ef-adff-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"匡衡，字稚圭，东海郡承县（今天的山东省兰陵县西南、枣庄一带）人。西汉经学家，元帝时位至丞相。","link_td_id":"Q10009100","link_td_number_id":522878,"people_name":"匡衡","people_name_jianti_auto":"匡衡","people_xingming":"匡衡","start_index":17,"tongjian_id":"91bbcdc7-db0e-11ef-8949-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雍","place_name_jianti_auto":"雍","resolved_place_entity_id":228,"start_index":7,"tongjian_id":"91bbcdc4-db0e-11ef-847b-a0d3651f611f"},{"place_name":"五畤","place_name_jianti_auto":"五畤","resolved_place_entity_id":1322,"start_index":8,"tongjian_id":"91bbcdc5-db0e-11ef-970b-a0d3651f611f"},{"place_name":"陳寶祠","place_name_jianti_auto":"陈宝祠","resolved_place_entity_id":5437,"start_index":11,"tongjian_id":"91bbcdc6-db0e-11ef-abf7-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":30,"tongjian_id":"91bbcdc8-db0e-11ef-a0bf-a0d3651f611f"},{"place_name":"中都","place_name_jianti_auto":"中都","resolved_place_entity_id":1436,"start_index":40,"tongjian_id":"91bbcdc9-db0e-11ef-946e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"《志》云：汉圜丘，在昆明池南。唐武德初，于明德门外道东二...","context_before":"...里。其制上圆下方，有九宫十二室。又汉圆丘亦在故长安城南。","source_end_index":259,"source_paragraph_tongjian_id":"795142ad-6540-589b-bb56-808ac60e563f","source_start_index":235,"source_text":"成帝建始二年，罢雍五畴，始祀昊天上帝于南郊是也。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"1春，正月，罷雍五畤及陳寶祠，皆從匡衡之請也。辛巳，上始郊祀長安南郊。赦奉郊縣及中都官耐罪徒；減天下賦錢，算四十。","content_fanyi":"春季，正月，下诏撤除雍县的五天帝祭坛和陈仓的陈宝祠，这些都是采纳匡衡的奏请。正月二十三日辛巳，汉成帝首次到京都长安南郊举行祭天典礼。赦免供奉祭天的长安县、供奉祭地的长陵县及京师各官署中服役的轻罪囚徒；减轻天下赋税，将算赋减为每人四十钱。","content_jianti_auto":"1春，正月，罢雍五畤及陈宝祠，皆从匡衡之请也。辛巳，上始郊祀长安南郊。赦奉郊县及中都官耐罪徒；减天下赋钱，算四十。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2342,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"91bbcd97-db0e-11ef-9917-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"渭城","place_name_jianti_auto":"渭城","resolved_place_entity_id":1950,"start_index":5,"tongjian_id":"91bbcdcb-db0e-11ef-bb10-a0d3651f611f"},{"place_name":"延陵亭","place_name_jianti_auto":"延陵亭","resolved_place_entity_id":6956,"start_index":7,"tongjian_id":"91bbcdcc-db0e-11ef-a5d2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2閏月，以渭城延陵亭部爲初陵。","content_fanyi":"闰正月，汉成帝将渭城延陵亭一带选定为初陵，并开始营建延陵。","content_jianti_auto":"2闰月，以渭城延陵亭部为初陵。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2343,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"91bbcdca-db0e-11ef-b4fa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"后土","people_name_jianti_auto":"后土","people_xingming":"后土","start_index":10,"tongjian_id":"91bbcdce-db0e-11ef-b616-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3三月，辛丑，上始祠后土于北郊。","content_fanyi":"三月十四日辛丑，汉成帝首次在京都长安的北郊祭祀后土。","content_jianti_auto":"3三月，辛丑，上始祠后土于北郊。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2344,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"91bbcdcd-db0e-11ef-bdad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":12,"source_start_index":0,"source_text":"事見二十四卷宣帝本始三年","target_paragraph_tongjian_id":"90b732a3-db0e-11ef-9356-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"宣帝","people_name_jianti_auto":"宣帝","start_index":6,"tongjian_id":"91bbcdd1-db0e-11ef-b1f8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見二十四卷宣帝本始三年。","note_content_jianti_auto":"事见二十四卷宣帝本始三年。","note_type":"hu_note","start_index":39,"tongjian_id":"91bbcdd0-db0e-11ef-aeec-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"車騎將軍","official_note":"車騎將軍是漢代高級武官，掌管車騎部隊，常參與軍事指揮和宮廷護衛。在原文中，許嘉擔任此職，其女被立為皇后，顯示其家族地位顯赫。","official_rank":"未知","source_snippet":"車騎將軍嘉之女也","start_index":10,"tongjian_id":"0b424c32-b661-4510-a388-b4136db0e7f8"}],"ExtRef_Children_people":[{"link_td_description":"许氏：成帝舅车骑将军许嘉之女，虽立为后，但因无子受王风等外戚排斥，终被废。传见《汉书》卷九十七下。","link_td_id":"Q10025196","people_name":"許氏","people_name_jianti_auto":"许氏","people_xingming":"许氏","start_index":7,"tongjian_id":"91bbcdd2-db0e-11ef-bcfe-a0d3651f611f"},{"link_death_year":-28,"link_td_description":"许嘉，昌邑（今山东省金乡县）人，西汉大司马、外戚。","link_td_id":"Q10004485","link_td_number_id":1509143,"people_name":"嘉","people_name_jianti_auto":"嘉","people_xingming":"许嘉","start_index":16,"tongjian_id":"91bbcdd3-db0e-11ef-974d-a0d3651f611f","wl_zhushi":"[许嘉]"},{"link_birth_year":-75,"link_death_year":-33,"link_td_description":"汉元帝刘奭，汉朝皇帝，其正式谥号为“孝元皇帝”，后世省略“孝”字称“汉元帝”。汉宣帝长子，生于民间，母恭哀皇后许平君。宣帝死后继位，在位16年（前48年－前33年）。","link_td_id":"Q10000055","link_td_number_id":39433,"people_name":"元帝","people_name_jianti_auto":"元帝","people_xingming":"刘奭","start_index":21,"tongjian_id":"91bbcdd4-db0e-11ef-8da4-a0d3651f611f","wl_zhushi":"[刘奭]"},{"link_birth_year":-88,"link_death_year":-71,"link_td_description":"许平君，昌邑（今山东省金乡县）人，平恩戴侯许广汉之女，汉宣帝刘询的糟糠之妻和首任皇后。","link_td_id":"Q10000627","link_td_number_id":148967,"people_name":"恭哀后","people_name_jianti_auto":"恭哀后","people_xingming":"许平君","start_index":25,"tongjian_id":"91bbcdd5-db0e-11ef-8ebc-a0d3651f611f","wl_zhushi":"[许平君]"},{"people_name":"霍氏","people_name_jianti_auto":"霍氏","people_xingming":"霍氏","start_index":34,"tongjian_id":"91bbcdd6-db0e-11ef-8a0b-a0d3651f611f"},{"link_death_year":-28,"link_td_description":"许嘉，昌邑（今山东省金乡县）人，西汉大司马、外戚。","link_td_id":"Q10004485","link_td_number_id":1509143,"people_name":"嘉","people_name_jianti_auto":"嘉","people_xingming":"许嘉","start_index":41,"tongjian_id":"91bbcdd7-db0e-11ef-a088-a0d3651f611f","wl_zhushi":"[许嘉]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"4丙午，立皇后許氏。后，車騎將軍嘉之女也。元帝傷母恭哀后居位日淺而遭霍氏之辜，故選嘉女以配太子。","content_fanyi":"三月十九日丙午，册立许氏为皇后。许皇后是车骑将军许嘉的女儿。汉元帝因哀伤母亲恭哀后在位时间不长，却遭霍氏毒害，所以特意挑选许嘉的女儿嫁给太子。","content_jianti_auto":"4丙午，立皇后许氏。后，车骑将军嘉之女也。元帝伤母恭哀后居位日浅而遭霍氏之辜，故选嘉女以配太子。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2345,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"91bbcdcf-db0e-11ef-b097-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此大將軍之軍中武庫令也。欽傳，軍下更有「軍」字。","note_content_jianti_auto":"此大将军之军中武库令也。钦传，军下更有「军」字。","note_type":"hu_note","start_index":38,"tongjian_id":"91bbcdda-db0e-11ef-ae07-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":0,"tongjian_id":"91bbcddd-db0e-11ef-a06f-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":23,"tongjian_id":"91bbcdde-db0e-11ef-9ff2-a0d3651f611f"},{"people_name":"欽","people_name_jianti_auto":"钦","start_index":41,"tongjian_id":"91bbcddf-db0e-11ef-b65f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"夏","place_name_jianti_auto":"夏","start_index":34,"tongjian_id":"91bbcde0-db0e-11ef-a683-a0d3651f611f"},{"place_name":"殷","place_name_jianti_auto":"殷","start_index":36,"tongjian_id":"91bbcde1-db0e-11ef-bdd6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張晏曰：陽數一、三、五、七、九。九，數之極也。臣瓚曰：天子一娶九女，夏、殷之制也。欽故舉古之約以刺今之奢也。說，輸芮翻。","note_content_jianti_auto":"张晏曰：阳数一、三、五、七、九。九，数之极也。臣瓒曰：天子一娶九女，夏、殷之制也。钦故举古之约以刺今之奢也。说，输芮翻。","note_type":"hu_note","start_index":59,"tongjian_id":"91bbcddc-db0e-11ef-bb2b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcde3-db0e-11ef-a307-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：媵女之內，兄弟之女則謂之姪，己之女弟則謂之娣。塞，絕也。復，扶又翻。塞，悉則翻。","note_content_jianti_auto":"师古曰：媵女之内，兄弟之女则谓之姪，己之女弟则谓之娣。塞，绝也。复，扶又翻。塞，悉则翻。","note_type":"hu_note","start_index":75,"tongjian_id":"91bbcde2-db0e-11ef-8d26-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"行，下孟翻；下同。","note_content_jianti_auto":"行，下孟翻；下同。","note_type":"hu_note","start_index":84,"tongjian_id":"91bbcde4-db0e-11ef-920f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcde6-db0e-11ef-8932-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：由，用也，從也。女德不厭，言好色之甚也。","note_content_jianti_auto":"师古曰：由，用也，从也。女德不厌，言好色之甚也。","note_type":"hu_note","start_index":121,"tongjian_id":"91bbcde5-db0e-11ef-9a23-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcde8-db0e-11ef-87b5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：究，竟也。","note_content_jianti_auto":"师古曰：究，竟也。","note_type":"hu_note","start_index":135,"tongjian_id":"91bbcde7-db0e-11ef-9bd1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcdea-db0e-11ef-8774-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：間，代也，音居莧翻。適，讀曰嫡；下亦同。","note_content_jianti_auto":"师古曰：间，代也，音居苋翻。适，读曰嫡；下亦同。","note_type":"hu_note","start_index":205,"tongjian_id":"91bbcde9-db0e-11ef-a02d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"晉獻公","people_name_jianti_auto":"晋献公","start_index":0,"tongjian_id":"91bbcdec-db0e-11ef-8723-a0d3651f611f"},{"people_name":"驪姬","people_name_jianti_auto":"骊姬","start_index":4,"tongjian_id":"91bbcded-db0e-11ef-93c3-a0d3651f611f"},{"people_name":"驪姬","people_name_jianti_auto":"骊姬","start_index":7,"tongjian_id":"91bbcdee-db0e-11ef-ac7d-a0d3651f611f"},{"people_name":"申生","people_name_jianti_auto":"申生","start_index":17,"tongjian_id":"91bbcdef-db0e-11ef-b29a-a0d3651f611f"},{"people_name":"獻公","people_name_jianti_auto":"献公","start_index":20,"tongjian_id":"91bbcdf0-db0e-11ef-8587-a0d3651f611f"},{"people_name":"申生","people_name_jianti_auto":"申生","start_index":25,"tongjian_id":"91bbcdf1-db0e-11ef-b43d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉獻公嬖驪姬，驪姬欲立其子，讒世子申生；獻公信之，申生雉經而死。被，皮義翻。","note_content_jianti_auto":"晋献公嬖骊姬，骊姬欲立其子，谗世子申生；献公信之，申生雉经而死。被，皮义翻。","note_type":"hu_note","start_index":223,"tongjian_id":"91bbcdeb-db0e-11ef-b230-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcdf5-db0e-11ef-b066-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：惟求淑質，無論美色及音聲技能，如此則可爲萬世法也。技，渠綺翻。","note_content_jianti_auto":"师古曰：惟求淑质，无论美色及音声技能，如此则可为万世法也。技，渠绮翻。","note_type":"hu_note","start_index":295,"tongjian_id":"91bbcdf4-db0e-11ef-a276-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbcdf7-db0e-11ef-a55e-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":7,"tongjian_id":"91bbcdf8-db0e-11ef-beda-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：論語，孔子曰：君子有三戒，少之時，血氣未定，戒之在色。言好色無節則致損敗，故戒之也。少，詩照翻。","note_content_jianti_auto":"师古曰：论语，孔子曰：君子有三戒，少之时，血气未定，戒之在色。言好色无节则致损败，故戒之也。少，诗照翻。","note_type":"hu_note","start_index":302,"tongjian_id":"91bbcdf6-db0e-11ef-8475-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":6,"tongjian_id":"91bbcdfb-db0e-11ef-99e4-a0d3651f611f"},{"people_name":"幽王","people_name_jianti_auto":"幽王","start_index":14,"tongjian_id":"91bbcdfc-db0e-11ef-9801-a0d3651f611f"},{"people_name":"申后","people_name_jianti_auto":"申后","start_index":17,"tongjian_id":"91bbcdfd-db0e-11ef-aa04-a0d3651f611f"},{"people_name":"褒姒","people_name_jianti_auto":"褒姒","start_index":21,"tongjian_id":"91bbcdfe-db0e-11ef-b8e4-a0d3651f611f"},{"people_name":"宜咎","people_name_jianti_auto":"宜咎","start_index":27,"tongjian_id":"91bbcdff-db0e-11ef-b6cf-a0d3651f611f"},{"people_name":"伯服","people_name_jianti_auto":"伯服","start_index":31,"tongjian_id":"91bbce00-db0e-11ef-92c3-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":35,"tongjian_id":"91bbce01-db0e-11ef-9675-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周室","place_name_jianti_auto":"周室","start_index":59,"tongjian_id":"91bbce02-db0e-11ef-be44-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩·小雅也。張晏曰：小卞，刺幽王廢申后而立褒姒，黜太子宜咎而立伯服也。臣瓚曰：小卞之詩，太子之傅作也；哀太子之放逐，愍周室之大壞也。卞，音盤。","note_content_jianti_auto":"诗·小雅也。张晏曰：小卞，刺幽王废申后而立褒姒，黜太子宜咎而立伯服也。臣瓒曰：小卞之诗，太子之傅作也；哀太子之放逐，愍周室之大坏也。卞，音盘。","note_type":"hu_note","start_index":312,"tongjian_id":"91bbcdfa-db0e-11ef-ab0e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91bbce07-db0e-11ef-9098-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：慮，計也。","note_content_jianti_auto":"师古曰：虑，计也。","note_type":"hu_note","start_index":371,"tongjian_id":"91bbce06-db0e-11ef-a988-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代高級軍事長官，常掌兵權，此處指王鳳擔任大將軍輔政，在文中作為杜欽進言的對象，顯示其權力地位。","official_rank":"正一品或高級武官","source_snippet":"大將軍武庫令杜欽說王鳳曰","start_index":39,"tongjian_id":"4fcf9c2f-7441-4b95-8bee-9fb2e81cf9bd"},{"confidence":0.9,"official_category":"財政或軍事後勤","official_name":"武庫令","official_note":"武庫令是管理武器庫的官員，屬少府或太僕，此處杜欽擔任此職，在文中以官員身份向王鳳進言，反映其參與政事。","official_rank":"中低級官員","source_snippet":"大將軍武庫令杜欽說王鳳曰","start_index":42,"tongjian_id":"af4e3b9a-7f41-4f4c-a991-05a4d0323a6e"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"將軍","official_note":"將軍泛指高級軍事官員，此處指王鳳作為大將軍輔佐朝政，在文中杜欽建議其建立制度，體現其政治影響力。","official_rank":"高級武官","source_snippet":"將軍輔政，宜因始初之隆","start_index":249,"tongjian_id":"85b157f8-1938-4d81-a505-ff911c55cbd4"}],"ExtRef_Children_people":[{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"杜欽","people_name_jianti_auto":"杜钦","people_xingming":"杜钦","start_index":36,"tongjian_id":"91bbce09-db0e-11ef-8e33-a0d3651f611f"},{"link_death_year":-22,"link_td_description":"王凤，字孝卿，西汉魏郡元城（今河北省大名县）人。济北王田安之后裔，王禁之子，汉成帝时外戚、大臣。","link_td_id":"Q10003974","link_td_number_id":301991,"people_name":"王鳳","people_name_jianti_auto":"王凤","people_xingming":"王凤","start_index":39,"tongjian_id":"91bbce0a-db0e-11ef-b1e8-a0d3651f611f"},{"link_death_year":-651,"link_td_description":"晋献公，姬姓，名佹諸，是春秋时代晋国君主，在位26年。攻灭虢國、虞國、魏國等国，史称其“并国十七，服国三十八”。","link_td_id":"Q10001049","link_td_number_id":38823,"people_name":"晉獻","people_name_jianti_auto":"晋献","people_xingming":"姬诡诸","start_index":207,"tongjian_id":"91be2e29-db0e-11ef-a262-a0d3651f611f","wl_zhushi":"[姬诡诸]"},{"link_death_year":-655,"link_td_description":"申生，姬姓，名申生，春秋时代人物。晋献公庶长子，齐姜所生，本是晋国太子，骊姬生下一子，取名奚齐，晋献公打算立奚齐为太子。之后骊姬与优施通奸，合谋陷害申生，申生不愿作乱而自杀。谥号恭太子、恭世子。","link_td_id":"Q10002489","link_td_number_id":658104,"people_name":"申生","people_name_jianti_auto":"申生","people_xingming":"申生","start_index":215,"tongjian_id":"91be2e2a-db0e-11ef-b99c-a0d3651f611f"},{"link_death_year":-22,"link_td_description":"王凤，字孝卿，西汉魏郡元城（今河北省大名县）人。济北王田安之后裔，王禁之子，汉成帝时外戚、大臣。","link_td_id":"Q10003974","link_td_number_id":301991,"people_name":"鳳","people_name_jianti_auto":"凤","people_xingming":"王凤","start_index":321,"tongjian_id":"91be4167-db0e-11ef-a80d-a0d3651f611f"},{"people_name":"鳳","people_name_jianti_auto":"凤","start_index":336,"tongjian_id":"91be4168-db0e-11ef-8030-a0d3651f611f"},{"people_name":"鳳","people_name_jianti_auto":"凤","start_index":350,"tongjian_id":"91be4169-db0e-11ef-8288-a0d3651f611f"},{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"欽","people_name_jianti_auto":"钦","people_xingming":"杜钦","start_index":353,"tongjian_id":"91be416a-db0e-11ef-ba6b-a0d3651f611f"},{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"欽","people_name_jianti_auto":"钦","start_index":367,"tongjian_id":"91be416b-db0e-11ef-a1ea-a0d3651f611f"},{"link_td_description":"杜钦，字子夏，祖籍南阳郡杜衍（今河南南阳西南），西汉杜陵县（今陕西省西安市一带）人。杜周之孙，杜延年的儿子，杜缓之弟。家富而一目盲，有“盲杜子夏”之称，人称“小冠杜子夏”。为人深博有谋略，曾任军武库令、议郎，后因病免官，优游不仕，寿终正寝。","link_td_id":"Q10019868","link_td_number_id":6034669,"people_name":"欽","people_name_jianti_auto":"钦","start_index":389,"tongjian_id":"91be416c-db0e-11ef-832e-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"5上自爲太子時，以好色聞；及卽位，皇太后詔采良家女以備後宮。大將軍武庫令杜欽說王鳳曰：「禮，一娶九女，所以廣嗣重祖也；娣姪雖缺不復補，所以養壽塞爭也。故后妃有貞淑之行，則胤嗣有賢聖之君；制度有威儀之節，則人君有壽考之福。廢而不由，則女德不厭；女德不厭，則壽命不究於高年。男子五十，好色未衰；婦人四十，容貌改前；以改前之容侍於未衰之年，而不以禮爲制，則其原不可救而後徠異態；後徠異態，則正后自疑而支庶有間適之心；是以晉獻被納讒之謗，申生蒙無罪之辜。今聖主富於春秋，未有適嗣，方鄕術入學，未親后妃之議。將軍輔政，宜因始初之隆，建九女之制，詳擇有行義之家，求淑女之質，毋必有聲色技能，爲萬世大法。夫少戒之在色，小卞之作，可爲寒心。唯將軍常以爲憂！」鳳白之太后，太后以爲故事無有；鳳不能自立法度，循故事而已。鳳素重欽，故置之莫府，國家政謀常與欽慮之，數稱達名士，裨正闕失；當世善政多出於欽者。","content_fanyi":"汉成帝在做太子时，就以好色闻名；等到即位以后，皇太后下诏挑选良家女子来充实后宫。大将军武库令杜钦劝说王凤道：“按照礼制，一次娶九名女子，是为了广续子嗣、尊崇祖先；九女中有人缺位也不再补充，是为了保养寿命、堵塞争宠。所以后妃有贞洁贤淑的品行，后嗣中就会有贤圣的君主；后宫制度有威严的节制，君主就会有长寿的福气。废弃而不遵循这些礼制，就会在女色上不知满足；在女色上不知满足，寿命就不能达到高年。男子到了五十岁，好色之心还没有衰退；妇人到了四十岁，容貌已经不同于从前；用已经改变的容貌去侍奉好色之心尚未衰退的男子，如果不用礼制来节制，那么他原本好色的心性就无法挽救，随后便会对妻子的态度发生变化；这种异样态度一旦出现，正宫皇后就会自生疑心，庶子宠妃也会萌生离间嫡子、争夺嫡位的心思；因此晋献公由于听信骊姬的谗言而蒙受毁谤，申生无罪却蒙冤被杀。如今圣上年纪正轻，还没有嫡子，正趋向道术、进于学问，还没有亲自参与有关后妃的计议。将军辅佐朝政，应当趁着即位之初的隆盛局面，建立九女之制，仔细选择有德行道义的人家，访求贤淑女子的品质，不一定非要追求美色与歌舞等技能，以此作为万世遵循的大法。年轻时所应戒慎的在于女色，《诗经·小雅》中的《小卞》一诗，讽刺周幽王废掉申后、改立褒姒而使太子遭到流放，实在令人寒心。希望将军经常以此为忧！”王凤把这些话禀告皇太后，皇太后认为九女之制没有先例可循；王凤不能自行建立法度，只是遵循旧例而已。王凤一向器重杜钦，所以把他安置在幕府中，国家的政务谋划常常与杜钦一起商量，杜钦多次举荐有名望的士人，补救改正政事中的缺漏过失；当世的善政大多出自杜钦的建议。","content_jianti_auto":"5上自为太子时，以好色闻；及即位，皇太后诏采良家女以备后宫。大将军武库令杜钦说王凤曰：「礼，一娶九女，所以广嗣重祖也；娣姪虽缺不复补，所以养寿塞争也。故后妃有贞淑之行，则胤嗣有贤圣之君；制度有威仪之节，则人君有寿考之福。废而不由，则女德不厌；女德不厌，则寿命不究于高年。男子五十，好色未衰；妇人四十，容貌改前；以改前之容侍于未衰之年，而不以礼为制，则其原不可救而后徕异态；后徕异态，则正后自疑而支庶有间适之心；是以晋献被纳谗之谤，申生蒙无罪之辜。今圣主富于春秋，未有适嗣，方鄕术入学，未亲后妃之议。将军辅政，宜因始初之隆，建九女之制，详择有行义之家，求淑女之质，毋必有声色技能，为万世大法。夫少戒之在色，小卞之作，可为寒心。唯将军常以为忧！」凤白之太后，太后以为故事无有；凤不能自立法度，循故事而已。凤素重钦，故置之莫府，国家政谋常与钦虑之，数称达名士，裨正阙失；当世善政多出于钦者。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，与其奏记王凤之书，及论王章之事，竟以王氏之篡，归祸始于...","context_before":"读","source_end_index":7,"source_paragraph_tongjian_id":"25c7f14b-9a01-4847-822f-4975fc7acca0","source_start_index":1,"source_text":"杜钦进谏之章"}],"title":"一 王氏篡位非始于杜钦党奸"}],"id":2346,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"91bbcdd8-db0e-11ef-935a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6夏，大旱。","content_fanyi":"夏季，发生大旱灾。","content_jianti_auto":"6夏，大旱。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2347,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"91be416d-db0e-11ef-be35-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"呼韩邪单于的继承人选择","decision_tongjian_id":"DECISION_91BE416EDB0E11EF9877A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"長，知兩翻；下同。閼，於乾翻；氏，音支；下同。","note_content_jianti_auto":"长，知两翻；下同。阏，于干翻；氏，音支；下同。","note_type":"hu_note","start_index":24,"tongjian_id":"91be416f-db0e-11ef-bd4f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91be4171-db0e-11ef-b3fd-a0d3651f611f"},{"people_name":"且麋胥","people_name_jianti_auto":"且麋胥","start_index":12,"tongjian_id":"91be4172-db0e-11ef-a1bb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：且，音子余翻；下且麋胥同。車，昌遮翻。","note_content_jianti_auto":"师古曰：且，音子余翻；下且麋胥同。车，昌遮翻。","note_type":"hu_note","start_index":34,"tongjian_id":"91be4170-db0e-11ef-ae4e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"少，詩照翻；下同。","note_content_jianti_auto":"少，诗照翻；下同。","note_type":"hu_note","start_index":48,"tongjian_id":"91be4173-db0e-11ef-9007-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。","note_content_jianti_auto":"复，扶又翻；下同。","note_type":"hu_note","start_index":150,"tongjian_id":"91be4174-db0e-11ef-82c1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91be4176-db0e-11ef-9eca-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：創，音初亮翻。艾，讀曰乂。","note_content_jianti_auto":"师古曰：创，音初亮翻。艾，读曰乂。","note_type":"hu_note","start_index":163,"tongjian_id":"91be4175-db0e-11ef-895c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"少，詩照翻；下同。","note_content_jianti_auto":"少，诗照翻；下同。","note_type":"hu_note","start_index":169,"tongjian_id":"91be4177-db0e-11ef-8a51-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91be4179-db0e-11ef-a656-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：一家，言親姊妹也。共子，兩人所生，恩慈無別也。","note_content_jianti_auto":"师古曰：一家，言亲姊妹也。共子，两人所生，恩慈无别也。","note_type":"hu_note","start_index":189,"tongjian_id":"91be4178-db0e-11ef-b9fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91be417b-db0e-11ef-a762-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：舍，謂棄置也。舍，讀曰捨。","note_content_jianti_auto":"师古曰：舍，谓弃置也。舍，读曰舍。","note_type":"hu_note","start_index":223,"tongjian_id":"91be417a-db0e-11ef-96ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91be417e-db0e-11ef-9ec1-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":15,"tongjian_id":"91be417f-db0e-11ef-a8ec-a0d3651f611f"},{"people_name":"呼韓邪","people_name_jianti_auto":"呼韩邪","start_index":27,"tongjian_id":"91be4180-db0e-11ef-bcbc-a0d3651f611f"},{"people_name":"復株累單于","people_name_jianti_auto":"复株累单于","start_index":52,"tongjian_id":"91be4181-db0e-11ef-bc94-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":18,"tongjian_id":"91be4182-db0e-11ef-956a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":34,"tongjian_id":"91be4183-db0e-11ef-9ce1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":39,"tongjian_id":"91be4184-db0e-11ef-b047-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：復，音服。累，力追翻。賢曰：匈奴謂孝爲若鞮。自呼韓邪降後，與漢親密，見漢帝諡常爲孝，慕之：至其子復株累單于以下，皆稱若鞮。","note_content_jianti_auto":"师古曰：复，音服。累，力追翻。贤曰：匈奴谓孝为若鞮。自呼韩邪降后，与汉亲密，见汉帝谥常为孝，慕之：至其子复株累单于以下，皆称若鞮。","note_type":"hu_note","start_index":272,"tongjian_id":"91be417d-db0e-11ef-81aa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":0,"tongjian_id":"91be4187-db0e-11ef-93c5-a0d3651f611f"},{"people_name":"須卜氏","people_name_jianti_auto":"须卜氏","start_index":4,"tongjian_id":"91be4188-db0e-11ef-a57f-a0d3651f611f"},{"people_name":"當于","people_name_jianti_auto":"当于","start_index":14,"tongjian_id":"91be4189-db0e-11ef-9b8c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":24,"tongjian_id":"91be418a-db0e-11ef-9163-a0d3651f611f"},{"people_name":"須卜","people_name_jianti_auto":"须卜","start_index":28,"tongjian_id":"91be418b-db0e-11ef-bc9d-a0d3651f611f"},{"people_name":"當于","people_name_jianti_auto":"当于","start_index":31,"tongjian_id":"91be418c-db0e-11ef-aac1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":8,"tongjian_id":"91be418d-db0e-11ef-a2af-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":18,"tongjian_id":"91be418e-db0e-11ef-ac4c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文穎曰：須卜氏，匈奴貴族也。當于，亦匈奴大族也。師古曰：須卜、當于，皆其夫家氏族。","note_content_jianti_auto":"文颖曰：须卜氏，匈奴贵族也。当于，亦匈奴大族也。师古曰：须卜、当于，皆其夫家氏族。","note_type":"hu_note","start_index":338,"tongjian_id":"91be4186-db0e-11ef-bec1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"左賢王","official_note":"左賢王是匈奴官職，通常負責統領左翼軍隊，地位僅次於單于，此處表示且麋胥被任命為此職。","official_rank":"未知","source_snippet":"且麋胥爲左賢王","start_index":279,"tongjian_id":"94b21a65-f919-4139-b69f-3f858c19df86"},{"confidence":0.95,"official_category":"军事指挥","official_name":"左谷蠡王","official_note":"左谷蠡王是匈奴官職，負責管理左翼部落或軍事事務，此處表示且莫車被任命為此職。","official_rank":"未知","source_snippet":"且莫車爲左谷蠡王","start_index":288,"tongjian_id":"7eb232b1-f48b-4a35-bf5f-197a49dddcce"},{"confidence":0.95,"official_category":"军事指挥","official_name":"右賢王","official_note":"右賢王是匈奴官職，通常負責統領右翼軍隊，地位僅次於單于，此處表示囊知牙斯被任命為此職。","official_rank":"未知","source_snippet":"囊知牙斯爲右賢王","start_index":297,"tongjian_id":"557fe19d-fe01-41ba-9ddb-a34513743e48"}],"ExtRef_Children_people":[{"link_death_year":-31,"link_td_description":"呼韩邪单于（？－前31年），名稽侯狦，是西汉后期匈奴单于之一，挛鞮氏，虚闾权渠单于的儿子。","link_td_id":"Q10000775","link_td_number_id":356590,"people_name":"呼韓邪單于","people_name_jianti_auto":"呼韩邪单于","people_xingming":"挛鞮稽侯狦","start_index":3,"tongjian_id":"91be418f-db0e-11ef-b907-a0d3651f611f","wl_zhushi":"[挛鞮稽侯狦]"},{"people_name":"左伊秩訾","people_name_jianti_auto":"左伊秩訾","people_xingming":"左伊秩訾","start_index":9,"tongjian_id":"91be4190-db0e-11ef-b23d-a0d3651f611f"},{"link_death_year":-8,"link_td_description":"车牙单于，全称为车牙若鞮单于，挛鞮氏，名且莫车，是西汉末