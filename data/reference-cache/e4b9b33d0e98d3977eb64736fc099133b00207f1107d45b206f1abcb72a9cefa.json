icial_note":"秦王指秦國君主，戰國時期秦國的最高統治者，在文中是秦國的政治決策者，發起稱帝行動。","official_rank":"王爵","source_snippet":"秦王稱西帝","start_index":4,"tongjian_id":"a9a2d109-83d7-4d80-981e-9292f719fa2f"},{"confidence":0.95,"official_category":"地方行政","official_name":"齊王","official_note":"齊王指齊國君主，戰國時期齊國的最高統治者，在文中是秦國試圖聯合的對象，最終接受稱帝但很快放棄。","official_rank":"王爵","source_snippet":"立齊王爲東帝","start_index":15,"tongjian_id":"6aa012ee-5957-4a9b-aa9b-4294fbc91598"},{"confidence":0.95,"official_category":"地方行政","official_name":"齊王","official_note":"齊王指齊國君主，在文中是對話的發起者，詢問蘇代關於秦國稱帝的意見。","official_rank":"王爵","source_snippet":"齊王曰","start_index":32,"tongjian_id":"c234aea3-2a9a-41a2-ae49-fcb5a8d5fe5c"},{"confidence":0.95,"official_category":"地方行政","official_name":"齊王","official_note":"齊王指齊國君主，在文中是決策者，聽從蘇代的建議，接受稱帝但僅維持兩天。","official_rank":"王爵","source_snippet":"齊王從之","start_index":155,"tongjian_id":"64c356d6-5ed2-45d2-b827-b051e6ab8ea2"},{"confidence":0.95,"official_category":"地方行政","official_name":"秦王","official_note":"秦王指秦國君主，在文中是政治行動者，跟隨齊王放棄帝號，恢復稱王。","official_rank":"王爵","source_snippet":"秦王亦去帝","start_index":172,"tongjian_id":"7baa0fa5-156b-4668-a255-fb996bd29a85"}],"ExtRef_Children_people":[{"link_birth_year":-325,"link_death_year":-251,"link_td_description":"秦昭襄王，嬴姓，名稷，秦惠文王之子，秦悼武王之弟，战国时期秦国君主。","link_td_id":"Q10001807","link_td_number_id":176297,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴稷","start_index":6,"tongjian_id":"8ca1d4ce-db0e-11ef-8a73-a0d3651f611f","wl_zhushi":"[嬴稷]"},{"people_name":"西帝","people_name_jianti_auto":"西帝","people_xingming":"null","start_index":9,"tongjian_id":"8ca1d4cf-db0e-11ef-b2aa-a0d3651f611f"},{"link_birth_year":-323,"link_death_year":-284,"link_td_description":"齐湣王，妫姓，田氏，名地，一名遂，战国时期齐国君主。在位十七年，屡建武功，破秦、燕诸国，制楚，灭宋。但也是其在位期间遭到五国合纵攻齐，齐国几乎遭到灭亡。","link_td_id":"Q10000622","link_td_number_id":320023,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田地","start_index":15,"tongjian_id":"8ca1d4d0-db0e-11ef-8a97-a0d3651f611f","wl_zhushi":"[田地]"},{"people_name