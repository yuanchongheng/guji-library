n_id":"8ca1d507-db0e-11ef-9081-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徐廣曰：「杜」，一作「梗」。按班志，梗陽在太原郡榆次縣界，杜陽縣屬扶風，註云：杜水南入渭。詩曰「自土」。師古註云：緜詩：自土、沮、漆。齊詩作「自杜」，言公劉自狄而來居杜與沮、漆之地。又云：扶風栒邑有豳鄕，公劉所都。審爾，則杜陽近栒邑，接上郡、北地之境。趙地西至上郡膚施，或者其時倂有杜陽歟！沮，七余翻。旬，須倫翻。豳，彼貧翻。","note_content_jianti_auto":"徐广曰：「杜」，一作「梗」。按班志，梗阳在太原郡榆次县界，杜阳县属扶风，注云：杜水南入渭。诗曰「自土」。师古注云：緜诗：自土、沮、漆。齐诗作「自杜」，言公刘自狄而来居杜与沮、漆之地。又云：扶风栒邑有豳鄕，公刘所都。审尔，则杜阳近栒邑，接上郡、北地之境。赵地西至上郡肤施，或者其时倂有杜阳欤！沮，七余翻。旬，须伦翻。豳，彼贫翻。","note_type":"hu_note","start_index":9,"tongjian_id":"8ca1d4e9-db0e-11ef-b0aa-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8ca1d50e-db0e-11ef-8295-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":3,"tongjian_id":"8ca1d50f-db0e-11ef-bb77-a0d3651f611f"},{"place_name":"杜陽","place_name_jianti_auto":"杜阳","place_note":"梗阳，山西清徐","resolved_place_entity_id":7396,"start_index":6,"tongjian_id":"8ca1d510-db0e-11ef-a74a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"2秦攻趙，拔杜陽。","content_fanyi":"秦国攻打赵国，攻下杜阳。","content_jianti_auto":"2秦攻赵，拔杜阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":328,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8ca1d4e8-db0e-11ef-9ec9-a0d3651f611f"}],"reign_name":"二十七年","reign_name_jianti_auto":"二十七年","start_index":9,"tongjian_id":"8ca1d4bd-db0e-11ef-919b-a0d3651f611f","year_anno":"（癸酉、前二八八）","year_int":-288},"message":"success","success":true}