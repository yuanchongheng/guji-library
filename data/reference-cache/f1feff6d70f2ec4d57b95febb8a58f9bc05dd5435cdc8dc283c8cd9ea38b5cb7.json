汝阳县","start_index":48,"tongjian_id":"8cad5f70-db0e-11ef-ad91-a0d3651f611f"},{"place_name":"豫州","place_name_jianti_auto":"豫州","start_index":61,"tongjian_id":"8cad5f71-db0e-11ef-aeaa-a0d3651f611f"},{"place_name":"吳房縣","place_name_jianti_auto":"吴房县","start_index":63,"tongjian_id":"8cad5f72-db0e-11ef-aa55-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，安成縣屬汝南郡。司馬彪志作「安城」。時魏地南至汝南，秦自武關出兵攻拔之。括地志：安城在豫州汝陽縣東南十七里。一曰：在豫州吳房縣東南。穰，人羊翻。","note_content_jianti_auto":"班志，安成县属汝南郡。司马彪志作「安城」。时魏地南至汝南，秦自武关出兵攻拔之。括地志：安城在豫州汝阳县东南十七里。一曰：在豫州吴房县东南。穰，人羊翻。","note_type":"hu_note","start_index":14,"tongjian_id":"8cad5f65-db0e-11ef-9b05-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8cad5f77-db0e-11ef-a4f7-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":3,"tongjian_id":"8cad5f78-db0e-11ef-9c6c-a0d3651f611f"},{"place_name":"穰","place_name_jianti_auto":"穰","resolved_place_entity_id":2053,"start_index":6,"tongjian_id":"8cad5f79-db0e-11ef-9e23-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":8,"tongjian_id":"8cad5f7a-db0e-11ef-9166-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":10,"tongjian_id":"8cad5f7b-db0e-11ef-84ee-a0d3651f611f"},{"place_name":"安城","place_name_jianti_auto":"安城","place_note":"河南原阳西","resolved_place_entity_id":4483,"start_index":11,"tongjian_id":"8cad5f7c-db0e-11ef-854d-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","place_note":"河南開封","resolved_place_entity_id":236,"start_index":16,"tongjian_id":"8cae5d5f-db0e-11ef-ab0e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"《括地志》原武有安城。《史记》：信陵君谓魏安釐王，通韩上...","context_before":"安城[在县东南二十里。《志》云：周所置城。","source_end_index":49,"source_paragraph_tongjian_id":"4eabb0f9-de63-5b9c-b7e5-92c32ff356cf","source_start_index":21,"source_text":"《史记·魏世家》：昭王十三年，秦拔我安城，兵至大梁而去。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"1秦、趙會于穰。秦拔魏安城，兵至大梁而還。","content_fanyi":"秦昭襄王与赵惠文王在穰地会盟。秦军攻取魏国安城，进军到大梁城后才班师返回。","content_jianti_auto":"1秦、赵会于穰。秦拔魏安城，兵至大梁而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":347,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8cad5f64-db0e-11ef-a526-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":12,"tongjian_id":"8cae5d62-db0e-11ef-9a0a-a0d3651f611f"},{"people_name":"康","people_name_jianti_auto":"康","start_index":25,"tongjian_id":"8cae5d63-db0e-11ef-a6fe-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":33,"tongjian_id":"8cae5d64-db0e-11ef-8a6d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":46,"tongjian_id":"8cae5d65-db0e-11ef-82e8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"淖，女敎翻。湣，讀曰閔。徐廣曰：敫，音躍，一音皎；康：吉了切。余按班書·王子侯表有「敫」字，師古曰：古穆字；今從之。傭，雇身爲人力作。爲，于僞翻。","note_content_jianti_auto":"淖，女教翻。湣，读曰闵。徐广曰：敫，音跃，一音皎；康：吉了切。余按班书·王子侯表有「敫」字，师古曰：古穆字；今从之。佣，雇身为人力作。为，于伪翻。","note_type":"hu_note","start_index":23,"tongjian_id":"8cae5d61-db0e-11ef-8fca-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"竊，私也，私爲之而不使人知。衣，於旣翻。食，祥吏翻。","note_content_jianti_auto":"窃，私也，私为之而不使人知。衣，于既翻。食，祥吏翻。","note_type":"hu_note","start_index":47,"tongjian_id":"8cae5d67-db0e-11ef-b2a3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閭，里門也。周禮：二十五家爲閭。","note_content_jianti_auto":"闾，里门也。周礼：二十五家为闾。","note_type":"hu_note","start_index":97,"tongjian_id":"8cae5d68-db0e-11ef-8fac-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"袒右肩也。","note_content_jianti_auto":"袒右肩也。","note_type":"hu_note","start_index":149,"tongjian_id":"8cae5d6b-db0e-11ef-9586-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":8,"chapter_name":"评论篇第八","chenzhu_chapter":"注中有论，由来尚矣，毛公之训《诗》，安国之传《书》，郑君之释《礼》，王弼之解《易》，皆有时参以论议。马、班而降，史论尤繁，荀悦曰论，陈寿曰评，裴松之引孙盛、徐众之书，亦皆以评为号，则评论实注家之一体也。胡注《通鉴》，评论亦众，此篇之外，散见于《史事》各篇者，大抵皆评论也。自清代文字狱迭兴，学者避之，始群趋于考据，以空言为大戒。不知言为心声，觇古人者宜莫善于此，胡明仲之《管见》，王船山之《鉴论》，皆足代表一时言议，岂得概以空言视之，《通鉴注》中之评论，亦犹是也。","chenzhu_index_in_chapter":1,"chenzhu_text":"此深有感于帝昺厓山之败也。魏夏侯玄太初撰《乐毅论》，见右军帖，文中子读而善之，曰：“仁哉乐毅！善藏其用，智哉太初！善发其蕴。”身之驳之，不怪张弘範之不为乐毅，而恨宋之无田单也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH08-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"樂毅","people_name_jianti_auto":"乐毅","start_index":2,"tongjian_id":"8cae5d6e-db0e-11ef-8632-a0d3651f611f"},{"people_name":"法章","people_name_jianti_auto":"法章","start_index":12,"tongjian_id":"8cae5d6f-db0e-11ef-86bb-a0d3651f611f"},{"people_name":"田單","people_name_jianti_auto":"田单","start_index":20,"tongjian_id":"8cae5d70-db0e-11ef-9f08-a0d3651f611f"},{"people_name":"法章","people_name_jianti_auto":"法章","start_index":41,"tongjian_id":"8cae5d71-db0e-11ef-a918-a0d3651f611f"},{"people_name":"樂毅","people_name_jianti_auto":"乐毅","start_index":66,"tongjian_id":"8cae5d72-db0e-11ef-b8d2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":5,"tongjian_id":"8cae5d73-db0e-11ef-877e-a0d3651f611f"},{"place_name":"臨淄","place_name_jianti_auto":"临淄","start_index":9,"tongjian_id":"8cae5d74-db0e-11ef-b773-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":18,"tongjian_id":"8cae5d75-db0e-11ef-8375-a0d3651f611f"},{"place_name":"安平","place_name_jianti_auto":"安平","start_index":23,"tongjian_id":"8cae5d76-db0e-11ef-bd8f-a0d3651f611f"},{"place_name":"卽墨","place_name_jianti_auto":"即墨","start_index":26,"tongjian_id":"8cae5d77-db0e-11ef-9f6c-a0d3651f611f"},{"place_name":"莒","place_name_jianti_auto":"莒","start_index":53,"tongjian_id":"8cae5d78-db0e-11ef-9371-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"其時樂毅以燕中軍鎭臨淄，法章已立而保莒。田單自安平保卽墨，奔敗之餘，猶可置之不問，法章布告國中，自言已立在莒，可安坐而不問乎！後人論樂毅，以爲善藏其用，吾未敢以爲然也。","note_content_jianti_auto":"其时乐毅以燕中军镇临淄，法章已立而保莒。田单自安平保即墨，奔败之余，犹可置之不问，法章布告国中，自言已立在莒，可安坐而不问乎！后人论乐毅，以为善藏其用，吾未敢以为然也。","note_type":"hu_note","start_index":224,"tongjian_id":"8cae5d6d-db0e-11ef-bf8d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"太史","official_note":"太史是古代掌管史书、天文、历法等事务的官职，此处指莒地的太史敫，法章在其家为佣，用于说明法章的藏身之处。","official_rank":"未知","source_snippet":"莒太史敫家傭","start_index":12,"tongjian_id":"f6e2350b-84a8-4149-8cad-b9e598c3969f"},{"confidence":0.95,"official_category":"地方行政","official_name":"齊王","official_note":"齊王是齐国的君主，此处指法章被立为齐王，以保莒城拒燕，用于描述政治事件中的职位确立。","official_rank":"诸侯王","source_snippet":"遂立以爲齊王","start_index":172,"tongjian_id":"8a6deef4-8a80-484b-a67e-6c57e25778a1"}],"ExtRef_Children_people":[{"link_death_year":-283,"link_td_descriptio