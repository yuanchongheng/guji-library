{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（壬子、前二四九）","note_content_jianti_auto":"（壬子、前二四九）","note_type":"hu_note","start_index":0,"tongjian_id":"8d216f19-db0e-11ef-b88e-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相國","official_note":"相國是秦國及後世中央政府的最高行政長官，掌管國政，此處呂不韋擔任相國，標誌其權力達到頂峰，在《資治通鑑》中常作為重要職位出現。","official_rank":"未知","source_snippet":"呂不韋爲相國","start_index":1,"tongjian_id":"03d6542d-3b5e-445e-b1da-5127a57650ed"}],"ExtRef_Children_people":[{"link_death_year":-235,"link_td_description":"吕不韦，姜姓，吕氏。中国战国时代政治人物，卫国濮阳（今河南濮阳南）人，初为大商人，后来成为秦相，封文信侯，在秦为相十三年。广招门客以「兼儒墨，合名法」为思想中心，合力编撰《吕氏春秋》，有系统性地提出自己的政治主张，后为先秦杂家代表人物之一。执政时曾攻取周、赵、卫的土地，立三川、太原、东郡，对秦王政兼并六国的事业有重大贡献。后因嫪毐集团叛乱事受牵连，被免除相邦职务，出居河南封地。不久，秦王政下令将其流放至蜀（今四川），不韦忧惧交加，于是在三川郡（今河南洛阳）自鸩而亡。","link_td_id":"Q10000130","link_td_number_id":5852,"people_name":"呂不韋","people_name_jianti_auto":"吕不韦","people_xingming":"吕不韦","start_index":1,"tongjian_id":"8d216f1c-db0e-11ef-8d17-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[{"title":"秦灭东周之战","tongjian_id":"war_N0537"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1呂不韋爲相國。","content_fanyi":"吕不韦出任秦国相国。","content_jianti_auto":"1吕不韦为相国。","dtjl_paragraph_links":[],"dtjl_references":[],"id":452,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d216f1a-db0e-11ef-b999-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"皇甫謐","people_name_jianti_auto":"皇甫谧","start_index":0,"tongjian_id":"8d23bddd-db0e-11ef-824a-a0d3651f611f"},{"people_name":"后稷","people_name_jianti_auto":"后稷","start_index":25,"tongjian_id":"8d23bdde-db0e-11ef-abeb-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":33,"tongjian_id":"8d23bddf-db0e-11ef-a810-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":5,"tongjian_id":"8d23bde0-db0e-11ef-8ae4-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":19,"tongjian_id":"8d23bde1-db0e-11ef-aa4a-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":54,"tongjian_id":"8d23bde2-db0e-11ef-826a-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":61,"tongjian_id":"8d23bde3-db0e-11ef-95ab-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":68,"tongjian_id":"8d23bde4-db0e-11ef-adb4-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":72,"tongjian_id":"8d23bde5-db0e-11ef-bc70-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":98,"tongjian_id":"8d23bde6-db0e-11ef-a30f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"皇甫謐曰：周凡三十七王，八百六十七年。周有天下，祀后稷以配天，宗祀文王於明堂以配上帝，宗廟血食八百六十餘年。西周已亡，猶幸東周能守其祀，東周又爲秦所滅，則盡不祀矣。索隱曰：旣，盡也。日食盡曰旣。言周祚盡滅，無主祭祀。","note_content_jianti_auto":"皇甫谧曰：周凡三十七王，八百六十七年。周有天下，祀后稷以配天，宗祀文王于明堂以配上帝，宗庙血食八百六十余年。西周已亡，犹幸东周能守其祀，东周又为秦所灭，则尽不祀矣。索隐曰：既，尽也。日食尽曰既。言周祚尽灭，无主祭祀。","note_type":"hu_note","start_index":35,"tongjian_id":"8d23bddc-db0e-11ef-b708-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8d23bdea