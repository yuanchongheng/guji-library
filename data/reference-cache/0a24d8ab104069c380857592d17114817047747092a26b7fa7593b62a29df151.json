f611f"},{"place_name":"平陰縣","place_name_jianti_auto":"平阴县","start_index":123,"tongjian_id":"8d23be0b-db0e-11ef-b218-a0d3651f611f"},{"place_name":"洛州","place_name_jianti_auto":"洛州","start_index":128,"tongjian_id":"8d23be0c-db0e-11ef-b734-a0d3651f611f"},{"place_name":"洛陽縣","place_name_jianti_auto":"洛阳县","start_index":130,"tongjian_id":"8d23be0d-db0e-11ef-943c-a0d3651f611f"},{"place_name":"平津","place_name_jianti_auto":"平津","start_index":146,"tongjian_id":"8d23be0e-db0e-11ef-a281-a0d3651f611f"},{"place_name":"大河","place_name_jianti_auto":"大河","start_index":148,"tongjian_id":"8d23be0f-db0e-11ef-81de-a0d3651f611f"},{"place_name":"河陰","place_name_jianti_auto":"河阴","start_index":158,"tongjian_id":"8d23be10-db0e-11ef-ba62-a0d3651f611f"},{"place_name":"偃師","place_name_jianti_auto":"偃师","place_note":"河南偃師","start_index":165,"tongjian_id":"8d23be11-db0e-11ef-bf29-a0d3651f611f"},{"place_name":"南亳","place_name_jianti_auto":"南亳","start_index":176,"tongjian_id":"8d23be12-db0e-11ef-a2ce-a0d3651f611f"},{"place_name":"西亳","place_name_jianti_auto":"西亳","start_index":181,"tongjian_id":"8d23be13-db0e-11ef-9731-a0d3651f611f"},{"place_name":"鞏","place_name_jianti_auto":"巩","place_note":"河南鞏縣","start_index":184,"tongjian_id":"8d23be14-db0e-11ef-8642-a0d3651f611f"},{"place_name":"鞏伯國","place_name_jianti_auto":"巩伯国","start_index":187,"tongjian_id":"8d23be15-db0e-11ef-b4d4-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":191,"tongjian_id":"8d23be16-db0e-11ef-bc44-a0d3651f611f"},{"place_name":"緱氏","place_name_jianti_auto":"缑氏","place_note":"河南偃師縣南緱氏鎮","start_index":200,"tongjian_id":"8d23be17-db0e-11ef-80bb-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":203,"tongjian_id":"8d23be18-db0e-11ef-844e-a0d3651f611f"},{"place_name":"緱氏","place_name_jianti_auto":"缑氏","place_note":"河南偃師縣南緱氏鎮","start_index":214,"tongjian_id":"8d23be19-db0e-11ef-9c97-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":217,"tongjian_id":"8d23be1a-db0e-11ef-8283-a0d3651f611f"},{"place_name":"滑國","place_name_jianti_auto":"滑国","start_index":220,"tongjian_id":"8d23be1b-db0e-11ef-969d-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":228,"tongjian_id":"8d23be1c-db0e-11ef-8ea0-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":231,"tongjian_id":"8d23be1d-db0e-11ef-b6b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：河南縣故郟鄏地，周武王遷九鼎，周公營以爲都，是爲王城；平王居之。洛陽，周公遷殷民於此，是爲成周。師古曰：穀城，卽今新安。應劭曰：平陰，在平城北，故曰平陰。班志：河南郡之平縣，卽平城也。括地志曰：故穀城在洛州河南縣西北十八里苑中。河陰縣城本漢平陰縣，在洛州洛陽縣東北五十里。十三州志曰：在平津大河之南，魏文帝改曰河陰。劉昭曰：偃師，帝嚳所都。盤庚復南亳，是爲西亳。鞏，古鞏伯國，周之東，周公所居。緱氏，周大夫劉子邑。宋白曰：緱氏，春秋之滑國。已上七邑，漢皆屬河南郡。緱，工侯翻。郟，音夾。鄏，音辱。","note_content_jianti_auto":"班志：河南县故郏鄏地，周武王迁九鼎，周公营以为都，是为王城；平王居之。洛阳，周公迁殷民于此，是为成周。师古曰：谷城，即今新安。应劭曰：平阴，在平城北，故曰平阴。班志：河南郡之平县，即平城也。括地志曰：故谷城在洛州河南县西北十八里苑中。河阴县城本汉平阴县，在洛州洛阳县东北五十里。十三州志曰：在平津大河之南，魏文帝改曰河阴。刘昭曰：偃师，帝喾所都。盘庚复南亳，是为西亳。巩，古巩伯国，周之东，周公所居。缑氏，周大夫刘子邑。宋白曰：缑氏，春秋之滑国。已上七邑，汉皆属河南郡。缑，工侯翻。郏，音夹。鄏，音辱。","note_type":"hu_note","start_index":64,"tongjian_id":"8d23bde9-db0e-11ef-8a58-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相國","official_note":"相國是秦國的最高行政長官，負責輔佐君主處理國政，此處指秦莊襄王派遣相國率軍討伐東周君，顯示其在軍事指揮中的核心角色。","official_rank":"未知","source_snippet":"王使相國帥師討滅之","start_index":12,"tongjian_id":"8766609b-8830-40e9-a724-1ad68cc9807d"}],"ExtRef_Children_people":[{"people_name":"東周君","people_name_jianti_auto":"东周君","people_xingming":"东周君","start_index":1,"tongjian_id":"8d23be22-db0e-11ef-9421-a0d3651f611f"},{"people_name":"東周君","people_name_jianti_auto":"东周君","people_xingming":"东周君","start_index":22,"tongjian_id":"8d23be23-db0e-11ef-98c5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d23bdda-db0e-11ef-95fa-a0d3651f611f","pinyin":"gōu","source_anchor_text":"陰偃師鞏緱氏以河南","source_key":"baiyang_epub","start_index":61,"text":"緱","tongjian_id":"797ad8a5-1a12-5e84-9d31-7