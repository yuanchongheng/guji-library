n_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"評","people_name_jianti_auto":"评","start_index":2,"tongjian_id":"96d8c43a-db0e-11ef-8a26-a0d3651f611f"},{"people_name":"建","people_name_jianti_auto":"建","start_index":5,"tongjian_id":"96d8c43b-db0e-11ef-9ec7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂以評死爲建罪也。","note_content_jianti_auto":"谓以评死为建罪也。","note_type":"hu_note","start_index":147,"tongjian_id":"96d8c439-db0e-11ef-93af-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"供具，宴饗之具也。","note_content_jianti_auto":"供具，宴飨之具也。","note_type":"hu_note","start_index":176,"tongjian_id":"96d8c43c-db0e-11ef-9012-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"輔國侯","people_name_jianti_auto":"辅国侯","start_index":10,"tongjian_id":"96d8c43e-db0e-11ef-b8f9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西域","place_name_jianti_auto":"西域","start_index":4,"tongjian_id":"96d8c43f-db0e-11ef-8648-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按前書，西域諸國各置輔國侯、左右將。復，扶又翻。僰，蒲北翻。","note_content_jianti_auto":"按前书，西域诸国各置辅国侯、左右将。复，扶又翻。僰，蒲北翻。","note_type":"hu_note","start_index":296,"tongjian_id":"96d8c43d-db0e-11ef-8701-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"輸僰","people_name_jianti_auto":"输僰","start_index":14,"tongjian_id":"96d987d2-db0e-11ef-bd23-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"于窴國","place_name_jianti_auto":"于窴国","start_index":1,"tongjian_id":"96d987d3-db0e-11ef-899d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"開于窴國人自新之路，仍募使斬輸僰也。僰，蒲北翻。","note_content_jianti_auto":"开于窴国人自新之路，仍募使斩输僰也。僰，蒲北翻。","note_type":"hu_note","start_index":401,"tongjian_id":"96d987d1-db0e-11ef-993b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":2,"tongjian_id":"96d987d6-db0e-11ef-abae-a0d3651f611f"},{"place_name":"西域","place_name_jianti_auto":"西域","start_index":10,"tongjian_id":"96d987d7-db0e-11ef-ae5a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言漢之威令不復行於西域。","note_content_jianti_auto":"史言汉之威令不复行于西域。","note_type":"hu_note","start_index":436,"tongjian_id":"96d987d5-db0e-11ef-b25b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"西域長史","official_note":"西域長史是漢朝在西域地區設置的行政長官，負責管理西域事務、維護漢朝在西域的統治。在《資治通鑒》此段中，王敬和趙評先後擔任此職，負責處理于窴國事務，體現了漢朝對西域的控制。","official_rank":"未知","source_snippet":"西域長史王敬爲于窴所殺","start_index":8,"tongjian_id":"3362aed9-99a5-4f3a-b163-2859c72107f9"},{"confidence":0.95,"official_category":"地方行政","official_name":"敦煌太守","official_note":"敦煌太守是漢朝敦煌郡的最高行政長官，負責郡內民政、軍事等事務。在此段中，馬達和宋亮先後擔任此職，馬達命令王敬調查于窴事，後因王敬被殺欲出兵，但被皇帝制止；宋亮接任後處理于窴後續事宜，顯示了地方長官在邊疆事務中的角色。","official_rank":"郡守級","source_snippet":"以告敦煌太守馬達","start_index":67,"tongjian_id":"87480ac6-f060-4720-9867-7fd2ca5a715a"},{"confidence":0.9,"official_category":"地方行政","official_name":"長史","official_note":"此處的“長史”是“西域長史”的簡稱，指王敬接替趙評擔任西域長史一職。在上下文中，它與“西域長史”職能相同，負責西域事務，因此歸為同一官職。","official_rank":"未知","source_snippet":"會敬代爲長史","start_index":73,"tongjian_id":"abdca092-0288-4b2b-8fab-8403076aa29e"},{"confidence":0.9,"official_category":"文書行政","official_name":"主簿","official_note":"主簿是漢代官署中的文書官員，負責記錄、文書處理等事務。在此段中，秦牧作為拘彌王成國的主簿，隨王敬參與會談，並在衝突中持刀斬殺于窴王建，顯示了屬吏在特定情境下的行動。","official_rank":"低級屬吏","source_snippet":"時成國主簿秦牧隨敬在會","start_index":184,"tongjian_id":"1996fa1f-6457-4f1c-ac19-bacca0452ee8"},{"confidence":0.85,"official_category":"地方行政","official_name":"于窴侯","official_note":"于窴侯是于窴國的諸侯或貴族封號，可能指于窴國內的貴族或地方首領。在此段中，于窴侯與將領輸僰一起率兵攻擊王敬，反映了地方勢力對漢朝官員的反抗。","official_rank":"侯爵級","source_snippet":"于窴侯、將輸僰等遂會兵攻敬","start_index":212,"tongjian_id":"192ad5cf-ecdb-4e2d-98e0-3b6dd93a0b22"},{"confidence":0.8,"official_category":"軍事指揮","official_name":"將","official_note":"“將”在此處指將領或軍事指揮官，輸僰是于窴國的將領。在上下文中，輸僰作為軍事領導，率兵攻擊王敬並後來自立為王，體現了軍事角色在地方衝突中的作用。","official_rank":"未知","source_snippet":"于窴侯、將輸僰等遂會兵攻敬","start_index":217,"tongjian_id":"d8482989-e7dd-49e4-95e1-62d5ed31575b"},{"confidence":0.85,"official_category":"地方行政","official_name":"王","official_note":"此處的“王”指于窴國的國王，是一個地方政權的最高統治者職位。在段中，建原為于窴王，被殺後輸僰自立為王，但很快被國人殺死，顯示了王位更迭的動蕩。","official_rank":"國王級","source_snippet":"輸僰自立爲王","start_index":248,"tongjian_id":"c08fe200-a5e1-409c-8dd0-a39a6bb7734c"},{"confidence":0.95,"official_category":"地方行政","official_name":"敦煌太守","official_note":"此處再次提到敦煌太守，宋亮接替馬達擔任此職。他處理于窴後續事務，下令招募于窴人斬殺輸僰，但後來發現被騙而未能討伐，展示了地方長官在邊疆管理中的挑戰。","official_rank":"郡守級","source_snippet":"而以宋亮代爲敦煌太守","start_index":298,"tongjian_id":"0fd319f5-2436-441e-a871-3e75684be114"}],"ExtRef_Children_people":[{"people_name":"王敬","people_name_jianti_auto":"王敬","people_xingming":"王敬","start_index":10,"tongjian_id":"96d987d8-db0e-11ef-8cfc-a0d3651f611f"},{"people_name":"趙評","people_name_jianti_auto":"赵评","people_xingming":"赵评","start_index":24,"tongjian_id":"96d987d9-db0e-11ef-9fd9-a0d3651f611f"},{"people_name":"評","people_name_jianti_auto":"评","people_xingming":"赵评","start_index":34,"tongjian_id":"96d987de-db0e-11ef-ac18-a0d3651f611f"},{"people_name":"拘彌王","people_name_jianti_auto":"拘弥王","people_xingming":"成国","start_index":44,"tongjian_id":"96d987df-db0e-11ef-aee6-a0d3651f611f"},{"people_name":"成國","people_name_jianti_auto":"成国","people_xingming":"成国","start_index":47,"tongjian_id":"96d987e0-db0e-11ef-bff4-a0d3651f611f"},{"peo