te_type":"hu_note","start_index":36,"tongjian_id":"8bf40349-db0e-11ef-a489-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"威烈王","people_name_jianti_auto":"威烈王","start_index":7,"tongjian_id":"8bf4034d-db0e-11ef-8412-a0d3651f611f"},{"people_name":"襄子","people_name_jianti_auto":"襄子","start_index":13,"tongjian_id":"8bf4034e-db0e-11ef-8e1d-a0d3651f611f"},{"people_name":"趙桓子","people_name_jianti_auto":"赵桓子","start_index":20,"tongjian_id":"8bf4034f-db0e-11ef-aa4e-a0d3651f611f"},{"people_name":"獻侯","people_name_jianti_auto":"献侯","start_index":34,"tongjian_id":"8bf40350-db0e-11ef-a85d-a0d3651f611f"},{"people_name":"浣","people_name_jianti_auto":"浣","start_index":36,"tongjian_id":"8bf40351-db0e-11ef-b5ca-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記·六國表，威烈王元年，襄子卒；二年，趙桓子元年，卒；明年，國人立獻侯浣。「浣」，索隱作「晚」。卒，子恤翻；下同。","note_content_jianti_auto":"史记·六国表，威烈王元年，襄子卒；二年，赵桓子元年，卒；明年，国人立献侯浣。「浣」，索隐作「晚」。卒，子恤翻；下同。","note_type":"hu_note","start_index":58,"tongjian_id":"8bf4034c-db0e-11ef-8074-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"獻子","people_name_jianti_auto":"献子","start_index":11,"tongjian_id":"8bf40355-db0e-11ef-b8bb-a0d3651f611f"},{"people_name":"獻侯","people_name_jianti_auto":"献侯","start_index":15,"tongjian_id":"8bf40356-db0e-11ef-ab47-a0d3651f611f"},{"people_name":"威烈王","people_name_jianti_auto":"威烈王","start_index":22,"tongjian_id":"8bf40357-db0e-11ef-bdd7-a0d3651f611f"},{"people_name":"獻侯","people_name_jianti_auto":"献侯","start_index":28,"tongjian_id":"8bf40358-db0e-11ef-856b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":36,"tongjian_id":"8bf40359-db0e-11ef-bc42-a0d3651f611f"},{"place_name":"三晉","place_name_jianti_auto":"三晋","start_index":40,"tongjian_id":"8bf4035a-db0e-11ef-b11f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；又音如字。獻子，卽獻侯。六國表：威烈王三年，獻侯之元年。蓋分晉之後，三晉僭侯久矣。諡法：知質有聖曰獻。","note_content_jianti_auto":"复，扶又翻；又音如字。献子，即献侯。六国表：威烈王三年，献侯之元年。盖分晋之后，三晋僭侯久矣。谥法：知质有圣曰献。","note_type":"hu_note","start_index":96,"tongjian_id":"8bf40354-db0e-11ef-a692-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：有功安民曰烈；秉德尊業曰烈。","note_content_jianti_auto":"谥法：有功安民曰烈；秉德尊业曰烈。","note_type":"hu_note","start_index":106,"tongjian_id":"8bf4035d-db0e-11ef-bf58-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：學勤好問曰文；慈惠安民曰文。","note_content_jianti_auto":"谥法：学勤好问曰文；慈惠安民曰文。","note_type":"hu_note","start_index":122,"tongjian_id":"8bf42a8d-db0e-11ef-a696-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"威烈王","people_name_jianti_auto":"威烈王","start_index":21,"tongjian_id":"8bf42a90-db0e-11ef-9518-a0d3651f611f"},{"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","start_index":27,"tongjian_id":"8bf42a91-db0e-11ef-bdbe-a0d3651f611f"},{"people_name":"韓景侯","people_name_jianti_auto":"韩景侯","start_index":38,"tongjian_id":"8bf42a92-db0e-11ef-a211-a0d3651f611f"},{"people_name":"威烈王","people_name_jianti_auto":"威烈王","start_index":61,"tongjian_id":"8bf42a93-db0e-11ef-83bb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":74,"tongjian_id":"8bf42a94-db0e-11ef-99ee-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諡法：克定禍亂曰武；布義行剛曰景。六國表：威烈王二年，魏文侯斯元年；十八年，韓景侯虔元年。蓋其在國僭爵已久，不敢以通王室；威烈王遂因而命之，識者重爲周惜。通鑑於此序三家之世也。","note_content_jianti_auto":"谥法：克定祸乱曰武；布义行刚曰景。六国表：威烈王二年，魏文侯斯元年；十八年，韩景侯虔元年。盖其在国僭爵已久，不敢以通王室；威烈王遂因而命之，识者重为周惜。通鉴于此序三家之世也。","note_type":"hu_note","start_index":139,"tongjian_id":"8bf42a8f-db0e-11ef-bb46-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-409,"link_td_description":"赵献子，本名赵浣，是中国战国时期赵国的领袖，赵襄子赵毋恤长兄赵伯鲁之孙、赵周之子。","link_td_id":"Q10000665","link_td_number_id":334805,"people_name":"浣","people_name_jianti_auto":"浣","people_xingming":"赵浣","start_index":39,"tongjian_id":"8bf42a9d-db0e-11ef-8894-a0d3651f611f"},{"link_death_year":-409,"link_td_description":"赵献子，本名赵浣，是中国战国时期赵国的领袖，赵襄子赵毋恤长兄赵伯鲁之孙、赵周之子。","link_td_id":"Q10000665","link_td_number_id":334805,"people_name":"浣","people_name_jianti_auto":"浣","start_index":53,"tongjian_id":"8bf42aa1-db0e-11ef-a5da-a0d3651f611f"},{"link_death_year":-409,"link_td_description":"赵献子，本名赵浣，是中国战国时期赵国的领袖，赵襄子赵毋恤长兄赵伯鲁之孙、赵周之子。","link_td_id":"Q10000665","link_td_number_id":334805,"people_name":"浣","people_name_jianti_auto":"浣","start_index":86,"tongjian_id":"8bf42aa5-db0e-11ef-ad33-a0d3651f611f"},{"link_death_year":-409,"link_td_description":"赵献子，本名赵浣，是中国战国时期赵国的领袖，赵襄子赵毋恤长兄赵伯鲁之孙、赵周之子。","link_td_id":"Q10000665","link_td_number_id":334805,"people_name":"獻子","people_name_jianti_auto":"献子","people_xingming":"赵献子","start_index":93,"tongjian_id":"8bf42aa6-db0e-11ef-88c0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"襄子爲伯魯之不立也，有子五人，不肯置後。封伯魯之子於代，曰代成君，早卒；立其子浣爲趙氏後。襄子卒，弟桓子逐浣而自立；一年卒。趙氏之人曰：「桓子立非襄主意。」乃共殺其子，復迎浣而立之，是爲獻子。獻子生籍，是爲烈侯。魏斯者，魏桓子之孫也，是爲文侯。韓康子生武子；武子生虔，是爲景侯。","content_fanyi":"赵襄子因为哥哥伯鲁当年未能被父亲立为继承人，自己虽有五个儿子，却不肯立他们为继承人。他把伯鲁的儿子封在代地，号称代成君；代成君早死，又立代成君的儿子赵浣为赵氏继承人。赵襄子去世后，他的弟弟赵桓子（《史记》记载赵桓子是赵襄子的同母弟，《世本》记载赵桓子是赵襄子之子，目前大多同意后者）驱逐了赵浣，自立为赵氏主君；在位一年就死了。赵氏族人说：“桓子自立，并不是赵襄子主君的本意。”于是族人共同杀了桓子的儿子，又迎回赵浣立为赵氏之主，这就是赵献子。赵献子生赵籍，就是赵烈侯。魏斯，是魏桓子的孙子，就是魏文侯。韩康子生韩武子；韩武子生韩虔，就是韩景侯。","content_jianti_auto":"襄子为伯鲁之不立也，有子五人，不肯置后。封伯鲁之子于代，曰代成君，早卒；立其子浣为赵氏后。襄子卒，弟桓子逐浣而自立；一年卒。赵氏之人曰：「桓子立非襄主意。」乃共杀其子，复迎浣而立之，是为献子。献子生籍，是为烈侯。魏斯者，魏桓子之孙也，是为文侯。韩康子生武子；武子生虔，是为景侯。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"8bf4033f-db0e-11ef-a48f-a0d3651f611f","year_int":-403},"tongjian_id":"8bf4033f-db0e-11ef-a48f-a0d3651f611f"},"paragraph_order":1}],"page_size":7,"total_pages":1,"total_paragraphs":1},"profile":{"alias_list":["赵献侯","赵浣","赵献子"],"biography":"赵献子，本名赵浣，是中国战国时期赵国的领袖，赵襄子赵毋恤长兄赵伯鲁之孙、赵周之子。","death_year":-409,"link_td_id":"Q10000665","name":"赵献子","number_id":334805},"relationships":[{"direction":"forward","rank":"normal","relation_detail":"父亲，来源文本：赵周之子","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10000665","source_person_name":"赵献子","source_person_number_id":334805,"statement_id":"S-Q10000665-P100023-Q10010293","target_person_id":"Q10010293","target_person_name":"赵周","target_person_number_id":1010878},{"direction":"reverse","rank":"normal","relation_detail":"来源文本：原名赵籍，赵献侯之子。","relation_property_display_template":"{subject}的父是{value}","relation_property_id":"P100023","relation_property_label":"父","source_person_id":"Q10000666","source_person_name":"赵烈侯","source_person_number_id":334806,"statement_id":"S-Q10000666-P100023-Q10000665","target_person_id":"Q10000665","target_person_name":"赵献子","target_person_number_id":334805},{"direction":"forward","rank":"normal","relation_detail":"儿子，来源文本：其子赵籍（赵烈侯）","relation_property_display_template":"{subject}的子是{value}","relation_property_id":"P100025","relation_property_label":"子","source_person_id":"Q10000665","source_person_name":"赵献子","source_person_number_id":334805,"statement