eople_name":"鞠彭","people_name_jianti_auto":"鞠彭","start_index":65,"tongjian_id":"a09b0100-db0e-11ef-bd29-a0d3651f611f"},{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":77,"tongjian_id":"a09b0101-db0e-11ef-a6cd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"樂浪","place_name_jianti_auto":"乐浪","start_index":0,"tongjian_id":"a09b0102-db0e-11ef-b4cf-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"a09b0103-db0e-11ef-ace3-a0d3651f611f"},{"place_name":"樂浪","place_name_jianti_auto":"乐浪","start_index":35,"tongjian_id":"a09b0104-db0e-11ef-9d36-a0d3651f611f"},{"place_name":"冀陽","place_name_jianti_auto":"冀阳","start_index":38,"tongjian_id":"a09b0105-db0e-11ef-98b2-a0d3651f611f"},{"place_name":"營丘郡","place_name_jianti_auto":"营丘郡","start_index":41,"tongjian_id":"a09b0106-db0e-11ef-a193-a0d3651f611f"},{"place_name":"朝鮮","place_name_jianti_auto":"朝鲜","start_index":45,"tongjian_id":"a09b0107-db0e-11ef-8d6e-a0d3651f611f"},{"place_name":"武寧","place_name_jianti_auto":"武宁","start_index":48,"tongjian_id":"a09b0108-db0e-11ef-8ada-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":56,"tongjian_id":"a09b0109-db0e-11ef-8524-a0d3651f611f"},{"place_name":"遼西郡","place_name_jianti_auto":"辽西郡","start_index":57,"tongjian_id":"a09b010a-db0e-11ef-9651-a0d3651f611f"},{"place_name":"柳城縣","place_name_jianti_auto":"柳城县","start_index":60,"tongjian_id":"a09b010b-db0e-11ef-b9d0-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":71,"tongjian_id":"a09b010c-db0e-11ef-be46-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"樂浪，非漢古郡地也，慕容廆所置，見八十八卷愍帝建興元年。以五代志考之，樂浪、冀陽、營丘郡、朝鮮、武寧等縣，當盡在隋遼西郡柳城縣界。鞠彭率鄕人歸燕，見九十卷元帝太興二年。樂浪，音洛琅。","note_content_jianti_auto":"乐浪，非汉古郡地也，慕容廆所置，见八十八卷愍帝建兴元年。以五代志考之，乐浪、冀阳、营丘郡、朝鲜、武宁等县，当尽在隋辽西郡柳城县界。鞠彭率鄕人归燕，见九十卷元帝太兴二年。乐浪，音洛琅。","note_type":"hu_note","start_index":200,"tongjian_id":"a09b00fd-db0e-11ef-a7e1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f","pinyin":"jū","source_anchor_text":"樂浪太守鞠彭以境內","source_key":"baiyang_epub","start_index":178,"text":"鞠","tongjian_id":"d284e56c-fde3-585c-96c0-1671fdf37deb"}],"ExtRef_Children_places":[{"place_name":"營丘","place_name_jianti_auto":"营丘","resolved_place_entity_id":4989,"start_index":87,"tongjian_id":"a09b0123-db0e-11ef-a15b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"虎遣使四出，招誘民夷，燕成周內史崔燾、居就令游泓、武原令常霸、東夷校尉封抽、護軍宋晃等皆應之，凡得三十六城。泓，邃之兄子也。冀陽流寓之士共殺太守宋燭以降於趙。燭，晃之從兄也。營丘內史鮮于屈亦遣使降趙；武寧令廣平孫興曉諭吏民共收屈，數其罪而殺之，閉城拒守。朝鮮令昌黎孫泳帥衆拒趙。大姓王清等密謀應趙，泳收斬之；同謀數百人惶怖請罪，泳皆釋之，與同拒守。樂浪太守鞠彭以境內皆叛，選鄕里壯士二百餘人共還棘城。","content_fanyi":"石虎派遣使者四面出动，招诱百姓和夷人，前燕成周内史崔焘、居就县令游泓、武原县令常霸、东夷校尉封抽、护军宋晃等人都响应石虎，共取得三十六座城。游泓是游邃兄长的儿子。冀阳的侨居士人共同杀死太守宋烛，向后赵投降。宋烛是宋晃的堂兄。营丘内史鲜于屈也派使者向后赵投降；武宁县令、广平人孙兴明白晓谕官吏和百姓，一起收捕鲜于屈，列举他的罪状后将他杀死，然后关闭城门拒守。朝鲜县令、昌黎人孙泳率领士众抵御后赵军队。大姓王清等人密谋响应后赵，孙泳将他们收捕斩首；参与同谋的数百人惊惶恐惧，向孙泳请罪，孙泳把他们全部释放，不予追究，并与他们共同拒守。乐浪太守鞠彭因为境内士民都已背叛，挑选同乡壮士二百多人，一同返回棘城。","content_jianti_auto":"虎遣使四出，招诱民夷，燕成周内史崔焘、居就令游泓、武原令常霸、东夷校尉封抽、护军宋晃等皆应之，凡得三十六城。泓，邃之兄子也。冀阳流寓之士共杀太守宋烛以降于赵。烛，晃之从兄也。营丘内史鲜于屈亦遣使降赵；武宁令广平孙兴晓谕吏民共收屈，数其罪而杀之，闭城拒守。朝鲜令昌黎孙泳帅众拒赵。大姓王清等密谋应赵，泳收斩之；同谋数百人惶怖请罪，泳皆释之，与同拒守。乐浪太守鞠彭以境内皆叛，选鄕里壮士二百余人共还棘城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":8244,"path":"资治通鉴 : 卷第九十六 (晉紀十八) / 顯宗成皇帝中之下 / 咸康四年 / 第 15 段","reading_annotation_sources":[],"start_index":14,"tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f","year_int":338},"tongjian_id":"a09a658c-db0e-11ef-8533-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"營丘","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRe