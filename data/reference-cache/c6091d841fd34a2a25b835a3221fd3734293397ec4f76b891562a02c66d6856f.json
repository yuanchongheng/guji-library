ianti_auto":"襄平","start_index":57,"tongjian_id":"a7ec07b7-db0e-11ef-adaa-a0d3651f611f"},{"place_name":"新昌","place_name_jianti_auto":"新昌","start_index":60,"tongjian_id":"a7ec07b8-db0e-11ef-a09c-a0d3651f611f"},{"place_name":"平剛","place_name_jianti_auto":"平刚","start_index":63,"tongjian_id":"a7ec07b9-db0e-11ef-a8fa-a0d3651f611f"},{"place_name":"柳城","place_name_jianti_auto":"柳城","start_index":66,"tongjian_id":"a7ec07ba-db0e-11ef-9e86-a0d3651f611f"},{"place_name":"富平","place_name_jianti_auto":"富平","start_index":69,"tongjian_id":"a7ec07bb-db0e-11ef-aeae-a0d3651f611f"},{"place_name":"燕國","place_name_jianti_auto":"燕国","start_index":75,"tongjian_id":"a7ec07bc-db0e-11ef-82c0-a0d3651f611f"},{"place_name":"慕容","place_name_jianti_auto":"慕容","start_index":78,"tongjian_id":"a7ec07bd-db0e-11ef-9867-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","start_index":88,"tongjian_id":"a7ec07be-db0e-11ef-875c-a0d3651f611f"},{"place_name":"玄菟郡","place_name_jianti_auto":"玄菟郡","start_index":109,"tongjian_id":"a7ec07bf-db0e-11ef-801d-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","start_index":116,"tongjian_id":"a7ec07c0-db0e-11ef-8437-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志曰：後魏置營州於和龍城，領建德、冀陽、遼東、樂浪、營丘等郡，龍城、大興、永樂、帶方、定荒、石城、廣都、陽武、襄平、新昌、平剛、柳城、富平等縣。蓋燕國自慕容以來，分置郡縣於遼西，其後或省或倂，爲郡爲縣，皆不可考；如玄菟郡亦當置於遼西也。驃，匹妙翻。騎，奇寄翻。樂浪，音洛琅。菟，同都翻。","note_content_jianti_auto":"五代志曰：后魏置营州于和龙城，领建德、冀阳、辽东、乐浪、营丘等郡，龙城、大兴、永乐、带方、定荒、石城、广都、阳武、襄平、新昌、平刚、柳城、富平等县。盖燕国自慕容以来，分置郡县于辽西，其后或省或倂，为郡为县，皆不可考；如玄菟郡亦当置于辽西也。骠，匹妙翻。骑，奇寄翻。乐浪，音洛琅。菟，同都翻。","note_type":"hu_note","start_index":41,"tongjian_id":"a7ec07a6-db0e-11ef-ae8a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"營丘","place_name_jianti_auto":"营丘","resolved_place_entity_id":4989,"start_index":14,"tongjian_id":"a7ec07c3-db0e-11ef-95b2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"是也。高齐废平刚等县，以冀阳郡寄治龙城。隋初郡废。土垠，...","context_before":"...流人置成周郡，并州流人置唐国郡，又于平州界内置乐浪等郡。","source_end_index":506,"source_paragraph_tongjian_id":"9409ee79-7415-54cb-b99d-fda62f1a73ae","source_start_index":455,"source_text":"宋元嘉九年，魏主焘攻北燕和龙，不克。引兵西还，徙营丘、成周、辽东、乐浪、带方、玄菟六郡民三万家于幽州。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"九月，乙卯，魏主引兵西還，徙營丘、成周、遼東、樂浪、帶方、玄菟六郡民三萬家於幽州。","content_fanyi":"九月乙卯日，北魏国主拓跋焘率军向西返回，将营丘、成周、辽东、乐浪、带方、玄菟六郡百姓三万家迁往幽州。","content_jianti_auto":"九月，乙卯，魏主引兵西还，徙营丘、成周、辽东、乐浪、带方、玄菟六郡民三万家于幽州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11235,"path":"资治通鉴 : 卷第一百二十二 (宋紀四) / 太祖文皇帝上之下 / 九年 / 第 24 段","reading_annotation_sources":[],"start_index":23,"tongjian_id":"a7ec07a5-db0e-11ef-8cff-a0d3651f611f","year_int":432},"tongjian_id":"a7ec07a5-db0e-11ef-8cff-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"營丘"},"message":"success","success":true}