type":"hu_note","start_index":14,"tongjian_id":"8c451b01-db0e-11ef-8fde-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齧桑","place_name_jianti_auto":"啮桑","place_note":"江蘇沛縣西南","resolved_place_entity_id":5587,"start_index":11,"tongjian_id":"8c451b21-db0e-11ef-9a87-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、徐州（卷二十九）","excerpts":[{"context_after":"汉武帝《瓠子歌》：啮桑浮兮淮泗满。及塞决口，而梁、楚无水...","context_before":"啮桑亭[在县西南。徐广曰：梁与彭城间有啮桑。谓此地也。","source_end_index":52,"source_paragraph_tongjian_id":"18afb555-2c9a-5155-ad10-944e6a3ce351","source_start_index":27,"source_text":"战国周显王四十六年，秦张仪及齐、楚之相，会于啮桑。"}],"path":"南直方舆纪要/十四、徐州（卷二十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦張儀及齊、楚之相會齧桑。","content_fanyi":"秦国张仪与齐国、楚国的相在啮桑会盟。","content_jianti_auto":"1秦张仪及齐、楚之相会啮桑。","dtjl_paragraph_links":[],"dtjl_references":[],"id":212,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十六年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c451b00-db0e-11ef-97e3-a0d3651f611f","year_int":-323},"tongjian_id":"8c451b00-db0e-11ef-97e3-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"齧桑","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":21,"tongjian_id":"8c451b2c-db0e-11ef-b27a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":25,"tongjian_id":"8c451b2d-db0e-11ef-a003-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"齧，魚結翻。還，從宣翻，又音如字。免相，免秦相而相魏。相，息亮翻。","note_content_jianti_auto":"啮，鱼结翻。还，从宣翻，又音如字。免相，免秦相而相魏。相，息亮翻。","note_type":"hu_note","start_index":15,"tongjian_id":"8c451b2b-db0e-11ef-95e4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"晉桓叔","people_name_jianti_auto":"晋桓叔","start_index":13,"tongjian_id":"8c451b2f-db0e-11ef-b791-a0d3651f611f"},{"people_name":"漢武帝","people_name_jianti_auto":"汉武帝","start_index":21,"tongjian_id":"8c451b30-db0e-11ef-9332-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"曲沃","place_name_jianti_auto":"曲沃","start_index":7,"tongjian_id":"8c451b31-db0e-11ef-9aed-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":10,"tongjian_id":"8c451b32-db0e-11ef-8965-a0d3651f611f"},{"place_name":"聞喜","place_name_jianti_auto":"闻喜","start_index":26,"tongjian_id":"8c451b33-db0e-11ef-86a3-a0d3651f611f"},{"place_name":"絳州","place_name_jianti_auto":"绛州","start_index":35,"tongjian_id":"8c451b34-db0e-11ef-ab14-a0d3651f611f"},{"place_name":"桐鄕縣","place_name_jianti_auto":"桐鄕县","start_index":37,"tongjian_id":"8c451b35-db0e-11ef-b689-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":41,"tongjian_id":"8c451b36-db0e-11ef-92b9-a0d3651f611f"},{"place_name":"曲沃","place_name_jianti_auto":"曲沃","start_index":42,"tongjian_id":"8c451b37-db0e-11ef-8711-a0d3651f611f"},{"place_name":"平周","place_name_jianti_auto":"平周","start_index":52,"tongjian_id":"8c451b38-db0e-11ef-a425-a0d3651f611f"},{"place_name":"汾州","place_name_jianti_auto":"汾州","start_index":56,"tongjian_id":"8c451b39-db0e-11ef-8492-a0d3651f611f"},{"place_name":"介休縣","place_name_jianti_auto":"介休县","start_index":58,"tongjian_id":"8c451b3a-db0e-11ef-a6f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令，力丁翻。此曲沃在河東，晉桓叔所封之邑；漢武帝改名聞喜。史記正義曰：絳州桐鄕縣，晉曲沃邑。十三州志：古平周邑在汾州介休縣西四十里。","note_content_jianti_auto":"令，力丁翻。此曲沃在河东，晋桓叔所封之邑；汉武帝改名闻喜。史记正义曰：绛州桐鄕县，晋曲沃邑。十三州志：古平周邑在汾州介休县西四十里。","note_type":"hu_note","start_index":44,"tongjian_id":"8c451b2e-db0e-11ef-9fda-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齧桑","place_name_jianti_auto":"啮桑","place_note":"江蘇沛縣西南","resolved_place_entity_id":5587,"start_index":5,"tongjian_id":"8c451b3f-db0e-11ef-a3b9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"又赧王元年，秦复伐魏，取曲沃而归其入秦，谓之左邑。《水经...","context_before":"...，即曲沃也。又襄二十三年，齐纳晋栾盈于曲沃。《战国策》：","source_end_index":165,"source_paragraph_tongjian_id":"b31baa1c-4223-59a5-9bf9-6183270736ce","source_start_index":149,"source_text":"周显王四十六年，秦伐魏，取曲沃。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"汉置平周县，属西河郡。后汉因之。晋省。又《郡志》云：县东...","context_before":"...邑。又平周城，在县西四十里。《十三州志》：战国时魏邑也。","source_end_index":87,"source_paragraph_tongjian_id":"c01b21cf-e9f0-5319-b4fd-067d1a6fcb00","source_start_index":68,"source_text":"梁襄王十三年，秦取我曲沃、平周，即此。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦張儀自齧桑還而免相，相魏。欲令魏先事秦而諸侯效之；魏王不聽。秦王伐魏，取曲沃、平周，復陰厚張儀益甚。","content_fanyi":"秦国张仪从齧桑返回后，表面上被免去国相之职，改到魏国任相。他想让魏国率先事奉秦国，以便各国诸侯仿效；魏王不肯听从。秦王于是发兵攻打魏国，夺取曲沃、平周两邑，又暗中更加厚待张仪。","content_jianti_auto":"1秦张仪自啮桑还而免相，相魏。欲令魏先事秦而诸侯效之；魏王不听。秦王伐魏，取曲沃、平周，复阴厚张仪益甚。","dtjl_paragraph_links":[],"dtjl_references":[],"id":214,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十七年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c451b2a-db0e-11ef-b1a0-a0d3651f611f","year_int":-322},"tongjian_id":"8c451b2a-db0e-11ef-b1a0-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"齧桑"},"message":"success","success":true}