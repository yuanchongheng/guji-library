{"data":{"current_mention_tongjian_id":"8c08f897-db0e-11ef-95af-a0d3651f611f","current_paragraph_tongjian_id":"8c08f892-db0e-11ef-8195-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"霸先","people_name_jianti_auto":"霸先","start_index":4,"tongjian_id":"b1838c66-db0e-11ef-b2b1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"長城縣","place_name_jianti_auto":"长城县","start_index":0,"tongjian_id":"b1838c67-db0e-11ef-a199-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":14,"tongjian_id":"b1838c68-db0e-11ef-9272-a0d3651f611f"},{"place_name":"烏程","place_name_jianti_auto":"乌程","start_index":21,"tongjian_id":"b1838c69-db0e-11ef-830a-a0d3651f611f"},{"place_name":"長城縣","place_name_jianti_auto":"长城县","start_index":24,"tongjian_id":"b1838c6a-db0e-11ef-83e3-a0d3651f611f"},{"place_name":"吳興郡","place_name_jianti_auto":"吴兴郡","start_index":29,"tongjian_id":"b1838c6b-db0e-11ef-9aab-a0d3651f611f"},{"place_name":"湖州","place_name_jianti_auto":"湖州","start_index":34,"tongjian_id":"b1838c6c-db0e-11ef-a77f-a0d3651f611f"},{"place_name":"長興縣","place_name_jianti_auto":"长兴县","start_index":36,"tongjian_id":"b1838c6d-db0e-11ef-b6e0-a0d3651f611f"},{"place_name":"湖州","place_name_jianti_auto":"湖州","start_index":43,"tongjian_id":"b1838c6e-db0e-11ef-93af-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"長城縣，霸先與其宗族世居之。晉太康三年，分烏程立長城縣，屬吳興郡，今湖州長興縣是也，在湖州西北七十里。蒨，七見翻。","note_content_jianti_auto":"长城县，霸先与其宗族世居之。晋太康三年，分乌程立长城县，属吴兴郡，今湖州长兴县是也，在湖州西北七十里。蒨，七见翻。","note_type":"hu_note","start_index":52,"tongjian_id":"b1838c65-db0e-11ef-bcd2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：典略作「韋載」。今從梁、陳書。今按典略若作「韋載」，則與梁、陳書同，不須考異矣。","note_content_jianti_auto":"考异曰：典略作「韦载」。今从梁、陈书。今按典略若作「韦载」，则与梁、陈书同，不须考异矣。","note_type":"hu_note","start_index":81,"tongjian_id":"b1838c6f-db0e-11ef-b37b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"僧智","people_name_jianti_auto":"僧智","start_index":9,"tongjian_id":"b1838c78-db0e-11ef-be8c-a0d3651f611f"},{"people_name":"任約","people_name_jianti_auto":"任约","start_index":12,"tongjian_id":"b1838c79-db0e-11ef-82ca-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：南史云，「僧智奔任約。」今從典略。","note_content_jianti_auto":"考异曰：南史云，「僧智奔任约。」今从典略。","note_type":"hu_note","start_index":101,"tongjian_id":"b1838c77-db0e-11ef-ae2b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻；下同。","note_content_jianti_auto":"将，即亮翻；下同。","note_type":"hu_note","start_index":136,"tongjian_id":"b1838c7d-db0e-11ef-9639-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，才用翻；下同。","note_content_jianti_auto":"从，才用翻；下同。","note_type":"hu_note","start_index":271,"tongjian_id":"b1838c81-db0e-11ef-830c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":20,"tongjian_id":"b1838c83-db0e-11ef-8145-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"永平郡","place_name_jianti_auto":"永平郡","start_index":4,"tongjian_id":"b1838c84-db0e-11ef-9a46-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":8,"tongjian_id":"b1838c85-db0e-11ef-892f-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","start_index":10,"tongjian_id":"b1838c86-db0e-11ef-a372-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":13,"tongjian_id":"b1838c87-db0e-11ef-979c-a0d3651f611f"},{"place_name":"藤州","place_name_jianti_auto":"藤州","start_index":17,"tongjian_id":"b1838c88-db0e-11ef-8fe6-a0d3651f611f"},{"place_name":"藤州","place_name_jianti_auto":"藤州","start_index":24,"tongjian_id":"b1838c89-db0e-11ef-8851-a0d3651f611f"},{"place_name":"鐔津縣","place_name_jianti_auto":"镡津县","start_index":28,"tongjian_id":"b1838c8a-db0e-11ef-8854-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":32,"tongjian_id":"b1838c8b-db0e-11ef-aa8c-a0d3651f611f"},{"place_name":"猛陵縣","place_name_jianti_auto":"猛陵县","start_index":33,"tongjian_id":"b1838c8c-db0e-11ef-81ba-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：永平郡，梁置石州，隋後改曰藤州。宋白曰：藤州，治鐔津縣，漢猛陵縣也。","note_content_jianti_auto":"五代志：永平郡，梁置石州，隋后改曰藤州。宋白曰：藤州，治镡津县，汉猛陵县也。","note_type":"hu_note","start_index":317,"tongjian_id":"b1838c82-db0e-11ef-a2ee-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"b1838c63-db0e-11ef-a45c-a0d3651f611f","pinyin":"qiàn","source_anchor_text":"密使兄子蒨還長城立","source_key":"baiyang_epub","start_index":47,"text":"蒨","tongjian_id":"52118bd9-2f55-588b-8091-353a5cc256b2"}],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"府设永平【广西藤县】","resolved_place_entity_id":1952,"start_index":306,"tongjian_id":"b1838cb8-db0e-11ef-aab5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、南北朝 隋（卷四）","excerpts":[{"context_after":"","context_before":"...京口袭杀僧辨于石头，废渊明，立方智，于是大权悉归于霸先。","source_end_index":587,"source_paragraph_tongjian_id":"0f95a878-0c0b-5d99-9cad-700360c2c332","source_start_index":492,"source_text":"谯、秦二州刺史徐嗣徽[谯州，见前侯景袭谯州。秦州，治秦郡，见晋临淮郡注]、吴兴太守杜龛、义兴太守韦载、东扬州刺史张彪、江州刺史侯瑱、广州刺史萧勃等先后起兵，霸先次第剪平之，乃废梁主而篡其位。"}],"path":"历代州域形势纪要/四、南北朝 隋（卷四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"29杜龕恃王僧辯之勢，素不禮於陳霸先，在吳興，每以法繩其宗族，霸先深怨之。及將圖僧辯，密使兄子蒨還長城，立柵以備龕。僧辯死，龕據吳興拒霸先，義興太守韋載以郡應之。吳郡太守王僧智，僧辯之弟也，亦據城拒守。陳蒨至長城，收兵纔數百人，杜龕遣其將杜泰將精兵五千奄至，將士相視失色。蒨言笑自若，部分益明，衆心乃定。泰晝夜苦攻，數旬，不克而退。霸先使周文育攻義興，義興屬縣卒皆霸先舊兵，善用弩，韋載收得數十人，繫以長鎖，命所親監之，使射文育軍，約曰：「十射不兩中者死。」故每發輒斃一人，文育軍稍卻。載因於城外據水立柵，相持數旬。杜龕遣其從弟北叟將兵拒戰，北叟敗，歸于義興。霸先聞文育軍不利，辛未，自表東討，留高州刺史侯安都、石州刺史杜稜宿衞臺省。甲戌，軍至義興，丙子，拔其水柵。","content_fanyi":"杜龕依仗王僧辩的权势，一向对陈霸先无礼，在吴兴时常用刑法惩治陈霸先的宗族，陈霸先因此深深怨恨他。等到陈霸先准备图谋袭击王僧辩时，秘密派侄子陈蒨回长城，修筑栅栏以防备杜龛。王僧辩死后，杜龛占据吴兴抗拒陈霸先，义兴太守韦载据本郡响应杜龛。吴郡太守王僧智，是王僧辩的弟弟，也占据吴郡城池坚守抵抗。陈蒨到达长城，收聚到的士兵只有数百人，杜龛派部将杜泰率领五千精兵突然杀到，将士们面面相觑，大惊失色。陈蒨谈笑如常，部署调度更加清晰，军心这才安定下来。杜泰昼夜苦攻，持续数十天，仍不能攻克，于是退走。陈霸先派周文育进攻义兴，义兴所属各县的士兵原来都是陈霸先的旧部，擅长使用弩，韦载抓住其中的数十人，用长锁链系住，命亲信在旁监督，命令他们向周文育军射箭，并规定：“射十箭若不能射中两人的，处死。”因此每射出一箭总能射死一人，周文育军渐渐后退。韦载趁机在城外靠着水边建立栅栏，与周文育军相持数十天。杜龛派堂弟杜北叟领兵迎战，杜北叟战败，逃回义兴。陈霸先得知周文育军作战不利，十月二十四日辛未，亲自上表请求率军东征，留下高州刺史侯安都、石州刺史杜稜宿卫台省。十月二十七日甲戌，陈霸先的军队到达义兴，十月二十九日丙子，攻破韦载的水栅。","content_jianti_auto":"29杜龛恃王僧辩之势，素不礼于陈霸先，在吴兴，每以法绳其宗族，霸先深怨之。及将图僧辩，密使兄子蒨还长城，立栅以备龛。僧辩死，龛据吴兴拒霸先，义兴太守韦载以郡应之。吴郡太守王僧智，僧辩之弟也，亦据城拒守。陈蒨至长城，收兵才数百人，杜龛遣其将杜泰将精兵五千奄至，将士相视失色。蒨言笑自若，部分益明，众心乃定。泰昼夜苦攻，数旬，不克而退。霸先使周文育攻义兴，义兴属县卒皆霸先旧兵，善用弩，韦载收得数十人，系以长锁，命所亲监之，使射文育军，约曰：「十射不两中者死。」故每发辄毙一人，文育军稍却。载因于城外据水立栅，相持数旬。杜龛遣其从弟北叟将兵拒战，北叟败，归于义兴。霸先闻文育军不利，辛未，自表东讨，留高州刺史侯安都、石州刺史杜棱宿衞台省。甲戌，军至义兴，丙子，拔其水栅。","dtjl_paragraph_links":[],"dtjl_references":[],"id":15636,"number":29,"path":"资治通鉴 : 卷第一百六十六 (梁紀二十二) / 敬皇帝 / 紹泰元年 / 第 32 段","reading_annotation_sources":[{"count":2,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":31,"tongjian_id":"b1838c63-db0e-11ef-a45c-a0d3651f611f","year_int":555},"tongjian_id":"b1838c63-db0e-11ef-a45c-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"b6bbf6ef-db0e-11ef-a86d-a0d3651f611f"},{"place_name":"後周","place_name_jianti_auto":"后周","start_index":7,"tongjian_id":"b6bbf6f0-db0e-11ef-821f-a0d3651f611f"},{"place_name":"昌化郡","place_name_jianti_auto":"昌化郡","start_index":11,"tongjian_id":"b6bbf6f1-db0e-11ef-836b-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":15,"tongjian_id":"b6bbf6f2-db0e-11ef-9b38-a0d3651f611f"},{"place_name":"離石郡","place_name_jianti_auto":"离石郡","start_index":17,"tongjian_id":"b6bbf6f3-db0e-11ef-a893-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":21,"tongjian_id":"b6bbf6f4-db0e-11ef-a1ba-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","start_index":23,"tongjian_id":"b6bbf6f5-db0e-11ef-9de0-a0d3651f611f"},{"place_name":"離石","place_name_jianti_auto":"离石","place_note":"山西离石县","start_index":26,"tongjian_id":"b6bbf6f6-db0e-11ef-aa92-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":28,"tongjian_id":"b6bbf6f7-db0e-11ef-a392-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":30,"tongjian_id":"b6bbf6f8-db0e-11ef-9968-a0d3651f611f"},{"place_name":"稽胡","place_name_jianti_auto":"稽胡","start_index":36,"tongjian_id":"b6bbf6f9-db0e-11ef-a070-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"舊志云：漢縣，後周改名昌化郡，隋爲離石郡，唐爲石州。離石胡，匈奴種也，卽稽胡。","note_content_jianti_auto":"旧志云：汉县，后周改名昌化郡，隋为离石郡，唐为石州。离石胡，匈奴种也，即稽胡。","note_type":"hu_note","start_index":11,"tongjian_id":"b6bbf6ee-db0e-11ef-b7b0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"可，從刊入聲。汗，音寒。","note_content_jianti_auto":"可，从刊入声。汗，音寒。","note_type":"hu_note","start_index":82,"tongjian_id":"b6bbf6fd-db0e-11ef-bed9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":8,"tongjian_id":"b6bbf700-db0e-11ef-88c4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"樓煩郡","place_name_jianti_auto":"楼烦郡","start_index":1,"tongjian_id":"b6bbf701-db0e-11ef-b6c1-a0d3651f611f"},{"place_name":"嵐州","place_name_jianti_auto":"岚州","start_index":5,"tongjian_id":"b6bbf702-db0e-11ef-9475-a0d3651f611f"},{"place_name":"岢嵐山","place_name_jianti_auto":"岢岚山","start_index":15,"tongjian_id":"b6bbf703-db0e-11ef-a479-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以樓煩郡置嵐州。宋白曰：因界內岢嵐山立名。嵐，盧含翻。","note_content_jianti_auto":"以楼烦郡置岚州。宋白曰：因界内岢岚山立名。岚，卢含翻。","note_type":"hu_note","start_index":105,"tongjian_id":"b6bbf6ff-db0e-11ef-ad5b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"离石郡改石州","resolved_place_entity_id":1605,"start_index":64,"tongjian_id":"b6bbf712-db0e-11ef-9991-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"54隋末，離石胡劉龍兒擁兵數萬，自號劉王，以其子季眞爲太子；虎賁郞將梁德擊斬龍兒。至是，季眞與弟六兒復舉兵爲亂，引劉武周之衆攻陷石州，殺刺史王儉。季眞自稱突利可汗，以六兒爲拓定王。六兒遣使請降，詔以爲嵐州總管。","content_fanyi":"隋朝末年，离石胡人刘龙儿拥有数万兵马，自称刘王，立其子刘季真为太子；唐虎贲郎将梁德出击斩杀刘龙儿。到这时，刘季真与弟弟刘六儿再次起兵作乱，引来刘武周的部众攻陷石州，杀死唐石州刺史王俭。刘季真自称突利可汗，封刘六儿为拓定王。刘六儿派使者向唐朝请求投降，唐朝廷下诏任命他为岚州总管。","content_jianti_auto":"54隋末，离石胡刘龙儿拥兵数万，自号刘王，以其子季真为太子；虎贲郞将梁德击斩龙儿。至是，季真与弟六儿复举兵为乱，引刘武周之众攻陷石州，杀刺史王俭。季真自称突利可汗，以六儿为拓定王。六儿遣使请降，诏以为岚州总管。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18032,"number":54,"path":"资治通鉴 : 卷第一百八十七 (唐紀三) / 高祖神堯大聖光孝皇帝上之下 / 武德二年 / 第 66 段","reading_annotation_sources":[],"start_index":65,"tongjian_id":"b6bbf6ed-db0e-11ef-b4ca-a0d3651f611f","year_int":619},"tongjian_id":"b6bbf6ed-db0e-11ef-b4ca-a0d3651f611f"},"paragraph_order":2},{"mention_count":2,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張綸","people_name_jianti_auto":"张纶","start_index":1,"tongjian_id":"b6e99f57-db0e-11ef-9fe7-a0d3651f611f"},{"people_name":"張綸","people_name_jianti_auto":"张纶","start_index":5,"tongjian_id":"b6e99f58-db0e-11ef-8487-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此張綸卽上張綸，上書其官，此書其爵。","note_content_jianti_auto":"此张纶即上张纶，上书其官，此书其爵。","note_type":"hu_note","start_index":8,"tongjian_id":"b6e99f56-db0e-11ef-b3a9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","start_index":0,"tongjian_id":"b6e99f5a-db0e-11ef-8774-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":3,"tongjian_id":"b6e99f5b-db0e-11ef-b972-a0d3651f611f"},{"place_name":"離石郡","place_name_jianti_auto":"离石郡","start_index":5,"tongjian_id":"b6e99f5c-db0e-11ef-91d5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"石州，隋之離石郡。","note_content_jianti_auto":"石州，隋之离石郡。","note_type":"hu_note","start_index":20,"tongjian_id":"b6e99f59-db0e-11ef-80b7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","resolved_place_entity_id":1605,"start_index":17,"tongjian_id":"b6e99f61-db0e-11ef-985d-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","resolved_place_entity_id":1605,"start_index":35,"tongjian_id":"b6e99f66-db0e-11ef-9254-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"15西河公張綸、眞鄕公李仲文引兵臨石州，劉季眞懼而詐降。乙酉，以季眞爲石州總管，賜姓李氏，封彭山郡王。","content_fanyi":"西河公张纶、真乡公李仲文率兵进抵石州城下，刘季真因害怕而假意投降。三月二十二日乙酉，唐任命刘季真为石州总管，赐姓李氏，封为彭山郡王。","content_jianti_auto":"15西河公张纶、真鄕公李仲文引兵临石州，刘季真惧而诈降。乙酉，以季真为石州总管，赐姓李氏，封彭山郡王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18109,"number":15,"path":"资治通鉴 : 卷第一百八十八 (唐紀四) / 高祖神堯大聖光孝皇帝中之上 / 三年 / 第 18 段","reading_annotation_sources":[],"start_index":17,"tongjian_id":"b6e99f55-db0e-11ef-8e3d-a0d3651f611f","year_int":620},"tongjian_id":"b6e99f55-db0e-11ef-8e3d-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"金剛","people_name_jianti_auto":"金刚","start_index":0,"tongjian_id":"b6ee93af-db0e-11ef-aa10-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"上谷","place_name_jianti_auto":"上谷","start_index":5,"tongjian_id":"b6ee93b0-db0e-11ef-a485-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"金剛本起於上谷。幾，居豈翻。","note_content_jianti_auto":"金刚本起于上谷。几，居岂翻。","note_type":"hu_note","start_index":19,"tongjian_id":"b6ee93ae-db0e-11ef-968f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉六兒","people_name_jianti_auto":"刘六儿","start_index":5,"tongjian_id":"b6ee93b2-db0e-11ef-bcf0-a0d3651f611f"},{"people_name":"季眞","people_name_jianti_auto":"季真","start_index":15,"tongjian_id":"b6ee93b3-db0e-11ef-9191-a0d3651f611f"},{"people_name":"金剛","people_name_jianti_auto":"金刚","start_index":22,"tongjian_id":"b6ee93b4-db0e-11ef-9753-a0d3651f611f"},{"people_name":"武周","people_name_jianti_auto":"武周","start_index":25,"tongjian_id":"b6ee93b5-db0e-11ef-b16f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年五月，劉六兒降，今年三月，季眞降，而實附金剛、武周，今皆誅死。","note_content_jianti_auto":"去年五月，刘六儿降，今年三月，季真降，而实附金刚、武周，今皆诛死。","note_type":"hu_note","start_index":67,"tongjian_id":"b6ee93b1-db0e-11ef-a8a1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","resolved_place_entity_id":1605,"start_index":48,"tongjian_id":"b6ee93c3-db0e-11ef-ab97-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"未幾，金剛謀走上谷，突厥追獲，腰斬之。嵐州總管劉六兒從宋金剛在介休，秦王世民擒斬之。其兄季眞，棄石州，奔劉武周將馬邑高滿政，滿政殺之。","content_fanyi":"不久，宋金刚计划逃往上谷，突厥追上并俘获了他，将他腰斩。唐岚州总管刘六儿自投降后便跟随宋金刚在介休，这时秦王李世民将他活捉并处死。刘六儿的哥哥刘季真放弃石州，投奔刘武周的将领马邑人高满政，高满政把他杀了。","content_jianti_auto":"未几，金刚谋走上谷，突厥追获，腰斩之。岚州总管刘六儿从宋金刚在介休，秦王世民擒斩之。其兄季真，弃石州，奔刘武周将马邑高满政，满政杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18121,"path":"资治通鉴 : 卷第一百八十八 (唐紀四) / 高祖神堯大聖光孝皇帝中之上 / 三年 / 第 30 段","reading_annotation_sources":[],"start_index":29,"tongjian_id":"b6ee93ad-db0e-11ef-bd42-a0d3651f611f","year_int":620},"tongjian_id":"b6ee93ad-db0e-11ef-bd42-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西离石县","start_index":0,"tongjian_id":"b72328da-db0e-11ef-9499-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":3,"tongjian_id":"b72328db-db0e-11ef-bed5-a0d3651f611f"},{"place_name":"離石郡","place_name_jianti_auto":"离石郡","start_index":5,"tongjian_id":"b72328dc-db0e-11ef-9f26-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"石州，隋之離石郡。","note_content_jianti_auto":"石州，隋之离石郡。","note_type":"hu_note","start_index":10,"tongjian_id":"b72328d9-db0e-11ef-abb2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西离石县","resolved_place_entity_id":1605,"start_index":7,"tongjian_id":"b72328de-db0e-11ef-887d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6壬午，突厥寇石州，刺史王集擊卻之。","content_fanyi":"壬午日，突厥进犯石州，刺史王集将其击退。","content_jianti_auto":"6壬午，突厥寇石州，刺史王集击却之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18213,"number":6,"path":"资治通鉴 : 卷第一百八十九 (唐紀五) / 高祖神堯大聖光孝皇帝中之中 / 武德四年 / 第 8 段","reading_annotation_sources":[],"start_index":7,"tongjian_id":"b72328d8-db0e-11ef-af6f-a0d3651f611f","year_int":621},"tongjian_id":"b72328d8-db0e-11ef-af6f-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"瓌，古回翻。吐，從暾入聲。將，卽亮翻，又音如字。騎，奇寄翻。邠，卑旻翻。趣，七喻翻。","note_content_jianti_auto":"瓌，古回翻。吐，从暾入声。将，即亮翻，又音如字。骑，奇寄翻。邠，卑旻翻。趣，七喻翻。","note_type":"hu_note","start_index":58,"tongjian_id":"c10b844f-db0e-11ef-9d9f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","start_index":5,"tongjian_id":"c10b8451-db0e-11ef-ad2d-a0d3651f611f"},{"place_name":"昌化郡","place_name_jianti_auto":"昌化郡","start_index":8,"tongjian_id":"c10b8452-db0e-11ef-a2be-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":12,"tongjian_id":"c10b8453-db0e-11ef-8415-a0d3651f611f"},{"place_name":"離石","place_name_jianti_auto":"离石","start_index":13,"tongjian_id":"c10b8454-db0e-11ef-b486-a0d3651f611f"},{"place_name":"河曲","place_name_jianti_auto":"河曲","start_index":17,"tongjian_id":"c10b8455-db0e-11ef-809d-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":20,"tongjian_id":"c10b8456-db0e-11ef-9648-a0d3651f611f"},{"place_name":"宥州","place_name_jianti_auto":"宥州","start_index":25,"tongjian_id":"c10b8457-db0e-11ef-a3b6-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":49,"tongjian_id":"c10b8458-db0e-11ef-83b4-a0d3651f611f"},{"place_name":"雲州","place_name_jianti_auto":"云州","start_index":54,"tongjian_id":"c10b8459-db0e-11ef-8d3e-a0d3651f611f"},{"place_name":"雲中郡","place_name_jianti_auto":"云中郡","start_index":57,"tongjian_id":"c10b845a-db0e-11ef-9ceb-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":62,"tongjian_id":"c10b845b-db0e-11ef-b502-a0d3651f611f"},{"place_name":"平城","place_name_jianti_auto":"平城","start_index":63,"tongjian_id":"c10b845c-db0e-11ef-9a71-a0d3651f611f"},{"place_name":"朔州","place_name_jianti_auto":"朔州","start_index":67,"tongjian_id":"c10b845d-db0e-11ef-acc2-a0d3651f611f"},{"place_name":"馬邑郡","place_name_jianti_auto":"马邑郡","start_index":70,"tongjian_id":"c10b845e-db0e-11ef-90b3-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":74,"tongjian_id":"c10b845f-db0e-11ef-b5b8-a0d3651f611f"},{"place_name":"馬邑縣","place_name_jianti_auto":"马邑县","start_index":75,"tongjian_id":"c10b8460-db0e-11ef-996c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燧，音遂。石州，昌化郡，漢離石地。河曲六胡州時已爲宥州，蓋諸部酋長，各以舊州名帶刺史，故於時猶有六胡州之名。雲州，雲中郡，本魏平城地。朔州，馬邑郡，漢馬邑縣地。降，戶江翻。","note_content_jianti_auto":"燧，音遂。石州，昌化郡，汉离石地。河曲六胡州时已为宥州，盖诸部酋长，各以旧州名带刺史，故于时犹有六胡州之名。云州，云中郡，本魏平城地。朔州，马邑郡，汉马邑县地。降，户江翻。","note_type":"hu_note","start_index":91,"tongjian_id":"c10b8450-db0e-11ef-97ab-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","resolved_place_entity_id":1605,"start_index":72,"tongjian_id":"c10b846e-db0e-11ef-8238-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"21韓遊瓌奏請發兵攻鹽州，吐蕃救之，則使河東襲其背。丙寅，詔駱元光及陳許兵馬使韓全義將步騎萬二千人會邠寧軍，趣鹽州，又命馬燧以河東軍擊吐蕃。燧至石州，河曲六胡州皆降，遷於雲、朔之間。","content_fanyi":"韩游瓌上奏朝廷，请求增派兵力攻打盐州，若吐蕃军队来救援，就让河东马燧所部从背后袭击。十二月十一日丙寅，德宗下诏，令骆元光和陈许兵马使韩全义统率步骑一万二千人，会合邠宁军后进逼盐州，又令马燧率河东军攻击吐蕃。马燧率军到达石州后，黄河河曲的六胡州全部向他投降，他便把这些部众迁到云州、朔州之间。","content_jianti_auto":"21韩游瓌奏请发兵攻盐州，吐蕃救之，则使河东袭其背。丙寅，诏骆元光及陈许兵马使韩全义将步骑万二千人会邠宁军，趣盐州，又命马燧以河东军击吐蕃。燧至石州，河曲六胡州皆降，迁于云、朔之间。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23402,"number":21,"path":"资治通鉴 : 卷第二百三十二 (唐紀四十八) / 德宗神武聖文皇帝七 / 二年 / 第 28 段","reading_annotation_sources":[],"start_index":27,"tongjian_id":"c10b844e-db0e-11ef-a430-a0d3651f611f","year_int":786},"tongjian_id":"c10b844e-db0e-11ef-a430-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":28,"tongjian_id":"c112f122-db0e-11ef-a2a0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","place_note":"首都逻些城【西藏拉萨市】","start_index":4,"tongjian_id":"c112f123-db0e-11ef-be7e-a0d3651f611f"},{"place_name":"鹽","place_name_jianti_auto":"盐","start_index":9,"tongjian_id":"c112f124-db0e-11ef-95d3-a0d3651f611f"},{"place_name":"夏州","place_name_jianti_auto":"夏州","place_note":"陕西靖边县北白城子","start_index":11,"tongjian_id":"c112f125-db0e-11ef-8fc0-a0d3651f611f"},{"place_name":"鳴沙縣","place_name_jianti_auto":"鸣沙县","start_index":14,"tongjian_id":"c112f126-db0e-11ef-aa8e-a0d3651f611f"},{"place_name":"靈州","place_name_jianti_auto":"灵州","start_index":19,"tongjian_id":"c112f127-db0e-11ef-9e04-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":22,"tongjian_id":"c112f128-db0e-11ef-8ec6-a0d3651f611f"},{"place_name":"富平縣","place_name_jianti_auto":"富平县","start_index":23,"tongjian_id":"c112f129-db0e-11ef-abcd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年冬，吐蕃留兵戍鹽、夏州。鳴沙縣，屬靈州，漢富平縣地。宋白曰：見後。夏，戶雅翻。","note_content_jianti_auto":"去年冬，吐蕃留兵戍盐、夏州。鸣沙县，属灵州，汉富平县地。宋白曰：见后。夏，户雅翻。","note_type":"hu_note","start_index":26,"tongjian_id":"c112f121-db0e-11ef-ab04-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":14,"source_start_index":0,"source_text":"清水盟見二百二十八卷建中四年","target_paragraph_tongjian_id":"c05338db-db0e-11ef-9494-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"清水","place_name_jianti_auto":"清水","place_note":"甘肃清水县","start_index":0,"tongjian_id":"c112f12c-db0e-11ef-a83a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"清水盟見二百二十八卷建中四年。","note_content_jianti_auto":"清水盟见二百二十八卷建中四年。","note_type":"hu_note","start_index":100,"tongjian_id":"c112f12b-db0e-11ef-891d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"馬燧","people_name_jianti_auto":"马燧","start_index":7,"tongjian_id":"c112f12e-db0e-11ef-a2ca-a0d3651f611f"},{"people_name":"尚結贊","people_name_jianti_auto":"尚结赞","start_index":15,"tongjian_id":"c112f12f-db0e-11ef-8c56-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲，于僞翻。以馬燧智略功名而信尚結贊爲之請，使其劫盟之謀獲遂，則自損功名，而智略不足言。","note_content_jianti_auto":"为，于伪翻。以马燧智略功名而信尚结赞为之请，使其劫盟之谋获遂，则自损功名，而智略不足言。","note_type":"hu_note","start_index":128,"tongjian_id":"c112f12d-db0e-11ef-9797-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西离石县","resolved_place_entity_id":1605,"start_index":114,"tongjian_id":"c112f13c-db0e-11ef-b8ef-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十一、宁夏卫（卷六十二）","excerpts":[{"context_after":"寻置长乐州于此。元和十三年，灵武奏破吐蕃长乐州，克其外城...","context_before":"...，移鸣沙县治丰安城。大历四年，吐蕃寇鸣沙，寻为吐蕃所据。","source_end_index":255,"source_paragraph_tongjian_id":"34ac9111-198d-501c-88b2-88e0192f33df","source_start_index":229,"source_text":"贞元三年，吐蕃尚结赞等入寇，陷盐、夏诸州，退屯鸣沙。"}],"path":"陕西方舆纪要/十一、宁夏卫（卷六十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"初，吐蕃尚結贊得鹽、夏州，各留千餘人戍之，退屯鳴沙；自冬入春，羊馬多死，糧運不繼，又聞李晟克摧沙，馬燧、渾瑊等各舉兵臨之，大懼，屢遣使求和，上未之許。乃遣使卑辭厚禮求和於馬燧，且請脩清水之盟而歸侵地，使者相繼於路。燧信其言，留屯石州，不復濟河，爲之請於朝。","content_fanyi":"起初，吐蕃国相尚结赞取得盐州、夏州后，各留一千余人戍守，自己退兵屯驻鸣沙；从冬季进入春季，羊马大多死去，粮运接续不上，又听说李晟攻克摧沙堡，马燧、浑瑊等人各自率兵前来进逼，尚结赞大为恐惧，多次派遣使者求和，德宗没有答应。尚结赞于是派使者以谦卑的言辞和厚重的礼物向马燧求和，并且请求重新履行建中四年清水会盟的约定，归还侵占的土地，使者一路上前后相继。马燧轻信了他的话，留屯石州，不再渡过黄河，并替吐蕃向朝廷请求。","content_jianti_auto":"初，吐蕃尚结赞得盐、夏州，各留千余人戍之，退屯鸣沙；自冬入春，羊马多死，粮运不继，又闻李晟克摧沙，马燧、浑瑊等各举兵临之，大惧，屡遣使求和，上未之许。乃遣使卑辞厚礼求和于马燧，且请修清水之盟而归侵地，使者相继于路。燧信其言，留屯石州，不复济河，为之请于朝。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23418,"path":"资治通鉴 : 卷第二百三十二 (唐紀四十八) / 德宗神武聖文皇帝七 / 三年 / 第 15 段","reading_annotation_sources":[],"start_index":14,"tongjian_id":"c112f120-db0e-11ef-9e20-a0d3651f611f","year_int":787},"tongjian_id":"c112f120-db0e-11ef-9e20-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"代宗","people_name_jianti_auto":"代宗","start_index":0,"tongjian_id":"c26644b7-db0e-11ef-a74e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"六州党項","place_name_jianti_auto":"六州党项","start_index":12,"tongjian_id":"c26644b8-db0e-11ef-af8b-a0d3651f611f"},{"place_name":"野利越詩","place_name_jianti_auto":"野利越诗","start_index":20,"tongjian_id":"c26644b9-db0e-11ef-9c3c-a0d3651f611f"},{"place_name":"野利龍兒","place_name_jianti_auto":"野利龙儿","start_index":25,"tongjian_id":"c26644ba-db0e-11ef-a0d3-a0d3651f611f"},{"place_name":"野利厥律","place_name_jianti_auto":"野利厥律","start_index":30,"tongjian_id":"c26644bb-db0e-11ef-9750-a0d3651f611f"},{"place_name":"兒黃","place_name_jianti_auto":"儿黄","start_index":35,"tongjian_id":"c26644bc-db0e-11ef-9b3c-a0d3651f611f"},{"place_name":"野海","place_name_jianti_auto":"野海","start_index":38,"tongjian_id":"c26644bd-db0e-11ef-9a09-a0d3651f611f"},{"place_name":"野窣","place_name_jianti_auto":"野窣","start_index":41,"tongjian_id":"c26644be-db0e-11ef-a7d7-a0d3651f611f"},{"place_name":"慶州","place_name_jianti_auto":"庆州","start_index":46,"tongjian_id":"c26644bf-db0e-11ef-a3de-a0d3651f611f"},{"place_name":"東山部","place_name_jianti_auto":"东山部","start_index":49,"tongjian_id":"c26644c0-db0e-11ef-88fa-a0d3651f611f"},{"place_name":"夏州","place_name_jianti_auto":"夏州","start_index":53,"tongjian_id":"c26644c1-db0e-11ef-87f7-a0d3651f611f"},{"place_name":"平夏部","place_name_jianti_auto":"平夏部","start_index":56,"tongjian_id":"c26644c2-db0e-11ef-90d9-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","start_index":67,"tongjian_id":"c26644c3-db0e-11ef-b53e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"代宗永泰之後，改爲大曆。六州党項部落，曰野利越詩，野利龍兒，野利厥律，兒黃，野海，野窣等，居慶州號東山部，夏州號平夏部。永泰之後，稍徙石州。","note_content_jianti_auto":"代宗永泰之后，改为大历。六州党项部落，曰野利越诗，野利龙儿，野利厥律，儿黄，野海，野窣等，居庆州号东山部，夏州号平夏部。永泰之后，稍徙石州。","note_type":"hu_note","start_index":16,"tongjian_id":"c26644b6-db0e-11ef-a51b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"c26644c5-db0e-11ef-95e3-a0d3651f611f"},{"place_name":"永安","place_name_jianti_auto":"永安","start_index":3,"tongjian_id":"c26644c6-db0e-11ef-a033-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","start_index":8,"tongjian_id":"c26644c7-db0e-11ef-b001-a0d3651f611f"},{"place_name":"党項","place_name_jianti_auto":"党项","start_index":14,"tongjian_id":"c26644c8-db0e-11ef-b3ea-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐蓋置永安鎭將於石州，以綏御党項。暕，古限翻。","note_content_jianti_auto":"唐盖置永安镇将于石州，以绥御党项。暕，古限翻。","note_type":"hu_note","start_index":30,"tongjian_id":"c26644c4-db0e-11ef-b126-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c26644b5-db0e-11ef-813f-a0d3651f611f","pinyin":"jiǎn","source_anchor_text":"阿史那思暕侵漁不已","source_key":"baiyang_epub","start_index":24,"text":"暕","tongjian_id":"74d6a299-21d6-5dfb-853d-b00122e0bb85"}],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","resolved_place_entity_id":1605,"start_index":13,"tongjian_id":"c26644ca-db0e-11ef-bd82-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"]。","context_before":"...。《唐志》：大历中，置镇将于石州，以绥御党项。《会要》：","source_end_index":98,"source_paragraph_tongjian_id":"ce8361dc-0996-5c5f-86fa-17baf614db68","source_start_index":36,"source_text":"党项部落，曰野利越诗、野利龙儿、野利厥律儿、黄野、海野窣等，居庆州号东山部，夏州号平夏部。代宗永泰后，皆徙石州，因置镇以统之"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"19六州党項自永泰以來居于石州，永安鎭將阿史那思暕侵漁不已，党項部落悉逃奔河西。","content_fanyi":"六州党项部落自永泰年间以来一直居住在石州，永安镇将阿史那思暕对他们侵扰掠夺不止，党项各部落便全部逃往河西一带。","content_jianti_auto":"19六州党项自永泰以来居于石州，永安镇将阿史那思暕侵渔不已，党项部落悉逃奔河西。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23719,"number":19,"path":"资治通鉴 : 卷第二百三十五 (唐紀五十一) / 德宗神武聖文皇帝十 / 十五年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"c26644b5-db0e-11ef-813f-a0d3651f611f","year_int":799},"tongjian_id":"c26644b5-db0e-11ef-813f-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁王","people_name_jianti_auto":"袁王","start_index":27,"tongjian_id":"c3b32092-db0e-11ef-ba66-a0d3651f611f"},{"people_name":"紳","people_name_jianti_auto":"绅","start_index":29,"tongjian_id":"c3b32093-db0e-11ef-a3ea-a0d3651f611f"},{"people_name":"順宗","people_name_jianti_auto":"顺宗","start_index":31,"tongjian_id":"c3b32094-db0e-11ef-9a30-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","start_index":0,"tongjian_id":"c3b32095-db0e-11ef-89bc-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":3,"tongjian_id":"c3b32096-db0e-11ef-90b4-a0d3651f611f"},{"place_name":"離石縣","place_name_jianti_auto":"离石县","start_index":4,"tongjian_id":"c3b32097-db0e-11ef-b0c9-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":9,"tongjian_id":"c3b32098-db0e-11ef-a6fd-a0d3651f611f"},{"place_name":"石州","place_name_jianti_auto":"石州","start_index":11,"tongjian_id":"c3b32099-db0e-11ef-a93a-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":14,"tongjian_id":"c3b3209a-db0e-11ef-a6fc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"石州，漢離石縣地，唐置石州，京師東北一千二百九十一里。袁王紳，順宗子。","note_content_jianti_auto":"石州，汉离石县地，唐置石州，京师东北一千二百九十一里。袁王绅，顺宗子。","note_type":"hu_note","start_index":22,"tongjian_id":"c3b32091-db0e-11ef-b0d9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","resolved_place_entity_id":1605,"start_index":10,"tongjian_id":"c3b347da-db0e-11ef-8607-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"11初，陳留人武昭罷石州刺史，爲袁王府長史，鬱鬱怨執政。李逢吉與李程不相悅，水部郞中李仍叔，程之族人，激怒之云，程欲與昭官，爲逢吉所沮。昭因酒酣，對左金吾兵曹茅彙言欲刺逢吉，爲人所告。九月，庚辰，詔三司鞫之。前河陽掌書記李仲言謂彙曰：「君言李程與昭謀則生，不然必死。」彙曰：「冤死甘心！誣人自全，彙不爲也！」獄成，冬，十月，甲子，武昭杖死，李仍叔貶道州司馬，李仲言流象州，茅彙流崖州。","content_fanyi":"当初，陈留人武昭被免去石州刺史后，改任袁王府长史，心情郁闷不乐，怨恨朝廷当权的人。宰相李逢吉与李程彼此不和，水部郎中李仍叔是李程的同族之人，故意激怒武昭说：“李程本想授给你一个好官职，却被李逢吉阻止了。”武昭借着酒醉，对左金吾卫兵曹茅汇说自己想刺杀李逢吉，被人告发。九月初十庚辰日，诏令三司共同审讯此案。曾任河阳掌书记的李仲言对茅汇说：“你只要说出李程与武昭合谋之事，就能活命；不然必死无疑。”茅汇说：“我甘愿含冤而死！诬陷别人来保全自己，我茅汇绝不干这种事！”案件审结后，冬季十月二十五日甲子，武昭被杖死，李仍叔被贬为道州司马，李仲言被流放象州，茅汇被流放崖州。","content_jianti_auto":"11初，陈留人武昭罢石州刺史，为袁王府长史，郁郁怨执政。李逢吉与李程不相悦，水部郞中李仍叔，程之族人，激怒之云，程欲与昭官，为逢吉所沮。昭因酒酣，对左金吾兵曹茅汇言欲刺逢吉，为人所告。九月，庚辰，诏三司鞫之。前河阳掌书记李仲言谓汇曰：「君言李程与昭谋则生，不然必死。」汇曰：「冤死甘心！诬人自全，汇不为也！」狱成，冬，十月，甲子，武昭杖死，李仍叔贬道州司马，李仲言流象州，茅汇流崖州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24660,"number":11,"path":"资治通鉴 : 卷第二百四十三 (唐紀五十九) / 敬宗睿武昭愍孝皇帝 / 寶曆元年 / 第 14 段","reading_annotation_sources":[],"start_index":13,"tongjian_id":"c3b32090-db0e-11ef-8090-a0d3651f611f","year_int":825},"tongjian_id":"c3b32090-db0e-11ef-8090-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"石州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"史敬存","people_name_jianti_auto":"史敬存","start_index":30,"tongjian_id":"c5ab2ee3-db0e-11ef-b212-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"安慶","place_name_jianti_auto":"安庆","start_index":7,"tongjian_id":"c5ab2ee4-db0e-11ef-b001-a0d3651f611f"},{"place_name":"薩葛","place_name_jianti_auto":"萨葛","start_index":10,"tongjian_id":"c5ab2ee5-db0e-11ef-8dfa-a0d3651f611f"},{"place_name":"安慶","place_name_jianti_auto":"安庆","start_index":26,"tongjian_id":"c5ab2ee6-db0e-11ef-9372-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"參考新、舊書，安慶、薩葛，皆部落之名，更以後廣明元年安慶都督史敬存證之可見。酋，慈由翻。長，知丈翻。薩，桑葛翻。","note_content_jianti_auto":"参考新、旧书，安庆、萨葛，皆部落之名，更以后广明元年安庆都督史敬存证之可见。酋，慈由翻。长，知丈翻。萨，桑葛翻。","note_type":"hu_note","start_index":65,"tongjian_id":"c5ab2ee2-db0e-11ef-a544-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"c5ab2eeb-db0e-11ef-90c5-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":26,"tongjian_id":"c5ab2eec-db0e-11ef-be1a-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":30,"tongjian_id":"c5ab2eed-db0e-11ef-ae1e-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":34,"tongjian_id":"c5ab2eee-db0e-11ef-ba5b-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「月」下有「甲午」二字；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：十二行本「月」下有「甲午」二字；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"c5ab2eea-db0e-11ef-b1e7-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":69,"tongjian_id":"c5ab2ee9-db0e-11ef-9c0d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"石州","place_name_jianti_auto":"石州","place_note":"山西省离石县","resolved_place_entity_id":1605,"start_index":107,"tongjian_id":"c5ab2f04-db0e-11ef-a7ec-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、唐下 五代九国附（卷六）","excerpts":[{"context_after":"广明初，引还代北，既而败奔鞑靼。是年，黄巢入长安，代北监...","context_before":"...贼庞勋，授大同节度使，赐姓名李国昌。十年，为振武节度使。","source_end_index":207,"source_paragraph_tongjian_id":"df331fe3-2741-5fe1-9c3c-52dbb0ef6398","source_start_index":171,"source_text":"乾符五年，国昌子克用戍蔚州，为云州乱军所推，国昌复与之合，犯河东诸州镇。"}],"path":"历代州域形势纪要/六、唐下 五代九国附（卷六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"28冬，十月，詔昭義節度使李鈞、幽州節度使李可舉與吐谷渾酋長赫連鐸、白義誠、沙陀酋長安慶、薩葛酋長米海萬，合兵討李國昌父子於蔚州。十一月，岢嵐軍翻城應沙陀。丁未，以河東宣慰使崔季康爲河東節度、代北行營招討使。沙陀攻石州，庚戌，崔季康救之。","content_fanyi":"冬季十月，朝廷下诏，命昭义节度使李钧、幽州节度使李可举与吐谷浑酋长赫连铎、白义诚、沙陀酋长安庆、萨葛酋长米海万合兵，在蔚州讨伐李国昌父子。十一月，岢岚军翻城响应沙陀。丁未这一天，河东宣慰使崔季康被任命为河东节度使、代北行营招讨使。沙陀进攻石州，庚戌这一天，崔季康前往救援。","content_jianti_auto":"28冬，十月，诏昭义节度使李钧、幽州节度使李可举与吐谷浑酋长赫连铎、白义诚、沙陀酋长安庆、萨葛酋长米海万，合兵讨李国昌父子于蔚州。十一月，岢岚军翻城应沙陀。丁未，以河东宣慰使崔季康为河东节度、代北行营招讨使。沙陀攻石州，庚戌，崔季康救之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25936,"number":28,"path":"资治通鉴 : 卷第二百五十三 (唐紀六十九) / 僖宗惠聖恭定孝皇帝上之下 / 五年 / 第 34 段","reading_annotation_sources":[],"start_index":33,"tongjian_id":"c5ab2ee1-db0e-11ef-91c7-a0d3651f611f","year_int":878},"tongjian_id":"c5ab2ee1-db0e-11ef-91c7-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":2,"total_paragraphs":11},"place_name":"石州"},"message":"success","success":true}