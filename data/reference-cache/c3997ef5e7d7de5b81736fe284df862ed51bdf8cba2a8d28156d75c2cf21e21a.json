[],"ExtRef_Children_zhang_notes":[],"note_content":"臣瓚曰：地理志，東萊腄縣有之罘山。師古曰：罘，音浮。","note_content_jianti_auto":"臣瓒曰：地理志，东莱腄县有之罘山。师古曰：罘，音浮。","note_type":"hu_note","start_index":37,"tongjian_id":"905838ee-db0e-11ef-acba-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"905838dd-db0e-11ef-a4ef-a0d3651f611f","pinyin":"fú","source_anchor_text":"成山登之罘浮大海而","source_key":"baiyang_epub","start_index":35,"text":"罘","tongjian_id":"2fcfd321-f7f2-57c6-acf9-b1b0f24ece61"}],"ExtRef_Children_places":[{"place_name":"甘泉宮","place_name_jianti_auto":"甘泉宫","place_note":"陝西淳化西北","resolved_place_entity_id":648,"start_index":9,"tongjian_id":"905838f6-db0e-11ef-8812-a0d3651f611f"},{"place_name":"東海","place_name_jianti_auto":"东海","place_note":"山东郯城","resolved_place_entity_id":442,"start_index":17,"tongjian_id":"905838f7-db0e-11ef-9a67-a0d3651f611f"},{"place_name":"琅邪","place_name_jianti_auto":"琅邪","place_note":"山東胶南","resolved_place_entity_id":445,"start_index":25,"tongjian_id":"905838f8-db0e-11ef-a020-a0d3651f611f"},{"place_name":"成山","place_name_jianti_auto":"成山","place_note":"山東荣成东北成山角","resolved_place_entity_id":3188,"start_index":30,"tongjian_id":"905838f9-db0e-11ef-845a-a0d3651f611f"},{"place_name":"之罘","place_name_jianti_auto":"之罘","place_note":"山東烟台北芝罘山","resolved_place_entity_id":3548,"start_index":34,"tongjian_id":"905838fa-db0e-11ef-a7e9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/七、登州府（卷三十六）","excerpts":[{"context_after":"其东南海中有垒石，俗传武帝尝立桥于此]。","context_before":"...七年，至之罘射巨鱼。《封禅书》：八神，五曰阳主，祀之罘。","source_end_index":112,"source_paragraph_tongjian_id":"591572c6-ffba-5b06-8dc3-6b1ddc7a5611","source_start_index":90,"source_text":"《汉书》：武帝太始三年，登之罘，浮大海而还。"}],"path":"山东方舆纪要/七、登州府（卷三十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1春，正月，上行幸甘泉宮。二月，幸東海，獲赤鴈。幸琅邪，禮日成山，登之罘，浮大海而還。","content_fanyi":"春季，正月，汉武帝巡幸甘泉宫。二月，巡幸东海郡，捕获一只赤色大雁。又巡幸琅邪郡，在成山祭祀日神，登上之罘山，泛舟海上后返回长安。","content_jianti_auto":"1春，正月，上行幸甘泉宫。二月，幸东海，获赤鴈。幸琅邪，礼日成山，登之罘，浮大海而还。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1793,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"905838dd-db0e-11ef-a4ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":29,"tongjian_id":"905838fd-db0e-11ef-a109-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河間國","place_name_jianti_auto":"河间国","start_index":0,"tongjian_id":"905838fe-db0e-11ef-b402-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":4,"tongjian_id":"905838ff-db0e-11ef-add9-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":7,"tongjian_id":"90583900-db0e-11ef-9297-a0d3651f611f"},{"place_name":"瀛","place_name_jianti_auto":"瀛","start_index":8,"tongjian_id":"90583901-db0e-11ef-9249-a0d3651f611f"},{"place_name":"莫","place_name_jianti_auto":"莫","start_index":10,"tongjian_id":"90583902-db0e-11ef-828f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"河間國屬冀州，唐瀛、莫州地。帝置倢伃，位視上卿，爵比列侯。師古曰：倢，言接幸於上也。伃，美貌。倢，音接。伃，音予。","note_content_jianti_auto":"河间国属冀州，唐瀛、莫州地。帝置倢伃，位视上卿，爵比列侯。师古曰：倢，言接幸于上也。伃，美貌。倢，音接。伃，音予。","note_type":"hu_note","start_index":20,"tongjian_id":"905838fc-db0e-11ef-914d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90583904-db0e-11ef-82a8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鉤弋宮","place_name_jianti_auto":"钩弋宫","start_index":7,"tongjian_id":"90583905-db0e-11ef-b2d0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：黃圖，鉤弋宮在城外；漢武故事，在直門南。","note_content_jianti_auto":"师古曰：黄图，钩弋宫在城外；汉武故事，在直门南。","note_type":"hu_note","start_index":25,"tongjian_id":"90583903-db0e-11ef-840e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-94,"link_death_year":-74,"link_td_description":"汉昭帝刘弗陵，汉朝皇帝（前87年－前74年在位），其正式谥号为“孝昭皇帝”，后世省略“孝”字称“汉昭帝”，汉武帝幼子，母亲钩弋夫人。","link_td_id":"Q10000314","link_td_number_id":98999,"people_name":"弗陵","people_name_jianti_auto":"弗陵","people_xingming":"刘弗陵","start_index":6,"tongjian_id":"90583909-db0e-11ef-acaf-a0d3651f611f"},{"link_birth_year":-94,"link_death_year":-74,"link_td_description":"汉昭帝刘弗陵，汉朝皇帝（前87年－前74年在位），其正式谥号为“孝昭皇帝”，后世省略“孝”字称“汉昭帝”，汉武帝幼子，母亲钩弋夫人。","link_td_id":"Q10000314","link_td_number_id":98999,"people_name":"弗陵","people_name_jianti_auto":"弗陵","start_index":10,"tongjian_id":"9058390a-db0e-11ef-baca-a0d3651f611f"},{"link_birth_year":-113,"link_death_year":-88,"link_td_description":"赵婕妤，名不详，西汉武垣县人。汉武帝宠妃，汉昭帝生母。","link_td_id":"Q10000791","link_td_number_id":309191,"people_name":"趙倢伃","people_name_jianti_auto":"赵倢伃","people_xingming":"赵倢伃","start_index":16,"tongjian_id":"9058390b-db0e-11ef-87ee-a0d3651f611f"},{"link_td_description":"尧，祁姓，名放勋，中国神话中五帝之一，传说出生于三阿之南。道教中为天官大帝，三官大帝之一，诞日为上元节。","link_td_id":"Q10000026","link_td_number_id":14183,"people_name":"堯","people_name_jianti_auto":"尧","people_xingming":"尧","start_index":39,"tongjian_id":"905a926f-db0e-11ef-b210-a0d3651f611f"},{"link_birth_year":-113,"link_death_year":-88,"link_td_description":"赵婕妤，名不详，西汉武垣县人。汉武帝宠妃，汉昭帝生母。","link_td_id":"Q10000791","link_td_number_id":309191,"people_name":"鉤弋","people_name_jianti_auto":"钩弋","people_xingming":"赵倢伃","start_index":47,"tongjian_id":"905a9270-db0e-11ef-b4ea-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"905838fb-db0e-11ef-bb09-a0d3651f611f","pinyin":"jié","source_anchor_text":"曰河間趙倢伃居鉤弋","source_key":"baiyang_epub","start_index":17,"text":"倢","tongjian_id":"a488dd31-1f88-5851-a181-9c898f545984"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"905838fb-db0e-11ef-bb09-a0d3651f611f","pinyin":"yú","source_anchor_text":"河間趙倢伃居鉤弋宮","source_key":"baiyang_epub","start_index":18,"text":"伃","tongjian_id":"0f0b3f54-6135-5da9-ae79-b246c42ef02f"}],"ExtRef_Children_places":[{"place_name":"河間","place_name_jianti_auto":"河间","place_note":"府乐成，河北獻縣","resolved_place_entity_id":581,"start_index":14,"tongjian_id":"9058390c-db0e-11ef-8ec3-a0d3651f611f"},{"place_name":"鉤弋宮","place_name_jianti_auto":"钩弋宫","resolved_place_entity_id":9497,"start_index":21,"tongjian_id":"905a926e-db0e-11ef-9fc7-a0d3651f611f"},{"place_name":"堯母門","place_name_jianti_auto":"尧母门","resolved_place_entity_id":6316,"start_index":60,"tongjian_id":"905a9271-db0e-11ef-9893-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2是歲，皇子弗陵生。弗陵母曰河間趙倢伃，居鉤弋宮，任身十四月而生。上曰：「聞昔堯十四月而生，今鉤弋亦然。」乃命其所生門曰堯母門。","content_fanyi":"这一年，皇子刘弗陵出生。刘弗陵的母亲是河间人赵倢伃，住在钩弋宫，怀胎十四个月才生下他。汉武帝说：“听说古时候尧是十四个月才出生的，如今钩弋宫所生的孩子也是这样。”于是把刘弗陵出生处的那道宫门命名为尧母门。","content_jianti_auto":"2是岁，皇子弗陵生。弗陵母曰河间赵倢伃，居钩弋宫，任身十四月而生。上曰：「闻昔尧十四月而生，今钩弋亦然。」乃命其所生门曰尧母门。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1794,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"905838fb-db0e-11ef-bb09-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"905a9276-db0e-11ef-bde7-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"905a9277-db0e-11ef-912a-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十四行本「人」作「臣」；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十四行本「人」作「臣」；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"905a9275-db0e-11ef-af27-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":65,"tongjian_id":"905a9274-db0e-11ef-9a40-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"905a927a-db0e-11ef-93e3-a0d3651f611f"},{"link_birth_year":-113,"link_death_year":-88,"link_td_description":"赵婕妤，名不详，西汉武垣县人。汉武帝宠妃，汉昭帝生母。","link_td_id":"Q10000791","link_td_number_id":309191,"people_name":"鉤弋","people_name_jianti_auto":"钩弋","people_xingming":"null","start_index":49,"tongjian_id":"905a927b-db0e-11ef-8150-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"堯母","place_name_jianti_auto":"尧母","resolved_place_entity_id":6316,"start_index":54,"tongjian_id":"905a927c-db0e-11ef-b59b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论","权争"],"content":"臣光曰：爲人君者，動靜舉措不可不愼，發於中必形於外，天下無不知之。當是時也，皇后、太子皆無恙，而命鉤弋之門曰堯母，非名也。是以姦人逆探上意，知其奇愛少子，欲以爲嗣，遂有危皇后、太子之心，卒成巫蠱之禍，悲夫！","content_fanyi":"臣司马光说：做君主的，一举一动和各项举措不可不慎重，心中产生什么，必定会显露于外，天下无人不知。当时，皇后和太子都安然无恙，汉武帝却把钩弋宫门命名为尧母门，这不合名分。因此奸邪之人揣测皇上的心意，知道他特别宠爱小儿子，想立他为继承人，于是产生了危害皇后和太子的心思，最终酿成巫蛊之祸，可悲啊！","content_jianti_auto":"臣光曰：为人君者，动静举措不可不愼，发于中必形于外，天下无不知之。当是时也，皇后、太子皆无恙，而命钩弋之门曰尧母，非名也。是以奸人逆探上意，知其奇爱少子，欲以为嗣，遂有危皇后、太子之心，卒成巫蛊之祸，悲夫！","dtjl_paragraph_links":[],"dtjl_references":[],"id":1795,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"905a9272-db0e-11ef-ad80-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否宽恕太子家臣擅行驰道","decision_tongjian_id":"DECISION_905A927DDB0E11EF8341A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":40,"tongjian_id":"905a927f-db0e-11ef-b952-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":62,"tongjian_id":"905a9280-db0e-11ef-b3ff-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":96,"tongjian_id":"905a9281-db0e-11ef-b4ab-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙國","place_name_jianti_auto":"赵国","start_index":0,"tongjian_id":"905a9282-db0e-11ef-9592-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":3,"tongjian_id":"905a9283-db0e-11ef-aae6-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":6,"tongjian_id":"905a9284-db0e-11ef-8e01-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":8,"tongjian_id":"905a9285-db0e-11ef-89cc-a0d3651f611f"},{"place_name":"深州","place_name_jianti_auto":"深州","start_index":16,"tongjian_id":"905a9286-db0e-11ef-8b4c-a0d3651f611f"},{"place_name":"德州","place_name_jianti_auto":"德州","start_index":19,"tongjian_id":"905a9287-db0e-11ef-a876-a0d3651f611f"},{"place_name":"上林苑","place_name_jianti_auto":"上林苑","start_index":36,"tongjian_id":"905a9288-db0e-11ef-9db4-a0d3651f611f"},{"place_name":"上林","place_name_jianti_auto":"上林","start_index":70,"tongjian_id":"905a9289-db0e-11ef-963c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"趙國屬冀州；唐爲冀州，其地又分入深州、德州界。元鼎二年，初置水衡都尉，掌上林苑。應劭曰：古山林之官曰衡；掌諸池苑，故稱水衡。張晏曰：主都水及上林，故稱水衡；主諸官，故曰都；有卒徒武事，故曰尉。師古曰：衡，平也，主平其稅入；位列九卿，秩中二千石。","note_content_jianti_auto":"赵国属冀州；唐为冀州，其地又分入深州、德州界。元鼎二年，初置水衡都尉，掌上林苑。应劭曰：古山林之官曰衡；掌诸池苑，故称水衡。张晏曰：主都水及上林，故称水衡；主诸官，故曰都；有卒徒武事，故曰尉。师古曰：衡，平也，主平其税入；位列九卿，秩中二千石。","note_type":"hu_note","start_index":11,"tongjian_id":"905a927e-db0e-11ef-b2bd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"敬肅王","people_name_jianti_auto":"敬肃王","start_index":0,"tongjian_id":"905a928b-db0e-11ef-a880-a0d3651f611f"},{"people_name":"彭祖","people_name_jianti_auto":"彭祖","start_index":5,"tongjian_id":"905a928c-db0e-11ef-ad57-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"敬肅王，名彭祖；薨，諡敬肅。","note_content_jianti_auto":"敬肃王，名彭祖；薨，谥敬肃。","note_type":"hu_note","start_index":21,"tongjian_id":"905a928a-db0e-11ef-a689-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"905a928f-db0e-11ef-a25f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：魁，大也。岸者，有廉稜如崖岸之狀。被服，衣服也。輕，輕細也。靡，靡麗也。被，皮義翻。","note_content_jianti_auto":"师古曰：魁，大也。岸者，有廉棱如崖岸之状。被服，衣服也。轻，轻细也。靡，靡丽也。被，皮义翻。","note_type":"hu_note","start_index":62,"tongjian_id":"905a928e-db0e-11ef-91ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"905a9292-db0e-11ef-b551-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：中，當也。中，竹仲翻。","note_content_jianti_auto":"师古曰：中，当也。中，竹仲翻。","note_type":"hu_note","start_index":119,"tongjian_id":"905a9291-db0e-11ef-8939-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"905a9295-db0e-11ef-86c0-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":21,"tongjian_id":"905a9296-db0e-11ef-9ec5-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":50,"tongjian_id":"905a9297-db0e-11ef-a48c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":76,"tongjian_id":"905a9298-db0e-11ef-8e0f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":88,"tongjian_id":"905a9299-db0e-11ef-bfc9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：馳道，天子所行道也，若今之中道也。孔穎達曰：馳道，正道御路也。是天子馳走車馬之處，故曰馳道。如淳曰：令乙：騎乘車馬行馳道中，已論者沒入車馬被具。師古曰：家使，太子遣人之甘泉請問者也。使，疏吏翻。屬，之欲翻。","note_content_jianti_auto":"应劭曰：驰道，天子所行道也，若今之中道也。孔颖达曰：驰道，正道御路也。是天子驰走车马之处，故曰驰道。如淳曰：令乙：骑乘车马行驰道中，已论者没入车马被具。师古曰：家使，太子遣人之甘泉请问者也。使，疏吏翻。属，之欲翻。","note_type":"hu_note","start_index":143,"tongjian_id":"905a9294-db0e-11ef-b978-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"905a929c-db0e-11ef-a7e2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：言素不敎敕左右。古字，亡與無通。","note_content_jianti_auto":"师古曰：言素不教敕左右。古字，亡与无通。","note_type":"hu_note","start_index":175,"tongjian_id":"905a929b-db0e-11ef-8e86-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"财政","official_name":"水衡都尉","official_note":"水衡都尉是漢代掌管上林苑及皇室財政的官職，此處江充擔任此職，顯示其受皇帝信任，負責管理皇家事務。","official_rank":"未知","source_snippet":"趙人江充爲水衡都尉","start_index":2,"tongjian_id":"861eae29-0b5d-4e03-b565-2649a197a314"},{"confidence":0.9,"official_category":"监察","official_name":"直指繡衣使者","official_note":"直指繡衣使者是漢代皇帝直接派遣的監察官員，負責督察貴戚和近臣的違法行為，此處江充被任命此職，以加強對權貴的監督，體現皇帝對其的寵信。","official_rank":"未知","source_snippet":"拜爲直指繡衣使者","start_index":73,"tongjian_id":"e4de702f-5a07-4b46-932c-c3266d5a7ff3"}],"ExtRef_Children_people":[{"link_death_year":-91,"link_td_description":"江充，字次倩，本名江齐，西汉赵国邯郸（今河北省邯郸市）人。","link_td_id":"Q10007798","link_td_number_id":515915,"people_name":"江充","people_name_jianti_auto":"江充","people_xingming":"江充","start_index":3,"tongjian_id":"905a929d-db0e-11ef-bba5-a0d3651f611f"},{"link_death_year":-91,"link_td_description":"江充，字次倩，本名江齐，西汉赵国邯郸（今河北省邯郸市）人。","link_td_id":"Q10007798","link_td_number_id":515915,"people_name":"充","people_name_jianti_auto":"充","people_xingming":"江充","start_index":13,"tongjian_id":"905a929f-db0e-11ef-94de-a0d3651f611f"},{"link_death_year":-92,"link_td_description":"刘彭祖，西汉景帝第八子，贾夫人所生。","link_td_id":"Q10004427","link_td_number_id":1295996,"people_name":"趙敬肅王","people_name_jianti_auto":"赵敬肃王","people_xingming":"刘彭祖","start_index":15,"tongjian_id":"905a92a0-db0e-11ef-8488-a0d3651f611f"},{"people_name":"丹","people_name_jianti_auto":"丹","people_xingming":"刘丹","start_index":26,"tongjian_id":"905a92a1-db0e-11ef-bc01-a0d3651f611f"},{"people_name":"趙太子","people_name_jianti_auto":"赵太子","people_xingming":"刘丹","start_index":34,"tongjian_id":"905a92a2-db0e-11ef-a847-a0d3651f611f","wl_zhushi":"[刘丹]"},{"link_death_year":-91,"link_td_description":"江充，字次倩，本名江齐，西汉赵国邯郸（今河北省邯郸市）人。","link_td_id":"Q10007798","link_td_number_id":515915,"people_name":"充","people_name_jianti_auto":"充","people_xingming":"江充","start_index":47,"tongjian_id":"905a92a3-db0e-11ef-97df-a0d3651f611f"},{"link_death_year":-91,"link_td_description":"江充，字次倩，本名江齐，西汉赵国邯郸（今河北省邯郸市）人。","link_td_id":"Q10007798","link_td_number_id":515915,"people_name":"充","people_name_jianti_auto":"充","people_xingming":"江充","start_index":51,"tongjian_id":"905a9