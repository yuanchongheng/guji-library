11f"},{"place_name":"廩丘","place_name_jianti_auto":"廪丘","start_index":96,"tongjian_id":"8c2b9cbc-db0e-11ef-a5ba-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周室衰微，戰國之時僅有七邑，漢時之河南、洛陽、穀成、平陰、偃師、鞏、緱氏是也。晉志曰：周考王封周桓公孫惠公於鞏，號東周，故戰國有東、西周，芒山、首山其界也。陵觀、廩丘皆當時邑聚之名，史無所考。廩丘，史記作「邢丘」。觀，古玩翻。","note_content_jianti_auto":"周室衰微，战国之时仅有七邑，汉时之河南、洛阳、谷成、平阴、偃师、巩、缑氏是也。晋志曰：周考王封周桓公孙惠公于巩，号东周，故战国有东、西周，芒山、首山其界也。陵观、廪丘皆当时邑聚之名，史无所考。廪丘，史记作「邢丘」。观，古玩翻。","note_type":"hu_note","start_index":13,"tongjian_id":"8c2b9ca5-db0e-11ef-93e1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f","pinyin":"lǐn","source_anchor_text":"周取陵觀廩丘楚昭奚","source_key":"baiyang_epub","start_index":10,"text":"廩","tongjian_id":"2b062e55-3977-5881-8f2d-4a8ac6b8f87d"}],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","resolved_place_entity_id":301,"start_index":1,"tongjian_id":"8c2b9cbf-db0e-11ef-984d-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","place_note":"府巩县，河南巩县","resolved_place_entity_id":4746,"start_index":3,"tongjian_id":"8c2b9cc0-db0e-11ef-9d6d-a0d3651f611f"},{"place_name":"陵觀","place_name_jianti_auto":"陵观","resolved_place_entity_id":9635,"start_index":7,"tongjian_id":"8c2b9cc1-db0e-11ef-ac27-a0d3651f611f"},{"place_name":"廩丘","place_name_jianti_auto":"廪丘","resolved_place_entity_id":2277,"start_index":10,"tongjian_id":"8c2b9cc2-db0e-11ef-a9c4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、怀庆府（卷四十九）","excerpts":[{"context_after":"秦昭王四十一年，攻魏，取邢丘、怀。又秦始皇五年，蒙骜伐魏...","context_before":"...晋侯于邢丘。《战国策》：范雎说秦攻邢丘，邢丘拔而魏请附。","source_end_index":124,"source_paragraph_tongjian_id":"a68ffbc0-58de-5026-a874-5fdf478e1ce6","source_start_index":105,"source_text":"《史记》：韩昭侯六年，伐东周，取邢丘。"}],"path":"河南方舆纪要/三、怀庆府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2韓伐東周，取陵觀、廩丘。","content_fanyi":"韩国攻打东周，攻取了陵观、廪丘。","content_jianti_auto":"2韩伐东周，取陵观、廪丘。","dtjl_paragraph_links":[],"dtjl_references":[],"id":143,"number":2,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c2b9ca4-db0e-11ef-85b4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昭","people_name_jianti_auto":"昭","start_index":0,"tongjian_id":"8c2b9cc5-db0e-11ef-b485-a0d3651f611f"},{"people_name":"屈","people_name_jianti_auto":"屈","start_index":2,"tongjian_id":"8c2b9cc6-db0e-11ef-ae7e-a0d3651f611f"},{"people_name":"景","people_name_jianti_auto":"景","start_index":4,"tongjian_id":"8c2b9cc7-db0e-11ef-84a1-a0d3651f611f"},{"people_name":"太史公","people_name_jianti_auto":"太史公","start_index":20,"tongjian_id":"8c2b9cc8-db0e-11ef-8cd4-a0d3651f611f"},{"people_name":"嬴姓","people_name_jianti_auto":"嬴姓","start_index":25,"tongjian_id":"8c2b9cc9-db0e-11ef-b4d7-a0d3651f611f"},{"people_name":"江氏","people_name_jianti_auto":"江氏","start_index":30,"tongjian_id":"8c2b9cca-db0e-11ef-aaec-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":6,"tongjian_id":"8c2b9ccb-db0e-11ef-92c4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昭、屈、景，楚之強族，所謂「三閭」者也。太史公曰：嬴姓分封爲江氏。相，息亮翻。溺，奴弔翻。","note_content_jianti_auto":"昭、屈、景，楚之强族，所谓「三闾」者也。太史公曰：嬴姓分封为江氏。相，息亮翻。溺，奴吊翻。","note_type":"hu_note","start_index":29,"tongjian_id":"8c2b9cc4-db0e-11ef-bce1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚王","people_name_jianti_auto":"楚王","start_index":10,"tongjian_id":"8c2b9ccd-db0e-11ef-bfce-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"噬，時制翻。見，謂見楚王也。惡，烏路翻。","note_content_jianti_auto":"噬，时制翻。见，谓见楚王也。恶，乌路翻。","note_type":"hu_note","start_index":61,"tongjian_id":"8c2b9ccc-db0e-11ef-badc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"好，呼到翻。近者，附近之近，去聲。遠，于願翻，推而遠之。推，吐雷翻。","note_content_jianti_auto":"好，呼到翻。近者，附近之近，去声。远，于愿翻，推而远之。推，吐雷翻。","note_type":"hu_note","start_index":104,"tongjian_id":"8c2b9cce-db0e-11ef-9bdd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"己，音紀。終己，猶言終身也。","note_content_jianti_auto":"己，音纪。终己，犹言终身也。","note_type":"hu_note","start_index":127,"tongjian_id":"8c2b9ccf-db0e-11ef-a54e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"江乙","people_name_jianti_auto":"江乙","start_index":0,"tongjian_id":"8c2b9cd1-db0e-11ef-89c8-a0d3651f611f"},{"people_name":"昭奚恤","people_name_jianti_auto":"昭奚恤","start_index":4,"tongjian_id":"8c2b9cd2-db0e-11ef-b357-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"江乙欲毀昭奚恤，故先設是言。","note_content_jianti_auto":"江乙欲毁昭奚恤，故先设是言。","note_type":"hu_note","start_index":160,"tongjian_id":"8c2b9cd0-db0e-11ef-a744-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"相","official_note":"相是楚国的高级官职，相当于宰相，负责辅佐君主处理国家政务。在《资治通鉴》此段中，昭奚恤担任相职，江乙向楚王进言批评昭奚恤的行为，表明相在楚国政治中具有重要影响力，可能涉及权力斗争。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"楚昭奚恤爲相","start_index":3,"tongjian_id":"1b6d893c-2741-41f1-96f7-f95017403b42"}],"ExtRef_Children_people":[{"link_td_description":"昭奚恤，芈姓，昭氏，战国时期楚国人，一说即昭鱼。楚宣王封他到江（今河南正阳县），所以称为江君奚恤。为令尹，历经楚宣王、楚威王、楚怀王。名声振于中原。前353年，魏国攻打赵国邯郸，赵国求援于楚国，建议帮助魏国，昭奚恤不听。昭奚恤和江乙不和，江乙对楚王说狐假虎威之事，以狐暗喻昭奚恤。","link_td_id":"Q10015175","link_td_number_id":3357999,"people_name":"昭奚恤","people_name_jianti_auto":"昭奚恤","people_xingming":"昭奚恤","start_index":2,"tongjian_id":"8c2b9cd3-db0e-11ef-9cf4-a0d3651f611f"},{"link_td_description":"江乙，战国初年魏国游士、楚国大夫。","link_td_id":"Q10004729","link_td_number_id":7267638,"people_name":"江乙","people_name_jianti_auto":"江乙","people_xingming":"江乙","start_index":8,"tongjian_id":"8c2b9cd4-db0e-11ef-864e-a0d3651f611f"},{"link_death_year":-340,"link_td_description":"楚宣王，原名熊良夫，楚肃王弟，肃王无子，良夫继任。","link_td_id":"Q10001877","link_td_number_id":335214,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈良夫","start_index":12,"tongjian_id":"8c2b9cd5-db0e-11ef-bfdc-a0d3651f611f","wl_zhushi":"[芈良夫]"},{"link_td_description":"昭奚恤，芈姓，昭氏，战国时期楚国人，一说即昭鱼。楚宣王封他到江（今河南正阳县），所以称为江君奚恤。为令尹，历经楚宣王、楚威王、楚怀王。名声振于中原。前353年，魏国攻打赵国邯郸，赵国求援于楚国，建议帮助魏国，昭奚恤不听。昭奚恤和江乙不和，江乙对楚王说狐假虎威之事，以狐暗喻昭奚恤。","link_td_id":"Q10015175","link_td_number_id":3357999,"people_name":"昭奚恤","people_name_jianti_auto":"昭奚恤","start_index":47,"tongjian_id":"8c2b9cd7-db0e-11ef-9a36-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":1,"tongjian_id":"8c2b9cd6-db0e-11ef-963b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"3楚昭奚恤爲相。江乙言於楚王曰：「人有愛其狗者，狗嘗溺井，其鄰人見，欲入言之，狗當門而噬之。今昭奚恤常惡臣之見，亦猶是也。且人有好揚人之善者，王曰：『此君子也，』近之；好揚人之惡者，王曰：『此小人也，』遠之。然則且有子弒其父、臣弒其主者，而王終己不知也。何者？以王好聞人之美而惡聞人之惡也。」王曰：「善，寡人願兩聞之。」","content_fanyi":"楚国任命昭奚恤为国相。江乙向楚王进言说：“有个疼爱自己狗的人，他的狗曾往井里撒尿；邻居看见了，想进去告诉他这件事，狗却挡在门口咬他。如今昭奚恤常常不愿让我进见大王，也和这种情况一样。况且，有人喜欢宣扬别人的长处，大王就说：‘这是君子’，便亲近他；有人喜欢宣扬别人的短处，大王就说：‘这是小人’，便疏远他。这样一来，即使将要发生儿子杀害父亲、臣下杀害君主的事，大王也始终不会知道。为什么呢？就是因为大王喜欢听人的优点，而厌恶听人的缺点啊。”楚王说：“好！寡人愿意两方面都听一听。”","content_jianti_auto":"3楚昭奚恤为相。江乙言于楚王曰：「人有爱其狗者，狗尝溺井，其邻人见，欲入言之，狗当门而噬之。今昭奚恤常恶臣之见，亦犹是也。且人有好扬人之善者，王曰：『此君子也，』近之；好扬人之恶者，王曰：『此小人也，』远之。然则且有子弑其父、臣弑其主者，而王终己不知也。何者？以王好闻人之美而恶闻人之恶也。」王曰：「善，寡人愿两闻之。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":144,"number":3,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8c2b9cc3-db0e-11ef-bd81-a0d3651f611f"}],"reign_name":"十六年","reign_name_jianti_auto":"十六年","start_index":12,"tongjian_id":"8c295cb8-db0e-11ef-9063-a0d3651f611f","year_anno":"（戊辰、前三五三）","year_int":-353},"message":"success","success":true}