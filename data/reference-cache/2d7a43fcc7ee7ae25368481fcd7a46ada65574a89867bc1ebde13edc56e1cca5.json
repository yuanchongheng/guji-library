"start_index":36,"tongjian_id":"8d706d2e-db0e-11ef-b01f-a0d3651f611f"},{"place_name":"絫縣","place_name_jianti_auto":"絫县","start_index":39,"tongjian_id":"8d706d2f-db0e-11ef-9fbe-a0d3651f611f"},{"place_name":"碣石山","place_name_jianti_auto":"碣石山","start_index":41,"tongjian_id":"8d706d30-db0e-11ef-93ce-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志：大碣石山在右北平郡驪成縣西南。文穎曰：碣石在遼西郡絫縣。酈道元曰：濡水至絫縣碣石山。今於此枕海有石如埇道，數十里，當山頂有大石如柱形，往往而見，立於鉅海之中，名天橋柱。碣，音桀。","note_content_jianti_auto":"班志：大碣石山在右北平郡骊成县西南。文颖曰：碣石在辽西郡絫县。郦道元曰：濡水至絫县碣石山。今于此枕海有石如埇道，数十里，当山顶有大石如柱形，往往而见，立于巨海之中，名天桥柱。碣，音桀。","note_type":"hu_note","start_index":7,"tongjian_id":"8d706d24-db0e-11ef-bed4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"姜","people_name_jianti_auto":"姜","start_index":3,"tongjian_id":"8d706d33-db0e-11ef-9701-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"盧","place_name_jianti_auto":"卢","start_index":10,"tongjian_id":"8d706d34-db0e-11ef-b076-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：姜姓之後，封於盧，以國爲氏。","note_content_jianti_auto":"姓谱：姜姓之后，封于卢，以国为氏。","note_type":"hu_note","start_index":16,"tongjian_id":"8d706d32-db0e-11ef-8ee2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":12,"tongjian_id":"8d706d38-db0e-11ef-9286-a0d3651f611f"},{"people_name":"胡","people_name_jianti_auto":"胡","start_index":16,"tongjian_id":"8d706d39-db0e-11ef-8cf6-a0d3651f611f"},{"people_name":"胡亥","people_name_jianti_auto":"胡亥","start_index":18,"tongjian_id":"8d706d3a-db0e-11ef-a12f-a0d3651f611f"},{"people_name":"秦二世","people_name_jianti_auto":"秦二世","start_index":21,"tongjian_id":"8d706d3b-db0e-11ef-b259-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":27,"tongjian_id":"8d706d3c-db0e-11ef-8c1a-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","start_index":42,"tongjian_id":"8d706d3d-db0e-11ef-b9cc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"錄圖書，如後世讖緯之書。鄭玄曰：胡，胡亥，秦二世名也。秦見圖書而不知此爲人名，反備北胡。","note_content_jianti_auto":"录图书，如后世谶纬之书。郑玄曰：胡，胡亥，秦二世名也。秦见图书而不知此为人名，反备北胡。","note_type":"hu_note","start_index":63,"tongjian_id":"8d706d37-db0e-11ef-aee6-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"將軍","official_note":"將軍是秦漢時期的高級軍事指揮官，負責統領軍隊作戰。在《資治通鑑》此段中，秦始皇派遣將軍蒙恬率兵北伐匈奴，顯示將軍在軍事行動中的核心角色。此信息基於歷史常識，將軍通常由皇帝任命，執行國家軍事任務。","official_rank":"高級武官","source_snippet":"遣將軍蒙恬","start_index":68,"tongjian_id":"737dd0a2-3f68-4f13-b245-7c1e5f2cb8f1"}],"ExtRef_Children_people":[{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":1,"tongjian_id":"8d72ac74-db0e-11ef-9aa6-a0d3651f611f"},{"link_td_description":"卢敖，世称卢生，秦朝方士，燕国人，一说齐国人。官至博士。据说修炼方术而成仙，汉朝时为了纪念卢敖，设置了卢氏县，在今日河南省。","link_td_id":"Q10003259","link_td_number_id":2892267,"people_name":"盧生","people_name_jianti_auto":"卢生","people_xingming":"卢生","start_index":10,"tongjian_id":"8d72ac76-db0e-11ef-8455-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":30,"tongjian_id":"8d72ac7a-db0e-11ef-948b-a0d3651f611f"},{"link_td_description":"卢敖，世称卢生，秦朝方士，燕国人，一说齐国人。官至博士。据说修炼方术而成仙，汉朝时为了纪念卢敖，设置了卢氏县，在今日河南省。","link_td_id":"Q10003259","link_td_number_id":2892267,"people_name":"盧生","people_name_jianti_auto":"卢生","people_xingming":"卢生","start_index":41,"tongjian_id":"8d72ac7b-db0e-11ef-914d-a0d3651f611f"},{"link_birth_year":-230,"link_death_year":-207,"link_td_description":"秦二世，嬴姓，名胡亥，秦朝第二位皇帝，秦始皇第十八子。","link_td_id":"Q10000037","link_td_number_id":2975,"people_name":"胡","people_name_jianti_auto":"胡","people_xingming":"胡亥","start_index":59,"tongjian_id":"8d72ac7c-db0e-11ef-8a53-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":63,"tongjian_id":"8d72ac80-db0e-11ef-b432-a0d3651f611f"},{"link_birth_year":-250,"link_death_year":-210,"link_td_description":"蒙恬，中国秦朝将领、书法家，祖居齐国，官至内史，祖父蒙骜和父亲蒙武皆为秦国名将。蒙恬北防匈奴多年，威震北方。秦始皇驾崩后，因为支持公子扶苏，被赵高设计谋害。","link_td_id":"Q10008136","link_td_number_id":108334,"people_name":"蒙恬","people_name_jianti_auto":"蒙恬","people_xingming":"蒙恬","start_index":69,"tongjian_id":"8d72ac81-db0e-11ef-999f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"碣石","place_name_jianti_auto":"碣石","place_note":"河北昌黎北","resolved_place_entity_id":2714,"start_index":4,"tongjian_id":"8d72ac75-db0e-11ef-bd7f-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":8,"tongjian_id":"8d72ac77-db0e-11ef-8a9e-a0d3651f611f"},{"place_name":"羨門","place_name_jianti_auto":"羡门","resolved_place_entity_id":8741,"start_index":13,"tongjian_id":"8d72ac78-db0e-11ef-8545-a0d3651f611f"},{"place_name":"碣石","place_name_jianti_auto":"碣石","resolved_place_entity_id":2714,"start_index":17,"tongjian_id":"8d72ac79-db0e-11ef-bbde-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","place_note":"陕西榆林南鱼河堡","resolved_place_entity_id":712,"start_index":37,"tongjian_id":"8d72ac7d-db0e-11ef-b9e0-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":19,"start_index":57,"tongjian_id":"8d72ac7e-db0e-11ef-8cfb-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","place_note":"王庭设内蒙察哈尔右翼中旗","resolved_place_entity_id":104,"start_index":80,"tongjian_id":"8d72ac82-db0e-11ef-bca6-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦蒙恬攻匈奴之战","tongjian_id":"war_N0551"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"二世元年，东行郡县，刻碣石，并燕南至会稽[缘海南行也]。...","context_before":"...而云燕南者，主燕而言，东西皆可谓之南也。渑水，今已堙]。","source_end_index":239,"source_paragraph_tongjian_id":"a01f1168-dac8-5b4d-8c9c-4179e5c7e528","source_start_index":186,"source_text":"《史记》：秦始皇二十二年之碣石，刻碣石门，坏城郭，决通堤防[示天下大定，不必有封守备御，即销兵铸虡之意]。"},{"context_after":"此碣石在高丽界中，亦谓之左碣石[杜佑曰：秦长城所起之碣石...","context_before":"...往师之。此碣石特宫名耳，在蓟县东二十里宁台之东，非山也。","source_end_index":853,"source_paragraph_tongjian_id":"a01f1168-dac8-5b4d-8c9c-4179e5c7e528","source_start_index":843,"source_text":"秦筑长城，起自碣石。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/九、朝鲜（卷三十七）","excerpts":[{"context_after":"，今遗址东截辽水，而入高丽。盖本《太康地志》之说，其实误...","context_before":"...伐高丽，分军出遂成道，谓此也。杜佑曰：碣石山在汉遂成县，","source_end_index":193,"source_paragraph_tongjian_id":"094b4a39-f3d5-5b4b-a9e2-6449a6c758eb","source_start_index":184,"source_text":"秦筑长城，起于碣石"}],"path":"山东方舆纪要/九、朝鲜（卷三十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷三十九）","excerpts":[{"context_after":"张仪之以秦胁燕也，曰：秦下甲云中、九原，驱赵而攻燕。唐范...","context_before":"...胜，莫若陕西，赵主父攘地至云中、九原，遂欲直南袭秦咸阳。","source_end_index":201,"source_paragraph_tongjian_id":"39bdc05b-cc10-5386-b121-93a7fe656d11","source_start_index":173,"source_text":"秦始皇巡北边，从上郡入，既又使蒙恬除直道，自九原抵云阳。"}],"path":"山西方舆纪要/〇、封域山川险要（卷三十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/九、临洮府（卷六十）","excerpts":[{"context_after":"唐因置长城堡。开元二年，陇右节度使王晙等追破吐蕃于洮水，...","context_before":"长城[在府西北。","source_end_index":34,"source_paragraph_tongjian_id":"08df7261-c516-5189-ba0e-543ecae6863e","source_start_index":8,"source_text":"《史记》：秦始皇遣蒙恬发兵三十万北筑长城，起自临洮。"}],"path":"陕西方舆纪要/九、临洮府（卷六十）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1始皇之碣石，使燕人盧生求羨門，刻碣石門。壞城郭，決通堤坊。始皇巡北邊，從上郡入。盧生使入海還，因奏錄圖書曰：「亡秦者胡也。」始皇乃遣將軍蒙恬發兵三十萬人，北伐匈奴。","content_fanyi":"始皇帝到达碣石山，派原燕国人卢生访求仙人羡门，并在碣石山门刻石铭文歌功颂德。又拆毁城郭，挖通堤防。此后，始皇帝巡视北部边境，从上郡返回都城咸阳。卢生受派遣入海求仙归来，便向始皇帝奏上《录图书》中的谶语说：“灭亡秦朝的是胡。”始皇帝于是派将军蒙恬率领三十万大军，向北攻打匈奴。","content_jianti_auto":"1始皇之碣石，使燕人卢生求羡门，刻碣石门。坏城郭，决通堤坊。始皇巡北边，从上郡入。卢生使入海还，因奏录图书曰：「亡秦者胡也。」始皇乃遣将军蒙恬发兵三十万人，北伐匈奴。","dtjl_paragraph_links":[],"dtjl_references":[],"id":568,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d706d23-db0e-11ef-99eb-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000386"}],"reign_name":"三十二年","reign_name_jianti_auto":"三十二年","start_index":11,"tongjian_id":"8d706d21-db0e-11ef-b840-a0d3651f611f","year_anno":"（丙戌、前二一五）","year_int":-215},"message":"success","success":true}