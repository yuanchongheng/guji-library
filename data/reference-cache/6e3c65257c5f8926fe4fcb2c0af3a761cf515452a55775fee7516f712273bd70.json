jian_id":"912aef89-db0e-11ef-9e0c-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"蓋司隸","people_name_jianti_auto":"盖司隶","start_index":0,"tongjian_id":"9131e8d3-db0e-11ef-9dbe-a0d3651f611f"},{"people_name":"韓馮翊","people_name_jianti_auto":"韩冯翊","start_index":12,"tongjian_id":"9131e8d4-db0e-11ef-afa8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蓋司隸事見上卷神爵二年。韓馮翊事見上元年。蓋，古盍翻。","note_content_jianti_auto":"盖司隶事见上卷神爵二年。韩冯翊事见上元年。盖，古盍翻。","note_type":"hu_note","start_index":360,"tongjian_id":"9131e8d2-db0e-11ef-9070-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"9131e8d6-db0e-11ef-a67a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：騶馬，以給騶使乘之；佐，主猥馬吏也，有史有佐，名成也。","note_content_jianti_auto":"如淳曰：驺马，以给驺使乘之；佐，主猥马吏也，有史有佐，名成也。","note_type":"hu_note","start_index":384,"tongjian_id":"9131e8d5-db0e-11ef-8cec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9131e8d9-db0e-11ef-bcf8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：當，謂處斷其罪。要，與腰同。","note_content_jianti_auto":"师古曰：当，谓处断其罪。要，与腰同。","note_type":"hu_note","start_index":428,"tongjian_id":"9131e8d8-db0e-11ef-b775-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"安定太守","official_note":"安定太守是安定郡的最高行政长官，负责郡内民政、司法等事务。在上下文中，孙会宗作为杨恽的朋友，以安定太守的身份写信劝诫杨恽，体现了地方官员对中央政治人物的关注。","official_rank":"郡守（二千石）","source_snippet":"其友人安定太守西河孫會宗","start_index":24,"tongjian_id":"39b9d6bb-2ef5-437e-83eb-915750c46111"},{"confidence":0.9,"official_category":"爵位","official_name":"安平侯","official_note":"安平侯是汉代的一种爵位，属于列侯，享有封邑和特权。在上下文中，杨谭作为杨恽的侄子，以安平侯的身份劝慰杨恽，反映了贵族阶层在政治事件中的角色。","official_rank":"侯爵","source_snippet":"又惲兄子安平侯譚謂惲曰","start_index":268,"tongjian_id":"1a0bb174-4004-4138-9e6d-55d24cba29cc"},{"confidence":0.85,"official_category":"监察","official_name":"司隸","official_note":"司隶是司隶校尉的简称，负责监察京师及周边地区官员，权力较大。在上下文中，杨谭提到司隶作为尽力吏的例子，用以说明官员即使尽职也可能因事被诛，暗示政治风险。","official_rank":"比二千石","source_snippet":"蓋司隸、韓馮翊皆盡力吏也","start_index":298,"tongjian_id":"a90fa2a7-28b9-4770-8aa4-3177708b7c38"},{"confidence":0.8,"official_category":"地方行政","official_name":"韓馮翊","official_note":"韩冯翊指韩延寿曾任左冯翊，左冯翊是汉代三辅之一（京兆尹、左冯翊、右扶风）的长官，负责京畿地区的行政。在上下文中，与司隶并列作为尽力吏的例子，说明地方高级官员也可能因政治事件受牵连。","official_rank":"郡守（二千石）","source_snippet":"蓋司隸、韓馮翊皆盡力吏也","start_index":303,"tongjian_id":"312f5445-1bd6-427c-ad3f-655dc84f2d92"},{"confidence":0.7,"official_category":"军事或宫廷侍从","official_name":"騶馬猥佐","official_note":"騶馬猥佐是汉代的一种低级官职，可能负责马政或宫廷侍从事务，具体职能不详。在上下文中，成以騶馬猥佐的身份上书告发杨恽，体现了低级官员参与政治告发的现象。","official_rank":"低级官吏","source_snippet":"騶馬猥佐成上書告","start_index":328,"tongjian_id":"aace63d4-a02e-49b7-b313-a8b309a153ac"},{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是汉代最高司法官员，负责审理重大案件。在上下文中，廷尉受理对杨恽的告发并进行查验，最终判处杨恽大逆无道，显示了其在司法系统中的核心作用。","official_rank":"九卿之一（中二千石）","source_snippet":"章下廷尉，按驗","start_index":348,"tongjian_id":"fa83b2b8-6713-4d39-b9fb-32c16572fce2"},{"confidence":0.9,"official_category":"军事指挥","official_name":"未央衞尉","official_note":"未央卫尉是负责未央宫警卫的军事长官，属于宫廷禁卫系统。在上下文中，韦玄成作为未央卫尉，因与杨恽厚善而被免官，反映了政治牵连对高级军事官员的影响。","official_rank":"九卿之一（中二千石）","source_snippet":"未央衞尉韋玄成及孫會宗等","start_index":418,"tongjian_id":"b5d1fb3b-9f50-4ab5-82d6-47039c7ea27d"}],"ExtRef_Children_people":[{"link_death_year":-54,"link_td_description":"杨恽，字子幼。西汉华阴（今属陕西）人。","link_td_id":"Q10010214","link_td_number_id":970391,"people_name":"楊惲","people_name_jianti_auto":"杨恽","people_xingming":"杨恽","start_index":1