fc913a2"}],"ExtRef_Children_places":[{"place_name":"安定","place_name_jianti_auto":"安定","place_note":"甘肅固原","resolved_place_entity_id":295,"start_index":22,"tongjian_id":"9131e8dd-db0e-11ef-abff-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","place_note":"內蒙准格爾旗西南","resolved_place_entity_id":563,"start_index":26,"tongjian_id":"9131e8de-db0e-11ef-97f0-a0d3651f611f"},{"place_name":"南山","place_name_jianti_auto":"南山","resolved_place_entity_id":663,"start_index":243,"tongjian_id":"9131e8e1-db0e-11ef-9a48-a0d3651f611f"},{"place_name":"酒泉郡","place_name_jianti_auto":"酒泉郡","place_note":"甘肅酒泉","resolved_place_entity_id":520,"start_index":431,"tongjian_id":"9131e8f2-db0e-11ef-8e8d-a0d3651f611f"},{"place_name":"未央","place_name_jianti_auto":"未央","resolved_place_entity_id":782,"start_index":451,"tongjian_id":"9131e8f3-db0e-11ef-915c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/二疏赞","excerpts":[{"context_after":"。方二疏去时，三人皆亡恙。盖先生文如倾河，不复效常人寻阅...","context_before":"...元康三年二疏去位，后二年盖宽饶诛，又三年韩延寿诛，又三年","source_end_index":125,"source_paragraph_tongjian_id":"dcd2858e-d703-4959-8e62-90b5774b4611","source_start_index":122,"source_text":"杨恽诛"}],"path":"随笔/卷四/二疏赞","source_name":"容斋随笔"},{"display_title":"容斋随笔/张于二廷尉","excerpts":[{"context_after":"。恽之罪何至于是？其徇主之过如此。《传》所谓“决疑平法，...","context_before":"...赦出。释之正为廷尉，不能救，但申理犯跸、盗环一二细事耳。","source_end_index":163,"source_paragraph_tongjian_id":"0b117041-0744-4467-bb44-142580baa2b2","source_start_index":124,"source_text":"杨恽为人告骄奢不悔过，下廷尉按验，始得所予孙会宗书，定国当恽大逆无道，恽坐要斩"}],"path":"续笔/卷二/张于二廷尉","source_name":"容斋随笔"},{"display_title":"容斋随笔/汉人坐语言获罪","excerpts":[{"context_after":"予熟味其词，独有所谓“君父至尊亲，送其终也，有时而既”，...","context_before":"...。”执金吾议以指意欲求禅，亦坐死。考其所引，亦不为无罪。","source_end_index":223,"source_paragraph_tongjian_id":"2422665c-5035-485a-9f11-d9d5a59ac51a","source_start_index":144,"source_text":"杨恽之报孙会宗书，初无甚怨怒之语，其诗曰：“田彼南山，芜秽不治。种一顷豆，落而为萁。”张晏释以为言朝廷荒乱，百官谄谀。可谓穿凿。而廷尉当以大逆无道，刑及妻子。"}],"path":"四笔/卷十三/汉人坐语言获罪","source_name":"容斋随笔"}],"class_tags":["权争"],"content":"5楊惲旣失爵位，家居治產業，以財自娛。其友人安定太守西河孫會宗與惲書，諫戒之，爲言「大臣廢退，當闔門惶懼，爲可憐之意；不當治產業，通賓客，有稱譽。」惲，宰相子，有材能，少顯朝廷，一朝以晻昧語言見廢，內懷不服，報會宗書曰：「竊自思念，過已大矣，行已虧矣，常爲農夫以沒世矣，是故身率妻子，戮力耕桑，不意當復用此爲譏議也！夫人情所不能止者，聖人弗禁；故君、父至尊、親，送其終也，有時而旣。臣之得罪，已三年矣，田家作苦，歲時伏臘，烹羊，炰羔，斗酒自勞，酒後耳熱，仰天拊缶而呼烏烏，其詩曰：『田彼南山，蕪穢不治；種一頃豆，落而爲萁。人生行樂耳，須富貴何時！』誠荒淫無度，不知其不可也。」又惲兄子安平侯譚謂惲曰：「侯罪薄，又有功，且復用！」惲曰：「有功何益！縣官不足爲盡力。」譚曰：「縣官實然。蓋司隸、韓馮翊皆盡力吏也，俱坐事誅。」會有日食之變，騶馬猥佐成上書告「惲驕奢，不悔過。日食之咎，此人所致。」章下廷尉，按驗，得所予會宗書，帝見而惡之。廷尉當惲大逆無道，要斬；妻子徙酒泉郡；譚坐免爲庶人，諸在位與惲厚善者，未央衞尉韋玄成及孫會宗等，皆免官。","content_fanyi":"杨恽失去爵位以后，在家经营产业，以追逐财利为乐。杨恽的朋友安定太守西河人孙会宗写信劝诫他说：“大臣被废退后，应当闭门惶恐思过，作出可怜的样子；不应当经营产业，交结宾客，博取名声。”杨恽是前丞相杨敞的儿子，很有才能，年少时就在朝廷中显露声名，一时因暧昧言语获罪被废，内心不服，就回信给孙会宗说：“我私下思量，自己的过错已经很大，德行已有亏损，只能做一个农夫来度过余生，因此亲自带着妻子儿女，努力耕田种桑，没想到又因此受到讥刺议论！人之常情所不能抑制的事情，圣人也不加禁止；即使是君主和父亲这样至尊至亲的人，子女为他们送终，也有完结的时候。臣获罪已经三年了，田间劳作很辛苦，每逢伏日、腊月，煮羊烤羔，喝一斗酒犒劳自己，酒后耳热，便仰天拍击瓦缶，呜呜呼喊，那诗写道：‘到那南山下耕作，荒草芜秽无人治理；种下一顷豆子，豆子零落只剩下豆秸。人生姑且及时行乐罢了，等待富贵要等到什么时候！’即使是荒淫无度，我也不知道有什么不可以。”另外，杨恽兄长的儿子安平侯杨谭对杨恽说：“你的罪过很轻，又曾有功，将会再次受到任用！”杨恽说：“有功又有什么用！这样的天子不值得为他尽力。”杨谭说：“皇上确实如此。司隶校尉盖宽饶、左冯翊韩延寿都是尽心国事的能吏，却都因事被诛杀。”恰逢发生日食，有个名叫成的马夫头上书控告说：“杨恽骄横奢侈，不知悔过。日食的灾祸，就是此人招来的。”奏章下交廷尉，查验核实，查获了杨恽写给孙会宗的回信，宣帝看到后更加憎恶他。廷尉判处杨恽大逆不道之罪，处以腰斩；妻子儿女流放到酒泉郡；杨谭受牵连被免为平民；所有在位的与杨恽交情深厚的官员，如未央卫尉韦玄成和孙会宗等人，都被免去官职。","content_jianti_auto":"5杨恽既失爵位，家居治产业，以财自娱。其友人安定太守西河孙会宗与恽书，谏戒之，为言「大臣废退，当阖门惶惧，为可怜之意；不当治产业，通宾客，有称誉。」恽，宰相子，有材能，少显朝廷，一朝以晻昧语言见废，内怀不服，报会宗书曰：「窃自思念，过已大矣，行已亏矣，常为农夫以没世矣，是故身率妻子，戮力耕桑，不意当复用此为讥议也！夫人情所不能止者，圣人弗禁；故君、父至尊、亲，送其终也，有时而既。臣之得罪，已三年矣，田家作苦，岁时伏腊，烹羊，炰羔，斗酒自劳，酒后耳热，仰天拊缶而呼乌乌，其诗曰：『田彼南山，芜秽不治；种一顷豆，落而为萁。人生行乐耳，须富贵何时！』诚荒淫无度，不知其不可也。」又恽兄子安平侯谭谓恽曰：「侯罪薄，又有功，且复用！」恽曰：「有功何益！县官不足为尽力。」谭曰：「县官实然。盖司隶、韩冯翊皆尽力吏也，俱坐事诛。」会有日食之变，驺马猥佐成上书告「恽骄奢，不悔过。日食之咎，此人所致。」章下廷尉，按验，得所予会宗书，帝见而恶之。廷尉当恽大逆无道，要斩；妻子徙酒泉郡；谭坐免为庶人，诸在位与恽厚善者，未央衞尉韦玄成及孙会宗等，皆免官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2144,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9131e89b-db0e-11ef-abf0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":34,"tongjian_id":"9131e8fd-db0e-11ef-9bf2-a0d3651f611f"},{"people_name":"鄭衆","people_name_jianti_auto":"郑众","start_index":55,"tongjian_id":"9131e8fe-db0e-11ef-bf7b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周官：小司寇之職，以八辟麗邦法，附刑罰，三曰議賢之辟，四曰議能之辟。鄭玄註曰：賢，謂有德行者。能，謂有道藝者。鄭衆曰：若今時廉吏有罪先請，是也。","note_content_jianti_auto":"周官：小司寇之职，以八辟丽邦法，附刑罚，三曰议贤之辟，四曰议能之辟。郑玄注曰：贤，谓有德行者。能，谓有道艺者。郑众曰：若今时廉吏有罪先请，是也。","note_type":"hu_note","start_index":65,"tongjian_id":"9131e8fc-db0e-11ef-93ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓馮翊","people_name_jianti_auto":"韩冯翊","start_index":12,"tongjian_id":"9131e903-db0e-11ef-837d-a0d3651f611f"},{"people_name":"蕭","people_name_jianti_auto":"萧","start_index":17,"tongjian_id":"9131e904-db0e-11ef-b56a-a0d3651f611f"},{"people_name":"魏","people_name_jianti_auto":"魏","start_index":24,"tongjian_id":"9131e905-db0e-11ef-bdc0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙","place_name_jianti_auto":"赵","start_index":19,"tongjian_id":"9131e906-db0e-11ef-8f8e-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":20,"tongjian_id":"9131e907-db0e-11ef-8ca3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"揚子：或問臣之自失，曰：韓馮翊之愬蕭，趙京兆之犯魏。","note_content_jianti_auto":"扬子：或问臣之自失，曰：韩冯翊之愬萧，赵京兆之犯魏。","note_type":"hu_note","start_index":130,"tongjian_id":"9131e902-db0e-11ef-b243-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处魏相和丙吉担任此职，表明他们是汉宣帝时期的重要辅臣。","official_rank":"正一品","source_snippet":"魏相、丙吉爲丞相","start_index":18,"tongjian_id":"269bf8a4-e33b-46c4-b451-5a6d48b5bfae"},{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是汉代最高司法官员，掌管刑狱审判，此处于定国担任此职，负责法律事务。","official_rank":"正三品","source_snippet":"于定國爲廷尉","start_index":30,"tongjian_id":"19d18e60-80f8-4bb3-8c13-c838b20be74a"},{"confidence":0.85,"official_category":"司法","official_name":"司寇","official_note":"司寇是周代官职，掌管刑狱和治安，此处引用周代法律作为历史背景，并非指具体人物担任此职。","official_rank":"未知","source_snippet":"周官司寇之法","start_index":60,"tongjian_id":"f367b583-052d-4cc7-a70f-c4084e12c058"},{"confidence":0.8,"official_category":"地方行政","official_name":"馮翊","official_note":"馮翊是汉代官职，通常指左冯翊或右冯翊，是京畿地区的行政长官，此处韩冯翊可能指韩延寿担任此职，负责地方治理。","official_rank":"未知","source_snippet":"韓馮翊之愬蕭爲臣之自失","start_index":130,"tongjian_id":"5f30776d-fff7-4acb-b12c-7e204d5f2eb0"}],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"9131e909-db0e-11ef-b23e-a0d3651f611f"},{"link_birth_year":-91,"link_death_year":-48,"link_td_description":"汉宣帝刘询，原名刘病已，字次卿，即位九年后改名询，汉朝皇帝（前74年9月10日－前48年1月10日在位），其正式谥号为「孝宣皇帝」，后世省略「孝」字称「汉宣帝」。汉武帝的曾孙，戾太子刘据的长孙，史皇孙刘进的长子，生母为王翁须。","link_td_id":"Q10000317","link_td_number_id":99982,"people_name":"孝宣","people_name_jianti_auto":"孝宣","people_xingming":"刘病已","start_index":5,"tongjian_id":"9131e90a-db0e-11ef-a0fe-a0d3651f611f","wl_zhushi":"[刘病已]"},{"link_death_year":-59,"link_td_description":"魏相，字弱翁，出身济阴郡定陶，后迁居平陵，西汉政治家。","link_td_id":"Q10006239","link_td_number_id":519200,"people_name":"魏相","people_name_jianti_auto":"魏相","people_xingming":"魏相","start_index":10,"tongjian_id":"9131e90b-db0e-11ef-890d-a0d3651f611f"},{"link_death_year":-55,"link_td_description":"丙吉，西汉鲁国人，字少卿，曾任丞相，麒麟阁十一功臣之一。","link_td_id":"Q10002152","link_td_number_id":502321,"people_name":"丙吉","people_name_jianti_auto":"丙吉","people_xingming":"丙吉","start_index":13,"tongjian_id":"9131e90c-db0e-11ef-87c5-a0d3651f611f"},{"link_birth_year":-110,"link_death_year":-40,"link_td_description":"于定国，字曼倩，西汉东海郯县（今山东省郯城县西）人。汉宣帝时期，于定国先后担任光禄大夫、水衡都尉、廷尉等职，甘露年间，于定国接替黄霸为丞相，受封西平侯。汉成帝永光元年，关东地区发生灾荒，汉成帝下诏责备众臣，于定国对此感到惶恐不安，故上书请辞并获准，在其退休数年后，于七十多岁高龄时病逝，谥号“安”。","link_td_id":"Q10013031","link_td_number_id":1549365,"people_name":"于定國","people_name_jianti_auto":"于定国","people_xingming":"于定国","start_index":19,"tongjian_id":"9131e90d-db0e-11ef-b301-a0d3651f611f"},{"link_death_year":-65,"link_td_description":"赵广汉，字子都，西汉涿郡蠡吾县（今河北省博野县西南）人，早年为郡吏，后历任州从事、平准令、阳翟县县令、京辅都尉等职。因参与拥立汉宣帝的议决，赐爵关内侯，升迁颖川郡太守、京兆尹，为人精明干练，严于吏治，深受京师百姓爱戴。地节三年因诬告丞相魏相之妻杀人，被司直萧望之弹劾，经廷尉审讯后遭腰斩而死。","link_td_id":"Q10015501","link_td_number_id":3505976,"people_name":"趙","people_name_jianti_auto":"赵","people_xingming":"赵广汉","start_index":27,"tongjian_id":"9131e90e-db0e-11ef-aebc-a0d3651f611f","wl_zhushi":"[赵广汉]"},{"people_name":"蓋","people_name_jianti_auto":"盖","people_xingming":"盖宽饶","start_index":29,"tongjian_id":"9131e90f-db0e-11ef-a6dd-a0d3651f611f","wl_zhushi":"[盖宽饶]"},{"link_death_year":-57,"link_td_description":"韩延寿，字长公，西汉燕国人，后迁居杜陵县，年少时为郡文学，历任谏大夫，淮阳、颍川、东郡太守与左冯翊，治理地方名声甚佳。后因遭御史大夫萧望之弹劾饰物僭越等罪名，于五凤元年被判处死刑。","link_td_id":"Q10015495","link_td_number_id":3506010,"people_name":"韓","people_name_jianti_auto":"韩","people_xingming":"韩延寿","start_index":31,"tongjian_id":"9131e910-db0e-11ef-a912-a0d3651f611f","wl_zhushi":"[韩延寿]"},{"link_death_year":-54,"link_td_description":"杨恽，字子幼。西汉华阴（今属陕西）人。","link_td_id":"Q10010214","link_td_number_id":970391,"people_name":"楊","people_name_jianti_auto":"杨","people_xingming":"杨恽","start_index":33,"tongjian_id":"9131e911-db0e-11ef-9d1b-a0d3651f611f","wl_zhushi":"[杨恽]"},{"link_death_year":-65,"link_td_description":"赵广汉，字子都，西汉涿郡蠡吾县（今河北省博野县西南）人，早年为郡吏，后历任州从事、平准令、阳翟县县令、京辅都尉等职。因参与拥立汉宣帝的议决，