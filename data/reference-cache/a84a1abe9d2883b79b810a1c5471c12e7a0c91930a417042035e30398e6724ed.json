f_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"博士","official_note":"博士是秦汉时期的学官，负责教授经学、参与议政和礼仪事务。在《资治通鉴》此段中，汉文帝召见公孙臣并任命他为博士，以申明土德和草拟改历、服色等事宜，体现了博士在文教和礼仪改革中的作用。","official_rank":"未知","source_snippet":"拜爲博士","start_index":14,"tongjian_id":"82ab5fd1-a7c5-486e-9d7c-8e619e429a4b"}],"ExtRef_Children_people":[{"people_name":"召公","people_name_jianti_auto":"召公","people_xingming":"null","start_index":10,"tongjian_id":"8f036284-db0e-11ef-bbe3-a0d3651f611f"},{"link_birth_year":-252,"link_death_year":-152,"link_td_description":"张苍，阳武（今河南原阳县东南）人，秦末汉初之际的科学家、儒家、阴阳家，曾师从荀子。西汉学者、开国功臣，官至丞相，封北平侯，谥号文。","link_td_id":"Q10007802","link_td_number_id":202577,"people_name":"張蒼","people_name_jianti_auto":"张苍","people_xingming":"张苍","start_index":36,"tongjian_id":"8f036285-db0e-11ef-ad99-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f03627a-db0e-11ef-a514-a0d3651f611f","pinyin":"chù","source_anchor_text":"蒼由此自絀夏四月上","source_key":"baiyang_epub","start_index":41,"text":"絀","tongjian_id":"7331da94-3266-501e-b215-58f78a3ebcb6"}],"ExtRef_Children_places":[{"place_name":"成紀","place_name_jianti_auto":"成纪","place_note":"甘肅静宁西南","resolved_place_entity_id":2867,"start_index":6,"tongjian_id":"8f036283-db0e-11ef-bc69-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"1春，黃龍見成紀。帝召公孫臣，拜爲博士，與諸生申明土德，草改曆、服色事。張蒼由此自絀。","content_fanyi":"春季，黄龙在成纪出现。文帝召见公孙臣，任命他为博士，让他与诸生一同申明汉朝得土德之说，并草拟更改历法、服色的事宜。张苍由此自行贬退。","content_jianti_auto":"1春，黄龙见成纪。帝召公孙臣，拜为博士，与诸生申明土德，草改历、服色事。张苍由此自绌。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1195,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f03627a-db0e-11ef-a514-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"白帝","people_name_jianti_auto":"白帝","start_index":2,"tongjian_id":"8f05ac35-db0e-11ef-bdff-a0d3651f611f"},{"people_name":"赤帝","people_name_jianti_auto":"赤帝","start_index":5,"tongjian_id":"8f05ac36-db0e-11ef-890f-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":8,"tongjian_id":"8f05ac37-db0e-11ef-9cec-a0d3651f611f"},{"people_name":"青帝畤","people_name_jianti_auto":"青帝畤","start_index":11,"tongjian_id":"8f05ac38-db0e-11ef-9a7a-a0d3651f611f"},{"people_name":"漢高帝","people_name_jianti_auto":"汉高帝","start_index":17,"tongjian_id":"8f05ac39-db0e-11ef-bd63-a0d3651f611f"},{"people_name":"黑帝畤","people_name_jianti_auto":"黑帝畤","start_index":22,"tongjian_id":"8f05ac3a-db0e-11ef-a0d4-a0d3651f611f"},{"people_name":"五帝","people_name_jianti_auto":"五帝","start_index":29,"tongjian_id":"8f05ac3b-db0e-11ef-8347-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8f05ac3c-db0e-11ef-8397-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","start_index":15,"tongjian_id":"8f05ac3d-db0e-11ef-920b-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","start_index":27,"tongjian_id":"8f05ac3e-db0e-11ef-8c5c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦立白帝、赤帝、黃帝、青帝畤於雍，漢高帝又立黑帝畤，故雍有五帝畤。雍，於用翻。見，賢遍翻。","note_content_jianti_auto":"秦立白帝、赤帝、黄帝、青帝畤于雍，汉高帝又立黑帝畤，故雍有五帝畤。雍，于用翻。见，贤遍翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8f05ac34-db0e-11ef-a7d4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"五帝","people_name_jianti_auto":"五帝","start_index":13,"tongjian_id":"8f05ac3f-db0e-11ef-8c47-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雍","place_name_jianti_auto":"雍","place_note":"陝西鳳翔","resolved_place_entity_id":228,"start_index":9,"tongjian_id":"8f05ac40-db0e-11ef-b282-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2夏，四月，上始幸雍，郊見五帝，赦天下。","content_fanyi":"夏季四月，文帝开始亲自前往雍地，郊祀五帝，大赦天下。","content_jianti_auto":"2夏，四月，上始幸雍，郊见五帝，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1196,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f05ac33-db0e-11ef-80f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"守、式又翻。","note_content_jianti_auto":"守、式又翻。","note_type":"hu_note","start_index":25,"tongjian_id":"8f05ac42-db0e-11ef-9d85-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"东宫属官","official_name":"太子家令","official_note":"太子家令是汉代东宫官职，负责太子宫中的事务管理，如财务、饮食等，属于太子属官体系。在上下文中，晁错担任此职，后因对策优秀被擢升为中大夫，显示其从东宫属官晋升至中央官职的过程。","official_rank":"未知","source_snippet":"太子家令鼂錯對策高第","start_index":28,"tongjian_id":"804856c7-9add-4251-b858-32e773ae7d19"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"中大夫","official_note":"中大夫是汉代中央官职，属于郎中令（后改光禄勋）的属官，负责顾问应对、参与朝议等，品秩较高，常作为晋升或重要官员的职位。在上下文中，晁错因对策高第被擢升为此职，表明其受到皇帝赏识，进入中央决策层。","official_rank":"未知","source_snippet":"擢爲中大夫","start_index":38,"tongjian_id":"f0a45b16-ec78-46ac-b188-3897ffb13e8a"}],"ExtRef_Children_people":[{"link_birth_year":-200,"link_death_year":-154,"link_td_description":"晁错，颍川（今河南省禹州市）人，西汉初著名政论家。","link_td_id":"Q10002153","link_td_number_id":104340,"people_name":"鼂錯","people_name_jianti_auto":"鼌错","people_xingming":"晁错","start_index":34,"tongjian_id":"8f05ac44-db0e-11ef-a3d8-a0d3651f611f"},{"link_birth_year":-200,"link_death_year":-154,"link_td_description":"晁错，颍川（今河南省禹州市）人，西汉初著名政论家。","link_td_id":"Q10002153","link_td_number_id":104340,"people_name":"錯","people_name_jianti_auto":"错","people_xingming":"晁错","start_index":47,"tongjian_id":"8f05ac45-db0e-11ef-a000-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f05ac41-db0e-11ef-8155-a0d3651f611f","pinyin":"zhuó","source_anchor_text":"對策高第擢為中大夫","source_key":"baiyang_epub","start_index":41,"text":"擢","tongjian_id":"14fe3c91-1879-5c78-b9e9-e0e92b30c503"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"3九月，詔諸侯王、公卿、郡守舉賢良、能直言極諫者，上親策之。太子家令鼂錯對策高第，擢爲中大夫。錯又上言宜削諸侯及法令可更定者，書凡三十篇。上雖不盡聽，然奇其材。","content_fanyi":"九月，文帝下诏命诸侯王、公卿、郡守推举贤良和能直言极谏的人，并亲自加以策问。太子家令晁错的对策成绩列为高等，被提拔为中大夫。晁错又上书认为应当削弱诸侯王势力，并更改法令中可更定的内容，所上奏书共三十篇。文帝虽然没有完全采纳，却很惊叹他的才能。","content_jianti_auto":"3九月，诏诸侯王、公卿、郡守举贤良、能直言极谏者，上亲策之。太子家令鼌错对策高第，擢为中大夫。错又上言宜削诸侯及法令可更定者，书凡三十篇。上虽不尽听，然奇其材。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1197,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f05ac41-db0e-11ef-8155-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊王則","people_name_jianti_auto":"齐王则","start_index":0,"tongjian_id":"8f05ac48-db0e-11ef-92d1-a0d3651f611f"},{"people_name":"哀王襄","people_name_jianti_auto":"哀王襄","start_index":4,"tongjian_id":"8f05ac49-db0e-11ef-94f3-a0d3651f611f"},{"people_name":"悼惠王","people_name_jianti_auto":"悼惠王","start_index":10,"tongjian_id":"8f05ac4a-db0e-11ef-847e-a0d3651f611f"},{"people_name":"肥","people_name_jianti_auto":"肥","start_index":13,"tongjian_id":"8f05ac4b-db0e-11ef-952e-a0d3651f611f"},{"people_name":"河間王福","people_name_jianti_auto":"河间王福","start_index":17,"tongjian_id":"8f05ac4c-db0e-11ef-a469-a0d3651f611f"},{"people_name":"辟彊","people_name_jianti_auto":"辟彊","start_index":22,"tongjian_id":"8f05ac4d-db0e-11ef-9dde-a0d3651f611f"},{"people_name":"趙幽王","people_name_jianti_auto":"赵幽王","start_index":27,"tongjian_id":"8f05ac4e-db0e-11ef-b400-a0d3651f611f"},{"people_name":"遂","people_name_jianti_auto":"遂","start_index":31,"tongjian_id":"8f05ac4f-db0e-11ef-b781-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"齊王則，哀王襄之子，悼惠王肥之孫。河間王福，辟彊之子，趙幽王子遂之孫。","note_content_jianti_auto":"齐王则，哀王襄之子，悼惠王肥之孙。河间王福，辟彊之子，赵幽王子遂之孙。","note_type":"hu_note","start_index":23,"tongjian_id":"8f05ac47-db0e-11ef-8e31-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-165,"link_td_description":"刘则，汉朝宗室，西汉齐文王。其祖父齐悼惠王刘肥是汉高帝刘邦的长子。前179年，其父齐哀王刘襄死后，刘则袭位，在位十三年。前165年，刘则死后，无后，谥号文，命他的叔叔刘将闾嗣位。","link_td_id":"Q10012231","link_td_number_id":1451296,"people_name":"齊文王則","people_name_jianti_auto":"齐文王则","people_xingming":"刘则","start_index":4,"tongjian_id":"8f05ac50-db0e-11ef-b176-a0d3651f611f"},{"link_death_year":-165,"link_td_description":"刘福，汉高祖曾孙，赵幽王刘友孙，河间文王刘辟强子。前166年，刘辟强卒，刘福嗣河间王，立一年，薨，谥号哀，无子国除。","link_td_id":"Q10004829","link_td_number_id":3296711,"people_name":"河間哀王福","people_name_jianti_auto":"河间哀王福","people_xingming":"刘福","start_index":9,"tongjian_id":"8f05ac51-db0e-11ef-956a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4是歲，齊文王則、河間哀王福皆薨，無子，國除。","content_fanyi":"这一年，齐文王刘则和河间哀王刘福都去世了，两人没有儿子，封国因此被废除。","content_jianti_auto":"4是岁，齐文王则、河间哀王福皆薨，无子，国除。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1198,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8f05ac46-db0e-11ef-b009-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_