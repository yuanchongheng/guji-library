":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"a8137c30-db0e-11ef-bb15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以其強壯，罷使爲民，以從征役。","note_content_jianti_auto":"以其强壮，罢使为民，以从征役。","note_type":"hu_note","start_index":20,"tongjian_id":"a8155096-db0e-11ef-a322-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"君主","official_name":"魏主","official_note":"魏主指北魏皇帝，此处为北魏太武帝拓跋焘，在资治通鉴中常以国号加'主'指代君主。这段文字中魏主下诏罢免五十岁以下的僧人，体现了君主对宗教事务的干预。","official_rank":"最高统治者","source_snippet":"魏主詔罷沙門年五十以下者","start_index":6,"tongjian_id":"7d410a54-7adf-4836-9c33-2601a760440c"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":7,"tongjian_id":"a8155635-db0e-11ef-b78a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2三月，癸未，魏主詔罷沙門年五十以下者。","content_fanyi":"三月癸未日，北魏主拓跋焘下诏，五十岁以下的僧人一律还俗。","content_jianti_auto":"2三月，癸未，魏主诏罢沙门年五十以下者。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11383,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"a8137c39-db0e-11ef-9b32-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否接受刘宋迎接并南下","decision_tongjian_id":"DECISION_A8156A26DB0E11EF9FFBA0D3651F611F_01"},{"decision_name":"是否应刘宋要求遣送冯弘南下","decision_tongjian_id":"DECISION_A8156A26DB0E11EF9FFBA0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children