n_id":"a8156a6e-db0e-11ef-b56f-a0d3651f611f"},{"place_name":"天山","place_name_jianti_auto":"天山","resolved_place_entity_id":2001,"start_index":86,"tongjian_id":"a8156a6f-db0e-11ef-ab73-a0d3651f611f"},{"place_name":"白阜","place_name_jianti_auto":"白阜","resolved_place_entity_id":8390,"start_index":91,"tongjian_id":"a8156a70-db0e-11ef-83ce-a0d3651f611f"},{"place_name":"柔然","place_name_jianti_auto":"柔然","resolved_place_entity_id":262,"start_index":96,"tongjian_id":"a8156a71-db0e-11ef-b688-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"魏攻柔然之战","tongjian_id":"war_N0737"},{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"太平真君十年，复伐柔然，出涿邪山，行数千里，柔然远遁，是...","context_before":"...众。又魏主焘神睟二年，击柔然，循弱水西行，至涿邪山而还。","source_end_index":265,"source_paragraph_tongjian_id":"2b1267ef-976b-5ace-9ede-a8d418241469","source_start_index":228,"source_text":"太延四年，自五原伐柔然，至浚稽山，分遣拓跋崇从大泽向涿邪山，不见柔然而还。"},{"context_after":"胡氏曰：此漠北之天山，即唐铁勒思结多滥葛所保之地，非伊吾...","context_before":"天山[在漠北。","source_end_index":32,"source_paragraph_tongjian_id":"215208d8-2781-53fc-8256-0dd2cacdea69","source_start_index":7,"source_text":"魏主焘太延四年，伐柔然，从浚稽北向天山，西登白阜。"},{"context_after":"○鞮汗山，在甘肃塞北。旧《志》：在遮虏障西北百八十里，李...","context_before":"...水上，匈奴尝分居之。龙勒水在敦煌境，东北流至浚稽山下也。","source_end_index":211,"source_paragraph_tongjian_id":"4780ce02-d5b9-5ab0-a7c1-f651bfc62f03","source_start_index":145,"source_text":"后魏主焘太延四年，自五原北伐柔然，自出中道，至浚稽山，复分中道为二，使拓跋崇从大泽向涿邪山，魏主从浚稽北向天山，西登白阜，不见而还。"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"6丙申，魏主如五原；秋，七月，自五原北伐柔然。命樂平王丕督十五將出東道，永昌王健督十五將出西道，魏主自出中道。至浚稽山，復分中道爲二：陳留王崇從大澤向涿邪山，魏主從浚稽北向天山，西登白阜，不見柔然而還。時漠北大旱，無水草，人馬多死。","content_fanyi":"六月丙申日，北魏主拓跋焘前往五原。秋季七月，他从五原出兵北上讨伐柔然，命乐平王拓跋丕督率十五名将领从东路出击，永昌王拓跋健督率十五名将领从西路出击，自己统率中路军。到达浚稽山后，又把中路军分为两路：陈留王拓跋崇从大泽向涿邪山进发，北魏主则从浚稽山向北往天山进发，又向西登上白阜山，没有遇见柔然人，于是回师。当时漠北大旱，没有水草，人马死亡很多。","content_jianti_auto":"6丙申，魏主如五原；秋，七月，自五原北伐柔然。命乐平王丕督十五将出东道，永昌王健督十五将出西道，魏主自出中道。至浚稽山，复分中道为二：陈留王崇从大泽向涿邪山，魏主从浚稽北向天山，西登白阜，不见柔然而还。时漠北大旱，无水草，人马多死。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11387,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"a8156a55-db0e-11ef-b12b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7冬，十一月，丁卯朔，日有食之。","content_fanyi":"冬季，十一月丁卯朔，发生日食。","content_jianti_auto":"7冬，十一月，丁卯朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11388,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"a8156a72-db0e-11ef-a3bc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":8,"tongjian_id":"a8156a74-db0e-11ef-abc4-a0d3651f611f"},{"place_name":"平城","place_name_jianti_auto":"平城","resolved_place_entity_id":277,"start_index":11,"tongjian_id":"a8156a75-db0e-11ef-a8fc-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"魏攻柔然之战","tongjian_id":"war_N0737"},{"title":"北魏统一北方的战争","tongjian_id":"war_N0718"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8十二月，丁巳，魏主至平城。","content_fanyi":"十二月丁巳日，北魏国主抵达平城。","content_jianti_auto":"8十二月，丁巳，魏主至平城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11389,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"a8156a73-db0e-11ef-8cb1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"好，呼到翻；下同。","note_content_jianti_auto":"好，呼到翻；下同。","note_type":"hu_note","start_index":9,"tongjian_id":"a8156a77-db0e-11ef-92ca-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"廬山","place_name_jianti_auto":"庐山","start_index":0,"tongjian_id":"a8156a79-db0e-11ef-bab4-a0d3651f611f"},{"place_name":"尋陽","place_name_jianti_auto":"寻阳","start_index":3,"tongjian_id":"a8156a7a-db0e-11ef-b321-a0d3651f611f"},{"place_name":"南康城","place_name_jianti_auto":"南康城","start_index":8,"tongjian_id":"a8156a7b-db0e-11ef-952c-a0d3651f611f"},{"place_name":"尋陽","place_name_jianti_auto":"寻阳","start_index":16,"tongjian_id":"a8156a7c-db0e-11ef-9d08-a0d3651f611f"},{"place_name":"廬山","place_name_jianti_auto":"庐山","start_index":23,"tongjian_id":"a8156a7d-db0e-11ef-b342-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"廬山在尋陽，今在南康城北十五里，尋陽之南，正面廬山。","note_content_jianti_auto":"庐山在寻阳，今在南康城北十五里，寻阳之南，正面庐山。","note_type":"hu_note","start_index":14,"tongjian_id":"a8156a78-db0e-11ef-86f8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"雞籠山","place_name_jianti_auto":"鸡笼山","start_index":0,"tongjian_id":"a8156a7f-db0e-11ef-bf66-a0d3651f611f"},{"place_name":"臺城","place_name_jianti_auto":"台城","start_index":4,"tongjian_id":"a8156a80-db0e-11ef-9792-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"雞籠山在臺城北郊。散，悉亶翻。騎，奇寄翻。處，昌呂翻。爲，于僞翻。","note_content_jianti_auto":"鸡笼山在台城北郊。散，悉亶翻。骑，奇寄翻。处，昌吕翻。为，于伪翻。","note_type":"hu_note","start_index":44,"tongjian_id":"a8156a7e-db0e-11ef-8065-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉志，太子率更令主宮殿門戶及賞罰事，職如光祿勳、衞尉。更，工衡翻。","note_content_jianti_auto":"晋志，太子率更令主宫殿门户及赏罚事，职如光禄勋、衞尉。更，工衡翻。","note_type":"hu_note","start_index":81,"tongjian_id":"a8156a81-db0e-11ef-9367-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛脩之","people_name_jianti_auto":"毛修之","start_index":35,"tongjian_id":"a8156a84-db0e-11ef-8c75-a0d3651f611f"},{"people_name":"殷景仁","people_name_jianti_auto":"殷景仁","start_index":44,"tongjian_id":"a8156a85-db0e-11ef-876b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":18,"tongjian_id":"a8156a86-db0e-11ef-822c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，才用翻。數，所角翻。褠，古侯翻。江南人士交際以爲盛服，蓋次於朝服。毛脩之不肯以巾褠到殷景仁之門是也。蜀註曰：巾謂巾幘，褠謂單衣。","note_content_jianti_auto":"从，才用翻。数，所角翻。褠，古侯翻。江南人士交际以为盛服，盖次于朝服。毛修之不肯以巾褠到殷景仁之门是也。蜀注曰：巾谓巾帻，褠谓单衣。","note_type":"hu_note","start_index":127,"tongjian_id":"a8156a83-db0e-11ef-a1ec-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"散騎侍郞","official_note":"散騎侍郞是魏晉南北朝時期的官職，隸屬散騎省，負責侍從皇帝、顧問應對，常參與文教事務。在原文中，雷次宗被徵召為此職但未就任，顯示其學術聲望。","official_rank":"未知","source_snippet":"嘗徵爲散騎侍郞","start_index":15,"tongjian_id":"8ae77563-8f30-4238-9482-e7d5e3fce633"},{"confidence":0.85,"official_category":"地方行政","official_name":"丹楊尹","official_note":"丹楊尹是地方行政長官，負責丹楊郡（今江蘇南京一帶）的治理。在原文中，何尚之以丹楊尹身份受命設立玄學，體現皇帝推動文教事業。","official_rank":"未知","source_snippet":"使丹楊尹廬江何尚之立玄學","start_index":67,"tongjian_id":"8d2a7f11-006d-46c6-a0fb-ddfdb3ca96d0"},{"confidence":0.85,"official_category":"文教","official_name":"太子率更令","official_note":"太子率更令是東宮官職，負責太子宮中的計時、禮儀等事務，常參與文教活動。在原文中，何承天以此職受命設立史學，反映皇帝對學術的重視。","official_rank":"未知","source_snippet":"太子率更令何承天立史學","start_index":78,"tongjian_id":"cf6f033c-f1c8-4fc7-bef9-34045dd210a6"},{"confidence":0.8,"official_category":"軍事指揮","official_name":"司徒參軍","official_note":"司徒參軍是司徒府的軍事參謀官職，負責協助司徒處理軍政事務。在原文中，謝元以此職受命設立文學，顯示其參與文教工作。","official_rank":"未知","source_snippet":"司徒參軍謝元立文學","start_index":90,"tongjian_id":"945f019a-d7ee-46dd-a3f8-4ec0e6d896fd"},{"confidence":0.9,"official_category":"監察","official_name":"給事中","official_note":"給事中是秦漢至魏晉時期的官職，隸屬門下省，負責審核詔令、監察政務。在原文中，雷次宗被任命為此職但未就任，進一步強調其隱居不仕的態度。","official_rank":"未知","source_snippet":"又除給事中","start_index":126,"tongjian_id":"48f45404-324f-41b2-8b2e-2e752c61721e"}],"ExtRef_Children_people":[{"people_name":"雷次宗","people_name_jianti_auto":"雷次宗","people_xingming":"雷次宗","start_index":3,"tongjian_id":"a8156a88-db0e-11ef-b66d-a0d3651f611f"},{"link_birth_year":382,"link_death_year":460,"link_td_description":"何尚之，字彦德，庐江灊县人。东晋骠骑将军何充弟何准曾孙。南朝宋官员。","link_td_id":"Q10006834","link_td_number_id":3984949,"people_name":"何尚之","people_name_jianti_auto":"何尚之","people_xingming":"何尚之","start_index":62,"tongjian_id":"a8156a8d-db0e-11ef-80f9-a0d3651f611f"},{"link_birth_year":370,"link_death_year":447,"link_td_description":"何承天，东海郡郯县（今山东郯城西北）人，南北朝数学家、天文学家、史学家、思想家。刘秀之的岳父。","link_td_id":"Q10008286","link_td_number_id":192021,"people_name":"何承天","people_name_jianti_auto":"何承天","people_xingming":"何承天","start_index":74,"tongjian_id":"a8156a8e-db0e-11ef-88e0-a0d3651f611f"},{"people_name":"謝元","people_name_jianti_auto":"谢元","people_xingming":"谢元","start_index":85,"tongjian_id":"a8156a91-db0e-11ef-a254-a0d3651f611f"},{"people_name":"次宗","people_name_jianti_auto":"次宗","people_xingming":"雷次宗","start_index":92,"tongjian_id":"a8156a92-db0e-11ef-91d6-a0d3651f611f"},{"people_name":"元","people_name_jianti_auto":"元","people_xingming":"谢元","start_index":100,"tongjian_id":"a8156a93-db0e-11ef-b95a-a0d3651f611f"},{"people_name":"靈運","people_name_jianti_auto":"灵运","people_xingming":"谢灵运","start_index":102,"tongjian_id":"a8156a94-db0e-11ef-a804-a0d3651f611f"},{"people_name":"次宗","people_name_jianti_auto":"次宗","people_xingming":"雷次宗","start_index":113,"tongjian_id":"a8156a95-db0e-11ef-b9f3-a0d3651f611f"},{"people_name":"次宗","people_name_jianti_auto":"次宗","people_xingming":"雷次宗","start_index":119,"tongjian_id":"a8156a96-db0e-11ef-a1a5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a8156a76-db0e-11ef-81db-a0d3651f611f","pinyin":"gōu","source_anchor_text":"次宗以巾褠侍講資給","source_key":"baiyang_epub","start_index":123,"text":"褠","tongjian_id":"ed227246-b440-5074-8d84-ca6ec815edb1"}],"ExtRef_Children_places":[{"place_name":"豫章","place_name_jianti_auto":"豫章","resolved_place_entity_id":310,"start_index":1,"tongjian_id":"a8156a89-db0e-11ef-b9f6-a0d3651f611f"},{"place_name":"廬山","place_name_jianti_auto":"庐山","resolved_place_entity_id":1495,"start_index":11,"tongjian_id":"a8156a8a-db0e-11ef-ba2a-a0d3651f611f"},{"place_name":"建康","place_name_jianti_auto":"建康","resolved_place_entity_id":64,"start_index":33,"tongjian_id":"a8156a8b-db0e-11ef-82c6-a0d3651f611f"},{"place_name":"雞籠山","place_name_jianti_auto":"鸡笼山","resolved_place_entity_id":9711,"start_index":40,"tongjian_id":"a8156a8c-db0e-11ef-b36a-a0d3651f611f"},{"place_name":"丹楊","place_name_jianti_auto":"丹杨","resolved_place_entity_id":424,"start_index":57,"tongjian_id":"a8156a8f-db0e-11ef-a250-a0d3651f611f"},{"place_name":"廬江","place_name_jianti_auto":"庐江","resolved_place_entity_id":638,"start_index":60,"tongjian_id":"a8156a90-db0e-11ef-aa55-a0d3651f611f"},{"place_name":"廬山","place_name_jianti_auto":"庐山","resolved_place_entity_id":1495,"start_index":145,"tongjian_id":"a8156a97-db0e-11ef-bd6c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、应天府（卷二十）","excerpts":[{"context_after":"齐永明二年，竟陵王子良镇西州，开西邸于鸡笼山。明初于山阳...","context_before":"...宇记》：山西接落星冈，北临栖玄塘，本名鸡笼山，以形似名。","source_end_index":89,"source_paragraph_tongjian_id":"589e7e44-8483-5962-8a2c-abc3d65d02c4","source_start_index":53,"source_text":"宋元嘉十六年，征庐山隐士雷次宗至建康，为开馆于鸡笼山，使聚徒教授，是也。"}],"path":"南直方舆纪要/一、应天府（卷二十）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"9豫章雷次宗好學，隱居廬山。嘗徵爲散騎侍郞，不就。是歲，以處士徵至建康，爲開館於雞籠山，使聚徒敎授。帝雅好藝文，使丹楊尹廬江何尚之立玄學，太子率更令何承天立史學，司徒參軍謝元立文學，幷次宗儒學爲四學。元，靈運之從祖弟也。帝數幸次宗學館，令次宗以巾褠侍講，資給甚厚。又除給事中，不就。久之，還廬山。","content_fanyi":"刘宋豫章人雷次宗爱好学问，隐居在庐山。朝廷曾经征召他担任散骑侍郎，他没有接受。这一年，他以处士身份被征召到建康，朝廷为他在鸡笼山开设学馆，让他聚集门徒讲学。宋文帝一向爱好艺文，命丹杨尹庐江人何尚之设立玄学，太子率更令何承天设立史学，司徒参军谢元设立文学，与雷次宗的儒学合为“四学”。谢元是谢灵运的从祖弟。宋文帝多次到雷次宗的学馆，命雷次宗穿戴头巾、单衣为他侍讲，供给的财物十分丰厚。又任命他为给事中，他不肯接受。过了很久，他返回庐山。","content_jianti_auto":"9豫章雷次宗好学，隐居庐山。尝征为散骑侍郞，不就。是岁，以处士征至建康，为开馆于鸡笼山，使聚徒教授。帝雅好艺文，使丹杨尹庐江何尚之立玄学，太子率更令何承天立史学，司徒参军谢元立文学，幷次宗儒学为四学。元，灵运之从祖弟也。帝数幸次宗学馆，令次宗以巾褠侍讲，资给甚厚。又除给事中，不就。久之，还庐山。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11390,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"a8156a76-db0e-11ef-81db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"行，下孟翻。易·大畜·彖辭。","note_content_jianti_auto":"行，下孟翻。易·大畜·彖辞。","note_type":"hu_note","start_index":22,"tongjian_id":"a8156a99-db0e-11ef-be66-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"論語所記。","note_content_jianti_auto":"论语所记。","note_type":"hu_note","start_index":34,"tongjian_id":"a8156a9b-db0e-11ef-9015-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"a8156a9d-db0e-11ef-a8a8-a0d3651f611f"},{"link_birth_year":-551,"link_death_year":-479,"link_td_description":"孔丘，春秋末期鲁国的教育家与哲学家，儒家创始人兼主要代表人物。","link_td_id":"Q10000008","link_td_number_id":484,"people_name":"孔子","people_name_jianti_auto":"孔子","people_xingming":"孔子","start_index":22,"tongjian_id":"a8156a9f-db0e-11ef-9fc3-a0d3651f611f"},{"link_birth_year":-571,"link_death_year":-471,"link_td_description":"老子，春秋时期思想家，道家及道教的奠基者，著有《道德经》。","link_td_id":"Q10000007","link_td_number_id":2195,"people_name":"老","people_name_jianti_auto":"老","people_xingming":"老子","start_index":52,"tongjian_id":"a8156aa0-db0e-11ef-8dcf-a0d3651f611f"},{"link_birth_year":-369,"link_death_year":-286,"link_td_description":"庄子，庄氏，名周，一说字子休，约与孟子同时，宋国蒙人，曾任漆园吏。为中国战国中期思想家、哲学家、文学家，是道家学派的代表人物，老子思想的继承和发展者，后世将他与老子并称为“老庄”。","link_td_id":"Q10000070","link_td_number_id":2168,"people_name":"莊","people_name_jianti_auto":"庄","people_xingming":"庄子","start_index":54,"tongjian_id":"a8156aa1-db0e-11ef-9818-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：易曰：「君子多識前言往行以畜其德。」孔子曰：「辭達而已矣。」然則史者儒之一端，文者儒之餘事；至於老、莊虛無，固非所以爲敎也。夫學者所以求道；天下無二道，安有四學哉！","content_fanyi":"臣司马光说：《易经》说：“君子多了解前人的言论和行事，以积累自己的德行。”孔子说：“言辞能表达清楚意思就够了。”既然如此，那么史学是儒学的一个方面，文学只是儒学的末节；至于老子、庄子的虚无之说，本来就不是用来教化的。学习的人是为了探求大道；天下没有两种大道，哪里会有“四学”呢！","content_jianti_auto":"臣光曰：易曰：「君子多识前言往行以畜其德。」孔子曰：「辞达而已矣。」然则史者儒之一端，文者儒之余事；至于老、庄虚无，固非所以为教也。夫学者所以求道；天下无二道，安有四学哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":11391,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"a8156a98-db0e-11ef-a09a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歲賦，常賦也，言不額外取民。","note_content_jianti_auto":"岁赋，常赋也，言不额外取民。","note_type":"hu_note","start_index":82,"tongjian_id":"a8156aa4-db0e-11ef-a0ab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自適己事而已。","note_content_jianti_auto":"自适己事而已。","note_type":"hu_note","start_index":92,"tongjian_id":"a8156aa5-db0e-11ef-945b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"江左","place_name_jianti_auto":"江左","resolved_place_entity_id":1301,"start_index":112,"tongjian_id":"a8156aa7-db0e-11ef-b89d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","史论"],"content":"10帝性仁厚恭儉，勤於爲政；守法而不峻，容物而不弛。百官皆久於其職，守宰以六期爲斷；吏不苟免，民有所係。三十年間，四境之內，晏安無事，戶口蕃息；出租供傜，止於歲賦，晨出暮歸，自事而已。閭閻之間，講誦相聞；士敦操尚，鄕恥輕薄。江左風俗，於斯爲美，後之言政治者，皆稱元嘉焉。","content_fanyi":"宋文帝刘义隆生性仁厚谦恭而节俭，处理政务勤奋；遵守法度却不严厉，待人宽容而不放纵。百官大多长期任职，地方长官以六年为一个任期；官吏不轻易被免职，百姓有所依托。三十年间，国境之内安宁无事，人口繁衍生息；百姓缴纳田租、承担徭役，只限于每年的常额赋税，早出晚归，自谋生计而已。乡里街巷之间，讲学诵读之声彼此相闻；士人重视操行，乡里以轻薄为耻。江东的风俗，此时最为美好，后世谈论政治的人，都称赞元嘉时期。","content_jianti_auto":"10帝性仁厚恭俭，勤于为政；守法而不峻，容物而不弛。百官皆久于其职，守宰以六期为断；吏不苟免，民有所系。三十年间，四境之内，晏安无事，户口蕃息；出租供傜，止于岁赋，晨出暮归，自事而已。闾阎之间，讲诵相闻；士敦操尚，鄕耻轻薄。江左风俗，于斯为美，后之言政治者，皆称元嘉焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11392,"number":10,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"a8156aa2-db0e-11ef-b148-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000842"}],"reign_name":"十五年","reign_name_jianti_auto":"十五年","start_index":2,"tongjian_id":"a8137c2e-db0e-11ef-8ee5-a0d3651f611f","year_anno":"（戊寅、四三八）","year_int":438},"message":"success","success":true}