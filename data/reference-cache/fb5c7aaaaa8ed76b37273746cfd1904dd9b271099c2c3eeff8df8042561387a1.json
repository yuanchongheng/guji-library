_name":"隋","place_name_jianti_auto":"隋","start_index":130,"tongjian_id":"b40c8c06-db0e-11ef-b3d6-a0d3651f611f"},{"place_name":"營州","place_name_jianti_auto":"营州","start_index":132,"tongjian_id":"b40c8c07-db0e-11ef-9636-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋書：靺鞨在高麗之北，凡有七種：其一號栗末部，與高麗接；其二曰伯咄部，在栗末之北；其三曰安車骨部，在伯咄東北；其四曰拂涅部，在伯咄東；其五曰號室部，在拂涅東；其六曰黑水部，在安車骨西北；其七曰白山部，在栗末東南。而黑水部猶爲勁健，卽古之肅愼氏也。遼西郡治柳城，隋置營州總管府。靺，莫撥翻。鞨，戶葛翻。","note_content_jianti_auto":"隋书：靺鞨在高丽之北，凡有七种：其一号栗末部，与高丽接；其二曰伯咄部，在栗末之北；其三曰安车骨部，在伯咄东北；其四曰拂涅部，在伯咄东；其五曰号室部，在拂涅东；其六曰黑水部，在安车骨西北；其七曰白山部，在栗末东南。而黑水部犹为劲健，即古之肃愼氏也。辽西郡治柳城，隋置营州总管府。靺，莫拨翻。鞨，户葛翻。","note_type":"hu_note","start_index":16,"tongjian_id":"b40c8bf1-db0e-11ef-833a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"營州總管","official_note":"營州總管是隋朝地方军事行政长官，负责营州地区的军事和民政，此处韦冲担任此职，击退高丽入侵。","official_rank":"未知","source_snippet":"營州總管韋沖擊走之","start_index":12,"tongjian_id":"1d1525d9-651d-45cc-8968-d1ee471c9893"},{"confidence":0.9,"official_category":"军事指挥","official_name":"行軍元帥","official_note":"行軍元帥是隋朝临时任命的军事统帅，负责指挥大规模远征，此处汉王谅和王世积被任命为元帅，领导伐高丽的军队。","official_rank":"高级","source_snippet":"以漢王諒、王世積並爲行軍元帥","start_index":38,"tongjian_id":"e78321f8-8f32-4f6b-ad05-271f990f43d8"},{"confidence":0.92,"official_category":"中枢机构","official_name":"尚書左僕射","official_note":"尚書左僕射是隋朝尚书省的高级官员，协助处理国家政务，此处高熲担任此职，并被任命为汉王谅的长史，辅助军事行动。","official_rank":"正二品","source_snippet":"以尚書左僕射高熲爲漢王長史","start_index":58,"tongjian_id":"60fcc270-e56d-4347-a623-90a1e95e29d3"},{"confidence":0.88,"official_category":"军事指挥","official_name":"漢王長史","official_note":"漢王長史是汉王谅的属官，负责王府事务和军事辅助，此处高熲兼任此职，协助汉王谅指挥伐高丽的军队。","official_rank":"未知","source_snippet":"以尚書左僕射高熲爲漢王長史","start_index":58,"tongjian_id":"45b85b7e-b79c-48b1-984a-f87111180aff"},{"confidence":0.9,"official_category":"军事指挥","official_name":"水軍總管","official_note":"水軍總管是隋朝水军指挥官，负责水军作战，此处周罗㬋担任此职，参与伐高丽的军事行动。","official_rank":"未知","source_snippet":"周羅㬋爲水軍總管","start_index":70,"tongjian_id":"a42ad650-1b27-465b-906a-acddc2c0379a"}],"ExtRef_Children_people":[{"people_name":"高麗王","people_name_jianti_auto":"高丽王","people_xingming":"高元","start_index":1,"tongjian_id":"b40c8c10-db0e-11ef-bff9-a0d3651f611f","wl_zhushi":"[高]"},{"people_name":"元","people_name_jianti_auto":"元","people_xingming":"高元","start_index":4,"tongjian_id":"b40c8c11-db0e-11ef-b9bd-a0d3651f611f"},{"link_birth_year":540,"link_death_year":605,"link_td_description":"韦冲，字世冲，京兆郡杜陵县（今陕西省西安市长安区）人，出自京兆韦氏逍遥公房，北周、隋朝官员。","link_td_id":"Q10019768","link_td_number_id":6020262,"people_name":"韋沖","people_name_jianti_auto":"韦冲","people_xingming":"韦冲","start_index":20,"tongjian_id":"b40c8c14-db0e-11ef-8210-a0d3651f611f"},{"link_death_year":605,"link_td_description":"杨谅，字德章，一名杰，隋文帝杨坚第五子，母独孤皇后。因不满隋炀帝杨广，起兵造反，被杨素率兵击败，被囚至死。","link_td_id":"Q10009617","link_td_number_id":765655,"people_name":"漢王","people_name_jianti_auto":"汉王","people_xingming":"杨谅","start_index":36,"tongjian_id":"b40c8c15-db0e-11ef-8dac-a0d3651f611f","wl_zhushi":"[高]"},{"link_death_year":605,"link_td_description":"杨谅，字德章，一名杰，隋文帝杨坚第五子，母独孤皇后。因不满隋炀帝杨广，起兵造反，被杨素率兵击败，被囚至死。","link_td_id":"Q10009617","link_td_number_id":765655,"people_name":"諒","people_name_jianti_auto":"谅","people_xingming":"杨谅","start_index":38,"tongjian_id":"b40c8c16-db0e-11ef-b6a5-a0d3651f611f"},{"link_td_description":"王世积，闡熙新囶人，王雅之子。","link_td_id":"Q10011080","link_td_number_id":1216325,"people_name":"王世積","people_name_jianti_auto":"王世积","people_xingming":"王世积","start_index":40,"tongjian_id":"b40c8c17-db0e-11ef-9316-a0d3651f611f"},{"link_death_year":607,"link_td_description":"高颎，字昭玄，一名敏，渤海郡蓨县（今河北景县）人，其父高宾为独孤信赐姓独孤氏，因此又称独孤颎，为隋朝宰相执政近20年，其子是杨勇的女婿，后因反对废太子杨勇并得罪独孤皇后，遭隋文帝猜忌，被免官为民，不久后又免去齐国公爵位。隋炀帝时，被起用为太常卿。大业三年，见炀帝奢靡，甚为忧虑，有所议论，为人告发，与贺若弼同时被杀害。诸子遭到流放。","link_td_id":"Q10001643","link_td_number_id":329611,"people_name":"高熲","people_name_jianti_auto":"高颎","people_xingming":"高颎","start_index":66,"tongjian_id":"b40c8c1a-db0e-11ef-a80b-a0d3651f611f"},{"link_death_year":605,"link_td_description":"杨谅，字德章，一名杰，隋文帝杨坚第五子，母独孤皇后。因不满隋炀帝杨广，起兵造反，被杨素率兵击败，被囚至死。","link_td_id":"Q10009617","link_td_number_id":765655,"people_name":"漢王","people_name_jianti_auto":"汉王","people_xingming":"杨谅","start_index":69,"tongjian_id":"b40c8c1b-db0e-11ef-86eb-a0d3651f611f","wl_zhushi":"[高]"},{"link_birth_year":542,"link_death_year":605,"link_td_description":"周罗睺，字公布，南陈、隋朝将领。九江浔阳人（今江西省九江市）人。","link_td_id":"Q10011572","link_td_number_id":1280167,"people_name":"周羅㬋","people_name_jianti_auto":"周罗㬋","people_xingming":"周罗睺","start_index":74,"tongjian_id":"b40c8c1c-db0e-11ef-a994-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"靺鞨","place_name_jianti_auto":"靺鞨","resolved_place_entity_id":1012,"start_index":6,"tongjian_id":"b40c8c12-db0e-11ef-863f-a0d3651f611f"},{"place_name":"遼西","place_name_jianti_auto":"辽西","place_note":"辽西走廊•辽宁省西南部","resolved_place_entity_id":656,"start_index":13,"tongjian_id":"b40c8c13-db0e-11ef-b4c2-a0d3651f611f"},{"place_name":"營州","place_name_jianti_auto":"营州","place_note":"总部设营州【辽宁省朝阳市】","resolved_place_entity_id":710,"start_index":16,"tongjian_id":"b40c8c18-db0e-11ef-a476-a0d3651f611f"},{"place_name":"高麗","place_name_jianti_auto":"高丽","resolved_place_entity_id":226,"start_index":57,"tongjian_id":"b40c8c19-db0e-11ef-9910-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"隋文帝攻高句丽之战","tongjian_id":"war_N0827"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"大业九年，杨玄感叛，李密谓玄感曰：天子出征，远在辽外。据...","context_before":"...，南临大海，相距不过数里，实为险要。隋开皇三年，城渝关。","source_end_index":247,"source_paragraph_tongjian_id":"e257701c-ab9a-5c92-b5df-2a778d0ec556","source_start_index":216,"source_text":"十八年，命汉王谅将兵伐高丽，出临渝关。值水潦，馈运不继，而还。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/九、朝鲜（卷三十七）","excerpts":[{"context_after":"大业七年，讨高丽。明年，发二十四军分道并进，总集平壤，不...","context_before":"...，隋主赐玺书责其称藩，汤受命。会卒，子元嗣，隋仍封为王。","source_end_index":632,"source_paragraph_tongjian_id":"c28e9df9-8375-5908-be97-238cbd7f9e3c","source_start_index":593,"source_text":"明年，元帅靺鞨之众寇辽西，隋营州总管韦冲却之。隋因伐高丽，元遣使谢罪，乃罢兵。"},{"context_after":"大业八年，诏左右各十二军分道伐高丽，总集平壤。明年，复遣...","context_before":"...道，谓此。《隋书》：平壤城东西六里，随山屈曲，南临浿水。","source_end_index":215,"source_paragraph_tongjian_id":"7b6775e0-2607-5d2f-9e10-d5f6641924b3","source_start_index":183,"source_text":"开皇十八年，伐高丽，命周罗睺将水军自东莱泛海趋平壤，不能达而还。"}],"path":"山东方舆纪要/九、朝鲜（卷三十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十、女真（卷三十七）","excerpts":[{"context_after":"唐贞观二年，黑水渠长阿固郎来朝，因置燕州授之。开元十四年...","context_before":"...部，在粟末东南。白山、粟末皆近边，惟黑水居极北，尤强盛。","source_end_index":76,"source_paragraph_tongjian_id":"507afa39-f140-5512-aa95-fcb438262be1","source_start_index":55,"source_text":"开皇十八年，高丽王汤帅靺鞨之众万余寇辽西。"}],"path":"山东方舆纪要/十、女真（卷三十七）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"2高麗王元帥靺鞨之衆萬餘寇遼西，營州總管韋沖擊走之。上聞而大怒，乙巳，以漢王諒、王世積並爲行軍元帥，將水陸三十萬伐高麗，以尚書左僕射高熲爲漢王長史，周羅㬋爲水軍總管。","content_fanyi":"高丽王高元率领一万余名靺鞨兵众进犯辽西郡，营州总管韦冲率军将其击走。隋文帝闻报后大为震怒。二月初四日乙巳，任命汉王杨谅与上柱国王世积共同担任行军元帅，统率水陆三十万兵马征讨高丽；又任命尚书左仆射高颎任汉王长史，周罗睺任水军总管。","content_jianti_auto":"2高丽王元帅靺鞨之众万余寇辽西，营州总管韦冲击走之。上闻而大怒，乙巳，以汉王谅、王世积并为行军元帅，将水陆三十万伐高丽，以尚书左仆射高颎为汉王长史，周罗㬋为水军总管。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17307,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"b40c8bf0-db0e-11ef-98db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"延安郡","place_name_jianti_auto":"延安郡","start_index":3,"tongjian_id":"b40d4050-db0e-11ef-bba5-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":7,"tongjian_id":"b40d4051-db0e-11ef-805c-a0d3651f611f"},{"place_name":"東夏州","place_name_jianti_auto":"东夏州","start_index":10,"tongjian_id":"b40d4052-db0e-11ef-82f4-a0d3651f611f"},{"place_name":"西魏","place_name_jianti_auto":"西魏","start_index":14,"tongjian_id":"b40d4053-db0e-11ef-acda-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","start_index":17,"tongjian_id":"b40d4054-db0e-11ef-86a8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋志：延安郡，後魏置東夏州，西魏改延州。陀，徒河翻。","note_content_jianti_auto":"隋志：延安郡，后魏置东夏州，西魏改延州。陀，徒河翻。","note_type":"hu_note","start_index":8,"tongjian_id":"b40d404f-db0e-11ef-8de9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"阿，烏葛翻。尼，女夷翻；下同。","note_content_jianti_auto":"阿，乌葛翻。尼，女夷翻；下同。","note_type":"hu_note","start_index":15,"tongjian_id":"b40d4056-db0e-11ef-8e83-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐阿尼","people_name_jianti_auto":"徐阿尼","start_index":7,"tongjian_id":"b40d4058-db0e-11ef-8688-a0d3651f611f"},{"people_name":"陀","people_name_jianti_auto":"陀","start_index":28,"tongjian_id":"b40d4059-db0e-11ef-8532-a0d3651f611f"},{"people_name":"陀","people_name_jianti_auto":"陀","start_index":47,"tongjian_id":"b40d405a-db0e-11ef-9479-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":50,"tongjian_id":"b40d405b-db0e-11ef-b7ee-a0d3651f611f"},{"people_name":"越公","people_name_jianti_auto":"越公","start_index":60,"tongjian_id":"b40d405c-db0e-11ef-99f6-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":71,"tongjian_id":"b40d405d-db0e-11ef-9957-a0d3651f611f"},{"people_name":"素","people_name_jianti_auto":"素","start_index":84,"tongjian_id":"b40d405e-db0e-11ef-86c0-a0d3651f611f"},{"people_name":"陀","people_name_jianti_auto":"陀","start_index":98,"tongjian_id":"b40d405f-db0e-11ef-9264-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":100,"tongjian_id":"b40d4060-db0e-11ef-b288-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":121,"tongjian_id":"b40d4061-db0e-11ef-a06f-a0d3651f611f"},{"people_name":"楊遠","people_name_jianti_auto":"杨远","start_index":135,"tongjian_id":"b40d4062-db0e-11ef-8182-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":144,"tongjian_id":"b40d4063-db0e-11ef-9d93-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":150,"tongjian_id":"b40d4064-db0e-11ef-95bd-a0d3651f611f"},{"people_name":"阿尼","people_name_jianti_auto":"阿尼","start_index":185,"tongjian_id":"b40d4065-db0e-11ef-aa08-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":94,"tongjian_id":"b40d4066-db0e-11ef-b491-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋書·陀傳云：徐阿尼事貓鬼，每以子夜祀之，言子者，鼠也。陀嘗從家中索酒，其妻曰：「無錢可酤。」陀因謂阿尼曰：「可令貓鬼向越公家，使我足錢也。」阿尼便呪之。居數日，貓鬼向素家。十一年，上初從幷州還，陀謂阿尼曰：「可令貓鬼向皇后所，使多賜吾物。」阿尼復呪之，遂入宮中。大理丞楊遠乃於門下外省遣阿尼呼貓鬼，阿尼於是夜中置香粥一盆，以匙扣而呼之曰：「貓女可來，無住宮中。」久之，阿尼色正青，若被牽曳者。云貓鬼已至。由是其事具得實。畜，吁玉翻；下同。","note_content_jianti_auto":"隋书·陀传云：徐阿尼事猫鬼，每以子夜祀之，言子者，鼠也。陀尝从家中索酒，其妻曰：「无钱可酤。」陀因谓阿尼曰：「可令猫鬼向越公家，使我足钱也。」阿尼便呪之。居数日，猫鬼向素家。十一年，上初从幷州还，陀谓阿尼曰：「可令猫鬼向皇后所，使多赐吾物。」阿尼复呪之，遂入宫中。大理丞杨远乃于门下外省遣阿尼呼猫鬼，阿尼于是夜中置香粥一盆，以匙扣而呼之曰：「猫女可来，无住宫中。」久之，阿尼色正青，若被牵曳者。云猫鬼已至。由是其事具得实。畜，吁玉翻；下同。","note_type":"hu_note","start_index":68,"tongjian_id":"b40d4057-db0e-11ef-adc2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"b40d406b-db0e-11ef-99bc-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"b40d406c-db0e-11ef-bc69-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十一行本「死」下有「於家」二字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：甲十一行本「死」下有「于家」二字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"b40d406a-db0e-11ef-9ef6-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":123,"tongjian_id":"b40d4069-db0e-11ef-bd06-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲，于僞翻；下同。","note_content_jianti_auto":"为，于伪翻；下同。","note_type":"hu_note","start_index":137,"tongjian_id":"b40d406d-db0e-11ef-9e07-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"司勳侍郞屬吏部尚書。","note_content_jianti_auto":"司勋侍郞属吏部尚书。","note_type":"hu_note","start_index":175,"tongjian_id":"b40d406e-db0e-11ef-a172-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"江","place_name_jianti_auto":"江","start_index":5,"tongjian_id":"b40d4072-db0e-11ef-8469-a0d3651f611f"},{"place_name":"宜春","place_name_jianti_auto":"宜春","place_note":"袁州•江西省宜春市","start_index":15,"tongjian_id":"b40d4073-db0e-11ef-91b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋書·志：江南諸郡往往畜蠱，而宜春偏甚。其法以五月五日聚百種蟲，大者至蛇，小者至蝨，合置器中，令自相啖，餘一種存者留之，蛇則曰蛇蠱，蝨則曰蝨蠱，行以殺人，因食入人腹內，食其五藏，死則其產移入蠱主之家。三年不殺他人，則畜者自鍾其弊。累世子孫相傳不絕，亦有隨女子嫁者。厭，於琰翻。魅，音媚。","note_content_jianti_auto":"隋书·志：江南诸郡往往畜蛊，而宜春偏甚。其法以五月五日聚百种虫，大者至蛇，小者至虱，合置器中，令自相啖，余一种存者留之，蛇则曰蛇蛊，虱则曰虱蛊，行以杀人，因食入人腹内，食其五藏，死则其产移入蛊主之家。三年不杀他人，则畜者自钟其弊。累世子孙相传不绝，亦有随女子嫁者。厌，于琰翻。魅，音媚。","note_type":"hu_note","start_index":257,"tongjian_id":"b40d4071-db0e-11ef-bd5e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"延州刺史","official_note":"延州刺史是隋朝地方行政官职，负责管理延州（今陕西延安一带）的政务和军事。在上下文中，独孤陀担任此职，因涉及猫鬼事件被调查，显示其作为地方官员可能滥用职权或参与不法活动。","official_rank":"未知","source_snippet":"延州刺史獨孤陀有婢曰徐阿尼","start_index":0,"tongjian_id":"0747516f-f465-4bd0-afeb-8ac4e8c88857"},{"confidence":0.9,"official_category":"中枢机构","official_name":"司勳侍郞","official_note":"司勳侍郞是隋朝中枢官职，隶属于吏部，负责官员的勋绩考核和封赏事务。在上下文中，独孤整以此官职身份向皇帝求情，帮助其兄独孤陀免死，体现了该官职在朝廷中的影响力。","official_rank":"未知","source_snippet":"陀弟司勳侍郞整詣闕求哀","start_index":142,"tongjian_id":"3f94f37d-9b9c-4800-8307-f85b5518ee3a"}],"ExtRef_Children_people":[{"link_td_description":"独孤陀，字黎邪，云中盛乐（内蒙古和林格尔县）人，西魏八大柱国之一独孤信的第六子，独孤伽罗皇后的异母弟。","link_td_id":"Q10015259","link_td_number_id":3395525,"people_name":"獨孤陀","people_name_jianti_auto":"独孤陀","people_xingming":"独孤陀","start_index":5,"tongjian_id":"b40d4075-db0e-11ef-b074-a0d3651f611f"},{"people_name":"徐阿尼","people_name_jianti_auto":"徐阿尼","people_xingming":"徐阿尼","start_index":11,"tongjian_id":"b40d4077-db0e-11ef-a649-a0d3651f611f"},{"people_name":"獨孤后","people_name_jianti_auto":"独孤后","people_xingming":"独孤后","start_index":44,"tongjian_id":"b40d4078-db0e-11ef-8893-a0d3651f611f"},{"link_birth_year":544,"link_death_year":606,"link_td_description":"杨素，字处道，弘农郡华阴县人，出自弘农杨氏越公房，北周、隋朝军事家、诗人。","link_td_id":"Q10008547","link_td_number_id":321425,"people_name":"楊素","people_name_jianti_auto":"杨素","people_xingming":"杨素","start_index":48,"tongjian_id":"b40d4079-db0e-11ef-aff7-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","people_xingming":"郑氏","start_index":51,"tongjian_id":"b40d407a-db0e-11ef-b3db-a0d3651f611f"},{"link_td_description":"独孤陀，字黎邪，云中盛乐（内蒙古和林格尔县）人，西魏八大柱国之一独孤信的第六子，独孤伽罗皇后的异母弟。","link_td_id":"Q10015259","link_td_number_id":3395525,"people_name":"陀","people_name_jianti_auto":"陀","people