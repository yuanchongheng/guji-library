0-35174107312b"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司空","official_note":"司空是汉代三公之一，掌管水土工程，此处伏恭被任命为司空，显示官职任命。","official_rank":"正一品","source_snippet":"伏恭爲司空","start_index":40,"tongjian_id":"564f9f98-04fd-48bb-b40c-83e468a6aab8"}],"ExtRef_Children_people":[{"link_birth_year":-25,"link_death_year":62,"link_td_description":"郭丹，字少卿，南阳郡穰县人（今河南省邓州市），东汉政治人物。郭丹七岁丧父，后去长安求学，官至司徒，为官清廉，但晚年却因听信奸吏错判陇西太守邓融入狱，而被免职。汉明帝永平五年（62年），郭丹在家中逝世，终年八十七岁。","link_td_id":"Q10007316","link_td_number_id":1630383,"people_name":"郭丹","people_name_jianti_auto":"郭丹","people_xingming":"郭丹","start_index":11,"tongjian_id":"95088ebb-db0e-11ef-8079-a0d3651f611f"},{"link_birth_year":-1,"link_death_year":85,"link_td_description":"冯鲂，字孝孙，南阳郡湖阳县（今河南省唐河县西南）人，东汉光武帝时司空。","link_td_id":"Q10007426","link_td_number_id":5397191,"people_name":"馮魴","people_name_jianti_auto":"冯鲂","people_xingming":"冯鲂","start_index":16,"tongjian_id":"95088ebc-db0e-11ef-a3ec-a0d3651f611f"},{"link_death_year":66,"link_td_description":"范迁，字子庐，沛国（今安徽省濉溪县西北）人，东汉司徒。","link_td_id":"Q10007308","link_td_number_id":5396941,"people_name":"范遷","people_name_jianti_auto":"范迁","people_xingming":"范迁","start_index":26,"tongjian_id":"95088ebd-db0e-11ef-8327-a0d3651f611f"},{"link_birth_year":-6,"link_death_year":84,"link_td_description":"伏恭，字叔齐，琅邪郡东武（今山东省诸城市）人，东汉经学家、司空。","link_td_id":"Q10007427","link_td_number_id":5396958,"people_name":"伏恭","people_name_jianti_auto":"伏恭","people_xingming":"伏恭","start_index":34,"tongjian_id":"95088ebe-db0e-11ef-96a8-a0d3651f611f"},{"link_birth_year":-6,"link_death_year":84,"link_td_description":"伏恭，字叔齐，琅邪郡东武（今山东省诸城市）人，东汉经学家、司空。","link_td_id":"Q10007427","link_td_number_id":5396958,"people_name":"恭","people_name_jianti_auto":"恭","people_xingming":"伏恭","start_index":40,"tongjian_id":"95088ebf-db0e-11ef-b8ce-a0d3651f611f"},{"link_death_year":37,"link_td_description":"伏湛，表字惠公，徐州琅邪郡东武县（今山东省诸城市）人，西汉末期、东汉初期政治人物。","link_td_id":"Q10018167","link_td_number_id":5430802,"people_name":"湛","people_name_jianti_au