将他杀死，兼并了他的国土。匈奴征调诸国军队包围于窴，广德请求归降。匈奴把贤生前送来作人质的儿子不居徵立为莎车王，广德又攻打莎车杀死不居徵，另立他的弟弟齐黎为莎车王。","content_jianti_auto":"5于窴王广德将诸国兵三万人攻莎车，诱莎车王贤，杀之，幷其国。匈奴发诸国兵围于窴，广德请降。匈奴立贤质子不居征为莎车王，广德又攻杀之，更立其弟齐黎为莎车王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3551,"number":5,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"950a4e9d-db0e-11ef-a0d6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蒼","people_name_jianti_auto":"苍","start_index":0,"tongjian_id":"950a4eb2-db0e-11ef-8d79-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蒼輔政，始上卷中元二年。","note_content_jianti_auto":"苍辅政，始上卷中元二年。","note_type":"hu_note","start_index":12,"tongjian_id":"950a4eb1-db0e-11ef-adae-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"驃騎將軍","official_note":"驃騎將軍是漢代高級武官，位次於大將軍，掌管軍事，此處東平王蒼請求上交此職印綬以退居藩國，顯示其權力與地位。","official_rank":"正一品或從一品","source_snippet":"乞上驃騎將軍印綬","start_index":54,"tongjian_id":"bc7cf6e5-a9f5-4a3e-9e1e-e6cc838a343e"}],"ExtRef_Children_people":[{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"東平王","people_name_jianti_auto":"东平王","people_xingming":"刘苍","start_index":1,"tongjian_id":"950a4eb4-db0e-11ef-bc6d-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":4,"tongjian_id":"950a4eb5-db0e-11ef-8804-a0d3651f611f"},{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":71,"tongjian_id":"950a4eb6-db0e-11ef-a2cb-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":31,"tongjian_id":"950a4eb7-db0e-11ef-b6cf-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"6東平王蒼自以至親輔政，聲望日重，意不自安，前後累上疏稱：「自漢興以來，宗室子弟無得在公卿位者，乞上驃騎將軍印綬，退就藩國。」辭甚懇切，帝乃許蒼還國，而不聽上將軍印綬。","content_fanyi":"东平王刘苍认为自己是明帝至亲而辅政，声望一天比一天高，内心很不安，先后多次上疏说：“自汉朝建立以来，宗室子弟中没有人能处在公卿的位置上，我请求交还骠骑将军的印绶，退回封国。”言辞非常恳切，明帝于是准许刘苍回封国，却不允许他交还骠骑将军的印绶。","content_jianti_auto":"6东平王苍自以至亲辅政，声望日重，意不自安，前后累上疏称：「自汉兴以来，宗室子弟无得在公卿位者，乞上骠骑将军印绶，退就藩国。」辞甚恳切，帝乃许苍还国，而不听上将军印绶。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3552,"number":6,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"950a4eb0-db0e-11ef-9911-a0d3651f611f"}],"reign_name":"永平四年","reign_name_jianti_auto":"永平四年","start_index":0,"tongjian_id":"95088ea9-db0e-11ef-9fbe-a0d3651f611f","year_anno":"（辛酉、六一）","year_int":61},"message":"success","success":true}