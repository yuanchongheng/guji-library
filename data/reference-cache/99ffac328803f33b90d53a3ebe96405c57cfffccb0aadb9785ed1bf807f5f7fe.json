_name_jianti_auto":"陵鄕侯","start_index":6,"tongjian_id":"950a2910-db0e-11ef-85e4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"松嗣父統爵爲陵鄕侯。縣，讀曰懸。下，遐稼翻。","note_content_jianti_auto":"松嗣父统爵为陵鄕侯。县，读曰悬。下，遐稼翻。","note_type":"hu_note","start_index":20,"tongjian_id":"950a290d-db0e-11ef-ae8b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"陵鄕侯","official_note":"陵鄕侯是漢代的爵位，屬於列侯，通常授予有功或皇室成員，表示封地為陵鄕。在《資治通鑑》此段中，梁松因被指控怨望和誹謗而被處死，陵鄕侯作為其爵位，標示其身份地位，但非官職。","official_rank":"侯爵","source_snippet":"陵鄕侯梁松坐怨望、縣飛書誹謗，下獄死。","start_index":0,"tongjian_id":"e20fe25a-fd0b-4eeb-b8d0-bd8ab865158f"}],"ExtRef_Children_people":[{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"陵鄕侯","people_name_jianti_auto":"陵鄕侯","people_xingming":"梁松","start_index":1,"tongjian_id":"950a2911-db0e-11ef-98d4-a0d3651f611f"},{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"梁松","people_name_jianti_auto":"梁松","people_xingming":"梁松","start_index":4,"tongjian_id":"950a2912-db0e-11ef-99c0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4陵鄕侯梁松坐怨望、縣飛書誹謗，下獄死。","content_fanyi":"陵乡侯梁松因对朝廷心怀怨恨，又悬挂匿名书诽谤朝政而获罪，被关进监狱处死。","content_jianti_auto":"4陵鄕侯梁松坐怨望、县飞书诽谤，下狱死。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3549,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"950a290c-db0e-11ef-a01f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"知名者，有名於時，人皆知之也。","note_content_jianti_auto":"知名者，有名于时，人皆知之也。","note_type":"hu_note","start_index":21,"tongjian_id":"950a4e90-db0e-11ef-bcff-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"儲，副也。","note_content_jianti_auto":"储，副也。","note_type":"hu_note","start_index":52,"tongjian_id":"950a4e91-db0e-11ef-9ac5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢近臣","official_name":"太中大夫","official_note":"太中大夫是汉代中央官职，属光禄勋，负责顾问应对，无固定职掌，常作为加官或荣誉职位。在原文中，郑兴担任此职，其子郑众以通经闻名，官职用于标识人物身份。","official_rank":"比千石","source_snippet":"太中大夫鄭興子衆以通經知名","start_index":12,"tongjian_id":"19ee2a40-963d-4041-a9d0-b64771adb0e3"},{"confidence":0.95,"official_category":"储君","official_name":"太子","official_note":"太子是皇位继承人，在汉代具有特殊地位，负责学习政务。在原文中，太子与山阳王荆试图通过梁松结交郑众，官职用于表示其身份和行动。","official_rank":"未知","source_snippet":"太子及山陽王荊因梁松以縑帛請之","start_index":28,"tongjian_id":"21c6987f-25d9-4556-9d99-aa407b2e9f42"},{"confidence":0.9,"official_category":"地方行政","official_name":"山陽王","official_note":"山阳王是汉代分封的诸侯王，负责管理山阳国的地方事务。在原文中，山阳王荆与太子一起行动，官职用于标识其身份和参与事件。","official_rank":"诸侯王","source_snippet":"太子及山陽王荊因梁松以縑帛請之","start_index":31,"tongjian_id":"94a1d357-5cbc-4c88-8c83-eeeb2ed46efa"}],"ExtRef_Children_people":[{"link_td_description":"郑兴，字少赣，陈留郡浚仪县（今河南开封市南）人，东汉初年古文经学家、训诂学家、反谶纬神学的思想家，更始初年郑兴为丞相长史，劝说更始帝西都长安。为谏议大夫，奉使安集关西及朔方、凉州、益州，归还后拜凉州刺史，因事免官。","link_td_id":"Q10018943","link_td_number_id":5709193,"people_name":"鄭興","people_name_jianti_auto":"郑兴","people_xingming":"郑兴","start_index":11,"tongjian_id":"950a4e92-db0e-11ef-98c4-a0d3651f611f"},{"link_death_year":83,"link_td_description":"郑众，字仲师，河南郡开封县（今河南省开封市）人。东汉时经学家，官至大司农，又称郑司农。","link_td_id":"Q10003423","link_td_number_id":1066574,"people_name":"衆","people_name_jianti_auto":"众","people_xingming":"郑众","start_index":14,"tongjian_id":"950a4e93-db0e-11ef-8adf-a0d3651f611f"},{"people_name":"山陽王","people_name_jianti_auto":"山阳王","people_xingming":"刘荆","start_index":24,"tongjian_id":"950a4e94-db0e-11ef-89ee-a0d3651f611f"},{"people_name":"荊","people_name_jianti_auto":"荆","people_xingming":"刘荆","start_index":27,"tongjian_id":"950a4e95-db0e-11ef-ad52-a0d3651f611f"},{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"梁松","people_name_jianti_auto":"梁松","people_xingming":"梁松","start_index":29,"tongjian_id":"950a4e96-db0e-11ef-81c3-a0d3651f611f"},{"link_death_year":83,"link_td_description":"郑众，字仲师，河南郡开封县（今河南省开封市）人。东汉时经学家，官至大司农，又称郑司农。","link_td_id":"Q10003423","link_td_number_id":1066574,"people_name":"衆","people_name_jianti_auto":"众","start_index":37,"tongjian_id":"950a4e97-db0e-11ef-be8d-a0d3651f611f"},{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"松","people_name_jianti_auto":"松","people_xingming":"梁松","start_index":67,"tongjian_id":"950a4e98-db0e-11ef-81ea-a0d3651f611f"},{"link_death_year":83,"link_td_description":"郑众，字仲师，河南郡开封县（今河南省开封市）人。东汉时经学家，官至大司农，又称郑司农。","link_td_id":"Q10003423","link_td_number_id":1066574,"people_name":"衆","people_name_jianti_auto":"众","people_xingming":"郑众","start_index":80,"tongjian_id":"950a4e99-db0e-11ef-b263-a0d3651f611f"},{"link_death_year":61,"link_td_description":"梁松，梁统的长子，汉光武帝的女婿。","link_td_id":"Q10010052","link_td_number_id":942425,"people_name":"松","people_name_jianti_auto":"松","people_xingming":"梁松","start_index":102,"tongjian_id":"950a4e9a-db0e-11ef-9547-a0d3651f611f"},{"link_death_year":83,"link_td_description":"郑众，字仲师，河南郡开封县（今河南省开封市）人。东汉时经学家，官至大司农，又称郑司农。","link_td_id":"Q10003423","link_td_number_id":1066574,"people_name":"衆","people_name_jianti_auto":"众","people_xingming":"郑众","start_index":112,"tongjian_id":"950a4e9b-db0e-11ef-a0b3-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"950a4e8f-db0e-11ef-98d9-a0d3651f611f","pinyin":"jiān","source_anchor_text":"因梁松以縑帛請之眾","source_key":"baiyang_epub","start_index":32,"text":"縑","tongjian_id":"8b862940-6a91-57fc-a668-dad3e98564df"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":10,"start_index":52,"tongjian_id":"950a4e9c-db0e-11ef-9ab7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"初，上爲太子，太中大夫鄭興子衆以通經知名，太子及山陽王荊因梁松以縑帛請之，衆曰：「太子儲君，無外交之義；漢有舊防，蕃王不宜私通賓客。」松曰：「長老意，不可逆。」衆曰：「犯禁觸罪，不如守正而死。」遂不往。及松敗，賓客多坐之，唯衆不染於辭。","content_fanyi":"当初，明帝还是太子的时候，太中大夫郑兴的儿子郑众因精通经学而知名。太子和山阳王刘荆通过梁松带着缣帛去聘请郑众为门客，郑众说：“太子身为储君，没有与外朝大臣私相交往的道理；汉朝原有旧防，藩王不该私自结交宾客。”梁松说：“这是长者的意思，不可违逆。”郑众说：“触犯禁令而获罪，不如坚守正道而死。”最终没有前去应聘。等到梁松败亡，宾客大多因此获罪，只有郑众没有被供辞牵连。","content_jianti_auto":"初，上为太子，太中大夫郑兴子众以通经知名，太子及山阳王荆因梁松以缣帛请之，众曰：「太子储君，无外交之义；汉有旧防，蕃王不宜私通宾客。」松曰：「长老意，不可逆。」众曰：「犯禁触罪，不如守正而死。」遂不往。及松败，宾客多坐之，唯众不染于辞。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3550,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"950a4e8f-db0e-11ef-98d9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"于窴王","people_name_jianti_auto":"于窴王","people_xingming":"广德","start_index":1,"tongjian_id":"950a4ea1-db0e-11ef-8c5d-a0d3651f611f"},{"people_name":"廣德","people_name_jianti_auto":"广德","people_xingming":"广德","start_index":4,"tongjian_id":"950a4ea2-db0e-11ef-afe4-a0d3651f611f"},{"people_name":"莎車王","people_name_jianti_auto":"莎车王","people_xingming":"贤","start_index":18,"tongjian_id":"950a4ea3-db0e-11ef-ada1-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","people_xingming":"