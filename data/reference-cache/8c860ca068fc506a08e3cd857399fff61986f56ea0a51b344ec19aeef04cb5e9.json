auto":"淖子","start_index":45,"tongjian_id":"905a92ee-db0e-11ef-8f15-a0d3651f611f"},{"people_name":"武始侯","people_name_jianti_auto":"武始侯","people_xingming":"刘昌","start_index":76,"tongjian_id":"905a92ef-db0e-11ef-8398-a0d3651f611f"},{"people_name":"昌","people_name_jianti_auto":"昌","people_xingming":"刘昌","start_index":79,"tongjian_id":"905a92f0-db0e-11ef-b265-a0d3651f611f"},{"people_name":"昌","people_name_jianti_auto":"昌","people_xingming":"刘昌","start_index":104,"tongjian_id":"905a92f2-db0e-11ef-a9dd-a0d3651f611f"},{"people_name":"趙王","people_name_jianti_auto":"赵王","people_xingming":"刘昌","start_index":106,"tongjian_id":"905a92f3-db0e-11ef-90e7-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"905a92d8-db0e-11ef-a037-a0d3651f611f","pinyin":"nào","source_anchor_text":"易王所幸淖姬生男號","source_key":"baiyang_epub","start_index":21,"text":"淖","tongjian_id":"a07f71d2-60fa-5619-8d49-bdedbf34c0cc"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":36,"tongjian_id":"905a92f1-db0e-11ef-ba19-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/六、广平府（卷十五）","excerpts":[{"context_after":"后汉省。《汉志》注：武始县有拘涧水，东北至邯郸，入于白渠...","context_before":"...秦昭襄王十三年，向寿伐韩，取武始。汉因置武始县，属魏郡。","source_end_index":58,"source_paragraph_tongjian_id":"d1f8ed70-ae4e-57d7-97c2-e990ddf28f82","source_start_index":45,"source_text":"武帝封赵敬肃王子昌为侯邑。"}],"path":"北直方舆纪要/六、广平府（卷十五）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"2三月，趙敬肅王彭祖薨。彭祖取江都易王所幸淖姬，生男，號淖子。時淖姬兄爲漢宦者，上召問：「淖子何如？」對曰：「爲人多欲。」上曰：「多欲不宜君國子民。」問武始侯昌，曰：「無咎無譽。」上曰：「如是可矣。」遣使者立昌爲趙王。","content_fanyi":"三月，赵敬肃王刘彭祖去世。刘彭祖娶江都易王刘非所宠爱的淖姬为妻，生下一个儿子，称为刘淖子。当时淖姬的哥哥在汉宫中做宦官，汉武帝召他来问道：“淖子为人怎么样？”他回答说：“这个人欲望太多。”汉武帝说：“欲望太多的人不适合做国君治理百姓。”汉武帝又询问武始侯刘昌的情况，淖姬的哥哥说：“刘昌既没有过失，也没有值得称道的好名声。”汉武帝说：“像这样就可以了。”于是派遣使者将刘昌立为赵王。","content_jianti_auto":"2三月，赵敬肃王彭祖薨。彭祖取江都易王所幸淖姬，生男，号淖子。时淖姬兄为汉宦者，上召问：「淖子何如？」对曰：「为人多欲。」上曰：「多欲不宜君国子民。」问武始侯昌，曰：「无咎无誉。」上曰：「如是可矣。」遣使者立昌为赵王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1801,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"905a92d8-db0e-11ef-a037-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3夏，大旱。","content_fanyi":"夏季，发生大旱。","content_jianti_auto":"3夏，大旱。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1802,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"905cdc5f-db0e-11ef-8c0d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"門候，掌宮門出入之禁；續漢志，秩六百石。","note_content_jianti_auto":"门候，掌宫门出入之禁；续汉志，秩六百石。","note_type":"hu_note","start_index":46,"tongjian_id":"905cdc61-db0e-11ef-a30b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":0,"tongjian_id":"905cdc64-db0e-11ef-824e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"上林苑","place_name_jianti_auto":"上林苑","start_index":12,"tongjian_id":"905cdc65-db0e-11ef-ace1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臣瓚曰：搜，謂索姦人也。上林苑周回數百里，恐姦人藏匿其中，故大搜索。索，山客翻。","note_content_jianti_auto":"臣瓒曰：搜，谓索奸人也。上林苑周回数百里，恐奸人藏匿其中，故大搜索。索，山客翻。","note_type":"hu_note","start_index":69,"tongjian_id":"905cdc63-db0e-11ef-b18b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"門候","official_note":"門候是汉代负责城门守卫的官职，通常属于军事系统，掌管城门开闭和出入检查。在《资治通鉴》此段中，汉武帝因一男子带剑闯入建章宫后逃脱而愤怒，斩杀了门候，这反映了门候在宫廷安全中的责任，以及皇帝对失职官员的严厉惩罚。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"斬門候","start_index":38,"tongjian_id":"0248defd-3df6-4cc0-a0bc-4e54f145f979"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"建章宮","place_name_jianti_auto":"建章宫","resolved_place_entity_id":2123,"start_index":3,"tongjian_id":"905cdc66-db0e-11ef-ae42-a0d3651f611f"},{"place_name":"中龍華門","place_name_jianti_auto":"中龙华门","resolved_place_entity_id":5726,"start_index":14,"tongjian_id":"905cdc67-db0e-11ef-ba2c-a0d3651f611f"},{"place_name":"三輔","place_name_jianti_auto":"三辅","resolved_place_entity_id":476,"start_index":53,"tongjian_id":"905cdc68-db0e-11ef-ade5-a0d3651f611f"},{"place_name":"上林","place_name_jianti_auto":"上林","resolved_place_entity_id":1226,"start_index":59,"tongjian_id":"905cdc69-db0e-11ef-84df-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","resolved_place_entity_id":1318,"start_index":63,"tongjian_id":"905cdc6a-db0e-11ef-a0f3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/巫蛊之祸","excerpts":[{"context_after":"又尝昼寝，梦木人数千，持杖欲击己，乃惊寤，因是体不平，遂...","context_before":"汉世巫蛊之祸，虽起于江充，然事会之来，盖有不可晓者。","source_end_index":90,"source_paragraph_tongjian_id":"1fbd6a0c-fb6d-4ce0-9654-2a71cd60cb70","source_start_index":26,"source_text":"武帝居建章宫，亲见一男子带剑入中龙华门，疑其异人，命收之，男子捐剑走，逐之弗获。上怒，斩门候，闭长安城门，大索十一日，巫蛊始起。"}],"path":"续笔/卷二/巫蛊之祸","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"4上居建章宮，見一男子帶劍入中龍華門，疑其異人，命收之。男子捐劍走，逐之弗獲。上怒，斬門候。冬，十一月，發三輔騎士大搜上林，閉長安城門索；十一日乃解。巫蠱始起。","content_fanyi":"汉武帝住在建章宫，看见一名男子带剑进入中龙华门，怀疑他不是寻常人物，便下令拘捕。男子丢下剑逃跑，追赶的人没能拿获。武帝发怒，把门候处死。冬季十一月，调发三辅骑士在上林苑大加搜索，关闭长安城门进行搜捕；经过十一天才解除。巫蛊事件从此开始发生。","content_jianti_auto":"4上居建章宫，见一男子带剑入中龙华门，疑其异人，命收之。男子捐剑走，逐之弗获。上怒，斩门候。冬，十一月，发三辅骑士大搜上林，闭长安城门索；十一日乃解。巫蛊始起。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1803,"number":4,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":3,"tongjian_id":"905cdc60-db0e-11ef-aaa4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"下，遐嫁翻；下同。","note_content_jianti_auto":"下，遐嫁翻；下同。","note_type":"hu_note","start_index":55,"tongjian_id":"905cdc6c-db0e-11ef-affe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陽石公主","people_name_jianti_auto":"阳石公主","start_index":0,"tongjian_id":"905cdc6e-db0e-11ef-8f5b-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":9,"tongjian_id":"905cdc6f-db0e-11ef-ae13-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陽石","place_name_jianti_auto":"阳石","start_index":12,"tongjian_id":"905cdc70-db0e-11ef-99bb-a0d3651f611f"},{"place_name":"北海郡","place_name_jianti_auto":"北海郡","start_index":15,"tongjian_id":"905cdc71-db0e-11ef-927d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陽石公主，帝女也。班志：陽石屬北海郡。上書，時掌翻；下且上同。","note_content_jianti_auto":"阳石公主，帝女也。班志：阳石属北海郡。上书，时掌翻；下且上同。","note_type":"hu_note","start_index":125,"tongjian_id":"905cdc6d-db0e-11ef-877b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,