}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":8,"tongjian_id":"8c451aec-db0e-11ef-aa78-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。爲後齊大夫殺蘇秦張本。","note_content_jianti_auto":"说，式芮翻。为后齐大夫杀苏秦张本。","note_type":"hu_note","start_index":94,"tongjian_id":"8c451aea-db0e-11ef-9534-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"客卿","official_note":"客卿是战国时期诸侯国授予外来人才的官职，通常无固定品秩，用于招揽贤能，此处齐宣王任命苏秦为客卿，以利用其才能。","official_rank":"未知","source_snippet":"齊宣王以爲客卿","start_index":54,"tongjian_id":"55abda3f-da51-4da2-a7f4-be3b2b51fddb"}],"ExtRef_Children_people":[{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊宣王","people_name_jianti_auto":"齐宣王","people_xingming":"田辟彊","start_index":60,"tongjian_id":"8c451af7-db0e-11ef-8a6c-a0d3651f611f","wl_zhushi":"[田辟彊]"},{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田辟彊","start_index":71,"tongjian_id":"8c451af9-db0e-11ef-b4c4-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2蘇秦通於燕文公之夫人，易王知之。蘇秦恐，乃說易王曰：「臣居燕不能使燕重，而在齊則燕重。」易王許之。乃僞得罪於燕而奔齊，齊宣王以爲客卿。蘇秦說齊王高宮室，大苑囿，以明得意，欲以敝齊而爲燕。","content_fanyi":"苏秦与燕文公的夫人私通，燕易王得知了此事。苏秦很害怕，便对燕易王说：“我留在燕国不能使燕国增加威望，如果到了齐国，就能使燕国增加威望。”燕易王答应了他的请求。于是苏秦假装在燕国犯下罪过，逃到齐国，齐宣王任用他为客卿。苏秦劝齐王修建高大的宫室，扩大苑囿园池，借以显示自己的得意与地位，想使齐国国力衰敝，为燕国谋利益。","content_jianti_auto":"2苏秦通于燕文公之夫人，易王知之。苏秦恐，乃说易王曰：「臣居燕不能使燕重，而在齐则燕重。」易王许之。乃伪得罪于燕而奔齐，齐宣王以为客卿。苏秦说齐王高宫室，大苑囿，以明得意，欲以敝齐而为燕。","dtjl_paragraph_links":[],"dtjl_references":[],"id":211,"number":2,"path":"资治通鉴 : 卷第二 (周