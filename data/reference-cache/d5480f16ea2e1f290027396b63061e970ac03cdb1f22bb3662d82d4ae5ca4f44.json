ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：徐廣以爲長社濁澤，非也。括地志云：濁水源出蒲州解縣東北平地，爾時魏都安邑，韓、趙伐魏，豈至河南長社邪！解縣濁水近於魏都，當是也。","note_content_jianti_auto":"史记正义曰：徐广以为长社浊泽，非也。括地志云：浊水源出蒲州解县东北平地，尔时魏都安邑，韩、赵伐魏，岂至河南长社邪！解县浊水近于魏都，当是也。","note_type":"hu_note","start_index":53,"tongjian_id":"8c0d900f-db0e-11ef-bb57-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是古代中国的高级官职，通常指中央或诸侯国的官员，负责行政、军事或顾问职责。在《资治通鉴》此段中，王錯作为魏国的大夫，出奔韩国，反映了魏国内乱和官员流亡的情况。","official_rank":"未知","source_snippet":"魏大夫王錯出奔韓","start_index":1,"tongjian_id":"b8d9aa2a-fd2a-4b86-b5cf-fdb8e9905e41"}],"ExtRef_Children_people":[{"link_td_description":"王错，又作王钟，战国时期魏国大臣。","link_td_id":"Q10023074","link_td_number_id":8141574,"people_name":"王錯","people_name_jianti_auto":"王错","people_xingming":"王错","start_index":4,"tongjian_id":"8c0d9024-db0e-11ef-9529-a0d3651f611f"},{"link_td_description":"公孙颀，战国时期宋国人。","link_td_id":"Q10023068","link_td_number_id":8141566,"people_name":"公孫頎","people_name_jianti_auto":"公孙颀","people_xingming":"公孙颀","start_index":10,"tongjian_id":"8c0d9027-db0e-11ef-b4a6-a0d3651f611f"},{"people_name":"韓懿侯","people_name_jianti_auto":"韩懿侯","people_xingming":"韩若山","start_index":14,"tongjian_id":"8c0d9028-db0e-11ef-87c3-a0d3651f611f"},{"people_name":"懿侯","people_name_jianti_auto":"懿侯","people_xingming":"韩若山","start_index":28,"tongjian_id":"8c0d902a-db0e-11ef-9f1f-a0d3651f611f"},{"link_death_year":-350,"link_td_description":"赵成侯，中国战国时期赵国的君主，姓赵，名种，赵敬侯之子。","link_td_id":"Q10000669","link_td_number_id":334822,"people_name":"趙成侯","people_name_jianti_auto":"赵成侯","people_xingming":"赵种","start_index":32,"tongjian_id":"8c0d902b-db0e-11ef-b46a-a0d3651f611f"},{"link_death_year":-350,"link_td_description":"赵成侯，中国战国时期赵国的君主，姓赵，名种，赵敬侯之子。","link_td_id":"Q10000669","link_td_number_id":334822,"people_name":"成侯","people_name_jianti_auto":"成侯","people_xingming":"赵种","start_index":53,"tongjian_id":"8c0d902f-db0e-11ef-83f7-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"罃","people_name_jianti_auto":"䓨","people_xingming":"魏罃","start_index":59,"tongjian_id":"8c0d9030-db0e-11ef-9514-a0d3651f611f"},{"link_td_description":"魏缓，即公子缓（《史记》作公中缓，今从《竹书纪年》），魏武侯之子。","link_td_id":"Q10001652","link_td_number_id":488945,"people_name":"公中緩","people_name_jianti_auto":"公中缓","people_xingming":"公中缓","start_index":62,"tongjian_id":"8c0d9031-db0e-11ef-b900-a0d3651f611f"},{"people_name":"懿侯","people_name_jianti_auto":"懿侯","people_xingming":"韩若山","start_index":79,"tongjian_id":"8c0d9032-db0e-11ef-9f06-a0d3651f611f"},{"people_name":"懿侯","people_name_jianti_auto":"懿侯","people_xingming":"韩若山","start_index":134,"tongjian_id":"8c0d9033-db0e-11ef-866e-a0d3651f611f"},{"link_death_year":-350,"link_td_description":"赵成侯，中国战国时期赵国的君主，姓赵，名种，赵敬侯之子。","link_td_id":"Q10000669","link_td_number_id":334822,"people_name":"趙成侯","people_name_jianti_auto":"赵成侯","people_xingming":"赵种","start_index":145,"tongjian_id":"8c0d9034-db0e-11ef-9fc0-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"罃","people_name_jianti_auto":"䓨","people_xingming":"魏罃","start_index":151,"tongjian_id":"8c0d9035-db0e-11ef-a3ed-a0d3651f611f"},{"link_td_description":"魏缓，即公子缓（《史记》作公中缓，今从《竹书纪年》），魏武侯之子。","link_td_id":"Q10001652","link_td_number_id":488945,"people_name":"公中緩","people_name_jianti_auto":"公中缓","people_xingming":"公中缓","start_index":154,"tongjian_id":"8c0d9036-db0e-11ef-9fcf-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君