f-81a8-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","resolved_place_entity_id":613,"start_index":118,"tongjian_id":"8c0d903a-db0e-11ef-9feb-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":124,"tongjian_id":"8c0d903b-db0e-11ef-91db-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":129,"tongjian_id":"8c0d903c-db0e-11ef-aa04-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"浊泽之战","tongjian_id":"war_N0506"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"又《魏世家》：惠王初立，韩懿侯、赵成侯。合兵伐魏，战于浊...","context_before":"浊泽[《括地志》：出解县东北平地，即涿水也。涿，音浊。","source_end_index":44,"source_paragraph_tongjian_id":"1d0a34bb-866b-51fc-869d-65e217e3e958","source_start_index":27,"source_text":"《史记》：赵成侯六年，伐魏取涿泽。"},{"context_after":"徐广以为河南之浊泽，误也。今湮]。","context_before":"...，即涿水也。涿，音浊。《史记》：赵成侯六年，伐魏取涿泽。","source_end_index":87,"source_paragraph_tongjian_id":"1d0a34bb-866b-51fc-869d-65e217e3e958","source_start_index":44,"source_text":"又《魏世家》：惠王初立，韩懿侯、赵成侯。合兵伐魏，战于浊泽，魏氏大败。是时，魏都安邑。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"又七里为三亭冈。秦王稽与范雎言：待我三亭之南。即此。○蔡...","context_before":"鸡鸣城[在县西南三十里。","source_end_index":43,"source_paragraph_tongjian_id":"a5278a9d-1b2e-5ef5-85e6-269ce5d76ae2","source_start_index":12,"source_text":"《竹书》：魏惠成王元年，韩伐魏，军于捴泽陂，北对鸡鸣城。是也。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":["军事","权争"],"content":"3魏大夫王錯出奔韓。公孫頎謂韓懿侯曰：「魏亂，可取也。」懿侯乃與趙成侯合兵伐魏，戰于濁澤，大破之，遂圍魏。成侯曰：「殺罃，立公中緩，割地而退，我二國之利也。」懿侯曰：「不可。殺魏君，暴也；割地而退，貪也。不如兩分之。魏分爲兩，不強於宋、衞，則我終無魏患矣。」趙人不聽。懿侯不悅，以其兵夜去。趙成侯亦去。罃遂殺公中緩而立，是爲惠王。","content_fanyi":"魏国大夫王错出逃到韩国。公孙颀对韩懿侯说：“魏国混乱，可以攻取。”韩懿侯便与赵成侯合兵攻打魏国，在浊泽交战，大败魏军，随后包围了魏国都城。赵成侯说：“杀掉魏罃，改立公中缓，让魏国割地后退兵，这对我们两国都有利。”韩懿侯说：“不行。杀掉魏国国君，是暴虐；割地后退兵，是贪婪。不如让魏国一分为二。魏国分成两国后，国力就不会强于宋国、卫国，我们便永远不会再有魏国的祸患了。”赵成侯不肯听从。韩懿侯很不高兴，当夜率领自己的军队撤走。赵成侯也撤兵离去。魏罃于是杀死公中缓，自立为国君，这就是魏惠王。","content_jianti_auto":"3魏大夫王错出奔韩。公孙颀谓韩懿侯曰：「魏乱，可取也。」懿侯乃与赵成侯合兵伐魏，战于浊泽，大破之，遂围魏。成侯曰：「杀䓨，立公中缓，割地而退，我二国之利也。」懿侯曰：「不可。杀魏君，暴也；割地而退，贪也。不如两分之。魏分为两，不强于宋、衞，则我终无魏患矣。」赵人不听。懿侯不悦，以其兵夜去。赵成侯亦去。䓨遂杀公中缓而立，是为惠王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":111,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c0d8feb-db0e-11ef-9580-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：蓋古人之言及俗說，故云「故曰」。適，讀曰嫡。","note_content_jianti_auto":"索隐曰：盖古人之言及俗说，故云「故曰」。适，读曰嫡。","note_type":"hu_note","start_index":57,"tongjian_id":"8c0d903f-db0e-11ef-9357-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-145,"link_death_year":-86,"link_td_description":"司马迁，西汉史学家和文学家，龙门（今陕西韩城）人，著有《史记》，首创纪传体撰史方法，被后世尊称为史圣。","link_td_id":"Q10000005","link_td_number_id":20912,"people_name":"太史公","people_name_jianti_auto":"太史公","people_xingming":"司马迁","start_index":0,"tongjian_id":"8c0d9041-db0e-11ef-99eb-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏惠王","people_name_jianti_auto":"魏惠王","people_xingming":"魏惠王","start_index":5,"tongjian_id":"8c0d9042-db0e-11ef-b833-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"府安邑，山西夏县","resolved_place_entity_id":1,"start_index":34,"tongjian_id":"8c0d9043-db0e-11ef-80ad-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"浊泽之战","tongjian_id":"war_N0506"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"太史公曰：魏惠王所以身不死、國不分者，二國之謀不和也。若從一家之謀，魏必分矣。故曰：「君終，無適子，其國可破也。」","content_fanyi":"太史公司马迁说：魏惠王之所以自身不死、国家没有被瓜分，是因为韩、赵两国的计策不一致。如果采纳其中任何一国的计策，魏国必定被瓜分。所以说：“国君去世而没有嫡子，他的国家就可以被攻破。”","content_jianti_auto":"太史公曰：魏惠王所以身不死、国不分者，二国之谋不和也。若从一家之谋，魏必分矣。故曰：「君终，无适子，其国可破也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":112,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c0d903e-db0e-11ef-854a-a0d3651f611f"}],"reign_name":"七年","reign_name_jianti_auto":"七年","start_index":5,"tongjian_id":"8c0b1bc3-db0e-11ef-a7d0-a0d3651f611f","year_anno":"（壬子、前三六九）","year_int":-369},"message":"success","success":true}