{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（己亥、前八二）","note_content_jianti_auto":"（己亥、前八二）","note_type":"hu_note","start_index":0,"tongjian_id":"9081d20a-db0e-11ef-ae95-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"順成侯","people_name_jianti_auto":"顺成侯","start_index":0,"tongjian_id":"9081d20d-db0e-11ef-8cda-a0d3651f611f"},{"people_name":"趙父","people_name_jianti_auto":"赵父","start_index":3,"tongjian_id":"9081d20e-db0e-11ef-8cec-a0d3651f611f"},{"people_name":"鉤弋夫人","people_name_jianti_auto":"钩弋夫人","start_index":6,"tongjian_id":"9081d20f-db0e-11ef-a1ca-a0d3651f611f"},{"people_name":"順成侯","people_name_jianti_auto":"顺成侯","start_index":22,"tongjian_id":"9081d210-db0e-11ef-90ac-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":33,"tongjian_id":"9081d211-db0e-11ef-bb6a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"順成侯趙父，鉤弋夫人之父也。父時已死，追封爲順成侯，置園邑三百戶於扶風。","note_content_jianti_auto":"顺成侯赵父，钩弋夫人之父也。父时已死，追封为顺成侯，置园邑三百户于扶风。","note_type":"hu_note","start_index":18,"tongjian_id":"9081d20c-db0e-11ef-bd3e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9081d213-db0e-11ef-81f6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：姁，音況羽翻。","note_content_jianti_auto":"师古曰：姁，音况羽翻。","note_type":"hu_note","start_index":26,"tongjian_id":"9081d212-db0e-11ef-b5ba-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":0,"tongjian_id":"9081d215-db0e-11ef-8333-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孔穎達曰：五服之內，大功已上服粗者爲親，小功已下服精者爲疏。疏，與疎同。","note_content_jianti_auto":"孔颖达曰：五服之内，大功已上服粗者为亲，小功已下服精者为疏。疏，与疎同。","note_type":"hu_note","start_index":53,"tongjian_id":"9081d214-db0e-11ef-8679-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"趙父","people_name_jianti_auto":"赵父","people_xingming":"赵父","start_index":11,"tongjian_id":"9081d216-db0e-11ef-a944-a0d3651f611f"},{"people_name":"順成侯","people_name_jianti_auto":"顺成侯","people_xingming":"赵父","start_index":14,"tongjian_id":"9081d217-db0e-11ef-830a-a0d3651f611f"},{"people_name":"順成侯","people_name_jianti_auto":"顺成侯","people_xingming":"赵父","start_index":18,"tongjian_id":"90841b8b-db0e-11ef-9e39-a0d3651f611f"},{"people_name":"君姁","people_name_jianti_auto":"君姁","people_xingming":"赵君姁","start_index":23,"tongjian_id":"90841b8c-db0e-11ef-bf3e-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9081d20b-db0e-11ef-8370-a0d3651f611f","pinyin":"xū","source_anchor_text":"侯有姊君姁賜錢二百","source_key":"baiyang_epub","start_index":24,"text":"姁","tongjian_id":"c291521f-ebbf-59b7-a80d-78e6edfa5084"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，追尊帝外祖趙父爲順成侯。順成侯有姊君姁，賜錢二百萬、奴婢、第宅以充實焉。諸昆弟各以親疏受賞賜，無在位者。","content_fanyi":"春季，正月，汉昭帝追尊其外祖父赵父为顺成侯。顺成侯有位姐姐赵君姁，汉昭帝赐给她二百万钱、奴婢和宅第，使她的家产得以充实。赵家各兄弟也按照血缘亲疏分别获得赏赐，但没有人在朝中任职。","content_jianti_auto":"1春，正月，追尊帝外祖赵父为顺成侯。顺成侯有姊君姁，赐钱二百万、奴婢、第宅以充实焉。诸昆弟各以亲疏受赏赐，无在位者。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1881,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9081d20b-db0e-11ef-8370-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蕭何","people_name_jianti_auto":"萧何","start_index":6,"tongjian_id":"90841b8f-db0e-11ef-8bed-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":11,"tongjian_id":"90841b90-db0e-11ef-9d54-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":0,"tongjian_id":"90841b91-db0e-11ef-aee4-a0d3651f611f"},{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":15,"tongjian_id":"90841b92-db0e-11ef-a2ea-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"未央宮北闕，蕭何築也。師古曰：未央宮雖南向，而上書、奏事、謁見者皆詣北闕，公車司馬在焉。","note_content_jianti_auto":"未央宫北阙，萧何筑也。师古曰：未央宫虽南向，而上书、奏事、谒见者皆诣北阙，公车司马在焉。","note_type":"hu_note","start_index":12,"tongjian_id":"90841b8e-db0e-11ef-8af8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"90841b94-db0e-11ef-9502-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":18,"tongjian_id":"90841b95-db0e-11ef-a419-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班表：公車屬衞尉，天下上事皆總領之。師古曰：公車主受章奏。","note_content_jianti_auto":"班表：公车属衞尉，天下上事皆总领之。师古曰：公车主受章奏。","note_type":"hu_note","start_index":23,"tongjian_id":"90841b93-db0e-11ef-804b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90846762-db0e-11ef-9521-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：雜，共也。有素識之者，令視知其是非也。","note_content_jianti_auto":"师古曰：杂，共也。有素识之者，令视知其是非也。","note_type":"hu_note","start_index":40,"tongjian_id":"90841b97-db0e-11ef-813f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"安，猶徐也。","note_content_jianti_auto":"安，犹徐也。","note_type":"hu_note","start_index":111,"tongjian_id":"90846764-db0e-11ef-ae0c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"90846766-db0e-11ef-9c2f-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":4,"tongjian_id":"90846767-db0e-11ef-b0db-a0d3651f611f"},{"people_name":"衞靈公","people_name_jianti_auto":"衞灵公","start_index":7,"tongjian_id":"90846768-db0e-11ef-a442-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":13,"tongjian_id":"90846769-db0e-11ef-b8ea-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":15,"tongjian_id":"9084676a-db0e-11ef-97c3-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":20,"tongjian_id":"9084676b-db0e-11ef-84b8-a0d3651f611f"},{"people_name":"靈公","people_name_jianti_auto":"灵公","start_index":25,"tongjian_id":"9084676c-db0e-11ef-bea5-a0d3651f611f"},{"people_name":"靈公","people_name_jianti_auto":"灵公","start_index":33,"tongjian_id":"9084676d-db0e-11ef-8135-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":38,"tongjian_id":"9084676e-db0e-11ef-8964-a0d3651f611f"},{"people_name":"趙鞅","people_name_jianti_auto":"赵鞅","start_index":43,"tongjian_id":"9084676f-db0e-11ef-87b7-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":46,"tongjian_id":"90846770-db0e-11ef-b542-a0d3651f611f"},{"people_name":"國夏","people_name_jianti_auto":"国夏","start_index":57,"tongjian_id":"90846771-db0e-11ef-ad67-a0d3651f611f"},{"people_name":"石曼姑","people_name_jianti_auto":"石曼姑","start_index":61,"tongjian_id":"90846772-db0e-11ef-ab75-a0d3651f611f"},{"people_name":"曼姑","people_name_jianti_auto":"曼姑","start_index":74,"tongjian_id":"90846773-db0e-11ef-8eaa-a0d3651f611f"},{"people_name":"靈公","people_name_jianti_auto":"灵公","start_index":79,"tongjian_id":"90846774-db0e-11ef-98c0-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":83,"tongjian_id":"90846775-db0e-11ef-9d7f-a0d3651f611f"},{"people_name":"曼姑","people_name_jianti_auto":"曼姑","start_index":85,"tongjian_id":"90846776-db0e-11ef-9f59-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":93,"tongjian_id":"90846777-db0e-11ef-8a2d-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":97,"tongjian_id":"90846778-db0e-11ef-86b7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":30,"tongjian_id":"90846779-db0e-11ef-b638-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":42,"tongjian_id":"9084677a-db0e-11ef-9bf6-a0d3651f611f"},{"place_name":"戚","place_name_jianti_auto":"戚","start_index":49,"tongjian_id":"9084677b-db0e-11ef-b148-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":56,"tongjian_id":"9084677c-db0e-11ef-8ed7-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","start_index":60,"tongjian_id":"9084677d-db0e-11ef-9072-a0d3651f611f"},{"place_name":"戚","place_name_jianti_auto":"戚","start_index":67,"tongjian_id":"9084677e-db0e-11ef-912f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：蒯聵，衞靈公太子；輒，蒯聵子也。蒯聵得罪於靈公而出奔晉。及靈公卒，使輒嗣位。晉趙鞅納蒯聵於戚，欲求入衞。齊國夏、衞石曼姑帥師圍戚。公羊傳曰：曼姑受命於靈公而立輒，曼姑之義固可以距蒯聵也。輒之義可以立乎？曰：可。柰何？不以父命辭王父命也。蒯，苦怪翻。聵，五怪翻。","note_content_jianti_auto":"师古曰：蒯聩，衞灵公太子；辄，蒯聩子也。蒯聩得罪于灵公而出奔晋。及灵公卒，使辄嗣位。晋赵鞅纳蒯聩于戚，欲求入衞。齐国夏、衞石曼姑帅师围戚。公羊传曰：曼姑受命于灵公而立辄，曼姑之义固可以距蒯聩也。辄之义可以立乎？曰：可。柰何？不以父命辞王父命也。蒯，苦怪翻。聩，五怪翻。","note_type":"hu_note","start_index":144,"tongjian_id":"90846765-db0e-11ef-904e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卽，就也。","note_content_jianti_auto":"即，就也。","note_type":"hu_note","start_index":157,"tongjian_id":"90846780-db0e-11ef-91b8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"凡不知姓名及所從來，皆曰何人。","note_content_jianti_auto":"凡不知姓名及所从来，皆曰何人。","note_type":"hu_note","start_index":233,"tongjian_id":"90846781-db0e-11ef-92f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張","people_name_jianti_auto":"张","start_index":35,"tongjian_id":"90846783-db0e-11ef-b1f5-a0d3651f611f"},{"people_name":"延年","people_name_jianti_auto":"延年","start_index":38,"tongjian_id":"90846784-db0e-11ef-a334-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"要，與腰同。考異曰：昭紀云「張延年」；雋不疑傳云「成方遂」，又云「一姓張，名延年」。今從不疑傳。","note_content_jianti_auto":"要，与腰同。考异曰：昭纪云「张延年」；隽不疑传云「成方遂」，又云「一姓张，名延年」。今从不疑传。","note_type":"hu_note","start_index":307,"tongjian_id":"90846782-db0e-11ef-883b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"公","official_note":"此处'公'指三公（太尉、司徒、司空），是汉代最高行政长官，负责辅佐皇帝处理国家政务。在上下文中，皇帝诏令公、卿、将军等官员共同辨识自称卫太子者，显示其权威地位。","official_rank":"未知","source_snippet":"詔使公、卿、將軍、中二千石雜識視","start_index":23,"tongjian_id":"9468f0da-a52f-4a43-abc9-dc7885c0d7f2"},{"confidence":0.9,"official_category":"中枢机构","official_name":"卿","official_note":"'卿'指九卿，如太常、光禄勋等，是汉代中央各行政部门长官。在上下文中，参与辨识事件，体现其行政职能。","official_rank":"未知","source_snippet":"詔使公、卿、將軍、中二千石雜識視","start_index":25,"tongjian_id":"819d28c5-8a51-4f5b-a4b1-c553c4ba369a"},{"confidence":0.9,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代高级军事官职，如大将军、车骑将军等，负责统兵作战。在上下文中，参与辨识，可能涉及京城防卫。","official_rank":"未知","source_snippet":"詔使公、卿、將軍、中二千石雜識視","start_index":27,"tongjian_id":"9a7f9b6e-3fd6-4d5f-b503-9fecee9af8c1"},{"confidence":0.95,"official_category":"中枢机构","official_name":"中二千石","official_note":"中二千石是汉代高级官员的俸禄等级，对应九卿等官职，年俸二千一百六十斛。在上下文中，指代这些高官参与事件处理。","official_rank":"中二千石","source_snippet":"詔使公、卿、將軍、中二千石雜識視","start_index":30,"tongjian_id":"1f819340-b9ed-4fe2-8902-187da200cc4e"},{"confidence":0.95,"official_category":"军事指挥","official_name":"右將軍","official_note":"右将军是汉代高级武职，位次上卿，负责军事指挥。在上下文中，率兵守卫宫阙以防变故，体现其防卫职责。","official_rank":"未知","source_snippet":"右將軍勒兵闕下以備非常","start_index":56,"tongjian_id":"28484846-e3fe-4482-8b56-5837a7742eff"},{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，辅佐皇帝总理政务。在上下文中，与御史等官员到场但不敢发言，显示其谨慎态度。","official_rank":"万石","source_snippet":"丞相、御史、中二千石至者並莫敢發言","start_index":73,"tongjian_id":"d55af7e5-25a7-43f3-954c-4a03985af2e7"},{"confidence":0.9,"official_category":"监察","official_name":"御史","official_note":"御史指御史大夫或御史中丞，负责监察百官。在上下文中，参与事件但保持沉默。","official_rank":"中二千石","source_snippet":"丞相、御史、中二千石至者並莫敢發言","start_index":76,"tongjian_id":"44d42e54-a8a9-4c1a-9ea7-9c3e3e519856"},{"confidence":0.95,"official_category":"地方行政","official_name":"京兆尹","official_note":"京兆尹是汉代三辅之一，掌管京城长安的行政长官。在上下文中，京兆尹不疑果断逮捕自称卫太子者，体现其地方治理职责。","official_rank":"中二千石","source_snippet":"京兆尹不疑後到，叱從吏收縛","start_index":91,"tongjian_id":"3c068a07-bdd2-425f-8fae-77eb1373fe5a"},{"confidence":0.95,"official_category":"军事指挥","official_name":"大將軍","official_note":"大将军是汉代最高军事统帅，常兼录尚书事，掌朝政。在上下文中，霍光作为大将军与皇帝一同嘉奖京兆尹不疑。","official_rank":"未知","source_snippet":"天子與大將軍霍光聞而嘉之曰","start_index":176,"tongjian_id":"497156ff-f375-4aba-a104-2c3a0b099d11"},{"confidence":0.85,"official_category":"中枢机构","official_name":"公卿大臣","official_note":"公卿大臣泛指三公九卿等高级官员。在上下文中，皇帝和大将军霍光强调应任用通晓经术、明大义者担任这些要职。","official_rank":"未知","source_snippet":"公卿大臣當用有經術、明於大誼者","start_index":186,"tongjian_id":"fc74a78d-32f8-4fc8-895f-d9fc5385fe5f"},{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是汉代九卿之一，掌管司法刑狱。在上下文中，负责审讯自称卫太子者，查明其诈骗身份。","official_rank":"中二千石","source_snippet":"廷尉驗治何人，竟得姦詐","start_index":226,"tongjian_id":"c63b9914-937e-4867-bb21-a09c5710c48f"},{"confidence":0.9,"official_category":"东宫属官","official_name":"太子舍人","official_note":"太子舍人是太子属官，负责侍从、文书等。在上下文中，指已故太子（卫太子）的旧属，曾找成方遂占卜。","official_rank":"未知","source_snippet":"有故太子舍人嘗從方遂卜","start_index":265,"tongjian_id":"7348acf3-45bc-462a-bc4c-8e1a2f239134"}],"ExtRef_Children_people":[{"link_birth_year":-128,"link_death_year":-91,"link_td_description":"刘据，西汉太子，汉武帝和皇后卫子夫的嫡长子，在巫蛊之祸中受到誣陷試圖抵抗，战败逃亡被围自杀。","link_td_id":"Q10000478","link_td_number_id":244067,"people_name":"衞太子","people_name_jianti_auto":"衞太子","people_xingming":"刘据","start_index":14,"tongjian_id":"90846789-db0e-11ef-b684-a0d3651f611f"},{"link_td_description":"隽不疑，字曼倩，西汉勃海郡（治今河北省沧县东）人，初任文学掾，汉武帝末年经暴胜之举荐，被征召为青州刺史。此后因破获齐孝王刘将闾之孙刘泽反叛的阴谋，擢升为京兆尹，赐钱百万。始元五年，逮捕冒充已故卫太子刘据的成方遂，得到汉昭帝和大将军霍光的赞赏，后因病免官，最终逝世于家中。","link_td_id":"Q10011121","link_td_number_id":1227462,"people_name":"不疑","people_name_jianti_auto":"不疑","people_xingming":"隽不疑","start_index":85,"tongjian_id":"9084678a-db0e-11ef-bbcc-a0d3651f611f"},{"link_td_description":"隽不疑，字曼倩，西汉勃海郡（治今河北省沧县东）人，初任文学掾，汉武帝末年经暴胜之举荐，被征召为青州刺史。此后因破获齐孝王刘将闾之孙刘泽反叛的阴谋，擢升为京兆尹，赐钱百万。始元五年，逮捕冒充已故卫太子刘据的成方遂，得到汉昭帝和大将军霍光的赞赏，后因病免官，最终逝世于家中。","link_td_id":"Q10011121","link_td_number_id":1227462,"people_name":"不疑","people_name_jianti_auto":"不疑","start_index":111,"tongjian_id":"9084678d-db0e-11ef-8612-a0d3651f611f"},{"people_name":"衞太子","people_name_jianti_auto":"衞太子","start_index":121,"tongjian_id":"9084678e-db0e-11ef-bb2b-a0d3651f611f"},{"link_death_year":-478,"link_td_description":"卫后庄公，姬姓，名蒯聩，为春秋诸侯国卫国君主之一，为了与前代的卫庄公分别，故学者时称卫后庄公。","link_td_id":"Q10001015","link_td_number_id":360271,"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","people_xingming":"蒯聵","start_index":126,"tongjian_id":"9084678f-db0e-11ef-b041-a0d3651f611f"},{"link_death_year":-456,"link_td_description":"卫出公，即姬辄，为春秋诸侯国卫国君主之一，卫灵公之孙，灵公长子蒯聩之子。","link_td_id":"Q10001213","link_td_number_id":360269,"people_name":"輒","people_name_jianti_auto":"辄","people_xingming":"輒","start_index":133,"tongjian_id":"90846790-db0e-11ef-ae9d-a0d3651f611f"},{"people_name":"衞太子","people_name_jianti_auto":"衞太子","start_index":144,"tongjian_id":"90846792-db0e-11ef-81a1-a0d3651f611f"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"霍光","people_name_jianti_auto":"霍光","people_xingming":"霍光","start_index":179,"tongjian_id":"90846793-db0e-11ef-9f53-a0d3651f611f"},{"link_td_description":"隽不疑，字曼倩，西汉勃海郡（治今河北省沧县东）人，初任文学掾，汉武帝末年经暴胜之举荐，被征召为青州刺史。此后因破获齐孝王刘将闾之孙刘泽反叛的阴谋，擢升为京兆尹，赐钱百万。始元五年，逮捕冒充已故卫太子刘据的成方遂，得到汉昭帝和大将军霍光的赞赏，后因病免官，最终逝世于家中。","link_td_id":"Q10011121","link_td_number_id":1227462,"people_name":"不疑","people_name_jianti_auto":"不疑","start_index":207,"tongjian_id":"90846794-db0e-11ef-bd79-a0d3651f611f"},{"people_name":"成","people_name_jianti_auto":"成","people_xingming":"成方遂","start_index":244,"tongjian_id":"90846795-db0e-11ef-b6cf-a0d3651f611f"},{"link_td_description":"方遂，字允成，广东广州府南海县人，明朝政治人物。","link_td_id":"Q10023049","link_td_number_id":8113993,"people_name":"方遂","people_name_jianti_auto":"方遂","people_xingming":"成方遂","start_index":247,"tongjian_id":"90846796-db0e-11ef-b1ec-a0d3651f611f"},{"link_td_description":"方遂，字允成，广东广州府南海县人，明朝政治人物。","link_td_id":"Q10023049","link_td_number_id":8113993,"people_name":"方遂","people_name_jianti_auto":"方遂","start_index":267,"tongjian_id":"90846797-db0e-11ef-913b-a0d3651f611f"},{"people_name":"衞太子","people_name_jianti_auto":"衞太子","start_index":280,"tongjian_id":"90846798-db0e-11ef-89ce-a0d3651f611f"},{"link_td_description":"方遂，字允成，广东广州府南海县人，明朝政治人物。","link_td_id":"Q10023049","link_td_number_id":8113993,"people_name":"方遂","people_name_jianti_auto":"方遂","start_index":285,"tongjian_id":"90846799-db0e-11ef-bec8-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"90841b8d-db0e-11ef-a46f-a0d3651f611f","pinyin":"kuǎi","source_anchor_text":"衛太子昔蒯聵違命出","source_key":"baiyang_epub","start_index":126,"text":"蒯","tongjian_id":"13614065-0cc8-5586-830c-b71579183588"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"90841b8d-db0e-11ef-a46f-a0d3651f611f","pinyin":"kuì","source_anchor_text":"太子昔蒯聵違命出奔","source_key":"baiyang_epub","start_index":127,"text":"聵","tongjian_id":"f37b6a2d-e4b7-53bf-86fb-b4035c0d10c9"}],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":40,"tongjian_id":"9084678b-db0e-11ef-bc03-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","resolved_place_entity_id":10163,"start_index":82,"tongjian_id":"9084678c-db0e-11ef-83c5-a0d3651f611f"},{"place_name":"夏陽","place_name_jianti_auto":"夏阳","place_note":"陝西韓城","resolved_place_entity_id":2396,"start_index":239,"tongjian_id":"9084679a-db0e-11ef-ac0e-a0d3651f611f"},{"place_name":"湖","place_name_jianti_auto":"湖","place_note":"河南靈寶西","resolved_place_entity_id":861,"start_index":251,"tongjian_id":"9084679b-db0e-11ef-b271-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","权争"],"content":"2有男子乘黃犢車詣北闕，自謂衞太子；公車以聞。詔使公、卿、將軍、中二千石雜識視。長安中吏民聚觀者數萬人。右將軍勒兵闕下以備非常。丞相、御史、中二千石至者並莫敢發言。京兆尹不疑後到，叱從吏收縛。或曰：「是非未可知，且安之！」不疑曰：「諸君何患於衞太子！昔蒯聵違命出奔，輒距而不納，春秋是之。衞太子得罪先帝，亡不卽死，今來自詣，此罪人也！」遂送詔獄。天子與大將軍霍光聞而嘉之曰：「公卿大臣當用有經術、明於大誼者。」繇是不疑名聲重於朝廷，在位者皆自以不及也。廷尉驗治何人，竟得姦詐，本夏陽人，姓成，名方遂，居湖，以卜筮爲事。有故太子舍人嘗從方遂卜，謂曰：「子狀貌甚似衞太子。」方遂心利其言，冀得以富貴。坐誣罔不道，要斬。","content_fanyi":"有一名男子乘坐黄牛犊车来到未央宫北门，自称是卫太子；公车令将此事奏报朝廷。汉昭帝下诏让公、卿、将军、中二千石官员共同前去辨认察看。长安城中的官吏百姓聚集围观的有数万人。右将军部署军队在宫阙之下，以防发生意外。丞相、御史、中二千石到场的官员，都不敢开口发言。京兆尹隽不疑后到，喝令随从吏员将那人收捕捆绑。有人说：“是真是假还不知道，暂且不要处置他！”隽不疑说：“各位何必为卫太子而担忧！从前卫国太子蒯聩违背卫灵公的命令出逃，其子蒯辄拒绝接纳他回国，《春秋》肯定这种做法。卫太子得罪了先帝，逃亡在外却不立即去死，如今自己前来投案，这正是罪人！”于是将那人押送到诏狱。汉昭帝和大将军霍光听说后，称赞隽不疑说：“公卿大臣应当选用有经术、明白大义的人。”从此隽不疑在朝廷中的名声更重，在位官员都自认为比不上他。廷尉查验审问此人究竟是谁，终于查明是欺诈冒充，此人本是夏阳人，姓成，名方遂，住在湖县，以占卜为业。有位前任卫太子舍人曾到方遂那里占卜，对他说：“您的体态相貌很像卫太子。”方遂觉得这话有利可图，希望借此获得富贵。方遂因诬罔不道之罪被腰斩。","content_jianti_auto":"2有男子乘黄犊车诣北阙，自谓衞太子；公车以闻。诏使公、卿、将军、中二千石杂识视。长安中吏民聚观者数万人。右将军勒兵阙下以备非常。丞相、御史、中二千石至者并莫敢发言。京兆尹不疑后到，叱从吏收缚。或曰：「是非未可知，且安之！」不疑曰：「诸君何患于衞太子！昔蒯聩违命出奔，辄距而不纳，春秋是之。衞太子得罪先帝，亡不即死，今来自诣，此罪人也！」遂送诏狱。天子与大将军霍光闻而嘉之曰：「公卿大臣当用有经术、明于大谊者。」繇是不疑名声重于朝廷，在位者皆自以不及也。廷尉验治何人，竟得奸诈，本夏阳人，姓成，名方遂，居湖，以卜筮为事。有故太子舍人尝从方遂卜，谓曰：「子状貌甚似衞太子。」方遂心利其言，冀得以富贵。坐诬罔不道，要斩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1882,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"90841b8d-db0e-11ef-a46f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"桑樂侯","people_name_jianti_auto":"桑乐侯","start_index":5,"tongjian_id":"9084679e-db0e-11ef-bc56-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"千乘","place_name_jianti_auto":"千乘","place_note":"山东滨州南二十六里旧镇西南十里千乘遗址","start_index":11,"tongjian_id":"9084679f-db0e-11ef-a1bf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"恩澤侯表：桑樂侯食邑於千乘。樂，來各翻。","note_content_jianti_auto":"恩泽侯表：桑乐侯食邑于千乘。乐，来各翻。","note_type":"hu_note","start_index":15,"tongjian_id":"9084679d-db0e-11ef-9ca0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"桑樂侯","official_note":"桑樂侯是漢代的爵位，屬於列侯，通常授予有功或皇室親屬，此處上官安被封為桑樂侯，顯示其地位提升，但後文描述其驕淫行為，暗示爵位可能未帶來正面影響。","official_rank":"侯爵","source_snippet":"封上官安爲桑樂侯","start_index":8,"tongjian_id":"e3d1bfca-ae4a-4e71-b5a1-c9e8e2f2a9e6"}],"ExtRef_Children_people":[{"link_death_year":-80,"link_td_description":"上官安，西汉官员。上官桀之子。其女为汉昭帝之妻孝昭皇后。","link_td_id":"Q10009212","link_td_number_id":557830,"people_name":"上官安","people_name_jianti_auto":"上官安","people_xingming":"上官安","start_index":7,"tongjian_id":"908467a3-db0e-11ef-a719-a0d3651f611f"},{"link_death_year":-80,"link_td_description":"上官安，西汉官员。上官桀之子。其女为汉昭帝之妻孝昭皇后。","link_td_id":"Q10009212","link_td_number_id":557830,"people_name":"桑樂侯","people_name_jianti_auto":"桑乐侯","people_xingming":"上官安","start_index":11,"tongjian_id":"908467a4-db0e-11ef-8d5e-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"安","place_name_jianti_auto":"安","resolved_place_entity_id":1447,"start_index":15,"tongjian_id":"908467a5-db0e-11ef-9441-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"3夏，六月，封上官安爲桑樂侯。安日以驕淫，受賜殿中，對賓客言：「與我壻飲，大樂！」見其服飾，使人歸，欲自燒物。子病死，仰而罵天。其頑悖如此。","content_fanyi":"夏季六月，汉昭帝封上官安为桑乐侯。上官安日益骄纵淫逸，在宫中接受赏赐后，对门客说：“和我女婿一起饮酒，实在快乐！”他看到汉昭帝的服饰，便派人回家，想把自己的东西都烧掉。他的儿子病死了，上官安仰头骂天。他顽固悖理竟到了如此地步。","content_jianti_auto":"3夏，六月，封上官安为桑乐侯。安日以骄淫，受赐殿中，对宾客言：「与我壻饮，大乐！」见其服饰，使人归，欲自烧物。子病死，仰而骂天。其顽悖如此。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1883,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9084679c-db0e-11ef-9097-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":0,"tongjian_id":"908467a8-db0e-11ef-90f1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"儋耳郡","place_name_jianti_auto":"儋耳郡","start_index":7,"tongjian_id":"908467a9-db0e-11ef-bcd3-a0d3651f611f"},{"place_name":"眞番郡","place_name_jianti_auto":"真番郡","start_index":16,"tongjian_id":"908467aa-db0e-11ef-8866-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武帝元鼎六年置儋耳郡，元封三年置眞番郡；今皆罷之。儋，都甘翻。","note_content_jianti_auto":"武帝元鼎六年置儋耳郡，元封三年置真番郡；今皆罢之。儋，都甘翻。","note_type":"hu_note","start_index":9,"tongjian_id":"908467a7-db0e-11ef-b84e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"908467a6-db0e-11ef-aba8-a0d3651f611f","pinyin":"dān","source_anchor_text":"悖如此罷儋耳真番郡","source_key":"baiyang_epub","start_index":2,"text":"儋","tongjian_id":"76eaed07-9f87-5a07-82a4-68137ebcb1a2"}],"ExtRef_Children_places":[{"place_name":"儋耳","place_name_jianti_auto":"儋耳","place_note":"海南儋州","resolved_place_entity_id":3582,"start_index":2,"tongjian_id":"908467ab-db0e-11ef-965c-a0d3651f611f"},{"place_name":"眞番郡","place_name_jianti_auto":"真番郡","resolved_place_entity_id":5066,"start_index":5,"tongjian_id":"908467ac-db0e-11ef-a12a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4罷儋耳、眞番郡。","content_fanyi":"汉朝撤销儋耳、真番二郡。","content_jianti_auto":"4罢儋耳、真番郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1884,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"908467a6-db0e-11ef-aba8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大鴻臚","official_note":"大鴻臚是漢代九卿之一，掌管諸侯及少數民族事務，此處廣明擔任此職，負責軍事行動。","official_rank":"九卿之一","source_snippet":"大鴻臚廣明","start_index":3,"tongjian_id":"4753cc10-7cf5-4549-b8ca-a9f243143fed"},{"confidence":0.85,"official_category":"军事指挥","official_name":"軍正","official_note":"軍正是漢代軍中執法官職，負責軍紀和刑罰，此處王平擔任此職，參與軍事行動。","official_rank":"未知","source_snippet":"軍正王平","start_index":9,"tongjian_id":"7d218df3-1525-4139-9524-4293b1bff02f"}],"ExtRef_Children_people":[{"link_td_description":"田广明，字子公，西汉郑县（今陕西省渭南市华州区）人。初任郎官，后调迁天水郡司马，凭功绩擢升至河南郡都尉，期间以杀戮的方式治理。当时汉朝各郡国盗贼横行，汉武帝于是提拔田广明担任淮阳郡太守，任上其因破获公孙勇、胡倩造反的阴谋，升迁为大鸿胪。始元初年益州诸夷发起叛乱，田广明受命和王平一同领兵讨伐，成功弭平当地的叛乱。汉昭帝驾崩后，田广明与大将军霍光等人共同废黜昌邑王刘贺，改立汉宣帝为皇，因功获封昌水侯。本始年间，汉朝与乌孙共同出兵征讨匈奴，田广明以祈连将军的身份统兵北伐，期间却与已故受降城都尉的妻子通奸，又在明知鸡秩山以西有匈奴人的情况下驻兵不进，班师回朝后其因此被汉宣帝下令交由杜延年审讯，田广明随即畏罪自杀，封国被废除。","link_td_id":"Q10009078","link_td_number_id":515346,"people_name":"廣明","people_name_jianti_auto":"广明","people_xingming":"田广明","start_index":6,"tongjian_id":"908467ae-db0e-11ef-a5ae-a0d3651f611f"},{"link_birth_year":-199,"link_death_year":-78,"link_td_description":"王平，一作王评，字子心，齐国人，西汉政治人物。","link_td_id":"Q10019732","link_td_number_id":5997073,"people_name":"王平","people_name_jianti_auto":"王平","people_xingming":"王平","start_index":11,"tongjian_id":"908467af-db0e-11ef-af39-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"益州","place_name_jianti_auto":"益州","place_note":"云南晋宁东晋城镇","resolved_place_entity_id":204,"start_index":14,"tongjian_id":"908467b0-db0e-11ef-aedb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/霍光赏功","excerpts":[{"context_after":"。盖霍光为政，务与民休息，故不欲求边功，益州之师，不得已...","context_before":"...，凡将士有军功，无问贵贱，未有不封侯者。及昭帝时，大鸿胪","source_end_index":61,"source_paragraph_tongjian_id":"243f7321-8075-41d6-9877-4fe902d4c8d7","source_start_index":40,"source_text":"田广明平益州夷，斩首捕虏三万，但赐爵关内侯"}],"path":"随笔/卷九/霍光赏功","source_name":"容斋随笔"}],"class_tags":["军事"],"content":"5秋，大鴻臚廣明、軍正王平擊益州，斬首、捕虜三萬餘人，獲畜產五萬餘頭。","content_fanyi":"五年秋季，大鸿胪田广明、军正王平率军攻打益州，斩首、俘虏叛军三万余人，缴获牲畜五万余头。","content_jianti_auto":"5秋，大鸿胪广明、军正王平击益州，斩首、捕虏三万余人，获畜产五万余头。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1885,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"908467ad-db0e-11ef-9845-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"諫大夫","official_note":"諫大夫是漢代官職，負責向皇帝進諫和提供建議，屬於文教類官員。在《資治通鑑》此段中，杜延年擔任諫大夫，向大將軍霍光提出政策建議，顯示其職責在於勸諫和輔政。","official_rank":"未知","source_snippet":"諫大夫杜延年","start_index":0,"tongjian_id":"9080c0f6-1be4-46b8-803d-72bc5a1388d5"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"大將軍","official_note":"大將軍是漢代高級軍事指揮官，常掌兵權和朝政。在此段中，大將軍指霍光，他聽取諫大夫杜延年的建議，顯示其在朝廷中的權威地位。","official_rank":"高級","source_snippet":"大將軍光","start_index":28,"tongjian_id":"00cde4fd-91d9-410d-9819-8277f248cd32"},{"confidence":0.85,"official_category":"監察","official_name":"御史大夫","official_note":"御史大夫是漢代監察機構的長官，負責彈劾和監察百官。在此段中，提到杜延年是已故御史大夫杜周的兒子，用來說明其家世背景。","official_rank":"高級","source_snippet":"故御史大夫周之子也","start_index":78,"tongjian_id":"960c5c3c-7c92-4faa-ae9c-6a680a8a0b48"}],"ExtRef_Children_people":[{"link_death_year":-52,"link_td_description":"杜延年，中国西汉南阳郡杜衍县人，麒麟阁十一功臣之一，京兆杜氏先祖之一。其父杜周，曾任御史大夫。延年精通法律，以荫补军司空。汉昭帝元始四年（前83年），率南阳士卒平定益州蛮反叛，升谏大夫。昭帝元凤元年（前80年），举发桑弘羊等人谋反，因功封建平侯，为太仆、右曹、给事中。汉宣帝地节四年（前66年）七月，因霍氏旧吏被免官。后任北地太守、西河太守，政绩卓著。甘露二年（前52年）以老病免，不久即死。著有《杜延年律章句》。","link_td_id":"Q10009035","link_td_number_id":503214,"people_name":"杜延年","people_name_jianti_auto":"杜延年","people_xingming":"杜延年","start_index":4,"tongjian_id":"908467b4-db0e-11ef-8e44-a0d3651f611f"},{"link_birth_year":-156,"link_death_year":-87,"link_td_description":"汉武帝刘彻（公元前156年－前87年），中国汉朝（西汉）皇帝，于公元前141年至前87年在位，共在位54年。汉武帝为汉景帝刘启第十子，母孝景王皇后。其少时先被封为胶东王，七岁被立为太子，十六岁登基，其在位期间首次使用年号纪年。","link_td_id":"Q10000035","link_td_number_id":9444,"people_name":"武帝","people_name_jianti_auto":"武帝","people_xingming":"刘彻","start_index":11,"tongjian_id":"908467b5-db0e-11ef-8afa-a0d3651f611f","wl_zhushi":"[刘彻]"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":26,"tongjian_id":"908467b6-db0e-11ef-bdcc-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"孝文","people_name_jianti_auto":"孝文","people_xingming":"刘恒","start_index":44,"tongjian_id":"908467b7-db0e-11ef-a7e6-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_death_year":-68,"link_td_description":"霍光，字子孟，西汉河东郡平阳县（今山西省临汾市）人，政治家，麒麟阁十一功臣之首，名将霍去病异母弟，昭帝上官皇后外祖父，宣帝霍皇后之父。","link_td_id":"Q10006237","link_td_number_id":81818,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"霍光","start_index":71,"tongjian_id":"908467b8-db0e-11ef-bb86-a0d3651f611f"},{"link_death_year":-52,"link_td_description":"杜延年，中国西汉南阳郡杜衍县人，麒麟阁十一功臣之一，京兆杜氏先祖之一。其父杜周，曾任御史大夫。延年精通法律，以荫补军司空。汉昭帝元始四年（前83年），率南阳士卒平定益州蛮反叛，升谏大夫。昭帝元凤元年（前80年），举发桑弘羊等人谋反，因功封建平侯，为太仆、右曹、给事中。汉宣帝地节四年（前66年）七月，因霍氏旧吏被免官。后任北地太守、西河太守，政绩卓著。甘露二年（前52年）以老病免，不久即死。著有《杜延年律章句》。","link_td_id":"Q10009035","link_td_number_id":503214,"people_name":"延年","people_name_jianti_auto":"延年","people_xingming":"杜延年","start_index":76,"tongjian_id":"908467b9-db0e-11ef-9d2f-a0d3651f611f"},{"link_death_year":-94,"link_td_description":"杜周，西汉政治人物，武帝手下酷吏。","link_td_id":"Q10007776","link_td_number_id":937202,"people_name":"周","people_name_jianti_auto":"周","people_xingming":"杜周","start_index":84,"tongjian_id":"908467ba-db0e-11ef-b79b-a0d3651f611f","wl_zhushi":"[杜周]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6諫大夫杜延年見國家承武帝奢侈、師旅之後，數爲大將軍光言：「年歲比不登，流民未盡還，宜脩孝文時政，示以儉約、寬和，順天心，說民意，年歲宜應。」光納其言。延年，故御史大夫周之子也。","content_fanyi":"谏大夫杜延年看到国家在武帝奢侈、屡兴兵役之后，多次对大将军霍光说：“连年收成不好，流民还没有全部返回故里，应当整饬孝文帝时期的政事，显示节俭、宽和，顺应天意，使民心欢悦，收成就会相应好转。”霍光采纳了他的话。杜延年，是已故御史大夫杜周的儿子。","content_jianti_auto":"6谏大夫杜延年见国家承武帝奢侈、师旅之后，数为大将军光言：「年岁比不登，流民未尽还，宜修孝文时政，示以俭约、宽和，顺天心，说民意，年岁宜应。」光纳其言。延年，故御史大夫周之子也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1886,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"908467b1-db0e-11ef-be32-a0d3651f611f"}],"reign_name":"五年","reign_name_jianti_auto":"五年","start_index":4,"tongjian_id":"9081d209-db0e-11ef-b2bf-a0d3651f611f","year_anno":"（己亥、前八二）","year_int":-82},"message":"success","success":true}