1f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":96,"tongjian_id":"b9c28401-db0e-11ef-890a-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","start_index":108,"tongjian_id":"b9c28402-db0e-11ef-b780-a0d3651f611f"},{"place_name":"韶州","place_name_jianti_auto":"韶州","place_note":"广东省韶关市","start_index":119,"tongjian_id":"b9c28403-db0e-11ef-aa4b-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":122,"tongjian_id":"b9c28404-db0e-11ef-8e42-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","start_index":134,"tongjian_id":"b9c28405-db0e-11ef-8e7f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"雷州，漢徐聞縣地。梁置南合州，隋曰合州，仍置海康縣，大業廢州。唐武德五年，復置，貞觀八年改曰雷州。韶州，漢南野縣地。吳孫皓甘露元年，分立始興郡。唐武德初，置番州，貞觀元年，改韶州。舊志：雷州至京師六千五百四十七里，至東都五千八百三十六里。韶州至京師四千九百三十二里，至東都四千一百四十二里。韁，居良翻。","note_content_jianti_auto":"雷州，汉徐闻县地。梁置南合州，隋曰合州，仍置海康县，大业废州。唐武德五年，复置，贞观八年改曰雷州。韶州，汉南野县地。吴孙皓甘露元年，分立始兴郡。唐武德初，置番州，贞观元年，改韶州。旧志：雷州至京师六千五百四十七里，至东都五千八百三十六里。韶州至京师四千九百三十二里，至东都四千一百四十二里。缰，居良翻。","note_type":"hu_note","start_index":219,"tongjian_id":"b9c283ec-db0e-11ef-a27d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"弘文館學士","official_note":"弘文館學士是唐代弘文館的官員，負責圖書整理、學術研究和教育事務，此處表示賀蘭敏之的官職升遷。","official_rank":"未知","source_snippet":"累遷弘文館學士、左散騎常侍","start_index":38,"tongjian_id":"3807daa7-381f-4003-9f82-dcfb70567ef3"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"左散騎常侍","official_note":"左散騎常侍是唐代門下省的官員，負責諫議和侍從皇帝，此處表示賀蘭敏之的官職升遷。","official_rank":"正三品","source_snippet":"累遷弘文館學士、左散騎常侍","start_index":45,"tongjian_id":"a2021326-a86d-4687-bcb4-8592214f64e0"},{"confidence":0.85,"official_category":"军事指挥","official_name":"司衞少卿","official_note":"司衞少卿是唐代衛尉寺的官員，負責宮廷警衛和儀仗事務，此處指楊思儉的官職。","official_rank":"正四品","source_snippet":"司衞少卿楊思儉女","start_index":126,"tongjian_id":"e34523ea-f487-44f3-b308-32ca44a84fb0"}],"ExtRef_Children_people":[{"link_td_description":"武元庆，武则天的大哥，武三思的父亲。唐朝官员。","link_td_id":"Q10011415","link_td_number_id":1257898,"people_name":"武元慶","people_name_jianti_auto":"武元庆","people_xingming":"武元庆","start_index":3,"tongjian_id":"b9c28408-db0e-11ef-aa01-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"賀蘭敏之","people_name_jianti_auto":"贺兰敏之","people_xingming":"贺兰敏之","start_index":17,"tongjian_id":"b9c28409-db0e-11ef-a5d5-a0d3651f611f"},{"link_birth_year":577,"link_death_year":635,"link_td_description":"武士彟，字信明，隋末唐初官员，是随李渊在晋阳起兵的功臣，亦是中国唯一的女皇帝武则天的父亲，死后谥号魏忠孝王。","link_td_id":"Q10000980","link_td_number_id":226044,"people_name":"士彠","people_name_jianti_auto":"士彟","people_xingming":"武士彟","start_index":22,"tongjian_id":"b9c2840a-db0e-11ef-b780-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"周公","people_name_jianti_auto":"周公","people_xingming":"贺敏之","start_index":29,"tongjian_id":"b9c2840b-db0e-11ef-8f76-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"武氏","people_name_jianti_auto":"武氏","people_xingming":"贺敏之","start_index":34,"tongjian_id":"b9c2840c-db0e-11ef-b48a-a0d3651f611f"},{"link_death_year":666,"link_td_description":"贺兰氏，名不详，封魏国夫人，是武则天外甥女，姿容极美，史称“国姝”。","link_td_id":"Q10003744","link_td_number_id":1128421,"people_name":"魏國夫人","people_name_jianti_auto":"魏国夫人","people_xingming":"魏国夫人","start_index":51,"tongjian_id":"b9c2840e-db0e-11ef-afea-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"敏之","people_name_jianti_auto":"敏之","people_xingming":"贺兰敏之","start_index":61,"tongjian_id":"b9c2840f-db0e-11ef-8baa-a0d3651f611f"},{"people_name":"敏之","people_name_jianti_auto":"敏之","start_index":91,"tongjian_id":"b9c28410-db0e-11ef-ae05-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"敏之","people_name_jianti_auto":"敏之","people_xingming":"贺兰敏之","start_index":116,"tongjian_id":"b9c28411-db0e-11ef-bf65-a0d3651f611f"},{"people_name":"太原王","people_name_jianti_auto":"太原王","people_xingming":"null","start_index":123,"tongjian_id":"b9c28412-db0e-11ef-8b38-a0d3651f611f"},{"link_td_description":"杨思俭，唐朝官员。隋朝司隶校尉杨綝子，观德王杨雄孙，有弟杨思约、杨思礼。龙朔元年（661年），在太子中舍人任上受命与中书令、太子宾客许敬宗、侍中兼太子右庶子许圉师、中书侍郎上官仪等于文思殿博采古今文集，摘取其中英词丽句，分类，成五百卷，名为《瑶山玉彩》，上表献上。龙朔年间杨思俭曾任司卫少卿。他的女儿有美色，被唐高宗和武皇后选为太子李弘妃，已经定下婚期，却被武皇后的外甥左散骑常侍周国公武敏之逼奸，后来没有嫁给李弘。杨思俭与许敬宗、顾胤、许圉师、上官仪、孟利贞、姚璹、窦德玄、郭瑜、董思恭、元思敬集成《芳林要览》三百卷。杨思俭另有作《议沙门不应拜俗状》。子右卫将军杨承祐。","link_td_id":"Q10007998","link_td_number_id":6321838,"people_name":"楊思儉","people_name_jianti_auto":"杨思俭","people_xingming":"杨思俭","start_index":144,"tongjian_id":"b9c28413-db0e-11ef-a58a-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"敏之","people_name_jianti_auto":"敏之","people_xingming":"贺兰敏之","start_index":169,"tongjian_id":"b9c28414-db0e-11ef-9f43-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"敏之","people_name_jianti_auto":"敏之","people_xingming":"贺兰敏之","start_index":181,"tongjian_id":"b9c28415-db0e-11ef-987c-a0d3651f611f"},{"link_birth_year":642,"link_death_year":671,"link_td_description":"贺兰敏之，字常住，河南郡洛阳县人，鲜卑后裔，唐朝的政治人物。","link_td_id":"Q10001387","link_td_number_id":315187,"people_name":"敏之","people_name_jianti_auto":"敏之","people_xingming":"贺兰敏之","start_index":223,"tongjian_id":"b9c28418-db0e-11ef-9873-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"弘文館","place_name_jianti_auto":"弘文馆","resolved_place_entity_id":2861,"start_index":39,"tongjian_id":"b9c2840d-db0e-11ef-b24f-a0d3651f611f"},{"place_name":"雷州","place_name_jianti_auto":"雷州","place_note":"广东省雷州市","resolved_place_entity_id":3035,"start_index":201,"tongjian_id":"b9c28416-db0e-11ef-9dfe-a0d3651f611f"},{"place_name":"韶州","place_name_jianti_auto":"韶州","place_note":"广东省韶关市","resolved_place_entity_id":2361,"start_index":210,"tongjian_id":"b9c28417-db0e-11ef-8d63-a0d3651f611f"},{"place_name":"嶺","place_name_jianti_auto":"岭","resolved_place_entity_id":326,"start_index":229,"tongjian_id":"b9c28419-db0e-11ef-b21b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争","人事"],"content":"3初，武元慶等旣死，皇后奏以其姊子賀蘭敏之爲士彠之嗣，襲爵周公，改姓武氏，累遷弘文館學士、左散騎常侍。魏國夫人之死也，上見敏之，悲泣曰：「曏吾出視朝猶無恙，退朝已不救，何蒼猝如此！」敏之號哭不對。后聞之，曰：「此兒疑我。」由是惡之。敏之貌美，蒸於太原王妃；及居妃喪，釋衰絰，奏妓。司衞少卿楊思儉女，有殊色，上及后自選以爲太子妃，婚有日矣，敏之逼而淫之。后於是表言敏之前後罪惡，請加竄逐。六月，丙子，敕流雷州，復其本姓。至韶州，以馬韁絞死。朝士坐與敏之交遊，流嶺南者甚衆。","content_fanyi":"起初，武元庆等人死后，皇后便上奏皇上，以她姐姐的儿子贺兰敏之作为她父亲武士彟的子嗣，承袭周国公的爵位，改姓武氏，后来历次升迁，官至弘文馆学士、左散骑常侍。魏国夫人去世时，皇上见到敏之，悲泣说：“刚才我出去临朝听政时，她还安然无恙，退朝时已经无法救治，怎么这样仓促突然！”敏之号哭不作回答。皇后听到后，说：“这孩子怀疑我。”从此就厌恶他。敏之容貌俊美，与他的外祖母太原王妃杨氏淫乱；到为杨氏守丧时，又脱去丧服，让歌妓奏乐歌舞。司卫少卿杨思俭的女儿有出众的姿色，皇上和皇后亲自挑选她做太子妃，婚期已经确定，敏之竟逼迫并奸污了她。皇后于是上表列举敏之前后的罪恶，请求将他流放驱逐。六月丙子日，敕令将他流放到雷州，恢复他的本来姓氏。到达韶州后，被马缰绳绞死。朝臣中因与敏之交游而获罪，被流放岭南的人很多。","content_jianti_auto":"3初，武元庆等既死，皇后奏以其姊子贺兰敏之为士彟之嗣，袭爵周公，改姓武氏，累迁弘文馆学士、左散骑常侍。魏国夫人之死也，上见敏之，悲泣曰：「向吾出视朝犹无恙，退朝已不救，何苍猝如此！」敏之号哭不对。后闻之，曰：「此儿疑我。」由是恶之。敏之貌美，蒸于太原王妃；及居妃丧，释衰绖，奏妓。司衞少卿杨思俭女，有殊色，上及后自选以为太子妃，婚有日矣，敏之逼而淫之。后于是表言敏之前后罪恶，请加窜逐。六月，丙子，敕流雷州，复其本姓。至韶州，以马缰绞死。朝士坐与敏之交游，流岭南者甚众。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19826,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"b9c283e1-db0e-11ef-bd5c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"高侃，名又作偘，出于渤海高氏，故称渤海蓚县人，唐朝高宗时期的将领。","link_td_id":"Q10004684","link_td_number_id":1188691,"people_name":"高侃","people_name_jianti_auto":"高侃","people_xingming":"高侃","start_index":10,"tongjian_id":"b9c2841c-db0e-11ef-aabc-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高麗","place_name_jianti_auto":"高丽","resolved_place_entity_id":226,"start_index":13,"tongjian_id":"b9c2841d-db0e-11ef-8493-a0d3651f611f"},{"place_name":"安市城","place_name_jianti_auto":"安市城","place_note":"辽宁省海城市","resolved_place_entity_id":2403,"start_index":18,"tongjian_id":"b9c2841e-db0e-11ef-8c32-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"罗唐战争","tongjian_id":"war_N0978"},{"title":"唐与高句丽战争","tongjian_id":"war_N0966"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、辽东行都司（卷三十七）","excerpts":[{"context_after":"后置安市州。渤海改置铁州，领位城、河瑞、苍山、龙珍四县。...","context_before":"...亦曰安市城。唐贞观十九年，征高丽，攻安市城，不克，引还。","source_end_index":84,"source_paragraph_tongjian_id":"7663bcab-6df9-526e-8f71-4b1172e43231","source_start_index":58,"source_text":"咸亨三年，高丽余众复叛，遣将高侃击之，败之于安市城。"}],"path":"山东方舆纪要/八、辽东行都司（卷三十七）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"4秋，七月，乙未朔，高侃破高麗餘衆於安市城。","content_fanyi":"秋季，七月乙未朔日，高侃在安市城击破叛唐的高丽残余部众。","content_jianti_auto":"4秋，七月，乙未朔，高侃破高丽余众于安市城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19827,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"b9c2841a-db0e-11ef-be90-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"潞州刺史","official_note":"潞州刺史是唐代地方行政官职，负责管理潞州（今山西长治一带）的民政事务。在《资治通鉴》此段中，徐王元禮担任此职，其去世被记录为历史事件。","official_rank":"未知","source_snippet":"潞州刺史徐王元禮薨","start_index":5,