{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛未、六七一）","note_content_jianti_auto":"（辛未、六七一）","note_type":"hu_note","start_index":0,"tongjian_id":"b9c283c8-db0e-11ef-84b0-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"東都","place_name_jianti_auto":"东都","place_note":"洛阳","start_index":20,"tongjian_id":"b9c283cb-db0e-11ef-81a3-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":27,"tongjian_id":"b9c283cc-db0e-11ef-b673-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":70,"tongjian_id":"b9c283cd-db0e-11ef-84fc-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","start_index":83,"tongjian_id":"b9c283ce-db0e-11ef-8a18-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊本紀及太子弘傳，「正月乙巳，幸東都，留太子於京師監國。」明年十月己未，又云「皇太子監國。」新本紀、唐曆、統紀皆連歲言太子監國。按離長安時，已留太子監國，及自東都將還，豈得又令監國！按實錄此月無監國事，唯明年十月有之。今從之。","note_content_jianti_auto":"考异曰：旧本纪及太子弘传，「正月乙巳，幸东都，留太子于京师监国。」明年十月己未，又云「皇太子监国。」新本纪、唐历、统纪皆连岁言太子监国。按离长安时，已留太子监国，及自东都将还，岂得又令监国！按实录此月无监国事，唯明年十月有之。今从之。","note_type":"hu_note","start_index":14,"tongjian_id":"b9c283ca-db0e-11ef-8f40-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東都","place_name_jianti_auto":"东都","place_note":"洛阳","resolved_place_entity_id":54,"start_index":11,"tongjian_id":"b9c283d6-db0e-11ef-a4b4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1春，正月，甲子，上幸東都。","content_fanyi":"春季正月甲子日，皇上巡幸东都洛阳。","content_jianti_auto":"1春，正月，甲子，上幸东都。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19824,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"b9c283c9-db0e-11ef-a678-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賀魯","people_name_jianti_auto":"贺鲁","start_index":6,"tongjian_id":"b9c283d9-db0e-11ef-857b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"處木昆部","place_name_jianti_auto":"处木昆部","start_index":10,"tongjian_id":"b9c283da-db0e-11ef-b3a3-a0d3651f611f"},{"place_name":"匐延都督府","place_name_jianti_auto":"匐延都督府","start_index":15,"tongjian_id":"b9c283db-db0e-11ef-9487-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"顯慶二年，平賀魯，以處木昆部爲匐延都督府。厥，九勿翻。驍，堅堯翻。匐，蒲北翻。","note_content_jianti_auto":"显庆二年，平贺鲁，以处木昆部为匐延都督府。厥，九勿翻。骁，坚尧翻。匐，蒲北翻。","note_type":"hu_note","start_index":31,"tongjian_id":"b9c283d8-db0e-11ef-9bbc-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"左驍衞大將軍","official_note":"左驍衞大將軍是唐代十六卫之一左驍衞的最高军事长官，负责宫廷禁卫和部分军事事务。在《资治通鉴》此段中，唐高宗任命西突厥首领阿史那都支为此职，旨在安抚和笼络西突厥部落，以稳定边疆局势。","official_rank":"正三品","source_snippet":"以西突厥阿史那都支爲左驍衞大將軍兼匐延都督","start_index":15,"tongjian_id":"4b1fde7f-74b3-42d1-9f16-17ff7cfc5210"},{"confidence":0.9,"official_category":"地方行政","official_name":"匐延都督","official_note":"匐延都督是唐代在边疆地区设置的都督府官职，通常由当地部落首领兼任，负责管理特定区域的事务。在此上下文中，阿史那都支兼任此职，表明唐朝通过授予官职来加强对西突厥地区的控制，属于羁縻政策的一部分。","official_rank":"未知","source_snippet":"以西突厥阿史那都支爲左驍衞大將軍兼匐延都督","start_index":24,"tongjian_id":"50210d76-e369-4d55-88a7-da9998d917c2"}],"ExtRef_Children_people":[{"people_name":"阿史那都支","people_name_jianti_auto":"阿史那都支","people_xingming":"阿史那都支","start_index":13,"tongjian_id":"b9c283dd-db0e-11ef-b58d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"西突厥","place_name_jianti_auto":"西突厥","resolved_place_entity_id":117,"start_index":10,"tongjian_id":"b9c283de-db0e-11ef-8392-a0d3651f611f"},{"place_name":"匐延","place_name_jianti_auto":"匐延","resolved_place_entity_id":6021,"start_index":26,"tongjian_id":"b9c283df-db0e-11ef-ac78-a0d3651f611f"},{"place_name":"咄陸","place_name_jianti_auto":"咄陆","resolved_place_entity_id":2573,"start_index":35,"tongjian_id":"b9c283e0-db0e-11ef-938a-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"裴行俭破西突厥之战","tongjian_id":"war_N0980"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","外交"],"content":"2夏，四月，甲申，以西突厥阿史那都支爲左驍衞大將軍兼匐延都督，以安集五咄陸之衆。","content_fanyi":"夏季四月甲申日，朝廷任命西突厥阿史那都支为左骁卫大将军兼匐延都督，以安抚并聚拢五咄陆部众。","content_jianti_auto":"2夏，四月，甲申，以西突厥阿史那都支为左骁衞大将军兼匐延都督，以安集五咄陆之众。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19825,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"b9c283d7-db0e-11ef-a88c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":8,"source_start_index":0,"source_text":"事見上卷乾封元年","target_paragraph_tongjian_id":"b9a24acd-db0e-11ef-b4cd-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷乾封元年。","note_content_jianti_auto":"事见上卷干封元年。","note_type":"hu_note","start_index":10,"tongjian_id":"b9c283e2-db0e-11ef-92cf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":