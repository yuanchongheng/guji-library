place_name_jianti_auto":"青","resolved_place_entity_id":242,"start_index":17,"tongjian_id":"96e2acdf-db0e-11ef-969d-a0d3651f611f"},{"place_name":"兗","place_name_jianti_auto":"兖","resolved_place_entity_id":211,"start_index":19,"tongjian_id":"96e2ace0-db0e-11ef-92f1-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","resolved_place_entity_id":191,"start_index":21,"tongjian_id":"96e2ace1-db0e-11ef-8038-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","resolved_place_entity_id":910,"start_index":51,"tongjian_id":"96e2ace3-db0e-11ef-b905-a0d3651f611f"},{"place_name":"嬴","place_name_jianti_auto":"嬴","resolved_place_entity_id":4466,"start_index":56,"tongjian_id":"96e2ace4-db0e-11ef-b83f-a0d3651f611f"},{"place_name":"嬴","place_name_jianti_auto":"嬴","resolved_place_entity_id":4466,"start_index":68,"tongjian_id":"96e2ace6-db0e-11ef-b44f-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","resolved_place_entity_id":910,"start_index":162,"tongjian_id":"96e2aced-db0e-11ef-a40f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"3公孫舉、東郭竇等聚衆至三萬人，寇青、兗、徐三州，破壞郡縣。連年討之，不能克。尚書選能治劇者，以司徒掾潁川韓韶爲嬴長。賊聞其賢，相戒不入嬴境。餘縣流民萬餘戶入縣界；韶開倉賑之，主者爭謂不可。韶曰：「長活溝壑之人，而以此伏罪，含笑入地矣。」太守素知韶名德，竟無所坐。韶與同郡荀淑、鍾皓、陳寔皆嘗爲縣長，所至以德政稱，時人謂之「潁川四長」。","content_fanyi":"公孙举、东郭窦等人聚集部众达三万人，侵扰青、兖、徐三州，破坏郡县。连年征讨，未能取胜。尚书挑选能够治理繁重事务的人，任命司徒掾、颍川人韩韶为嬴县县长。盗贼听说他贤能，互相告诫不要进入嬴县境内。其他县的流民一万余户进入嬴县地界；韩韶打开粮仓赈济他们，主管粮仓的官吏争辩说不可以这样做。韩韶说：“让将要死于沟壑的人活下来，即便因此获罪，我也会含笑入地。”泰山郡太守素来知道韩韶的名声和德行，最终没有追究他的罪责。韩韶与同郡的荀淑、钟皓、陈寔都曾担任县长，所到之处以德政受到称颂，当时人称他们为“颍川四长”。","content_jianti_auto":"3公孙举、东郭窦等聚众至三万人，寇青、兖、徐三州，破坏郡县。连年讨之，不能克。尚书选能治剧者，以司徒掾颍川韩韶为嬴长。贼闻其贤，相戒不入嬴境。余县流民万余户入县界；韶开仓赈之，主者争谓不可。韶曰：「长活沟壑之人，而以此伏罪，含笑入地矣。」太守素知韶名德，竟无所坐。韶与同郡荀淑、钟皓、陈寔皆尝为县长，所至以德政称，时人谓之「颍川四长」。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4573,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"96e2acca-db0e-11ef-a85b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"96e2acf1-db0e-11ef-bda2-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"96e2acf2-db0e-11ef-b2a2-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":31,"tongjian_id":"96e2acf3-db0e-11ef-a850-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：乙十六行本「段」上有「武威」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：乙十六行本「段」上有「武威」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"96e2acf0-db0e-11ef-8096-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":14,"tongjian_id":"96e2acef-db0e-11ef-9bfa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"司寇，二歲刑。璽，斯氏翻。","note_content_jianti_auto":"司寇，二岁刑。玺，斯氏翻。","note_type":"hu_note","start_index":101,"tongjian_id":"96e2acf5-db0e-11ef-8674-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"段熲傳作「訟」，帝紀作「頌」；作「頌」爲是。","note_content_jianti_auto":"段颎传作「讼」，帝纪作「颂」；作「颂」为是。","note_type":"hu_note","start_index":132,"tongjian_id":"96e2acf7-db0e-11ef-8eaa-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"屬國都尉","official_note":"屬國都尉是漢代在邊疆地區設置的官職，負責管理歸附的少數民族事務，兼具軍事和行政職能。在原文中，段熲擔任此職，率領部下應對鮮卑入侵，顯示其軍事指揮角色。","official_rank":"未知","source_snippet":"屬國都尉段熲率所領馳赴之","start_index":9,"tongjian_id":"c1b33490-6154-4af5-8f7e-4c1aa21f58a4"},{"confidence":0.8,"official_category":"司法","official_name":"司寇","official_note":"司寇是古代官職，負責刑獄和治安事務。在漢代，司寇可能指刑罰或相關職位。原文中，段熲因詐為璽書被判重刑，後以有功改論司寇，表示減輕刑罰或擔任相關職務。","official_rank":"未知","source_snippet":"論司寇","start_index":73,"tongjian_id":"1c09bac7-f51f-40cf-9885-c626d59f708e"},{"confidence":0.85,"official_category":"文教","official_name":"議郞","official_note":"議郞是漢代官職，屬光祿勳，負責顧問應對和議論朝政，無固定職掌但地位較高。原文中，段熲在刑罰結束後被任命為議郞，可能表示其恢復官職或獲得榮譽職位。","official_rank":"未知","source_snippet":"拜議郞","start_index":79,"tongjian_id":"725b8aa8-3bb5-4893-af91-ac67eab3fd52"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是漢代三公之一，負責民政和教化事務，地位極高。原文中，司徒尹頌推薦段熲，顯示其在朝廷中的高級職位和推薦權力。","official_rank":"正一品","source_snippet":"司徒尹頌薦熲","start_index":116,"tongjian_id":"a5d435b1-304c-488f-ad5a-e0398b390fc8"},{"confidence":0.9,"official_category":"军事指挥","official_name":"中郞將","official_note":"中郞將是漢代武官，負責宮廷宿衛或統領軍隊，常作為高級將領。原文中，段熲被任命為中郞將，率軍擊敗盜賊，體現其軍事指揮職能。","official_rank":"未知","source_snippet":"拜中郞將","start_index":124,"tongjian_id":"145c574c-6cc1-43c0-be99-26d096e7351d"},{"confidence":0.85,"official_category":"爵位","official_name":"列侯","official_note":"列侯是漢代爵位，屬於侯爵的一種，通常授予有功之臣，享有封地和特權。原文中，段熲因戰功被封為列侯，表示其獲得高級榮譽和地位。","official_rank":"未知","source_snippet":"封熲爲列侯","start_index":154,"tongjian_id":"2146b165-7c5e-4b23-9c07-e8940059980f"}],"ExtRef_Children_people":[{"link_death_year":179,"link_td_description":"段颎，字纪明，武威郡姑臧县人，东汉官员，曾任护羌校尉、平羌大将、司隶校尉、三公之首太尉等职位。典故“血战积石”就来自段颎，凉州武力豪族的代表人物之一，出自武威郡段氏。","link_td_id":"Q10002673","link_td_number_id":476349,"people_name":"段","people_name_jianti_auto":"段","people_xingming":"段熲","start_index":13,"tongjian_id":"96e2acfb-db0e-11ef-8bdf-a0d3651f611f"},{"link_death_year":179,"link_td_description":"段颎，字纪明，武威郡姑臧县人，东汉官员，曾任护羌校尉、平羌大