{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁亥、八六七）","note_content_jianti_auto":"（丁亥、八六七）","note_type":"hu_note","start_index":0,"tongjian_id":"c5126d53-db0e-11ef-9a97-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"魏博留後","official_note":"魏博留後是唐代魏博節度使的臨時代理職務，通常由節度使去世或離任時指定，負責管理藩鎮事務直至朝廷正式任命新節度使。在《資治通鑑》此段中，何全皞從魏博留後被正式任命為節度使，反映了唐代藩鎮權力交接的常見模式。","official_rank":"未知","source_snippet":"以魏博留後何全皞爲節度使","start_index":8,"tongjian_id":"6de9731b-59f8-4e46-bc51-cc291251b4a2"},{"confidence":0.98,"official_category":"地方行政","official_name":"節度使","official_note":"節度使是唐代中後期的地方軍政長官，統轄一鎮或數州的軍事、行政和財政，權力極大，常形成藩鎮割據。在《資治通鑑》此段中，何全皞被任命為魏博節度使，標誌著他從代理職務轉為正式長官，體現了朝廷對地方權力的確認。","official_rank":"從二品至正三品","source_snippet":"以魏博留後何全皞爲節度使","start_index":17,"tongjian_id":"055024e4-0650-4779-9e05-8fe703477211"}],"ExtRef_Children_people":[{"link_birth_year":839,"link_death_year":870,"link_td_description":"何全皞，唐朝将领，在865年-870年间任魏博节度使，实质独立于朝廷，尽管他协助朝廷平定了庞勋叛乱。870年，全皞被兵變所殺。","link_td_id":"Q10012799","link_td_number_id":1507535,"people_name":"何全皞","people_name_jianti_auto":"何全皞","people_xingming":"何全皞","start_index":11,"tongjian_id":"c5126d55-db0e-11ef-a0ee-a0d3651f611f","wl_zhushi":"[李漼（李温）本年三十五岁]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏博","place_name_jianti_auto":"魏博","place_note":"总部设魏州【河北省大名县】","resolved_place_entity_id":287,"start_index":7,"tongjian_id":"c5126d56-db0e-11ef-a00b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"c