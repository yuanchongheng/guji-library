e_name":"皇陂","place_name_jianti_auto":"皇陂","start_index":66,"tongjian_id":"8bfd6700-db0e-11ef-a3f2-a0d3651f611f"},{"place_name":"長社","place_name_jianti_auto":"长社","start_index":70,"tongjian_id":"8bfd6701-db0e-11ef-a714-a0d3651f611f"},{"place_name":"濁澤","place_name_jianti_auto":"浊泽","start_index":73,"tongjian_id":"8bfd6702-db0e-11ef-ab03-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"康曰：濁，水名；漢志：濁水出齊郡廣縣嬀山。余謂康說誤矣。徐廣史記註曰：長社有濁澤。水經註曰：皇陂水出胡城西北。胡城，潁陰之狐人亭也。皇陂，古長社之濁澤也。記：諸侯相見於郤地曰會。孔穎達曰：諸侯未及期而相見曰遇。會者，謂及期之禮，旣及期，又至所期之地。","note_content_jianti_auto":"康曰：浊，水名；汉志：浊水出齐郡广县妫山。余谓康说误矣。徐广史记注曰：长社有浊泽。水经注曰：皇陂水出胡城西北。胡城，颍阴之狐人亭也。皇陂，古长社之浊泽也。记：诸侯相见于郤地曰会。孔颖达曰：诸侯未及期而相见曰遇。会者，谓及期之礼，既及期，又至所期之地。","note_type":"hu_note","start_index":18,"tongjian_id":"8bfd66ef-db0e-11ef-aa14-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"諸侯","official_note":"諸侯是周朝分封制度下的地方统治者，拥有封地和自治权，此处指田和请求被周王册封为诸侯，以获得合法地位。","official_rank":"未知","source_snippet":"求爲諸侯","start_index":12,"tongjian_id":"69ec7b13-83c4-4c65-9b77-d3930cf40ab5"},{"confidence":0.85,"official_category":"中枢机构","official_name":"王","official_note":"王指周王，是周朝的最高统治者，负责册封诸侯和处理国家大事，此处魏文侯向周王请求册封田和为诸侯。","official_rank":"最高统治者","source_snippet":"請於王","start_index":24,"tongjian_id":"9b58d276-082c-47d3-b3fc-b2d995ea44ef"}],"ExtRef_Children_people":[{"link_death_year":-384,"link_td_description":"田和，本名田和，为大夫时称子禾子，田氏齐国开国君主。其父为田莊子、兄为田悼子，其妻为齐君母、孝大妃。陈完之十世孙。","link_td_id":"Q10000615","link_td_number_id":326951,"people_name":"田和","people_name_jianti_auto":"田和","people_xingming":"田和","start_index":2,"tongjian_id":"8bfd6708-db0e-11ef-968a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"又齐威王败魏于浊泽，围魏，魏请献观以和。《韩世家》：宣惠...","context_before":"...阴之狐人亭也，亦曰胡宗乡。皇陂，古长社之浊泽。《史记》：","source_end_index":69,"source_paragraph_tongjian_id":"5e9ac492-dda2-57cd-bba3-59b5a33204fb","source_start_index":54,"source_text":"齐田和会诸侯于浊泽，求为诸侯。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"2齊田和會魏文侯、楚人、衞人于濁澤，求爲諸侯。魏文侯爲之請於王及諸侯，王許之。","content_fanyi":"齐国田和在浊泽会同魏文侯、楚人、卫人，谋求取得诸侯名位。魏文侯替田和向周安王及各国诸侯陈请，周安王准予所请。","content_jianti_auto":"2齐田和会魏文侯、楚人、衞人于浊泽，求为诸侯。魏文侯为之请于王及诸侯，王许之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":55,"number":2,"path":"资治通鉴 : 卷第一 (周紀一) / 安王 / 十三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8bfd66ee-db0e-11ef-987c-a0d3651f611f","year_int":-389},"tongjian_id":"8bfd66ee-db0e-11ef-987c-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"田氏","people_name_jianti_auto":"田氏","start_index":0,"tongjian_id":"8c021aa1-db0e-11ef-b2e2-a0d3651f611f"},{"people_name":"田和","people_name_jianti_auto":"田和","start_index":9,"tongjian_id":"8c021aa2-db0e-11ef-98aa-a0d3651f611f"},{"people_name":"太公","people_name_jianti_auto":"太公","start_index":13,"tongjian_id":"8c021aa3-db0e-11ef-9b7d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊國","place_name_jianti_auto":"齐国","start_index":6,"tongjian_id":"8c021aa4-db0e-11ef-b051-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"田氏自此遂有齊國。田和是爲太公。","note_content_jianti_auto":"田氏自此遂有齐国。田和是为太公。","note_type":"hu_note","start_index":12,"tongjian_id":"8c021aa0-db0e-11ef-bb28-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"大夫","official_note":"大夫是春秋战国时期诸侯国的高级官职，通常负责地方治理或中央政务。在《资治通鉴》此段中，田和原为齐国的大夫，后被任命为诸侯，反映了战国时期权力更迭的历史背景。","official_rank":"未知","