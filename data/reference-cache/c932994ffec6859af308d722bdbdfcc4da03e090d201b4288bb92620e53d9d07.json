_index":4,"tongjian_id":"9436aa10-db0e-11ef-9d7e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武王觀兵孟津，諸侯不期而會者八百，皆曰：「紂可伐矣。」王曰：「汝未知天命。」乃還師。","note_content_jianti_auto":"武王观兵孟津，诸侯不期而会者八百，皆曰：「纣可伐矣。」王曰：「汝未知天命。」乃还师。","note_type":"hu_note","start_index":61,"tongjian_id":"9436aa0d-db0e-11ef-970a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"速，不速之速，明召也。","note_content_jianti_auto":"速，不速之速，明召也。","note_type":"hu_note","start_index":110,"tongjian_id":"9436aa11-db0e-11ef-904d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昭，明也。","note_content_jianti_auto":"昭，明也。","note_type":"hu_note","start_index":113,"tongjian_id":"9436aa12-db0e-11ef-a771-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9436aa14-db0e-11ef-931d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：病，猶難也。","note_content_jianti_auto":"贤曰：病，犹难也。","note_type":"hu_note","start_index":193,"tongjian_id":"9436aa13-db0e-11ef-a474-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","resolved_place_entity_id":3132,"start_index":83,"tongjian_id":"9436aa1e-db0e-11ef-a92a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"赫连勃勃非无纵横之才，而拓跋方强，凉秦列峙，仅能拾取秦川...","context_before":"...之势，恒在西北，边塞阻险，受敌一面，虽中才亦足以自保哉！","source_end_index":696,"source_paragraph_tongjian_id":"3cc0e31f-4383-5b3e-bc38-b27793753de7","source_start_index":660,"source_text":"隗嚣既不能先败河西，又不能早图三辅，事机已失，乃欲倔强自雄，宜其不振也。"}],"path":"陕西方舆纪要/序","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、巩昌府（卷五十九）","excerpts":[{"context_after":"其后，武侯及姜维皆规此以连结羌胡，震动关辅。蜀汉延熙十八...","context_before":"...陇之会，介雍、凉之间，屹为重镇。秦人始基于此，奄有丰岐。","source_end_index":49,"source_paragraph_tongjian_id":"d492b757-5982-5cb6-b0aa-7266c92dad55","source_start_index":32,"source_text":"东汉初，隗嚣据之，妄欲希踪西伯也。"}],"path":"陕西方舆纪要/八、巩昌府（卷五十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"22隗囂矜己飾智，每自比西伯，與諸將議欲稱王。鄭興曰：「昔文王三分天下有其二，尚服事殷；武王八百諸侯不謀同會，猶還兵待時；高帝征伐累年，猶以沛公行師。今令德雖明，世無宗周之祚；威略雖振，未有高祖之功；而欲舉未可之事，昭速禍患，無乃不可乎！」囂乃止。後又廣置職位以自尊高，鄭興曰：「夫中郞將、太中大夫、使持節官，皆王者之器，非人臣所當制也。無益於實，有損於名，非尊上之意也。」囂病之而止。","content_fanyi":"隗嚣自视甚高，又爱卖弄才智，常常把自己比作周文王，和众将领商议想要称王。郑兴说：“从前周文王三分天下有其二，仍然臣服于殷朝；周武王在孟津检阅军队，八百诸侯不约而同前来相会，他仍然撤回军队等待时机；汉高祖征伐多年，仍以沛公的名义用兵。如今您的美德虽然彰明，却没有周朝世代相承的福禄；声威谋略虽然振作，却没有高祖那样的战功；却想去做不可能成功的事，加速招来祸患，恐怕不可以吧！”隗嚣这才放弃了称王的打算。后来他又大量设置职位来抬高自己的尊贵和富贵，郑兴说：“中郎将、太中大夫、使持节官，都是帝王才能设置的官衔，不是臣子所应设置的。这些对实际并无益处，反而有损名分，不是尊崇皇上的本意。”隗嚣为此很为难，只好作罢。","content_jianti_auto":"22隗嚣矜己饰智，每自比西伯，与诸将议欲称王。郑兴曰：「昔文王三分天下有其二，尚服事殷；武王八百诸侯不谋同会，犹还兵待时；高帝征伐累年，犹以沛公行师。今令德虽明，世无宗周之祚；威略虽振，未有高祖之功；而欲举未可之事，昭速祸患，无乃不可乎！」嚣乃止。后又广置职位以自尊高，郑兴曰：「夫中郞将、太中大夫、使持节官，皆王者之器，非人臣所当制也。无益于实，有损于名，非尊上之意也。」嚣病之而止。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3201,"number":22,"path":"资治通鉴 : 卷第四十一 (漢紀三十三) / 世祖光武皇帝上之下 / 五年 / 第 37 段","reading_annotation_sources":[],"start_index":36,"tongjian_id":"94367912-db0e-11ef-9b53-a0d3651f611f","year_int":29},"tongjian_id":"94367912-db0e-11ef-9b53-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"宗周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭子太叔","people_name_jianti_auto":"郑子太叔","start_index":3,"tongjian_id":"a0ba0830-db0e-11ef-a429-a0d3651f611f"},{"people_name":"范獻子","people_name_jianti_auto":"范献子","start_index":8,"tongjian_id":"a0ba0831-db0e-11ef-a3db-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","start_index":20,"tongjian_id":"a0ba0832-db0e-11ef-ba37-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":31,"tongjian_id":"a0ba0833-db0e-11ef-87c5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：鄭子太叔見范獻子曰：「嫠不恤緯而憂宗周之隕，王室之不寧，晉之恥也。」嫠，陵之翻。","note_content_jianti_auto":"左传：郑子太叔见范献子曰：「嫠不恤纬而忧宗周之陨，王室之不宁，晋之耻也。」嫠，陵之翻。","note_type":"hu_note","start_index":89,"tongjian_id":"a0ba082f-db0e-11ef-89f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"后羿","people_name_jianti_auto":"后羿","start_index":9,"tongjian_id":"a0ba0837-db0e-11ef-b2f3-a0d3651f611f"},{"people_name":"寒浞","people_name_jianti_auto":"寒浞","start_index":21,"tongjian_id":"a0ba0838-db0e-11ef-ba44-a0d3651f611f"},{"people_name":"羿","people_name_jianti_auto":"羿","start_index":24,"tongjian_id":"a0ba0839-db0e-11ef-acf6-a0d3651f611f"},{"people_name":"夏后相","people_name_jianti_auto":"夏后相","start_index":27,"tongjian_id":"a0ba083a-db0e-11ef-80cc-a0d3651f611f"},{"people_name":"后緡","people_name_jianti_auto":"后缗","start_index":31,"tongjian_id":"a0ba083b-db0e-11ef-9e9c-a0d3651f611f"},{"people_name":"少康","people_name_jianti_auto":"少康","start_index":39,"tongjian_id":"a0ba083c-db0e-11ef-80ab-a0d3651f611f"},{"people_name":"靡","people_name_jianti_auto":"靡","start_index":43,"tongjian_id":"a0ba083d-db0e-11ef-9b30-a0d3651f611f"},{"people_name":"浞","people_name_jianti_auto":"浞","start_index":56,"tongjian_id":"a0ba083e-db0e-11ef-9d60-a0d3651f611f"},{"people_name":"少康","people_name_jianti_auto":"少康","start_index":59,"tongjian_id":"a0ba083f-db0e-11ef-a824-a0d3651f611f"},{"people_name":"齊桓公","people_name_jianti_auto":"齐桓公","start_index":72,"tongjian_id":"a0ba0840-db0e-11ef-8973-a0d3651f611f"},{"people_name":"晉文公","people_name_jianti_auto":"晋文公","start_index":84,"tongjian_id":"a0ba0841-db0e-11ef-ba0a-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":102,"tongjian_id":"a0ba0842-db0e-11ef-b35d-a0d3651f611f"},{"people_name":"管仲","people_name_jianti_auto":"管仲","start_index":107,"tongjian_id":"a0ba0843-db0e-11ef-b373-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"夏","place_name_jianti_auto":"夏","start_index":3,"tongjian_id":"a0ba0844-db0e-11ef-a899-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":12,"tongjian_id":"a0ba0845-db0e-11ef-823e-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":16,"tongjian_id":"a0ba0846-db0e-11ef-a0d1-a0d3651f611f"},{"place_name":"有仍","place_name_jianti_auto":"有仍","start_index":35,"tongjian_id":"a0ba0847-db0e-11ef-a666-a0d3651f611f"},{"place_name":"有鬲氏","place_name_jianti_auto":"有鬲氏","start_index":45,"tongjian_id":"a0ba0848-db0e-11ef-ab25-a0d3651f611f"},{"place_name":"有鬲","place_name_jianti_auto":"有鬲","start_index":50,"tongjian_id":"a0ba0849-db0e-11ef-bb9a-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":63,"tongjian_id":"a0ba084a-db0e-11ef-8412-a0d3651f611f"},{"place_name":"山戎","place_name_jianti_auto":"山戎","start_index":77,"tongjian_id":"a0ba084b-db0e-11ef-be36-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":82,"tongjian_id":"a0ba084c-db0e-11ef-96e7-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":88,"tongjian_id":"a0ba084d-db0e-11ef-b859-a0d3651f611f"},{"place_name":"城濮","place_name_jianti_auto":"城濮","start_index":90,"tongjian_id":"a0ba084e-db0e-11ef-8c93-a0d3651f611f"},{"place_name":"周室","place_name_jianti_auto":"周室","start_index":99,"tongjian_id":"a0ba084f-db0e-11ef-a7ae-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：夏之方衰也，后羿因夏民以代夏政；其臣寒浞殺羿而滅夏后相。后緡逃歸有仍，生少康焉。靡奔有鬲氏，自有鬲收衆以滅浞而立少康，祀夏配天，不失舊物。齊桓公北伐山戎，南伐楚，晉文公勝楚於城濮，皆率諸侯以尊周室。孔子曰：微管仲，吾其被髮左袵矣。","note_content_jianti_auto":"左传：夏之方衰也，后羿因夏民以代夏政；其臣寒浞杀羿而灭夏后相。后缗逃归有仍，生少康焉。靡奔有鬲氏，自有鬲收众以灭浞而立少康，祀夏配天，不失旧物。齐桓公北伐山戎，南伐楚，晋文公胜楚于城濮，皆率诸侯以尊周室。孔子曰：微管仲，吾其被发左袵矣。","note_type":"hu_note","start_index":145,"tongjian_id":"a0ba0836-db0e-11ef-b17c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a0ba082d-db0e-11ef-b3ad-a0d3651f611f","pinyin":"lí","source_anchor_text":"賴焉翔曰嫠婦猶知恤","source_key":"baiyang_epub","start_index":79,"text":"嫠","tongjian_id":"a9e031a3-dd59-5d66-99df-7a38ea55e361"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"a0ba082d-db0e-11ef-b3ad-a0d3651f611f","pinyin":"gé","source_anchor_text":"邪嚮使靡鬲之功不立","source_key":"baiyang_epub","start_index":114,"text":"鬲","tongjian_id":"557f8ba6-9be9-596f-bc83-d1ac536a073c"}],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","resolved_place_entity_id":3132,"start_index":84,"tongjian_id":"a0ba0859-db0e-11ef-92f1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"汉置鬲县，属平原郡。后汉建武中，封朱祐为侯邑。晋仍之。后...","context_before":"鬲城[在县东北。古鬲国郾城卑阅之后。","source_end_index":35,"source_paragraph_tongjian_id":"a7305837-ac98-540b-b8ee-d8d5716642a6","source_start_index":18,"source_text":"《左传》云：夏臣靡奔有鬲氏。即此。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"尚書諸葛恢，翔之姊夫也，獨主異議，以爲：「夷狄相攻，中國之利；惟器與名，不可輕許。」乃謂翔曰：「借使慕容鎭軍能除石虎，乃是復得一石虎也。朝廷何賴焉！」翔曰：「嫠婦猶知恤宗周之隕。今晉室阽危，君位侔元、凱，曾無憂國之心邪？嚮使靡、鬲之功不立，則少康何以祀夏！桓、文之戰不捷，則周人皆爲左袵矣。慕容鎭軍枕戈待旦，志殄凶逆，而君更唱邪惑之言，忌間忠臣。四海所以未壹，良由君輩耳！」翔留建康歲餘，衆議終不決。","content_fanyi":"尚书诸葛恢是刘翔的姐夫，独自坚持异议，认为：“夷狄互相攻伐，这对中原之国有利；只有礼器和名号，不能轻易许诺。”于是他对刘翔说：“假如慕容皝能够除掉石虎，那只会是又出现一个石虎，朝廷又有什么可仰仗的呢？”刘翔说：“寡妇尚且知道忧虑西周的覆亡。如今晋室处于危险境地，你的职位与辅佐帝王的高辛氏八元、高阳氏八凯相当，难道竟没有忧国之心吗？从前如果伯靡和有鬲氏不能建立功业，那么少康怎能中兴夏朝！齐桓公、晋文公的战争如果不能取胜，那么周朝人都将披发左衽，沦为异族的奴隶。慕容皝枕戈待旦，立志消灭凶逆，而你却反而宣扬偏颇而惑人的言论，妒忌、离间忠臣。天下之所以未能统一，正是因为有你这样的人！”刘翔留在建康一年多，众人的议论始终没有结果。","content_jianti_auto":"尚书诸葛恢，翔之姊夫也，独主异议，以为：「夷狄相攻，中国之利；惟器与名，不可轻许。」乃谓翔曰：「借使慕容镇军能除石虎，乃是复得一石虎也。朝廷何赖焉！」翔曰：「嫠妇犹知恤宗周之陨。今晋室阽危，君位侔元、凯，曾无忧国之心邪？向使靡、鬲之功不立，则少康何以祀夏！桓、文之战不捷，则周人皆为左袵矣。慕容镇军枕戈待旦，志殄凶逆，而君更唱邪惑之言，忌间忠臣。四海所以未壹，良由君辈耳！」翔留建康岁余，众议终不决。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，义正而于计亦得矣。","context_before":"","source_end_index":22,"source_paragraph_tongjian_id":"03e3d8b4-9c7e-46c6-8e71-a6883cf88c37","source_start_index":0,"source_text":"慕容皝求封燕王，晋廷迟回不予，诸葛恢抗疏拒之"},{"context_after":"灼见其心矣。刘翔虽辩，亦恶能折此乎？当是时，石虎恶极而向...","context_before":"...己已定，则业入其笼中而不能去，又奚复须晋之王而不自帝哉！","source_end_index":292,"source_paragraph_tongjian_id":"d6754824-2b78-4634-b7f4-c2ddf04a83eb","source_start_index":271,"source_text":"诸葛恢曰：“借使能除石虎，是复得一石虎。”"},{"context_after":"，而晋事去矣。皝不死，慕容氏不乱，苻坚不起，吾未见晋之不...","context_before":"...皝乃敢以此言试中国之从违；诸具臣者，畏其暴己罪状而徇之，","source_end_index":143,"source_paragraph_tongjian_id":"0282fb2f-aad5-41db-b4be-18be29ae35df","source_start_index":134,"source_text":"诸葛恢不能固持其说"}],"title":"一五 诸葛恢上疏拒慕容皝求封燕王"}],"id":8327,"path":"资治通鉴 : 卷第九十六 (晉紀十八) / 顯宗成皇帝中之下 / 七年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"a0ba082d-db0e-11ef-b3ad-a0d3651f611f","year_int":341},"tongjian_id":"a0ba082d-db0e-11ef-b3ad-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"宗周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周成王","people_name_jianti_auto":"周成王","start_index":0,"tongjian_id":"ab1ac020-db0e-11ef-8c38-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"洛","place_name_jianti_auto":"洛","start_index":4,"tongjian_id":"ab1ac021-db0e-11ef-b0e9-a0d3651f611f"},{"place_name":"豐","place_name_jianti_auto":"丰","start_index":7,"tongjian_id":"ab1ac022-db0e-11ef-9314-a0d3651f611f"},{"place_name":"宗周","place_name_jianti_auto":"宗周","start_index":9,"tongjian_id":"ab1ac023-db0e-11ef-a8f3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"周成王宅洛，以豐爲宗周，存故都也。","note_content_jianti_auto":"周成王宅洛，以丰为宗周，存故都也。","note_type":"hu_note","start_index":13,"tongjian_id":"ab1ac01f-db0e-11ef-a166-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":0,"tongjian_id":"ab1ac025-db0e-11ef-931f-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":3,"tongjian_id":"ab1ac026-db0e-11ef-9731-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":7,"tongjian_id":"ab1ac027-db0e-11ef-9889-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":12,"tongjian_id":"ab1ac028-db0e-11ef-b809-a0d3651f611f"},{"place_name":"京兆","place_name_jianti_auto":"京兆","start_index":16,"tongjian_id":"ab1ac029-db0e-11ef-8b9d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢都雒陽，置河南尹；而長安仍置京兆尹，亦存故都也。","note_content_jianti_auto":"后汉都雒阳，置河南尹；而长安仍置京兆尹，亦存故都也。","note_type":"hu_note","start_index":23,"tongjian_id":"ab1ac024-db0e-11ef-9659-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"ab1ac02c-db0e-11ef-b338-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"ab1ac02d-db0e-11ef-8250-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":26,"tongjian_id":"ab1ac02e-db0e-11ef-8ce8-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":30,"tongjian_id":"ab1ac02f-db0e-11ef-8a84-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「察」作「案」；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：十二行本「察」作「案」；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"ab1ac02b-db0e-11ef-98bc-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":24,"tongjian_id":"ab1ac02a-db0e-11ef-93e2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":0,"tongjian_id":"ab1ac031-db0e-11ef-bcd4-a0d3651f611f"},{"place_name":"平城","place_name_jianti_auto":"平城","start_index":3,"tongjian_id":"ab1ac032-db0e-11ef-95ff-a0d3651f611f"},{"place_name":"司州","place_name_jianti_auto":"司州","start_index":11,"tongjian_id":"ab1ac033-db0e-11ef-b34f-a0d3651f611f"},{"place_name":"平城","place_name_jianti_auto":"平城","start_index":15,"tongjian_id":"ab1ac034-db0e-11ef-b567-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","start_index":18,"tongjian_id":"ab1ac035-db0e-11ef-b23e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魏初都平城，分畫甸畿置司州，於平城置代尹。","note_content_jianti_auto":"魏初都平城，分画甸畿置司州，于平城置代尹。","note_type":"hu_note","start_index":91,"tongjian_id":"ab1ac030-db0e-11ef-9c04-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","resolved_place_entity_id":3132,"start_index":10,"tongjian_id":"ab1ac038-db0e-11ef-829c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"又，昔周居洛邑，猶存宗周；漢遷東都，京兆置尹。察春秋之義，有宗廟曰都，無曰邑。況代京，宗廟山陵所託，王業所基，其爲神鄕福地，實亦遠矣，今便同之郡國，臣竊不安。謂宜建畿置尹，一如故事，崇本重舊，光示萬葉。","content_fanyi":"再有，过去周成王定居洛阳，仍保留镐京作为故都；东汉迁都洛阳，仍在长安设置京兆尹。考察《春秋》的义例，有宗庙的地方称为“都”，没有宗庙的称为“邑”。何况代京平城，是宗庙与先帝陵墓依托之地，也是王业的根基所在，它作为神乡福地，由来实在已经很久远了，如今却要将它等同于一般的郡国，臣私下深感不安。我认为应依照旧例，将平城升为京畿、设置尹官，以尊崇根本、重视旧业，光示万代。","content_jianti_auto":"又，昔周居洛邑，犹存宗周；汉迁东都，京兆置尹。察春秋之义，有宗庙曰都，无曰邑。况代京，宗庙山陵所托，王业所基，其为神鄕福地，实亦远矣，今便同之郡国，臣窃不安。谓宜建畿置尹，一如故事，崇本重旧，光示万叶。","dtjl_paragraph_links":[],"dtjl_references":[],"id":13162,"path":"资治通鉴 : 卷第一百三十九 (齊紀五) / 高宗明皇帝上 / 建武元年 / 第 15 段","reading_annotation_sources":[],"start_index":14,"tongjian_id":"ab1ac01e-db0e-11ef-b0f6-a0d3651f611f","year_int":494},"tongjian_id":"ab1ac01e-db0e-11ef-b0f6-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"宗周","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"幠母","people_name_jianti_auto":"幠母","start_index":8,"tongjian_id":"b9439e9c-db0e-11ef-acca-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":11,"tongjian_id":"b9439e9d-db0e-11ef-abeb-a0d3651f611f"},{"people_name":"倉林","people_name_jianti_auto":"仓林","start_index":16,"tongjian_id":"b9439e9e-db0e-11ef-978d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":19,"tongjian_id":"b9439e9f-db0e-11ef-9979-a0d3651f611f"},{"people_name":"嫫母","people_name_jianti_auto":"嫫母","start_index":29,"tongjian_id":"b9439ea0-db0e-11ef-a65e-a0d3651f611f"},{"people_name":"何承天","people_name_jianti_auto":"何承天","start_index":33,"tongjian_id":"b9439ea1-db0e-11ef-9d91-a0d3651f611f"},{"people_name":"嫫母","people_name_jianti_auto":"嫫母","start_index":40,"tongjian_id":"b9439ea2-db0e-11ef-aa45-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":47,"tongjian_id":"b9439ea3-db0e-11ef-9f52-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢書·古今人表：幠母，黃帝妃，生倉林。師古曰：幠，音謨；卽嫫母也。何承天纂文曰：嫫母，醜人也，黃帝愛幸之。嫫，音謨。","note_content_jianti_auto":"汉书·古今人表：幠母，黄帝妃，生仓林。师古曰：幠，音谟；即嫫母也。何承天纂文曰：嫫母，丑人也，黄帝爱幸之。嫫，音谟。","note_type":"hu_note","start_index":74,"tongjian_id":"b9439e9b-db0e-11ef-84e4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"妲己","people_name_jianti_auto":"妲己","start_index":0,"tongjian_id":"b9439ea7-db0e-11ef-9b17-a0d3651f611f"},{"people_name":"有蘇氏","people_name_jianti_auto":"有苏氏","start_index":3,"tongjian_id":"b9439ea8-db0e-11ef-a7b8-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":10,"tongjian_id":"b9439ea9-db0e-11ef-a43a-a0d3651f611f"},{"people_name":"妲己","people_name_jianti_auto":"妲己","start_index":15,"tongjian_id":"b9439eaa-db0e-11ef-85c6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"殷","place_name_jianti_auto":"殷","start_index":25,"tongjian_id":"b9439eab-db0e-11ef-bab7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"妲己，有蘇氏之美女，紂愛之，唯妲己之言是從，卒以亡殷。妲，當割翻。","note_content_jianti_auto":"妲己，有苏氏之美女，纣爱之，唯妲己之言是从，卒以亡殷。妲，当割翻。","note_type":"hu_note","start_index":81,"tongjian_id":"b9439ea6-db0e-11ef-9079-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓瑗","people_name_jianti_auto":"韩瑗","start_index":10,"tongjian_id":"b9439ead-db0e-11ef-af07-a0d3651f611f"},{"people_name":"嫫母","people_name_jianti_auto":