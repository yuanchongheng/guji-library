ex":16,"tongjian_id":"9794e594-db0e-11ef-85f7-a0d3651f611f"},{"people_name":"松","people_name_jianti_auto":"松","start_index":20,"tongjian_id":"9794e595-db0e-11ef-9239-a0d3651f611f"},{"people_name":"袁","people_name_jianti_auto":"袁","start_index":33,"tongjian_id":"9794e596-db0e-11ef-85f6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鴻都","place_name_jianti_auto":"鸿都","start_index":22,"tongjian_id":"9794e597-db0e-11ef-af28-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"任，音壬。考異曰：范書云「中常侍樂松」。松本鴻都文學，必非中常侍。袁紀云「侍中」，今從之。","note_content_jianti_auto":"任，音壬。考异曰：范书云「中常侍乐松」。松本鸿都文学，必非中常侍。袁纪云「侍中」，今从之。","note_type":"hu_note","start_index":144,"tongjian_id":"9794e592-db0e-11ef-85f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊宣王","people_name_jianti_auto":"齐宣王","start_index":0,"tongjian_id":"9794e59c-db0e-11ef-b7b8-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":10,"tongjian_id":"9794e59d-db0e-11ef-8c38-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":49,"tongjian_id":"9794e59e-db0e-11ef-be24-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"齊宣王問於孟子曰：「文王之囿，方七十里，人猶以爲小；寡人之囿，方四十里，人以爲大，何也？」對曰：「文王之囿方七十里，芻蕘者往焉，雉兔者往焉，與人同之；人以爲小，不亦宜乎！今王之囿，殺其麋鹿者如殺人之罪；人以爲大，不亦宜乎！」此云五里，微與孟子異。","note_content_jianti_auto":"齐宣王问于孟子曰：「文王之囿，方七十里，人犹以为小；寡人之囿，方四十里，人以为大，何也？」对曰：「文王之囿方七十里，刍荛者往焉，雉兔者往焉，与人同之；人以为小，不亦宜乎！今王之囿，杀其麋鹿者如杀人之罪；人以为大，不亦宜乎！」此云五里，微与孟子异。","note_type":"hu_note","start_index":171,"tongjian_id":"9794e59b-db0e-11ef-b136-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒为东汉三公之一，主管教化，此处杨赐以司徒身份进谏皇帝修建苑囿之事，体现了其作为朝廷重臣的谏议职责。","official_rank":"三公之一","source_snippet":"司徒楊賜諫曰","start_index":12,"tongjian_id":"53b6fa41-0e3f-441b-b253-110b9147492b"},{"confidence":0.95,"official_category":"中枢近臣","official_name":"侍中","official_note":"侍中为皇帝近侍之臣，掌顾问应对，此处任芝、乐松以侍中身份回答皇帝关于修建苑囿的询问，体现了其参与决策咨询的作用。","official_rank":"比二千石","source_snippet":"以問侍中任芝、樂松","start_index":114,"tongjian_id":"1170bf1a-ee16-45af-8376-d3d2fa180c0a"}],"ExtRef_Children_people":[{"link_death_year":185,"link_td_description":"杨赐，字伯献，弘农郡华阴县人，东汉大臣，出身自东汉世族“弘农杨氏”，祖父杨震，父亲杨秉，杨赐以及儿子杨彪皆位至太尉，时人有“四世太尉”之称。","link_td_id":"Q10007282","link_td_number_id":4560049,"people_name":"楊賜","people_name_jianti_auto":"杨赐","people_xingming":"杨赐","start_index":14,"tongjian_id":"9794e5a3-db0e-11ef-8ee7-a0d3651f611f"},{"link_td_description":"禹，姒姓，夏后氏，传说名文命，后世尊称为大禹。远古时期中国神话人物，是黄帝轩辕氏八世孙，因在大禹治水中成功治理洪水之患的故事而广为人知。传说中，禹是中国历史上第一个家天下政权夏朝的开创者，定都于阳城（具体所在有多种说法）。禹在尧时被封为夏伯，故史书又称伯禹、夏禹。在道教信仰里，禹也被尊为水官大帝、水仙尊王。","link_td_id":"Q10000013","link_td_number_id":4218,"people_name":"夏禹","people_name_jianti_auto":"夏禹","people_xingming":"姒文命","start_index":107,"tongjian_id":"9794e5a6-db0e-11ef-a984-a0d3651f611f","wl_zhushi":"[姒文命]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"太宗","people_name_jianti_auto":"太宗","people_xingming":"刘恒","start_index":112,"tongjian_id":"9794e5a7-db0e-11ef-a428-a0d3651f611f","wl_zhushi":"[刘恒]"},{"people_name":"任芝","people_name_jianti_auto":"任芝","people_xingming":"任芝","start_index":138,"tongjian_id":"9794e5a8-db0e-11ef-a64a-a0d3651f611f"},{"people_name":"樂松","people_name_jianti_auto":"乐松","people_xingming":"乐松","start_index":141,"tongjian_id":"9794e5a9-db0e-11ef-ace2-a0d3651f611f"},{"link_birth_year":-1112,"link_death_year":-1050,"link_td_description":"周文王，姬姓，周氏，名昌，又称西伯昌。中国商朝末期诸侯国周国君主。后世视之为道统的传人之一。","link_td_id":"Q10000441","link_td_number_id":15568,"people_name":"文王","people_name_jianti_auto":"文王","people_xingming":"姬昌","start_index":149,"tongjian_id":"9794e5aa-db0e-11ef-a289-a0d3651f611f","wl_zhushi":"[姬昌]"},{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊宣","people_name_jianti_auto":"齐宣","people_xingming":"田辟彊","start_index":161,"tongjian_id":"9794e5ab-db0e-11ef-8906-a0d3651f611f","wl_zhushi":"[田辟彊]"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9794e577-db0e-11ef-b95e-a0d3651f611f","pinyin":"bì","source_anchor_text":"之是歲作罼圭靈昆苑","source_key":"baiyang_epub","start_index":5,"text":"罼","tongjian_id":"ec8e9dde-4fe9-5625-8d2c-aeb2a70c2156"}],"ExtRef_Children_places":[{"place_name":"罼圭","place_name_jianti_auto":"罼圭","resolved_place_entity_id":8714,"start_index":5,"tongjian_id":"9794e5a1-db0e-11ef-8396-a0d3651f611f"},{"place_name":"靈昆苑","place_name_jianti_auto":"灵昆苑","resolved_place_entity_id":9758,"start_index":8,"tongjian_id":"9794e5a2-db0e-11ef-bd8d-a0d3651f611f"},{"place_name":"鴻池","place_name_jianti_auto":"鸿池","resolved_place_entity_id":3893,"start_index":27,"tongjian_id":"9794e5a4-db0e-11ef-ad8d-a0d3651f611f"},{"place_name":"上林","place_name_jianti_auto":"上林","resolved_place_entity_id":1226,"start_index":32,"tongjian_id":"9794e5a5-db0e-11ef-a65c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"7是歲，作罼圭、靈昆苑。司徒楊賜諫曰：「先帝之制，左開鴻池，右作上林，不奢不約，以合體中。今猥規郊城之地以爲苑囿，壞沃衍，廢田園，驅居民，畜禽獸，殆非所謂若保赤子之義。今城外之苑已有五六，可以逞情意，順四節也。宜惟夏禹卑宮、太宗露臺之意，以尉下民之勞。」書奏，帝欲止，以問侍中任芝、樂松；對曰：「昔文王之囿百里，人以爲小；齊宣五里，人以爲大。今與百姓共之，無害於政也。」帝悅，遂爲之。","content_fanyi":"这一年，朝廷下令营建罼圭苑、灵昆苑。司徒杨赐进谏说：“先帝定下的制度，左边开凿鸿池，右边营建上林苑，既不奢侈也不俭约，以合乎体制。现在滥行规划郊城土地作为苑囿，毁坏肥沃平广的良田，废弃田园，赶走居民，饲养禽兽，这恐怕不是所谓像保护婴儿那样的爱民之义。如今城外的苑囿已经有五六处，可以满足情志意趣，顺应四时节令。应当追念夏禹宫室低矮、汉文帝不修露台的用意，以慰藉下层百姓的劳苦。”奏书呈上后，灵帝想要停工，询问侍中任芝、乐松；二人回答说：“从前周文王的苑囿方圆百里，百姓认为小；齐宣王的苑囿方圆五里，百姓认为大。如今与百姓共同享用，对政事并无妨害。”灵帝很高兴，于是继续修建。","content_jianti_auto":"7是岁，作罼圭、灵昆苑。司徒杨赐谏曰：「先帝之制，左开鸿池，右作上林，不奢不约，以合体中。今猥规郊城之地以为苑囿，坏沃衍，废田园，驱居民，畜禽兽，殆非所谓若保赤子之义。今城外之苑已有五六，可以逞情意，顺四节也。宜惟夏禹卑宫、太宗露台之意，以尉下民之劳。」书奏，帝欲止，以问侍中任芝、乐松；对曰：「昔文王之囿百里，人以为小；齐宣五里，人以为大。今与百姓共之，无害于政也。」帝悦，遂为之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4962,"number":7,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"9794e577-db0e-11ef-b95e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9794e5ac-db0e-11ef-8fea-a0d3651f611f","pinyin":"shǔn","source_anchor_text":"之巴郡板楯蠻反蒼梧","source_key":"baiyang_epub","start_index":4,"text":"楯","tongjian_id":"4cc986d6-5275-5a9e-a36c-8266251a4d5b"}],"ExtRef_Children_places":[{"place_name":"巴郡","place_name_jianti_auto":"巴郡","resolved_place_entity_id":427,"start_index":1,"tongjian_id":"9794e5ad-db0e-11ef-837a-a0d3651f611f"},{"place_name":"板楯蠻","place_name_jianti_auto":"板楯蛮","resolved_place_entity_id":2885,"start_index":3,"tongjian_id":"9794e5ae-db0e-11ef-b203-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"8巴郡板楯蠻反。","content_fanyi":"巴郡的板楯蛮再次起兵反叛。","content_jianti_auto":"8巴郡板楯蛮反。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4963,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"9794e5ac-db0e-11ef-8fea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9794e5b1-db0e-11ef-b33f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：排囊，卽今囊袋也。排，音蒲拜翻。盛，時征翻。","note_content_jianti_auto":"贤曰：排囊，即今囊袋也。排，音蒲拜翻。盛，时征翻。","note_type":"hu_note","start_index":34,"tongjian_id":"9794e5b0-db0e-11ef-83ef-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"波駭者，蓋喻以物擊水，一波動，萬波隨而駭動。","note_content_jianti_auto":"波骇者，盖喻以物击水，一波动，万波随而骇动。","note_type":"hu_note","start_index":106,"tongjian_id":"9794e5b3-db0e-11ef-bd6f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"梟者，斬首而梟之木上也。梟，堅堯翻。帥，所類翻。","note_content_jianti_auto":"枭者，斩首而枭之木上也。枭，坚尧翻。帅，所类翻。","note_type":"hu_note","start_index":118,"tongjian_id":"9794e5b4-db0e-11ef-b632-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":12,"source_start_index":3,"source_text":"見上卷桓帝永康元年","target_paragraph_tongjian_id":"9746f4b2-db0e-11ef-bca6-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"楊喬","people_name_jianti_auto":"杨乔","start_index":0,"tongjian_id":"9794e5b6-db0e-11ef-b37f-a0d3651f611f"},{"people_name":"桓帝","people_name_jianti_auto":"桓帝","start_index":6,"tongjian_id":"9794e5b7-db0e-11ef-b352-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楊喬，見上卷桓帝永康元年。","note_content_jianti_auto":"杨乔，见上卷桓帝永康元年。","note_type":"hu_note","start_index":229,"tongjian_id":"9794e5b5-db0e-11ef-acdd-a0d3651f611f"}],"ExtRef_Children_officials":[{"