hildren_paragraph_links":[{"relation_type":"forward_setup","source_end_index":14,"source_start_index":0,"source_text":"爲何進謀誅宦官、敗國亡家張本","target_paragraph_tongjian_id":"9810f49e-db0e-11ef-9124-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"何進","people_name_jianti_auto":"何进","start_index":1,"tongjian_id":"9794e571-db0e-11ef-acca-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲何進謀誅宦官、敗國亡家張本。","note_content_jianti_auto":"为何进谋诛宦官、败国亡家张本。","note_type":"hu_note","start_index":51,"tongjian_id":"9794e570-db0e-11ef-8667-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"潁川太守","official_note":"潁川太守是潁川郡的最高行政長官，負責管理該郡的民政、司法、財政等事務。在東漢時期，郡守是地方行政體系中的重要職位。此處指何進在被徵召為侍中之前擔任的官職。","official_rank":"郡守（二千石）","source_snippet":"潁川太守進","start_index":24,"tongjian_id":"784dbe90-9527-4785-a1bf-c97868b5ea3a"},{"confidence":0.9,"official_category":"中枢近臣","official_name":"侍中","official_note":"侍中是皇帝的近臣，負責顧問應對、傳達詔命、審核奏章等事務，常出入禁中。在東漢時期，侍中多由外戚或親信擔任，權力較大。此處指何進被徵召擔任此職，顯示其因妹妹被立為皇后而獲得晉升。","official_rank":"比二千石","source_snippet":"進爲侍中","start_index":29,"tongjian_id":"7ac779b9-bbc1-409d-8204-6cbf6eb9dfdf"}],"ExtRef_Children_people":[{"link_birth_year":150,"link_death_year":189,"link_td_description":"灵思皇后，何姓，真名失传。东汉灵帝第二任皇后。何进异母妹，何苗同母妹。另有一妹为张让儿媳（或为张奉妻）。","link_td_id":"Q10000847","link_td_number_id":378955,"people_name":"何氏","people_name_jianti_auto":"何氏","people_xingming":"何氏","start_index":11,"tongjian_id":"9794e572-db0e-11ef-a344-a0d3651f611f","wl_zhushi":"[刘宏本年二十五岁]"},{"link_death_year":189,"link_td_description":"何进，字遂高，南阳宛县（今河南省南阳市）人，东汉末年外戚，官至大将军，录尚书事，封慎侯。何进为了对付十常侍而召董卓率军队入京，成为东汉末年直至三国割据的重要事件之一，而自己也被十常侍杀死。","link_td_id":"Q10001052","link_td_number_id":138554,"people_name":"進","people_name_jianti_auto":"进","people_xingming":"何进","start_index":24,"tongjian_id":"9794e573-db0e-11ef-b091-a0d3651f611f","wl_zhushi":"[刘宏本年二十五岁]"},{"people_name":"辨","people_name_jianti_auto":"辨","people_xingming":"刘辨","start_index":45,"tongjian_id":"9794e574-db0e-11ef-95d5-a0d3651f611f","wl_zhushi":"[刘宏本年二十五岁]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁川","place_name_jianti_auto":"颍川","resolved_place_entity_id":910,"start_index":20,"tongjian_id":"9794e575-db0e-11ef-ad41-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","resolved_place_entity_id":235,"start_index":31,"tongjian_id":"9794e576-db0e-11ef-9020-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"6十二月，己巳，立貴人何氏爲皇后。徵后兄潁川太守進爲侍中。后本南陽屠家，以選入掖庭，生皇子辨，故立之。","content_fanyi":"十二月己巳日，灵帝册立贵人何氏为皇后。征召皇后的兄长、颍川郡太守何进担任侍中。何皇后本是南阳郡屠户家的女儿，因被选入掖庭，生下皇子刘辨，因此被立为皇后。","content_jianti_auto":"6十二月，己巳，立贵人何氏为皇后。征后兄颍川太守进为侍中。后本南阳屠家，以选入掖庭，生皇子辨，故立之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4961,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"9794e569-db0e-11ef-abb5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9794e579-db0e-11ef-8a3d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"罼圭苑","place_name_jianti_auto":"罼圭苑","start_index":3,"tongjian_id":"9794e57a-db0e-11ef-a3da-a0d3651f611f"},{"place_name":"東罼圭苑","place_name_jianti_auto":"东罼圭苑","start_index":9,"tongjian_id":"9794e57b-db0e-11ef-b83d-a0d3651f611f"},{"place_name":"魚梁臺","place_name_jianti_auto":"鱼梁台","start_index":23,"tongjian_id":"9794e57c-db0e-11ef-9ef3-a0d3651f611f"},{"place_name":"西罼圭苑","place_name_jianti_auto":"西罼圭苑","start_index":27,"tongjian_id":"9794e57d-db0e-11ef-a1bd-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":41,"tongjian_id":"9794e57e-db0e-11ef-8827-a0d3651f611f"},{"place_name":"宣平門","place_name_jianti_auto":"宣平门","start_index":43,"tongjian_id":"9794e57f-db0e-11ef-9795-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：罼圭苑有二，東罼圭苑，周一千五百步，中有魚梁臺，西罼圭苑，周三千三百步，並在雒陽宣平門外。","note_content_jianti_auto":"贤曰：罼圭苑有二，东罼圭苑，周一千五百步，中有鱼梁台，西罼圭苑，周三千三百步，并在雒阳宣平门外。","note_type":"hu_note","start_index":12,"tongjian_id":"9794e578-db0e-11ef-b670-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":0,"tongjian_id":"9794e581-db0e-11ef-b7bb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜預註左傳曰：衍沃，平美之地也。壞，音怪。","note_content_jianti_auto":"杜预注左传曰：衍沃，平美之地也。坏，音怪。","note_type":"hu_note","start_index":61,"tongjian_id":"9794e580-db0e-11ef-b7cc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"書曰：若保赤子，惟民其康乂。","note_content_jianti_auto":"书曰：若保赤子，惟民其康乂。","note_type":"hu_note","start_index":84,"tongjian_id":"9794e584-db0e-11ef-953d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9794e587-db0e-11ef-a772-a0d3651f611f"},{"people_name":"桓帝","people_name_jianti_auto":"桓帝","start_index":36,"tongjian_id":"9794e588-db0e-11ef-a3dd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西苑","place_name_jianti_auto":"西苑","start_index":9,"tongjian_id":"9794e589-db0e-11ef-a179-a0d3651f611f"},{"place_name":"顯陽苑","