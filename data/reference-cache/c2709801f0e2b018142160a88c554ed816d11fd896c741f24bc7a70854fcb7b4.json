d3651f611f"},{"place_name":"鄜州","place_name_jianti_auto":"鄜州","start_index":63,"tongjian_id":"8c3bd475-db0e-11ef-b309-a0d3651f611f"},{"place_name":"洛交縣","place_name_jianti_auto":"洛交县","start_index":65,"tongjian_id":"8c3bd476-db0e-11ef-9175-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"犀首，魏官名。公孫衍爲此官，因號犀首，猶虎牙將軍之稱。龍姓出於龍伯氏，或云出於御龍氏。班志，上郡有雕陰道。括地志：雕陰故城，在鄜州洛交縣北二十里。敗，補邁翻。稱，尺證翻。","note_content_jianti_auto":"犀首，魏官名。公孙衍为此官，因号犀首，犹虎牙将军之称。龙姓出于龙伯氏，或云出于御龙氏。班志，上郡有雕阴道。括地志：雕阴故城，在鄜州洛交县北二十里。败，补迈翻。称，尺证翻。","note_type":"hu_note","start_index":26,"tongjian_id":"8c3bd469-db0e-11ef-a9ab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言引兵東下也。","note_content_jianti_auto":"言引兵东下也。","note_type":"hu_note","start_index":31,"tongjian_id":"8c3bd479-db0e-11ef-a003-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":55,"tongjian_id":"8c3bd483-db0e-11ef-a265-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、延安府（卷五十七）","excerpts":[{"context_after":"汉置县。三国魏时县废。旧《志》云：雕阴城在鄜州北三十里。...","context_before":"○雕阴城[县南四十里。战国时魏地。","source_end_index":63,"source_paragraph_tongjian_id":"cc3014eb-fb2d-5016-a8e0-1f2ee11827b3","source_start_index":17,"source_text":"周显王三十六年，秦犀首伐魏，取雕阴。《史记》：梁襄王五年，秦败我龙贾军四万五千于雕阴。是也。"}],"path":"陕西方舆纪要/五、延安府（卷五十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"會秦使犀首伐魏，大敗其師四萬餘人，禽將龍賈，取雕陰，且欲東兵。蘇秦恐秦兵至趙而敗從約，念莫可使用於秦者，乃激怒張儀，入之於秦。","content_fanyi":"恰逢秦国派犀首率军攻打魏国，大败魏军四万余人，擒获魏将龙贾，夺取魏国城邑雕阴，并准备向东进兵。苏秦担心秦军打到赵国会破坏合纵盟约，考虑到没有合适的人可派往秦国用计，于是激怒张仪，使他前往秦国。","content_jianti_auto":"会秦使犀首伐魏，大败其师四万余人，禽将龙贾，取雕阴，且欲东兵。苏秦恐秦兵至赵而败从约，念莫可使用于秦者，乃激怒张仪，入之于秦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":187,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"8c3bd468-db0e-11ef-915f-a0d3651f611f","year_int":-333},"tongjian_id":"8c3bd468-db0e-11ef-915f-a0d3651f611f"},"paragraph_order":1},{"mention_count":6,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"张仪选择入秦","decision_tongjian_id":"DECISION_8C3BD486DB0E11EF8BABA0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鬼谷先生","people_name_jianti_auto":"鬼谷先生","start_index":30,"tongjian_id":"8c3bd488-db0e-11ef-b482-a0d3651f611f"},{"people_name":"樂壹","people_name_jianti_auto":"乐壹","start_index":73,"tongjian_id":"8c3bd489-db0e-11ef-9ab4-a0d3651f611f"},{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":82,"tongjian_id":"8c3bd48a-db0e-11ef-a372-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鬼谷","place_name_jianti_auto":"鬼谷","start_index":3,"tongjian_id":"8c3bd48b-db0e-11ef-86ab-a0d3651f611f"},{"place_name":"馮翊郡","place_name_jianti_auto":"冯翊郡","start_index":14,"tongjian_id":"8c3bd48c-db0e-11ef-b8ca-a0d3651f611f"},{"place_name":"韓城縣","place_name_jianti_auto":"韩城县","start_index":17,"tongjian_id":"8c3bd48d-db0e-11ef-895a-a0d3651f611f"},{"place_name":"鬼谷","place_name_jianti_auto":"鬼谷","start_index":21,"tongjian_id":"8c3bd48e-db0e-11ef-92d0-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":35,"tongjian_id":"8c3bd48f-db0e-11ef-af5b-a0d3651f611f"},{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":46,"tongjian_id":"8c3bd490-db0e-11ef-be28-a0d3651f611f"},{"place_name":"池陽","place_name_jianti_auto":"池阳","start_index":48,"tongjian_id":"8c3bd491-db0e-11ef-8a8f-a0d3651f611f"},{"place_name":"潁川陽城","place_name_jianti_auto":"颍川阳城","start_index":51,"tongjian_id":"8c3bd492-db0e-11ef-9825-a0d3651f611f"},{"place_name":"陽城","place_name_jianti_auto":"阳城","start_index":53,"tongjian_id":"8c3bd493-db0e-11ef-8cef-a0d3651f611f"},{"place_name":"鬼谷","place_name_jianti_auto":"鬼谷","start_index":57,"tongjian_id":"8c3bd494-db0e-11ef-b770-a0d3651f611f"},{"place_name":"鬼谷","place_name_jianti_auto":"鬼谷","start_index":93,"tongjian_id":"8c3bd495-db0e-11ef-b6ce-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蓋居於鬼谷，因以稱之。隋志，馮翊郡韓城縣有鬼谷。風俗通義曰：鬼谷先生，六國時縱橫家。索隱曰：扶風池陽、潁川陽城並有鬼谷，蓋是其人所居，因以爲號。又樂壹註鬼谷子書云：蘇秦欲神祕其道，故假名鬼谷。","note_content_jianti_auto":"盖居于鬼谷，因以称之。隋志，冯翊郡韩城县有鬼谷。风俗通义曰：鬼谷先生，六国时纵横家。索隐曰：扶风池阳、颍川阳城并有鬼谷，盖是其人所居，因以为号。又乐壹注鬼谷子书云：苏秦欲神秘其道，故假名鬼谷。","note_type":"hu_note","start_index":17,"tongjian_id":"8c3bd487-db0e-11ef-afa9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「恐」，史記作「怒」。","note_content_jianti_auto":"「恐」，史记作「怒」。","note_type":"hu_note","start_index":55,"tongjian_id":"8c3bd49b-db0e-11ef-810d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":0,"tongjian_id":"8c3bd49e-db0e-11ef-8e72-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":16,"tongjian_id":"8c3bd49f-db0e-11ef-99fe-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文穎曰：舍人，主廏內小吏官名也。師古曰：舍人，親近左右之通稱也；後遂爲司屬官號。齎，則兮翻。","note_content_jianti_auto":"文颖曰：舍人，主廏内小吏官名也。师古曰：舍人，亲近左右之通称也；后遂为司属官号。赍，则兮翻。","note_type":"hu_note","start_index":81,"tongjian_id":"8c3bd49d-db0e-11ef-a140-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8c3bd4a2-db0e-11ef-9c0c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"秦有客卿之官，以待自諸侯來者，其位爲卿而以客禮待之也。","note_content_jianti_auto":"秦有客卿之官，以待自诸侯来者，其位为卿而以客礼待之也。","note_type":"hu_note","start_index":97,"tongjian_id":"8c3bd4a1-db0e-11ef-9073-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":23,"source_start_index":9,"source_text":"爲後蘇秦死，儀方出說六國張本","target_paragraph_tongjian_id":"8c5c61dc-db0e-11ef-97bb-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":11,"tongjian_id":"8c3bd4a5-db0e-11ef-a29d-a0d3651f611f"},{"people_name":"儀","people_name_jianti_auto":"仪","start_index":15,"tongjian_id":"8c3bd4a6-db0e-11ef-91e7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"六國","place_name_jianti_auto":"六国","start_index":19,"tongjian_id":"8c3bd4a7-db0e-11ef-9924-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲吾之爲，于僞翻。爲後蘇秦死，儀方出說六國張本。說，式芮翻。","note_content_jianti_auto":"为吾之为，于伪翻。为后苏秦死，仪方出说六国张本。说，式芮翻。","note_type":"hu_note","start_index":189,"tongjian_id":"8c3bd4a4-db0e-11ef-9ae1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"客卿","official_note":"客卿是战国时期秦国授予外国人的高级官职，用于吸引人才，此处张仪被秦王任命为客卿，表示他受到重用，参与国家事务。","official_rank":"未知","source_snippet":"以爲客卿","start_index":96,"tongjian_id":"e2be8cd1-d813-42e6-a56f-e1ca76