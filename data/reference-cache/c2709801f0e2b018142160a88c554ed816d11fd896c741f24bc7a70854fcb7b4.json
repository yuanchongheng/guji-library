和外交中的重要作用。","official_rank":"未知","source_snippet":"齊、楚之相","start_index":6,"tongjian_id":"55ad5f0d-f74d-43c8-80a1-2d8519af178d"}],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":2,"tongjian_id":"8c451b1d-db0e-11ef-9f17-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十四、徐州（卷二十九）","excerpts":[{"context_after":"汉武帝《瓠子歌》：啮桑浮兮淮泗满。及塞决口，而梁、楚无水...","context_before":"啮桑亭[在县西南。徐广曰：梁与彭城间有啮桑。谓此地也。","source_end_index":52,"source_paragraph_tongjian_id":"18afb555-2c9a-5155-ad10-944e6a3ce351","source_start_index":27,"source_text":"战国周显王四十六年，秦张仪及齐、楚之相，会于啮桑。"}],"path":"南直方舆纪要/十四、徐州（卷二十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦張儀及齊、楚之相會齧桑。","content_fanyi":"秦国张仪与齐国、楚国的相在啮桑会盟。","content_jianti_auto":"1秦张仪及齐、楚之相会啮桑。","dtjl_paragraph_links":[],"dtjl_references":[],"id":212,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十六年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c451b00-db0e-11ef-97e3-a0d3651f611f","year_int":-323},"tongjian_id":"8c451b00-db0e-11ef-97e3-a0d3651f611f"},"paragraph_order":5},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"如何应对魏王拒绝臣服","decision_tongjian_id":"DECISION_8C451B2ADB0E11EFB1A0A0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":21,"tongjian_id":"8c451b2c-db0e-11ef-