-a6f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令，力丁翻。此曲沃在河東，晉桓叔所封之邑；漢武帝改名聞喜。史記正義曰：絳州桐鄕縣，晉曲沃邑。十三州志：古平周邑在汾州介休縣西四十里。","note_content_jianti_auto":"令，力丁翻。此曲沃在河东，晋桓叔所封之邑；汉武帝改名闻喜。史记正义曰：绛州桐鄕县，晋曲沃邑。十三州志：古平周邑在汾州介休县西四十里。","note_type":"hu_note","start_index":44,"tongjian_id":"8c451b2e-db0e-11ef-9fda-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期诸侯国的最高行政长官，负责辅佐君主处理政务。在《资治通鉴》此段中，张仪被免去秦国的相位后，又担任魏国的相，这反映了战国时期士人流动和各国争相任用人才的现象。","official_rank":"未知","source_snippet":"免相，相魏","start_index":6,"tongjian_id":"eaaebca5-add4-4dfa-9ccd-fd12d3b13a1c"}],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":2,"tongjian_id":"8c451b3d-db0e-11ef-a1f4-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":47,"tongjian_id":"8c451b48-db0e-11ef-8c01-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"又赧王元年，秦复伐魏，取曲沃而归其入秦，谓之左邑。《水经...","context_before":"...，即曲沃也。又襄二十三年，齐纳晋栾盈于曲沃。《战国策》：","source_end_index":165,"source_paragraph_tongjian_id":"b31baa1c-4223-59a5-9bf9-6183270736ce","source_start_index":149,"source_text":"周显王四十六年，秦伐魏，取曲沃。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"汉置平周县，属西河郡。后汉因之。晋省。又《郡志》云：县东...","context_before":"...邑。又平周城，在县西四十里。《十三州志》：战国时魏邑也。","source_end_index":87,"source_paragraph_tongjian_id":"c01b21cf-e9f0-5319-b4fd-067d1a6fcb00","source_start_index":68,"source_text":"梁襄王十三年，秦取我曲沃、平周，即此。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦張儀自齧桑還而免相，相魏。欲令魏先事秦而諸侯效之；魏王不聽。秦王伐魏，取曲沃、平周，復陰厚張儀益甚。","content_fanyi":"秦国张仪从齧桑返回后，表面上被免去国相之职，改到魏国任相。他想让魏国率先事奉秦国，以便各国诸侯仿效；魏王不肯听从。秦王于是发兵攻打魏国，夺取曲沃、平周两邑，又暗中更加厚待张仪。","content_jianti_auto":"1秦张仪自啮桑还而免相，相魏。欲令魏先事秦而诸侯效之；魏王不听。秦王伐魏，取曲沃、平周，复阴厚张仪益甚。","dtjl_paragraph_links":[],"dtjl_references":[],"id":214,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十七年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c451b2a-db0e-11ef-b1a0-a0d3651f611f","year_int":-322},"tongjian_id":"8c451b2a-db0e-11ef-b1a0-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"智氏","people_name_jianti_auto":"智氏","start_index":4,"tongjian_id":"8c49c1e5-db0e-11ef-81ec-a0d3651f611f"},{"people_name":"范氏","people_name_jianti_auto":"范氏","start_index":7,"tongjian_id":"8c49c1e6-db0e-11ef-8e2e-a0d3651f611f"},{"people_name":"中行氏","people_name_jianti_auto":"中行氏","start_index":10,"tongjian_id":"8c49c1e7-db0e-11ef-a0a7-a0d3651f611f"},{"people_name":"趙氏","people_name_jianti_auto":"赵氏","start_index":14,"tongjian_id":"8c49c1e8-db0e-11ef-b43f-a0d3651f611f"},{"people_name":"韓氏","people_name_jianti_auto":"韩氏","start_index":17,"tongjian_id":"8c49c1e9-db0e-11ef-a594-a0d3651f611f"},{"people_name":"魏氏","people_name_jianti_auto":"魏氏","start_index":20,"tongjian_id":"8c49c1ea-db0e-11ef-9577-a0d3651f611f"},{"people_name":"晉文","people_name_jianti_auto":"晋文","start_index":25,"tongjian_id":"8c49c1eb-db0e-11ef-8178-a0d3651f611f"},{"people_name":"襄","people_name_jianti_auto":"襄","start_index":28,"tongjian_id":"8c49c1ec-db0e-11ef-b5b5-a0d3651f611f"},{"people_name":"齊簡公","people_name_jianti_auto":"齐简公","start_index":47,"tongjian_id":"8c49c1ed-db0e-11ef-b19d-a0d3651f611f"},{"people_name":"闞止","people_name_jianti_auto":"阚止","start_index":51,"tongjian_id":"8c49c1ee-db0e-11ef-8789-a0d3651f611f"},{"people_name":"陳成子","people_name_jianti_auto":"陈成子","start_index":56,"tongjian_id":"8c49c1ef-db0e-11ef-a834-a0d3651f611f"},{"people_name":"陳常","people_name_jianti_auto":"陈常","start_index":64,"tongjian_id":"8c49c1f0-db0e-11ef-b946-a0d3651f611f"},{"people_name":"闞止","people_name_jianti_auto":"阚止","start_index":67,"tongjian_id":"8c49c1f1-db0e-11ef-bd40-a0d3651f611f"},{"people_name":"簡公","people_name_jianti_auto":"简公","start_index":71,"tongjian_id":"8c49c1f2-db0e-11ef-9419-a0d3651f611f"},{"people_name":"闞","people_name_jianti_auto":"阚","start_index":74,"tongjian_id":"8c49c1f3-db0e-11ef-a8f8-a0d3651f611f"},{"people_name":"蘇代","people_name_jianti_auto":"苏代","start_index":81,"tongjian_id":"8c49c1f4-db0e-11ef-bf3c-a0d3651f611f"},{"people_name":"犀首","people_name_jianti_auto":"犀首","start_index":87,"tongjian_id":"8c49c1f5-db0e-11ef-95ad-a0d3651f611f"},{"people_name":"張儀","people_name_jianti_auto":"张仪","start_index":98,"tongjian_id":"8c49c1f6-db0e-11ef-afcc-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":0,"tongjian_id":"8c49c1f7-db0e-11ef-948a-a0d3651f611f"},{"place_name":"晉國","place_name_jianti_auto":"晋国","start_index":44,"tongjian_id":"8c49c1f8-db0e-11ef-af14-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":85,"tongjian_id":"8c49c1f9-db0e-11ef-a731-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":92,"tongjian_id":"8c49c1fa-db0e-11ef-a49e-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":95,"tongjian_id":"8c49c1fb-db0e-11ef-95da-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":103,"tongjian_id":"8c49c1fc-db0e-11ef-bea4-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":126,"tongjian_id":"8c49c1fd-db0e-11ef-a7c6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉六卿，智氏、范氏、中行氏、趙氏、韓氏、魏氏也。自晉文、襄以來，迭秉國政，後皆強大，卒分晉國。齊簡公使闞止爲政，陳成子憚之；已而陳常殺闞止，弒簡公。闞，以邑爲氏。蘇代曰：魏相犀首，必右韓而左魏；相張儀，必右秦而左魏。蓋二相外各倚與國以爲重而內爭權，所以魏日削也。闞，戶監翻。行，戶剛翻。恆，戶登翻。卒，子恤翻。相，息亮翻。","note_content_jianti_auto":"晋六卿，智氏、范氏、中行氏、赵氏、韩氏、魏氏也。自晋文、襄以来，迭秉国政，后皆强大，卒分晋国。齐简公使阚止为政，陈成子惮之；已而陈常杀阚止，弑简公。阚，以邑为氏。苏代曰：魏相犀首，必右韩而左魏；相张仪，必右秦而左魏。盖二相外各倚与国以为重而内争权，所以魏日削也。阚，户监翻。行，户刚翻。恒，户登翻。卒，子恤翻。相，息亮翻。","note_type":"hu_note","start_index":64,"tongjian_id":"8c4774a6-db0e-11ef-9826-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":55,"tongjian_id":"8c49c206-db0e-11ef-9396-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"[吕氏曰：秦孝公用商鞅，取河西地。其尽得河西，则犀首张仪...","context_before":"...年，魏纳上郡十五县[今延安以北地]，而河西之地尽入于秦。","source_end_index":425,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":396,"source_text":"《战国策》：摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"5韓宣惠王欲兩用公仲、公叔爲政，問於繆留。對曰：「不可，晉用六卿而國分；齊簡公用陳成子及闞止而見殺；魏用犀首、張儀而西河之外亡。今君兩用之，其多力者內樹黨，其寡力者藉外權。羣臣有內樹黨以驕主，有外爲交以削地，君之國危矣。」","content_fanyi":"韩宣惠王想同时任用公仲和公叔两人执掌国政，便向缪留询问。缪留回答说：“不可以，晋国任用六卿，国家因而分裂；齐简公任用陈成子和阚止，自身因而被杀；魏国任用犀首、张仪，西河以外的土地因而丧失。如今您要同时任用这两人，他们中力量强的一方便会在国内树立党羽，力量弱的一方便会向外借助他国权势。群臣中有的在国内树立党羽以欺凌君主，有的对外结交以削减国土，您的国家就危险了。”","content_jianti_auto":"5韩宣惠王欲两用公仲、公叔为政，问于缪留。对曰：「不可，晋用六卿而国分；齐简公用陈成子及阚止而见杀；魏用犀首、张仪而西河之外亡。今君两用之，其多力者内树党，其寡力者藉外权。群臣有内树党以骄主，有外为交以削地，君之国危矣。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":223,"number":5,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十八年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"8c4774a4-db0e-11ef-a485-a0d3651f611f","year_int":-321},"tongjian_id":"8c4774a4-db0e-11ef-a485-a0d3651f611f"},"paragraph_order":7}],"page_size":7,"total_pages":4,"total_paragraphs":25},"profile":{"alias_list":["張儀"],"biography":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","birth_year":-373,"death_year":-310,"link_td_id":"Q10002172","name":"张仪","number_id":133753},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"同门师兄弟，来源文本：苏秦与张仪同出自鬼谷子门下，跟随鬼谷子学习纵横之术。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10001054","source_person_name":"苏秦","source_person_number_id":133739,"statement_id":"S-Q10001054-P100061-Q10002172","target_person_id":"Q10002172","target_person_name":"张仪","target_person_number_id":133753},{"direction":"reverse","rank":"normal","relation_detail":"师徒关系，来源文本：弟子有苏秦、张仪等人。","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10001648","source_person_name":"鬼谷子","source_person_number_id":71648,"statement_id":"S-Q10001648-P100061-Q10002172","target_person_id":"Q10002172","target_person_name":"张仪","target_person_number_id":133753},{"direction":"reverse","rank":"normal","relation_detail":"同朝为官，存在政治接替关系，来源文本：秦武王驱逐张仪、魏章后，任命战功卓著的叔父樗里子为右丞相","relation_property_id":"P100061","relation_property_label":"其他关系","source_person_id":"Q10002142","source_person_name":"樗里子","source_person_number_id":109473,"statement_id":"S-Q10002142-P100061-Q10002172","target_person_id":"Q10002172","target_person_name":"张仪","target_person_number_id":13