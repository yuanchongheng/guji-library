f-af0e-a0d3651f611f"},{"place_name":"丹","place_name_jianti_auto":"丹","start_index":46,"tongjian_id":"8c438072-db0e-11ef-b55f-a0d3651f611f"},{"place_name":"延","place_name_jianti_auto":"延","start_index":48,"tongjian_id":"8c438073-db0e-11ef-b4a4-a0d3651f611f"},{"place_name":"固陽","place_name_jianti_auto":"固阳","start_index":54,"tongjian_id":"8c438074-db0e-11ef-b988-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":58,"tongjian_id":"8c438075-db0e-11ef-a12f-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":62,"tongjian_id":"8c438076-db0e-11ef-82cc-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":67,"tongjian_id":"8c438077-db0e-11ef-9ede-a0d3651f611f"},{"place_name":"華州","place_name_jianti_auto":"华州","start_index":70,"tongjian_id":"8c438078-db0e-11ef-a628-a0d3651f611f"},{"place_name":"鄭縣","place_name_jianti_auto":"郑县","start_index":72,"tongjian_id":"8c438079-db0e-11ef-b5c7-a0d3651f611f"},{"place_name":"洛","place_name_jianti_auto":"洛","start_index":75,"tongjian_id":"8c43807a-db0e-11ef-abff-a0d3651f611f"},{"place_name":"慶州","place_name_jianti_auto":"庆州","start_index":77,"tongjian_id":"8c43807b-db0e-11ef-b2eb-a0d3651f611f"},{"place_name":"洛源縣","place_name_jianti_auto":"洛源县","start_index":79,"tongjian_id":"8c43807c-db0e-11ef-b4b7-a0d3651f611f"},{"place_name":"勝州","place_name_jianti_auto":"胜州","start_index":90,"tongjian_id":"8c43807d-db0e-11ef-a7dd-a0d3651f611f"},{"place_name":"固陽","place_name_jianti_auto":"固阳","start_index":92,"tongjian_id":"8c43807e-db0e-11ef-a8ee-a0d3651f611f"},{"place_name":"河西","place_name_jianti_auto":"河西","start_index":97,"tongjian_id":"8c43807f-db0e-11ef-8b3e-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":99,"tongjian_id":"8c438080-db0e-11ef-9a44-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":107,"tongjian_id":"8c438081-db0e-11ef-b1c0-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":109,"tongjian_id":"8c438082-db0e-11ef-b063-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":112,"tongjian_id":"8c438083-db0e-11ef-a7e8-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":116,"tongjian_id":"8c438084-db0e-11ef-bf57-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":119,"tongjian_id":"8c438085-db0e-11ef-b480-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":128,"tongjian_id":"8c438086-db0e-11ef-bd40-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說，式芮翻。括地志曰：上郡故城在綏州上縣東南五十里，魏、秦之上郡地也。史記正義曰：按鄜、坊、丹、延等州，北至固陽，盡上郡地。魏築長城界秦，自華州鄭縣濱洛至慶州洛源縣自於山，卽東北至勝州固陽，東至河西上郡之地，盡入於秦。秦之與魏者小，魏之謝秦者大，史言張儀爲秦計者甚巧。","note_content_jianti_auto":"说，式芮翻。括地志曰：上郡故城在绥州上县东南五十里，魏、秦之上郡地也。史记正义曰：按鄜、坊、丹、延等州，北至固阳，尽上郡地。魏筑长城界秦，自华州郑县滨洛至庆州洛源县自于山，即东北至胜州固阳，东至河西上郡之地，尽入于秦。秦之与魏者小，魏之谢秦者大，史言张仪为秦计者甚巧。","note_type":"hu_note","start_index":80,"tongjian_id":"8c438069-db0e-11ef-b745-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"秦王","official_note":"秦王是秦国的君主，在《资治通鉴》中常指秦国的国王，此处张仪向秦王进言，反映了秦国的决策过程。","official_rank":"未知","source_snippet":"張儀言於秦王","start_index":18,"tongjian_id":"6c0ec0c8-e352-47d3-8110-a1f4984f586a"},{"confidence":0.9,"official_category":"地方行政","official_name":"魏王","official_note":"魏王是魏国的君主，在《资治通鉴》中常指魏国的国王，此处张仪游说魏王，体现了外交互动。","official_rank":"未知","source_snippet":"儀因說魏王曰","start_index":48,"tongjian_id":"1b90bbce-171a-4c2c-9229-01eff8ada9e4"},{"confidence":0.85,"official_category":"中枢机构","official_name":"相秦","official_note":"相秦指担任秦国的相国，是高级官职，负责辅佐君主处理政务，此处表示张仪回国后被任命为秦相。","official_rank":"未知","source_snippet":"張儀歸而相秦","start_index":78,"tongjian_id":"0aea9189-9b78-4c4a-a6d2-083c2fa138da"}],"ExtRef_Children_people":[{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":6,"tongjian_id":"8c43808b-db0e-11ef-9506-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","start_index":18,"tongjian_id":"8c43808f-db0e-11ef-b45f-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"儀","people_name_jianti_auto":"仪","people_xingming":"张仪","start_index":42,"tongjian_id":"8c438095-db0e-11ef-864a-a0d3651f611f"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":80,"tongjian_id":"8c43809d-db0e-11ef-94c5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"方孝公商鞅时，并小乡为大县，县一令，尚未有郡牧守称[《秦...","context_before":"...众，所谓上大夫受县，下大夫受郡是也。战国之时，县属于郡。","source_end_index":117,"source_paragraph_tongjian_id":"6228835c-9f0b-5352-b8eb-1e2574c01ed5","source_start_index":97,"source_text":"《秦纪》惠文十一年，魏纳上郡十五县是也。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"又景湣王五年，秦败我蒲阳。《秦纪》：惠王十年，使公子华、...","context_before":"...《括地志》：蒲邑故城，在隰川县南，蒲水经其南，亦曰蒲阳。","source_end_index":102,"source_paragraph_tongjian_id":"2f222536-669c-5a9e-8746-d315ed108393","source_start_index":82,"source_text":"《史记·魏世家》：襄王七年，秦降我蒲阳。"},{"context_after":"《通释》：蒲阳故城，在隰川县北四十五里蒲水之北，即重耳所...","context_before":"...世家》：襄王七年，秦降我蒲阳。又景湣王五年，秦败我蒲阳。","source_end_index":139,"source_paragraph_tongjian_id":"2f222536-669c-5a9e-8746-d315ed108393","source_start_index":115,"source_text":"《秦纪》：惠王十年，使公子华、张仪围魏蒲，取之。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"《战国策》：摎留谓韩王，魏两用犀首张仪，而西河之外亡。是...","context_before":"...西地[孔氏曰：同、丹二州之地也。丹州，今延安府宜川县]。","source_end_index":396,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":367,"source_text":"十年，魏纳上郡十五县[今延安以北地]，而河西之地尽入于秦。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、延安府（卷五十七）","excerpts":[{"context_after":"汉逐匈奴，开朔方，恒自上郡而北。盖其地外控彊索，内藩畿辅...","context_before":"府东带黄河，北控灵夏，为形胜之地。","source_end_index":116,"source_paragraph_tongjian_id":"c832f8b8-c214-5f81-89f1-54f62e022106","source_start_index":17,"source_text":"战国时，魏人入上郡于秦，而秦益强[《史记》：梁襄王七年，魏尽入上郡于秦。《正义》：丹、坊、鄜、延北至圁阴，魏上郡地也。秦惠文君六年，魏纳阴晋，八年纳河西地，十年又纳上郡十五县，而河西滨河之地尽矣]。"}],"path":"陕西方舆纪要/五、延安府（卷五十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1秦公子華、張儀帥師圍魏蒲陽，取之。張儀言於秦王，請以蒲陽復與魏，而使公子繇質於魏。儀因說魏王曰：「秦之遇魏甚厚，魏不可以無禮於秦。」魏因盡入上郡十五縣以謝焉。張儀歸而相秦。","content_fanyi":"秦国公子嬴华和张仪率领军队包围魏国的蒲阳邑，夺取了蒲阳。张仪向秦王进言，请求把蒲阳再归还给魏国，并派秦公子繇到魏国去做人质。张仪趁机游说魏王说：“秦国这样厚待魏国，魏国不可以对秦国失礼。”魏国于是只好把上郡十五个县全部献给秦国以作答谢。张仪回到秦国后，被任命为秦国的国相。","content_jianti_auto":"1秦公子华、张仪帅师围魏蒲阳，取之。张仪言于秦王，请以蒲阳复与魏，而使公子繇质于魏。仪因说魏王曰：「秦之遇魏甚厚，魏不可以无礼于秦。」魏因尽入上郡十五县以谢焉。张仪归而相秦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":204,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十一年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c438061-db0e-11ef-b1a0-a0d3651f611f","year_int":-328},"tongjian_id":"8c438061-db0e-11ef-b1a0-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annot