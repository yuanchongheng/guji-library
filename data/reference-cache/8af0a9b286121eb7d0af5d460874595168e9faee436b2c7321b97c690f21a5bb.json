jian_id":"9487227a-db0e-11ef-8f80-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":60,"tongjian_id":"9487227b-db0e-11ef-9a6d-a0d3651f611f"},{"place_name":"日南郡","place_name_jianti_auto":"日南郡","start_index":61,"tongjian_id":"9487227c-db0e-11ef-bcdc-a0d3651f611f"},{"place_name":"朱吾縣","place_name_jianti_auto":"朱吾县","start_index":66,"tongjian_id":"9487227d-db0e-11ef-a137-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志：日南郡，秦象郡地，在雒陽南萬三千四百里。賢曰：俚，蠻之別號，今呼爲俚人。宋白曰：愛州，漢九眞郡，治胥浦縣。驩州，漢日南郡，治朱吾縣。","note_content_jianti_auto":"郡国志：日南郡，秦象郡地，在雒阳南万三千四百里。贤曰：俚，蛮之别号，今呼为俚人。宋白曰：爱州，汉九真郡，治胥浦县。驩州，汉日南郡，治朱吾县。","note_type":"hu_note","start_index":29,"tongjian_id":"9485b17e-db0e-11ef-bf2a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"交趾刺史","official_note":"交趾刺史是东汉时期交趾郡（今越南北部）的地方行政长官，负责监察和管理该地区。在上下文中，交趾刺史面对徵侧、徵贰的反叛，只能勉强自守，反映了地方官员在叛乱中的困境。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"交趾刺史及諸太守僅得自守","start_index":45,"tongjian_id":"3ae44a27-5e7a-4e9b-9c3c-237c147d89d6"},{"confidence":0.9,"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡级行政区的最高长官，负责治理地方。在上下文中，诸太守与交趾刺史一同面对叛乱，仅能自守，突出了地方行政官员在军事危机中的无力。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"交趾刺史及諸太守僅得自守","start_index":50,"tongjian_id":"6c90c55e-1b3a-4958-9747-2cc6e9679503"}],"ExtRef_Children_people":[{"people_name":"徵側","people_name_jianti_auto":"征侧","people_xingming":"征侧","start_index":6,"tongjian_id":"9487227f-db0e-11ef-9802-a0d3651f611f"},{"people_name":"徵貳","people_name_jianti_auto":"征贰","people_xingming":"征贰","start_index":11,"tongjian_id":"94872280-db0e-11ef-b8e2-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9485b17d-db0e-11ef-aadd-a0d3651f611f","pinyin":"mí","source_anchor_text":"立為王都麊泠交趾刺","source_key":"baiyang_epub","start_index":42,"text":"麊","tongjian_id":"0ca27f3a-494c-5fc4-8ba2-5c8037fd59d1"}],"ExtRef_Children_places":[{"place_name":"九眞","place_name_jianti_auto":"九真","resolved_place_entity_id":1017,"start_index":15,"tongjian_id":"94872281-db0e-11ef-b0dc-a0d3651f611f"},{"place_name":"日南","place_name_jianti_auto":"日南","resolved_place_entity_id":1279,"start_index":18,"tongjian_id":"94872282-db0e-11ef-9873-a0d3651f611f"},{"place_name":"合浦","place_name_jianti_auto":"合浦","resolved_place_entity_id":1375,"start_index":21,"tongjian_id":"94872283-db0e-11ef-818e-a0d3651f611f"},{"place_name":"麊泠","place_name_jianti_auto":"麊泠","resolved_place_entity_id":10020,"start_index":42,"tongjian_id":"94872284-db0e-11ef-90a8-a0d3651f611f"},{"place_name":"交趾","place_name_jianti_auto":"交趾","resolved_place_entity_id":579,"start_index":45,"tongjian_id":"94872285-db0e-11ef-9d84-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"马援征岭南之战","tongjian_id":"war_N0612"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二十五、安南（卷一百十二）","excerpts":[{"context_after":"孙吴时，增置新昌、武平、九德三郡。晋因之。宋增置宋平、宋...","context_before":"...元鼎五年，平南越，置交趾、九真、日南等郡，兼置交州刺史。","source_end_index":224,"source_paragraph_tongjian_id":"88ed3a42-4d83-5125-913d-1fb533719285","source_start_index":199,"source_text":"后汉建武十六年，交趾女子征侧、征贰反，马援讨平之。"},{"context_after":"《广州记》：交趾有骆田，仰潮水上下，人食其田，名为骆侯。...","context_before":"...之，因曰雒民。《交州志》：雒王、雒侯主诸郡县，县有雒将。","source_end_index":197,"source_paragraph_tongjian_id":"34ff104e-b28e-5ba0-a19e-8632018fdd9c","source_start_index":160,"source_text":"后汉建武十五年，交趾牴泠雒将女子征侧、征贰反，九真、日南、合浦蛮俚皆应之。"},{"context_after":"三国吴属新兴郡，后属新昌郡。梁、陈间，废县入嘉宁]。","context_before":"...泠城[在府西。汉县，属交趾郡。牴泠，读曰麋零。后汉因之。","source_end_index":63,"source_paragraph_tongjian_id":"1b837bd1-e126-586e-b144-f4cee54a86df","source_start_index":29,"source_text":"建武中，交趾女子征侧、征贰反，掠六十五城，都牴泠，马援讨平之，是也。"}],"path":"广西方舆纪要/二十五、安南（卷一百十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1春，二月，徵側與其妹徵貳反，九眞、日南、合浦蠻俚皆應之，凡略六十五城，自立爲王，都麊泠。交趾刺史及諸太守僅得自守。","content_fanyi":"春季，二月，徵侧和她的妹妹徵贰起兵反叛，九真、日南、合浦三郡的蛮夷俚民都起兵响应，共攻占六十五座城池，徵侧自立为王，建都麊泠县。交趾郡刺史和各郡太守无力征讨，只能勉强自保。","content_jianti_auto":"1春，二月，征侧与其妹征贰反，九真、日南、合浦蛮俚皆应之，凡略六十五城，自立为王，都麊泠。交趾刺史及诸太守仅得自守。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3359,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9485b17d-db0e-11ef-aadd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2三月，辛丑晦，日有食之。","content_fanyi":"三月三十日辛丑晦，发生日食。","content_jianti_auto":"2三月，辛丑晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3360,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"94872286-db0e-11ef-aa4a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":0,"tongjian_id":"94872289-db0e-11ef-b381-a0d3651f611f"},{"people_name":"平帝","people_name_jianti_auto":"平帝","start_index":13,"tongjian_id":"9487228a-db0e-11ef-88e3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武帝置期門郞，掌執兵送從；平帝元始元年，更名虎賁郞，置中郞將。漢儀：虎賁騎，鶡冠、虎文單衣。度，徒洛翻。從，千容翻。賁，章奔。","note_content_jianti_auto":"武帝置期门郞，掌执兵送从；平帝元始元年，更名虎贲郞，置中郞将。汉仪：虎贲骑，鹖冠、虎文单衣。度，徒洛翻。从，千容翻。贲，章奔。","note_type":"hu_note","start_index":43,"tongjian_id":"94872288-db0e-11ef-8354-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"河南尹","official_note":"河南尹是东汉时期管理河南郡的地方行政长官，相当于郡守，负责地方治理。在上下文中，河南尹张伋因度田不实被下狱处死，反映了当时对地方官员的严格监督。","official_rank":"未知","source_snippet":"河南尹張伋","start_index":4,"tongjian_id":"2e4c0d2d-74a6-4e75-a00e-1c30658f9a93"},{"confidence":0.9,"official_category":"地方行政","official_name":"郡守","official_note":"郡守是汉代地方行政长官，负责管理一郡的政务。在上下文中，郡守们因度田不实被处死，显示了光武帝对地方治理的重视和严惩不实行为。","official_rank":"未知","source_snippet":"諸郡守十餘人","start_index":10,"tongjian_id":"7ab19d7e-d003-4c49-980d-f8360c08587d"},{"confidence":0.85,"official_category":"军事指挥","official_name":"虎賁中郞將","official_note":"虎賁中郞将是汉代禁卫军的高级军官，负责宫廷护卫。在上下文中，马援担任此职，与光武帝对话，讨论之前处死守、相官员的事宜。","official_rank":"未知","source_snippet":"虎賁中郞將馬援","start_index":38,"tongjian_id":"ef70cbb8-8f28-4828-b9d5-944874464000"},{"confidence":0.8,"official_category":"地方行政","official_name":"守","official_note":"守是汉代地方行政长官的简称，通常指郡守或太守，负责地方治理。在上下文中，光武帝提到之前杀了很多守、相官员，表达了对过度惩罚的悔恨。","official_rank":"未知","source_snippet":"前殺守、相多也","start_index":52,"tongjian_id":"7520221b-6d01-4f04-bd13-2abeb4575ce8"},{"confidence":0.8,"official_category":"地方行政","official_name":"相","official_note":"相在汉代通常指诸侯国的相国或地方行政长官，负责辅佐诸侯或管理地方。在上下文中，与守一起被提及，表示被处死的官员包括地方行政长官。","official_rank":"未知","source_snippet":"前殺守、相多也","start_index":54,"tongjian_id":"ae24401f-c156-4f6d-872c-b5b769a2b3a2"}],"ExtRef_Children_people":[{"people_name":"張伋","people_name_jianti_auto":"张伋","people_xingming":"张伋","start_index":9,"tongjian_id":"9487228e-db0e-11ef-9916-a0d3651f611f"},{"link_birth_year":-14,"link_death_year":49,"link_td_description":"马援，字文渊，扶风郡茂陵（今陕西省兴平市东北）人，东汉军事家。汉光武帝时，拜为伏波将军，封新息侯，世称马伏波。","link_td_id":"Q10000488","link_td_number_id":135961,"people_name":"馬援","people_name_jianti_auto":"马援","people_xingming":"马援","start_index":39,"tongjian_id":"9487228f-db0e-11ef-841f-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河南","place_name_jianti_auto":"河南","resolved_place_entity_id":10172,"start_index":6,"tongjian_id":"94872290-db0e-11ef-8adc-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"3秋，九月，河南尹張伋及諸郡守十餘人皆坐度田不實，下獄死。後上從容謂虎賁中郞將馬援曰：「吾甚恨前殺守、相多也！」對曰：「死得其罪，何多之有！但死者旣往，不可復生也！」上大笑。","content_fanyi":"秋季，九月，河南尹张伋及其他各郡太守十余人，都因丈量土地不实获罪，被关进监狱而死。后来，光武帝私下用平和的语气对虎贲中郎将马援说：“我非常后悔前些时杀了太多太守和国相啊！”马援回答说：“他们因罪而死，死得不冤，怎么能算多呢！只是死去的人已经成为过去，不能再活过来了！”光武帝听了大笑。","content_jianti_auto":"3秋，九月，河南尹张伋及诸郡守十余人皆坐度田不实，下狱死。后上从容谓虎贲中郞将马援曰：「吾甚恨前杀守、相多也！」对曰：「死得其罪，何多之有！但死者既往，不可复生也！」上大笑。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3361,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"94872287-db0e-11ef-bc61-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94872296-db0e-11ef-8e30-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：委守，謂棄其所守也。負，罪負也。愞，而戀翻，又奴亂翻。","note_content_jianti_auto":"贤曰：委守，谓弃其所守也。负，罪负也。愞，而恋翻，又奴乱翻。","note_type":"hu_note","start_index":123,"tongjian_id":"94872295-db0e-11ef-86da-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"稟，給也。帥，所類翻。","note_content_jianti_auto":"禀，给也。帅，所类翻。","note_type":"hu_note","start_index":166,"tongjian_id":"94872299-db0e-11ef-8fb4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"牧守","official_note":"牧守是漢代地方行政長官，如州牧或郡守，負責治理地方和維護治安。在上下文中，指責地方官員因境內有盜賊而不逮捕，反映其職責包括捕盜和維護秩序。","official_rank":"未知","source_snippet":"其牧守令長坐界內有盜賊而不收捕者","start_index":108,"tongjian_id":"e69b2c12-a0e4-4221-876a-bf7ae31ed59e"},{"confidence":0.9,"official_category":"地方行政","official_name":"令長","official_note":"令長是漢代縣級行政長官，如縣令或縣長，負責管理縣政和治安。在上下文中，與牧守並列，強調地方官員對盜賊問題的責任。","official_rank":"未知","source_snippet":"其牧守令長坐界內有盜賊而不收捕者","start_index":110,"tongjian_id":"3d093ab1-a119-4a4a-ad40-5514afdd2f83"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94872291-db0e-11ef-8dd9-a0d3651f611f","pinyin":"tī","source_anchor_text":"盜自相糾擿五人共斬","source_key":"baiyang_epub","start_index":55,"text":"擿","tongjian_id":"dcba8078-f4dc-5365-b311-ba0fea061282"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"94872291-db0e-11ef-8dd9-a0d3651f611f","pinyin":"nuò","source_anchor_text":"者又以畏愞捐城委守","source_key":"baiyang_epub","start_index":110,"text":"愞","tongjian_id":"3f814ab6-770b-5754-b815-6bde25f4737e"}],"ExtRef_Children_places":[{"place_name":"青","place_name_jianti_auto":"青","resolved_place_entity_id":242,"start_index":25,"tongjian_id":"9487b150-db0e-11ef-976d-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","resolved_place_entity_id":191,"start_index":27,"tongjian_id":"9487b151-db0e-11ef-b2d4-a0d3651f611f"},{"place_name":"幽","place_name_jianti_auto":"幽","resolved_place_entity_id":102,"start_index":29,"tongjian_id":"9487b152-db0e-11ef-b729-a0d3651f611f"},{"place_name":"冀","place_name_jianti_auto":"冀","resolved_place_entity_id":216,"start_index":31,"tongjian_id":"9487b153-db0e-11ef-a92a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/汉二帝治盗","excerpts":[{"context_after":"此二事均为治盗，而武帝之严，不若光武之宽，其效可睹也。","context_before":"...课累府，府亦使不言。故盗贼寖多，上下相为匿，以避文法焉。","source_end_index":264,"source_paragraph_tongjian_id":"f5a930fb-8213-4ec7-9dcf-a7b7f96e0d24","source_start_index":143,"source_text":"光武时，群盗处处并起。遣使者下郡国，听群盗自相纠擿，五人共斩一人者除其罪。吏虽逗留回避故纵者，皆勿问，听以禽讨为效。其牧守令长坐界内有盗贼而不收捕者，及以畏愞捐城委守者，皆不以为负，但取获贼多少为殿最，唯蔽匿者乃罪之。于是更相追捕，贼并解散。"}],"path":"随笔/卷十一/汉二帝治盗","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"4郡國羣盜處處並起，郡縣追討，到則解散，去復屯結，青、徐、幽、冀四州尤甚。冬，十月，遣使者下郡國，聽羣盜自相糾擿，五人共斬一人者，除其罪；吏雖逗留回避故縱者，皆勿問，聽以禽討爲效。其牧守令長坐界內有盜賊而不收捕者，又以畏愞捐城委守者，皆不以爲負，但取獲賊多少爲殿最，唯蔽匿者乃罪之。於是更相追捕，賊並解散，徙其魁帥於他郡，賦田受稟，使安生業。自是牛馬放牧不收，邑門不閉。","content_fanyi":"各郡、国的盗贼到处纷纷兴起，郡、县派兵围剿，征讨军队一到，盗贼便四散离去，军队一离开又重新聚集屯结，青、徐、幽、冀四州尤其严重。冬季十月，光武帝派遣使者到各郡、国颁布文告，听任盗贼互相检举告发，五个人共同斩杀一个人，就免除这五个人的罪；官吏中即使有滞留不进、回避盗贼或故意放纵盗贼的，也一律不予追究，只准许他们以当前擒拿、讨伐盗贼的功绩作为效力。各州牧、郡守、县令、长吏，凡因辖区内有盗贼而不加收捕，或因胆小怯懦而抛弃城池、放弃职守的，都不予判罪，只以当前捕获盗贼的多少考核政绩优劣，只有包庇藏匿盗贼的人才予治罪。于是盗贼互相攻击，官府又全力追捕，成群盗贼全都解散，又将他们的首领迁往其他郡县，授给田地、供给粮食，使他们安心生产。从此以后，放牧的牛马晚上不必赶回，村落的大门也可以不必关闭。","content_jianti_auto":"4郡国群盗处处并起，郡县追讨，到则解散，去复屯结，青、徐、幽、冀四州尤甚。冬，十月，遣使者下郡国，听群盗自相纠擿，五人共斩一人者，除其罪；吏虽逗留回避故纵者，皆勿问，听以禽讨为效。其牧守令长坐界内有盗贼而不收捕者，又以畏愞捐城委守者，皆不以为负，但取获贼多少为殿最，唯蔽匿者乃罪之。于是更相追捕，贼并解散，徙其魁帅于他郡，赋田受禀，使安生业。自是牛马放牧不收，邑门不闭。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3362,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"94872291-db0e-11ef-8dd9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"朝，直遙翻；下同。","note_content_jianti_auto":"朝，直遥翻；下同。","note_type":"hu_note","start_index":57,"tongjian_id":"9487e2b1-db0e-11ef-8e23-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"代王","official_note":"代王是漢代分封的王爵，通常授予皇室成員或功臣，掌管代地（今河北、山西一帶）的行政和軍事事務。在《資治通鑑》此段中，盧芳被立爲代王，表示他被任命爲代地的統治者，以安撫邊疆和處理與匈奴的關係。","official_rank":"王爵","source_snippet":"立芳爲代王","start_index":12,"tongjian_id":"a5939844-4ffc-4f0d-94cd-cfc8b6237dd9"},{"confidence":0.9,"official_category":"地方行政","official_name":"代相","official_note":"代相是代王國的丞相，負責輔佐代王處理政務，是地方行政中的重要職位。在《資治通鑑》此段中，閔堪被任命爲代相，協助盧芳管理代地，以加強對邊疆的控制。","official_rank":"高級官員","source_snippet":"堪爲代相","start_index":18,"tongjian_id":"2a3f9185-8d90-41e4-b321-e1ad5673d8b8"}],"ExtRef_Children_people":[{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"盧芳","people_name_jianti_auto":"卢芳","people_xingming":"卢芳","start_index":1,"tongjian_id":"9487e2b2-db0e-11ef-a687-a0d3651f611f"},{"people_name":"閔堪","people_name_jianti_auto":"闵堪","people_xingming":"闵堪","start_index":4,"tongjian_id":"9487e2b3-db0e-11ef-9492-a0d3651f611f"},{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"芳","people_name_jianti_auto":"芳","people_xingming":"卢芳","start_index":13,"tongjian_id":"9487e2b4-db0e-11ef-a64a-a0d3651f611f"},{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"代王","people_name_jianti_auto":"代王","people_xingming":"卢芳","start_index":15,"tongjian_id":"9487e2b5-db0e-11ef-bd78-a0d3651f611f"},{"people_name":"堪","people_name_jianti_auto":"堪","people_xingming":"闵堪","start_index":18,"tongjian_id":"9487e2b6-db0e-11ef-b38e-a0d3651f611f"},{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"芳","people_name_jianti_auto":"芳","people_xingming":"卢芳","start_index":36,"tongjian_id":"9487e2b8-db0e-11ef-b583-a0d3651f611f"},{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"芳","people_name_jianti_auto":"芳","people_xingming":"卢芳","start_index":50,"tongjian_id":"9487e2b9-db0e-11ef-b3fd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"代","place_name_jianti_auto":"代","resolved_place_entity_id":240,"start_index":20,"tongjian_id":"9487e2b7-db0e-11ef-a291-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":33,"tongjian_id":"9487e2ba-db0e-11ef-a30f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、两汉 三国（卷二）","excerpts":[{"context_after":"","context_before":"...邑，与吴汉会于成都。述出战，败死。延岑以城降，蜀地悉定。","source_end_index":1833,"source_paragraph_tongjian_id":"f908cd4d-ba0f-5d87-a39e-ef88b491dfe1","source_start_index":1789,"source_text":"卢芳所据诸郡，亦次第来降。芳亡入匈奴，寻复犯塞，既而请降，立为代王，复叛去，竟死匈奴中。"}],"path":"历代州域形势纪要/二、两汉 三国（卷二）","source_name":"读史方舆纪要"}],"class_tags":["外交"],"content":"5盧芳與閔堪使使請降，帝立芳爲代王，堪爲代相，賜繒二萬匹，因使和集匈奴。芳上疏謝，自陳思望闕庭；詔報芳朝明年正月。","content_fanyi":"卢芳与他的大将闵堪派遣使者到洛阳请求投降，光武帝接受后，封卢芳为代王，任命闵堪为代相，赏赐缯绢二万匹，并趁机派卢芳去缓和与匈奴的关系。卢芳上疏谢恩，陈述自己思念朝廷、盼望能亲自入朝；光武帝下诏答复，允许卢芳明年正月进京朝见。","content_jianti_auto":"5卢芳与闵堪使使请降，帝立芳为代王，堪为代相，赐缯二万匹，因使和集匈奴。芳上疏谢，自陈思望阙庭；诏报芳朝明年正月。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3363,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9487e2af-db0e-11ef-97d2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。","note_content_jianti_auto":"复，扶又翻；下同。","note_type":"hu_note","start_index":45,"tongjian_id":"9487e2bc-db0e-11ef-a4c3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"芳","people_name_jianti_auto":"芳","people_xingming":"卢芳","start_index":8,"tongjian_id":"9487e2bd-db0e-11ef-91d0-a0d3651f611f"},{"link_td_description":"卢芳，字君期，安定郡三水县人。新朝末东汉初期群雄之一，曾在北方边境一度称帝。","link_td_id":"Q10003529","link_td_number_id":959313,"people_name":"芳","people_name_jianti_auto":"芳","people_xingming":"卢芳","start_ind