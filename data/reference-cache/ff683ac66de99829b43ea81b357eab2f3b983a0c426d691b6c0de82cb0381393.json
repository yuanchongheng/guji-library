1-a0d3651f611f"},{"place_name":"張掖","place_name_jianti_auto":"张掖","resolved_place_entity_id":543,"start_index":28,"tongjian_id":"967ca26a-db0e-11ef-948e-a0d3651f611f"},{"place_name":"兩河","place_name_jianti_auto":"两河","resolved_place_entity_id":1491,"start_index":39,"tongjian_id":"967ca26b-db0e-11ef-9521-a0d3651f611f"},{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":42,"tongjian_id":"967ca26c-db0e-11ef-98d8-a0d3651f611f"},{"place_name":"湟中","place_name_jianti_auto":"湟中","resolved_place_entity_id":1512,"start_index":70,"tongjian_id":"967ca26e-db0e-11ef-8e00-a0d3651f611f"},{"place_name":"羌","place_name_jianti_auto":"羌","resolved_place_entity_id":140,"start_index":73,"tongjian_id":"967ca26f-db0e-11ef-b38f-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/十三、西宁卫（卷六十四）","excerpts":[{"context_after":"两河间，胡氏曰：逢留大河及赐支河间也]。","context_before":"...年，复叛还赐支河曲，犯金城塞，败于允川，遂远逾赐支河首。","source_end_index":175,"source_paragraph_tongjian_id":"22355560-b102-5231-92ab-3f8d501f31ea","source_start_index":137,"source_text":"永建五年，护羌校尉韩皓展湟中屯田，置两河间以逼群羌。羌惧而图变，乃移还湟中。"}],"path":"陕西方舆纪要/十三、西宁卫（卷六十四）","source_name":"读史方舆纪要"}],"class_tags":["军事","内政"],"content":"5護羌校尉韓皓轉湟中屯田置兩河間，以逼羣羌。皓坐事徵，以張掖太守馬續代爲校尉。兩河間羌以屯田近之，恐必見圖，乃解仇詛盟，各自儆備；續上移田還湟中，羌意乃安。","content_fanyi":"护羌校尉韩皓将湟中的屯田转移安置到赐支河与逢留大河两河之间，以威逼西羌各部落。韩皓因犯法获罪被征召回京都洛阳，朝廷任命张掖郡太守马续接替韩皓为护羌校尉。两河之间的羌人各部落因为屯田地区逼近自己，害怕必定会被图谋和攻击，于是互相解除仇怨、结盟发誓，各自加强戒备；马续上奏朝廷请求把屯田移回湟中，羌人内心这才安定下来。","content_jianti_auto":"5护羌校尉韩皓转湟中屯田置两河间，以逼群羌。皓坐事征，以张掖太守马续代为校尉。两河间羌以屯田近之，恐必见图，乃解仇诅盟，各自儆备；续上移田还湟中，羌意乃安。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4312,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"967ca257-db0e-11ef-8350-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"反对抽签选后，主张以德才为标准遴选","decision_tongjian_id":"DECISION_967CA270DB0E11EFAFF5A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"書四人姓氏於籌，禱之於神而探之，得之爲入選。探，他南翻。","note_content_jianti_auto":"书四人姓氏于筹，祷之于神而探之，得之为入选。探，他南翻。","note_type":"hu_note","start_index":31,"tongjian_id":"967ca271-db0e-11ef-9f36-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"967ca274-db0e-11ef-8ddc-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":23,"tongjian_id":"967ca275-db0e-11ef-8140-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":27,"tongjian_id":"967ca276-db0e-11ef-b1e4-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十六行本「卜」作「任」；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：甲十六行本「卜」作「任」；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"967ca273-db0e-11ef-91ec-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":100,"tongjian_id":"967ca272-db0e-11ef-81df-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"967ca278-db0e-11ef-9f46-a0d3651f611f"},{"people_name":"鄭","people_name_jianti_auto":"郑","start_index":11,"tongjian_id":"967ca279-db0e-11ef-b727-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：詩云：克岐克嶷。鄭註云：岐岐然意有所知，其貌嶷嶷然有所識別也。嶷，魚力翻。","note_content_jianti_auto":"贤曰：诗云：克岐克嶷。郑注云：岐岐然意有所知，其貌嶷嶷然有所识别也。嶷，鱼力翻。","note_type":"hu_note","start_index":126,"tongjian_id":"967ca277-db0e-11ef-a7a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"967ca27d-db0e-11ef-99ed-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":23,"tongjian_id":"967ca27e-db0e-11ef-b536-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":38,"tongjian_id":"967ca27f-db0e-11ef-9c52-a0d3651f611f"},{"people_name":"太姒","people_name_jianti_auto":"太姒","start_index":41,"tongjian_id":"967ca280-db0e-11ef-b1f0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：俔，音苦見翻。說文曰：俔，譬論也。詩云：文王嘉止，大邦有子，俔天之妹。文王聞太姒之賢則美之，言大邦有子女，譬天之有女弟，故求爲配焉。","note_content_jianti_auto":"贤曰：伣，音苦见翻。说文曰：伣，譬论也。诗云：文王嘉止，大邦有子，伣天之妹。文王闻太姒之贤则美之，言大邦有子女，譬天之有女弟，故求为配焉。","note_type":"hu_note","start_index":133,"tongjian_id":"967ca27c-db0e-11ef-9d2b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"尚書僕射","official_note":"尚書僕射是尚書省的副長官，協助尚書令處理政務，在漢代屬於重要中樞官員。此處胡廣擔任此職，與其他官員上疏諫言立后之事，顯示其參與朝廷決策。","official_rank":"正三品","source_snippet":"尚書僕射南郡胡廣","start_index":48,"tongjian_id":"32435303-7d6f-4a0c-8851-aab61eb25d2f"},{"confidence":0.85,"official_category":"中枢机构","official_name":"尚書","official_note":"尚書是尚書省的官員，負責文書處理和政務執行，在漢代為中樞要職。此處郭虔擔任此職，與胡廣等共同上疏，反映其參與諫議。","official_rank":"正三品","source_snippet":"尚書馮翊郭虔","start_index":58,"tongjian_id":"4f0ae9eb-17af-46e0-a573-65c5804b6f7e"}],"ExtRef_Children_people":[{"link_birth_year":91,"link_death_year":172,"link_td_description":"胡广，字伯始，南郡华容（今湖北省监利市）人，东汉中期大臣。","link_td_id":"Q10007243","link_td_number_id":1556737,"people_name":"胡廣","people_name_jianti_auto":"胡广","people_xingming":"胡广","start_index":37,"tongjian_id":"967ca284-db0e-11ef-b207-a0d3651f611f"},{"link_td_description":"郭虔，字君贤，冯翊郡池阳（今陕西省泾阳县西北）人，东汉时期人物。","link_td_id":"Q10007255","link_td_number_id":5352517,"people_name":"郭虔","people_name_jianti_auto":"郭虔","people_xingming":"郭虔","start_index":44,"tongjian_id":"967ca285-db0e-11ef-a4f3-a0d3651f611f"},{"people_name":"史敞","people_name_jianti_auto":"史敞","people_xingming":"史敞","start_index":47,"tongjian_id":"967ca286-db0e-11ef-95a0-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"967ca270-db0e-11ef-aff5-a0d3651f611f","pinyin":"qiàn","source_anchor_text":"形於自然俔天必有異","source_key":"baiyang_epub","start_index":126,"text":"俔","tongjian_id":"be7381d0-c7ea-5da7-b62d-d4776b2af407"}],"ExtRef_Children_places":[{"place_name":"南郡","place_name_jianti_auto":"南郡","resolved_place_entity_id":510,"start_index":35,"tongjian_id":"967ca287-db0e-11ef-aa0f-a0d3651f611f"},{"place_name":"馮翊","place_name_jianti_auto":"冯翊","resolved_place_entity_id":521,"start_index":42,"tongjian_id":"967ca288-db0e-11ef-821c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6帝欲立皇后，而貴人有寵者四人，莫知所建，議欲探籌，以神定選。尚書僕射南郡胡廣與尚書馮翊郭虔、史敞上疏諫曰：「竊見詔書，以立后事大，謙不自專，欲假之籌策，決疑靈神；篇籍所記，祖宗典故，未嘗有也。恃神卜筮，旣未必當賢；就值其人，猶非德選。夫岐嶷形於自然，俔天必有異表，宜參良家，簡求有德，德同以年，年鈞以貌；稽之典經，斷之聖慮。」帝從之。","content_fanyi":"汉顺帝想册立皇后，但受宠的贵人有四位，不知该立哪一位，有人建议抽签，由神灵来确定人选。尚书仆射南郡人胡广与尚书冯翊人郭虔、史敞上疏劝谏说：“臣等见到诏书，陛下认为选立皇后事关重大，谦逊而不愿自己专断，想借助竹筹，由神灵来决断疑惑；然而典籍记载和祖宗典故中，从未有过这样的先例。依靠神灵占卜，最终未必能选中贤者；即使碰巧选中了合适的人，也仍然不是凭德行选拔出来的。聪明才智自然会显露于外表，天资优异的人必定会有不同寻常的仪容，应当让良家女子一起参选，从中挑选有德行的女子；德行相同就比年龄，年龄相同就比容貌；再考据经典，由陛下亲自决断。”顺帝采纳了这个建议。","content_jianti_auto":"6帝欲立皇后，而贵人有宠者四人，莫知所建，议欲探筹，以神定选。尚书仆射南郡胡广与尚书冯翊郭虔、史敞上疏谏曰：「窃见诏书，以立后事大，谦不自专，欲假之筹策，决疑灵神；篇籍所记，祖宗典故，未尝有也。恃神卜筮，既未必当贤；就值其人，犹非德选。夫岐嶷形于自然，伣天必有异表，宜参良家，简求有德，德同以年，年钧以貌；稽之典经，断之圣虑。」帝从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4313,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"967ca270-db0e-11ef-aff5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"恭懷皇后","people_name_jianti_auto":"恭怀皇后","start_index":0,"tongjian_id":"967ca28b-db0e-11ef-a4b6-a0d3651f611f"},{"people_name":"和帝","people_name_jianti_auto":"和帝","start_index":5,"tongjian_id":"967ca28c-db0e-11ef-9949-a0d3651f611f"},{"people_name":"梁貴人","people_name_jianti_auto":"梁贵人","start_index":8,"tongjian_id":"967ca28d-db0e-11ef-98a7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"乘氏縣","place_name_jianti_auto":"乘氏县","start_index":13,"tongjian_id":"967ca28e-db0e-11ef-af09-a0d3651f611f"},{"place_name":"濟陰郡","place_name_jianti_auto":"济阴郡","start_index":18,"tongjian_id":"967ca28f-db0e-11ef-968e-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":22,"tongjian_id":"967ca290-db0e-11ef-ac5c-a0d3651f611f"},{"place_name":"乘丘","place_name_jianti_auto":"乘丘","start_index":25,"tongjian_id":"967ca291-db0e-11ef-8b21-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"恭懷皇后，和帝母梁貴人也。乘氏縣，屬濟陰郡，春秋之乘丘也。乘，繩證翻。","note_content_jianti_auto":"恭怀皇后，和帝母梁贵人也。乘氏县，属济阴郡，春秋之乘丘也。乘，绳证翻。","note_type":"hu_note","start_index":13,"tongjian_id":"967ca28a-db0e-11ef-a18d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言后妃不妬忌，若螽斯，則子孫衆多而百福興矣。","note_content_jianti_auto":"言后妃不妬忌，若螽斯，则子孙众多而百福兴矣。","note_type":"hu_note","start_index":58,"tongjian_id":"967ca293-db0e-11ef-ac09-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":61,"link_death_year":83,"link_td_description":"梁贵人，汉章帝的贵人，褒亲愍侯梁竦的女儿。","link_td_id":"Q10011529","link_td_number_id":1276328,"people_name":"恭懷皇后","people_name_jianti_auto":"恭怀皇后","people_xingming":"梁贵人","start_index":0,"tongjian_id":"967ca294-db0e-11ef-ac81-a0d3651f611f"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"梁商，字伯夏，安定郡乌氏县（今宁夏固原）人，东汉政治人物、外戚，官至大将军。","link_td_id":"Q10007463","link_td_number_id":4553697,"people_name":"乘氏侯","people_name_jianti_auto":"乘氏侯","people_xingming":"梁商","start_index":6,"tongjian_id":"967ca295-db0e-11ef-a6a5-a0d3651f611f"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"梁商，字伯夏，安定郡乌氏县（今宁夏固原）人，东汉政治人物、外戚，官至大将军。","link_td_id":"Q10007463","link_td_number_id":4553697,"people_name":"商","people_name_jianti_auto":"商","people_xingming":"梁商","start_index":9,"tongjian_id":"967ca296-db0e-11ef-a865-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"967ca289-db0e-11ef-a3aa-a0d3651f611f","pinyin":"zhōng","source_anchor_text":"不專為義螽斯則百福","source_key":"baiyang_epub","start_index":48,"text":"螽","tongjian_id":"bef404ea-5ad8-5806-a89c-256635da6ecc"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"恭懷皇后弟子乘氏侯商之女，選入掖庭爲貴人，常特被引御，從容辭曰：「夫陽以博施爲德，陰以不專爲義。螽斯則百福所由興也。願陛下思雲雨之均澤，小妾得免於罪。」帝由是賢之。","content_fanyi":"和帝刘肇的母亲恭怀皇后弟弟的儿子、乘氏侯梁商的女儿，被选入后宫做了顺帝的贵人，经常被特别召去侍奉君主，她从容推辞说：“男子以广泛施予恩惠为德，妇人以不独自专宠为义。《螽斯》诗赞颂螽斯子孙繁衍，百福由此而兴。希望陛下考虑到云雨恩泽均匀布施，使臣妾能够免于罪过。”汉顺帝因此认为她很贤惠。","content_jianti_auto":"恭怀皇后弟子乘氏侯商之女，选入掖庭为贵人，常特被引御，从容辞曰：「夫阳以博施为德，阴以不专为义。螽斯则百福所由兴也。愿陛下思云雨之均泽，小妾得免于罪。」帝由是贤之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4314,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"967ca289-db0e-11ef-a3aa-a0d3651f611f"}],"reign_name":"六年","reign_name_jianti_auto":"六年","start_index":5,"tongjian_id":"967a5807-db0e-11ef-b2e5-a0d3651f611f","year_anno":"（辛未、一三一）","year_int":131},"message":"success","success":true}