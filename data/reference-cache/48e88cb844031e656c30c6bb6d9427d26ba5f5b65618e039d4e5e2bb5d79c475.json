0e-11ef-91d0-a0d3651f611f"},{"place_name":"狼居胥","place_name_jianti_auto":"狼居胥","resolved_place_entity_id":5000,"start_index":48,"tongjian_id":"a87678da-db0e-11ef-854d-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":96,"start_index":72,"tongjian_id":"a87678dc-db0e-11ef-9d7f-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":74,"tongjian_id":"a87678dd-db0e-11ef-b67a-a0d3651f611f"},{"place_name":"岱宗","place_name_jianti_auto":"岱宗","resolved_place_entity_id":306,"start_index":78,"tongjian_id":"a87678de-db0e-11ef-97bd-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"元嘉北伐","tongjian_id":"war_N0738"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、北翟（卷四十五）","excerpts":[{"context_after":"]。","context_before":"...侯之山，济弓卢之水，封狼居胥山，禅于姑衍，登临翰海而还。","source_end_index":142,"source_paragraph_tongjian_id":"f8c78bd6-9f4a-5fd6-802f-b94017258371","source_start_index":98,"source_text":"宋元嘉二十六年，帝欲经略中原，王玄谟每献策，帝曰：观玄谟所陈，令人有封狼居胥意，谓此意也"}],"path":"山西方舆纪要/九、北翟（卷四十五）","source_name":"读史方舆纪要"}],"class_tags":["内政","人事"],"content":"6帝欲經略中原，羣臣爭獻策以迎合取寵。彭城太守王玄謨尤好進言，帝謂侍臣曰：「觀玄謨所陳，令人有封狼居胥意。」御史中丞袁淑言於上曰：「陛下今當席卷趙、魏，檢玉岱宗；臣逢千載之會，願上封禪書。」上悅。淑，耽之曾孫也。","content_fanyi":"宋文帝想要收复中原，群臣争相进献计策来迎合取宠。彭城太守王玄谟尤其喜好进言，宋文帝对侍臣说：“看王玄谟所陈述的内容，使人顿时产生封狼居胥的念头。”御史中丞袁淑对文帝说：“陛下如今正应席卷赵、魏旧地，前往泰山封禅；臣正逢这千载难逢的机会，愿意奉上封禅书。”宋文帝很高兴。袁淑是袁耽的曾孙。","content_jianti_auto":"6帝欲经略中原，群臣争献策以迎合取宠。彭城太守王玄谟尤好进言，帝谓侍臣曰：「观玄谟所陈，令人有封狼居胥意。」御史中丞袁淑言于上曰：「陛下今当席卷赵、魏，检玉岱宗；臣逢千载之会，愿上封禅书。」上悦。淑，耽之曾孙也。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"坐谈而动远略之雄心，不败何待焉？","context_before":"...余岁以下，繇其言论风旨而观之，知其未有不败者也。文帝曰：","source_end_index":74,"source_paragraph_tongjian_id":"d7956ab3-0db1-4d51-88e0-e485613adf2d","source_start_index":57,"source_text":"“观玄谟所陈，令人有封狼居胥意。”"}],"title":"一八 观王玄谟论兵知其必败"}],"id":11654,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"a87678c7-db0e-11ef-ad05-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"沈約","people_name_jianti_auto":"沈约","start_index":0,"tongjian_id":"a87678e4-db0e-11ef-9b74-a0d3651f611f"},{"people_name":"晉孝武","people_name_jianti_auto":"晋孝武","start_index":4,"tongjian_id":"a87678e5-db0e-11ef-b96f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":9,"tongjian_id":"a87678e6-db0e-11ef-9bac-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":12,"tongjian_id":"a87678e7-db0e-11ef-8d87-a0d3651f611f"},{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":25,"tongjian_id":"a87678e8-db0e-11ef-ad63-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":28,"tongjian_id":"a87678e9-db0e-11ef-9739-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":31,"tongjian_id":"a87678ea-db0e-11ef-b8d3-a0d3651f611f"},{"place_name":"新野","place_name_jianti_auto":"新野","start_index":34,"tongjian_id":"a87678eb-db0e-11ef-9c52-a0d3651f611f"},{"place_name":"順陽","place_name_jianti_auto":"顺阳","start_index":37,"tongjian_id":"a87678ec-db0e-11ef-ab3b-a0d3651f611f"},{"place_name":"隨","place_name_jianti_auto":"随","start_index":40,"tongjian_id":"a87678ed-db0e-11ef-b68a-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":44,"tongjian_id":"a87678ee-db0e-11ef-8747-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"沈約曰：晉孝武始於襄陽立雍州，幷立僑郡縣；至是，割荊州之襄陽、南陽、新野、順陽、隨五郡爲雍州，而僑郡縣猶寄寓在諸郡界。","note_content_jianti_auto":"沈约曰：晋孝武始于襄阳立雍州，幷立侨郡县；至是，割荆州之襄阳、南阳、新野、顺阳、随五郡为雍州，而侨郡县犹寄寓在诸郡界。","note_type":"hu_note","start_index":49,"tongjian_id":"a87678e3-db0e-11ef-825a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"雍州刺史","official_note":"雍州刺史是雍州的最高行政长官，负责管理雍州（今陕西、甘肃一带）的军政事务。在《资治通鉴》此段中，广陵王刘诞被任命为雍州刺史，以加强雍州的治理和防御。","official_rank":"州级长官","source_snippet":"以廣陵王誕爲雍州刺史","start_index":12,"tongjian_id":"f7db794e-c404-4fd2-b593-a347ed3bb488"}],"ExtRef_Children_people":[{"link_birth_year":433,"link_death_year":459,"link_td_description":"刘诞，字休文，宋文帝刘义隆第六子，母为殷修华。刘诞官至司空、南兖州刺史，虽在刘劭及刘义宣的两场动乱中坚定支持兄长孝武帝，然仍遭猜忌，最终遭孝武帝诛杀。","link_td_id":"Q10013240","link_td_number_id":1577594,"people_name":"廣陵王","people_name_jianti_auto":"广陵王","people_xingming":"刘诞","start_index":9,"tongjian_id":"a87678ef-db0e-11ef-adf5-a0d3651f611f"},{"link_birth_year":433,"link_death_year":459,"link_td_description":"刘诞，字休文，宋文帝刘义隆第六子，母为殷修华。刘诞官至司空、南兖州刺史，虽在刘劭及刘义宣的两场动乱中坚定支持兄长孝武帝，然仍遭猜忌，最终遭孝武帝诛杀。","link_td_id":"Q10013240","link_td_number_id":1577594,"people_name":"誕","people_name_jianti_auto":"诞","people_xingming":"刘诞","start_index":12,"tongjian_id":"a87678f0-db0e-11ef-9955-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雍州","place_name_jianti_auto":"雍州","resolved_place_entity_id":195,"start_index":14,"tongjian_id":"a87678f1-db0e-11ef-a72e-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","resolved_place_entity_id":229,"start_index":21,"tongjian_id":"a87678f2-db0e-11ef-8bf0-a0d3651f611f"},{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":133,"start_index":25,"tongjian_id":"a87678f3-db0e-11ef-9d66-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":42,"start_index":27,"tongjian_id":"a87678f4-db0e-11ef-ac6e-a0d3651f611f"},{"place_name":"江州","place_name_jianti_auto":"江州","resolved_place_entity_id":63,"start_index":37,"tongjian_id":"a87678f5-db0e-11ef-bc4d-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","resolved_place_entity_id":195,"start_index":46,"tongjian_id":"a87678f6-db0e-11ef-94d6-a0d3651f611f"},{"place_name":"湘州","place_name_jianti_auto":"湘州","resolved_place_entity_id":375,"start_index":49,"tongjian_id":"a87678f7-db0e-11ef-937d-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","resolved_place_entity_id":229,"start_index":58,"tongjian_id":"a87678f8-db0e-11ef-98b9-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"雍州之战","tongjian_id":"war_N0743"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、襄阳府（卷七十九）","excerpts":[{"context_after":"废帝子业末，袁珣谋以襄阳拒命，曰：襄、沔地胜兵强，去江陵...","context_before":"...战，氐秦气丧，赵统得乘其敝，复收襄阳，而上游之藩垣始固。","source_end_index":902,"source_paragraph_tongjian_id":"529fb606-24ed-59ed-82f7-dd65dd9d98fa","source_start_index":801,"source_text":"宋元嘉二十六年，议欲经略中原，以襄阳外接关河，欲广其资力，乃罢江州军府，文武悉配雍州、湘州，入台租税，悉给襄阳，使随王诞镇焉。既而诞遣柳元景等北伐，前据潼关，使东军不至丧败，南国之威，未必不可以复振也。"}],"path":"湖广方舆纪要/八、襄阳府（卷七十九）","source_name":"读史方舆纪要"}],"class_tags":["人事","内政"],"content":"秋，七月，辛未，以廣陵王誕爲雍州刺史。上以襄陽外接關、河，欲廣其資力，乃罷江州軍府，文武悉配雍州；湘州入臺租稅，悉給襄陽。","content_fanyi":"秋季，七月初七日辛未，刘宋朝廷任命广陵王刘诞为雍州刺史。宋文帝认为襄阳在外与函谷关、黄河交界，想要增强雍州的实力，于是撤销江州军府，将该州的文武官员全部配备给雍州；湘州向朝廷交纳的租税，则全部转拨给襄阳。","content_jianti_auto":"秋，七月，辛未，以广陵王诞为雍州刺史。上以襄阳外接关、河，欲广其资力，乃罢江州军府，文武悉配雍州；湘州入台租税，悉给襄阳。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11655,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"a87678e1-db0e-11ef-8273-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"a87678fc-db0e-11ef-9f49-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":28,"tongjian_id":"a87678fd-db0e-11ef-a77c-a0d3651f611f"},{"people_name":"張","people_name_jiant