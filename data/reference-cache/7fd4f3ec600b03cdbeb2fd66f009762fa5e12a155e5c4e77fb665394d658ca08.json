ca\u76e7\u6c34\u7f8c\u3001\u80e1\u842c\u4e8c\u5343\u9a0e\u51fa\u9152\u6cc9\u585e\uff0c\u803f\u79c9\u3001\u79e6\u5f6d\u7387\u6b66\u5a01\u3001\u96b4\u897f\u3001\u5929\u6c34\u52df\u58eb\u53ca\u7f8c\u3001\u80e1\u842c\u9a0e\u51fa\u5f35\u6396\u5c45\u5ef6\u585e\uff0c\u9a0e\u90fd\u5c09\u4f86\u82d7\u3001\u8b77\u70cf\u6853\u6821\u5c09\u6587\u7a46\u5c07\u592a\u539f\u3001\u9d08\u9580\u3001\u4ee3\u90e1\u3001\u4e0a\u8c37\u3001\u6f01\u967d\u3001\u53f3\u5317\u5e73\u3001\u5b9a\u8944\u90e1\u5175\u53ca\u70cf\u6853\u3001\u9bae\u5351\u842c\u4e00\u5343\u9a0e\u51fa\u5e73\u57ce\u585e\uff0c\u4f10\u5317\u5308\u5974\u3002\u7ac7\u56fa\u3001\u803f\u5fe0\u81f3\u5929\u5c71\uff0c\u64ca\u547c\u884d\u738b\uff0c\u65ac\u9996\u5343\u9918\u7d1a\uff1b\u8ffd\u81f3\u84b2\u985e\u6d77\uff0c\u53d6\u4f0a\u543e\u76e7\u5730\uff0c\u7f6e\u5b9c\u79be\u90fd\u5c09\uff0c\u7559\u540f\u58eb\u5c6f\u7530\u4f0a\u543e\u76e7\u57ce\u3002\u803f\u79c9\u3001\u79e6\u5f6d\u64ca\u5308\u6797\u738b\uff0c\u7d55\u5e55\u516d\u767e\u9918\u91cc\uff0c\u81f3\u4e09\u6728\u6a13\u5c71\u800c\u9084\u3002\u4f86\u82d7\u3001\u6587\u7a46\u81f3\u5308\u6cb3\u6c34\u4e0a\uff0c\u865c\u7686\u5954\u8d70\uff0c\u7121\u6240\u7372\u3002\u796d\u809c\u8207\u5357\u5308\u5974\u5de6\u8ce2\u738b\u4fe1\u4e0d\u76f8\u5f97\uff0c\u51fa\u9ad8\u95d5\u585e\u4e5d\u767e\u9918\u91cc\uff0c\u5f97\u5c0f\u5c71\uff0c\u4fe1\u5984\u8a00\u4ee5\u7232\u6dbf\u90aa\u5c71\uff0c\u4e0d\u898b\u865c\u800c\u9084\u3002\u809c\u8207\u5433\u68e0\u5750\u9017\u7559\u754f\u61e6\uff0c\u4e0b\u7344\uff0c\u514d\u3002\u809c\u81ea\u6068\u7121\u529f\uff0c\u51fa\u7344\u6578\u65e5\uff0c\u6b50\u8840\u6b7b\uff1b\u81e8\u7d42\uff0c\u8b02\u5176\u5b50\u66f0\uff1a\u300c\u543e\u8499\u570b\u539a\u6069\uff0c\u5949\u4f7f\u4e0d\u7a31\uff0c\u8eab\u6b7b\u8aa0\u615a\u6068\uff0c\u7fa9\u4e0d\u53ef\u4ee5\u7121\u529f\u53d7\u8cde\u3002\u6b7b\u5f8c\uff0c\u82e5\u6089\u7c3f\u4e0a\u6240\u5f97\u7269\uff0c\u8eab\u81ea\u8a63\u5175\u5c6f\uff0c\u6548\u6b7b\u524d\u884c\uff0c\u4ee5\u526f\u543e\u5fc3\u3002\u300d\u65e3\u5352\uff0c\u5176\u5b50\u9022\u4e0a\u758f\uff0c\u5177\u9673\u907a\u8a00\u3002\u5e1d\u96c5\u91cd\u809c\uff0c\u65b9\u66f4\u4efb\u7528\uff0c\u805e\u4e4b\uff0c\u5927\u9a5a\uff0c\u55df\u5606\u826f\u4e45\u3002\u70cf\u6853\u3001\u9bae\u5351\u6bcf\u671d\u8cc0\u4eac\u5e2b\uff0c\u5e38\u904e\u809c\u51a2\u62dc\u8b01\uff0c\u4ef0\u5929\u865f\u6ce3\uff1b\u907c\u6771\u540f\u6c11\u7232\u7acb\u7960\uff0c\u56db\u6642\u5949\u796d\u7109\u3002\u7ac7\u56fa\u7368\u6709\u529f\uff0c\u52a0\u4f4d\u7279\u9032\u3002","content_fanyi":"\u6625\u5b63\u4e8c\u6708\uff0c\u671d\u5ef7\u6d3e\u9063\u796d\u809c\u4e0e\u5ea6\u8fbd\u5c06\u519b\u5434\u68e0\u7edf\u9886\u6cb3\u4e1c\u3001\u897f\u6cb3\u7684\u7f8c\u4eba\u3001\u80e1\u4eba\u4ee5\u53ca\u5357\u5355\u4e8e\u7684\u9a91\u5175\u5171\u4e00\u4e07\u4e00\u5343\u9a91\uff0c\u4ece\u9ad8\u9619\u585e\u51fa\u585e\uff1b\u7aa6\u56fa\u3001\u803f\u5fe0\u7387\u9886\u9152\u6cc9\u3001\u6566\u714c\u3001\u5f20\u6396\u7684\u7532\u5175\u4ee5\u53ca\u5362\u6c34\u7684\u7f8c\u4eba\u3001\u80e1\u4eba\u5171\u4e00\u4e07\u4e8c\u5343\u9a91\uff0c\u4ece\u9152\u6cc9\u585e\u51fa\u585e\uff1b\u803f\u79c9\u3001\u79e6\u5f6d\u7387\u9886\u6b66\u5a01\u3001\u9647\u897f\u3001\u5929\u6c34\u62db\u52df\u7684\u5175\u58eb\u4ee5\u53ca\u7f8c\u4eba\u3001\u80e1\u4eba\u5171\u4e00\u4e07\u9a91\uff0c\u4ece\u5f20\u6396\u5c45\u5ef6\u585e\u51fa\u585e\uff1b\u9a91\u90fd\u5c09\u6765\u82d7\u3001\u62a4\u4e4c\u6853\u6821\u5c09\u6587\u7a46\u7387\u9886\u592a\u539f\u3001\u96c1\u95e8\u3001\u4ee3\u90e1\u3001\u4e0a\u8c37\u3001\u6e14\u9633\u3001\u53f3\u5317\u5e73\u3001\u5b9a\u8944\u7b49\u90e1\u7684\u519b\u961f\u4ee5\u53ca\u4e4c\u6853\u3001\u9c9c\u5351\u5175\u5171\u4e00\u4e07\u4e00\u5343\u9a91\uff0c\u4ece\u5e73\u57ce\u585e\u51fa\u585e\uff0c\u5f81\u4f10\u5317\u5308\u5974\u3002\u7aa6\u56fa\u3001\u803f\u5fe0\u62b5\u8fbe\u5929\u5c71\uff0c\u653b\u6253\u547c\u884d\u738b\uff0c\u65a9\u83b7\u9996\u7ea7\u4e00\u5343\u4f59\u7ea7\uff1b\u53c8\u8ffd\u5230\u84b2\u7c7b\u6d77\uff0c\u593a\u53d6\u4f0a\u543e\u5362\u5730\u533a\uff0c\u8bbe\u7f6e\u5b9c\u79be\u90fd\u5c09\uff0c\u7559\u4e0b\u540f\u58eb\u5728\u4f0a\u543e\u5362\u57ce\u5c6f\u7530\u3002\u803f\u79c9\u3001\u79e6\u5f6d\u8fdb\u51fb\u5317\u5308\u5974\u7684\u5308\u6797\u738b\uff0c\u7a7f\u8d8a\u6c99\u6f20\u516d\u767e\u4f59\u91cc\uff0c\u62b5\u8fbe\u4e09\u6728\u697c\u5c71\u540e\u8fd4\u56de\u3002\u6765\u82d7\u3001\u6587\u7a46\u5230\u8fbe\u5308\u6cb3\u6c34\u8fb9\uff0c\u654c\u4eba\u5168\u90fd\u9003\u6563\uff0c\u6ca1\u6709\u53d6\u5f97\u6218\u679c\u3002\u796d\u809c\u4e0e\u5357\u5308\u5974\u5de6\u8d24\u738b\u4fe1\u76f8\u4e92\u4e0d\u7766\uff0c\u51fa\u9ad8\u9619\u585e\u4e5d\u767e\u4f59\u91cc\u540e\uff0c\u9047\u5230\u4e00\u5ea7\u5c0f\u5c71\uff0c\u4fe1\u5984\u79f0\u90a3\u5c31\u662f\u6dbf\u90aa\u5c71\uff0c\u6ca1\u6709\u89c1\u5230\u654c\u519b\u800c\u8fd4\u56de\u3002\u796d\u809c\u4e0e\u5434\u68e0\u56e0\u9017\u7559\u754f\u602f\u83b7\u7f6a\uff0c\u88ab\u4e0b\u72f1\uff0c\u514d\u53bb\u5b98\u804c\u3002\u796d\u809c\u81ea\u6068\u6ca1\u6709\u529f\u52b3\uff0c\u51fa\u72f1\u51e0\u5929\u540e\uff0c\u5410\u8840\u800c\u6b7b\uff1b\u4e34\u7ec8\u65f6\uff0c\u4ed6\u5bf9\u513f\u5b50\u8bf4\uff1a\u201c\u6211\u8499\u53d7\u56fd\u5bb6\u539a\u6069\uff0c\u5949\u547d\u5374\u672a\u80fd\u79f0\u804c\uff0c\u8fd9\u6837\u6b7b\u53bb\u5b9e\u5728\u60ed\u6127\u9057\u61be\u3002\u6309\u9053\u4e49\uff0c\u4e0d\u80fd\u6ca1\u6709\u529f\u52b3\u800c\u63a5\u53d7\u8d4f\u8d50\u3002\u6211\u6b7b\u540e\uff0c\u4f60\u8981\u628a\u7c3f\u518c\u4e0a\u8bb0\u8f7d\u7684\u6240\u5f97\u8d4f\u8d50\u5168\u90e8\u5c01\u8fd8\u671d\u5ef7\uff0c\u4eb2\u81ea\u524d\u5f80\u519b\u8425\uff0c\u5728\u9635\u524d\u4ee5\u6b7b\u6548\u529b\uff0c\u6765\u7b26\u5408\u6211\u7684\u5fc3\u610f\u3002\u201d\u796d\u809c\u6b7b\u540e\uff0c\u4ed6\u7684\u513f\u5b50\u796d\u9022\u4e0a\u758f\uff0c\u8be6\u7ec6\u9648\u8ff0\u4e86\u8fd9\u4e9b\u9057\u8a00\u3002\u6c49\u660e\u5e1d\u4e00\u5411\u5668\u91cd\u796d\u809c\uff0c\u6b63\u8981\u518d\u6b21\u8d77\u7528\u4ed6\uff0c\u542c\u5230\u8fd9\u4e2a\u6d88\u606f\u540e\u5927\u4e3a\u9707\u60ca\uff0c\u53f9\u606f\u4e86\u5f88\u4e45\u3002\u4e4c\u6853\u3001\u9c9c\u5351\u6