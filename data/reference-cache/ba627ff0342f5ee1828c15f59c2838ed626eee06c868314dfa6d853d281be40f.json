{"data":{"current_mention_tongjian_id":"8c295d1d-db0e-11ef-bb37-a0d3651f611f","current_paragraph_tongjian_id":"8c295cfb-db0e-11ef-aa7a-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"梁孝王","people_name_jianti_auto":"梁孝王","start_index":7,"tongjian_id":"b34830b8-db0e-11ef-8f82-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蓼隄","place_name_jianti_auto":"蓼隄","place_note":"汴河河堤","start_index":4,"tongjian_id":"b34830b9-db0e-11ef-94b7-a0d3651f611f"},{"place_name":"睢陽","place_name_jianti_auto":"睢阳","start_index":13,"tongjian_id":"b34830ba-db0e-11ef-a1b4-a0d3651f611f"},{"place_name":"睢陽","place_name_jianti_auto":"睢阳","start_index":28,"tongjian_id":"b34830bb-db0e-11ef-b479-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":32,"tongjian_id":"b34830bc-db0e-11ef-ac12-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：蓼隄，梁孝王築，至睢陽三百里。按此，則九域志所謂睢陽，非漢舊城之地。蓼，盧鳥翻；或音六，非。","note_content_jianti_auto":"九域志：蓼隄，梁孝王筑，至睢阳三百里。按此，则九域志所谓睢阳，非汉旧城之地。蓼，卢鸟翻；或音六，非。","note_type":"hu_note","start_index":14,"tongjian_id":"b34830b7-db0e-11ef-8df3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"梁郡","place_name_jianti_auto":"梁郡","start_index":0,"tongjian_id":"b34830c2-db0e-11ef-a0f6-a0d3651f611f"},{"place_name":"睢陽","place_name_jianti_auto":"睢阳","start_index":3,"tongjian_id":"b34830c3-db0e-11ef-93d4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"梁郡治睢陽。","note_content_jianti_auto":"梁郡治睢阳。","note_type":"hu_note","start_index":64,"tongjian_id":"b34830c1-db0e-11ef-9ad5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻；下同。","note_content_jianti_auto":"将，即亮翻；下同。","note_type":"hu_note","start_index":74,"tongjian_id":"b34830c4-db0e-11ef-b796-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"濟陰郡","place_name_jianti_auto":"济阴郡","start_index":4,"tongjian_id":"b34830c6-db0e-11ef-b119-a0d3651f611f"},{"place_name":"成武縣","place_name_jianti_auto":"成武县","start_index":7,"tongjian_id":"b34830c7-db0e-11ef-a57c-a0d3651f611f"},{"place_name":"永昌郡","place_name_jianti_auto":"永昌郡","start_index":13,"tongjian_id":"b34830c8-db0e-11ef-901c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：濟陰郡成武縣，時爲永昌郡。","note_content_jianti_auto":"五代志：济阴郡成武县，时为永昌郡。","note_type":"hu_note","start_index":113,"tongjian_id":"b34830c5-db0e-11ef-a278-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"沛縣","place_name_jianti_auto":"沛县","place_note":"江苏省沛县","start_index":4,"tongjian_id":"b34830cb-db0e-11ef-b085-a0d3651f611f"},{"place_name":"彭城郡","place_name_jianti_auto":"彭城郡","start_index":7,"tongjian_id":"b34830cc-db0e-11ef-86a7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：沛縣屬彭城郡。將，卽亮翻。","note_content_jianti_auto":"五代志：沛县属彭城郡。将，即亮翻。","note_type":"hu_note","start_index":127,"tongjian_id":"b34830ca-db0e-11ef-b32a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":0,"tongjian_id":"b34830cf-db0e-11ef-9f42-a0d3651f611f"},{"place_name":"彭城郡","place_name_jianti_auto":"彭城郡","start_index":3,"tongjian_id":"b34830d0-db0e-11ef-b26d-a0d3651f611f"},{"place_name":"沛縣","place_name_jianti_auto":"沛县","place_note":"江苏省沛县","start_index":7,"tongjian_id":"b34830d1-db0e-11ef-9a37-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徐州，彭城郡，沛縣在州西北一百四十里。","note_content_jianti_auto":"徐州，彭城郡，沛县在州西北一百四十里。","note_type":"hu_note","start_index":132,"tongjian_id":"b34830ce-db0e-11ef-a867-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"金鄕縣","place_name_jianti_auto":"金鄕县","start_index":4,"tongjian_id":"b34830d3-db0e-11ef-97f0-a0d3651f611f"},{"place_name":"曹州","place_name_jianti_auto":"曹州","start_index":8,"tongjian_id":"b34830d4-db0e-11ef-8f61-a0d3651f611f"},{"place_name":"濟陰郡","place_name_jianti_auto":"济阴郡","start_index":10,"tongjian_id":"b34830d5-db0e-11ef-ad53-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：金鄕縣屬曹州濟陰郡。","note_content_jianti_auto":"五代志：金鄕县属曹州济阴郡。","note_type":"hu_note","start_index":139,"tongjian_id":"b34830d2-db0e-11ef-be0e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"簡，分揀也。幟，昌志翻。","note_content_jianti_auto":"简，分拣也。帜，昌志翻。","note_type":"hu_note","start_index":204,"tongjian_id":"b34830d8-db0e-11ef-876d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"薄，迫也。","note_content_jianti_auto":"薄，迫也。","note_type":"hu_note","start_index":289,"tongjian_id":"b34830d9-db0e-11ef-9990-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"洙水","place_name_jianti_auto":"洙水","start_index":0,"tongjian_id":"b34830db-db0e-11ef-a043-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"洙水，詳見辯誤。爲，于僞翻。","note_content_jianti_auto":"洙水，详见辩误。为，于伪翻。","note_type":"hu_note","start_index":314,"tongjian_id":"b34830da-db0e-11ef-b981-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","start_index":0,"tongjian_id":"b34830de-db0e-11ef-8e8d-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":4,"tongjian_id":"b34830df-db0e-11ef-be98-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"京師，謂長安。","note_content_jianti_auto":"京师，谓长安。","note_type":"hu_note","start_index":323,"tongjian_id":"b34830dd-db0e-11ef-88bf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","start_index":4,"tongjian_id":"b34830e1-db0e-11ef-8410-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"亦傳首於長安。","note_content_jianti_auto":"亦传首于长安。","note_type":"hu_note","start_index":330,"tongjian_id":"b34830e0-db0e-11ef-ab75-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"左城•山东省定陶县西","resolved_place_entity_id":815,"start_index":78,"tongjian_id":"b34a7a33-db0e-11ef-8022-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"《水经注》：洙水径瑕丘城，又西南径山阳郡南平阳县之闾丘亭...","context_before":"洙水[在县东北。或曰：泗水自鱼台支流入县境，谓之洙水。","source_end_index":64,"source_paragraph_tongjian_id":"b2ccb884-4faf-52ab-99fd-bf8e3d2fc2f1","source_start_index":27,"source_text":"宇文周末，于仲文击尉迟迥将席毗罗于金乡，毗罗众溃，争投洙水死，水为之不流。"},{"context_after":"隋初，郡罢。开皇十六年，置戴州治焉。大业初，州废，县属济...","context_before":"...郡。晋属济阳郡。刘宋属北济阴郡。后魏因之。后齐置永昌郡。","source_end_index":144,"source_paragraph_tongjian_id":"d3061351-7e97-5f70-a478-176d99b26522","source_start_index":115,"source_text":"后周大象二年，尉迟迥将檀让屯成武，于仲文击破之，遂拔成武。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/六、归德府（卷五十）","excerpts":[{"context_after":"《志》云：府城南六里有南湖，梁孝王园池故址也]。","context_before":"漻堤[在府西北七里。漻，一作蓼。梁孝王所筑。","source_end_index":59,"source_paragraph_tongjian_id":"06e5cd12-8c68-5a8e-9846-c10a1c95a5f0","source_start_index":22,"source_text":"宇文周末，杨坚使于仲文击尉迟迥将檀让于河南，军至漻堤，去梁郡七里，进拔之。"}],"path":"河南方舆纪要/六、归德府（卷五十）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"于仲文軍至蓼隄，去梁郡七里。檀讓擁衆數萬，仲文以羸師挑戰而僞北，讓不設備；仲文還擊，大破之，生獲五千餘人，斬首七百級。進攻梁郡，迥守將劉子寬棄城走。仲文進擊曹州，獲迥所署刺史李仲康。檀讓以餘衆屯成武，仲文襲擊，破之，遂拔成武。迥將席毗羅，衆十萬，屯沛縣，將攻徐州。其妻子在金鄕，仲文遣人詐爲毗羅使者謂金鄕城主徐善淨曰：「檀讓明日午時至金鄕，宣蜀公令，賞賜將士。」金鄕人皆喜。仲文簡精兵，僞建迥旗幟，倍道而進。善淨望見，以爲檀讓，以迎謁。仲文執之，遂取金鄕。諸將多勸屠其城，仲文曰：「此城乃毗羅起兵之所，當寬其妻子，其兵自歸。如卽屠之，彼望絕矣。」衆皆稱善。於是毗羅恃衆來薄官軍，仲文設伏擊之，毗羅衆大潰，爭投洙水死，水爲之不流。獲檀讓，檻送京師；斬毗羅，傳首。","content_fanyi":"于仲文率军进至蓼堤，距离梁郡七里。檀让拥有数万部众，于仲文用疲弱的士兵前去挑战，并假装败退，檀让因此不加防备；于仲文回军反击，大败檀让军，活捉五千余人，斩首七百级。接着进攻梁郡，尉迟迥的守将刘子宽弃城逃跑。于仲文又进击曹州，俘获尉迟迥任命的刺史李仲康。檀让率领残余部众屯驻成武，于仲文突袭并打败了他，于是攻下成武。尉迟迥的部将席毗罗拥兵十万，屯驻在沛县，准备进攻徐州。他的妻儿在金乡，于仲文派人假扮席毗罗的使者，对金乡城主徐善净说：“檀让明天午时到金乡，宣布蜀公尉迟迥的命令，赏赐将士。”金乡人都很高兴。于仲文挑选精兵，假立尉迟迥的旗帜，兼程前进。徐善净远远望见，以为是檀让，便出城迎见。于仲文将他拿下，于是占领金乡。众将大多劝他屠杀金乡城，于仲文说：“这座城是席毗罗起兵的地方，应当宽待他的妻子儿女，他的部众自会归附。如果立即屠城，他们就会完全绝望。”众人都称好。于是席毗罗仗恃人多前来进逼官军，于仲文设下伏兵攻击，席毗罗军大败溃散，争相跳入洙水淹死，洙水因此堵塞不流。于仲文俘获檀让，用槛车押送京城；斩杀席毗罗，将其首级传送长安。","content_jianti_auto":"于仲文军至蓼隄，去梁郡七里。檀让拥众数万，仲文以羸师挑战而伪北，让不设备；仲文还击，大破之，生获五千余人，斩首七百级。进攻梁郡，迥守将刘子宽弃城走。仲文进击曹州，获迥所署刺史李仲康。檀让以余众屯成武，仲文袭击，破之，遂拔成武。迥将席毗罗，众十万，屯沛县，将攻徐州。其妻子在金鄕，仲文遣人诈为毗罗使者谓金鄕城主徐善净曰：「檀让明日午时至金鄕，宣蜀公令，赏赐将士。」金鄕人皆喜。仲文简精兵，伪建迥旗帜，倍道而进。善净望见，以为檀让，以迎谒。仲文执之，遂取金鄕。诸将多劝屠其城，仲文曰：「此城乃毗罗起兵之所，当宽其妻子，其兵自归。如即屠之，彼望绝矣。」众皆称善。于是毗罗恃众来薄官军，仲文设伏击之，毗罗众大溃，争投洙水死，水为之不流。获檀让，槛送京师；斩毗罗，传首。","dtjl_paragraph_links":[],"dtjl_references":[],"id":16844,"path":"资治通鉴 : 卷第一百七十四 (陳紀八) / 高宗宣皇帝下之上 / 太建十二年 / 第 57 段","reading_annotation_sources":[],"start_index":56,"tongjian_id":"b34830b6-db0e-11ef-b3c5-a0d3651f611f","year_int":580},"tongjian_id":"b34830b6-db0e-11ef-b3c5-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻；下同。","note_content_jianti_auto":"将，即亮翻；下同。","note_type":"hu_note","start_index":12,"tongjian_id":"b72328c8-db0e-11ef-a614-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"酸棗縣","place_name_jianti_auto":"酸枣县","start_index":0,"tongjian_id":"b72328ca-db0e-11ef-afd8-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":3,"tongjian_id":"b72328cb-db0e-11ef-a103-a0d3651f611f"},{"place_name":"鄭州","place_name_jianti_auto":"郑州","start_index":5,"tongjian_id":"b72328cc-db0e-11ef-afa4-a0d3651f611f"},{"place_name":"東梁州","place_name_jianti_auto":"东梁州","start_index":11,"tongjian_id":"b72328cd-db0e-11ef-ab02-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"酸棗縣隋屬鄭州，此時屬東梁州。","note_content_jianti_auto":"酸枣县隋属郑州，此时属东梁州。","note_type":"hu_note","start_index":55,"tongjian_id":"b72328c9-db0e-11ef-94f8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"济阴郡改•山东省定陶县","resolved_place_entity_id":815,"start_index":9,"tongjian_id":"b72328d0-db0e-11ef-8d9c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、南北朝 隋（卷四）","excerpts":[{"context_after":"","context_before":"...海公据此，有曹、戴二州地。戴州，今兖州府城武县是其治]。","source_end_index":455,"source_paragraph_tongjian_id":"df5ef6d1-c056-56b4-bf05-f35553b05637","source_start_index":423,"source_text":"会唐军围东都急，王世充请救，遂引而西，战于成皋，军败，为唐所擒。"}],"path":"历代州域形势纪要/四、南北朝 隋（卷四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"竇建德使其將范願守曹州，悉發孟海公、徐圓朗之衆，西救洛陽。至滑州，王世充行臺僕射韓洪開門納之。己卯，軍于酸棗。","content_fanyi":"窦建德派其将领范愿守卫曹州，调发孟海公、徐圆朗的全部部众，向西救援洛阳。至滑州，王世充的行台仆射韩洪打开城门接纳了他们。己卯，屯驻于酸枣。","content_jianti_auto":"窦建德使其将范愿守曹州，悉发孟海公、徐圆朗之众，西救洛阳。至滑州，王世充行台仆射韩洪开门纳之。己卯，军于酸枣。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18212,"path":"资治通鉴 : 卷第一百八十九 (唐紀五) / 高祖神堯大聖光孝皇帝中之中 / 武德四年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"b72328c7-db0e-11ef-ae67-a0d3651f611f","year_int":621},"tongjian_id":"b72328c7-db0e-11ef-ae67-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鄆州","place_name_jianti_auto":"郓州","place_note":"山东省东平县","start_index":0,"tongjian_id":"b7334096-db0e-11ef-9048-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":3,"tongjian_id":"b7334097-db0e-11ef-8339-a0d3651f611f"},{"place_name":"東平郡","place_name_jianti_auto":"东平郡","start_index":5,"tongjian_id":"b7334098-db0e-11ef-ae81-a0d3651f611f"},{"place_name":"曹州","place_name_jianti_auto":"曹州","start_index":9,"tongjian_id":"b7334099-db0e-11ef-b91e-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":12,"tongjian_id":"b733409a-db0e-11ef-bf22-a0d3651f611f"},{"place_name":"濟陰郡","place_name_jianti_auto":"济阴郡","start_index":14,"tongjian_id":"b733409b-db0e-11ef-a67e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄆州，隋之東平郡。曹州，隋之濟陰郡。鄆，音運。噉，徒濫翻。降，戶江翻。","note_content_jianti_auto":"郓州，隋之东平郡。曹州，隋之济阴郡。郓，音运。噉，徒滥翻。降，户江翻。","note_type":"hu_note","start_index":26,"tongjian_id":"b7334095-db0e-11ef-b396-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东省定陶县","resolved_place_entity_id":815,"start_index":21,"tongjian_id":"b73367ea-db0e-11ef-82a6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"24戊戌，孟海公餘黨蔣善合以鄆州，孟噉鬼以曹州來降。噉鬼，海公之從兄也。","content_fanyi":"六月十二日戊戌，孟海公的余党蒋善合率郓州、孟啖鬼率曹州投降唐朝。孟啖鬼是孟海公的堂兄。","content_jianti_auto":"24戊戌，孟海公余党蒋善合以郓州，孟噉鬼以曹州来降。噉鬼，海公之从兄也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18246,"number":24,"path":"资治通鉴 : 卷第一百八十九 (唐紀五) / 高祖神堯大聖光孝皇帝中之中 / 武德四年 / 第 41 段","reading_annotation_sources":[],"start_index":40,"tongjian_id":"b7334094-db0e-11ef-bb63-a0d3651f611f","year_int":621},"tongjian_id":"b7334094-db0e-11ef-bb63-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"藝","people_name_jianti_auto":"艺","start_index":5,"tongjian_id":"b7f3416e-db0e-11ef-87d8-a0d3651f611f"},{"people_name":"建成","people_name_jianti_auto":"建成","start_index":11,"tongjian_id":"b7f3416f-db0e-11ef-ada9-a0d3651f611f"},{"people_name":"劉黑闥","people_name_jianti_auto":"刘黑闼","start_index":15,"tongjian_id":"b7f34170-db0e-11ef-9f6a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武德五年，藝引兵與太子建成會討劉黑闥，遂入朝。朝，直遙翻。","note_content_jianti_auto":"武德五年，艺引兵与太子建成会讨刘黑闼，遂入朝。朝，直遥翻。","note_type":"hu_note","start_index":7,"tongjian_id":"b7f3416d-db0e-11ef-a01c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"諸州治中，卽別駕。","note_content_jianti_auto":"诸州治中，即别驾。","note_type":"hu_note","start_index":105,"tongjian_id":"b7f34173-db0e-11ef-88d0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":6,"tongjian_id":"b7f34177-db0e-11ef-a63e-a0d3651f611f"},{"place_name":"烏氏縣","place_name_jianti_auto":"乌氏县","start_index":7,"tongjian_id":"b7f34178-db0e-11ef-826e-a0d3651f611f"},{"place_name":"安定郡","place_name_jianti_auto":"安定郡","start_index":11,"tongjian_id":"b7f34179-db0e-11ef-b0eb-a0d3651f611f"},{"place_name":"彈箏峽","place_name_jianti_auto":"弹筝峡","start_index":18,"tongjian_id":"b7f3417a-db0e-11ef-bfd0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"厥，九勿翻。漢烏氏縣屬安定郡，故城在彈箏峽東。氏，音支。","note_content_jianti_auto":"厥，九勿翻。汉乌氏县属安定郡，故城在弹筝峡东。氏，音支。","note_type":"hu_note","start_index":185,"tongjian_id":"b7f34176-db0e-11ef-bbd0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","resolved_place_entity_id":815,"start_index":50,"tongjian_id":"b7f34181-db0e-11ef-b4c1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"藝之初入朝也，恃功驕倨，秦王左右至其營，藝無故毆之。上皇怒，收藝繫獄，旣而釋之。上卽位，藝內不自安。曹州妖巫李五戒謂藝曰：「王貴色已發！」勸之反。藝乃詐稱奉密敕，勒兵入朝。遂引兵至豳州，豳州治中趙慈皓馳出謁之，藝入據豳州，詔吏部尚書長孫無忌等爲行軍總管以討之。趙慈皓聞官軍將至，密與統軍楊岌圖之，事洩，藝囚慈皓。岌在城外覺變，勒兵攻之，藝衆潰，棄妻子，將奔突厥。至烏氏，左右斬之，傳首長安。弟壽，爲利州都督，亦坐誅。","content_fanyi":"当初李艺归顺朝廷时，仗恃功劳骄横傲慢；秦王李世民身边的人到了他的营地，李艺无故殴打他们。太上皇大怒，将李艺逮捕关进监狱，不久又释放了他。唐太宗即位后，李艺内心感到不安。曹州妖邪巫师李五戒对李艺说：“郡王的贵相已经显现出来了！”劝他反叛。李艺于是假称奉有皇帝密诏，领兵入朝。接着领兵到达豳州，豳州治中赵慈皓驰马出城谒见他，李艺入城占据豳州，唐太宗下诏任命吏部尚书长孙无忌等人为行军总管，率兵讨伐他。赵慈皓听说官军将要到来，秘密与统军杨岌商议逮捕李艺，事情泄露，李艺囚禁了赵慈皓。杨岌在城外察觉情况有变，率兵攻打，李艺部众溃散，李艺抛弃妻子儿女，准备投奔突厥。到达乌氏城，左右的人将他斩杀，将首级传送到长安。他的弟弟李寿当时任利州都督，也因连坐被诛杀。","content_jianti_auto":"艺之初入朝也，恃功骄倨，秦王左右至其营，艺无故殴之。上皇怒，收艺系狱，既而释之。上即位，艺内不自安。曹州妖巫李五戒谓艺曰：「王贵色已发！」劝之反。艺乃诈称奉密敕，勒兵入朝。遂引兵至豳州，豳州治中赵慈皓驰出谒之，艺入据豳州，诏吏部尚书长孙无忌等为行军总管以讨之。赵慈皓闻官军将至，密与统军杨岌图之，事泄，艺囚慈皓。岌在城外觉变，勒兵攻之，艺众溃，弃妻子，将奔突厥。至乌氏，左右斩之，传首长安。弟寿，为利州都督，亦坐诛。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18667,"path":"资治通鉴 : 卷第一百九十二 (唐紀八) / 太宗文武大聖大廣孝皇帝上之上 / 貞觀元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"b7f3416c-db0e-11ef-82d1-a0d3651f611f","year_int":627},"tongjian_id":"b7f3416c-db0e-11ef-82d1-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东定陶","start_index":3,"tongjian_id":"bce39ece-db0e-11ef-8243-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":6,"tongjian_id":"bce39ecf-db0e-11ef-b666-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"舊志，曹州，京師東北一千四百五十三里。","note_content_jianti_auto":"旧志，曹州，京师东北一千四百五十三里。","note_type":"hu_note","start_index":109,"tongjian_id":"bce39ecd-db0e-11ef-bda7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"中宗","people_name_jianti_auto":"中宗","start_index":38,"tongjian_id":"bce39ed2-db0e-11ef-8dd9-a0d3651f611f"},{"people_name":"豆盧欽望","people_name_jianti_auto":"豆卢钦望","start_index":44,"tongjian_id":"bce39ed3-db0e-11ef-b28a-a0d3651f611f"},{"people_name":"源乾曜","people_name_jianti_auto":"源乾曜","start_index":90,"tongjian_id":"bce39ed4-db0e-11ef-aa57-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":19,"tongjian_id":"bce39ed5-db0e-11ef-8157-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":81,"tongjian_id":"bce39ed6-db0e-11ef-87ac-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"開元初，改尚書左、右僕射爲左、右丞相。唐初，僕射之職無所不統，是正丞相也。至中宗神龍元年豆盧欽望專爲僕射，不敢預政事，是後專拜僕射者不復知政事，雖有丞相之名，非復唐初丞相之職矣。今源乾曜止爲左丞相，是止爲尚書左僕射，不復預政事也。","note_content_jianti_auto":"开元初，改尚书左、右仆射为左、右丞相。唐初，仆射之职无所不统，是正丞相也。至中宗神龙元年豆卢钦望专为仆射，不敢预政事，是后专拜仆射者不复知政事，虽有丞相之名，非复唐初丞相之职矣。今源乾曜止为左丞相，是止为尚书左仆射，不复预政事也。","note_type":"hu_note","start_index":122,"tongjian_id":"bce39ed1-db0e-11ef-8f22-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河西","place_name_jianti_auto":"河西","start_index":2,"tongjian_id":"bce39ed8-db0e-11ef-9bc3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"遙領河西節度使。","note_content_jianti_auto":"遥领河西节度使。","note_type":"hu_note","start_index":167,"tongjian_id":"bce39ed7-db0e-11ef-9be5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东定陶","resolved_place_entity_id":815,"start_index":104,"tongjian_id":"bce39ee4-db0e-11ef-8603-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7初，張說、張嘉貞、李元紘、杜暹相繼爲相用事，源乾曜以清謹自守，常讓事於說等，唯諾署名而已。元紘、暹議事多異同，遂有隙，更相奏列。上不悅，六月，甲戌，貶黃門侍郞、同平章事杜暹荊州長史，中書侍郞、同平章事李元紘曹州刺史，罷乾曜兼侍中，止爲左丞相；以戶部侍郞宇文融爲黃門侍郞，兵部侍郞裴光庭爲中書侍郞，並同平章事；蕭嵩兼中書令，遙領河西。","content_fanyi":"当初，张说、张嘉贞、李元纮、杜暹相继担任宰相并掌权，源乾曜始终坚持清廉谨慎、自我约束，常常把事情让给张说等人处理，自己只是应诺署名罢了。李元纮、杜暹商讨事情时意见往往不一致，于是产生嫌隙，又交替上奏陈述己见。玄宗对此很不高兴。六月十五日甲戌，将黄门侍郎、同平章事杜暹贬为荆州长史，将中书侍郎、同平章事李元纮贬为曹州刺史，罢免源乾曜所兼任的侍中，只让他担任左丞相；任命户部侍郎宇文融为黄门侍郎，兵部侍郎裴光庭为中书侍郎，二人都为同平章事；萧嵩兼任中书令，遥领河西节度使。","content_jianti_auto":"7初，张说、张嘉贞、李元纮、杜暹相继为相用事，源乾曜以清谨自守，常让事于说等，唯诺署名而已。元纮、暹议事多异同，遂有隙，更相奏列。上不悦，六月，甲戌，贬黄门侍郞、同平章事杜暹荆州长史，中书侍郞、同平章事李元纮曹州刺史，罢乾曜兼侍中，止为左丞相；以户部侍郞宇文融为黄门侍郞，兵部侍郞裴光庭为中书侍郞，并同平章事；萧嵩兼中书令，遥领河西。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21452,"number":7,"path":"资治通鉴 : 卷第二百一十三 (唐紀二十九) / 玄宗至道大聖大明孝皇帝中之上 / 十七年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"bce39ecb-db0e-11ef-963e-a0d3651f611f","year_int":729},"tongjian_id":"bce39ecb-db0e-11ef-963e-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"新書「江」作「缸」，「鄂」作「萼」。","note_content_jianti_auto":"新书「江」作「缸」，「鄂」作「萼」。","note_type":"hu_note","start_index":51,"tongjian_id":"bed968bc-db0e-11ef-8847-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东定陶县","resolved_place_entity_id":815,"start_index":48,"tongjian_id":"bed968c6-db0e-11ef-9cdd-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"35史思明遣其將田承嗣將兵五千徇淮西，王同芝將兵三千人徇陳，許敬江將二千人徇兗鄆，薛鄂將五千人徇曹州。","content_fanyi":"史思明派遣部将田承嗣率兵五千攻掠淮西，王同芝率兵三千人攻掠陈州，许敬江率二千人攻掠兖州、郓州，薛鄂率五千人攻掠曹州。","content_jianti_auto":"35史思明遣其将田承嗣将兵五千徇淮西，王同芝将兵三千人徇陈，许敬江将二千人徇兖郓，薛鄂将五千人徇曹州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22365,"number":35,"path":"资治通鉴 : 卷第二百二十一 (唐紀三十七) / 肅宗文明武德大聖大宣孝皇帝下之上 / 上元元年 / 第 42 段","reading_annotation_sources":[],"start_index":41,"tongjian_id":"bed968bb-db0e-11ef-b010-a0d3651f611f","year_int":760},"tongjian_id":"bed968bb-db0e-11ef-b010-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"少，始照翻。考異曰：汾陽家傳作「李思惠」。今從舊傳。","note_content_jianti_auto":"少，始照翻。考异曰：汾阳家传作「李思惠」。今从旧传。","note_type":"hu_note","start_index":15,"tongjian_id":"bfb67542-db0e-11ef-b799-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"嚴","people_name_jianti_auto":"严","start_index":1,"tongjian_id":"bfb67548-db0e-11ef-8844-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『嚴：「僧」改「曾」。』","note_content_jianti_auto":"『严：「僧」改「曾」。』","note_type":"『嚴：[^』]*』","start_index":0,"tongjian_id":"bfb67547-db0e-11ef-ae4a-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":31,"tongjian_id":"bfb67546-db0e-11ef-b3db-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","resolved_place_entity_id":815,"start_index":97,"tongjian_id":"bfb6755e-db0e-11ef-a701-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"汴宋兵馬使、攝節度副使李僧惠，靈曜之謀主也。宋州牙門將劉昌遣僧神表潛說僧惠；僧惠召問計，昌爲之泣陳逆順。僧惠乃與汴宋牙將高憑、石隱金遣神表奉表詣京師，請討靈曜。九月，壬戌，以僧惠爲宋州刺史，憑爲曹州刺史，隱金爲鄆州刺史。","content_fanyi":"汴宋兵马使、代理节度副使李僧惠，是李灵曜身边出谋划策的核心人物。宋州牙门将刘昌派僧人神表私下劝说李僧惠；李僧惠召来刘昌询问计策，刘昌流着泪向他陈说叛逆与归顺朝廷的利害。李僧惠于是同汴宋牙将高凭、石隐金派神表进京呈送表文，请求讨伐李灵曜。九月初八日壬戌，朝廷任命李僧惠为宋州刺史，任命高凭为曹州刺史，任命石隐金为郓州刺史。","content_jianti_auto":"汴宋兵马使、摄节度副使李僧惠，灵曜之谋主也。宋州牙门将刘昌遣僧神表潜说僧惠；僧惠召问计，昌为之泣陈逆顺。僧惠乃与汴宋牙将高凭、石隐金遣神表奉表诣京师，请讨灵曜。九月，壬戌，以僧惠为宋州刺史，凭为曹州刺史，隐金为郓州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22822,"path":"资治通鉴 : 卷第二百二十五 (唐紀四十一) / 代宗睿文孝武皇帝中之下 / 十一年 / 第 11 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":10,"tongjian_id":"bfb67541-db0e-11ef-b67d-a0d3651f611f","year_int":776},"tongjian_id":"bfb67541-db0e-11ef-b67d-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉文喜","people_name_jianti_auto":"刘文喜","start_index":0,"tongjian_id":"bfffdf99-db0e-11ef-9664-a0d3651f611f"},{"people_name":"劉晏","people_name_jianti_auto":"刘晏","start_index":4,"tongjian_id":"bfffdf9a-db0e-11ef-a62e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉文喜、劉晏死皆見上年。","note_content_jianti_auto":"刘文喜、刘晏死皆见上年。","note_type":"hu_note","start_index":29,"tongjian_id":"bfffdf98-db0e-11ef-a762-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李正己","people_name_jianti_auto":"李正己","start_index":0,"tongjian_id":"bfffdf9c-db0e-11ef-a2eb-a0d3651f611f"},{"people_name":"田悅","people_name_jianti_auto":"田悦","start_index":4,"tongjian_id":"bfffdf9d-db0e-11ef-b2b6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李正己、田悅非面相告語也，使人傳言有此語。","note_content_jianti_auto":"李正己、田悦非面相告语也，使人传言有此语。","note_type":"hu_note","start_index":48,"tongjian_id":"bfffdf9b-db0e-11ef-80e2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"燭之武","people_name_jianti_auto":"烛之武","start_index":27,"tongjian_id":"c0001a76-db0e-11ef-8b0c-a0d3651f611f"},{"people_name":"秦伯","people_name_jianti_auto":"秦伯","start_index":32,"tongjian_id":"c0001a77-db0e-11ef-b89e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"泰山","place_name_jianti_auto":"泰山","start_index":18,"tongjian_id":"c0001a78-db0e-11ef-9491-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":37,"tongjian_id":"c0001a79-db0e-11ef-b614-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"汴，皮變翻。隘，烏介翻。東封，非東封泰山之謂，蓋用左傳燭之武說「秦伯旣東封鄭，又欲肆其西封」之語。","note_content_jianti_auto":"汴，皮变翻。隘，乌介翻。东封，非东封泰山之谓，盖用左传烛之武说「秦伯既东封郑，又欲肆其西封」之语。","note_type":"hu_note","start_index":68,"tongjian_id":"bfffdf9e-db0e-11ef-9cfc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李正己","people_name_jianti_auto":"李正己","start_index":3,"tongjian_id":"c0001a7c-db0e-11ef-bca6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东省定陶县","start_index":0,"tongjian_id":"c0001a7d-db0e-11ef-b078-a0d3651f611f"},{"place_name":"汴州","place_name_jianti_auto":"汴州","start_index":10,"tongjian_id":"c0001a7e-db0e-11ef-960b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"曹州，李正己巡屬，與汴州接壤。","note_content_jianti_auto":"曹州，李正己巡属，与汴州接壤。","note_type":"hu_note","start_index":86,"tongjian_id":"c0001a7b-db0e-11ef-a984-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":0,"tongjian_id":"c0001a80-db0e-11ef-9c8b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜預曰：完聚者，完城郭，聚人民。","note_content_jianti_auto":"杜预曰：完聚者，完城郭，聚人民。","note_type":"hu_note","start_index":94,"tongjian_id":"c0001a7f-db0e-11ef-b879-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东省定陶县","resolved_place_entity_id":815,"start_index":83,"tongjian_id":"c0001a8a-db0e-11ef-b325-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"劉文喜之死也，李正己、田悅等皆不自安；劉晏死，正己等益懼，相謂曰：「我輩罪惡，豈得與劉晏比乎！」會汴州城隘，廣之，東方人訛言「上欲東封，故城汴州。」正己懼，發兵萬人屯曹州；田悅亦完聚爲備，與梁崇義、李惟岳遙相應助，河南士民騷然驚駭。","content_fanyi":"四镇北庭留后刘文喜去年被杀，这让李正己、田悦等人内心都很不安；左仆射刘晏被赐死之后，李正己等人愈发忧惧，彼此议论道：“我们这些人的罪过，怎么能和刘晏相提并论呢！”恰逢朝廷觉得汴州城狭小，加以拓宽，京东一带的人便讹传说“皇上想要向东控制边疆，所以要修建汴州城”。李正己害怕，调发一万军队驻扎在曹州；田悦也修治城郭、聚集粮草兵马作防备，与梁崇义、李惟岳遥相呼应、互相援助，河南的士民和军队因此骚动不安，惊恐不已。","content_jianti_auto":"刘文喜之死也，李正己、田悦等皆不自安；刘晏死，正己等益惧，相谓曰：「我辈罪恶，岂得与刘晏比乎！」会汴州城隘，广之，东方人讹言「上欲东封，故城汴州。」正己惧，发兵万人屯曹州；田悦亦完聚为备，与梁崇义、李惟岳遥相应助，河南士民骚然惊骇。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，贼指为名以激众怨耳，实则了不相及之势也。抑欲天子不敢杀...","context_before":"...而河北能戢志以听命乎，谁其信之？不杀来瑱而仆固怀恩固反，","source_end_index":65,"source_paragraph_tongjian_id":"5806746e-541d-4456-a980-f30068c990ac","source_start_index":56,"source_text":"不杀刘晏而河北固叛"}],"title":"七 天下复乱非因不许李惟岳嗣位"}],"id":22981,"path":"资治通鉴 : 卷第二百二十六 (唐紀四十二) / 德宗神武孝文皇帝一 / 二年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"bfffdf97-db0e-11ef-83ba-a0d3651f611f","year_int":781},"tongjian_id":"bfffdf97-db0e-11ef-83ba-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王武俊","people_name_jianti_auto":"王武俊","start_index":4,"tongjian_id":"c09ab26e-db0e-11ef-9f6c-a0d3651f611f"},{"people_name":"康日知","people_name_jianti_auto":"康日知","start_index":10,"tongjian_id":"c09ab26f-db0e-11ef-8bfa-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"趙州","place_name_jianti_auto":"赵州","start_index":1,"tongjian_id":"c09ab270-db0e-11ef-a856-a0d3651f611f"},{"place_name":"同州","place_name_jianti_auto":"同州","start_index":19,"tongjian_id":"c09ab271-db0e-11ef-a3e2-a0d3651f611f"},{"place_name":"匡國軍","place_name_jianti_auto":"匡国军","start_index":22,"tongjian_id":"c09ab272-db0e-11ef-9d43-a0d3651f611f"},{"place_name":"奉誠軍","place_name_jianti_auto":"奉诚军","start_index":32,"tongjian_id":"c09ab273-db0e-11ef-9db5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"以趙州與王武俊，故徙康日知。乾元初，以同州爲匡國軍節度使，今又爲奉誠軍。","note_content_jianti_auto":"以赵州与王武俊，故徙康日知。乾元初，以同州为匡国军节度使，今又为奉诚军。","note_type":"hu_note","start_index":91,"tongjian_id":"c09ab26d-db0e-11ef-86e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李納","people_name_jianti_auto":"李纳","start_index":0,"tongjian_id":"c09ab275-db0e-11ef-8e21-a0d3651f611f"},{"people_name":"正己","people_name_jianti_auto":"正己","start_index":16,"tongjian_id":"c09ab276-db0e-11ef-82d1-a0d3651f611f"},{"people_name":"納","people_name_jianti_auto":"纳","start_index":20,"tongjian_id":"c09ab277-db0e-11ef-aa54-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","start_index":4,"tongjian_id":"c09ab278-db0e-11ef-8467-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李納本爲曹州刺史，建中二年，其父正己卒，納自領軍務，未有朝命，今方命以旌節，故先敍其本職，而加以新命。鄆，音運。","note_content_jianti_auto":"李纳本为曹州刺史，建中二年，其父正己卒，纳自领军务，未有朝命，今方命以旌节，故先敍其本职，而加以新命。郓，音运。","note_type":"hu_note","start_index":109,"tongjian_id":"c09ab274-db0e-11ef-8571-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东省定陶县","resolved_place_entity_id":815,"start_index":91,"tongjian_id":"c09ab289-db0e-11ef-b9ca-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、唐上（卷五）","excerpts":[{"context_after":"贞元中，复兼有德、棣二州地。传四世。元和十五年，王承元入...","context_before":"...节度使。武俊与朱滔等叛，滔以深州归之，又攻康日知于赵州。","source_end_index":545,"source_paragraph_tongjian_id":"1245deab-e06f-5898-938e-4d8ad5884fb3","source_start_index":518,"source_text":"兴元初，武俊顺命，以赵州畀之，授恒、冀、深、赵节度使。"}],"path":"历代州域形势纪要/五、唐上（卷五）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"11辛卯，以王武俊爲恆、冀、深、趙節度使。壬辰，加李抱眞、張孝忠並同平章事。丙申，加田悅檢校左僕射。以山南東道行軍司馬樊澤爲本道節度使，前深、趙觀察使康日知爲同州刺史、奉誠軍節度使，曹州刺史李納爲鄆州刺史、平盧節度使。","content_fanyi":"十一月辛卯日，皇上任命王武俊为恒、冀、深、赵四州节度使。壬辰日，又加授李抱真、张孝忠二人同平章事。丙申日，加授田悦检校左仆射。又任命山南东道行军司马樊泽为本道节度使，前深、赵二州观察使康日知为同州刺史、奉诚军节度使，曹州刺史李纳为郓州刺史、平卢节度使。","content_jianti_auto":"11辛卯，以王武俊为恒、冀、深、赵节度使。壬辰，加李抱真、张孝忠并同平章事。丙申，加田悦检校左仆射。以山南东道行军司马樊泽为本道节度使，前深、赵观察使康日知为同州刺史、奉诚军节度使，曹州刺史李纳为郓州刺史、平卢节度使。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23211,"number":11,"path":"资治通鉴 : 卷第二百二十九 (唐紀四十五) / 德宗神武聖文皇帝四 / 興元元年 / 第 18 段","reading_annotation_sources":[],"start_index":17,"tongjian_id":"c09ab26b-db0e-11ef-83a1-a0d3651f611f","year_int":784},"tongjian_id":"c09ab26b-db0e-11ef-83a1-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"曹州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":13,"tongjian_id":"c2889b70-db0e-11ef-9568-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋公羊傳曰：王者無外。此唐人以化外待藩鎭，故有此語。","note_content_jianti_auto":"春秋公羊传曰：王者无外。此唐人以化外待藩镇，故有此语。","note_type":"hu_note","start_index":57,"tongjian_id":"c2889b6f-db0e-11ef-8aa0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"穆宗","people_name_jianti_auto":"穆宗","start_index":23,"tongjian_id":"c2889b73-db0e-11ef-8d05-a0d3651f611f"},{"people_name":"文宗","people_name_jianti_auto":"文宗","start_index":26,"tongjian_id":"c2889b74-db0e-11ef-b145-a0d3651f611f"},{"people_name":"愈","people_name_jianti_auto":"愈","start_index":36,"tongjian_id":"c2889b75-db0e-11ef-820e-a0d3651f611f"},{"people_name":"李漢","people_name_jianti_auto":"李汉","start_index":38,"tongjian_id":"c2889b76-db0e-11ef-a083-a0d3651f611f"},{"people_name":"蔣係","people_name_jianti_auto":"蒋系","start_index":41,"tongjian_id":"c2889b77-db0e-11ef-b84d-a0d3651f611f"},{"people_name":"韋處厚","people_name_jianti_auto":"韦处厚","start_index":53,"tongjian_id":"c2889b78-db0e-11ef-b2f6-a0d3651f611f"},{"people_name":"韓愈","people_name_jianti_auto":"韩愈","start_index":94,"tongjian_id":"c2889b79-db0e-11ef-9218-a0d3651f611f"},{"people_name":"李師古","people_name_jianti_auto":"李师古","start_index":130,"tongjian_id":"c2889b7a-db0e-11ef-bc75-a0d3651f611f"},{"people_name":"衡","people_name_jianti_auto":"衡","start_index":153,"tongjian_id":"c2889b7b-db0e-11ef-86b9-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":161,"tongjian_id":"c2889b7c-db0e-11ef-a31d-a0d3651f611f"},{"people_name":"衡","people_name_jianti_auto":"衡","start_index":167,"tongjian_id":"c2889b7d-db0e-11ef-a904-a0d3651f611f"},{"people_name":"衡","people_name_jianti_auto":"衡","start_index":172,"tongjian_id":"c2889b7e-db0e-11ef-bd0a-a0d3651f611f"},{"people_name":"韓愈","people_name_jianti_auto":"韩愈","start_index":200,"tongjian_id":"c2889b7f-db0e-11ef-a183-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"滑州","place_name_jianti_auto":"滑州","place_note":"河南省滑县","start_index":134,"tongjian_id":"c2889b80-db0e-11ef-aa16-a0d3651f611f"},{"place_name":"濮州","place_name_jianti_auto":"濮州","start_index":190,"tongjian_id":"c2889b81-db0e-11ef-956e-a0d3651f611f"},{"place_name":"曹","place_name_jianti_auto":"曹","start_index":212,"tongjian_id":"c2889b82-db0e-11ef-a5e0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊·韓愈傳云：「撰順宗實錄，繁簡不當，穆宗、文宗嘗詔史臣添改。時愈壻李漢、蔣係在顯位，諸公難之，而韋處厚竟別撰順宗實錄三卷。」景祐中，詔編次崇文總目，順宗實錄有七本，皆五卷，題曰「韓愈等撰」。五本略而二本詳，編次者兩存之。其中多異同，今以詳、略爲別。此李師古脅滑州事，詳本有而略本無。詳錄又云：「使衡密以其本示之。師古不受，杖衡幾死。」衡蓋使者之名而無姓。又云：「遂以師至濮州，伺候爲變。」按韓愈撰韓弘碑云：「屯兵于曹。」今從之。","note_content_jianti_auto":"考异曰：旧·韩愈传云：「撰顺宗实录，繁简不当，穆宗、文宗尝诏史臣添改。时愈壻李汉、蒋系在显位，诸公难之，而韦处厚竟别撰顺宗实录三卷。」景祐中，诏编次崇文总目，顺宗实录有七本，皆五卷，题曰「韩愈等撰」。五本略而二本详，编次者两存之。其中多异同，今以详、略为别。此李师古胁滑州事，详本有而略本无。详录又云：「使衡密以其本示之。师古不受，杖衡几死。」衡盖使者之名而无姓。又云：「遂以师至濮州，伺候为变。」按韩愈撰韩弘碑云：「屯兵于曹。」今从之。","note_type":"hu_note","start_index":120,"tongjian_id":"c2889b72-db0e-11ef-98e1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东定陶","start_index":4,"tongjian_id":"c2889b8e-db0e-11ef-bad1-a0d3651f611f"},{"place_name":"滑州","place_name_jianti_auto":"滑州","start_index":9,"tongjian_id":"c2889b8f-db0e-11ef-9b5a-a0d3651f611f"},{"place_name":"汴州","place_name_jianti_auto":"汴州","start_index":17,"tongjian_id":"c2889b90-db0e-11ef-8405-a0d3651f611f"},{"place_name":"滑州","place_name_jianti_auto":"滑州","start_index":21,"tongjian_id":"c2889b91-db0e-11ef-87b0-a0d3651f611f"},{"place_name":"曹州","place_name_jianti_auto":"曹州","start_index":31,"tongjian_id":"c2889b92-db0e-11ef-9926-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：曹州西北至滑州一百二十里。汴州北至滑州界一百里，東北至曹州界一百三里。三州之界，蓋犬牙相入。","note_content_jianti_auto":"九域志：曹州西北至滑州一百二十里。汴州北至滑州界一百里，东北至曹州界一百三里。三州之界，盖犬牙相入。","note_type":"hu_note","start_index":127,"tongjian_id":"c2889b8d-db0e-11ef-a274-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"翦，芟截也。夷，平也。","note_content_jianti_auto":"翦，芟截也。夷，平也。","note_type":"hu_note","start_index":190,"tongjian_id":"c2889b94-db0e-11ef-a876-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韓弘","people_name_jianti_auto":"韩弘","start_index":15,"tongjian_id":"c2889b96-db0e-11ef-b2df-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":19,"tongjian_id":"c2889b97-db0e-11ef-9f5d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索，蘇各翻。索，散也，盡也。言韓弘逆得師古之情，其所設詭變索然散盡也。","note_content_jianti_auto":"索，苏各翻。索，散也，尽也。言韩弘逆得师古之情，其所设诡变索然散尽也。","note_type":"hu_note","start_index":225,"tongjian_id":"c2889b95-db0e-11ef-86fa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李泌","people_name_jianti_auto":"李泌","start_index":0,"tongjian_id":"c2889b99-db0e-11ef-99bc-a0d3651f611f"},{"people_name":"肅","people_name_jianti_auto":"肃","start_index":4,"tongjian_id":"c2889b9a-db0e-11ef-abb3-a0d3651f611f"},{"people_name":"代","people_name_jianti_auto":"代","start_index":6,"tongjian_id":"c2889b9b-db0e-11ef-b54b-a0d3651f611f"},{"people_name":"德","people_name_jianti_auto":"德","start_index":8,"tongjian_id":"c2889b9c-db0e-11ef-a724-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李泌歷事肅、代、德，貞元中爲相。","note_content_jianti_auto":"李泌历事肃、代、德，贞元中为相。","note_type":"hu_note","start_index":258,"tongjian_id":"c2889b98-db0e-11ef-bb51-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"曹州","place_name_jianti_auto":"曹州","place_note":"山东定陶","resolved_place_entity_id":815,"start_index":117,"tongjian_id":"c2889ba6-db0e-11ef-b7ab-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4壬子，李師古發兵屯西境以脅滑州。時告哀使未至諸道，義成牙將有自長安還得遺詔者，節度使李元素以師古鄰道，欲示無外，遣使密以遺詔示之。師古欲乘國喪侵噬鄰境，乃集將士謂曰：「聖上萬福，而元素忽傳遺詔，是反也，宜擊之。」遂杖元素使者，發兵屯曹州，且告假道於汴。宣武節度使韓弘使謂曰：「汝能越吾界而爲盜邪！有以相待，無爲空言！」元素告急，弘使謂曰：「吾在此，公安無恐。」或告：「翦棘夷道，兵且至矣，請備之。」弘曰：「兵來，不除道也。」不爲之應。師古詐窮變索，且聞上卽位，乃罷兵。元素表請自貶，朝廷兩慰解之。元素，泌之族弟也。","content_fanyi":"壬子日，李师古发兵屯驻西部边境，借以胁迫滑州。此时告哀使还没有抵达各道，有个义成牙将从长安返回，带回了德宗的遗诏；节度使李元素因李师古与自己辖境相邻，想表示不把他当作外人，便派使者秘密把遗诏拿给他看。李师古想趁国家大丧侵吞邻境，于是召集将士，对他们说：“圣上万福，而李元素忽然传示遗诏，这是反叛，应当攻打他。”于是杖打李元素的使者，发兵屯驻曹州，并派人向汴州请求借道。宣武节度使韩弘派人对他说：“你能越过我的地界来当强盗吗！我自有办法对付你，不是只说空话！”李元素告急，韩弘派人对他说：“我在这里，你尽管安心，不必害怕。”有人报告说：“请砍除荆棘、平整道路，军队就要到了，请加以防备。”韩弘说：“军队真的开来，是不会先清除道路的。”韩弘并没有因此作防备。李师古诡计和权变用尽，又听说皇上已经即位，才停止用兵。李元素上表请求将自己贬职，朝廷对双方都加以安抚劝解。李元素，是李泌同族弟弟。","content_jianti_auto":"4壬子，李师古发兵屯西境以胁滑州。时告哀使未至诸道，义成牙将有自长安还得遗诏者，节度使李元素以师古邻道，欲示无外，遣使密以遗诏示之。师古欲乘国丧侵噬邻境，乃集将士谓曰：「圣上万福，而元素忽传遗诏，是反也，宜击之。」遂杖元素使者，发兵屯曹州，且告假道于汴。宣武节度使韩弘使谓曰：「汝能越吾界而为盗邪！有以相待，无为空言！」元素告急，弘使谓曰：「吾在此，公安无恐。」或告：「翦棘夷道，兵且至矣，请备之。」弘曰：「兵来，不除道也。」不为之应。师古诈穷变索，且闻上即位，乃罢兵。元素表请自贬，朝廷两慰解之。元素，泌之族弟也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23813,"number":4,"path":"资治通鉴 : 卷第二百三十六 (唐紀五十二) / 順宗至德弘道大聖大安孝皇帝 / 永貞元年 / 第 7 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":6,"tongjian_id":"c2889b6e-db0e-11ef-a04a-a0d3651f611f","year_int":805},"tongjian_id":"c2889b6e-db0e-11ef-a04a-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":4,"total_paragraphs":37},"place_name":"曹州"},"message":"success","success":true}