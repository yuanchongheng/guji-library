{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁亥、前三三四）","note_content_jianti_auto":"（丁亥、前三三四）","note_type":"hu_note","start_index":0,"tongjian_id":"8c372c93-db0e-11ef-b512-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"梁惠王","people_name_jianti_auto":"梁惠王","start_index":12,"tongjian_id":"8c372c96-db0e-11ef-b91f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"下邳","place_name_jianti_auto":"下邳","start_index":19,"tongjian_id":"8c372c97-db0e-11ef-9e90-a0d3651f611f"},{"place_name":"薛","place_name_jianti_auto":"薛","start_index":23,"tongjian_id":"8c372c98-db0e-11ef-a223-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":27,"tongjian_id":"8c372c99-db0e-11ef-97b9-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":35,"tongjian_id":"8c372c9a-db0e-11ef-a243-a0d3651f611f"},{"place_name":"薛縣","place_name_jianti_auto":"薛县","start_index":37,"tongjian_id":"8c372c9b-db0e-11ef-987c-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":40,"tongjian_id":"8c372c9c-db0e-11ef-a641-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":44,"tongjian_id":"8c372c9d-db0e-11ef-89e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：竹書紀年云：梁惠王三十年，下邳遷于薛，改曰徐州。續漢志曰：魯國薛縣，六國時曰徐州。與竹書合。徐，音舒。相王者，相立爲王也。","note_content_jianti_auto":"史记正义曰：竹书纪年云：梁惠王三十年，下邳迁于薛，改曰徐州。续汉志曰：鲁国薛县，六国时曰徐州。与竹书合。徐，音舒。相王者，相立为王也。","note_type":"hu_note","start_index":14,"tongjian_id":"8c372c95-db0e-11ef-9ec1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"齊王","official_note":"齊王是齊國的君主，在戰國時期為諸侯國國王，此處指齊國國王參與會盟。","official_rank":"王爵","source_snippet":"齊王、魏王會于徐州以相王。","start_index":1,"tongjian_id":"7207dd92-25c1-4c91-a077-7f18c29bdfa0"},{"confidence":0.9,"official_category":"地方行政","official_name":"魏王","official_note":"魏王是魏國的君主，在戰國時期為諸侯國國王，此處指魏國國王參與會盟。","official_rank":"王爵","source_snippet":"齊王、魏王會于徐州以相王。","start_index":4,"tongjian_id":"39af2ac0-6377-45c9-aa05-fb9ef0ff6b10"}],"ExtRef_Children_people":[{"link_birth_year":-378,"link_death_year":-320,"link_td_description":"齐威王，妫姓，田氏，名因齐，战国策作婴齐，出土文物作陈侯因齐，田齐君主，为田齐桓公之子。","link_td_id":"Q10002279","link_td_number_id":327054,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田因齐","start_index":1,"tongjian_id":"8c372ca2-db0e-11ef-b498-a0d3651f611f","wl_zhushi":"[田因齐]"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏王","people_name_jianti_auto":"魏王","people_xingming":"魏罃","start_index":4,"tongjian_id":"8c372ca3-db0e-11ef-ae81-a0d3651f611f","wl_zhushi":"[魏罃]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"徐州","place_name_jianti_auto":"徐州","resolved_place_entity_id":190,"start_index":8,"tongjian_id":"8c372ca4-db0e-11ef-98bb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"十年，楚围我徐州。《楚世家》：威王七年，伐齐，败之于徐州...","context_before":"...诸侯会于徐州。又齐威王谓魏惠王，吾吏有黔夫者，使守徐州。","source_end_index":349,"source_paragraph_tongjian_id":"7a04b6d6-ac2b-54ee-a7d6-8d8a39f95109","source_start_index":329,"source_text":"又宣王八年，与魏襄王会徐州，诸侯相王也。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"}],"class_tags":["外交"],"content":"1齊王、魏王會于徐州以相王。","content_fanyi":"齐王、魏王在徐州会盟，互相推尊王号。","content_jianti_auto":"1齐王、魏王会于徐州以相王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":180,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c372c94-db0e-11ef-ab67-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"許愼","people_name_jianti_auto":"许愼","start_index":0,"tongjian_id":"8c372ca7-db0e-11ef-b235-a0d3651f611f"},{"people_name":"屈宜臼","people_name_jianti_auto":"屈宜臼","start_index":4,"tongjian_id":"8c372ca8-db0e-11ef-9f0e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":8,"tongjian_id":"8c372ca9-db0e-11ef-8c3d-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":14,"tongjian_id":"8c372caa-db0e-11ef-aef4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"許愼曰：屈宜臼，楚大夫，時在韓。屈，九勿翻。","note_content_jianti_auto":"许愼曰：屈宜臼，楚大夫，时在韩。屈，九勿翻。","note_type":"hu_note","start_index":21,"tongjian_id":"8c372ca6-db0e-11ef-b8b1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":11,"chapter_name":"治術篇第十一","chenzhu_chapter":"治術者致治之術，即身之之政论也。身之生平不喜滕口说，不喜上书言时事，国变以後，尤与政治绝缘。然其注《通鉴》，不能舍政治不谈，且有时陈古证今，谈言微中，颇得风人之旨，知其未尝忘情政治也。《表微》初拟立《君道》、《相业》诸篇，今特删併于《治術》，亦不多尚空言之意耳。","chenzhu_index_in_chapter":1,"chenzhu_text":"此盖为宋徽宗言之。《泊宅编》言：“崇、观以来，天下珍异，悉归禁中，四方梯航，殆无虚日，大则宠以爵禄，其次锡赉称是。宣和五年，平江府朱[img:Image00076.jpg] 造巨舰，载太湖石一块至京，以千人舁进，役夫各赐银碗并官，其四僕皆承节郎及金带，[img:Image00024.jpg] 遂为威远军节度使，而封石为槃固侯。”是时辽夏交侵，金人亦乘机思动，国家多难而势诎，政府渺不恤民，而举事反若有赢馀也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH11-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":6,"tongjian_id":"8c372cad-db0e-11ef-9ca7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詘，區勿翻。徐廣曰：時衰耗而作奢侈，言國家多難而勢詘，此時宜恤民之急，而舉事反若有贏餘者，失其所以爲國之道矣。「時詘舉贏」，蓋古語也。贏，怡成翻。","note_content_jianti_auto":"诎，区勿翻。徐广曰：时衰耗而作奢侈，言国家多难而势诎，此时宜恤民之急，而举事反若有赢余者，失其所以为国之道矣。「时诎举赢」，盖古语也。赢，怡成翻。","note_type":"hu_note","start_index":95,"tongjian_id":"8c372cac-db0e-11ef-9b1c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"韓昭侯","official_note":"韓昭侯是战国时期韩国的君主，属于地方行政长官，在上下文中作为对话的发起者出现，讨论修建高门之事。","official_rank":"侯爵","source_snippet":"韓昭侯作高門","start_index":2,"tongjian_id":"49961d37-6862-43a3-8d5b-e83d98b63e22"}],"ExtRef_Children_people":[{"link_death_year":-333,"link_td_description":"韩昭侯，姬姓，韩氏，名武，又称韩昭釐侯、韩釐侯、韩昭僖侯。前362年－前333年在位。战国时代韩国的第六任君主。韩共侯韩若山之子。","link_td_id":"Q10000677","link_td_number_id":210906,"people_name":"韓昭侯","people_name_jianti_auto":"韩昭侯","people_xingming":"韩昭侯","start_index":1,"tongjian_id":"8c372cae-db0e-11ef-a3db-a0d3651f611f"},{"link_td_description":"屈宜臼，亦作屈宜咎。战国时楚国宗室大夫，以言辩而著名。","link_td_id":"Q10004056","link_td_number_id":5553735,"people_name":"屈宜臼","people_name_jianti_auto":"屈宜臼","people_xingming":"屈宜臼","start_index":8,"tongjian_id":"8c372caf-db0e-11ef-92f5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8c372ca5-db0e-11ef-840e-a0d3651f611f","pinyin":"qū","source_anchor_text":"此所謂時詘舉贏者也","source_key":"baiyang_epub","start_index":89,"text":"詘","tongjian_id":"21177896-e1c7-5a50-8cca-bb964211c322"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","place_note":"府咸阳，陕西咸阳","resolved_place_entity_id":18,"start_index":62,"tongjian_id":"8c372cb0-db0e-11ef-ac06-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","place_note":"河南宜阳西","resolved_place_entity_id":881,"start_index":64,"tongjian_id":"8c372cb1-db0e-11ef-964b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2韓昭侯作高門，屈宜臼曰：「君必不出此門。何也？不時。吾所謂時者，非時日也。夫人固有利、不利時。往者君嘗利矣，不作高門。前年秦拔宜陽，今年旱，君不以此時恤民之急而顧益奢，此所謂時詘舉贏者也。故曰不時。」","content_fanyi":"韩昭侯修建高大的宫门，屈宜臼说：“您一定不要走出这座宫门。为什么呢？因为不合时宜。我所说的时宜，不是说时机。人本来就有有利时机和不利时机。从前您曾有过有利时机，却没有修建高门。前年秦国攻下宜阳，今年又遇上天旱，您不在这时体恤百姓的急难，反而更加奢侈，这正是所谓在时势艰难时去做时势顺利时的事。所以说不合时宜。”","content_jianti_auto":"2韩昭侯作高门，屈宜臼曰：「君必不出此门。何也？不时。吾所谓时者，非时日也。夫人固有利、不利时。往者君尝利矣，不作高门。前年秦拔宜阳，今年旱，君不以此时恤民之急而顾益奢，此所谓时诎举赢者也。故曰不时。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":181,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c372ca5-db0e-11ef-840e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"越王","people_name_jianti_auto":"越王","start_index":0,"tongjian_id":"8c372cb4-db0e-11ef-91ce-a0d3651f611f"},{"people_name":"句踐","people_name_jianti_auto":"句践","start_index":2,"tongjian_id":"8c372cb5-db0e-11ef-ae32-a0d3651f611f"},{"people_name":"句踐","people_name_jianti_auto":"句践","start_index":8,"tongjian_id":"8c372cb6-db0e-11ef-95cd-a0d3651f611f"},{"people_name":"無彊","people_name_jianti_auto":"无彊","start_index":11,"tongjian_id":"8c372cb7-db0e-11ef-8ca8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"越王句踐之後。自句踐至無彊，凡六世。句，音鉤。踐，音慈淺翻。","note_content_jianti_auto":"越王句践之后。自句践至无彊，凡六世。句，音钩。践，音慈浅翻。","note_type":"hu_note","start_index":8,"tongjian_id":"8c372cb3-db0e-11ef-a9fc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":136,"tongjian_id":"8c