a-a0d3651f611f"},{"place_name":"錢唐","place_name_jianti_auto":"钱唐","start_index":160,"tongjian_id":"8c372cdd-db0e-11ef-8eb0-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":208,"tongjian_id":"8c372cde-db0e-11ef-acf1-a0d3651f611f"},{"place_name":"甌越","place_name_jianti_auto":"瓯越","start_index":210,"tongjian_id":"8c372cdf-db0e-11ef-ac2b-a0d3651f611f"},{"place_name":"閩越","place_name_jianti_auto":"闽越","start_index":213,"tongjian_id":"8c372ce0-db0e-11ef-b338-a0d3651f611f"},{"place_name":"駱越","place_name_jianti_auto":"骆越","start_index":216,"tongjian_id":"8c372ce1-db0e-11ef-ac3a-a0d3651f611f"},{"place_name":"太末","place_name_jianti_auto":"太末","start_index":239,"tongjian_id":"8c372ce2-db0e-11ef-a736-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"吳之故地，漢會稽、九江、丹楊、豫章、廬江、廣陵、臨淮等郡是也。越初都會稽，其境北至於禦兒，不能全有漢會稽一郡地；及其滅吳，始幷有吳地。今楚取吳地至于浙江，則禦兒亦入于楚矣。浙江有三源：發於太末者謂之穀水，今之衢港是也；發於烏傷者，水經謂之吳寧溪，今之婺港是也；發於黝縣者，班志謂之漸江水，今之徽港是也：三水合爲浙江，東至錢唐入海。浙，折也，言水屈折於羣山之間也。釋名曰：江，共也，小水流入其中，所公共也。國於海上者，漢之甌越、閩越、駱越其後也。浙，之列翻。濱，音賓。會，古外翻。太末之太，孟康音闥。港，古項翻。婺，亡遇翻。黝，音伊。閩，眉巾翻。駱，音洛。","note_content_jianti_auto":"吴之故地，汉会稽、九江、丹杨、豫章、庐江、广陵、临淮等郡是也。越初都会稽，其境北至于御儿，不能全有汉会稽一郡地；及其灭吴，始幷有吴地。今楚取吴地至于浙江，则御儿亦入于楚矣。浙江有三源：发于太末者谓之谷水，今之衢港是也；发于乌伤者，水经谓之吴宁溪，今之婺港是也；发于黝县者，班志谓之渐江水，今之徽港是也：三水合为浙江，东至钱唐入海。浙，折也，言水屈折于群山之间也。释名曰：江，共也，小水流入其中，所公共也。国于海上者，汉之瓯越、闽越、骆越其后也。浙，之列翻。滨，音宾。会，古外翻。太末之太，孟康音闼。港，古项翻。婺，亡遇翻。黝，音伊。闽，眉巾翻。骆，音洛。","note_type":"hu_note","start_index":74,"tongjian_id":"8c372cba-db0e-11ef-85b9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-306,"link_td_description":"無彊為戰國時期越國的君主，《史記索隱》稱為無顓之弟。無顓死後繼承為君主，在位36年（前342年—前306年）。无疆即位后重新振兴了越国，向北進攻齊國，在齊國挑唆下又向西進攻楚國，遭致慘敗，為楚怀王所殺。","link_td_id":"Q10002082","link_td_number_id":489168,"people_name":"越王","people_name_jianti_auto":"越王","start_index":1,"tongjian_id":"8c39b127-db0e-11ef-9de5-a0d3651f611f"},{"link_death_year":-306,"link_td_description":"無彊為戰國時期越國的君主，《史記索隱》稱為無顓之弟。無顓死後繼承為君主，在位36年（前342年—前306年）。无疆即位后重新振兴了越国，向北進攻齊國，在齊國挑唆下又向西進攻楚國，遭致慘敗，為楚怀王所殺。","link_td_id":"Q10002082","link_td_number_id":489168,"people_name":"無彊","people_name_jianti_auto":"无彊","people_xingming":"姒无强","start_index":3,"tongjian_id":"8c39b128-db0e-11ef-945c-a0d3651f611f"},{"link_birth_year":-378,"link_death_year":-320,"link_td_description":"齐威王，妫姓，田氏，名因齐，战国策作婴齐，出土文物作陈侯因齐，田齐君主，为田齐桓公之子。","link_td_id":"Q10002279","link_td_number_id":327054,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田因齐","start_index":8,"tongjian_id":"8c39b12a-db0e-11ef-b47d-a0d3651f611f","wl_zhushi":"[田因齐]"},{"link_death_year":-306,"link_td_description":"無彊為戰國時期越國的君主，《史記索隱》稱為無顓之弟。無顓死後繼承為君主，在位36年（前342年—前306年）。无疆即位后重新振兴了越国，向北進攻齊國，在齊國挑唆下又向西進攻楚國，遭致慘敗，為楚怀王所殺。","link_td_id":"Q10002082","link_td_number_id":489168,"people_name":"越王","people_name_jianti_auto":"越王","people_xingming":"姒无强","start_index":24,"tongjian_id":"8c39b12d-db0e-11ef-bd25-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":6,"tongjian_id":"8c39b129-db0e-11ef-bf17-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":16,"tongjian_id":"8c39b12b-db0e-11ef-b0a0-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":20,"tongjian_id":"8c39b12c-db0e-11ef-86c0-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":28,"tongjian_id":"8c39b12e-db0e-11ef-9b6c-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":30,"tongjian_id":"8c39b12f-db0e-11ef-be20-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","resolved_place_entity_id":30,"start_index":40,"tongjian_id":"8c39b130-db0e-11ef-9111-a0d3651f611f"},{"place_name":"浙江","place_name_jianti_auto":"浙江","resolved_place_entity_id":1573,"start_index":47,"tongjian_id":"8c39b131-db0e-11ef-a0