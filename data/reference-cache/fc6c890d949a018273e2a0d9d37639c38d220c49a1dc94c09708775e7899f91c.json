es":[],"note_content":"楚太子質秦而亡歸，復質於齊；秦以爲言而誘陷其父，齊乘其父出而要之以利。","note_content_jianti_auto":"楚太子质秦而亡归，复质于齐；秦以为言而诱陷其父，齐乘其父出而要之以利。","note_type":"hu_note","start_index":21,"tongjian_id":"8c83cc0c-db0e-11ef-835e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是古代中国的高级官职，通常指中央或诸侯国的官员，负责行政、军事或顾问职责。在《资治通鉴》此段中，'秦大夫'指秦国的官员，与楚太子发生冲突，表明其作为秦国代表参与外交或军事事务。","official_rank":"未知","source_snippet":"秦大夫有私與楚太子鬬者","start_index":2,"tongjian_id":"b87593cd-0d90-419d-91af-f29ede6649f7"}],"ExtRef_Children_people":[{"link_birth_year":-329,"link_death_year":-263,"link_td_description":"楚顷襄王，简称楚顷王或楚襄王，又作楚庄王（与其远祖楚庄王有别），芈姓，熊氏，名横，楚怀王之子，生母为郑袖。","link_td_id":"Q10000653","link_td_number_id":335229,"people_name":"楚太子","people_name_jianti_auto":"楚太子","people_xingming":"芈横","start_index":7,"tongjian_id":"8c83cc12-db0e-11ef-aa35-a0d3651f611f","wl_zhushi":"[芈横]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c83cc13-db0e-11ef-8ebd-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"2秦大夫有私與楚太子鬬者，太子殺之，亡歸。","content_fanyi":"秦国有一位大夫私下与在秦国做人质的楚国太子横争斗，太子横杀了这位大夫后，逃回楚国。","content_jianti_auto":"2秦大夫有私与楚太子鬬者，太子杀之，亡归。","dtjl_paragraph_links":[],"dtjl_references":[],"id":281,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c83cc0b-db0e-11ef-b2f1-a0d3651f611f"}],"reign_name":"十三年","reign_name_jianti_auto":"十三年","start_index":12,"tongjian_id":"8c83cbfb-db0e-11ef-a384-a0d3651f611f","year_anno":"（己未、前三○二）","year_int":-302},"message":"success","success":true}