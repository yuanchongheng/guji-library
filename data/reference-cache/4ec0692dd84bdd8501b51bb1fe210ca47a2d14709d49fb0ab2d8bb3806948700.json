xtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4秋，八月，丙申朔，日有食之。","content_fanyi":"秋季，八月初一日丙申朔，发生日食。","content_jianti_auto":"4秋，八月，丙申朔，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4112,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"95f9d88f-db0e-11ef-a911-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張顯","people_name_jianti_auto":"张显","start_index":26,"tongjian_id":"95f9d892-db0e-11ef-9567-a0d3651f611f"},{"people_name":"嚴授","people_name_jianti_auto":"严授","start_index":49,"tongjian_id":"95f9d893-db0e-11ef-bbfa-a0d3651f611f"},{"people_name":"顯","people_name_jianti_auto":"显","start_index":63,"tongjian_id":"95f9d894-db0e-11ef-b3cf-a0d3651f611f"},{"people_name":"授","people_name_jianti_auto":"授","start_index":68,"tongjian_id":"95f9d895-db0e-11ef-b374-a0d3651f611f"},{"people_name":"授","people_name_jianti_auto":"授","start_index":79,"tongjian_id":"95f9d896-db0e-11ef-b11a-a0d3651f611f"},{"people_name":"顯","people_name_jianti_auto":"显","start_index":89,"tongjian_id":"95f9d897-db0e-11ef-bb47-a0d3651f611f"},{"people_name":"顯","people_name_jianti_auto":"显","start_index":103,"tongjian_id":"95f9d898-db0e-11ef-a476-a0d3651f611f"},{"people_name":"衞福","people_name_jianti_auto":"衞福","start_index":107,"tongjian_id":"95f9d899-db0e-11ef-8178-a0d3651f611f"},{"people_name":"徐咸","people_name_jianti_auto":"徐咸","start_index":112,"tongjian_id":"95f9d89a-db0e-11ef-b5b5-a0d3651f611f"},{"people_name":"顯","people_name_jianti_auto":"显","start_index":118,"tongjian_id":"95f9d89b-db0e-11ef-9408-a0d3651f611f"},{"people_name":"福","people_name_jianti_auto":"福","start_index":123,"tongjian_id":"95f9d89c-db0e-11ef-ba27-a0d3651f611f"},{"people_name":"授","people_name_jianti_auto":"授","start_index":137,"tongjian_id":"95f9d89d-db0e-11ef-8657-a0d3651f611f"},{"people_name":"張顯","people_name_jianti_auto":"张显","start_index":197,"tongjian_id":"95f9d89e-db0e-11ef-8ee6-a0d3651f611f"},{"people_name":"殤帝","people_name_jianti_auto":"殇帝","start_index":208,"tongjian_id":"95f9d89f-db0e-11ef-b533-a0d3651f611f"},{"people_name":"范","people_name_jianti_auto":"范","start_index":216,"tongjian_id":"95f9d8a0-db0e-11ef-945b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":14,"tongjian_id":"95f9d8a1-db0e-11ef-8399-a0d3651f611f"},{"place_name":"漁陽","place_name_jianti_auto":"渔阳","start_index":21,"tongjian_id":"95f9d8a2-db0e-11ef-9d38-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":159,"tongjian_id":"95f9d8a3-db0e-11ef-8f3d-a0d3651f611f"},{"place_name":"漁陽","place_name_jianti_auto":"渔阳","start_index":164,"tongjian_id":"95f9d8a4-db0e-11ef-8e96-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":174,"tongjian_id":"95f9d8a5-db0e-11ef-8397-a0d3651f611f"},{"place_name":"漁陽","place_name_jianti_auto":"渔阳","start_index":183,"tongjian_id":"95f9d8a6-db0e-11ef-8c5e-a0d3651f611f"},{"place_name":"代郡","place_name_jianti_auto":"代郡","start_index":187,"tongjian_id":"95f9d8a7-db0e-11ef-9d8f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：獨行傳云：「元初中，鮮卑數百餘騎寇漁陽，太守張顯率吏士追出塞，遙望虜營煙火，急趣之。兵馬掾嚴授慮有伏兵，苦諫止，不聽。顯䠞令進，授不獲已前戰，伏兵發，授身被十創，沒於陣。顯拔刃追散兵，不能制，虜射中顯，主簿衞福、功曹徐咸遽趣之，顯遂墮馬，福以身擁蔽，虜幷殺之。朝廷愍授等節，詔書褒歎，厚加賞賜。」按元初凡六年，鮮卑不曾犯漁陽，殺長吏；惟是入代郡曾殺長吏。今疑漁陽本是代郡，史之誤也。余按張顯事，通鑑已書於上卷殤帝延平元年，從范書·帝紀也。","note_content_jianti_auto":"考异曰：独行传云：「元初中，鲜卑数百余骑寇渔阳，太守张显率吏士追出塞，遥望虏营烟火，急趣之。兵马掾严授虑有伏兵，苦谏止，不听。显䠞令进，授不获已前战，伏兵发，授身被十创，没于阵。显拔刃追散兵，不能制，虏射中显，主簿衞福、功曹徐咸遽趣之，显遂堕马，福以身拥蔽，虏幷杀之。朝廷愍授等节，诏书褒叹，厚加赏赐。」按元初凡六年，鲜卑不曾犯渔阳，杀长吏；惟是入代郡曾杀长吏。今疑渔阳本是代郡，史之误也。余按张显事，通鉴已书于上卷殇帝延平元年，从范书·帝纪也。","note_type":"hu_note","start_index":12,"tongjian_id":"95f9d891-db0e-11ef-bca1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"居庸縣","place_name_jianti_auto":"居庸县","start_index":4,"tongjian_id":"95f9d8ad-db0e-11ef-8a35-a0d3651f611f"},{"place_name":"上谷郡","place_name_jianti_auto":"上谷郡","start_index":9,"tongjian_id":"95f9d8ae-db0e-11ef-bf73-a0d3651f611f"},{"place_name":"幽州","place_name_jianti_auto":"幽州","start_index":17,"tongjian_id":"95f9d8af-db0e-11ef-b60d-a0d3651f611f"},{"place_name":"昌平縣","place_name_jianti_auto":"昌平县","start_index":19,"tongjian_id":"95f9d8b0-db0e-11ef-abc7-a0d3651f611f"},{"place_name":"納款關","place_name_jianti_auto":"纳款关","start_index":30,"tongjian_id":"95f9d8b1-db0e-11ef-933c-a0d3651f611f"},{"place_name":"居庸","place_name_jianti_auto":"居庸","start_index":35,"tongjian_id":"95f9d8b2-db0e-11ef-9f7d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郡國志：居庸縣，屬上谷郡。新唐志：幽州昌平縣西北三十五里，有納款關，卽居庸故關。","note_content_jianti_auto":"郡国志：居庸县，属上谷郡。新唐志：幽州昌平县西北三十五里，有纳款关，即居庸故关。","note_type":"hu_note","start_index":45,"tongjian_id":"95f9d8ac-db0e-11ef-b85d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"長吏","official_note":"長吏泛指地方官員，如郡守、縣令等，在漢代通常指郡縣的長官或高級屬吏。此處指代郡的官員被鮮卑殺害，顯示邊境衝突的嚴重性。","official_rank":"未知","source_snippet":"殺長吏","start_index":8,"tongjian_id":"d05ffbcf-64b0-45b0-ade2-b8fad9408346"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"代郡","place_name_jianti_auto":"代郡","resolved_place_entity_id":239,"start_index":1,"tongjian_id":"95f9d8b6-db0e-11ef-917d-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","resolved_place_entity_id":218,"start_index":3,"tongjian_id":"95f9d8b7-db0e-11ef-bff0-a0d3651f611f"},{"place_name":"黎陽營","place_name_jianti_auto":"黎阳营","resolved_place_entity_id":5579,"start_index":18,"tongjian_id":"95f9d8b8-db0e-11ef-b2c9-a0d3651f611f"},{"place_name":"上谷","place_name_jianti_auto":"上谷","resolved_place_entity_id":502,"start_index":23,"tongjian_id":"95f9d8b9-db0e-11ef-bfce-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","resolved_place_entity_id":218,"start_index":34,"tongjian_id":"95f9d8ba-db0e-11ef-a178-a0d3651f611f"},{"place_name":"上谷","place_name_jianti_auto":"上谷","resolved_place_entity_id":502,"start_index":37,"tongjian_id":"95f9d8bb-db0e-11ef-8e9e-a0d3651f611f"},{"place_name":"居庸關","place_name_jianti_auto":"居庸关","resolved_place_entity_id":2264,"start_index":41,"tongjian_id":"95f9d8bc-db0e-11ef-b267-a0d3651f611f"},{"place_name":"黎陽營","place_name_jianti_auto":"黎阳营","resolved_place_entity_id":5579,"start_index":51,"tongjian_id":"95f9d8bd-db0e-11ef-8c35-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与鲜卑的战争","tongjian_id":"war_N0613"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"建光初，复寇居庸关。初平四年，幽州牧刘虞遣掾田畴奉章诣长...","context_before":"...。建武十五年，以匈奴犯塞，迁代、上谷诸郡民于居庸关以东。","source_end_index":455,"source_paragraph_tongjian_id":"50ad45d6-4fec-5168-92d7-ca3941ef347d","source_start_index":438,"source_text":"安帝元初五年，鲜卑犯塞，屡寇上谷。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","excerpts":[{"context_after":"桓帝时，鲜卑益强，其长檀石槐立庭于代郡高柳北三百余里弹汗...","context_before":"...据其地。匈奴余种留者十余万落，皆自号鲜卑，鲜卑由此渐盛。","source_end_index":139,"source_paragraph_tongjian_id":"7548135d-52d9-5001-b976-56cea81f634a","source_start_index":122,"source_text":"安帝时，屡寇代郡上谷以东，为边患。"}],"path":"北直方舆纪要/十一、万全都指挥使司开平、大宁二卫及诸裔附（卷十八）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"5代郡鮮卑入寇，殺長吏；發緣邊甲卒、黎陽營兵屯上谷以備之。冬，十月，鮮卑寇上谷，攻居庸關，復發緣邊諸郡黎陽營兵、積射士步騎二萬人，屯列衝要。","content_fanyi":"代郡的鲜卑人入侵，杀害地方长吏；朝廷征发沿边甲卒、黎阳营兵屯驻上谷，以防范鲜卑。冬季，十月，鲜卑人侵犯上谷，攻打居庸关，朝廷再次征发沿边各郡及黎阳营兵、积射士等步骑兵共二万人，屯驻于各处冲要。","content_jianti_auto":"5代郡鲜卑入寇，杀长吏；发缘边甲卒、黎阳营兵屯上谷以备之。冬，十月，鲜卑寇上谷，攻居庸关，复发缘边诸郡黎阳营兵、积射士步骑二万人，屯列冲要。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4113,"number":5,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":4,"tongjian_id":"95f9d890-db0e-11ef-9327-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否招募羌人刺杀狼莫以平定叛乱","decision_tongjian_id":"DECISION_95F9D8BEDB0E11EFA7DAA0D3651F611F_01"},{"decision_name":"如何应对儿子收受罪将贿赂的丑闻","decision_tongjian_id":"DECISION_95F9D8BEDB0E11EFA7DAA0D3651F611F_03"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"羌","place_name_jianti_auto":"羌","start_index":4,"tongjian_id":"95f9d8c1-db0e-11ef-bc68-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"永初元年羌叛，至是年凡十二年。","note_content_jianti_auto":"永初元年羌叛，至是年凡十二年。","note_type":"hu_note","start_index":32,"tongjian_id":"95f9d8c0-db0e-11ef-b337-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":0,"tongjian_id":"95f9d8c5-db0e-11ef-aecf-a0d3651f611f"},{"place_name":"東武陽","place_name_jianti_auto":"东武阳","start_index":3,"tongjian_id":"95f9d8c6-db0e-11ef-908a-a0d3651f611f"},{"place_name":"泰山郡","place_name_jianti_auto":"泰山郡","start_index":7,"tongjian_id":"95f9d8c7-db0e-11ef-b6bd-a0d3651f611f"},{"place_name":"南武陽","place_name_jianti_auto":"南武阳","start_index":11,"tongjian_id":"95f9d8c8-db0e-11ef-bf76-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東郡有東武陽，泰山郡有南武陽，鄧騭傳又作「舞陽」。","note_content_jianti_auto":"东郡有东武阳，泰山郡有南武阳，邓骘传又作「舞阳」。","note_type":"hu_note","start_index":110,"tongjian_id":"95f9d8c4-db0e-11ef-bbce-a0d3651f611f"}],"ExtRef_Childr