":23,"tongjian_id":"93384f83-db0e-11ef-975b-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":73,"tongjian_id":"93384f84-db0e-11ef-a94c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"海曲縣","place_name_jianti_auto":"海曲县","start_index":49,"tongjian_id":"93384f85-db0e-11ef-b5bf-a0d3651f611f"},{"place_name":"海曲縣","place_name_jianti_auto":"海曲县","start_index":65,"tongjian_id":"93384f86-db0e-11ef-ac50-a0d3651f611f"},{"place_name":"琅邪郡","place_name_jianti_auto":"琅邪郡","start_index":69,"tongjian_id":"93384f87-db0e-11ef-b5ec-a0d3651f611f"},{"place_name":"密州","place_name_jianti_auto":"密州","start_index":79,"tongjian_id":"93384f88-db0e-11ef-96ae-a0d3651f611f"},{"place_name":"莒縣","place_name_jianti_auto":"莒县","start_index":81,"tongjian_id":"93384f89-db0e-11ef-bff8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"莽改縣令長曰宰。初，呂母子爲縣吏，爲宰所冤殺；母散家財，以酤酒買弓弩，陰厚貧窮少年，得百餘人，遂攻海曲縣，殺其宰以祭子墓。地理志，海曲縣屬琅邪郡。賢曰：故城在密州莒縣東。","note_content_jianti_auto":"莽改县令长曰宰。初，吕母子为县吏，为宰所冤杀；母散家财，以酤酒买弓弩，阴厚贫穷少年，得百余人，遂攻海曲县，杀其宰以祭子墓。地理志，海曲县属琅邪郡。贤曰：故城在密州莒县东。","note_type":"hu_note","start_index":273,"tongjian_id":"93384f80-db0e-11ef-b157-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":32,"tongjian_id":"93384f8c-db0e-11ef-9ddd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":0,"tongjian_id":"93384f8d-db0e-11ef-8ee1-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":3,"tongjian_id":"93384f8e-db0e-11ef-af35-a0d3651f611f"},{"place_name":"南郡","place_name_jianti_auto":"南郡","start_index":6,"tongjian_id":"93384f8f-db0e-11ef-9f0f-a0d3651f611f"},{"place_name":"桂陽","place_name_jianti_auto":"桂阳","start_index":9,"tongjian_id":"93384f90-db0e-11ef-a61f-a0d3651f611f"},{"place_name":"武陵","place_name_jianti_auto":"武陵","start_index":12,"tongjian_id":"93384f91-db0e-11ef-9585-a0d3651f611f"},{"place_name":"零陵","place_name_jianti_auto":"零陵","start_index":15,"tongjian_id":"93384f92-db0e-11ef-a645-a0d3651f611f"},{"place_name":"江夏","place_name_jianti_auto":"江夏","start_index":18,"tongjian_id":"93384f93-db0e-11ef-ae52-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"荊州部南陽、南郡、桂陽、武陵、零陵、江夏等郡。爾雅曰：芍，鳧茈。郭璞曰：生下田中，苗似龍鬚而細，根如指；根黑色，可食。茈，音才支翻。芍，音胡了翻。","note_content_jianti_auto":"荆州部南阳、南郡、桂阳、武陵、零陵、江夏等郡。尔雅曰：芍，凫茈。郭璞曰：生下田中，苗似龙须而细，根如指；根黑色，可食。茈，音才支翻。芍，音胡了翻。","note_type":"hu_note","start_index":300,"tongjian_id":"93384f8b-db0e-11ef-b0c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王沈","people_name_jianti_auto":"王沈","start_index":25,"tongjian_id":"93384f97-db0e-11ef-9f44-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"新市縣","place_name_jianti_auto":"新市县","start_index":4,"tongjian_id":"93384f98-db0e-11ef-ae98-a0d3651f611f"},{"place_name":"江夏郡","place_name_jianti_auto":"江夏郡","start_index":8,"tongjian_id":"93384f99-db0e-11ef-86f6-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":24,"tongjian_id":"93384f9a-db0e-11ef-88b3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"地理志，新市縣屬江夏郡。爲，于僞翻。諍，與爭同。晉王沈釋時論，闒茸勇敢於饕諍，叶韻平聲。古字多假借用也。","note_content_jianti_auto":"地理志，新市县属江夏郡。为，于伪翻。诤，与争同。晋王沈释时论，阘茸勇敢于饕诤，叶韵平声。古字多假借用也。","note_type":"hu_note","start_index":319,"tongjian_id":"93384f96-db0e-11ef-82d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔安國","people_name_jianti_auto":"孔安国","start_index":0,"tongjian_id":"93384f9e-db0e-11ef-a211-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孔安國曰：渠，大也。帥，所類翻。","note_content_jianti_auto":"孔安国曰：渠，大也。帅，所类翻。","note_type":"hu_note","start_index":330,"tongjian_id":"93384f9d-db0e-11ef-8f89-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"93384fa0-db0e-11ef-b1eb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"離鄕聚","place_name_jianti_auto":"离鄕聚","start_index":3,"tongjian_id":"93384fa1-db0e-11ef-971f-a0d3651f611f"},{"place_name":"離鄕","place_name_jianti_auto":"离鄕","start_index":34,"tongjian_id":"93384fa2-db0e-11ef-a8ba-a0d3651f611f"},{"place_name":"綠林山","place_name_jianti_auto":"绿林山","start_index":47,"tongjian_id":"93384fa3-db0e-11ef-a0b5-a0d3651f611f"},{"place_name":"荊州","place_name_jianti_auto":"荆州","start_index":53,"tongjian_id":"93384fa4-db0e-11ef-bf37-a0d3651f611f"},{"place_name":"當陽縣","place_name_jianti_auto":"当阳县","start_index":55,"tongjian_id":"93384fa5-db0e-11ef-be18-a0d3651f611f"},{"place_name":"新市侯國","place_name_jianti_auto":"新市侯国","start_index":67,"tongjian_id":"93384fa6-db0e-11ef-9e4a-a0d3651f611f"},{"place_name":"離鄕聚","place_name_jianti_auto":"离鄕聚","start_index":72,"tongjian_id":"93384fa7-db0e-11ef-9bf5-a0d3651f611f"},{"place_name":"綠林山","place_name_jianti_auto":"绿林山","start_index":76,"tongjian_id":"93384fa8-db0e-11ef-a9c5-a0d3651f611f"},{"place_name":"離鄕","place_name_jianti_auto":"离鄕","start_index":82,"tongjian_id":"93384fa9-db0e-11ef-af86-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：離鄕聚，謂諸鄕聚離散。去城郭遠者，大曰鄕，小曰聚。前書曰：收合離鄕，置大城中，卽其義也。綠林山，在今荊州當陽縣東北。余按郡國志，新市侯國有離鄕聚、綠林山。則以離鄕爲聚名。聚，才喻翻。臧，古藏字。","note_content_jianti_auto":"贤曰：离鄕聚，谓诸鄕聚离散。去城郭远者，大曰鄕，小曰聚。前书曰：收合离鄕，置大城中，即其义也。绿林山，在今荆州当阳县东北。余按郡国志，新市侯国有离鄕聚、绿林山。则以离鄕为聚名。聚，才喻翻。臧，古藏字。","note_type":"hu_note","start_index":368,"tongjian_id":"93384f9f-db0e-11ef-972a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卽，就也；就其相聚爲盜處而赦之也。","note_content_jianti_auto":"即，就也；就其相聚为盗处而赦之也。","note_type":"hu_note","start_index":409,"tongjian_id":"93384fac-db0e-11ef-b987-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"财政","official_name":"羲和命士","official_note":"羲和命士是王莽时期设置的官职，负责监督五均、六筦等经济政策，旨在管理市场物价和税收，但在此文中，这些官员与富贾勾结，导致府藏不实，百姓困苦。","official_rank":"未知","source_snippet":"莽置羲和命士","start_index":1,"tongjian_id":"5965ab69-fab3-4b11-8549-2d760b63166a"},{"confidence":0.85,"official_category":"地方行政","official_name":"宰","official_note":"宰是汉代地方行政长官，通常指县令或县长，负责管理一县事务。在此文中，海曲宰被吕母所杀，反映了地方官吏与民众的冲突。","official_rank":"未知","source_snippet":"殺海曲宰","start_index":290,"tongjian_id":"f91d36d9-bc49-4fd2-86c3-097e14591899"},{"confidence":0.8,"official_category":"军事指挥","official_name":"渠帥","official_note":"渠帅是古代对起义军或盗贼首领的称呼，非正式官职，但在此文中指王匡、王凤被推举为绿林军的领袖，领导民众反抗。","official_rank":"未知","source_snippet":"遂推爲渠帥","start_index":340,"tongjian_id":"13434387-80a7-4dc2-a65b-6caa6cbdc3a6"},{"confidence":0.85,"official_category":"中枢机构","official_name":"使者","official_note":"使者是汉代皇帝或中央派出的官员，负责传达命令、巡视地方或处理特定事务。在此文中，王莽派遣使者去赦免盗贼，但使者回报后反被免官，反映了王莽政策的反复和官吏的困境。","official_rank":"未知","source_snippet":"莽遣使者","start_index":420,"tongjian_id":"397c6d38-c2e9-4c63-a6a2-5c9766492ab6"}],"ExtRef_Children_people":[{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","people_xingming":"王莽","start_index":1,"tongjian_id":"9339bc5d-db0e-11ef-b4a5-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","start_index":63,"tongjian_id":"9339bc5e-db0e-11ef-b7b3-a0d3651f611f"},{"people_name":"馮常","people_name_jianti_auto":"冯常","people_xingming":"冯常","start_index":132,"tongjian_id":"9339bc5f-db0e-11ef-88c8-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","start_index":139,"tongjian_id":"9339bc60-db0e-11ef-824b-a0d3651f611f"},{"link_death_year":36,"link_td_description":"王常，字颜卿。豫州颍川郡舞阳县人，新朝、东汉初期武将，东汉草创期功臣之一。最初是绿林军部将、下江军头领、更始帝刘玄属下武将。","link_td_id":"Q10011536","link_td_number_id":1277922,"people_name":"常","people_name_jianti_auto":"常","people_xingming":"冯常","start_index":144,"tongjian_id":"9339bc61-db0e-11ef-8ed5-a0d3651f611f"},{"link_birth_year":-45,"link_death_year":23,"link_td_description":"王莽，字巨君，魏郡元城貴鄉（今河北邯郸大名縣東）人，篡夺汉朝自立，不被承认的僭主，是西漢末年政治人物、外戚及權臣。他最終以「假皇帝」（代理皇帝）身份登基並建立新朝，自称“皇帝”。稱帝後的王莽大舉推行向周朝看齊的復古改革，引發社會動盪，再加上黃河改道等天災，以致各地豪強紛起，亦有民變发生，新朝僅14年就被推翻，王莽也被叛軍所殺。文獻記載王莽身高七尺五寸（大約173公分）。他終其一生都自奉甚儉、治家嚴苛，曾先後命三名行為不端的嫡子自盡。","link_td_id":"Q10008016","link_td_number_id":16053,"people_name":"莽","people_name_jianti_auto":"莽","start_index":191,"tongjian_id":"9339bc62-db0e-11ef-8a7f-a0d3651f611f"},{"link_birth_year":-99,"link_death_year":21,"link_td_description":"瓜田仪，新朝临淮郡（今江苏省盱眙县西北）人。姓瓜田，名仪。新朝天凤四年（17年）在会稽郡长洲率先起义，反抗王莽统治，部众达万余人。地皇二年（21年）上书愿降，未出而死。","link_td_id":"Q10019911","link_td_number_id":6039674,"people_name":"瓜田儀","people_name_jianti_auto":"瓜田仪","people_xingming":"瓜田仪","start_index":242,"tongjian_id":"9339bc63-db0e-11ef-81eb-a0d3651f611f"},{"link_death_year":18,"link_td_description":"吕母，姓名不详，新朝琅邪海曲（今山东省日照市境内）人，她的儿子吕育做县吏，被县官杀死。吕母尽散家财，招募近万人。在天凤四年（17年），杀县官复仇，自称将军，开启了王莽末年民变的序幕。她去世后，部属大多加入赤眉军。与迟昭平都是当时的新朝民变女领袖。","link_td_id":"Q10012705","link_td_number_id":1499007,"people_name":"呂母","people_name_jianti_auto":"吕母","people_xingming":"吕母","start_index":254,"tongjian_id":"9339bc67-db0e-11ef-bea5-a0d3651f611f"},{"link_death_year":26,"link_td_description":"王匡，荆州江夏郡新市（今湖北京山）人，新朝末年政治人物，绿林军首领。","link_td_id":"Q10013149","link_td_number_id":1570467,"people_name":"王匡","people_name_jianti_auto":"王匡","people_xingming":"王匡","start_index":308,"tongjian_id":"9339bc6b-db0e-11ef-9321-a0d3651f611f"},{"link_td_description":"王凤，新朝末年荆州江夏郡新市（今湖北京山）人，绿林军首领。","link_td_id":"Q10013144","link_td_number_id":1570469,"people_name":"王鳳","people_name_jianti_auto":"王凤","people_xingming":"王凤","start_index":311,"tongjian_id":"9339bc6c-db0e-11ef-bc2a-a0d3651f611f"},{"link_death_year":61,"link_td_description":"马武，字子张，南阳郡湖阳（今河南唐河湖阳镇）人，东汉“云台二十八将”之一。","link_td_id":"Q10006249","link_td_number_id":942194,"people_name":"馬武","people_name_jianti_auto":"马武","people_xingming":"马武","start_index":338,"tongjian_id":"9339bc6e-db0e-11ef-9449-a0d3651f611f"},{"link_death_year":36,"link_td_description":"王常，字颜卿。豫州颍川郡舞阳县人，新朝、东汉初期武将，东汉草创期功臣之一。最初是绿林军部将、下江军头领、更始帝刘玄属下武将。","link_td_id":"Q10011536","link_td_number_id":1277922,"people_name":"王常","people_name_jianti_auto":"王常","people_xingming":"王常","start_index":343,"tongjian_id":"9339bc6f-db0e-11ef-b169-a0d3651f611f"},{"link_death_year":25,"link_td_description":"成丹，中国两汉之际緑林軍創始期部将，更始帝劉玄属下大臣。","link_td_id":"Q10018163","link_td_number_id":5430464,"people_name":"成丹","people_name_jianti_auto":"成丹","people_xingming":"成丹","start_index":346,"tongjian_id":"9339bc70-db0e-11ef-a1a2-a0d3651f611f"},{"people_name":"張霸","people_name_jianti_auto":"张霸","people_xingming":"张霸","start_index":381,"tongjian_id":"9339b