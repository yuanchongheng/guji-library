_auto":"颍川","start_index":22,"tongjian_id":"8c83cc1e-db0e-11ef-a6d1-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":28,"tongjian_id":"8c83cc1f-db0e-11ef-ac7e-a0d3651f611f"},{"place_name":"穰","place_name_jianti_auto":"穰","start_index":52,"tongjian_id":"8c83cc20-db0e-11ef-b6e9-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":54,"tongjian_id":"8c83cc21-db0e-11ef-ac80-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，穰縣屬南陽郡。以時考之，當屬楚。然韓得潁川之地，與南陽接境，七國兵爭，疆埸之間，一彼一此，或者此時穰屬韓歟？穰，人羊翻。","note_content_jianti_auto":"班志，穰县属南阳郡。以时考之，当属楚。然韩得颍川之地，与南阳接境，七国兵争，疆埸之间，一彼一此，或者此时穰属韩欤？穰，人羊翻。","note_type":"hu_note","start_index":7,"tongjian_id":"8c83cc18-db0e-11ef-bdb2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c83cc23-db0e-11ef-8c3a-a0d3651f611f"},{"place_name":"韓穰","place_name_jianti_auto":"韩穰","place_note":"河南鄧州","resolved_place_entity_id":9809,"start_index":4,"tongjian_id":"8c83cc24-db0e-11ef-a670-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、南阳府（卷五十一）","excerpts":[{"context_after":"又秦武王十六年，封魏冉于此，为穰侯。昭王二十四年，与楚会...","context_before":"○穰县城[州东南二里。战国时属楚，后为韩邑。","source_end_index":39,"source_paragraph_tongjian_id":"0a81dfdc-df97-5a98-a4fc-f76d4f46ce4d","source_start_index":22,"source_text":"《史记》：韩襄王十一年，秦取我穰。"}],"path":"河南方舆纪要/八、南阳府（卷五十一）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2秦人取韓穰。","content_fanyi":"秦国军队攻取了韩国的穰城。","content_jianti_auto":"2秦人取韩穰。","dtjl_paragraph_links":[],"dtjl_references":[],"id":283,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c83cc17-db0e-11ef-a20d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"煇","people_name_jianti_auto":"𪸩","start_index":29,"tongjian_id":"8c83cc27-db0e-11ef-a01c-a0d3651f611f"},{"people_name":"蜀侯","people_name_jianti_auto":"蜀侯","start_index":31,"tongjian_id":"8c83cc28-db0e-11ef-91e9-a0d3651f611f"},{"people_name":"蜀侯","people_name_jianti_auto":"蜀侯","start_index":34,"tongjian_id":"8c83cc29-db0e-11ef-b6db-a0d3651f611f"},{"people_name":"司馬錯","people_name_jianti_auto":"司马错","start_index":58,"tongjian_id":"8c83cc2a-db0e-11ef-895e-a0d3651f611f"},{"people_name":"煇","people_name_jianti_auto":"𪸩","start_index":62,"tongjian_id":"8c83cc2b-db0e-11ef-97bc-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":0,"tongjian_id":"8c83cc2c-db0e-11ef-b237-a0d3651f611f"},{"place_name":"蜀郡","place_name_jianti_auto":"蜀郡","start_index":3,"tongjian_id":"8c83cc2d-db0e-11ef-a650-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":25,"tongjian_id":"8c83cc2e-db0e-11ef-a008-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蜀守，蜀郡守也。史記·秦紀作「蜀侯」。華陽國志曰：秦封王子煇爲蜀侯。蜀侯祭，歸胙於王；後母疾之，加毒以進。王大怒，使司馬錯賜煇劍。守，音狩。煇，索隱音暉。","note_content_jianti_auto":"蜀守，蜀郡守也。史记·秦纪作「蜀侯」。华阳国志曰：秦封王子𪸩为蜀侯。蜀侯祭，归胙于王；后母疾之，加毒以进。王大怒，使司马错赐𪸩剑。守，音狩。𪸩，索隐音晖。","note_type":"hu_note","start_index":15,"tongjian_id":"8c83cc26-db0e-11ef-9776-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"蜀守","official_note":"蜀守是秦朝在蜀地设置的郡守官职，负责地方行政和军事管理，此处指蜀守煇背叛秦国。","official_rank":"未知","source_snippet":"蜀守煇叛秦","start_index":3,"tongjian_id":"4bb1cfbc-33f5-402a-a218-26097e08c08c"},{"confidence":0.85,"official_category":"军事指挥","official_name":"司馬錯","official_note":"司馬錯是秦国的将领，此处指他奉命前往诛杀叛乱的蜀守煇，在资治通鉴中常作为军事指挥官出现。","official_rank":"未知","source_s