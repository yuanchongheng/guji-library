11ef-a2f9-a0d3651f611f"},{"place_name":"重丘","place_name_jianti_auto":"重丘","start_index":132,"tongjian_id":"8c83cc57-db0e-11ef-b649-a0d3651f611f"},{"place_name":"茈丘","place_name_jianti_auto":"茈丘","start_index":135,"tongjian_id":"8c83cc58-db0e-11ef-b77e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐姓本於唐堯。春秋之時，有二重丘：衞孫蒯飲馬於重丘，杜預曰：曹邑；諸侯同盟于重丘，杜預曰：齊地。時楚之境皆不至此。呂氏春秋曰：齊令章子與韓、魏攻荊，荊使唐薎將兵應之，夾泚而軍；章子夜襲之，斬薎於是水之上。水經註曰：泚水又西，澳水注之。水北出茈丘山，南入于泚水。意者重丘卽茈丘也。敗，補邁翻。將，卽亮翻。「昩」，荀子作「蔑」，楊倞註曰：與「昩」同，語音相近，當音末。索隱音莫葛翻。重，直龍翻。茈，才支翻。","note_content_jianti_auto":"唐姓本于唐尧。春秋之时，有二重丘：衞孙蒯饮马于重丘，杜预曰：曹邑；诸侯同盟于重丘，杜预曰：齐地。时楚之境皆不至此。吕氏春秋曰：齐令章子与韩、魏攻荆，荆使唐薎将兵应之，夹泚而军；章子夜袭之，斩薎于是水之上。水经注曰：泚水又西，澳水注之。水北出茈丘山，南入于泚水。意者重丘即茈丘也。败，补迈翻。将，即亮翻。「昩」，荀子作「蔑」，杨倞注曰：与「昩」同，语音相近，当音末。索隐音莫葛翻。重，直龙翻。茈，才支翻。","note_type":"hu_note","start_index":33,"tongjian_id":"8c83cc3a-db0e-11ef-8545-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"庶長","official_note":"庶長是秦國官職，主要負責軍事指揮，此處指秦國將領奐率領軍隊與其他國家聯合伐楚。","official_rank":"未知","source_snippet":"秦庶長奐","start_index":1,"tongjian_id":"c4d6912f-496e-4e0d-84be-e0414277a043"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將","official_note":"將是楚國的軍事官職，此處指楚國將領唐昩在戰爭中被殺。","official_rank":"未知","source_snippet":"殺其將唐昩","start_index":24,"tongjian_id":"1aea48b3-fc04-4c37-8331-21b0f1c8591b"}],"ExtRef_Children_people":[{"link_td_description":"庶长奂，战国时期秦国将领，官至庶长。","link_td_id":"Q10021341","link_td_number_id":7200761,"people_name":"奐","people_name_jianti_auto":"奂","people_xingming":"奂","start_index":4,"tongjian_id":"8c83cc5e-db0e-11ef-98f0-a0d3651f611f"},{"people_name":"唐昩","people_name_jianti_auto":"唐昩","people_xingming":"唐昩","start_index":25,"tongjian_id":"8c83cc64-db0e-11ef-97fa-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c83cc5f-db0e-11ef-9afc-a0d3651f611f"},{"