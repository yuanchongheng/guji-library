ote":"居風令是漢代地方縣級長官，負責治理居風縣，此處因貪暴導致民變。","official_rank":"未知","source_snippet":"居風令貪暴無度","start_index":0,"tongjian_id":"89cd8919-3443-4745-b781-03ba8b086a9d"},{"confidence":0.9,"official_category":"地方行政","official_name":"九眞太守","official_note":"九眞太守是漢代郡級行政長官，負責管理九眞郡，此處在叛亂中戰死。","official_rank":"未知","source_snippet":"九眞太守兒式戰死","start_index":38,"tongjian_id":"def804b4-0ae7-4acc-8958-4af9331666df"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"九眞都尉","official_note":"九眞都尉是漢代郡級軍事長官，負責鎮守和征討，此處受命平定叛亂。","official_rank":"未知","source_snippet":"詔九眞都尉魏朗討破之","start_index":48,"tongjian_id":"5f277e05-d4df-48c0-84c0-00bae517c92a"}],"ExtRef_Children_people":[{"people_name":"朱達","people_name_jianti_auto":"朱达","people_xingming":"朱达","start_index":11,"tongjian_id":"96f065c2-db0e-11ef-9bee-a0d3651f611f"},{"people_name":"兒式","people_name_jianti_auto":"儿式","people_xingming":"兒式","start_index":46,"tongjian_id":"96f065c3-db0e-11ef-89ef-a0d3651f611f"},{"people_name":"魏朗","people_name_jianti_auto":"魏朗","people_xingming":"魏朗","start_index":56,"tongjian_id":"96f065c6-db0e-11ef-8e60-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"居風","place_name_jianti_auto":"居风","resolved_place_entity_id":4543,"start_index":1,"tongjian_id":"96f065c1-db0e-11ef-aa1c-a0d3651f611f"},{"place_name":"九眞","place_name_jianti_auto":"九真","resolved_place_entity_id":1017,"start_index":39,"tongjian_id":"96f065c4-db0e-11ef-be1a-a0d3651f611f"},{"place_name":"九眞","place_name_jianti_auto":"九真","resolved_place_entity_id":1017,"start_index":42,"tongjian_id":"96f065c5-db0e-11ef-9c51-a0d3651f611f"},{"place_name":"九眞","place_name_jianti_auto":"九真","resolved_place_entity_id":1017,"start_index":52,"tongjian_id":"96f065c7-db0e-11ef-bf67-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"2居風令貪暴無度，縣人朱達等與蠻夷同反，攻殺令，聚衆至四五千人。夏，四月，進攻九眞，九眞太守兒式戰死。詔九眞都尉魏朗討破之。","content_fanyi":"居风县令贪婪暴虐，毫无节制。县民朱达等人与蛮夷一同造反，杀死县令，聚众达四五千人。夏季四月，他们进攻九真，九真太守兒式战死。桓帝下诏，命九真都尉魏朗率军讨伐，击溃了叛军。","content_jianti_auto":"2居风令贪暴无度，县人朱达等与蛮夷同反，攻杀令，聚众至四五千人。夏，四月，进攻九真，九真太守儿式战死。诏九真都尉魏朗讨破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4578,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"96f065bb-db0e-11ef-9f6c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3閏月，庚辰晦，日有食之。","content_fanyi":"闰五月的庚辰晦日，发生了日食。","content_jianti_auto":"3闰月，庚辰晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4579,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"96f065c8-db0e-11ef-bffb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":56,"start_index":1,"tongjian_id":"96f065ca-db0e-11ef-bdc6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3京師蝗。","content_fanyi":"京城洛阳发生蝗灾。","content_jianti_auto":"3京师蝗。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4580,"number":3,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"96f065c9-db0e-11ef-b7f5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"下，遐稼翻。四府，三公府及大將軍府。","note_content_jianti_auto":"下，遐稼翻。四府，三公府及大将军府。","note_type":"hu_note","start_index":27,"tongjian_id":"96f065cc-db0e-11ef-92a5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"96f065cf-db0e-11ef-990c-a0d3651f611f"},{"people_name":"和","people_name_jianti_auto":"和","start_index":11,"tongjian_id":"96f065d0-db0e-11ef-b19f-a0d3651f611f"},{"people_name":"卞和","people_name_jianti_auto":"卞和","start_index":14,"tongjian_id":"96f065d1-db0e-11ef-8091-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：詩曰：大賂南金。和玉，卞和之玉。礫，郞狄翻。","note_content_jianti_auto":"贤曰：诗曰：大赂南金。和玉，卞和之玉。砾，郞狄翻。","note_type":"hu_note","start_index":127,"tongjian_id":"96f065ce-db0e-11ef-a99a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"天皇氏","people_name_jianti_auto":"天皇氏","start_index":6,"tongjian_id":"96f065d4-db0e-11ef-8b1f-a0d3651f611f"},{"people_name":"伏羲氏","people_name_jianti_auto":"伏羲氏","start_index":21,"tongjian_id":"96f065d5-db0e-11ef-a1c2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"天地初立，有天皇氏，澹泊無所施爲而民自化。伏羲氏始畫八卦，造書契以代結繩之政。去洪荒之世未遠，故其風朴略。","note_content_jianti_auto":"天地初立，有天皇氏，澹泊无所施为而民自化。伏羲氏始画八卦，造书契以代结绳之政。去洪荒之世未远，故其风朴略。","note_type":"hu_note","start_index":148,"tongjian_id":"96f065d3-db0e-11ef-9905-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":0,"tongjian_id":"96f065d7-db0e-11ef-81f1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄭氏曰：蕭，肅也。牆，謂屛也。君臣相見之禮，至屛而加肅敬焉，是以謂之蕭牆。","note_content_jianti_auto":"郑氏曰：萧，肃也。墙，谓屛也。君臣相见之礼，至屛而加肃敬焉，是以谓之萧墙。","note_type":"hu_note","start_index":166,"tongjian_id":"96f065d6-db0e-11ef-ac80-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈誼","people_name_jianti_auto":"贾谊","start_index":0,"tongjian_id":"96f065d9-db0e-11ef-bf7e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賈誼服賦之言。","note_content_jianti_auto":"贾谊服赋之言。","note_type":"hu_note","start_index":246,"tongjian_id":"96f065d8-db0e-11ef-8995-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"厭，於鹽翻；下同。","note_content_jianti_auto":"厌，于盐翻；下同。","note_type":"hu_note","start_index":268,"tongjian_id":"96f065db-db0e-11ef-99aa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"揚子曰：君人者務在殷民阜財。","note_content_jianti_auto":"扬子曰：君人者务在殷民阜财。","note_type":"hu_note","start_index":275,"tongjian_id":"96f065dc-db0e-11ef-a18e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":5,"tongjian_id":"96f065e1-db0e-11ef-8f4d-a0d3651f611f"},{"people_name":"堯","people_name_jianti_auto":"尧","start_index":13,"tongjian_id":"96f065e2-db0e-11ef-8f40-a0d3651f611f"},{"people_name":"堯","people_name_jianti_auto":"尧","start_index":28,"tongjian_id":"96f065e3-db0e-11ef-be92-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":68,"tongjian_id":"96f065e4-db0e-11ef-9e6d-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":83,"tongjian_id":"96f065e5-db0e-11ef-9233-a0d3651f611f"},{"people_name":"虞丘子","people_name_jianti_auto":"虞丘子","start_index":106,"tongjian_id":"96f065e6-db0e-11ef-8b41-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"康衢","place_name_jianti_auto":"康衢","start_index":34,"tongjian_id":"96f065e7-db0e-11ef-ac54-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"通下情也。賢曰：列子曰：昔堯理天下五十年，不知天下理亂，堯乃微服遊於康衢，兒童謠曰：「立我蒸民，莫匪爾極，不識不知，順帝之則。」說苑曰：孔子行遊中路，聞哭者其音甚悲。孔子避車而問之曰：「夫子非有喪也，何哭之悲？」虞丘子對曰：「吾有三失：吾少好學，周徧天下，還，後吾親喪，是一失也。事君驕奢不遂，是二失也。厚交友而後絕，是三失也。」","note_content_jianti_auto":"通下情也。贤曰：列子曰：昔尧理天下五十年，不知天下理乱，尧乃微服游于康衢，儿童谣曰：「立我蒸民，莫匪尔极，不识不知，顺帝之则。」说苑曰：孔子行游中路，闻哭者其音甚悲。孔子避车而问之曰：「夫子非有丧也，何哭之悲？」虞丘子对曰：「吾有三失：吾少好学，周徧天下，还，后吾亲丧，是一失也。事君骄奢不遂，是二失也。厚交友而后绝，是三失也。」","note_type":"hu_note","start_index":375,"tongjian_id":"96f065e0-db0e-11ef-93a1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":9,"tongjian_id":"96f065eb-db0e-11ef-b54e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"瞰，苦鑒翻，視也。賢曰：三光，日、月、星也。分，謂山。流，謂河。言日、月有讁食之變，星、辰有錯行之異，故視其文耀也。山崩、川竭，皆亡之徵，不可不察。","note_content_jianti_auto":"瞰，苦鉴翻，视也。贤曰：三光，日、月、星也。分，谓山。流，谓河。言日、月有讁食之变，星、辰有错行之异，故视其文耀也。山崩、川竭，皆亡之征，不可不察。","note_type":"hu_note","start_index":389,"tongjian_id":"96f065ea-db0e-11ef-a0f1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":6,"tongjian_id":"96f065ee-db0e-11ef-9d5c-a0d3651f611f"},{"people_name":"陳涉","people_name_jianti_auto":"陈涉","start_index":14,"tongjian_id":"96f065ef-db0e-11ef-8ba6-a0d3651f611f"},{"people_name":"陳涉","people_name_jianti_auto":"陈涉","start_index":33,"tongjian_id":"96f065f0-db0e-11ef-94ab-a0d3651f611f"},{"people_name":"黥布","people_name_jianti_auto":"黥布","start_index":36,"tongjian_id":"96f065f1-db0e-11ef-bc83-a0d3651f611f"},{"people_name":"蘇令","people_name_jianti_auto":"苏令","start_index":53,"tongjian_id":"96f065f2-db0e-11ef-8e00-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蘄","place_name_jianti_auto":"蕲","start_index":17,"tongjian_id":"96f065f3-db0e-11ef-9f12-a0d3651f611f"},{"place_name":"驪山","place_name_jianti_auto":"骊山","start_index":25,"tongjian_id":"96f065f4-db0e-11ef-aa46-a0d3651f611f"},{"place_name":"山陽","place_name_jianti_auto":"山阳","start_index":48,"tongjian_id":"96f065f5-db0e-11ef-ae05-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卒，讀曰猝。賢曰：役夫，謂如陳涉起蘄也。窮匠，謂如驪山之徒也。余謂陳涉、黥布皆可以言役夫，窮匠則山陽鐵官徒蘇令等是也。","note_content_jianti_auto":"卒，读曰猝。贤曰：役夫，谓如陈涉起蕲也。穷匠，谓如骊山之徒也。余谓陈涉、黥布皆可以言役夫，穷匠则山阳铁官徒苏令等是也。","note_type":"hu_note","start_index":475,"tongjian_id":"96f065ed-db0e-11ef-b445-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言雖錢大方尺，亦不能救天下之亂也。","note_content_jianti_auto":"言虽钱大方尺，亦不能救天下之乱也。","note_type":"hu_note","start_index":510,"tongjian_id":"96f065f7-db0e-11ef-b71a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"四府","official_note":"四府指东汉时期的重要中央机构，通常包括太尉府、司徒府、司空府和将军府，负责处理国家政务和军事事务。在上下文中，皇帝将铸钱事宜下发给四府讨论，表明这些机构在决策中扮演咨询和审议角色。","official_rank":"未知","source_snippet":"事下四府羣僚及太學能言之士議之","start_index":18,"tongjian_id":"c2bb2587-d0f2-4ef9-9698-5b171f65af56"}],"ExtRef_Children_people":[{"link_death_year":185,"link_td_description":"刘陶，又名刘伟，字子奇，颍川颍阴人，东汉名臣，西汉济北贞王刘勃之后，官至谏议大夫，后被宦官诬陷下狱而自尽。","link_td_id":"Q10016926","link_td_number_id":4429767,"people_name":"劉陶","people_name_jianti_auto":"刘陶","people_xingming":"刘陶","start_index":42,"tongjian_id":"96f065f8-db0e-11ef-84b0-a0d3651f611f"},{"link_td_description":"卞和，春秋时代楚国人，和氏璧的发现者，是中国历史上著名被刖刑的肢体伤残人士。生活年代应该是楚厉王霄敖和楚文王之间。","link_td_id":"Q10008162","link_td_number_id":122541,"people_name":"和","people_name_jianti_auto":"和","people_xingming":"卞和","start_index":124,"tongjian_id":"96f065f9-db0e-11ef-9f81-a0d3651f611f"},{"people_name":"皇","people_name_jianti_auto":"皇","people_xingming":"天皇氏","start_index":141,"tongjian_id":"96f065fa-db0e-11ef-bbb8-a0d3651f611f"},{"link_td_description":"伏羲是中国传说时代的人物，为《史记》中的三皇五帝之一。伏羲不仅在古代被视为人文始祖，其神话形象和事迹也深刻影响了后世的道教、儒家及民间信仰体系。","link_td_id":"Q10000049","link_td_number_id":157653,"people_name":"羲","people_name_jianti_auto":"羲","people_xingming":"伏羲氏","start_index":143,"tongjian_id":"96f065fb-db0e-11ef-b31e-a0d3651f611f"},{"link_td_description":"尧，祁姓，名放勋，中国神话中五帝之一，传说出生于三阿之南。道教中为天官大帝，三官大帝之一，诞日为上元节。","link_td_id":"Q10000026","link_td_number_id":14183,"people_name":"唐","people_name_jianti_auto":"唐","people_xingming":"唐尧","start_index":148,"tongjian_id":"96f065fc-db0e-11ef-ba70-a0d3651f611f"},{"link_td_description":"舜，中国上古时代的五帝之一，东夷人。亦是道教与民间信仰的地官大帝。名重华；生于姚墟，为姚姓，后居于妫水之边，后人将姚姓改为妫姓，有虞氏。冀州人，都城在蒲阪（今山西永济）。舜为四部落联盟首领，以受尧的「禅让」而称帝于天下，其国号为「有虞」。","link_td_id":"Q10000010","link_td_number_id":4332,"people_name":"虞","people_name_jianti_auto":"虞","people_xingming":"虞舜","start_index":150,"tongjian_id":"96f065fd-db0e-11ef-a8d5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"96f065cb-db0e-11ef-bde5-a0d3651f611f","pinyin":"qiè","source_anchor_text":"願陛下寬鍥薄之禁後","source_key":"baiyang_epub","start_index":350,"text":"鍥","tongjian_id":"920b654c-55b9-5355-a0f8-9ce60ae540c7"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5或上言：「民之貧困以貨輕錢薄，宜改鑄大錢。」事下四府羣僚及太學能言之士議之。太學生劉陶上議曰：「當今之憂，不在於貨，在乎民飢。竊見比年已來，良苗盡於蝗螟之口，杼軸空於公私之求。民所患者，豈謂錢貨之厚薄，銖兩之輕重哉！就使當今沙礫化爲南金，瓦石變爲和玉，使百姓渴無所飲，飢無所食，雖皇、羲之純德，唐、虞之文明，猶不能以保蕭牆之內也。蓋民可百年無貨，不可一朝有飢，故食爲至急也。議者不達農殖之本，多言鑄冶之便。蓋萬人鑄之，一人奪之，猶能不給；況今一人鑄之，則萬人奪之乎！雖以陰陽爲炭，萬物爲銅，役不食之民，使不飢之士，猶不能足無厭之求也。夫欲民殷財阜，要在止役禁奪，則百姓不勞而足。陛下愍海內之憂戚，欲鑄錢齊貨以救其弊，猶養魚沸鼎之中，棲鳥烈火之上；水、木，本魚鳥之所生也，用之不時，必至焦爛。願陛下寬鍥薄之禁，後冶鑄之議，聽民庶之謠吟，問路叟之所憂，瞰三光之交耀，視山河之分流，天下之心，國家大事，粲然皆見，無有遺惑者矣。伏念當今地廣而不得耕，民衆而無所食，羣小競進，秉國之位，鷹揚天下，鳥鈔求飽，吞肌及骨，並噬無厭。誠恐卒有役夫、窮匠起於版築之間，投斤攘臂，登高遠呼，使愁怨之民響應雲合，雖方尺之錢，何有能救其危也！」遂不改錢。","content_fanyi":"有人上奏说：“百姓贫困，是由于钱币太轻太薄，应当改铸大钱。”此事下交大将军、太尉、司徒、司空等四府官员以及太学中善于议论的人士商议。太学生刘陶上奏说：“当今的忧患，不在于货币，而在于百姓饥饿。我私下看到，近年以来，好庄稼全被蝗螟吃光，织机上的布帛被官府和私家的索取搜括一空。百姓所担忧的，哪里是钱币的厚薄、铢两的轻重呢！即使当今沙砾变成南方出产的黄金，瓦石变成卞和发现的美玉，如果百姓口渴没有水喝，饥饿没有饭吃，即使有天皇氏、伏羲氏的纯厚德行，唐尧、虞舜的清明教化，仍不能保住宫廷内部的安全。人民可以一百年没有钱币，却不能有一天挨饿，所以粮食是最急迫的事情。议论此事的人不明白农耕生产的根本，大多只谈铸钱的便利。一万个人铸钱，一个人加以掠夺，尚且供给不上；何况现在一个人铸钱，却有上万个人来掠夺呢！即使用阴阳二气作为炭火，用万物作为铜，驱使不用吃饭的百姓，使用不会饥饿的人，也还是不能满足永不知足的索求。要使百姓殷实、财物丰富，关键在于停止征发徭役、禁止掠夺，这样百姓不用劳苦就能富足。陛下怜悯海内的忧苦，想铸钱统一货币以补救时弊，这就好比把鱼养在沸腾的鼎中，让鸟栖息在烈火之上；水和树木本是鱼和鸟赖以生存之物，使用得不是时候，必然招致焦烂。希望陛下放宽苛刻的禁令，推迟铸钱的议论，倾听民间的歌谣吟诵，询问路边老人的忧虑，观察日月星三光的交相辉映，察看山河的分布流向，这样天下人心、国家大事都会清楚地显现，没有遗漏和疑惑了。我私下想到，当今土地虽广却不能耕种，民众虽多却没有饭吃，众小人争相钻营，把持国家权位，像鹰一样飞扬于天下，像鸟一样掠取食物以求饱足，吞食肌肉连及骨头，一起吞噬而不知满足。实在担心忽然有服役之人和穷困工匠从版筑劳作中起事，扔掉斧头，挽起袖子，登高向远方呼喊，使忧愁怨恨的百姓响应聚合如同云涌，到那时即使有一尺见方的大钱，又怎能解救危亡呢！”于是不改铸钱币。","content_jianti_auto":"5或上言：「民之贫困以货轻钱薄，宜改铸大钱。」事下四府群僚及太学能言之士议之。太学生刘陶上议曰：「当今之忧，不在于货，在乎民饥。窃见比年已来，良苗尽于蝗螟之口，杼轴空于公私之求。民所患者，岂谓钱货之厚薄，铢两之轻重哉！就使当今沙砾化为南金，瓦石变为和玉，使百姓渴无所饮，饥无所食，虽皇、羲之纯德，唐、虞之文明，犹不能以保萧墙之内也。盖民可百年无货，不可一朝有饥，故食为至急也。议者不达农殖之本，多言铸冶之便。盖万人铸之，一人夺之，犹能不给；况今一人铸之，则万人夺之乎！虽以阴阳为炭，万物为铜，役不食之民，使不饥之士，犹不能足无厌之求也。夫欲民殷财阜，要在止役禁夺，则百姓不劳而足。陛下愍海内之忧戚，欲铸钱齐货以救其弊，犹养鱼沸鼎之中，栖鸟烈火之上；水、木，本鱼鸟之所生也，用之不时，必至焦烂。愿陛下宽锲薄之禁，后冶铸之议，听民庶之谣吟，问路叟之所忧，瞰三光之交耀，视山河之分流，天下之心，国家大事，粲然皆见，无有遗惑者矣。伏念当今地广而不得耕，民众而无所食，群小竞进，秉国之位，鹰扬天下，鸟钞求饱，吞肌及骨，并噬无厌。诚恐卒有役夫、穷匠起于版筑之间，投斤攘臂，登高远呼，使愁怨之民响应云合，虽方尺之钱，何有能救其危也！」遂不改钱。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4581,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"96f065cb-db0e-11ef-bde5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"袁","people_name_jianti_auto":"袁","start_index":4,"tongjian_id":"96f06600-db0e-11ef-82c5-a0d3651f611f"},{"people_name":"范","people_name_jianti_auto":"范","start_index":12,"tongjian_id":"96f06601-db0e-11ef-b57d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：袁紀在六月。今從范書。","note_content_jianti_auto":"考异曰：袁纪在六月。今从范书。","note_type":"hu_note","start_index":13,"tongjian_id":"96f065ff-db0e-11ef-bd17-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是东汉三公之一，掌管民政和教育，此处表示尹頌担任此职并去世。","official_rank":"正一品","source_snippet":"司徒尹頌薨","start_index":6,"tongjian_id":"d2220228-7d25-4bea-a161-dff693d28c43"}],"ExtRef_Children_people":[{"link_death_year":157,"link_td_description":"尹颂，字公孙，河南郡巩县（今河南省巩义市西南）人，东汉时期人物。","link_td_id":"Q10007317","link_td_number_id":5247259,"people_name":"尹頌","people_name_jianti_auto":"尹颂","people_xingming":"尹颂","start_index":9,"tongjian_id":"96f06605-db0e-11ef-9f27-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"6冬，十一月，司徒尹頌薨。","content_fanyi":"冬季，十一月，司徒尹颂去世。","content_jianti_auto":"6冬，十一月，司徒尹颂薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4582,"number":6,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":5,"tongjian_id":"96f065fe-db0e-11ef-9cfe-a0