h_links":[],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":8,"tongjian_id":"8c407a90-db0e-11ef-972f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都郢都，湖北江陵","start_index":0,"tongjian_id":"8c407a91-db0e-11ef-8abb-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":2,"tongjian_id":"8c407a92-db0e-11ef-8c98-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":11,"tongjian_id":"8c407a93-db0e-11ef-a168-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":16,"tongjian_id":"8c407a94-db0e-11ef-9341-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楚在齊之西南，故蘇秦自齊而西南詣楚。說，式芮翻。乘，繩證翻。騎，奇寄翻。","note_content_jianti_auto":"楚在齐之西南，故苏秦自齐而西南诣楚。说，式芮翻。乘，绳证翻。骑，奇寄翻。","note_type":"hu_note","start_index":39,"tongjian_id":"8c407a8f-db0e-11ef-91c8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-329,"link_td_description":"楚威王，芈姓，熊氏，名商，楚宣王之子，战国时期楚国著名国君，被称为楚国的中兴之主。","link_td_id":"Q10001876","link_td_number_id":335216,"people_name":"楚威王","people_name_jianti_auto":"楚威王","people_xingming":"芈商","start_index":4,"tongjian_id":"8c407a98-db0e-11ef-81fb-a0d3651f611f","wl_zhushi":"[芈商]"},{"link_death_year":-329,"link_td_description":"楚威王，芈姓，熊氏，名商，楚宣王之子，战国时期楚国著名国君，被称为楚国的中兴之主。","link_td_id":"Q10001876","link_td_number_id":335216,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈商","start_index":171,"tongjian_id":"8c407aa5-db0e-11ef-8d1b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/苏张说六国","excerpts":[{"context_after":"。谓燕地方二千余里，带甲数十万，车六百乘，骑六千匹；谓赵...","context_before":"...鬼谷，而其从横之辩，如冰炭水火之不同，盖所以设心者异耳。","source_end_index":50,"source_paragraph_tongjian_id":"1db2313c-c7f2-4053-bd18-4454471f59de","source_start_index":36,"source_text":"苏欲六国合从以摈秦，故言其强"}],"path":"续笔/卷二/苏张说六国","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"楚怀王十八年，秦使人告楚，请以武关之外易黔中地。二十年，...","context_before":"...争商密[鄀国本治商密，今内乡县之丹水城]。商密近武关也。","source_end_index":335,"source_paragraph_tongjian_id":"e50d3daf-9bb4-555a-838d-7253c4f724ea","source_start_index":304,"source_text":"苏秦说楚威王：秦起两军，一军出武关，一军下黔中，则鄢、郢动矣。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷六十六）","excerpts":[{"context_after":"盖郡据巫山之险，因以山名。后汉初，荆邯说公孙述，亦云倚巫...","context_before":"...峡详湖广重险西陵]，长一百六十里，所谓巴东三峡巫峡长也。","source_end_index":76,"source_paragraph_tongjian_id":"105925cd-c26f-5316-946d-f7cc272b826f","source_start_index":55,"source_text":"《战国策》：苏秦说楚威王曰：西有黔中巫郡。"}],"path":"四川方舆纪要/〇、封域 山川险要（卷六十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"乃西南說楚威王曰：「楚，天下之強國也，地方六千餘里，帶甲百萬，車千乘，騎萬匹，粟支十年，此霸王之資也。秦之所害莫如楚，楚強則秦弱，秦強則楚弱，其勢不兩立。故爲大王計，莫如從親以孤秦。臣請令山東之國奉四時之獻，以承大王之明詔；委社稷，奉宗廟，練士厲兵，在大王之所用之。故從親則諸侯割地以事楚，衡合則楚割地以事秦，此兩策者相去遠矣，大王何居焉？」楚王亦許之。","content_fanyi":"于是苏秦前往西南方游说楚威王说：“楚国是天下的强国，土地方圆六千多里，甲士上百万，战车千辆，战马万匹，粮食储存可支撑十年，这是称霸称王的资本。秦国所嫉恨的国家没有哪个比得上楚国，楚国强大秦国就弱小，秦国强大楚国就弱小，双方势不两立。所以为大王考虑，不如合纵结盟来孤立秦国。我请求让崤山以东各国进献春夏秋冬四季的贡品，来接受大王英明的命令；把社稷委托给您，把宗庙进献给您，训练士卒，整备兵器，只等大王您来调动使用。因此，如果合纵结盟，诸侯就会割让土地来事奉楚国；如果实行连横，楚国就要割让土地去事奉秦国。这两种策略相差太远了，大王您选择哪一种呢？”楚王也应允了苏秦的主张。","content_jianti_auto":"乃西南说楚威王曰：「楚，天下之强国也，地方六千余里，带甲百万，车千乘，骑万匹，粟支十年，此霸王之资也。秦之所害莫如楚，楚强则秦弱，秦强则楚弱，其势不两立。故为大王计，莫如从亲以孤秦。臣请令山东之国奉四时之献，以承大王之明诏；委社稷，奉宗庙，练士厉兵，在大王之所用之。故从亲则诸侯割地以事楚，衡合则楚割地以事秦，此两策者相去远矣，大王何居焉？」楚王亦许之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":192,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十六年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"8c407a8e-db0e-11ef-828b-a0d3651f611f","year_int":-333},"tongjian_id":"8c407a8e-db0e-11ef-828b-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_enti