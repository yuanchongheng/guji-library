-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"護羌校尉","official_note":"護羌校尉是汉代设置的官职，负责管理羌族事务和边境防务，常驻西北地区，此处周鮪担任此职，指挥军队对抗迷唐。","official_rank":"未知","source_snippet":"護羌校尉周鮪","start_index":18,"tongjian_id":"274712cc-5a59-4bf1-bcbc-25febe88291f"},{"confidence":0.95,"official_category":"地方行政","official_name":"金城太守","official_note":"金城太守是汉代地方行政官职，负责金城郡的治理，此处侯霸担任此职，参与军事行动击败迷唐。","official_rank":"未知","source_snippet":"金城太守侯霸","start_index":25,"tongjian_id":"061309c4-232d-4916-948e-7a35b2ea0514"}],"ExtRef_Children_people":[{"link_td_description":"迷唐，烧当羌首领。羌王迷吾的儿子。","link_td_id":"Q10002671","link_td_number_id":1275484,"people_name":"迷唐","people_name_jianti_auto":"迷唐","people_xingming":"迷唐","start_index":1,"tongjian_id":"95a15f81-db0e-11ef-ab5f-a0d3651f611f"},{"people_name":"周鮪","people_name_jianti_auto":"周鲔","people_xingming":"周鲔","start_index":19,"tongjian_id":"95a15f82-db0e-11ef-8763-a0d3651f611f"},{"link_death_year":37,"link_td_description":"侯霸，字君房，河南郡密县（今河南省新密市东南）人，东汉初年大臣。","link_td_id":"Q10007205","link_td_number_id":1549261,"people_name":"侯霸","people_name_jianti_auto":"侯霸","people_xingming":"侯霸","start_index":26,"tongjian_id":"95a15f83-db0e-11ef-8654-a0d3651f611f"},{"link_death_year":37,"link_td_description":"侯霸，字君房，河南郡密县（今河南省新密市东南）人，东汉初年大臣。","link_td_id":"Q10007205","link_td_number_id":1549261,"people_name":"侯霸","people_name_jianti_auto":"侯霸","start_index":46,"tongjian_id":"95a15f8a-db0e-11ef-bf9f-a0d3651f611f"},{"link_td_description":"迷唐，烧当羌首领。羌王迷吾的儿子。","link_td_id":"Q10002671","link_td_number_id":1275484,"people_name":"迷唐","people_name_jianti_auto":"迷唐","start_index":50,"tongjian_id":"95a15f8b-db0e-11ef-973a-a0d3651f611f"},{"link_td_description":"迷唐，烧当羌首领。羌王迷吾的儿子。","link_td_id":"Q10002671","link_td_number_id":1275484,"people_name":"迷唐","people_name_jianti_auto":"迷唐","start_index":76,"tongjian_id":"95a15f8c-db0e-11ef-a3b5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongji