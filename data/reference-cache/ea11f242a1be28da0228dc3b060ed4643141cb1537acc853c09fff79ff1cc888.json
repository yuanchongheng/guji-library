{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（辛丑、一○一）","note_content_jianti_auto":"（辛丑、一○一）","note_type":"hu_note","start_index":0,"tongjian_id":"95a1112d-db0e-11ef-9bb4-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"盛饌門","place_name_jianti_auto":"盛馔门","start_index":0,"tongjian_id":"95a11130-db0e-11ef-9b8a-a0d3651f611f"},{"place_name":"北宮","place_name_jianti_auto":"北宫","start_index":79,"tongjian_id":"95a11131-db0e-11ef-a1c5-a0d3651f611f"},{"place_name":"盛饌門","place_name_jianti_auto":"盛馔门","start_index":82,"tongjian_id":"95a11132-db0e-11ef-aa80-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"盛饌門閣，御廚門閣也。晉書·天文志曰：紫宮垣西南角外二星，內二星曰內廚，主六宮之內飲食，后妃、夫人與太子宴飲。東北維外六星，曰天廚，主盛饌。皇居則象於天極，故北宮有盛饌門閣。","note_content_jianti_auto":"盛馔门阁，御厨门阁也。晋书·天文志曰：紫宫垣西南角外二星，内二星曰内厨，主六宫之内饮食，后妃、夫人与太子宴饮。东北维外六星，曰天厨，主盛馔。皇居则象于天极，故北宫有盛馔门阁。","note_type":"hu_note","start_index":17,"tongjian_id":"95a1112f-db0e-11ef-9fd2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"北宮","place_name_jianti_auto":"北宫","resolved_place_entity_id":1235,"start_index":9,"tongjian_id":"95a11134-db0e-11ef-90d8-a0d3651f611f"},{"place_name":"盛饌門","place_name_jianti_auto":"盛馔门","resolved_place_entity_id":8441,"start_index":11,"tongjian_id":"95a11135-db0e-11ef-88df-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_mater