icial_category":"爵位","official_name":"燕王","official_note":"燕王为封爵，地位崇高，此处是封抽等人建议朝廷封慕容廆为此爵位以表彰其功绩。","official_rank":"王爵","source_snippet":"請封廆爲燕王","start_index":168,"tongjian_id":"e637da22-b928-4564-aac9-5834e4135943"},{"confidence":0.9,"official_category":"军事指挥","official_name":"大將軍","official_note":"大将军为高级军事统帅，此处建议让慕容廆代理大将军职务，掌管军事。","official_rank":"正一品","source_snippet":"行大將軍事","start_index":173,"tongjian_id":"6640252d-e6ad-491b-8b02-1be2dbb8ee1a"},{"confidence":0.8,"official_category":"军事指挥","official_name":"車騎","official_note":"车骑将军为高级武官，此处陶侃在回信中提及，可能指代慕容廆或相关人物，但上下文未明确指定具体人物。","official_rank":"从一品","source_snippet":"車騎雖未能爲官摧勒","start_index":202,"tongjian_id":"ef34ce72-b5be-4506-8660-b58ae04aa7b4"}],"ExtRef_Children_people":[{"link_birth_year":269,"link_death_year":333,"link_td_description":"慕容廆，字弈洛瓌，昌黎棘城（今辽宁义县）人。晋朝时鲜卑人，慕容部首领慕容涉归之子，前燕奠基人慕容皝之父。其孙慕容儁建立前燕之后，追尊武宣皇帝。吐谷浑第一代首领慕容吐谷浑是其庶兄。","link_td_id":"Q10000872","link_td_number_id":211298,"people_name":"慕容廆","people_name_jianti_auto":"慕容廆","people_xingming":"慕容廆","start_index":1,"tongjian_id":"a0417619-db0e-11ef-bd27-a0d3651f611f"},{"link_birth_year":259,"link_death_year":334,"link_td_description":"陶侃，字士行，孙吴鄱阳郡枭阳县（今江西省都昌县）人，晋朝名将。出身寒门，自讨平张昌叛乱开始以其战功升迁，最终当上太尉之位，并掌握重兵，都督八州军事并任荆江两州刺史。在东晋世族垄断高位的情况下是一个例外。对东晋的建立与维持在军事上作出贡献，本身亦有治绩，治下荆州太平安定，路不拾遗，深受人民爱戴。曾建杉庵读书于岳麓山。因曾任西晋龙骧将军获封长沙郡公，故又称“陶龙骧”、“陶长沙”。诗人陶渊明为其曾孙。","link_td_id":"Q10008511","link_td_number_id":302095,"people_name":"陶侃","people_name_jianti_auto":"陶侃","people_xingming":"陶侃","start_index":9,"tongjian_id":"a041761a-db0e-11ef-9cf1-a0d3651f611f"},{"link_td_description":"宋该，字弘宣，又作宣弘，《十六国春秋》作宋谚。五胡十六国时代前燕官员，平原郡人。","link_td_id":"Q10023759","link_td_number_id":8516422,"people_name":"宋該","people_name_jianti_auto":"宋该","people_xingming":"宋该","start_index":27,"tongjian_id":"a041761b-db0e-11ef-9c50-a0d3651f611f"},{"link_birth_year":269,"link_death_year":333,"link_td_description":"慕容廆，字弈洛瓌，昌黎棘城（今辽宁义县）人。晋朝时鲜卑人，慕容部首领慕容涉归之子，前燕奠基人慕容皝之父。其孙慕容儁建立前燕之后，追尊武宣皇帝。吐谷浑第一代首领慕容吐谷浑是其庶兄。","link_td_id":"Q10000