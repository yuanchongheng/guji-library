ace_name":"魯國","place_name_jianti_auto":"鲁国","start_index":6,"tongjian_id":"8c477417-db0e-11ef-83c8-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":9,"tongjian_id":"8c477418-db0e-11ef-8d86-a0d3651f611f"},{"place_name":"邳","place_name_jianti_auto":"邳","start_index":18,"tongjian_id":"8c477419-db0e-11ef-929c-a0d3651f611f"},{"place_name":"薛城","place_name_jianti_auto":"薛城","start_index":30,"tongjian_id":"8c47741a-db0e-11ef-81bf-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":34,"tongjian_id":"8c47741b-db0e-11ef-84fc-a0d3651f611f"},{"place_name":"滕縣","place_name_jianti_auto":"滕县","start_index":36,"tongjian_id":"8c47741c-db0e-11ef-bb58-a0d3651f611f"},{"place_name":"薛","place_name_jianti_auto":"薛","start_index":46,"tongjian_id":"8c47741d-db0e-11ef-8e0a-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":51,"tongjian_id":"8c47741e-db0e-11ef-b866-a0d3651f611f"},{"place_name":"滕縣","place_name_jianti_auto":"滕县","start_index":53,"tongjian_id":"8c47741f-db0e-11ef-a217-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，薛縣屬魯國，夏奚仲之國；後遷于邳，仲虺居之。括地志：故薛城在今徐州滕縣界。史記正義曰：薛故城在今徐州滕縣南四十四里。","note_content_jianti_auto":"班志，薛县属鲁国，夏奚仲之国；后迁于邳，仲虺居之。括地志：故薛城在今徐州滕县界。史记正义曰：薛故城在今徐州滕县南四十四里。","note_type":"hu_note","start_index":9,"tongjian_id":"8c477412-db0e-11ef-a831-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"8c477424-db0e-11ef-92ef-a0d3651f611f"},{"people_name":"項","people_name_jianti_auto":"项","start_index":11,"tongjian_id":"8c477425-db0e-11ef-9287-a0d3651f611f"},{"people_name":"靖郭","people_name_jianti_auto":"靖郭","start_index":40,"tongjian_id":"8c477426-db0e-11ef-8448-a0d3651f611f"},{"people_name":"武安","people_name_jianti_auto":"武安","start_index":43,"tongjian_id":"8c477427-db0e-11ef-b2e4-a0d3651f611f"},{"people_name":"嬰","people_name_jianti_auto":"婴","start_index":73,"tongjian_id":"8c477428-db0e-11ef-9c1d-a0d3651f611f"},{"people_name":"靖郭君","people_name_jianti_auto":"靖郭君","start_index":76,"tongjian_id":"8c477429-db0e-11ef-adca-a0d3651f611f"},{"people_name":"靖郭","people_name_jianti_auto":"靖郭","start_index":84,"tongjian_id":"8c47742a-db0e-11ef-a1f3-a0d3651f611f"},{"people_name":"駟鈞","people_name_jianti_auto":"驷钧","start_index":94,"tongjian_id":"8c47742b-db0e-11ef-af6f-a0d3651f611f"},{"people_name":"靖郭侯","people_name_jianti_auto":"靖郭侯","start_index":97,"tongjian_id":"8c47742c-db0e-11ef-8823-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":4,"tongjian_id":"8c47742d-db0e-11ef-b1aa-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":9,"tongjian_id":"8c47742e-db0e-11ef-a485-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":51,"tongjian_id":"8c47742f-db0e-11ef-a839-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":93,"tongjian_id":"8c477430-db0e-11ef-9f72-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：戰國之際，秦、項之間，權設班寵有加賜邑封君者，蓋假其位號，或空受其爵，如靖郭、武安之類是也。至漢尤多，蓋在封爵之外別加美號。史記·列傳云：嬰諡爲靖郭君。索隱曰：靖郭，或封邑號，故漢駟鈞封靖郭侯。","note_content_jianti_auto":"杜佑曰：战国之际，秦、项之间，权设班宠有加赐邑封君者，盖假其位号，或空受其爵，如靖郭、武安之类是也。至汉尤多，盖在封爵之外别加美号。史记·列传云：婴谥为靖郭君。索隐曰：靖郭，或封邑号，故汉驷钧封靖郭侯。","note_type":"hu_note","start_index":15,"tongjian_id":"8c477423-db0e-11ef-8029-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"記·曾子問：諸侯出，命國家五官而後行。註云：五官，五大夫典事者。命者，敕之以其職。正義云：案太宰職云：建其牧，立其監，設其參，傅其伍，是諸侯有三卿、五大夫。經云五官，故云五大夫。以屬官大夫，其數衆多，直云五者，據典國事言之。不云命卿者，或從君出行，或雖在國留守，總主羣吏，如三公然，不專主一事，且尊之。旣命五大夫，則卿亦命之可知，故不顯言命卿也。余謂此所謂五官，蓋亦言典事五大夫也。數，所角翻。","note_content_jianti_auto":"记·曾子问：诸侯出，命国家五官而后行。注云：五官，五大夫典事者。命者，敕之以其职。正义云：案太宰职云：建其牧，立其监，设其参，傅其伍，是诸侯有三卿、五大夫。经云五官，故云五大夫。以属官大夫，其数众多，直云五者，据典国事言之。不云命卿者，或从君出行，或虽在国留守，总主群吏，如三公然，不专主一事，且尊之。既命五大夫，则卿亦命之可知，故不显言命卿也。余谓此所谓五官，盖亦言典事五大夫也。数，所角翻。","note_type":"hu_note","start_index":41,"tongjian_id":"8c477433-db0e-11ef-bd2c-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"齊王","official_note":"齊王是齊國的君主，在戰國時期為諸侯國的最高統治者，此處指齊威王或齊宣王，負責封賞田嬰於薛地，體現其行政權力。","official_rank":"王爵","source_snippet":"齊王封田嬰於薛","start_index":0,"tongjian_id":"65b5df14-f185-46ae-9900-2f5a7ff7ae5e"},{"confidence":0.85,"official_category":"封爵","official_name":"靖郭君","official_note":"靖郭君是田嬰的封號，源自齊王封賞，屬於戰國時期貴族封爵，此處表示田嬰獲得封地薛後的尊稱，有助於其專權。","official_rank":"君爵","source_snippet":"號曰靖郭君","start_index":10,"tongjian_id":"f1d32103-f83c-4560-9795-827fa7f3950e"},{"confidence":0.7,"official_category":"財政","official_name":"五官","official_note":"五官可能指戰國時期齊國的財政或行政官員，負責會計或統計事務，此處靖郭君建議齊王每日聽取其報告以加強管理。","official_rank":"未知","source_snippet":"五官之計","start_index":24,"tongjian_id":"93bbf1c8-e838-48c3-b810-c3be101b74e6"}],"ExtRef_Children_people":[{"link_birth_year":-350,"link_death_year":-301,"link_td_description":"齐宣王，本名田辟疆，战国时代齐国国君，齐威王之子。","link_td_id":"Q10000604","link_td_number_id":320027,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田辟彊","start_index":1,"tongjian_id":"8c477438-db0e-11ef-b958-a0d3651f611f","wl_zhushi":"[田辟彊]"},{"link_td_description":"田婴，妫姓，田氏，名婴，也作陈婴、田宴、陈宴，中国战国时期齐国人，号靖郭君。孟尝君田文之父，齐威王的儿子，齐宣王的弟弟。","link_td_id":"Q10001102","link_td_number_id":673473,"people_name":"田嬰","people_name_jianti_auto":"田婴","people_xingming":"田婴","start_index":4,"tongjian_id":"8c477439-db0e-11ef-a166-a0d3651f611f"},{"link_td_description":"田婴，妫姓，田氏，名婴，也作陈婴、田宴、陈宴，中国战国时期齐国人，号靖郭君。孟尝君田文之父，齐威王的儿子，齐宣王的弟弟。","link_td_id":"Q10001102","link_td_number_id":673473,"people_name":"靖郭君","people_name_jianti_auto":"靖郭君","people_xingming":"田婴","start_index":11,"tongjian_id":"8c47743b-db0e-11ef-9f41-a0d365