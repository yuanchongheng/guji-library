,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c477411-db0e-11ef-a47c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隆，高也，崇也。庸，常也。","note_content_jianti_auto":"隆，高也，崇也。庸，常也。","note_type":"hu_note","start_index":89,"tongjian_id":"8c477443-db0e-11ef-84af-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田婴，妫姓，田氏，名婴，也作陈婴、田宴、陈宴，中国战国时期齐国人，号靖郭君。孟尝君田文之父，齐威王的儿子，齐宣王的弟弟。","link_td_id":"Q10001102","link_td_number_id":673473,"people_name":"靖郭君","people_name_jianti_auto":"靖郭君","people_xingming":"靖郭君","start_index":0,"tongjian_id":"8c477444-db0e-11ef-8180-a0d3651f611f"},{"link_td_description":"田婴，妫姓，田氏，名婴，也作陈婴、田宴、陈宴，中国战国时期齐国人，号靖郭君。孟尝君田文之父，齐威王的儿子，齐宣王的弟弟。","link_td_id":"Q10001102","link_td_number_id":673473,"people_name":"靖郭君","people_name_jianti_auto":"靖郭君","people_xingming":"靖郭君","start_index":9,"tongjian_id":"8c477445-db0e-11ef-9c55-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"薛","place_name_jianti_auto":"薛","place_note":"山東滕州南","resolved_place_entity_id":190,"start_index":5,"tongjian_id":"8c477446-db0e-11ef-856b-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":46,"tongjian_id":"8c477447-db0e-11ef-8d4e-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":57,"tongjian_id":"8c477448-db0e-11ef-9b24-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":67,"tongjian_id":"8c477449-db0e-11ef-8f48-a0d3651f611f"},{"place_name":"薛","place_name_jianti_auto":"薛","resolved_place_entity_id":190,"start_index":71,"tongjian_id":"8c47744a-db0e-11ef-a06b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"靖郭君欲城薛，客謂靖郭君曰：「君不聞海大魚乎？網不能止，鉤不能牽，蕩而失水，則螻蟻制焉。今夫齊，亦君之水也。君長有齊，奚以薛爲！苟爲失齊，雖隆薛之城到於天，庸足恃乎！」乃不果城。","content_fanyi":"靖郭君打算在薛地筑城，门客对靖郭君说：“您难道没有听说过海里的大鱼吗？渔网不能困住它，鱼钩不能牵动它，可它一旦游荡离开了水，连蝼蛄蚂蚁也能制伏它。如今齐国也就是您的水。您若长久保有齐国，哪里还用得着薛城！如果失去了齐国，纵使把薛城加高到顶到天，难道真能靠它自保吗？”于是就没有筑城。","content_jianti_auto":"靖郭君欲城薛，客谓靖郭君曰：「君不闻海大鱼乎？网不能止，钩不能牵，荡而失水，则蝼蚁制焉。今夫齐，亦君之水也。君长有齐，奚以薛为！苟为失齐，虽隆薛之城到于天，庸足恃乎！」乃不果城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":218,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c477441-db0e-11ef-8e9b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8c47744e-db0e-11ef-9ef5-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":24,"tongjian_id":"8c47744f-db0e-11ef-8c9a-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「十」下有「餘」字；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十二行本「十」下有「余」字；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8c47744d-db0e-11ef-b896-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":7,"tongjian_id":"8c47744c-db0e-11ef-80f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"通，達也。儻，倜儻卓異也。饒智略，言智略有餘也。","note_content_jianti_auto":"通，达也。傥，倜傥卓异也。饶智略，言智略有余也。","note_type":"hu_note","start_index":24,"tongjian_id":"8c477450-db0e-11ef-99ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟嘗君","people_name_jianti_auto":"孟尝君","start_index":9,"tongjian_id":"8c477454-db0e-11ef-aac1-a0d3651f611f"},{"people_name":"孟嘗君","people_name_jianti_auto":"孟尝君","start_index":19,"tongjian_id":"8c477455-db0e-11ef-9d95-a0d3651f611f"},{"people_name":"孟","people_name_jianti_auto":"孟","start_index":29,"tongjian_id":"8c477456-db0e-11ef-b5f8-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"嘗","place_name_jianti_auto":"尝","start_index":33,"tongjian_id":"8c477457-db0e-11ef-80a6-a0d3651f611f"},{"place_name":"嘗邑","place_name_jianti_auto":"尝邑","start_index":38,"tongjian_id":"8c477458-db0e-11ef-9e96-a0d3651f611f"},{"place_name":"薛","place_name_jianti_auto":"薛","start_index":41,"tongjian_id":"8c477459-db0e-11ef-8d58-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記·列傳曰：諡曰孟嘗君。索隱曰：號曰孟嘗君；曰諡，非也。孟，字；嘗，邑名。嘗邑在薛之旁。","note_content_jianti_auto":"史记·列传曰：谥曰孟尝君。索隐曰：号曰孟尝君；曰谥，非也。孟，字；尝，邑名。尝邑在薛之旁。","note_type":"hu_note","start_index":79,"tongjian_id":"8c477453-db0e-11ef-8fb4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"舍業，爲之築舍，立居業也。","note_content_jianti_auto":"舍业，为之筑舍，立居业也。","note_type":"hu_note","start_index":101,"tongjian_id":"8c47745c-db0e-11ef-9dcd-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"田婴，妫姓，田氏，名婴，也作陈婴、田宴、陈宴，中国战国时期齐国人，号靖郭君。孟尝君田文之父，齐威王的儿子，齐宣王的弟弟。","link_td_id":"Q10001102","link_td_number_id":673473,"people_name":"靖郭君","people_name_jianti_auto":"靖郭君","people_xingm