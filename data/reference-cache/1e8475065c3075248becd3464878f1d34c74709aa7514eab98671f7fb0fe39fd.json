u679d\uff0c\u62ab\u5176\u679d\u8005\u50b7\u5176\u5fc3\uff1b\u5927\u5176\u90fd\u8005\u5371\u5176\u570b\uff0c\u5c0a\u5176\u81e3\u8005\u5351\u5176\u4e3b\u3002\u6dd6\u9f52\u7ba1\u9f4a\uff0c\u5c04\u738b\u80a1\uff0c\u64e2\u738b\u7b4b\uff0c\u61f8\u4e4b\u65bc\u5edf\u6881\uff0c\u5bbf\u6614\u800c\u6b7b\u3002\u674e\u514c\u7ba1\u8d99\uff0c\u56da\u4e3b\u7236\u65bc\u6c99\u4e18\uff0c\u767e\u65e5\u800c\u9913\u6b7b\u3002\u4eca\u81e3\u89c0\u56db\u8cb4\u4e4b\u7528\u4e8b\uff0c\u6b64\u4ea6\u6dd6\u9f52\u3001\u674e\u514c\u4e4b\u985e\u4e5f\u3002\u592b\u4e09\u4ee3\u4e4b\u6240\u4ee5\u4ea1\u570b\u8005\uff0c\u541b\u5c08\u6388\u653f\u65bc\u81e3\uff0c\u7e31\u9152\u5f0b\u7375\uff1b\u5176\u6240\u6388\u8005\u59ac\u8ce2\u75be\u80fd\uff0c\u5fa1\u4e0b\u853d\u4e0a\u4ee5\u6210\u5176\u79c1\uff0c\u4e0d\u7232\u4e3b\u8a08\uff0c\u800c\u4e3b\u4e0d\u89ba\u609f\uff0c\u6545\u5931\u5176\u570b\u3002\u4eca\u81ea\u6709\u79e9\u4ee5\u4e0a\u81f3\u8af8\u5927\u540f\u3002\u4e0b\u53ca\u738b\u5de6\u53f3\uff0c\u7121\u975e\u76f8\u570b\u4e4b\u4eba\u8005\uff0c\u898b\u738b\u7368\u7acb\u65bc\u671d\uff0c\u81e3\u7aca\u7232\u738b\u6050\uff0c\u842c\u4e16\u4e4b\u5f8c\u6709\u79e6\u570b\u8005\uff0c\u975e\u738b\u5b50\u5b6b\u4e5f\uff01\u300d\u738b\u4ee5\u7232\u7136\uff0c\u65bc\u662f\u5ee2\u592a\u540e\uff0c\u9010\u7a70\u4faf\u3001\u9ad8\u9675\u3001\u83ef\u967d\u3001\u6d87\u967d\u541b\u65bc\u95dc\u5916\uff0c\u4ee5\u8303\u7762\u7232\u4e1e\u76f8\uff0c\u5c01\u7232\u61c9\u4faf\u3002","content_fanyi":"\u79e6\u56fd\u593a\u53d6\u4e86\u9b4f\u56fd\u7684\u90a2\u4e18\u9091\u3002\u8303\u96ce\u4e00\u5929\u6bd4\u4e00\u5929\u4eb2\u8fd1\u79e6\u662d\u8944\u738b\uff0c\u6267\u638c\u653f\u4e8b\uff0c\u4fbf\u8d81\u673a\u5bfb\u627e\u673a\u4f1a\u5411\u79e6\u662d\u8944\u738b\u8fdb\u8a00\u8bf4\uff1a\u201c\u81e3\u5728\u5d24\u5c71\u4ee5\u4e1c\u65f6\uff0c\u542c\u8bf4\u9f50\u56fd\u6709\u5b5f\u5c1d\u541b\uff0c\u6ca1\u542c\u8bf4\u6709\u9f50\u738b\uff1b\u542c\u8bf4\u79e6\u56fd\u6709\u592a\u540e\u3001\u7a70\u4faf\u9b4f\u5189\uff0c\u6ca1\u542c\u8bf4\u6709\u79e6\u738b\u3002\u638c\u63a7\u56fd\u5bb6\u5927\u6743\u7684\u53eb\u505a\u738b\uff0c\u80fd\u51b3\u5b9a\u56fd\u5bb6\u5229\u5bb3\u7684\u53eb\u505a\u738b\uff0c\u638c\u63e1\u751f\u6740\u5927\u6743\u7684\u53eb\u505a\u738b\u3002\u5982\u4eca\u592a\u540e\u72ec\u65ad\u4e13\u884c\u800c\u4e0d\u987e\u5ff5\u5927\u738b\uff0c\u7a70\u4faf\u51fa\u4f7f\u4e5f\u4e0d\u5411\u5927\u738b\u62a5\u544a\uff0c\u534e\u9633\u541b\u3001\u6cfe\u9633\u541b\u51b3\u65ad\u4e8b\u60c5\u6beb\u65e0\u5fcc\u8bb3\uff0c\u9ad8\u9675\u541b\u51fa\u5165\u671d\u5ef7\u4e5f\u4e0d\u8bf7\u793a\uff1b\u56db\u4f4d\u6743\u8d35\u9f50\u5907\u800c\u56fd\u5bb6\u4e0d\u5371\u9669\uff0c\u662f\u4ece\u672a\u6709\u8fc7\u7684\u4e8b\u3002\u5728\u8fd9\u56db\u4f4d\u6743\u8d35\u4e4b\u4e0b\uff0c\u5c31\u662f\u6240\u8bf4\u7684\u6ca1\u6709\u79e6\u738b\u4e86\u3002\u7a70\u4faf\u7684\u4f7f\u8005\u51ed\u501f\u5927\u738b\u7684\u5a01\u91cd\uff0c\u5bf9\u8bf8\u4faf\u52a0\u4ee5\u63a7\u5236\uff0c\u5bf9\u5929\u4e0b\u5256\u7b26\u5c01\u8d4f\uff0c\u5f81\u8ba8\u654c\u56fd\uff0c\u6ca1\u6709\u4eba\u6562\u4e0d\u542c\u4ece\uff1b\u6218\u80dc\u653b\u53d6\u7684\u5229\u76ca\u5f52\u4e8e\u9676\u9091\uff0c\u6218\u8d25\u5219\u4e0e\u767e\u59d3\u7ed3\u6028\u800c\u628a\u7978\u60a3\u5f52\u4e8e\u56fd\u5bb6\u3002\u81e3\u8fd8\u542c\u8bf4\uff0c\u6811\u6728\u679c\u5b9e\u592a\u591a\u5c31\u4f1a\u538b\u65ad\u6811\u679d\uff0c\u538b\u65ad\u6811\u679d\u5c31\u4f1a\u4f24\u5bb3\u6811\u5e72\uff1b\u5c01\u5730\u90fd\u9091\u8fc7\u5927\u5c31\u4f1a\u5371\u5bb3\u56fd\u5bb6\uff0c\u81e3\u4e0b\u8fc7\u4e8e\u5c0a\u8d35\u5c31\u4f1a\u4f7f\u541b\u4e3b\u5351\u4e0b\u3002\u6dd6\u9f7f\u6267\u638c\u9f50\u56fd\u5927\u6743\uff0c\u7528\u7bad\u5c04\u9f50\u6e63\u738b\u7684\u5927\u817f\uff0c\u62bd\u4ed6\u7684\u7b4b\uff0c\u628a\u4ed6\u60ac\u540a\u5728\u5e99\u5802\u7684\u6881\u4e0a\uff0c\u6298\u78e8\u4e00\u591c\u624d\u6b7b\u53bb\u3002\u674e\u5151\u6267\u638c\u8d75\u56fd\u5927\u6743\uff0c\u628a\u8d75\u4e3b\u7236\u56da\u7981\u5728\u6c99\u4e18\u5bab\u4e2d\uff0c\u4e00\u767e\u5929\u540e\u88ab\u6d3b\u6d3b\u997f\u6b7b\u3002\u5982\u4eca\u81e3\u770b\u56db\u4f4d\u6743\u8d35\u6267\u653f\u7684\u60c5\u5f62\uff0c\u4ed6\u4eec\u4e5f\u6b63\u662f\u6dd6\u9f7f\u3001\u674e\u5151\u4e00\u7c7b\u7684\u4eba\u554a\u3002\u590f\u3001\u5546\u3001\u5468\u4e09\u4ee3\u4e4b\u6240\u4ee5\u4ea1\u56fd\uff0c\u662f\u56e0\u4e3a\u56fd\u541b\u628a\u56fd\u653f\u4e13\u95e8\u4ea4\u7ed9\u81e3\u4e0b\uff0c\u81ea\u5df1\u7eb5\u9152\u5c04\u730e\uff1b\u800c\u90a3\u4e9b\u88ab\u6388\u4e88\u6743\u529b\u7684\u4eba\u5ac9\u8d24\u5992\u80fd\uff0c\u63a7\u5236\u4e0b\u5c5e\u3001\u8499\u853d\u541b\u4e0a\uff0c\u4ee5\u6210\u5c31\u81ea\u5df1\u7684\u79c1\u5229\uff0c\u4e0d\u4e3a\u541b\u4e3b\u8c0b\u5212\uff0c\u541b\u4e3b\u53c8\u4e0d\u89c9\u609f\uff0c\u6240\u4ee5\u4e27\u5931\u4e86\u56fd\u5bb6\u3002\u5982\u4eca\u81ea\u6709\u79e9\u4ee5\u4e0a\u7684\u5c0f\u5b98\u76f4\u5230\u5404\u5927\u5b98\u540f\u3002\u4e0b\u53ca\u5927\u738b\u8eab\u8fb9\u7684\u4f8d\u4ece\uff0c\u6ca1\u6709\u4e00\u4e2a\u4e0d\u662f\u76f8\u56fd\u7684\u4eba\uff0c\u81e3\u89c1\u5927\u738b\u5728\u671d\u4e2d\u5b64\u8eab\u4e00\u4eba\uff0c\u79c1\u4e0b\u4e3a\u5927\u738b\u62c5\u5fe7\uff0c\u6050\u6015\u5927\u738b\u4e07\u4e16\u4e4b\u540e\uff0c\u62e5\u6709\u79e6\u56fd\u7684\u5c31\u4e0d\u662f\u5927\u738b\u7684\u5b50\u5b59\u4e86\uff01\u201d\u79e6\u662d\u8944\u738b\u8ba4\u4e3a\u8303\u96ce\u8bf4\u5f97\u5bf9\uff0c\u4e8e\u662f\u5e9f\u9edc\u592a\u540e\uff0c\u628a\u7a70\u4faf\u9b4f\u5189\u3001\u9ad8\u9675\u541b\u3001\u534e\u9633\u541b\u3001\u6cfe\u9633\u541b\u9a71\u9010\u5230\u5173\u5916\uff0c\u4efb\u547d\u8303\u96ce\u4e3a\u4e1e\u76f8\uff0c\u5c01\u4ed6\u4e3a\u5e94\u4faf\u3002","content_jianti_auto":"1\u79e6\u62d4\u9b4f\u90a2\u4e18\u3002\u8303\u7762\u65e5\u76ca\u4eb2\uff0c\u7528\u4e8b\uff0c\u56e0\u627f\u95f4\u8bf4\u738b\u66f0\uff1a\u300c\u81e3\u5c45\u5c71\u4e1c\u65f6\uff0c\u95fb\u9f50\u4e4b\u6709\u5b5f\u5c1d\u541b\uff0c\u4e0d\u95fb\u6709\u738b\uff1b\u95fb\u79e6\u6709\u592a\u540e\u3001\u7a70\u4faf\uff0c\u4e0d\u95fb\u6709\u738b\u3002\u592b\u64c5\u56fd\u4e4b\u8c13\u738b\uff0c\u80fd\u5229\u5bb3\u4e4b\u8c13\u738b\uff0c\u5236\u67