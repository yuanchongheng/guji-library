f_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"始皇","people_name_jianti_auto":"始皇","start_index":23,"tongjian_id":"8d2aa7b3-db0e-11ef-b2bd-a0d3651f611f"},{"people_name":"廉頗","people_name_jianti_auto":"廉颇","start_index":38,"tongjian_id":"8d2aa7b4-db0e-11ef-b7eb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"壽春縣","place_name_jianti_auto":"寿春县","start_index":6,"tongjian_id":"8d2aa7b5-db0e-11ef-9828-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":10,"tongjian_id":"8d2aa7b6-db0e-11ef-841d-a0d3651f611f"},{"place_name":"九江郡","place_name_jianti_auto":"九江郡","start_index":12,"tongjian_id":"8d2aa7b7-db0e-11ef-9654-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":16,"tongjian_id":"8d2aa7b8-db0e-11ef-bad5-a0d3651f611f"},{"place_name":"壽州","place_name_jianti_auto":"寿州","start_index":18,"tongjian_id":"8d2aa7b9-db0e-11ef-8e40-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","place_note":"都陈丘，河南淮阳","start_index":28,"tongjian_id":"8d2aa7ba-db0e-11ef-a462-a0d3651f611f"},{"place_name":"壽春","place_name_jianti_auto":"寿春","start_index":32,"tongjian_id":"8d2aa7bb-db0e-11ef-b27d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻。壽春縣，漢屬九江郡，唐爲壽州治所。始皇六年，楚方徙都壽春，史終言廉頗之事也。卒，子恤翻。","note_content_jianti_auto":"将，即亮翻。寿春县，汉属九江郡，唐为寿州治所。始皇六年，楚方徙都寿春，史终言廉颇之事也。卒，子恤翻。","note_type":"hu_note","start_index":219,"tongjian_id":"8d2aa7b2-db0e-11ef-a252-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"假相國","official_note":"假相國是战国时期赵国的一种官职，意为代理相国，负责辅佐君主处理国家政务。在《资治通鉴》此段中，廉颇被任命为假相国，表明他暂时担任相国职务，以指挥伐魏战役。","official_rank":"未知","source_snippet":"趙以廉頗爲假相國","start_index":2,"tongjian_id":"97488092-eddd-4c4b-bc52-1fb8f971293c"},{"confidence":0.85,"official_category":"军事指挥","official_name":"武襄君","official_note":"武襄君是战国时期赵国的一种封号或官职，通常授予有军功的将领，可能涉及军事指挥职责。在此段中，武襄君乐乘被派去代替廉颇，显示其在军事上的角色。","official_rank":"未知","source_snippet":"使武襄君樂乘代廉頗","start_index":24,"tongjian_id":"3c94651f-908e-4ac5-b903-9d6d0f4b2ceb"},{"confidence":0.8,"official_category":"军事指挥","official_name":"廉將軍","official_note":"廉將軍是对廉颇的尊称，指其将军职务，负责军事指挥。在《资治通鉴》此段中，使者回报中提到廉将军，表明廉颇曾担任将军，但此时已年老，赵王考虑其可用性。","official_rank":"未知","source_snippet":"廉將軍雖老","start_index":126,"tongjian_id":"09659fdf-b366-4f10-8ce2-7d49224fd941"},{"confidence":0.9,"official_category":"军事指挥","official_name":"楚將","official_note":"楚將指楚国将军，是军事指挥官职。在此段中，廉颇逃亡到魏国后，被楚国暗中迎接并任命为楚将，但无功而返，显示其军事生涯的延续。","official_rank":"未知","source_snippet":"廉頗一爲楚將","start_index":172,"tongjian_id":"d36df104-bcc8-4646-9c76-4e40cecfecdd"}],"ExtRef_Children_people":[{"link_birth_year":-327,"link_death_year":-243,"link_td_description":"廉颇，嬴姓，廉氏，名颇，字洪野，战国末期赵国之将领，与白起、王翦、李牧并称“战国四大名将”。曾战胜齐国、魏国、燕国。","link_td_id":"Q10001053","link_td_number_id":29932,"people_name":"廉頗","people_name_jianti_auto":"廉颇","people_xingming":"廉颇","start_index":3,"tongjian_id":"8d2aa7bc-db0e-11ef-95b8-a0d3651f611f"},{"link_death_year":-245,"link_td_description":"赵孝成王，是中国战国时期赵国君主，原名赵丹，赵惠文王之子。","link_td_id":"Q10000660","link_td_number_id":334708,"people_name":"趙孝成王","people_name_jianti_auto":"赵孝成王","people_xingming":"赵丹","start_index":17,"tongjian_id":"8d2aa7c0-db0e-11ef-89bb-a0d3651f611f","wl_zhushi":"[赵丹]"},{"link_death_year":-236,"link_td_description":"赵悼襄王是中国战国时期赵国君主，原名赵偃，赵孝成王之子。","link_td_id":"Q10000659","link_td_number_id":334710,"people_name":"悼襄王","people_name_jianti_auto":"悼襄王","people_xingming":"赵偃","start_index":24,"tongjian_id":"8d2aa7c1-db0e-11ef-b725-a0d3651f611f","wl_zhushi":"[赵偃]"},{"link_td_description":"乐乘，中国战国时代政治人物，乐毅的族人。在燕国为将。前251年，燕王喜攻打赵国，赵将廉颇大败燕军，燕国相栗腹和乐乘被俘虏，乐乘弃燕归赵。赵国封乐乘为武襄君。第二年（前250年），乐乘、廉颇为赵围燕，燕国重礼求和。五年后（前245年），赵孝成王去世。赵悼襄王使乐乘代廉颇。廉颇攻乐乘，乐乘离开，廉颇流亡魏国。其十六年后（前228年）秦国灭赵。","link_td_id":"Q10012757","link_td_number_id":1501114,"people_name":"武襄君","people_name_jianti_auto":"武襄君","people_xingming":"乐乘","start_index":30,"tongjian_id":"8d2aa7c2-db0e-11ef-abe7-a0d3651f611f"},{"link_td_descriptio