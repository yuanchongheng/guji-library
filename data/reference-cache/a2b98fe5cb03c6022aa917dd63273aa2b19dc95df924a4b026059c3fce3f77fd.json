{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁丑、六七七）","note_content_jianti_auto":"（丁丑、六七七）","note_type":"hu_note","start_index":0,"tongjian_id":"b9d0403d-db0e-11ef-91a7-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，乙亥，上耕藉田。","content_fanyi":"春季，正月十二日乙亥，高宗举行亲耕藉田典礼。","content_jianti_auto":"1春，正月，乙亥，上耕藉田。","dtjl_paragraph_links":[],"dtjl_references":[],"id":19907,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"b9d0403e-db0e-11ef-8621-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":7,"source_start_index":0,"source_text":"見上卷麟德二年","target_paragraph_tongjian_id":"b99d9f3d-db0e-11ef-8457-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見上卷麟德二年。","note_content_jianti_auto":"见上卷麟德二年。","note_type":"hu_note","start_index":13,"tongjian_id":"b9d04040-db0e-11ef-aa1c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"安東都護府","place_name_jianti_auto":"安东都护府","start_index":5,"tongjian_id":"b9d04044-db0e-11ef-8491-a0d3651f611f"},{"place_name":"遼東","place_name_jianti_auto":"辽东","start_index":11,"tongjian_id":"b9d04045-db0e-11ef-be69-a0d3651f611f"},{"place_name":"新城","place_name_jianti_auto":"新城","place_note":"辽宁省抚顺市北","start_index":20,"tongjian_id":"b9d04046-db0e-11ef-874e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年春，移安東都護府於遼東故城，今又移於新城。統，他綜翻。","note_content_jianti_auto":"去年春，移安东都护府于辽东故城，今又移于新城。统，他综翻。","note_type":"hu_note","start_index":126,"tongjian_id":"b9d04043-db0e-11ef-a30b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"工部尚書","official_note":"工部尚書是唐代六部之一工部的长官，负责工程、水利等事务，此处高藏被任命此职，但随后改任地方官职，反映了唐朝对高丽旧臣的安置策略。","official_rank":"正三品","source_snippet":"以工部尚書高藏爲遼東州都督","start_index":34,"tongjian_id":"28fb6e56-11d8-442d-a290-162de58bedca"},{"confidence":0.9,"official_category":"地方行政","official_name":"遼東州都督","official_note":"遼東州都督是唐朝在辽东地区设置的都督府长官，负责管理当地军政事务，此处高藏被任命此职以安抚高丽余众，但后来谋叛失败。","official_rank":"未知","source_snippet":"以工部尚書高藏爲遼東州都督","start_index":40,"tongjian_id":"bcb2c98f-dcef-4207-8a5d-b1fa4516d913"},{"confidence":0.85,"official_category":"封爵","official_name":"朝鮮王","official_note":"朝鮮王是唐朝赐予高丽的封号，表示对高藏的王爵册封，旨在稳定高丽旧地，但高藏后来谋叛导致封爵失效。","official_rank":"王爵","source_snippet":"封朝鮮王","start_index":45,"tongjian_id":"27e36be5-b0c7-4d78-869f-4e2fb66b7d61"},{"confidence":0.95,"official_category":"中枢机构","official_name":"司農卿","official_note":"司農卿是唐代司农寺的长官，负责农业、仓储等事务，此处扶餘隆被任命此职，但随后改任地方官职，用于安抚百济余众。","official_rank":"正三品","source_snippet":"又以司農卿扶餘隆爲熊津都督","start_index":67,"tongjian_id":"a9c42fe1-0a43-4992-b841-4900ee6aad48"},{"confidence":0.9,"official_category":"地方行政","official_name":"熊津都督","official_note":"熊津都督是唐朝在熊津地区设置的都督府长官，负责管理百济旧地的军政事务，此处扶餘隆被任命此职以安抚百济余众，但后来因局势动荡未敢返回。","official_rank":"未知","source_snippet":"又以司農卿扶餘隆爲熊津都督","start_index":73,"tongjian_id":"18b85788-ac7c-4f56-a218-2a02cd76e8c6"},{"confidence":0.85,"official_category":"封爵","official_name":"帶方王","official_note":"帶方王是唐朝赐予百济的封号，表示对扶餘隆的王爵册封，旨在稳定百济旧地，但扶餘隆后来未敢返回故地。","official_rank":"王爵","source_snippet":"封帶方王","start_index":78,"tongjian_id":"27f2f36a-e945-4f65-99f4-2a33621add8d"},{"confidence":0.9,"official_category":"地方行政","official_name":"安東都護府","official_note":"安東都護府是唐朝在东北地区设置的都护府，负责统辖高丽、百济等地的军政事务，此处迁移至新城以加强控制。","official_rank":"未知","source_snippet":"仍移安東都護府於新城以統之","start_index":88,"tongjian_id":"20eafbc0-4cac-40a9-bcf2-a8fbc78f663a"}],"ExtRef_Children_people":[{"link_birth_year":602,"link_death_year":685,"link_td_description":"刘仁轨，字正则，汴州尉氏县（今河南省尉氏县）人，唐朝官员。","link_td_id":"Q10004715","link_td_number_id":580729,"people_name":"劉仁軌","people_name_jianti_auto":"刘仁轨","people_xingming":"刘仁轨","start_index":3,"tongjian_id":"b9d2909b-db0e-11ef-af98-a0d3651f611f"},{"people_name":"扶餘隆","people_name_jianti_auto":"扶余隆","people_xingming":"扶餘隆","start_index":13,"tongjian_id":"b9d2909d-db0e-11ef-9b5a-a0d3651f611f"},{"people_name":"高藏","people_name_jianti_auto":"高藏","people_xingming":"高藏","start_index":42,"tongjian_id":"b9d2a492-db0e-11ef-a808-a0d3651f611f","wl_zhushi":"[高句丽末任王]"},{"people_name":"朝鮮王","people_name_jianti_auto":"朝鲜王","people_xingming":"高藏","start_index":52,"tongjian_id":"b9d2a493-db0e-11ef-8698-a0d3651f611f"},{"people_name":"藏","people_name_jianti_auto":"藏","people_xingming":"高藏","start_index":79,"tongjian_id":"b9d2a495-db0e-11ef-a14e-a0d3651f611f","wl_zhushi":"[高句丽末任王]"},{"people_name":"扶餘隆","people_name_jianti_auto":"扶余隆","start_index":88,"tongjian_id":"b9d2a496-db0e-11ef-9025-a0d3651f611f"},{"people_name":"帶方王","people_name_jianti_auto":"带方王","people_xingming":"扶餘隆","start_index":98,"tongjian_id":"b9d2a497-db0e-11ef-a29d-a0d3651f611f"},{"people_name":"隆","people_name_jianti_auto":"隆","people_xingming":"扶餘隆","start_index":133,"tongjian_id":"b9d2a49f-db0e-11ef-bd54-a0d3651f611f"},{"people_name":"藏","people_name_jianti_auto":"藏","people_xingming":"高藏","start_index":141,"tongjian_id":"b9d2a4a0-db0e-11ef-b