:[],"dtjl_references":[],"id":21215,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"bca4ca98-db0e-11ef-abec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋璟","people_name_jianti_auto":"宋璟","start_index":2,"tongjian_id":"bca4ca9e-db0e-11ef-bb00-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"廣州","place_name_jianti_auto":"广州","start_index":5,"tongjian_id":"bca4ca9f-db0e-11ef-9aeb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年宋璟自廣州入相。爲，于僞翻。璟，居永翻。","note_content_jianti_auto":"去年宋璟自广州入相。为，于伪翻。璟，居永翻。","note_type":"hu_note","start_index":13,"tongjian_id":"bca4ca9d-db0e-11ef-841e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":663,"link_death_year":737,"link_td_description":"宋璟，邢州南和县（今河北省邢台市南和区）人，祖籍广平郡列人县（今河北省邯郸市肥乡区），为唐玄宗开元初期宰相。","link_td_id":"Q10008310","link_td_number_id":202797,"people_name":"宋璟","people_name_jianti_auto":"宋璟","people_xingming":"宋璟","start_index":6,"tongjian_id":"bca4caa1-db0e-11ef-bfcb-a0d3651f611f"},{"link_birth_year":663,"link_death_year":737,"link_td_description":"宋璟，邢州南和县（今河北省邢台市南和区）人，祖籍广平郡列人县（今河北省邯郸市肥乡区），为唐玄宗开元初期宰相。","link_td_id":"Q10008310","link_td_number_id":202797,"people_name":"璟","people_name_jianti_auto":"璟","people_xingming":"宋璟","start_index":13,"tongjian_id":"bca4caa3-db0e-11ef-826b-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"廣州","place_name_jianti_auto":"广州","place_note":"广东广州","resolved_place_entity_id":328,"start_index":1,"tongjian_id":"bca4caa2-db0e-11ef-b09c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"2廣州吏民爲宋璟立遺愛碑。璟上言：「臣在州無他異迹，今以臣光寵，成彼諂諛；欲革此風，望自臣始，請敕下禁止。」上從之。於是他州皆不敢立。","content_fanyi":"广州的官吏和百姓为宋璟立遗爱碑。宋璟上奏说：“臣在广州担任都督期间并没有其他特别优异的政绩，如今由于臣受到皇上的恩宠，反而助长了那些人的谄媚阿谀；想要革除这种风气，希望从臣开始，请求陛下降敕予以禁止。”皇上听从了他的意见。于是其他各州都不敢再立碑。","content_jianti_auto":"2广州吏民为宋璟立遗爱碑。璟上言：「臣在州无他异迹，今以臣光宠，成彼谄谀；欲革此风，望自臣始，请敕下禁止。」上从之。于是他州皆不敢立。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21216,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"bca4ca9c-db0e-11ef-afc4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"武后","people_name_jianti_auto":"武后","start_index":86,"tongjian_id":"bca4caa6-db0e-11ef-8d97-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"兩京","place_name_jianti_auto":"两京","start_index":133,"tongjian_id":"bca4caa7-db0e-11ef-a3c6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武德四年鑄開元通寶錢。其後盜鑄漸起，顥慶五年以惡錢多，官爲市之，以一善錢售五惡錢。民間藏惡錢以待禁㢮。乾封以後，私錢犯法日蕃，有以舟筏鑄於江中者。詔所在納惡錢，而姦亦不息。武后時，錢非穿穴及鐵錫銅液，皆得用之，熟銅排斗沙澀之錢皆售。自是盜鑄蜂起，吏莫能捕。先天之際，兩京錢益濫，或鎔錫模錢，須臾百十，故禁之。","note_content_jianti_auto":"武德四年铸开元通宝钱。其后盗铸渐起，颢庆五年以恶钱多，官为市之，以一善钱售五恶钱。民间藏恶钱以待禁㢮。干封以后，私钱犯法日蕃，有以舟筏铸于江中者。诏所在纳恶钱，而奸亦不息。武后时，钱非穿穴及铁锡铜液，皆得用之，熟铜排斗沙涩之钱皆售。自是盗铸蜂起，吏莫能捕。先天之际，两京钱益滥，或镕锡模钱，须臾百十，故禁之。","note_type":"hu_note","start_index":9,"tongjian_id":"bca4caa5-db0e-11ef-abdd-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"财政","official_name":"太府","official_note":"太府是唐代掌管国家财政和国库的机构，此处指太府寺的钱财，用于平抑市场物价。","official_rank":"未知","source_snippet":"太府錢","start_index":58,"tongjian_id":"855829d0-909e-42cd-a3ea-db2adea89648"}],"ExtRef_Children_people":[{"link_birth_year":663,"link_death_year":737,"link_td_description":"宋璟，邢州南和县（今河北省邢台市南和区）人，祖籍广平郡列人县（今河北省邯郸市肥乡区），为唐玄宗开元初期宰相。","link_td_id":"Q10008310","link_td_number_id":202797,"people_name":"宋璟","people_name_jianti_auto":"宋璟","people_xingming":"宋璟","start_index":46,"tongjian_id":"bca4caaa-db0e-11ef-b750-a0d3651f611f"},{"link_birth_year":670,"link_death_year":727,"link_td_description":"苏颋，字庭硕，京兆武功县（今陕西省武功县）人。唐玄宗宰相，封许国公。善于文学，与燕国公张说齐名，时称“燕许大手笔”。","link_td_id":"Q10012872","link_td_number_id":1515513,"people_name":"蘇頲","people_name_jianti_auto":"苏颋","people_xingming":"苏颋","start_index":49,"tongjian_id":"bca4caab-db0e-11ef-9d2d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"京城","place_name_jianti_auto":"京城","place_note":"首都长安","resolved_place_entity_id":413,"start_index":36,"tongjian_id":"bca4caac-db0e-11ef-8c27-a0d3651f611f"},{"place_name":"兩京","place_name_jianti_auto":"两京","resolved_place_entity_id":944,"start_index":82,"tongjian_id":"bca4caad-db0e-11ef-afe3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3辛酉，敕禁惡錢，重二銖四分以上乃得行。斂人間惡錢鎔之，更鑄如式錢。於是京城紛然，賣買殘絕。宋璟、蘇頲請出太府錢二萬緡置南北市，以平價買百姓不售之物可充官用者，及聽兩京百官豫假俸錢，庶使良錢流布人間，從之。","content_fanyi":"辛酉日，皇上颁布敕令禁止恶钱流通，规定重量在二铢四分以上的钱币方可通行。又收缴民间恶钱加以熔炼，重新铸成符合定式的钱币。于是京城秩序纷乱，买卖几乎断绝。宋璟、苏颋请求拨出太府钱二万缗分置于南北二市，用于平价收购百姓卖不出去而可充官用的物品，并允许两京百官预借俸钱，希望使良钱流布于人间，皇上听从了。","content_jianti_auto":"3辛酉，敕禁恶钱，重二铢四分以上乃得行。敛人间恶钱镕之，更铸如式钱。于是京城纷然，卖买残绝。宋璟、苏颋请出太府钱二万缗置南北市，以平价买百姓不售之物可充官用者，及听两京百官豫假俸钱，庶使良钱流布人间，从之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":21217,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"bca4caa4-db0e-11ef-b09b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"bca4cab0-db0e-11ef-aa86-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"橫野軍","place_name_jianti_auto":"横野军","start_index":4,"tongjian_id":"bca4cab1-db0e-11ef-bf60-a0d3651f611f"},{"place_name":"蔚州","place_name_jianti_auto":"蔚州","start_index":8,"tongjian_id":"bca4cab2-db0e-11ef-ab76-a0d3651f611f"},{"place_name":"太原","place_name_jianti_auto":"太原","start_index":18,"tongjian_id":"bca4cab3-db0e-11ef-a139-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：橫野軍在蔚州東北百四十里，去太原九百里。此蓋指言開元所移軍之地。蔚，紆勿翻。","note_content_jianti_auto":"杜佑曰：横野军在蔚州东北百四十里，去太原九百里。此盖指言开元所移军之地。蔚，纡勿翻。","note_type":"hu_note","start_index":17,"tongjian_id":"bca4caaf-db0e-11ef-9bc6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"頡，戶結翻。啜，陟劣翻。霫，而立翻。騎，奇寄翻。吏，疏吏翻；下同。","note_content_jianti_auto":"颉，户结翻。啜，陟劣翻。霫，而立翻。骑，奇寄翻。吏，疏吏翻；下同。","note_type":"hu_note","start_index":89,"tongjian_id":"bca4cab4-db0e-11ef-a8fa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"執米啜","people_name_jianti_auto":"执米啜","start_index":42,"tongjian_id":"bca4cab6-db0e-11ef-ad91-a0d3651f611f"},{"people_name":"骨篤祿","people_name_jianti_auto":"骨笃禄","start_index":50,"tongjian_id":"bca4cab7-db0e-11ef-9aa6-a0d3651f611f"},{"people_name":"毗伽","people_name_jianti_auto":"毗伽","start_index":53,"tongjian_id":"bca4cab8-db0e-11ef-a362-a0d3651f611f"},{"people_name":"李失活","people_name_jianti_auto":"李失活","start_index":60,"tongjian_id":"bca4cab9-db0e-11ef-aa45-a0d3651f611f"},{"people_name":"李大酺","people_name_jianti_auto":"李大酺","start_index":67,"tongjian_id":"bca4caba-db0e-11ef-9872-a0d3651f611f"},{"people_name":"默啜","people_name_jianti_auto":"默啜","start_index":71,"tongjian_id":"bca4cabb-db0e-11ef-81f8-a0d3651f611f"},{"people_name":"右賢王","people_name_jianti_auto":"右贤王","start_index":7