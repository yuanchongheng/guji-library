-87b0-a0d3651f611f"},{"people_name":"夫差","people_name_jianti_auto":"夫差","start_index":80,"tongjian_id":"8cb90bd8-db0e-11ef-ba84-a0d3651f611f"},{"people_name":"子胥","people_name_jianti_auto":"子胥","start_index":84,"tongjian_id":"8cb90bd9-db0e-11ef-8e5b-a0d3651f611f"},{"people_name":"子胥","people_name_jianti_auto":"子胥","start_index":98,"tongjian_id":"8cb90bda-db0e-11ef-af70-a0d3651f611f"},{"people_name":"夫差","people_name_jianti_auto":"夫差","start_index":103,"tongjian_id":"8cb90bdb-db0e-11ef-b752-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":119,"tongjian_id":"8cb90bdc-db0e-11ef-a1e8-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":136,"tongjian_id":"8cb90bdd-db0e-11ef-91a9-a0d3651f611f"},{"people_name":"子胥","people_name_jianti_auto":"子胥","start_index":157,"tongjian_id":"8cb90bde-db0e-11ef-a84a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":5,"tongjian_id":"8cb90bdf-db0e-11ef-914c-a0d3651f611f"},{"place_name":"郢","place_name_jianti_auto":"郢","place_note":"湖北江陵","start_index":7,"tongjian_id":"8cb90be0-db0e-11ef-a8b8-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":41,"tongjian_id":"8cb90be1-db0e-11ef-891a-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":60,"tongjian_id":"8cb90be2-db0e-11ef-b54f-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":72,"tongjian_id":"8cb90be3-db0e-11ef-a525-a0d3651f611f"},{"place_name":"郢","place_name_jianti_auto":"郢","start_index":74,"tongjian_id":"8cb90be4-db0e-11ef-aff2-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":116,"tongjian_id":"8cb90be5-db0e-11ef-98a6-a0d3651f611f"},{"place_name":"江","place_name_jianti_auto":"江","start_index":165,"tongjian_id":"8cb90be6-db0e-11ef-b95f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"遠迹，言自吳至郢，其道里甚遠而行迹得至也。弗是，謂夫差弗以子胥之言爲是也。伍子胥，楚人也。楚平王信讒，殺其父、兄，子胥奔吳。吳王闔閭信而用之，伐楚入郢。闔閭卒，夫差立，子胥屢諫不聽，賜之屬鏤以死。子胥旣死，夫差取其尸，盛之鴟夷，浮之江中。應劭曰：鴟夷，榼形也，以馬革爲之。韋昭曰：革囊也。或曰：生牛皮也。索隱曰：言子胥怨恨，故雖投江而神不化，猶爲波濤之神也。郢，以井翻。說，式芮翻。夫，音扶。差，初加翻。鴟，丑之翻。沈，持林翻。量，力讓翻。闔，戶臘翻。卒，子恤翻。鏤，力俱翻，又力侯翻。盛，時征翻。榼，戶盍翻。","note_content_jianti_auto":"远迹，言自吴至郢，其道里甚远而行迹得至也。弗是，谓夫差弗以子胥之言为是也。伍子胥，楚人也。楚平王信谗，杀其父、兄，子胥奔吴。吴王阖闾信而用之，伐楚入郢。阖闾卒，夫差立，子胥屡谏不听，赐之属镂以死。子胥既死，夫差取其尸，盛之鸱夷，浮之江中。应劭曰：鸱夷，榼形也，以马革为之。韦昭曰：革囊也。或曰：生牛皮也。索隐曰：言子胥怨恨，故虽投江而神不化，犹为波涛之神也。郢，以井翻。说，式芮翻。夫，音扶。差，初加翻。鸱，丑之翻。沈，持林翻。量，力让翻。阖，户腊翻。卒，子恤翻。镂，力俱翻，又力侯翻。盛，时征翻。榼，户盍翻。","note_type":"hu_note","start_index":161,"tongjian_id":"8cb90bcf-db0e-11ef-8d69-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"離，與罹同。墮，與隳同，音火規翻；後凡墮毀之墮皆同音。","note_content_jianti_auto":"离，与罹同。堕，与隳同，音火规翻；后凡堕毁之堕皆同音。","note_type":"hu_note","start_index":199,"tongjian_id":"8cb90be9-db0e-11ef-bb38-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"趙","place_name_jianti_auto":"赵","start_index":4,"tongjian_id":"8cb90beb-db0e-11ef-8fd5-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":6,"tongjian_id":"8cb90bec-db0e-11ef-adf0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂不敢與趙謀燕。","note_content_jianti_auto":"谓不敢与赵谋燕。","note_type":"hu_note","start_index":218,"tongjian_id":"8cb90bea-db0e-11ef-b488-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不佞，猶言不才也。","note_content_jianti_auto":"不佞，犹言不才也。","note_type":"hu_note","start_index":247,"tongjian_id":"8cb90bed-db0e-11ef-b1bf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕，因肩翻。索隱曰：閒，音紀閑翻。","note_content_jianti_auto":"燕，因肩翻。索隐曰：闲，音纪闲翻。","note_type":"hu_note","start_index":279,"tongjian_id":"8cb90bef-db0e-11ef-8fe1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毅","people_name_jianti_auto":"毅","start_index":10,"tongjian_id":"8cb90bf2-db0e-11ef-82ba-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"望諸","place_name_jianti_auto":"望诸","place_note":"即孟诸。在今河南商丘县东北、虞城县西北。唐时泽面周五十里。金、元后堙废","start_index":0,"tongjian_id":"8cb90bf3-db0e-11ef-ae09-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":7,"tongjian_id":"8cb90bf4-db0e-11ef-bc67-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":12,"tongjian_id":"8cb90bf5-db0e-11ef-9e1a-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":14,"tongjian_id":"8cb90bf6-db0e-11ef-a5ec-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":16,"tongjian_id":"8cb90bf7-db0e-11ef-b8bc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"望諸，澤名，本齊地；毅自齊奔趙，趙人以此號之，本其所從來也。卒，子恤翻。","note_content_jianti_auto":"望诸，泽名，本齐地；毅自齐奔赵，赵人以此号之，本其所从来也。卒，子恤翻。","note_type":"hu_note","start_index":298,"tongjian_id":"8cb90bf1-db0e-11ef-aae7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"觀津","place_name_jianti_auto":"观津","place_note":"河北武邑","resolved_place_entity_id":2996,"start_index":6,"tongjian_id":"8cb90bfa-db0e-11ef-a628-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、河间府（卷十三）","excerpts":[{"context_after":"歷当作磿。或讹为磨。即此地也。汉置歷县，属信都国。《史记...","context_before":"...读条。后汉省。又歷县城，《括地志》：在蓚县西南四十六里。","source_end_index":80,"source_paragraph_tongjian_id":"f84a820e-bffa-55e5-b145-ae3c524ee2b0","source_start_index":63,"source_text":"《战国策》：乐毅曰：故鼎反乎歷室。"}],"path":"北直方舆纪要/三、河间府（卷十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、真定府（卷十四）","excerpts":[{"context_after":"汉置观津县，属信都国。后汉属安平国。晋因之。后魏曰灌津，...","context_before":"○观津城[县东南三十三里。","source_end_index":37,"source_paragraph_tongjian_id":"441032fc-b1a1-5548-ae8c-068a3905e8e1","source_start_index":13,"source_text":"战国时赵邑。乐毅去燕归赵，赵封之于此，号望诸君。"}],"path":"北直方舆纪要/四、真定府（卷十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、苏州府（卷二十四）","excerpts":[{"context_after":"胥口之外曰胥湖，南有高峰穹窿之脉尽于此。○白石山，在府西...","context_before":"...泾也，相传吴王种香处。又有胥山，《寰宇记》：山在太湖口。","source_end_index":157,"source_paragraph_tongjian_id":"46044ed2-c077-53d8-8037-4ac85c09a2cf","source_start_index":132,"source_text":"吴王杀子胥，投之于江，吴人立祠于此，胥口盖因以名。"}],"path":"南直方舆纪要/五、苏州府（卷二十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、荆州府（卷七十八）","excerpts":[{"context_after":"又东北出城，复西南流注于龙陂。又诸倪冈，在府东三十里。《...","context_before":"赤坂冈[在城西。《水经注》：","source_end_index":58,"source_paragraph_tongjian_id":"21a822b1-822c-5926-bea5-1fd3a167ac5a","source_start_index":14,"source_text":"纪南城西南有赤坂冈，下有渎水，东北流入城。相传子胥入郢时所开，亦谓之子胥渎，一名西京湖。"}],"path":"湖广方舆纪要/七、荆州府（卷七十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"趙王封樂毅於觀津，尊寵之，以警動於燕、齊。燕惠王乃使人讓樂毅，且謝之曰：「將軍過聽，以與寡人有隙，遂捐燕歸趙。將軍自爲計則可矣，而亦何以報先王之所以遇將軍之意乎？」樂毅報書曰：「昔伍子胥說聽於闔閭而吳遠迹至郢；夫差弗是也，賜之鴟夷而浮之江。吳王不寤先論之可以立功，故沈子胥而不悔；子胥不蚤見主之不同量，是以至於入江而不化。夫免身立功以明先王之迹，臣之上計也。離毀辱之誹謗，墮先王之名，臣之所大恐也。臨不測之罪，以幸爲利，義之所不敢出也。臣聞古之君子，交絕不出惡聲，忠臣去國，不潔其名。臣雖不佞，數奉敎於君子矣。唯君王之留意焉！」於是燕王復以樂毅子閒爲昌國君，而樂毅往來復通燕，卒於趙，號曰望諸君。","content_fanyi":"赵惠文王把观津分封给乐毅，对他十分尊重宠信，借此使燕、齐两国警戒。燕惠王便派人去责备乐毅，同时向他表示歉意说：“将军误信了流言，以为与寡人之间有了嫌隙，就抛弃燕国，归附赵国。将军为自己打算是可以的，但您又拿什么来报答我燕国先王当初厚待将军的恩义呢？”乐毅回信说：“从前伍子胥的建议被吴王阖闾听从，吴国军队因此远征到楚国郢都；夫差却不是这样，他赐死伍子胥，用皮囊装着他的尸体漂浮在江上。吴王夫差不明白伍子胥先前的计谋本可建立功业，所以把伍子胥沉入江中而不后悔；伍子胥没有及早看出阖闾、夫差两位君主器量不同，因此直到尸体被沉入江中，心意仍未改变。臣离开燕国，免遭大难并保全功业，用以显扬先王的事迹，这是臣的上策。遭到毁谤羞辱，损害先王的名声，这是臣最恐惧的事。面临不可测度的罪罚，却想侥幸从中取利，这在道义上是臣绝不敢做的。我听说古代的君子，与人断交也不说对方坏话；忠臣离开国家，不靠损害国君声誉来洗刷自己的名声。臣虽然不才，也曾多次承蒙古今君子的教诲。希望君王对此多加留意！”于是燕惠王又封乐毅的儿子乐间为昌国君，乐毅也往返于燕、赵两国之间，重新与燕国通好，最后死在赵国，号称望诸君。","content_jianti_auto":"赵王封乐毅于观津，尊宠之，以警动于燕、齐。燕惠王乃使人让乐毅，且谢之曰：「将军过听，以与寡人有隙，遂捐燕归赵。将军自为计则可矣，而亦何以报先王之所以遇将军之意乎？」乐毅报书曰：「昔伍子胥说听于阖闾而吴远迹至郢；夫差弗是也，赐之鸱夷而浮之江。吴王不寤先论之可以立功，故沈子胥而不悔；子胥不蚤见主之不同量，是以至于入江而不化。夫免身立功以明先王之迹，臣之上计也。离毁辱之诽谤，堕先王之名，臣之所大恐也。临不测之罪，以幸为利，义之所不敢出也。臣闻古之君子，交绝不出恶声，忠臣去国，不洁其名。臣虽不佞，数奉教于君子矣。唯君王之留意焉！」于是燕王复以乐毅子闲为昌国君，而乐毅往来复通燕，卒于赵，号曰望诸君。","dtjl_paragraph_links":[],"dtjl_references":[],"id":365,"path":"资治通鉴 : 卷第四 (周紀四) / 赧王中 / 三十六年 / 第 9 段","reading_annotation_sources":[],"start_index":8,"tongjian_id":"8cb90bc8-db0e-11ef-abca-a0d3651f611f","year_int":-279},"tongjian_id":"8cb90bc8-db0e-11ef-abca-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"觀津","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":0,"tongjian_id":"8d3af0aa-db0e-11ef-9e95-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"壽陵","place_name_jianti_auto":"寿陵","start_index":4,"tongjian_id":"8d3af0ab-db0e-11ef-a08e-a0d3651f611f"},{"place_name":"常山","place_name_jianti_auto":"常山","start_index":7,"tongjian_id":"8d3af0ac-db0e-11ef-8e0b-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":17,"tongjian_id":"8d3af0ad-db0e-11ef-8cfa-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":26,"tongjian_id":"8d3af0ae-db0e-11ef-95fb-a0d3651f611f"},{"place_name":"壽陵","place_name_jianti_auto":"寿陵","start_index":29,"tongjian_id":"8d3af0af-db0e-11ef-b776-a0d3651f611f"},{"place_name":"函谷","place_name_jianti_auto":"函谷","place_note":"河南靈寶东北","start_index":33,"tongjian_id":"8d3af0b0-db0e-11ef-acf0-a0d3651f611f"},{"place_name":"壽陵","place_name_jianti_auto":"寿陵","start_index":37,"tongjian_id":"8d3af0b1-db0e-11ef-b817-a0d3651f611f"},{"place_name":"新安","place_name_jianti_auto":"新安","start_index":41,"tongjian_id":"8d3af0b2-db0e-11ef-8f36-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","start_index":44,"tongjian_id":"8d3af0b3-db0e-11ef-bcb2-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":51,"tongjian_id":"8d3af0b4-db0e-11ef-8757-a0d3651f611f"},{"place_name":"常山","place_name_jianti_auto":"常山","start_index":56,"tongjian_id":"8d3af0b5-db0e-11ef-9b18-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徐廣曰：壽陵在常山。史記正義曰：本趙邑也。余據五國攻秦，取壽陵，至函谷，則壽陵不在新安、宜陽之閒，當在河東郡界；常山無乃太遠！","note_content_jianti_auto":"徐广曰：寿陵在常山。史记正义曰：本赵邑也。余据五国攻秦，取寿陵，至函谷，则寿陵不在新安、宜阳之闲，当在河东郡界；常山无乃太远！","note_type":"hu_note","start_index":32,"tongjian_id":"8d3af0a9-db0e-11ef-85f3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":20,"tongjian_id":"8d3af0b8-db0e-11ef-bc4f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":12,"tongjian_id":"8d3af0b9-db0e-11ef-8718-a0d3651f611f"},{"place_name":"觀城縣","place_name_jianti_auto":"观城县","start_index":14,"tongjian_id":"8d3af0ba-db0e-11ef-9a61-a0d3651f611f"},{"place_name":"觀津縣","place_name_jianti_auto":"观津县","start_index":23,"tongjian_id":"8d3af0bb-db0e-11ef-a676-a0d3651f611f"},{"place_name":"信都國","place_name_jianti_auto":"信都国","start_index":27,"tongjian_id":"8d3af0bc-db0e-11ef-a6d6-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":36,"tongjian_id":"8d3af0bd-db0e-11ef-9a34-a0d3651f611f"},{"place_name":"觀城","place_name_jianti_auto":"观城","start_index":39,"tongjian_id":"8d3af0be-db0e-11ef-9f02-a0d3651f611f"},{"place_name":"衞國","place_name_jianti_auto":"衞国","start_index":44,"tongjian_id":"8d3af0bf-db0e-11ef-ac9b-a0d3651f611f"},{"place_name":"信都國","place_name_jianti_auto":"信都国","start_index":55,"tongjian_id":"8d3af0c0-db0e-11ef-9403-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":59,"tongjian_id":"8d3af0c1-db0e-11ef-be42-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":60,"tongjian_id":"8d3af0c2-db0e-11ef-8add-a0d3651f611f"},{"place_name":"武邑縣","place_name_jianti_auto":"武邑县","start_index":69,"tongjian_id":"8d3af0c3-db0e-11ef-bb41-a0d3651f611f"},{"place_name":"觀津縣","place_name_jianti_auto":"观津县","start_index":75,"tongjian_id":"8d3af0c4-db0e-11ef-ae3d-a0d3651f611f"},{"place_name":"觀津","place_name_jianti_auto":"观津","start_index":81,"tongjian_id":"8d3af0c5-db0e-11ef-9704-a0d3651f611f"},{"place_name":"信都","place_name_jianti_auto":"信都","start_index":85,"tongjian_id":"8d3af0c6-db0e-11ef-a8be-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：觀，音館，今魏州觀城縣。余按班志，觀津縣屬信都國。又按隋志，魏州之觀城，舊曰衞國，開皇六年始更名；信都國則隋冀州也。開皇六年置武邑縣，幷得觀津縣地，則觀津猶屬信都也。正義誤矣。觀，古玩翻。","note_content_jianti_auto":"史记正义曰：观，音馆，今魏州观城县。余按班志，观津县属信都国。又按隋志，魏州之观城，旧曰衞国，开皇六年始更名；信都国则隋冀州也。开皇六年置武邑县，幷得观津县地，则观津犹属信都也。正义误矣。观，古玩翻。","note_type":"hu_note","start_index":75,"tongjian_id":"8d3af0b7-db0e-11ef-b13d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉昭","people_name_jianti_auto":"刘昭","start_index":0,"tongjian_id":"8d3af0cc-db0e-11ef-bf59-a0d3651f611f"},{"people_name":"張守節","people_name_jianti_auto":"张守节","start_index":31,"tongjian_id":"8d3af0cd-db0e-11ef-8efe-a0d3651f611f"},{"people_name":"康","people_name_jianti_auto":"康","start_index":87,"tongjian_id":"8d3af0ce-db0e-11ef-b8bb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"江夏郡","place_name_jianti_auto":"江夏郡","start_index":4,"tongjian_id":"8d3af0cf-db0e-11ef-8ffe-a0d3651f611f"},{"place_name":"鄳縣","place_name_jianti_auto":"𫑡县","start_index":7,"tongjian_id":"8d3af0d0-db0e-11ef-b8ff-a0d3651f611f"},{"place_name":"冥阨之塞","place_name_jianti_auto":"冥阨之塞","start_index":11,"tongjian_id":"8d3af0d1-db0e-11ef-883b-a0d3651f611f"},{"place_name":"黽阨之塞","place_name_jianti_auto":"黾阨之塞","place_note":"河南信陽西南平靖關","start_index":23,"tongjian_id":"8d3af0d2-db0e-11ef-9368-a0d3651f611f"},{"place_name":"申州","place_name_jianti_auto":"申州","start_index":28,"tongjian_id":"8d3af0d3-db0e-11ef-93de-a0d3651f611f"},{"place_name":"申州","place_name_jianti_auto":"申州","start_index":36,"tongjian_id":"8d3af0d4-db0e-11ef-ae0a-a0d3651f611f"},{"place_name":"羅山縣","place_name_jianti_auto":"罗山县","start_index":38,"tongjian_id":"8d3af0d5-db0e-11ef-9cef-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":42,"tongjian_id":"8d3af0d6-db0e-11ef-a818-a0d3651f611f"},{"place_name":"鄳縣","place_name_jianti_auto":"𫑡县","start_index":43,"tongjian_id":"8d3af0d7-db0e-11ef-a345-a0d3651f611f"},{"place_name":"平靖關","place_name_jianti_auto":"平靖关","start_index":45,"tongjian_id":"8d3af0d8-db0e-11ef-ba5d-a0d3651f611f"},{"place_name":"鄳縣","place_name_jianti_auto":"𫑡县","start_index":50,"tongjian_id":"8d3af0d9-db0e-11ef-9e9b-a0d3651f611f"},{"place_name":"石城山","place_name_jianti_auto":"石城山","start_index":61,"tongjian_id":"8d3af0da-db0e-11ef-bb25-a0d3651f611f"},{"place_name":"申州","place_name_jianti_auto":"申州","start_index":65,"tongjian_id":"8d3af0db-db0e-11ef-934a-a0d3651f611f"},{"place_name":"羅山縣","place_name_jianti_auto":"罗山县","start_index":67,"tongjian_id":"8d3af0dc-db0e-11ef-8902-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉昭曰：江夏郡鄳縣，古冥阨之塞也。史記正義曰：黽阨之塞在申州。張守節曰：申州羅山縣本漢鄳縣平靖關，蓋鄳縣之阨塞。括地志曰：石城山在申州羅山縣東南二十一里，古冥阨塞。黽，音盲；康彌兗切，非也。阨，音厄，又於賣翻。","note_content_jianti_auto":"刘昭曰：江夏郡𫑡县，古冥阨之塞也。史记正义曰：黾阨之塞在申州。张守节曰：申州罗山县本汉𫑡县平靖关，盖𫑡县之阨塞。括地志曰：石城山在申州罗山县东南二十一里，古冥阨塞。黾，音盲；康弥兖切，非也。阨，音厄，又于卖翻。","note_type":"hu_note","start_index":127,"tongjian_id":"8d3af0cb-db0e-11ef-a0f5-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"觀津","place_name_jianti_auto":"观津","place_note":"河北武邑","resolved_place_entity_id":2996,"start_index":64,"tongjian_id":"8d3d6548-db0e-11ef-a10a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/总叙二","excerpts":[{"context_after":"迨其末也，拒群盗而不足。诸葛武侯出剑阁，震秦陇，规三辅。...","context_before":"...误必多矣。且夫地利亦何常之有哉？函关、剑阁，天下之险也。","source_end_index":449,"source_paragraph_tongjian_id":"2bbae16a-58bd-5bb5-a968-8e6ab74cc441","source_start_index":436,"source_text":"秦人用函关，却六国而有余。"}],"path":"叙、凡例和目次/总叙二","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、宋下辽金元附（卷八）","excerpts":[{"context_after":"，刘嗣自咸阳徙于上邽而不振，赫连定自统万徙于北地而不振，...","context_before":"...复振者。周自丰镐徙于东洛而不振，魏自安邑徙于大梁而不振，","source_end_index":1444,"source_paragraph_tongjian_id":"f21b65ed-b257-53e4-ba71-e07ccfd2e60b","source_start_index":1433,"source_text":"楚自渚宫徙于寿春而不振"}],"path":"历代州域形势纪要/八、宋下辽金元附（卷八）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、凤阳府（卷二十一）","excerpts":[{"context_after":"]。秦为九江郡。汉初为淮南国[按汉初封黥布为淮南王，都六...","context_before":"春秋时，六蓼国地。战国时属楚，名曰寿春[","source_end_index":48,"source_paragraph_tongjian_id":"969248a7-8fd8-5f10-82a8-4fea7d17faa8","source_start_index":20,"source_text":"楚考烈王二十二年，为秦所败，徙都寿春，仍名曰郢，即此地也"}],"path":"南直方舆纪要/二、凤阳府（卷二十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷四十六）","excerpts":[{"context_after":"魏信陵君说安釐王曰：秦伐楚，道涉山谷[《索隐》云：往楚之...","context_before":"...对楚襄王曰：穰侯受命于秦王，填黾塞之内，投己于黾塞之外。","source_end_index":304,"source_paragraph_tongjian_id":"78c2130c-f4c7-5cf9-9f51-3a8b051eea85","source_start_index":283,"source_text":"朱英谓春申君曰：秦逾黾阨之塞而攻楚，不便。"}],"path":"河南方舆纪要/〇、封域山川险要（卷四十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"，所谓鄢者即此；郢，谓陈州也。魏曹丕封弟燕王宇为鄢陵王，...","context_before":"...年，秦败我于鄢。又秦始皇二十二年，李信攻楚鄢、郢，破之。","source_end_index":121,"source_paragraph_tongjian_id":"a02262de-f612-57b1-847d-d45df5be2471","source_start_index":112,"source_text":"胡氏曰：时楚迁寿春"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"林氏曰：春秋时，崤函晋有也，故能以制秦。秦得崤函，而六国...","context_before":"...魏、韩、燕同伐秦，攻函谷关。秦出兵逐之，五国之师皆败走。","source_end_index":326,"source_paragraph_tongjian_id":"2f224efe-0b68-55c9-b219-0c7bdf27567a","source_start_index":281,"source_text":"秦始皇六年，楚、赵、魏、韩、卫合从伐秦，取寿陵[胡氏曰：寿陵在新安、宜阳间]至函谷，败还。"},{"context_after":"沛公伐秦，不从函谷入，乃引而南袭攻武关，破之，诚畏其险也...","context_before":"...时，崤函晋有也，故能以制秦。秦得崤函，而六国之亡始此矣。","source_end_index":404,"source_paragraph_tongjian_id":"2f224efe-0b68-55c9-b219-0c7bdf27567a","source_start_index":360,"source_text":"当苏秦之约从也，山东六国共攻秦，至函谷关。秦出兵击六国，六国皆引而归，岂非入险不可犯耶？"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、西安府（卷五十三）","excerpts":[{"context_after":"徐广曰：新丰有蕞乡也，亦谓之掫城。更始以赤眉将入关，使王...","context_before":"...。汉神爵元年，从方士言，祠天封苑火井于鸿门。或谓之蕞城。","source_end_index":136,"source_paragraph_tongjian_id":"f1adbf2a-775a-5879-8460-4726f97be7fd","source_start_index":108,"source_text":"赵悼襄王四年，庞煖将赵、楚、魏、燕之锐师入函谷，攻秦蕞。"}],"path":"陕西方舆纪要/一、西安府（卷五十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1楚、趙、魏、韓、衞合從以伐秦，楚王爲從長，春申君用事，取壽陵。至函谷，秦師出，五國之師皆敗走。楚王以咎春申君，春申君以此益疏。觀津人朱英謂春申君曰：「人皆以楚爲強，君用之而弱。其於英不然。先君時，秦善楚，二十年而不攻楚，何也？秦踰黽阨之塞而攻楚，不便；假道於兩周，背韓、魏而攻楚，不可。今則不然。魏旦暮亡，不能愛許、鄢陵，魏割以與秦，秦兵去陳百六十里。臣之所觀者，見秦、楚之日鬬也。」楚於是去陳，徙壽春，命曰郢。春申君就封於吳，行相事。","content_fanyi":"楚、赵、魏、韩、卫五国结成合纵联盟攻打秦国，楚考烈王熊完任纵约长，春申君执掌军务，夺取寿陵。五国联军直逼函谷关，秦军出关迎战，五国军队都大败逃走。楚考烈王把联军失利归罪于春申君，春申君因此渐渐被楚考烈王疏远。观津人朱英对春申君说：“人们都认为楚国本来强大，是由于您执政才变弱的。我却不这样看。先王在世时，秦国与楚国友善，二十年不进攻楚国，为什么呢？秦国越过黾厄要塞进攻楚国很不便利；向东周、西周两国借道，又背对着韩国、魏国来进攻楚国，有后顾之忧，不可行。如今情形不同了。魏国朝不保夕，说不定哪天就灭亡，再也顾不得许、鄢陵；一旦魏国把这两地割给秦国，秦军距离楚都陈就只有一百六十里。我所看到的是，秦国和楚国将天天争斗不休。”楚国于是离开陈，迁都寿春，命名为郢。春申君前往自己的封地吴，仍行使相国职权。","content_jianti_auto":"1楚、赵、魏、韩、衞合从以伐秦，楚王为从长，春申君用事，取寿陵。至函谷，秦师出，五国之师皆败走。楚王以咎春申君，春申君以此益疏。观津人朱英谓春申君曰：「人皆以楚为强，君用之而弱。其于英不然。先君时，秦善楚，二十年而不攻楚，何也？秦逾黾阨之塞而攻楚，不便；假道于两周，背韩、魏而攻楚，不可。今则不然。魏旦暮亡，不能爱许、鄢陵，魏割以与秦，秦兵去陈百六十里。臣之所观者，见秦、楚之日鬬也。」楚于是去陈，徙寿春，命曰郢。春申君就封于吴，行相事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":481,"number":1,"path":"资治通鉴 : 卷第六 (秦紀一) / 始皇帝上 / 六年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d3af0a7-db0e-11ef-9cab-a0d3651f611f","year_int":-241},"tongjian_id":"8d3af0a7-db0e-11ef-9cab-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"觀津","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"相","people_name_jianti_auto":"相","start_index":16,"tongjian_id":"8ebc133b-db0e-11ef-8f20-a0d3651f611f"},{"people_name":"有窮氏","people_name_jianti_auto":"有穷氏","start_index":18,"tongjian_id":"8ebc133c-db0e-11ef-8589-a0d3651f611f"},{"people_name":"少康","people_name_jianti_auto":"少康","start_index":35,"tongjian_id":"8ebc133d-db0e-11ef-bc5e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"夏帝","place_name_jianti_auto":"夏帝","start_index":14,"tongjian_id":"8ebc133e-db0e-11ef-8b23-a0d3651f611f"},{"place_name":"竇","place_name_jianti_auto":"窦","start_index":32,"tongjian_id":"8ebc133f-db0e-11ef-a1f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋之法，母以子貴。風俗通：夏帝相遭有窮氏之難，其妃方娠，逃出自竇而生少康，其後氏焉。","note_content_jianti_auto":"春秋之法，母以子贵。风俗通：夏帝相遭有穷氏之难，其妃方娠，逃出自窦而生少康，其后氏焉。","note_type":"hu_note","start_index":14,"tongjian_id":"8ebc133a-db0e-11ef-b7ad-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8ebc1343-db0e-11ef-82d4-a0d3651f611f"},