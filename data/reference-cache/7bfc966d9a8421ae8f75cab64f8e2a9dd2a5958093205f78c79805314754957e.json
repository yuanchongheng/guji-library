{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（癸酉、八五三）","note_content_jianti_auto":"（癸酉、八五三）","note_type":"hu_note","start_index":0,"tongjian_id":"c4c180fe-db0e-11ef-bc54-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，正月，戊申，上祀圜丘；赦天下。","content_fanyi":"春季，正月十七日戊申，宣宗前往圜丘举行祭天典礼，大赦天下。","content_jianti_auto":"1春，正月，戊申，上祀圜丘；赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25396,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c4c180ff-db0e-11ef-b663-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"法杖，謂常行臀杖也。脊，資昔翻。折，之截翻。","note_content_jianti_auto":"法杖，谓常行臀杖也。脊，资昔翻。折，之截翻。","note_type":"hu_note","start_index":33,"tongjian_id":"c4c18102-db0e-11ef-9de3-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2夏，四月，丙寅，敕：「自今法司處罪，用常行杖。杖脊一，折法杖十；杖臀一，折笞五。使吏用法有常準。」","content_fanyi":"夏季，四月初六日丙寅，皇帝下敕令说：“从今以后，法司处罚罪人，使用常行杖。用杖击打脊背一下，折合法杖十下；用杖击打臀部一下，折合笞刑五下。使官吏执法有固定的准则。”","content_jianti_auto":"2夏，四月，丙寅，敕：「自今法司处罪，用常行杖。杖脊一，折法杖十；杖臀一，折笞五。使吏用法有常准。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":25397,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c4c18100-db0e-11ef-9d4a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"明火行劫，言盜無所憚。華，戶化翻。","note_content_jianti_auto":"明火行劫，言盗无所惮。华，户化翻。","note_type":"hu_note","start_index":66,"tongjian_id":"c4c18105-db0e-11ef-953f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"諫官","official_name":"左補闕","official_note":"左補闕是唐代諫官，隸屬門下省，負責規諫皇帝和朝廷政策，在《資治通鑑》中，趙璘以此官職上奏建議取消元會，體現其諫議職能。","official_rank":"從七品上","source_snippet":"左補闕趙璘請罷來年元會","start_index":8,"tongjian_id":"8d630012-8165-4216-902b-429e9281ad29"},{"confidence":0.9,"official_category":"中樞機構","official_name":"宰相","official_note":"宰相是唐代最高行政長官，通常指中書令、門下侍中等，負責輔佐皇帝處理國政，在《資治通鑑》中，皇帝詢問宰相關於元會事宜，顯示其決策核心地位。","official_rank":"高級官員","source_snippet":"上以問宰相","start_index":28,"tongjian_id":"af45d7c9-eaba-4a5f-820c-f3f1712cdd08"}],"ExtRef_Children_people":[{"link_td_description":"赵璘，字泽章。平原（今属山东）人，唐朝政治人物。","link_td_id":"Q10010741","link_td_number_id":1125131,"people_name":"趙璘","people_name_jianti_auto":"赵璘","people_xingming":"赵璘","start_index":10,"tongjian_id":"c4c18107-db0e-11ef-a8b1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"宣政","place_name_jianti_auto":"宣政","resolved_place_entity_id":1832,"start_index":21,"tongjian_id":"c4c18108-db0e-11ef-ab54-a0d3651f611f"},{"place_name":"華州","place_name_jianti_auto":"华州","place_note":"陕西省华县","resolved_place_entity_id":423,"start_index":55,"tongjian_id":"c4c18109-db0e-11ef-925f-a0d3651f611f"},{"place_name":"下邽","place_name_jianti_auto":"下邽","place_note":"陕西省渭南市北","resolved_place_entity_id":1882,"start_index":63,"tongjian_id":"c4c1810a-db0e-11ef-b32e-a0d3651f611f"},{"place_name":"關","place_name_jianti_auto":"关","resolved_place_entity_id":133,"start_index":66,"tongjian_id":"c4c1810b-db0e-11ef-b7a8-a0d3651f611f"},{"place_name":"宣政","place_name_jianti_auto":"宣政","resolved_place_entity_id":1832,"start_index":82,"tongjian_id":"c4c1810c-db0e-11ef-8c15-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3冬，十二月，左補闕趙璘請罷來年元會，止御宣政。上以問宰相，對曰：「元會大禮，不可罷。況天下無事。」上曰：「近華州奏有賊光火劫下邽，關中少雪，皆朕之憂，何謂無事！雖宣政亦不可御也。」","content_fanyi":"冬季，十二月，左补阙赵璘请求取消来年的元旦朝会，只在宣政殿接见群臣。宣宗就此事征求宰相的意见，宰相回答说：“元旦朝会是国家的重大礼仪，不可废止。何况如今天下太平无事。”宣宗说：“近来华州上奏，说有盗贼明火执仗地抢劫下邽县，关中又很少下雪，这些都是朕所忧虑的，怎么能说无事！即使是宣政殿也不能亲临了。”","content_jianti_auto":"3冬，十二月，左补阙赵璘请罢来年元会，止御宣政。上以问宰相，对曰：「元会大礼，不可罢。况天下无事。」上曰：「近华州奏有贼光火劫下邽，关中少雪，皆朕之忧，何谓无事！虽宣政亦不可御也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":25398,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"c4c18104-db0e-11ef-957e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"c4c18111-db0e-11ef-9e5b-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":26,"tongjian_id":"c4c18112-db0e-11ef-84ba-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":30,"tongjian_id":"c4c18113-db0e-11ef-acd6-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":34,"tongjian_id":"c4c18114-db0e-11ef-8642-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「上」上有「入朝」二字；乙十一行本同；孔本同；張校同；退齋校同。』","note_content_jianti_auto":"『章：十二行本「上」上有「入朝」二字；乙十一行本同；孔本同；张校同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"c4c18110-db0e-11ef-9077-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":33,"tongjian_id":"c4c1810f-db0e-11ef-b225-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻。民官，謂治民之官。","note_content_jianti_auto":"复，扶又翻。民官，谓治民之官。","note_type":"hu_note","start_index":84,"tongjian_id":"c4c18116-db0e-11ef-b5be-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"鄭太后","people_name_jianti_auto":"郑太后","people_xingming":"郑太后","start_index":3,"tongjian_id":"c4c18117-db0e-11ef-84c3-a0d3651f611f"},{"link_death_year":857,"link_td_description":"郑光，润州丹杨县人，唐朝官员和外戚。","link_td_id":"Q10020802","link_td_number_id":6807515,"people_name":"鄭光","people_name_jianti_auto":"郑光","people_xingming":"郑光","start_index":20,"tongjian_id":"c4c18118-db0e-11ef-bd9e-a0d3651f611f"},{"link_death_year":857,"link_td_description":"郑光，润州丹杨县人，唐朝官员和外戚。","link_td_id":"Q10020802","link_td_number_id":6807515,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"郑光","start_index":39,"tongjian_id":"c4c1811b-db0e-11ef-b3da-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"平盧","place_name_jianti_auto":"平卢","place_note":"总部设青州【山东省青州市】","resolved_place_entity_id":349,"start_index":23,"tongjian_id":"c4c18119-db0e-11ef-bca7-a0d3651f611f"},{"place_name":"河中","place_name_jianti_auto":"河中","place_note":"总部设河中府【山西省永济市】","resolved_place_entity_id":208,"start_index":26,"tongjian_id":"c4c1811a-db0e-11ef-8a85-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"4上事鄭太后甚謹，不居別宮，朝夕奉養。舅鄭光歷平盧、河中節度使，上與之論爲政，光應對鄙淺，上不悅，留爲右羽林統軍，使奉朝請。太后數言其貧，上輒厚賜金帛，終不復任以民官。","content_fanyi":"宣宗侍奉郑太后十分恭谨，不让她住在别的宫殿，以便朝夕奉养。舅父郑光历任平卢、河中节度使；郑光入朝时，宣宗与他谈论为政，郑光对答浅陋，宣宗不悦，将他留在朝中任右羽林统军，让他充任奉朝请。郑太后多次说郑光贫穷，宣宗便厚加赏赐金帛，但始终不再任命他担任治民官职。","content_jianti_auto":"4上事郑太后甚谨，不居别宫，朝夕奉养。舅郑光历平卢、河中节度使，上与之论为政，光应对鄙浅，上不悦，留为右羽林统军，使奉朝请。太后数言其贫，上辄厚赐金帛，终不复任以民官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":25399,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"c4c1810d-db0e-11ef-9599-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":2,"chapter_name":"书法篇第二","chenzhu_chapter":"《通鉴》书法，不尽关褒贬，故不如《春秋》之严。温公谦不敢法《春秋》，而志在续《左氏传》，有所感触，亦仿左氏设辞“君子曰”而称“臣光曰”以发之。馀则据事直书，使人随其时地之异而评其得失，以为鉴戒，非有一定不易之书法也。旧传温公《修书前例》一卷，公曾孙伋曾梓行之，然脱落已甚，不皆可据。兹篇所录，则身之推论《通鉴》之书法为多，其有关全书义例及史文构造、史料采取，亦隶焉，固与《通鉴纲目》等之所谓书法，涵义颇殊也。","chenzhu_index_in_chapter":26,"chenzhu_text":"书死者多矣，身之推论之如此，所谓“以意逆志”也。赵绍祖《通鉴注商》以为《胡注》多事，是使读史者不能自由运用其心思也。","created_at":"2025-12-31 08:50:44","seq_in_chapter":105,"tongjian_id":"CH02-CZ026"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"溫公","people_name_jianti_auto":"温公","start_index":47,"tongjian_id":"c4c1811e-db0e-11ef-b24c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"榷，古岳翻。酤，工護翻。考異曰：續皇王寶運錄具載是歲度支支收之數，舛錯不可曉，今特存其可曉者。溫公拳拳於史之闕文，蓋其所重者，制國用也。","note_content_jianti_auto":"榷，古岳翻。酤，工护翻。考异曰：续皇王宝运录具载是岁度支支收之数，舛错不可晓，今特存其可晓者。温公拳拳于史之阙文，盖其所重者，制国用也。","note_type":"hu_note","start_index":60,"tongjian_id":"c4c1811d-db0e-11ef-90b1-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"财政","official_name":"度支","official_note":"度支是唐代负责财政收支管理的官职，属于户部或独立机构，此处度支上奏财政数据，表明其在中央财政管理中的角色。","official_rank":"未知","source_snippet":"度支奏","start_index":0,"tongjian_id":"5e9d948c-1894-4dac-9869-c7fbb87d5257"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","resolved_place_entity_id":67,"start_index":7,"tongjian_id":"c4c18121-db0e-11ef-919b-a0d3651f611f"},{"place_name":"湟","place_name_jianti_auto":"湟","place_note":"甘肃省及青海省东部","resolved_place_entity_id":67,"start_index":9,"tongjian_id":"c4c18122-db0e-11ef-9585-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5度支奏：「自河、湟平，每歲天下所納錢九百二十五萬餘緡，內五百五十萬餘緡租稅，八十二萬餘緡榷酤，二百七十八萬餘緡鹽利。」","content_fanyi":"度支上奏说：“自从河、湟平定以后，每年全国所缴纳的钱为九百二十五万余缗，其中五百五十余万缗是租税，八十二万余缗是酒税，二百七十八万余缗是盐利。”","content_jianti_auto":"5度支奏：「自河、湟平，每岁天下所纳钱九百二十五万余缗，内五百五十万余缗租税，八十二万余缗榷酤，二百七十八万余缗盐利。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":25400,"number":5,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":4,"tongjian_id":"c4c1811c-db0e-11ef-a707-a0d3651f611f"}],"reign_name":"七年","reign_name_jianti_auto":"七年","start_index":3,"tongjian_id":"c4c180fd-db0e-11ef-b312-a0d3651f611f","year_anno":"（癸酉、八五三）","year_int":853},"message":"success","success":true}