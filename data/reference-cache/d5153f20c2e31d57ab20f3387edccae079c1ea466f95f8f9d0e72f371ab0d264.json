id":"8c451ac0-db0e-11ef-86bd-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-335,"link_td_description":"卫平侯，姬姓，子南氏，名劲，为战国诸侯国卫国君主之一。","link_td_id":"Q10001222","link_td_number_id":360342,"people_name":"衞平侯","people_name_jianti_auto":"衞平侯","people_xingming":"卫平侯","start_index":1,"tongjian_id":"8c451ac3-db0e-11ef-ae7f-a0d3651f611f"},{"link_death_year":-293,"link_td_description":"卫嗣君，姬姓，子南氏，名字无法考证，亦称为卫成襄侯，为战国诸侯国卫国君主之一，倒数第4任国君。","link_td_id":"Q10001223","link_td_number_id":360345,"people_name":"嗣君","people_name_jianti_auto":"嗣君","people_xingming":"嗣君","start_index":7,"tongjian_id":"8c451ac4-db0e-11ef-a7c5-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏王","people_name_jianti_auto":"魏王","people_xingming":"魏罃","start_index":21,"tongjian_id":"8c451ac7-db0e-11ef-ab32-a0d3651f611f","wl_zhushi":"[魏罃]"},{"link_death_year":-293,"link_td_description":"卫嗣君，姬姓，子南氏，名字无法考证，亦称为卫成襄侯，为战国诸侯国卫国君主之一，倒数第4任国君。","link_td_id":"Q10001223","link_td_number_id":360345,"people_name":"嗣君","people_name_jianti_auto":"嗣君","start_index":28,"tongjian_id":"8c451ac8-db0e-11ef-976b-a0d3651f611f"},{"link_death_year":-293,"link_td_description":"卫嗣君，姬姓，子南氏，名字无法考证，亦称为卫成襄侯，为战国诸侯国卫国君主之一，倒数第4任国君。","link_td_id":"Q10001223","link_td_number_id":360345,"people_name":"嗣君","people_name_jianti_auto":"嗣君","start_index":74,"tongjian_id":"8c451acb-db0e-11ef-ae28-a0d3651f611f"},{"link_birth_year":-400,"link_death_year":-319,"link_td_description":"魏惠王，本名魏罃，一作魏婴，魏武侯之子，生于魏文侯二十五年（前400年），全谥为魏文惠王或魏惠成王，通称魏惠王，战国时期魏国的第三代君主，在位期间为前370年－前319年。原本为侯，五国相王后称王，在位时期魏国由盛至衰。《孟子》一书中又称其为梁惠王，《庄子》中称文惠君。","link_td_id":"Q10000501","link_td_number_id":334595,"people_name":"魏王","people_name_jianti_auto":"魏王","start_index":128,"tongjian_id":"8c451acc-db0e-11ef-bf1f-a0d3651f611f","wl_zhushi":"[魏罃]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"衞","place_name_jianti_auto":"衞","resolved_place_entity_id":613,"start_index":11,"tongjian_id":"8c451ac5-db0e-11ef-b960-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"都大梁，河南开封","resolved_place_entity_id":1,"start_index":17,"tongjian_id":"8c451ac6-db0e-11ef-b8be-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":44,"tongjian_id":"8c451ac9-db0e-11ef-9f46-a0d3651f611f"},{"place_name":"左氏","place_name_jianti_auto":"左氏","place_note":"山东定陶东","resolved_place_entity_id":6818,"start_index":50,"tongjian_id":"8c451aca-db0e-11ef-af96-a0d3651f611f"},{"place_name":"左氏","place_name_jianti_auto":"左氏","resolved_place_entity_id":6818,"start_index":105,"tongjian_id":"8c451acd-db0e-11ef-9ec2-a0d3651f611f"},{"place_name":"左氏","place_name_jianti_auto":"左氏","resolved_place_entity_id":6818,"start_index":120,"tongjian_id":"8c451ace-db0e-11ef-8b0c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2衞平侯薨，子嗣君立。衞有胥靡亡之魏，因爲魏王之后治病。嗣君聞之，請以五十金買之。五反，魏不與，乃以左氏易之。左右諫曰：「夫以一都買一胥靡，可乎？」嗣君曰：「非子所知也！夫治無小，亂無大。法不立，誅不必，雖有十左氏，無益也。法立，誅必，失十左氏，無害也。」魏王聞之曰：「人主之欲，不聽之不祥。」因載而往，徒獻之。","content_fanyi":"卫平侯去世，他的儿子卫嗣君即位。卫国有个服劳役的囚犯逃到魏国，正为魏王的王后治病。卫嗣君听说后，派人到魏国请求用五十金把他赎回。卫国使者往返五次，魏国始终不肯交出他，卫嗣君于是要用左氏邑去交换他。身边的臣子劝谏说：“用一座都邑去买一个服劳役的囚犯，行吗？”卫嗣君说：“这不是你们能明白的！治理国家没有小事，大乱也不是一开始就起于大事。法令不确立，该惩罚的不能坚决执行，即使有十个左氏邑，也没有好处。法令确立了，该惩罚的一定执行，失去十个左氏邑，也没有害处。”魏王听到后说：“这是卫国国君的愿望，不听从恐怕会不吉利。”于是用车载着囚犯送往卫国，不要赎金，也不要左氏邑，无偿地献给卫国。","content_jianti_auto":"2衞平侯薨，子嗣君立。衞有胥靡亡之魏，因为魏王之后治病。嗣君闻之，请以五十金买之。五反，魏不与，乃以左氏易之。左右谏曰：「夫以一都买一胥靡，可乎？」嗣君曰：「非子所知也！夫治无小，乱无大。法不立，诛不必，虽有十左氏，无益也。法立，诛必，失十左氏，无害也。」魏王闻之曰：「人主之欲，不听之不祥。」因载而往，徒献之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":209,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c451ab3-db0e-11ef-ade2-a0d3651f611f"}],"reign_name":"四十四年","reign_name_jianti_auto":"四十四年","start_index":35,"tongjian_id":"8c451aaf-db0e-11ef-8857-a0d3651f611f","year_anno":"（丙申、前三二五）","year_int":-325},"message":"success","success":true}