ef-b79a-a0d3651f611f"},{"place_name":"鉅鹿郡","place_name_jianti_auto":"巨鹿郡","start_index":15,"tongjian_id":"9594a149-db0e-11ef-8ee3-a0d3651f611f"},{"place_name":"樂成國","place_name_jianti_auto":"乐成国","start_index":23,"tongjian_id":"9594a14a-db0e-11ef-ac8f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東光縣，本屬勃海郡；鄡縣，本屬鉅鹿郡，章帝以益樂成國。鄡，音羌堯翻。舊禁宮人出嫁，不得適諸國。有故掖庭技人哀置嫁男子章初，黨召入宮與通；初欲上書告之，黨賂哀置姊昭殺初。","note_content_jianti_auto":"东光县，本属勃海郡；鄡县，本属巨鹿郡，章帝以益乐成国。鄡，音羌尧翻。旧禁宫人出嫁，不得适诸国。有故掖庭技人哀置嫁男子章初，党召入宫与通；初欲上书告之，党赂哀置姊昭杀初。","note_type":"hu_note","start_index":18,"tongjian_id":"9594a13c-db0e-11ef-ba7c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9594a13b-db0e-11ef-9434-a0d3651f611f","pinyin":"qiāo","source_anchor_text":"人削東光鄡二縣春二","source_key":"baiyang_epub","start_index":14,"text":"鄡","tongjian_id":"be81028c-64ce-5dbd-ba35-20e44ed57016"}],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","resolved_place_entity_id":2442,"start_index":11,"tongjian_id":"9594a14d-db0e-11ef-93d5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5樂成王黨坐賊殺人，削東光、鄡二縣。","content_fanyi":"乐成王刘党因被控告杀人而获罪，削除封国中的东光、鄡两个县。","content_jianti_auto":"5乐成王党坐贼杀人，削东光、鄡二县。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3854,"number":5,"path":"资治通鉴 : 卷第四十八 (漢紀四十) / 孝和皇帝下 / 七年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"9594a13b-db0e-11ef-9434-a0d3651f611f","year_int":95},"tongjian_id":"9594a13b-db0e-11ef-9434-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":8,"tongjian_id":"9845a804-db0e-11ef-b117-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":0,"tongjian_id":"9845a805-db0e-11ef-9734-a0d3651f611f"},{"place_name":"勃海","place_name_jianti_auto":"勃海","start_index":5,"tongjian_id":"9845a806-db0e-11ef-b2ac-a0d3651f611f"},{"place_name":"滄州","place_name_jianti_auto":"沧州","start_index":12,"tongjian_id":"9845a807-db0e-11ef-b617-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東光縣，屬勃海。賢曰：今滄州縣。","note_content_jianti_auto":"东光县，属勃海。贤曰：今沧州县。","note_type":"hu_note","start_index":41,"tongjian_id":"9845a803-db0e-11ef-b2e5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復，扶又翻；下同。","note_content_jianti_auto":"复，扶又翻；下同。","note_type":"hu_note","start_index":72,"tongjian_id":"9845a809-db0e-11ef-aaaa-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言水爲之丹也。","note_content_jianti_auto":"言水为之丹也。","note_type":"hu_note","start_index":82,"tongjian_id":"9845a80a-db0e-11ef-9fc4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","resolved_place_entity_id":2442,"start_index":33,"tongjian_id":"9845a811-db0e-11ef-9591-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、河间府（卷十三）","excerpts":[{"context_after":"齐乘云：东光县东连沧州，有古胡苏亭。又旧《志》：县东南有...","context_before":"...世谓之羌城。非矣。又东北右会大河故渎，又径东光县故城西。","source_end_index":112,"source_paragraph_tongjian_id":"47c6f824-e815-5c1a-91d7-a98b13a0bec5","source_start_index":70,"source_text":"后汉初平二年，黄巾贼三十万入北海，公孙瓒破之于东光南，斩首数万，流血丹水。即是处也。"}],"path":"北直方舆纪要/三、河间府（卷十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"又瓒与袁绍相攻，瓒引军屯盘河。魏收《志》：般县以般河所经...","context_before":"...，为九河之一。自德州经县界，入乐陵及阳信县境，下流入海。","source_end_index":61,"source_paragraph_tongjian_id":"f8c31922-7643-55cc-bb04-c7d5f408878f","source_start_index":44,"source_text":"后汉初平二年，公孙瓒破黄巾于盘河。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"11青州黃巾寇勃海，衆三十萬，欲與黑山合。公孫瓚率步騎二萬人逆擊於東光南，大破之，斬首三萬餘級。賊棄其輜重，奔走渡河；瓚因其半濟薄之，賊復大破，死者數萬，流血丹水，收得生口七萬餘人，車甲財物不可勝算，威名大震。","content_fanyi":"青州黄巾军进犯勃海，部众达三十万，企图与黑山黄巾军会合。公孙瓒率领步骑二万人在东光县南迎击，大破黄巾军，斩首三万余级。黄巾军丢弃辎重，奔逃渡河；公孙瓒趁其半渡之际发起进攻，黄巾军再次大败，死者数万，鲜血染红河水，俘获七万余人，车辆、甲胄、财物不计其数，公孙瓒威名大震。","content_jianti_auto":"11青州黄巾寇勃海，众三十万，欲与黑山合。公孙瓒率步骑二万人逆击于东光南，大破之，斩首三万余级。贼弃其辎重，奔走渡河；瓒因其半济薄之，贼复大破，死者数万，流血丹水，收得生口七万余人，车甲财物不可胜算，威名大震。","dtjl_paragraph_links":[],"dtjl_references":[],"id":5192,"number":11,"path":"资治通鉴 : 卷第六十 (漢紀五十二) / 孝獻皇帝乙 / 初平二年 / 第 18 段","reading_annotation_sources":[],"start_index":17,"tongjian_id":"9845a802-db0e-11ef-85ba-a0d3651f611f","year_int":191},"tongjian_id":"9845a802-db0e-11ef-85ba-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"靈帝","people_name_jianti_auto":"灵帝","start_index":30,"tongjian_id":"9fc0416b-db0e-11ef-a874-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"渤海郡","place_name_jianti_auto":"渤海郡","start_index":4,"tongjian_id":"9fc0416c-db0e-11ef-9ff7-a0d3651f611f"},{"place_name":"東光","place_name_jianti_auto":"东光","start_index":9,"tongjian_id":"9fc0416d-db0e-11ef-856d-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":12,"tongjian_id":"9fc0416e-db0e-11ef-b897-a0d3651f611f"},{"place_name":"饒安縣","place_name_jianti_auto":"饶安县","start_index":16,"tongjian_id":"9fc0416f-db0e-11ef-a54f-a0d3651f611f"},{"place_name":"前漢","place_name_jianti_auto":"前汉","start_index":20,"tongjian_id":"9fc04170-db0e-11ef-8503-a0d3651f611f"},{"place_name":"千童縣","place_name_jianti_auto":"千童县","start_index":23,"tongjian_id":"9fc04171-db0e-11ef-8a59-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":28,"tongjian_id":"9fc04172-db0e-11ef-bc98-a0d3651f611f"},{"place_name":"饒安","place_name_jianti_auto":"饶安","start_index":34,"tongjian_id":"9fc04173-db0e-11ef-9ccd-a0d3651f611f"},{"place_name":"安陵縣","place_name_jianti_auto":"安陵县","start_index":37,"tongjian_id":"9fc04174-db0e-11ef-b850-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":41,"tongjian_id":"9fc04175-db0e-11ef-a078-a0d3651f611f"},{"place_name":"後趙","place_name_jianti_auto":"后赵","start_index":47,"tongjian_id":"9fc04176-db0e-11ef-8a40-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三縣皆屬渤海郡，惟東光，漢舊縣；饒安縣，前漢之千童縣也，後漢靈帝改曰饒安；安陵縣，晉置。時皆爲後趙之地。","note_content_jianti_auto":"三县皆属渤海郡，惟东光，汉旧县；饶安县，前汉之千童县也，后汉灵帝改曰饶安；安陵县，晋置。时皆为后赵之地。","note_type":"hu_note","start_index":13,"tongjian_id":"9fc0416a-db0e-11ef-b12e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","resolved_place_entity_id":2442,"start_index":4,"tongjian_id":"9fc04178-db0e-11ef-b796-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4饒安、東光、安陵三縣災，燒七千餘家，死者萬五千人。","content_fanyi":"饶安、东光、安陵三县发生火灾，烧毁七千多家房屋，死者一万五千人。","content_jianti_auto":"4饶安、东光、安陵三县灾，烧七千余家，死者万五千人。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7912,"number":4,"path":"资治通鉴 : 卷第九十二 (晉紀十四) / 肅宗明皇帝上 / 太寧元年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"9fc04169-db0e-11ef-8dae-a0d3651f611f","year_int":323},"tongjian_id":"9fc04169-db0e-11ef-8dae-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"帆，施於船上以汎風，時軍興織蒲不給，以布爲之。牟，兜牟也。","note_content_jianti_auto":"帆，施于船上以泛风，时军兴织蒲不给，以布为之。牟，兜牟也。","note_type":"hu_note","start_index":71,"tongjian_id":"b4b49558-db0e-11ef-8b37-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不用帝所改官制。","note_content_jianti_auto":"不用帝所改官制。","note_type":"hu_note","start_index":82,"tongjian_id":"b4b49559-db0e-11ef-9b6a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"黎陽倉","place_name_jianti_auto":"黎阳仓","place_note":"河南省浚县境","start_index":3,"tongjian_id":"b4b4955b-db0e-11ef-89db-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"倉，謂黎陽倉。","note_content_jianti_auto":"仓，谓黎阳仓。","note_type":"hu_note","start_index":103,"tongjian_id":"b4b4955a-db0e-11ef-93c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":37,"tongjian_id":"b4b4955d-db0e-11ef-8e7a-a0d3651f611f"},{"people_name":"陶氏","people_name_jianti_auto":"陶氏","start_index":80,"tongjian_id":"b4b4955e-db0e-11ef-8ed2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":29,"tongjian_id":"b4b4955f-db0e-11ef-a02e-a0d3651f611f"},{"place_name":"平原郡","place_name_jianti_auto":"平原郡","start_index":33,"tongjian_id":"b4b49560-db0e-11ef-bbe6-a0d3651f611f"},{"place_name":"定遠軍","place_name_jianti_auto":"定远军","start_index":42,"tongjian_id":"b4b49561-db0e-11ef-b2a9-a0d3651f611f"},{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":46,"tongjian_id":"b4b49562-db0e-11ef-9370-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":50,"tongjian_id":"b4b49563-db0e-11ef-a588-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":65,"tongjian_id":"b4b49564-db0e-11ef-bc5b-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":85,"tongjian_id":"b4b49565-db0e-11ef-81a4-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":94,"tongjian_id":"b4b49566-db0e-11ef-9005-a0d3651f611f"},{"place_name":"勃海郡","place_name_jianti_auto":"勃海郡","start_index":97,"tongjian_id":"b4b49567-db0e-11ef-bdc6-a0d3651f611f"},{"place_name":"懷州","place_name_jianti_auto":"怀州","place_note":"河内郡•河南省沁阳市","start_index":126,"tongjian_id":"b4b49568-db0e-11ef-a968-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"復開皇之制，以郡爲州，以太守爲刺史。隋志：州、郡皆置主簿。東光縣屬平原郡。宋白曰：今定遠軍治東光縣，漢舊縣也；故城在今縣東二十里，齊天保七年，移於今縣東南三十里陶氏故城，隋開皇三年，又移於後魏廢勃海郡城。縣置令、丞、尉、正。禕，許韋翻。考異曰：雜記作「懷州司功書佐」，今從隋書。","note_content_jianti_auto":"复开皇之制，以郡为州，以太守为刺史。隋志：州、郡皆置主簿。东光县属平原郡。宋白曰：今定远军治东光县，汉旧县也；故城在今县东二十里，齐天保七年，移于今县东南三十里陶氏故城，隋开皇三年，又移于后魏废勃海郡城。县置令、丞、尉、正。祎，许韦翻。考异曰：杂记作「怀州司功书佐」，今从隋书。","note_type":"hu_note","start_index":156,"tongjian_id":"b4b4955c-db0e-11ef-8bca-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"b4b24bb4-db0e-11ef-b11c-a0d3651f611f","pinyin":"yī","source_anchor_text":"郡主簿唐禕為懷州刺","source_key":"baiyang_epub","start_index":149,"text":"禕","tongjian_id":"6bcf68f8-2f27-52e6-9688-7be0cd011019"}],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","place_note":"河北省东光县","resolved_place_entity_id":2442,"start_index":131,"tongjian_id":"b4b4bfbc-db0e-11ef-813c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/七、大名府（卷十六）","excerpts":[{"context_after":"十三年，李密攻东都，使徐世勣袭破黎阳仓，据之。开仓，恣民...","context_before":"...为河津重镇。隋开皇三年，置黎阳仓，漕河北之粟，以输京师。","source_end_index":397,"source_paragraph_tongjian_id":"2dc8c5ee-2bad-5cfe-a0d6-141b3bd3c293","source_start_index":378,"source_text":"大业九年，杨玄感督运黎阳，起兵攻东都。"}],"path":"北直方舆纪要/七、大名府（卷十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"唐贞观十八年，征高丽，使张亮自莱州泛海趣辽东。二十一年，...","context_before":"...]。隋开皇十七年，伐高丽，使周罗睺分道自东莱泛海趣平壤。","source_end_index":590,"source_paragraph_tongjian_id":"c7aac4b9-7e9f-54e2-9a4f-1ee9a6d64ee8","source_start_index":567,"source_text":"大业七年，伐高丽，亦使来护儿自东莱入海趣平壤。"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、登州府（卷三十六）","excerpts":[{"context_after":"唐贞观十八年，伐高丽，遣张亮自莱州泛海趣平壤。二十一年，...","context_before":"...元弘嗣往东莱海口造船。八年，遣来护儿等分兵自海道趣平壤。","source_end_index":288,"source_paragraph_tongjian_id":"daa947bc-0702-52c1-b9f4-903e1c567d53","source_start_index":274,"source_text":"九年，复遣护儿出海道伐高丽。"}],"path":"山东方舆纪要/七、登州府（卷三十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、河南府（卷四十八）","excerpts":[{"context_after":"唐贞观十一年，河溢坏陕州河北县，毁河阳中潬城，帝幸白司马...","context_before":"...，萧赞在洛阳闻之，惧而出走，趣白马山，至河桥，为人所获。","source_end_index":108,"source_paragraph_tongjian_id":"0bc53a56-5921-51f7-9a46-e5c625b68cb6","source_start_index":69,"source_text":"隋大业九年，杨玄感反于黎阳，引兵向洛，使其弟玄挺为先锋，自白司马阪逾邙山南入。"}],"path":"河南方舆纪要/二、河南府（卷四十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"時右驍衞大將軍來護兒以舟師自東萊將入海趣平壤，玄感遣家奴僞爲使者從東方來，詐稱護兒反。六月，乙巳，玄感入黎陽，閉城，大索男夫，取帆布爲牟、甲，署官屬，皆準開皇之舊。移書傍郡，以討護兒爲名，各令發兵會於倉所。郡縣官有幹用者，玄感皆以運糧追集之，以趙懷義爲衞州刺史，東光尉元務本爲黎州刺史，河內郡主簿唐禕爲懷州刺史。","content_fanyi":"当时右骁卫大将军来护儿率领水军，将从东莱渡海进攻平壤，杨玄感派家奴伪装成使者从东方前来，谎称来护儿反叛。六月初三日乙巳，杨玄感进入黎阳，关闭城门，大规模搜索男丁以扩充军队，用帆布制作头盔、铠甲，委任官属，一律依照隋文帝开皇年间的旧制。发文书给附近各郡，以讨伐来护儿为名，命令他们各自发兵到黎阳仓会合。郡县官吏中有才干的，杨玄感都以押运粮草为名把他们召集起来，并任命赵怀义为卫州刺史，东光县尉元务本为黎州刺史，河内郡主簿唐祎为怀州刺史。","content_jianti_auto":"时右骁衞大将军来护儿以舟师自东莱将入海趣平壤，玄感遣家奴伪为使者从东方来，诈称护儿反。六月，乙巳，玄感入黎阳，闭城，大索男夫，取帆布为牟、甲，署官属，皆准开皇之旧。移书傍郡，以讨护儿为名，各令发兵会于仓所。郡县官有干用者，玄感皆以运粮追集之，以赵怀义为衞州刺史，东光尉元务本为黎州刺史，河内郡主簿唐祎为怀州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":17601,"path":"资治通鉴 : 卷第一百八十二 (隋紀六) / 煬皇帝中 / 大業九年 / 第 17 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":16,"tongjian_id":"b4b24bb4-db0e-11ef-b11c-a0d3651f611f","year_int":613},"tongjian_id":"b4b24bb4-db0e-11ef-b11c-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":22,"tongjian_id":"bbc5f9a5-db0e-11ef-af9e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":26,"tongjian_id":"bbc5f9a6-db0e-11ef-81a0-a0d3651f611f"},{"place_name":"勃海郡","place_name_jianti_auto":"勃海郡","start_index":28,"tongjian_id":"bbc5f9a7-db0e-11ef-ab40-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":32,"tongjian_id":"bbc5f9a8-db0e-11ef-840f-a0d3651f611f"},{"place_name":"滄州","place_name_jianti_auto":"沧州","start_index":34,"tongjian_id":"bbc5f9a9-db0e-11ef-b712-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"光宅分御史左、右臺，各置大夫、中丞、侍御史。東光縣，漢屬勃海郡，唐屬滄州。詹事司直正九品上，掌彈劾宮僚，糾舉職事。","note_content_jianti_auto":"光宅分御史左、右台，各置大夫、中丞、侍御史。东光县，汉属勃海郡，唐属沧州。詹事司直正九品上，掌弹劾宫僚，纠举职事。","note_type":"hu_note","start_index":29,"tongjian_id":"bbc5f9a4-db0e-11ef-826d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陽休之","people_name_jianti_auto":"阳休之","start_index":0,"tongjian_id":"bbc5f9ac-db0e-11ef-a40d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"高齊","place_name_jianti_auto":"高齐","start_index":4,"tongjian_id":"bbc5f9ad-db0e-11ef-aa04-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陽休之仕高齊貴顯。","note_content_jianti_auto":"阳休之仕高齐贵显。","note_type":"hu_note","start_index":106,"tongjian_id":"bbc5f9ab-db0e-11ef-84f9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","place_note":"河北省东光县","resolved_place_entity_id":2442,"start_index":12,"tongjian_id":"bbc5f9b1-db0e-11ef-8c62-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"左臺中丞桓彥範、右臺中丞東光袁恕己共薦詹事司直陽嶠爲御史。楊再思曰：「嶠不樂搏擊之任如何？」彥範曰：「爲官擇人，豈必待其所欲！所不欲者，尤須與之，所以長難進之風，抑躁求之路。」乃擢爲右臺侍御史。嶠，休之之玄孫也。","content_fanyi":"左台中丞桓彦范、右台中丞东光县人袁恕己共同举荐太子詹事司直阳峤出任御史。杨再思问：“阳峤并不乐意担任搏击弹劾之类的职务，怎么办？”桓彦范回答说：“为国家职位物色人选，怎么能一定要等到他本人愿意才任命呢！对不愿接受任命的人，更应授予他这种官职，以此助长知难而进的风尚，遏止急图功名的门路。”于是提拔阳峤为右台侍御史。阳峤是阳休之的玄孙。","content_jianti_auto":"左台中丞桓彦范、右台中丞东光袁恕己共荐詹事司直阳峤为御史。杨再思曰：「峤不乐搏击之任如何？」彦范曰：「为官择人，岂必待其所欲！所不欲者，尤须与之，所以长难进之风，抑躁求之路。」乃擢为右台侍御史。峤，休之之玄孙也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":20661,"path":"资治通鉴 : 卷第二百七 (唐紀二十三) / 則天順聖皇后下 / 四年 / 第 40 段","reading_annotation_sources":[],"start_index":39,"tongjian_id":"bbc5f9a3-db0e-11ef-bec3-a0d3651f611f","year_int":704},"tongjian_id":"bbc5f9a3-db0e-11ef-bec3-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":8,"tongjian_id":"c326da23-db0e-11ef-82fe-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"東光縣","place_name_jianti_auto":"东光县","start_index":0,"tongjian_id":"c326da24-db0e-11ef-be72-a0d3651f611f"},{"place_name":"景州","place_name_jianti_auto":"景州","start_index":5,"tongjian_id":"c326da25-db0e-11ef-9aef-a0d3651f611f"},{"place_name":"東光","place_name_jianti_auto":"东光","place_note":"河北省东光县","start_index":12,"tongjian_id":"c326da26-db0e-11ef-b8d8-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":15,"tongjian_id":"c326da27-db0e-11ef-9cb1-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":29,"tongjian_id":"c326da28-db0e-11ef-bb64-a0d3651f611f"},{"place_name":"陶氏","place_name_jianti_auto":"陶氏","start_index":43,"tongjian_id":"c326da29-db0e-11ef-9e8f-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":48,"tongjian_id":"c326da2a-db0e-11ef-8ee0-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":56,"tongjian_id":"c326da2b-db0e-11ef-b261-a0d3651f611f"},{"place_name":"勃海","place_name_jianti_auto":"勃海","start_index":59,"tongjian_id":"c326da2c-db0e-11ef-adb7-a0d3651f611f"},{"place_name":"永濟渠","place_name_jianti_auto":"永济渠","start_index":69,"tongjian_id":"c326da2d-db0e-11ef-ad0d-a0d3651f611f"},{"place_name":"弓高","place_name_jianti_auto":"弓高","start_index":82,"tongjian_id":"c326da2e-db0e-11ef-9b5e-a0d3651f611f"},{"place_name":"白橋","place_name_jianti_auto":"白桥","place_note":"东光县西北，跨永济渠","start_index":87,"tongjian_id":"c326da2f-db0e-11ef-9340-a0d3651f611f"},{"place_name":"永濟渠","place_name_jianti_auto":"永济渠","start_index":90,"tongjian_id":"c326da30-db0e-11ef-bf56-a0d3651f611f"},{"place_name":"德州","place_name_jianti_auto":"德州","start_index":95,"tongjian_id":"c326da31-db0e-11ef-b75f-a0d3651f611f"},{"place_name":"長河縣","place_name_jianti_auto":"长河县","start_index":97,"tongjian_id":"c326da32-db0e-11ef-855a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東光縣，屬景州。宋白曰：東光，漢舊縣也。故城在縣東二十里，齊天保七年移於今縣東南三十里陶氏故城，隋開皇三年又移於後魏廢勃海舊城。縣西四里有永濟渠，渠上有橋，當自縣通弓高之路。白橋跨永濟渠，在德州長河縣。斷，音短。","note_content_jianti_auto":"东光县，属景州。宋白曰：东光，汉旧县也。故城在县东二十里，齐天保七年移于今县东南三十里陶氏故城，隋开皇三年又移于后魏废勃海旧城。县西四里有永济渠，渠上有桥，当自县通弓高之路。白桥跨永济渠，在德州长河县。断，音短。","note_type":"hu_note","start_index":21,"tongjian_id":"c326da22-db0e-11ef-b234-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"渾鎬","people_name_jianti_auto":"浑镐","start_index":0,"tongjian_id":"c326da34-db0e-11ef-b913-a0d3651f611f"},{"people_name":"郗士美","people_name_jianti_auto":"郗士美","start_index":5,"tongjian_id":"c326da35-db0e-11ef-9128-a0d3651f611f"},{"people_name":"程權","people_name_jianti_auto":"程权","start_index":11,"tongjian_id":"c326da36-db0e-11ef-ab1a-a0d3651f611f"},{"people_name":"王承宗","people_name_jianti_auto":"王承宗","start_index":17,"tongjian_id":"c326da37-db0e-11ef-bca4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"渾鎬旣敗，郗士美又敗，程權又退歸，王承宗之才，非諸帥所能制也。","note_content_jianti_auto":"浑镐既败，郗士美又败，程权又退归，王承宗之才，非诸帅所能制也。","note_type":"hu_note","start_index":33,"tongjian_id":"c326da33-db0e-11ef-8641-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","place_note":"河北省东光县","resolved_place_entity_id":2442,"start_index":13,"tongjian_id":"c326da39-db0e-11ef-ac57-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、河间府（卷十三）","excerpts":[{"context_after":"旧《志》：县西四里为永济渠，渠上有桥。当自县通弓高之路]...","context_before":"白桥[在县西南，跨永济渠上。","source_end_index":66,"source_paragraph_tongjian_id":"55035fb1-6914-5bf4-aea5-c9c2afdda4a0","source_start_index":14,"source_text":"唐元和十二年，横海节度使程权奉诏讨成德叛帅王承宗军于长河。承宗遣兵入东光，断白桥路。权不能御，引还沧州。"}],"path":"北直方舆纪要/三、河间府（卷十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"12戊寅，王承宗遣兵二萬入東光，斷白橋路；程權不能禦，以衆歸滄州。","content_fanyi":"戊寅日，王承宗派遣两万军队进入东光，切断白桥通路；程权无力抵御，带着部众退回沧州。","content_jianti_auto":"12戊寅，王承宗遣兵二万入东光，断白桥路；程权不能御，以众归沧州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24252,"number":12,"path":"资治通鉴 : 卷第二百四十 (唐紀五十六) / 憲宗昭文章武大聖至神孝皇帝中之下 / 元和十二年 / 第 14 段","reading_annotation_sources":[],"start_index":13,"tongjian_id":"c326da21-db0e-11ef-8b0e-a0d3651f611f","year_int":817},"tongjian_id":"c326da21-db0e-11ef-8b0e-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"東光","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟知祥","people_name_jianti_auto":"孟知祥","start_index":7,"tongjian_id":"cb70be77-db0e-11ef-b276-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":4,"tongjian_id":"cb70be78-db0e-11ef-bd11-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲諸將在蜀卒爲孟知祥效死張本。","note_content_jianti_auto":"为诸将在蜀卒为孟知祥效死张本。","note_type":"hu_note","start_index":75,"tongjian_id":"cb70be76-db0e-11ef-85d6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三十里爲一舍。差後於中軍三十里也。帥，讀曰率。","note_content_jianti_auto":"三十里为一舍。差后于中军三十里也。帅，读曰率。","note_type":"hu_note","start_index":106,"tongjian_id":"cb70be79-db0e-11ef-9be1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東光","place_name_jianti_auto":"东光","place_note":"河北东光县","resolved_place_entity_id":2442,"start_index":24,"tongjian_id":"cb70be83-db0e-11ef-87f9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9魏王繼岌留馬步都指揮使陳留李仁罕、馬軍都指揮使東光潘仁嗣、左廂都指揮使趙廷隱、右廂都指揮使浚儀張業、牙內指揮使文水武漳、驍銳指揮使平恩李延厚戍成都。甲申，繼岌發成都，命李紹琛帥萬二千人爲後軍，行止常差中軍一舍。","content_fanyi":"魏王李继岌留马步都指挥使陈留人李仁罕、马军都指挥使东光人潘仁嗣、左厢都指挥使赵廷隐、右厢都指挥使浚仪人张业、牙内指挥使文水人武漳、骁锐指挥使平恩人李延厚戍守成都。正月二十七日甲申，李继岌自成都启程，命李绍琛率一万二千人担任他的后军，行军宿营常与中军相距三十里。","content_jianti_auto":"9魏王继岌留马步都指挥使陈留李仁罕、马军都指挥使东光潘仁嗣、左厢都指挥使赵廷隐、右厢都指挥使浚仪张业、牙内指挥使文水武漳、骁锐指挥使平恩李延厚戍成都。甲申，继岌发成都，命李绍琛帅万二千人为后军，行止常差中军一舍。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28496,"number":9,"path":"资治通鉴 : 卷第二百七十四 (後唐紀三) / 明宗聖德和武欽孝皇帝上之上 / 天成元年 / 第 11 段","reading_annotation_sources":[],"start_index":10,"tongjian_id":"cb70be75-db0e-11ef-b4aa-a0d3651f611f","year_int":926},"tongjian_id":"cb70be75-db0e-11ef-b4aa-a0d3651f611f"},"paragraph_order":7}],"page_size":10,"total_pages":1,"total_paragraphs":7},"place_name":"東光"},"message":"success","success":true}