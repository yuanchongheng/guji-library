4d660c"}],"ExtRef_Children_people":[{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","people_xingming":"秦始皇","start_index":15,"tongjian_id":"8d774220-db0e-11ef-98e9-a0d3651f611f"},{"link_birth_year":-259,"link_death_year":-210,"link_td_description":"秦始皇，嬴姓赵氏，名政，战国末期秦国君主，十三岁即位，三十九岁时灭亡六国建立秦朝，自称“始皇帝”，四十九岁出巡时驾崩。他是中国史上第一位使用“皇帝”称号的君主，统一度量衡、“车同轨，书同文，行同伦”，修筑长城、阿房宫、骊山陵等，被明代思想家李贽誉为“千古一帝”。","link_td_id":"Q10000011","link_td_number_id":958,"people_name":"始皇","people_name_jianti_auto":"始皇","start_index":23,"tongjian_id":"8d774221-db0e-11ef-b6c8-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d7546c1-db0e-11ef-aad4-a0d3651f611f","pinyin":"fán","source_anchor_text":"居人誅之燔其石遷河","source_key":"baiyang_epub","start_index":43,"text":"燔","tongjian_id":"5d712f93-cad0-571b-899e-948de9c653d2"}],"ExtRef_Children_places":[{"place_name":"東郡","place_name_jianti_auto":"东郡","resolved_place_entity_id":627,"start_index":5,"tongjian_id":"8d7546ca-db0e-11ef-80cf-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1有隕石于東郡。或刻其石曰：「始皇死而地分。」始皇使御史逐問，莫服；盡取石旁居人誅之，燔其石。","content_fanyi":"有陨石坠落在东郡。有人在陨石上刻字说：“始皇死而地分。”秦始皇于是派御史逐个查问，但无人承认是自己干的；随即下令将居住在陨石附近的人全部捉拿处死，并焚化了那块石头。","content_jianti_auto":"1有陨石于东郡。或刻其石曰：「始皇死而地分。」始皇使御史逐问，莫服；尽取石旁居人诛之，燔其石。","dtjl_paragraph_links":[],"dtjl_references":[],"id":578,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d7546c1-db0e-11ef-aad4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Chil