n_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"昌邑國","place_name_jianti_auto":"昌邑国","start_index":0,"tongjian_id":"90ad5fac-db0e-11ef-bf5b-a0d3651f611f"},{"place_name":"山陽郡","place_name_jianti_auto":"山阳郡","start_index":4,"tongjian_id":"90ad5fad-db0e-11ef-8f1f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昌邑國本山陽郡也；今國除，復爲郡。","note_content_jianti_auto":"昌邑国本山阳郡也；今国除，复为郡。","note_type":"hu_note","start_index":82,"tongjian_id":"90ad5fab-db0e-11ef-aae0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"山陽郡","place_name_jianti_auto":"山阳郡","resolved_place_entity_id":661,"start_index":78,"tongjian_id":"90ad5fb4-db0e-11ef-ab36-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"后汉为兖州治。兴平初，吕布与曹操争兖州，自乘氏东屯山阳。...","context_before":"...邑国，封子髆为昌邑王。始元初，子贺嗣。十二年，征为昭帝。","source_end_index":141,"source_paragraph_tongjian_id":"f344a6ee-1cc6-5559-ab5e-b5734e2ccc79","source_start_index":125,"source_text":"后贺废，国除为山阳郡，仍治昌邑。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"羣臣奏言：「古者廢放之人，屛於遠方，不及以政。請徙王賀漢中房陵縣。」太后詔歸賀昌邑，賜湯沐邑二千戶，故王家財物皆與賀；及哀王女四人，各賜湯沐邑千戶；國除，爲山陽郡。","content_fanyi":"群臣上奏说：“古时候被废黜流放的人，要安置到远方，不让他们参与政事。请把昌邑王刘贺迁到汉中房陵县。”太后下诏让刘贺返回昌邑居住，赐给他汤沐邑二千户，原昌邑王府的财物都交还给他；哀王的四个女儿，各赐给汤沐邑一千户；废除昌邑国，改为山阳郡。","content_jianti_auto":"群臣奏言：「古者废放之人，屛于远方，不及以政。请徙王贺汉中房陵县。」太后诏归贺昌邑，赐汤沐邑二千户，故王家财物皆与贺；及哀王女四人，各赐汤沐邑千户；国除，为山阳郡。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1951,"path":"资治通鉴 : 卷第二十四 (漢紀十六) / 孝昭皇帝下 / 元平元年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"90ad5fa1-db0e-11ef-b90a-a0d3651f611f","year_int":-74},"tongjian_id":"90ad5fa1-db0e-11ef-b90a-a0d3651f611f"},"paragraph_order":1}],"page_size":10,"total_pages":1,"total_paragraphs":1},"place_name":"山陽郡"},"message":"success","success":true}