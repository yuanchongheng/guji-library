_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蒼","people_name_jianti_auto":"苍","start_index":49,"tongjian_id":"950a4ec2-db0e-11ef-9f02-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"百官志：將軍長史一人，秩千石；掾屬二十九人，秩比四百石至比二百石；令史及御屬三十一人，百石。帝特爲蒼置掾、史，員四十人。王國太傅秩二千石，中大夫比六百石，郞二百石。掾，俞絹翻。","note_content_jianti_auto":"百官志：将军长史一人，秩千石；掾属二十九人，秩比四百石至比二百石；令史及御属三十一人，百石。帝特为苍置掾、史，员四十人。王国太傅秩二千石，中大夫比六百石，郞二百石。掾，俞绢翻。","note_type":"hu_note","start_index":36,"tongjian_id":"950a4ec1-db0e-11ef-97aa-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"驃騎長史","official_note":"驃騎長史是驃騎將軍的屬官，負責協助處理軍務和行政事務，在《資治通鑑》中常出現於漢代軍事體系。此處皇帝任命驃騎長史為東平太傅，顯示其從軍事職務轉任地方教育或輔導職位，反映了職務調動。","official_rank":"未知","source_snippet":"帝以驃騎長史爲東平太傅","start_index":12,"tongjian_id":"d29f3153-4cd7-4310-a813-26abebedf781"},{"confidence":0.85,"official_category":"地方行政","official_name":"東平太傅","official_note":"東平太傅是東平王國的太傅，負責輔導和教育諸侯王，屬於地方行政體系中的文教職務。在漢代，太傅常由皇帝任命以監督諸侯。此處皇帝任命驃騎長史擔任此職，可能意在加強對東平王國的控制或提升其教育水平。","official_rank":"未知","source_snippet":"帝以驃騎長史爲東平太傅","start_index":18,"tongjian_id":"05d4e633-a8cf-45a1-8389-ff0aa7db7f0e"},{"confidence":0.8,"official_category":"財政或行政","official_name":"掾","official_note":"掾是漢代官署中的屬吏，通常負責文書、財務或行政事務，職能多樣。此處掾被任命為中大夫，顯示從低級屬吏晉升為中央官員，反映了職務變遷。","official_rank":"未知","source_snippet":"掾爲中大夫","start_index":24,"tongjian_id":"2686b862-bbcd-4985-b5de-3a24aa3b6ee1"},{"confidence":0.85,"official_category":"中樞機構","official_name":"中大夫","official_note":"中大夫是漢代中央官職，屬於光祿勳系統，負責顧問、議政或出使等事務，品秩較高。此處掾被任命為中大夫，可能表示皇帝對其能力的認可或作為獎賞。","official_rank":"未知","source_snippet":"掾爲中大夫","start_index":26,"tongjian_id":"927168b4-26b3-45cf-b7cc-bbdc7d57a102"},{"confidence":0.8,"official_category":"行政","official_name":"令史","official_note":"令史是漢代官署中的低級文書官員，負責記錄和管理文書。此處令史被任命為王家郞，顯示從一般行政職務轉為諸侯王國的屬官。","official_rank":"未知","source_snippet":"令史爲王家郞","start_index":30,"tongjian_id":"7dbd92a7-77bd-4ca2-8985-256cfb83d8fc"},{"confidence":0.75,"official_category":"地方行政","official_name":"王家郞","official_note":"王家郞是諸侯王國的屬官，可能負責侍衛、文書或輔助事務，屬於地方行政體系。此處令史被任命為王家郞，反映了職務調動到王國層級。","official_rank":"未知","source_snippet":"令史爲王家郞","start_index":33,"tongjian_id":"f527bfef-22a2-4a34-921c-900e87320705"}],"ExtRef_Children_people":[{"link_birth_year":30,"link_death_year":83,"link_td_description":"刘苍，东汉皇子、东平宪王。汉光武帝和阴丽华之子，明帝的同母弟。","link_td_id":"Q10000925","link_td_number_id":132458,"people_name":"蒼","people_name_jianti_auto":"苍","people_xingming":"刘苍","start_index":6,"tongjian_id":"950a4ec4-db0e-11ef-bc39-a0d3651f611f","wl_zhushi":"[十六]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"東平","place_name_jianti_auto":"东平","resolved_place_entity_id":735,"start_index":18,"tongjian_id":"950a4ec5-db0e-11ef-ba1f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，二月，蒼罷歸藩；帝以驃騎長史爲東平太傅，掾爲中大夫，令史爲王家郞，加賜錢五千萬，布十萬匹。","content_fanyi":"春季，二月，刘苍罢职返回封国；汉明帝任命骠骑长史为东平国太傅，掾为中大夫，令史为王府郎官，加赐钱五千万，布十万匹。","content_jianti_auto":"1春，二月，苍罢归藩；帝以骠骑长史为东平太傅，掾为中大夫，令史为王家郞，加赐钱五千万，布十万匹。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3553,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"950a4eba-db0e-11ef-b88d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄴","place_name_jianti_auto":"邺","resolved_place_entity_id":101,"start_index":9,"tongjian_id":"950a4ec7-db0e-11ef-ab2c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2冬，十月，上行幸鄴；是月，還宮。","content_fanyi":"冬季十月，汉明帝亲临邺县；当月返回宫中。","content_jianti_auto":"2冬，十月，上行幸邺；是月，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3554,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"950a4ec6-db0e-11ef-ac85-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"挛鞮適","start_index":20,"tongjian_id":"950a4ec9-db0e-11ef-bc5a-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"北匈奴","place_name_jianti_auto":"北匈奴","resolved_place_entity_id":943,"start_index":5,"tongjian_id":"950a4eca-db0e-11ef-bd1c-a0d3651f611f"},{"place_name":"五原","place_name_jianti_auto":"五原","resolved_place_entity_id":554,"start_index":9,"tongjian_id":"950a4ecb-db0e-11ef-97bb-a0d3651f611f"},{"place_name":"雲中","place_name_jianti_auto":"云中","resolved_place_entity_id":379,"start_index":17,"tongjian_id":"950a4ecc-db0e-11ef-926a-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与匈奴的战争","tongjian_id":"war_N0608"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"3十一月，北匈奴寇五原；十二月，寇雲中，南單于擊卻之。","content_fanyi":"十一月，北匈奴进犯五原郡；十二月，进犯云中郡，南匈奴单于击退了来犯的北匈奴军队。","content_jianti_auto":"3十一月，北匈奴寇五原；十二月，寇云中，南单于击却之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3555,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"950a4ec8-db0e-11ef-80db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賜錢爲辦裝也。","note_content_jianti_auto":"赐钱为办装也。","note_type":"hu_note","start_index":21,"tongjian_id":"950a4ece-db0e-11ef-bc30-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4是歲，發遣邊民在內郡者，賜裝錢，人二萬。","content_fanyi":"这一年，朝廷征发移居内地各郡的边民，把他们遣返回边疆，并赐给置办行装的钱，每人二万钱。","content_jianti_auto":"4是岁，发遣边民在内郡者，赐装钱，人二万。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3556,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"950a4ecd-db0e-11ef-a1ab-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"內黃縣","place_name_jianti_auto":"内黄县","start_index":0,"tongjian_id":"950a4ed1-db0e-11ef-9903-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":5,"tongjian_id":"950a4ed2-db0e-11ef-839c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"內黃縣，屬魏郡。","note_content_jianti_auto":"内黄县，属魏郡。","note_type":"hu_note","start_index":28,"tongjian_id":"950a4ed0-db0e-11ef-afa0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":9,"tongjian_id":"950a4ed4-db0e-11ef-b04c-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":41,"tongjian_id":"950a4ed5-db0e-11ef-8d19-a0d3651f611f"},{"people_name":"劉昫","people_name_jianti_auto":"刘昫","start_index":70,"tongjian_id":"950a4ed6-db0e-11ef-a8f9-a0d3651f611f"},{"people_name":"章帝","people_name_jianti_auto":"章帝","start_index":98,"tongjian_id":"950a4ed7-db0e-11ef-a88b-a0d3651f611f"},{"people_name":"江陵王","people_name_jianti_auto":"江陵王","start_index":106,"tongjian_id":"950a4ed8-db0e-11ef-831f-a0d3651f611f"},{"people_name":"恭","people_name_jianti_auto":"恭","start_index":109,"tongjian_id":"950a4ed9-db0e-11ef-8c34-a0d3651f611f"},{"people_name":"六安王","people_name_jianti_auto":"六安王","start_index":111,"tongjian_id":"950a4eda-db0e-11ef-9007-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":126,"tongjian_id":"950a4edb-db0e-11ef-bf32-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"六安國","place_name_jianti_auto":"六安国","start_index":0,"tongjian_id":"950a4edc-db0e-11ef-8950-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":5,"tongjian_id":"950a4edd-db0e-11ef-a281-a0d3651f611f"},{"place_name":"廬州","place_name_jianti_auto":"庐州","start_index":14,"tongjian_id":"950a4ede-db0e-11ef-bb72-a0d3651f611f"},{"place_name":"前漢","place_name_jianti_auto":"前汉","start_index":18,"tongjian_id":"950a4edf-db0e-11ef-a1a0-a0d3651f611f"},{"place_name":"六安","place_name_jianti_auto":"六安","start_index":21,"tongjian_id":"950a4ee0-db0e-11ef-9051-a0d3651f611f"},{"place_name":"後漢","place_name_jianti_auto":"后汉","start_index":27,"tongjian_id":"950a4ee1-db0e-11ef-b44b-a0d3651f611f"},{"place_name":"六安","place_name_jianti_auto":"六安","start_index":30,"tongjian_id":"950a4ee2-db0e-11ef-808e-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":37,"tongjian_id":"950a4ee3-db0e-11ef-9235-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":43,"tongjian_id":"950a4ee4-db0e-11ef-b163-a0d3651f611f"},{"place_name":"廬州","place_name_jianti_auto":"庐州","start_index":45,"tongjian_id":"950a4ee5-db0e-11ef-a0ef-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":48,"tongjian_id":"950a4ee6-db0e-11ef-8ab0-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":50,"tongjian_id":"950a4ee7-db0e-11ef-8f83-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":57,"tongjian_id":"950a4ee8-db0e-11ef-98c7-a0d3651f611f"},{"place_name":"六安侯國","place_name_jianti_auto":"六安侯国","start_index":59,"tongjian_id":"950a4ee9-db0e-11ef-8570-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":65,"tongjian_id":"950a4eea-db0e-11ef-8dc3-a0d3651f611f"},{"place_name":"壽州","place_name_jianti_auto":"寿州","start_index":66,"tongjian_id":"950a4eeb-db0e-11ef-81a1-a0d3651f611f"},{"place_name":"壽州","place_name_jianti_auto":"寿州","start_index":76,"tongjian_id":"950a4eec-db0e-11ef-aa94-a0d3651f611f"},{"place_name":"安豐縣","place_name_jianti_auto":"安丰县","start_index":78,"tongjian_id":"950a4eed-db0e-11ef-afde-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":82,"tongjian_id":"950a4eee-db0e-11ef-b08d-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":83,"tongjian_id":"950a4eef-db0e-11ef-9e98-a0d3651f611f"},{"place_name":"廬江郡","place_name_jianti_auto":"庐江郡","start_index":116,"tongjian_id":"950a4ef0-db0e-11ef-88d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"六安國，屬廬江郡。賢曰：今之廬州。按前漢以六安爲王國，後漢以六安爲侯國，屬廬江郡。賢以唐之廬州爲漢之廬江郡可也，若漢之六安侯國實在唐壽州界。劉昫地理志：壽州安豐縣，漢六國故城在縣南，此爲可據。此後章帝元和二年，徙江陵王恭爲六安王，以廬江郡爲國，卻可以用賢註。妻，七細翻。","note_content_jianti_auto":"六安国，属庐江郡。贤曰：今之庐州。按前汉以六安为王国，后汉以六安为侯国，属庐江郡。贤以唐之庐州为汉之庐江郡可也，若汉之六安侯国实在唐寿州界。刘昫地理志：寿州安丰县，汉六国故城在县南，此为可据。此后章帝元和二年，徙江陵王恭为六安王，以庐江郡为国，却可以用贤注。妻，七细翻。","note_type":"hu_note","start_index":49,"tongjian_id":"950a4ed3-db0e-11ef-a088-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"竇氏","people_name_jianti_auto":"窦氏","start_index":0,"tongjian_id":"950a4ef3-db0e-11ef-ba86-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"扶風","place_name_jianti_auto":"扶风","start_index":4,"tongjian_id":"950a4ef4-db0e-11ef-a859-a0d3651f611f"},{"place_name":"平陵","place_name_jianti_auto":"平陵","start_index":6,"tongjian_id":"950a4ef5-db0e-11ef-b272-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"竇氏，故扶風平陵人。","note_content_jianti_auto":"窦氏，故扶风平陵人。","note_type":"hu_note","start_index":82,"tongjian_id":"950a4ef2-db0e-11ef-ab03-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"郞吏","official_note":"郞吏是汉代宫廷中的低级官员，通常负责侍卫、文书等事务，此处指窦氏家族中担任此类官职的人，在上下文中因窦穆等犯罪被免官，导致这些郞吏被遣返故郡，反映了汉代对官员家族连坐的惩罚制度。","official_rank":"未知","source_snippet":"諸竇爲郞吏者","start_index":78,"tongjian_id":"9026a9cb-dd7c-451c-a908-3541420a2d5b"}],"ExtRef_Children_people":[{"link_birth_year":-16,"link_death_year":62,"link_td_description":"窦融，字周公，扶风平陵（今陕西省咸阳市西北）人，窦氏家族世代仕官于河右，家族中不少成员自称河右大族，任凉州刺史。东汉官员，曾孙女是汉章帝章德窦皇后。","link_td_id":"Q10000534","link_td_number_id":232095,"people_name":"安豐戴侯","people_name_jianti_auto":"安丰戴侯","people_xingming":"窦融","start_index":1,"tongjian_id":"950a4ef7-db0e-11ef-b1fd-a0d3651f611f"},{"link_birth_year":-16,"link_death_year":62,"link_td_description":"窦融，字周公，扶风平陵（今陕西省咸阳市西北）人，窦氏家族世代仕官于河右，家族中不少成员自称河右大族，任凉州刺史。东汉官员，曾孙女是汉章帝章德窦皇后。","link_td_id":"Q10000534","link_td_number_id":232095,"people_name":"竇融","people_name_jianti_auto":"窦融","people_xingming":"窦融","start_index":5,"tongjian_id":"950a4ef8-db0e-11ef-87df-a0d3651f611f"},{"link_birth_year":23,"link_td_description":"窦穆，东汉扶风平陵（今陕西咸阳西北）人，窦融长子。孙女是汉章帝窦皇后。","link_td_id":"Q10007116","link_td_number_id":5657162,"people_name":"穆","people_name_jianti_auto":"穆","people_xingming":"窦穆","start_index":21,"tongjian_id":"950a4ef9-db0e-11ef-b63e-a0d3651f611f"},{"link_td_description":"内黄公主，东汉前期的公主。其生父不详。嫁给了窦穆，大司空、安丰侯窦融的儿子。","link_td_id":"Q10013670","link_td_number_id":1605315,"people_name":"內黃公主","people_name_jianti_auto":"内黄公主","people_xingming":"内黄公主","start_index":23,"tongjian_id":"950a4efa-db0e-11ef-9245-a0d3651f611f"},{"link_birth_year":5,"link_death_year":64,"link_td_description":"阴丽华，南阳郡新野县（今河南新野）人。东汉光武帝刘秀第一任妻子，第二任皇后。汉明帝刘庄的生母。","link_td_id":"Q10000628","link_td_number_id":13368