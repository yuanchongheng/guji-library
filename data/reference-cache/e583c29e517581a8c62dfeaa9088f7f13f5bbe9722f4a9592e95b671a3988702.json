id":"a2c2b199-db0e-11ef-8a70-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","resolved_place_entity_id":111,"start_index":167,"tongjian_id":"a2c2b19a-db0e-11ef-aa1d-a0d3651f611f"},{"place_name":"涪","place_name_jianti_auto":"涪","resolved_place_entity_id":1000,"start_index":170,"tongjian_id":"a2c2b19b-db0e-11ef-8e40-a0d3651f611f"},{"place_name":"成都","place_name_jianti_auto":"成都","resolved_place_entity_id":182,"start_index":185,"tongjian_id":"a2c2b19c-db0e-11ef-b47f-a0d3651f611f"},{"place_name":"緜竹","place_name_jianti_auto":"緜竹","resolved_place_entity_id":1751,"start_index":209,"tongjian_id":"a2c2b1a1-db0e-11ef-9ae1-a0d3651f611f"},{"place_name":"益州","place_name_jianti_auto":"益州","resolved_place_entity_id":204,"start_index":216,"tongjian_id":"a2c2b1a2-db0e-11ef-b2da-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":20,"start_index":221,"tongjian_id":"a2c2b1a3-db0e-11ef-b32c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"梁天监十三年，魏复谋取蜀，分遣其将奚康生出绵竹，皆此城也...","context_before":"...，退住绵竹。晋永康元年，巴氐李特等屯绵竹，攻赵廞于成都。","source_end_index":246,"source_paragraph_tongjian_id":"de42c919-d042-59d7-a31c-2ac2260a7bfc","source_start_index":213,"source_text":"宁康二年，时苻秦取益州，州人张育等起兵拒秦。秦将邓羌击斩育于绵竹。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/八、潼川州（卷七十一）","excerpts":[{"context_after":"太元七年，桓冲遣将杨亮等攻蜀，拔伍城，进攻涪城。苻秦遣张...","context_before":"...，尉部主之。晋咸宁四年，因立五城县，亦曰伍城，属广汉郡。","source_end_index":94,"source_paragraph_tongjian_id":"f611847f-0b91-57ff-a62c-c7200309e12d","source_start_index":58,"source_text":"宁康二年，时苻秦置宁州于垫江，以姚苌为刺史，晋将竺瑶等败之，苌退屯五城。"}],"path":"四川方舆纪要/八、潼川州（卷七十一）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"4夏，五月，蜀人張育、楊光起兵擊秦，有衆二萬，遣使來請兵。秦王堅遣鎭軍將軍鄧羌帥甲士五萬討之。益州刺史竺瑤、威遠將軍桓石虔帥衆三萬攻墊江，姚萇兵敗，退屯五城。瑤、石虔屯巴東。張育自號蜀王，與巴獠酋帥張重、尹萬萬餘人進圍成都。六月，育改元黑龍。秋，七月，張育與張重等爭權，舉兵相攻，秦楊安、鄧羌襲育，敗之，育與楊光退屯緜竹。八月，鄧羌敗晉兵于涪西。九月，楊安敗張重、尹萬于成都南，重死，斬首二萬三千級。鄧羌擊張育、楊光于緜竹，皆斬之。益州復入于秦。","content_fanyi":"夏季，五月，蜀人张育、杨光起兵攻打前秦，拥有部众二万，派使者到东晋请求援军。前秦主苻坚派镇军将军邓羌率领甲士五万讨伐他们。东晋益州刺史竺瑶、威远将军桓石虔率领士兵三万进攻垫江，姚苌兵败，退守五城。竺瑶、桓石虔屯驻巴东。张育自称蜀王，与巴獠酋帅张重、尹万的一万余人进军包围成都。六月，张育改年号为黑龙。秋季，七月，张育与张重等人争夺权力，举兵互相攻击，前秦杨安、邓羌袭击张育，将其击败，张育与杨光退守绵竹。八月，邓羌在涪西击败东晋军队。九月，杨安在成都以南击败张重、尹万，张重战死，斩首二万三千级。邓羌在绵竹进攻张育、杨光，将二人全部斩杀。益州重新归入前秦。","content_jianti_auto":"4夏，五月，蜀人张育、杨光起兵击秦，有众二万，遣使来请兵。秦王坚遣镇军将军邓羌帅甲士五万讨之。益州刺史竺瑶、威远将军桓石虔帅众三万攻垫江，姚苌兵败，退屯五城。瑶、石虔屯巴东。张育自号蜀王，与巴獠酋帅张重、尹万万余人进围成都。六月，育改元黑龙。秋，七月，张育与张重等争权，举兵相攻，秦杨安、邓羌袭育，败之，育与杨光退屯緜竹。八月，邓羌败晋兵于涪西。九月，杨安败张重、尹万于成都南，重死，斩首二万三千级。邓羌击张育、杨光于緜竹，皆斩之。益州复入于秦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9091,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"a2c1edd1-db0e-11ef-9030-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否诛杀鲜卑以应天象警兆","decision_tongjian_id":"DECISION_A2C2B1A4DB0E11EFB7A4A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":12,"tongjian_id":"a2c2b1a6-db0e-11ef-a91d-a0d3651f611f"},{"place_name":"慕容","place_name_jianti_auto":"慕容","start_index":18,"tongjian_id":"a2c2b1a7-db0e-11ef-8d7e-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":23,"tongjian_id":"a2c2b1a8-db0e-11ef-a195-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「魚羊」合成「鮮」字，謂鮮卑也。是後慕容起兵攻秦，果在甲申、乙酉之歲。呼，火到翻。","note_content_jianti_auto":"「鱼羊」合成「鲜」字，谓鲜卑也。是后慕容起兵攻秦，果在甲申、乙酉之岁。呼，火到翻。","note_type":"hu_note","start_index":37,"tongjian_id":"a2c2b1a5-db0e-11ef-b92a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"整","people_name_jianti_auto":"整","start_index":16,"tongjian_id":"a2c2b1aa-db0e-11ef-9f0c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":0,"tongjian_id":"a2c2b1ab-db0e-11ef-ba0c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":14,"tongjian_id":"a2c2b1ac-db0e-11ef-bb9f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉祕書省有丞、有郞，無侍郞。秦以整爲祕書郞，內侍左右，故曰侍郞。","note_content_jianti_auto":"晋秘书省有丞、有郞，无侍郞。秦以整为秘书郞，内侍左右，故曰侍郞。","note_type":"hu_note","start_index":61,"tongjian_id":"a2c2b1a9-db0e-11ef-a1d9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"段夫人","people_name_jianti_auto":"段夫人","start_index":1,"tongjian_id":"a2c3e7e8-db0e-11ef-96e3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卽段夫人也。","note_content_jianti_auto":"即段夫人也。","note_type":"hu_note","start_index":113,"tongjian_id":"a2c2b1af-db0e-11ef-8b0e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"祕書監","official_note":"祕書監是掌管圖書典籍的官員，屬於文教類職務。在《資治通鑑》此段中，朱肜擔任此職，並與趙整一同建議誅殺鮮卑，顯示其參與朝政諫言。","official_rank":"未知","source_snippet":"祕書監朱肜","start_index":38,"tongjian_id":"8bbd8944-49d7-408c-a2cc-d558537042be"},{"confidence":0.9,"official_category":"文教","official_name":"祕書侍郞","official_note":"祕書侍郞是協助祕書監管理圖書的官員，也屬文教類職務。在此段中，趙整擔任此職，並以直言諫諍聞名，前後上書五十餘事，體現其監察或諫議作用。","official_rank":"未知","source_snippet":"祕書侍郞略陽趙整","start_index":44,"tongjian_id":"0f8d06b1-96fe-406d-abd6-9e7a2299045d"},{"confidence":0.85,"official_category":"宫廷内侍","official_name":"宦官","official_note":"宦官是宫廷内的侍從官員，負責侍奉皇帝或皇室。在此段中，趙整被描述為宦官，並以其博聞強記和直言諫諍著稱，顯示其雖為內侍但參與政治諫言。","official_rank":"未知","source_snippet":"整，宦官也","start_index":56,"tongjian_id":"ae044541-740d-4981-9516-613a51f1ca40"}],"ExtRef_Children_people":[{"link_birth_yea