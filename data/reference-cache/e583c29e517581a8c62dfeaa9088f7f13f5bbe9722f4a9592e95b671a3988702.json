a2c1edc5-db0e-11ef-9e72-a0d3651f611f"},{"place_name":"青","place_name_jianti_auto":"青","resolved_place_entity_id":249,"start_index":25,"tongjian_id":"a2c1edc6-db0e-11ef-8bf0-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","resolved_place_entity_id":199,"start_index":32,"tongjian_id":"a2c1edc7-db0e-11ef-bc48-a0d3651f611f"},{"place_name":"兗","place_name_jianti_auto":"兖","resolved_place_entity_id":211,"start_index":34,"tongjian_id":"a2c1edc8-db0e-11ef-95e7-a0d3651f611f"},{"place_name":"廣陵","place_name_jianti_auto":"广陵","resolved_place_entity_id":246,"start_index":41,"tongjian_id":"a2c1edc9-db0e-11ef-b7dd-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"2己酉，刁彝卒。二月，癸丑，以王坦之爲都督徐·兗·青三州諸軍事、徐·兗二州刺史，鎭廣陵。詔謝安總中書。安好聲律，期功之慘，不廢絲竹，士大夫效之，遂以成俗。王坦之屢以書苦諫之曰：「天下之寶，當爲天下惜之。」安不能從。","content_fanyi":"正月二十七日己酉，东晋大臣刁彝去世。二月初一癸丑，东晋任命王坦之为都督徐、兖、青三州诸军事及徐、兖二州刺史，镇守广陵。下诏命谢安总领中书事务。谢安爱好音乐，即使服丧的哀痛期间也不停止演奏丝竹；士大夫们纷纷仿效，逐渐成为风俗。王坦之多次写信苦苦劝谏他说：“礼仪法度是天下的至宝，应当为天下珍惜它。”谢安最终没能听从。","content_jianti_auto":"2己酉，刁彝卒。二月，癸丑，以王坦之为都督徐·兖·青三州诸军事、徐·兖二州刺史，镇广陵。诏谢安总中书。安好声律，期功之惨，不废丝竹，士大夫效之，遂以成俗。王坦之屡以书苦谏之曰：「天下之宝，当为天下惜之。」安不能从。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9089,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"a2c1edbb-db0e-11ef-b597-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是古代中国的高级军事官职，掌管全国军事，此处指前秦的太尉李威去世，表明其在前秦政权中的军事领导地位。","official_rank":"正一品","source_snippet":"秦太尉建寧烈公李威卒","start_index":4,"tongjian_id":"290f7cba-2b7d-48f9-9252-5526cfbcd356"}],"ExtRef_Children_people":[{"link_death_year":375,"link_td_description":"李威，字伯龙，十六国汉阳（今甘肃省甘谷县东南）人。苻坚母苟夫人姑姑的儿子。","link_td_id":"Q10018242","link_td_number_id":5482491,"people_name":"建寧烈公","people_name_j