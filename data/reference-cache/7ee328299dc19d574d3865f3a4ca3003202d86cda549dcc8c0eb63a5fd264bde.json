f_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"春申君","people_name_jianti_auto":"春申君","start_index":0,"tongjian_id":"8d23be80-db0e-11ef-9018-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":34,"tongjian_id":"8d23be81-db0e-11ef-b3e4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":4,"tongjian_id":"8d23be82-db0e-11ef-9664-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":6,"tongjian_id":"8d23be83-db0e-11ef-9c40-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":10,"tongjian_id":"8d23be84-db0e-11ef-be91-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春申君相楚，楚正弱，秦正強，不能爲國謀，乃營其都而盛宮室，何足道也！孔穎達曰：爾雅云：室謂之宮，宮謂之室。別而言之，論其四面穹隆則曰宮，因其貯物則曰室。室之言實也。","note_content_jianti_auto":"春申君相楚，楚正弱，秦正强，不能为国谋，乃营其都而盛宫室，何足道也！孔颖达曰：尔雅云：室谓之宫，宫谓之室。别而言之，论其四面穹隆则曰宫，因其贮物则曰室。室之言实也。","note_type":"hu_note","start_index":57,"tongjian_id":"8d23be7f-db0e-11ef-a175-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.7,"official_category":"封君","official_name":"春申君","official_note":"春申君是战国时期楚国的封君，以封号而非正式官职著称，在《资治通鉴》中常作为人物出现，此处是春申君向楚王进言，建议将淮北设为郡并封于江东，体现了封君在政治决策中的作用。","official_rank":"未知","source_snippet":"楚春申君言於楚王曰","start_index":1,"tongjian_id":"de388357-2b8c-4b1c-9d30-55e08958e04c"},{"confidence":0.9,"official_category":"君主","official_name":"楚王","official_note":"楚王是楚国的君主，在《资治通鉴》中作为最高统治者出现，此处楚王批准了春申君的建议，显示了君主在地方行政决策中的权威。","official_rank":"最高统治者","source_snippet":"楚王許之","start_index":28,"tongjian_id":"c6cf9375-37f6-48cb-9960-eca1f393951b"}],"ExtRef_Children_people":[{"link_death_year":-238,"link_td_description":"春申君，本名黄歇，中国战国时代政治家，楚国黃邑人。楚考烈王时期官至楚国令尹，和平原君赵胜、孟尝君田文、信陵君魏无忌合称为“战国四公子”。","link_td_id":"Q10000284","link_td_number_id":191045,"people_name":"春申君","people_name_jianti_auto":"春申君","start_index":2,"tongjian_id":"8d23be86-db0e-11ef-b6f3-a0d3651f611f","wl_zhushi":"[黄歇]"},{"link_death_year"