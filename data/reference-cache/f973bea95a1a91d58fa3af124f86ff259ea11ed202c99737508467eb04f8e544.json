219-0c7bdf27567a","source_start_index":242,"source_text":"周慎靓王三年，楚、赵、魏、韩、燕同伐秦，攻函谷关。秦出兵逐之，五国之师皆败走。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1楚、趙、魏、韓、燕同伐秦，攻函谷關。秦人出兵逆之，五國之師皆敗走。","content_fanyi":"楚国、赵国、魏国、韩国、燕国一同讨伐秦国，攻打函谷关。秦军出兵迎战，五国军队都战败退走。","content_jianti_auto":"1楚、赵、魏、韩、燕同伐秦，攻函谷关。秦人出兵逆之，五国之师皆败走。","dtjl_paragraph_links":[],"dtjl_references":[],"id":227,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c5a1806-db0e-11ef-8830-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"宋","place_name_jianti_auto":"宋","place_note":"府睢阳，河南商丘","resolved_place_entity_id":354,"start_index":1,"tongjian_id":"8c5a1818-db0e-11ef-b229-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2宋初稱王。","content_fanyi":"宋国国君开始称王。","content_jianti_auto":"2宋初称王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":228,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c5a1817-db0e-11ef-b3a0-a0d3651f611f"}],"reign_name":"三年","reign_name_jianti_auto":"三年","start_index":2,"tongjian_id":"8c5a1804-db0e-11ef-8009-a0d3651f611f","year_anno":"（癸卯、前三一八）","year_int":-318},"message":"success","success":true}