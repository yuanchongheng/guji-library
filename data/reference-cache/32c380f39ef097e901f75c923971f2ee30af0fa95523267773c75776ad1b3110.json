ame":"鄆州","place_name_jianti_auto":"郓州","resolved_place_entity_id":623,"start_index":38,"tongjian_id":"c21f5218-db0e-11ef-95a7-a0d3651f611f"},{"place_name":"棣州","place_name_jianti_auto":"棣州","resolved_place_entity_id":1295,"start_index":44,"tongjian_id":"c21f5219-db0e-11ef-84f9-a0d3651f611f"},{"place_name":"貝州","place_name_jianti_auto":"贝州","resolved_place_entity_id":605,"start_index":59,"tongjian_id":"c21f521a-db0e-11ef-a18d-a0d3651f611f"},{"place_name":"經城","place_name_jianti_auto":"经城","place_note":"河北省威县北经镇","resolved_place_entity_id":5143,"start_index":63,"tongjian_id":"c21f521b-db0e-11ef-ba42-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"4五月，王武俊屯冀州，將擊趙鎬，鎬帥其屬奔鄆州；李納分兵據之。田緒使孫光佐如鄆州，矯詔以棣州隸納；武俊怒，遣其子士清伐貝州，取經城等四縣。","content_fanyi":"五月，王武俊率军屯驻冀州，准备进攻赵镐，赵镐率领部属逃奔郓州；李纳分出一支军队占领棣州。田绪派遣判官孙光佐前往郓州，假称诏令将棣州划归李纳管辖；王武俊大怒，派儿子王士清率军攻打贝州，夺取经城等四县。","content_jianti_auto":"4五月，王武俊屯冀州，将击赵镐，镐帅其属奔郓州；李纳分兵据之。田绪使孙光佐如郓州，矫诏以棣州隶纳；武俊怒，遣其子士清伐贝州，取经城等四县。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23517,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"c21f520b-db0e-11ef-9120-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":8,"source_start_index":0,"source_text":"爲後沙陀來降張本","target_paragraph_tongjian_id":"c2bd605f-db0e-11ef-aa9a-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"沙陀","place_name_jianti_auto":"沙陀","start_index":2,"tongjian_id":"c21f521e-db0e-11ef-b7fa-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲後沙陀來降張本。","note_content_jianti_auto":"为后沙陀来降张本。","note_type":"hu_note","start_index":46,"tongjian_id":"c21f521d-db0e-11ef-9c17-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"郭鋒","people_name_jianti_auto":"郭锋","start_index":4,"tongjian_id":"c21f5220-db0e-11ef-846f-a0d3651f611f"},{"people_name":"忠貞可汗","people_name_jianti_auto":"忠贞可汗","start_index":7,"tongjian_id":"c21f5221-db0e-11ef-94f6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":2,"tongjian_id":"c21f5222-db0e-11ef-af2b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"去年唐遣郭鋒冊忠貞可汗。遺，唯季翻。","note_content_jianti_auto":"去年唐遣郭锋册忠贞可汗。遗，唯季翻。","note_type":"hu_note","start_index":126,"tongjian_id":"c21f521f-db0e-11ef-8463-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"仰，牛向翻。唐韻：北人呼父曰阿爹。爹，徒可翻。","note_content_jianti_auto":"仰，牛向翻。唐韵：北人呼父曰阿爹。爹，徒可翻。","note_type":"hu_note","start_index":166,"tongjian_id":"c21f5223-db0e-11ef-9762-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"節度使","official_note":"節度使是唐代地方军政长官，掌管一镇或数州的军事、行政和财政，此处指北庭节度使杨袭古在战败后逃亡西州，反映了唐朝在边疆地区的军事控制力减弱。","official_rank":"未知","source_snippet":"節度使楊襲古帥麾下二千人奔西州","start_index":48,"tongjian_id":"d50c5ce9-8e05-48f2-b9b3-40c6c98e41d5"},{"confidence":0.85,"official_category":"中枢机构","official_name":"次相","official_note":"次相是回鹘（回鶻）政权中的高级官职，通常指副宰相或仅次于可汗的官员，此处次相担心颉干迦斯回国后可能发动政变，显示了回鹘内部的政治斗争。","official_rank":"未知","source_snippet":"次相恐其有廢立","start_index":73,"tongjian_id":"b8cf21a9-466c-4709-bef4-c925461d9387"},{"confidence":0.9,"official_category":"地方行政","official_name":"可汗","official_note":"可汗是回鹘（回鶻）等北方游牧民族政权的最高统治者，相当于皇帝，此处可汗与次相一同出迎颉干迦斯，表明其地位但受制于军事将领。","official_rank":"未知","source_snippet":"與可汗皆出郊迎","st