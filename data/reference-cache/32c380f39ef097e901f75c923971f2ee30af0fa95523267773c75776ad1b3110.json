{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚午、七九○）","note_content_jianti_auto":"（庚午、七九○）","note_type":"hu_note","start_index":0,"tongjian_id":"c21d08e1-db0e-11ef-953a-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"宫廷内侍","official_name":"中使","official_note":"中使是唐代皇帝派遣的宦官使者，负责传达诏令或执行宫廷任务，此处指派遣宦官将佛指骨重新安葬。","official_rank":"未知","source_snippet":"遣中使","start_index":44,"tongjian_id":"838d604c-c640-4913-ae57-fea71008de0a"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"岐山","place_name_jianti_auto":"岐山","place_note":"陕西岐山县东北","resolved_place_entity_id":592,"start_index":5,"tongjian_id":"c21d08e4-db0e-11ef-95af-a0d3651f611f"},{"place_name":"無憂王寺","place_name_jianti_auto":"无忧王寺","resolved_place_entity_id":3291,"start_index":7,"tongjian_id":"c21d08e5-db0e-11ef-9560-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1春，詔出岐山無憂王寺佛指骨迎置禁中，又送諸寺以示衆，傾都瞻禮，施財巨萬；二月，乙亥，遣中使復葬故處。","content_fanyi":"春季，德宗下诏取出岐山县无忧王寺中的佛指骨，迎入宫中安放，又送到京城各寺院展示给众人观看，全京城的人都去瞻仰礼拜，施舍的钱财数额成千上万。二月初八日乙亥，德宗派遣中使把佛指骨送回无忧王寺旧址重新安葬。","content_jianti_auto":"1春，诏出岐山无忧王寺佛指骨迎置禁中，又送诸寺以示众，倾都瞻礼，施财巨万；二月，乙亥，遣中使复葬故处。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23514,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"c21d08e2-db0e-11ef-90d4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":11,"source_start_index":0,"source_text":"見二百三十一卷興元元年","target_paragraph_tongjian_id":"c0d449b2-db0e-11ef-af1d-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見二百三十一卷興元元年。","note_content_jianti_auto":"见二百三十一卷兴元元年。","note_type":"hu_note","start_index":10,"tongjian_id":"c21f51e0-db0e-11ef-95ef-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"棣州刺史","official_note":"棣州刺史是唐朝地方行政官职，负责管理棣州（今山东境内）的政务和军事。在上下文中，赵镐担任此职，后投降王武俊，反映了当时藩镇割据和官员叛变的情况。","official_rank":"未知","source_snippet":"其棣州刺史趙鎬以州降於王武俊","start_index":12,"tongjian_id":"d507c41b-6a4e-4276-bd94-5fa1ae6d6f55"},{"confidence":0.95,"official_category":"地方行政","official_name":"齊州刺史","official_note":"齐州刺史是唐朝地方行政官职，负责管理齐州（今山东济南一带）的政务和军事。在上下文中，田绪的兄长担任此职，服务于李纳，显示了地方官员与藩镇势力的关联。","official_rank":"未知","source_snippet":"仕李納爲齊州刺史","start_index":44,"tongjian_id":"f0a689d3-a0a9-411e-992a-b0a62cf47f3e"},{"confidence":0.9,"official_category":"地方行政","official_name":"判官","official_note":"判官是唐朝地方或军事机构中的僚属官职，负责协助长官处理政务或军务。在上下文中，孙光佐作为判官为田绪出谋划策，体现了其在地方行政中的作用。","official_rank":"未知","source_snippet":"判官孫光佐等爲緒謀","start_index":66,"tongjian_id":"6a2d92b2-4fb1-494b-9d08-b313fc63602e"}],"ExtRef_Children_people":[{"link_death_year":785,"link_td_description":"朱滔，幽州昌平人，朱泚之弟。","link_td_id":"Q10009330","link_td_number_id":608993,"people_name":"朱滔","people_name_jianti_auto":"朱滔","people_xingming":"朱滔","start_index":3,"tongjian_id":"c21f51e2-db0e-11ef-a8d9-a0d3651f611f"},{"people_name":"趙鎬","people_name_jianti_auto":"赵镐","people_xingming":"赵镐","start_index":15,"tongjian_id":"c21f51e4-db0e-11ef-913e-a0d3651f611f"},{"people_name":"王武俊","people_name_jianti_auto":"王武俊","people_xingming":"王武俊","start_index":21,"tongjian_id":"c21f51e5-db0e-11ef-9b69-a0d3651f611f"},{"people_name":"武俊","people_name_jianti_auto":"武俊","people_xingming":"王武俊","start_index":30,"tongjian_id":"c21f51e6-db0e-11ef-a096-a0d3651f611f"},{"link_birth_year":764,"link_death_year":796,"link_td_description":"田绪，平州卢龙（今河北省卢龙县）人。唐朝魏博节度使田承嗣之子，官至魏博兵马使，后杀其堂兄田悦，自命节度使。唐朝以嘉诚公主配之，成为驸马。","link_td_id":"Q10001621","link_td_number_id":858962,"people_name":"田緒","people_name_jianti_auto":"田绪","people_xingming":"田绪","start_index":38,"tongjian_id":"c21f51e7-db0e-11ef-ba06-a0d3651f611f"},{"people_name":"朝","people_name_jianti_auto":"朝","people_xingming":"田朝","start_index":45,"tongjian_id":"c21f51e8-db0e-11ef-9878-a0d3651f611f"},{"people_name":"李納","people_name_jianti_auto":"李纳","people_xingming":"李纳","start_index":48,"tongjian_id":"c21f51e9-db0e-11ef-95a1-a0d3651f611f"},{"people_name":"納","people_name_jianti_auto":"纳","people_xingming":"李纳","start_index":58,"tongjian_id":"c21f51ea-db0e-11ef-b97e-a0d3651f611f"},{"people_name":"朝","people_name_jianti_auto":"朝","start_index":61,"tongjian_id":"c21f51eb-db0e-11ef-bd65-a0d3651f611f"},{"link_birth_year":764,"link_death_year":796,"link_td_description":"田绪，平州卢龙（今河北省卢龙县）人。唐朝魏博节度使田承嗣之子，官至魏博兵马使，后杀其堂兄田悦，自命节度使。唐朝以嘉诚公主配之，成为驸马。","link_td_id":"Q10001621","link_td_number_id":858962,"people_name":"緒","people_name_jianti_auto":"绪","start_index":65,"tongjian_id":"c21f51ec-db0e-11ef-8a69-a0d3651f611f"},{"people_name":"孫光佐","people_name_jianti_auto":"孙光佐","people_xingming":"孙光佐","start_index":70,"tongjian_id":"c21f51ed-db0e-11ef-a014-a0d3651f611f"},{"link_birth_year":764,"link_death_year":796,"link_td_description":"田绪，平州卢龙（今河北省卢龙县）人。唐朝魏博节度使田承嗣之子，官至魏博兵马使，后杀其堂兄田悦，自命节度使。唐朝以嘉诚公主配之，成为驸马。","link_td_id":"Q10001621","link_td_number_id":858962,"people_name":"緒","people_name_jianti_auto":"绪","people_xingming":"田绪","start_index":75,"tongjian_id":"c21f51ee-db0e-11ef-a4ff-a0d3651f611f"},{"people_name":"納","people_name_jianti_auto":"纳","people_xingming":"李纳","start_index":84,"tongjian_id":"c21f51ef-db0e-11ef-ba8f-a0d3651f611f"},{"people_name":"趙鎬","people_name_jianti_auto":"赵镐","start_index":86,"tongjian_id":"c21f51f0-db0e-11ef-a3ca-a0d3651f611f"},{"people_name":"朝","people_name_jianti_auto":"朝","people_xingming":"田朝","start_index":98,"tongjian_id":"c21f51f5-db0e-11ef-91fe-a0d3651f611f"},{"people_name":"納","people_name_jianti_auto":"纳","people_xingming":"李纳","start_index":103,"tongjian_id":"c21f51f6-db0e-11ef-98e0-a0d3651f611f"},{"people_name":"鎬","people_name_jianti_auto":"镐","people_xingming":"赵镐","start_index":110,"tongjian_id":"c21f51f7-db0e-11ef-824b-a0d3651f611f"},{"people_name":"納","people_name_jianti_auto":"纳","people_xingming":"李纳","start_index":116,"tongjian_id":"c21f51f8-db0e-11ef-8190-a0d3651f611f"},{"people_name":"武俊","people_name_jianti_auto":"武俊","people_xingming":"王武俊","start_index":121,"tongjian_id":"c21f51f9-db0e-11ef-aa39-a0d3651f611f"},{"link_birth_year":759,"link_death_year":809,"link_td_description":"王士真，字公一，唐代成德（河北正定）军节度王武俊长子。沈毅勇悍，李宝臣“倚爱”之，以女妻之，王武俊死后，继任成德军节度使。顺宗即位，进位检校司空。有子王承宗（吴氏所生）、王承系、王承元、王承通、王承迪、王承恭、王承庆、王承泰、王承宪等11人（余子失名）。元和四年三月（809年），王士真病死，葬于恒府寿阳先茔。其长子王承宗起兵叛唐。","link_td_id":"Q10009672","link_td_number_id":795106,"people_name":"士眞","people_name_jianti_auto":"士真","people_xingming":"王士真","start_index":126,"tongjian_id":"c21f51fa-db0e-11ef-ab68-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"貝州","place_name_jianti_auto":"贝州","place_note":"河北省清河县","resolved_place_entity_id":605,"start_index":7,"tongjian_id":"c21f51e3-db0e-11ef-beb1-a0d3651f611f"},{"place_name":"棣州","place_name_jianti_auto":"棣州","place_note":"山东省惠民县","resolved_place_entity_id":1295,"start_index":11,"tongjian_id":"c21f51f1-db0e-11ef-b6ea-a0d3651f611f"},{"place_name":"齊州","place_name_jianti_auto":"齐州","resolved_place_entity_id":27,"start_index":51,"tongjian_id":"c21f51f2-db0e-11ef-8223-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","place_note":"河北省大名县","resolved_place_entity_id":8,"start_index":63,"tongjian_id":"c21f51f3-db0e-11ef-a7fb-a0d3651f611f"},{"place_name":"棣州","place_name_jianti_auto":"棣州","resolved_place_entity_id":1295,"start_index":89,"tongjian_id":"c21f51f4-db0e-11ef-90a0-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","resolved_place_entity_id":43,"start_index":100,"tongjian_id":"c21f51fb-db0e-11ef-a552-a0d3651f611f"},{"place_name":"棣州","place_name_jianti_auto":"棣州","resolved_place_entity_id":1295,"start_index":112,"tongjian_id":"c21f51fc-db0e-11ef-8a32-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"贞元八年，纳死，子师古袭位，武俊引兵屯德、棣，将取蛤垛及...","context_before":"蛤垛城[在州南。有盐池，岁出盐数十万斛。","source_end_index":69,"source_paragraph_tongjian_id":"0e200b77-b9b4-5053-9622-b0721d0f1f0c","source_start_index":20,"source_text":"唐建中初，棣州隶淄青，既而归于朱滔，又归于王武俊，惟蛤垛犹为淄青帅李纳所据，因城而戍之，以专盐利。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"}],"class_tags":["军事","外交"],"content":"2初，朱滔敗於貝州，其棣州刺史趙鎬以州降於王武俊，旣而得罪於武俊，召之不至。田緒殘忍，其兄朝，仕李納爲齊州刺史。或言納欲納朝於魏，緒懼；判官孫光佐等爲緒謀，厚賂納，且說納招趙鎬取棣州以悅之，因請送朝於京師；納從之。丁酉，鎬以棣州降于納。三月，武俊使其子士眞擊之，不克。","content_fanyi":"当初，朱滔在贝州打了败仗后，他统辖的棣州刺史赵镐率领本州军民投降了王武俊；不久，赵镐又因事得罪了王武俊，王武俊召他前来，他拒不受命。田绪生性残忍暴虐，他的哥哥田朝在李纳手下担任齐州刺史。有人对田绪说，李纳打算把田朝送回魏博，田绪听后十分恐惧；判官孙光佐等人为田绪出谋划策，向李纳赠送丰厚的礼品，并劝说李纳招降赵镐、夺取棣州，以此取悦李纳，趁机请求李纳把田朝送往京城；李纳听从了他们的建议。二月三十日丁酉，赵镐又带着棣州投降了李纳。三月，王武俊派他的儿子王士真进攻赵镐占据的棣州，未能攻克。","content_jianti_auto":"2初，朱滔败于贝州，其棣州刺史赵镐以州降于王武俊，既而得罪于武俊，召之不至。田绪残忍，其兄朝，仕李纳为齐州刺史。或言纳欲纳朝于魏，绪惧；判官孙光佐等为绪谋，厚赂纳，且说纳招赵镐取棣州以悦之，因请送朝于京师；纳从之。丁酉，镐以棣州降于纳。三月，武俊使其子士真击之，不克。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23515,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"c21d08e6-db0e-11ef-8842-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"葉公主","people_name_jianti_auto":"叶公主","start_index":15,"tongjian_id":"c21f51ff-db0e-11ef-a295-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：新傳曰：「可汗爲少可敦葉公主所毒死，可汗之弟乃自立。」今從實錄。","note_content_jianti_auto":"考异曰：新传曰：「可汗为少可敦叶公主所毒死，可汗之弟乃自立。」今从实录。","note_type":"hu_note","start_index":16,"tongjian_id":"c21f51fe-db0e-11ef-9b8b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相，息亮翻。帥，讀曰率；下同。","note_content_jianti_auto":"相，息亮翻。帅，读曰率；下同。","note_type":"hu_note","start_index":59,"tongjian_id":"c21f5203-db0e-11ef-9f39-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大相","official_note":"大相是回鶻（回纥）政权中的高级官职，相当于宰相，负责国家政务和军事指挥。在《资治通鉴》此段中，大相頡干迦斯西击吐蕃未还，表明其在外执行军事任务，是回鶻政治结构中的关键人物。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"其大相頡干迦斯西擊吐蕃未還","start_index":18,"tongjian_id":"c5ad2622-d92a-4d42-ac7c-b55508be4151"},{"confidence":0.85,"official_category":"中枢机构","official_name":"次相","official_note":"次相是回鶻政权中的官职，地位次于大相，可能协助处理国家事务。在此段中，次相领导国人杀死篡位者并立新可汗，显示了其在政治变动中的重要作用。此信息基于《资治通鉴》原文和历史常识。","official_rank":"未知","source_snippet":"次相帥國人殺篡者而立忠貞之子阿啜爲可汗","start_index":36,"tongjian_id":"47c6fe2a-7b8f-470a-b161-f422fb551587"}],"ExtRef_Children_people":[{"link_death_year":790,"link_td_description":"忠贞可汗，名多逻斯，号“泮官特勒”，药罗葛氏，是回鹘的第五任可汗，他是长寿天亲可汗之子。","link_td_id":"Q10010174","link_td_number_id":964554,"people_name":"忠貞可汗","people_name_jianti_auto":"忠贞可汗","people_xingming":"药罗葛多逻斯","start_index":3,"tongjian_id":"c21f5204-db0e-11ef-9436-a0d3651f611f","wl_zhushi":"[药罗葛多逻斯]"},{"link_death_year":790,"link_td_description":"忠贞可汗，名多逻斯，号“泮官特勒”，药罗葛氏，是回鹘的第五任可汗，他是长寿天亲可汗之子。","link_td_id":"Q10010174","link_td_number_id":964554,"people_name":"忠貞","people_name_jianti_auto":"忠贞","people_xingming":"药罗葛多逻斯","start_index":10,"tongjian_id":"c21f5205-db0e-11ef-8a46-a0d3651f611f"},{"link_td_description":"颉干迦斯，又作颉于迦斯，原音应为ilugasi，义为采邑主权者。回鹘汗国贵族、重臣，武义成功可汗时宰相。","link_td_id":"Q10020410","link_td_number_id":6318617,"people_name":"頡干迦斯","people_name_jianti_auto":"颉干迦斯","people_xingming":"頡干迦斯","start_index":19,"tongjian_id":"c21f5207-db0e-11ef-b858-a0d3651f611f"},{"link_death_year":790,"link_td_description":"忠贞可汗，名多逻斯，号“泮官特勒”，药罗葛氏，是回鹘的第五任可汗，他是长寿天亲可汗之子。","link_td_id":"Q10010174","link_td_number_id":964554,"people_name":"忠貞","people_name_jianti_auto":"忠贞","people_xingming":"药罗葛多逻斯","start_index":45,"tongjian_id":"c21f5208-db0e-11ef-874d-a0d3651f611f"},{"link_death_year":795,"link_td_description":"奉诚可汗，名阿啜，药罗葛氏，是回鹘汗国的第六任可汗，在位时间为790-795年，他是忠贞可汗的幼子。","link_td_id":"Q10010167","link_td_number_id":964558,"people_name":"阿啜","people_name_jianti_auto":"阿啜","people_xingming":"阿啜","start_index":49,"tongjian_id":"c21f5209-db0e-11ef-9eb9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"回鶻","place_name_jianti_auto":"回鹘","resolved_place_entity_id":297,"start_index":1,"tongjian_id":"c21f5206-db0e-11ef-83fa-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","resolved_place_entity_id":92,"start_index":25,"tongjian_id":"c21f520a-db0e-11ef-b53c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"3回鶻忠貞可汗之弟弒忠貞而自立，其大相頡干迦斯西擊吐蕃未還，夏，四月，次相帥國人殺篡者而立忠貞之子阿啜爲可汗，年十五。","content_fanyi":"回鹘忠贞可汗的弟弟杀死忠贞可汗，自立为可汗。回鹘大相国颉干迦斯正率军西征攻打吐蕃，尚未返回。夏季四月，回鹘次相国率领国人杀死篡位者，拥立忠贞可汗的儿子阿啜为可汗，阿啜时年十五岁。","content_jianti_auto":"3回鹘忠贞可汗之弟弑忠贞而自立，其大相颉干迦斯西击吐蕃未还，夏，四月，次相帅国人杀篡者而立忠贞之子阿啜为可汗，年十五。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23516,"number":3,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":2,"tongjian_id":"c21f51fd-db0e-11ef-8376-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],