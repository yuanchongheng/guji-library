{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲子、前一一七）","note_content_jianti_auto":"（甲子、前一一七）","note_type":"hu_note","start_index":0,"tongjian_id":"8fdf65b0-db0e-11ef-af49-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1冬，十月，雨水，無冰。","content_fanyi":"冬季，十月，降雨，水未结冰。","content_jianti_auto":"1冬，十月，雨水，无冰。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1602,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8fdf65b1-db0e-11ef-8689-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":6,"source_start_index":0,"source_text":"事見上卷四年","target_paragraph_tongjian_id":"8fcaa958-db0e-11ef-a2e6-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷四年。","note_content_jianti_auto":"事见上卷四年。","note_type":"hu_note","start_index":12,"tongjian_id":"8fdf65b4-db0e-11ef-b173-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"縱，放也，肆也。","note_content_jianti_auto":"纵，放也，肆也。","note_type":"hu_note","start_index":32,"tongjian_id":"8fdf65b5-db0e-11ef-9e4a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"8fdf65b7-db0e-11ef-8b99-a0d3651f611f"},{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":4,"tongjian_id":"8fdf65b8-db0e-11ef-9f44-a0d3651f611f"},{"people_name":"楊可","people_name_jianti_auto":"杨可","start_index":7,"tongjian_id":"8fdf65b9-db0e-11ef-aac6-a0d3651f611f"},{"people_name":"縱","people_name_jianti_auto":"纵","start_index":19,"tongjian_id":"8fdf65ba-db0e-11ef-93c1-a0d3651f611f"},{"people_name":"可","people_name_jianti_auto":"可","start_index":23,"tongjian_id":"8fdf65bb-db0e-11ef-a076-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：武帝使楊可主告緡，沒入其財物，縱捕其爲可使者，此爲廢格詔書，沮已成之事也。格，音閣。沮，才汝翻，壞也。考異曰：漢書·武紀：「元鼎三年十一月，令民告緡。」據義縱傳則在今冬。","note_content_jianti_auto":"孟康曰：武帝使杨可主告缗，没入其财物，纵捕其为可使者，此为废格诏书，沮已成之事也。格，音阁。沮，才汝翻，坏也。考异曰：汉书·武纪：「元鼎三年十一月，令民告缗。」据义纵传则在今冬。","note_type":"hu_note","start_index":59,"tongjian_id":"8fdf65b6-db0e-11ef-ade0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"縣官","official_note":"縣官在漢代泛指地方官員或政府機構，此處指地方官府，上下文用於表示百姓不願資助官府。","official_rank":"未知","source_snippet":"佐縣官","start_index":18,"tongjian_id":"924313b6-a2c1-44fe-b6fa-38b40abf1989"}],"ExtRef_Children_people":[{"link_td_description":"卜式，为西汉时期官员，其出身河南郡（今属洛阳），以从事牧羊工作维生，后因出资赞助朝廷，而受拜为中郎，赐爵左庶长，再迁齐相，赐爵关内侯，一度官至御史大夫，卜式后因反对官方专营盐、铁，且不擅长于典章，而于元封元年被降调为太子太傅。","link_td_id":"Q10013005","link_td_number_id":1545377,"people_name":"卜式","people_name_jianti_auto":"卜式","people_xingming":"卜式","start_index":9,"tongjian_id":"8fdf65bf-db0e-11ef-85ce-a0d3651f611f"},{"link_td_description":"杨可，西汉大臣。","link_td_id":"Q10019801","link_td_number_id":6027736,"people_name":"楊可","people_name_jianti_auto":"杨可","people_xingming":"杨可","start_index":24,"tongjian_id":"8fdf65c0-db0e-11ef-a4b1-a0d3651f611f"},{"link_death_year":-117,"link_td_description":"义纵，河东郡（今山西省）人，西汉酷吏。","link_td_id":"Q10001272","link_td_number_id":345923,"people_name":"義縱","people_name_jianti_auto":"义纵","people_xingming":"义纵","start_index":32,"tongjian_id":"8fdf65c1-db0e-11ef-adf0-a0d3651f611f"},{"people_name":"可","people_name_jianti_auto":"可","start_index":45,"tongjian_id":"8fdf65c2-db0e-11ef-80b6-a0d3651f611f"},{"link_death_year":-117,"link_td_description":"义纵，河东郡（今山西省）人，西汉酷吏。","link_td_id":"Q10001272","link_td_number_id":345923,"people_name":"縱","people_name_jianti_auto":"纵","people_xingming":"义纵","start_index":52,"tongjian_id":"8fdf65c3-db0e-11ef-b7f7-a0d3651f611f"},{"link_death_year":-117,"link_td_description":"义纵，河东郡（今山西省）人，西汉酷吏。","link_td_id":"Q10001272","link_td_number_id":345923,"people_name":"縱","people_name_jianti_auto":"纵","people_xingming":"义纵","start_index":60,"tongjian_id":"8fdf65c4-db0e-11ef-8325-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/上官桀","excerpts":[{"context_after":"二人者，其始获罪一也，桀以一言之故超用，而纵及诛，可谓幸...","context_before":"...言未卒，泣数行下。上以为忠，由是亲近，至于受遗诏辅少主。","source_end_index":155,"source_paragraph_tongjian_id":"b37426eb-4eb7-4a1c-8d06-1d4f2a166d80","source_start_index":99,"source_text":"义纵为右内史，上幸鼎湖，病久，已而卒起，幸甘泉，道不治，上怒，曰：“纵以我为不行此道乎！”衔之，遂坐以它事弃市。"}],"path":"随笔/卷五/上官桀","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"2上旣下緡錢令而尊卜式，百姓終莫分財佐縣官，於是楊可告緡錢縱矣。義縱以爲此亂民，部吏捕其爲可使者。天子以縱爲廢格沮事，棄縱市。","content_fanyi":"汉武帝颁行缗钱令并尊崇卜式之后，百姓始终没有人愿意分出钱财来资助国家，于是由杨可主持的告发隐匿缗钱之事便大规模开展起来。义纵认为这是扰乱百姓，部署官吏逮捕杨可派出的官员。汉武帝认为义纵抗拒圣旨、阻挠告密事务，就把他处死在闹市。","content_jianti_auto":"2上既下缗钱令而尊卜式，百姓终莫分财佐县官，于是杨可告缗钱纵矣。义纵以为此乱民，部吏捕其为可使者。天子以纵为废格沮事，弃纵市。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1603,"number":2,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":1,"tongjian_id":"8fdf65b3-db0e-11ef-9677-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":17,"source_start_index":8,"source_text":"恨其父事見上卷四年","target_paragraph_tongjian_id":"8fcd2366-db0e-11ef-a828-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"衞青","people_name_jianti_auto":"衞青","start_index":4,"tongjian_id":"8fdf65c7-db0e-11ef-a8af-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":18,"tongjian_id":"8fdf65c8-db0e-11ef-8d34-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"怨大將軍衞青也。恨其父事見上卷四年。師古曰：令其父抱恨而死也。","note_content_jianti_auto":"怨大将军衞青也。恨其父事见上卷四年。师古曰：令其父抱恨而死也。","note_type":"hu_note","start_index":16,"tongjian_id":"8fdf65c6-db0e-11ef-8ccc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdf65ca-db0e-11ef-b9b2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：無何，謂未多時也。","note_content_jianti_auto":"师古曰：无何，谓未多时也。","note_type":"hu_note","start_index":34,"tongjian_id":"8fdf65c9-db0e-11ef-ab31-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdf65cc-db0e-11ef-99bd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"雍","place_name_jianti_auto":"雍","start_index":4,"tongjian_id":"8fdf65cd-db0e-11ef-8d3c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：雍之所在，地形積高，故曰上也。上，時掌翻。雍，於用翻。","note_content_jianti_auto":"师古曰：雍之所在，地形积高，故曰上也。上，时掌翻。雍，于用翻。","note_type":"hu_note","start_index":39,"tongjian_id":"8fdf65cb-db0e-11ef-bf89-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"義縱","people_name_jianti_auto":"义纵","start_index":72,"tongjian_id":"8fdf65cf-db0e-11ef-926e-a0d3651f611f"},{"people_name":"李敢","people_name_jianti_auto":"李敢","start_index":75,"tongjian_id":"8fdf65d0-db0e-11ef-a828-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鼎湖","place_name_jianti_auto":"鼎湖","start_index":25,"tongjian_id":"8fdf65d1-db0e-11ef-9770-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":34,"tongjian_id":"8fdf65d2-db0e-11ef-9010-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","place_note":"陝西凤翔","start_index":90,"tongjian_id":"8fdf65d3-db0e-11ef-9bc2-a0d3651f611f"},{"place_name":"甘泉宮","place_name_jianti_auto":"甘泉宫","place_note":"陝西淳化西北","start_index":93,"tongjian_id":"8fdf65d4-db0e-11ef-8988-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"射，而亦翻。考異曰：史記·封禪書云：「明年，天子病鼎湖，甚；病愈，幸甘泉，大赦。」莫知其爲何年。本紀皆無其事，獨義縱傳有之。按漢書·百官公卿表，義縱、李敢死皆在今年。敢傳云：「從上雍，至甘泉宮。」「雍」蓋衍字也。平準書云：「自造白金五銖錢後五歲赦。」按武紀，元狩四年造白金，元鼎元年赦，首尾四年。若今年更有赦，則四年再赦，與平準書不合，今從百官表。","note_content_jianti_auto":"射，而亦翻。考异曰：史记·封禅书云：「明年，天子病鼎湖，甚；病愈，幸甘泉，大赦。」莫知其为何年。本纪皆无其事，独义纵传有之。按汉书·百官公卿表，义纵、李敢死皆在今年。敢传云：「从上雍，至甘泉宫。」「雍」盖衍字也。平准书云：「自造白金五铢钱后五岁赦。」按武纪，元狩四年造白金，元鼎元年赦，首尾四年。若今年更有赦，则四年再赦，与平准书不合，今从百官表。","note_type":"hu_note","start_index":55,"tongjian_id":"8fdf65ce-db0e-11ef-bb94-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"郞中令","official_note":"郞中令是汉代九卿之一，掌管宫殿门户和侍卫，负责宫廷安全。在《资治通鉴》此段中，李敢担任郞中令，因怨恨大将军卫青而击伤他，显示其官职与宫廷事务相关。","official_rank":"九卿之一","source_snippet":"郞中令李敢","start_index":0,"tongjian_id":"e78c95f2-581b-4581-9c72-3008ff8237ee"},{"confidence":0.9,"official_category":"军事指挥","official_name":"大將軍","official_note":"大将军是汉代最高军事官职之一，通常授予功勋卓著的将领，负责统领全国军队。在此段中，大将军指卫青，李敢因父亲李广之死怨恨他，导致冲突。","official_rank":"高级军事长官","source_snippet":"怨大將軍之恨其父","start_index":7,"tongjian_id":"13068b7a-61f9-4818-af93-9b7be02bae57"},{"confidence":0.9,"official_category":"军事指挥","official_name":"票騎將軍","official_note":"票骑将军（骠骑将军）是汉代高级军事官职，地位仅次于大将军，常授予杰出将领。在此段中，霍去病担任票骑将军，射杀李敢，显示其军事权威和皇帝宠幸。","official_rank":"高级军事长官","source_snippet":"票騎將軍去病射殺敢","start_index":48,"tongjian_id":"2425de5c-596f-4af7-aa89-607a03a3a71a"}],"ExtRef_Children_people":[{"link_td_description":"李敢，飞将军李广的幼子，西汉将领。","link_td_id":"Q10009338","link_td_number_id":619641,"people_name":"李敢","people_name_jianti_auto":"李敢","people_xingming":"李敢","start_index":4,"tongjian_id":"8fdf65e0-db0e-11ef-8800-a0d3651f611f"},{"link_td_description":"李敢，飞将军李广的幼子，西汉将领。","link_td_id":"Q10009338","link_td_number_id":619641,"people_name":"敢","people_name_jianti_auto":"敢","people_xingming":"李敢","start_index":34,"tongjian_id":"8fdf65e1-db0e-11ef-8825-a0d3651f611f"},{"link_birth_year":-140,"link_death_year":-117,"link_td_description":"霍去病，河东郡平阳县（今山西临汾）人，卫子夫的姨甥，卫青的外甥，霍光之兄，西汉汉武帝时代对抗匈奴的名将。元狩六年因病去世，年仅二十三岁。","link_td_id":"Q10003709","link_td_number_id":72011,"people_name":"去病","people_name_jianti_auto":"去病","people_xingming":"霍去病","start_index":49,"tongjian_id":"8fdf65e3-db0e-11ef-836d-a0d3651f611f"},{"link_td_description":"李敢，飞将军李广的幼子，西汉将领。","link_td_id":"Q10009338","link_td_number_id":619641,"people_name":"敢","people_name_jianti_auto":"敢","people_xingming":"李敢","start_index":53,"tongjian_id":"8fdf65e4-db0e-11ef-8322-a0d3651f611f"},{"link_birth_year":-140,"link_death_year":-117,"link_td_description":"霍去病，河东郡平阳县（今山西临汾）人，卫子夫的姨甥，卫青的外甥，霍光之兄，西汉汉武帝时代对抗匈奴的名将。元狩六年因病去世，年仅二十三岁。","link_td_id":"Q10003709","link_td_number_id":72011,"people_name":"去病","people_name_jianti_auto":"去病","start_index":55,"tongjian_id":"8fdf65e6-db0e-11ef-b0b5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雍","place_name_jianti_auto":"雍","place_note":"陝西凤翔","resolved_place_entity_id":228,"start_index":37,"tongjian_id":"8fdf65e2-db0e-11ef-82b6-a0d3651f611f"},{"place_name":"甘泉宮","place_name_jianti_auto":"甘泉宫","place_note":"陝西淳化西北","resolved_place_entity_id":648,"start_index":40,"tongjian_id":"8fdf65e5-db0e-11ef-9e58-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"3郞中令李敢，怨大將軍之恨其父，乃擊傷大將軍，大將軍匿諱之。居無何，敢從上雍，至甘泉宮獵，票騎將軍去病射殺敢。去病時方貴幸，上爲諱，云鹿觸殺之。","content_fanyi":"郎中令李敢怨恨大将军卫青使其父李广抱恨而死，便打伤了卫青；卫青却隐瞒了这件事。过了不久，李敢随汉武帝刘彻前往雍地，又到甘泉宫狩猎，骠骑将军霍去病用箭射死了李敢。霍去病当时正受宠幸，声势显赫，汉武帝刘彻替他隐瞒真相，对外宣称李敢是被鹿撞死的。","content_jianti_auto":"3郞中令李敢，怨大将军之恨其父，乃击伤大将军，大将军匿讳之。居无何，敢从上雍，至甘泉宫猎，票骑将军去病射杀敢。去病时方贵幸，上为讳，云鹿触杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1604,"number":3,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":2,"tongjian_id":"8fdf65c5-db0e-11ef-884e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdf65e9-db0e-11ef-860d-a0d3651f611f"},{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":11,"tongjian_id":"8fdf65ea-db0e-11ef-b4ed-a0d3651f611f"},{"people_name":"李奇","people_name_jianti_auto":"李奇","start_index":25,"tongjian_id":"8fdf65eb-db0e-11ef-a16e-a0d3651f611f"},{"people_name":"毛晃","people_name_jianti_auto":"毛晃","start_index":41,"tongjian_id":"8fdf65ec-db0e-11ef-b28f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":45,"tongjian_id":"8fdf65ed-db0e-11ef-83ca-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：於廟中策命之。服虔曰：誥敕王，如尚書諸誥。李奇曰：今敕封拜諸王策文起於此。毛晃曰：漢制，天子之策長二尺。釋名曰：策，書敎令於上，所以驅策於下也。","note_content_jianti_auto":"师古曰：于庙中策命之。服虔曰：诰敕王，如尚书诸诰。李奇曰：今敕封拜诸王策文起于此。毛晃曰：汉制，天子之策长二尺。释名曰：策，书教令于上，所以驱策于下也。","note_type":"hu_note","start_index":34,"tongjian_id":"8fdf65e8-db0e-11ef-9507-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-110,"link_td_description":"刘闳，汉武帝第二子，生母王夫人，西汉齐王。","link_td_id":"Q10011696","link_td_number_id":1296156,"people_name":"閎","people_name_jianti_auto":"闳","people_xingming":"刘闳","start_index":13,"tongjian_id":"8fdf65f0-db0e-11ef-8875-a0d3651f611f"},{"link_death_year":-110,"link_td_description":"刘闳，汉武帝第二子，生母王夫人，西汉齐王。","link_td_id":"Q10011696","link_td_number_id":1296156,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"刘闳","start_index":15,"tongjian_id":"8fdf65f1-db0e-11ef-a7ed-a0d3651f611f"},{"link_death_year":-80,"link_td_description":"刘旦，汉武帝之子，母李姬，汉昭帝刘弗陵的同父异母的哥哥。","link_td_id":"Q10000470","link_td_number_id":1227964,"people_name":"旦","people_name_jianti_auto":"旦","people_xingming":"刘旦","start_index":18,"tongjian_id":"8fdf65f2-db0e-11ef-a1db-a0d3651f611f"},{"link_death_year":-80,"link_td_description":"刘旦，汉武帝之子，母李姬，汉昭帝刘弗陵的同父异母的哥哥。","link_td_id":"Q10000470","link_td_number_id":1227964,"people_name":"燕王","people_name_jianti_auto":"燕王","people_xingming":"刘旦","start_index":20,"tongjian_id":"8fdf65f3-db0e-11ef-b0e8-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"胥","people_name_jianti_auto":"胥","people_xingming":"刘胥","start_index":23,"tongjian_id":"8fdf65f4-db0e-11ef-be36-a0d3651f611f"},{"link_birth_year":-135,"link_death_year":-54,"link_td_description":"刘胥，汉武帝第四子，生母李姬。","link_td_id":"Q10011690","link_td_number_id":1296149,"people_name":"廣陵王","people_name_jianti_auto":"广陵王","people_xingming":"刘胥","start_index":25,"tongjian_id":"8fdf65f5-db0e-11ef-bad8-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/序","excerpts":[{"context_after":"彭宠以渔阳贾祸。公孙瓒以易京覆宗。王浚掩有幽州，幸晋室多...","context_before":"...，几灭者数矣。及秦人灭赵，败燕军于易水之西，而国随以亡。","source_end_index":1596,"source_paragraph_tongjian_id":"f376e31c-8440-5e2e-b4db-e21dcf05ec70","source_start_index":1576,"source_text":"臧荼、卢绾、燕王旦国于燕，不旋踵而陨毙。"}],"path":"北直方舆纪要/序","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"4夏，四月，乙巳，廟立皇子閎爲齊王，旦爲燕王，胥爲廣陵王，初作誥策。","content_fanyi":"夏季，四月二十八日乙巳，汉武帝在太庙册立皇子刘闳为齐王，刘旦为燕王，刘胥为广陵王，自此开始以颁布“诰策”的形式册封诸王。","content_jianti_auto":"4夏，四月，乙巳，庙立皇子闳为齐王，旦为燕王，胥为广陵王，初作诰策。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1605,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8fdf65e7-db0e-11ef-b4a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdf65f9-db0e-11ef-bf8f-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：抵，歸也。大歸，猶言大凡也。無慮，亦謂大率無少計慮云耳。","note_content_jianti_auto":"师古曰：抵，归也。大归，犹言大凡也。无虑，亦谓大率无少计虑云耳。","note_type":"hu_note","start_index":48,"tongjian_id":"8fdf65f8-db0e-11ef-8e7b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5自造白金、五銖錢後，吏民之坐盜鑄金錢死者數十萬人，其不發覺者不可勝計，天下大抵無慮皆鑄金錢矣。犯者衆，吏不能盡誅。","content_fanyi":"自从铸造白金币、五铢钱以后，官吏和百姓中因私自铸钱而被处死的达数十万人，那些尚未被发觉的更是不计其数，天下大概几乎没有人不私自铸钱了。犯法的人太多，官府无法把他们全部处死。","content_jianti_auto":"5自造白金、五铢钱后，吏民之坐盗铸金钱死者数十万人，其不发觉者不可胜计，天下大抵无虑皆铸金钱矣。犯者众，吏不能尽诛。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1606,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8fdf65f6-db0e-11ef-a433-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋恭公","people_name_jianti_auto":"宋恭公","start_index":3,"tongjian_id":"8fdf65fc-db0e-11ef-af36-a0d3651f611f"},{"people_name":"褚師","people_name_jianti_auto":"褚师","start_index":20,"tongjian_id":"8fdf65fd-db0e-11ef-b832-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"褚","place_name_jianti_auto":"褚","start_index":11,"tongjian_id":"8fdf65fe-db0e-11ef-aee9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：宋恭公子石食采於褚，其德可師，號曰褚師，因以命氏。","note_content_jianti_auto":"姓谱：宋恭公子石食采于褚，其德可师，号曰褚师，因以命氏。","note_type":"hu_note","start_index":16,"tongjian_id":"8fdf65fb-db0e-11ef-b358-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"守，郡守；相，諸侯相也。","note_content_jianti_auto":"守，郡守；相，诸侯相也。","note_type":"hu_note","start_index":37,"tongjian_id":"8fdf6600-db0e-11ef-adcc-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"文教","official_name":"博士","official_note":"博士是汉代掌管经学、教育和礼仪的官职，此处指褚大和徐偃等人被派遣巡视郡国，负责举荐和监察事务。","official_rank":"未知","source_snippet":"博士褚大","start_index":8,"tongjian_id":"002803d1-b045-4339-bc0f-9dd9f8b8e635"},{"confidence":0.85,"official_category":"地方行政","official_name":"守","official_note":"守是汉代郡守的简称，负责一郡的行政事务，此处指被举荐的郡守中有罪者。","official_rank":"未知","source_snippet":"守、相","start_index":28,"tongjian_id":"9be176f9-5c48-467a-be4f-590842b7e7f0"},{"confidence":0.85,"official_category":"地方行政","official_name":"相","official_note":"相是汉代诸侯国相的简称，负责诸侯国的行政事务，此处指被举荐的国相中有罪者。","official_rank":"未知","source_snippet":"守、相","start_index":30,"tongjian_id":"6a4761ae-f174-4c3e-85e1-6745db8d88ec"},{"confidence":0.8,"official_category":"地方行政","official_name":"吏","official_note":"吏泛指官吏，此处指地方官员中有罪者，被博士等人举荐。","official_rank":"未知","source_snippet":"爲吏有罪者","start_index":32,"tongjian_id":"4c2be0e4-336d-426a-aaca-7a872e18f1e6"}],"ExtRef_Children_people":[{"people_name":"褚大","people_name_jianti_auto":"褚大","people_xingming":"褚大","start_index":8,"tongjian_id":"8fdf6601-db0e-11ef-a021-a0d3651f611f"},{"people_name":"徐偃","people_name_jianti_auto":"徐偃","people_xingming":"徐偃","start_index":11,"tongjian_id":"8fdf6602-db0e-11ef-8add-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6六月，詔遣博士褚大、徐偃等六人分循郡國，舉兼幷之徒及守、相、爲吏有罪者。","content_fanyi":"六月，汉武帝下诏派遣博士褚大、徐偃等六人分别巡行全国各郡和诸侯国，举劾兼并贫民耕地的人以及郡守、诸侯国丞相和其他官吏中犯法有罪的人。","content_jianti_auto":"6六月，诏遣博士褚大、徐偃等六人分循郡国，举兼幷之徒及守、相、为吏有罪者。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1607,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8fdf65fa-db0e-11ef-84ff-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-140,"link_death_year":-117,"link_td_description":"霍去病，河东郡平阳县（今山西临汾）人，卫子夫的姨甥，卫青的外甥，霍光之兄，西汉汉武帝时代对抗匈奴的名将。元狩六年因病去世，年仅二十三岁。","link_td_id":"Q10003709","link_td_number_id":72011,"people_name":"冠軍景桓侯","people_name_jianti_auto":"冠军景桓侯","people_xingming":"霍去病","start_