，生子光。去病旣壯大，乃自知父爲霍仲孺。會爲票騎將軍，擊匈奴，道出河東，遣吏迎仲孺而見之，大爲買田宅奴婢而去；及還，因將光西至長安，任以爲郞，稍遷至奉車都尉、光祿大夫。","content_fanyi":"当初，霍仲孺辞去官职回到家乡，娶了妻子，生下儿子霍光。霍去病长大后，才得知霍仲孺是自己的父亲。恰逢他担任骠骑将军出击匈奴，经过河东时，派官吏把霍仲孺接来相见，为他大量购置了田地、住宅和奴婢后才离去；等到班师回朝时，又顺势带着霍光西行到长安，保举他为郎官，后逐渐升迁至奉车都尉、光禄大夫。","content_jianti_auto":"初，霍仲孺吏毕归家，娶妇，生子光。去病既壮大，乃自知父为霍仲孺。会为票骑将军，击匈奴，道出河东，遣吏迎仲孺而见之，大为买田宅奴婢而去；及还，因将光西至长安，任以为郞，稍迁至奉车都尉、光禄大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1609,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"8fdf6608-db0e-11ef-83c8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"景帝","people_name_jianti_auto":"景帝","start_index":0,"tongjian_id":"8fdf661d-db0e-11ef-96cd-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":20,"tongjian_id":"8fdf661e-db0e-11ef-87c3-a0d3651f611f"},{"people_name":"異","people_name_jianti_auto":"异","start_index":31,"tongjian_id":"8fdf661f-db0e-11ef-9f5c-a0d3651f611f"},{"people_name":"廣","people_name_jianti_auto":"广","start_index":42,"tongjian_id":"8fdf6620-db0e-11ef-b349-a0d3651f611f"},{"people_name":"顏異","people_name_jianti_auto":"颜异","start_index":62,"tongjian_id":"8fdf6621-db0e-11ef-8cf9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"平","place_name_jianti_auto":"平","start_index":26,"tongjian_id":"8fdf6622-db0e-11ef-ba63-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"景帝後元年，更治粟內史爲大農令。考異曰：徐廣註史記·平準書云，異誅在元狩四年壬戌歲。廣見漢書·百官公卿表，其年註云：「大農令顏異，二年坐腹非誅。」不思有二年字，致此誤也。","note_content_jianti_auto":"景帝后元年，更治粟内史为大农令。考异曰：徐广注史记·平准书云，异诛在元狩四年壬戌岁。广见汉书·百官公卿表，其年注云：「大农令颜异，二年坐腹非诛。」不思有二年字，致此误也。","note_type":"hu_note","start_index":11,"tongjian_id":"8fdf661c-db0e-11ef-b5c3-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"财政","official_name":"大農令","official_note":"大農令是漢代掌管國家財政、農業和倉儲的中央官員，屬於九卿之一，負責賦稅、錢穀等事務。在《資治通鑑》此段中，大農令顏異被誅，顯示其在政治事件中的角色。","official_rank":"九卿之一","source_snippet":"大農令顏異誅","start_index":3,"tongjian_id":"fbb43d64-28b1-4f81-bddf-914efa40433d"}],"ExtRef_Children_people":[{"link_death_year":-117,"link_td_description":"颜异，早年为济南亭长，汉武帝时期任大司农，号称廉洁正直，最终被张汤以腹诽论罪，处死。","link_td_id":"Q10001614","link_td_number_id":223062,"people_name":"顏異","people_name_jianti_auto":"颜异","people_xingming":"颜异","start_index":7,"tongjian_id":"8fdf6627-db0e-11ef-ba90-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"8是歲，大農令顏異誅。","content_fanyi":"这一年，大农令颜异被处死。","content_jianti_auto":"8是岁，大农令颜异诛。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1610,"number":8,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":8,"tongjian_id":"8fdf661b-db0e-11ef-add5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":5,"source_start_index":0,"source_text":"見上卷四年","target_paragraph_tongjian_id":"8fcaa91a-db0e-11ef-a309-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"見上卷四年。","note_content_jianti_auto":"见上卷四年。","note_type":"hu_note","start_index":24,"tongjian_id":"8fdf6629-db0e-11ef-93ec-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"時王侯朝賀以皮幣薦璧，故曰皮薦。朝