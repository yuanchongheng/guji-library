1ef-a851-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":8,"tongjian_id":"ca15d469-db0e-11ef-b490-a0d3651f611f"},{"place_name":"武陽","place_name_jianti_auto":"武阳","start_index":11,"tongjian_id":"ca15d46a-db0e-11ef-94dc-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":14,"tongjian_id":"ca15d46b-db0e-11ef-80a3-a0d3651f611f"},{"place_name":"朝城","place_name_jianti_auto":"朝城","start_index":21,"tongjian_id":"ca15d46c-db0e-11ef-be7b-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":25,"tongjian_id":"ca15d46d-db0e-11ef-9fd8-a0d3651f611f"},{"place_name":"朝城縣","place_name_jianti_auto":"朝城县","start_index":29,"tongjian_id":"ca15d46e-db0e-11ef-83a3-a0d3651f611f"},{"place_name":"東武","place_name_jianti_auto":"东武","start_index":38,"tongjian_id":"ca15d46f-db0e-11ef-a807-a0d3651f611f"},{"place_name":"朝城","place_name_jianti_auto":"朝城","place_note":"山东莘县西南朝城镇","start_index":45,"tongjian_id":"ca15d470-db0e-11ef-b08c-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":48,"tongjian_id":"ca15d471-db0e-11ef-b8fd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢東郡東武陽縣，後魏曰武陽，唐開元七年更名朝城，屬魏州。故朝城縣管內猶有地名東武。九域志：朝城在魏州東南八十里。","note_content_jianti_auto":"汉东郡东武阳县，后魏曰武阳，唐开元七年更名朝城，属魏州。故朝城县管内犹有地名东武。九域志：朝城在魏州东南八十里。","note_type":"hu_note","start_index":32,"tongjian_id":"ca15d466-db0e-11ef-8fe2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"隋","place_name_jianti_auto":"隋","start_index":0,"tongjian_id":"ca15d474-db0e-11ef-8ae4-a0d3651f611f"},{"place_name":"汲","place_name_jianti_auto":"汲","start_index":2,"tongjian_id":"ca15d475-db0e-11ef-b1d2-a0d3651f611f"},{"place_name":"獲嘉","place_name_jianti_auto":"获嘉","place_note":"河南省获嘉县","start_index":4,"tongjian_id":"ca15d476-db0e-11ef-9be3-a0d3651f611f"},{"place_name":"新樂城","place_name_jianti_auto":"新乐城","start_index":12,"tongjian_id":"ca15d477-db0e-11ef-95bb-a0d3651f611f"},{"place_name":"新鄕縣","place_name_jianti_auto":"新鄕县","start_index":16,"tongjian_id":"ca15d478-db0e-11ef-9e9b-a0d3651f611f"},{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":20,"tongjian_id":"ca15d479-db0e-11ef-8ecb-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":23,"tongjian_id":"ca15d47a-db0e-11ef-9703-a0d3651f611f"},{"place_name":"共縣","place_name_jianti_auto":"共县","start_index":24,"tongjian_id":"ca15d47b-db0e-11ef-b9ef-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":31,"tongjian_id":"ca15d47c-db0e-11ef-9d69-a0d3651f611f"},{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":38,"tongjian_id":"ca15d47d-db0e-11ef-9aa3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋分汲、獲嘉二縣地，於古新樂城置新鄕縣。共城，漢共縣地，唐志屬衞州。九域志：共城在州西北五十五里。共，音恭。","note_content_jianti_auto":"隋分汲、获嘉二县地，于古新乐城置新鄕县。共城，汉共县地，唐志属衞州。九域志：共城在州西北五十五里。共，音恭。","note_type":"hu_note","start_index":74,"tongjian_id":"ca15d473-db0e-11ef-9358-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"梁祖","people_name_jianti_auto":"梁祖","start_index":11,"tongjian_id":"ca15d481-db0e-11ef-948d-a0d3651f611f"},{"people_name":"薛居正","people_name_jianti_auto":"薛居正","start_index":30,"tongjian_id":"ca15d482-db0e-11ef-a2f7-a0d3651f611f"},{"people_name":"太祖","people_name_jianti_auto":"太祖","start_index":35,"tongjian_id":"ca15d483-db0e-11ef-8b9e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":2,"tongjian_id":"ca15d484-db0e-11ef-bfe1-a0d3651f611f"},{"place_name":"白司馬阪","place_name_jianti_auto":"白司马阪","place_note":"河南洛阳市北","start_index":47,"tongjian_id":"ca15d485-db0e-11ef-aff3-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":52,"tongjian_id":"ca15d486-db0e-11ef-bfab-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言晉兵乘勝聲勢之盛。梁祖選富家子有材力者置帳下，號廳子都。薛居正曰：太祖置廳子都，最爲親軍。白司馬阪在洛陽城北。帥，讀曰率。","note_content_jianti_auto":"史言晋兵乘胜声势之盛。梁祖选富家子有材力者置帐下，号厅子都。薛居正曰：太祖置厅子都，最为亲军。白司马阪在洛阳城北。帅，读曰率。","note_type":"hu_note","start_index":90,"tongjian_id":"ca15d480-db0e-11ef-a793-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","resolved_place_entity_id":4282,"start_index":71,"tongjian_id":"ca15d497-db0e-11ef-a656-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"乾化五年，魏博附晋，晋王存勖命李存审自赵州进据临清，晋王...","context_before":"...。贞元末，属贝州。乾宁三年，河东将李存信攻临清，败汴兵。","source_end_index":152,"source_paragraph_tongjian_id":"9f2f6813-d180-5721-9a81-091aeeae12eb","source_start_index":122,"source_text":"朱梁开平五年，晋将周德威略魏博，自临清攻贝州，拔夏津、高唐。"},{"context_after":"盖因故东武朝城而名也。贞明五年，晋王存勖败于朝城，视河冰...","context_before":"...师自清入河，军于东武阳。后魏曰武阳县。隋因之。唐曰朝城。","source_end_index":225,"source_paragraph_tongjian_id":"ba91fc78-2d5b-50d3-ad4c-acb8c7cb0150","source_start_index":192,"source_text":"五代梁开平五年，晋将周德威攻博州，拔东武朝城。又贝州奏晋兵侵东武。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、卫辉府（卷四十九）","excerpts":[{"context_after":"新乡，皆今治也]。","context_before":"...置今县。唐武德二年，王世充使刘黑闼守新乡，为窦建德所获。","source_end_index":106,"source_paragraph_tongjian_id":"9345b8f3-8ce1-5fe2-852d-4b521b6fd4c9","source_start_index":83,"source_text":"朱梁开平五年，晋将周德威逼卫州，拔新乡及共城。"}],"path":"河南方舆纪要/四、卫辉府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"7乙丑，周德威自臨清攻貝州，拔夏津、高唐；攻博州，拔東武、朝城。攻澶州，刺史張可臻棄城走，帝斬之。德威進攻黎陽，拔臨河、淇門；逼衞州，掠新鄕、共城。庚午，帝親帥軍屯白司馬阪以備之。","content_fanyi":"乙丑日，周德威从临清进攻贝州，攻克夏津、高唐；又进攻博州，攻克东武、朝城。攻打澶州时，刺史张可臻弃城逃跑，皇帝将他处死。周德威又进攻黎阳，夺取临河、淇门；逼近卫州，抢掠新乡、共城。庚午日，皇帝亲自率领军队驻扎在白司马阪，以防备晋军。","content_jianti_auto":"7乙丑，周德威自临清攻贝州，拔夏津、高唐；攻博州，拔东武、朝城。攻澶州，刺史张可臻弃城走，帝斩之。德威进攻黎阳，拔临河、淇门；逼衞州，掠新鄕、共城。庚午，帝亲帅军屯白司马阪以备之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27742,"number":7,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 乾化元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"ca15d45d-db0e-11ef-8633-a0d3651f611f","year_int":911},"tongjian_id":"ca15d45d-db0e-11ef-8633-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"共城","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"月徵其課錢而免其防守之勞。","note_content_jianti_auto":"月征其课钱而免其防守之劳。","note_type":"hu_note","start_index":59,"tongjian_id":"caf64cac-db0e-11ef-a358-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":0,"tongjian_id":"caf64caf-db0e-11ef-bc24-a0d3651f611f"},{"place_name":"新鄕","place_name_jianti_auto":"新鄕","start_index":3,"tongjian_id":"caf64cb0-db0e-11ef-b7ce-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":9,"tongjian_id":"caf64cb1-db0e-11ef-93dd-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":21,"tongjian_id":"caf64cb2-db0e-11ef-9b48-a0d3651f611f"},{"place_name":"汲","place_name_jianti_auto":"汲","start_index":23,"tongjian_id":"caf64cb3-db0e-11ef-a963-a0d3651f611f"},{"place_name":"獲嘉","place_name_jianti_auto":"获嘉","start_index":25,"tongjian_id":"caf64cb4-db0e-11ef-b15d-a0d3651f611f"},{"place_name":"新樂城","place_name_jianti_auto":"新乐城","start_index":33,"tongjian_id":"caf64cb5-db0e-11ef-8859-a0d3651f611f"},{"place_name":"新鄕縣","place_name_jianti_auto":"新鄕县","start_index":37,"tongjian_id":"caf64cb6-db0e-11ef-8c79-a0d3651f611f"},{"place_name":"共城縣","place_name_jianti_auto":"共城县","start_index":41,"tongjian_id":"caf64cb7-db0e-11ef-bcfc-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","place_note":"首都兴王府【广东广州】","start_index":45,"tongjian_id":"caf64cb8-db0e-11ef-9edf-a0d3651f611f"},{"place_name":"共縣","place_name_jianti_auto":"共县","start_index":46,"tongjian_id":"caf64cb9-db0e-11ef-a74b-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":50,"tongjian_id":"caf64cba-db0e-11ef-be5e-a0d3651f611f"},{"place_name":"共城縣","place_name_jianti_auto":"共城县","start_index":52,"tongjian_id":"caf64cbb-db0e-11ef-a044-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":60,"tongjian_id":"caf64cbc-db0e-11ef-887c-a0d3651f611f"},{"place_name":"汲縣","place_name_jianti_auto":"汲县","start_index":63,"tongjian_id":"caf64cbd-db0e-11ef-959c-a0d3651f611f"},{"place_name":"新鄕縣","place_name_jianti_auto":"新鄕县","start_index":71,"tongjian_id":"caf64cbe-db0e-11ef-8080-a0d3651f611f"},{"place_name":"汲縣","place_name_jianti_auto":"汲县","start_index":78,"tongjian_id":"caf64cbf-db0e-11ef-9310-a0d3651f611f"},{"place_name":"汲縣","place_name_jianti_auto":"汲县","start_index":81,"tongjian_id":"caf64cc0-db0e-11ef-8c8b-a0d3651f611f"},{"place_name":"淇門鎭","place_name_jianti_auto":"淇门镇","start_index":85,"tongjian_id":"caf64cc1-db0e-11ef-b11d-a0d3651f611f"},{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":89,"tongjian_id":"caf64cc2-db0e-11ef-8b1d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"共城、新鄕二縣皆屬衞州。舊唐書·地理志曰：隋割汲、獲嘉二縣地，於古新樂城置新鄕縣。共城縣，漢共縣也，唐爲共城縣。九域志：衞州治汲縣。熙寧六年廢新鄕縣爲鎭，屬汲縣。汲縣又有淇門鎭。共城在州西北五十五里。共，音恭。","note_content_jianti_auto":"共城、新鄕二县皆属衞州。旧唐书·地理志曰：隋割汲、获嘉二县地，于古新乐城置新鄕县。共城县，汉共县也，唐为共城县。九域志：衞州治汲县。熙宁六年废新鄕县为镇，属汲县。汲县又有淇门镇。共城在州西北五十五里。共，音恭。","note_type":"hu_note","start_index":115,"tongjian_id":"caf64cae-db0e-11ef-976c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"澶州","place_name_jianti_auto":"澶州","start_index":4,"tongjian_id":"caf64cc6-db0e-11ef-b25d-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":8,"tongjian_id":"caf64cc7-db0e-11ef-ac5c-a0d3651f611f"},{"place_name":"相州","place_name_jianti_auto":"相州","place_note":"河南安阳","start_index":16,"tongjian_id":"caf64cc8-db0e-11ef-bd32-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":20,"tongjian_id":"caf64cc9-db0e-11ef-a61f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：澶州西至衞州二百四十里。相州南至衞州一百五十里。","note_content_jianti_auto":"九域志：澶州西至衞州二百四十里。相州南至衞州一百五十里。","note_type":"hu_note","start_index":132,"tongjian_id":"caf64cc5-db0e-11ef-b9ea-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","resolved_place_entity_id":4282,"start_index":109,"tongjian_id":"caf64cda-db0e-11ef-aa68-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、卫辉府（卷四十九）","excerpts":[{"context_after":"《九域志》汲县有淇门镇。元人运道，自封丘中栾镇，陆运至淇...","context_before":"...分遣其将丁会等渡河，取黎阳、临河，庞师古等下淇门、卫县。","source_end_index":88,"source_paragraph_tongjian_id":"eed7af9f-56c5-522d-b77d-0df3ed91ad4e","source_start_index":50,"source_text":"五代梁龙德二年，与晋军夹河相持，戴思远袭陷卫州，又攻陷淇门及共城、新乡等县。"}],"path":"河南方舆纪要/四、卫辉府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"11晉衞州刺史李存儒，本姓楊，名婆兒，以俳優得幸於晉王。頗有膂力，晉王賜姓名，以爲刺史；專事掊斂，防城卒皆徵月課縱歸。八月，莊宅使段凝與步軍都指揮使張朗引兵夜渡河襲之，詰旦登城，執存儒，遂克衞州。戴思遠又與凝攻陷淇門、共城、新鄕，於是澶州之西，相州之南，皆爲梁有；晉人失軍儲三之一，梁軍復振。帝以張朗爲衞州刺史。朗，徐州人也。","content_fanyi":"晋国卫州刺史李存儒，原本姓杨，名婆儿，因为会演戏而得到晋王的宠爱。他很有力气，晋王赐给他姓名，任命他为刺史；他专门搜刮民财，守城的士兵只要缴纳月课钱，他就一律放他们回家。八月，后梁庄宅使段凝与步军都指挥使张朗率兵趁夜渡过黄河偷袭他，天亮时登上城墙并攻入城中，活捉了李存儒，于是攻克卫州。戴思远又和段凝一道攻陷淇门、共城、新乡，于是澶州以西、相州以南的地区又都归后梁所有；为此，晋军失去了三分之一的军用储备，梁军的声势又重新振作起来。后梁末帝任命张朗为卫州刺史。张朗是徐州人。","content_jianti_auto":"11晋衞州刺史李存儒，本姓杨，名婆儿，以俳优得幸于晋王。颇有膂力，晋王赐姓名，以为刺史；专事掊敛，防城卒皆征月课纵归。八月，庄宅使段凝与步军都指挥使张朗引兵夜渡河袭之，诘旦登城，执存儒，遂克衞州。戴思远又与凝攻陷淇门、共城、新鄕，于是澶州之西，相州之南，皆为梁有；晋人失军储三之一，梁军复振。帝以张朗为衞州刺史。朗，徐州人也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28213,"number":11,"path":"资治通鉴 : 卷第二百七十一 (後梁紀六) / 均王下 / 二年 / 第 16 段","reading_annotation_sources":[],"start_index":15,"tongjian_id":"caf64caa-db0e-11ef-acd9-a0d3651f611f","year_int":922},"tongjian_id":"caf64caa-db0e-11ef-acd9-a0d3651f611f"},"paragraph_order":2}],"page_size":10,"total_pages":1,"total_paragraphs":2},"place_name":"共城"},"message":"success","success":true}