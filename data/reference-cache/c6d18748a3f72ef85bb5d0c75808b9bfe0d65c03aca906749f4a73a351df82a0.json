{"data":{"current_mention_tongjian_id":"8c611dbc-db0e-11ef-ab8c-a0d3651f611f","current_paragraph_tongjian_id":"8c5eb45e-db0e-11ef-b22e-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蘇秦","people_name_jianti_auto":"苏秦","start_index":3,"tongjian_id":"8c5eb460-db0e-11ef-90ab-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":7,"tongjian_id":"8c5eb461-db0e-11ef-9fdc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"三年，蘇秦死於齊。","note_content_jianti_auto":"三年，苏秦死于齐。","note_type":"hu_note","start_index":6,"tongjian_id":"8c5eb45f-db0e-11ef-b7cc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉伯莊","people_name_jianti_auto":"刘伯庄","start_index":0,"tongjian_id":"8c5eb466-db0e-11ef-a76a-a0d3651f611f"},{"people_name":"鹿毛壽","people_name_jianti_auto":"鹿毛寿","start_index":5,"tongjian_id":"8c5eb467-db0e-11ef-9156-a0d3651f611f"},{"people_name":"潘壽","people_name_jianti_auto":"潘寿","start_index":15,"tongjian_id":"8c5eb468-db0e-11ef-8a3e-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":29,"tongjian_id":"8c5eb469-db0e-11ef-aa07-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":41,"tongjian_id":"8c5eb46a-db0e-11ef-9bb9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"清河","place_name_jianti_auto":"清河","start_index":61,"tongjian_id":"8c5eb46b-db0e-11ef-986b-a0d3651f611f"},{"place_name":"厝縣","place_name_jianti_auto":"厝县","start_index":64,"tongjian_id":"8c5eb46c-db0e-11ef-8de6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"劉伯莊曰：鹿毛壽，人姓名；又曰潘壽。春秋後語作「唐毛壽」。徐廣曰：一作「厝毛」。如徐廣一作之說，當作「厝」。厝，音秦昔翻。清河有厝縣。","note_content_jianti_auto":"刘伯庄曰：鹿毛寿，人姓名；又曰潘寿。春秋后语作「唐毛寿」。徐广曰：一作「厝毛」。如徐广一作之说，当作「厝」。厝，音秦昔翻。清河有厝县。","note_type":"hu_note","start_index":99,"tongjian_id":"8c5eb465-db0e-11ef-9cf2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"禹","people_name_jianti_auto":"禹","start_index":4,"tongjian_id":"8c610a0e-db0e-11ef-b5f4-a0d3651f611f"},{"people_name":"益","people_name_jianti_auto":"益","start_index":6,"tongjian_id":"8c610a0f-db0e-11ef-a332-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":10,"tongjian_id":"8c610a10-db0e-11ef-b17d-a0d3651f611f"},{"people_name":"益","people_name_jianti_auto":"益","start_index":19,"tongjian_id":"8c610a11-db0e-11ef-bdfa-a0d3651f611f"},{"people_name":"啓","people_name_jianti_auto":"启","start_index":22,"tongjian_id":"8c610a12-db0e-11ef-8724-a0d3651f611f"},{"people_name":"啓","people_name_jianti_auto":"启","start_index":46,"tongjian_id":"8c610a13-db0e-11ef-8ed1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟子曰：禹薦益於天，禹崩，天下之人不之益而之啓，曰：「吾君之子也。」索隱曰：人，猶臣也。謂以啓臣爲益吏。索，山客翻。","note_content_jianti_auto":"孟子曰：禹荐益于天，禹崩，天下之人不之益而之启，曰：「吾君之子也。」索隐曰：人，犹臣也。谓以启臣为益吏。索，山客翻。","note_type":"hu_note","start_index":160,"tongjian_id":"8c61034f-db0e-11ef-8f88-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"伊尹","people_name_jianti_auto":"伊尹","start_index":11,"tongjian_id":"8c610a18-db0e-11ef-8a50-a0d3651f611f"},{"people_name":"太甲","people_name_jianti_auto":"太甲","start_index":14,"tongjian_id":"8c610a19-db0e-11ef-bb74-a0d3651f611f"},{"people_name":"伊尹","people_name_jianti_auto":"伊尹","start_index":23,"tongjian_id":"8c610a1a-db0e-11ef-bba7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"桐","place_name_jianti_auto":"桐","start_index":20,"tongjian_id":"8c610a1b-db0e-11ef-a8a1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按或曰一段事，與師春紀伊尹放太甲，潛出自桐，殺伊尹，事頗相類，古書雜記固多也。","note_content_jianti_auto":"按或曰一段事，与师春纪伊尹放太甲，潜出自桐，杀伊尹，事颇相类，古书杂记固多也。","note_type":"hu_note","start_index":205,"tongjian_id":"8c610a17-db0e-11ef-9e36-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"三王","people_name_jianti_auto":"三王","start_index":9,"tongjian_id":"8c610a1e-db0e-11ef-a447-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":39,"tongjian_id":"8c610a1f-db0e-11ef-9d92-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":64,"tongjian_id":"8c610a20-db0e-11ef-983c-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":66,"tongjian_id":"8c610a21-db0e-11ef-8011-a0d3651f611f"},{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":164,"tongjian_id":"8c610a22-db0e-11ef-81d1-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":182,"tongjian_id":"8c610a23-db0e-11ef-9c97-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢書·輿服志曰：三王俗化雕文，詐僞漸生，始有印綬，以檢姦萌。周禮掌節有璽節，鄭氏註云：今之印章也。綬，組綬。古者佩玉以綬貫之。漢承秦制，乘輿璽綬；諸王以下，印以金、銀、銅爲差，綬以赤、紫、青、黑、黃爲差。印，信也，刻文合信也。綬，受也，轉相授受也。三百石吏，銅印，黑綬或黃綬。王制：諸侯大國之卿，食祿以田計之，爲三十二夫之入。戰國之卿，食祿萬鍾，其僭差不度甚矣。漢制：三公秩萬石，至於斗食佐吏，凡十六等。三百石吏，第十等，奉月四十斛。綬，音受。璽，斯氏翻。組，祖五翻。乘，繩證翻。奉，與俸同，音扶用翻。","note_content_jianti_auto":"后汉书·舆服志曰：三王俗化雕文，诈伪渐生，始有印绶，以检奸萌。周礼掌节有玺节，郑氏注云：今之印章也。绶，组绶。古者佩玉以绶贯之。汉承秦制，乘舆玺绶；诸王以下，印以金、银、铜为差，绶以赤、紫、青、黑、黄为差。印，信也，刻文合信也。绶，受也，转相授受也。三百石吏，铜印，黑绶或黄绶。王制：诸侯大国之卿，食禄以田计之，为三十二夫之入。战国之卿，食禄万锺，其僭差不度甚矣。汉制：三公秩万石，至于斗食佐吏，凡十六等。三百石吏，第十等，奉月四十斛。绶，音受。玺，斯氏翻。组，祖五翻。乘，绳证翻。奉，与俸同，音扶用翻。","note_type":"hu_note","start_index":255,"tongjian_id":"8c610a1d-db0e-11ef-94f1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"顧，反也。噲，苦夬翻。","note_content_jianti_auto":"顾，反也。哙，苦夬翻。","note_type":"hu_note","start_index":275,"tongjian_id":"8c610a28-db0e-11ef-bb15-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":6,"source_start_index":0,"source_text":"爲後燕亂張本","target_paragraph_tongjian_id":"8c627621-db0e-11ef-9905-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":2,"tongjian_id":"8c611db9-db0e-11ef-8572-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲後燕亂張本。","note_content_jianti_auto":"为后燕乱张本。","note_type":"hu_note","start_index":283,"tongjian_id":"8c610a29-db0e-11ef-afcb-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"燕相","official_note":"燕相是燕国的宰相，负责辅佐君主处理国政。在上下文中，子之担任燕相，并试图通过联姻和游说获取更多权力，最终导致燕王让位，子之实际掌权。","official_rank":"未知","source_snippet":"燕相子之與蘇代婚","start_index":24,"tongjian_id":"5b11e882-b77b-4532-80d2-0775319a26b3"},{"confidence":0.8,"official_category":"地方行政","official_name":"吏","official_note":"吏泛指官员或官吏，负责执行行政事务。在上下文中，禹任命启的人为吏，以辅助益，但后来启夺权，反映了权力斗争。","official_rank":"未知","source_snippet":"以啓人爲吏","start_index":156,"tongjian_id":"bc3c03d1-72b7-44e7-94a4-521e7f1f29ba"},{"confidence":0.85,"official_category":"地方行政","official_name":"三百石吏","official_note":"三百石吏指俸禄为三百石的官员，属于低级官吏。在上下文中，燕王将这类官员的印绶交给子之，象征子之获得行政控制权。","official_rank":"低级官员","source_snippet":"自三百石吏已上而效之子之","start_index":228,"tongjian_id":"029b45f0-27da-4d16-94d7-efaa7ed67b57"}],"ExtRef_Children_people":[{"link_td_description":"苏厉，中国战国时代的纵横家，洛阳人，大兄长是苏秦、二兄长苏代。","link_td_id":"Q10012729","link_td_number_id":1501112,"people_name":"厲","people_name_jianti_auto":"厉","people_xingming":"苏厉","start_index":10,"tongjian_id":"8c611dbc-db0e-11ef-ab8c-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2蘇秦旣死，秦弟代、厲亦以遊說顯於諸侯。燕相子之與蘇代婚，欲得燕權。蘇代使於齊而還，燕王噲問曰：「齊王其霸乎？」對曰：「不能。」王曰：「何故？」對曰：「不信其臣。」於是燕王專任子之。鹿毛壽謂燕王曰：「人之謂堯賢者，以其能讓天下也。今王以國讓子之，是王與堯同名也。」燕王因屬國於子之，子之大重。或曰：「禹薦益而以啓人爲吏，及老而以啓爲不足任天下，傳之於益。啓與交黨攻益，奪之，天下謂禹名傳天下於益而實令啓自取之。今王言屬國於子之而吏無非太子人者，是名屬子之而實太子用事也。」王因收印綬，自三百石吏已上而效之子之。子之南面行王事，而噲老，不聽政，顧爲臣，國事皆決於子之。","content_fanyi":"苏秦死后，他的弟弟苏代、苏厉也以游说诸侯而扬名。燕国国相子之与苏代结为姻亲，想夺取燕国政权。苏代出使齐国回到燕国，燕王哙问他：“齐王能称霸吗？”苏代回答：“不能。”燕王问：“为什么？”回答说：“他不信任自己的臣下。”于是燕王哙一心信任子之。鹿毛寿对燕王说：“人们之所以说尧贤明，是因为他能禅让天下。如今大王把国家让给子之，就与尧有同样的名声了。”燕王哙于是把国家托付给子之，子之的权势十分显赫。有人说：“夏禹推举伯益为继承人，又用自己儿子启的臣属担任官吏，等到年老时认为启不足以承担天下重任，就把王位传给了伯益。启与他的党羽攻打伯益，夺取了王位，天下人都说禹名义上把天下传给伯益，而实际上是让启自己夺取了天下。如今大王说把国家交给子之，可是官吏中没有不是太子的人，这是名义上把国家交给子之，而实际上是太子在掌权。”燕王于是收回印绶，把三百石以上官吏的印绶都交给子之，由他选任。子之面向南而坐，行使君王权力，而燕王哙年老，不再听政，反而居于臣位，国家大事都由子之决断。","content_jianti_auto":"2苏秦既死，秦弟代、厉亦以游说显于诸侯。燕相子之与苏代婚，欲得燕权。苏代使于齐而还，燕王哙问曰：「齐王其霸乎？」对曰：「不能。」王曰：「何故？」对曰：「不信其臣。」于是燕王专任子之。鹿毛寿谓燕王曰：「人之谓尧贤者，以其能让天下也。今王以国让子之，是王与尧同名也。」燕王因属国于子之，子之大重。或曰：「禹荐益而以启人为吏，及老而以启为不足任天下，传之于益。启与交党攻益，夺之，天下谓禹名传天下于益而实令启自取之。今王言属国于子之而吏无非太子人者，是名属子之而实太子用事也。」王因收印绶，自三百石吏已上而效之子之。子之南面行王事，而哙老，不听政，顾为臣，国事皆决于子之。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，而敢言尧、舜乎？","context_before":"...俄而将相矣，俄而天子矣，争夺者攘臂而仍之，不能一朝居也，","source_end_index":261,"source_paragraph_tongjian_id":"98b1badc-00a1-47af-b07f-66d562951501","source_start_index":254,"source_text":"徒为子哙、子之"}],"title":"一四 郭氏立异姓为嗣"}],"id":234,"number":2,"path":"资治通鉴 : 卷第三 (周紀三) / 愼靚王 / 五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c5eb45e-db0e-11ef-b22e-a0d3651f611f","year_int":-316},"tongjian_id":"8c5eb45e-db0e-11ef-b22e-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"周","people_name_jianti_auto":"周","start_index":4,"tongjian_id":"8c73a122-db0e-11ef-82d1-a0d3651f611f"},{"people_name":"周平王","people_name_jianti_auto":"周平王","start_index":8,"tongjian_id":"8c73a123-db0e-11ef-b211-a0d3651f611f"},{"people_name":"周","people_name_jianti_auto":"周","start_index":21,"tongjian_id":"8c73a124-db0e-11ef-8a34-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":32,"tongjian_id":"8c73a125-db0e-11ef-bf3a-a0d3651f611f"},{"people_name":"周家","people_name_jianti_auto":"周家","start_index":48,"tongjian_id":"8c73a126-db0e-11ef-aa9c-a0d3651f611f"},{"people_name":"周任","people_name_jianti_auto":"周任","start_index":61,"tongjian_id":"8c73a127-db0e-11ef-ac34-a0d3651f611f"},{"people_name":"周","people_name_jianti_auto":"周","start_index":66,"tongjian_id":"8c73a128-db0e-11ef-af29-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":78,"tongjian_id":"8c73a129-db0e-11ef-bc94-a0d3651f611f"},{"people_name":"周最","people_name_jianti_auto":"周最","start_index":88,"tongjian_id":"8c73a12a-db0e-11ef-9721-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":92,"tongjian_id":"8c73a12b-db0e-11ef-ada5-a0d3651f611f"},{"people_name":"樓","people_name_jianti_auto":"楼","start_index":95,"tongjian_id":"8c73a12c-db0e-11ef-baaf-a0d3651f611f"},{"people_name":"少康","people_name_jianti_auto":"少康","start_index":99,"tongjian_id":"8c73a12d-db0e-11ef-a0d8-a0d3651f611f"},{"people_name":"東樓公","people_name_jianti_auto":"东楼公","start_index":107,"tongjian_id":"8c73a12e-db0e-11ef-861e-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":117,"tongjian_id":"8c73a12f-db0e-11ef-ab7b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汝川","place_name_jianti_auto":"汝川","start_index":15,"tongjian_id":"8c73a130-db0e-11ef-b0c6-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":35,"tongjian_id":"8c73a131-db0e-11ef-9f95-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":57,"tongjian_id":"8c73a132-db0e-11ef-b7c5-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":98,"tongjian_id":"8c73a133-db0e-11ef-bab7-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":104,"tongjian_id":"8c73a134-db0e-11ef-a1af-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜曰：周姓本自周平王子，別封汝川，人謂之周家，因氏焉。一云：以赧王爲秦所滅，黜爲庶人，百姓稱爲周家，因氏焉。余按商有太史周任，謂爲周姓所自出，夫豈不可！又赧王於時未滅，不可謂周最出於赧王。樓姓，夏少康之裔，周封爲東樓公，子孫因氏焉。師古曰：紛紜，興作貌，又物多而亂貌。勝，音升。赧，奴版翻。夏，戶雅翻。少，始照翻。裔，苗裔。","note_content_jianti_auto":"姓谱曰：周姓本自周平王子，别封汝川，人谓之周家，因氏焉。一云：以赧王为秦所灭，黜为庶人，百姓称为周家，因氏焉。余按商有太史周任，谓为周姓所自出，夫岂不可！又赧王于时未灭，不可谓周最出于赧王。楼姓，夏少康之裔，周封为东楼公，子孙因氏焉。师古曰：纷纭，兴作貌，又物多而乱貌。胜，音升。赧，奴版翻。夏，户雅翻。少，始照翻。裔，苗裔。","note_type":"hu_note","start_index":82,"tongjian_id":"8c73a121-db0e-11ef-8026-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"著者，顯著於時。","note_content_jianti_auto":"著者，显著于时。","note_type":"hu_note","start_index":91,"tongjian_id":"8c73a136-db0e-11ef-890d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"苏厉，中国战国时代的纵横家，洛阳人，大兄长是苏秦、二兄长苏代。","link_td_id":"Q10012729","link_td_number_id":1501112,"people_name":"蘇厲","people_name_jianti_auto":"苏厉","people_xingming":"苏厉","start_index":52,"tongjian_id":"8c73a13d-db0e-11ef-a2c0-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"儀與蘇秦皆以縱橫之術遊諸侯，致位富貴，天下爭慕效之。又有魏人公孫衍者，號曰犀首，亦以談說顯名。其餘蘇代、蘇厲、周最、樓緩之徒，紛紜徧於天下，務以辯詐相高，不可勝紀，而儀、秦、衍最著。","content_fanyi":"张仪与苏秦都凭借合纵连横的谋略游说诸侯各国，取得了富贵的地位，天下人争相仰慕效法。又有魏国人公孙衍，号犀首，也以游说而扬名。其余如苏代、苏厉、周最、楼缓之辈，纷纭而起，遍布天下，致力于用论辩诡诈争相较量高下，多得无法一一记述，而张仪、苏秦、公孙衍最为著名。","content_jianti_auto":"仪与苏秦皆以纵横之术游诸侯，致位富贵，天下争慕效之。又有魏人公孙衍者，号曰犀首，亦以谈说显名。其余苏代、苏厉、周最、楼缓之徒，纷纭徧于天下，务以辩诈相高，不可胜纪，而仪、秦、衍最著。","dtjl_paragraph_links":[],"dtjl_references":[],"id":257,"path":"资治通鉴 : 卷第三 (周紀三) / 赧王上 / 五年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c73a11e-db0e-11ef-9d63-a0d3651f611f","year_int":-310},"tongjian_id":"8c73a11e-db0e-11ef-9d63-a0d3651f611f"},"paragraph_order":2}],"page_size":7,"total_pages":1,"total_paragraphs":2},"profile":{"alias_list":[],"biography":"苏厉，中国战国时代的纵横家，洛阳人，大兄长是苏秦、二兄长苏代。","link_td_id":"Q10012729","name":"苏厉","number_id":1501112},"relationships":[{"direction":"reverse","rank":"normal","relation_detail":"苏代是苏厉的兄长，来源文本：是苏秦的弟弟、苏厉之兄。","relation_property_display_template":"{subject}的兄弟姐妹是{value}","relation_property_id":"P100028","relation_property_label":"兄弟姐妹","source_person_id":"Q10012478","source_person_name":"苏代","source_person_number_id":1482900,"statement_id":"S-Q10012478-P100028-Q10012729","target_person_id":"Q10012729","target_person_name":"苏厉","target_person_number_id":1501112},{"direction":"forward","rank":"normal","relation_detail":"大兄长，来源文本：大兄长是蘇秦","relation_property_display_template":"{subject}的兄弟姐妹是{value}","relation_property_id":"P100028","relation_property_label":"兄弟姐妹","source_person_id":"Q10012729","source_person_name":"苏厉","source_person_number_id":1501112,"statement_id":"S-Q10012729-P100028-Q10001054","target_person_id":"Q10001054","target_person_name":"苏秦","target_person_number_id":133739},{"direction":"forward","rank":"normal","relation_detail":"二兄长，来源文本：二兄長蘇代","relation_property_display_template":"{subje