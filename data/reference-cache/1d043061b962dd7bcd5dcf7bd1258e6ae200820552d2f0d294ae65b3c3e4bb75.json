ace_name_jianti_auto":"开封县","start_index":28,"tongjian_id":"8c304386-db0e-11ef-bfa3-a0d3651f611f"},{"place_name":"逢澤","place_name_jianti_auto":"逢泽","place_note":"河南洛陽西","start_index":44,"tongjian_id":"8c304387-db0e-11ef-9a06-a0d3651f611f"},{"place_name":"汴州","place_name_jianti_auto":"汴州","start_index":47,"tongjian_id":"8c304388-db0e-11ef-a0e7-a0d3651f611f"},{"place_name":"浚儀縣","place_name_jianti_auto":"浚仪县","start_index":49,"tongjian_id":"8c304389-db0e-11ef-9c65-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：逢澤有介麋焉，宋地也。杜預註曰：地理志言逢澤在滎陽開封縣東北；遠，疑非。括地志曰：逢澤在汴州浚儀縣東南二十四里。帥，音率。","note_content_jianti_auto":"左传：逢泽有介麋焉，宋地也。杜预注曰：地理志言逢泽在荥阳开封县东北；远，疑非。括地志曰：逢泽在汴州浚仪县东南二十四里。帅，音率。","note_type":"hu_note","start_index":33,"tongjian_id":"8c3027e3-db0e-11ef-811e-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"君主","official_name":"王","official_note":"在《资治通鉴》中，'王'通常指周天子或诸侯国君主，此处根据上下文'王致伯于秦'和'以朝王'，应指周显王，是周朝的最高统治者，负责册封诸侯和接受朝见。","official_rank":"最高统治者","source_snippet":"王致伯于秦","start_index":0,"tongjian_id":"5c10e97e-759d-49e0-90b3-b36753c2e117"},{"confidence":0.85,"official_category":"君主","official_name":"秦孝公","official_note":"秦孝公是秦国君主，在战国时期，诸侯国君主拥有军事和外交权力，此处他派遣公子少官率军会合诸侯朝见周王，体现了其作为秦国统治者的职能。","official_rank":"诸侯国君主","source_snippet":"秦孝公使公子少官帥師會諸侯于逢澤以朝王","start_index":12,"tongjian_id":"792a8bbb-9734-46d7-b3b9-b1be5a884dd3"},{"confidence":0.8,"official_category":"军事指挥","official_name":"公子少官","official_note":"公子少官是秦国公子，可能担任军事将领职务，此处'帥師'表示他率领军队，负责执行秦孝公的命令，会合诸侯朝见周王，在上下文中起到军事指挥的作用。","official_rank":"未知","source_snippet":"秦孝公使公子少官帥師會諸侯于逢澤以朝王","start_index":15,"tongjian_id":"a7919972-d58b-4b00-9239-9393747e9e15"}],"ExtRef_Children_people":[{"link_birth_year":-382,"link_death_year":-338,"link_td_description":"秦孝公，战国时期秦国君主，秦献公之子，前362年－前338年在位，在位共25年。","link_td_id":"Q10001805","link_td_number_id":139181,"people_name":"秦孝公","people_name_jianti_auto":"秦孝公","people_xingming":"嬴渠梁","start_index":13,"tongjia