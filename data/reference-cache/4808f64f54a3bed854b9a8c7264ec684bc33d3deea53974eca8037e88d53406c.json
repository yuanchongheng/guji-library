{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（甲戌、前二二七）","note_content_jianti_auto":"（甲戌、前二二七）","note_type":"hu_note","start_index":0,"tongjian_id":"8d604123-db0e-11ef-bed6-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":0,"tongjian_id":"8d604126-db0e-11ef-9dbf-a0d3651f611f"},{"people_name":"劉","people_name_jianti_auto":"刘","start_index":40,"tongjian_id":"8d604127-db0e-11ef-a498-a0d3651f611f"},{"people_name":"劉原父","people_name_jianti_auto":"刘原父","start_index":65,"tongjian_id":"8d604128-db0e-11ef-b9f9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：九賓，周禮九儀也，謂公、侯、伯、子、男、孤、卿、大夫、士也。史記正義曰：劉云：設文物大備，卽謂九賓，不得以周禮九賓義爲釋。劉原父曰：賓，謂傳擯之擯。九賓，擯者九人。","note_content_jianti_auto":"韦昭曰：九宾，周礼九仪也，谓公、侯、伯、子、男、孤、卿、大夫、士也。史记正义曰：刘云：设文物大备，即谓九宾，不得以周礼九宾义为释。刘原父曰：宾，谓传摈之摈。九宾，摈者九人。","note_type":"hu_note","start_index":33,"tongjian_id":"8d604125-db0e-11ef-8014-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"愕，五各翻。卒，讀曰猝；後倉卒之卒皆同音。","note_content_jianti_auto":"愕，五各翻。卒，读曰猝；后仓卒之卒皆同音。","note_type":"hu_note","start_index":89,"tongjian_id":"8d60412e-db0e-11ef-a1a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：擿，與擲同，古字耳，音持益翻。中，竹仲翻。","note_content_jianti_auto":"索隐曰：擿，与掷同，古字耳，音持益翻。中，竹仲翻。","note_type":"hu_note","start_index":160,"tongjian_id":"8d604131-db0e-11ef-9ca6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"體解，支解也。解，佳買翻。","note_content_jianti_auto":"体解，支解也。解，佳买翻。","note_type":"hu_note","start_index":202,"tongjian_id":"8d604133-db0e-11ef-bc37-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":1,"tongjian_id":"8d604134-db0e-11ef-a6f4-a0d3651f611f"},{"people_name":"蒙嘉","people_name_jianti_auto":"蒙嘉","people_xingming":"蒙嘉","start_index":11,"tongjian_id":"8d604135-db0e-11ef-b7da-a0d3651f611f"},{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":33,"tongjian_id":"8d604137-db0e-11ef-b4a9-a0d3651f611f"},{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":68,"tongjian_id":"8d604138-db0e-11ef-bdb7-a0d3651f611f"},{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":137,"tongjian_id":"8d60413a-db0e-11ef-af50-a0d3651f611f"},{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":145,"tongjian_id":"8d60413b-db0e-11ef-a1df-a0d3651f611f"},{"link_death_year":-227,"link_td_description":"荆轲，战国末期卫国人，著名刺客。也称庆卿、荆卿、庆轲。受燕太子丹之托入刺秦王政，失败被杀。","link_td_id":"Q10000093","link_td_number_id":5854,"people_name":"荊軻","people_name_jianti_auto":"荆轲","people_xingming":"荆轲","start_index":197,"tongjian_id":"8d60413c-db0e-11ef-948e-a0d3651f611f"},{"link_td_description":"王翦，战国时期秦国名将，关中频阳东乡（今陕西富平东北）人，主要战绩：破赵国都城邯郸，消灭燕和赵；以秦国绝大部分兵力消灭楚国后，接着率领平楚大军南下平定百越。王翦与白起、廉颇、李牧并称战国四大名将。其曾孙是琅琊王氏和太原王氏的始祖。","link_td_id":"Q10008023","link_td_number_id":29919,"people_name":"王翦","people_name_jianti_auto":"王翦","people_xingming":"王翦","start_index":215,"tongjian_id":"8d60413d-db0e-11ef-8356-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d604124-db0e-11ef-a334-a0d3651f611f","pinyin":"zhèn","source_anchor_text":"把王袖而揕之未至身","source_key":"baiyang_epub","start_index":54,"text":"揕","tongjian_id":"21486daf-f9e1-557c-8748-3aab7c594f34"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8d604124-db0e-11ef-a334-a0d3651f611f","pinyin":"zhì","source_anchor_text":"乃引匕首擿王中銅柱","source_key":"baiyang_epub","start_index":153,"text":"擿","tongjian_id":"394d53be-dd47-5de0-8b4e-8bfb122940c8"}],"ExtRef_Children_places":[{"place_name":"咸陽","place_name_jianti_auto":"咸阳","place_note":"陕西咸阳","resolved_place_entity_id":382,"start_index":4,"tongjian_id":"8d604136-db0e-11ef-a415-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":95,"tongjian_id":"8d604139-db0e-11ef-9830-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":212,"tongjian_id":"8d60413e-db0e-11ef-a5f3-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":219,"tongjian_id":"8d60413f-db0e-11ef-87c4-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":69,"start_index":222,"tongjian_id":"8d604140-db0e-11ef-9cc9-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","resolved_place_entity_id":238,"start_index":225,"tongjian_id":"8d604141-db0e-11ef-93dd-a0d3651f611f"},{"place_name":"易水","place_name_jianti_auto":"易水","place_note":"海河支流，流经河北易县南","resolved_place_entity_id":1919,"start_index":229,"tongjian_id":"8d604142-db0e-11ef-92df-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭燕之战","tongjian_id":"war_N0547"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1荊軻至咸陽，因王寵臣蒙嘉卑辭以求見；王大喜，朝服，設九賓而見之。荊軻奉圖而進於王，圖窮而匕首見，因把王袖而揕之；未至身，王驚起，袖絕。荊軻逐王，王環柱而走。羣臣皆愕，卒起不意，盡失其度。而秦法，羣臣侍殿上者不得操尺寸之兵，左右以手共搏之，且曰：「王負劍！」負劍，王遂拔以擊荊軻，斷其左股。荊軻廢，乃引匕首擿王，中銅柱。自知事不就，罵曰：「事所以不成者，以欲生劫之，必得約契以報太子也！」遂體解荊軻以徇。王於是大怒，益發兵詣趙，就王翦以伐燕，與燕師、代師戰於易水之西，大破之。","content_fanyi":"荆轲到达秦国都城咸阳，通过秦王政的宠臣蒙嘉，以谦卑言辞请求谒见秦王政；秦王政非常高兴，穿上朝会礼服，安排了九宾大礼接见他。荆轲捧着地图进献给秦王政，图卷完全展开时，匕首露了出来，他乘势抓住秦王政的袍袖，举起匕首刺向他的胸膛；匕首尚未刺到身上，秦王政已惊恐地一跃而起，袍袖被挣断。荆轲追逐秦王政，秦王政绕着柱子奔跑。群臣都惊愕不已，因为事发仓促、出乎意料，全都失去了常态。按照秦国法律，在殿上侍从的群臣不得携带任何兵器，于是左右侍臣徒手一起上前扑打荆轲，并喊道：“大王，把剑推到背上！”秦王政把剑推到背上，使剑套倾斜、剑柄向前，随即拔出剑来攻击荆轲，砍断了他的左大腿。荆轲肢体残废，无法再追，于是举起匕首向秦王政掷去，击中了铜柱。荆轲知道行刺之事已无法成功，大骂道：“事情之所以不能成功，是因为我想活捉你，强迫你订立契约，归还所兼并的土地，用来回报燕太子啊！”于是荆轲被分尸示众。秦王政为此勃然大怒，增派军队前往赵国，会合王翦的军队攻打燕国，与燕军、代王的军队在易水以西交战，大破燕、代军队。","content_jianti_auto":"1荆轲至咸阳，因王宠臣蒙嘉卑辞以求见；王大喜，朝服，设九宾而见之。荆轲奉图而进于王，图穷而匕首见，因把王袖而揕之；未至身，王惊起，袖绝。荆轲逐王，王环柱而走。群臣皆愕，卒起不意，尽失其度。而秦法，群臣侍殿上者不得操尺寸之兵，左右以手共搏之，且曰：「王负剑！」负剑，王遂拔以击荆轲，断其左股。荆轲废，乃引匕首擿王，中铜柱。自知事不就，骂曰：「事所以不成者，以欲生劫之，必得约契以报太子也！」遂体解荆轲以徇。王于是大怒，益发兵诣赵，就王翦以伐燕，与燕师、代师战于易水之西，大破之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":530,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d604124-db0e-11ef-a334-a0d3651f611f"}],"reign_name":"二十年","reign_name_jianti_auto":"二十年","start_index":0,"tongjian_id":"8d604122-db0e-11ef-9906-a0d3651f611f","year_anno":"（甲戌、前二二七）","year_int":-227},"message":"success","success":true}