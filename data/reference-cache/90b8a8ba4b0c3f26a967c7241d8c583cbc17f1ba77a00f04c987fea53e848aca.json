1b95-db0e-11ef-8518-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":7,"tongjian_id":"8c0b1b97-db0e-11ef-8f10-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"阿","place_name_jianti_auto":"阿","start_index":0,"tongjian_id":"8c0b1b98-db0e-11ef-8554-a0d3651f611f"},{"place_name":"東阿縣","place_name_jianti_auto":"东阿县","start_index":3,"tongjian_id":"8c0b1b99-db0e-11ef-9fa4-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":10,"tongjian_id":"8c0b1b9a-db0e-11ef-8093-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"阿，卽東阿縣；班志屬東郡。譽，音余，稱其美也。","note_content_jianti_auto":"阿，即东阿县；班志属东郡。誉，音余，称其美也。","note_type":"hu_note","start_index":91,"tongjian_id":"8c0b1b96-db0e-11ef-97d1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":11,"tongjian_id":"8c0b1b9e-db0e-11ef-b616-a0d3651f611f"},{"people_name":"田嬰","people_name_jianti_auto":"田婴","start_index":48,"tongjian_id":"8c0b1b9f-db0e-11ef-bba9-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"薛陵","place_name_jianti_auto":"薛陵","place_note":"山東陽谷東北","start_index":0,"tongjian_id":"8c0b1ba0-db0e-11ef-b11e-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":3,"tongjian_id":"8c0b1ba1-db0e-11ef-9600-a0d3651f611f"},{"place_name":"薛國","place_name_jianti_auto":"薛国","start_index":5,"tongjian_id":"8c0b1ba2-db0e-11ef-89fc-a0d3651f611f"},{"place_name":"薛縣","place_name_jianti_auto":"薛县","start_index":14,"tongjian_id":"8c0b1ba3-db0e-11ef-a989-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":17,"tongjian_id":"8c0b1ba4-db0e-11ef-85b1-a0d3651f611f"},{"place_name":"衞國","place_name_jianti_auto":"衞国","start_index":21,"tongjian_id":"8c0b1ba5-db0e-11ef-9d6d-a0d3651f611f"},{"place_name":"漢東郡","place_name_jianti_auto":"汉东郡","start_index":24,"tongjian_id":"8c0b1ba6-db0e-11ef-a445-a0d3651f611f"},{"place_name":"陳留","place_name_jianti_auto":"陈留","start_index":27,"tongjian_id":"8c0b1ba7-db0e-11ef-a13b-a0d3651f611f"},{"place_name":"薛陵","place_name_jianti_auto":"薛陵","place_note":"山東陽谷東北","start_index":31,"tongjian_id":"8c0b1ba8-db0e-11ef-b713-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":34,"tongjian_id":"8c0b1ba9-db0e-11ef-ae8e-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","start_index":38,"tongjian_id":"8c0b1baa-db0e-11ef-be25-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","place_note":"府临淄，山东淄博东临淄镇","start_index":45,"tongjian_id":"8c0b1bab-db0e-11ef-99ff-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"薛陵，春秋薛國之墟也。班志，薛縣屬魯國，而衞國在漢東郡陳留界。薛陵屬齊而近於衞，故爲所取。齊後封田嬰於此。","note_content_jianti_auto":"薛陵，春秋薛国之墟也。班志，薛县属鲁国，而衞国在汉东郡陈留界。薛陵属齐而近于衞，故为所取。齐后封田婴于此。","note_type":"hu_note","start_index":126,"tongjian_id":"8c0b1b9d-db0e-11ef-8f32-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"卽墨大夫","official_note":"即墨大夫是战国时期齐国的地方行政长官，负责治理即墨地区。在《资治通鉴》此段中，齐威王召见即墨大夫，赞扬其治理有方，不贿赂左右以求誉，体现了地方官员的职责和考核。","official_rank":"未知","source_snippet":"齊威王召卽墨大夫","start_index":4,"tongjian_id":"0b928a53-16e9-4a19-beb3-2d6d7a5dfe62"},{"confidence":0.9,"official_category":"地方行政","official_name":"阿大夫","official_note":"阿大夫是战国时期齐国的地方行政长官，负责治理阿地区。在《资治通鉴》此段中，齐威王召见阿大夫，批评其治理不善、贿赂左右以求誉，最终被烹杀，反映了地方官员的失职和惩罚。","official_rank":"未知","source_snippet":"召阿大夫","start_index":58,"tongjian_id":"12e8c3c9-917f-46ae-89e7-5fb898321a14"}],"ExtRef_Children_people":[{"link_birth_year":-378,"link_death_year":-320,"link_td_description":"齐威王，妫姓，田氏，名因齐，战国策作婴齐，出土文物作陈侯因齐，田齐君主，为田齐桓公之子。","link_td_id":"Q10002279","link_td_number_id":327054,"people_name":"齊威王","people_name_jianti_auto":"齐威王","people_xingming":"齐威王","start_index":1,"tongjian_id":"8c0b1bae-db0e-11ef-bfd7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"《世纪》：周显王十三年，燕、赵会于阿。秦时谓之东阿，二世...","context_before":"...顷公卒于柯。皆此地。后为柯邑。赵成侯九年，与齐战阿下。又","source_end_index":89,"source_paragraph_tongjian_id":"bb403b0a-f384-50e4-9106-4dee85247b9a","source_start_index":81,"source_text":"齐威王烹阿大夫。"},{"context_after":"盖其地与阿近]。","context_before":"薛陵城[在县西南。战国时齐邑。","source_end_index":54,"source_paragraph_tongjian_id":"dc92d408-6045-5d9a-8da8-d2df7e0c73d9","source_start_index":15,"source_text":"《史记·齐世家》：威王七年，卫伐我，取薛陵。又威王语阿大夫：卫取薛陵，子不知。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/六、莱州府（卷三十六）","excerpts":[{"context_after":"湣王时，乐毅破齐七十余城，惟莒、即墨未下。既而田单以即墨...","context_before":"...[州东南六十里。齐即墨邑。《志》云：城临墨水，故曰即墨。","source_end_index":47,"source_paragraph_tongjian_id":"3dd71f98-1e15-57b7-879f-b90f52586e43","source_start_index":32,"source_text":"齐威王封即墨大夫，而烹阿大夫。"}],"path":"山东方舆纪要/六、莱州府（卷三十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"4齊威王召卽墨大夫，語之曰：「自子之居卽墨也，毀言日至。然吾使人視卽墨，田野辟，人民給，官無事，東方以寧；是子不事吾左右以求助也！」封之萬家。召阿大夫，語之曰：「自子守阿，譽言日至。吾使人視阿，田野不辟，人民貧餒。昔日趙攻鄄，子不救；衞取薛陵，子不知；是子厚幣事吾左右以求譽也！」是日，烹阿大夫及左右嘗譽者。於是羣臣聳懼，莫敢飾詐，務盡其情，齊國大治，強於天下。","content_fanyi":"齐威王召见即墨大夫，对他说：“自从你到即墨任职以来，诋毁你的话每天都有。然而我派人到即墨察看，田地开辟得很好，百姓生活充足，官府清静无事，东方因而安宁；这是你不肯侍奉我身边的近臣、请他们帮助说好话啊！”于是封给他一万户的食邑。齐威王又召见阿地大夫，对他说：“自从你镇守阿地以来，赞誉你的话每天都有。我派人到阿地察看，田地没有开辟，百姓贫困饥饿。从前赵国攻打鄄地，你不去救援；卫国夺取薛陵，你竟不知道；这是你用重礼贿赂我身边的近臣、向他们求取称誉啊！”当天，齐威王烹杀了阿地大夫以及身边那些曾为他称誉的人。从此群臣震惊恐惧，没有人再敢掩饰欺诈，都尽力说出实情，齐国因此大治，强于天下。","content_jianti_auto":"4齐威王召即墨大夫，语之曰：「自子之居即墨也，毁言日至。然吾使人视即墨，田野辟，人民给，官无事，东方以宁；是子不事吾左右以求助也！」封之万家。召阿大夫，语之曰：「自子守阿，誉言日至。吾使人视阿，田野不辟，人民贫馁。昔日赵攻鄄，子不救；衞取薛陵，子不知；是子厚币事吾左右以求誉也！」是日，烹阿大夫及左右尝誉者。于是群臣耸惧，莫敢饰诈，务尽其情，齐国大治，强于天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":106,"number":4,"path":"资治通鉴 : 