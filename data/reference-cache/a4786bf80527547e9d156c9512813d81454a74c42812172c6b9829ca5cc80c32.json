{"data":{"current_mention_tongjian_id":"8c372cc8-db0e-11ef-a0d9-a0d3651f611f","current_paragraph_tongjian_id":"8c372cb2-db0e-11ef-8011-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":0,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"brief_for":"禦兒","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"甄后","people_name_jianti_auto":"甄后","start_index":0,"tongjian_id":"9a96ef4e-db0e-11ef-8910-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄴","place_name_jianti_auto":"邺","start_index":5,"tongjian_id":"9a96ef4f-db0e-11ef-8ca1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"甄后賜死於鄴，因葬焉。","note_content_jianti_auto":"甄后赐死于邺，因葬焉。","note_type":"hu_note","start_index":14,"tongjian_id":"9a96ef4d-db0e-11ef-8858-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":3,"tongjian_id":"9a96ef51-db0e-11ef-84e9-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":7,"tongjian_id":"9a96ef52-db0e-11ef-b98c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"論語：孔子曰：禹卑宮室，菲飲食，而盡力乎溝洫。","note_content_jianti_auto":"论语：孔子曰：禹卑宫室，菲饮食，而尽力乎沟洫。","note_type":"hu_note","start_index":66,"tongjian_id":"9a96ef50-db0e-11ef-9caf-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"句踐","people_name_jianti_auto":"句践","start_index":8,"tongjian_id":"9a96ef55-db0e-11ef-bf6b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":14,"tongjian_id":"9a96ef56-db0e-11ef-86fb-a0d3651f611f"},{"place_name":"禦兒","place_name_jianti_auto":"御儿","start_index":21,"tongjian_id":"9a96ef57-db0e-11ef-932b-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":55,"tongjian_id":"9a96ef58-db0e-11ef-8b5e-a0d3651f611f"},{"place_name":"禦兒","place_name_jianti_auto":"御儿","start_index":57,"tongjian_id":"9a96ef59-db0e-11ef-b008-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":60,"tongjian_id":"9a96ef5a-db0e-11ef-877f-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","start_index":62,"tongjian_id":"9a96ef5b-db0e-11ef-85ec-a0d3651f611f"},{"place_name":"嘉興府","place_name_jianti_auto":"嘉兴府","start_index":69,"tongjian_id":"9a96ef5c-db0e-11ef-99fd-a0d3651f611f"},{"place_name":"語兒鄕","place_name_jianti_auto":"语儿鄕","start_index":78,"tongjian_id":"9a96ef5d-db0e-11ef-a9e3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"句，音鉤。國語：句踐旣獲成於吳，其地北至于禦兒。非其身之所種則不食；非其夫人之所織則不衣。十年不收於國，卒以報吳。禦兒，吳、越分界之所，今嘉興府卽其地，今有語兒鄕。施，弋智翻。","note_content_jianti_auto":"句，音钩。国语：句践既获成于吴，其地北至于御儿。非其身之所种则不食；非其夫人之所织则不衣。十年不收于国，卒以报吴。御儿，吴、越分界之所，今嘉兴府即其地，今有语儿鄕。施，弋智翻。","note_type":"hu_note","start_index":91,"tongjian_id":"9a96ef54-db0e-11ef-8f9a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":11,"source_start_index":0,"source_text":"事見十五卷漢文帝後七年","target_paragraph_tongjian_id":"8f0caf68-db0e-11ef-ab19-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"漢文帝","people_name_jianti_auto":"汉文帝","start_index":5,"tongjian_id":"9a96ef60-db0e-11ef-a2af-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見十五卷漢文帝後七年。","note_content_jianti_auto":"事见十五卷汉文帝后七年。","note_type":"hu_note","start_index":120,"tongjian_id":"9a96ef5f-db