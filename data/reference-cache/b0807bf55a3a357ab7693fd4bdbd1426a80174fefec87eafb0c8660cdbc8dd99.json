ongjian_id":"8cc00b1e-db0e-11ef-a814-a0d3651f611f"},{"place_name":"韓","place_name_jianti_auto":"韩","start_index":40,"tongjian_id":"8cc00b1f-db0e-11ef-82ef-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":43,"tongjian_id":"8cc00b20-db0e-11ef-aa36-a0d3651f611f"},{"place_name":"胡國","place_name_jianti_auto":"胡国","start_index":45,"tongjian_id":"8cc00b21-db0e-11ef-ac9d-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":48,"tongjian_id":"8cc00b22-db0e-11ef-a807-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：舜後胡公滿封於陳，子孫以爲氏。又陸終氏六子，長曰昆吾，次曰參胡，董姓，封於韓墟。周爲胡國，楚滅之。","note_content_jianti_auto":"姓谱：舜后胡公满封于陈，子孙以为氏。又陆终氏六子，长曰昆吾，次曰参胡，董姓，封于韩墟。周为胡国，楚灭之。","note_type":"hu_note","start_index":141,"tongjian_id":"8cc00b17-db0e-11ef-92d7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"華陽城","place_name_jianti_auto":"华阳城","start_index":1,"tongjian_id":"8cc00b25-db0e-11ef-97d4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蓋華陽城下也。","note_content_jianti_auto":"盖华阳城下也。","note_type":"hu_note","start_index":155,"tongjian_id":"8cc00b24-db0e-11ef-b72f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":31,"tongjian_id":"8cc00b27-db0e-11ef-9052-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"將，卽亮翻。沈，持林翻。人皆貪生而畏死，二萬人與戰，烏得盡沈諸河？以計沈之也。","note_content_jianti_auto":"将，即亮翻。沈，持林翻。人皆贪生而畏死，二万人与战，乌得尽沈诸河？以计沈之也。","note_type":"hu_note","start_index":189,"tongjian_id":"8cc00b26-db0e-11ef-b4e5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_par