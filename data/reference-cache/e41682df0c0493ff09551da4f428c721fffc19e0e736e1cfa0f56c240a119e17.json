,"tongjian_id":"8cab28a8-db0e-11ef-b9ea-a0d3651f611f"},{"place_name":"湖陸縣","place_name_jianti_auto":"湖陆县","start_index":65,"tongjian_id":"8cab28a9-db0e-11ef-bc31-a0d3651f611f"},{"place_name":"泗水","place_name_jianti_auto":"泗水","start_index":70,"tongjian_id":"8cab28aa-db0e-11ef-9adb-a0d3651f611f"},{"place_name":"鉅野澤","place_name_jianti_auto":"巨野泽","start_index":82,"tongjian_id":"8cab28ab-db0e-11ef-aa08-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":89,"tongjian_id":"8cab28ac-db0e-11ef-86ae-a0d3651f611f"},{"place_name":"壽良縣","place_name_jianti_auto":"寿良县","start_index":91,"tongjian_id":"8cab28ad-db0e-11ef-8bec-a0d3651f611f"},{"place_name":"須昌","place_name_jianti_auto":"须昌","start_index":99,"tongjian_id":"8cab28ae-db0e-11ef-898b-a0d3651f611f"},{"place_name":"穀城","place_name_jianti_auto":"谷城","start_index":102,"tongjian_id":"8cab28af-db0e-11ef-9ba7-a0d3651f611f"},{"place_name":"臨邑縣","place_name_jianti_auto":"临邑县","start_index":105,"tongjian_id":"8cab28b0-db0e-11ef-820d-a0d3651f611f"},{"place_name":"四瀆津","place_name_jianti_auto":"四渎津","start_index":108,"tongjian_id":"8cab28b1-db0e-11ef-b6b6-a0d3651f611f"},{"place_name":"河水","place_name_jianti_auto":"河水","start_index":114,"tongjian_id":"8cab28b2-db0e-11ef-88b6-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":121,"tongjian_id":"8cab28b3-db0e-11ef-aa3f-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":124,"tongjian_id":"8cab28b4-db0e-11ef-a0b4-a0d3651f611f"},{"place_name":"濟","place_name_jianti_auto":"济","start_index":126,"tongjian_id":"8cab28b5-db0e-11ef-8aa4-a0d3651f611f"},{"place_name":"濟西","place_name_jianti_auto":"济西","start_index":135,"tongjian_id":"8cab28b6-db0e-11ef-8945-a0d3651f611f"},{"place_name":"阿","place_name_jianti_auto":"阿","start_index":147,"tongjian_id":"8cab28b7-db0e-11ef-9b86-a0d3651f611f"},{"place_name":"東阿","place_name_jianti_auto":"东阿","start_index":149,"tongjian_id":"8cab28b8-db0e-11ef-91a2-a0d3651f611f"},{"place_name":"鄄","place_name_jianti_auto":"鄄","place_note":"山東鄄城","start_index":152,"tongjian_id":"8cab28b9-db0e-11ef-b7ec-a0d3651f611f"},{"place_name":"鄄城","place_name_jianti_auto":"鄄城","start_index":154,"tongjian_id":"8cab28ba-db0e-11ef-8a32-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"河濟註已見一卷安王十五年，然僅及濟水入河而溢爲滎一節。今據水經：濟水自滎澤東流至濟陰乘氏縣西，分爲二瀆：其南瀆爲菏水，東南流至山陽湖陸縣，與泗水合。其北瀆東北流入于鉅野澤，東北過東郡壽良縣西界，北逕須昌、穀城至臨邑縣四瀆津口，與河水合。此蓋言齊地在河、濟之間者也。參考上濟西註可見。濟，子禮翻。阿，東阿；鄄，鄄城。鄄，音絹。乘，繩證翻。菏，音柯。","note_content_jianti_auto":"河济注已见一卷安王十五年，然仅及济水入河而溢为荥一节。今据水经：济水自荥泽东流至济阴乘氏县西，分为二渎：其南渎为菏水，东南流至山阳湖陆县，与泗水合。其北渎东北流入于巨野泽，东北过东郡寿良县西界，北迳须昌、谷城至临邑县四渎津口，与河水合。此盖言齐地在河、济之间者也。参考上济西注可见。济，子礼翻。阿，东阿；鄄，鄄城。鄄，音绢。乘，绳证翻。菏，音柯。","note_type":"hu_note","start_index":211,"tongjian_id":"8ca8da1d-db0e-11ef-98a3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"臨淄","place_name_jianti_auto":"临淄","start_index":7,"tongjian_id":"8cab28bd-db0e-11ef-9c95-a0d3651f611f"},{"place_name":"北海","place_name_jianti_auto":"北海","place_note":"渤海湾","start_index":14,"tongjian_id":"8cab28be-db0e-11ef-985c-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":19,"tongjian_id":"8cab28bf-db0e-11ef-a090-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"旁，步浪翻。自臨淄東北至海，北海地也。漢置郡。乘，繩證翻。","note_content_jianti_auto":"旁，步浪翻。自临淄东北至海，北海地也。汉置郡。乘，绳证翻。","note_type":"hu_note","start_index":221,"tongjian_id":"8cab28bc-db0e-11ef-b53a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王蠋","people_name_jianti_auto":"王蠋","start_index":0,"tongjian_id":"8cab28c1-db0e-11ef-9d5d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"王蠋墓蓋在晝。","note_c