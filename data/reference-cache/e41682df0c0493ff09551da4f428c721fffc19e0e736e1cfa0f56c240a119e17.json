f-86a2-a0d3651f611f"},{"place_name":"東萊","place_name_jianti_auto":"东莱","start_index":33,"tongjian_id":"8ca8da0e-db0e-11ef-af5a-a0d3651f611f"},{"place_name":"當利縣","place_name_jianti_auto":"当利县","start_index":35,"tongjian_id":"8ca8da0f-db0e-11ef-bcf1-a0d3651f611f"},{"place_name":"膠水","place_name_jianti_auto":"胶水","start_index":41,"tongjian_id":"8ca8da10-db0e-11ef-a22e-a0d3651f611f"},{"place_name":"膠東國","place_name_jianti_auto":"胶东国","start_index":46,"tongjian_id":"8ca8da11-db0e-11ef-8db8-a0d3651f611f"},{"place_name":"膠水","place_name_jianti_auto":"胶水","start_index":50,"tongjian_id":"8ca8da12-db0e-11ef-b89b-a0d3651f611f"},{"place_name":"膠西國","place_name_jianti_auto":"胶西国","start_index":55,"tongjian_id":"8ca8da13-db0e-11ef-ad6c-a0d3651f611f"},{"place_name":"東萊","place_name_jianti_auto":"东莱","place_note":"山东半岛东","start_index":59,"tongjian_id":"8ca8da14-db0e-11ef-8377-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":62,"tongjian_id":"8ca8da15-db0e-11ef-9864-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":69,"tongjian_id":"8ca8da16-db0e-11ef-88c1-a0d3651f611f"},{"place_name":"東萊郡","place_name_jianti_auto":"东莱郡","start_index":71,"tongjian_id":"8ca8da17-db0e-11ef-b04a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"膠東，漢爲王國。水經：膠水出琅邪黔陬縣膠山，北過膠東、下密，又北過東萊當利縣入海。膠水之東爲膠東國，膠水之西爲膠西國。東萊，春秋萊子之國，漢置東萊郡。邪，音耶。","note_content_jianti_auto":"胶东，汉为王国。水经：胶水出琅邪黔陬县胶山，北过胶东、下密，又北过东莱当利县入海。胶水之东为胶东国，胶水之西为胶西国。东莱，春秋莱子之国，汉置东莱郡。邪，音耶。","note_type":"hu_note","start_index":181,"tongjian_id":"8ca8da04-db0e-11ef-aa28-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"琅邪","place_name_jianti_auto":"琅邪","place_note":"山東膠南縣南","start_index":0,"tongjian_id":"8ca8da1a-db0e-11ef-becf-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":3,"tongjian_id":"8c