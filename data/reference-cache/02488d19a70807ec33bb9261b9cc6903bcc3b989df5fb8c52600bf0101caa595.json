{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁亥、前二一四）","note_content_jianti_auto":"（丁亥、前二一四）","note_type":"hu_note","start_index":0,"tongjian_id":"8d72ac84-db0e-11ef-8a2a-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈誼","people_name_jianti_auto":"贾谊","start_index":0,"tongjian_id":"8d72ac87-db0e-11ef-8088-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":14,"tongjian_id":"8d72ac88-db0e-11ef-b688-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":4,"tongjian_id":"8d72ac89-db0e-11ef-b269-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賈誼曰：秦人家貧子壯則出贅。師古曰：謂之贅壻，言其不當出在妻家，猶人身之有肬贅也。轉貨販易者爲商，坐市販賣者爲賈。贅，之銳翻。","note_content_jianti_auto":"贾谊曰：秦人家贫子壮则出赘。师古曰：谓之赘壻，言其不当出在妻家，犹人身之有肬赘也。转货贩易者为商，坐市贩卖者为贾。赘，之锐翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8d72ac86-db0e-11ef-88b9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":21,"tongjian_id":"8d72ac8b-db0e-11ef-ad6b-a0d3651f611f"},{"people_name":"漢高帝","people_name_jianti_auto":"汉高帝","start_index":24,"tongjian_id":"8d72ac8c-db0e-11ef-bba1-a0d3651f611f"},{"people_name":"陸量侯","people_name_jianti_auto":"陆量侯","start_index":30,"tongjian_id":"8d72ac8d-db0e-11ef-b4a6-a0d3651f611f"},{"people_name":"長沙王","people_name_jianti_auto":"长沙王","start_index":52,"tongjian_id":"8d72ac8e-db0e-11ef-b790-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":56,"tongjian_id":"8d72ac8f-db0e-11ef-bf61-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陸梁","place_name_jianti_auto":"陆梁","start_index":12,"tongjian_id":"8d72ac90-db0e-11ef-bcae-a0d3651f611f"},{"place_name":"陸梁","place_name_jianti_auto":"陆梁","start_index":17,"tongjian_id":"8d72ac91-db0e-11ef-9675-a0d3651f611f"},{"place_name":"陸量","place_name_jianti_auto":"陆量","start_index":60,"tongjian_id":"8d72ac92-db0e-11ef-8b11-a0d3651f611f"},{"place_name":"陸梁","place_name_jianti_auto":"陆梁","start_index":70,"tongjian_id":"8d72ac93-db0e-11ef-b0d0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索隱曰：謂南方之人，其性陸梁，故曰陸梁地。班表，漢高帝功臣有陸量侯須無，詔以爲列諸侯，自置吏令、長，受令長沙王。如淳曰：陸量，秦始皇本紀所謂陸梁地也。","note_content_jianti_auto":"索隐曰：谓南方之人，其性陆梁，故曰陆梁地。班表，汉高帝功臣有陆量侯须无，诏以为列诸侯，自置吏令、长，受令长沙王。如淳曰：陆量，秦始皇本纪所谓陆梁地也。","note_type":"hu_note","start_index":24,"tongjian_id":"8d72ac8a-db0e-11ef-ac20-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":29,"tongjian_id":"8d72ac98-db0e-11ef-9af8-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":40,"tongjian_id":"8d72ac99-db0e-11ef-a969-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":89,"tongjian_id":"8d72ac9a-db0e-11ef-b614-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"桂林","place_name_jianti_auto":"桂林","place_note":"廣西百色北","start_index":0,"tongjian_id":"8d72ac9b-db0e-11ef-ac92-a0d3651f611f"},{"place_name":"合浦","place_name_jianti_auto":"合浦","start_index":8,"tongjian_id":"8d72ac9c-db0e-11ef-b978-a0d3651f611f"},{"place_name":"桂林","place_name_jianti_auto":"桂林","place_note":"廣西百色北","start_index":33,"tongjian_id":"8d72ac9d-db0e-11ef-a1c3-a0d3651f611f"},{"place_name":"鬱林","place_name_jianti_auto":"郁林","start_index":37,"tongjian_id":"8d72ac9e-db0e-11ef-bbe3-a0d3651f611f"},{"place_name":"桂林","place_name_jianti_auto":"桂林","place_note":"廣西百色北","start_index":44,"tongjian_id":"8d72ac9f-db0e-11ef-8e68-a0d3651f611f"},{"place_name":"桂州","place_name_jianti_auto":"桂州","start_index":48,"tongjian_id":"8d72aca0-db0e-11ef-9df0-a0d3651f611f"},{"place_name":"鬱林","place_name_jianti_auto":"郁林","start_index":56,"tongjian_id":"8d72aca1-db0e-11ef-8c74-a0d3651f611f"},{"place_name":"南海郡","place_name_jianti_auto":"南海郡","start_index":60,"tongjian_id":"8d72aca2-db0e-11ef-b030-a0d3651f611f"},{"place_name":"廣州","place_name_jianti_auto":"广州","start_index":65,"tongjian_id":"8d72aca3-db0e-11ef-8388-a0d3651f611f"},{"place_name":"象郡","place_name_jianti_auto":"象郡","place_note":"广西崇左","start_index":73,"tongjian_id":"8d72aca4-db0e-11ef-a7e3-a0d3651f611f"},{"place_name":"臨塵","place_name_jianti_auto":"临尘","start_index":76,"tongjian_id":"8d72aca5-db0e-11ef-ac66-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":80,"tongjian_id":"8d72aca6-db0e-11ef-89e1-a0d3651f611f"},{"place_name":"日南","place_name_jianti_auto":"日南","start_index":94,"tongjian_id":"8d72aca7-db0e-11ef-afa2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"桂林因產桂而名。合浦以南，山間無雜木，冬夏長青，葉長尺餘。文穎曰：桂林，今鬱林。師古曰：桂林，今桂州界是其地，非鬱林也。南海郡，今廣州。茂陵書曰：象郡治臨塵，去長安萬七千五百里。韋昭曰：今日南是也。","note_content_jianti_auto":"桂林因产桂而名。合浦以南，山间无杂木，冬夏长青，叶长尺余。文颖曰：桂林，今郁林。师古曰：桂林，今桂州界是其地，非郁林也。南海郡，今广州。茂陵书曰：象郡治临尘，去长安万七千五百里。韦昭曰：今日南是也。","note_type":"hu_note","start_index":34,"tongjian_id":"8d72ac97-db0e-11ef-9854-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":35,"tongjian_id":"8d72acaa-db0e-11ef-9e1b-a0d3651f611f"},{"people_name":"裴氏","people_name_jianti_auto":"裴氏","start_index":70,"tongjian_id":"8d72acab-db0e-11ef-81d9-a0d3651f611f"},{"people_n