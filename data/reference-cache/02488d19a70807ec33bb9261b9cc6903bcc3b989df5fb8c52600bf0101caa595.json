start_index":119,"tongjian_id":"8d72acbc-db0e-11ef-9be5-a0d3651f611f"},{"place_name":"龐嶺","place_name_jianti_auto":"庞岭","start_index":122,"tongjian_id":"8d72acbd-db0e-11ef-9486-a0d3651f611f"},{"place_name":"臨賀","place_name_jianti_auto":"临贺","start_index":128,"tongjian_id":"8d72acbe-db0e-11ef-a3ff-a0d3651f611f"},{"place_name":"萌渚嶺","place_name_jianti_auto":"萌渚岭","start_index":130,"tongjian_id":"8d72acbf-db0e-11ef-a42f-a0d3651f611f"},{"place_name":"始安","place_name_jianti_auto":"始安","start_index":137,"tongjian_id":"8d72acc0-db0e-11ef-b9b6-a0d3651f611f"},{"place_name":"越城嶺","place_name_jianti_auto":"越城岭","start_index":139,"tongjian_id":"8d72acc1-db0e-11ef-ac19-a0d3651f611f"},{"place_name":"大庾嶺","place_name_jianti_auto":"大庾岭","start_index":158,"tongjian_id":"8d72acc2-db0e-11ef-bd4e-a0d3651f611f"},{"place_name":"虔州","place_name_jianti_auto":"虔州","start_index":162,"tongjian_id":"8d72acc3-db0e-11ef-8da3-a0d3651f611f"},{"place_name":"永明嶺","place_name_jianti_auto":"永明岭","start_index":165,"tongjian_id":"8d72acc4-db0e-11ef-8609-a0d3651f611f"},{"place_name":"白芒嶺","place_name_jianti_auto":"白芒岭","start_index":169,"tongjian_id":"8d72acc5-db0e-11ef-8c0a-a0d3651f611f"},{"place_name":"道州","place_name_jianti_auto":"道州","start_index":173,"tongjian_id":"8d72acc6-db0e-11ef-9b55-a0d3651f611f"},{"place_name":"臘嶺","place_name_jianti_auto":"腊岭","start_index":176,"tongjian_id":"8d72acc7-db0e-11ef-92f5-a0d3651f611f"},{"place_name":"郴州","place_name_jianti_auto":"郴州","start_index":179,"tongjian_id":"8d72acc8-db0e-11ef-b838-a0d3651f611f"},{"place_name":"臨源嶺","place_name_jianti_auto":"临源岭","start_index":182,"tongjian_id":"8d72acc9-db0e-11ef-a76f-a0d3651f611f"},{"place_name":"桂州","place_name_jianti_auto":"桂州","start_index":186,"tongjian_id":"8d72acca-db0e-11ef-bd28-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"所謂讁戍也。晉志曰：自北徂南，入越之道，必由嶺嶠；時有五處，故曰五嶺。師古曰：嶺者，西自衡山之南，東窮于海，一山之限耳，而別標名，則有五焉。裴氏廣州記曰：大庾、始安、臨賀、桂陽、揭陽爲五嶺。鄧德明南康記曰：大庾嶺，一也；桂陽騎田嶺，二也；九眞都龐嶺，三也；臨賀萌渚嶺，四也；始安越城嶺，五也。師古以裴說爲是。蜀註曰：大庾嶺在虔州；永明嶺、白芒嶺在道州；臘嶺在郴州；臨源嶺在桂州。讁，則革翻。處，昌呂翻。","note_content_jianti_auto":"所谓讁戍也。晋志曰：自北徂南，入越之道，必由岭峤；时有五处，故曰五岭。师古曰：岭者，西自衡山之南，东穷于海，一山之限耳，而别标名，则有五焉。裴氏广州记曰：大庾、始安、临贺、桂阳、揭阳为五岭。邓德明南康记曰：大庾岭，一也；桂阳骑田岭，二也；九真都庞岭，三也；临贺萌渚岭，四也；始安越城岭，五也。师古以裴说为是。蜀注曰：大庾岭在虔州；永明岭、白芒岭在道州；腊岭在郴州；临源岭在桂州。讁，则革翻。处，昌吕翻。","note_type":"hu_note","start_index":51,"tongjian_id":"8d72aca9-db0e-11ef-8970-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"南越","place_name_jianti_auto":"南越","place_note":"廣東廣西","resolved_place_entity_id":1030,"start_index":18,"tongjian_id":"8d72accf-db0e-11ef-88fe-a0d3651f611f"},{"place_name":"陸梁","place_name_jianti_auto":"陆梁","resolved_place_entity_id":5444,"start_index":20,"tongjian_id":"8d72acd0-db0e-11ef-ad6c-a0d3651f611f"},{"place_name":"桂林","place_name_jianti_auto":"桂林","place_note":"廣西百色北","resolved_place_entity_id":2663,"start_index":25,"tongjian_id":"8d72acd1-db0e-11ef-aea9-a0d3651f611f"},{"place_name":"南海","place_name_jianti_auto":"南海","place_note":"廣東廣州","resolved_place_entity_id":1021,"start_index":28,"tongjian_id":"8d72acd2-db0e-11ef-877c-a0d3651f611f"},{"place_name":"象郡","place_name_jianti_auto":"象郡","place_note":"广西崇左","resolved_place_entity_id":4067,"start_index":31,"tongjian_id":"8d72acd3-db0e-11ef-854f-a0d3651f611f"},{"place_name":"五嶺","place_name_jianti_auto":"五岭","resolved_place_entity_id":316,"start_index":43,"tongjian_id":"8d72acd4-db0e-11ef-915b-a0d3651f611f"},{"place_name":"越","place_name_jianti_auto":"越","resolved_place_entity_id":357,"start_index":47,"tongjian_id":"8d72acd5-db0e-11ef-8eae-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、唐虞 三代 春秋 战国 秦（卷一）","excerpts":[{"context_after":"","context_before":"","source_end_index":9,"source_paragraph_tongjian_id":"4210fe0f-a730-588d-9209-30d91ee9a45c","source_start_index":0,"source_text":"又平百越，置四郡。"}],"path":"历代州域形势纪要/一、唐虞 三代 春秋 战国 秦（卷一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷一百）","excerpts":[{"context_after":"孔氏曰：岭南之人，多处山陆，其性强梁，故曰陆梁。《史记》...","context_before":"...越在扬州南境，故曰扬越]。其在天文，则牵牛、婺女之分野。","source_end_index":236,"source_paragraph_tongjian_id":"ad9e4357-0094-5a58-a945-de8298f56271","source_start_index":156,"source_text":"秦并天下，置南海等郡，亦谓之南越[《秦本纪》：始皇三十年，略取陆梁地，为南海、桂林、象郡，以适遣戍。三十四年，又谪人筑南越地，又设南海尉以董之，所谓东南一尉也。"},{"context_after":"淮南子曰：始皇使尉屠睢发卒五十万，为五军：一军塞镡城之岭...","context_before":"...十里，与江西分险。绵亘而西为骑田岭、都庞岭，与湖广分险。","source_end_index":60,"source_paragraph_tongjian_id":"0b67428a-a923-5aad-ac38-7b797a28f18e","source_start_index":43,"source_text":"秦王翦降百越，以谪戍五万人守五岭。"}],"path":"广东方舆纪要/〇、封域山川险要（卷一百）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、南雄府（卷一百二）","excerpts":[{"context_after":"汉武平南越，遣杨仆出豫章，下浈水，即此地矣。南汉置雄州为...","context_before":"府当庾岭要口，为南北噤喉。","source_end_index":29,"source_paragraph_tongjian_id":"43d9cdc6-1d10-5988-8a72-9012c1a0717c","source_start_index":13,"source_text":"秦王翦降百越，谪戍五万人守五岭。"}],"path":"广东方舆纪要/五、南雄府（卷一百二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷一百六）","excerpts":[{"context_after":"秦末，赵陀兼据此。汉元鼎六年，讨平之，改置苍梧、郁林二郡...","context_before":"...越。后又谓之扬越。今详见广东]。其在天文，则翼、轸分野。","source_end_index":121,"source_paragraph_tongjian_id":"e6a47c83-e7b4-5370-85b4-a597218ad08e","source_start_index":105,"source_text":"秦始皇平南越，此为桂林、象郡地。"},{"context_after":"汉灭南越，使归义越侯严为戈船将军，出零陵，下漓水。又东汉...","context_before":"...》云：漓水上流谓之灵渠，自兴安县而南有斗门，上下六十里。","source_end_index":189,"source_paragraph_tongjian_id":"cbe725ae-e33c-594e-b41b-06c973f459bd","source_start_index":172,"source_text":"昔秦戍五岭，命史禄凿渠，以通舟楫。"},{"context_after":"盖岭之喉衿在是，稍南又不可以宿兵也。宋景炎元年，元将阿里...","context_before":"...遗址尚存，石甃无恙。城北近严关，群山环之，鸟道不可方轨。","source_end_index":385,"source_paragraph_tongjian_id":"77eeccea-4e08-5111-9420-23626eef24f7","source_start_index":362,"source_text":"秦取南越，以其地为桂林、象郡，而戍兵乃止湘南。"}],"path":"广西方舆纪要/〇、封域山川险要（卷一百六）","source_name":"读史方舆纪要"}],"class_tags":["军事","内政"],"content":"1發諸嘗逋亡人、贅壻、賈人爲兵，略取南越陸梁地，置桂林、南海、象郡；以讁徙民五十萬人戍五嶺，與越雜處。","content_fanyi":"朝廷征调那些曾逃亡在外的人、赘婿以及商贾来当兵，攻取南越的陆梁一带，并在当地设置桂林、南海、象郡三郡；又把因罪遭贬谪的五十万人迁往五岭戍守，与越地民众交错杂居。","content_jianti_auto":"1发诸尝逋亡人、赘壻、贾人为兵，略取南越陆梁地，置桂林、南海、象郡；以讁徙民五十万人戍五岭，与越杂处。","dtjl_paragraph_links":[],"dtjl_references":[],"id":569,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8d72ac85-db0e-11ef-a396-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8d72acd8-db0e-11ef-8be3-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":78,"tongjian_id":"8d72acd9-db0e-11ef-b29b-a0d3651f611f"},{"people_name":"劉昭","people_name_jianti_auto":"刘昭","start_index":95,"tongjian_id":"8d72acda-db0e-11ef-9c4b-a0d3651f611f"},{"people_name":"班","people_name_jianti_auto":"班","start_index":111,"tongjian_id":"8d72acdb-db0e-11ef-b3bd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":4,"tongjian_id":"8d72acdc-db0e-11ef-af14-a0d3651f611f"},{"place_name":"北地","place_name_jianti_auto":"北地","start_index":8,"tongjian_id":"8d72acdd-db0e-11ef-b729-a0d3651f611f"},{"place_name":"黃河","place_name_jianti_auto":"黄河","start_index":13,"tongjian_id":"8d72acde-db0e-11ef-8dd5-a0d3651f611f"},{"place_name":"積石","place_name_jianti_auto":"积石","start_index":23,"tongjian_id":"8d72acdf-db0e-11ef-b384-a0d3651f611f"},{"place_name":"金城","place_name_jianti_auto":"金城","start_index":27,"tongjian_id":"8d72ace0-db0e-11ef-9d96-a0d3651f611f"},{"place_name":"隴西","place_name_jianti_auto":"陇西","start_index":30,"tongjian_id":"8d72ace1-db0e-11ef-9628-a0d3651f611f"},{"place_name":"安定","place_name_jianti_auto":"安定","start_index":33,"tongjian_id":"8d72ace2-db0e-11ef-8c81-a0d3651f611f"}