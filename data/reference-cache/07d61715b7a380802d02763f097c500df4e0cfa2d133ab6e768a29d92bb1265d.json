lace_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":48,"tongjian_id":"8f3ad723-db0e-11ef-959d-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":102,"tongjian_id":"8f3ad726-db0e-11ef-b63c-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":114,"tongjian_id":"8f3d2093-db0e-11ef-9365-a0d3651f611f"},{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":144,"tongjian_id":"8f3d2094-db0e-11ef-b5ad-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":210,"tongjian_id":"8f3d2095-db0e-11ef-a280-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":266,"tongjian_id":"8f3d2098-db0e-11ef-b087-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":280,"tongjian_id":"8f3d2099-db0e-11ef-b7fc-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","resolved_place_entity_id":9,"start_index":285,"tongjian_id":"8f3d209a-db0e-11ef-b2b1-a0d3651f611f"},{"place_name":"胡","place_name_jianti_auto":"胡","resolved_place_entity_id":78,"start_index":297,"tongjian_id":"8f3d209b-db0e-11ef-85c9-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"上郡之战","tongjian_id":"war_N0573"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"后汉末废。○北舆城，亦在府西境。汉县，属云中郡，中部都尉...","context_before":"...以北六县，斩代左相，破胡骑于武泉北。又周勃击破胡骑于此。","source_end_index":79,"source_paragraph_tongjian_id":"b989833b-fb11-5ade-9040-dd0c1fd5c04c","source_start_index":61,"source_text":"景帝中六年，匈奴入雁门至武泉，是也。"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"7六月，匈奴入鴈門，至武泉，入上郡，取苑馬；吏卒戰死者二千人。隴西李廣爲上郡太守，嘗從百騎出，遇匈奴數千騎，見廣，以爲誘騎，皆驚，上山陳。廣之百騎皆大恐，欲馳還走。廣曰：「吾去大軍數十里，今如此以百騎走，匈奴追射我立盡。今我留，匈奴必以我爲大軍之誘，必不敢擊我。」廣令諸騎曰：「前！」未到匈奴陣二里所，止，令曰：「皆下馬解鞍！」其騎曰：「虜多且近，卽有急，柰何？」廣曰：「彼虜以我爲走；令皆解鞍以示不走，用堅其意。」於是胡騎遂不敢擊。有白馬將出，護其兵；李廣上馬，與十餘騎奔，射殺白馬將而復還，至其騎中解鞍，令士皆縱馬臥。是時會暮，胡兵終怪之，不敢擊。夜半時，胡兵亦以爲漢有伏軍於旁，欲夜取之，胡皆引兵而去。平旦，李廣乃歸其大軍。","content_fanyi":"六月，匈奴侵入雁门郡，抵达武泉县，又侵入上郡，抢走苑马；汉军官兵战死两千人。陇西人李广任上郡太守，曾率一百名骑兵出行，遭遇几千名匈奴骑兵。匈奴人看见李广，以为是汉军大部队派出的诱兵，都很惊恐，上山列阵。李广的一百名骑兵都大为恐惧，想纵马往回逃跑。李广阻止他们说：“我们离大军几十里，眼下如果就这样带着一百名骑兵逃走，匈奴人追着射杀，我们立刻就会全被射死。如今我们留在这里，匈奴人必定把我们当作大军的诱兵，一定不敢攻击我们。”李广命令众骑兵说：“前进！”走到离匈奴阵地约二里处停下，又下令说：“都下马，解下马鞍！”他的骑兵说：“敌人又多又近，万一有紧急情况怎么办？”李广说：“敌人本来认为我们会逃跑；现在我命令都解下马鞍，以此表示不逃跑，这就能更让他们相信我们是诱兵。”于是胡骑果然不敢进攻。有一位骑着白马的匈奴将领出阵来监护自己的部下；李广上马，带着十余名骑兵冲过去，射杀了那名白马将领后又返回，回到自己的骑兵队中解下马鞍，命令士兵都放开战马，躺下休息。这时恰逢傍晚，胡兵始终对李广部队的举动感到奇怪，不敢进攻。半夜时，胡兵仍然认为汉军在附近有伏兵，会趁夜前来袭击他们，于是全部领兵撤走了。黎明时，李广才回到他的大军营垒。","content_jianti_auto":"7六月，匈奴入鴈门，至武泉，入上郡，取苑马；吏卒战死者二千人。陇西李广为上郡太守，尝从百骑出，遇匈奴数千骑，见广，以为诱骑，皆惊，上山陈。广之百骑皆大恐，欲驰还走。广曰：「吾去大军数十里，今如此以百骑走，匈奴追射我立尽。今我留，匈奴必以我为大军之诱，必不敢击我。」广令诸骑曰：「前！」未到匈奴阵二里所，止，令曰：「皆下马解鞍！」其骑曰：「虏多且近，即有急，柰何？」广曰：「彼虏以我为走；令皆解鞍以示不走，用坚其意。」于是胡骑遂不敢击。有白马将出，护其兵；李广上马，与十余骑奔，射杀白马将而复还，至其骑中解鞍，令士皆纵马卧。是时会暮，胡兵终怪之，不敢击。夜半时，胡兵亦以为汉有伏军于旁，欲夜取之，胡皆引兵而去。平旦，李广乃归其大军。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1328,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"8f3ad6fe-db0e-11ef-a899-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8秋，七月，辛亥晦，日有食之。","content_fanyi":"秋季，七月二十九日辛亥晦，发生了日食。","content_jianti_auto":"8秋，七月，辛亥晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1329,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"8f3d209c-db0e-11ef-bae9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"都尉","official_note":"都尉是汉代地方军事和治安长官，通常负责郡的军事事务。在原文中，济南都尉是甯成之前的官职，表示他曾在济南担任此职，后升为中尉。","official_rank":"未知","source_snippet":"濟南都尉","start_index":18,"tongjian_id":"348289d8-31f8-470e-954e-462960c0e900"},{"confidence":0.85,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉是汉代中央官职，负责京城的治安和军事，类似于首都卫戍司令。在原文中，甯成被任命为中尉，以加强长安的执法，应对宗室暴犯法的问题。","official_rank":"未知","source_snippet":"中尉","start_index":26,"tongjian_id":"47b4e6b0-7808-41d5-b2f6-75b39f19744b"}],"ExtRef_Children_people":[{"link_death_year":-145,"link_td_description":"郅都，河东郡杨县（今山西省洪洞县东南）人，西汉政治家、军事家。汉文帝时任郎官，汉景帝时先后任中郎将、济南郡太守、中尉、雁门郡太守。郅都任中尉时执法严格、不避权贵，人称“苍鹰”；任雁门太守时使匈奴闻名丧胆，被称为“战克之将，国之爪牙”。","link_td_id":"Q10008878","link_td_number_id":433642,"people_name":"郅都","people_name_jianti_auto":"郅都","people_xingming":"郅都","start_index":2,"tongjian_id":"8f3d209f-db0e-11ef-9c01-a0d3651f611f"},{"link_td_description":"宁成，南阳郡穰人，西汉初期大臣。汉景帝时，为济南都尉、迁中尉，执法严厉，被宗室豪强所畏惧。汉武帝时，为内史，因罪入狱。后来逃回家，置家产一千顷，劳役平民数千家。后为关都尉。","link_td_id":"Q10002765","link_td_number_id":1547182,"people_name":"甯成","people_name_jianti_auto":"宁成","people_xingming":"宁成","start_index":27,"tongjian_id":"8f3d20a0-db0e-11ef-ac57-a0d3651f611f"},{"link_death_year":-145,"link_td_description":"郅都，河东郡杨县（今山西省洪洞县东南）人，西汉政治家、军事家。汉文帝时任郎官，汉景帝时先后任中郎将、济南郡太守、中尉、雁门郡太守。郅都任中尉时执法严格、不避权贵，人称“苍鹰”；任雁门太守时使匈奴闻名丧胆，被称为“战克之将，国之爪牙”。","link_td_id":"Q10008878","link_td_number_id":433642,"people_name":"郅都","people_name_jianti_auto":"郅都","start_index":36,"tongjian_id":"8f3d20a1-db0e-11ef-a9b9-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長安","place_name_jianti_auto":"长安","resolved_place_entity_id":43,"start_index":7,"tongjian_id":"8f3d20a2-db0e-11ef-9d18-a0d3651f611f"},{"place_name":"濟南","place_name_jianti_auto":"济南","resolved_place_entity_id":859,"start_index":21,"tongjian_id":"8f3d20a3-db0e-11ef-ad63-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","resolved_place_entity_id":235,"start_index":25,"tongjian_id":"8f3d20a4-db0e-11ef-a78a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事","内政"],"content":"9自郅都之死，長安左右宗室多暴犯法。上乃召濟南都尉南陽甯成爲中尉。其治效郅都，其廉弗如；然宗室、豪傑皆人人惴恐。","content_fanyi":"自从郅都死后，长安及其附近的宗室皇族中多有凶暴犯法之人。汉景帝于是征召济南都尉、南阳人宁成入朝担任中尉。他治政仿效郅都，但清廉不及郅都；然而宗室皇族、地方豪强个个都恐惧不安。","content_jianti_auto":"9自郅都之死，长安左右宗室多暴犯法。上乃召济南都尉南阳宁成为中尉。其治效郅都，其廉弗如；然宗室、豪杰皆人人惴恐。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，则假法于残忍之小人，姑宽为之法，以使愚民轻于蹈阱，而幸...","context_before":"...不能决，移谳廷尉，谳而后谳不当，谳者不为失，立法宽矣。乃","source_end_index":91,"source_paragraph_tongjian_id":"a6dc567b-e40a-4e7d-974e-980e04d582a3","source_start_index":81,"source_text":"郅都、宁成相继为中尉"}],"title":"五 法宽而任鸷击之吏不如法严而任宽仁之吏"}],"id":1330,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"8f3d209d-db0e-11ef-9791-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"共王喜","people_name_jianti_auto":"共王喜","start_index":0,"tongjian_id":"8f3d20a7-db0e-11ef-8f12-a0d3651f611f"},{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":4,"tongjian_id":"8f3d20a8-db0e-11ef-abfc-a0d3651f611f"},{"people_name":"章","people_name_jianti_auto":"章","start_index":11,"tongjian_id":"8f3d20a9-db0e-11ef-a78d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"淮陽","place_name_jianti_auto":"淮阳","start_index":20,"tongjian_id":"8f3d20aa-db0e-11ef-858e-a0d3651f611f"},{"place_name":"城陽","place_name_jianti_auto":"城阳","start_index":28,"tongjian_id":"8f3d20ab-db0e-11ef-85c9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"共王喜，文帝前四年嗣父章爵爲王，八年徙王淮陽，後四年復還城陽，至是而薨。共，讀曰恭。","note_content_jianti_auto":"共王喜，文帝前四年嗣父章爵为王，八年徙王淮阳，后四年复还城阳，至是而薨。共，读曰恭。","note_type":"hu_note","start_index":9,"tongjian_id":"8f3d20a6-db0e-11ef-b68d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-144,"link_td_description":"刘喜，汉朝宗室，西汉第二代城阳王。","link_td_id":"Q10003275","link_td_number_id":1448931,"people_name":"城陽共王喜","people_name_jianti_auto":"城阳共王喜","people_xingming":"刘喜","start_index":2,"tongjian_id":"8f3d20ac-db0e-11ef-b341-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10城陽共王喜薨。","content_fanyi":"城阳共王刘喜去世。","content_jianti_auto":"10城阳共王喜薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1331,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"8f3d20a5-db0e-11ef-967c-a0d3651f611f"}],"reign_name":"六年","reign_name_jianti_auto":"六年","start_index":10,"tongjian_id":"8f3ad6be-db0e-11ef-8ce6-a0d3651f611f","year_anno":"（丁酉、前一四四）","year_int":-144},"message":"success","success":true}