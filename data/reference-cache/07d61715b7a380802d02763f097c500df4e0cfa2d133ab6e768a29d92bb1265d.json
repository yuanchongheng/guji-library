{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（丁酉、前一四四）","note_content_jianti_auto":"（丁酉、前一四四）","note_type":"hu_note","start_index":0,"tongjian_id":"8f3ad6bf-db0e-11ef-9a40-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"褚少孫","people_name_jianti_auto":"褚少孙","start_index":0,"tongjian_id":"8f3ad6c2-db0e-11ef-809b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":13,"tongjian_id":"8f3ad6c3-db0e-11ef-82c8-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":76,"tongjian_id":"8f3ad6c4-db0e-11ef-99c1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"褚少孫曰：諸侯王朝見天子，漢法凡當四見耳：始到，入，小見。到正月朔旦，奉皮薦璧玉賀正月，法見。後三日，爲王置酒，賜金錢財物。後二日，復入小見，辭去。凡留長安，不過二十日。小見者，燕見於禁門內，飲於省中。","note_content_jianti_auto":"褚少孙曰：诸侯王朝见天子，汉法凡当四见耳：始到，入，小见。到正月朔旦，奉皮荐璧玉贺正月，法见。后三日，为王置酒，赐金钱财物。后二日，复入小见，辞去。凡留长安，不过二十日。小见者，燕见于禁门内，饮于省中。","note_type":"hu_note","start_index":20,"tongjian_id":"8f3ad6c1-db0e-11ef-8f3e-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-199,"link_death_year":-144,"link_td_description":"刘武，西汉时期的贵族，与馆陶公主、汉景帝同为窦太后所出，汉文帝嫡次子。","link_td_id":"Q10002450","link_td_number_id":121643,"people_name":"梁王","people_name_jianti_auto":"梁王","people_xingming":"刘武","start_index":6,"tongjian_id":"8f3ad6c6-db0e-11ef-bf87-a0d3651f611f","wl_zhushi":"[刘武]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1冬，十月，梁王來朝，上疏欲留；上弗許。王歸國，意忽忽不樂。","content_fanyi":"冬季，十月，梁王刘武来京朝见，上书请求留居长安；汉景帝没有准许。梁王返回封国，心情郁郁不乐。","content_jianti_auto":"1冬，十月，梁王来朝，上疏欲留；上弗许。王归国，意忽忽不乐。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1322,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f3ad6c0-db0e-11ef-b0c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8f3ad6ca-db0e-11ef-8dec-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":16,"tongjian_id":"8f3ad6cb-db0e-11ef-8138-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：乙十一行本「一」作「二」；孔本同。』","note_content_jianti_auto":"『章：乙十一行本「一」作「二」；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8f3ad6c9-db0e-11ef-b26f-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":3,"tongjian_id":"8f3ad6c8-db0e-11ef-922a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長信","place_name_jianti_auto":"长信","start_index":29,"tongjian_id":"8f3ad6cd-db0e-11ef-939d-a0d3651f611f"},{"place_name":"長信","place_name_jianti_auto":"长信","start_index":34,"tongjian_id":"8f3ad6ce-db0e-11ef-8f53-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"時改廷尉爲大理，將作少府爲大匠，奉常爲太常，典客爲大行令，長信詹事爲長信少府，將行爲大長秋，主爵中尉爲都尉。","note_content_jianti_auto":"时改廷尉为大理，将作少府为大匠，奉常为太常，典客为大行令，长信詹事为长信少府，将行为大长秋，主爵中尉为都尉。","note_type":"hu_note","start_index":16,"tongjian_id":"8f3ad6cc-db0e-11ef-939a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"司法","official_name":"廷尉","official_note":"廷尉是秦漢時期掌管刑獄的最高司法官員，屬於九卿之一，負責審判案件和監獄管理。在《資治通鑑》此段中，提及改官名，廷尉是其中之一，反映了漢景帝時期的官制調整。","official_rank":"九卿之一","source_snippet":"改諸廷尉、將作等官名","start_index":5,"tongjian_id":"12aeacde-4fcd-4cf1-8677-5a9109d21d65"},{"confidence":0.95,"official_category":"工程營造","official_name":"將作","official_note":"將作是秦漢時期負責宮殿、陵墓等大型工程營造的官員，也屬於九卿之一。在此段中，將作與廷尉一同被提及改官名，顯示漢景帝對官職名稱的變更。","official_rank":"九卿之一","source_snippet":"改諸廷尉、將作等官名","start_index":9,"tongjian_id":"246a9d7a-1c16-4971-a204-d65bf09ae7f7"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2十一月，改諸廷尉、將作等官名。","content_fanyi":"十一月，汉景帝下诏，更改廷尉、将作少府等官名。","content_jianti_auto":"2十一月，改诸廷尉、将作等官名。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1323,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f3ad6c7-db0e-11ef-b876-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f3ad6cf-db0e-11ef-98cf-a0d3651f611f","pinyin":"zhì","source_anchor_text":"幸雍郊五畤三月雨雪","source_key":"baiyang_epub","start_index":16,"text":"畤","tongjian_id":"cbb9593b-eaf3-5351-a33a-aba51202d4f2"}],"ExtRef_Children_places":[{"place_name":"雍","place_name_jianti_auto":"雍","resolved_place_entity_id":228,"start_index":12,"tongjian_id":"8f3ad6d1-db0e-11ef-9ea9-a0d3651f611f"},{"place_name":"五畤","place_name_jianti_auto":"五畤","resolved_place_entity_id":1322,"start_index":15,"tongjian_id":"8f3ad6d2-db0e-11ef-8199-a0d3651f611f