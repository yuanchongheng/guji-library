{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（癸未、前九八）","note_content_jianti_auto":"（癸未、前九八）","note_type":"hu_note","start_index":0,"tongjian_id":"9055e357-db0e-11ef-95cb-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"9055e35a-db0e-11ef-aa60-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":21,"tongjian_id":"9055e35b-db0e-11ef-94c5-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":39,"tongjian_id":"9055e35c-db0e-11ef-b9b6-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"京師","place_name_jianti_auto":"京师","start_index":8,"tongjian_id":"9055e35d-db0e-11ef-9489-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班表：中尉掌徼循京師，太初元年更名執金吾。應劭曰：吾，禦也，掌執金革以禦非常。師古曰：金吾，鳥名，主辟不祥。天子出行，主先導以備非常，故執此鳥之象；因以名官。","note_content_jianti_auto":"班表：中尉掌徼循京师，太初元年更名执金吾。应劭曰：吾，御也，掌执金革以御非常。师古曰：金吾，鸟名，主辟不祥。天子出行，主先导以备非常，故执此鸟之象；因以名官。","note_type":"hu_note","start_index":25,"tongjian_id":"9055e359-db0e-11ef-b424-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"執金吾","official_note":"執金吾是漢代官職，負責京師治安和皇帝出行儀仗，此處杜周擔任此職後被任命為御史大夫，顯示其職務變遷。","official_rank":"中二千石","source_snippet":"以執金吾杜周爲御史大夫","start_index":12,"tongjian_id":"37384bca-c627-495e-9cf0-cd66f2115699"},{"confidence":0.9,"official_category":"监察","official_name":"御史大夫","official_note":"御史大夫是漢代三公之一，掌管監察和司法，此處杜周被任命為此職，標誌其晉升至高級官職。","official_rank":"三公之一","source_snippet":"以執金吾杜周爲御史大夫","start_index":18,"tongjian_id":"951980bd-646d-4897-941e-53bc9652cc32"}],"ExtRef_Children_people":[{"link_birth_year":-199,"link_death_year":-98,"link_td_description":"王卿，琅琊郡人，西汉御史大夫。","link_td_id":"Q10019393","link_td_number_id":5922058,"people_name":"王卿","people_name_jianti_auto":"王卿","people_xingming":"王卿","start_index":6,"tongjian_id":"9055e35f-db0e-11ef-9331-a0d3651f611f"},{"link_death_year":-94,"link_td_description":"杜周，西汉政治人物，武帝手下酷吏。","link_td_id":"Q10007776","link_td_number_id":937202,"people_name":"杜周","people_name_jianti_auto":"杜周","people_xingming":"杜周","start_index":17,"tongjian_id":"9055e360-db0e-11ef-9951-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，二月，王卿有罪自殺，以執金吾杜周爲御史大夫。","content_fanyi":"春季，二月，王卿因罪自杀，汉武帝任命执金吾杜周为御史大夫。","content_jianti_auto":"1春，二月，王卿有罪自杀，以执金吾杜周为御史大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1776,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9055e358-db0e-11ef-ab51-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"9055e363-db0e-11ef-9d93-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":9,"tongjian_id":"9055e364-db0e-11ef-aa48-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":29,"tongjian_id":"9055e365-db0e-11ef-bf3d-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":64,"tongjian_id":"9055e366-db0e-11ef-9cc5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：榷，音較。應劭曰：縣官自酤榷賣酒，小民不復得酤也。韋昭曰：以木渡水曰榷，謂禁民酤釀，獨官開置，如道路設木爲榷，獨取利也。師古曰：榷者，步渡橋，爾雅謂之石杠，今之略彴是也。禁閉其事，總利入官，而下無由以得，有若渡水之榷，因立名焉。酤，工護翻。彴，音酌。","note_content_jianti_auto":"如淳曰：榷，音较。应劭曰：县官自酤榷卖酒，小民不复得酤也。韦昭曰：以木渡水曰榷，谓禁民酤酿，独官开置，如道路设木为榷，独取利也。师古曰：榷者，步渡桥，尔雅谓之石杠，今之略彴是也。禁闭其事，总利入官，而下无由以得，有若渡水之榷，因立名焉。酤，工护翻。彴，音酌。","note_type":"hu_note","start_index":6,"tongjian_id":"9055e362-db0e-11ef-afe9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9055e361-db0e-11ef-a131-a0d3651f611f","pinyin":"què","source_anchor_text":"史大夫初榷酒酤三月","source_key":"baiyang_epub","start_index":2,"text":"榷","tongjian_id":"1be8f7cf-dc79-5315-b16f-782cf3c5a748"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9055e361-db0e-11ef-a131-a0d3651f611f","pinyin":"gū","source_anchor_text":"夫初榷酒酤三月上行","source_key":"baiyang_epub","start_index":4,"text":"酤","tongjian_id":"2514a790-2497-566b-aa35-7ad187eb66a3"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2初榷酒酤。","content_fanyi":"开始实行酒类专卖。","content_jianti_auto":"2初榷酒酤。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1777,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9055e361-db0e-11ef-a131-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄧展","people_name_jianti_auto":"邓展","start_index":0,"tongjian_id":"9055e36a-db0e-11ef-ab2a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄧展曰：瘞，埋也。爾雅曰：祭地曰瘞薶。薶其物者，示歸於地也。瘞，音於例翻。","note_content_jianti_auto":"邓展曰：瘗，埋也。尔雅曰：祭地曰瘗薶。薶其物者，示归于地也。瘗，音于例翻。","note_type":"hu_note","start_index":31,"tongjian_id":"9055e369-db0e-11ef-acc1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":11,"source_start_index":0,"source_text":"大人跡見二十卷元封元年","target_paragraph_tongjian_id":"90051a17-db0e-11ef-aa28-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"大人跡見二十卷元封元年。","note_content_jianti_auto":"大人迹见二十卷元封元年。","note_type":"hu_note","start_index":62,"tongjian_id":"9055e36c-db0e-11ef-ab31-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9055e36e-db0e-11ef-ab92-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：羈縻，牽聯之意。馬絡頭曰羈，牛靷曰縻。","note_content_jianti_auto":"师古曰：羁縻，牵联之意。马络头曰羁，牛靷曰縻。","note_type":"hu_note","start_index":82,"tongjian_id":"9055e36d-db0e-11ef-814a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"公孙卿，齐国（治今山东淄博市临淄）人，西汉方士。","link_td_id":"Q10007759","link_td_number_id":6026488,"people_name":"公孫卿","people_name_jianti_auto":"公孙卿","people_xingming":"公孙卿","start_index":51,"tongjian_id":"9055e371-db0e-11ef-a9d5-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9055e368-db0e-11ef-8626-a0d3651f611f","pinyin":"yì","source_anchor_text":"還祠常山瘞玄玉方士","source_key":"baiyang_epub","start_index":27,"text":"瘞","tongjian_id":"1cf71e23-4033-57ac-b0ef-2a478e50cb79"}],"ExtRef_Children_places":[{"place_name":"泰山","place_name_jianti_auto":"泰山","resolved_place_entity_id":306,"start_index":7,"tongjian_id":"9055e36f-db0e-11ef-9cd8-a0d3651f611f"},{"place_name":"常山","place_name_jianti_auto":"常山","place_note":"河北唐县西北","resolved_place_entity_id":518,"start_index":24,"tongjian_id":"9055e370-db0e-11ef-a093-a0d3651f611f"},{"place_name":"蓬萊","place_name_jianti_auto":"蓬莱","resolved_place_entity_id":1794,"start_index":42,"tongjian_id":"9055e372-db0e-11ef-94f6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域 山川险要（卷十）","excerpts":[{"context_after":"后汉初平四年，袁绍与黑山贼张燕等战于常山。建安三年，绍攻...","context_before":"...天下之脊。《燕世家》：燕听张仪计，愿献常山之尾五城于秦。","source_end_index":314,"source_paragraph_tongjian_id":"435eff47-1b32-5f8b-85be-b05773833451","source_start_index":300,"source_text":"汉天汉二年，祠常山，瘗玄玉。"}],"path":"北直方舆纪要/〇、封域 山川险要（卷十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域 山川险要（卷三十）","excerpts":[{"context_after":"太始四年，幸泰山修封，禅石闾。征和四年，复幸泰山修封，亦...","context_before":"...，一作高，亦见泰安州]。二年，修封泰山，禅石闾[同上]。","source_end_index":434,"source_paragraph_tongjian_id":"4fb08d4f-c3c0-5b48-be3b-5e70e4f4b948","source_start_index":422,"source_text":"天汉三年，行幸泰山修封。"}],"path":"山东方舆纪要/〇、封域 山川险要（卷三十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"天汉四年，幸泰山，祀明堂。后汉元和二年，幸泰山，柴告岱宗...","context_before":"...明堂于汶上。太初元年十一月甲子，朔旦冬至，祀上帝于明堂。","source_end_index":161,"source_paragraph_tongjian_id":"ae173de8-867c-5afd-a173-351ba033d8b7","source_start_index":141,"source_text":"天汉三年春三月，上行幸泰山修封，祀明堂。"},{"context_after":"后汉元和二年，幸泰山，柴告岱宗，进幸奉高，祀五帝于汶上明...","context_before":"...，祀上帝于明堂。天汉三年春三月，上行幸泰山修封，祀明堂。","source_end_index":174,"source_paragraph_tongjian_id":"ae173de8-867c-5afd-a173-351ba033d8b7","source_start_index":161,"source_text":"天汉四年，幸泰山，祀明堂。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"}],"class_tags":["内政"],"content":"3三月，上行幸泰山，脩封，祀明堂，因受計。還，祠常山，瘞玄玉。方士之候祠神人、入海求蓬萊者終無有驗，而公孫卿猶以大人跡爲解，天子益怠厭方士之怪迂語矣；然猶羈縻不絕，冀遇其眞。自此之後，方士言神祠者彌衆，然其效可睹矣。","content_fanyi":"三月，汉武帝巡行泰山，举行修封之礼，祭祀明堂，并借此接受、审核各郡国呈报的户籍、财政簿册。返回京城途中，祭祀常山，把黑色玉器埋藏在祭坛下面。方士中那些四处等候祭祀神人、入海寻找蓬莱山的人，始终没有应验，而公孙卿仍然拿巨人的脚印作为托辞；汉武帝更加厌倦方士们怪诞迂阔的话了，但仍笼络他们、不断绝往来，希望遇到真正有本事的仙人。从此以后，方士谈论神仙祭祀的人更多，但效果也就可以看到了。","content_jianti_auto":"3三月，上行幸泰山，修封，祀明堂，因受计。还，祠常山，瘗玄玉。方士之候祠神人、入海求蓬莱者终无有验，而公孙卿犹以大人迹为解，天子益怠厌方士之怪迂语矣；然犹羁縻不绝，冀遇其真。自此之后，方士言神祠者弥众，然其效可睹矣。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1778,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9055e368-db0e-11ef-8626-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4夏，四月，大旱。赦天下。","content_fanyi":"夏季四月，发生大旱。大赦天下。","content_jianti_auto":"4夏，四月，大旱。赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1779,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"9055e373-db0e-11ef-ab87-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鴈門郡","place_name_jianti_auto":"鴈门郡","start_index":0,"tongjian_id":"9055e376-db0e-11ef-a563-a0d3651f611f"},{"place_name":"幷州","place_name_jianti_auto":"幷州","start_index":4,"tongjian_id":"9055e377-db0e-11ef-8b3d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鴈門郡屬幷州。","note_content_jianti_auto":"鴈门郡属幷州。","note_type":"hu_note","start_index":9,"tongjian_id":"9055e375-db0e-11ef-87c0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"9055e379-db0e-11ef-8819-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":22,"tongjian_id":"9055e37a-db0e-11ef-9775-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：軍法，行逗留畏愞者要斬。愞，如椽翻；師古曰：又音乃館翻。","note_content_jianti_auto":"如淳曰：军法，行逗留畏愞者要斩。愞，如椽翻；师古曰：又音乃馆翻。","note_type":"hu_note","start_index":17,"tongjian_id":"9055e378-db0e-11ef-b6cd-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡级行政长官，负责治理地方，此处指鴈门郡太守因畏敌失职而被处死，反映了汉代对地方官员的严厉问责制度。","official_rank":"未知","source_snippet":"太守坐畏愞棄市","start_index":12,"tongjian_id":"e57aab41-032b-4f92-b001-a3864fc28c02"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9055e374-db0e-11ef-8240-a0d3651f611f","pinyin":"nuò","source_anchor_text":"太守坐畏愞棄市春正","source_key":"baiyang_epub","start_index":13,"text":"愞","tongjian_id":"2a820a2e-b05e-59bf-af21-f9e832bbf491"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":3,"tongjian_id":"9055e37b-db0e-11ef-9898-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","resolved_place_entity_id":496,"start_index":6,"tongjian_id":"9055e37c-db0e-11ef-8d6b-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"5秋，匈奴入鴈門。太守坐畏愞棄市。","content_fanyi":"秋季，匈奴侵入雁门。雁门太守因畏缩惧敌获罪，被处以弃市之刑。","content_jianti_auto":"5秋，匈奴入鴈门。太守坐畏愞弃市。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1780,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9055e374-db0e-11ef-8240-a0d3651f611f"}],"reign_name":"天漢三年","reign_name_jianti_auto":"天汉三年","start_index":0,"tongjian_id":"9055e356-db0e-11ef-b5ab-a0d3651f611f","year_anno":"（癸未、前九八）","year_int":-98},"message":"success","success":true}