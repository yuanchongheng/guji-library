{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":8,"tongjian_id":"90583897-db0e-11ef-89b6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙酉、前九六）應劭曰：言蕩滌天下，與民更始，故以冠元。","note_content_jianti_auto":"（乙酉、前九六）应劭曰：言荡涤天下，与民更始，故以冠元。","note_type":"hu_note","start_index":0,"tongjian_id":"90583896-db0e-11ef-b92b-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":35,"tongjian_id":"9058389a-db0e-11ef-9485-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"巫，祝也；蠱，厭也，惑也；謂使巫祠祭、祝詛、厭魅以蠱惑人也。蠱，音古。孔穎達曰：蠱者，損壞之名，故左傳云：皿蟲爲蠱；是蠱食器皿，巫行邪術，損壞於人。要，與腰同。","note_content_jianti_auto":"巫，祝也；蛊，厌也，惑也；谓使巫祠祭、祝诅、厌魅以蛊惑人也。蛊，音古。孔颖达曰：蛊者，损坏之名，故左传云：皿虫为蛊；是蛊食器皿，巫行邪术，损坏于人。要，与腰同。","note_type":"hu_note","start_index":17,"tongjian_id":"90583899-db0e-11ef-85de-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-96,"link_td_description":"公孙敖，义渠人，汉朝军事人物。","link_td_id":"Q10009481","link_td_number_id":717641,"people_name":"公孫敖","people_name_jianti_auto":"公孙敖","people_xingming":"公孙敖","start_index":6,"tongjian_id":"9058389c-db0e-11ef-8eef-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，正月，公孫敖坐妻爲巫蠱要斬。","content_fanyi":"春季，正月，公孙敖因其妻行巫蛊之事被腰斩。","content_jianti_auto":"1春，正月，公孙敖坐妻为巫蛊要斩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1785,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"90583898-db0e-11ef-bfa7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"茂陵","place_name_jianti_auto":"茂陵","resolved_place_entity_id":2179,"start_index":7,"tongjian_id":"9058389e-db0e-11ef-8e22-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2徙郡國豪桀于茂陵。","content_fanyi":"汉武帝强制各郡国的豪杰迁往茂陵。","content_jianti_auto":"2徙郡国豪桀于茂陵。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1786,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9058389d-db0e-11ef-ad45-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3夏，六月，赦天下。","content_fanyi":"夏季，六月，大赦天下。","content_jianti_auto":"3夏，六月，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1787,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9058389f-db0e-11ef-af6d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":7,"tongjian_id":"905838a3-db0e-11ef-ad54-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":0,"tongjian_id":"905838a4-db0e-11ef-b08d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"匈奴二十四長，左賢王位第一，左大將位第五。長，知兩翻。","note_content_jianti_auto":"匈奴二十四长，左贤王位第一，左大将位第五。长，知两翻。","note_type":"hu_note","start_index":29,"tongjian_id":"905838a2-db0e-11ef-82bd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"905838a6-db0e-11ef-b907-a0d3651f611f"},{"people_name":"日逐王","people_name_jianti_auto":"日逐王","start_index":9,"tongjian_id":"905838a7-db0e-11ef-8dc6-a0d3651f611f"},{"people_name":"宣帝","people_name_jianti_auto":"宣帝","start_index":30,"tongjian_id":"905838a8-db0e-11ef-afbd-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","start_index":13,"tongjian_id":"905838a9-db0e-11ef-aad9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：撣，音廛。日逐王居匈奴西邊，以日入於西，故以爲名。至宣帝神爵二年，撣來降。","note_content_jianti_auto":"师古曰：掸，音廛。日逐王居匈奴西边，以日入于西，故以为名。至宣帝神爵二年，掸来降。","note_type":"hu_note","start_index":150,"tongjian_id":"905838a5-db0e-11ef-b511-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"左賢王","official_note":"左賢王是匈奴官職，通常由單于的兒子或近親擔任，負責管理左翼部落和軍事事務，在匈奴政治中地位崇高，常被視為單于的繼承人。在上下文中，左賢王是且鞮侯單于的長子，後因未及時到達而被更立，最終狐鹿姑單于自以其子為左賢王，顯示此職在繼承爭議中的關鍵作用。","official_rank":"未知","source_snippet":"長爲左賢王","start_index":15,"tongjian_id":"69134b47-98b4-4eab-bfa4-4558fe0065e4"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"左大將","official_note":"左大將是匈奴官職，屬於高級軍事將領，負責指揮左翼軍隊。在上下文中，左大將是且鞮侯單于的次子，後被更立為單于，並讓位給左賢王，顯示此職在匈奴權力過渡中的重要性。","official_rank":"未知","source_snippet":"次爲左大將","start_index":20,"tongjian_id":"ec9765c8-0b08-494d-9c22-c66aa4643a2b"},{"confidence":0.98,"official_category":"地方行政","official_name":"單于","official_note":"單于是匈奴的最高統治者，相當於漢朝的皇帝，負責全族政治、軍事和外交事務。在上下文中，且鞮侯單于死後，左大將被更立為單于，後讓位給左賢王成為狐鹿姑單于，顯示單于職位的繼承過程。","official_rank":"最高統治者","source_snippet":"更立左大將爲單于","start_index":40,"tongjian_id":"b668762a-8b52-49aa-a8a8-b2b50133db8b"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"左賢王","official_note":"此處左賢王是狐鹿姑單于任命左大將擔任的職位，延續其作為匈奴高級官職和潛在繼承人的角色。","official_rank":"未知","source_snippet":"以左大將爲左賢王","start_index":95,"tongjian_id":"63073a1c-58dc-4407-8a83-c068b1599538"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"日逐王","official_note":"日逐王是匈奴官職，通常負責管理特定部落或地區，屬於王級職位。在上下文中，先賢撣因左賢王病死而不得代，被更立為日逐王，顯示匈奴官職的調整和繼承安排。","official_rank":"未知","source_snippet":"更以爲日逐王","start_index":115,"tongjian_id":"3633ef8f-f004-45c1-8dc8-a68d8369aa92"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"左賢王","official_note":"此處左賢王是狐鹿姑單于任命自己的兒子擔任，強調此職在單于家族中的世襲性和政治重要性。","official_rank":"未知","source_snippet":"單于自以其子爲左賢王","start_index":135,"tongjian_id":"227cfede-181d-400f-a92d-39e58eb1b4f9"}],"ExtRef_Children_people":[{"link_death_year":-96,"link_td_description":"且鞮侯单于，为亚洲古匈奴的君主之一，伊稚斜单于之子，乌维单于之弟，他于前101年接任呴犁湖单于担任匈奴单于，前96年卒于任。","link_td_id":"Q10000779","link_td_number_id":356580,"people_name":"且鞮侯單于","people_name_jianti_auto":"且鞮侯单于","people_xingming":"且鞮侯单于","start_index":6,"tongjian_id":"905838aa-db0e-11ef-8486-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","people_xingming":"左贤王","start_index":19,"tongjian_id":"905838ac-db0e-11ef-9d99-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":29,"tongjian_id":"905838ad-db0e-11ef-bb60-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":51,"tongjian_id":"905838ae-db0e-11ef-8354-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":67,"tongjian_id":"905838af-db0e-11ef-a333-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":75,"tongjian_id":"905838b0-db0e-11ef-8460-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":103,"tongjian_id":"905838b1-db0e-11ef-8aea-a0d3651f611f"},{"link_death_year":-85,"link_td_description":"狐鹿姑单于（－前85年），为亚洲古匈奴的君主之一，他于前96年接任父亲且鞮侯单于担任匈奴单于，前85年卒于任。","link_td_id":"Q10000780","link_td_number_id":356581,"people_name":"狐鹿姑單于","people_name_jianti_auto":"狐鹿姑单于","people_xingming":"狐鹿姑单于","start_index":113,"tongjian_id":"905838b2-db0e-11ef-b3ec-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":124,"tongjian_id":"905838b3-db0e-11ef-9c7b-a0d3651f611f"},{"link_death_year":-34,"link_td_description":"先贤掸，匈奴日逐王，栾提氏，左大将之子，车犁单于之弟。前60年率部归顺汉朝，被封为归德侯。","link_td_id":"Q10003761","link_td_number_id":4340513,"people_name":"先賢撣","people_name_jianti_auto":"先贤掸","people_xingming":"先贤掸","start_index":136,"tongjian_id":"905838b4-db0e-11ef-9257-a0d3651f611f"},{"link_death_year":-34,"link_td_description":"先贤掸，匈奴日逐王，栾提氏，左大将之子，车犁单于之弟。前60年率部归顺汉朝，被封为归德侯。","link_td_id":"Q10003761","link_td_number_id":4340513,"people_name":"日逐王","people_name_jianti_auto":"日逐王","people_xingming":"日逐王","start_index":146,"tongjian_id":"905838b5-db0e-11ef-9b97-a0d3651f611f"},{"people_name":"左賢王","people_name_jianti_auto":"左贤王","start_index":157,"tongjian_id":"905838b6-db0e-11ef-8cc6-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"905838a0-db0e-11ef-93e8-a0d3651f611f","pinyin":"dī","source_anchor_text":"歲匈奴且鞮侯單于死","source_key":"baiyang_epub","start_index":7,"text":"鞮","tongjian_id":"1eb8c59a-d264-57ac-9781-85e83d90b9b8"}],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":4,"tongjian_id":"905838ab-db0e-11ef-b8c1-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"4是歲，匈奴且鞮侯單于死；有兩子，長爲左賢王，次爲左大將。左賢王未至，貴人以爲有病，更立左大將爲單于。左賢王聞之，不敢進；左大將使人召左賢王而讓位焉。左賢王辭以病，左大將不聽，謂曰：「卽不幸死，傳之於我。」左賢王許之，遂立，爲狐鹿姑單于；以左大將爲左賢王，數年，病死；其子先賢撣不得代，更以爲日逐王。單于自以其子爲左賢王。","content_fanyi":"这一年，匈奴且鞮侯单于去世。他有两个儿子，长子是左贤王，次子是左大将。左贤王未能及时赶回，匈奴贵族们以为他有病，便改立左大将为单于。左贤王听说此事，不敢到王庭来；左大将派人召请左贤王，要把单于之位让给他。左贤王以生病为由推辞，左大将不肯答应，对他说：“如果你不幸去世，就把王位传给我。”左贤王答应了，于是即位，成为狐鹿姑单于；任命左大将为左贤王，过了几年，左贤王病死；他的儿子先贤掸未能继承左贤王之位，被改封为日逐王。单于立自己的儿子为左贤王。","content_jianti_auto":"4是岁，匈奴且鞮侯单于死；有两子，长为左贤王，次为左大将。左贤王未至，贵人以为有病，更立左大将为单于。左贤王闻之，不敢进；左大将使人召左贤王而让位焉。左贤王辞以病，左大将不听，谓曰：「即不幸死，传之于我。」左贤王许之，遂立，为狐鹿姑单于；以左大将为左贤王，数年，病死；其子先贤掸不得代，更以为日逐王。单于自以其子为左贤王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1788,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"905838a0-db0e-11ef-93e8-a0d3651f611f"}],"reign_name":"太始元年","reign_name_jianti_auto":"太始元年","start_index":2,"tongjian_id":"90583895-db0e-11ef-bd8f-a0d3651f611f","year_anno":"（乙酉、前九六）","year_int":-96},"message":"success","success":true}