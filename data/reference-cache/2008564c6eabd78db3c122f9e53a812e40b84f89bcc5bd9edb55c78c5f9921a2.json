b0e-11ef-b0b5-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":47,"tongjian_id":"8bf42b00-db0e-11ef-8900-a0d3651f611f"},{"place_name":"定州","place_name_jianti_auto":"定州","start_index":48,"tongjian_id":"8bf42b01-db0e-11ef-afd3-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":51,"tongjian_id":"8bf42b02-db0e-11ef-82a0-a0d3651f611f"},{"place_name":"白狄","place_name_jianti_auto":"白狄","start_index":53,"tongjian_id":"8bf42b03-db0e-11ef-a829-a0d3651f611f"},{"place_name":"鮮虞","place_name_jianti_auto":"鲜虞","start_index":55,"tongjian_id":"8bf42b04-db0e-11ef-8253-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","place_note":"都顾城，河北定州","start_index":65,"tongjian_id":"8bf42b05-db0e-11ef-8867-a0d3651f611f"},{"place_name":"唐昌縣","place_name_jianti_auto":"唐昌县","start_index":70,"tongjian_id":"8bf42b06-db0e-11ef-801a-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","place_note":"都顾城，河北定州","start_index":80,"tongjian_id":"8bf42b07-db0e-11ef-89fa-a0d3651f611f"},{"place_name":"中山","place_name_jianti_auto":"中山","start_index":98,"tongjian_id":"8bf42b08-db0e-11ef-b3ea-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"樂，姓也。本自有殷微子之後。宋戴公四世孫樂呂爲大司寇。中山，春秋之鮮虞也，漢爲中山郡。宋白曰：唐定州，春秋白狄鮮虞之地。隋圖經曰：中山城在今唐昌縣東北三十一里，中山故城是也。杜佑曰：城中有山，故曰中山。","note_content_jianti_auto":"乐，姓也。本自有殷微子之后。宋戴公四世孙乐吕为大司寇。中山，春秋之鲜虞也，汉为中山郡。宋白曰：唐定州，春秋白狄鲜虞之地。隋图经曰：中山城在今唐昌县东北三十一里，中山故城是也。杜佑曰：城中有山，故曰中山。","note_type":"hu_note","start_index":10,"tongjian_id":"8bf42af3-db0e-11ef-bc61-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"任座","people_name_jianti_auto":"任座","start_index":0,"tongjian_id":"8bf42b0b-db0e-11ef-afae-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"任座亦習見當時鄰國之事而爲是言耳。任，音壬。「座」一作「痤」，音才戈翻。","note_content_jianti_auto":"任座亦习见当时邻国之事而为是言耳。任，音壬。「座」一作「痤」，音才戈翻。","note_type":"hu_note","start_index":77,"tongjian_id":"8bf42b0a-db0e-11ef-9954-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"翟","people_name_jianti_auto":"翟","start_index":0,"tongjian_id":"8bf42b0d-db0e-11ef-b4db-a0d3651f611f"},{"people_name":"翟","people_name_jianti_auto":"翟","start_index":17,"tongjian_id":"8bf42b0e-db0e-11ef-9783-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":19,"tongjian_id":"8bf42b0f-db0e-11ef-8d4c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"翟，姓也，音直格翻，又音狄。姓譜：翟爲晉所滅，子孫以國爲氏。今人多讀從上音。璜，戶光翻。","note_content_jianti_auto":"翟，姓也，音直格翻，又音狄。姓谱：翟为晋所灭，子孙以国为氏。今人多读从上音。璜，户光翻。","note_type":"hu_note","start_index":82,"tongjian_id":"8bf42b0c-db0e-11ef-87da-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"乐羊，中山国人，战国时魏国的大将。是乐毅的先祖。","link_td_id":"Q10000064","link_td_number_id":2106,"people_name":"樂羊","people_name_jianti_auto":"乐羊","people_xingming":"乐羊","start_index":1,"tongjian_id":"8bf42b11-db0e-11ef-80a3-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/中山宜阳","excerpts":[{"context_after":"。故任座云：“君得中山不以封君之弟，而以封君之子。”翟璜...","context_before":"战国事杂出于诸书，故有不可考信者。","source_end_index":34,"source_paragraph_tongjian_id":"899ca649-bbb0-4456-a935-4efcdb628196","source_start_index":17,"source_text":"魏文侯使乐羊伐中山，克之，以封其子"}],"path":"续笔/卷四/中山宜阳","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/四、真定府（卷十四）","excerpts":[{"context_after":"秦属巨鹿郡。汉为新市县。景帝封王弃之为侯邑，属中山国。魏...","context_before":"...中，晋荀寅谓中山不服。哀三年，齐卫求援于中山，即鲜虞也。","source_end_index":112,"source_paragraph_tongjian_id":"41366cbc-babd-53c9-b4e4-b1616ca2baff","source_start_index":85,"source_text":"战国时，乐羊为魏文侯将，攻中山，三年而克之。没为赵地。"},{"context_after":"又赵惠文王二年，主父起灵寿北地，方从代道大通。汉因置灵寿...","context_before":"○灵寿城[在今县城东。《汉志》：中山桓公徙都灵寿。","source_end_index":48,"source_paragraph_tongjian_id":"901a297e-c146-5545-8081-082ee60b339d","source_start_index":25,"source_text":"《史记》：乐羊为魏文侯将，攻拔中山，封之灵寿。"},{"context_after":"赵武灵王伐取之]。秦为上谷、巨鹿二郡地。汉初置中山郡，景...","context_before":"春秋时鲜虞国地。战国初为中山国，寻为魏所并，后又属赵[","source_end_index":51,"source_paragraph_tongjian_id":"1130cfac-da26-5df4-8bd6-afcf4f6b94e5","source_start_index":27,"source_text":"魏文侯时，使乐羊伐中山，取之。既而中山复有其地。"}],"path":"北直方舆纪要/四、真定府（卷十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"使樂羊伐中山，克之；以封其子擊。文侯問於羣臣曰：「我何如主？」皆曰：「仁君。」任座曰：「君得中山，不以封君之弟而以封君之子，何謂仁君！」文侯怒，任座趨出。次問翟璜，對曰：「仁君。」文侯曰：「何以知之？」對曰：「臣聞君仁則臣直。嚮者任座之言直，臣是以知之。」文侯悅，使翟璜召任座而反之，親下堂迎之，以爲上客。","content_fanyi":"魏文侯派乐羊攻打中山国，攻克了它；把它封给自己的儿子魏击。魏文侯问群臣说：“我是怎样的君主？”大家都说：“是仁君。”任座说：“您取得了中山，不把它封给您的弟弟，却封给自己的儿子，怎么能说是仁君！”魏文侯大怒，任座急忙退出朝堂。魏文侯接着问翟璜，翟璜回答说：“是仁君。”魏文侯问：“你凭什么知道我是仁君？”翟璜回答说：“我听说国君仁爱，臣子就正直。刚才任座的话正直，我因此知道您是仁君。”魏文侯很高兴，派翟璜去召任座回朝堂，并亲自下堂迎接他，待他为上客。","content_jianti_auto":"使乐羊伐中山，克之；以封其子击。文侯问于群臣曰：「我何如主？」皆曰：「仁君。」任座曰：「君得中山，不以封君之弟而以封君之子，何谓仁君！」文侯怒，任座趋出。次问翟璜，对曰：「仁君。」文侯曰：「何以知之？」对曰：「臣闻君仁则臣直。向者任座之言直，臣是以知之。」文侯悦，使翟璜召任座而反之，亲下堂迎之，以为上客。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 23 段","reading_annotation_sources":[],"start_index":22,"tongjian_id":"8bf42af2-db0e-11ef-899a-a0d3651f611f","year_int":-403,"zhang_TJZJ_id":"zttjzj_000342"},"tongjian_id":"8bf42af2-db0e-11ef-899a-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":0,"tongjian_id":"8bf6767b-db0e-11ef-90eb-a0d3651f611f"},{"people_name":"顓頊","people_name_jianti_auto":"颛顼","start_index":4,"tongjian_id":"8bf6767c-db0e-11ef-9555-a0d3651f611f"},{"people_name":"皋陶","people_name_jianti_auto":"皋陶","start_index":8,"tongjian_id":"8bf6767d-db0e-11ef-af6b-a0d3651f611f"},{"people_name":"堯","people_name_jianti_auto":"尧","start_index":12,"tongjian_id":"8bf6767e-db0e-11ef-af11-a0d3651f611f"},{"people_name":"理氏","people_name_jianti_auto":"理氏","start_index":21,"tongjian_id":"8bf6767f-db0e-11ef-9088-a0d3651f611f"},{"people_name":"商紂","people_name_jianti_auto":"商纣","start_index":24,"tongjian_id":"8bf67680-db0e-11ef-a6ff-a0d3651f611f"},{"people_name":"利貞","people_name_jianti_auto":"利贞","start_index":30,"tongjian_id":"8bf67681-db0e-11ef-afdf-a0d3651f611f"},{"people_name":"李氏","people_name_jianti_auto":"李氏","start_index":43,"tongjian_id":"8bf67682-db0e-11ef-8898-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李氏出自顓頊曾孫皋陶，爲堯大理，以官命族爲理氏。商紂時，裔孫利貞逃難，食木子得全，改爲李氏。置，言置相也。相，息亮翻。難，乃旦翻。","note_content_jianti_auto":"李氏出自颛顼曾孙皋陶，为尧大理，以官命族为理氏。商纣时，裔孙利贞逃难，食木子得全，改为李氏。置，言置相也。相，息亮翻。难，乃旦翻。","note_type":"hu_note","start_index":43,"tongjian_id":"8bf6767a-db0e-11ef-bf9d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"在闕門之外，謂疏遠也。","note_content_jianti_auto":"在阙门之外，谓疏远也。","note_type":"hu_note","start_index":70,"tongjian_id":"8bf67683-db0e-11ef-9270-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8bf67686-db0e-11ef-80f9-a0d3651f611f"},{"people_name":"吳起","people_name_jianti_auto":"吴起","start_index":50,"tongjian_id":"8bf67687-db0e-11ef-9fca-a0d3651f611f"},{"people_name":"惠王","people_name_jia