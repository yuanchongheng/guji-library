"96e12805-db0e-11ef-af59-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"96e1280d-db0e-11ef-ade2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"安定屬國","place_name_jianti_auto":"安定属国","start_index":19,"tongjian_id":"96e1280e-db0e-11ef-b747-a0d3651f611f"},{"place_name":"三水縣","place_name_jianti_auto":"三水县","start_index":26,"tongjian_id":"96e1280f-db0e-11ef-8a6b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：屬國都尉，其秩比二千石。水經註：安定屬國都尉治三水縣。","note_content_jianti_auto":"贤曰：属国都尉，其秩比二千石。水经注：安定属国都尉治三水县。","note_type":"hu_note","start_index":45,"tongjian_id":"96e1280c-db0e-11ef-af85-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"蒙恬","people_name_jianti_auto":"蒙恬","start_index":3,"tongjian_id":"96e12812-db0e-11ef-8130-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":2,"tongjian_id":"96e12813-db0e-11ef-a541-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":11,"tongjian_id":"96e12814-db0e-11ef-9a96-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"此卽秦蒙恬所築長城，在上郡界。","note_content_jianti_auto":"此即秦蒙恬所筑长城，在上郡界。","note_type":"hu_note","start_index":87,"tongjian_id":"96e12811-db0e-11ef-b6e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":18,"tongjian_id":"96e12816-db0e-11ef-9752-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"上郡","place_name_jianti_auto":"上郡","start_index":3,"tongjian_id":"96e12817-db0e-11ef-99b4-a0d3651f611f"},{"place_name":"龜茲縣","place_name_jianti_auto":"龟兹县","start_index":5,"tongjian_id":"96e12818-db0e-11ef-bbe0-a0d3651f611f"},{"place_name":"上郡屬國","place_name_jianti_auto":"上郡属国","start_index":9,"tongjian_id":"96e12819-db0e-11ef-bedf-a0d3651f611f"},{"place_name":"龜茲國","place_name_jianti_auto":"龟兹国","start_index":22,"tongjian_id":"96e1281a-db0e-11ef-9026-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"前書，上郡龜茲縣，上郡屬國都尉治所。師古曰：龜茲國人來降附者處之於此，故以名云。","note_content_jianti_auto":"前书，上郡龟兹县，上郡属国都尉治所。师古曰：龟兹国人来降附者处之于此，故以名云。","note_type":"hu_note","start_index":107,"tongjian_id":"96e12815-db0e-11ef-b501-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":6,"tongjian_id":"96e1281d-db0e-11ef-a3b2-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":9,"tongjian_id":"96e1281e-db0e-11ef-8641-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"遺，于季翻。賢曰：郭璞註山海經云：鐻，音渠，金食器名，未詳形制也。韻書曰：鐻，戎夷貫耳。","note_content_jianti_auto":"遗，于季翻。贤曰：郭璞注山海经云：鐻，音渠，金食器名，未详形制也。韵书曰：鐻，戎夷贯耳。","note_type":"hu_note","start_index":163,"tongjian_id":"96e1281c-db0e-11ef-8e34-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"96e12822-db0e-11ef-bca6-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：以酒沃地謂之酹，音力外翻。余謂蓋自誓也。","note_content_jianti_auto":"贤曰：以酒沃地谓之酹，音力外翻。余谓盖自誓也。","note_type":"hu_note","start_index":172,"tongjian_id":"96e12821-db0e-11ef-868d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"安定屬國都尉","official_note":"安定屬國都尉是漢代在邊疆地區設置的官職，負責管理歸附的少數民族事務，此處張奐擔任此職，負責處理南匈奴和東羌的叛亂，體現其軍事和行政職能。","official_rank":"未知","source_snippet":"安定屬國都尉敦煌張奐初到職","start_index":34,"tongjian_id":"3c7a333b-172c-4b0c-b074-7a47bebea431"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"都尉","official_note":"都尉是漢代地方軍事長官，常負責郡級或邊疆的防務和治安，此處指之前擔任類似職務的官員，與張奐形成對比，強調其清廉。","official_rank":"未知","source_snippet":"前此八都尉率好財貨","start_index":195,"tongjian_id":"aee16e7a-e453-418a-a1fd-11b83b891e79"}],"ExtRef_Children_people":[{"people_name":"左薁鞬","people_name_jianti_auto":"左薁鞬","people_xingming":"左薁鞬","start_index":6,"tongjian_id":"96e1fc77-db0e-11ef-b73c-a0d3651f611f"},{"people_name":"臺耆","people_name_jianti_auto":"台耆","people_xingming":"臺耆","start_index":9,"tongjian_id":"96e1fc78-db0e-11ef-a0c3-a0d3651f611f"},{"people_name":"且渠伯德","people_name_jianti_auto":"且渠伯德","people_xingming":"且渠伯德","start_index":12,"tongjian_id":"96e1fc79-db0e-11ef-ae49-a0d3651f611f"},{"link_birth_year":104,"link_death_year":181,"link_td_description":"张奂，字然明，敦煌郡渊泉人，东汉名将。与段熲、皇甫规并称“凉州三明”。","link_td_id":"Q10007200","link_td_number_id":1496348,"people_name":"張奐","people_name_jianti_auto":"张奂","people_xingming":"張奐","start_index":39,"tongjian_id":"96e1fc7d-db0e-11ef-bcd6-a0d3651f611f"},{"link_birth_year":104,"link_death_year":181,"link_td_description":"张奂，字然明，敦煌郡渊泉人，东汉名将。与段熲、皇甫规并称“凉州三明”。","link_td_id":"Q10007200","link_td_number_id":1496348,"people_name":"奐","people_name_jianti_auto":"奂","people_xingming":"張奐","start_index":77,"tongjian_id":"96e1fc80-db0e-11ef-8165-a0d3651f611f"},{"people_name":"王衞","people_name_jianti_auto":"王衞","people_xingming":"王衞","start_index":94,"tongjian_id":"96e1fc81-db0e-11ef-9775-a0d3651f611f"},{"link_birth_year":104,"link_death_year":181,"link_td_description":"张奂，字然明，敦煌郡渊泉人，东汉名将。与段熲、皇甫规并称“凉州三明”。","link_td_id":"Q10007200","link_td_number_id":1496348,"people_name":"奐","people_name_jianti_auto":"奂","people_xingming":"張奐","start_index":124,"tongjian_id":"96e1fc84-db0e-11ef-aa1d-a0d3651f611f"},{"link_death_year":50,"link_t