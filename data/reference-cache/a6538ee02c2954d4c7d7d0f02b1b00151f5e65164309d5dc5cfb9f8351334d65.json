ef_Children_zhang_notes":[],"note_content":"應劭曰：始取天下者曰祖，高帝稱高祖是也。始治天下者曰宗，文帝稱太宗是也。師古曰：應說非也。祖，始也，始受命也。宗，尊也，有德可尊。貢父曰：顏說非也。始受命稱太祖耳；有功亦稱祖，商祖甲是也。","note_content_jianti_auto":"应劭曰：始取天下者曰祖，高帝称高祖是也。始治天下者曰宗，文帝称太宗是也。师古曰：应说非也。祖，始也，始受命也。宗，尊也，有德可尊。贡父曰：颜说非也。始受命称太祖耳；有功亦称祖，商祖甲是也。","note_type":"hu_note","start_index":88,"tongjian_id":"8f0ee5e3-db0e-11ef-a5df-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，此处指申屠嘉等官员上奏建议。","official_rank":"正一品","source_snippet":"丞相嘉等奏","start_index":6,"tongjian_id":"a21b662f-849e-410b-8a61-f70e62d5f1b1"}],"ExtRef_Children_people":[{"link_death_year":-155,"link_td_description":"申屠嘉，西汉初期大臣，西汉时梁（治今安徽砀山）人。","link_td_id":"Q10013013","link_td_number_id":1547141,"people_name":"嘉","people_name_jianti_auto":"嘉","people_xingming":"申屠嘉","start_index":8,"tongjian_id":"8f0ee5ee-db0e-11ef-9994-a0d3651f611f","wl_zhushi":"[申屠嘉]"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高皇帝","people_name_jianti_auto":"高皇帝","people_xingming":"刘邦","start_index":17,"tongjian_id":"8f0ee5ef-db0e-11ef-9ae9-a0d3651f611f","wl_zhushi":"[刘邦]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"孝文皇帝","people_name_jianti_auto":"孝文皇帝","people_xingming":"刘恒","start_index":25,"tongjian_id":"8f0ee5f0-db0e-11ef-93b3-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"太祖","people_name_jianti_auto":"太祖","people_xingming":"null","start_index":39,"tongjian_id":"8f0ee5f1-db0e-11ef-9816-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"太宗","people_name_jianti_auto":"太宗","people_xingming":"null","start_index":54,"tongjian_id":"8f0ee5f2-db0e-11ef-acd1-a0d3651f611f"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"孝文皇帝","people_name_jianti_auto":"孝文皇帝","start_index":77,"tongjian_id":"8f0ee5f3-db0e-11ef-8a1c-a0d3651f611f","wl_zhushi":"[刘恒]"},{"link_birth_year":-202,"link_death_year":-157,"link_td_description":"汉文帝刘恒，中国汉朝（西汉）初期皇帝，于公元前180年至前157年在位，共23年，庙号太宗，正式谥号为“孝文皇帝”，后世省略“孝”字称为“汉文帝”。其系汉高祖刘邦第四子，母亲是汉高祖薄姬（即薄太后），墓葬是汉霸陵（位于今陕西省西安市灞桥区白鹿原）。汉文帝是中国历史上第一位经由推选出来的皇帝，也是一位贤良、节俭、恤民及治国有方的君主，与其子汉景帝共同创造了中国历史上大一统时代的首个盛世“文景之治”。","link_td_id":"Q10000348","link_td_number_id":38105,"people_name":"太宗","people_name_jianti_auto":"太宗","people_xingming":"null","start_index":82,"tongjian_id":"8f0ee5f4-db0e-11ef-bae1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高皇帝廟","place_name_jianti_auto":"高皇帝庙","resolved_place_entity_id":9930,"start_index":30,"tongjian_id":"8f0ee5f5-db0e-11ef-bf08-a0d3651f611f"},{"place_name":"孝文皇帝廟","place_name_jianti_auto":"孝文皇帝庙","resolved_place_entity_id":6535,"start_index":44,"tongjian_id":"8f0ee5f6-db0e-11ef-9b3b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"1冬，十月，丞相嘉等奏：「功莫大於高皇帝，德莫盛於孝文皇帝。高皇帝廟，宜爲帝者太祖之廟；孝文皇帝廟，宜爲帝者太宗之廟。天子宜世世獻祖宗之廟，郡國諸侯宜各爲孝文皇帝立太宗之廟。」制曰：「可。」","content_fanyi":"冬季，十月，丞相申屠嘉等大臣上奏说：“功勋没有比高皇帝更大的，德行没有比孝文皇帝更盛的。高皇帝的庙，应当作为本朝皇帝宗庙中的太祖庙；孝文皇帝的庙，应当作为本朝皇帝宗庙中的太宗庙。后世天子应当世世代代供奉太祖、太宗之庙，各郡和各国诸侯应当各自在当地为孝文皇帝修建太宗庙。”汉景帝下制批复说：“可以。”","content_jianti_auto":"1冬，十月，丞相嘉等奏：「功莫大于高皇帝，德莫盛于孝文皇帝。高皇帝庙，宜为帝者太祖之庙；孝文皇帝庙，宜为帝者太宗之庙。天子宜世世献祖宗之庙，郡国诸侯宜各为孝文皇帝立太宗之庙。」制曰：「可。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":1224,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f0ee5e2-db0e-11ef-bff0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2夏，四月，乙卯，赦天下。","content_fanyi":"夏季，四月二十二日乙卯，景帝大赦天下。","content_jianti_auto":"2夏，四月，乙卯，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1225,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f0ee5f7-db0e-11ef-9c50-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"開封侯","people_name_jianti_auto":"开封侯","start_index":0,"tongjian_id":"8f0ee5fa-db0e-11ef-9d28-a0d3651f611f"},{"people_name":"陶青","people_name_jianti_auto":"陶青","start_index":3,"tongjian_id":"8f0ee5fb-db0e-11ef-8049-a0d3651f611f"},{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":6,"tongjian_id":"8f0ee5fc-db0e-11ef-bbc9-a0d3651f611f"},{"people_name":"陶舍","pe