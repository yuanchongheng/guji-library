k_td_id":"Q10003024","link_td_number_id":1628877,"people_name":"公叔","people_name_jianti_auto":"公叔","people_xingming":"公叔痤","start_index":195,"tongjian_id":"8c24f5dd-db0e-11ef-b567-a0d3651f611f"},{"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","start_index":210,"tongjian_id":"8c24f5de-db0e-11ef-8d3d-a0d3651f611f"},{"people_name":"衞鞅","people_name_jianti_auto":"衞鞅","start_index":228,"tongjian_id":"8c24f5df-db0e-11ef-aede-a0d3651f611f"},{"link_td_description":"景监，生卒年不详，景氏，战国时期秦国宦官，多次向秦孝公举荐商鞅，使其得到重用。","link_td_id":"Q10015145","link_td_number_id":3343322,"people_name":"景監","people_name_jianti_auto":"景监","people_xingming":"景监","start_index":237,"tongjian_id":"8c24f5e0-db0e-11ef-ae1f-a0d3651f611f"},{"link_birth_year":-382,"link_death_year":-338,"link_td_description":"秦孝公，战国时期秦国君主，秦献公之子，前362年－前338年在位，在位共25年。","link_td_id":"Q10001805","link_td_number_id":139181,"people_name":"孝公","people_name_jianti_auto":"孝公","people_xingming":"嬴渠梁","start_index":242,"tongjian_id":"8c24f5e1-db0e-11ef-bb95-a0d3651f611f","wl_zhushi":"[嬴渠梁]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"衞","place_name_jianti_auto":"衞","resolved_place_entity_id":613,"start_index":5,"tongjian_id":"8c24baf7-db0e-11ef-9384-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":18,"tongjian_id":"8c24bafc-db0e-11ef-8dc4-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":232,"tongjian_id":"8c24f5e2-db0e-11ef-82da-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"河西之战（后期）","tongjian_id":"war_N0507"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/秦用他国人","excerpts":[{"context_after":"。其它若楼缓赵人，张仪、魏冉、范睢皆魏人，蔡泽燕人，吕不...","context_before":"...仲、公叔，赵之奉阳、平原君，魏王至以太子为相。独秦不然，","source_end_index":92,"source_paragraph_tongjian_id":"6e15c2e4-f2d3-4bfd-b268-aaf88f22dfd7","source_start_index":74,"source_text":"其始与之谋国以开霸业者，魏人公孙鞅也"}],"path":"随笔/卷二/秦用他国人","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"其尽得河西，则犀首张仪之力也]。《吕氏春秋》：吴起去西河...","context_before":"...摎留谓韩王，魏两用犀首张仪，而西河之外亡。是也[吕氏曰：","source_end_index":442,"source_paragraph_tongjian_id":"8e5a0768-dfec-539f-9b20-8e795d4ab86a","source_start_index":430,"source_text":"秦孝公用商鞅，取河西地。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"公孫鞅者，衞之庶孫也。好刑名之學。事魏相公叔痤，痤知其賢，未及進。會病，魏惠王往問之曰：「公叔病如有不可諱，將柰社稷何？」公叔曰：「痤之中庶子衞鞅，年雖少，有奇才，願君舉國而聽之！」王嘿然。公叔曰：「君卽不聽用鞅，必殺之，無令出境！」王許諾而去。公叔召鞅謝曰：「吾先君而後臣，故先爲君謀，後以告子。子必速行矣！」鞅曰：「君不能用子之言任臣，又安能用子之言殺臣乎！」卒不去。王出，謂左右曰：「公叔病甚，悲乎，欲令寡人以國聽衞鞅也！旣又勸寡人殺之，豈不悖哉！」衞鞅旣至秦，因嬖臣景監以求見孝公，說以富國強兵之術；公大悅，與議國事。","content_fanyi":"公孙鞅，是卫侯的庶出孙辈。他爱好法家刑名之学。他侍奉魏国宰相公叔痤，公叔痤知道他贤能，但还没有来得及向国君推荐进用。恰逢公叔痤生病，魏惠王前去探望，问他说：“公叔万一有什么不测，国家该怎么办？”公叔痤说：“我手下的中庶子卫鞅，年纪虽轻，却有奇才，希望您把整个国家都交给他治理！”魏惠王沉默不语。公叔痤又说：“您如果不听从我的建议任用卫鞅，就一定要杀掉他，不要让他离开国境！”魏惠王答应后便离去了。公叔痤把卫鞅叫来，向他谢罪说：“我应当先为国君着想，再为臣下着想，所以先替国君出主意杀掉你，之后才把话告诉你。你一定要赶快逃走！”卫鞅说：“国君不能采用您的话任用我，又怎能采用您的话杀掉我呢？”最终没有逃离。魏惠王出来以后，对左右近臣说：“公叔痤病得这么重，真是可悲啊！他竟想让寡人把国家大权交给卫鞅，随后又劝寡人杀掉他，这难道不是荒谬吗！”卫鞅到了秦国以后，通过宠臣景监求见秦孝公，向他游说富国强兵的策略；秦孝公大为高兴，与他商议国家大事。","content_jianti_auto":"公孙鞅者，衞之庶孙也。好刑名之学。事魏相公叔痤，痤知其贤，未及进。会病，魏惠王往问之曰：「公叔病如有不可讳，将柰社稷何？」公叔曰：「痤之中庶子衞鞅，年虽少，有奇才，愿君举国而听之！」王嘿然。公叔曰：「君即不听用鞅，必杀之，无令出境！」王许诺而去。公叔召鞅谢曰：「吾先君而后臣，故先为君谋，后以告子。子必速行矣！」鞅曰：「君不能用子之言任臣，又安能用子之言杀臣乎！」卒不去。王出，谓左右曰：「公叔病甚，悲乎，欲令寡人以国听衞鞅也！既又劝寡人杀之，岂不悖哉！」衞鞅既至秦，因嬖臣景监以求见孝公，说以富国强兵之术；公大悦，与议国事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":125,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c22eb11-db0e-11ef-bc51-a0d3651f611f"}],"reign_name":"八年","reign_name_jianti_auto":"八年","start_index":5,"tongjian_id":"8c20515b-db0e-11ef-aada-a0d3651f611f","year_anno":"（庚申、前三六一）","year_int":-361},"message":"success","success":true}