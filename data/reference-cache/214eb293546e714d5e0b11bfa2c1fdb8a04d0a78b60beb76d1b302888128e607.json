{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（癸未、前一五八）","note_content_jianti_auto":"（癸未、前一五八）","note_type":"hu_note","start_index":0,"tongjian_id":"8f0a4949-db0e-11ef-8ecc-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":0,"tongjian_id":"8f0a494c-db0e-11ef-b40a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"胡","place_name_jianti_auto":"胡","start_index":7,"tongjian_id":"8f0a494d-db0e-11ef-abbb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文穎曰：邊方備胡寇作高土，櫓上作桔槔，桔槔頭兜零，以薪草置其中，常低之。有寇，卽燃火舉之以相告，曰烽。又多積薪，寇至卽燃之，以望其煙，曰燧。","note_content_jianti_auto":"文颖曰：边方备胡寇作高土，橹上作桔槔，桔槔头兜零，以薪草置其中，常低之。有寇，即燃火举之以相告，曰烽。又多积薪，寇至即燃之，以望其烟，曰燧。","note_type":"hu_note","start_index":35,"tongjian_id":"8f0a494b-db0e-11ef-98cb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0a494f-db0e-11ef-ac47-a0d3651f611f"},{"people_name":"令","people_name_jianti_auto":"令","start_index":14,"tongjian_id":"8f0a4950-db0e-11ef-b7f2-a0d3651f611f"},{"people_name":"免","people_name_jianti_auto":"免","start_index":16,"tongjian_id":"8f0a4951-db0e-11ef-be2c-a0d3651f611f"},{"people_name":"徐厲","people_name_jianti_auto":"徐厉","start_index":25,"tongjian_id":"8f0a4952-db0e-11ef-ac1e-a0d3651f611f"},{"people_name":"徐廣","people_name_jianti_auto":"徐广","start_index":3