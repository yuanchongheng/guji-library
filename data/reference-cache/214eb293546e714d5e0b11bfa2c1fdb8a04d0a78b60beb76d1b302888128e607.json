"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"之，往也。","note_content_jianti_auto":"之，往也。","note_type":"hu_note","start_index":147,"tongjian_id":"8f0a499d-db0e-11ef-8c0d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f0a49a0-db0e-11ef-891a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：先驅導駕，若今之武候隊矣。","note_content_jianti_auto":"师古曰：先驱导驾，若今之武候队矣。","note_type":"hu_note","start_index":177,"tongjian_id":"8f0a499f-db0e-11ef-85e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"禮，介者不拜。見，賢遍翻。","note_content_jianti_auto":"礼，介者不拜。见，贤遍翻。","note_type":"hu_note","start_index":315,"tongjian_id":"8f0a49a1-db0e-11ef-b592-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":9,"source_start_index":0,"source_text":"爲以亞夫屬太子張本","target_paragraph_tongjian_id":"8f23d989-db0e-11ef-b7a6-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"亞夫","people_name_jianti_auto":"亚夫","start_index":2,"tongjian_id":"8f0a49a6-db0e-11ef-9f6a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲以亞夫屬太子張本。","note_content_jianti_auto":"为以亚夫属太子张本。","note_type":"hu_note","start_index":436,"tongjian_id":"8f0a49a5-db0e-11ef-ba90-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢近臣","official_name":"中大夫令","official_note":"中大夫令是汉代官职，掌管宫廷事务，属于皇帝近臣。在原文中，免被任命为车骑将军，表明他从中大夫令转任军事职务，用于应对匈奴入侵。","official_rank":"未知","source_snippet":"以中大夫令免爲車騎將軍","start_index":28,"tongjian_id":"d44220bf-5627-4972-b64d-c491b5252476"},{"confidence":0.95,"official_category":"军事指挥","official_name":"車騎將軍","official_note":"车骑将军是汉代高级军事官职，负责指挥骑兵和车兵，常用于出征或防御。在原文中，免被任命为车骑将军，屯守飞狐，以防御匈奴入侵。","official_rank":"高级将领","source_snippet":"以中大夫令免爲車騎將軍","start_index":33,"tongjian_id":"8877c32a-08e2-4d53-b282-b92d0a882d3a"},{"confidence":0.9,"official_category":"地方行政","official_name":"楚相","official_note":"楚相是楚国（诸侯国）的丞相，负责管理楚国政务。在原文中，苏意曾任楚相，后被任命为将军，屯守句注，参与防御匈奴。","official_rank":"诸侯国相","source_snippet":"故楚相蘇意爲將軍","start_index":44,"tongjian_id":"bb36c7c7-1a39-4e4a-991f-c3dc564fe71f"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，苏意被任命为将军，屯守句注，用于防御匈奴入侵。","official_rank":"高级将领","source_snippet":"故楚相蘇意爲將軍","start_index":48,"tongjian_id":"52a895ff-b2b8-4c23-a3b6-6568ccf0e9be"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，张武作为将军屯守北地，参与防御匈奴入侵。","official_rank":"高级将领","source_snippet":"將軍張武屯北地","start_index":53,"tongjian_id":"77acb986-8b77-4d30-9933-ac6471e5fe0d"},{"confidence":0.95,"official_category":"地方行政","official_name":"河內太守","official_note":"河内太守是汉代地方官职，负责管理河内郡的行政事务。在原文中，周亚夫原为河内太守，后被任命为将军，屯守细柳，以防御匈奴入侵。","official_rank":"郡守","source_snippet":"河內太守周亞夫爲將軍","start_index":62,"tongjian_id":"fae8cbe2-a0aa-4afe-ac2d-6334c64d0f97"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，周亚夫被任命为将军，屯守细柳，用于防御匈奴入侵。","official_rank":"高级将领","source_snippet":"河內太守周亞夫爲將軍","start_index":68,"tongjian_id":"b9923661-8773-472b-8639-2af50cdeb8d0"},{"confidence":0.95,"official_category":"中枢机构","official_name":"宗正","official_note":"宗正是汉代九卿之一，负责管理皇族事务。在原文中，刘礼原为宗正，后被任命为将军，屯守霸上，参与防御匈奴入侵。","official_rank":"九卿之一","source_snippet":"宗正劉禮爲將軍","start_index":74,"tongjian_id":"c3ab8d94-e9c5-4e9b-8f13-d83e5d67f2d4"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，刘礼被任命为将军，屯守霸上，用于防御匈奴入侵。","official_rank":"高级将领","source_snippet":"宗正劉禮爲將軍","start_index":78,"tongjian_id":"11ee8c3d-9f99-47dc-bea3-e7153dfe6153"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，徐厉被任命为将军，屯守棘门，用于防御匈奴入侵。","official_rank":"高级将领","source_snippet":"祝茲侯徐厲爲將軍","start_index":85,"tongjian_id":"8b667eab-6865-4ec4-b26e-9c0ad19a9658"},{"confidence":0.9,"official_category":"军事指挥","official_name":"軍門都尉","official_note":"军门都尉是汉代军事官职，负责守卫军营大门和执行军令。在原文中，军门都尉在细柳军营执行周亚夫的命令，阻止天子先驱进入，体现了严格的军纪。","official_rank":"中级军官","source_snippet":"軍門都尉曰","start_index":176,"tongjian_id":"68825650-0191-47d4-9bb9-8e08a49887f1"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，指周亚夫作为将军下达军令，强调军中只听将军命令，不听天子诏书。","official_rank":"高级将领","source_snippet":"將軍令曰","start_index":180,"tongjian_id":"b5c03da5-41e7-4e8f-a82f-db472883217d"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，周亚夫作为将军下令打开营门，允许天子进入劳军。","official_rank":"高级将领","source_snippet":"亞夫乃傳言「開壁門。」","start_index":220,"tongjian_id":"8e6a136f-ce50-44f3-829b-02a1140c98f6"},{"confidence":0.7,"official_category":"军事指挥","official_name":"車騎","official_note":"车骑在原文中可能指车骑将军或泛指骑兵部队，但此处作为官职引用，可能指车骑将军的简称。在上下文中，壁门士向车骑传达将军的约束，要求不得驰驱。","official_rank":"未知","source_snippet":"壁門士請車騎曰","start_index":230,"tongjian_id":"bb071924-98a5-45ec-9c85-344dca606e59"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，指周亚夫作为将军制定的军规，约束军中不得驰驱。","official_rank":"高级将领","source_snippet":"將軍約","start_index":236,"tongjian_id":"0cd890a5-f386-4dd7-afe9-57ff93f83e90"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"将军是汉代常见的军事官职，泛指高级指挥官。在原文中，周亚夫作为将军以军礼见天子，体现了他的威严和纪律。","official_rank":"高级将领","source_snippet":"將軍亞夫持兵揖曰","start_index":260,"tongjian_id":"765285f0-606c-403a-9e95-3ca7c48fe32e"},{"confidence":0.95,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉是汉代官职，负责京师治安和军事事务，属于九卿之一。在原文中，周亚夫因在细柳军营的表现被任命为中尉，表彰其军事才能。","official_rank":"九卿之一","source_snippet":"乃拜周亞夫爲中尉","start_index":430,"tongjian_id":"de63557b-b06f-43b3-bc4a-0ad0328cf55a"}],"ExtRef_Children_people":[{"people_name":"令免","people_name_jianti_auto":"令免","people_xingming":"令免","start_index":39,"tongjian_id":"8f0caf0a-db0e-11ef-85c0-a0d3651f611f"},{"people_name":"蘇意","people_name_jianti_auto":"苏意","people_xingming":"苏意","start_index":54,"tongjian_id":"8f0caf0c-db0e-11ef-9050-a0d3651f611f"},{"link_td_description":"张武，西汉汉文帝属下大臣。官至郎中令、车骑将军。","link_td_id":"Q10019761","link_td_number_id":6015016,"people_name":"張武","people_name_jianti_auto":"张武","people_xingming":"张武","start_index":66,"tongjian_id":"8f0caf0f-db0e-11ef-b584-a0d3651f611f"},{"link_death_year":-143,"link_td_description":"周亚夫，西汉沛郡丰县（今江苏省徐州市丰县）人，为太尉周勃之子。汉文帝时，曾任河内郡太守，获封条侯。汉文帝后元六年为将军，领兵驻守细柳，防备入侵的匈奴大军，期间治军严谨，深获汉文帝赞赏。汉景帝即位后，周亚夫为车骑将军，并于七国之乱时，率军平定吴王刘濞、楚王刘戊等反叛的诸国联军，五年后接替陶青担任丞相，任上因不赞同废黜栗太子刘荣，以及反对封王信、唯徐卢等人为列侯得罪于汉景帝，加上梁孝王刘武多次在窦太后面前说周亚夫的不是，由此日渐失势而罢相。其后周亚夫因儿子遭人控告谋反受牵连，被关入监狱交由廷尉审判，最终周亚夫在狱中绝食五日，呕血而死。","link_td_id":"Q10008095","link_td_number_id":95189,"people_name":"周亞夫","people_name_jianti_auto":"周亚夫","people_xingming":"周亚夫","start_index":76,"tongjian_id":"8f0caf11-db0e-11ef-b262-a0d3651f611f"},{"link_death_year":-151,"link_td_description":"刘礼，汉朝宗室，西汉楚王。","link_td_id":"Q10002647","link_td_number_id":1486784,"people_name":"劉禮","people_name_jianti_auto":"刘礼","people_xingming":"刘礼","start_index":89,"tongjian_id":"8f0caf14-db0e-11ef-a43b-a0d3651f611f"},{"people_name":"祝茲侯","people_name_jianti_auto":"祝兹侯","people_xingming":"徐厉","start_index":99,"tongjian_id":"8f0caf15-db0e-11ef-81b9-a0d3651f611f"},{"people_name":"徐厲","people_name_jianti_auto":"徐厉","people_xingming":"徐厉","start_index":102,"tongjian_id":"8f0caf16-db0e-11ef-878b-a0d3651f611f"},{"link_death_year":-143,"li