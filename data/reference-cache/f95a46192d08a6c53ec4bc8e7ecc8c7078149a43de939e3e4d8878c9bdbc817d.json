le_name":"周公","people_name_jianti_auto":"周公","start_index":69,"tongjian_id":"8cafcf3c-db0e-11ef-aa29-a0d3651f611f"},{"people_name":"惠公","people_name_jianti_auto":"惠公","start_index":77,"tongjian_id":"8cafcf3d-db0e-11ef-ba7d-a0d3651f611f"},{"people_name":"赧王","people_name_jianti_auto":"赧王","start_index":91,"tongjian_id":"8cafcf3e-db0e-11ef-8eed-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宗周","place_name_jianti_auto":"宗周","start_index":4,"tongjian_id":"8cafcf3f-db0e-11ef-8374-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":16,"tongjian_id":"8cafcf40-db0e-11ef-8c54-a0d3651f611f"},{"place_name":"成周","place_name_jianti_auto":"成周","start_index":20,"tongjian_id":"8cafcf41-db0e-11ef-ad97-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":26,"tongjian_id":"8cafcf42-db0e-11ef-abf9-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":38,"tongjian_id":"8cafcf43-db0e-11ef-b0c3-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":44,"tongjian_id":"8cafcf44-db0e-11ef-836a-a0d3651f611f"},{"place_name":"河南","place_name_jianti_auto":"河南","start_index":65,"tongjian_id":"8cafcf45-db0e-11ef-8556-a0d3651f611f"},{"place_name":"鞏","place_name_jianti_auto":"巩","start_index":84,"tongjian_id":"8cafcf46-db0e-11ef-8eec-a0d3651f611f"},{"place_name":"東周","place_name_jianti_auto":"东周","start_index":88,"tongjian_id":"8cafcf47-db0e-11ef-a2bf-a0d3651f611f"},{"place_name":"東","place_name_jianti_auto":"东","start_index":95,"tongjian_id":"8cafcf48-db0e-11ef-995c-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":97,"tongjian_id":"8cafcf49-db0e-11ef-aee8-a0d3651f611f"},{"place_name":"西周","place_name_jianti_auto":"西周","start_index":105,"tongjian_id":"8cafcf4a-db0e-11ef-b6a3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"言天下共宗周以爲諸侯主。杜佑曰：洛陽，古成周之地。今洛陽城東三十餘里故城，是周之下都也。晉帥諸侯城之，以居敬王。至孝王封其弟桓公於河南以續周公之官職，至孫惠公乃封少子於鞏，號曰東周。赧王立，東、西周分理，又徙都西周，則王城也。帥，讀曰率。少，始照翻。鞏，居勇翻。赧，奴版翻。","note_content_jianti_auto":"言天下共宗周以为诸侯主。杜佑曰：洛阳，古成周之地。今洛阳城东三十余里故城，是周之下都也。晋帅诸侯城之，以居敬王。至孝王封其弟桓公于河南以续周公之官职，至孙惠公乃封少子于巩，号曰东周。赧王立，东、西周分理，又徙都西周，则王城也。帅，读曰率。少，始照翻。巩，居勇翻。赧，奴版翻。","note_type":"hu_note","start_index":87,"tongjian_id":"8cafcf37-db0e-11ef-b5a6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","start_index":1,"tongjian_id":"8cafcf4c-db0e-11ef-9ee0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂三代所傳之祭器，如九鼎之類是也。","note_content_jianti_auto":"谓三代所传之祭器，如九鼎之类是也。","note_type":"hu_note","start_index":133,"tongjian_id":"8cafcf4b-db0e-11ef-8d5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉伯莊","people_name_jianti_auto":"刘伯庄","start_index":5,"tongjian_id":"8cafcf4e-db0e-11ef-9a10-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夫，音扶。劉伯莊曰：虎之爪牙如兵之利刃在身，其肉雖臊而人猶攻之者，以其皮之所在也。鹿之大者曰麋，麋無爪牙之利而肉可食；若更蒙虎之皮，人之攻之必萬倍於虎矣。臊，蘇遭翻。魚腥，肉臊。麋，武悲翻。更，古孟翻。","note_content_jianti_auto":"夫，音扶。刘伯庄曰：虎之爪牙如兵之利刃在身，其肉虽臊而人犹攻之者，以其皮之所在也。鹿之大者曰麋，麋无爪牙之利而肉可食；若更蒙虎之皮，人之攻之必万倍于虎矣。臊，苏遭翻。鱼腥，肉臊。麋，武悲翻。更，古孟翻。","note_type":"hu_note","start_index":168,"tongjian_id":"8cafcf4d-db0e-11ef-89d8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","start_index":13,"tongjian_id":"8cafcf55-db0e-11ef-87ba-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":19,"tongjian_id":"8cafcf56-db0e-11ef-8058-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":21,"tongjian_id":"8cafcf57-db0e-11ef-875c-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":32,"tongjian_id":"8cafcf58-db0e-11ef-8820-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","start_index":40,"tongjian_id":"8cafcf59-db0e-11ef-975e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"共，音如字。傳，直專翻。言三代之器傳於周，周亡則所傳之器將南歸於楚，天下將合兵至楚而共討其罪也。","note_content_jianti_auto":"共，音如字。传，直专翻。言三代之器传于周，周亡则所传之器将南归于楚，天下将合兵至楚而共讨其罪也。","note_type":"hu_note","start_index":223,"tongjian_id":"8cafcf54-db0e-11ef-abcf-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"令尹","official_note":"令尹是楚国的最高行政长官，相当于宰相，负责国家政务。在上下文中，楚令尹昭子被东周武公劝说不要攻打周朝，体现了令尹在楚国决策中的核心作用。","official_rank":"未知","source_snippet":"楚令尹昭子","start_index":23,"tongjian_id":"563a1306-2cfe-4718-9b93-0534c1c6a3c2"}],"ExtRef_Children_people":[{"link_td_description":"西周武公，姓姬，是战国西周的第四任君主，为西周惠公长子。","link_td_id":"Q10008706","link_td_number_id":366343,"people_name":"武公","people_name_jianti_auto":"武公","start_index":20,"tongjian_id":"8cafcf5a-db0e-11ef-8648-a0d3651f611f"},{"people_name":"昭子","people_name_jianti_auto":"昭子","start_index":26,"tongjian_id":"8cafcf5b-db0e-11ef-8b03-a0d3651f611f"},{"people_name":"昭子","people_name_jianti_auto":"昭子","people_xingming":"昭子","start_index":38,"tongjian_id":"8cafcf64-db0e-11ef-80f1-a0d3651f611f"},{"link_td_description":"西周武公，姓姬，是战国西周的第四任君主，为西周惠公长子。","link_td_id":"Q10008706","link_td_number_id":366343,"people_name":"武公","people_name_jianti_auto":"武公","people_xingming":"东周武公","start_index":60,"tongjian_id":"8cafcf65-db0e-11ef-8f82-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8cafcf33-db0e-11ef-a3e8-a0d3651f611f","pinyin":"sāo","source_anchor_text":"也夫虎肉臊而兵利身","source_key":"baiyang_epub","start_index":136,"text":"臊","tongjian_id":"2590bec6-2156-5ec1-998c-c45340935df8"}],"ExtRef_Children_places":[{"place_name":"楚","place_name_j