to":"相州","start_index":55,"tongjian_id":"8cafcf1d-db0e-11ef-bf01-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","start_index":58,"tongjian_id":"8cafcf1e-db0e-11ef-8a8a-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":61,"tongjian_id":"8cafcf1f-db0e-11ef-bbed-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":67,"tongjian_id":"8cafcf20-db0e-11ef-a08d-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","start_index":71,"tongjian_id":"8cafcf21-db0e-11ef-82fa-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":74,"tongjian_id":"8cafcf22-db0e-11ef-a209-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","start_index":75,"tongjian_id":"8cafcf23-db0e-11ef-8723-a0d3651f611f"},{"place_name":"離石縣","place_name_jianti_auto":"离石县","start_index":78,"tongjian_id":"8cafcf24-db0e-11ef-87c6-a0d3651f611f"},{"place_name":"拓拔魏","place_name_jianti_auto":"拓拔魏","start_index":83,"tongjian_id":"8cafcf25-db0e-11ef-8057-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","start_index":87,"tongjian_id":"8cafcf26-db0e-11ef-b3b7-a0d3651f611f"},{"place_name":"五城郡","place_name_jianti_auto":"五城郡","start_index":91,"tongjian_id":"8cafcf27-db0e-11ef-ae8f-a0d3651f611f"},{"place_name":"石城縣","place_name_jianti_auto":"石城县","start_index":97,"tongjian_id":"8cafcf28-db0e-11ef-9494-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記正義曰：地理志，右北平有石城縣。括地志：石城在相州林慮縣西南九十里。疑相州石城是。余謂北平之石城，燕境也，相州之石城，魏境也，皆非趙地。此石城卽漢西河之離石縣城；拓拔魏分西河，置五城郡，又置石城縣，蓋此地是也。相，息亮翻。慮，音廬。燕，因肩翻。","note_content_jianti_auto":"史记正义曰：地理志，右北平有石城县。括地志：石城在相州林虑县西南九十里。疑相州石城是。余谓北平之石城，燕境也，相州之石城，魏境也，皆非赵地。此石城即汉西河之离石县城；拓拔魏分西河，置五城郡，又置石城县，盖此地是也。相，息亮翻。虑，音庐。燕，因肩翻。","note_type":"hu_note","start_index":9,"tongjian_id":"8cafcf12-db0e-11ef-ad5f-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8cafcf2c-db0e-11ef-a781-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":3,"tongjian_id":"8cafcf2d-db0e-11ef-963a-a0d3651f611f"},{"place_name":"石城","place_name_jianti_auto":"石城","place_note":"河北石家庄西南","resolved_place_entity_id":1124,"start_index":6,"tongjian_id":"8cafcf2e-db0e-11ef-805d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、彰德府（卷四十九）","excerpts":[{"context_after":"]。","context_before":"...城西北隅入于漳水。又有石城，《括地志》：在县西南九十里。","source_end_index":113,"source_paragraph_tongjian_id":"1fcce2de-ad53-5fe6-9f5f-e07ff41ec680","source_start_index":96,"source_text":"秦惠文王十一年，伐赵，拔石城，即此"}],"path":"河南方舆纪要/五、彰德府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1秦伐趙，拔石城。","content_fanyi":"秦军攻打赵国，攻克石城。","content_jianti_auto":"1秦伐赵，拔石城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":353,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8cafcf11-db0e-11ef-b5fe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是秦朝及战国时期最高行政长官，辅佐君主处理全国政务。此处指穰侯魏冉重新担任秦国丞相，反映了他在秦昭襄王时期的政治地位和权力变化。","official_rank":"正一品","source_snippet":"秦穰侯復爲丞相","start_index":6,"tongjian_id":"a4ef5f8c-94f2-4a96-ae9b-379b8a99ebf3"}],"ExtRef_Children_people":[{"link_birth_year":-335,"link_death_year":-266,"link_td_description":"魏冉，芈姓，魏氏，名冉，亦作魏焻、魏厓，中国战国时期秦国政治家，宣太后异父弟，封於穰邑（今日河南邓州市），故为穰侯。","link_td_id":"Q10001101","link_td_number_id":672615,"people_name":"穰侯","people_name_jianti_auto":"穰侯","people_xingming":"魏冉","start_index":2,"tongjian_id":"8cafcf31-db0e-11ef-8e28-a0d3651f611f","wl_zhushi":"[魏冉]"}],"ExtRef_Children_pinyi