{"data":{"current_mention_tongjian_id":"8be4024e-db0e-11ef-bc10-a0d3651f611f","current_paragraph_tongjian_id":"8be19ee2-db0e-11ef-9924-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8be3d551-db0e-11ef-8493-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"8be3d552-db0e-11ef-bd46-a0d3651f611f"},{"people_name":"退齋","people_name_jianti_auto":"退斋","start_index":26,"tongjian_id":"8be3d553-db0e-11ef-9c45-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「王」作「周」；乙十一行本同；孔本同；退齋校同。』","note_content_jianti_auto":"『章：十二行本「王」作「周」；乙十一行本同；孔本同；退斋校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8be3d550-db0e-11ef-8426-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":62,"tongjian_id":"8be3d54f-db0e-11ef-b3bb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惓，逵員翻。漢·劉向傳：忠臣畎畝，猶不忘君惓惓之義也。惓惓，猶言勤勤也。","note_content_jianti_auto":"惓，逵员翻。汉·刘向传：忠臣畎亩，犹不忘君惓惓之义也。惓惓，犹言勤勤也。","note_type":"hu_note","start_index":93,"tongjian_id":"8be3d554-db0e-11ef-a513-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"商帝乙","people_name_jianti_auto":"商帝乙","start_index":3,"tongjian_id":"8be3d557-db0e-11ef-b35f-a0d3651f611f"},{"people_name":"微子啓","people_name_jianti_auto":"微子启","start_index":12,"tongjian_id":"8be3d558-db0e-11ef-a9d0-a0d3651f611f"},{"people_name":"中衍","people_name_jianti_auto":"中衍","start_index":18,"tongjian_id":"8be3d559-db0e-11ef-a777-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":23,"tongjian_id":"8be3d55a-db0e-11ef-899d-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":25,"tongjian_id":"8be3d55b-db0e-11ef-baa6-a0d3651f611f"},{"people_name":"帝乙","people_name_jianti_auto":"帝乙","start_index":31,"tongjian_id":"8be3d55c-db0e-11ef-b592-a0d3651f611f"},{"people_name":"啓","people_name_jianti_auto":"启","start_index":35,"tongjian_id":"8be3d55d-db0e-11ef-81c9-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":64,"tongjian_id":"8be3d55e-db0e-11ef-b3df-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":66,"tongjian_id":"8be3d55f-db0e-11ef-9942-a0d3651f611f"},{"people_name":"孔鄭玄義曰","people_name_jianti_auto":"孔郑玄义曰","start_index":75,"tongjian_id":"8be3d560-db0e-11ef-8bbd-a0d3651f611f"},{"people_name":"孔氏","people_name_jianti_auto":"孔氏","start_index":124,"tongjian_id":"8be3d561-db0e-11ef-9645-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"殷國","place_name_jianti_auto":"殷国","start_index":72,"tongjian_id":"8be3d562-db0e-11ef-9c28-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":176,"tongjian_id":"8be3d563-db0e-11ef-8139-a0d3651f611f"},{"place_name":"殷","place_name_jianti_auto":"殷","start_index":179,"tongjian_id":"8be3d564-db0e-11ef-b6b1-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":186,"tongjian_id":"8be3d565-db0e-11ef-978a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史記：商帝乙生三子：長曰微子啓，次曰中衍，季曰紂。紂之母爲后。帝乙欲立啓爲太子，太史據法爭之曰：「有妻之子，不可立妾之子。」乃立紂。紂卒以暴虐亡殷國。孔鄭玄義曰：物之大者莫若於天；推父比天，與之相配，行孝之大，莫大於此；所謂「嚴父莫大於配天」也。又孔氏曰：禮記稱萬物本乎天，人本乎祖。俱爲其本，可以相配，故王者皆以祖配天。諡法：除殘去虐曰湯。然諡法起於周；蓋殷人先有此號，周人遂引以爲諡法。分，扶問翻。長，知兩翻。卒，子恤翻。","note_content_jianti_auto":"史记：商帝乙生三子：长曰微子启，次曰中衍，季曰纣。纣之母为后。帝乙欲立启为太子，太史据法争之曰：「有妻之子，不可立妾之子。」乃立纣。纣卒以暴虐亡殷国。孔郑玄义曰：物之大者莫若于天；推父比天，与之相配，行孝之大，莫大于此；所谓「严父莫大于配天」也。又孔氏曰：礼记称万物本乎天，人本乎祖。俱为其本，可以相配，故王者皆以祖配天。谥法：除残去虐曰汤。然谥法起于周；盖殷人先有此号，周人遂引以为谥法。分，扶问翻。长，知两翻。卒，子恤翻。","note_type":"hu_note","start_index":143,"tongjian_id":"8be3d556-db0e-11ef-9e4f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"吳王","people_name_jianti_auto":"吴王","start_index":0,"tongjian_id":"8be40224-db0e-11ef-9210-a0d3651f611f"},{"people_name":"壽夢","people_name_jianti_auto":"寿梦","start_index":2,"tongjian_id":"8be40225-db0e-11ef-b75a-a0d3651f611f"},{"people_name":"諸樊","people_name_jianti_auto":"诸樊","start_index":11,"tongjian_id":"8be40226-db0e-11ef-a529-a0d3651f611f"},{"people_name":"餘祭","people_name_jianti_auto":"余祭","start_index":16,"tongjian_id":"8be40227-db0e-11ef-af34-a0d3651f611f"},{"people_name":"餘昩","people_name_jianti_auto":"余昩","start_index":21,"tongjian_id":"8be40228-db0e-11ef-8fea-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":26,"tongjian_id":"8be40229-db0e-11ef-95a0-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":29,"tongjian_id":"8be4022a-db0e-11ef-bc23-a0d3651f611f"},{"people_name":"壽夢","people_name_jianti_auto":"寿梦","start_index":33,"tongjian_id":"8be4022b-db0e-11ef-9807-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":39,"tongjian_id":"8be4022c-db0e-11ef-9999-a0d3651f611f"},{"people_name":"諸樊","people_name_jianti_auto":"诸樊","start_index":48,"tongjian_id":"8be4022d-db0e-11ef-a17e-a0d3651f611f"},{"people_name":"諸樊","people_name_jianti_auto":"诸樊","start_index":51,"tongjian_id":"8be4022e-db0e-11ef-bbd8-a0d3651f611f"},{"people_name":"餘祭","people_name_jianti_auto":"余祭","start_index":57,"tongjian_id":"8be4022f-db0e-11ef-ab30-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":72,"tongjian_id":"8be40230-db0e-11ef-bfec-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":75,"tongjian_id":"8be40231-db0e-11ef-9283-a0d3651f611f"},{"people_name":"諸樊","people_name_jianti_auto":"诸樊","start_index":85,"tongjian_id":"8be40232-db0e-11ef-b3b0-a0d3651f611f"},{"people_name":"光","people_name_jianti_auto":"光","start_index":89,"tongjian_id":"8be40233-db0e-11ef-a8c1-a0d3651f611f"},{"people_name":"餘昩","people_name_jianti_auto":"余昩","start_index":91,"tongjian_id":"8be40234-db0e-11ef-961f-a0d3651f611f"},{"people_name":"僚","people_name_jianti_auto":"僚","start_index":95,"tongjian_id":"8be40235-db0e-11ef-9409-a0d3651f611f"},{"people_name":"夫差","people_name_jianti_auto":"夫差","start_index":101,"tongjian_id":"8be40236-db0e-11ef-80e0-a0d3651f611f"},{"people_name":"太伯","people_name_jianti_auto":"太伯","start_index":121,"tongjian_id":"8be40237-db0e-11ef-9e25-a0d3651f611f"},{"people_name":"范甯","people_name_jianti_auto":"范宁","start_index":130,"tongjian_id":"8be40238-db0e-11ef-8fc5-a0d3651f611f"},{"people_name":"周太王","people_name_jianti_auto":"周太王","start_index":148,"tongjian_id":"8be40239-db0e-11ef-af61-a0d3651f611f"},{"people_name":"太伯","people_name_jianti_auto":"太伯","start_index":157,"tongjian_id":"8be4023a-db0e-11ef-af26-a0d3651f611f"},{"people_name":"陸德明","people_name_jianti_auto":"陆德明","start_index":160,"tongjian_id":"8be4023b-db0e-11ef-babf-a0d3651f611f"},{"people_name":"壽夢","people_name_jianti_auto":"寿梦","start_index":165,"tongjian_id":"8be4023c-db0e-11ef-8e3b-a0d3651f611f"},{"people_name":"餘祭","people_name_jianti_auto":"余祭","start_index":172,"tongjian_id":"8be4023d-db0e-11ef-9bbe-a0d3651f611f"},{"people_name":"餘昩","people_name_jianti_auto":"余昩","start_index":179,"tongjian_id":"8be4023e-db0e-11ef-94d2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"吳","place_name_jianti_auto":"吴","start_index":104,"tongjian_id":"8be4023f-db0e-11ef-8fbb-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":124,"tongjian_id":"8be40240-db0e-11ef-9d2c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"吳王壽夢有子四人：長曰諸樊，次曰餘祭，次曰餘昩，次曰季札。季札賢，壽夢欲立之，季札讓不可，於是立諸樊。諸樊卒，以授餘祭，欲兄弟以次相傳，必致國於季札；季札終讓而逃之。其後諸樊之子光與餘昩之子僚爭國，至於夫差，吳遂以亡。宗廟之祭用牲，故曰血食。太伯，吳立國之君。范甯曰：太者，善大之稱；伯者，長也。周太王之元子，故曰太伯。陸德明曰：壽夢，莫公翻。餘祭，側介翻。餘昩，音末。","note_content_jianti_auto":"吴王寿梦有子四人：长曰诸樊，次曰余祭，次曰余昩，次曰季札。季札贤，寿梦欲立之，季札让不可，于是立诸樊。诸樊卒，以授余祭，欲兄弟以次相传，必致国于季札；季札终让而逃之。其后诸樊之子光与余昩之子僚争国，至于夫差，吴遂以亡。宗庙之祭用牲，故曰血食。太伯，吴立国之君。范宁曰：太者，善大之称；伯者，长也。周太王之元子，故曰太伯。陆德明曰：寿梦，莫公翻。余祭，侧介翻。余昩，音末。","note_type":"hu_note","start_index":156,"tongjian_id":"8be3d569-db0e-11ef-a88b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_td_description":"季札，姬姓，名札，又称公子札、延陵季子、延州来季子、季子，吴王寿梦最小的儿子。公元前547年，吴王寿梦将第四子季札封于延陵邑。","link_td_id":"Q10002781","link_td_number_id":1295108,"people_name":"季札","people_name_jianti_auto":"季札","people_xingming":"季札","start_index":144,"tongjian_id":"8be4024e-db0e-11ef-bc10-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"文王序易，以乾、坤爲首。孔子繫之曰：「天尊地卑，乾坤定矣。卑高以陳，貴賤位矣。」言君臣之位猶天地之不可易也。春秋抑諸侯，尊王室，王人雖微，序於諸侯之上，以是見聖人於君臣之際未嘗不惓惓也。非有桀、紂之暴，湯、武之仁，人歸之，天命之，君臣之分當守節伏死而已矣。是故以微子而代紂則成湯配天矣，以季札而君吳則太伯血食矣，然二子寧亡國而不爲者，誠以禮之大節不可亂也。故曰禮莫大於分也。","content_fanyi":"周文王序次《易》，把《乾》《坤》两卦放在首位。孔子系辞说：“天尊贵，地卑微，乾坤由此确定。卑下与高大按次序列出，贵贱也就有了定位。”这是说君臣之位如同天地一样不可改易。《春秋》贬抑诸侯，尊崇王室，周王室的臣属虽然卑微，仍排在诸侯之上，由此可见圣人对于君臣之间的关系，从来都念念不忘。除非有桀、纣那样的暴虐，汤、武那样的仁德，民众归附他们，上天授予他们天命；否则君臣的名分，就应当坚守节操，至死不渝。因此，如果让微子取代纣王，成汤开创的商朝就能与天相配；如果让季札做吴国君主，太伯也能永享祭祀。然而二人宁愿让国家灭亡也不肯这样做，实在是因为礼制的大节不可紊乱。所以说：礼没有比名分更重要的了。","content_jianti_auto":"文王序易，以干、坤为首。孔子系之曰：「天尊地卑，乾坤定矣。卑高以陈，贵贱位矣。」言君臣之位犹天地之不可易也。春秋抑诸侯，尊王室，王人虽微，序于诸侯之上，以是见圣人于君臣之际未尝不惓惓也。非有桀、纣之暴，汤、武之仁，人归之，天命之，君臣之分当守节伏死而已矣。是故以微子而代纣则成汤配天矣，以季札而君吴则太伯血食矣，然二子宁亡国而不为者，诚以礼之大节不可乱也。故曰礼莫大于分也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4,"path":"资治通鉴 : 卷第一 (周紀一) / 威烈王 / 二十三年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8be19ee2-db0e-11ef-9924-a0d3651f611f","year_int":-403},"tongjian_id":"8be19ee2-db0e-11ef-9924-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"91f326ac-db0e-11ef-85f8-a0d3651f611f"},{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":15,"tongjian_id":"91f326ad-db0e-11ef-96fe-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":28,"tongjian_id":"91f326ae-db0e-11ef-a96c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":101,"tongjian_id":"91f326af-db0e-11ef-9fac-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":38,"tongjian_id":"91f326b0-db0e-11ef-9289-a0d3651f611f"},{"place_name":"殷","place_name_jianti_auto":"殷","start_index":61,"tongjian_id":"91f326b1-db0e-11ef-a761-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":84,"tongjian_id":"91f326b2-db0e-11ef-87c2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：二王之後與己爲三統也。孟康曰：天、地、人之始也。張晏曰：一曰天統，謂周以十一月建子爲正，天始施之端也；二曰地統，謂殷以十二月建丑爲正，地始化之端也；三曰人統，謂夏以十三月建寅爲正，人始成之端也。師古曰：諸家之說皆不備也；言王者象天、地、人之三統，故存三代也。","note_content_jianti_auto":"应劭曰：二王之后与己为三统也。孟康曰：天、地、人之始也。张晏曰：一曰天统，谓周以十一月建子为正，天始施之端也；二曰地统，谓殷以十二月建丑为正，地始化之端也；三曰人统，谓夏以十三月建寅为正，人始成之端也。师古曰：诸家之说皆不备也；言王者象天、地、人之三统，故存三代也。","note_type":"hu_note","start_index":29,"tongjian_id":"91f326ab-db0e-11ef-ac3d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":13,"source_start_index":0,"source_text":"釋之對詳見十四卷文帝前三年","target_paragraph_tongjian_id":"8ed308dc-db0e-11ef-b91d-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"釋之","people_name_jianti_auto":"释之","start_index":0,"tongjian_id":"91f326b4-db0e-11ef-95ae-a0d3651f611f"},{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":8,"tongjian_id":"91f326b5-db0e-11ef-bfbb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"釋之對詳見十四卷文帝前三年。","note_content_jianti_auto":"释之对详见十四卷文帝前三年。","note_type":"hu_note","start_index":112,"tongjian_id":"91f326b3-db0e-11ef-b9b2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":21,"tongjian_id":"91f326b7-db0e-11ef-a01c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古之葬者，厚衣之以薪，葬之中野，不封不樹；黃帝易之以棺槨。","note_content_jianti_auto":"古之葬者，厚衣之以薪，葬之中野，不封不树；黄帝易之以棺椁。","note_type":"hu_note","start_index":131,"tongjian_id":"91f326b6-db0e-11ef-bb39-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":0,"tongjian_id":"91f326b9-db0e-11ef-96db-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉灼曰：丘壠，冢墳也。","note_content_jianti_auto":"晋灼曰：丘垅，冢坟也。","note_type":"hu_note","start_index":159,"tongjian_id":"91f326b8-db0e-11ef-b9c9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91f326bb-db0e-11ef-8835-a0d3651f611f"},{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":11,"tongjian_id":"91f326bc-db0e-11ef-841b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"防","place_name_jianti_auto":"防","start_index":4,"tongjian_id":"91f326bd-db0e-11ef-ac09-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":6,"tongjian_id":"91f326be-db0e-11ef-84a0-a0d3651f611f"},{"place_name":"昌邑縣","place_name_jianti_auto":"昌邑县","start_index":15,"tongjian_id":"91f326bf-db0e-11ef-b286-a0d3651f611f"},{"place_name":"防城","place_name_jianti_auto":"防城","start_index":20,"tongjian_id":"91f326c0-db0e-11ef-99b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：防，魯邑名也。杜預曰：昌邑縣西有防城。","note_content_jianti_auto":"师古曰：防，鲁邑名也。杜预曰：昌邑县西有防城。","note_type":"hu_note","start_index":193,"tongjian_id":"91f326ba-db0e-11ef-9bd9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":6,"tongjian_id":"91f326c2-db0e-11ef-bcf0-a0d3651f611f"},{"people_name":"丘","people_name_jianti_auto":"丘","start_index":26,"tongjian_id":"91f326c3-db0e-11ef-98db-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":54,"tongjian_id":"91f326c4-db0e-11ef-a546-a0d3651f611f"},{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":118,"tongjian_id":"91f326c5-db0e-11ef-a42d-a0d3651f611f"},{"people_name":"孔子","people_name_jianti_auto":"孔子","start_index":122,"tongjian_id":"91f326c6-db0e-11ef-a64c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"防","place_name_jianti_auto":"防","start_index":13,"tongjian_id":"91f326c7-db0e-11ef-9708-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"記·檀弓曰：孔子旣得合葬於防，曰：「古者墓而不墳；今丘也，東西南北之人也，不可以不識也，」於是封之，崇四尺。師古曰：墳者，謂積土也。春秋緯：天子墳高三仞，樹以松；諸侯半之，樹以柏；大夫八尺，樹以藥草；士四尺，樹以槐；庶人無墳，樹以楊柳。鄭玄曰：孔子蓋用士禮。","note_content_jianti_auto":"记·檀弓曰：孔子既得合葬于防，曰：「古者墓而不坟；今丘也，东西南北之人也，不可以不识也，」于是封之，崇四尺。师古曰：坟者，谓积土也。春秋纬：天子坟高三仞，树以松；诸侯半之，树以柏；大夫八尺，树以药草；士四尺，树以槐；庶人无坟，树以杨柳。郑玄曰：孔子盖用士礼。","note_type":"hu_note","start_index":197,"tongjian_id":"91f326c1-db0e-11ef-a209-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"91f326cb-db0e-11ef-aebf-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":14,"tongjian_id":"91f326cc-db0e-11ef-884e-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":26,"tongjian_id":"91f326cd-db0e-11ef-b3d0-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":30,"tongjian_id":"91f326ce-db0e-11ef-8bd5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：隱蔽之，財可見而已。臣瓚曰：謂人立可隱肘也。師古曰：瓚說是也。隱，音於靳反。","note_content_jianti_auto":"孟康曰：隐蔽之，财可见而已。臣瓒曰：谓人立可隐肘也。师古曰：瓒说是也。隐，音于靳反。","note_type":"hu_note","start_index":215,"tongjian_id":"91f326ca-db0e-11ef-8391-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91f326d0-db0e-11ef-af14-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：弟弟者，言弟能順理也。上弟，音徒計反。","note_content_jianti_auto":"师古曰：弟弟者，言弟能顺理也。上弟，音徒计反。","note_type":"hu_note","start_index":237,"tongjian_id":"91f326cf-db0e-11ef-a9a3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臧，古藏字通；下臧椁同。","note_content_jianti_auto":"臧，古藏字通；下臧椁同。","note_type":"hu_note","start_index":301,"tongjian_id":"91f326d1-db0e-11ef-bd4c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":11,"source_start_index":0,"source_text":"詳見七卷秦始皇三十七年","target_paragraph_tongjian_id":"8d7c47d9-db0e-11ef-90eb-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"秦始皇","people_name_jianti_auto":"秦始皇","start_index":4,"tongjian_id":"91f326d3-db0e-11ef-93d4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詳見七卷秦始皇三十七年。勝，音升。","note_content_jianti_auto":"详见七卷秦始皇三十七年。胜，音升。","note_type":"hu_note","start_index":321,"tongjian_id":"91f326d2-db0e-11ef-b4e0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":9,"source_start_index":0,"source_text":"事見七卷秦二世二年","target_paragraph_tongjian_id":"8d84463b-db0e-11ef-9cdf-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"秦二世","people_name_jianti_auto":"秦二世","start_index":4,"tongjian_id":"91f326d5-db0e-11ef-8c76-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見七卷秦二世二年。","note_content_jianti_auto":"事见七卷秦二世二年。","note_type":"hu_note","start_index":349,"tongjian_id":"91f326d4-db0e-11ef-bf95-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":8,"source_start_index":0,"source_text":"事見九卷高帝元年","target_paragraph_tongjian_id":"8ddb6ccd-db0e-11ef-8a23-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":4,"tongjian_id":"91f326d7-db0e-11ef-a2a4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見九卷高帝元年。","note_content_jianti_auto":"事见九卷高帝元年。","note_type":"hu_note","start_index":359,"tongjian_id":"91f326d6-db0e-11ef-851d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"91f326da-db0e-11ef-9f07-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：離，遭也。","note_content_jianti_auto":"师古曰：离，遭也。","note_type":"hu_note","start_index":409,"tongjian_id":"91f326d9-db0e-11ef-a9cc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"知，讀曰智；下賢知同。","note_content_jianti_auto":"知，读曰智；下贤知同。","note_type":"hu_note","start_index":437,"tongjian_id":"91f326db-db0e-11ef-abf8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"91f326de-db0e-11ef-be1b-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":22,"tongjian_id":"91f326df-db0e-11ef-8aa3-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十四行本「闕」作「廟」；乙十一行本同；孔本同。』","note_content_jianti_auto":"『章：十四行本「阙」作「庙」；乙十一行本同；孔本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"91f326dd-db0e-11ef-941e-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":449,"tongjian_id":"91f32