d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":172,"tongjian_id":"bed451a9-db0e-11ef-9086-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":175,"tongjian_id":"bed451aa-db0e-11ef-9b5c-a0d3651f611f"},{"place_name":"東都","place_name_jianti_auto":"东都","start_index":188,"tongjian_id":"bed451ab-db0e-11ef-b3b6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"貞觀八年，分辰州龍標縣置巫州，京師南三千一百五十八里，至東都三千八百三十三里。播州，秦夜郞郡之南境，隋牂柯郡之牂柯縣，貞觀九年，置郞州，十一年，置播州，京師南四千四百五十里，至東都四千九百六十里。貞觀十六年，開山洞置溱州，至京師三千四百八十里，東都四千二百里。歸州，漢秭歸縣地，後周置秭歸郡，隋廢郡，以縣屬巴東郡；唐武德二年，分秭歸、巴東二縣置歸州，京師南二千二百六十八里，至東都一千八百四十三里。","note_content_jianti_auto":"贞观八年，分辰州龙标县置巫州，京师南三千一百五十八里，至东都三千八百三十三里。播州，秦夜郞郡之南境，隋牂柯郡之牂柯县，贞观九年，置郞州，十一年，置播州，京师南四千四百五十里，至东都四千九百六十里。贞观十六年，开山洞置溱州，至京师三千四百八十里，东都四千二百里。归州，汉秭归县地，后周置秭归郡，隋废郡，以县属巴东郡；唐武德二年，分秭归、巴东二县置归州，京师南二千二百六十八里，至东都一千八百四十三里。","note_type":"hu_note","start_index":40,"tongjian_id":"bed257ce-db0e-11ef-aaf3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"睿宗","people_name_jianti_auto":"睿宗","start_index":4,"tongjian_id":"bed451ad-db0e-11ef-b236-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"玉眞觀","place_name_jianti_auto":"玉真观","start_index":0,"tongjian_id":"bed451ae-db0e-11ef-84e8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"玉眞觀，睿宗爲主所起。","note_content_jianti_auto":"玉真观，睿宗为主所起。","note_type":"hu_note","start_index":50,"tongjian_id":"bed451ac-db0e-11ef-be5b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"萬安","people_name_jianti_auto":"万安","start_index":0,"tongjian_id":"bed451b1-db0e-11ef-b05b-a0d3651f611f"},{"people_name":"咸宜","people_name_jianti_auto":"咸宜","start_index":3,"tongjian_id":"bed451b2-db0e-11ef-b29b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"萬安、咸宜二公主皆上皇女。","note_content_jianti_auto":"万安、咸宜二公主皆上皇女。","note_type":"hu_note","start_index":80,"tongjian_id":"bed451b0-db0e-11ef-90c1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"bed257cd-db0e-11ef-a4e2-a0d3651f611f","pinyin":"zhēn","source_anchor_text":"州魏悅流溱州陳玄禮","source_key":"baiyang_epub","start_index":22,"text":"溱","tongjian_id":"d0a97892-e532-5e46-b5ae-1b512e7f3b3e"}],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":37,"tongjian_id":"bed4a600-db0e-11ef-b614-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/诸公论唐肃宗","excerpts":[{"context_after":"，其不孝之恶，上通于天。是时，元次山作《中兴颂》，所书天...","context_before":"...者，曰：“欲收复两京，非居尊位，不足以制命诸将耳。”至于","source_end_index":81,"source_paragraph_tongjian_id":"acaf7d6a-acb8-49d2-96cc-6ebcad82963a","source_start_index":49,"source_text":"上皇还居兴庆，恶其与外人交通，劫徙之西内，不复定省，竟以怏怏而终"}],"path":"五笔/卷二/诸公论唐肃宗","source_name":"容斋随笔"}],"class_tags":[],"content":"26丙辰，高力士流巫州，王承恩流播州，魏悅流溱州，陳玄禮勒致仕；置如仙媛於歸州，玉眞公主出居玉眞觀。上更選後宮百餘人，置西內，備灑掃。令萬安、咸宜二公主視服膳；四方所獻珍異，先薦上皇。然上皇日以不懌，因不茹葷，辟穀，浸以成疾。上初猶往問安，旣而上亦有疾，但遣人起居。其後上稍悔寤，惡輔國，欲誅之，畏其握兵，竟猶豫不能決。","content_fanyi":"丙辰这一天，高力士被流放到巫州，王承恩被流放到播州，魏悦被流放到溱州，陈玄礼被勒令退休；如仙媛被安置到归州，玉真公主移居宫外的玉真观。皇上又挑选后宫一百多人，安置在西内太极宫，负责打扫。命令万安、咸宜两位公主照管太上皇的衣服膳食；各地进献的奇珍异品，先呈送给太上皇。然而太上皇一天比一天闷闷不乐，于是不再吃荤，修炼辟谷之术，逐渐酿成疾病。起初皇上还亲自前往问安，不久皇上也生了病，只派人去问候起居。此后皇上渐渐悔悟，厌恶李辅国，想诛杀他，却忌惮他手握兵权，终究犹豫不决。","content_jianti_auto":"26丙辰，高力士流巫州，王承恩流播州，魏悦流溱州，陈玄礼勒致仕；置如仙媛于归州，玉真公主出居玉真观。上更选后宫百余人，置西内，备洒扫。令万安、咸宜二公主视服膳；四方所献珍异，先荐上皇。然上皇日以不怿，因不茹荤，辟谷，浸以成疾。上初犹往问安，既而上亦有疾，但遣人起居。其后上稍悔寤，恶辅国，欲诛之，畏其握兵，竟犹豫不能决。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22351,"number":26,"path":"资治通鉴 : 卷第二百二十一 (唐紀三十七) / 肅宗文明武德大聖大宣孝皇帝下之上 / 上元元年 / 第 28 段","reading_annotation_sources":[],"start_index":27,"tongjian_id":"bed257cd-db0e-11ef-a4e2-a0d3651f611f","year_int":760},"tongjian_id":"bed257cd-db0e-11ef-a4e2-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"辰","place_name_jianti_auto":"辰","place_note":"湖南省沅陵县","start_index":0,"tongjian_id":"c2fda540-db0e-11ef-916d-a0d3651f611f"},{"place_name":"漵","place_name_jianti_auto":"溆","place_note":"湖南省洪江市西北黔城镇","start_index":2,"tongjian_id":"c2fda541-db0e-11ef-98f6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"辰、漵賊反，事始上卷六年。","note_content_jianti_auto":"辰、溆贼反，事始上卷六年。","note_type":"hu_note","start_index":16,"tongjian_id":"c2fda53f-db0e-11ef-ba30-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"c2fda544-db0e-11ef-a6f5-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"c2fda545-db0e-11ef-a0ae-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":31,"tongjian_id":"c2fda546-db0e-11ef-ad15-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十一行本「辛」上有「九月」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：甲十一行本「辛」上有「九月」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"c2fda543-db0e-11ef-9c6e-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":19,"tongjian_id":"c2fda542-db0e-11ef-9298-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"委，屬也，付也。","note_content_jianti_auto":"委，属也，付也。","note_type":"hu_note","start_index":36,"tongjian_id":"c2fda547-db0e-11ef-b6e2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","resolved_place_entity_id":1933,"start_index":23,"tongjian_id":"c2ffeed5-db0e-11ef-892c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10丁未，辰、漵賊帥張伯靖請降。辛亥，以伯靖爲歸州司馬，委荊南軍前驅使。","content_fanyi":"八月二十七日丁未，辰州、溆州叛军首领张伯靖请求归降朝廷。九月初二日辛亥，宪宗任命张伯靖为归州司马，交由荆南节度使军前驱使。","content_jianti_auto":"10丁未，辰、溆贼帅张伯靖请降。辛亥，以伯靖为归州司马，委荆南军前驱使。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24120,"number":10,"path":"资治通鉴 : 卷第二百三十九 (唐紀五十五) / 憲宗昭文章武大聖至神孝皇帝中之上 / 八年 / 第 12 段","reading_annotation_sources":[],"start_index":11,"tongjian_id":"c2fda53e-db0e-11ef-8238-a0d3651f611f","year_int":813},"tongjian_id":"c2fda53e-db0e-11ef-8238-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李遜","people_name_jianti_auto":"李逊","start_index":0,"tongjian_id":"c3148a0c-db0e-11ef-a5e8-a0d3651f611f"},{"people_name":"霞寓","people_name_jianti_auto":"霞寓","start_index":5,"tongjian_id":"c3148a0d-db0e-11ef-b2fb-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李遜主餉，霞寓軍因得以罪歸之。","note_content_jianti_auto":"李逊主饷，霞寓军因得以罪归之。","note_type":"hu_note","start_index":18,"tongjian_id":"c3148a0b-db0e-11ef-a85d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"c3148a10-db0e-11ef-8d48-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"c3148a11-db0e-11ef-a914-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":31,"tongjian_id":"c3148a12-db0e-11ef-b413-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十一行本「月」下有「丁丑」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：甲十一行本「月」下有「丁丑」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"c3148a0f-db0e-11ef-a1c1-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":23,"tongjian_id":"c3148a0e-db0e-11ef-9642-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","start_index":0,"tongjian_id":"c3148a14-db0e-11ef-b5ae-a0d3651f611f"},{"place_name":"秭歸","place_name_jianti_auto":"秭归","start_index":5,"tongjian_id":"c3148a15-db0e-11ef-84f9-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","place_note":"江苏苏州","start_index":8,"tongjian_id":"c3148a16-db0e-11ef-b742-a0d3651f611f"},{"place_name":"建平郡","place_name_jianti_auto":"建平郡","start_index":10,"tongjian_id":"c3148a17-db0e-11ef-a533-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":14,"tongjian_id":"c3148a18-db0e-11ef-92e2-a0d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":16,"tongjian_id":"c3148a19-db0e-11ef-bfaf-a0d3651f611f"},{"place_name":"京師","place_name_jianti_auto":"京师","start_index":19,"tongjian_id":"c3148a1a-db0e-11ef-86b0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歸州，古之秭歸，吳立建平郡，唐置歸州，京師南二千二百六十八里。","note_content_jianti_auto":"归州，古之秭归，吴立建平郡，唐置归州，京师南二千二百六十八里。","note_type":"hu_note","start_index":32,"tongjian_id":"c3148a13-db0e-11ef-abb0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"恩王","people_name_jianti_auto":"恩王","start_index":0,"tongjian_id":"c3148a1c-db0e-11ef-8acb-a0d3651f611f"},{"people_name":"連","people_name_jianti_auto":"连","start_index":2,"tongjian_id":"c3148a1d-db0e-11ef-b793-a0d3651f611f"},{"people_name":"代宗","people_name_jianti_auto":"代宗","start_index":4,"tongjian_id":"c3148a1e-db0e-11ef-a2e7-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"恩王連，代宗之子。","note_content_jianti_auto":"恩王连，代宗之子。","note_type":"hu_note","start_index":40,"tongjian_id":"c3148a1b-db0e-11ef-8359-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","resolved_place_entity_id":1933,"start_index":27,"tongjian_id":"c3148a23-db0e-11ef-bd94-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"上責高霞寓之敗，霞寓稱李遜應接不至。秋，七月，貶霞寓爲歸州刺史，遜亦左遷恩王傅。以河南尹鄭權爲山南東道節度使。以荊南節度使袁滋爲彰義節度、申·光·蔡·唐·隨·鄧觀察使，以唐州爲理所。","content_fanyi":"皇上追究高霞寓战败的责任，高霞寓声称李逊没有前来接应。秋季七月，高霞寓被贬为归州刺史，李逊也降职为恩王傅。朝廷任命河南尹郑权为山南东道节度使，又任命荆南节度使袁滋为彰义节度使，兼申、光、蔡、唐、随、邓观察使，以唐州为治所。","content_jianti_auto":"上责高霞寓之败，霞寓称李逊应接不至。秋，七月，贬霞寓为归州刺史，逊亦左迁恩王傅。以河南尹郑权为山南东道节度使。以荆南节度使袁滋为彰义节度、申·光·蔡·唐·随·邓观察使，以唐州为理所。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24216,"path":"资治通鉴 : 卷第二百三十九 (唐紀五十五) / 憲宗昭文章武大聖至神孝皇帝中之上 / 十一年 / 第 22 段","reading_annotation_sources":[],"start_index":21,"tongjian_id":"c3148a0a-db0e-11ef-ac54-a0d3651f611f","year_int":816},"tongjian_id":"c3148a0a-db0e-11ef-ac54-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","resolved_place_entity_id":1933,"start_index":37,"tongjian_id":"c383474c-db0e-11ef-9b24-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2庚戌，以德州刺史王日簡爲橫海節度使。日簡，本成德牙將也。壬子，貶杜叔良爲歸州刺史。","content_fanyi":"正月十八日庚戌，朝廷任命德州刺史王日简出任横海节度使。王日简原本是成德军牙将。正月二十日壬子，朝廷将杜叔良贬为归州刺史。","content_jianti_auto":"2庚戌，以德州刺史王日简为横海节度使。日简，本成德牙将也。壬子，贬杜叔良为归州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":24528,"number":2,"path":"资治通鉴 : 卷第二百四十二 (唐紀五十八) / 穆宗睿聖文惠孝皇帝中 / 二年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"c3834745-db0e-11ef-bd0b-a0d3651f611f","year_int":822},"tongjian_id":"c3834745-db0e-11ef-bd0b-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"禹","people_name_jianti_auto":"禹","start_index":0,"tongjian_id":"c6662cdb-db0e-11ef-8d59-a0d3651f611f"},{"people_name":"陳儒","people_name_jianti_auto":"陈儒","start_index":6,"tongjian_id":"c6662cdc-db0e-11ef-9703-a0d3651f611f"},{"people_name":"薛","people_name_jianti_auto":"薛","start_index":21,"tongjian_id":"c6662cdd-db0e-11ef-949f-a0d3651f611f"},{"people_name":"成汭","people_name_jianti_auto":"成汭","start_index":24,"tongjian_id":"c6662cde-db0e-11ef-885a-a0d3651f611f"},{"people_name":"郭氏","people_name_jianti_auto":"郭氏","start_index":50,"tongjian_id":"c6662cdf-db0e-11ef-82f0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"禹先爲盜，詣陳儒降，以爲將。更，工衡翻。按薛史，成汭少年任俠，乘醉殺人，爲讎家所捕，因落髮爲僧，冒姓郭氏。","note_content_jianti_auto":"禹先为盗，诣陈儒降，以为将。更，工衡翻。按薛史，成汭少年任侠，乘醉杀人，为雠家所捕，因落发为僧，冒姓郭氏。","note_type":"hu_note","start_index":116,"tongjian_id":"c6662cda-db0e-11ef-9fe6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c6662cd7-db0e-11ef-8aeb-a0d3651f611f","pinyin":"piāo","source_anchor_text":"牙將郭禹慓悍欲殺之","source_key":"baiyang_epub","start_index":66,"text":"慓","tongjian_id":"0f320122-a2c5-5cb1-a63c-96fd5e5ec24e"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c6662cd7-db0e-11ef-8aeb-a0d3651f611f","pinyin":"ruì","source_anchor_text":"青州人成汭也因殺人","source_key":"baiyang_epub","start_index":102,"text":"汭","tongjian_id":"49292250-ae72-51a6-a102-4a0799ee2ee0"}],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":85,"tongjian_id":"c6662cec-db0e-11ef-89d9-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"先是，朱敬玫屢殺大將及富商以致富，朝廷遣中使楊玄晦代之。敬玫留居荊南，嘗曝衣，瓌見而欲之，遣卒夜攻之，殺敬玫，盡取其財。瓌惡牙將郭禹慓悍，欲殺之，禹結黨千人亡去，庚申，襲歸州，據之，自稱刺史。禹，青州人成汭也，因殺人亡命，更其姓名。","content_fanyi":"此前，朱敬玫多次杀死军中大将和富商来聚敛财富，朝廷派中使杨玄晦前去接替他。朱敬玫留居荆南时，一次晾晒衣物被张瓌看见，张瓌起了贪念，就趁夜派兵攻打他，杀死朱敬玫，夺走了他的全部财物。张瓌厌恶牙将郭禹剽悍，想除掉他，郭禹便集结同党一千人逃走；庚申日，他袭击归州并占据该地，自称刺史。郭禹本是青州人成汭，因杀人逃亡，才改换姓名。","content_jianti_auto":"先是，朱敬玫屡杀大将及富商以致富，朝廷遣中使杨玄晦代之。敬玫留居荆南，尝曝衣，瓌见而欲之，遣卒夜攻之，杀敬玫，尽取其财。瓌恶牙将郭禹慓悍，欲杀之，禹结党千人亡去，庚申，袭归州，据之，自称刺史。禹，青州人成汭也，因杀人亡命，更其姓名。","dtjl_paragraph_links":[],"dtjl_references":[],"id":26274,"path":"资治通鉴 : 卷第二百五十六 (唐紀七十二) / 僖宗惠聖恭定孝皇帝下之上 / 光啓元年 / 第 5 段","reading_annotation_sources":[],"start_index":4,"tongjian_id":"c6662cd7-db0e-11ef-8aeb-a0d3651f611f","year_int":885},"tongjian_id":"c6662cd7-db0e-11ef-8aeb-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王建肇","people_name_jianti_auto":"王建肇","start_index":0,"tongjian_id":"c6be0ade-db0e-11ef-a07f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"荊南","place_name_jianti_auto":"荆南","start_index":6,"tongjian_id":"c6be0adf-db0e-11ef-8b4b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"王建肇去年據荊南。","note_content_jianti_auto":"王建肇去年据荆南。","note_type":"hu_note","start_index":17,"tongjian_id":"c6be0add-db0e-11ef-bebd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昭宗","people_name_jianti_auto":"昭宗","start_index":0,"tongjian_id":"c6be0ae1-db0e-11ef-b507-a0d3651f611f"},{"people_name":"成汭","people_name_jianti_auto":"成汭","start_index":7,"tongjian_id":"c6be0ae2-db0e-11ef-aabc-a0d3651f611f"},{"people_name":"李神福","people_name_jianti_auto":"李神福","start_index":13,"tongjian_id":"c6be0ae3-db0e-11ef-b7ff-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"淮南","place_name_jianti_auto":"淮南","start_index":10,"tongjian_id":"c6be0ae4-db0e-11ef-9f51-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"昭宗天復三年，成汭爲淮南將李神福所敗而死。所謂晚年，殆此時也。治，直吏翻。","note_content_jianti_auto":"昭宗天复三年，成汭为淮南将李神福所败而死。所谓晚年，殆此时也。治，直吏翻。","note_type":"hu_note","start_index":69,"tongjian_id":"c6be0ae0-db0e-11ef-b6b8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":2,"tongjian_id":"c6be0ae7-db0e-11ef-9769-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"19歸州刺史郭禹擊荊南，逐王建肇，建肇奔黔州。詔以禹爲荊南留後。荊南兵荒之餘，止有一十七家，禹勵精爲治，撫集彫殘，通商務農，晚年殆及萬戶。時藩鎭各務兵力相殘，莫以養民爲事，獨華州刺史韓建招撫流散，勸課農桑，數年之間，民富軍贍。時人謂之北韓南郭。","content_fanyi":"归州刺史郭禹攻打荆南，驱逐王建肇，王建肇逃奔黔州。唐昭宗下诏任命郭禹为荆南留后。荆南兵荒马乱之后，只余下十七户人家，郭禹振作精神，励精图治，安抚招集残存疲敝的百姓，通商务农，到晚年时户口几乎增至一万户。当时各藩镇都致力于用兵相互残杀，没有人把养育百姓当作政事，唯独华州刺史韩建招集安抚流散百姓，劝勉奖励农桑，几年之间，百姓富足，军队给养充足。当时的人把他们合称为“北韩南郭”。","content_jianti_auto":"19归州刺史郭禹击荆南，逐王建肇，建肇奔黔州。诏以禹为荆南留后。荆南兵荒之余，止有一十七家，禹励精为治，抚集雕残，通商务农，晚年殆及万户。时藩镇各务兵力相残，莫以养民为事，独华州刺史韩建招抚流散，劝课农桑，数年之间，民富军赡。时人谓之北韩南郭。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"。此数子者，君子酌天地之心，顺民物之欲，予之焉可矣。存其...","context_before":"...张全义招怀流散于东都，躬劝农桑；杨行密定扬州，辇米赈饥；","source_end_index":203,"source_paragraph_tongjian_id":"097e0443-7ddb-4f5f-8efa-dbd237d5561f","source_start_index":189,"source_text":"成汭抚集凋残于荆南，通商劝农"}],"title":"一〇 社稷不存以保民者为重"}],"id":26478,"number":19,"path":"资治通鉴 : 卷第二百五十七 (唐紀七十三) / 僖宗惠聖恭定孝皇帝下之下 / 文德元年 / 第 23 段","reading_annotation_sources":[],"start_index":22,"tongjian_id":"c6be0adc-db0e-11ef-9a82-a0d3651f611f","year_int":888},"tongjian_id":"c6be0adc-db0e-11ef-9a82-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","start_index":0,"tongjian_id":"c98e233d-db0e-11ef-9956-a0d3651f611f"},{"place_name":"荊南","place_name_jianti_auto":"荆南","start_index":3,"tongjian_id":"c98e233e-db0e-11ef-8e8e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歸州屬荊南。","note_content_jianti_auto":"归州属荆南。","note_type":"hu_note","start_index":18,"tongjian_id":"c98e233c-db0e-11ef-88b8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":8,"tongjian_id":"c98e2342-db0e-11ef-9b35-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7西川將王宗阮攻歸州，獲其將韓從實。","content_fanyi":"西川将领王宗阮进攻归州，俘获归州将领韩从实。","content_jianti_auto":"7西川将王宗阮攻归州，获其将韩从实。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27441,"number":7,"path":"资治通鉴 : 卷第二百六十五 (唐紀八十一) / 昭宣光烈孝皇帝 / 三年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"c98e233b-db0e-11ef-a8ff-a0d3651f611f","year_int":906},"tongjian_id":"c98e233b-db0e-11ef-a8ff-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","start_index":0,"tongjian_id":"c9ce55ad-db0e-11ef-a31a-a0d3651f611f"},{"place_name":"荊南","place_name_jianti_auto":"荆南","start_index":3,"tongjian_id":"c9ce55ae-db0e-11ef-a915-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歸州，荊南巡屬。不地曰入，言入之而不能有其地。","note_content_jianti_auto":"归州，荆南巡属。不地曰入，言入之而不能有其地。","note_type":"hu_note","start_index":11,"tongjian_id":"c9ce55ac-db0e-11ef-9e22-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":8,"tongjian_id":"c9ce55b0-db0e-11ef-b9f6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10甲子，蜀兵入歸州，執刺史張瑭。","content_fanyi":"二月二十三日甲子，前蜀军队攻入归州，俘获了归州刺史张瑭。","content_jianti_auto":"10甲子，蜀兵入归州，执刺史张瑭。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27567,"number":10,"path":"资治通鉴 : 卷第二百六十六 (後梁紀一) / 太祖神武元聖孝皇帝上 / 二年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"c9ce55ab-db0e-11ef-bc6e-a0d3651f611f","year_int":908},"tongjian_id":"c9ce55ab-db0e-11ef-bc6e-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高季興","people_name_jianti_auto":"高季兴","start_index":3,"tongjian_id":"cbc83b08-db0e-11ef-91ed-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":0,"tongjian_id":"cbc83b09-db0e-11ef-8080-a0d3651f611f"},{"place_name":"夔州","place_name_jianti_auto":"夔州","place_note":"宁江战区总部所在•重庆市奉节县","start_index":14,"tongjian_id":"cbc83b0a-db0e-11ef-b8b1-a0d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":18,"tongjian_id":"cbc83b0b-db0e-11ef-b8d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歸州，高季興巡屬也。九域志：夔州東至歸州三百三十里。幾，居豈翻。復，扶又翻；下宜復同。","note_content_jianti_auto":"归州，高季兴巡属也。九域志：夔州东至归州三百三十里。几，居岂翻。复，扶又翻；下宜复同。","note_type":"hu_note","start_index":26,"tongjian_id":"cbc83b07-db0e-11ef-8cbc-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":14,"tongjian_id":"cbc83b0f-db0e-11ef-b613-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8壬辰，寧江節度使西方鄴攻拔歸州；未幾，荊南復取之。","content_fanyi":"二月十六日壬辰，宁江节度使西方邺攻下归州；没过多久，荆南又把归州夺了回去。","content_jianti_auto":"8壬辰，宁江节度使西方邺攻拔归州；未几，荆南复取之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28704,"number":8,"path":"资治通鉴 : 卷第二百七十六 (後唐紀五) / 明宗聖德和武欽孝皇帝中之上 / 三年 / 第 8 段","reading_annotation_sources":[],"start_index":7,"tongjian_id":"cbc83b06-db0e-11ef-856c-a0d3651f611f","year_int":928},"tongjian_id":"cbc83b06-db0e-11ef-856c-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"歸州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"西方鄴","people_name_jianti_auto":"西方邺","start_index":10,"tongjian_id":"cbd60258-db0e-11ef-bf9b-a0d3651f611f"},{"people_name":"高季興","people_name_jianti_auto":"高季兴","start_index":25,"tongjian_id":"cbd60259-db0e-11ef-9709-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"忠州","place_name_jianti_auto":"忠州","place_note":"重庆市忠县","start_index":0,"tongjian_id":"cbd6025a-db0e-11ef-96fb-a0d3651f611f"},{"place_name":"夔州","place_name_jianti_auto":"夔州","start_index":4,"tongjian_id":"cbd6025b-db0e-11ef-9007-a0d3651f611f"},{"place_name":"寧江軍","place_name_jianti_auto":"宁江军","start_index":6,"tongjian_id":"cbd6025c-db0e-11ef-b206-a0d3651f611f"},{"place_name":"歸州","place_name_jianti_auto":"归州","start_index":17,"tongjian_id":"cbd6025d-db0e-11ef-b322-a0d3651f611f"},{"place_name":"荊南軍","place_name_jianti_auto":"荆南军","start_index":21,"tongjian_id":"cbd6025e-db0e-11ef-b63a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"忠州時屬夔州寧江軍，西方鄴所部也。歸州時屬荊南軍，高季興所部也。","note_content_jianti_auto":"忠州时属夔州宁江军，西方邺所部也。归州时属荆南军，高季兴所部也。","note_type":"hu_note","start_index":12,"tongjian_id":"cbd60257-db0e-11ef-aa34-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"歸州","place_name_jianti_auto":"归州","place_note":"湖北省秭归县","resolved_place_entity_id":1933,"start_index":9,"tongjian_id":"cbd60261-db0e-11ef-ac89-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"47忠州刺史王雅取歸州。","content_fanyi":"忠州刺史王雅攻下归州。","content_jianti_auto":"47忠州刺史王雅取归州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28745,"number":47,"path":"资治通鉴 : 卷第二百七十六 (後唐紀五) / 明宗聖德和武欽孝皇帝中之上 / 三年 / 第 49 段","reading_annotation_sources":[],"start_index":48,"tongjian_id":"cbd60256-db0e-11ef-9d11-a0d3651f611f","year_int":928},"tongjian_id":"cbd60256-db0e-11ef-9d11-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":2,"total_paragraphs":11},"place_name":"歸州"},"message":"success","success":true}