ildren_pinyin":[],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","resolved_place_entity_id":84,"start_index":0,"tongjian_id":"ca6927b8-db0e-11ef-8fbd-a0d3651f611f"},{"place_name":"滄州","place_name_jianti_auto":"沧州","resolved_place_entity_id":620,"start_index":6,"tongjian_id":"ca6927b9-db0e-11ef-9409-a0d3651f611f"},{"place_name":"燕樂","place_name_jianti_auto":"燕乐","place_note":"北京市密云县东北","resolved_place_entity_id":8190,"start_index":25,"tongjian_id":"ca6927ba-db0e-11ef-a770-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"后唐灭后梁之战","tongjian_id":"war_N1071"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/露布","excerpts":[{"context_after":"。然亦有所从来。魏高祖南伐，长史韩显宗与齐戍将力战，斩其...","context_before":"...刘勰《文心雕龙》云：“露布者，盖露板不封，布诸观听也。”","source_end_index":120,"source_paragraph_tongjian_id":"032e7dc7-6e12-4e61-97c9-a10e5af56902","source_start_index":75,"source_text":"唐庄宗为晋王时，擒灭刘守光，命掌书记王缄草露布，缄不知故事，书之于布，遣人曳之，为议者所笑"}],"path":"四笔/卷十/露布","source_name":"容斋随笔"},{"display_title":"读史方舆纪要/一、顺天府（卷十一）","excerpts":[{"context_after":"县寻废。宋白曰：燕乐、密云，皆汉厗奚县地。五代时，废为燕...","context_before":"...此。《旧唐书》：燕乐县初治白檀城，长寿二年，移治新兴城。","source_end_index":177,"source_paragraph_tongjian_id":"829ad743-5aca-57e3-98de-fd9d4df8671d","source_start_index":151,"source_text":"五代梁乾化三年，晋将周德威伐燕，刘守光奔燕乐，被擒。"}],"path":"北直方舆纪要/一、顺天府（卷十一）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"燕主守光將奔滄州就劉守奇，涉寒，足腫，且迷失道，至燕樂之境，晝匿阬谷，數日不食，令妻祝氏乞食於田父張師造家。師造怪婦人異狀，詰知守光處，幷其三子擒之。癸酉，晉王方宴，將吏擒守光適至，王語之曰：「主人何避客之深邪！」幷仁恭置之館舍，以器服膳飲賜之。王命掌書記王緘草露布，緘不知故事，書之於布，遣人曳之。","content_fanyi":"燕主刘守光准备逃往沧州投靠刘守奇，因冒着严寒赶路，脚部肿胀，又迷失了道路。行至燕乐县境内，白天藏在坑谷中，几天没有吃东西，让妻子祝氏到老农张师造家乞讨食物。张师造见那妇人形迹异常，盘问出刘守光的藏身之处，便连同他的三个儿子一起擒获。癸酉日，晋王正在宴饮，将吏押着刘守光恰好到来，晋王对刘守光说：“主人为什么这样畏避客人呢！”于是把刘仁恭和刘守光安置在馆舍中，赐给他们器物、衣服和饮食。晋王又命掌书记王缄草拟宣示天下的露布，王缄不知旧例，就写在布上，派人拖着它。","content_jianti_auto":"燕主守光将奔沧州就刘守奇，涉寒，足肿，且迷失道，至燕乐之境，昼匿阬谷，数日不食，令妻祝氏乞食于田父张师造家。师造怪妇人异状，诘知守光处，幷其三子擒之。癸酉，晋王方宴，将吏擒守光适至，王语之曰：「主人何避客之深邪！」幷仁恭置之馆舍，以器服膳饮赐之。王命掌书记王缄草露布，缄不知故事，书之于布，遣人曳之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27900,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"ca69279c-db0e-11ef-93a8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"幽州","place_name_jianti_auto":"幽州","start_index":1,"tongjian_id":"ca6927c6-db0e-11ef-a7e9-a0d3651f611f"},{"place_name":"雲","place_name_jianti_auto":"云","start_index":9,"tongjian_id":"ca6927c7-db0e-11ef-bcdd-a0d3651f611f"},{"place_name":"代","place_name_jianti_auto":"代","place_note":"山西代县","start_index":11,"tongjian_id":"ca6927c8-db0e-11ef-9679-a0d3651f611f"},{"place_name":"晉陽","place_name_jianti_auto":"晋阳","start_index":15,"tongjian_id":"ca6927c9-db0e-11ef-860c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"自幽州取山後路，歷雲、代等州至晉陽。","note_content_jianti_auto":"自幽州取山后路，历云、代等州至晋阳。","note_type":"hu_note","start_index":9,"tongjian_id":"ca6927c5-db0e-11ef-b99a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王處直","people_name_jianti_auto":"王处直","start_index":0,"tongjian_id":"ca6927cb-db0e-11ef-92c6-a0d3651f611f"},{"people_name":"王鎔","people_name_jianti_auto":"王镕","start_index":4,"tongjian_id":"ca6927cc-db0e-11ef-919d-a0d3651f611f"},{"people_name":"晉王","people_name_jianti_auto":"晋王","start_index":7,"tongjian_id":"ca6927cd-db0e-11ef-b217-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"中山","place_name_jianti_auto":"中山","start_index":11,"tongjian_id":"ca6927ce-db0e-11ef-bee1-a0d3651f611f"},{"place_name":"眞定","place_name_jianti_auto":"真定","start_index":14,"tongjian_id":"ca6927cf-db0e-11ef-9c9c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"王處直，王鎔欲晉王取道中山、眞定，各展迎賀之禮。趣，七喻翻。","note_content_jianti_auto":"王处直，王镕欲晋王取道中山、真定，各展迎贺之礼。趣，七喻翻。","note_type":"hu_note","start_index":27,"tongjian_id":"ca6927ca-db0e-11ef-b115-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"荷，下可翻，又音何。校，爻敎翻。易曰：荷校滅耳。註云：校者，以木絞校者也，卽械也；校者取其通名也。","note_content_jianti_auto":"荷，下可翻，又音何。校，爻教翻。易曰：荷校灭耳。注云：校者，以木绞校者也，即械也；校者取其通名也。","note_type":"hu_note","start_index":54,"tongjian_id":"ca6927d0-db0e-11ef-b6fc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"北嶽廟","place_name_jianti_auto":"北岳庙","place_note":"河北省曲阳县西•当时北岳所在","start_index":0,"tongjian_id":"ca6927d5-db0e-11ef-b610-a0d3651f611f"},{"place_name":"恆山","place_name_jianti_auto":"恒山","start_index":4,"tongjian_id":"ca6927d6-db0e-11ef-9721-a0d3651f611f"},{"place_name":"大茂山","place_name_jianti_auto":"大茂山","start_index":7,"tongjian_id":"ca6927d7-db0e-11ef-a3bd-a0d3651f611f"},{"place_name":"恆山","place_name_jianti_auto":"恒山","start_index":11,"tongjian_id":"ca6927d8-db0e-11ef-8bd4-a0d3651f611f"},{"place_name":"定州","place_name_jianti_auto":"定州","start_index":14,"tongjian_id":"ca6927d9-db0e-11ef-82ec-a0d3651f611f"},{"place_name":"曲陽縣","place_name_jianti_auto":"曲阳县","start_index":16,"tongjian_id":"ca6927da-db0e-11ef-9b9e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"北嶽廟在恆山之大茂山；恆山在定州曲陽縣西北。","note_content_jianti_auto":"北岳庙在恒山之大茂山；恒山在定州曲阳县西北。","note_type":"hu_note","start_index":110,"tongjian_id":"ca6927d4-db0e-11ef-92e1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_