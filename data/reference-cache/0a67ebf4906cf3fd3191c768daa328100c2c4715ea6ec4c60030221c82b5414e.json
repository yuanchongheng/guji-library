otes":[],"note_content":"朱景，霍丘土豪也，吳用以爲將，守霍丘。浮表於木者，徙梁所立之表，其下接之以木，立諸深淵以誤之。","note_content_jianti_auto":"朱景，霍丘土豪也，吴用以为将，守霍丘。浮表于木者，徙梁所立之表，其下接之以木，立诸深渊以误之。","note_type":"hu_note","start_index":207,"tongjian_id":"ca66dd49-db0e-11ef-96f5-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"鎭海節度使","official_note":"鎭海節度使是唐代至五代時期的地方軍事和行政長官，掌管鎭海地區的軍政事務。在《資治通鑑》此段中，徐溫擔任此職，負責指揮吳軍對抗梁軍，體現了其在戰爭中的領導角色。","official_rank":"未知","source_snippet":"吳鎭海節度使徐溫","start_index":3,"tongjian_id":"d0f1a8e7-7d47-40f1-be8c-c74e969d646f"},{"confidence":0.95,"official_category":"地方行政","official_name":"平盧節度使","official_note":"平盧節度使是唐代至五代時期的地方軍事和行政長官，掌管平盧地區的軍政事務。在《資治通鑑》此段中，朱瑾擔任此職，與徐溫共同率軍對抗梁軍，顯示其在吳國軍事行動中的重要性。","official_rank":"未知","source_snippet":"平盧節度使朱瑾","start_index":11,"tongjian_id":"3374e441-4778-449e-878f-1ce65fe486b7"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"左驍衞大將軍","official_note":"左驍衞大將軍是唐代至五代時期的禁軍高級武官，負責宮廷和京城的防衛。在《資治通鑑》此段中，陳紹擔任此職，在戰鬥中表現勇猛，扭轉戰局，體現了其軍事指揮和戰鬥能力。","official_rank":"未知","source_snippet":"左驍衞大將軍宛丘陳紹","start_index":56,"tongjian_id":"104ac388-3cbe-4149-a233-46c16586ba17"},{"confidence":0.85,"official_category":"地方行政","official_name":"霍丘守將","official_note":"霍丘守將是地方守備官員，負責霍丘地區的防禦和治理。在《資治通鑑》此段中，朱景擔任此職，通過移動標記物導致梁軍在撤退時溺死，顯示其在戰爭中的策略作用。","official_rank":"未知","source_snippet":"霍丘守將朱景","start_index":155,"tongjian_id":"81f2fd29-e88c-43ec-a2d2-94a76527138d"}],"ExtRef_Children_people":[{"link_birth_year":862,"link_death_year":927,"link_td_description":"徐温，字敦美，海州胊山（今江苏东海）人，唐末军事人物。南唐建立者徐知诰（李昪）养父，庙号义祖。","link_td_id":"Q10000403","link_td_number_id":207020,"people_name":"徐溫","people_name_jianti_auto":"徐温","people_xingming":"徐温","start_index":11,"tongjian_id":"ca69276c-db0e-11ef-9dda-a0d3651f611f"},{"link_birth_year":867,"link_death_year":918,"link_td_description":"朱瑾，唐末军事人物，天平节度使朱瑄从弟，善槊，壮武勇猛，兖州泰宁军节度使齐克让颇爱之，瑾遂假意要娶齐氏之女，却趁机突击齐氏而驱逐之，自为泰宁节度使。后为朱温所败，奔杨行密。后因徐温之子徐知训辱瑾，瑾怒，杀知训。徐温发兵迫之，遂自刎死。","link_td_id":"Q10001003","link_td_number_id":543943,"people_name":"朱瑾","people_name_jianti_auto":"朱瑾","people_xingming":"朱瑾","start_index":19,"tongjian_id":"ca69276d-db0e-11ef-9252-a0d3651f611f"},{"link_birth_year":862,"link_death_year":927,"link_td_description":"徐温，字敦美，海州胊山（今江苏东海）人，唐末军事人物。南唐建立者徐知诰（李昪）养父，庙号义祖。","link_td_id":"Q10000403","link_td_number_id":207020,"people_name":"溫","people_name_jianti_auto":"温","people_xingming":"徐温","start_index":38,"tongjian_id":"ca692772-db0e-11ef-b41b-a0d3651f611f"},{"link_death_year":914,"link_td_description":"王景仁，本名王茂章（改名于906年？），中国五代十国时期后梁大将。初为唐朝末年吴王杨行密将，后与杨行密之子和继承人杨渥有争执，被迫逃奔吴越王钱镠，后梁太祖皇帝朱全忠欣赏他的能力，作为后梁封臣的钱镠又将他送到后梁，太祖用他为将。但在随后对吴国和梁北面敌国晋国的战事中，他并不成功。","link_td_id":"Q10003869","link_td_number_id":5065963,"people_name":"景仁","people_name_jianti_auto":"景仁","people_xingming":"王景仁","start_index":45,"tongjian_id":"ca692773-db0e-11ef-8a25-a0d3651f611f"},{"link_death_year":914,"link_td_description":"王景仁，本名王茂章（改名于906年？），中国五代十国时期后梁大将。初为唐朝末年吴王杨行密将，后与杨行密之子和继承人杨渥有争执，被迫逃奔吴越王钱镠，后梁太祖皇帝朱全忠欣赏他的能力，作为后梁封臣的钱镠又将他送到后梁，太祖用他为将。但在随后对吴国和梁北面敌国晋国的战事中，他并不成功。","link_td_id":"Q10003869","link_td_number_id":5065963,"people_name":"景仁","people_name_jianti_auto":"景仁","start_index":54,"tongjian_id":"ca692774-db0e-11ef-8261-a0d3651f611f"},{"people_name":"陳紹","people_name_jianti_auto":"陈绍","people_xingming":"陈绍","start_index":81,"tongjian_id":"ca692776-db0e-11ef-bce0-a0d3651f611f"},{"link_birth_year":862,"link_death_year":927,"link_td_description":"徐温，字敦美，海州胊山（今江苏东海）人，唐末军事人物。南唐建立者徐知诰（李昪）养父，庙号义祖。","link_td_id":"Q10000403","link_td_number_id":207020,"people_name":"溫","people_name_jianti_auto":"温","start_index":115,"tongjian_id":"ca692779-db0e-11ef-abb0-a0d3651f611f"},{"people_name":"紹","people_name_jianti_auto":"绍","people_xingming":"陈绍","start_index":139,"tongjian_id":"ca69277b-db0e-11ef-882e-a0d3651f611f"},{"link_death_year":914,"link_td_description":"王景仁，本名王茂章（改名于906年？），中国五代十国时期后梁大将。初为唐朝末年吴王杨行密将，后与杨行密之子和继承人杨渥有争执，被迫逃奔吴越王钱镠，后梁太祖皇帝朱全忠欣赏他的能力，作为后梁封臣的钱镠又将他送到后梁，太祖用他为将。但在随后对吴国和梁北面敌国晋国的战事中，他并不成功。","link_td_id":"Q10003869","link_t