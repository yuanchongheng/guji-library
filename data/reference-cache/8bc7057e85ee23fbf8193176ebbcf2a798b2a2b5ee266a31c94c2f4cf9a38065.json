ea95596-db0e-11ef-a3e0-a0d3651f611f"},{"people_name":"湯","people_name_jianti_auto":"汤","start_index":91,"tongjian_id":"8ea95597-db0e-11ef-926e-a0d3651f611f"},{"people_name":"武王","people_name_jianti_auto":"武王","start_index":93,"tongjian_id":"8ea95598-db0e-11ef-8144-a0d3651f611f"},{"people_name":"文王","people_name_jianti_auto":"文王","start_index":100,"tongjian_id":"8ea95599-db0e-11ef-9b86-a0d3651f611f"},{"people_name":"寧王","people_name_jianti_auto":"宁王","start_index":103,"tongjian_id":"8ea9559a-db0e-11ef-abb1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"韋昭曰：生以武爲號，不稽古也。師古曰：此說非也。湯曰：「吾武甚，自號曰武王」。佗言武帝，亦猶是耳，何謂其不稽古乎！貢父曰：顏雖引成湯之言，然未知湯自號武王乎？聖人者，人與之名耳。詩謂湯爲武王，亦猶書謂文王爲寧王耳。史記之言，未可信也。","note_content_jianti_auto":"韦昭曰：生以武为号，不稽古也。师古曰：此说非也。汤曰：「吾武甚，自号曰武王」。佗言武帝，亦犹是耳，何谓其不稽古乎！贡父曰：颜虽引成汤之言，然未知汤自号武王乎？圣人者，人与之名耳。诗谓汤为武王，亦犹书谓文王为宁王耳。史记之言，未可信也。","note_type":"hu_note","start_index":11,"tongjian_id":"8ea9558b-db0e-11ef-bece-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-240,"link_death_year":-137,"link_td_description":"赵佗，恒山郡真定县（今河北省正定县）人，秦朝南海龙川令，南越国创建者，是南越国第一代王和皇帝。","link_td_id":"Q10000453","link_td_number_id":52649,"people_name":"佗","people_name_jianti_auto":"佗","people_xingming":"赵佗","start_index":3,"tongjian_id":"8ea9559f-db0e-11ef-a16d-a0d3651f611f"},{"link_birth_year":-240,"link_death_year":-137,"link_td_description":"赵佗，恒山郡真定县（今河北省正定县）人，秦朝南海龙川令，南越国创建者，是南越国第一代王和皇帝。","link_td_id":"Q10000453","link_td_number_id":52649,"people_name":"南越武帝","people_name_jianti_auto":"南越武帝","people_xingming":"赵佗","start_index":6,"tongjian_id":"8ea955a0-db0e-11ef-b808-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長沙","place_name_jianti_auto":"长沙","resolved_place_entity_id":311,"start_index":14,"tongjian_id":"8ea955a1-db0e-11ef-9212-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/叙","excerpts":[{"context_after":"夫陀固未尝一日而忘用兵也。观其初行尉事，即击并桂林、象郡...","context_before":"...定天下，急封吴芮以长沙，所以塞岭南之口也，陀遂不敢与抗。","source_end_index":589,"source_paragraph_tongjian_id":"24a93877-61e9-5d61-bd71-49b346dcf16f","source_start_index":546,"source_text":"及吕后乱政，陀始自尊为帝，发兵攻长沙边邑，败数县而去。吕后亡而陀兵亦罢矣，陀亦智矣哉！"}],"path":"广东方舆纪要/叙","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1春，佗自稱南越武帝，發兵攻長沙，敗數縣而去。","content_fanyi":"春季，赵佗自称南越武帝，发兵进攻长沙国，打败几个县的守军后离去。","content_jianti_auto":"1春，佗自称南越武帝，发兵攻长沙，败数县而去。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1015,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8ea9558a-db0e-11ef-afe0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-183,"link_td_description":"刘强，汉惠帝之子，生母不详。吕后元年（前187年）四月，被立为淮阳王。","link_td_id":"Q10004344","link_td_number_id":1296186,"people_name":"淮陽懷王","people_name_jianti_auto":"淮阳怀王","people_xingming":"刘彊","start_index":6,"tongjian_id":"8ea955a3-db0e-11ef-a3fd-a0d3651f611f"},{"link_death_year":-183,"link_td_description":"刘强，汉惠帝之子，生母不详。吕后元年（前187年）四月，被立为淮阳王。","link_td_id":"Q10004344","link_td_number_id":1296186,"people_name":"彊","people_name_jianti_auto":"彊","people_xingming":"刘彊","start_index":10,"tongjian_id":"8ea955a4-db0e-11ef-94f6-a0d3651f611f"},{"link_death_year":-180,"link_td_description":"刘武，汉惠帝之子，生母不详。","link_td_id":"Q10002432","link_td_number_id":1296181,"people_name":"壺關侯","people_name_jianti_auto":"壶关侯","people_xingming":"刘武","start_index":14,"tongjian_id":"8ea955a5-db0e-11ef-a854-a0d3651f611f"},{"link_death_year":-180,"link_td_description":"刘武，汉惠帝之子，生母不详。","link_td_id":"Q10002432","link_td_number_id":1296181,"people_name":"武","people_name_jianti_auto":"武","people_xingming":"刘武","start_index":17,"tongjian_id":"8ea955a6-db0e-11ef-aaf3-a0d3651f611f","wl_zhushi":"[刘盈子]"},