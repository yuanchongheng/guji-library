8988-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"向","people_name_jianti_auto":"向","start_index":9,"tongjian_id":"8c760654-db0e-11ef-bec7-a0d3651f611f"},{"people_name":"向姓","people_name_jianti_auto":"向姓","start_index":21,"tongjian_id":"8c760655-db0e-11ef-8818-a0d3651f611f"},{"people_name":"宋文公","people_name_jianti_auto":"宋文公","start_index":25,"tongjian_id":"8c760656-db0e-11ef-ab00-a0d3651f611f"},{"people_name":"向文旰","people_name_jianti_auto":"向文旰","start_index":30,"tongjian_id":"8c760657-db0e-11ef-8c9b-a0d3651f611f"},{"people_name":"旰","people_name_jianti_auto":"旰","start_index":34,"tongjian_id":"8c760658-db0e-11ef-afa0-a0d3651f611f"},{"people_name":"戌","people_name_jianti_auto":"戌","start_index":36,"tongjian_id":"8c760659-db0e-11ef-948b-a0d3651f611f"},{"people_name":"向戌","people_name_jianti_auto":"向戌","start_index":49,"tongjian_id":"8c76065a-db0e-11ef-9acd-a0d3651f611f"},{"people_name":"宋桓公","people_name_jianti_auto":"宋桓公","start_index":54,"tongjian_id":"8c76065b-db0e-11ef-87ca-a0d3651f611f"},{"people_name":"孟子","people_name_jianti_auto":"孟子","start_index":58,"tongjian_id":"8c76065c-db0e-11ef-9877-a0d3651f611f"},{"people_name":"王驩","people_name_jianti_auto":"王驩","start_index":71,"tongjian_id":"8c76065d-db0e-11ef-817d-a0d3651f611f"},{"people_name":"趙岐","people_name_jianti_auto":"赵岐","start_index":77,"tongjian_id":"8c76065e-db0e-11ef-b07b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":61,"tongjian_id":"8c76065f-db0e-11ef-aecb-a0d3651f611f"},{"place_name":"滕","place_name_jianti_auto":"滕","start_index":67,"tongjian_id":"8c760660-db0e-11ef-9198-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令，盧經翻，使也。向，式讓翻，姓也。姓譜：向姓本自宋文公枝子向文旰，旰孫戌以王父字爲氏。余按左傳，向戌本出於宋桓公。孟子爲齊卿，出弔於滕，王使王驩爲輔行。趙岐註曰：輔行，副使也。旰，音榦。戌，音恤。傳，直戀翻。使，疏吏翻。","note_content_jianti_auto":"令，卢经翻，使也。向，式让翻，姓也。姓谱：向姓本自宋文公枝子向文旰，旰孙戌以王父字为氏。余按左传，向戌本出于宋桓公。孟子为齐卿，出吊于滕，王使王驩为辅行。赵岐注曰：辅行，副使也。旰，音干。戌，音恤。传，直恋翻。使，疏吏翻。","note_type":"hu_note","start_index":36,"tongjian_id":"8c760653-db0e-11ef-941a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"柳宗元","people_name_jianti_auto":"柳宗元","start_index":0,"tongjian_id":"8c760665-db0e-11ef-bf07-a0d3651f611f"},{"people_name":"鯀","people_name_jianti_auto":"鲧","start_index":27,"tongjian_id":"8c760666-db0e-11ef-869e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"息壤","place_name_jianti_auto":"息壤","start_index":19,"tongjian_id":"8c760667-db0e-11ef-9729-a0d3651f611f"},{"place_name":"息壤","place_name_jianti_auto":"息壤","start_index":31,"tongjian_id":"8c760668-db0e-11ef-a09c-a0d3651f611f"},{"place_name":"息壤","place_name_jianti_auto":"息壤","start_index":43,"tongjian_id":"8c760669-db0e-11ef-8cf4-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"柳宗元曰：地長隆然而起，夷之而益高者爲息壤。異書有云：鯀竊帝之息壤以堙洪水。意者此所謂息壤，蓋以地長得名。長，知兩翻。","note_content_jianti_auto":"柳宗元曰：地长隆然而起，夷之而益高者为息壤。异书有云：鲧窃帝之息壤以堙洪水。意者此所谓息壤，盖以地长得名。长，知两翻。","note_type":"hu_note","start_index":55,"tongjian_id":"8c760664-db0e-11ef-b491-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":0,"tongjian_id":"8c76066b-db0e-11ef-b320-a0d3651f611f"},{"people_name":"趙鞅","people_name_jianti_auto":"赵鞅","start_index":27,"tongjian_id":"8c76066c-db0e-11ef-9295-a0d3651f611f"},{"people_name":"甘茂","people_name_jianti_auto":"甘茂","start_index":59,"tongjian_id":"8c76066d-db0e-11ef-bcc4-a0d3651f611f"},{"people_name":"夏禹","people_name_jianti_auto":"夏禹","start_index":177,"tongjian_id":"8c76066e-db0e-11ef-bd10-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":4,"tongjian_id":"8c76066f-db0e-11ef-8711-a0d3651f611f"},{"place_name":"戰國","place_name_jianti_auto":"战国","start_index":47,"tongjian_id":"8c760670-db0e-11ef-9d5c-a0d3651f611f"},{"place_name":"宜陽","place_name_jianti_auto":"宜阳","start_index":64,"tongjian_id":"8c760671-db0e-11ef-9f4d-a0d3651f611f"},{"place_name":"陳","place_name_jianti_auto":"陈","start_index":88,"tongjian_id":"8c760672-db0e-11ef-a56d-a0d3651f611f"},{"place_name":"魯","place_name_jianti_auto":"鲁","start_index":90,"tongjian_id":"8c760673-db0e-11ef-b612-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":92,"tongjian_id":"8c760674-db0e-11ef-9f98-a0d3651f611f"},{"place_name":"吳","place_name_jianti_auto":"吴","start_index":94,"tongjian_id":"8c760675-db0e-11ef-a7bc-a0d3651f611f"},{"place_name":"長沙","place_name_jianti_auto":"长沙","start_index":103,"tongjian_id":"8c760676-db0e-11ef-afee-a0d3651f611f"},{"place_name":"丹陽","place_name_jianti_auto":"丹阳","start_index":106,"tongjian_id":"8c760677-db0e-11ef-ac05-a0d3651f611f"},{"place_name":"泰山","place_name_jianti_auto":"泰山","start_index":116,"tongjian_id":"8c760678-db0e-11ef-91d4-a0d3651f611f"},{"place_name":"山陽","place_name_jianti_auto":"山阳","start_index":119,"tongjian_id":"8c760679-db0e-11ef-aaf7-a0d3651f611f"},{"place_name":"西河","place_name_jianti_auto":"西河","start_index":129,"tongjian_id":"8c76067a-db0e-11ef-814c-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":132,"tongjian_id":"8c76067b-db0e-11ef-94bd-a0d3651f611f"},{"place_name":"金城","place_name_jianti_auto":"金城","start_index":142,"tongjian_id":"8c76067c-db0e-11ef-a039-a0d3651f611f"},{"place_name":"酒泉","place_name_jianti_auto":"酒泉","start_index":149,"tongjian_id":"8c76067d-db0e-11ef-9b46-a0d3651f611f"},{"place_name":"豫章","place_name_jianti_auto":"豫章","start_index":156,"tongjian_id":"8c76067e-db0e-11ef-a52f-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","start_index":163,"tongjian_id":"8c76067f-db0e-11ef-9330-a0d3651f611f"},{"place_name":"東冶","place_name_jianti_auto":"东冶","start_index":185,"tongjian_id":"8c760680-db0e-11ef-8aff-a0d3651f611f"},{"place_name":"會稽","place_name_jianti_auto":"会稽","start_index":194,"tongjian_id":"8c760681-db0e-11ef-89fa-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：春秋時列國相滅，多以其地爲縣，則縣大而郡小，故趙鞅曰：「上大夫受縣，下大夫受郡。」至于戰國，則郡大而縣小矣，故甘茂曰：「宜陽大縣，其實郡也。」漢官儀曰：凡郡：或以列國，陳、魯、齊、吳是也；或以舊邑，長沙、丹陽是也；或以山陵，泰山，山陽是也；或以川原，西河、河東是也；或以所出，金城城下得金、酒泉泉味如酒、豫章樟樹生庭、鴈門鴈之所育是也；或以號令，夏禹合諸侯，大計東冶之山會計，因名會稽是也。令，力正翻。名會，古外翻。","note_content_jianti_auto":"杜佑曰：春秋时列国相灭，多以其地为县，则县大而郡小，故赵鞅曰：「上大夫受县，下大夫受郡。」至于战国，则郡大而县小矣，故甘茂曰：「宜阳大县，其实郡也。」汉官仪曰：凡郡：或以列国，陈、鲁、齐、吴是也；或以旧邑，长沙、丹阳是也；或以山陵，泰山，山阳是也；或以川原，西河、河东是也；或以所出，金城城下得金、酒泉泉味如酒、豫章樟树生庭、鴈门鴈之所育是也；或以号令，夏禹合诸侯，大计东冶之山会计，因名会稽是也。令，力正翻。名会，古外翻。","note_type":"hu_note","start_index":69,"tongjian_id":"8c76066a-db0e-11ef-b952-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"函谷","place_name_jianti_auto":"函谷","start_index":15,"tongjian_id":"8c760684-db0e-11ef-81e3-a0d3651f611f"},{"place_name":"三崤","place_name_jianti_auto":"三崤","start_index":18,"tongjian_id":"8c760685-db0e-11ef-b8a6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"倍，與背同，音蒲妹翻。數險，謂函谷及三崤之險。","note_content_jianti_auto":"倍，与背同，音蒲妹翻。数险，谓函谷及三崤之险。","note_type":"hu_note","start_index":83,"tongjian_id":"8c760683-db0e-11ef-af01-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杼，直呂翻。說文曰：杼，機之持緯者，蓋今所謂梭。梭，蘇禾翻。","note_content_jianti_auto":"杼，直吕翻。说文曰：杼，机之持纬者，盖今所谓梭。梭，苏禾翻。","note_type":"hu_note","start_index":126,"tongjian_id":"8c760687-db0e-11ef-b5e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_p