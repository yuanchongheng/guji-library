s":[],"ExtRef_Children_zhang_notes":[],"note_content":"甘茂，楚下蔡人，故云然。羇，居宜翻，寄也。旅，客也。","note_content_jianti_auto":"甘茂，楚下蔡人，故云然。羇，居宜翻，寄也。旅，客也。","note_type":"hu_note","start_index":223,"tongjian_id":"8c76068d-db0e-11ef-a0c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"公仲侈","people_name_jianti_auto":"公仲侈","start_index":0,"tongjian_id":"8c760693-db0e-11ef-ba17-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"韓","place_name_jianti_auto":"韩","start_index":4,"tongjian_id":"8c760694-db0e-11ef-a0e9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"公仲侈，韓相也。","note_content_jianti_auto":"公仲侈，韩相也。","note_type":"hu_note","start_index":257,"tongjian_id":"8c760692-db0e-11ef-bcfd-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"庶長","official_note":"庶長是秦國官職，主要負責軍事指揮或貴族事務，此處庶長封與甘茂共同率軍攻打宜陽，顯示其在軍事行動中的角色。","official_rank":"未知","source_snippet":"甘茂、庶長封帥師伐宜陽","start_index":280,"tongjian_id":"f9c96f4e-4d17-4a67-8c01-c71357d8bc14"}],"ExtRef_Children_people":[{"link_birth_year":-329,"link_death_year":-307,"link_td_description":"秦武王，嬴姓，名荡，战国时期秦国君主。秦惠文王之子，在位4年。","link_td_id":"Q10000865","link_td_number_id":176299,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴荡","start_index":1,"tongjian_id":"8c7858ea-db0e-11ef-9a2a-a0d3651f611f","wl_zhushi":"[嬴荡]"},{"link_td_description":"甘茂，中国战国时期楚国下蔡邑（今安徽省蚌埠市凤台县）人。战国中期秦国名将。","link_td_id":"Q10011041","link_td_number_id":1209598,"people_name":"甘茂","people_name_jianti_auto":"甘茂","people_xingming":"甘茂","start_index":4,"tongjian_id":"8c7858eb-db0e-11ef-b60f-a0d3651f611f"},{"people_name":"向壽","people_name_jianti_auto":"向寿","people_xingming":"向寿","start_index":14,"tongjian_id":"8c7858ec-db0e-11ef-bba5-a0d3651f611f"},{"link_td_description":"甘茂，中国战国时期楚国下蔡邑（今安徽省蚌埠市凤台县）人。战国中期秦国名将。","link_td_id":"Q10011041","link_td_number_id":1209598,"people_name":"甘茂","people_name_jianti_auto":"甘茂","start_index":19,"tongjian_id":"8c7858ed-db0e-11ef-a282-a0d3651f611f"},{"people_name":"向壽","people_name_jianti_auto":"向寿","people_xingming":"向寿","start_index":22,"tongjian_id":"8c7858f0-db0e-11ef-915f-a0d3651f611f"},{"link_td_description":"甘茂，中国战国时期楚国下蔡邑（今安徽省蚌埠市凤台县）人。战国中期秦国名将。","link_td_id":"Q10011041","link_td_number_id":1209598,"people_name":"甘茂","people_name_jianti_auto":"甘茂","start_index":45,"tongjian_id":"8c7858f2-db0e-11ef-a667-a0d3651f611f"},{"link_birth_year":-505,"link_death_year":-432,"link_td_description":"曾子，春秋末期鲁国南武城（山东嘉祥县）人，儒家主要代表人物之一，孔子的弟子，世称“曾子”，有“宗圣”之称。","link_td_id":"Q10002146","link_td_number_id":113662,"people_name":"曾參","people_name_jianti_auto":"曾参","people_xingming":"曾参","start_index":87,"tongjian_id":"8c7858f5-db0e-11ef-bdfa-a0d3651f611f"},{"link_birth_year":-505,"link_death_year":-432,"link_td_description":"曾子，春秋末期鲁国南武城（山东嘉祥县）人，儒家主要代表人物之一，孔子的弟子，世称“曾子”，有“宗圣”之称。","link_td_id":"Q10002146","link_td_number_id":113662,"people_name":"曾參","people_name_jianti_auto":"曾参","start_index":131,"tongjian_id":"8c7858f7-db0e-11ef-9cf3-a0d3651f611f"},{"link_death_year":-396,"link_td_description":"魏文侯，安邑（今山西夏县）人。东周战国时魏国开国君主。姬姓，魏氏，名斯（《史记·魏世家》记其名为都）。周贞定王二十四年（前445年）继魏桓子位，周威烈王二年（前424年）称侯改元，威烈王二十三年（前403年）与韩、赵两家一起被周威烈王册封为诸侯，是为三家分晋，周安王六年（前396年）卒。魏文侯是魏桓子之子，魏国百年霸业的开创者。魏文侯在战国七雄中首先实行变法，改革政治，奖励耕战，兴修水利，发展封建经济。魏文侯被司马迁在《史记·儒林列传》中提到，被赞为“好学”。魏文侯经常向孔子的弟子子夏以及再传弟子田子方、段干木等请教，颇精通儒家思想。对于国势而言，魏文侯曾经迁都到魏县，试图扭转魏国的战略地位，又拜法家的李悝为相，以“食有劳而禄有功，使有能而赏必行，罚必当”为原则实行变法。魏国经过变法国势强盛，先后以乐羊为将败中山国，以吴起为将攻取秦国西河（今黄河与洛水间）五城。以西门豹为邺令，以北门可为酸枣令，以翟璜为上卿，改革政治，兴修水利，成为战国初期的强国之首。","link_td_id":"Q10008342","link_td_number_id":211476,"people_name":"魏文侯","people_name_jianti_auto":"魏文侯","people_xingming":"魏斯","start_index":161,"tongjian_id":"8c7858f8-db0e-11ef-b503-a0d3651f611f","wl_zhushi":"[魏斯]"},{"link_td_description":"乐羊，中山国人，战国时魏国的大将。是乐毅的先祖。","link_td_id":"Q10000064","link_td_number_id":2106,"people_name":"樂羊","people_name_jianti_auto":"乐羊","people_xingmin