_id":"8c76063a-db0e-11ef-94fd-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":45,"tongjian_id":"8c76063b-db0e-11ef-be0c-a0d3651f611f"},{"place_name":"父城縣","place_name_jianti_auto":"父城县","start_index":47,"tongjian_id":"8c76063c-db0e-11ef-9fff-a0d3651f611f"},{"place_name":"應鄕","place_name_jianti_auto":"应鄕","start_index":53,"tongjian_id":"8c76063d-db0e-11ef-a393-a0d3651f611f"},{"place_name":"應國","place_name_jianti_auto":"应国","start_index":57,"tongjian_id":"8c76063e-db0e-11ef-9288-a0d3651f611f"},{"place_name":"應城","place_name_jianti_auto":"应城","start_index":67,"tongjian_id":"8c76063f-db0e-11ef-bcc7-a0d3651f611f"},{"place_name":"應山","place_name_jianti_auto":"应山","start_index":70,"tongjian_id":"8c760640-db0e-11ef-bd16-a0d3651f611f"},{"place_name":"應國","place_name_jianti_auto":"应国","start_index":77,"tongjian_id":"8c760641-db0e-11ef-99df-a0d3651f611f"},{"place_name":"汝州","place_name_jianti_auto":"汝州","start_index":80,"tongjian_id":"8c760642-db0e-11ef-b69f-a0d3651f611f"},{"place_name":"魯山縣","place_name_jianti_auto":"鲁山县","start_index":82,"tongjian_id":"8c760643-db0e-11ef-91b6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳曰：邘、晉、應、韓，武之穆也。杜預註云：應國在襄陽城父縣西。余按襄陽無城父縣。後漢志，潁川父城縣西南有應鄕，古應國也。括地志曰：故應城因應山爲名。古之應國在汝州魯山縣東三十里。應，乙陵翻。邘，音于。","note_content_jianti_auto":"左传曰：邘、晋、应、韩，武之穆也。杜预注云：应国在襄阳城父县西。余按襄阳无城父县。后汉志，颍川父城县西南有应鄕，古应国也。括地志曰：故应城因应山为名。古之应国在汝州鲁山县东三十里。应，乙陵翻。邘，音于。","note_type":"hu_note","start_index":8,"tongjian_id":"8c76062f-db0e-11ef-9ecf-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c760648-db0e-11ef-b904-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":1,"start_index":3,"tongjian_id":"8c760649-db0e-11ef-a5d5-a0d3651f611f"},{"place_name":"應","place_name_jianti_auto"