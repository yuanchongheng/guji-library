28,"tongjian_id":"bebb504a-db0e-11ef-befc-a0d3651f611f"},{"people_name":"李奐","people_name_jianti_auto":"李奂","start_index":49,"tongjian_id":"bebb504b-db0e-11ef-b13d-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"陳","place_name_jianti_auto":"陈","start_index":0,"tongjian_id":"bebb504c-db0e-11ef-a902-a0d3651f611f"},{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":2,"tongjian_id":"bebb504d-db0e-11ef-a23a-a0d3651f611f"},{"place_name":"亳","place_name_jianti_auto":"亳","start_index":4,"tongjian_id":"bebb504e-db0e-11ef-a447-a0d3651f611f"},{"place_name":"南陽","place_name_jianti_auto":"南阳","start_index":16,"tongjian_id":"bebb504f-db0e-11ef-af9d-a0d3651f611f"},{"place_name":"青","place_name_jianti_auto":"青","start_index":21,"tongjian_id":"bebb5050-db0e-11ef-abe0-a0d3651f611f"},{"place_name":"密","place_name_jianti_auto":"密","start_index":23,"tongjian_id":"bebb5051-db0e-11ef-b162-a0d3651f611f"},{"place_name":"彭城","place_name_jianti_auto":"彭城","start_index":31,"tongjian_id":"bebb5052-db0e-11ef-b2ca-a0d3651f611f"},{"place_name":"興平軍","place_name_jianti_auto":"兴平军","place_note":"总部设商州【陕西省商州市】","start_index":37,"tongjian_id":"bebb5053-db0e-11ef-bbe1-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":43,"tongjian_id":"bebb5054-db0e-11ef-9a13-a0d3651f611f"},{"place_name":"始平縣","place_name_jianti_auto":"始平县","start_index":45,"tongjian_id":"bebb5055-db0e-11ef-8d31-a0d3651f611f"},{"place_name":"豫","place_name_jianti_auto":"豫","start_index":58,"tongjian_id":"bebb5056-db0e-11ef-9053-a0d3651f611f"},{"place_name":"許","place_name_jianti_auto":"许","start_index":60,"tongjian_id":"bebb5057-db0e-11ef-ad95-a0d3651f611f"},{"place_name":"汝","place_name_jianti_auto":"汝","start_index":62,"tongjian_id":"bebb5058-db0e-11ef-a78a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陳、鄭、亳前此未嘗置節鎭，魯炅自南陽爲之。青、密等七州，尚衡自彭城升統之。興平軍本置於雍州始平縣，李奐時在行營，使統豫、許、汝三州。此皆臨時分鎭，非有一定規模也。","note_content_jianti_auto":"陈、郑、亳前此未尝置节镇，鲁炅自南阳为之。青、密等七州，尚衡自彭城升统之。兴平军本置于雍州始平县，李奂时在行营，使统豫、许、汝三州。此皆临时分镇，非有一定规模也。","note_type":"hu_note","start_index":73,"tongjian_id":"bebb5048-db0e-11ef-80d1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","resolved_place_entity_id":921,"start_index":16,"tongjian_id":"bebb505e-db0e-11ef-9063-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"12甲辰，置陳、鄭、亳節度使，以鄧州刺史魯炅爲之；以徐州刺史尚衡爲青、密七州節度使；以興平軍節度使李奐兼豫、許、汝三州節度使；仍各於境上守捉防禦。","content_fanyi":"四月初八日甲辰，朝廷设置陈州、郑州、亳州节度使，任命邓州刺史鲁炅充任此职；任命徐州刺史尚衡为青州、密州等七州节度使；命兴平军节度使李奂兼任豫州、许州、汝州三州节度使；并令各节度使仍在各自辖境履行守捉使、防御使的职责。","content_jianti_auto":"12甲辰，置陈、郑、亳节度使，以邓州刺史鲁炅为之；以徐州刺史尚衡为青、密七州节度使；以兴平军节度使李奂兼豫、许、汝三州节度使；仍各于境上守捉防御。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22283,"number":12,"path":"资治通鉴 : 卷第二百二十一 (唐紀三十七) / 肅宗文明武德大聖大宣孝皇帝下之上 / 乾元二年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"bebb503f-db0e-11ef-b327-a0d3651f611f","year_int":759},"tongjian_id":"bebb503f-db0e-11ef-b327-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"鄧州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"山南東道","place_name_jianti_auto":"山南东道","place_note":"总部设襄州【湖北省襄樊市】","start_index":0,"tongjian_id":"bf09b4b5-db0e-11ef-8e1b-a0d3651f611f"},{"place_name":"襄","place_name_jianti_auto":"襄","start_index":5,"tongjian_id":"bf09b4b6-db0e-11ef-991a-a0d3651f611f"},{"place_name":"鄧","place_name_jianti_auto":"邓","start_index":7,"tongjian_id":"bf09b4b7-db0e-11ef-bda6-a0d3651f611f"},{"place_name":"隨","place_name_jianti_auto":"随","place_note":"湖北随州市","start_index":9,"tongjian_id":"bf09b4b8-db0e-11ef-8352-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","place_note":"河南省泌阳县","start_index":11,"tongjian_id":"bf09b4b9-db0e-11ef-8d3d-a0d3651f611f"},{"place_name":"安","place_name_jianti_auto":"安","start_index":13,"tongjian_id":"bf09b4ba-db0e-11ef-bf14-a0d3651f611f"},{"place_name":"均","place_name_jianti_auto":"均","place_note":"湖北省丹江口市西北","start_index":15,"tongjian_id":"bf09b4bb-db0e-11ef-91fc-a0d3651f611f"},{"place_name":"房","place_name_jianti_auto":"房","place_note":"湖北省房县","start_index":17,"tongjian_id":"bf09b4bc-db0e-11ef-9ee0-a0d3651f611f"},{"place_name":"金","place_name_jianti_auto":"金","place_note":"陕西安康","start_index":19,"tongjian_id":"bf09b4bd-db0e-11ef-9e1a-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":21,"tongjian_id":"bf09b4be-db0e-11ef-9347-a0d3651f611f"},{"place_name":"郢","place_name_jianti_auto":"郢","place_note":"湖北钟祥市","start_index":43,"tongjian_id":"bf09b4bf-db0e-11ef-b74b-a0d3651f611f"},{"place_name":"復","place_name_jianti_auto":"复","place_note":"湖北天门市","start_index":45,"tongjian_id":"bf09b4c0-db0e-11ef-b019-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"山南東道領襄、鄧、隨、唐、安、均、房、金、商九州。今分四州，餘五州耳。曰領六州，無亦於郢、復二州增領一州邪！","note_content_jianti_auto":"山南东道领襄、邓、随、唐、安、均、房、金、商九州。今分四州，余五州耳。曰领六州，无亦于郢、复二州增领一州邪！","note_type":"hu_note","start_index":110,"tongjian_id":"bf09b4b4-db0e-11ef-8b69-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"汝","place_name_jianti_auto":"汝","start_index":7,"tongjian_id":"bf09b4c4-db0e-11ef-838d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊傳無汝，云十五州。今從實錄。","note_content_jianti_auto":"考异曰：旧传无汝，云十五州。今从实录。","note_type":"hu_note","start_index":188,"tongjian_id":"bf09b4c3-db0e-11ef-99c4-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","place_note":"河南邓州市","resolved_place_entity_id":921,"start_index":43,"tongjian_id":"bf09b4cd-db0e-11ef-9f70-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"12上召山南東道節度使來瑱赴京師；瑱樂在襄陽，其將士亦愛之，乃諷所部將吏上表留之；行及鄧州，復令還鎭。荊南節度使呂諲、淮西節度使王仲昇及中使往來者言「瑱曲收衆心，恐久難制。」上乃割商、金、均、房別置觀察使，令瑱止領六州。會謝欽讓圍王仲昇於申州數月，瑱怨之，按兵不救，仲昇竟敗沒。行軍司馬裴茙謀奪瑱位，密表瑱倔強難制，請以兵襲取之，上以爲然。癸巳，以瑱爲淮西、河南十六州節度使，外示寵任，實欲圖之。密敕以茙代瑱爲襄、鄧等州防禦使。","content_fanyi":"皇上征召山南东道节度使来瑱前来京师；来瑱乐意留在襄阳，手下将士也爱戴他，于是暗示所属将吏上表请求朝廷将他留任；等来瑱行至邓州时，皇上又命他返回本镇。荆南节度使吕諲、淮西节度使王仲昇以及往来中使都说：“来瑱曲意收揽人心，恐怕时间一久就难以控制。”皇上于是分割商、金、均、房四州另设观察使，让来瑱只统辖六州。正好谢钦让在申州围攻王仲昇达数月之久，来瑱对此怀恨，按兵不动不去救援，王仲昇最终兵败被俘。行军司马裴茙图谋夺取来瑱的职位，暗中上表称来瑱倔强难以控制，请求用兵袭击夺取襄阳，皇上认为可行。癸巳，任命来瑱为淮西、河南十六州节度使，表面上是表示宠信重用，实际却想借此除掉他。又秘密下敕，让裴茙代替来瑱出任襄、邓等州防御使。","content_jianti_auto":"12上召山南东道节度使来瑱赴京师；瑱乐在襄阳，其将士亦爱之，乃讽所部将吏上表留之；行及邓州，复令还镇。荆南节度使吕𬤇、淮西节度使王仲升及中使往来者言「瑱曲收众心，恐久难制。」上乃割商、金、均、房别置观察使，令瑱止领六州。会谢钦让围王仲升于申州数月，瑱怨之，按兵不救，仲升竟败没。行军司马裴茙谋夺瑱位，密表瑱倔强难制，请以兵袭取之，上以为然。癸巳，以瑱为淮西、河南十六州节度使，外示宠任，实欲图之。密敕以茙代瑱为襄、邓等州防御使。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，徙镇淮西而不行，纵兵击裴茙，禽送京师，胁朝廷以行辟，唐...","context_before":"...人，夺韦伦而得之，引降贼张维瑾等为爪牙，收人心以据大镇，","source_end_index":47,"source_paragraph_tongjian_id":"6b14fed9-ab53-4cd3-b6a7-353e28867108","source_start_index":40,"source_text":"召赴京师而不至"}],"title":"一 流杀来瑱宜在其违命之日"}],"id":22430,"number":12,"path":"资治通鉴 : 卷第二百二十二 (唐紀三十八) / 肅宗文明武德大聖大宣孝皇帝下之下 / 寶應元年 / 第 14 段","reading_annotation_sources":[{"count":2,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":13,"tongjian_id":"bf09b4b2-db0e-11ef-baaa-a0d3651f611f","year_int":762},"tongjian_id":"bf09b4b2-db0e-11ef-baaa-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"鄧州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"來瑱","people_name_jianti_auto":"来瑱","start_index":3,"tongjian_id":"bf22f0be-db0e-11ef-9af8-a0d3651f611f"},{"people_name":"龐充","people_name_jianti_auto":"庞充","start_index":6,"tongjian_id":"bf22f0bf-db0e-11ef-9477-a0d3651f611f"},{"people_name":"史朝義","people_name_jianti_auto":"史朝义","start_index":15,"tongjian_id":"bf22f0c0-db0e-11ef-be69-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河南","place_name_jianti_auto":"河南","start_index":9,"tongjian_id":"bf22f0c1-db0e-11ef-a0de-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"蓋先是來瑱使龐充赴河南行營會討史朝義。","note_content_jianti_auto":"盖先是来瑱使庞充赴河南行营会讨史朝义。","note_type":"hu_note","start_index":88,"tongjian_id":"bf22f0bd-db0e-11ef-b298-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":33,"source_start_index":20,"source_text":"爲梁崇義以襄陽拒命而死張本","target_paragraph_tongjian_id":"c02249e5-db0e-11ef-86a0-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"梁崇義","people_name_jianti_auto":"梁崇义","start_index":21,"tongjian_id":"bf22f0c4-db0e-11ef-9ce3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"bf22f0c5-db0e-11ef-a43b-a0d3651f611f"},{"place_name":"襄陽","place_name_jianti_auto":"襄阳","start_index":25,"tongjian_id":"bf22f0c6-db0e-11ef-9a1b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐藩鎭命帥，未授旌節者，先以爲節度留後。爲梁崇義以襄陽拒命而死張本。","note_content_jianti_auto":"唐藩镇命帅，未授旌节者，先以为节度留后。为梁崇义以襄阳拒命而死张本。","note_type":"hu_note","start_index":209,"tongjian_id":"bf22f0c3-db0e-11ef-9c57-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","place_note":"河南邓州","resolved_place_entity_id":921,"start_index":120,"tongjian_id":"bf22f0db-db0e-11ef-aaf1-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8初，長安人梁崇義以羽林射生從來瑱鎭襄陽，累遷右兵馬使。崇義有勇力，能卷鐵舒鈎；沈毅寡言，得衆心。瑱之入朝也，命諸將分戍諸州，瑱死，戍者皆奔歸襄陽。行軍司馬龐充將兵二千赴河南，至汝州，聞瑱死，引兵還襲襄州；左兵馬使李昭拒之，充奔房州。崇義自鄧州引戍兵歸，與昭及副使薛南陽相讓爲長，久之不決，衆皆曰：「兵非梁卿主之不可。」遂推崇義爲帥。崇義尋殺昭及南陽，以其狀聞，上不能討。三月甲辰，以崇義爲襄州刺史、山南東道節度留後。崇義奏改葬瑱，爲之立祠，不居瑱聽事及正堂。","content_fanyi":"当初，长安人梁崇义以羽林射生的身份跟随来瑱镇守襄阳，屡经升迁做到右兵马使。梁崇义勇敢有力，能把铁卷弯，能把铁钩舒展开；他性情深沉坚毅，寡言少语，很得众人之心。来瑱入朝为相时，命令诸将分别戍守各州；来瑱死后，各地戍守的将士都奔回襄阳。行军司马庞充率领士兵二千人开赴河南，到达汝州时，听说来瑱死去，便带兵回袭襄州；左兵马使李昭率兵抵抗，庞充逃奔房州。梁崇义从邓州带领戍守士兵回来，与李昭及节度副使薛南阳互相推让不肯做首领，很久不能决定下来，众人都说：‘军队非由梁卿统率不可。’于是推举梁崇义为帅。梁崇义不久就杀掉李昭和薛南阳，把情况奏报朝廷，代宗无力讨伐。三月初一日甲辰，朝廷任命梁崇义为襄州刺史、山南东道节度留后。梁崇义上奏请求改葬来瑱，为他建立祠堂，自己不住在来瑱的听事和正堂。","content_jianti_auto":"8初，长安人梁崇义以羽林射生从来瑱镇襄阳，累迁右兵马使。崇义有勇力，能卷铁舒钩；沈毅寡言，得众心。瑱之入朝也，命诸将分戍诸州，瑱死，戍者皆奔归襄阳。行军司马庞充将兵二千赴河南，至汝州，闻瑱死，引兵还袭襄州；左兵马使李昭拒之，充奔房州。崇义自邓州引戍兵归，与昭及副使薛南阳相让为长，久之不决，众皆曰：「兵非梁卿主之不可。」遂推崇义为帅。崇义寻杀昭及南阳，以其状闻，上不能讨。三月甲辰，以崇义为襄州刺史、山南东道节度留后。崇义奏改葬瑱，为之立祠，不居瑱听事及正堂。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22495,"number":8,"path":"资治通鉴 : 卷第二百二十二 (唐紀三十八) / 代宗睿文孝武皇帝上之上 / 廣德元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"bf22f0ba-db0e-11ef-a82e-a0d3651f611f","year_int":763},"tongjian_id":"bf22f0ba-db0e-11ef-a82e-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"鄧州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"稽，緩也。","note_content_jianti_auto":"稽，缓也。","note_type":"hu_note","start_index":57,"tongjian_id":"c0022a5b-db0e-11ef-80cd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":22,"source_start_index":14,"source_text":"事見二百二十二卷","target_paragraph_tongjian_id":"bf1e5c89-db0e-11ef-b728-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"來公","people_name_jianti_auto":"来公","start_index":0,"tongjian_id":"c0022a5d-db0e-11ef-b9a4-a0d3651f611f"},{"people_name":"來瑱","people_name_jianti_auto":"来瑱","start_index":4,"tongjian_id":"c0022a5e-db0e-11ef-90c4-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"來公，謂來瑱，死於廣德元年，事見二百二十二卷。","note_content_jianti_auto":"来公，谓来瑱，死于广德元年，事见二百二十二卷。","note_type":"hu_note","start_index":75,"tongjian_id":"c0022a5c-db0e-11ef-ab01-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"淮西","place_name_jianti_auto":"淮西","start_index":10,"tongjian_id":"c0022a60-db0e-11ef-8f33-a0d3651f611f"},{"place_name":"蔡州","place_name_jianti_auto":"蔡州","start_index":17,"tongjian_id":"c0022a61-db0e-11ef-8b89-a0d3651f611f"},{"place_name":"淮寧","place_name_jianti_auto":"淮宁","start_index":22,"tongjian_id":"c0022a62-db0e-11ef-846b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"方鎭表：大曆十四年，淮西節度使復治蔡州，賜號淮寧軍，事見上。","note_content_jianti_auto":"方镇表：大历十四年，淮西节度使复治蔡州，赐号淮宁军，事见上。","note_type":"hu_note","start_index":100,"tongjian_id":"c0022a5f-db0e-11ef-b937-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"郭昔","people_name_jianti_auto":"郭昔","start_index":0,"tongjian_id":"c0022a65-db0e-11ef-a1cf-a0d3651f611f"},{"people_name":"崇義","people_name_jianti_auto":"崇义","start_index":4,"tongjian_id":"c0022a66-db0e-11ef-9f38-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郭昔以告崇義得流罪，史因稱流人以敍其事。","note_content_jianti_auto":"郭昔以告崇义得流罪，史因称流人以敍其事。","note_type":"hu_note","start_index":119,"tongjian_id":"c0022a64-db0e-11ef-8147-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲，于僞翻；下爲陳同。","note_content_jianti_auto":"为，于伪翻；下为陈同。","note_type":"hu_note","start_index":137,"tongjian_id":"c0022a67-db0e-11ef-8bc1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"惡，烏路翻。復，扶又翻。拒境者，拒之於境上。","note_content_jianti_auto":"恶，乌路翻。复，扶又翻。拒境者，拒之于境上。","note_type":"hu_note","start_index":209,"tongjian_id":"c0022a69-db0e-11ef-a758-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","place_note":"河南省邓州市","start_index":6,"tongjian_id":"c0022a6c-db0e-11ef-9e4b-a0d3651f611f"},{"place_name":"穰縣","place_name_jianti_auto":"穰县","start_index":10,"tongjian_id":"c0022a6d-db0e-11ef-b90f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"裨，賓彌翻。鄧州，治穰縣。","note_content_jianti_auto":"裨，宾弥翻。邓州，治穰县。","note_type":"hu_note","start_index":294,"tongjian_id":"c0022a6b-db0e-11ef-955b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"c0022a59-db0e-11ef-96e0-a0d3651f611f","pinyin":"xìn","source_anchor_text":"誅吾歲久釁積何可往","source_key":"baiyang_epub","start_index":78,"text":"釁","tongjian_id":"8b2f8166-122e-554c-85de-e5b0d2daf3ea"}],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","resolved_place_entity_id":921,"start_index":289,"tongjian_id":"c0022a87-db0e-11ef-93ed-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、襄阳府（卷七十九）","excerpts":[{"context_after":"唐末，朱温并秦宗权，因以驱摄山南，兼有荆、郢。高氏据荆南...","context_before":"...，汴、洛沸腾，而襄、邓无虞，故东南之资储，得以西给行在。","source_end_index":1251,"source_paragraph_tongjian_id":"529fb606-24ed-59ed-82f7-dd65dd9d98fa","source_start_index":1216,"source_text":"梁崇义拒命于建中间，未几丧败，及淮西寇暴，实藉襄、邓之力，为之犄角焉。"}],"path":"湖广方舆纪要/八、襄阳府（卷七十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"10梁崇義雖與李正己等連結，兵勢寡弱，禮數最恭。或勸其入朝，崇義曰：「來公有大功於國，上元中爲閹宦所讒，遷延稽命；及代宗嗣位，不俟駕入朝，猶不免族誅。吾歲久釁積，何可往也！」淮寧節度使李希烈屢請討之，崇義懼，益脩武備，流人郭昔告崇義爲變，崇義聞之，請罪，上爲之杖昔，遠流之；使金部員外郞李舟詣襄州諭旨以安之。舟嘗奉使詣劉文喜，爲陳禍福，文喜囚之，會帳下殺文喜以降，諸道跋扈者聞之，謂舟能覆城殺將。至襄州，崇義拒境不內，上言「軍中疑懼，請易以他使。」時兩河諸鎭方猜阻，上欲示恩信以安之，夏，四月，庚寅，加崇義同平章事，妻子悉加封賞，賜以鐵券；遣御史張著齎手詔徵之，仍以其裨將藺杲爲鄧州刺史。","content_fanyi":"梁崇义虽然和李正己等人互相连结，但兵力薄弱，对朝廷的礼节最为恭敬。有人劝他入朝，梁崇义说：‘来公对国家有大功，上元年间被宦官进谗言，说他拖延执行诏命；等到代宗即位，他不等车马备好就入朝，仍然不免被灭族。我年岁已久，与朝廷积下很多嫌隙，怎么能去呢！’淮宁节度使李希烈多次请求讨伐他，梁崇义害怕，更加整治军备。流放之人郭昔告发梁崇义将要反叛，梁崇义听说后，向朝廷请罪，皇上为此杖责郭昔，将他远远流放；又派金部员外郎李舟前往襄州宣谕旨意，安抚梁崇义。李舟曾经奉命出使到刘文喜处，向他陈述祸福，刘文喜把他囚禁；适逢刘文喜部下杀死刘文喜投降，各道骄横不法的将领听说后，认为李舟能倾覆城池、杀死将领。李舟到达襄州，梁崇义在边境阻拦，不让他入境，并上奏说：‘军中怀疑恐惧，请求另派使者。’当时两河各镇正互相猜疑、心怀隔阻，皇上想显示恩德信义来安抚他们。夏季，四月，庚寅日，加授梁崇义同平章事，妻子儿女都给予封赏，赐给铁券；派遣御史张著携带亲笔诏书征召他入朝，同时任命他的副将蔺杲为邓州刺史。","content_jianti_auto":"10梁崇义虽与李正己等连结，兵势寡弱，礼数最恭。或劝其入朝，崇义曰：「来公有大功于国，上元中为阉宦所谗，迁延稽命；及代宗嗣位，不俟驾入朝，犹不免族诛。吾岁久衅积，何可往也！」淮宁节度使李希烈屡请讨之，崇义惧，益修武备，流人郭昔告崇义为变，崇义闻之，请罪，上为之杖昔，远流之；使金部员外郞李舟诣襄州谕旨以安之。舟尝奉使诣刘文喜，为陈祸福，文喜囚之，会帐下杀文喜以降，诸道跋扈者闻之，谓舟能覆城杀将。至襄州，崇义拒境不内，上言「军中疑惧，请易以他使。」时两河诸镇方猜阻，上欲示恩信以安之，夏，四月，庚寅，加崇义同平章事，妻子悉加封赏，赐以铁券；遣御史张著赍手诏征之，仍以其裨将蔺杲为邓州刺史。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22992,"number":10,"path":"资治通鉴 : 卷第二百二十六 (唐紀四十二) / 德宗神武孝文皇帝一 / 二年 / 第 18 段","reading_annotation_sources":[],"start_index":17,"tongjian_id":"c0022a59-db0e-11ef-96e0-a0d3651f611f","year_int":781},"tongjian_id":"c0022a59-db0e-11ef-96e0-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"鄧州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","place_note":"河南邓州市","resolved_place_entity_id":921,"start_index":9,"tongjian_id":"c057acc6-db0e-11ef-a84b-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、郧阳府（卷七十九）","excerpts":[{"context_after":"[《唐史》：建中四年，李希烈将封有麟据邓州，南路绝贡献，...","context_before":"...乱，江淮贡献，悉取上津，以达扶风[扶风，今陕西凤翔府]。","source_end_index":373,"source_paragraph_tongjian_id":"ecb1fa86-eeda-5da3-bc94-510a226160a1","source_start_index":327,"source_text":"德宗时，李希烈叛，遣将据邓州，南路贡献遂绝，诏陕虢观察使姚明釭治上津山路，置馆驿以通南方贡献"}],"path":"湖广方舆纪要/九、郧阳府（卷七十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"希烈使其將封有麟據鄧州，南路遂絕，貢獻、商旅皆不通。壬寅，詔治上津山路，置郵驛。","content_fanyi":"李希烈命部将封有麟据守邓州，朝廷通往南方的道路因此断绝，进贡物品和商人、旅客都无法通行。正月二十五日壬寅，德宗下诏修治上津县的山路，并设置邮驿。","content_jianti_auto":"希烈使其将封有麟据邓州，南路遂绝，贡献、商旅皆不通。壬寅，诏治上津山路，置邮驿。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23095,"path":"资治通鉴 : 卷第二百二十八 (唐紀四十四) / 德宗神武聖文皇帝三 / 建中四年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"c057acc0-db0e-11ef-a852-a0d3651f611f","year_int":783},"tongjian_id":"c057acc0-db0e-11ef-a852-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"鄧州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鄧州","place_name_jianti_auto":"邓州","place_note":"河南省邓州市","resolved_place_entity_id":921,"start_index":8,"tongjian_id":"c0e6af4c-db0e-11ef-be52-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"4三月，李希烈陷鄧州。","content_fanyi":"三月，李希烈攻陷邓州。","content_jianti_auto":"4三月，李希烈陷邓州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":23339,"number":4,"path":"资治通鉴 : 卷第二百三十一 (唐紀四十七) / 德宗神武聖文皇帝六 / 貞元元年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"c0e6af4a-db0e-11ef-8b9e-a0d3651f611f","year_int":785},"tongjian_id":"c0e6af4a-db0e-11ef-8b9e-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":3,"total_paragraphs":23},"place_name":"鄧州"},"message":"success","success":true}