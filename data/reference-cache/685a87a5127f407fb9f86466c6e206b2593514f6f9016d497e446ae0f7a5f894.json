agraph_links":[],"ExtRef_Children_people":[{"people_name":"苟","people_name_jianti_auto":"苟","start_index":35,"tongjian_id":"8c06abcd-db0e-11ef-83dc-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":38,"tongjian_id":"8c06abce-db0e-11ef-9889-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"古者兵車一乘，甲士三人，步卒七十二人；五百乘，三萬七千五百人。國語曰：苟本自黃帝之子。將，卽亮翻；下同。乘，繩證翻。","note_content_jianti_auto":"古者兵车一乘，甲士三人，步卒七十二人；五百乘，三万七千五百人。国语曰：苟本自黄帝之子。将，即亮翻；下同。乘，绳证翻。","note_type":"hu_note","start_index":21,"tongjian_id":"8c06abcc-db0e-11ef-93bb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛氏","people_name_jianti_auto":"毛氏","start_index":12,"tongjian_id":"8c06abd3-db0e-11ef-8b81-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":27,"tongjian_id":"8c06abd4-db0e-11ef-8094-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩：赳赳武夫，公侯干城。毛氏傳曰：干，扞也；音戶旦翻。鄭氏箋曰：干也，城也，皆所以禦難也。干，讀如字。","note_content_jianti_auto":"诗：赳赳武夫，公侯干城。毛氏传曰：干，扞也；音户旦翻。郑氏笺曰：干也，城也，皆所以御难也。干，读如字。","note_type":"hu_note","start_index":124,"tongjian_id":"8c06abd2-db0e-11ef-81c9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"吏","official_note":"吏泛指低级官员或办事人员，此处指苟變曾担任地方官吏，负责征收赋税等事务，在上下文中用于说明其过去的过失。","official_rank":"未知","source_snippet":"嘗爲吏","start_index":38,"tongjian_id":"5544a14d-9c81-4649-903b-8fa56313c774"}],"ExtRef_Children_people":[{"link_birth_year":-483,"link_death_year":-402,"link_td_description":"孔伋，字子思，战国初期鲁国人，儒家的主要代表之一，有「述圣」之称，为孔子的孙子，孔鲤的儿子，曾受业于曾子。","link_td_id":"Q10004569","link_td_number_id":135770,"people_name":"子思","people_name_jianti_auto":"子思","people_xingming":"孔伋","start_index":1,"tongjian_id":"8c06abd8-db0e-11ef-bc01-a0d3651f611f","wl_zhushi":"[孔伋]"},{"link_td_description":"苟变，战国时期卫国人。","link_td_id":"Q10023406","link_td_number_id":8332822,"people_name":"苟變","people_name_jianti_auto":"苟变","people_xingming":"苟变","start_index":4,"tongjian_id":"8c06abd9-db0e-11ef-9bcb-a0d3651f611f"},{"people_name":"衞侯","people_name_jianti_auto":"衞侯","people_xingming":"卫颓","start_index":7,"tongjian_id":"8c06abda-db0e-11ef-9807-a0d3651f611f"},{"link_td_description":"苟变，战国时期卫国人。","link_td_id":"Q10023406","link_td_number_id":8332822,"people_name":"變","people_name_jianti_auto":"变","people_xingming":"苟变","start_index":32,"tongjian_id":"8c06abdb-db0e-11ef-a4dd-a0d3651f611f"},{"link_birth_year":-483,"link_death_year":-402,"link_td_description":"孔伋，字子思，战国初期鲁国人，儒家的主要代表之一，有「述圣」之称，为孔子的孙子，孔鲤的儿子，曾受业于曾子。","link_td_id":"Q10004569","link_td_number_id":135770,"people_name":"子思","people_name_jianti_auto":"子思","start_index":54,"tongjian_id":"8c06abdc-db0e-11ef-acfe-a0d3651f611f","wl_zhushi":"[孔伋]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"戰國","place_name_jianti_auto":"战国","resolved_place_entity_id":1860,"start_index":103,"tongjian_id":"8c06abdd-db0e-11ef-a46f-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2子思言苟變於衞侯曰：「其才可將五百乘。」公曰：「吾知其可將；然變也嘗爲吏，賦於民而食人二雞子，故弗用也。」子思曰：「夫聖人之官人，猶匠之用木也，取其所長，棄其所短；故杞梓連抱而有數尺之朽，良工不棄。今君處戰國之世，選爪牙之士，而以二卵棄干城之將，此不可使聞於鄰國也。」公再拜曰：「謹受敎矣！」","content_fanyi":"子思在卫侯面前举荐苟变说：“他的才能可以统率五百乘兵车。”卫侯说：“我知道他可以担任将领；但苟变曾经做过官吏，向百姓征收赋税时竟白吃了人家两个鸡蛋，所以没有任用他。”子思说：“圣人任命人做官，就像工匠使用木料，取用它的长处，舍弃它的短处；所以杞梓树有几人合抱那么粗，即使有几尺朽烂之处，好的工匠也不会丢弃。如今您处在战国乱世，要选拔勇武的爪牙之士，却因为两个鸡蛋而抛弃能保卫国家的干城之将，这样可笑的事不能让邻国听到啊！”卫侯再三拜谢说：“恭敬地接受您的教诲。”","content_jianti_auto":"2子思言苟变于衞侯曰：「其才可将五百乘。」公曰：「吾知其可将；然变也尝为吏，赋于民而食人二鸡子，故弗用也。」子思曰：「夫圣人之官人，犹匠之用木也，取其所长，弃其所短；故杞梓连抱而有数尺之朽，良工不弃。今君处战国之世，选爪牙之士，而以二卵弃干城之将，此不可使闻于邻国也。」公再拜曰：「谨受教矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":82,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c06abcb-db0e-11ef-85c4-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000355"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊景公","people_name_jianti_auto":"齐景公","start_index":13,"tongjian_id":"8c06abe1-db0e-11ef-8fc1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「君不君，臣不臣，」論語載齊景公之言。","note_content_jianti_auto":"「君不君，臣不臣，」论语载齐景公之言。","note_type":"hu_note","start_index":42,"tongjian_id":"8c06abe0-db0e-11ef-860b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"公丘","people_name_jianti_auto":"公丘","start_index":0,"tongjian_id":"8c06abe4-db0e-11ef-9db9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"公丘，複姓。諡法：溫柔賢善曰懿。","note_content_jianti_auto":"公丘，复姓。谥法：温柔贤善曰懿。","note_type":"hu_note","start_index":55,"tongjian_id":"8c06abe3-db0e-11ef-ab96-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臧，善也。","note_content_jianti_auto":"臧，善也。","note_type":"hu_note","start_index":71,"tongjian_id":"8c06abe6-db0e-11ef-b7c7-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"衞侯","people_name_jianti_auto":"衞侯","people_xingming":"卫侯","start_index":0,"tongjian_id":"8c06abe9-db0e-11ef-8c2e-a0d3651f611f"},{"link_birth_year":-483,"link_death_year":-402,"link_td_description":"孔伋，字子思，战国初期鲁国人，儒家的主要代表之一，有「述圣」之称，为孔子的孙子，孔鲤的儿子，曾受业于曾子。","link_td_id":"Q10004569","link_td_number_id":135770,"people_name":"子思","people_name_jianti_auto":"子思","people_xingming":"孔伋","start_index":17,"tongjian_id":"8c06abea-db0e-11ef-8972-a0d3651f611f","wl_zhushi":"[孔伋]"},{"people_name":"公丘懿子","people_name_jianti_auto":"公丘懿子","people_xingming":"公丘懿子","start_index":42,"tongjian_id":"8c06abeb-db0e-11ef-9bfb-a0d3651f611f"},{"link_birth_year":-483,"link_death_year":-402,"link_td_description":"孔伋，字子思，战国初期鲁国人，儒家的主要代表之一，有「述圣」之称，为孔子的孙子，孔鲤的儿子，曾受业于曾子。","link_td_id":"Q10004569","link_td_number_id":135770,"people_name":"子思","people_name_jianti_auto":"子思","people_xingming":"孔伋","start_index":55,"tongjian_id":"8c06abec-db0e-11ef-a7b6-a0d3651f611f","wl_zhushi":"[孔伋]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"衞侯言計非是，而羣臣和者如出一口。子思曰：「以吾觀衞，所謂『君不君，臣不臣』者也！」公丘懿子曰：「何乃若是？」子思曰：「人主自臧，則衆謀不進。事是而臧之，猶卻衆謀，況和非以長惡乎！夫不察事之是非而悅人讚己，闇莫甚焉；不度理之所在而阿諛求容，諂莫甚焉。君闇臣諂，以居百姓之上，民不與也。若此不已，國無類矣！」","content_fanyi":"卫侯所说的计谋不对，群臣却随声附和，如同出于同一人之口。子思说：“依我观察卫国，正是所谓‘君不像君，臣不像臣’的情形啊！”公丘懿子说：“怎么会到这种地步？”子思说：“君主如果自以为高明，众人的计谋就不会进献上来。事情正确却自以为是，尚且会堵塞众人的谋略，更何况让人们附和错误的计谋来助长恶行呢！君主不考察事情的是非而喜欢别人称赞自己，昏暗没有比这更严重的；臣子不揣度道理何在而阿谀奉承以求容身，谄媚没有比这更严重的。君主昏暗，臣子谄媚，却高居百姓之上，民众是不会支持这样的国家的。如果这样下去而不停止，国家就要灭亡了！”","content_jianti_auto":"衞侯言计非是，而群臣和者如出一口。子思曰：「以吾观衞，所谓『君不君，臣不臣』者也！」公丘懿子曰：「何乃若是？」子思曰：「人主自臧，则众谋不进。事是而臧之，犹却众谋，况和非以长恶乎！夫不察事之是非而悦人赞己，暗莫甚焉；不度理之所在而阿谀求容，谄莫甚焉。君暗臣谄，以居百姓之上，民不与也。若此不已，国无类矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":83,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c06abde-db0e-11ef-9919-a0d3651f611f","zhang_TJZJ_id":"zttjzj_000357"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"白虎通曰：君，羣也，羣下之所歸心也。臣，堅也，厲志自堅也。","note_content_jianti_auto":"白虎通曰：君，群也，群下之所归心也。臣，坚也，厉志自坚也。","note_type":"hu_note","start_index":82,"tongjian_id":"8c06abee-db0e-11ef-ac46-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"毛氏","people_name_jianti_auto":"毛氏","start_index":7,"tongjian_id":"8c06abf1-db0e-11ef-9d84-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":20,"tongjian_id":"8c06abf2-db0e-11ef-b846-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"詩·正月之辭。毛氏傳曰：君臣俱自謂聖也。鄭氏箋曰：時君臣賢愚適同，如烏之雌雄相似，誰能別異之乎？又曰：烏鳥之雌雄不可別者，以翼知之，右掩左，雄，左掩右，雌，陰陽相下之義也。","note_content_jianti_auto":"诗·正月之辞。毛氏传曰：君臣俱自谓圣也。郑氏笺曰：时君臣贤愚适同，如乌之雌雄相似，谁能别异之乎？又曰：乌鸟之雌雄不可别者，以翼知之，右掩左，雄，左掩右，雌，阴阳相下之义也。","note_type":"hu_note","start_index":131,"tongjian_id":"8c06abf0-db0e-11ef-8ecf-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"卿大夫","official_note":"卿大夫是周代至春秋战国时期的高级官员，通常指诸侯国中的贵族官员，负责行政、军事等事务。在《资治通鉴》此段中，卿大夫被提及为卫侯的臣子，他们不敢纠正君主的错误，反映了当时政治中阿谀奉承的风气。此信息基于历史常识，卿大夫在周代官制中属于上层贵族。","official_rank":"未知","source_snippet":"卿大夫莫敢矯其非","start_index":41,"tongjian_id":"77ccb83d-388d-498e-a099-e6c0d8e8480c"}],"ExtRef_Children_people":[{"link_birth_year":-483,"link_death_year":-402,"link_td_description":"孔伋，字子思，战国初期鲁国人，儒家的主要代表之一，有「述圣」之称，为孔子的孙子，孔鲤的儿子，曾受业于曾子。","link_td_id":"Q10004569","link_td_number_id":135770,"people_name":"子思","people_name_jianti_auto":"子思","people_xingming":"孔伋","start_index":0,"tongjian_id":"8c06abf6-db0e-11ef-84ea-a0d3651f611f","wl_zhushi":"[孔伋]"},{"people_name":"衞侯","people_name_jianti_auto":"衞侯","people_xingming":"卫颓","start_index":4,"tongjian_id":"8c06abf7-db0e-11ef-9ebb-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","史论"],"content":"子思言於衞侯曰：「君之國事將日非矣！」公曰：「何故？」對曰：「有由然焉。君出言自以爲是，而卿大夫莫敢矯其非；卿大夫出言亦自以爲是，而士庶人莫敢矯其非。君臣旣自賢矣，而羣下同聲賢之，賢之則順而有福，矯之則逆而有禍，如此則善安從生！詩曰：『具曰予聖，誰知烏之雌雄？』抑亦似君之君臣乎！」","content_fanyi":"子思对卫侯说：“主君的国事将一天天坏下去了！”卫侯说：“什么缘故呢？”子思回答说：“这是有原因的。主君说话自以为是，而卿大夫们没有谁敢纠正您的错误；卿大夫们说话也自以为是，而士人百姓没有谁敢纠正他们的错误。君臣既然都自以为贤能，而群臣百姓又同声称赞他们贤能，称赞贤能就顺从而有福，纠正错误就违逆而有祸，像这样，良好的政治又从哪里产生！《诗经》说：‘都说自己是圣人，谁能分辨乌鸦的雌雄？’这大概也就像主君这样的君臣吧！”","content_jianti_auto":"子思言于衞侯曰：「君之国事将日非矣！」公曰：「何故？」对曰：「有由然焉。君出言自以为是，而卿大夫莫敢矫其非；卿大夫出言亦自以为是，而士庶人莫敢矫其非。君臣既自贤矣，而群下同声贤之，贤之则顺而有福，矫之则逆而有祸，如此则善安从生！诗曰：『具曰予圣，谁知乌之雌雄？』抑亦似君之君臣乎！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":84,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c06abed-db0e-11ef-94bb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"司馬遷","people_name_jianti_auto":"司马迁","start_index":48,"tongjian_id":"8c06abfb-db0e-11ef-8051-a0d3651f611f"},{"people_name":"周威烈王","people_name_jianti_auto":"周威烈王","start_index":58,"tongjian_id":"8c06abfc-db0e-11ef-a804-a0d3651f611f"},{"people_name":"魯穆公","people_name_jianti_auto":"鲁穆公","start_index":68,"tongjian_id":"8c06abfd-db0e-11ef-ac3a-a0d3651f611f"},{"people_name":"烈王","people_name_jianti_auto":"烈王","start_index":74,"tongjian_id":"8c06abfe-db0e-11ef-ad19-a0d3651f611f"},{"people_name":"共公","people_name_jianti_auto":"共公","start_index":81,"tongjian_id":"8c06abff-db0e-11ef-b897-a0d3651f611f"},{"people_name":"顯王","people_name_jianti_auto":"显王","start_index":86,"tongjian_id":"8c06ac00-db0e-11ef-a5f1-a0d3651f611f"},{"people_name":"康公","people_name_jianti_auto":"康公","start_index":94,"tongjian_id":"8c06ac01-db0e-11ef-af86-a0d3651f611f"},{"people_name":"景公","people_name_jianti_auto":"景公","start_index":106,"tongjian_id":"8c06ac02-db0e-11ef