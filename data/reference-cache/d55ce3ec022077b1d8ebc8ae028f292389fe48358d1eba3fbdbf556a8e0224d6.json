ef-80a5-a0d3651f611f"},{"place_name":"懷戎","place_name_jianti_auto":"怀戎","start_index":225,"tongjian_id":"b700dcac-db0e-11ef-b61e-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","start_index":228,"tongjian_id":"b700dcad-db0e-11ef-a34a-a0d3651f611f"},{"place_name":"靈武","place_name_jianti_auto":"灵武","start_index":231,"tongjian_id":"b700dcae-db0e-11ef-b60b-a0d3651f611f"},{"place_name":"涼州","place_name_jianti_auto":"凉州","place_note":"甘肃武威","start_index":234,"tongjian_id":"b700dcaf-db0e-11ef-8332-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"可，從刊入聲。汗，音寒。奚與契丹本皆東胡種，保烏丸山者，其後爲奚，保鮮卑山者，其後爲契丹。霫與突厥同俗，保冷陘山，南契丹，東靺鞨，西拔野古。靺鞨居肅愼地，亦曰挹婁，元魏時曰勿吉。霫，而立翻。契，欺訖翻，又音喫。靺，莫撥翻。鞨，戶割翻。考異曰：舊·突厥傳：「大業中，突利年數歲，始畢遣領東牙之兵，號泥步設，頡利嗣位，以爲突利可汗。」按梁師都傳，此際有泥步設，又有突利可汗。然則突利、處羅時已爲小可汗，非頡利嗣位後也。高祖實錄云：「處羅欲分兵大掠中國，於懷戎、鴈門、靈武、涼州四道俱入。」今從舊書·梁師都傳。","note_content_jianti_auto":"可，从刊入声。汗，音寒。奚与契丹本皆东胡种，保乌丸山者，其后为奚，保鲜卑山者，其后为契丹。霫与突厥同俗，保冷陉山，南契丹，东靺鞨，西拔野古。靺鞨居肃愼地，亦曰挹娄，元魏时曰勿吉。霫，而立翻。契，欺讫翻，又音吃。靺，莫拨翻。鞨，户割翻。考异曰：旧·突厥传：「大业中，突利年数岁，始毕遣领东牙之兵，号泥步设，颉利嗣位，以为突利可汗。」按梁师都传，此际有泥步设，又有突利可汗。然则突利、处罗时已为小可汗，非颉利嗣位后也。高祖实录云：「处罗欲分兵大掠中国，于怀戎、鴈门、灵武、凉州四道俱入。」今从旧书·梁师都传。","note_type":"hu_note","start_index":163,"tongjian_id":"b700dc8e-db0e-11ef-aaa0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"滏口","place_name_jianti_auto":"滏口","place_note":"太行八陉之四•河北省武安市西南","start_index":0,"tongjian_id":"b700dcb6-db0e-11ef-8009-a0d3651f611f"},{"place_name":"滏水","place_name_jianti_auto":"滏水","start_index":3,"tongjian_id":"b700dcb7-db0e-11ef-b4a0-a0d3651f611f"},{"place_name":"磁州","place_name_jianti_auto":"磁州","start_index":9,"tongjian_id":"b700dcb8-db0e-11ef-96ff-a0d3651f611f"},{"place_name":"滏陽縣","place_name_jianti_auto":"滏阳县","start_index":11,"tongjian_id":"b700dcb9-db0e-11ef-8454-a0d3651f611f"},{"place_name":"晉州","place_name_jianti_auto":"晋州","place_note":"山西省临汾市","start_index":16,"tongjian_id":"b700dcba-db0e-11ef-9a5b-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":19,"tongjian_id":"b700dcbb-db0e-11ef-b61b-a0d3651f611f"},{"place_name":"臨汾郡","place_name_jianti_auto":"临汾郡","start_index":21,"tongjian_id":"b700dcbc-db0e-11ef-845a-a0d3651f611f"},{"place_name":"絳州","place_name_jianti_auto":"绛州","place_note":"山西新绛","start_index":25,"tongjian_id":"b700dcbd-db0e-11ef-8907-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":28,"tongjian_id":"b700dcbe-db0e-11ef-b184-a0d3651f611f"},{"place_name":"絳郡","place_name_jianti_auto":"绛郡","start_index":30,"tongjian_id":"b700dcbf-db0e-11ef-af37-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"滏口，滏水之口，在磁州滏陽縣界。晉州，隋之臨汾郡。絳州，隋之絳郡。滏，音釜。","note_content_jianti_auto":"滏口，滏水之口，在磁州滏阳县界。晋州，隋之临汾郡。绛州，隋之绛郡。滏，音釜。","note_type":"hu_note","start_index":181,"tongjian_id":"b700dcb5-db0e-11ef-a44d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"b700dc79-db0e-11ef-936c-a0d3651f611f","pinyin":"xí","source_anchor_text":"可汗與奚霫契丹靺鞨","source_key":"baiyang_epub","start_index":151,"text":"霫","tongjian_id":"47954229-5f49-52a9-9a0a-05b13df46c33"}],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","place_note":"陕西省延安市","resolved_place_entity_id":1238,"start_index":141,"tongjian_id":"b700dcd2-db0e-11ef-9ef7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、彰德府（卷四十九）","excerpts":[{"context_after":"又建德救世充，军虎牢，其妻曹氏亦劝建德自滏口乘唐国之虚。...","context_before":"...，趣黎阳，塞白马津[黎阳，见大名府濬县。白马，见滑县]。","source_end_index":410,"source_paragraph_tongjian_id":"20c47371-a2fc-56ea-9d8f-185686967369","source_start_index":375,"source_text":"唐武德三年，突厥谋入寇，欲自幽州会窦建德之师，自滏口西入，会兵于晋绛。"}],"path":"河南方舆纪要/五、彰德府（卷四十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/十一、宁夏卫（卷六十二）","excerpts":[{"context_after":"唐失盐州，而塞防无复保障。吐蕃往往由此阻绝灵武，侵迫鄜坊...","context_before":"卫控扼朔方，翼蔽内郡，北面之险也。赫连氏桀骜于统万，","source_end_index":47,"source_paragraph_tongjian_id":"f701cc0c-0626-5f3e-b980-c7d9b9fa27b8","source_start_index":26,"source_text":"梁师都倔强于夏州，皆取途于此，以窥伺关中。"}],"path":"陕西方舆纪要/十一、宁夏卫（卷六十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"63張舉、劉旻之降也，梁師都大懼，遣其尚書陸季覽說突厥處羅可汗曰：「比者中原喪亂，分爲數國，勢均力弱，故皆北面歸附突厥。今定楊可汗旣亡，天下將悉爲唐有。師都不辭灰滅，亦恐次及可汗，不若及其未定，南取中原，如魏道武所爲，師都請爲鄕導。」處羅從之，謀使莫賀咄設入自原州，泥步設與師都入自延州，突利可汗與奚、霫、契丹、靺鞨入自幽州，會竇建德之師自滏口西入，會于晉、絳。莫賀咄者，處羅之弟咄苾也；突利者，始畢之子什鉢苾也。","content_fanyi":"张举、刘旻降唐后，梁师都大为恐惧，派他的尚书陆季览游说突厥处罗可汗说：“近来中原皇帝被杀，战乱不止，分裂成几个国家，彼此势均力弱，所以都向北对突厥称臣归附。如今定杨可汗刘武周已经败亡，天下即将全部归唐所有。师都不怕自身覆灭，只是担心接着会轮到可汗。不如趁唐还没有平定天下，南下夺取中原，像北魏道武帝当年所做的那样，师都请求充当您的向导。”处罗可汗听从了他的建议，谋划派莫贺咄设从原州入侵，泥步设与梁师都从延州入侵，突利可汗与奚、霫、契丹、靺鞨诸部从幽州南下，会合窦建德的军队从滏口西进，在晋州、绛州会师。莫贺咄设，是处罗可汗的弟弟咄苾；突利可汗，是始毕可汗的儿子什钵苾。","content_jianti_auto":"63张举、刘旻之降也，梁师都大惧，遣其尚书陆季览说突厥处罗可汗曰：「比者中原丧乱，分为数国，势均力弱，故皆北面归附突厥。今定杨可汗既亡，天下将悉为唐有。师都不辞灰灭，亦恐次及可汗，不若及其未定，南取中原，如魏道武所为，师都请为鄕导。」处罗从之，谋使莫贺咄设入自原州，泥步设与师都入自延州，突利可汗与奚、霫、契丹、靺鞨入自幽州，会窦建德之师自滏口西入，会于晋、绛。莫贺咄者，处罗之弟咄苾也；突利者，始毕之子什钵苾也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18168,"number":63,"path":"资治通鉴 : 卷第一百八十八 (唐紀四) / 高祖神堯大聖光孝皇帝中之上 / 三年 / 第 77 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":76,"tongjian_id":"b700dc79-db0e-11ef-936c-a0d3651f611f","year_int":620},"tongjian_id":"b700dc79-db0e-11ef-936c-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"延州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","place_note":"总部设陕西延安","resolved_place_entity_id":1238,"start_index":5,"tongjian_id":"b70ee2c5-db0e-11ef-93df-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"11壬子，延州總管段德操擊劉仚成，破之，斬首千餘級。","content_fanyi":"壬子日，唐延州总管段德操进击刘仚成，将其击败，斩首一千余级。","content_jianti_auto":"11壬子，延州总管段德操击刘仚成，破之，斩首千余级。","dtjl_paragraph_links":[],"dtjl_references":[],"id":18201,"number":11,"path":"资治通鉴 : 卷第一百八十八 (唐紀四) / 高祖神堯大聖光孝皇帝中之上 / 四年 / 第 16 段","reading_annotation_sources":[],"start_index":15,"tongjian_id":"b70ee2c1-db0e-11ef-a3e7-a0d3651f611f","year_int":621},"tongjian_id":"b70ee2c1-db0e-11ef-a3e7-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"延州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"王雄","people_name_jianti_auto":"王雄","start_index":8,"tongjian_id":"bfe8f19a-db0e-11ef-9a41-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"振武","place_name_jianti_auto":"振武","start_index":11,"tongjian_id":"bfe8f19b-db0e-11ef-b9b2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：舊傳云，王雄爲振武。今從實錄。","note_content_jianti_auto":"考异曰：旧传云，王雄为振武。今从实录。","note_type":"hu_note","start_index":123,"tongjian_id":"bfe8f199-db0e-11ef-b68a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"寧","people_name_jianti_auto":"宁","start_index":22,"tongjian_id":"bfe8f1a0-db0e-11ef-ba22-a0d3651f611f"},{"people_name":"喬琳","people_name_jianti_auto":"乔琳","start_index":24,"tongjian_id":"bfe8f1a1-db0e-11ef-a76d-a0d3651f611f"},{"people_name":"寧","people_name_jianti_auto":"宁","start_index":36,"tongjian_id":"bfe8f1a2-db0e-11ef-a0f7-a0d3651f611f"},{"people_name":"李衡","people_name_jianti_auto":"李衡","start_index":58,"tongjian_id":"bfe8f1a3-db0e-11ef-b6fe-a0d3651f611f"},{"people_name":"于結","people_name_jianti_auto":"于结","start_index":61,"tongjian_id":"bfe8f1a4-db0e-11ef-b63b-a0d3651f611f"},{"people_name":"楊炎","people_name_jianti_auto":"杨炎","start_index":70,"tongjian_id":"bfe8f1a5-db0e-11ef-b63f-a0d3651f611f"},{"people_name":"炎","people_name_jianti_auto":"炎","start_index":80,"tongjian_id":"bfe8f1a6-db0e-11ef-bbf9-a0d3651f611f"},{"people_name":"劉晏","people_name_jianti_auto":"刘晏","start_index":85,"tongjian_id":"bfe8f1a7-db0e-11ef-8647-a0d3651f611f"},{"people_name":"寧","people_name_jianti_auto":"宁","start_index":88,"tongjian_id":"bfe8f1a8-db0e-11ef-90f9-a0d3651f611f"},{"people_name":"寧","people_name_jianti_auto":"宁","start_index":111,"tongjian_id":"bfe8f1a9-db0e-11ef-935b-a0d3651f611f"},{"people_name":"炎","people_name_jianti_auto":"炎","start_index":115,"tongjian_id":"bfe8f1aa-db0e-11ef-aef3-a0d3651f611f"},{"people_name":"寧","people_name_jianti_auto":"宁","start_index":131,"tongjian_id":"bfe8f1ab-db0e-11ef-a13b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"南蠻","place_name_jianti_auto":"南蛮","start_index":104,"tongjian_id":"bfe8f1ac-db0e-11ef-bd8e-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":121,"tongjian_id":"bfe8f1ad-db0e-11ef-b298-a0d3651f611f"},{"place_name":"吐蕃","place_name_jianti_auto":"吐蕃","start_index":139,"tongjian_id":"bfe8f1ae-db0e-11ef-bc7a-a0d3651f611f"},{"place_name":"南蠻","place_name_jianti_auto":"南蛮","start_index":142,"tongjian_id":"bfe8f1af-db0e-11ef-80d5-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":145,"tongjian_id":"bfe8f1b0-db0e-11ef-a8f8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"令，力丁翻。伺，相吏翻。考異曰：舊傳：「初，寧代喬琳爲御史大夫、平章事，寧以爲選擇御史當出大夫，不謀及宰相，乃奏請以李衡、于結等數人爲御史。楊炎大怒，其狀遂寢。炎又數讒毀劉晏，寧又救解之，因此大怒。其年十月，南蠻大至，上遣寧還鎭。炎懼怨己，入蜀難制，奏止之。」按寧爲御史大夫，在吐蕃、南蠻寇蜀後。舊傳恐誤。","note_content_jianti_auto":"令，力丁翻。伺，相吏翻。考异曰：旧传：「初，宁代乔琳为御史大夫、平章事，宁以为选择御史当出大夫，不谋及宰相，乃奏请以李衡、于结等数人为御史。杨炎大怒，其状遂寝。炎又数谗毁刘晏，宁又救解之，因此大怒。其年十月，南蛮大至，上遣宁还镇。炎惧怨己，入蜀难制，奏止之。」按宁为御史大夫，在吐蕃、南蛮寇蜀后。旧传恐误。","note_type":"hu_note","start_index":183,"tongjian_id":"bfe8f19f-db0e-11ef-9dbe-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","place_note":"陕西省延安市","resolved_place_entity_id":1238,"start_index":123,"tongjian_id":"bfeb4297-db0e-11ef-835a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"12楊炎旣留崔寧，二人由是交惡。炎託以北邊須大臣鎭撫，癸巳，以京畿觀察使崔寧爲單于·鎭北大都護、朔方節度使，鎭坊州。以荊南節度使張延賞爲西川節度使。又以靈鹽節度都虞候醴泉杜希全知靈、鹽州留後；代州刺史張光晟知單于·振武等城，綏·銀·麟·勝州留後；延州刺史李建徽知鄜、坊、丹州留後。時寧旣出鎭，不當更置留後，炎欲奪寧權，且窺其所爲，令三人皆得特奏事，仍諷之使伺寧過失。","content_fanyi":"杨炎把崔宁留在京城后，两人从此关系恶化，互相结怨。杨炎借口北部边境需要大臣镇守安抚，十一月二十七日癸巳，将京畿观察使崔宁改任为单于、镇北大都护、朔方节度使，镇守坊州；又改任荆南节度使张延赏为西川节度使。他还任命灵盐节度都虞候、醴泉人杜希全主持灵州、盐州留后事务；任命代州刺史张光晟主持单于、振武等城以及绥州、银州、麟州、胜州的留后事务；任命延州刺史李建徽主持鄜州、坊州、丹州的留后事务。当时崔宁已经出镇，本不应再在他的辖区内设置留后，杨炎想借此削夺崔宁的权力，并窥察他的所作所为，于是让杜希全、张光晟、李建徽三人都获得直接向朝廷独自奏事的特权，还暗中示意他们窥探崔宁的过失。","content_jianti_auto":"12杨炎既留崔宁，二人由是交恶。炎托以北边须大臣镇抚，癸巳，以京畿观察使崔宁为单于·镇北大都护、朔方节度使，镇坊州。以荆南节度使张延赏为西川节度使。又以灵盐节度都虞候醴泉杜希全知灵、盐州留后；代州刺史张光晟知单于·振武等城，绥·银·麟·胜州留后；延州刺史李建徽知鄜、坊、丹州留后。时宁既出镇，不当更置留后，炎欲夺宁权，且窥其所为，令三人皆得特奏事，仍讽之使伺宁过失。","dtjl_paragraph_links":[],"dtjl_references":[],"id":22929,"number":12,"path":"资治通鉴 : 卷第二百二十六 (唐紀四十二) / 代宗睿文孝武皇帝下 / 大曆十四年 / 第 14 段","reading_annotation_sources":[{"count":2,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":13,"tongjian_id":"bfe8f197-db0e-11ef-95f9-a0d3651f611f","year_int":779},"tongjian_id":"bfe8f197-db0e-11ef-95f9-a0d3651f611f"},"paragraph_order":7},{"mention_count":2,"paragraph_brief":{"brief_for":"延州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張𩇕","people_name_jianti_auto":"张𩇕","start_index":4,"tongjian_id":"c635eaca-db0e-11ef-8baf-a0d3651f611f"},{"people_name":"黃巢","people_name_jianti_auto":"黄巢","start_index":19,"tongjian_id":"c635eacb-db0e-11ef-8a2b-a0d3651f611f"},{"people_name":"句延慶","people_name_jianti_auto":"句延庆","start_index":52,"tongjian_id":"c635eacc-db0e-11ef-8831-a0d3651f611f"},{"people_name":"黃巢","people_name_jianti_auto":"黄巢","start_index":67,"tongjian_id":"c635eacd-db0e-11ef-9b56-a0d3651f611f"},{"people_name":"黃巢","people_name_jianti_auto":"黄巢","start_index":89,"tongjian_id":"c635eace-db0e-11ef-9a7b-a0d3651f611f"},{"people_name":"延慶","people_name_jianti_auto":"延庆","start_index":97,"tongjian_id":"c635eacf-db0e-11ef-a859-a0d3651f611f"},{"people_name":"𩇕","people_name_jianti_auto":"𩇕","start_index":101,"tongjian_id":"c635ead0-db0e-11ef-948f-a0d3651f611f"},{"people_name":"𩇕","people_name_jianti_auto":"𩇕","start_index":130,"tongjian_id":"c635ead1-db0e-11ef-955a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":30,"tongjian_id":"c635ead2-db0e-11ef-8741-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":78,"tongjian_id":"c635ead3-db0e-11ef-868a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：張𩇕耆舊傳：「中和三年，北路奏黃巢正月十日敗走，收復長安城訖。三月，北路行營收城，將士並回戈。」句延慶耆舊傳曰：「四年，北路奏黃巢正月十日敗走，收復長安。三月，北路行營破黃巢將士並回。」延慶悉移𩇕四年事於三年，三年事於四年，而不移其月日，其爲差謬又甚於𩇕。今但云告捷，更不著月日。","note_content_jianti_auto":"考异曰：张𩇕耆旧传：「中和三年，北路奏黄巢正月十日败走，收复长安城讫。三月，北路行营收城，将士并回戈。」句延庆耆旧传曰：「四年，北路奏黄巢正月十日败走，收复长安。三月，北路行营破黄巢将士并回。」延庆悉移𩇕四年事于三年，三年事于四年，而不移其月日，其为差谬又甚于𩇕。今但云告捷，更不著月日。","note_type":"hu_note","start_index":8,"tongjian_id":"c635eac9-db0e-11ef-bd3e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黃巢","people_name_jianti_auto":"黄巢","start_index":2,"tongjian_id":"c635ead9-db0e-11ef-9348-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"京城","place_name_jianti_auto":"京城","start_index":6,"tongjian_id":"c635eada-db0e-11ef-9fc3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賞破黃巢、復京城之功也。","note_content_jianti_auto":"赏破黄巢、复京城之功也。","note_type":"hu_note","start_index":111,"tongjian_id":"c635ead8-db0e-11ef-92e9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","place_note":"陕西省延安市","resolved_place_entity_id":1238,"start_index":85,"tongjian_id":"c6382f06-db0e-11ef-ad6e-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","resolved_place_entity_id":1238,"start_index":99,"tongjian_id":"c6382f09-db0e-11ef-a0b7-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"楊復光遣使告捷，百官入賀。詔留忠武等軍二萬人，委大明宮留守王徽及京畿制置使田從異部分，守衞長安。五月，如朱玫、李克用、東方逵同平章事。升陝州爲節度，以王重盈爲節度使。又建延州爲保塞軍，以保大行軍司馬延州刺史李孝恭爲節度使。克用時年二十八，於諸將最少，而破黃巢，復長安，功第一，兵勢最強，諸將皆畏之。克用一目微眇，時人謂之「獨眼龍」。","content_fanyi":"杨复光派人向唐僖宗报告捷报，百官都入朝庆贺。唐僖宗下诏留下忠武等军二万人，交给大明宫留守王徽和京畿制置使田从异部署调度，守卫长安。五月，加授朱玫、李克用、东方逵为同平章事。将陕州升格为节度，任命王重盈为节度使。又在延州设置保塞军，任命保大行军司马、延州刺史李孝恭为节度使。李克用当时二十八岁，在诸将中年纪最小，却击破黄巢，收复长安，功劳位居第一，兵力最强，诸将都畏惧他。李克用一只眼睛略小，当时人称他为“独眼龙”。","content_jianti_auto":"杨复光遣使告捷，百官入贺。诏留忠武等军二万人，委大明宫留守王徽及京畿制置使田从异部分，守衞长安。五月，如朱玫、李克用、东方逵同平章事。升陕州为节度，以王重盈为节度使。又建延州为保塞军，以保大行军司马延州刺史李孝恭为节度使。克用时年二十八，于诸将最少，而破黄巢，复长安，功第一，兵势最强，诸将皆畏之。克用一目微眇，时人谓之「独眼龙」。","dtjl_paragraph_links":[],"dtjl_references":[],"id":26202,"path":"资治通鉴 : 卷第二百五十五 (唐紀七十一) / 僖宗惠聖恭定孝皇帝中之下 / 三年 / 第 20 段","reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":19,"tongjian_id":"c635eac8-db0e-11ef-8ca8-a0d3651f611f","year_int":883},"tongjian_id":"c635eac8-db0e-11ef-8ca8-a0d3651f611f"},"paragraph_order":8},{"mention_count":1,"paragraph_brief":{"brief_for":"延州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"胡敬璋","people_name_jianti_auto":"胡敬璋","start_index":29,"tongjian_id":"c9e9e63d-db0e-11ef-8954-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"隰州","place_name_jianti_auto":"隰州","place_note":"山西省隰县","start_index":6,"tongjian_id":"c9e9e63e-db0e-11ef-a331-a0d3651f611f"},{"place_name":"石樓縣","place_name_jianti_auto":"石楼县","start_index":8,"tongjian_id":"c9e9e63f-db0e-11ef-84a2-a0d3651f611f"},{"place_name":"上平關","place_name_jianti_auto":"上平关","start_index":12,"tongjian_id":"c9e9e640-db0e-11ef-852f-a0d3651f611f"},{"place_name":"延州","place_name_jianti_auto":"延州","start_index":17,"tongjian_id":"c9e9e641-db0e-11ef-b535-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":21,"tongjian_id":"c9e9e642-db0e-11ef-a9d5-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":34,"tongjian_id":"c9e9e643-db0e-11ef-b7cd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"金人疆域圖：隰州石樓縣有上平關。按延州東至隰州百三十里耳，胡敬璋蓋渡河來寇也。","note_content_jianti_auto":"金人疆域图：隰州石楼县有上平关。按延州东至隰州百三十里耳，胡敬璋盖渡河来寇也。","note_type":"hu_note","start_index":70,"tongjian_id":"c9e9e63c-db0e-11ef-93d2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉州","place_name_jianti_auto":"晋州","place_note":"山西省临汾市","start_index":4,"tongjian_id":"c9e9e646-db0e-11ef-8277-a0d3651f611f"},{"place_name":"隰州","place_name_jianti_auto":"隰州","start_index":9,"tongjian_id":"c9e9e647-db0e-11ef-bec1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志，晉州西北至隰州二百五十五里。","note_content_jianti_auto":"九域志，晋州西北至隰州二百五十五里。","note_type":"hu_note","start_index":94,"tongjian_id":"c9e9e645-db0e-11ef-bfc6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","place_note":"陕西省延安市","resolved_place_entity_id":1238,"start_index":57,"tongjian_id":"c9e9e653-db0e-11ef-9e49-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"向有巡司戍守]。","context_before":"○上平关[县西北九十里，下临黄河，路出陕西绥德州。","source_end_index":60,"source_paragraph_tongjian_id":"101ccb87-41b1-5d67-8086-8b833d7120bd","source_start_index":25,"source_text":"五代梁开平二年，李茂贞遣延州帅胡敬璋攻上平关，为梁将刘知俊所败，即此。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"3晉周德威、李嗣昭將兵三萬出陰地關，攻晉州，刺史徐懷玉拒守；帝自將救之，丁丑，發大梁，乙酉，至陝州。戊子，岐王所署延州節度使胡敬璋寇上平關，劉知俊擊破之。周德威等聞帝將至，乙未，退保隰州。","content_fanyi":"晋国的周德威、李嗣昭率领三万军队从阴地关出击，攻打晋州，晋州刺史徐怀玉坚守抵抗；皇帝亲自带兵救援晋州，丁丑日从大梁出发，乙酉日到达陕州。戊子日，岐王所任命的延州节度使胡敬璋进犯上平关，刘知俊将其击败。周德威等人听说皇帝即将到来，乙未日，退兵据守隰州。","content_jianti_auto":"3晋周德威、李嗣昭将兵三万出阴地关，攻晋州，刺史徐怀玉拒守；帝自将救之，丁丑，发大梁，乙酉，至陕州。戊子，岐王所署延州节度使胡敬璋寇上平关，刘知俊击破之。周德威等闻帝将至，乙未，退保隰州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27609,"number":3,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 開平二年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"c9e9e63a-db0e-11ef-8219-a0d3651f611f","year_int":908},"tongjian_id":"c9e9e63a-db0e-11ef-8219-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"延州","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"保塞","place_name_jianti_auto":"保塞","place_note":"总部设延州【陕西省延安市】","start_index":0,"tongjian_id":"c9ec599f-db0e-11ef-9a67-a0d3651f611f"},{"place_name":"靜難","place_name_jianti_auto":"静难","place_note":"总部设邠州【陕西彬县】","start_index":3,"tongjian_id":"c9ec59a0-db0e-11ef-8900-a0d3651f611f"},{"place_name":"岐","place_name_jianti_auto":"岐","start_index":10,"tongjian_id":"c9ec59a1-db0e-11ef-92ae-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"保塞、靜難二鎭時皆屬岐。","note_content_jianti_auto":"保塞、静难二镇时皆属岐。","note_type":"hu_note","start_index":31,"tongjian_id":"c9ec599e-db0e-11ef-8e56-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"延州","place_name_jianti_auto":"延州","resolved_place_entity_id":1238,"start_index":28,"tongjian_id":"c9ec59a7-db0e-11ef-a7d3-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"15保塞節度使胡敬璋卒，靜難節度使李繼徽以其將劉萬子代鎭延州。","content_fanyi":"保塞节度使胡敬璋去世，静难节度使李继徽派部将刘万子接替他镇守延州。","content_jianti_auto":"15保塞节度使胡敬璋卒，静难节度使李继徽以其将刘万子代镇延州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27621,"number":15,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 開平二年 / 第 16 段","reading_annotation_sources":[],"start_index":15,"tongjian_id":"c9ec599d-db0e-11ef-908a-a0d3651f611f","year_int":908},"tongjian_id":"c9ec599d-db0e-11ef-908a-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":3,"total_paragraphs":21},"place_name":"延州"},"message":"success","success":true}