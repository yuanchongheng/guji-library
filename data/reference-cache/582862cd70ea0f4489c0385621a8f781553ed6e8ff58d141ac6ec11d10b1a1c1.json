{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（己亥、前一四二）","note_content_jianti_auto":"（己亥、前一四二）","note_type":"hu_note","start_index":0,"tongjian_id":"8f3f1cbc-db0e-11ef-901c-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"1春，正月，地一日三動。","content_fanyi":"春季正月，大地一天之内三次震动。","content_jianti_auto":"1春，正月，地一日三动。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1342,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8f3f1cbd-db0e-11ef-adee-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡的最高行政长官，负责地方治理和军事防御。在《资治通鉴》此段中，太守冯敬与匈奴作战并战死，体现了太守在边疆地区的军事职责。","official_rank":"郡级长官","source_snippet":"太守馮敬與戰","start_index":9,"tongjian_id":"0c299672-0db1-42bf-846e-ca3bf7b05ad3"}],"ExtRef_Children_people":[{"link_death_year":-142,"link_td_description":"冯敬，上党郡人，西汉御史大夫。是秦始皇的武信侯冯无择之子。","link_td_id":"Q10019401","link_td_number_id":5922190,"people_name":"馮敬","people_name_jianti_auto":"冯敬","people_xingming":"冯敬","start_index":12,"tongjian_id":"8f3f1cbf-db0e-11ef-9732-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"匈奴","place_name_jianti_auto":"匈奴","resolved_place_entity_id":104,"start_index":4,"tongjian_id":"8f3f1cc0-db0e-11ef-9a67-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","resolved_place_entity_id":496,"start_index":7,"tongjian_id":"8f3f1cc1-db0e-11ef-95bb-a0d3651f611f"},{"place_name":"鴈門","place_name_jianti_auto":"鴈门","resolved_place_entity_id":496,"start_index":26,"tongjian_id":"8f3f1cc2-db0e-11ef-9833-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"汉匈战争","tongjian_id":"war_N0568"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"2三月，匈奴入鴈門，太守馮敬與戰，死。發車騎、材官屯鴈門。","content_fanyi":"三月，匈奴侵入雁门郡，太守冯敬与匈奴交战，战死。朝廷调发战车、骑兵和步兵屯驻雁门郡。","content_jianti_auto":"2三月，匈奴入鴈门，太守冯敬与战，死。发车骑、材官屯鴈门。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1343,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8f3f1cbe-db0e-11ef-ba62-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f3f6b1a-db0e-11ef-85f9-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：食，讀曰飤。以粟食馬者，沒其馬入官。","note_content_jianti_auto":"师古曰：食，读曰飤。以粟食马者，没其马入官。","note_type":"hu_note","start_index":19,"tongjian_id":"8f3f6b19-db0e-11ef-bd53-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3春，以歲不登，禁內郡食馬粟；沒入之。","content_fanyi":"春季，因收成不好，景帝下诏禁止内地各郡臣民用粟喂马；违犯此令者，由官府没收其马匹。","content_jianti_auto":"3春，以岁不登，禁内郡食马粟；没入之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1344,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f3f6b18-db0e-11ef-97ba-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"8f3fad75-db0e-11ef-9d12-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":24,"tongjian_id":"8f3fad76-db0e-11ef-a5f3-a0d3651f611f"},{"people_name":"許愼","people_name_jianti_auto":"许愼","start_index":28,"tongjian_id":"8f3fad77-db0e-11ef-90a1-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":38,"tongjian_id":"8f3fad78-db0e-11ef-baac-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":42,"tongjian_id":"8f3fad79-db0e-11ef-930c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：纂，今五采屬，綷是也。組，今綬紛絛是也。臣瓚曰：許愼云：纂，赤組也。師古曰：瓚說是也。綷，會也；會五采者，今謂之錯綵，非纂也。綷，子內翻。絛，他牢翻。","note_content_jianti_auto":"应劭曰：纂，今五采属，綷是也。组，今绶纷绦是也。臣瓒曰：许愼云：纂，赤组也。师古曰：瓒说是也。綷，会也；会五采者，今谓之错彩，非纂也。綷，子内翻。绦，他牢翻。","note_type":"hu_note","start_index":32,"tongjian_id":"8f3f6b1d-db0e-11ef-aa87-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"亡，古無字通。","note_content_jianti_auto":"亡，古无字通。","note_type":"hu_note","start_index":63,"tongjian_id":"8f3fad7a-db0e-11ef-b72e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f3fad7d-db0e-11ef-96a2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：省，所領翻。繇，讀曰傜。","note_content_jianti_auto":"师古曰：省，所领翻。繇，读曰傜。","note_type":"hu_note","start_index":98,"tongjian_id":"8f3fad7c-db0e-11ef-b98c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f3fad7f-db0e-11ef-9c8b-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：遂，成也。長，知兩翻。","note_content_jianti_auto":"师古曰：遂，成也。长，知两翻。","note_type":"hu_note","start_index":137,"tongjian_id":"8f3fad7e-db0e-11ef-909c-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":0,"tongjian_id":"8f3fad81-db0e-11ef-96cb-a0d3651f611f"},{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":12,"tongjian_id":"8f3fad82-db0e-11ef-974f-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":27,"tongjian_id":"8f3fad83-db0e-11ef-8211-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"張晏曰：以詐僞人爲吏也。臣瓚曰：律所謂矯枉以爲吏者也。師古曰：二說並非也，直謂詐自稱吏耳。","note_content_jianti_auto":"张晏曰：以诈伪人为吏也。臣瓒曰：律所谓矫枉以为吏者也。师古曰：二说并非也，直谓诈自称吏耳。","note_type":"hu_note","start_index":159,"tongjian_id":"8f3fad80-db0e-11ef-a15a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f3fad85-db0e-11ef-8e7d-a0d3651f611f"},{"people_name":"李奇","people_name_jianti_auto":"李奇","start_index":14,"tongjian_id":"8f3fad86-db0e-11ef-aea7-a0d3651f611f"},{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":37,"tongjian_id":"8f3fad87-db0e-11ef-b2b5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：漁，言若漁獵之爲也。李奇曰：牟，食苗根蟲也。侵牟食民，比之蛑賊也。杜佑曰：牟，取也。","note_content_jianti_auto":"师古曰：渔，言若渔猎之为也。李奇曰：牟，食苗根虫也。侵牟食民，比之蛑贼也。杜佑曰：牟，取也。","note_type":"hu_note","start_index":175,"tongjian_id":"8f3fad84-db0e-11ef-b100-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李斐","people_name_jianti_auto":"李斐","start_index":0,"tongjian_id":"8f3fad89-db0e-11ef-bbc9-a0d3651f611f"},{"people_name":"文穎","people_name_jianti_auto":"文颖","start_index":13,"tongjian_id":"8f3fad8a-db0e-11ef-9e2c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":42,"tongjian_id":"8f3fad8b-db0e-11ef-8782-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"李斐曰：姦法，因法作姦也。文穎曰：與盜，謂盜者當治，而知情反佐與之，是則共盜無異也。師古曰：與盜盜者，共盜爲盜耳。","note_content_jianti_auto":"李斐曰：奸法，因法作奸也。文颖曰：与盗，谓盗者当治，而知情反佐与之，是则共盗无异也。师古曰：与盗盗者，共盗为盗耳。","note_type":"hu_note","start_index":193,"tongjian_id":"8f3fad88-db0e-11ef-b385-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8f3fad8d-db0e-11ef-af7c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：耗，不明也，讀與眊同，音莫報翻。","note_content_jianti_auto":"师古曰：耗，不明也，读与眊同，音莫报翻。","note_type":"hu_note","start_index":212,"tongjian_id":"8f3fad8c-db0e-11ef-b47f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"縣丞","official_note":"縣丞是縣級行政機構的副長官，協助縣令處理政務，在漢代屬於地方基層官員。在原文中，縣丞被提及為長吏，並批評其可能涉及不法行為，反映了對地方官吏的監督和整頓意圖。","official_rank":"未知","source_snippet":"縣丞，長吏也；姦法與盜盜，甚無謂也！","start_index":180,"tongjian_id":"275484ca-99ae-4199-a88b-3e259cf0dcc0"},{"confidence":0.9,"official_category":"地方行政","official_name":"二千石","official_note":"二千石是漢代官員的俸祿等級，通常指郡守、諸侯國相等高級地方行政長官，品秩較高。在原文中，皇帝命令二千石官員盡職守責，否則將由丞相上報並治罪，體現了對地方治理的重視和中央集權的加強。","official_rank":"高級官員","source_snippet":"其令二千石各脩其職；不事官職、耗亂者，丞相以聞，請其罪。","start_index":200,"tongjian_id":"0bb76004-1aa1-49b9-a14b-de906266f4b9"},{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是漢代中央政府的最高行政長官，負責輔佐皇帝處理全國政務。在原文中，丞相被賦予監督和報告不稱職官員的職責，顯示其在官僚體系中的核心地位和監察功能。","official_rank":"最高行政長官","source_snippet":"不事官職、耗亂者，丞相以聞，請其罪。","start_index":210,"tongjian_id":"b0a134e3-cd00-48fa-87cf-c3dbbfb3f515"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f3f6b1b-db0e-11ef-b4db-a0d3651f611f","pinyin":"zuǎn","source_anchor_text":"者也錦繡纂組害女工","source_key":"baiyang_epub","start_index":23,"text":"纂","tongjian_id":"58deaec2-e30e-5374-9489-4714a8c3fdf6"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8f3f6b1b-db0e-11ef-b4db-a0d3651f611f","pinyin":"zī","source_anchor_text":"以奉宗廟粢盛祭服為","source_key":"baiyang_epub","start_index":75,"text":"粢","tongjian_id":"ee771f41-ef38-5f94-b6c3-ea7076a184d8"}],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4夏，四月，詔曰：「雕文刻鏤，傷農事者也；錦繡纂組，害女工者也。農事傷則飢之本，女工害則寒之原也。夫飢寒並至而能亡爲非者寡矣。朕親耕，后親桑，以奉宗廟粢盛、祭服，爲天下先；不受獻，減太官，省繇賦，欲天下務農蠶，素有蓄積，以備災害。強毋攘弱，衆毋暴寡；老耆以壽終，幼孤得遂長。今歲或不登，民食頗寡，其咎安在？或詐僞爲吏，以貨賂爲市，漁奪百姓，侵牟萬民。縣丞，長吏也；姦法與盜盜，甚無謂也！其令二千石各脩其職；不事官職、耗亂者，丞相以聞，請其罪。布告天下，使明知朕意。」","content_fanyi":"夏季四月，景帝下诏说：“雕文刻镂，会伤害农事；锦绣纂组，会伤害女工。农事受到伤害，就是饥饿的根源；女工受到伤害，就是寒冷的根源。饥寒一同降临而还能不做坏事的人，是很少的。朕亲自耕种，皇后亲自养蚕，用来供奉宗庙的粢盛和祭服，为天下做表率；不接受进献，裁减太官用度，减轻徭役赋税，希望天下百姓努力务农养蚕，平时多有积蓄，以防备灾害。强横者不得侵夺弱小者，势众者不得欺凌人少者；老年人得以寿终，幼儿孤儿得以顺利长大。如今年成有时歉收，百姓口粮很少，过错在哪里呢？也许是奸诈虚伪的人做了官吏，把财货贿赂当作买卖，侵夺百姓，侵害万民。县丞身为长吏，却作奸犯法，与盗贼一同偷盗，实在太没有道理了！现在命令二千石官员各自修明职守；不勤于职事、昏乱误政的，丞相要报告上来，并请求治他们的罪。布告天下，使天下人明白朕的心意。”","content_jianti_auto":"4夏，四月，诏曰：「雕文刻镂，伤农事者也；锦绣纂组，害女工者也。农事伤则饥之本，女工害则寒之原也。夫饥寒并至而能亡为非者寡矣。朕亲耕，后亲桑，以奉宗庙粢盛、祭服，为天下先；不受献，减太官，省繇赋，欲天下务农蚕，素有蓄积，以备灾害。强毋攘弱，众毋暴寡；老耆以寿终，幼孤得遂长。今岁或不登，民食颇寡，其咎安在？或诈伪为吏，以货赂为市，渔夺百姓，侵牟万民。县丞，长吏也；奸法与盗盗，甚无谓也！其令二千石各修其职；不事官职、耗乱者，丞相以闻，请其罪。布告天下，使明知朕意。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":1345,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8f3f6b1b-db0e-11ef-b4db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"8f3fad90-db0e-11ef-a080-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":15,"tongjian_id":"8f3fad91-db0e-11ef-8791-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"服虔曰：貲萬錢，算百二十七也。應劭曰：古者疾吏之貪，衣食足知榮辱，限貲十算乃得爲吏；十算，十萬也。賈人有財不得爲吏，廉士無貲又不得官，故減貲四算得官矣。","note_content_jianti_auto":"服虔曰：赀万钱，算百二十七也。应劭曰：古者疾吏之贪，衣食足知荣辱，限赀十算乃得为吏；十算，十万也。贾人有财不得为吏，廉士无赀又不得官，故减赀四算得官矣。","note_type":"hu_note","start_index":11,"tongjian_id":"8f3fad8f-db0e-11ef-88aa-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.7,"official_category":"未知","official_name":"官","official_note":"在《资治通鉴》中，“官”通常指官职或官员，此处“得官”表示通过“算貲四”获得官职，反映了汉代通过财产标准选拔官员的制度。","official_rank":"未知","source_snippet":"得官","start_index":9,"tongjian_id":"bde09ba1-de0f-46cd-8a62-524cf724f313"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5五月，詔算貲四得官。","content_fanyi":"五月，景帝下诏规定，家产达到四万钱的人，就可以获得官职。","content_jianti_auto":"5五月，诏算赀四得官。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1346,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8f3fad8e-db0e-11ef-a4e7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6秋，大旱。","content_fanyi":"秋季，天下发生了大旱。","content_jianti_auto":"6秋，大旱。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1347,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8f3fad92-db0e-11ef-8347-a0d3651f611f"}],"reign_name":"二年","reign_name_jianti_auto":"二年","start_index":12,"tongjian_id":"8f3f1cbb-db0e-11ef-a395-a0d3651f611f","year_anno":"（己亥、前一四二）","year_int":-142},"message":"success","success":true}