ldren_zhang_notes":[],"note_content":"考異曰：劉昭註補後漢書·志亦謂之續漢志，其郡國志註云「中郞將馬援」，誤也。帝紀「冬十月，遣援出塞擊烏桓」，援傳：「十二月，出屯襄國，明年秋，將三千騎出高柳。」袁紀在八月祭肜事前。今從之。","note_content_jianti_auto":"考异曰：刘昭注补后汉书·志亦谓之续汉志，其郡国志注云「中郞将马援」，误也。帝纪「冬十月，遣援出塞击乌桓」，援传：「十二月，出屯襄国，明年秋，将三千骑出高柳。」袁纪在八月祭肜事前。今从之。","note_type":"hu_note","start_index":139,"tongjian_id":"949453f7-db0e-11ef-9f8a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡的最高行政长官，负责管理郡内政务、军事和司法。在上下文中，光武帝派遣马援等人筑堡塞、兴立郡县，并空置太守等官职，旨在招还流亡百姓，恢复边郡秩序，这反映了东汉初期对北方边疆的治理策略。","official_rank":"郡级长官","source_snippet":"或空置太守、令、長","start_index":78,"tongjian_id":"12b1c544-ff34-440e-a6c8-c69ce82070a8"},{"confidence":0.9,"official_category":"地方行政","official_name":"令","official_note":"令是汉代县的行政长官，负责管理县内事务。在上下文中，与太守、长并列，表示在边疆地区设立或空置县级官职，以吸引人民回归，加强地方控制。","official_rank":"县级长官","source_snippet":"或空置太守、令、長","start_index":81,"tongjian_id":"921d3e61-ccbf-4a0c-80e3-87308c2c4bbf"},{"confidence":0.9,"official_category":"地方行政","official_name":"長","official_note":"长是汉代县的另一种行政长官，通常用于较小的县。在上下文中，与太守、令一起提及，作为边疆治理中恢复或设立的地方官职，旨在重建行政体系。","official_rank":"县级长官","source_snippet":"或空置太守、令、長","start_index":83,"tongjian_id":"cf115e45-5593-410b-b143-1a70d2aa4e1c"}],"ExtRef_Children_people":[{"link_birth_year":-14,"link_death_year":49,"link_td_description":"马援，字文渊，扶风郡茂陵（今陕西省兴平市东北）人，东汉军事家。汉光武帝时，拜为伏波将军，封新息侯，世称马伏波。","link_td_id":"Q10000488","link_td_number_id":135961,"people_name":"馬援","people_name_jianti_auto":"马援","people_xingming":"马援","start_index":80,"tongjian_id":"9494540c-db0e-11ef-a8d3-a0d3651f611f"},{"link_birth_year":-14,"link_death_year":49,"link_td_description":"马援，字文渊，扶风郡茂陵（今陕西省兴平市东北）人，东汉军事家。汉光武帝时，拜为伏波将军，封新息侯，世称马伏波。","link_td_id":"Q10000488","link_td_number_id":135961,"people_name":"援","people_name_jianti_auto":"援","people_xingming":"马援","start_index":126,"tongjian_id":"9494540d-db0e-11ef-a4b5-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"烏桓","place_name_jianti_auto":"乌桓