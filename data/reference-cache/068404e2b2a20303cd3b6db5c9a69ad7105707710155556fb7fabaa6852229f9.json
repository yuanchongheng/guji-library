{"data":{"current_mention_tongjian_id":"8c372c75-db0e-11ef-88f1-a0d3651f611f","current_paragraph_tongjian_id":"8c372c5c-db0e-11ef-89ec-a0d3651f611f","occurrence_page":{"anchor_paragraph_order":1,"current_page":1,"items":[{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":9,"tongjian_id":"8c372c5e-db0e-11ef-bbac-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":18,"tongjian_id":"8c372c5f-db0e-11ef-927b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄒","place_name_jianti_auto":"邹","place_note":"山東鄒縣东南","start_index":0,"tongjian_id":"8c372c60-db0e-11ef-9101-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":2,"tongjian_id":"8c372c61-db0e-11ef-944f-a0d3651f611f"},{"place_name":"邾國","place_name_jianti_auto":"邾国","start_index":5,"tongjian_id":"8c372c62-db0e-11ef-b6db-a0d3651f611f"},{"place_name":"鄒縣","place_name_jianti_auto":"邹县","start_index":12,"tongjian_id":"8c372c63-db0e-11ef-97e0-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":15,"tongjian_id":"8c372c64-db0e-11ef-b0d2-a0d3651f611f"},{"place_name":"淄州","place_name_jianti_auto":"淄州","start_index":22,"tongjian_id":"8c372c65-db0e-11ef-b966-a0d3651f611f"},{"place_name":"鄒平縣","place_name_jianti_auto":"邹平县","start_index":24,"tongjian_id":"8c372c66-db0e-11ef-a645-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":28,"tongjian_id":"8c372c67-db0e-11ef-9649-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄒，春秋之邾國也。班志，鄒縣屬魯國。宋白曰：淄州鄒平縣，漢舊縣。","note_content_jianti_auto":"邹，春秋之邾国也。班志，邹县属鲁国。宋白曰：淄州邹平县，汉旧县。","note_type":"hu_note","start_index":10,"tongjian_id":"8c372c5d-db0e-11ef-97bb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"叟者，尊老之稱。稱，尺證翻。","note_content_jianti_auto":"叟者，尊老之称。称，尺证翻。","note_type":"hu_note","start_index":16,"tongjian_id":"8c372c69-db0e-11ef-952f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不遠千里，言不以千里爲遠也。","note_content_jianti_auto":"不远千里，言不以千里为远也。","note_type":"hu_note","start_index":49,"tongjian_id":"8c372c6a-db0e-11ef-bd8a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":2,"chapter_name":"书法篇第二","chenzhu_chapter":"《通鉴》书法，不尽关褒贬，故不如《春秋》之严。温公谦不敢法《春秋》，而志在续《左氏传》，有所感触，亦仿左氏设辞“君子曰”而称“臣光曰”以发之。馀则据事直书，使人随其时地之异而评其得失，以为鉴戒，非有一定不易之书法也。旧传温公《修书前例》一卷，公曾孙伋曾梓行之，然脱落已甚，不皆可据。兹篇所录，则身之推论《通鉴》之书法为多，其有关全书义例及史文构造、史料采取，亦隶焉，固与《通鉴纲目》等之所谓书法，涵义颇殊也。","chenzhu_index_in_chapter":3,"chenzhu_text":"此亦谨名分之意，身之因其与《孟子》异文而推论之如此。","created_at":"2025-12-31 08:50:44","seq_in_chapter":12,"tongjian_id":"CH02-CZ003"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟子","people_name_jianti_auto":"孟子","start_index":20,"tongjian_id":"8c372c6d-db0e-11ef-b5fd-a0d3651f611f"},{"people_name":"魏王","people_name_jianti_auto":"魏王","start_index":23,"tongjian_id":"8c372c6e-db0e-11ef-a0ff-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":40,"tongjian_id":"8c372c6f-db0e-11ef-84d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"通鑑於此段前後書王，因孟子之文也。中間敍孟子答魏王之言，獨改「王」曰「君」，不與魏之稱王也。","note_content_jianti_auto":"通鉴于此段前后书王，因孟子之文也。中间敍孟子答魏王之言，独改「王」曰「君」，不与魏之称王也。","note_type":"hu_note","start_index":114,"tongjian_id":"8c372c6c-db0e-11ef-aa89-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"大夫","official_note":"大夫是古代官职，在周代属于卿大夫阶层，负责管理封地或参与国政。在《资治通鉴》此段中，孟子引用'大夫曰何以利吾家'来说明不同阶层追求私利会导致国家危机，这里的'大夫'泛指官员阶层，并非特指某个具体人物。","official_rank":"未知","source_snippet":"大夫曰何以利吾家","start_index":54,"tongjian_id":"2ba4c660-e135-483e-bf24-6b6e4f57d5af"}],"ExtRef_Children_people":[{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟軻","people_name_jianti_auto":"孟轲","people_xingming":"孟轲","start_index":3,"tongjian_id":"8c372c72-db0e-11ef-a73d-a0d3651f611f"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟轲","start_index":32,"tongjian_id":"8c372c75-db0e-11ef-88f1-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2鄒人孟軻見魏惠王，王曰：「叟，不遠千里而來，亦有以利吾國乎？」孟子曰：「君何必曰利，仁義而已矣！君曰何以利吾國，大夫曰何以利吾家，士庶人曰何以利吾身，上下交征利而國危矣。未有仁而遺其親者也，未有義而後其君者也。」王曰：「善。」","content_fanyi":"邹国人孟轲前去求见魏惠王，魏惠王说：“先生，您不远千里前来，能给我的国家带来什么利益吗？”孟子说：“主君为什么一定要说利益呢，只要讲仁义就够了！国君说怎样使自己的邦国得利，大夫说怎样使自己的家邑得利，士人平民说怎样使自身得利，上上下下互相争夺利益，国家就危险了。从来没有仁德的人会遗弃自己的父母，也从来没有忠义的人会怠慢自己的国君。”魏惠王说：“说得好！”","content_jianti_auto":"2邹人孟轲见魏惠王，王曰：「叟，不远千里而来，亦有以利吾国乎？」孟子曰：「君何必曰利，仁义而已矣！君曰何以利吾国，大夫曰何以利吾家，士庶人曰何以利吾身，上下交征利而国危矣。未有仁而遗其亲者也，未有义而后其君者也。」王曰：「善。」","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"，杜篡弑夺攘之萌，其功信不在禹下也。","context_before":"...王贱利以纳民于名义，节其情，正其性，非计近功者所能测。而","source_end_index":98,"source_paragraph_tongjian_id":"a79aecaf-6445-44dd-8b3b-667bb259a502","source_start_index":92,"source_text":"孟子三斥梁王"}],"title":"一五 贪功利能亡国败家"}],"id":176,"number":2,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"8c372c5c-db0e-11ef-89ec-a0d3651f611f","year_int":-336,"zhang_TJZJ_id":"zttjzj_000366"},"tongjian_id":"8c372c5c-db0e-11ef-89ec-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"易·乾卦·文言。","note_content_jianti_auto":"易·乾卦·文言。","note_type":"hu_note","start_index":107,"tongjian_id":"8c372c78-db0e-11ef-afb9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"易·大傳之辭。","note_content_jianti_auto":"易·大传之辞。","note_type":"hu_note","start_index":122,"tongjian_id":"8c372c7a-db0e-11ef-837a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟轲","start_index":2,"tongjian_id":"8c372c7c-db0e-11ef-b882-a0d3651f611f"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟轲","start_index":27,"tongjian_id":"8c372c7f-db0e-11ef-97f7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"初，孟子師子思，嘗問牧民之道何先。子思曰：「先利之。」孟子曰：「君子所以敎民者，亦仁義而已矣，何必利！」子思曰：「仁義固所以利之也。上不仁則下不得其所，上不義則下樂爲詐也，此爲不利大矣。故易曰：『利者，義之和也。』又曰：『利用安身，以崇德也。』此皆利之大者也。」","content_fanyi":"当初，孟子以子思为师，曾问治理百姓应以什么为先。子思说：“先让百姓得到利益。”孟子说：“君子用来教导民众的，只讲仁义就够了，何必讲利！”子思说：“仁义本来就是用来为民众谋利的。居上位的人不仁，下面的人就得不到他们应得的东西；居上位的人不义，下面的人就乐于欺诈，这样造成的不利最大。所以《易经》说：‘利，是义的谐和体现。’又说：‘用利来安顿自身，以崇尚道德。’这些都是利益中最重要的内容。”","content_jianti_auto":"初，孟子师子思，尝问牧民之道何先。子思曰：「先利之。」孟子曰：「君子所以教民者，亦仁义而已矣，何必利！」子思曰：「仁义固所以利之也。上不仁则下不得其所，上不义则下乐为诈也，此为不利大矣。故易曰：『利者，义之和也。』又曰：『利用安身，以崇德也。』此皆利之大者也。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":177,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十三年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8c372c76-db0e-11ef-b67e-a0d3651f611f","year_int":-336},"tongjian_id":"8c372c76-db0e-11ef-b67e-a0d3651f611f"},"paragraph_order":2},{"mention_count":2,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8c372c85-db0e-11ef-8f20-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本無「爲」字；乙十一行本同。』","note_content_jianti_auto":"『章：十二行本无「为」字；乙十一行本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8c372c84-db0e-11ef-8201-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":25,"tongjian_id":"8c372c83-db0e-11ef-b761-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟子","start_index":7,"tongjian_id":"8c372c89-db0e-11ef-a16b-a0d3651f611f"},{"link_birth_year":-372,"link_death_year":-289,"link_td_description":"孟子，姬姓，孟氏，名轲，邹国（今山东省邹城市）人，战国时期儒家代表人物。","link_td_id":"Q10000009","link_td_number_id":1677,"people_name":"孟子","people_name_jianti_auto":"孟子","people_xingming":"孟子","start_index":35,"tongjian_id":"8c372c8a-db0e-11ef-aaee-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"臣光曰：子思、孟子之言，一也。夫唯仁者爲知仁義之爲利，不仁者不知也。故孟子對梁王直以仁義而不及利者，所與言之人異故也。","content_fanyi":"臣司马光评论说：子思和孟子的话，道理是一致的。只有仁德的人才能懂得仁义的利益所在，不仁德的人则不懂得这一点。所以孟子面对梁王，也就是魏惠王，只讲仁义而不谈利益，是因为所交谈的对象不同。","content_jianti_auto":"臣光曰：子思、孟子之言，一也。夫唯仁者为知仁义之为利，不仁者不知也。故孟子对梁王直以仁义而不及利者，所与言之人异故也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":178,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 三十三年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8c372c82-db0e-11ef-90bb-a0d3651f611f","year_int":-336},"tongjian_id":"8c372c82-db0e-11ef-90bb-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"襄王","people_name_jianti_auto":"襄王","start_index":8,"tongjian_id":"8c5a17a2-db0e-11ef-8bca-a0d3651f611f"},{"people_name":"嗣","people_name_jianti_auto":"嗣","start_index":12,"tongjian_id":"8c5a17a3-db0e-11ef-9cd2-a0d3651f611f"},{"people_name":"司馬貞","people_name_jianti_auto":"司马贞","start_index":22,"tongjian_id":"8c5a17a4-db0e-11ef-aee8-a0d3651f611f"},{"people_name":"惠王","people_name_jianti_auto":"惠王","start_index":50,"tongji