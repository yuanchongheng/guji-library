{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙巳、二八五）","note_content_jianti_auto":"（乙巳、二八五）","note_type":"hu_note","start_index":0,"tongjian_id":"9d06667d-db0e-11ef-a3d3-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：晉春秋在七年十月，今從本傳。","note_content_jianti_auto":"考异曰：晋春秋在七年十月，今从本传。","note_type":"hu_note","start_index":19,"tongjian_id":"9d06667f-db0e-11ef-92e6-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"尚書左僕射","official_note":"尚書左僕射是尚書省的高级官员，负责协助尚书令处理政务，在晋代属于中枢行政核心。此处表示刘毅担任此官职后退休。","official_rank":"从二品","source_snippet":"尚書左僕射劉毅致仕","start_index":5,"tongjian_id":"ca88072b-c810-4d6f-8dd4-eca13696e365"}],"ExtRef_Children_people":[{"link_birth_year":216,"link_death_year":285,"link_td_description":"刘毅，字仲雄，东莱郡掖县人。西汉城阳王刘章的后代，曹魏及西晋官员。刘毅公正刚直，喜欢评论人物，后来任官更多次弹劾大小官员，又提议废除九品中正制。刘毅更曾直谏晋武帝卖官入私门，连东汉时期的汉桓帝都比不上。","link_td_id":"Q10009422","link_td_number_id":669123,"people_name":"劉毅","people_name_jianti_auto":"刘毅","people_xingming":"刘毅","start_index":11,"tongjian_id":"9d066683-db0e-11ef-8204-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"1春，正月，尚書左僕射劉毅致仕，尋卒。","content_fanyi":"春季，正月，尚书左仆射刘毅辞官归家，不久后就去世了。","content_jianti_auto":"1春，正月，尚书左仆射刘毅致仕，寻卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6981,"number":1,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":0,"tongjian_id":"9d06667e-db0e-11ef-8db6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"尚書主者也。處，昌呂翻。當，丁浪翻。","note_content_jianti_auto":"尚书主者也。处，昌吕翻。当，丁浪翻。","note_type":"hu_note","start_index":29,"tongjian_id":"9d066685-db0e-11ef-adcc-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"侍中管門下諸事，故得繩以法。","note_content_jianti_auto":"侍中管门下诸事，故得绳以法。","note_type":"hu_note","start_index":35,"tongjian_id":"9d066686-db0e-11ef-bd5f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"齊王","people_name_jianti_auto":"齐王","start_index":5,"tongjian_id":"9d06668a-db0e-11ef-b4d0-a0d3651f611f"},{"people_name":"攸","people_name_jianti_auto":"攸","start_index":7,"tongjian_id":"9d06668b-db0e-11ef-8424-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂帝不能容齊王攸也。爲，于僞翻。","note_content_jianti_auto":"谓帝不能容齐王攸也。为，于伪翻。","note_type":"hu_note","start_index":146,"tongjian_id":"9d066689-db0e-11ef-bdd5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Childr