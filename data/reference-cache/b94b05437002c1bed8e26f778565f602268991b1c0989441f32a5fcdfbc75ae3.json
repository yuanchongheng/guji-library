089ce5-db0e-11ef-80de-a0d3651f611f"},{"people_name":"俟汾氏","people_name_jianti_auto":"俟汾氏","start_index":95,"tongjian_id":"9d089ce6-db0e-11ef-8790-a0d3651f611f"},{"people_name":"俟汾","people_name_jianti_auto":"俟汾","start_index":103,"tongjian_id":"9d089ce7-db0e-11ef-a222-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宇文","place_name_jianti_auto":"宇文","start_index":0,"tongjian_id":"9d089ce8-db0e-11ef-984e-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":4,"tongjian_id":"9d089ce9-db0e-11ef-9a22-a0d3651f611f"},{"place_name":"宇文","place_name_jianti_auto":"宇文","start_index":54,"tongjian_id":"9d089cea-db0e-11ef-986d-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":84,"tongjian_id":"9d089ceb-db0e-11ef-890d-a0d3651f611f"},{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","start_index":113,"tongjian_id":"9d089cec-db0e-11ef-95d5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宇文部亦鮮卑種，其先有大人曰普回，因狩得玉璽三紐，文曰「皇帝璽」。普回以爲天授，其俗謂天子曰「宇文」，故國號宇文，倂以爲氏。何氏姓苑曰：宇文氏出自炎帝，其後以嘗草之功，鮮卑呼草爲俟汾，遂號爲俟汾氏，後世通稱俟汾，蓋音訛也。代爲鮮卑單于。","note_content_jianti_auto":"宇文部亦鲜卑种，其先有大人曰普回，因狩得玉玺三纽，文曰「皇帝玺」。普回以为天授，其俗谓天子曰「宇文」，故国号宇文，倂以为氏。何氏姓苑曰：宇文氏出自炎帝，其后以尝草之功，鲜卑呼草为俟汾，遂号为俟汾氏，后世通称俟汾，盖音讹也。代为鲜卑单于。","note_type":"hu_note","start_index":35,"tongjian_id":"9d089ce0-db0e-11ef-aff4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":8,"tongjian_id":"9d089cef-db0e-11ef-ad73-a0d3651f611f"},{"people_name":"肥子","people_name_jianti_auto":"肥子","start_index":12,"tongjian_id":"9d089cf0-db0e-11ef-b12d-a0d3651f611f"},{"people_name":"賢","people_name_jianti_auto":"贤","start_index":22,"tongjian_id":"9d089cf1-db0e-11ef-84fe-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"肥如縣","place_name_jianti_auto":"肥如县","start_index":0,"tongjian_id":"9d089cf2-db0e-11ef-a8bb-a0d3651f611f"},{"place_name":"遼西郡","place_name_jianti_auto":"辽西郡","start_index":4,"tongjian_id":"9d089cf3-db0e-11ef-ab3f-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":15,"tongjian_id":"9d089cf4-db0e-11ef-84de-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":17,"tongjian_id":"9d089cf5-db0e-11ef-9d28-a0d3651f611f"},{"place_name":"肥如","place_name_jianti_auto":"肥如","start_index":25,"tongjian_id":"9d089cf6-db0e-11ef-aaa2-a0d3651f611f"},{"place_name":"平州","place_name_jianti_auto":"平州","start_index":29,"tongjian_id":"9d089cf7-db0e-11ef-a8d1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"肥如縣屬遼西郡。應劭曰：肥子奔燕、燕封於此，賢曰：肥如，今平州。","note_content_jianti_auto":"肥如县属辽西郡。应劭曰：肥子奔燕、燕封于此，贤曰：肥如，今平州。","note_type":"hu_note","start_index":71,"tongjian_id":"9d089cee-db0e-11ef-a62a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"幽州軍","official_note":"幽州軍是晉朝在幽州地區的軍事部隊，負責邊防和征討任務。在上下文中，晉武帝派遣幽州軍討伐慕容廆，顯示其作為地方軍事力量在鎮壓邊境叛亂中的作用。此信息基於《資治通鑑》原文和歷史常識。","official_rank":"未知","source_snippet":"帝遣幽州軍討廆","start_index":68,"tongjian_id":"7c6ed66d-9a26-4157-a02e-bad98bc4b659"},{"confidence":0.85,"official_category":"地方行政","official_name":"扶餘王","official_note":"扶餘王是扶餘國（位於今中國東北地區的古代國家）的君主，屬於地方政權的統治者。在上下文中，扶餘王依慮因慕容廆的攻擊而自殺，顯示其作為地方領袖在邊境衝突中的角色。此信息基於《資治通鑑》原文和歷史常識。","official_rank":"未知","source_snippet":"扶餘王依慮自殺","start_index":94,"tongjian_id":"66a0a593-4b0a-41a4-8c19-71141ba63516"}],"ExtRef_Children_people":[{"link_death_year":285,"link_td_description":"慕容删，慕容部鲜卑酋长慕容涉归之弟。西晋太康四年（283年）十二月，趁其兄长慕容涉归逝世之际，成功夺取政权，并企图追杀其兄长遗子慕容廆未果。晋太康五年（285年）十二月，遭其属下诛杀。","link_td_id":"Q10009570","link_td_number_id":749498,"people_name":"慕容删","people_name_jianti_auto":"慕容删","people_xingming":"慕容删","start_index":4,"tongjian_id":"9d089cfa-db0e-11ef-9041-a0d3651f611f"},{"link_death_year":283,"link_td_description":"慕容涉归，慕容部鲜卑初代酋长莫护跋之孙，慕容木延之子。","link_td_id":"Q10009565","link_td_number_id":748297,