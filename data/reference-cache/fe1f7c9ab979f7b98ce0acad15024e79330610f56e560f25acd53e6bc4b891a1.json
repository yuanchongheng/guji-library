e":"班","people_name_jianti_auto":"班","start_index":18,"tongjian_id":"8fdd7223-db0e-11ef-9926-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"武強縣","place_name_jianti_auto":"武强县","start_index":21,"tongjian_id":"8fdd7224-db0e-11ef-b5b6-a0d3651f611f"},{"place_name":"廣川","place_name_jianti_auto":"广川","start_index":25,"tongjian_id":"8fdd7225-db0e-11ef-a5c8-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":28,"tongjian_id":"8fdd7226-db0e-11ef-a400-a0d3651f611f"},{"place_name":"冀州","place_name_jianti_auto":"冀州","start_index":29,"tongjian_id":"8fdd7227-db0e-11ef-a20e-a0d3651f611f"},{"place_name":"武強縣","place_name_jianti_auto":"武强县","start_index":31,"tongjian_id":"8fdd7228-db0e-11ef-a612-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武強侯莊不識，高祖功臣，青翟其孫也。班志，武強縣屬廣川；唐冀州武強縣是也。","note_content_jianti_auto":"武强侯庄不识，高祖功臣，青翟其孙也。班志，武强县属广川；唐冀州武强县是也。","note_type":"hu_note","start_index":24,"tongjian_id":"8fdd721e-db0e-11ef-82a4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"文教","official_name":"太子少傅","official_note":"太子少傅是负责教导太子的官员，属于东宫官属，在汉代通常为重要文职。在此上下文中，莊青翟被任命为丞相，太子少傅是其之前的官职，用于说明其晋升背景。","official_rank":"未知","source_snippet":"太子少傅武強侯莊青翟","start_index":12,"tongjian_id":"2890fb2c-ee76-4f2c-9d1b-35d17db682b9"},{"confidence":0.98,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是汉代最高行政长官，负责辅佐皇帝处理政务，属于三公之一。在此上下文中，莊青翟被任命为丞相，表示其晋升至最高官职。","official_rank":"正一品","source_snippet":"爲丞相","start_index":21,"tongjian_id":"8f0c79c7-8040-4148-bad1-65b6899804e0"}],"ExtRef_Children_people":[{"link_birth_year":-164,"link_death_year":-115,"link_td_description":"庄青翟，西汉大臣。","link_td_id":"Q10002667","link_td_number_id":1486102,"people_name":"武強侯","people_name_jianti_auto":"武强侯","people_xingming":"庄青翟","start_index":14,"tongjian_id":"8fdd722a-db0e-11ef-b9b5-a0d3651f611f"},{"link_birth_year":-164,"link_death_year":-115,"link_td_description":"庄青翟，西汉大臣。","link_td_