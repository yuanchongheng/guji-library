gjian_id":"8fdd7236-db0e-11ef-9d18-a0d3651f611f"},{"place_name":"湖城縣","place_name_jianti_auto":"湖城县","start_index":56,"tongjian_id":"8fdd7237-db0e-11ef-8687-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉灼曰：黃圖：鼎湖，宮名，在京兆。班志，湖本在京兆，後分屬弘農。索隱曰：昔黃帝採首山銅，鑄鼎於湖，曰鼎湖，卽今之湖城縣也。","note_content_jianti_auto":"晋灼曰：黄图：鼎湖，宫名，在京兆。班志，湖本在京兆，后分属弘农。索隐曰：昔黄帝采首山铜，铸鼎于湖，曰鼎湖，即今之湖城县也。","note_type":"hu_note","start_index":8,"tongjian_id":"8fdd722d-db0e-11ef-9f26-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"8fdd723c-db0e-11ef-9f10-a0d3651f611f"},{"people_name":"發根","people_name_jianti_auto":"发根","start_index":10,"tongjian_id":"8fdd723d-db0e-11ef-96b4-a0d3651f611f"},{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":16,"tongjian_id":"8fdd723e-db0e-11ef-bd69-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":34,"tongjian_id":"8fdd723f-db0e-11ef-9907-a0d3651f611f"},{"people_name":"游水","people_name_jianti_auto":"游水","start_index":44,"tongjian_id":"8fdd7240-db0e-11ef-95c0-a0d3651f611f"},{"people_name":"發根","people_name_jianti_auto":"发根","start_index":50,"tongjian_id":"8fdd7241-db0e-11ef-b22a-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"游水","place_name_jianti_auto":"游水","start_index":4,"tongjian_id":"8fdd7242-db0e-11ef-96b3-a0d3651f611f"},{"place_name":"游水","place_name_jianti_auto":"游水","start_index":24,"tongjian_id":"8fdd7243-db0e-11ef-abbc-a0d3651f611f"},{"place_name":"臨淮","place_name_jianti_auto":"临淮","start_index":31,"tongjian_id":"8fdd7244-db0e-11ef-ac82-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"服虔曰：游水，縣名；發根，人名。晉灼曰：地理志，游水，水名，在臨淮。師古曰：二說皆非也。游水，姓也；發根，名也；蓋因水爲姓也。本嘗遇病而神下之，故爲巫也。下，戶嫁翻，降附也。","note_content_jianti_auto":"服虔曰：游水，县名；发根，人名。晋灼曰：地理志，游水，水名，在临淮。师古曰：二说皆非也。游水，姓也；发根，名也；盖因水为姓也。本尝遇病而神下之，故为巫也。下，户嫁翻，降附也。","note_type":"hu_note","start_index":35,"tongjian_id":"8fdd723b-db0e-11ef-95cd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"8fdd7248-db0e-11ef-9db1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：良已，善已；謂瘉也。","note_content_jianti_auto":"孟康曰：良已，善已；谓瘉也。","note_type":"hu_note","start_index":92,"tongjian_id":"8fdd7247-db0e-11ef-b95e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":9,"tongjian_id":"8fdd724a-db0e-11ef-b8df-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"壽宮","place_name_jianti_auto":"寿宫","start_index":2,"tongjian_id":"8fdd724b-db0e-11ef-812a-a0d3651f611f"},{"place_name":"壽宮","place_name_jianti_auto":"寿宫","start_index":13,"tongjian_id":"8fdd724c-db0e-11ef-9775-a0d3651f611f"},{"place_name":"壽宮","place_name_jianti_auto":"寿宫","start_index":30,"tongjian_id":"8fdd724d-db0e-11ef-8d39-a0d3651f611f"},{"place_name":"壽宮","place_name_jianti_auto":"寿宫","start_index":37,"tongjian_id":"8fdd724e-db0e-11ef-916e-a0d3651f611f"},{"place_name":"雍州","place_name_jianti_auto":"雍州","start_index":40,"tongjian_id":"8fdd724f-db0e-11ef-bd4a-a0d3651f611f"},{"place_name":"長安縣","place_name_jianti_auto":"长安县","start_index":42,"tongjian_id":"8fdd7250-db0e-11ef-8a2e-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":50,"tongjian_id":"8fdd7251-db0e-11ef-9cb7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"帝置壽宮以奉神君。臣瓚曰：壽宮，奉神之宮也。楚辭曰：蹇將澹兮壽宮。括地志：壽宮在雍州長安縣西北三十里長安故城中。","note_content_jianti_auto":"帝置寿宫以奉神君。臣瓒曰：寿宫，奉神之宫也。楚辞曰：蹇将澹兮寿宫。括地志：寿宫在雍州长安县西北三十里长安故城中。","note_type":"hu_note","start_index":97,"tongjian_id":"8fdd7249-db0e-11ef-a1e4-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孟康","people_name_jianti_auto":"孟康","start_index":0,"tongjian_id":"8fdd7255-db0e-11ef-8975-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟康曰：策畫之法也。","note_content_jianti_auto":"孟康曰：策画之法也。","note_type":"hu_note","start_index":152,"tongjian_id":"8fdd7254-db0e-11ef-9782-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdd7257-db0e-11ef-ab11-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：喜，好也，音許吏翻。","note_content_jianti_auto":"师古曰：喜，好也，音许吏翻。","note_type":"hu_note","start_index":184,"tongjian_id":"8fdd7256-db0e-11ef-8d04-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"people_name":"發根","people_name_jianti_auto":"发根","people_xingming":"發根","start_index":20,"tongjian_id":"8fdd7259-db0e-11ef-9869-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鼎湖","place_name_jianti_auto":"鼎湖","resolved_place_entity_id":10098,"start_index":4,"tongjian_id":"8fdd7258-db0e-11ef-8273-a0d3651f611f"},{"place_name":"游水","place_name_jianti_auto":"游水","resolved_place_entity_id":7973,"start_index":18,"tongjian_id":"8fdd725a-db0e-11ef-b9d3-a0d3651f611f"},{"place_name":"上郡","place_name_jianti_auto":"上郡","place_note":"陕西榆林南鱼河堡","resolved_place_entity_id":712,"start_index":23,"tongjian_id":"8fdd725b-db0e-11ef-84ac-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","resolved_place_entity_id":648,"start_index":41,"tongjian_id":"8fdd725c-db0e-11ef-83bf-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","resolved_place_entity_id":648,"start_index":73,"tongjian_id":"8fdd725d-db0e-11ef-8d24-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","resolved_place_entity_id":648,"start_index":85,"tongjian_id":"8fdd725e-db0e-11ef-a073-a0d3651f611f"},{"place_name":"壽宮","place_name_jianti_auto":"寿宫","resolved_place_entity_id":6341,"start_index":94,"tongjian_id":"8fdd725f-db0e-11ef-bf45-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5天子病鼎湖甚，巫醫無所不致，不愈。游水發根言上郡有巫，病而鬼神下之。上召置，祠之甘泉，及病，使人問神君，神君言曰：「天子無憂病；病少愈，強與我會甘泉。」於是病愈，遂起幸甘泉，病良已，置酒壽宮。神君非可得見，聞其言，言與人音等，時去時來，來則風肅然，居室帷中。神君所言，上使人受，書其言，命之曰「畫法」。其所語，世俗之所知也，無絕殊者，而天子心獨喜；其事祕，世莫知也。","content_fanyi":"汉武帝在鼎湖宫病得很重，巫师、医生用尽了各种办法，仍然不能痊愈。游水发根说，上郡有一个巫师，生病时会有鬼神附体。武帝把他召来，安置在甘泉宫祭祀，等到发病时，派人向神君询问，神君说：“天子不必忧虑病情；病稍有好转后，勉强支撑到甘泉来与我相会。”于是病情好转，武帝便动身前往甘泉宫，病完全好了以后，又在专门供奉神灵的寿宫设酒宴。人们无法看见神君，只能听到他说话，声音和人的声音一样，他时来时去，来时风声肃然，停留在室中的帷帐里。神君说的话，武帝派人接受并记录下来，称作“画法”。他所说的内容，都是世俗之人早已知道的，没有什么特别奇异之处，但武帝心里独自喜欢；这件事很隐秘，世上没有人知道。","content_jianti_auto":"5天子病鼎湖甚，巫医无所不致，不愈。游水发根言上郡有巫，病而鬼神下之。上召置，祠之甘泉，及病，使人问神君，神君言曰：「天子无忧病；病少愈，强与我会甘泉。」于是病愈，遂起幸甘泉，病良已，置酒寿宫。神君非可得见，闻其言，言与人音等，时去时来，来则风肃然，居室帷中。神君所言，上使人受，书其言，命之曰「画法」。其所语，世俗之所知也，无绝殊者，而天子心独喜；其事秘，世莫知也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1600,"number":5,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"8fdd722c-db0e-11ef-8e49-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fdf65ac-db0e-11ef-bda2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：銜，含也；包含在心，以爲過也。復，扶又翻。","note_content_jianti_auto":"师古曰：衔，含也；包含在心，以为过也。复，扶又翻。","note_type":"hu_note","start_index":42,"tongjian_id":"8fdf65ab-db0e-11ef-9ada-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"右內史","official_note":"右內史是漢代京畿地區的行政長官，負責管理長安以西地區，此處指其轄區。","official_rank":"未知","source_snippet":"過右內史界中","start_index":12,"tongjian_id":"bb233203-eebc-4632-96b9-c45848228a7b"}],"ExtRef_Children_people":[{"link_death_year":-117,"link_td_description":"义纵，河东郡（今山西省）人，西汉酷吏。","link_td_id":"Q10001272","link_td_number_id":345923,"people_name":"義縱","people_name_jianti_auto":"义纵","people_xingming":"义纵","start_index":26,"tongjian_id":"8fdf65ae-db0e-11ef-a762-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","resolved_place_entity_id":648,"start_index":6,"tongjian_id":"8fdf65ad-db0e-11ef-90b6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/上官桀","excerpts":[{"context_after":"二人者，其始获罪一也，桀以一言之故超用，而纵及诛，可谓幸...","context_before":"...言未卒，泣数行下。上以为忠，由是亲近，至于受遗诏辅少主。","source_end_index":155,"source_paragraph_tongjian_id":"b37426eb-4eb7-4a1c-8d06-1d4f2a166d80","source_start_index":99,"source_text":"义纵为右内史，上幸鼎湖，病久，已而卒起，幸甘泉，道不治，上怒，曰：“纵以我为不行此道乎！”衔之，遂坐以它事弃市。"}],"path":"随笔/卷五/上官桀","source_name":"容斋随笔"}],"class_tags":["内政"],"content":"時上卒起，幸甘泉，過右內史界中，道多不治，上怒曰：「義縱以我爲不復行此道乎！」銜之。","content_fanyi":"当时汉武帝突然起驾前往甘泉宫，经过右内史辖区时，看到道路大多失修，皇上发怒说：“义纵以为我不会再走这条路了吗！”从此对义纵怀恨在心。","content_jianti_auto":"时上卒起，幸甘泉，过右内史界中，道多不治，上怒曰：「义纵以我为不复行此道乎！」衔之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1601,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"8fdf46dd-db0e-11ef-b62e-a0d3651f611f"}],"reign_name":"元狩五年","reign_name_jianti_auto":"元狩五年","start_index":0,"tongjian_id":"8fdd0cda-db0e-11ef-84aa-a0d3651f611f","year_anno":"（癸亥、前一一八）","year_int":-118},"message":"success","success":true}