ion_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"馬城縣，屬代郡。賢曰：搜神記：昔秦人築城於武周塞以備胡，將成而崩者數矣。有馬馳走周旋反覆，父老異之，因依以築城，城乃不崩，遂以名焉。其故城，則今之朔州也。余按續漢志，搜神記所云乃鴈門郡之馬邑，此乃代郡之馬城，賢誤。","note_content_jianti_auto":"马城县，属代郡。贤曰：搜神记：昔秦人筑城于武周塞以备胡，将成而崩者数矣。有马驰走周旋反复，父老异之，因依以筑城，城乃不崩，遂以名焉。其故城，则今之朔州也。余按续汉志，搜神记所云乃鴈门郡之马邑，此乃代郡之马城，贤误。","note_type":"hu_note","start_index":17,"tongjian_id":"95f9d902-db0e-11ef-917d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"軍事指揮","official_name":"度遼將軍","official_note":"度遼將軍是漢代設置的軍事職位，負責邊境防禦和征戰，尤其在北方邊疆對抗外族如鮮卑時發揮重要作用。在《資治通鑑》此段中，度遼將軍鄧遵率軍追擊鮮卑，顯示其軍事指揮職能。","official_rank":"未知","source_snippet":"度遼將軍鄧遵","start_index":20,"tongjian_id":"6f729a39-9a55-48b1-bccb-948c94f428cd"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"中郞將","official_note":"中郞將是漢代中級軍官，常負責禁軍或邊防任務，在《資治通鑑》此段中，中郞將馬續與度遼將軍鄧遵一同率南單于追擊鮮卑，體現其軍事協同作用。","official_rank":"未知","source_snippet":"中郞將馬續","start_index":26,"tongjian_id":"2a5f9bbd-64b8-4427-845b-1f11fc5f95bc"}],"ExtRef_Children_people":[{"link_death_year":121,"link_td_description":"邓遵，南阳郡新野县（今河南省新野县）人。东汉人物，邓禹之孙，和熹皇后邓绥、邓骘的从兄弟。","link_td_id":"Q10020274","link_td_number_id":6213073,"people_name":"鄧遵","people_name_jianti_auto":"邓遵","people_xingming":"邓遵","start_index":21,"tongjian_id":"95fc2309-db0e-11ef-9604-a0d3651f611f"},{"link_birth_year":70,"link_death_year":141,"link_td_description":"马续，东汉军事人物，马援侄孙，马融之兄，拜护羌都尉。","link_td_id":"Q10001627","link_td_number_id":225941,"people_name":"馬續","people_name_jianti_auto":"马续","people_xingming":"马续","start_index":27,"tongjian_id":"95fc230a-db0e-11ef-982d-a0d3651f611f"},{"people_name":"南單于","people_name_jianti_auto":"南单于","people_xingming":"挛鞮檀","start_index":30,"tongjian_id":"95fc230b-db0e-11ef-9fae-a0d3651f611f","wl_zhushi":"[挛鞮檀]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"鮮卑","place_name_jianti_auto":"鲜卑","resolved_place_entity_id":218,"start_index":6,"tongjian_id":"95fc2307-db0e-11ef-9c0a-a0d3651f611f"},{"place_name":"馬城","place_nam