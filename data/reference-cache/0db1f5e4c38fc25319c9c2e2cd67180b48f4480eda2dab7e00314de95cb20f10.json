6b66\u9042\u3001\u65b9\u57ce\u3002\u674e\u7267\u8005\uff0c\u8d99\u4e4b\u5317\u908a\u826f\u5c07\u4e5f\uff0c\u5617\u5c45\u4ee3\u3001\u9d08\u9580\u5099\u5308\u5974\uff0c\u4ee5\u4fbf\u5b9c\u7f6e\u540f\uff0c\u5e02\u79df\u7686\u8f38\u5165\u83ab\u5e9c\uff0c\u7232\u58eb\u5352\u8cbb\uff0c\u65e5\u64ca\u6578\u725b\u9957\u58eb\uff1b\u7fd2\u9a0e\u5c04\uff0c\u8b39\u70fd\u706b\uff0c\u591a\u9593\u8adc\uff0c\u7232\u7d04\u66f0\uff1a\u300c\u5308\u5974\u537d\u5165\u76dc\uff0c\u6025\u5165\u6536\u4fdd\u3002\u6709\u6562\u6355\u865c\u8005\u65ac\uff01\u300d\u5308\u5974\u6bcf\u5165\uff0c\u70fd\u706b\u8b39\uff0c\u8f12\u5165\u6536\u4fdd\u4e0d\u6230\u3002\u5982\u662f\u6578\u6b72\uff0c\u4ea6\u4e0d\u4ea1\u5931\u3002\u5308\u5974\u7686\u4ee5\u7232\u602f\uff0c\u96d6\u8d99\u908a\u5175\u4ea6\u4ee5\u7232\u543e\u5c07\u602f\u3002\u8d99\u738b\u8b93\u4e4b\uff0c\u674e\u7267\u5982\u6545\u3002\u738b\u6012\uff0c\u4f7f\u4ed6\u4eba\u4ee3\u4e4b\u3002\u6b72\u9918\uff0c\u5c62\u51fa\u6230\uff0c\u4e0d\u5229\uff0c\u591a\u5931\u4ea1\uff0c\u908a\u4e0d\u5f97\u7530\u755c\u3002\u738b\u5fa9\u8acb\u674e\u7267\uff0c\u674e\u7267\u675c\u9580\u7a31\u75c5\u4e0d\u51fa\u3002\u738b\u5f37\u8d77\u4e4b\uff0c\u674e\u7267\u66f0\uff1a\u300c\u5fc5\u6b32\u7528\u81e3\uff0c\u5982\u524d\uff0c\u4e43\u6562\u5949\u4ee4\u3002\u300d\u738b\u8a31\u4e4b\u3002\u674e\u7267\u81f3\u908a\uff0c\u5982\u7d04\u3002\u5308\u5974\u6578\u6b72\u7121\u6240\u5f97\uff0c\u7d42\u4ee5\u7232\u602f\u3002\u908a\u58eb\u65e5\u5f97\u8cde\u8cdc\u800c\u4e0d\u7528\uff0c\u7686\u9858\u4e00\u6230\u3002\u65bc\u662f\u4e43\u5177\u9078\u8eca\u5f97\u5343\u4e09\u767e\u4e58\uff0c\u9078\u9a0e\u5f97\u842c\u4e09\u5343\u5339\uff0c\u767e\u91d1\u4e4b\u58eb\u4e94\u842c\u4eba\uff0c\u5f40\u8005\u5341\u842c\u4eba\u3002\u6089\u52d2\u7fd2\u6230\uff1b\u5927\u7e31\u755c\u7267\u3001\u4eba\u6c11\u6eff\u91ce\u3002\u5308\u5974\u5c0f\u5165\uff0c\u4f6f\u5317\u4e0d\u52dd\uff0c\u4ee5\u6578\u5341\u4eba\u59d4\u4e4b\u3002\u55ae\u4e8e\u805e\u4e4b\uff0c\u5927\u7387\u8846\u4f86\u5165\u3002\u674e\u7267\u591a\u7232\u5947\u9673\uff0c\u5f35\u5de6\u3001\u53f3\u7ffc\u64ca\u4e4b\uff0c\u5927\u7834\u4e4b\uff0c\u6bba\u5308\u5974\u5341\u9918\u842c\u9a0e\u3002\u6ec5\u895c\u8964\uff0c\u7834\u6771\u80e1\uff0c\u964d\u6797\u80e1\u3002\u55ae\u4e8e\u5954\u8d70\uff0c\u5341\u9918\u6b72\u4e0d\u6562\u8fd1\u8d99\u908a\u3002","content_fanyi":"\u8d75\u738b\u4efb\u547d\u674e\u7267\u4e3a\u5c06\uff0c\u653b\u6253\u71d5\u56fd\uff0c\u593a\u53d6\u6b66\u9042\u3001\u65b9\u57ce\u3002\u674e\u7267\u662f\u8d75\u56fd\u5317\u90e8\u8fb9\u5883\u7684\u826f\u5c06\uff0c\u66fe\u9a7b\u5b88\u4ee3\u3001\u96c1\u95e8\u9632\u5907\u5308\u5974\uff1b\u4ed6\u6839\u636e\u5b9e\u9645\u60c5\u51b5\u81ea\u884c\u8bbe\u7f6e\u5b98\u540f\uff0c\u96c6\u5e02\u7a0e\u6536\u90fd\u9001\u5165\u5e55\u5e9c\uff0c\u4f5c\u4e3a\u58eb\u5175\u519b\u8d39\uff0c\u6bcf\u5929\u5bb0\u6740\u51e0\u5934\u725b\u7292\u8d4f\u58eb\u5175\uff1b\u8bad\u7ec3\u9a91\u9a6c\u5c04\u7bad\uff0c\u4e25\u5bc6\u5b88\u671b\u70fd\u706b\uff0c\u591a\u6d3e\u95f4\u8c0d\u6253\u63a2\u654c\u60c5\uff0c\u5e76\u4e0b\u4ee4\u8bf4\uff1a\u201c\u5308\u5974\u5982\u679c\u5165\u4fb5\u62a2\u63a0\uff0c\u7acb\u5373\u6536\u62e2\u4eba\u9a6c\u7269\u8d44\u9000\u5b88\u3002\u6709\u6562\u6355\u6349\u5308\u5974\u4fd8\u864f\u7684\uff0c\u5904\u65a9\uff01\u201d\u5308\u5974\u6bcf\u6b21\u5165\u4fb5\uff0c\u70fd\u706b\u62a5\u8b66\u90fd\u5f88\u4e25\u5bc6\uff0c\u519b\u961f\u5c31\u6536\u62e2\u4eba\u9a6c\u7269\u8d44\u9632\u5b88\uff0c\u4e0d\u4e0e\u5308\u5974\u4ea4\u6218\u3002\u8fd9\u6837\u8fc7\u4e86\u51e0\u5e74\uff0c\u4e5f\u6ca1\u6709\u4ec0\u4e48\u635f\u5931\u3002\u5308\u5974\u4eba\u90fd\u8ba4\u4e3a\u4ed6\u80c6\u602f\uff0c\u8fde\u8d75\u56fd\u8fb9\u5883\u58eb\u5175\u4e5f\u8ba4\u4e3a\u81ea\u5df1\u7684\u5c06\u519b\u80c6\u602f\u3002\u8d75\u738b\u8d23\u5907\u674e\u7267\uff0c\u674e\u7267\u8fd8\u662f\u7167\u65e7\u3002\u8d75\u738b\u5927\u6012\uff0c\u6d3e\u522b\u4eba\u53d6\u4ee3\u4ed6\u3002\u4e00\u5e74\u591a\u540e\uff0c\u65b0\u4efb\u5c06\u9886\u5c61\u6b21\u51fa\u6218\uff0c\u90fd\u4e0d\u987a\u5229\uff0c\u4f24\u4ea1\u635f\u5931\u5f88\u591a\uff0c\u8fb9\u5883\u65e0\u6cd5\u8015\u4f5c\u653e\u7267\u3002\u8d75\u738b\u518d\u6b21\u8bf7\u674e\u7267\u51fa\u4efb\uff0c\u674e\u7267\u95ed\u95e8\u79f0\u75c5\uff0c\u4e0d\u80af\u51fa\u6765\u3002\u8d75\u738b\u5f3a\u884c\u8d77\u7528\u4ed6\uff0c\u674e\u7267\u8bf4\uff1a\u201c\u5982\u679c\u4e00\u5b9a\u8981\u4efb\u7528\u6211\uff0c\u5fc5\u987b\u8ba9\u6211\u50cf\u4ee5\u524d\u90a3\u6837\u884c\u4e8b\uff0c\u6211\u624d\u6562\u63a5\u53d7\u547d\u4ee4\u3002\u201d\u8d75\u738b\u7b54\u5e94\u4e86\u4ed6\u3002\u674e\u7267\u5230\u8fbe\u8fb9\u5883\uff0c\u4ecd\u6309\u539f\u6765\u7684\u7ea6\u5b9a\u884c\u4e8b\u3002\u5308\u5974\u51e0\u5e74\u5185\u6beb\u65e0\u6536\u83b7\uff0c\u59cb\u7ec8\u8ba4\u4e3a\u4ed6\u80c6\u602f\u3002\u8fb9\u5883\u58eb\u5175\u6bcf\u5929\u5f97\u5230\u8d4f\u8d50\u5374\u65e0\u7528\u6b66\u4e4b\u5730\uff0c\u90fd\u76fc\u671b\u4e00\u6218\u3002\u4e8e\u662f\u674e\u7267\u51c6\u5907\u5e76\u6311\u9009\u6218\u8f66\uff0c\u5f97\u5230\u4e00\u5343\u4e09\u767e\u8f86\uff1b\u6311\u9009\u9a91\u5175\uff0c\u5f97\u5230\u4e00\u4e07\u4e09\u5343\u9a91\uff1b\u66fe\u83b7\u767e\u91d1\u8d4f\u8d50\u7684\u52c7\u58eb\u4e94\u4e07\u4eba\uff0c\u5584\u4e8e\u5c04\u7bad\u7684\u58eb\u5175\u5341\u4e07\u4eba\u3002\u5168\u90e8\u7ec4\u7ec7\u8d77\u6765\u8bad\u7ec3\u4f5c\u6218\uff1b\u53c8\u5927\u89c4\u6a21\u653e\u51fa\u7272\u755c\u548c\u767e\u59d3\uff0c\u904d\u5e03\u7530\u91ce\u3002\u5308\u5974\u5c0f\u80a1\u5165\u4fb5\u65f6\uff0c\u674e\u7267\u5047\u88c5\u6218\u8d25\uff0c\u628a\u6570\u5341\u4eba\u4e22\u7ed9\u4ed6\u4eec\u3002\u5355\u4e8e\u542c\u8bf4\u540e\uff0c\u7387\u9886\u5927\u519b\u524d\u6765\u5165\u4fb5\u3002\u674e\u7267\u5e03\u4e0b\u8bb8\u591a\u5947\u9635\uff0c\u5c55\u5f00\u5de6\u53f3\u4e24\u7ffc\u5939\u51fb\u5308\u5974\uff0c\u5927\u8d25\u654c\u519b\uff0c\u65a9\u6740\u5308\u5974\u5341\u591a\u4e07\u9a91\u5175\u3002\u706d\u6389\u895c\u8934\uff0c\u51fb\u7834\u4e1c\u80e1\uff0c\u6536\u964d\u6797\u80e1\u3002\u5355\u4e8e\u9003\u9041\uff0c\u5341\u591a\u5e74\u4e0d\u6562\u903c\u8fd1\u8d75\u56fd\u8fb9\u5883\u3002","content_jianti_auto":"3\u8d75\u738b\u4ee5\u674e\u7267\u4e3a\u5c06\uff0c\u4f10\u71d5\uff0c\u53d6\u6b66\u9042\u3001\u65b9\u57ce\u3002\u674e\u7267\u8005\uff0c\u8d75\u4e4b\u5317\u8fb9\u826f\u5c06\u4e5f\uff0c\u5c1d\u5c45\u4ee3\u3001\u9d08\u95e8\u5907\u5308\u5974\uff0c\u4ee5\u4fbf\u5b9c\u7f6e\u540f\uff0c\u5e02\u79df\u7686\u8f93\u5165\u83ab\u5e9c\uff0c\u4e3a\u58eb\u5352\u8d39\uff0c\u65e5\u51fb\u6570\u725b\u98e8\u58eb\uff1b\u4e60\u9a91\u5c04\uff0c\u8c28\u70fd\u706b\uff0c\u591a\u95f4\u8c0d\uff0c\u4e3a\u7ea6\u66f0\uff1a\u300c\u5308\u5974\u5373\u5165\u76d7\uff0c\u6025\u5165\u6536\u4fdd\u3002\u6709\u6562\u6355\u864f\u8005\u65a9\uff01\u300d\u5308\u5974\u6bcf\u5165\uff0c\u70fd\u706b\u8c28\uff0c\u8f84\u5165\u6536\u4fdd\u4e0d\u6218\u3002\u5982\u662f\u6570\u5c81\uff0c\u4ea6\u4e0d\u4ea1\u5931\u3002\u5308\u5974\u7686\u4ee5\u4e3a\u602f\uff0c\u867d\u8d75\u8fb9\u5175\u4ea6\u4ee5\u4e3a\u543e\u5c06\u602f\u3002\u8d75\u738b\u8ba9\u4e4b\uff0c\u674e\u7267\u5982\u6545\u3002\u738b\u6012\uff0c\u4f7f\u4ed6\u4eba\u4ee3\u4e4b\u3002\u5c81\u4f59\uff0c\u5c61\u51fa\u6218\uff0c\u4e0d\u5229\uff0c\u591a\u5931\u4ea1\uff0c\u8fb9\u4e0d\u5f97\u7530\u755c\u3002\u738b\u590d\u8bf7\u674e\u7267\uff0c\u674e\u7267\u675c\u95e8\u79f0\u75c5\u4e0d\u51fa\u3002\u738b\u5f3a\u8d77\u4e4b\uff0c\u674e\u7267\u66f0\uff1a\u300c\u5fc5\u6b32\u7528\u81e3\uff0c\u5982\u524d\uff0c\u4e43\u6562\u5949\u4ee4\u3002\u300d\u738b\u8bb8\u4e4b\u3002\u674e\u7267\u81f3\u8fb9\uff0c\u5982\u7ea6\u3002\u5308\u5974\u6570\u5c81\u65e0\u6240\u5f97\uff0c\u7ec8\u4ee5\u4e3a\u602f\u3002\u8fb9\u58eb\u65e5\u5f97\u8d4f\u8d50\u800c\u4e0d\u7528\uff0c\u7686\u613f\u4e00\u6218\u3002\u4e8e\u662f\u4e43\u5177\u9009\u8f66\u5f97\u5343\u4e09\u767e\u4e58\uff0c\u9009\u9a91\u5f97\u4e07\u4e09\u5343\u5339\uff0c\u767e\u91d1\u4e4b\u58eb\u4e94\u4e07\u4eba\uff0c\u5f40\u8005\u5341\u4e07\u4eba\u3002\u6089\u52d2\u4e60\u6218\uff1b\u5927\u7eb5\u755c\u7267\u3001\u4eba\u6c11\u6ee1\u91ce\u3002\u5308\u5974\u5c0f\u5165\uff0c\u4f6f\u5317\u4e0d\u80dc\uff0c\u4ee5\u6570\u5341\u4eba\u59d4\u4e4b\u3002\u5355\