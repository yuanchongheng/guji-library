":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"倍者，子錢倍於本錢。稱者，子本相侔也。稱，尺證翻。","note_content_jianti_auto":"倍者，子钱倍于本钱。称者，子本相侔也。称，尺证翻。","note_type":"hu_note","start_index":35,"tongjian_id":"c3ba263f-db0e-11ef-929b-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"節度使","official_note":"節度使是唐代地方军政长官，掌管一镇或数州的军事、行政和财政，此处指节度使多从禁军中选拔，反映了当时禁军势力的影响。","official_rank":"未知","source_snippet":"節度使多出禁軍","start_index":6,"tongjian_id":"a3b4a4c8-d945-4f62-87b4-6b65fafb21b4"},{"confidence":0.9,"official_category":"军事指挥","official_name":"禁軍大將","official_note":"禁军大将是禁军中的高级将领，负责宫廷和京城的防卫，此处指资历高的禁军大将通过借贷贿赂中尉以获取节度使职位。","official_rank":"未知","source_snippet":"其禁軍大將資高者","start_index":18,"tongjian_id":"77905b00-3da6-4857-8b0f-23d663f5fea4"},{"confidence":0.85,"official_category":"军事指挥","official_name":"中尉","official_note":"中尉在唐代通常指神策军中尉，是禁军的重要官职，掌握实权，此处指禁军大将贿赂中尉以谋取节度使职位。","official_rank":"未知","source_snippet":"以賂中尉","start_index":39,"tongjian_id":"3e000b3d-e4e0-44a8-99df-a53c733650bd"},{"confidence":0.8,"official_category":"中枢机构","official_name":"執政","official_note":"执政泛指朝廷中的高级官员或宰相，此处指节度使的任命不由朝廷执政官员决定，而是通过贿赂禁军势力获得。","official_rank":"未知","source_snippet":"未嘗由執政","start_index":56,"tongjian_id":"ea4370b2-e0d7-45f9-84de-1038c9e471af"}],"ExtRef_Children_people":[{"link_death_year":827,"link_td_description":"王沛，许州许昌县（今河南省许昌市）人，唐朝大臣。","link_td_id":"Q10022652","link_td_number_id":7895383,"people_name":"沛","people_name_jianti_auto":"沛","people_xingming":"王沛","start_index":68,"tongjian_id":"c3ba2642-db0e-11ef-a83e-a0d3651f611f"},{"link_birth_year":765,"link_death_year":839,"link_td_description":"裴度，字中立，河东闻喜县人，出自河东裴氏东眷裴。中晚唐时宪宗、穆宗、敬宗、文宗四朝重臣，官至中书令。","link_td_id":"Q10008124","link_td_number_id":103758,"people_name":"裴度","people_name_jianti_auto":"裴度","people_xingming":"裴度","start_index":71,"tongjian_id":"c3ba2643-db0e-11ef-87bb-a0d3651f611f"},{"people_name":"韋處厚","people_name_jianti_auto":"韦处厚","people_xingming":"韦处厚","start_index":74,"tongjian_id":"c3ba2644-db0e-11ef-9c77-a0d3651f611f"},{"link_death_year":834,"link_td_description":"高瑀，出身渤海高氏，唐朝官员。","link_td_id":"Q10022651","link_td_number_id":7894513,"people_name":"瑀","people_name_jianti_auto":"瑀","people_xingming":"高瑀","start_index":80,"tongjian_id":"c3ba2645-db0e-11ef-8f41-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","人事"],"content":"自大曆以來，節度使多出禁軍，其禁軍大將資高者，皆以倍稱之息貸錢於富室，以賂中尉，動踰億萬，然後得之，未嘗由執政；至鎭，則重斂以償所負。及沛薨，裴度、韋處厚始奏以瑀代之。中外相賀曰：「自今債帥鮮矣！」","content_fanyi":"自从唐代宗大历年间以来，藩镇节度使大多出自禁军，禁军中资历、声望较高的大将，都以加倍的利息向富室借钱，用来贿赂神策军护军中尉，动辄超过亿万钱，然后才能得到节度使的职位，从不曾经由宰相荐举；等到了藩镇，便加重征收赋税来偿还所欠的债务。等到王沛去世，裴度、韦处厚才奏请由高瑀接替。朝廷内外官员相互庆贺说：“从今以后，欠债的节帅就少了！”","content_jianti_auto":"自大历以来，节度使多出禁军，其禁军大将资高者，皆以倍称之息贷钱于富室，以赂中尉，动逾亿万，然后得之，未尝由执政；至镇，则重敛以偿所负。及沛薨，裴度、韦处厚始奏以瑀代之。中外相贺曰：「自今债帅鲜矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":24696,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"c3ba263e-db0e-11ef-9414-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"天平節度使","official_note":"天平節度使是唐代地方军事和行政长官，掌管天平军辖区，此处表示乌重胤原任此职，后被调任。","official_rank":"未知","source_snippet":"以天平節度使烏重胤爲橫海節度使","start_index":8,"tongjian_id":"a4dbb973-cded-4b41-ae6a-5dac5ab9d06c"},{"confidence":0.95,"official_category":"地方行政","official_name":"橫海節度使","official_note":"橫海節度使是唐代地方军事和行政长官，掌管横海军辖区，此处表示乌重胤被任命为此职。","official_rank":"未知","source_snippet":"以天平節度使烏重胤爲橫海節度使","start_index":18,"tongjian_id":"f54a9320-9c43-4b89-8c2c-3b74dcef2ac7"},{"confidence":0.95,"official_category":"地方行政","offic