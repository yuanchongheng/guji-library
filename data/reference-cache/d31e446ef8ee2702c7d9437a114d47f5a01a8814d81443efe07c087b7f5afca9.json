{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（乙丑、前二九六）","note_content_jianti_auto":"（乙丑、前二九六）","note_type":"hu_note","start_index":0,"tongjian_id":"8c9b04df-db0e-11ef-8e73-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-355,"link_death_year":-296,"link_td_description":"楚怀王，芈姓，熊氏，名槐，楚国君主。父为楚威王，怀王任用佞臣令尹子兰、上官大夫靳尚，宠爱郑袖，为人利令智昏，国事日非。最后被秦昭襄王所骗，监禁于秦国至死，楚人皆悲之。","link_td_id":"Q10000652","link_td_number_id":335220,"people_name":"楚懷王","people_name_jianti_auto":"楚怀王","people_xingming":"芈槐","start_index":1,"tongjian_id":"8c9b04e2-db0e-11ef-a956-a0d3651f611f","wl_zhushi":"[芈槐]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":9,"tongjian_id":"8c9b04e3-db0e-11ef-a83d-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":11,"tongjian_id":"8c9b04e4-db0e-11ef-8609-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":17,"tongjian_id":"8c9b04e5-db0e-11ef-9fec-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":34,"tongjian_id":"8c9b04e6-db0e-11ef-8ba0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"容斋随笔/战国自取亡","excerpts":[{"context_after":"。赵以上党之地，代韩受兵，利令智昏，轻用民死，同日坑于长...","context_before":"...王贪商於六百里，受诈张仪，失其名都，丧其甲士，不能取偿，","source_end_index":315,"source_paragraph_tongjian_id":"1509ccdd-dd12-435e-a66e-d1a5b3