an_id":"95112874-db0e-11ef-87c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2夏，四月，戊子，赦天下。","content_fanyi":"夏季，四月二十四日戊子，大赦天下。","content_jianti_auto":"2夏，四月，戊子，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3580,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"95112879-db0e-11ef-9421-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":18,"source_start_index":15,"source_text":"註見上","target_paragraph_tongjian_id":"94fc7460-db0e-11ef-b0e3-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9511287c-db0e-11ef-a646-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：校，學也，戶敎翻。雅樂，註見上。","note_content_jianti_auto":"贤曰：校，学也，户教翻。雅乐，注见上。","note_type":"hu_note","start_index":21,"tongjian_id":"9511287b-db0e-11ef-96ba-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭玄","people_name_jianti_auto":"郑玄","start_index":0,"tongjian_id":"9511287e-db0e-11ef-abba-a0d3651f611f"},{"people_name":"鄭衆","people_name_jianti_auto":"郑众","start_index":19,"tongjian_id":"9511287f-db0e-11ef-a250-a0d3651f611f"},{"people_name":"暴辛公","people_name_jianti_auto":"暴辛公","start_index":31,"tongjian_id":"95112880-db0e-11ef-909f-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":51,"tongjian_id":"95112881-db0e-11ef-aebb-a0d3651f611f"},{"people_name":"孫炎","people_name_jianti_auto":"孙炎","start_index":93,"tongjian_id":"95112882-db0e-11ef-9a7b-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":104,"tongjian_id":"95112883-db0e-11ef-b3d5-a0d3651f611f"},{"people_name":"李巡","people_name_jianti_auto":"李巡","start_index":150,"tongjian_id":"95112884-db0e-11ef-8552-a0d3651f611f"},{"people_name":"郭璞","people_name_jianti_auto":"郭璞","start_index":163,"tongjian_id":"95112885-db0e-11ef-a663-a0d3651f611f"},{"people_name":"鄭司農","people_name_jianti_auto":"郑司农","start_index":208,"tongjian_id":"95112886-db0e-11ef-b0d1-a0d3651f611f"},{"people_name":"暴辛公","people_name_jianti_auto":"暴辛公","start_index":236,"tongjian_id":"95112887-db0e-11ef-ad8f-a0d3651f611f"},{"people_name":"蘇成公","people_name_jianti_auto":"苏成公","start_index":242,"tongjian_id":"95112888-db0e-11ef-b41c-a0d3651f611f"},{"people_name":"譙周","people_name_jianti_auto":"谯周","start_index":248,"tongjian_id":"95112889-db0e-11ef-9c12-a0d3651f611f"},{"people_name":"周幽王","people_name_jianti_auto":"周幽王","start_index":264,"tongjian_id":"9511288a-db0e-11ef-9450-a0d3651f611f"},{"people_name":"暴辛公","people_name_jianti_auto":"暴辛公","start_index":269,"tongjian_id":"9511288b-db0e-11ef-a21f-a0d3651f611f"},{"people_name":"蘇成公","people_name_jianti_auto":"苏成公","start_index":275,"tongjian_id":"9511288c-db0e-11ef-bd07-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄭玄註周禮云：塤，燒土爲之，大如鴈子。鄭衆云：有六孔。世本曰：暴辛公作篪，以竹爲之，長尺四寸，有八孔。孔穎達曰：土曰壎，竹曰篪。周禮小師職作「塤」，古今字異耳。釋樂云：大塤謂之嘂，音叫。孫炎曰：音大如叫呼也。郭璞曰：塤，燒土爲之，大如鵝子，銳上平底，形似稱鎚，六孔；小者如雞子。釋樂又云：大篪謂之沂。李巡曰：大篪，其聲非一也。郭璞曰：篪以竹爲之，長尺四寸，圍三寸，一孔上出，逕三分，橫吹之，小者尺二寸。廣雅云：八孔。鄭司農小師註云：篪七孔，蓋不數其上出者，故七也。世本云：暴辛公作塤，蘇成公作篪。譙周古史考云：古有塤、篪，尚矣。周幽王時，暴辛公善塤，蘇成公善篪，記者因以爲作，繆矣。釋名：塤，喧也，聲濁喧然。塤，況袁翻。篪，音池。和，戶臥翻。","note_content_jianti_auto":"郑玄注周礼云：埙，烧土为之，大如鴈子。郑众云：有六孔。世本曰：暴辛公作篪，以竹为之，长尺四寸，有八孔。孔颖达曰：土曰埙，竹曰篪。周礼小师职作「埙」，古今字异耳。释乐云：大埙谓之嘂，音叫。孙炎曰：音大如叫呼也。郭璞曰：埙，烧土为之，大如鹅子，锐上平底，形似称锤，六孔；小者如鸡子。释乐又云：大篪谓之沂。李巡曰：大篪，其声非一也。郭璞曰：篪以竹为之，长尺四寸，围三寸，一孔上出，迳三分，横吹之，小者尺二寸。广雅云：八孔。郑司农小师注云：篪七孔，盖不数其上出者，故七也。世本云：暴辛公作埙，苏成公作篪。谯周古史考云：古有埙、篪，尚矣。周幽王时，暴辛公善埙，苏成公善篪，记者因以为作，缪矣。释名：埙，喧也，声浊喧然。埙，况袁翻。篪，音池。和，户卧翻。","note_type":"hu_note","start_index":38,"tongjian_id":"9511287d-db0e-11ef-9953-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.85,"official_category":"文教","official_name":"校官","official_note":"校官在汉代通常指负责教育或学校管理的官员，如太学中的校官，此处可能指地方学校的官员，用于召集弟子演奏雅乐以娱乐嘉宾。","official_rank":"未知","source_snippet":"召校官弟子作雅樂","start_index":12,"tongjian_id":"136cac79-73bd-4891-bc0c-86442f7233e5"}],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9511287a-db0e-11ef-9874-a0d3651f611f","pinyin":"xūn","source_anchor_text":"鳴帝自奏塤篪和之以","source_key":"baiyang_epub","start_index":28,"text":"塤","tongjian_id":"03c36669-c30d-5245-a141-6c8b5085e9a6"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9511287a-db0e-11ef-9874-a0d3651f611f","pinyin":"chí","source_anchor_text":"帝自奏塤篪和之以娛","source_key":"baiyang_epub","start_index":29,"text":"篪","tongjian_id":"6abd3fcb-49eb-5370-9d67-1b2270c804e0"}],"ExtRef_Children_places":[{"place_name":"南陽","place_name_jianti_auto":"南阳","resolved_place_entity_id":235,"start_index":9,"tongjian_id":"95112897-db0e-11ef-b82e-a0d3651f611f"},{"place_name":"南頓","place_name_jianti_auto":"南顿","resolved_place_entity_id":1680,"start_index":41,"tongjian_id":"95112899-db0e-11ef-8653-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3閏月，甲午，上幸南陽，召校官弟子作雅樂，奏鹿鳴，帝自奏塤篪和之，以娛嘉賓。還，幸南頓。冬，十二月，甲午，還宮。","content_fanyi":"闰十月初三日甲午，汉明帝巡幸南阳，召见学官弟子演奏雅乐，奏《鹿鸣》，明帝亲自吹奏埙、篪相和，用来娱乐嘉宾。返回途中，又亲临南顿县。冬季，十二月初四日甲午，回到宫中。","content_jianti_auto":"3闰月，甲午，上幸南阳，召校官弟子作雅乐，奏鹿鸣，帝自奏埙篪和之，以娱嘉宾。还，幸南顿。冬，十二月，甲午，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3581,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9511287a-db0e-11ef-9874-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"陵陽縣","place_name_jianti_auto":"陵阳县","start_index":0,"tongjian_id":"9511289c-db0e-11ef-9094-a0d3651f611f"},{"place_name":"丹陽郡","place_name_jianti_auto":"丹阳郡","start_index":5,"tongjian_id":"9511289d-db0e-11ef-b7d7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陵陽縣，屬丹陽郡。綝，丑林翻。","note_content_jianti_auto":"陵阳县，属丹阳郡。𬘭，丑林翻。","note_type":"hu_note","start_index":10,"tongjian_id":"9511289b-db0e-11ef-a85b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"東海郡","place_name_jianti_auto":"东海郡","start_index":0,"tongjian_id":"951128a0-db0e-11ef-85b8-a0d3651f611f"},{"place_name":"雒陽","place_name_jianti_auto":"雒阳","start_index":5,"tongjian_id":"951128a1-db0e-11ef-918f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"東海郡，在雒陽東一千五百里。","note_content_jianti_auto":"东海郡，在雒阳东一千五百里。","note_type":"hu_note","start_index":56,"tongjian_id":"9511289f-db0e-11ef-ada3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"951128a3-db0e-11ef-b453-a0d3651f611f"},{"people_name":"伯夷","people_name_jianti_auto":"伯夷","start_index":3,"tongjian_id":"951128a4-db0e-11ef-8aa7-a0d3651f611f"},{"people_name":"孤竹君","people_name_jianti_auto":"孤竹君","start_index":6,"tongjian_id":"951128a5-db0e-11ef-8ee7-a0d3651f611f"},{"people_name":"叔齊","people_name_jianti_auto":"叔齐","start_index":15,"tongjian_id":"951128a6-db0e-11ef-b8cf-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":18,"tongjian_id":"951128a7-db0e-11ef-8026-a0d3651f611f"},{"people_name":"吳王","people_name_jianti_auto":"吴王","start_index":21,"tongjian_id":"951128a8-db0e-11ef-8594-a0d3651f611f"},{"people_name":"壽夢","people_name_jianti_auto":"寿梦","start_index":23,"tongjian_id":"951128a9-db0e-11ef-8db2-a0d3651f611f"},{"people_name":"季子","people_name_jianti_auto":"季子","start_index":37,"tongjian_id":"951128aa-db0e-11ef-94b0-a0d3651f611f"},{"people_name":"伯夷","people_name_jianti_auto":"伯夷","start_index":58,"tongjian_id":"951128ab-db0e-11ef-a9a2-a0d3651f611f"},{"people_name":"紂","people_name_jianti_auto":"纣","start_index":61,"tongjian_id":"951128ac-db0e-11ef-bb94-a0d3651f611f"},{"people_name":"季札","people_name_jianti_auto":"季札","start_index":64,"tongjian_id":"951128ad-db0e-11ef-a079-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":67,"tongjian_id":"951128ae-db0e-11ef-a9d2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：伯夷，孤竹君之子，讓其弟叔齊。季札，吳王壽夢之季子也，諸兄欲讓以國，季子乃舍其室而耕。皆是權時所行，非常道也。伯夷當紂時，季札當周末，故言亂世也。","note_content_jianti_auto":"贤曰：伯夷，孤竹君之子，让其弟叔齐。季札，吴王寿梦之季子也，诸兄欲让以国，季子乃舍其室而耕。皆是权时所行，非常道也。伯夷当纣时，季札当周末，故言乱世也。","note_type":"hu_note","start_index":80,"tongjian_id":"951128a2-db0e-11ef-9bb6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"衞靈公","people_name_jianti_auto":"衞灵公","start_index":3,"tongjian_id":"951128b0-db0e-11ef-8296-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":9,"tongjian_id":"951128b1-db0e-11ef-b18c-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":13,"tongjian_id":"951128b2-db0e-11ef-bba0-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":16,"tongjian_id":"951128b3-db0e-11ef-a2f9-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":25,"tongjian_id":"951128b4-db0e-11ef-88dc-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":28,"tongjian_id":"951128b5-db0e-11ef-a040-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":39,"tongjian_id":"951128b6-db0e-11ef-940e-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":43,"tongjian_id":"951128b7-db0e-11ef-aa38-a0d3651f611f"},{"people_name":"蒯聵","people_name_jianti_auto":"蒯聩","start_index":45,"tongjian_id":"951128b8-db0e-11ef-a827-a0d3651f611f"},{"people_name":"靈公","people_name_jianti_auto":"灵公","start_index":50,"tongjian_id":"951128b9-db0e-11ef-871b-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":56,"tongjian_id":"951128ba-db0e-11ef-93ac-a0d3651f611f"},{"people_name":"輒","people_name_jianti_auto":"辄","start_index":60,"tongjian_id":"951128bb-db0e-11ef-8c6a-a0d3651f611f"},{"people_name":"駿","people_name_jianti_auto":"骏","start_index":92,"tongjian_id":"951128bc-db0e-11ef-ab11-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"春秋：衞靈公卒，孫輒立，父蒯聵與輒爭國。公羊傳曰：輒者，蒯聵之子。然則曷爲不立蒯聵而立輒？蒯聵無道，靈公遂之而立輒。然則輒之義可以立乎？曰：可，不以父命辭於王父命，不以家事辭於王事。故駿引以爲言。","note_content_jianti_auto":"春秋：衞灵公卒，孙辄立，父蒯聩与辄争国。公羊传曰：辄者，蒯聩之子。然则曷为不立蒯聩而立辄？蒯聩无道，灵公遂之而立辄。然则辄之义可以立乎？曰：可，不以父命辞于王父命，不以家事辞于王事。故骏引以为言。","note_type":"hu_note","start_index":93,"tongjian_id":"951128af-db0e-11ef-bfa9-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢近臣","official_name":"侍中","official_note":"侍中是汉代中枢官职，掌管宫廷诏命和顾问，此处表示丁鸿被皇帝征召担任此职，以表彰其经学品行。","official_rank":"正三品","source_snippet":"上徵鴻爲侍中","start_index":130,"tongjian_id":"ab8b25eb-ff11-420f-b2f1-88b0096b364e"}],"ExtRef_Children_people":[{"link_td_description":"丁綝，字幼春，豫州颍川郡定陵