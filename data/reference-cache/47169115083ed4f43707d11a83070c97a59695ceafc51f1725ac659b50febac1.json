1ef-b592-a0d3651f611f"},{"place_name":"絳州","place_name_jianti_auto":"绛州","start_index":60,"tongjian_id":"8c438047-db0e-11ef-bc36-a0d3651f611f"},{"place_name":"龍門縣","place_name_jianti_auto":"龙门县","start_index":62,"tongjian_id":"8c438048-db0e-11ef-80d9-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，汾陰縣屬河東郡。皮氏縣，故耿國，晉獻公以封趙夙者也，亦屬河東郡。括地志：汾陰故城，在蒲州汾陰縣北九里，皮氏故城，在絳州龍門縣西百八十步。","note_content_jianti_auto":"班志，汾阴县属河东郡。皮氏县，故耿国，晋献公以封赵夙者也，亦属河东郡。括地志：汾阴故城，在蒲州汾阴县北九里，皮氏故城，在绛州龙门县西百八十步。","note_type":"hu_note","start_index":15,"tongjian_id":"8c43803a-db0e-11ef-88de-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","place_note":"山西万荣西南榮河镇","resolved_place_entity_id":1244,"start_index":9,"tongjian_id":"8c43804e-db0e-11ef-aa2e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"1秦伐魏，渡河，取汾陰、皮氏，拔焦。","content_fanyi":"秦军进攻魏国，渡过黄河，夺取汾阴、皮氏两城，进而攻克焦邑。","content_jianti_auto":"1秦伐魏，渡河，取汾阴、皮氏，拔焦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":201,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 四十年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c438039-db0e-11ef-ba20-a0d3651f611f","year_int":-329},"tongjian_id":"8c438039-db0e-11ef-ba20-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":25,"tongjian_id":"8f081260-db0e-11ef-83d0-a0d3651f611f"},{"people_name":"鄭","people_name_jianti_auto":"郑","start_index":178,"tongjian_id":"8f081261-db0e-11ef-8fac-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"8f081262-db0e-11ef-b4e4-a0d3651f611f"},{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":54,"tongjian_id":"8f081263-db0e-11ef-8e00-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢律：三人無故羣飲，罰金四兩。今詔橫賜得會聚飲食。師古曰：酺，布也；言王德布於天下而合聚飲食爲酺。周禮族師：春秋祭酺。註：酺者，爲人烖害之神也。有馬酺，有蝝螟之酺與人鬼之酺，亦爲壇位如雩禜。族長無飲酒之禮，因祭酺而與其民以長幼相獻酬焉。正義曰：古者祭酺，聚錢飲酒，故後世聽民聚飲，皆謂之酺。漢書，每有嘉慶，令民大酺，是其事也。彼註云因祭酺而與其民長幼相酬，鄭註所謂祭酺，合醵也。酺，音蒲。","note_content_jianti_auto":"汉律：三人无故群饮，罚金四两。今诏横赐得会聚饮食。师古曰：酺，布也；言王德布于天下而合聚饮食为酺。周礼族师：春秋祭酺。注：酺者，为人烖害之神也。有马酺，有蝝螟之酺与人鬼之酺，亦为坛位如雩禜。族长无饮酒之礼，因祭酺而与其民以长幼相献酬焉。正义曰：古者祭酺，聚钱饮酒，故后世听民聚饮，皆谓之酺。汉书，每有嘉庆，令民大酺，是其事也。彼注云因祭酺而与其民长幼相酬，郑注所谓祭酺，合醵也。酺，音蒲。","note_type":"hu_note","start_index":98,"tongjian_id":"8f08125f-db0e-11ef-9d8a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8f08126b-db0e-11ef-9623-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":11,"tongjian_id":"8f08126c-db0e-11ef-9629-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":24,"tongjian_id":"8f08126d-db0e-11ef-972e-a0d3651f611f"},{"people_name":"少康","people_name_jianti_auto":"少康","start_index":40,"tongjian_id":"8f08126e-db0e-11ef-8f2f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汾陰縣","place_name_jianti_auto":"汾阴县","start_index":3,"tongjian_id":"8f08126f-db0e-11ef-a2d8-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":7,"tongjian_id":"8f081270-db0e-11ef-93f3-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":20,"tongjian_id":"8f081271-db0e-11ef-96dd-a0d3651f611f"},{"place_name":"蒲州","place_name_jianti_auto":"蒲州","start_index":28,"tongjian_id":"8f081272-db0e-11ef-9dea-a0d3651f611f"},{"place_name":"寶鼎縣","place_name_jianti_auto":"宝鼎县","start_index":30,"tongjian_id":"8f081273-db0e-11ef-ab6a-a0d3651f611f"},{"place_name":"綸氏","place_name_jianti_auto":"纶氏","start_index":35,"tongjian_id":"8f081274-db0e-11ef-bdf6-a0d3651f611f"},{"place_name":"夏","place_name_jianti_auto":"夏","start_index":39,"tongjian_id":"8f081275-db0e-11ef-a699-a0d3651f611f"},{"place_name":"汾水","place_name_jianti_auto":"汾水","start_index":46,"tongjian_id":"8f081276-db0e-11ef-874b-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":53,"tongjian_id":"8f081277-db0e-11ef-97e5-a0d3651f611f"},{"place_name":"汾陰縣","place_name_jianti_auto":"汾阴县","start_index":55,"tongjian_id":"8f081278-db0e-11ef-b3fc-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":65,"tongjian_id":"8f081279-db0e-11ef-bcaf-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，汾陰縣屬河東郡。師古曰：直，謂正當汾陰也。宋白曰：蒲州寶鼎縣，古綸氏地，夏少康所邑也。汾水南流過縣，漢置汾陰縣，今縣北九十里汾陰故城是也。","note_content_jianti_auto":"班志，汾阴县属河东郡。师古曰：直，谓正当汾阴也。宋白曰：蒲州宝鼎县，古纶氏地，夏少康所邑也。汾水南流过县，汉置汾阴县，今县北九十里汾阴故城是也。","note_type":"hu_note","start_index":131,"tongjian_id":"8f08126a-db0e-11ef-b9a8-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","place_note":"山西萬榮西南荣河镇","resolved_place_entity_id":1244,"start_index":123,"tongjian_id":"8f081285-db0e-11ef-8a5e-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":155,"tongjian_id":"8f081287-db0e-11ef-9b1c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"3秋，九月，新垣平使人持玉杯上書闕下獻之。平言上曰：「闕下有寶玉氣來者。」已，視之，果有獻玉杯者，刻曰「人主延壽」。平又言：「臣候日再中。」居頃之，日卻，復中。於是始更以十七年爲元年，令天下大酺。平言曰：「周鼎亡在泗水中。今河決，通於泗，臣望東北汾陰直有金寶氣，意周鼎其出乎！兆見，不迎則不至。」於是上使使治廟汾陰，南臨河，欲祠出周鼎。","content_fanyi":"秋季，九月，新垣平指使人带着玉杯到皇宫门前上书，将玉杯献给汉文帝刘恒。新垣平对汉文帝说：“宫门前移来一股宝玉之气。”过了一会儿，前去察看，果然有来献玉杯的人，杯上刻着“人主延寿”四字。新垣平又说：“我推算今天太阳会再次出现在中天。”过了不久，太阳向东退行，再次到达中天。于是，汉文帝开始把在位的第十七年改称元年，并下令特许天下人聚会痛饮，以示庆贺。新垣平说：“周朝的大鼎沉没在泗水中。如今黄河决口，与泗水连通，我看东北方正对着汾阴有金宝之气，心想周鼎恐怕要出世了吧！征兆已经显现，若不去迎接，它就不会到来。”于是，汉文帝派使者在汾阴修建祠庙，庙南靠近黄河，想通过祭祀求得周鼎出世。","content_jianti_auto":"3秋，九月，新垣平使人持玉杯上书阙下献之。平言上曰：「阙下有宝玉气来者。」已，视之，果有献玉杯者，刻曰「人主延寿」。平又言：「臣候日再中。」居顷之，日却，复中。于是始更以十七年为元年，令天下大酺。平言曰：「周鼎亡在泗水中。今河决，通于泗，臣望东北汾阴直有金宝气，意周鼎其出乎！兆见，不迎则不至。」于是上使使治庙汾阴，南临河，欲祠出周鼎。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1202,"number":3,"path":"资治通鉴 : 卷第十五 (漢紀七) / 太宗孝文皇帝下 / 十六年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"8f08125d-db0e-11ef-9df1-a0d3651f611f","year_int":-164},"tongjian_id":"8f08125d-db0e-11ef-9df1-a0d3651f611f"},"paragraph_order":2},{"mention_count":2,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8feaf956-db0e-11ef-bc82-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：答，對也。郊天而不祀地，失對偶之義。一曰：闕地祇之祀，不爲神所答應。","note_content_jianti_auto":"师古曰：答，对也。郊天而不祀地，失对偶之义。一曰：阙地祇之祀，不为神所答应。","note_type":"hu_note","start_index":39,"tongjian_id":"8feaf955-db0e-11ef-93db-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"后土","people_name_jianti_auto":"后土","start_index":8,"tongjian_id":"8feaf958-db0e-11ef-8ca5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"郊祀志：有司議祠后土宜於澤中圜丘，爲五壇。","note_content_jianti_auto":"郊祀志：有司议祠后土宜于泽中圜丘，为五坛。","note_type":"hu_note","start_index":56,"tongjian_id":"8feaf957-db0e-11ef-a904-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8feaf95b-db0e-11ef-82e1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"夏陽縣","place_name_jianti_auto":"夏阳县","start_index":3,"tongjian_id":"8feaf95c-db0e-11ef-9738-a0d3651f611f"},{"place_name":"左馮翊","place_name_jianti_auto":"左冯翊","start_index":7,"tongjian_id":"8feaf95d-db0e-11ef-8e01-a0d3651f611f"},{"place_name":"汾陰縣","place_name_jianti_auto":"汾阴县","start_index":11,"tongjian_id":"8feaf95e-db0e-11ef-8efb-a0d3651f611f"},{"place_name":"河東郡","place_name_jianti_auto":"河东郡","start_index":15,"tongjian_id":"8feaf95f-db0e-11ef-970a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，夏陽縣屬左馮翊；汾陰縣屬河東郡。","note_content_jianti_auto":"班志，夏阳县属左冯翊；汾阴县属河东郡。","note_type":"hu_note","start_index":66,"tongjian_id":"8feaf95a-db0e-11ef-b5fb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"不意天子行幸至郡，供具不能備也。","note_content_jianti_auto":"不意天子行幸至郡，供具不能备也。","note_type":"hu_note","start_index":91,"tongjian_id":"8feaf961-db0e-11ef-a56a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"8feb5b32-db0e-11ef-ab80-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":57,"tongjian_id":"8feb5b33-db0e-11ef-bb0e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"河","place_name_jianti_auto":"河","start_index":7,"tongjian_id":"8feb5b34-db0e-11ef-b696-a0d3651f611f"},{"place_name":"汾陰縣","place_name_jianti_auto":"汾阴县","start_index":30,"tongjian_id":"8feb5b35-db0e-11ef-b4fe-a0d3651f611f"},{"place_name":"后土祠","place_name_jianti_auto":"后土祠","start_index":38,"tongjian_id":"8feb5b36-db0e-11ef-8d2c-a0d3651f611f"},{"place_name":"汾","place_name_jianti_auto":"汾","start_index":45,"tongjian_id":"8feb5b37-db0e-11ef-994d-a0d3651f611f"},{"place_name":"河","place_name_jianti_auto":"河","start_index":54,"tongjian_id":"8feb5b38-db0e-11ef-bec7-a0d3651f611f"},{"place_name":"汾水","place_name_jianti_auto":"汾水","start_index":85,"tongjian_id":"8feb5b39-db0e-11ef-a826-a0d3651f611f"},{"place_name":"鄈","place_name_jianti_auto":"鄈","start_index":93,"tongjian_id":"8feb5b3a-db0e-11ef-b710-a0d3651f611f"},{"place_name":"鄈上","place_name_jianti_auto":"鄈上","start_index":122,"tongjian_id":"8feb5b3b-db0e-11ef-a799-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：脽者，河之東岸特堆堀，長四五里，廣二里餘，高十餘丈。汾陰縣治脽之上；后土祠在縣西。汾在脽之北，西流與河合。師古曰：脽者，以其形高起，如人尻脽，故以名云。一說，此臨汾水之上，地本名鄈，音與葵同，彼鄕人呼葵音如誰，故轉而爲脽字耳。故漢舊儀曰鄈上。脽，音誰。","note_content_jianti_auto":"如淳曰：脽者，河之东岸特堆堀，长四五里，广二里余，高十余丈。汾阴县治脽之上；后土祠在县西。汾在脽之北，西流与河合。师古曰：脽者，以其形高起，如人尻脽，故以名云。一说，此临汾水之上，地本名鄈，音与葵同，彼鄕人呼葵音如谁，故转而为脽字耳。故汉旧仪曰鄈上。脽，音谁。","note_type":"hu_note","start_index":108,"tongjian_id":"8feaf962-db0e-11ef-81b7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班","people_name_jianti_auto":"班","start_index":0,"tongjian_id":"8feb5b3e-db0e-11ef-b1dc-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"滎陽","place_name_jianti_auto":"荥阳","place_note":"河南荥阳","start_index":3,"tongjian_id":"8feb5b3f-db0e-11ef-856b-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":6,"tongjian_id":"8feb5b40-db0e-11ef-8e6f-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":10,"tongjian_id":"8feb5b41-db0e-11ef-9b78-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班志，滎陽、洛陽並屬河南郡。","note_content_jianti_auto":"班志，荥阳、洛阳并属河南郡。","note_type":"hu_note","start_index":132,"tongjian_id":"8feb5b3d-db0e-11ef-b375-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"臣瓚","people_name_jianti_auto":"臣瓒","start_index":0,"tongjian_id":"8feb5b44-db0e-11ef-b246-a0d3651f611f"},{"people_name":"文子","people_name_jianti_auto":"文子","start_index":12,"tongjian_id":"8feb5b45-db0e-11ef-91e5-a0d3651f611f"},{"people_name":"子南彌牟","people_name_jianti_auto":"子南弥牟","start_index":15,"tongjian_id":"8feb5b46-db0e-11ef-bee7-a0d3651f611f"},{"people_name":"子南固","people_name_jianti_auto":"子南固","start_index":23,"tongjian_id":"8feb5b47-db0e-11ef-9cf2-a0d3651f611f"},{"people_name":"子南勁","people_name_jianti_auto":"子南劲","start_index":27,"tongjian_id":"8feb5b48-db0e-11ef-8108-a0d3651f611f"},{"people_name":"勁","people_name_jianti_auto":"劲","start_index":34,"tongjian_id":"8feb5b49-db0e-11ef-ac70-a0d3651f611f"},{"people_name":"惠成王","people_name_jianti_auto":"惠成王","start_index":40,"tongjian_id":"8feb5b4a-db0e-11ef-9063-a0d3651f611f"},{"people_name":"子南","people_name_jianti_auto":"子南","start_index":47,"tongjian_id":"8feb5b4b-db0e-11ef-bbe7-a0d3651f611f"},{"people_name":"嘉","people_name_jianti_auto":"嘉","start_index":63,"tongjian_id":"8feb5b4c-db0e-11ef-8216-a0d3651f611f"},{"people_name":"子南","people_name_jianti_auto":"子南","start_index":70,"tongjian_id":"8feb5b4d-db0e-11ef-904c-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":77,"tongjian_id":"8feb5b4e-db0e-11ef-a688-a0d3651f611f"},{"people_name":"子南","people_name_jianti_auto":"子南","start_index":81,"tongjian_id":"8feb5b4f-db0e-11ef-9d6b-a0d3651f611f"},{"people_name":"周子南君","people_name_jianti_auto":"周子南君","start_index":98,"tongjian_id":"8feb5b50-db0e-11ef-99b6-a0d3651f611f"},{"people_name":"瓚","people_name_jianti_auto":"瓒","start_index":103,"tongjian_id":"8feb5b51-db0e-11ef-9f97-a0d3651f611f"},{"people_name":"嘉","people_name_jianti_auto":"嘉","start_index":120,"tongjian_id":"8feb5b52-db0e-11ef-a84a-a0d3651f611f"},{"people_name":"姬","people_name_jianti_auto":"姬","start_index":125,"tongjian_id":"8feb5b53-db0e-11ef-8ddb-a0d3651f611f"},{"people_name":"周子南君","people_name_jianti_auto":"周子南君","start_index":139,"tongjian_id":"8feb5b54-db0e-11ef-9e3f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"衞","place_name_jianti_auto":"衞","start_index":9,"tongjian_id":"8feb5b55-db0e-11ef-a4af-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":37,"tongjian_id":"8feb5b56-db0e-11ef-8684-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","start_index":44,"tongjian_id":"8feb5b57-db0e-11ef-a576-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":52,"tongjian_id":"8feb5b58-db0e-11ef-bdb1-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":54,"tongjian_id":"8feb5b59-db0e-11ef-99cb-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","start_index":57,"tongjian_id":"8feb5b5a-db0e-11ef-9cf0-a0d3651f611f"},{"place_name":"衞","place_name_jianti_auto":"衞","start_index":65,"tongjian_id":"8feb5b5b-db0e-11ef-90b6-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":92,"tongjian_id":"8feb5b5c-db0e-11ef-a560-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":146,"tongjian_id":"8feb5b5d-db0e-11ef-a5d9-a0d3651f611f"},{"place_name":"長社","place_name_jianti_auto":"长社","place_note":"河南长葛","start_index":148,"tongjian_id":"8feb5b5e-db0e-11ef-bec0-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"臣瓚曰：汲冢古文謂衞將軍文子爲子南彌牟，其後有子南固、子南勁。紀年，勁朝於魏。後惠成王如衞，命子南爲侯。秦幷六國，衞最後亡。疑嘉是衞後，故氏子南而稱君也。師古曰：子南，其封邑之號，以爲周後，故總言周子南君，瓚說非也。例不先言姓而後稱君，且自嘉以下皆姓姬，著於史傳。余據恩澤侯表，周子南君食邑於潁川長社。","note_content_jianti_auto":"臣瓒曰：汲冢古文谓衞将军文子为子南弥牟，其后有子南固、子南劲。纪年，劲朝于魏。后惠成王如衞，命子南为侯。秦幷六国，衞最后亡。疑嘉是衞后，故氏子南而称君也。师古曰：子南，其封邑之号，以为周后，故总言周子南君，瓒说非也。例不先言姓而后称君，且自嘉以下皆姓姬，著于史传。余据恩泽侯表，周子南君食邑于颍川长社。","note_type":"hu_note","start_index":143,"tongjian_id":"8feb5b43-db0e-11ef-b8e9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"8feaf953-db0e-11ef-8340-a0d3651f611f","pinyin":"shuí","source_anchor_text":"祠于汾陰脽上上親望","source_key":"baiyang_epub","start_index":105,"text":"脽","tongjian_id":"dfd6eb0f-b2a3-5d3f-9e18-b963df73cc2c"}],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","place_note":"山西万荣西南榮河镇","resolved_place_entity_id":1244,"start_index":63,"tongjian_id":"8feb5b67-db0e-11ef-8e00-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":103,"tongjian_id":"8feb5b6a-db0e-11ef-8fed-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"1冬，十月，上行幸雍，祠五畤。詔曰：「今上帝，朕親郊，而后土無祀，則禮不答也，其令有司議！」立后土祠於澤中圜丘。上遂自夏陽東幸汾陰。是時，天子始巡郡、國；河東守不意行至，不辦，自殺。十一月，甲子，立后土祠於汾陰脽上，上親望拜，如上帝禮。禮畢，行幸滎陽，還，至洛陽，封周後姬嘉爲周子南君。","content_fanyi":"冬季，十月，汉武帝刘彻巡行到雍地，在五畤举行祭祀。他下诏说：“如今祭祀天帝，朕亲自举行郊祭，而后土却没有祭祀，于礼不合，着令主管官员商议办理！”主管官员建议在水泽中的圜丘上建立后土祠，用以祭祀土地神。汉武帝于是从夏阳向东巡赴汾阴。这时，天子第一次巡视各郡、国；河东郡守没料到皇帝突然到来，供应来不及备办，惶恐自杀。十一月，甲子日，即初八，在汾阴丘陵上建立后土祠，皇上亲自行望祭礼，礼仪规格与祭祀天帝相同。祭礼结束，他巡行到荥阳，回程，到洛阳，封周朝王室后裔姬嘉为周子南君。","content_jianti_auto":"1冬，十月，上行幸雍，祠五畤。诏曰：「今上帝，朕亲郊，而后土无祀，则礼不答也，其令有司议！」立后土祠于泽中圜丘。上遂自夏阳东幸汾阴。是时，天子始巡郡、国；河东守不意行至，不办，自杀。十一月，甲子，立后土祠于汾阴脽上，上亲望拜，如上帝礼。礼毕，行幸荥阳，还，至洛阳，封周后姬嘉为周子南君。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1635,"number":1,"path":"资治通鉴 : 卷第二十 (漢紀十二) / 世宗孝武皇帝中之下 / 四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8feaf953-db0e-11ef-8340-a0d3651f611f","year_int":-113},"tongjian_id":"8feaf953-db0e-11ef-8340-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"8fedc30c-db0e-11ef-8312-a0d3651f611f"},{"people_name":"錦","people_name_jianti_auto":"锦","start_index":4,"tongjian_id":"8fedc30d-db0e-11ef-a903-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：錦，巫名。","note_content_jianti_auto":"应劭曰：锦，巫名。","note_type":"hu_note","start_index":8,"tongjian_id":"8fedaec0-db0e-11ef-9516-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8fedc30f-db0e-11ef-9b26-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"汾脽","place_name_jianti_auto":"汾脽","start_index":4,"tongjian_id":"8fedc310-db0e-11ef-af56-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":7,"tongjian_id":"8fedc311-db0e-11ef-979b-a0d3651f611f"},{"place_name":"魏脽","place_name_jianti_auto":"魏脽","start_index":14,"tongjian_id":"8fedc312-db0e-11ef-8221-a0d3651f611f"},{"place_name":"后土祠","place_name_jianti_auto":"后土祠","start_index":21,"tongjian_id":"8fedc313-db0e-11ef-8388-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：汾脽本魏地之墳，故曰魏脽也。營，謂后土祠之兆域。","note_content_jianti_auto":"师古曰：汾脽本魏地之坟，故曰魏脽也。营，谓后土祠之兆域。","note_type":"hu_note","start_index":19,"tongjian_id":"8fedc30e-db0e-11ef-bcb8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"8fedc315-db0e-11ef-9a11-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":9,"tongjian_id":"8fedc316-db0e-11ef-bb39-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：以鼎從行上甘泉。","note_content_jianti_auto":"如淳曰：以鼎从行上甘泉。","note_type":"hu_note","start_index":54,"tongjian_id":"8fedc314-db0e-11ef-8c93-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":4,"tongjian_id":"8fedc318-db0e-11ef-9c06-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"4六月，汾陰巫錦得大鼎於魏脽后土營旁，河東太守以聞。天子使驗問，巫得鼎無姦詐，乃以禮祠，迎鼎至甘泉，從上行，薦之宗廟及上帝，藏於甘泉宮；羣臣皆上壽賀。","content_fanyi":"六月，汾阴一位名叫锦的巫师在魏脽后土祠旁得到一只大鼎，河东太守将此事奏报朝廷。武帝派人核验查问，确认巫师得鼎并无欺诈，于是按照礼仪祭祀，把鼎迎接到甘泉宫，随同武帝带着鼎前行，进献给宗庙和皇天上帝，收藏在甘泉宫中；群臣都向武帝上寿祝贺。","content_jianti_auto":"4六月，汾阴巫锦得大鼎于魏脽后土营旁，河东太守以闻。天子使验问，巫得鼎无奸诈，乃以礼祠，迎鼎至甘泉，从上行，荐之宗庙及上帝，藏于甘泉宫；群臣皆上寿贺。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1638,"number":4,"path":"资治通鉴 : 卷第二十 (漢紀十二) / 世宗孝武皇帝中之下 / 四年 / 第 4 段","reading_annotation_sources":[],"start_index":3,"tongjian_id":"8fedaebf-db0e-11ef-94a2-a0d3651f611f","year_int":-113},"tongjian_id":"8fedaebf-db0e-11ef-94a2-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"902e0396-db0e-11ef-b0d1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"回中","place_name_jianti_auto":"回中","place_note":"陕西陇县西北","start_index":4,"tongjian_id":"902e0397-db0e-11ef-ae54-a0d3651f611f"},{"place_name":"安定","place_name_jianti_auto":"安定","start_index":7,"tongjian_id":"902e0398-db0e-11ef-acee-a0d3651f611f"},{"place_name":"高平","place_name_jianti_auto":"高平","start_index":9,"tongjian_id":"902e0399-db0e-11ef-88fa-a0d3651f611f"},{"place_name":"蕭關","place_name_jianti_auto":"萧关","place_note":"宁夏固原东南","start_index":16,"tongjian_id":"902e039a-db0e-11ef-a6c9-a0d3651f611f"},{"place_name":"回中","place_name_jianti_auto":"回中","start_index":25,"tongjian_id":"902e039b-db0e-11ef-9e06-a0d3651f611f"},{"place_name":"蕭關","place_name_jianti_auto":"萧关","place_note":"宁夏固原东南","start_index":31,"tongjian_id":"902e039c-db0e-11ef-82f5-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：回中在安定高平，有險阻；蕭關在其北。此蓋自回中通道以出蕭關。","note_content_jianti_auto":"师古曰：回中在安定高平，有险阻；萧关在其北。此盖自回中通道以出萧关。","note_type":"hu_note","start_index":26,"tongjian_id":"902e0395-db0e-11ef-8c50-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"902e039e-db0e-11ef-8e41-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"獨鹿","place_name_jianti_auto":"独鹿","place_note":"北京房山区西南","start_index":4,"tongjian_id":"902e039f-db0e-11ef-9996-a0d3651f611f"},{"place_name":"鳴澤","place_name_jianti_auto":"鸣泽","place_note":"河北涿州市西","start_index":10,"tongjian_id":"902e03a0-db0e-11ef-9780-a0d3651f611f"},{"place_name":"涿郡","place_name_jianti_auto":"涿郡","start_index":18,"tongjian_id":"902e03a1-db0e-11ef-8437-a0d3651f611f"},{"place_name":"遒縣","place_name_jianti_auto":"遒县","start_index":20,"tongjian_id":"902e03a2-db0e-11ef-80b7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"服虔曰：獨鹿，山名；鳴澤，澤名；皆在涿郡遒縣北界。水經註：澤渚方十五里。","note_content_jianti_auto":"服虔曰：独鹿，山名；鸣泽，泽名；皆在涿郡遒县北界。水经注：泽渚方十五里。","note_type":"hu_note","start_index":33,"tongjian_id":"902e039d-db0e-11ef-804f-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","place_note":"山西万荣西南榮河镇","resolved_place_entity_id":1244,"start_index":52,"tongjian_id":"902e03ad-db0e-11ef-95f4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"1冬，十月，上行幸雍，祠五畤。通回中道，遂北出蕭關，歷獨鹿、鳴澤，自代而還，幸河東。春，三月，祠后土，赦汾陰、夏陽、中都死罪以下。","content_fanyi":"冬季十月，汉武帝巡幸雍县，祭祀五畤。开通回中道，便北出萧关，经过独鹿山、鸣泽湖，从代地返回，途中巡幸河东郡。春季三月，祭祀后土神，赦免汾阴、夏阳、中都三地死罪以下的囚犯。","content_jianti_auto":"1冬，十月，上行幸雍，祠五畤。通回中道，遂北出萧关，历独鹿、鸣泽，自代而还，幸河东。春，三月，祠后土，赦汾阴、夏阳、中都死罪以下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1703,"number":1,"path":"资治通鉴 : 卷第二十一 (漢紀十三) / 世宗孝武皇帝下之上 / 四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"902e0393-db0e-11ef-ae06-a0d3651f611f","year_int":-107},"tongjian_id":"902e0393-db0e-11ef-ae06-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","place_note":"山西万荣西南榮河镇","resolved_place_entity_id":1244,"start_index":14,"tongjian_id":"9030a6ec-db0e-11ef-acde-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"3三月，行幸河東，祠后土，赦汾陰殊死以下。","content_fanyi":"三月，汉武帝巡幸河东，祭祀后土神，赦免汾阴地区死罪以下的囚犯。","content_jianti_auto":"3三月，行幸河东，祠后土，赦汾阴殊死以下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1712,"number":3,"path":"资治通鉴 : 卷第二十一 (漢紀十三) / 世宗孝武皇帝下之上 / 六年 / 第 3 段","reading_annotation_sources":[],"start_index":2,"tongjian_id":"9030a6e9-db0e-11ef-85fc-a0d3651f611f","year_int":-105},"tongjian_id":"9030a6e9-db0e-11ef-85fc-a0d3651f611f"},"paragraph_order":6},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"畤，音止；下同。","note_content_jianti_auto":"畤，音止；下同。","note_type":"hu_note","start_index":16,"tongjian_id":"9156ab42-db0e-11ef-9672-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"徒，有罪居作者。","note_content_jianti_auto":"徒，有罪居作者。","note_type":"hu_note","start_index":33,"tongjian_id":"9156ab43-db0e-11ef-82f1-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":29,"tongjian_id":"9158e198-db0e-11ef-9e2e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"1春，正月，上行幸甘泉，郊泰畤。三月，行幸河東，祠后土；赦汾陰徒。","content_fanyi":"春季，正月，汉元帝巡幸甘泉宫，在泰畤祭祀太乙神。三月，汉元帝巡幸河东郡，祭祀后土神；并特赦汾阴的苦役犯。","content_jianti_auto":"1春，正月，上行幸甘泉，郊泰畤。三月，行幸河东，祠后土；赦汾阴徒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2223,"number":1,"path":"资治通鉴 : 卷第二十八 (漢紀二十) / 孝元皇帝上 / 四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"9156ab41-db0e-11ef-b812-a0d3651f611f","year_int":-45},"tongjian_id":"9156ab41-db0e-11ef-b812-a0d3651f611f"},"paragraph_order":7},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"匡衡","people_name_jianti_auto":"匡衡","start_index":0,"tongjian_id":"91bbcd85-db0e-11ef-9aa7-a0d3651f611f"},{"people_name":"后土","people_name_jianti_auto":"后土","start_index":44,"tongjian_id":"91bbcd86-db0e-11ef-812b-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":28,"tongjian_id":"91bbcd87-db0e-11ef-af1f-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":41,"tongjian_id":"91bbcd88-db0e-11ef-bf87-a0d3651f611f"},{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":53,"tongjian_id":"91bbcd89-db0e-11ef-8ddf-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":56,"tongjian_id":"91bbcd8a-db0e-11ef-a515-a0d3651f611f"},{"place_name":"長安","place_name_jianti_auto":"长安","start_index":72,"tongjian_id":"91bbcd8b-db0e-11ef-af15-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"匡衡奏：祭天於南郊，就陽之義也。瘞地於北郊，卽陰之象也。甘泉郊見皇天，反北之太陰；汾陰祠后土，反東之少陽。甘泉、河東之祠宜徙就正陽、太陰之處，於長安定南、北郊。上從之。","note_content_jianti_auto":"匡衡奏：祭天于南郊，就阳之义也。瘗地于北郊，即阴之象也。甘泉郊见皇天，反北之太阴；汾阴祠后土，反东之少阳。甘泉、河东之祠宜徙就正阳、太阴之处，于长安定南、北郊。上从之。","note_type":"hu_note","start_index":23,"tongjian_id":"91bbcd84-db0e-11ef-be68-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":52,"tongjian_id":"91bbcd8d-db0e-11ef-a533-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":4,"tongjian_id":"91bbcd8e-db0e-11ef-ac07-a0d3651f611f"},{"place_name":"泰畤","place_name_jianti_auto":"泰畤","start_index":6,"tongjian_id":"91bbcd8f-db0e-11ef-98ac-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"衡又言：甘泉泰畤紫壇有文章、采鏤、黼黻之飾，及玉女樂、石壇仙人祠，瘞鸞路，騂駒、寓龍，非古。於是悉罷之。師古曰：漢舊儀云：祭天用六綵，綺席六重，用玉几、玉飾器凡七十。女樂，卽禮樂志所云使童男、童女俱歌也。","note_content_jianti_auto":"衡又言：甘泉泰畤紫坛有文章、采镂、黼黻之饰，及玉女乐、石坛仙人祠，瘗鸾路，骍驹、寓龙，非古。于是悉罢之。师古曰：汉旧仪云：祭天用六彩，绮席六重，用玉几、玉饰器凡七十。女乐，即礼乐志所云使童男、童女俱歌也。","note_type":"hu_note","start_index":46,"tongjian_id":"91bbcd8c-db0e-11ef-b934-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"91bbcd83-db0e-11ef-bed8-a0d3651f611f","pinyin":"xīng","source_anchor_text":"女樂鸞路騂駒龍馬石","source_key":"baiyang_epub","start_index":35,"text":"騂","tongjian_id":"b333ad99-9254-52cd-8f99-68f2c83e131b"}],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":19,"tongjian_id":"91bbcd94-db0e-11ef-a7a4-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"9冬，十二月，作長安南、北郊，罷甘泉、汾陰祠，及紫壇僞飾、女樂、鸞路、騂駒、龍馬、石壇之屬。","content_fanyi":"冬季十二月，汉成帝在长安南郊和北郊修建祭天、祭地的庙宇，下令撤除甘泉、汾阴两地的祠庙，并撤去甘泉紫坛的伪饰、女乐、鸾路、骍驹、龙马、石坛之类。","content_jianti_auto":"9冬，十二月，作长安南、北郊，罢甘泉、汾阴祠，及紫坛伪饰、女乐、鸾路、骍驹、龙马、石坛之属。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2341,"number":9,"path":"资治通鉴 : 卷第三十 (漢紀二十二) / 孝成皇帝上之上 / 建始元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"91bbcd83-db0e-11ef-bed8-a0d3651f611f","year_int":-32},"tongjian_id":"91bbcd83-db0e-11ef-bed8-a0d3651f611f"},"paragraph_order":8},{"mention_count":2,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":8,"source_start_index":0,"source_text":"事見上卷建始元年","target_paragraph_tongjian_id":"91bbcd83-db0e-11ef-bed8-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"事見上卷建始元年。","note_content_jianti_auto":"事见上卷建始元年。","note_type":"hu_note","start_index":15,"tongjian_id":"9200e7fe-db0e-11ef-a9fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":0,"tongjian_id":"9200e800-db0e-11ef-ab37-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":21,"tongjian_id":"9200e801-db0e-11ef-bf0a-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":35,"tongjian_id":"9200e802-db0e-11ef-b4ce-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":9,"tongjian_id":"9200e803-db0e-11ef-aaef-a0d3651f611f"},{"place_name":"竹宮","place_name_jianti_auto":"竹宫","start_index":15,"tongjian_id":"9200e804-db0e-11ef-b057-a0d3651f611f"},{"place_name":"竹宮","place_name_jianti_auto":"竹宫","start_index":43,"tongjian_id":"9200e805-db0e-11ef-96ad-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武帝以正月上辛有事甘泉圜丘，自竹宮而望拜。韋昭曰：以竹爲宮，天子居中。師古曰：漢舊儀，竹宮去壇三里。壞，音怪。","note_content_jianti_auto":"武帝以正月上辛有事甘泉圜丘，自竹宫而望拜。韦昭曰：以竹为宫，天子居中。师古曰：汉旧仪，竹宫去坛三里。坏，音怪。","note_type":"hu_note","start_index":26,"tongjian_id":"9200e7ff-db0e-11ef-ab94-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9200e809-db0e-11ef-8755-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：家人，謂庶人之家也。種祠，繼嗣所傳祠也。","note_content_jianti_auto":"师古曰：家人，谓庶人之家也。种祠，继嗣所传祠也。","note_type":"hu_note","start_index":61,"tongjian_id":"9200e808-db0e-11ef-91c2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"武帝","people_name_jianti_auto":"武帝","start_index":0,"tongjian_id":"9200e80b-db0e-11ef-bf01-a0d3651f611f"},{"people_name":"泰一","people_name_jianti_auto":"泰一","start_index":3,"tongjian_id":"9200e80c-db0e-11ef-839c-a0d3651f611f"},{"people_name":"公孫滂洋","people_name_jianti_auto":"公孙滂洋","start_index":26,"tongjian_id":"9200e80d-db0e-11ef-a392-a0d3651f611f"},{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":51,"tongjian_id":"9200e80e-db0e-11ef-a69c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":6,"tongjian_id":"9200e80f-db0e-11ef-bbc8-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":22,"tongjian_id":"9200e810-db0e-11ef-801a-a0d3651f611f"},{"place_name":"汾","place_name_jianti_auto":"汾","start_index":32,"tongjian_id":"9200e811-db0e-11ef-ac6a-a0d3651f611f"},{"place_name":"后土祠","place_name_jianti_auto":"后土祠","start_index":42,"tongjian_id":"9200e812-db0e-11ef-9d98-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":46,"tongjian_id":"9200e813-db0e-11ef-8a34-a0d3651f611f"},{"place_name":"成紀","place_name_jianti_auto":"成纪","start_index":60,"tongjian_id":"9200e814-db0e-11ef-bbf2-a0d3651f611f"},{"place_name":"雍","place_name_jianti_auto":"雍","start_index":65,"tongjian_id":"9200e815-db0e-11ef-8a4a-a0d3651f611f"},{"place_name":"五畤","place_name_jianti_auto":"五畤","start_index":69,"tongjian_id":"9200e816-db0e-11ef-b3b2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武帝祠泰一於甘泉，夜常有神光如流星集于祠壇。汾陰男子公孫滂洋等見汾旁有光如絳，上遂立后土祠於汾陰脽上。文帝十四年，黃龍見成紀，始幸雍，郊見五畤。","note_content_jianti_auto":"武帝祠泰一于甘泉，夜常有神光如流星集于祠坛。汾阴男子公孙滂洋等见汾旁有光如绛，上遂立后土祠于汾阴脽上。文帝十四年，黄龙见成纪，始幸雍，郊见五畤。","note_type":"hu_note","start_index":101,"tongjian_id":"9200e80a-db0e-11ef-8a22-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"元帝","people_name_jianti_auto":"元帝","start_index":0,"tongjian_id":"9200e819-db0e-11ef-a600-a0d3651f611f"},{"people_name":"貢禹","people_name_jianti_auto":"贡禹","start_index":4,"tongjian_id":"9200e81a-db0e-11ef-abe8-a0d3651f611f"},{"people_name":"韋玄成","people_name_jianti_auto":"韦玄成","start_index":19,"tongjian_id":"9200e81b-db0e-11ef-baaa-a0d3651f611f"},{"people_name":"匡衡","people_name_jianti_auto":"匡衡","start_index":23,"tongjian_id":"9200e81c-db0e-11ef-80ba-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢家","place_name_jianti_auto":"汉家","start_index":9,"tongjian_id":"9200e81d-db0e-11ef-8bb7-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"元帝時，貢禹建言，漢家祭祀多不應古禮；韋玄成、匡衡等因之。","note_content_jianti_auto":"元帝时，贡禹建言，汉家祭祀多不应古礼；韦玄成、匡衡等因之。","note_type":"hu_note","start_index":153,"tongjian_id":"9200e818-db0e-11ef-b637-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"9200e81f-db0e-11ef-bc8c-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：恨，悔也。","note_content_jianti_auto":"师古曰：恨，悔也。","note_type":"hu_note","start_index":184,"tongjian_id":"9200e81e-db0e-11ef-8952-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":74,"tongjian_id":"9200e827-db0e-11ef-b51b-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":214,"tongjian_id":"9200e831-db0e-11ef-a940-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"2初，帝用匡衡議，罷甘泉泰畤，其日，大風壞甘泉竹宮，折拔畤中樹木十圍以上百餘。帝異之，以問劉向；對曰：「家人尚不欲絕種祠，況於國之神寶舊畤！且甘泉、汾陰及雍五畤始立，皆有神祇感應，然後營之，非苟而已也。武、宣之世奉此三神，禮敬敕備，神光尤著。祖宗所立神祇舊位，誠未易動。前始納貢禹之議，後人相因，多所動搖。易·大傳曰：『誣神者殃及三世。』恐其咎不獨止禹等！」上意恨之，又以久無繼嗣，冬，十月，庚辰，上白太后，令詔有司復甘泉泰畤、汾陰后土如故，及雍五畤、陳寶祠、長安及郡國祠著明者，皆復之。","content_fanyi":"起初，汉成帝采纳匡衡的建议，撤销了甘泉泰畤，当天，大风吹毁甘泉竹宫，刮断并连根拔起畤中十围以上的树木一百多棵。成帝感到奇异，便召见刘向询问；刘向回答说：“普通百姓尚且不愿祖庙祭祀断绝，何况是国家的神宝旧畤！况且甘泉、汾阴和雍城五畤最初建立时，都有神灵感应，然后才加以营建，并不是随便设立的。武帝、宣帝时代敬奉这三处神灵，礼仪恭敬、严谨而完备，神光尤为显著。祖宗所立的神灵旧位，实在不可轻易变动。从前元帝时开始采纳贡禹的建议，后人相继沿袭，祭祀礼仪多有变动。《易·大传》说：‘诬蔑神灵的人会殃及三代。’恐怕这种灾祸不会只由贡禹等人承当！”成帝心中很后悔，又因很久没有继承人，冬季十月初十日庚辰，成帝向皇太后禀告，命有关官员恢复甘泉泰畤、汾阴后土祭祀如故，以及雍城五畤、陈宝祠，长安和郡国中著名祠庙，也全部恢复。","content_jianti_auto":"2初，帝用匡衡议，罢甘泉泰畤，其日，大风坏甘泉竹宫，折拔畤中树木十围以上百余。帝异之，以问刘向；对曰：「家人尚不欲绝种祠，况于国之神宝旧畤！且甘泉、汾阴及雍五畤始立，皆有神祇感应，然后营之，非苟而已也。武、宣之世奉此三神，礼敬敕备，神光尤著。祖宗所立神祇旧位，诚未易动。前始纳贡禹之议，后人相因，多所动摇。易·大传曰：『诬神者殃及三世。』恐其咎不独止禹等！」上意恨之，又以久无继嗣，冬，十月，庚辰，上白太后，令诏有司复甘泉泰畤、汾阴后土如故，及雍五畤、陈宝祠、长安及郡国祠著明者，皆复之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2490,"number":2,"path":"资治通鉴 : 卷第三十一 (漢紀二十三) / 孝成皇帝上之下 / 三年 / 第 2 段","reading_annotation_sources":[],"start_index":1,"tongjian_id":"9200e7fd-db0e-11ef-b7dd-a0d3651f611f","year_int":-14},"tongjian_id":"9200e7fd-db0e-11ef-b7dd-a0d3651f611f"},"paragraph_order":9},{"mention_count":1,"paragraph_brief":{"brief_for":"汾陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"定，猶安也。","note_content_jianti_auto":"定，犹安也。","note_type":"hu_note","start_index":8,"tongjian_id":"929186c3-db0e-11ef-be90-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"成帝","people_name_jianti_auto":"成帝","start_index":0,"tongjian_id":"929186c5-db0e-11ef-acdb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"甘泉","place_name_jianti_auto":"甘泉","start_index":9,"tongjian_id":"929186c6-db0e-11ef-abb2-a0d3651f611f"},{"place_name":"汾陰","place_name_jianti_auto":"汾阴","start_index":12,"tongjian_id":"929186c7-db0e-11ef-8423-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"成帝崩，皇太后詔罷甘泉，汾陰祠，復南、北郊。畤，音止。","note_content_jianti_auto":"成帝崩，皇太后诏罢甘泉，汾阴祠，复南、北郊。畤，音止。","note_type":"hu_note","start_index":42,"tongjian_id":"929186c4-db0e-11ef-889b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"汾陰","place_name_jianti_auto":"汾阴","resolved_place_entity_id":1244,"start_index":30,"tongjian_id":"929186ca-db0e-11ef-b3f6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"class_tags":[],"content":"7上以寢疾未定，冬，十一月，壬子，令太皇太后下詔復甘泉泰畤、汾陰后土祠，罷南、北郊。上亦不能親至甘泉、河東，遣有司行事而禮祠焉。","content_fanyi":"汉哀帝因为卧病未愈，冬季十一月初五日壬子，命太皇太后王政君颁下诏书，恢复甘泉泰畤、汾阴后土祠的祭祀，废除长安南郊祭天、北郊祭地的祭祀。汉哀帝本人也不能亲赴甘泉、河东郡，就派遣主管官员代行祭事，依礼祭祀。","content_jianti_auto":"7上以寝疾未定，冬，十一月，壬子，令太皇太后下诏复甘泉泰畤、汾阴后土祠，罢南、北郊。上亦不能亲至甘泉、河东，遣有司行事而礼祠焉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":2637,"number":7,"path":"资治通鉴 : 卷第三十四 (漢紀二十六) / 孝哀皇帝中 / 三年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"929186c2-db0e-11ef-8c4f-a0d3651f611f","year_int":-4},"tongjian_id":"929186c2-db0e-11ef-8c4f-a0d3651f611f"},"paragraph_order":10}],"page_size":10,"total_pages":3,"total_paragraphs":21},"place_name":"汾陰"},"message":"success","success":true}