ks":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楊保宗","people_name_jianti_auto":"杨保宗","start_index":6,"tongjian_id":"a90fc409-db0e-11ef-abe4-a0d3651f611f"},{"people_name":"氐王","people_name_jianti_auto":"氐王","start_index":10,"tongjian_id":"a90fc40a-db0e-11ef-a945-a0d3651f611f"},{"people_name":"楊玄","people_name_jianti_auto":"杨玄","start_index":12,"tongjian_id":"a90fc40b-db0e-11ef-9c5e-a0d3651f611f"},{"people_name":"元和","people_name_jianti_auto":"元和","start_index":18,"tongjian_id":"a90fc40c-db0e-11ef-8230-a0d3651f611f"},{"people_name":"楊氏","people_name_jianti_auto":"杨氏","start_index":21,"tongjian_id":"a90fc40d-db0e-11ef-87d1-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"從，才用翻。楊保宗，氐王楊玄之子，故元和爲楊氏正統。","note_content_jianti_auto":"从，才用翻。杨保宗，氐王杨玄之子，故元和为杨氏正统。","note_type":"hu_note","start_index":47,"tongjian_id":"a90fc408-db0e-11ef-913d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":0,"tongjian_id":"a90fc40f-db0e-11ef-a5bf-a0d3651f611f"},{"people_name":"楊文德","people_name_jianti_auto":"杨文德","start_index":13,"tongjian_id":"a90fc410-db0e-11ef-adf9-a0d3651f611f"},{"people_name":"頭","people_name_jianti_auto":"头","start_index":19,"tongjian_id":"a90fc411-db0e-11ef-b728-a0d3651f611f"},{"people_name":"頭","people_name_jianti_auto":"头","start_index":41,"tongjian_id":"a90fc412-db0e-11ef-bada-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","start_index":8,"tongjian_id":"a90fc413-db0e-11ef-866c-a0d3651f611f"},{"place_name":"仇池","place_name_jianti_auto":"仇池","start_index":10,"tongjian_id":"a90fc414-db0e-11ef-8742-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":25,"tongjian_id":"a90fc415-db0e-11ef-8990-a0d3651f611f"},{"place_name":"葭蘆","place_name_jianti_auto":"葭芦","start_index":43,"tongjian_id":"a90fc416-db0e-11ef-adc6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文帝元嘉二十年，魏克仇池，楊文德敗走；頭母妻子弟爲魏所執，當在是年。二十七年，始使頭戍葭蘆。","note_content_jianti_auto":"文帝元嘉二十年，魏克仇池，杨文德败走；头母妻子弟为魏所执，当在是年。二十七年，始使头戍葭芦。","note_type":"hu_note","start_index":83,"tongjian_id":"a90fc40e-db0e-11ef-9ec4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"軍事指揮","official_name":"征虜將軍","official_note":"征虜將軍是魏晉南北朝時期的將軍號，通常用於授予少數民族首領或地方將領，以安撫或控制邊疆地區。在此上下文中，元和被任命為征虜將軍，以穩定氐族部落，但因其年幼才弱，未正式確立其地位。","official_rank":"未知","source_snippet":"以故氐王楊保宗子元和爲征虜將軍","start_index":8,"tongjian_id":"262dd1cd-6af8-4d90-a918-7cce2fac8712"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"輔國將軍","official_note":"輔國將軍是魏晉南北朝時期的將軍號，常用於授予有功將領或地方勢力，以加強中央控制。在此上下文中，楊頭被任命為輔國將軍，以表彰其對宋朝的忠誠和堅守葭蘆的功績。","official_rank":"未知","source_snippet":"楊頭爲輔國將軍","start_index":20,"tongjian_id":"1843105a-c5a5-49be-b18e-dd74a87b7806"},{"confidence":0.95,"official_category":"地方行政","official_name":"雍州刺史","official_note":"雍州刺史是地方行政長官，負責管理雍州地區的軍政事務。在此上下文中，王玄謨作為雍州刺史，向朝廷建議任命楊頭為假節、西秦州刺史，以穩定邊疆局勢。","official_rank":"未知","source_snippet":"雍州刺史王玄謨上言","start_index":78,"tongjian_id":"2ebc894e-885f-4929-bc94-79b09f840f32"},{"confidence":0.85,"official_category":"軍事指揮","official_name":"假節","official_note":"假節是授予官員的一種權力，允許其在特定情況下行使節制權，常用於軍事指揮官。在此上下文中，王玄謨建議授予楊頭假節，以增強其權威，更好地安撫氐族部落。","official_rank":"未知","source_snippet":"請以頭爲假節、西秦州刺史","start_index":88,"tongjian_id":"55ddbb23-25e1-4b1f-8558-6f03acd63c12"},{"confidence":0.9,"official_category":"地方行政","official_name":"西秦州刺史","official_note":"西秦州刺史是地方行政長官，負責管理西秦州地區。在此上下文中，王玄謨建議任命楊頭為西秦州刺史，以安輯其衆，並作為過渡措施，等待元和成年後再考慮繼承事宜。","official_rank":"未知","source_snippet":"請以頭爲假節、西秦州刺史","start_index":92,"tongjian_id":"13a94110-3c8e-4510-8221-3d17ca617fd1"}],"ExtRef_Children_people":[{"link_death_year":443,"link_td_description":"杨保宗，氐人，在429年任仇池（今中国甘肃南一带）首领。他是上任首领杨玄之子。","link_td_id":"Q10008667","link_td_number_id":361535,"people_name":"氐王","people_name_jianti_auto":"氐王","people_xingming":"杨保宗","start_index":7,"tongjian_id":"a90fc41a-db0e-11ef-977d-a0d3651f611f"},{"link_death_year":443,"link_td_description":"杨保宗，氐人，在429年任仇池（今中国甘肃南一带）首领。他是上任首领杨玄之子。","link_td_id":"Q10008667","link_td_number_id":361535,"people_name":"楊保宗","people_name_jianti_auto":"杨保宗","people_xingming":"杨保宗","start_index":9,"tongjian_id":"a90fc41b-db0e-11ef-8747-a0d3651f611f"},{"link_td_description":"杨元和，5世纪氐人，仇池首领杨保宗之子。455年，宋以杨元和为征虏将军，又以文德之从祖兄杨头为辅国将军，守葭芦（今甘肃武都县东南）。朝廷以元和“年幼才弱”，未正位号。后来宋立元和为武都王，治白水，可是元和因“微弱不能自立”，在大约466年弃国投奔北魏。元和从弟杨僧嗣自立，屯葭芦。","link_td_id":"Q10008671","link_td_number_id":361540,"people_name":"元和","people_name_jianti_auto":"元和","people_xingming":"杨元和","start_index":13,"tongjian_id":"a90fc41c-db0e-11ef-ba81-a0d3651f611f"},{"people_name":"楊頭","people_name_jianti_auto":"杨头","people_xingming":"杨头","start_index":21,"tongjian_id":"a90fc41d-db0e-11ef-8fcf-a0d3651f611f"},{"people_name":"頭","people_name_jianti_auto":"头","people_xingming":"杨头","start_index":29,"tongjian_id":"a90fc41e-db0e-11ef-bcdc-a0d3651f611f"},{"link_td_description":"杨文德，氐人，在443年至450年间任仇池首领。","link_td_id":"Q10008669","link_td_number_id":361538,"people_name":"文德","people_name_jianti_auto":"文德","people_xingming":"杨文德","start_index":31,"tongjian_id":"a90fc41f-db0e-11ef-bcb8-a0d3651f611f"},{"link_td_description":"杨元和，5世纪氐人，仇池首领杨保宗之子。455年，宋以杨元和为征虏将军，又以文德之从祖兄杨头为辅国将军，守葭芦（今甘肃武都县东南）。朝廷以元和“年幼才弱”，未正位号。后来宋立元和为武都王，治白水，可是元和因“微弱不能自立”，在大约466年弃国投奔北魏。元和从弟杨僧嗣自立，屯葭芦。","link_td_id":"Q10008671","link_td_number_id":361540,"people_name":"元和","people_name_jianti_auto":"元和","start_index":39,"tongjian_id":"a90fc420-db0e-11ef-8f85-a0d3651f611f"},{"people_name":"楊氏","people_name_jianti_auto":"杨氏","start_index":42,"tongjian_id":"a90fc421-db0e-11ef-ab69-a0d3651f611f"},{"people_name":"頭","people_name_jianti_auto":"头","people_xingming":"杨头","start_index":67,"tongjian_id":"a90fc422-db0e-11ef-ae98-a0d3651f611f"},{"people