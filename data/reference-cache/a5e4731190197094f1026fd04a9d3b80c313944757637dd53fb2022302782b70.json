{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（庚戌、前一九一）","note_content_jianti_auto":"（庚戌、前一九一）","note_type":"hu_note","start_index":0,"tongjian_id":"8e89214c-db0e-11ef-ac09-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"張敖","people_name_jianti_auto":"张敖","start_index":2,"tongjian_id":"8e89214f-db0e-11ef-9aa6-a0d3651f611f"},{"people_name":"魯元公主","people_name_jianti_auto":"鲁元公主","start_index":7,"tongjian_id":"8e892150-db0e-11ef-9bd2-a0d3651f611f"},{"people_name":"敖","people_name_jianti_auto":"敖","start_index":12,"tongjian_id":"8e892151-db0e-11ef-9347-a0d3651f611f"},{"people_name":"魯元公主","people_name_jianti_auto":"鲁元公主","start_index":28,"tongjian_id":"8e892152-db0e-11ef-859e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"后，張敖女也。魯元公主降敖而生后。因下文重親，故直書帝姊魯元公主女；旣以紀人倫之變，且著外戚固寵也。重，直龍翻。","note_content_jianti_auto":"后，张敖女也。鲁元公主降敖而生后。因下文重亲，故直书帝姊鲁元公主女；既以纪人伦之变，且著外戚固宠也。重，直龙翻。","note_type":"hu_note","start_index":35,"tongjian_id":"8e89214e-db0e-11ef-add2-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-163,"link_td_description":"张皇后，中国西汉时期皇族女性，为汉惠帝皇后。","link_td_id":"Q10001945","link_td_number_id":149888,"people_name":"張氏","people_name_jianti_auto":"张氏","people_xingming":"张嫣","start_index":9,"tongjian_id":"8e892153-db0e-11ef-a73b-a0d3651f611f","wl_zhushi":"[张嫣]"},{"link_death_year":-187,"link_td_description":"鲁元公主，名不详，《汉书》记载，吕后曾称其为鲁元，汉高祖刘邦和皇后吕雉的长女，为汉惠帝之姐。颇受母亲吕雉宠爱。嫁赵王张耳之子张敖为妻，生鲁王张偃。另有一女张氏，后来成为汉惠帝刘盈的皇后。","link_td_id":"Q10001659","link_td_number_id":203373,"people_name":"魯元公主","people_name_jianti_auto":"鲁元公主","people_xingming":"鲁元公主","start_index":16,"tongjian_id":"8e892154-db0e-11ef-bbdc-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政","权争"],"content":"1冬，十月，立皇后張氏。后，帝姊魯元公主女也，太后欲爲重親，故以配帝。","content_fanyi":"冬季十月，册立张氏为皇后。皇后是惠帝姐姐鲁元公主的女儿。吕太后希望亲上加亲，所以将她许配给惠帝。","content_jianti_auto":"1冬，十月，立皇后张氏。后，帝姊鲁元公主女也，太后欲为重亲，故以配帝。","dtjl_paragraph_links":[],"dtjl_references":[],"id":968,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8e89214d-db0e-11ef-8e8e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"善事父母爲孝；善事兄長爲弟；力田者，取其竭力服勤於田事。孝、弟，人倫之大；力田，人生之本；故令郡國舉之。復其身，以風厲天下也。弟，讀曰悌。復，方目翻。","note_content_jianti_auto":"善事父母为孝；善事兄长为弟；力田者，取其竭力服勤于田事。孝、弟，人伦之大；力田，人生之本；故令郡国举之。复其身，以风厉天下也。弟，读曰悌。复，方目翻。","note_type":"hu_note","start_index":20,"tongjian_id":"8e892156-db0e-11ef-8d7a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"2春，正月，舉民孝、弟、力田者，復其身。","content_fanyi":"春季正月，朝廷选拔百姓中孝顺父母、敬爱兄长、勤于耕作的人，免除其本人的赋役。","content_jianti_auto":"2春，正月，举民孝、弟、力田者，复其身。","dtjl_paragraph_links":[],"dtjl_references":[],"id":969,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8e892155-db0e-11ef-b6f8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":12,"tongjian_id":"8e892159-db0e-11ef-8c1e-a0d3651f611f"},{"people_name":"周公","people_name_jianti_auto":"周公","start_index":21,"tongjian_id":"8e89215a-db0e-11ef-866c-a0d3651f611f"},{"people_name":"成王","people_name_jianti_auto":"成王","start_index":24,"tongjian_id":"8e89215b-db0e-11ef-a3c0-a0d3651f611f"},{"people_name":"三皇","people_name_jianti_auto":"三皇","start_index":42,"tongjian_id":"8e89215c-db0e-11ef-9f64-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":56,"tongjian_id":"8e89215d-db0e-11ef-8c16-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":67,"tongjian_id":"8e89215e-db0e-11ef-b138-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":80,"tongjian_id":"8e89215f-db0e-11ef-93b1-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":85,"tongjian_id":"8e892160-db0e-11ef-81ff-a0d3651f611f"},{"people_name":"黃帝","people_name_jianti_auto":"黄帝","start_index":98,"tongjian_id":"8e892161-db0e-11ef-b1d6-a0d3651f611f"},{"people_name":"襄","people_name_jianti_auto":"襄","start_index":125,"tongjian_id":"8e892162-db0e-11ef-9b93-a0d3651f611f"},{"people_name":"鄭樵","people_name_jianti_auto":"郑樵","start_index":238,"tongjian_id":"8e892163-db0e-11ef-aa1c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":242,"tongjian_id":"8e892164-db0e-11ef-a884-a0d3651f611f"},{"place_name":"高祖廟","place_name_jianti_auto":"高祖庙","start_index":277,"tongjian_id":"8e892165-db0e-11ef-b2a2-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"帝年十七卽位，至是始冠。孔穎達曰：案略說：周公對成王云：古者冒而句領。註云：古人，謂三皇時以冒覆頭，句領繞頸，至黃帝時則有冕也。世本謂黃帝造火食、旃冕，是冕起於黃帝也。但黃帝以前，則以羽皮爲之冠；黃帝以後，乃用布帛。其冠之年，則天子、諸侯十二而冠。故襄九年左傳云：古者國君十五而生子；冠而生子，禮也。其士則二十而冠。古者行冠禮於廟，初加緇布冠，次加皮弁冠，三加爵弁冠，所謂「三加彌尊，加有成也」。諸侯則四加而有玄冕，故大戴禮云「公冠四加」也。諸侯尚四加，則天子當五加，袞冕也。鄭樵曰：漢改皇帝冠爲加元服；初加緇布進賢，次爵弁，次武弁，次通天冠；冠訖，皆於高祖廟如禮謁見。","note_content_jianti_auto":"帝年十七即位，至是始冠。孔颖达曰：案略说：周公对成王云：古者冒而句领。注云：古人，谓三皇时以冒覆头，句领绕颈，至黄帝时则有冕也。世本谓黄帝造火食、旃冕，是冕起于黄帝也。但黄帝以前，则以羽皮为之冠；黄帝以后，乃用布帛。其冠之年，则天子、诸侯十二而冠。故襄九年左传云：古者国君十五而生子；冠而生子，礼也。其士则二十而冠。古者行冠礼于庙，初加缁布冠，次加皮弁冠，三加爵弁冠，所谓「三加弥尊，加有成也」。诸侯则四加而有玄冕，故大戴礼云「公冠四加」也。诸侯尚四加，则天子当五加，衮冕也。郑樵曰：汉改皇帝冠为加元服；初加缁布进贤，次爵弁，次武弁，次通天冠；冠讫，皆于高祖庙如礼谒见。","note_type":"hu_note","start_index":15,"tongjian_id":"8e892158-db0e-11ef-8c5f-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"3三月，甲子，皇帝冠，赦天下。","content_fanyi":"三月甲子日，皇帝行加冠礼，大赦天下。","content_jianti_auto":"3三月，甲子，皇帝冠，赦天下。","dtjl_paragraph_links":[],"dtjl_references":[],"id":970,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8e892157-db0e-11ef-adc7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":0,"tongjian_id":"8e89216d-db0e-11ef-82e4-a0d3651f611f"},{"people_name":"張晏","people_name_jianti_auto":"张晏","start_index":9,"tongjian_id":"8e89216e-db0e-11ef-a7bb-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":13,"tongjian_id":"8e89216f-db0e-11ef-bb75-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"應劭曰：挾，藏也。張晏曰：秦律，挾書者族。今始除之。","note_content_jianti_auto":"应劭曰：挟，藏也。张晏曰：秦律，挟书者族。今始除之。","note_type":"hu_note","start_index":14,"tongjian_id":"8e89216c-db0e-11ef-a2ef-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"4省法令妨吏民者；除挾書律。","content_fanyi":"审查法令中妨害官吏和百姓的条文；废止秦律中禁止携带、收藏书籍的“挟书律”。","content_jianti_auto":"4省法令妨吏民者；除挟书律。","dtjl_paragraph_links":[],"dtjl_references":[],"id":971,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"8e89216b-db0e-11ef-becd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8e892172-db0e-11ef-a968-a0d3651f611f"},{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":39,"tongjian_id":"8e892173-db0e-11ef-8f00-a0d3651f611f"},{"people_name":"賈公彥","people_name_jianti_auto":"贾公彦","start_index":70,"tongjian_id":"8e892174-db0e-11ef-96d5-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：非大朝見、中間小謁見曰間往。天子出入警蹕，辟止行人；數蹕，則人以爲煩。鄭氏周禮註曰：國有事，王當出，則禁絕行者，若今時衞士塡街蹕也。賈公彥疏曰：漢儀：大駕行幸，使衞士塡塞街巷，備非常也。蹕，壁吉翻。","note_content_jianti_auto":"师古曰：非大朝见、中间小谒见曰间往。天子出入警跸，辟止行人；数跸，则人以为烦。郑氏周礼注曰：国有事，王当出，则禁绝行者，若今时衞士塡街跸也。贾公彦疏曰：汉仪：大驾行幸，使衞士塡塞街巷，备非常也。跸，壁吉翻。","note_type":"hu_note","start_index":19,"tongjian_id":"8e892171-db0e-11ef-9a93-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"長樂","place_name_jianti_auto":"长乐","start_index":3,"tongjian_id":"8e892179-db0e-11ef-8db9-a0d3651f611f"},{"place_name":"未央宮","place_name_jianti_auto":"未央宫","start_index":6,"tongjian_id":"8e89217a-db0e-11ef-9e5e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武庫在長樂、未央宮之間，故築複道始於武庫南。","note_content_jianti_auto":"武库在长乐、未央宫之间，故筑复道始于武库南。","note_type":"hu_note","start_index":28,"tongjian_id":"8e892178-db0e-11ef-95b1-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"服虔","people_name_jianti_auto":"服虔","start_index":0,"tongjian_id":"8e89217c-db0e-11ef-9524-a0d3651f611f"},{"people_name":"應劭","people_name_jianti_auto":"应劭","start_index":24,"tongjian_id":"8e89217d-db0e-11ef-938e-a0d3651f611f"},{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":32,"tongjian_id":"8e89217e-db0e-11ef-8378-a0d3651f611f"},{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":47,"tongjian_id":"8e89217f-db0e-11ef-a65b-a0d3651f611f"},{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":51,"tongjian_id":"8e892180-db0e-11ef-9f18-a0d3651f611f"},{"people_name":"晉灼","people_name_jianti_auto":"晋灼","start_index":92,"tongjian_id":"8e892181-db0e-11ef-8be2-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":133,"tongjian_id":"8e892182-db0e-11ef-b26c-a0d3651f611f"},{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":148,"tongjian_id":"8e892183-db0e-11ef-8c2c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"高廟","place_name_jianti_auto":"高庙","start_index":5,"tongjian_id":"8e892184-db0e-11ef-a943-a0d3651f611f"},{"place_name":"高廟","place_name_jianti_auto":"高庙","start_index":99,"tongjian_id":"8e892185-db0e-11ef-acab-a0d3651f611f"},{"place_name":"長安城","place_name_jianti_auto":"长安城","start_index":102,"tongjian_id":"8e892186-db0e-11ef-9e7f-a0d3651f611f"},{"place_name":"桂宮","place_name_jianti_auto":"桂宫","start_index":111,"tongjian_id":"8e892187-db0e-11ef-9175-a0d3651f611f"},{"place_name":"高廟","place_name_jianti_auto":"高庙","start_index":158,"tongjian_id":"8e892188-db0e-11ef-984c-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":167,"tongjian_id":"8e892189-db0e-11ef-ba54-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"服虔曰：持高廟中衣冠，月旦以遊於衆廟，已而復之。應劭曰：月旦，出高帝衣冠，備法駕，名曰遊衣冠。如淳曰：高祖之衣冠藏在宮中之寢，三月出遊，其道正直今之所作複道下，故言「乘宗廟道上行」也。晉灼曰：黃圖：高廟在長安城門街東，寢在桂宮北；服言衣冠藏於廟中，如言宮中，皆非也。師古曰：諸家之說皆未允也。謂從高帝陵寢出，衣冠遊於高廟，每月一爲之，漢制則然。而後之學者不曉其意，謂以月出之時，夜遊衣冠，皆非也。","note_content_jianti_auto":"服虔曰：持高庙中衣冠，月旦以游于众庙，已而复之。应劭曰：月旦，出高帝衣冠，备法驾，名曰游衣冠。如淳曰：高祖之衣冠藏在宫中之寝，三月出游，其道正直今之所作复道下，故言「乘宗庙道上行」也。晋灼曰：黄图：高庙在长安城门街东，寝在桂宫北；服言衣冠藏于庙中，如言宫中，皆非也。师古曰：诸家之说皆未允也。谓从高帝陵寝出，衣冠游于高庙，每月一为之，汉制则然。而后之学者不晓其意，谓以月出之时，夜游衣冠，皆非也。","note_type":"hu_note","start_index":49,"tongjian_id":"8e89217b-db0e-11ef-b615-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"師古","people_name_jianti_auto":"师古","start_index":0,"tongjian_id":"8e89218d-db0e-11ef-b32d-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"師古曰：原，重也；先已有廟，今更立之，故云重也。","note_content_jianti_auto":"师古曰：原，重也；先已有庙，今更立之，故云重也。","note_type":"hu_note","start_index":102,"tongjian_id":"8e89218c-db0e-11ef-bf4b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8e892190-db0e-11ef-b2e7-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":27,"tongjian_id":"8e892191-db0e-11ef-bdb6-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":31,"tongjian_id":"8e892192-db0e-11ef-a84a-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：甲十五行本「月」上有「衣冠」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：甲十五行本「月」上有「衣冠」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8e89218f-db0e-11ef-bf83-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":103,"tongjian_id":"8e89218e-db0e-11ef-9aea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"鄭氏","people_name_jianti_auto":"郑氏","start_index":0,"tongjian_id":"8e892194-db0e-11ef-8407-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"鄭氏曰：廟之言貌也；死者精神不可得而見，但以生時之居，立宮室象貌爲之耳。孝經註：宗，尊也。廟，貌也。","note_content_jianti_auto":"郑氏曰：庙之言貌也；死者精神不可得而见，但以生时之居，立宫室象貌为之耳。孝经注：宗，尊也。庙，貌也。","note_type":"hu_note","start_index":127,"tongjian_id":"8e892193-db0e-11ef-9b0d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"奉常","official_note":"奉常是汉代九卿之一，掌管宗庙礼仪和祭祀事务，此处叔孙通以奉常身份进谏皇帝关于宗庙道路的问题，体现了其职责所在。","official_rank":"九卿之一","source_snippet":"奉常叔孫通諫曰","start_index":38,"tongjian_id":"0a7b1e36-2888-4daa-9f65-6be405313c2e"}],"ExtRef_Children_people":[{"link_td_description":"叔孙通，又名叔孙何，西汉初期儒家学者，曾协助汉高祖制订汉朝的宫廷礼仪，先后出任太常及太子太傅。","link_td_id":"Q10008825","link_td_number_id":387711,"people_name":"叔孫通","people_name_jianti_auto":"叔孙通","people_xingming":"叔孙通","start_index":30,"tongjian_id":"8e892197-db0e-11ef-8c13-a0d3651f611f"},{"link_death_year":-195,"link_td_description":"刘邦，字季，沛丰邑中阳里（今江苏省丰县）人，中国秦末汉初的军事家、政治家，中国汉朝（西汉）开国皇帝，也是中国历史上第一位平民（家世）出身的皇帝，参与以楚国为首的反秦起义，成为诸侯之一。在楚汉战争中，刘邦击败了西楚霸王项羽，统一了自秦朝灭亡后的天下，于公元前202年称帝，建立汉王朝。","link_td_id":"Q10000038","link_td_number_id":21913,"people_name":"高帝","people_name_jianti_auto":"高帝","people_xingming":"高帝","start_index":38,"tongjian_id":"8e892198-db0e-11ef-85c0-a0d3651f611f"},{"link_td_description":"叔孙通，又名叔孙何，西汉初期儒家学者，曾协助汉高祖制订汉朝的宫廷礼仪，先后出任太常及太子太傅。","link_td_id":"Q10008825","link_td_number_id":387711,"people_name":"通","people_name_jianti_auto":"通","people_xingming":"叔孙通","start_index":72,"tongjian_id":"8e892199-db0e-11ef-907e-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"長樂宮","place_name_jianti_auto":"长乐宫","resolved_place_entity_id":797,"start_index":7,"tongjian_id":"8e892196-db0e-11ef-af9c-a0d3651f611f"},{"place_name":"原廟","place_name_jianti_auto":"原庙","resolved_place_entity_id":4345,"start_index":97,"tongjian_id":"8e89219a-db0e-11ef-b19f-a0d3651f611f"},{"place_name":"渭","place_name_jianti_auto":"渭","resolved_place_entity_id":400,"start_index":99,"tongjian_id":"8e89219b-db0e-11ef-bb1a-a0d3651f611f"},{"place_name":"原廟","place_name_jianti_auto":"原庙","resolved_place_entity_id":4345,"start_index":124,"tongjian_id":"8e8b5766-db0e-11ef-80ad-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5帝以朝太后於長樂宮及間往，數蹕煩民。乃築複道於武庫南。奉常叔孫通諫曰：「此高帝月出遊衣冠之道也，子孫柰何乘宗廟道上行哉！」帝懼曰：「急壞之！」通曰：「人主無過舉；今已作，百姓皆知之矣。願陛下爲原廟渭北，月出遊之，益廣宗廟，大孝之本。」上乃詔有司立原廟。","content_fanyi":"惠帝因为去长乐宫朝见太后以及平时往来，屡次都要清道戒严，烦扰百姓。于是便在武库南面修筑了一条架空的复道。奉常叔孙通进谏说：“这是高帝每月出游衣冠所走的道路啊，子孙怎么能在宗庙道路的上空行走呢？”惠帝害怕地说：“赶快拆掉它！”叔孙通说：“君主不应有错误的举动；如今已经修成，百姓也都知道了。希望陛下在渭河北岸修建原庙，每月到那里举行高帝衣冠出巡的仪式，这样既扩充了宗庙，又是大孝的根本。”惠帝于是下诏命令有关官员建立原庙。","content_jianti_auto":"5帝以朝太后于长乐宫及间往，数跸烦民。乃筑复道于武库南。奉常叔孙通谏曰：「此高帝月出游衣冠之道也，子孙柰何乘宗庙道上行哉！」帝惧曰：「急坏之！」通曰：「人主无过举；今已作，百姓皆知之矣。愿陛下为原庙渭北，月出游之，益广宗庙，大孝之本。」上乃诏有司立原庙。","dtjl_paragraph_links":[],"dtjl_references":[],"id":972,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"8e892170-db0e-11ef-8a25-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"堯","people_name_jianti_auto":"尧","start_index":5,"tongjian_id":"8e8b79dc-db0e-11ef-a417-a0d3651f611f"},{"people_name":"賈誼","people_name_jianti_auto":"贾谊","start_index":12,"tongjian_id":"8e8b79dd-db0e-11ef-a000-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"三代","place_name_jianti_auto":"三代","start_index":16,"tongjian_id":"8e8b79de-db0e-11ef-80a6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"後漢書曰：堯置敢諫之鼓。賈誼曰：三代之君，則有進善之旌，誹謗之木，敢諫之鼓。","note_content_jianti_auto":"后汉书曰：尧置敢谏之鼓。贾谊曰：三代之君，则有进善之旌，诽谤之木，敢谏之鼓。","note_type":"hu_note","start_index":53,"tongjian_id":"8e8b5768-db0e-11ef-99a9-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8e8b79e0-db0e-11ef-9dde-a0d3651f611f"},{"link_td_description":"仲虺，又叫莱朱，是商汤时期的著名大臣。他与伊尹并为商汤左、右相，辅佐商汤完成大业。仲虺为奚仲之后，商汤之左相，居于薛。身为商汤的“左相”，仲虺在商代初年的政治中居于重要地位。仲虺作诰，在诰书中首次提出天子失德失天命之哲学思想。仲虺在政治上有一套自己的见解。","link_td_id":"Q10008242","link_td_number_id":154051,"people_name":"仲虺","people_name_jianti_auto":"仲虺","people_xingming":"仲虺","start_index":65,"tongjian_id":"8e8b79e1-db0e-11ef-82e6-a0d3651f611f"},{"link_birth_year":-1670,"link_death_year":-1587,"link_td_description":"商汤，商朝开国之君，子姓，名履。","link_td_id":"Q10000014","link_td_number_id":6813,"people_name":"成湯","people_name_jianti_auto":"成汤","people_xingming":"子天乙","start_index":68,"tongjian_id":"8e8b79e2-db0e-11ef-9bc4-a0d3651f611f","wl_zhushi":"[子天乙]"},{"link_td_description":"傅说，商代时古虞国（今山西省平陆县）人，商代政治家。其辅佐商王武丁治国，促成了“武丁中兴”，被认为是中国有史可考的第一个圣人。","link_td_id":"Q10003726","link_td_number_id":1086280,"people_name":"傅說","people_name_jianti_auto":"傅说","people_xingming":"傅说","start_index":79,"tongjian_id":"8e8b79e3-db0e-11ef-9945-a0d3651f611f"},{"link_birth_year":-1250,"link_death_year":-1192,"link_td_description":"武丁，子姓，根据《今本竹书纪年》名昭，多本史书记载他被周朝誉为高宗，是商朝第23位国君，共在位59年（约前1250年—前1192年在位）。他是商王敛（小乙）之子，商王旬（盘庚）、商王颂（小辛）的侄子。","link_td_id":"Q10000373","link_td_number_id":76036,"people_name":"高宗","people_name_jianti_auto":"高宗","people_xingming":"子武丁","start_index":82,"tongjian_id":"8e8b79e4-db0e-11ef-8bd2-a0d3651f611f","wl_zhushi":"[子武丁]"},{"link_td_description":"叔孙通，又名叔孙何，西汉初期儒家学者，曾协助汉高祖制订汉朝的宫廷礼仪，先后出任太常及太子太傅。","link_td_id":"Q10008825","link_td_number_id":387711,"people_name":"叔孫通","people_name_jianti_auto":"叔孙通","people_xingming":"叔孙通","start_index":122,"tongjian_id":"8e8b79e5-db0e-11ef-a52a-a0d3651f611f"},{"link_birth_year":-211,"link_death_year":-188,"link_td_description":"汉惠帝刘盈，汉朝开国皇帝汉高帝刘邦和皇后吕氏之子，汉朝皇帝，于前195年6月26日—前188年9月26日在位，在位7年，其正式谥号为“孝惠皇帝”。","link_td_id":"Q10000195","link_td_number_id":106737,"people_name":"孝惠","people_name_jianti_auto":"孝惠","people_xingming":"汉惠帝","start_index":126,"tongjian_id":"8e8b79e6-db0e-11ef-a838-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：過者，人之所必不免也；惟聖賢爲能知而改之。古之聖王，患其有過而不自知也，故設誹謗之木，置敢諫之鼓；豈畏百姓之聞其過哉！是以仲虺美成湯曰：「改過不吝。」傅說戒高宗曰：「無恥過作非。」由是觀之，則爲人君者，固不以無過爲賢，而以改過爲美也。今叔孫通諫孝惠，乃云「人主無過舉」，是敎人君以文過遂非也，豈不繆哉！","content_fanyi":"臣司马光说：过错，是人人都无法避免的；只有圣贤能够知道并改正它。古代圣明的帝王，担心自己有过错而不能自知，所以设置诽谤木，安放敢谏鼓；难道是怕百姓听到自己的过失吗！因此仲虺赞美商汤说：“改正过错毫不吝惜。”傅说告诫商高宗武丁说：“不要以有过错为耻而去做错事。”由此看来，作为君主，本来就不以没有过错为贤明，而以改正过错为美德。如今叔孙通劝谏汉惠帝，竟说“君主没有错误的举动”，这是教君主掩饰过错、将错就错，难道不荒谬吗！","content_jianti_auto":"臣光曰：过者，人之所必不免也；惟圣贤为能知而改之。古之圣王，患其有过而不自知也，故设诽谤之木，置敢谏之鼓；岂畏百姓之闻其过哉！是以仲虺美成汤曰：「改过不吝。」傅说戒高宗曰：「无耻过作非。」由是观之，则为人君者，固不以无过为贤，而以改过为美也。今叔孙通谏孝惠，乃云「人主无过举」，是教人君以文过遂非也，岂不缪哉！","dtjl_paragraph_links":[],"dtjl_references":[],"id":973,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8e8b5767-db0e-11ef-9912-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_an