_index":9,"tongjian_id":"c14b5ec7-8df6-4046-8906-5b76ae4a5be1"}],"ExtRef_Children_people":[{"link_death_year":81,"link_td_description":"鲍昱，字文渊，东汉上党郡屯留人。祖父鲍宣，祖母桓少君，父亲鲍永。曾任司隶校尉、汝南太守、司徒、太尉，建初六年六月去世，终年七十余岁。","link_td_id":"Q10007290","link_td_number_id":3510429,"people_name":"鮑昱","people_name_jianti_auto":"鲍昱","people_xingming":"鲍昱","start_index":11,"tongjian_id":"9543dfac-db0e-11ef-87cc-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2夏，六月，丙辰，太尉鮑昱薨。","content_fanyi":"夏季，六月十五日丙辰，太尉鲍昱去世。","content_jianti_auto":"2夏，六月，丙辰，太尉鲍昱薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3687,"number":2,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"9543dfab-db0e-11ef-9f00-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"3辛未晦，日有食之。","content_fanyi":"六月三十日辛未晦，发生日食。","content_jianti_auto":"3辛未晦，日有食之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3688,"number":3,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"9543dfad-db0e-11ef-a619-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"財政","official_name":"大司農","official_note":"大司農是漢代掌管國家財政、賦稅、倉儲等事務的中央官員，屬於九卿之一。在《資治通鑑》此處，鄧彪從大司農升任太尉，顯示其職務變動。","official_rank":"九卿之一（正三品）","source_snippet":"以大司農鄧彪爲太尉","start_index":10,"tongjian_id":"21f8dc36-ef38-46ea-a6b9-47ede4ebb1f3"},{"confidence":0.95,"official_category":"軍事指揮","official_name":"太尉","official_note":"太尉是漢代三公之一，主管全國軍事，為最高軍事長官。在此段中，鄧彪被任命為太尉，標誌其晉升至高級官職。","official_rank":"三公之一（正一品）","source_snippet":"以大司農鄧彪爲太尉","start_index":16,"tongjian_id":"1c56eb9b-26ae-42e0-905c-8ff743d82a7e"}],"ExtRef_Children_people":[{"link_death_year":93,"link_td_description":"邓彪，字智伯，南阳新野人，东汉大臣。鄳侯、勃海太守邓邯的儿子。","link_td_id":"Q10007379","link_td_number_id":1556322,"people_name":"鄧彪","people_name_jianti_auto":"邓彪","people_xingming":"邓彪","start_index":13,"tongjian_id":"9543dfaf-db0e-11ef-ae9d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、韶州府（卷一百）","excerpts":[{"context_after":"《舆地志》：皋石、太尉二山之间，是为浈阳峡，两崖杰秀，壁...","context_before":"...壁千仞，猿猴莫上。又西南二十二里，曰太尉山，一名香炉峡。","source_end_index":67,"source_paragraph_tongjian_id":"4b91e306-09c0-56b4-aa30-8b9b1b2f1515","source_start_index":50,"source_text":"汉邓彪尝至岭南，召还为太尉，因名。"}],"path":"广东方舆纪要/四、韶州府（卷一百）","source_name":"读史方舆纪要"}],"class_tags":["人事"],"content":"4秋，七月，癸巳，以大司農鄧彪爲太尉。","content_fanyi":"秋季，七月二十二日癸巳，朝廷任命大司农邓彪为太尉。","content_jianti_auto":"4秋，七月，癸巳，以大司农邓彪为太尉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3689,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"9543dfae-db0e-11ef-9cd3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"更，工衡翻。屬，之欲翻；聯也，聯日有火也。","note_content_jianti_auto":"更，工衡翻。属，之欲翻；联也，联日有火也。","note_type":"hu_note","start_index":48,"tongjian_id":"9543dfb1-db0e-11ef-8b48-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"廉范","people_name_jianti_auto":"廉范","start_index":0,"tongjian_id":"9543dfb3-db0e-11ef-b1a7-a0d3651f611f"},{"people_name":"叔度","people_name_jianti_auto":"叔度","start_index":4,"tongjian_id":"9543dfb4-db0e-11ef-9037-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"廉范，字叔度。","note_content_jianti_auto":"廉范，字叔度。","note_type":"hu_note","start_index":82,"tongjian_id":"9543dfb2-db0e-11ef-a4a0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"武都太守","official_note":"武都太守是汉代武都郡的最高行政长官，负责治理地方事务。在原文中，廉范从武都太守调任蜀郡太守，体现了官员的职务变动。","official_rank":"郡守级（约二千石）","source_snippet":"武都太守廉范遷蜀郡太守","start_index":0,"tongjian_id":"8e76f7e1-c34a-437f-a060-eac0c29a941e"},{"confidence":0.95,"official_category":"地方行政","official_name":"蜀郡太守","official_note":"蜀郡太守是汉代蜀郡的最高行政长官，管理成都等地区。在原文中，廉范调任此职，负责成都的治理，并改革防火制度。","official_rank":"郡守级（约二千石）","source_snippet":"武都太守廉范遷蜀郡太守","start_index":6,"tongjian_id":"e6455341-cbbf-47dc-8533-bf7fbbc5d9d9"}],"ExtRef_Children_people":[{"link_td_description":"廉范，字叔度，京兆杜陵人，东汉政治人物。赵国名将廉颇的后裔子孙。","link_td_id":"Q10007438","link_td_number_id":862735,"people_name":"廉范","people_name_jianti_auto":"廉范","people_xingming":"廉范","start_index":5,"tongjian_id":"9543dfb8-db0e-11ef-b4c3-a0d3651f611f"},{"link_td_description":"廉范，字叔度，京兆杜陵人，东汉政治人物。赵国名将廉颇的后裔子孙。","link_td_id":"Q10007438","link_td_number_id":862735,"people_name":"范","people_name_jianti_auto":"范","people_xingming":"廉范","start_index":48,"tongjian_id":"9543dfbc-db0e-11ef-b4aa-a0d3651f611f"},{"link_td_description":"廉范，字叔度，京兆杜陵人，东汉政治人物。赵国名将廉颇的后裔子孙。","link_td_id":"Q10007438","link_td_number_id":862735,"people_name":"廉叔度","people_name_jianti_auto":"廉叔度","people_xingming":"廉范","start_index":74,"tongjian_id":"9543dfbd-db0e-11ef-9b5a-a0d3651f611f"}],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9543dfb0-db0e-11ef-be5a-a0d3651f611f","pinyin":"rú","source_anchor_text":"安作昔無襦今五絝帝","source_key":"baiyang_epub","start_index":92,"text":"襦","tongjian_id":"dd8a0ee1-f3ab-5869-b32d-19fa0be970db"},{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9543dfb0-db0e-11ef-be5a-a0d3651f611f","pinyin":"kù","source_anchor_text":"無襦今五絝帝以沛王","source_key":"baiyang_epub","start_index":96,"text":"絝","tongjian_id":"61dda1cf-2273-555d-9c85-9e213cbfbe70"}],"ExtRef_Children_places":[{"place_name":"武都","place_name_jianti_auto":"武都","resolved_place_entity_id":783,"start_index":1,"tongjian_id":"9543dfb9-db0e-11ef-b571-a0d3651f611f"},{"place_name":"蜀郡","place_name_jianti_auto":"蜀郡","resolved_place_entity_id":38,"start_index":8,"tongjian_id":"9543dfba-db0e-11ef-9617-a0d3651f611f"},{"place_name":"成都","place_name_jianti_auto":"成都","resolved_place_entity_id":182,"start_index":13,"tongjian_id":"9543dfbb-db0e-11ef-a45e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"5武都太守廉范遷蜀郡太守。成都民物豐盛，邑宇逼側，舊制，禁民夜作以防火災，而更相隱蔽，燒者日屬。范乃毀削先令，但嚴使儲水而已。百姓以爲便，歌之曰：「廉叔度，來何暮！不禁火，民安作。昔無襦，今五絝。」","content_fanyi":"武都太守廉范升任蜀郡太守。成都人口众多，物产丰盛，房屋彼此紧挨，旧时制度规定禁止百姓夜间劳作以防止火灾，但百姓互相隐瞒，暗中点灯干活，火灾一天连着一天。廉范于是取消原先的禁令，只严格要求百姓储水防火而已。百姓感到便利，作歌称颂他说：“廉叔度，为何来得这样晚！不禁止用火，百姓安心劳作。从前连上衣都没得穿，如今裤子都有五条。”","content_jianti_auto":"5武都太守廉范迁蜀郡太守。成都民物丰盛，邑宇逼侧，旧制，禁民夜作以防火灾，而更相隐蔽，烧者日属。范乃毁削先令，但严使储水而已。百姓以为便，歌之曰：「廉叔度，来何暮！不禁火，民安作。昔无襦，今五绔。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":3690,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9543dfb0-db0e-11ef-be5a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"丁零國","place_name_jianti_auto":"丁零国","start_index":13,"tongjian_id":"9543dfc0-db0e-11ef-8f75-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"說文曰：貂鼠大而黃黑，出胡丁零國。","note_content_jianti_auto":"说文曰：貂鼠大而黄黑，出胡丁零国。","note_type":"hu_note","start_index":16,"tongjian_id":"9543dfbf-db0e-11ef-af94-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"謁者","official_note":"謁者是汉代负责传达、接待的官员，此处表示派遣謁者去赐予物品，体现了皇帝的恩宠和礼仪安排。","official_rank":"未知","source_snippet":"遣謁者賜貂裘及太官食物、珍果","start_index":12,"tongjian_id":"0ba793db-9a8c-4a4c-b4fb-eac6da03ef68"},{"confidence":0.85,"official_category":"宫廷服务","official_name":"太官","official_note":"太官是汉代掌管宫廷饮食的官员，此处表示赐予的食物来自太官，显示了皇帝的赏赐规格。","official_rank":"未知","source_snippet":"太官食物、珍果","start_index":18,"tongjian_id":"7f2da83e-1b96-4d7b-87bd-fd70ca4af6ca"},{"confidence":0.95,"official_category":"礼仪外交","official_name":"大鴻臚","official_note":"大鴻臚是汉代负责诸侯、外宾礼仪和接待的官员，此处表示派遣大鴻臚竇固持节去郊外迎接，体现了对沛王等入朝的重视和礼仪程序。","official_rank":"九卿之一","source_snippet":"又使大鴻臚竇固持節郊迎","start_index":28,"tongjian_id":"acf6d215-da5e-48fc-8d82-f4ad6ab6a4ec"}],"ExtRef_Children_people":[{"link_birth_year":16,"link_death_year":84,"link_td_description":"刘辅，东汉光武帝的次子，生母是郭圣通。","link_td_id":"Q10005077","link_td_number_id":1566275,"people_name":"沛王","people_name_jianti_auto":"沛王","people_xingming":"刘辅","start_index":3,"tongjian_id":"9543dfc4-db0e-11ef-834f-a0d3651f611f"},{"link_death_year":88,"link_td_description":"窦固，字孟孙，扶风平陵（今陕西咸阳西北）人，窦融弟窦友之子，娶光武帝女涅阳公主。","link_td_id":"Q10000612","link_td_number_id":325821,"people_name":"竇固","people_name_jianti_auto":"窦固","people_xingming":"窦固","start_index":30,"tongjian_id":"9543dfc5-db0e-11ef-a557-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6帝以沛王等將入朝，遣謁者賜貂裘及太官食物、珍果，又使大鴻臚竇固持節郊迎。帝親自循行邸第，豫設帷牀，其錢帛、器物無不充備。","content_fanyi":"汉章帝因为沛王刘辅等人将要入朝，派谒者赐给他们貂裘以及太官供应的食物、珍奇果品，又派大鸿胪窦固持节到京城郊外迎接。汉章帝亲自巡视各封国在京城的府第，预先陈设帷帐、床榻，其中钱帛、器物无不齐备。","content_jianti_auto":"6帝以沛王等将入朝，遣谒者赐貂裘及太官食物、珍果，又使大鸿胪窦固持节郊迎。帝亲自循行邸第，豫设帷床，其钱帛、器物无不充备。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3691,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"9543dfbe-db0e-11ef-8711-a0d3651f611f"}],"reign_name":"六年","reign_name_jianti_auto":"六年","start_index":5,"tongjian_id":"9543dfa6-db0e-11ef-8223-a0d3651f611f","year_anno":"（辛巳、八一）","year_int":81},"message":"success","success":true}