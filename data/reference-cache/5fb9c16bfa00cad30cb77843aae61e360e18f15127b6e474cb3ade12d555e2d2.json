_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"索，盡也。愔，於今翻。索，昔各翻。","note_content_jianti_auto":"索，尽也。愔，于今翻。索，昔各翻。","note_type":"hu_note","start_index":126,"tongjian_id":"94e0c0a0-db0e-11ef-b8ce-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"94e0c0a2-db0e-11ef-b7bd-a0d3651f611f"},{"people_name":"援","people_name_jianti_auto":"援","start_index":30,"tongjian_id":"94e0c0a3-db0e-11ef-8454-a0d3651f611f"},{"people_name":"耿舒","people_name_jianti_auto":"耿舒","start_index":34,"tongjian_id":"94e0c0a4-db0e-11ef-b107-a0d3651f611f"},{"people_name":"梁松","people_name_jianti_auto":"梁松","start_index":42,"tongjian_id":"94e0c0a5-db0e-11ef-a0f7-a0d3651f611f"},{"people_name":"竇固","people_name_jianti_auto":"窦固","start_index":45,"tongjian_id":"94e0c0a6-db0e-11ef-be2a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：長者家兒，謂權要子弟等。介介，猶耿耿也。余謂調，和也。援固已慮耿舒之難與共事，梁松、竇固之邇言矣。惡，烏路翻。","note_content_jianti_auto":"贤曰：长者家儿，谓权要子弟等。介介，犹耿耿也。余谓调，和也。援固已虑耿舒之难与共事，梁松、窦固之迩言矣。恶，乌路翻。","note_type":"hu_note","start_index":173,"tongjian_id":"94e0c0a1-db0e-11ef-b986-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"謁者","official_note":"謁者是汉代官职，负责传达诏命、引见宾客等，此处表示派遣謁者李嵩参与讨伐武陵蛮。","official_rank":"未知","source_snippet":"遣謁者李嵩","start_index":12,"tongjian_id":"f0ea09b5-2436-46a4-a0ea-545e74046465"},{"confidence":0.95,"official_category":"地方行政","official_name":"中山太守","official_note":"中山太守是汉代地方官职，掌管中山郡的行政事务，此处表示中山太守馬成参与讨伐武陵蛮。","official_rank":"郡守级","source_snippet":"中山太守馬成","start_index":17,"tongjian_id":"25c91b11-24d4-4e5f-8fc0-333f4c2c8379"},{"confidence":0.9,"o