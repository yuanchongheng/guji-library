place_name_jianti_auto":"常山","start_index":56,"tongjian_id":"8fe8d6c2-db0e-11ef-b4e1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"華山、嵩高，本在天子之郡。南嶽霍山屬廬江，淮南、衡山謀反，國除，入漢爲郡。元狩元年，濟北王獻太山及其旁邑。今又以常山爲郡，然後皆在天子之邦。","note_content_jianti_auto":"华山、嵩高，本在天子之郡。南岳霍山属庐江，淮南、衡山谋反，国除，入汉为郡。元狩元年，济北王献太山及其旁邑。今又以常山为郡，然后皆在天子之邦。","note_type":"hu_note","start_index":65,"tongjian_id":"8fe8d6b7-db0e-11ef-ac63-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":-114,"link_td_description":"刘舜，西汉孝景帝刘启第十四子，母亲为王儿姁，大姨是王皇后。谥为常山宪王。","link_td_id":"Q10008602","link_td_number_id":346476,"people_name":"常山憲王","people_name_jianti_auto":"常山宪王","people_xingming":"刘舜","start_index":1,"tongjian_id":"8fe8d6c3-db0e-11ef-95ef-a0d3651f611f"},{"link_death_year":-114,"link_td_description":"刘舜，西汉孝景帝刘启第十四子，母亲为王儿姁，大姨是王皇后。谥为常山宪王。","link_td_id":"Q10008602","link_td_number_id":346476,"people_name":"舜","people_name_jianti_auto":"舜","people_xingming":"刘舜","start_index":5,"tongjian_id":"8fe8d6c4-db0e-11ef-a05b-a0d3651f611f"},{"people_name":"勃","people_name_jianti_auto":"勃","people_xingming":"刘勃","start_index":9,"tongjian_id":"8fe8d6c5-db0e-11ef-8a1b-a0d3651f611f"},{"link_death_year":-114,"link_td_description":"刘舜，西汉孝景帝刘启第十四子，母亲为王儿姁，大姨是王皇后。谥为常山宪王。","link_td_id":"Q10008602","link_td_number_id":346476,"people_name":"憲王","people_name_jianti_auto":"宪王","people_xingming":"刘舜","start_index":13,"tongjian_id":"8fe8d6c6-db0e-11ef-a604-a0d3651f611f","wl_zhushi":"[刘舜]"},{"link_death_year":-114,"link_td_description":"刘舜，西汉孝景帝刘启第十四子，母亲为王儿姁，大姨是王皇后。谥为常山宪王。","link_td_id":"Q10008602","link_td_number_id":346476,"people_name":"憲王","people_name_jianti_auto":"宪王","people_xingming":"刘舜","start_index":38,"tongjian_id":"8fe8d6c8-db0e-11ef-9a37-a0d3651f611f","wl_zhushi":"[刘舜]"},{"link_death_year":-90,"link_td_description":"刘平，西汉宗室，即真定顷王。汉景帝孙，常山宪王刘舜庶子。","link_td_id":"Q10019755","link_td_number_id":6006524,"people_name":"平","people_name_jianti_auto":"平",