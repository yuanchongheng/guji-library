3651f611f"},{"place_name":"東平","place_name_jianti_auto":"东平","resolved_place_entity_id":735,"start_index":49,"tongjian_id":"9518396e-db0e-11ef-aa6a-a0d3651f611f"},{"place_name":"大梁","place_name_jianti_auto":"大梁","resolved_place_entity_id":236,"start_index":52,"tongjian_id":"9518396f-db0e-11ef-a40c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、淮安府（卷二十二）","excerpts":[{"context_after":"十七年，改置下邳国于此。建安初，先主为徐州牧，屯下邳，吕...","context_before":"...董宪等保下邳，既而去下邳，还兰陵。五年，帝徇彭城、下邳。","source_end_index":198,"source_paragraph_tongjian_id":"f0f72551-46ae-5547-9f6e-1cf464d4d188","source_start_index":184,"source_text":"永平十五年，东巡，耕于下邳。"}],"path":"南直方舆纪要/三、淮安府（卷二十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"元和二年，幸鲁，祀孔子于阙里。延光二年，亦幸鲁。隋曰曲阜...","context_before":"...楚。秦为薛郡治，义帝尝封项羽为鲁公。后汉建武五年，幸鲁。","source_end_index":175,"source_paragraph_tongjian_id":"3af32d51-525d-5f66-8f8c-ac2f4c3cbd8d","source_start_index":161,"source_text":"永平十五年，至鲁，幸孔子宅。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1春，二月，庚子，上東巡。癸亥，耕于下邳。三月，至魯，幸孔子宅，親御講堂，命皇太子、諸王說經；又幸東平、大梁。夏，四月，庚子，還宮。","content_fanyi":"春季，二月初四日庚子，汉明帝到东方巡视。二月二十七日癸亥，他在下邳县亲自耕作。三月，到达鲁地，来到孔子故居，亲临孔子当年的讲堂，命令皇太子刘炟和诸亲王解说经书；又临幸东平、大梁。夏季，四月初五日庚子，汉明帝返回宫中。","content_jianti_auto":"1春，二月，庚子，上东巡。癸亥，耕于下邳。三月，至鲁，幸孔子宅，亲御讲堂，命皇太子、诸王说经；又幸东平、大梁。夏，四月，庚子，还宫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3601,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9518395b-db0e-11ef-9850-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"樂成國","place_name_jianti_auto":"乐成国","start_index":0,"tongjian_id":"95183973-db0e-1