tongjian_id":"96cd6b9e-db0e-11ef-9617-a0d3651f611f"},{"people_name":"庭堅","people_name_jianti_auto":"庭坚","start_index":202,"tongjian_id":"96cd6b9f-db0e-11ef-ba87-a0d3651f611f"},{"people_name":"仲容","people_name_jianti_auto":"仲容","start_index":205,"tongjian_id":"96cd6ba0-db0e-11ef-9e12-a0d3651f611f"},{"people_name":"叔達","people_name_jianti_auto":"叔达","start_index":208,"tongjian_id":"96cd6ba1-db0e-11ef-976c-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":229,"tongjian_id":"96cd6ba2-db0e-11ef-a8a3-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":240,"tongjian_id":"96cd6ba3-db0e-11ef-8607-a0d3651f611f"},{"people_name":"韋昭","people_name_jianti_auto":"韦昭","start_index":251,"tongjian_id":"96cd6ba4-db0e-11ef-9276-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":4,"tongjian_id":"96cd6ba5-db0e-11ef-a3c5-a0d3651f611f"},{"place_name":"西豪里","place_name_jianti_auto":"西豪里","start_index":20,"tongjian_id":"96cd6ba6-db0e-11ef-a585-a0d3651f611f"},{"place_name":"潁陰縣","place_name_jianti_auto":"颍阴县","start_index":30,"tongjian_id":"96cd6ba7-db0e-11ef-9889-a0d3651f611f"},{"place_name":"汝南郡","place_name_jianti_auto":"汝南郡","start_index":35,"tongjian_id":"96cd6ba8-db0e-11ef-830a-a0d3651f611f"},{"place_name":"商","place_name_jianti_auto":"商","start_index":48,"tongjian_id":"96cd6ba9-db0e-11ef-b918-a0d3651f611f"},{"place_name":"苑","place_name_jianti_auto":"苑","start_index":57,"tongjian_id":"96cd6baa-db0e-11ef-8e78-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":67,"tongjian_id":"96cd6bab-db0e-11ef-b8af-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":97,"tongjian_id":"96cd6bac-db0e-11ef-a0d3-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":134,"tongjian_id":"96cd6bad-db0e-11ef-985b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜佑曰：潁川郡城西南有荀淑故宅，相傳云卽西豪里。更，工衡翻。潁陰縣，屬汝南郡。淑，縣人也。姓譜：商武丁子子文受封於苑，因以爲氏。左傳有齊大夫苑何忌。趙明誠金石錄有漢荊州從事苑鎭碑曰：其先苑柏何爲晉樂正，世掌朝禮；又有苑子園，實能掌陰陽之理：皆其冑也。按姓氏志皆以爲出於齊大夫苑何忌之後。今此碑所謂苑柏何與子園，左傳、國語皆無其人；故錄之以待知者。左傳曰：昔高陽氏有才子八人：蒼舒、隤敱、檮戭、大臨、厖降、庭堅、仲容、叔達。隤，徒回翻。敱，五才翻，一音五回翻；韋昭音瑰。檮，直由翻；韋昭音桃。戭，以善翻；韋昭以震翻。厖，莫江翻。降，下江翻。","note_content_jianti_auto":"杜佑曰：颍川郡城西南有荀淑故宅，相传云即西豪里。更，工衡翻。颍阴县，属汝南郡。淑，县人也。姓谱：商武丁子子文受封于苑，因以为氏。左传有齐大夫苑何忌。赵明诚金石录有汉荆州从事苑镇碑曰：其先苑柏何为晋乐正，世掌朝礼；又有苑子园，实能掌阴阳之理：皆其胄也。按姓氏志皆以为出于齐大夫苑何忌之后。今此碑所谓苑柏何与子园，左传、国语皆无其人；故录之以待知者。左传曰：昔高阳氏有才子八人：苍舒、𬯎敱、梼戭、大临、厖降、庭坚、仲容、叔达。𬯎，徒回翻。敱，五才翻，一音五回翻；韦昭音瑰。梼，直由翻；韦昭音桃。戭，以善翻；韦昭以震翻。厖，莫江翻。降，下江翻。","note_type":"hu_note","start_index":118,"tongjian_id":"96cd6b8c-db0e-11ef-8484-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁陰","place_name_jianti_auto":"颍阴","resolved_place_entity_id":3326,"start_index":90,"tongjian_id":"96ced48e-db0e-11ef-8f09-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"7是歲，前朗陵侯相荀淑卒。淑少博學有高行，當世名賢李固、李膺皆師宗之。在朗陵，涖事明治，稱爲神君。有子八人：儉、緄、靖、燾、汪、爽、肅、專，並有名稱，時人謂之八龍。所居里舊名西豪，潁陰令渤海苑康以爲昔高陽氏有才子八人，更命其里曰高陽里。","content_fanyi":"这一年，前任朗陵侯国相荀淑去世。荀淑年轻时学问渊博，品德高尚，当代著名贤士李固、李膺都把他当作老师来尊崇。他在朗陵侯国任职时，处理政事明察公正，被称为神君。他有八个儿子：荀俭、荀绲、荀靖、荀焘、荀汪、荀爽、荀肃、荀专，都很有名声，当时人称之为“八龙”。荀淑所居住的里，旧名西豪，颍阴县令渤海人苑康认为从前高阳氏有八个才子，于是把该里改名为高阳里。","content_jianti_auto":"7是岁，前朗陵侯相荀淑卒。淑少博学有高行，当世名贤李固、李膺皆师宗之。在朗陵，涖事明治，称为神君。有子八人：俭、绲、靖、焘、汪、爽、肃、专，并有名称，时人谓之八龙。所居里旧名西豪，颍阴令渤海苑康以为昔高阳氏有才子八人，更命其里曰高阳里。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4511,"number":7,"path":"资治通鉴 : 卷第五十三 (漢紀四十五) / 孝桓皇帝上之上 / 三年 / 第 7 段","reading_annotation_sources":[],"start_index":6,"tongjian_id":"96cd6b83-db0e-11ef-bc89-a0d3651f611f","year_int":149},"tongjian_id":"96cd6b83-db0e-11ef-bc89-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"潁陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"共，相與也。","note_content_jianti_auto":"共，相与也。","note_type":"hu_note","start_index":27,"tongjian_id":"9946781a-db0e-11ef-bae0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"潁陰","place_name_jianti_auto":"颍阴","resolved_place_entity_id":3326,"start_index":8,"tongjian_id":"9946781f-db0e-11ef-8bbb-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"晋属河南郡。大兴三年，郭诵保阳翟，石勒将石生屡攻之，不能...","context_before":"...仍为颍川郡治。后汉光和七年，皇甫嵩等破黄巾贼波才于阳翟。","source_end_index":256,"source_paragraph_tongjian_id":"b3150123-8266-5d64-af2a-a2acbc28d9d6","source_start_index":241,"source_text":"建安十三年，曹操使乐进屯阳翟。"},{"context_after":"，曹魏典农都尉治焉。魏明帝封侍中辛毗为侯邑。晋亦曰颍阴县...","context_before":"...婴为侯邑，有灌台，今曰思故台。更始二年，封宗佻为颍阴王。","source_end_index":68,"source_paragraph_tongjian_id":"36b3590e-e3da-525d-8635-57f5d32ace52","source_start_index":54,"source_text":"建安十三年，曹操使于禁屯颍阴"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"遼在長社，于禁屯潁陰，樂進屯陽翟，三將任氣，多共不協。操使司空主簿趙儼幷參三軍，每事訓諭，遂相親睦。","content_fanyi":"张辽驻守长社，于禁屯驻颍阴，乐进屯驻阳翟，三位将领都意气用事，彼此之间多有不合。曹操派司空主簿赵俨同时参理三军军务，每遇事情便加以训导劝解，于是三人关系亲密和睦。","content_jianti_auto":"辽在长社，于禁屯颍阴，乐进屯阳翟，三将任气，多共不协。操使司空主簿赵俨幷参三军，每事训谕，遂相亲睦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":5610,"path":"资治通鉴 : 卷第六十五 (漢紀五十七) / 孝獻皇帝庚 / 十三年 / 第 11 段","reading_annotation_sources":[],"start_index":10,"tongjian_id":"99467819-db0e-11ef-b2f6-a0d3651f611f","year_int":208},"tongjian_id":"99467819-db0e-11ef-b2f6-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"潁陰","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"陽翟縣","place_name_jianti_auto":"阳翟县","start_index":0,"tongjian_id":"9d7bb660-db0e-11ef-b4a9-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":4,"tongjian_id":"9d7bb661-db0e-11ef-a6ce-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":6,"tongjian_id":"9d7bb662-db0e-11ef-9e45-a0d3651f611f"},{"place_name":"晉","place_name_jianti_auto":"晋","start_index":10,"tongjian_id":"9d7bb663-db0e-11ef-a455-a0d3651f611f"},{"place_name":"河南郡","place_name_jianti_auto":"河南郡","start_index":12,"tongjian_id":"9d7bb664-db0e-11ef-9b54-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陽翟縣，漢屬潁川郡，晉屬河南郡。","note_content_jianti_auto":"阳翟县，汉属颍川郡，晋属河南郡。","note_type":"hu_note","start_index":9,"tongjian_id":"9d7bb65f-db0e-11ef-a84f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"潁陰縣","place_name_jianti_auto":"颍阴县","start_index":0,"tongjian_id":"9d7bb666-db0e-11ef-ba78-a0d3651f611f"},{"place_name":"潁川郡","place_name_jianti_auto":"颍川郡","start_index":5,"tongjian_id":"9d7bb667-db0e-11ef-ac33-a0d3651f611f"},{"place_name":"潁陰","place_name_jianti_auto":"颍阴","start_index":9,"tongjian_id":"9d7bb668-db0e-11ef-b527-a0d3651f611f"},{"place_name":"陽翟","place_name_jianti_auto":"阳翟","start_index":12,"tongjian_id":"9d7bb669-db0e-11ef-9d40-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"潁陰縣，在潁川郡，潁陰去陽翟四十里。","note_content_jianti_auto":"颍阴县，在颍川郡，颍阴去阳翟四十里。","note_type":"hu_note","start_index":24,"tongjian_id":"9d7bb665-db0e-11ef-92a9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"河北","place_name_jianti_auto":"河北","start_index":2,"tongjian_id":"9d7bb66c-db0e-11ef-b22b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"欲召河北之軍還以自衞。","note_content_jianti_auto":"欲召河北之军还以自衞。","note_type":"hu_note","start_index":99,"tongjian_id":"9d7bb66b-db0e-11ef-9e27-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"潁水","place_name_jianti_auto":"颍水","start_index":0,"tongjian_id":"9d7bb66f-db0e-11ef-87ef-a0d3651f611f"},{"place_name":"潁川","place_name_jianti_auto":"颍川","start_index":3,"tongjian_id":"9d7bb670-db0e-11ef-8839-a0d3651f611f"},{"place_name":"陽城縣","place_name_jianti_auto":"阳城县","start_index":5,"tongjian_id":"9d7bb671-db0e-11ef-9330-a0d3651f611f"},{"place_name":"少室","place_name_jianti_auto":"少室","start_index":8,"tongjian_id":"9d7bb672-db0e-11ef-95b5-a0d3651f611f"},{"place_name":"陽翟縣","place_name_jianti_auto":"阳翟县","start_index":16,"tongjian_id":"9d7bb673-db0e-11ef-b888-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"潁水出潁川陽城縣少室，東南流，過陽翟縣之北。帥，讀曰率；下同。","note_content_jianti_auto":"颍水出颍川阳城县少室，东南流，过阳翟县之北。帅，读曰率；下同。","note_type":"hu_note","start_index":125,"tongjian_id":"9d7bb66e-db0e-11ef-b59d-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9d7bb65e-db0e-11ef-b796-a0d3651f611f","pinyin":"dí","source_anchor_text":"等進據陽翟與齊王冏","source_key":"baiyang_epub","start_index":7,"text":"翟","tongjian_id":"34273d97-9f3c-57a1-83f8-63212d27a29b"}],"ExtRef_Children_places":[{"place_name":"潁陰","place_name_jianti_auto":"颍阴","resolved_place_entity_id":3326,"start_index":21,"tongjian_id":"9d7bb679-db0e-11ef-b0f6-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、开封府（卷四十七）","excerpts":[{"context_after":"后魏仍为颍阴县，属颍川郡。东魏武定七年，改颍州曰郑州，移...","context_before":"...治焉。魏明帝封侍中辛毗为侯邑。晋亦曰颍阴县，仍属颍川郡。","source_end_index":154,"source_paragraph_tongjian_id":"36b3590e-e3da-525d-8635-57f5d32ace52","source_start_index":103,"source_text":"永康二年，赵王伦篡逆，齐王冏起兵许昌讨伦。伦遣其党张泓等拒冏，进据阳翟，冏军颍阴，泓乘胜济颍，攻冏营。"}],"path":"河南方舆纪要/一、开封府（卷四十七）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"7張泓等進據陽翟，與齊王冏戰，屢破之。冏軍潁陰，夏，四月，泓乘勝逼之，冏遣兵逆戰。諸軍不動，而孫輔、徐建軍夜亂，徑歸洛自首曰：「齊王兵盛，不可當，泓等已沒矣！」趙王倫大恐，祕之，而召其子虔及許超還。會泓破冏露布至，倫乃復遣之。泓等悉帥諸軍濟潁攻冏營，冏出兵擊其別將孫髦、司馬譚等，破之，泓等乃退。孫秀詐稱已破冏營，擒得冏，令百官皆賀。","content_fanyi":"张泓等人进占阳翟，与齐王司马冏交战，接连击败司马冏。司马冏领兵驻于颍阴，夏季四月，张泓乘胜逼近，司马冏派兵迎敌。司马伦的各路兵马都按兵不动，孙辅、徐建的部队却在夜间发生溃乱，径直逃回洛阳自首说：“齐王兵势强盛，难以抵挡，张泓等人已经覆没了！”赵王司马伦大为惊恐，隐瞒此事，并召回他的儿子司马虔和许超。这时张泓击败司马冏的露布刚好送到，司马伦才又重新派他们前去。张泓等人尽率各军渡过颍水攻打司马冏的营垒，司马冏出兵攻击张泓的别将孙髦、司马谭等人，将他们击败，张泓等人这才退走。孙秀假称已攻破司马冏的营垒，擒获司马冏，命令百官都来祝贺。","content_jianti_auto":"7张泓等进据阳翟，与齐王冏战，屡破之。冏军颍阴，夏，四月，泓乘胜逼之，冏遣兵逆战。诸军不动，而孙辅、徐建军夜乱，径归洛自首曰：「齐王兵盛，不可当，泓等已没矣！」赵王伦大恐，秘之，而召其子虔及许超还。会泓破冏露布至，伦乃复遣之。泓等悉帅诸军济颍攻冏营，冏出兵击其别将孙髦、司马谭等，破之，泓等乃退。孙秀诈称已破冏营，擒得冏，令百官皆贺。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7176,"number":7,"path":"资治通鉴 : 卷第八十四 (晉紀六) / 孝惠皇帝中之上 / 永寧元年 / 第 21 段","reading_annotation_sources":[],"start_index":20,"tongjian_id":"9d7bb65e-db0e-11ef-b796-a0d3651f611f","year_int":301},"tongjian_id":"9d7bb65e-db0e-11ef-b796-a0d3651f611f"},"paragraph_order":4}],"page_size":10,"total_pages":1,"total_paragraphs":4},"place_name":"潁陰"},"message":"success","success":true}