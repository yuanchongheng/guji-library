_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"衷，中心；適也。","note_content_jianti_auto":"衷，中心；适也。","note_type":"hu_note","start_index":131,"tongjian_id":"9480dbb5-db0e-11ef-8e8d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高帝","people_name_jianti_auto":"高帝","start_index":0,"tongjian_id":"9480dbb7-db0e-11ef-9922-a0d3651f611f"},{"people_name":"蕭何","people_name_jianti_auto":"萧何","start_index":11,"tongjian_id":"9480dbb8-db0e-11ef-ac39-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"關","place_name_jianti_auto":"关","start_index":3,"tongjian_id":"9480dbb9-db0e-11ef-b823-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高帝入關，約法三章，後蕭何定律九章。","note_content_jianti_auto":"高帝入关，约法三章，后萧何定律九章。","note_type":"hu_note","start_index":146,"tongjian_id":"9480dbb6-db0e-11ef-93a0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"文帝","people_name_jianti_auto":"文帝","start_index":0,"tongjian_id":"9480dbbb-db0e-11ef-a539-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"文帝元年，除收孥相坐法；十三年，除肉刑。","note_content_jianti_auto":"文帝元年，除收孥相坐法；十三年，除肉刑。","note_type":"hu_note","start_index":159,"tongjian_id":"9480dbba-db0e-11ef-bc9e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":6,"chapter_name":"考证篇第六","chenzhu_chapter":"胡注长于地理及考证，今日学者无不知。书名《表微》，非微何必表也？曰：考证为史学方法之一，欲实事求是，非考证不可。彼毕生从事考证，以为尽史学之能事者固非；薄视考证以为不足道者，亦未必是也。兹特辑存数十条，以备史学之一法，固知非大义微言所在也。","chenzhu_index_in_chapter":8,"chenzhu_text":"史略不载，即以梁统疏为证，并可以补史之略。","created_at":"2025-12-31 08:50:44","seq_in_chapter":25,"tongjian_id":"CH06-CZ008"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"統","people_name_jianti_auto":"统","start_index":12,"tongjian_id":"9480dbbe-db0e-11ef-b738-a0d3651f611f"},{"people_name":"嘉","people_name_jianti_auto":"嘉","start_index":14,"tongjian_id":"9480dbbf-db0e-11ef-9638-a0d3651f611f"},{"people_name":"班固","people_name_jianti_auto":"班固","start_index":28,"tongjian_id":"9480dbc0-db0e-11ef-822e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按嘉傳及刑法志並無其事，統與嘉時代相接，所引固不妄矣，但班固略而不載也。","note_content_jianti_auto":"按嘉传及刑法志并无其事，统与嘉时代相接，所引固不妄矣，但班固略而不载也。","note_type":"hu_note","start_index":202,"tongjian_id":"9480dbbd-db0e-11ef-8ba3-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"體，政體也。傅，音附。","note_content_jianti_auto":"体，政体也。傅，音附。","note_type":"hu_note","start_index":237,"tongjian_id":"9480dbc4-db0e-11ef-9d59-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"老子曰：法令滋章，盜賊多有。","note_content_jianti_auto":"老子曰：法令滋章，盗贼多有。","note_type":"hu_note","start_index":296,"tongjian_id":"9480dbc6-db0e-11ef-8edb-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"9480dbc9-db0e-11ef-8320-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：遁，猶回避也。前書曰：上下相匿，以文避法焉。","note_content_jianti_auto":"贤曰：遁，犹回避也。前书曰：上下相匿，以文避法焉。","note_type":"hu_note","start_index":342,"tongjian_id":"9480dbc8-d