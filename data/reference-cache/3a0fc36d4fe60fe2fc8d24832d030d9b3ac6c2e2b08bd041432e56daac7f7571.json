paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":0,"tongjian_id":"9f7f7c47-db0e-11ef-b022-a0d3651f611f"},{"place_name":"朔州","place_name_jianti_auto":"朔州","start_index":4,"tongjian_id":"9f7f7c48-db0e-11ef-afe1-a0d3651f611f"},{"place_name":"朔州","place_name_jianti_auto":"朔州","start_index":9,"tongjian_id":"9f7f7c49-db0e-11ef-85ad-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"晉未嘗置朔州；此罷朔州，未知誰所置也。","note_content_jianti_auto":"晋未尝置朔州；此罢朔州，未知谁所置也。","note_type":"hu_note","start_index":127,"tongjian_id":"9f7f7c46-db0e-11ef-8379-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"石勒","people_name_jianti_auto":"石勒","start_index":0,"tongjian_id":"9f7f7c4b-db0e-11ef-bf48-a0d3651f611f"},{"people_name":"世龍","people_name_jianti_auto":"世龙","start_index":4,"tongjian_id":"9f7f7c4c-db0e-11ef-abdc-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"石勒，字世龍。","note_content_jianti_auto":"石勒，字世龙。","note_type":"hu_note","start_index":147,"tongjian_id":"9f7f7c4a-db0e-11ef-9294-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"春秋","place_name_jianti_auto":"春秋","start_index":151,"tongjian_id":"9f7f7c64-db0e-11ef-b438-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、晋 十六国（卷三）","excerpts":[{"context_after":"冉闵据邺，改赵曰魏。\n【史略】初，匈奴别种曰羯，入居上党...","context_before":"","source_end_index":26,"source_paragraph_tongjian_id":"fae31f68-8d78-5c59-86c3-1081b12e630e","source_start_index":0,"source_text":"石勒据襄国[今北直顺德府，见前]，称赵[史曰后赵]。"},{"context_after":"四年，攻取厌次[即乐陵郡治]，于是幽、冀、并三州，皆没于...","context_before":"...，靳准作乱，弑刘粲，勒与刘曜讨灭之。勒入平阳，置戍而还。","source_end_index":465,"source_paragraph_tongjian_id":"fae31f68-8d78-5c59-86c3-1081b12e630e","source_start_index":387,"source_text":"曜封勒为赵公，既而贰于曜，称赵王[勒自以河内等二十四郡为赵国，改太守皆为内史，仿古冀州之制，南至孟津，西至龙门，东至河，北至塞垣，皆为冀州，兼领冀州牧云]。"}],"path":"历代州域形势纪要/三、晋 十六国（卷三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"15冬，石勒左、右長史張敬、張賓，左、右司馬張屈六、程遐等勸勒稱尊號，勒不許。十一月，將佐等復請勒稱大將軍、大單于、領冀州牧、趙王，依漢昭烈在蜀、魏武在鄴故事，以河內等二十四郡爲趙國，太守皆爲內史，準禹貢，復冀州之境，以大單于鎭撫百蠻，罷幷、朔、司三州，通置部司以監之；勒許之。戊寅，卽趙王位，大赦；依春秋時列國稱元年。","content_fanyi":"这年冬天，石勒的左、右长史张敬、张宾，左、右司马张屈六、程遐等人劝石勒称皇帝尊号，石勒没有接受。十一月，将佐们又请求石勒称大将军、大单于、领冀州牧、赵王，仿照蜀汉昭烈帝刘备在蜀、魏武帝曹操在邺城的先例，将河内等二十四郡设为赵国，各郡太守全部改为内史，依照《尚书·禹贡》恢复冀州旧有境域，并以大单于身份镇抚众多蛮族，撤销并州、朔州、司州三州，统一设置部司进行监管；石勒答应了。十一月戊寅日，石勒即赵王位，宣布大赦；又依照春秋时期列国的旧例称元年。","content_jianti_auto":"15冬，石勒左、右长史张敬、张宾，左、右司马张屈六、程遐等劝勒称尊号，勒不许。十一月，将佐等复请勒称大将军、大单于、领冀州牧、赵王，依汉昭烈在蜀、魏武在邺故事，以河内等二十四郡为赵国，太守皆为内史，准禹贡，复冀州之境，以大单于镇抚百蛮，罢幷、朔、司三州，通置部司以监之；勒许之。戊寅，即赵王位，大赦；依春秋时列国称元年。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7790,"number":15,"path":"资治通鉴 : 卷第九十一 (晉紀十三) / 中宗元皇帝中 / 太興二年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"9f7f7c24-db0e-11ef-a091-a0d3651f611f","year_int":319},"tongjian_id":"9f7f7c24-db0e-11ef-a091-a0d3651f611f"},"paragraph_order":7}],"page_size":10,"total_pages":1,"total_paragraphs":7},"place_name":"春秋"},"message":"success","success":true}