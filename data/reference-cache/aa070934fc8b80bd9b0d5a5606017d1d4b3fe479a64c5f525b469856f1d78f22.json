"}],"class_tags":["人事"],"content":"7八月，丁未，以御史大夫開封侯陶青爲丞相。丁巳，以內史鼂錯爲御史大夫。","content_fanyi":"八月丁未日，景帝任命御史大夫、开封侯陶青为丞相。丁巳日，任命内史晁错为御史大夫。","content_jianti_auto":"7八月，丁未，以御史大夫开封侯陶青为丞相。丁巳，以内史鼌错为御史大夫。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1236,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"8f114372-db0e-11ef-861d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"8彗星出東北。","content_fanyi":"彗星出现在东北方天空。","content_jianti_auto":"8彗星出东北。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1237,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"8f11437e-db0e-11ef-b11e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"孔會子","people_name_jianti_auto":"孔会子","start_index":5,"tongjian_id":"8f114382-db0e-11ef-8239-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"大戴禮曰：孔會子云：陽之專氣爲霰，陰之專氣爲雹。盛陽之氣在雨水，則溫暖而爲雨，陰氣薄而脅之不相入，則搏而爲雹也。盛陰之氣在雨水，則凝滯而爲雪，陽氣薄而脅之不相入，則消散而下，因水而爲霰。雨，于具翻。","note_content_jianti_auto":"大戴礼曰：孔会子云：阳之专气为霰，阴之专气为雹。盛阳之气在雨水，则温暖而为雨，阴气薄而胁之不相入，则搏而为雹也。盛阴之气在雨水，则凝滞而为雪，阳气薄而胁之不相入，则消散而下，因水而为霰。雨，于具翻。","note_type":"hu_note","start_index":18,"tongjian_id":"8f114381-db0e-11ef-8fba-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"衡山","place_name_jianti_auto":"衡山","place_note":"安徽霍山县西南霍山","resolved_place_entity_id":1415,"start_index":3,"tongjian_id":"8f114384-db0e-11ef-b6d0-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"9秋，衡山雨雹，大者五寸，深者二尺。","content_fanyi":"秋天，衡山地区降下冰雹，大的直径有五寸，堆积深的地方达二尺。","content_jianti_auto":"9秋，衡山雨雹，大者五寸，深者二尺。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1238,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"8f114380-db0e-11ef-8bae-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"石氏","people_name_jianti_auto":"石氏","start_index":164,"tongjian_id":"8f114387-db0e-11ef-811a-a0d3651f611f"},{"people_name":"孔穎達","people_name_jianti_auto":"孔颖达","start_index":183,"tongjian_id":"8f114388-db0e-11ef-ab91-a0d3651f611f"},{"people_name":"五帝","people_name_jianti_auto":"五帝","start_index":208,"tongjian_id":"8f114389-db0e-11ef-b830-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"熒惑，火星。北辰，中宮天極星也。月有九行，黑道二，出黃道北，自立冬、冬至行之，青道二，出黃道東，立春、春分行之；赤道二，出黃道南，立夏、夏至行之；白道二，出黃道西，立秋、秋分行之。其去極有遠近，終不能出北辰之間；出北辰間，失其行也。歲星，木星也。太微爲天廷。據天文志：北極及太微，人君之位；或守之，或出之，或逆行經之，皆變也。又石氏星傳曰：龍左角爲天田，右角爲天廷。孔穎達曰：春秋緯文：紫微宮爲大帝，太微爲天庭，中有五帝座。","note_content_jianti_auto":"荧惑，火星。北辰，中宫天极星也。月有九行，黑道二，出黄道北，自立冬、冬至行之，青道二，出黄道东，立春、春分行之；赤道二，出黄道南，立夏、夏至行之；白道二，出黄道西，立秋、秋分行之。其去极有远近，终不能出北辰之间；出北辰间，失其行也。岁星，木星也。太微为天廷。据天文志：北极及太微，人君之位；或守之，或出之，或逆行经之，皆变也。又石氏星传曰：龙左角为天田，右角为天廷。孔颖达曰：春秋纬文：紫微宫为大帝，太微为天庭，中有五帝座。","note_type":"hu_note","start_index":24,"tongjian_id":"8f114386-db0e-11ef-af88-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"10熒惑逆行守北辰，月出北辰間；歲星逆行天廷中。","content_fanyi":"火星逆行并靠近北极星，月亮出现在北极星天区；木星在太微垣中逆行。","content_jianti_auto":"10荧惑逆行守北辰，月出北辰间；岁星逆行天廷中。","dtjl_paragraph_links":[],"dtjl_references":[],"id":1239,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"8f114385-db0e-11ef-b82f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"巨萬，萬萬也。勝，音升。","note_content_jianti_auto":"巨万，万万也。胜，音升。","note_type":"hu_note","start_index":45,"tongjian_id":"8f11438f-db0e-11ef-857e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"唐","place_name_jianti_auto":"唐","start_index":0,"tongjian_id":"8f114391-db0e-11ef-abb9-a0d3651f611f"},{"place_name":"宋州","place_name_jianti_auto":"宋州","start_index":1,"tongjian_id":"8f114392-db0e-11ef-91c6-a0d3651f611f"},{"place_name":"宋城縣","place_name_jianti_auto":"宋城县","start_index":4,"tongjian_id":"8f114393-db0e-11ef-a919-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":9,"tongjian_id":"8f114394-db0e-11ef-b068-a0d3651f611f"},{"place_name":"睢陽","place_name_jianti_auto":"睢阳","start_index":10,"tongjian_id":"8f114395-db0e-11ef-afa8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐宋州治宋城縣，卽漢睢陽。","note_content_jianti_auto":"唐宋州治宋城县，即汉睢阳。","note_type":"hu_note","start_index":72,"tongjian_id":"8f114390-db0e-11ef-8ea2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"如淳","people_name_jianti_auto":"如淳","start_index":0,"tongjian_id":"8f114398-db0e-11ef-bce6-a0d3651f611f"},{"people_name":"師古","people_name_jianti_auto":"师古","start_index":16,"tongjian_id":"8f114399-db0e-11ef-8ac3-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"平臺","place_name_jianti_auto":"平台","start_index":4,"tongjian_id":"8f11439a-db0e-11ef-82b3-a0d3651f611f"},{"place_name":"梁","place_name_jianti_auto":"梁","start_index":7,"tongjian_id":"8f11439b-db0e-11ef-9155-a0d3651f611f"},{"place_name":"平臺","place_name_jianti_auto":"平台","start_index":40,"tongjian_id":"8f11439c-db0e-11ef-9bce-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"如淳曰：平臺在梁東北，離宮所在。師古曰：今其城東二十里所有故臺基，其處寬博，俗云平臺也。屬，之欲翻。","note_content_jianti_auto":"如淳曰：平台在梁东北，离宫所在。师古曰：今其城东二十里所有故台基，其处宽博，俗云平台也。属，之欲翻。","note_type":"hu_note","start_index":93,"tongjian_id":"8f114397-db0e-11ef-9c59-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"枚被","people_name_jianti_auto":"枚被","start_index":13,"tongjian_id":"8f11439e-db0e-11ef-9cdb-a0d3651f611f"},{"people_name":"嚴忌","people_name_jianti_auto":"严忌","start_index":16,"tongjian_id":"8f11439f-db0e-11ef-9c73-a0d3651f611f"},{"people_name":"莊","people_name_jianti_auto":"庄","start_index":21,"tongjian_id":"8f1143a0-db0e-11ef-9201-a0d3651f611f"},{"people_name":"明帝","people_name_jianti_auto":"明帝","start_index":26,"tongjian_id":"8f1143a1-db0e-11ef-87f2-a0d3651f611f"},{"people_name":"嚴","people_name_jianti_auto":"严","start_index":32,"tongjian_id":"8f1143a2-db0e-11ef-8b29-a0d3651f611f"},{"people_name":"羊","people_name_jianti_auto":"羊","start_index":34,"tongjian_id":"8f1143a3-db0e-11ef-889e-a0d3651f611f"},{"people_name":"羊舌大夫","people_name_jianti_auto":"羊舌大夫","start_index":37,"tongjian_id":"8f1143a4-db0e-11ef-a58d-a0d3651f611f"},{"people_name":"鄒","people_name_jianti_auto":"邹","st