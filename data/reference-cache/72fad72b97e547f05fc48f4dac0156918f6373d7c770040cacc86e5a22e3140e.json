:"948b5d8b-db0e-11ef-afe6-a0d3651f611f"},{"place_name":"渠州","place_name_jianti_auto":"渠州","start_index":15,"tongjian_id":"948b5d8c-db0e-11ef-830f-a0d3651f611f"},{"place_name":"流江縣","place_name_jianti_auto":"流江县","start_index":17,"tongjian_id":"948b5d8d-db0e-11ef-a1a5-a0d3651f611f"},{"place_name":"宕渠","place_name_jianti_auto":"宕渠","start_index":29,"tongjian_id":"948b5d8e-db0e-11ef-b120-a0d3651f611f"},{"place_name":"渠州","place_name_jianti_auto":"渠州","start_index":44,"tongjian_id":"948b5d8f-db0e-11ef-b959-a0d3651f611f"},{"place_name":"流江縣","place_name_jianti_auto":"流江县","start_index":46,"tongjian_id":"948b5d90-db0e-11ef-aa4c-a0d3651f611f"},{"place_name":"車騎城","place_name_jianti_auto":"车骑城","start_index":54,"tongjian_id":"948b5d91-db0e-11ef-b967-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"宕渠縣，屬巴郡。宕渠故城，在今渠州流江縣東北七十里。賢曰：宕渠，山名，因以名縣，故城在今渠州流江縣東北，俗名車騎城是也。師古曰：宕，音徒浪翻。","note_content_jianti_auto":"宕渠县，属巴郡。宕渠故城，在今渠州流江县东北七十里。贤曰：宕渠，山名，因以名县，故城在今渠州流江县东北，俗名车骑城是也。师古曰：宕，音徒浪翻。","note_type":"hu_note","start_index":34,"tongjian_id":"948b367e-db0e-11ef-b377-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方军事","official_name":"蜀郡守將","official_note":"蜀郡守將是蜀郡的军事指挥官，负责地方防务，此处史歆担任此职并发动叛乱，反映了地方军事官员的独立性和潜在威胁。","official_rank":"未知","source_snippet":"蜀郡守將史歆反","start_index":3,"tongjian_id":"a0918cd6-ab8b-4960-b78d-0dfbd39fc856"},{"confidence":0.95,"official_category":"地方行政","official_name":"太守","official_note":"太守是汉代郡的最高行政长官，掌管一郡的民政、军事和司法，此处张穆作为蜀郡太守，被叛军攻击，显示了地方行政官员在动乱中的脆弱性。","official_rank":"郡级长官","source_snippet":"攻太守張穆","start_index":10,"tongjian_id":"23b71964-a058-4885-909c-fe328ac98782"}],"ExtRef_Children_people":[{"people_name":"史歆","people_name_jianti_auto":"史歆","people_xingming":"史歆","start_index":8,"tongjian_id":"948b5d92-db0e-11ef-8e3f-a0d3651f611f"},{"people_name":"張穆","people_name_jianti_auto":"张穆","people_xingming":"张穆","start_index":15,"tongjian_id":"948b5d93-db0e-11ef-b1fc-a0d3651f611f"},{"people_name":"穆","people_name_jianti_auto":"穆","people_xingming":"张穆","start_index":18,"tongjian_id":"948b5d94-db0e-11ef-8504-a0d3651f611f"},{"people_name":"楊偉","people_name_jianti_auto":"杨伟","people_xingming":"杨伟","start_index":25,"tongjian_id":"948b5d95-db0e-11ef-a791-a0d3651f611f"},{"people_name":"歆","people_name_jianti_auto":"歆","people_xingming":"史歆","start_index":32,"tongjian_id":"948b5d96-db0e-11ef-9204-a0d3651f611f"},{"link_death_year":44,"link_td_description":"吴汉，字子颜，南阳宛人。东汉初年军事人物。他协助汉光武帝征召幽州军队，击败檀乡贼、邺西山贼等诸多民变势力并先后扫灭朱鲔、刘永、董宪、公孙述等割据势力，最终一统天下，位列“云台二十八将”第二位。","link_td_id":"Q10006241","link_td_number_id":1229788,"people_name":"吳漢","people_name_jianti_auto":"吴汉","people_xingming":"吴汉","start_index":36,"tongjian_id":"948b8495-db0e-11ef-bea3-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"蜀郡","place_name_jianti_auto":"蜀郡","resolved_place_entity_id":38,"start_index":4,"tongjian_id":"948b5d97-db0e-11ef-ad24-a0d3651f611f"},{"place_name":"宕渠","place_name_jianti_auto":"宕渠","resolved_place_entity_id":2603,"start_index":23,"tongjian_id":"948b5d98-db0e-11ef-b64d-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事"],"content":"1二月，蜀郡守將史歆反，攻太守張穆，穆踰城走；宕渠楊偉等起兵以應歆。帝遣吳漢等將萬餘人討之。","content_fanyi":"二月，蜀郡守将史歆反叛，攻打太守张穆，张穆翻越城墙逃走；宕渠县人杨伟等起兵响应史歆。光武帝派吴汉等人率领一万余人征讨叛军。","content_jianti_auto":"1二月，蜀郡守将史歆反，攻太守张穆，穆逾城走；宕渠杨伟等起兵以应歆。帝遣吴汉等将万余人讨之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3377,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"948b367a-db0e-11ef-b579-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蒲坂縣","place_name_jianti_auto":"蒲坂县","start_index":0,"tongj