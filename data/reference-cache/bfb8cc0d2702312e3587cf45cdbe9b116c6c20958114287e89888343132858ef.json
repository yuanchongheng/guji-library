ey":"baiyang_epub","start_index":26,"text":"呪","tongjian_id":"27a6ee6f-d279-5199-966a-f4e4ebd6a581"}],"ExtRef_Children_places":[{"place_name":"鉅鹿","place_name_jianti_auto":"巨鹿","resolved_place_entity_id":757,"start_index":3,"tongjian_id":"97a4ec8b-db0e-11ef-a740-a0d3651f611f"},{"place_name":"青","place_name_jianti_auto":"青","resolved_place_entity_id":242,"start_index":80,"tongjian_id":"97a4ec8d-db0e-11ef-b605-a0d3651f611f"},{"place_name":"徐","place_name_jianti_auto":"徐","resolved_place_entity_id":191,"start_index":82,"tongjian_id":"97a4ec8e-db0e-11ef-8681-a0d3651f611f"},{"place_name":"幽","place_name_jianti_auto":"幽","resolved_place_entity_id":102,"start_index":84,"tongjian_id":"97a4ec8f-db0e-11ef-8741-a0d3651f611f"},{"place_name":"冀","place_name_jianti_auto":"冀","resolved_place_entity_id":216,"start_index":86,"tongjian_id":"97a4ec90-db0e-11ef-bb55-a0d3651f611f"},{"place_name":"荊","place_name_jianti_auto":"荆","resolved_place_entity_id":103,"start_index":88,"tongjian_id":"97a4ec91-db0e-11ef-8ffc-a0d3651f611f"},{"place_name":"揚","place_name_jianti_auto":"扬","resolved_place_entity_id":419,"start_index":90,"tongjian_id":"97a4ec92-db0e-11ef-a8be-a0d3651f611f"},{"place_name":"兗","place_name_jianti_auto":"兖","resolved_place_entity_id":211,"start_index":92,"tongjian_id":"97a4ec93-db0e-11ef-9aa0-a0d3651f611f"},{"place_name":"豫","place_name_jianti_auto":"豫","resolved_place_entity_id":185,"start_index":94,"tongjian_id":"97a4ec94-db0e-11ef-8ee3-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"黄巾起义","tongjian_id":"war_N0619"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"6初，鉅鹿張角奉事黃、老，以妖術敎授，號「太平道」。呪符水以療病，令病者跪拜首過，或時病愈，衆共神而信之。角分遣弟子周行四方，轉相誑誘，十餘年間，徒衆數十萬，自青、徐、幽、冀、荊、揚、兗、豫八州之人，莫不畢應。或棄賣財產，流移奔赴，塡塞道路，未至病死者亦以萬數。郡縣不解其意，反言角以善道敎化，爲民所歸。","content_fanyi":"当初，钜鹿人张角信奉黄帝、老子，用妖术传教，号称“太平道”。他让人喝下念过咒语的符水来治病，令病人跪拜忏悔自己的罪过，有时病人能够痊愈，大家便共同把他奉若神明而深信不疑。张角分别派遣弟子周游四方，辗转欺骗引诱人们入教，十多年间，信徒多达数十万，青、徐、幽、冀、荆、扬、兖、豫八州的人无不响应。有的人变卖、抛弃家产，流转迁徙前往投奔，道路被人群堵塞，还没赶到就病死在途中的也数以万计。郡县官员不明白他的真实意图，反而替张角说好话，说他用善道教化百姓，为民众所归附。","content_jianti_auto":"6初，巨鹿张角奉事黄、老，以妖术教授，号「太平道」。呪符水以疗病，令病者跪拜首过，或时病愈，众共神而信之。角分遣弟子周行四方，转相诳诱，十余年间，徒众数十万，自青、徐、幽、冀、荆、扬、兖、豫八州之人，莫不毕应。或弃卖财产，流移奔赴，塡塞道路，未至病死者亦以万数。郡县不解其意，反言角以善道教化，为民所归。","dtjl_paragraph_links":[],"dtjl_references":[{"excerpts":[{"context_after":"乃至韩山童、徐寿辉曰：吾之道，瞿昙之道也。微二氏之支流，...","context_before":"...矣，宦寺之毒，郡县之虐，未可以为名也，于是而诡托之于道。","source_end_index":217,"source_paragraph_tongjian_id":"1c11696d-92c8-488c-bc28-b4c4f3371e86","source_start_index":201,"source_text":"角曰：吾之道，黄帝、老子之道也。"}],"title":"九 汉儒倡导之异端邪说"}],"id":4996,"number":6,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"97a4ec81-db0e-11ef-aa24-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賜","people_name_jianti_auto":"赐","start_index":0,"tongjian_id":"97a4ec98-db0e-11ef-a8b0-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賜爲司徒，熹平五年也。","note_content_jianti_auto":"赐为司徒，熹平五年也。","note_type":"hu_note","start_index":9,"tongjian_id":"97a4ec97-db0e-11ef-9030-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":0,"tongjian_id":"97a4ec9c-db0e-11ef-bb51-a0d3651f611f"},{"people_name":"賜","people_name_jianti_auto":"赐","start_index":19,"tongjian_id":"97a4ec9d-db0e-11ef-ac6a-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：謂所論事留在禁中，未施用之。余據賜以熹平六年免。帥，所類翻。","note_content_jianti_auto":"贤曰：谓所论事留在禁中，未施用之。余据赐以熹平六年免。帅，所类翻。","note_type":"hu_note","start_index":99,"tongjian_id":"97a4ec9b-db0e-11ef-80d5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"陶","people_name_jianti_auto":"陶","start_index":0,"tongjian_id":"97a4eca2-db0e-11ef-8c2e-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陶明春秋，爲之訓詁，故詔之次第條例。","note_content_jianti_auto":"陶明春秋，为之训诂，故诏之次第条例。","note_type":"hu_note","start_index":213,"tongjian_id":"97a4eca1-db0e-11ef-9c2f-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"太尉","official_note":"太尉是汉代三公之一，掌管全国军事，此处杨赐曾任太尉，但文中提及他当时为司徒，表明官职变动。","official_rank":"正一品","source_snippet":"太尉楊賜時爲司徒","start_index":0,"tongjian_id":"b653216c-35ef-4948-9824-19b041d548a7"},{"confidence":0.9,"official_category":"中枢机构","official_name":"司徒","official_note":"司徒是汉代三公之一，主管民政和教育，此处杨赐担任司徒，上书建议处理张角叛乱。","official_rank":"正一品","source_snippet":"太尉楊賜時爲司徒","start_index":6,"tongjian_id":"13c05887-f1ed-48ca-b48c-a71611c56dcf"},{"confidence":0.85,"official_category":"地方行政","official_name":"刺史","official_note":"刺史是汉代州级监察和行政长官，负责监督地方官员，此处建议敕令刺史处理流民问题。","official_rank":"州级长官","source_snippet":"宜切敕刺史、二千石","start_index":56,"tongjian_id":"bea8a851-a624-481d-89d5-aab50d286e8d"},{"confidence":0.8,"official_category":"地方行政","official_name":"二千石","official_note":"二千石是汉代郡守等高级地方官员的俸禄等级，代指郡级长官，此处建议敕令他们协助处理流民。","official_rank":"郡级长官","source_snippet":"宜切敕刺史、二千石","start_index":60,"tongjian_id":"34e6e8d5-7d40-4f48-9825-a9dc147d27bb"},{"confidence":0.85,"official_category":"中枢机构","official_name":"司徒掾","official_note":"司徒掾是司徒府中的属官，协助处理政务，此处刘陶作为司徒掾上疏重申杨赐的建议。","official_rank":"掾属","source_snippet":"司徒掾劉陶復上疏申賜前議","start_index":113,"tongjian_id":"26798e7f-1f3f-4280-9f96-6d1fc5c75aaf"}],"ExtRef_Children_people":[{"link_death_year":185,"link_td_description":"杨赐，字伯献，弘农郡华阴县人，东汉大臣，出身自东汉世族“弘农杨氏”，祖父杨震，父亲杨秉，杨赐以及儿子杨彪皆位至太尉，时人有“四世太尉”之称。","link_td_id":"Q10007282","link_td_number_