al_rank":"未知","source_snippet":"虜其將莊豹","start_index":13,"tongjian_id":"bebd0f44-756c-47d9-9245-936d88bf2890"}],"ExtRef_Children_people":[{"link_death_year":-300,"link_td_description":"樗里子，嬴姓，名疾，又称“樗里疾”，秦国公族、大臣，秦孝公之子，惠文王弟，母亲为韩国人，乃战国时代著名军事家及政治家，曾辅佐秦惠王、秦武王、秦昭王等秦国君主。擅长外交、军事。","link_td_id":"Q10002142","link_td_number_id":109473,"people_name":"疾","people_name_jianti_auto":"疾","people_xingming":"疾","start_index":4,"tongjian_id":"8c637a52-db0e-11ef-ac19-a0d3651f611f"},{"people_name":"莊豹","people_name_jianti_auto":"庄豹","people_xingming":"庄豹","start_index":14,"tongjian_id":"8c637a55-db0e-11ef-82ed-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8c637a53-db0e-11ef-82df-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","resolved_place_entity_id":88,"start_index":6,"tongjian_id":"8c637a54-db0e-11ef-8134-a0d3651f611f"},{"place_name":"藺","place_name_jianti_auto":"蔺","place_note":"山西離石縣西","resolved_place_entity_id":9033,"start_index":9,"tongjian_id":"8c637a56-db0e-11ef-b188-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/三、汾州府（卷四十二）","excerpts":[{"context_after":"又武灵王曰：先王取蔺、郭狼。郭狼即皋狼矣。汉置蔺县，属西...","context_before":"...在州西，战国时赵蔺邑也。《赵世家》：成侯三年，魏败我蔺。","source_end_index":43,"source_paragraph_tongjian_id":"ac439c84-8fb8-5728-affb-fe3c2a0a9861","source_start_index":31,"source_text":"武灵王十三年，秦拔我蔺。"}],"path":"山西方舆纪要/三、汾州府（卷四十二）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"1秦右更疾伐趙，拔藺，虜其將莊豹。","content_fanyi":"秦国派担任右更的疾率兵攻打赵国，攻下蔺邑，俘虏了赵国的将领庄豹。","content_jianti_auto":"1秦右更疾伐赵，拔蔺，虏其将庄豹。","dtjl_paragraph_links":[],"dtjl_references":[],"id":243,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c637a3d-db0e-11ef-8bfe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_d