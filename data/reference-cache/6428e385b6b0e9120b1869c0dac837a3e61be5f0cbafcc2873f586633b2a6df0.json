f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陳姓出於舜，周武王封舜後於陳，子孫以國爲氏。","note_content_jianti_auto":"陈姓出于舜，周武王封舜后于陈，子孙以国为氏。","note_type":"hu_note","start_index":98,"tongjian_id":"8c637a5c-db0e-11ef-89c6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"楚","place_name_jianti_auto":"楚","start_index":0,"tongjian_id":"8c637a64-db0e-11ef-90d6-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":4,"tongjian_id":"8c637a65-db0e-11ef-a337-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":8,"tongjian_id":"8c637a66-db0e-11ef-9590-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"楚東北接齊，西接秦。","note_content_jianti_auto":"楚东北接齐，西接秦。","note_type":"hu_note","start_index":235,"tongjian_id":"8c637a63-db0e-11ef-bc35-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"班固","people_name_jianti_auto":"班固","start_index":0,"tongjian_id":"8c637a6a-db0e-11ef-8e76-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"周","place_name_jianti_auto":"周","start_index":9,"tongjian_id":"8c637a6b-db0e-11ef-b396-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":13,"tongjian_id":"8c637a6c-db0e-11ef-b17b-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":15,"tongjian_id":"8c637a6d-db0e-11ef-802b-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"班固百官表：將軍，周末官，秦、漢因之。","note_content_jianti_auto":"班固百官表：将军，周末官，秦、汉因之。","note_type":"hu_note","start_index":328,"tongjian_id":"8c637a69-db0e-11ef-aef0-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"相","official_note":"相是战国时期楚国的最高行政官职，相当于宰相或丞相，负责辅佐君主处理国家政务。在上下文中，楚王授予张仪相印，表示任命他为楚国的相，以拉拢秦国，但张仪实际是秦国的使者，这反映了楚王的外交策略和信任。","official_rank":"未知","source_snippet":"乃以相印授張儀","start_index":304,"tongjian_id":"307a1788-1d3b-40d6-a6d5-c766e46653e4"},{"confidence":0.85,"official_category":"军事指挥","official_name":"將軍","official_note":"將軍是战国时期的军事官职，负责指挥军队。在上下文中，楚王派遣一位将军跟随张仪到秦国，可能是为了监督或执行外交任务，体现了楚国对秦国的谨慎态度。","official_rank":"未知","source_snippet":"使一將軍隨張儀至秦","start_index":320,"tongjian_id":"cd62c864-4cbd-4838-b02b-5cb599fd5e78"}],"ExtRef_Children_people":[{"link_birth_year":-356,"link_death_year":-311,"link_td_description":"秦惠文王，又称秦惠王或秦惠文君，嬴姓，考古名骃，传世名驷，秦孝公之子，称王前为伯爵，称秦伯骃或秦伯驷。在位期间称王，秦国称王自嬴驷始，并重用樗里疾、张仪等人。","link_td_id":"Q10001806","link_td_number_id":176314,"people_name":"秦王","people_name_jianti_auto":"秦王","people_xingming":"嬴驷","start_index":1,"tongjian_id":"8c65cee8-db0e-11ef-8ab1-a0d3651f611f","wl_zhushi":"[嬴驷]"},{"link_birth_year":-373,"link_death_year":-310,"link_td_description":"张仪，姬姓，张氏，魏国安邑（今山西夏县）人，战国时期著名的纵横家。提倡连横，即秦国联合其他诸侯国中的几个，然后对抗其他的诸侯国，多次破坏了公孙衍的合纵，为秦惠王重用，封武信君，卒于魏国。","link_td_id":"Q10002172","link_td_number_id":133753,"people_name":"張儀","people_name_jianti_auto":"张仪","people_xingming":"张仪","start_index":17,"tongjian_id":"8c65ceec-db0e-11ef-9c6e-a0d3651f611f"},{"link_birth_year":-355,"link_death_year":-296,"link_td_description":"楚怀王，芈姓，熊氏，名槐，楚国君主。父为楚威王，怀王任用佞臣令尹子兰、上官大夫靳尚，宠爱郑袖，为人利令智昏，国事日非。最后被秦昭襄王所骗，监禁于秦国至死，楚人皆悲之。","link_td_id":"Q10000652","link_td_number_id":335220,"people_name":"楚王","people_name_jianti_auto":"楚王","people_xingming":"芈槐","start_index":23,"tongjian_id":"8c65ceed-db0e-11ef-86ef-a0d3651f611f","wl_zhushi":"[芈槐]"},{"link_birth_year":-355,"link_death_year":-296,"link_td_description":"楚怀王，芈姓，熊氏，名槐，楚国君主。父为楚威王，怀王任用佞臣令尹子兰、上官大夫靳尚，宠爱郑袖，为人利令智昏，国事日非。最后被秦昭襄王所骗，监禁于秦国至死，楚人皆悲之。","link_td_id":"Q10000652","link_td_number_id":335220,"people_name":"楚王","people_name_jianti_auto":"楚王","start_index":81,"tongjian_id":"8c65cef2-db0e-11ef-8b63-a0d3651f611f","wl_zhushi":"[芈槐]"},{"link_td_description":"陈轸，齐国