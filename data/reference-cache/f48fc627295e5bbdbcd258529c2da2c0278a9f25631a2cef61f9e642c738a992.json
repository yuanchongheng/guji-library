_category":"軍事指揮","official_name":"越騎校尉","official_note":"越騎校尉是漢代禁軍騎兵部隊的指揮官，此處趙世因畏懦被免職。","official_rank":"中級將領","source_snippet":"越騎校尉趙世","start_index":9,"tongjian_id":"b5ace33c-0dd1-4099-b96d-69d989ee1348"},{"confidence":0.9,"official_category":"中樞機構","official_name":"謁者","official_note":"謁者是漢代負責傳達詔令、接待賓客的官員，此處王信和耿譚分別接管劉尚和趙世的營屯。","official_rank":"低級官員","source_snippet":"謁者王信","start_index":25,"tongjian_id":"29ed680c-1195-4cf2-b1e7-023f9b1d42e7"},{"confidence":0.9,"official_category":"中樞機構","official_name":"謁者","official_note":"謁者是漢代負責傳達詔令、接待賓客的官員，此處耿譚接管趙世的營屯並設購賞招降。","official_rank":"低級官員","source_snippet":"謁者耿譚","start_index":33,"tongjian_id":"521f7dff-35e8-41f7-bb6d-c44036155da9"}],"ExtRef_Children_people":[{"link_death_year":47,"link_td_description":"刘尚，《东观汉记》、《续汉书》作“刘禹”，是中国东汉时代初期武将以及汉朝宗室人物。","link_td_id":"Q10018156","link_td_number_id":5426945,"people_name":"劉尚","people_name_jianti_auto":"刘尚","people_xingming":"刘尚","start_index":6,"tongjian_id":"959e186f-db0e-11ef-ba1a-a0d3651f611f"},{"people_name":"趙世","people_name_jianti_auto":"赵世","people_xingming":"赵世","start_index":13,"tongjian_id":"959e1870-db0e-11ef-bd9f-a0d3651f611f"},{"link_td_description":"王信，一称王长君，西汉槐里（治今陕西省兴平市东南）人，孝景王皇后之兄。","link_td_id":"Q10004379","link_td_number_id":5996958,"people_name":"王信","people_name_jianti_auto":"王信","people_xingming":"王信","start_index":27,"tongjian_id":"959e1871-db0e-11ef-a45a-a0d3651f611f"},{"link_death_year":47,"link_td_description":"刘尚，《东观汉记》、《续汉书》作“刘禹”，是中国东汉时代初期武将以及汉朝宗室人物。","link_td_id":"Q10018156","link_td_number_id":5426945,"people_name":"尚","people_name_jianti_auto":"尚","people_xingming":"刘尚","start_index":30,"tongjian_id":"959e1872-db0e-11ef-8407-a0d3651f611f"},{"people_name":"耿譚","people_name_jianti_auto":"耿谭","people_xingming":"耿谭","start_index":38,"tongjian_id":"959e1873-db0e-11ef-bb1f-a0d3651f611f"},{"people_name":"世","people_name_jianti_auto":"世","people_xingming":"赵世","start_index":41,"tongjian_id":"959e1874-db0e-11ef-ad18-a0d3651f611f"},{"people_name":"譚","people_name_jianti_auto":"谭","people_xingming":"耿谭","start_index":47,"tongjian_id":"959e1877-db0e-11ef-9e96-a0d3651f611f"},{"link_td_description":"迷唐，烧当羌首领。羌王迷吾的儿子。","link_td_id":"Q10002671","link_td_number_id":1275484,"people_name":"迷唐","people_name_jianti_auto":"迷唐","people_xingming":"迷唐","start_index":60,"tongjian_id":"959e1878-db0e-11ef-8018-a0d3651f611f"},{"link_td_description":"王信，一称王长君，西汉槐里（治今陕西省兴平市东南）人，孝景王皇后之兄。","link_td_id":"Q10004379","link_td_number_id":5996958,"people_name":"信","people_name_jianti_auto":"信","people_xingming":"王信","start_index":68,"tongjian_id":"959e1879-db0e-11ef-b1ff-a0d3651f611f"},{"people_name":"譚","people_name_jianti_auto":"谭","people_xingming":"耿谭","start_index":70,"tongjian_id":"959e187a-db0e-11ef-b5cf-a0d3651f611f"},{"link_td_description":"迷唐，烧当羌首领。羌王迷吾的儿子。","link_td_id":"Q10002671","link_td_number_id":1275484,"people_name":"迷唐","people_name_jianti_auto":"迷唐","people_xingming":"迷唐","start_index":81,"tongjian_id":"959e187b-db0e-11ef-be9d-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"枹罕","place_name_jianti_auto":"枹罕","resolved_place_entity_id":549,"start_index":33,"tongjian_id":"959e1875-db0e-11ef-add2-a0d3651f611f"},{"place_name":"白石","place_name_jianti_auto":"白石","resolved_place_entity_id":1655,"start_index":44,"tongjian_id":"959e1876-db0e-11ef-a46b-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"东汉与羌的战争","tongjian_id":"war_N0606"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/九、临洮府（卷六十）","excerpts":[{"context_after":"晋废。惠帝时，张轨复置，属晋兴郡，改为永固县。太和二年，...","context_before":"...。兵少，皆为羌所败。乃益兵破走之。后汉白石县，属陇西郡。","source_end_index":221,"source_paragraph_tongjian_id":"753f3dda-eb63-50e6-8580-7d4907a54fe2","source_start_index":171,"source_text":"永元十年，刘尚等讨叛羌迷唐等，不克，征还。谒者王信、耿谭代领其兵。信屯枹罕，谭屯白石，叛羌以次降附。"}],"path":"陕西方舆纪要/九、临洮府（卷六十）","source_name":"读史方舆纪要"}],"class_tags":["军事","人事"],"content":"4行征西將軍劉尚、越騎校尉趙世坐畏懦徵，下獄，免。謁者王信領尚營屯枹罕，謁者耿譚領世營屯白石。譚乃設購賞，諸種頗來內附。迷唐恐，乃請降；信、譚遂受降罷兵。十二月，迷唐等帥種人詣闕貢獻。","content_fanyi":"代理征西将军刘尚、越骑校尉赵世因畏惧敌人、懦弱无能而被召回论罪，下狱，免职。谒者王信率领刘尚的军营驻扎在枹罕县，谒者耿谭率领赵世的军营驻扎在白石县。耿谭于是设置悬赏招降，各羌人部落多有前来归附。迷唐感到恐惧，于是请求投降；王信、耿谭便接受了他的投降，停止用兵。十二月，迷唐等率领本族人前往朝廷进献贡品。","content_jianti_auto":"4行征西将军刘尚、越骑校尉赵世坐畏懦征，下狱，免。谒者王信领尚营屯枹罕，谒者耿谭领世营屯白石。谭乃设购赏，诸种颇来内附。迷唐恐，乃请降；信、谭遂受降罢兵。十二月，迷唐等帅种人诣阙贡献。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3883,"number":4,"reading_annotation_sources":[],"start_index":3,"tongjian_id":"959e1851-db0e-11ef-bc52-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_death_year":98,"link_td_description":"刘畅，东汉明帝的第七子，生母阴贵人。","link_td_id":"Q10013148","link_td_number_id":1570241,"people_name":"梁節王","people_name_jianti_auto":"梁节王","people_xingming":"刘畅","start_index":4,"tongjian_id":"959e187d-db0e-11ef-919f-a0d3651f611f"},{"link_death_year":98,"link_td_description":"刘畅，东汉明帝的第七子，生母阴贵人。","link_td_id":"Q10013148","link_td_number_id":1570241,"people_name":"暢","people_name_jianti_auto":"畅","people_xingming":"刘畅","start_index":7,"tongjian_id":"959e187e-db0e-11ef-bef3-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5戊寅，梁節王暢薨。","content_fanyi":"十二月十九日戊寅这一天，梁节王刘畅去世。","content_jianti_auto":"5戊寅，梁节王畅薨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3884,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"959e187c-db0e-11ef-9c31-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"般","people_name_jianti_auto":"般","start_index":9,"tongjian_id":"959e1