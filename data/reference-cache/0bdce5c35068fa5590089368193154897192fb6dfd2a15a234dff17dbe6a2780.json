-a0d3651f611f"},{"place_name":"江津縣","place_name_jianti_auto":"江津县","start_index":46,"tongjian_id":"93f7e583-db0e-11ef-9030-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":51,"tongjian_id":"93f7e584-db0e-11ef-abaa-a0d3651f611f"},{"place_name":"江州縣","place_name_jianti_auto":"江州县","start_index":52,"tongjian_id":"93f7e585-db0e-11ef-b7cf-a0d3651f611f"},{"place_name":"扞關","place_name_jianti_auto":"扞关","start_index":64,"tongjian_id":"93f7e586-db0e-11ef-bc49-a0d3651f611f"},{"place_name":"蜀","place_name_jianti_auto":"蜀","start_index":68,"tongjian_id":"93f7e587-db0e-11ef-816d-a0d3651f611f"},{"place_name":"峽州","place_name_jianti_auto":"峡州","start_index":74,"tongjian_id":"93f7e588-db0e-11ef-b9d9-a0d3651f611f"},{"place_name":"巴山縣","place_name_jianti_auto":"巴山县","start_index":76,"tongjian_id":"93f7e589-db0e-11ef-aa5a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"賢曰：閬中、江州，皆縣名，並屬巴郡。閬中，今隆州縣也。江州故城，在渝州巴縣西。宋白曰：今渝州江津縣，本漢江州縣。史記曰：楚肅王爲扞關以拒蜀，故基在今峽州巴山縣。","note_content_jianti_auto":"贤曰：阆中、江州，皆县名，并属巴郡。阆中，今隆州县也。江州故城，在渝州巴县西。宋白曰：今渝州江津县，本汉江州县。史记曰：楚肃王为扞关以拒蜀，故基在今峡州巴山县。","note_type":"hu_note","start_index":21,"tongjian_id":"93f7e576-db0e-11ef-9046-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":0,"tongjian_id":"93f7e58c-db0e-11ef-bc7e-a0d3651f611f"},{"place_name":"益州","place_name_jianti_auto":"益州","start_index":1,"tongjian_id":"93f7e58d-db0e-11ef-b699-a0d3651f611f"},{"place_name":"漢中","place_name_jianti_auto":"汉中","start_index":4,"tongjian_id":"93f7e58e-db0e-11ef-9443-a0d3651f611f"},{"place_name":"巴郡","place_name_jianti_auto":"巴郡","start_index":7,"tongjian_id":"93f7e58f-db0e-11ef-969b-a0d3651f611f"},{"place_name":"廣漢","place_name_jianti_auto":"广汉","start_index":10,"tongjian_id":"93f7e590-db0e-11ef-9751-a0d3651f611f"},{"place_name":"蜀郡","place_name_jianti_auto":"蜀郡","start_index":13,"tongjian_id":"93f7e591-db0e-11ef-938c-a0d3651f611f"},{"place_name":"犍爲","place_name_jianti_auto":"犍为","start_index":16,"tongjian_id":"93f7e592-db0e-11ef-b92f-a0d3651f611f"},{"place_name":"牂柯","place_name_jianti_auto":"牂柯","start_index":19,"tongjian_id":"93f7e593-db0e-11ef-b23f-a0d3651f611f"},{"place_name":"越巂","place_name_jianti_auto":"越巂","start_index":22,"tongjian_id":"93f7e594-db0e-11ef-a7ca-a0d3651f611f"},{"place_name":"益州","place_name_jianti_auto":"益州","start_index":25,"tongjian_id":"93f7e595-db0e-11ef-9aee-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢益州部漢中、巴郡、廣漢、蜀郡、犍爲、牂柯、越巂、益州等郡。","note_content_jianti_auto":"汉益州部汉中、巴郡、广汉、蜀郡、犍为、牂柯、越巂、益州等郡。","note_type":"hu_note","start_index":30,"tongjian_id":"93f7e58b-db0e-11ef-8ee6-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":2754,"start_index":10,"tongjian_id":"93f7e598-db0e-11ef-8d25-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、成都府（卷六十七）","excerpts":[{"context_after":"诸葛武侯用巴蜀，北出秦川，魏人骚动。晋季雄窃成都，亦能北...","context_before":"...力，战胜荥阳、成皋间，卒有天下。故取天下之规，常在巴蜀。","source_end_index":144,"source_paragraph_tongjian_id":"44dfd997-fb76-5aa8-8de9-d1fbb0d6a37d","source_start_index":121,"source_text":"公孙述之据蜀也，北连秦陇，东逼荆州，号为盛强。"}],"path":"四川方舆纪要/一、成都府（卷六十七）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、夔州府（卷六十九）","excerpts":[{"context_after":"田戎出江关，拔巫及夷道、夷陵，据荆门、虎牙[见湖广重险]...","context_before":"...置江关、阳关[阳关，见重庆府涪州。扞关，见湖广长阳县]。","source_end_index":171,"source_paragraph_tongjian_id":"81bf4ab9-52a8-5056-b002-86a043206e13","source_start_index":125,"source_text":"公孙述使将军侯丹开白水关[见汉中府宁羌州]，北守南郑，任满下江州[今重庆府巴县]，东据捍关。"}],"path":"四川方舆纪要/四、夔州府（卷六十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/五、重庆府（卷六十九）","excerpts":[{"context_after":"先主初入蜀，亦自江州而北[建安十九年，诸葛武侯等由巴东至...","context_before":"...时，巴人据此，常与强楚争衡。秦得其地，而谋楚之道愈多矣。","source_end_index":91,"source_paragraph_tongjian_id":"6f147af3-12bc-5220-a93e-37421e0a8ee6","source_start_index":55,"source_text":"公孙述之据蜀也，遣将从阆中下江州，东据扞关，光武使岑彭讨述，自江州而进。"},{"context_after":"建武十一年，岑彭讨述，述将田戎败保江州。彭至城下，以城固...","context_before":"○江州城[在府治西。相传秦张仪所筑，置县于此。汉因之。","source_end_index":48,"source_paragraph_tongjian_id":"4477887b-7445-5af2-b263-240de0128ecb","source_start_index":27,"source_text":"后汉初，公孙述据蜀，遣将从阆中下江州是也。"}],"path":"四川方舆纪要/五、重庆府（卷六十九）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/七、荆州府（卷七十八）","excerpts":[{"context_after":"亦谓之楚关。建安十三年，甘宁献策于孙权，据夏口，鼓行而西...","context_before":"...险置关，以相防捍。李熊说公孙述曰：东守巴郡，拒捍关之口。","source_end_index":205,"source_paragraph_tongjian_id":"2b56b5ed-dc66-5aa1-b324-8023a7df2c1f","source_start_index":184,"source_text":"建武二年，述使任满从阆中下江州，东据捍关。"}],"path":"湖广方舆纪要/七、荆州府（卷七十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"公孫述又遣將軍任滿從閬中下江州，東據扞關，於是盡有益州之地。","content_fanyi":"公孙述又派遣将军任满从阆中县沿嘉陵江南下攻陷江州县，向东占据扞关，于是完全据有益州之地。","content_jianti_auto":"公孙述又遣将军任满从阆中下江州，东据扞关，于是尽有益州之地。","dtjl_paragraph_links":[],"dtjl_references":[],"id":3088,"path":"资治通鉴 : 卷第四十 (漢紀三十二) / 世祖光武皇帝上之上 / 二年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"93f7e575-db0e-11ef-b62b-a0d3651f611f","year_int":26},"tongjian_id":"93f7e575-db0e-11ef-b62b-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"閬中","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賢","people_name_jianti_auto":"贤","start_index":8,"tongjian_id":"961e9e17-db0e-11ef-86ce-a0d3651f611f"},{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":26,"tongjian_id":"961e9e18-db0e-11ef-85f7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"閬中縣","place_name_jianti_auto":"阆中县","start_index":0,"tongjian_id":"961e9e19-db0e-11ef-906d-a0d3651f611f"},{"place_name":"巴郡","place_name_jianti_auto":"巴郡","start_index":5,"tongjian_id":"961e9e1a-db0e-11ef-b210-a0d3651f611f"},{"place_name":"閬中","place_name_jianti_auto":"阆中","start_index":12,"tongjian_id":"961e9e1b-db0e-11ef-94d7-a0d3651f611f"},{"place_name":"隆州","place_name_jianti_auto":"隆州","start_index":22,"tongjian_id":"961e9e1c-db0e-11ef-8169-a0d3651f611f"},{"place_name":"閬水","place_name_jianti_auto":"阆水","start_index":30,"tongjian_id":"961e9e1d-db0e-11ef-a29d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閬中縣，屬巴郡。賢曰：臨閬中水，因以爲名，今隆州縣。宋白曰：閬水紆曲，經其三面，縣居其中，取以名之。","note_content_jianti_auto":"阆中县，属巴郡。贤曰：临阆中水，因以为名，今隆州县。宋白曰：阆水纡曲，经其三面，县居其中，取以名之。","note_type":"hu_note","start_index":9,"tongjian_id":"961e9e16-db0e-11ef-bdde-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":2754,"start_index":4,"tongjian_id":"961e9e1e-db0e-11ef-b400-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9庚午，閬中山崩。","content_fanyi":"六月初八日庚午，阆中县发生山崩。","content_jianti_auto":"9庚午，阆中山崩。","dtjl_paragraph_links":[],"dtjl_references":[],"id":4218,"number":9,"path":"资治通鉴 : 卷第五十 (漢紀四十二) / 孝安皇帝中 / 三年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"961e9e15-db0e-11ef-b9a3-a0d3651f611f","year_int":124},"tongjian_id":"961e9e15-db0e-11ef-b9a3-a0d3651f611f"},"paragraph_order":2},{"mention_count":1,"paragraph_brief":{"brief_for":"閬中","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":17,"source_start_index":8,"source_text":"事見六十卷初平二年","target_paragraph_tongjian_id":"984a3c68-db0e-11ef-951e-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"魯","people_name_jianti_auto":"鲁","start_index":0,"tongjian_id":"98ff63d8-db0e-11ef-a6c8-a0d3651f611f"},{"people_name":"脩","people_name_jianti_auto":"修","start_index":3,"tongjian_id":"98ff63d9-db0e-11ef-912e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"漢中","place_name_jianti_auto":"汉中","start_index":5,"tongjian_id":"98ff63da-db0e-11ef-80d1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"魯初與脩取漢中，事見六十卷初平二年。","note_content_jianti_auto":"鲁初与修取汉中，事见六十卷初平二年。","note_type":"hu_note","start_index":30,"tongjian_id":"98ff63d7-db0e-11ef-b31e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"閬中縣","place_name_jianti_auto":"阆中县","start_index":0,"tongjian_id":"98ff63dc-db0e-11ef-8dfd-a0d3651f611f"},{"place_name":"巴郡","place_name_jianti_auto":"巴郡","start_index":5,"tongjian_id":"98ff63dd-db0e-11ef-81d6-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閬中縣，屬巴郡。","note_content_jianti_auto":"阆中县，属巴郡。","note_type":"hu_note","start_index":79,"tongjian_id":"98ff63db-db0e-11ef-9547-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"譙周","people_name_jianti_auto":"谯周","start_index":0,"tongjian_id":"98ff63df-db0e-11ef-a022-a0d3651f611f"},{"people_name":"和帝","people_name_jianti_auto":"和帝","start_index":6,"tongjian_id":"98ff63e0-db0e-11ef-b6a4-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"宕渠","place_name_jianti_auto":"宕渠","start_index":13,"tongjian_id":"98ff63e1-db0e-11ef-ab5c-a0d3651f611f"},{"place_name":"漢昌縣","place_name_jianti_auto":"汉昌县","start_index":18,"tongjian_id":"98ff63e2-db0e-11ef-a923-a0d3651f611f"},{"place_name":"巴郡","place_name_jianti_auto":"巴郡","start_index":23,"tongjian_id":"98ff63e3-db0e-11ef-8640-a0d3651f611f"},{"place_name":"賨","place_name_jianti_auto":"賨","start_index":30,"tongjian_id":"98ff63e4-db0e-11ef-a8e7-a0d3651f611f"},{"place_name":"賨","place_name_jianti_auto":"賨","start_index":39,"tongjian_id":"98ff63e5-db0e-11ef-a153-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"譙周巴記曰：和帝永元中，分宕渠之地置漢昌縣，屬巴郡。夷人歲入賨錢，口四十，謂之賨民。賨，徂宗翻。","note_content_jianti_auto":"谯周巴记曰：和帝永元中，分宕渠之地置汉昌县，属巴郡。夷人岁入賨钱，口四十，谓之賨民。賨，徂宗翻。","note_type":"hu_note","start_index":89,"tongjian_id":"98ff63de-db0e-11ef-9f9b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"98ff63d6-db0e-11ef-b9af-a0d3651f611f","pinyin":"cóng","source_anchor_text":"輒召漢昌賨民為兵或","source_key":"baiyang_epub","start_index":84,"text":"賨","tongjian_id":"f9de4f9b-d5d0-54a6-8bbe-6059c378ace2"}],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":2754,"start_index":73,"tongjian_id":"98ff63f6-db0e-11ef-8b3e-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、汉中府（卷五十六）","excerpts":[{"context_after":"魏武征汉中，走张鲁，复为汉中郡。旋入于蜀汉，分置梁州治焉...","context_before":"...室嘉为汉中王。既而公孙述有其地]。寻讨平之，仍为汉中郡。","source_end_index":123,"source_paragraph_tongjian_id":"b814c544-ef1d-5521-8d52-cf317497852b","source_start_index":106,"source_text":"后汉末，张鲁据其地，改汉中曰汉宁。"}],"path":"陕西方舆纪要/四、汉中府（卷五十六）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、保宁府（卷六十八）","excerpts":[{"context_after":"自唐以后，皆为阆中县治。明洪武七年，徙县治于府治西南，其...","context_before":"○阆中城[府东二十里。秦筑。亦谓之张仪城。县旧治此。","source_end_index":61,"source_paragraph_tongjian_id":"cd9a1803-4ce8-5ece-a7c8-48c2742516dd","source_start_index":26,"source_text":"后汉建安五年，刘璋以张鲁据汉中，以庞羲为巴郡太守，屯阆中以御鲁。即此。"},{"context_after":"后分属巴西郡。蜀汉及晋因之。东晋后荒废。萧梁置梁广县，为...","context_before":"...。汉宕渠县地。后汉永元中，分宕渠北界置汉昌县，仍属巴郡。","source_end_index":60,"source_paragraph_tongjian_id":"3451dd14-560d-511b-9878-4e1cb0cf9473","source_start_index":36,"source_text":"建安五年，巴郡守庞羲召汉昌賨民为兵为刘璋，即此。"}],"path":"四川方舆纪要/二、保宁府（卷六十八）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"11張魯以劉璋闇懦，不復承順，襲別部司馬張脩，殺之而幷其衆。璋怒，殺魯母及弟，魯遂據漢中，與璋爲敵。璋遣中郞將龐羲擊之，不克。璋以羲爲巴郡太守，屯閬中以禦魯。羲輒召漢昌賨民爲兵，或構羲於璋，璋疑之。趙韙數諫不從，亦恚恨。","content_fanyi":"张鲁认为刘璋昏庸懦弱，不再顺从，袭击别部司马张脩，将他杀死并吞并了他的部众。刘璋大怒，杀了张鲁的母亲和弟弟，张鲁于是占据汉中，与刘璋为敌。刘璋派中郎将庞羲进攻张鲁，未能取胜。刘璋任命庞羲为巴郡太守，驻守阆中以抵御张鲁。庞羲擅自征召汉昌的賨人为兵，有人在刘璋面前诬陷庞羲，刘璋怀疑他。赵韪多次劝谏，刘璋不听从，赵韪也心怀怨恨。","content_jianti_auto":"11张鲁以刘璋暗懦，不复承顺，袭别部司马张修，杀之而幷其众。璋怒，杀鲁母及弟，鲁遂据汉中，与璋为敌。璋遣中郞将庞羲击之，不克。璋以羲为巴郡太守，屯阆中以御鲁。羲辄召汉昌賨民为兵，或构羲于璋，璋疑之。赵韪数谏不从，亦恚恨。","dtjl_paragraph_links":[],"dtjl_references":[],"id":5508,"number":11,"path":"资治通鉴 : 卷第六十三 (漢紀五十五) / 孝獻皇帝戊 / 五年 / 第 46 段","reading_annotation_sources":[],"start_index":45,"tongjian_id":"98ff63d6-db0e-11ef-b9af-a0d3651f611f","year_int":200},"tongjian_id":"98ff63d6-db0e-11ef-b9af-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"閬中","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"差，次也。過差，猶今人言過次也。","note_content_jianti_auto":"差，次也。过差，犹今人言过次也。","note_type":"hu_note","start_index":56,"tongjian_id":"9a5b6a4a-db0e-11ef-9f68-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜佑","people_name_jianti_auto":"杜佑","start_index":19,"tongjian_id":"9a5b6a4e-db0e-11ef-b959-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"閬中縣","place_name_jianti_auto":"阆中县","start_index":0,"tongjian_id":"9a5b6a4f-db0e-11ef-b4bd-a0d3651f611f"},{"place_name":"巴西郡","place_name_jianti_auto":"巴西郡","start_index":5,"tongjian_id":"9a5b6a50-db0e-11ef-9f29-a0d3651f611f"},{"place_name":"內水","place_name_jianti_auto":"内水","start_index":12,"tongjian_id":"9a5b6a51-db0e-11ef-9c45-a0d3651f611f"},{"place_name":"江州","place_name_jianti_auto":"江州","start_index":15,"tongjian_id":"9a5b6a52-db0e-11ef-867e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":23,"tongjian_id":"9a5b6a53-db0e-11ef-b0e0-a0d3651f611f"},{"place_name":"江州縣","place_name_jianti_auto":"江州县","start_index":24,"tongjian_id":"9a5b6a54-db0e-11ef-8ffc-a0d3651f611f"},{"place_name":"巴縣","place_name_jianti_auto":"巴县","start_index":30,"tongjian_id":"9a5b6a55-db0e-11ef-94bc-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閬中縣，屬巴西郡。此亦由內水下江州也。杜佑曰：漢江州縣故城在巴縣西。","note_content_jianti_auto":"阆中县，属巴西郡。此亦由内水下江州也。杜佑曰：汉江州县故城在巴县西。","note_type":"hu_note","start_index":101,"tongjian_id":"9a5b6a4d-db0e-11ef-bdbe-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"飛","people_name_jianti_auto":"飞","start_index":3,"tongjian_id":"9a5b6a57-db0e-11ef-8188-a0d3651f611f"},{"people_name":"關羽","people_name_jianti_auto":"关羽","start_index":32,"tongjian_id":"9a5b6a58-db0e-11ef-93ff-a0d3651f611f"},{"people_name":"張飛","people_name_jianti_auto":"张飞","start_index":37,"tongjian_id":"9a5b6a59-db0e-11ef-bf91-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"表當自飛上，而都督越次上之，故知其必死也。凡用兵，必觀人事，旣失關羽，又喪張飛，兵可以無出矣。","note_content_jianti_auto":"表当自飞上，而都督越次上之，故知其必死也。凡用兵，必观人事，既失关羽，又丧张飞，兵可以无出矣。","note_type":"hu_note","start_index":145,"tongjian_id":"9a5b6a56-db0e-11ef-8a3a-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[{"note_on_table":"ZZTJContent","note_on_tongjian_id":"9a5b6a49-db0e-11ef-bac0-a0d3651f611f","pinyin":"zhuā","source_anchor_text":"差又日鞭檛健兒而令","source_key":"baiyang_epub","start_index":59,"text":"檛","tongjian_id":"8598afb3-14bb-584e-ad98-c28e84715d26"}],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":2754,"start_index":95,"tongjian_id":"9a5b6a64-db0e-11ef-ba55-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、重庆府（卷六十九）","excerpts":[{"context_after":"建兴四年，丞相亮欲出军汉中，李严当知后事，自永安移屯江州...","context_before":"...，至巴郡，由江州而北。十九年，诸葛武侯等至江州，破巴郡。","source_end_index":175,"source_paragraph_tongjian_id":"4477887b-7445-5af2-b263-240de0128ecb","source_start_index":151,"source_text":"章武二年，东伐孙权，张飞自阆中发兵，会江州遇害。"}],"path":"四川方舆纪要/五、重庆府（卷六十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"初，車騎將軍張飛，雄壯威猛亞於關羽；羽善待卒伍而驕於士大夫，飛愛禮君子而不恤軍人。漢主常戒飛曰：「卿刑殺旣過差，又日鞭檛健兒而令在左右，此取禍之道也。」飛猶不悛。漢主將伐孫權，飛當率兵萬人自閬中會江州。臨發，其帳下將張達、范彊殺飛，以其首順流奔孫權。漢主聞飛營都督有表，曰：「噫，飛死矣！」","content_fanyi":"起初，车骑将军张飞，雄壮威武、勇猛善战仅次于关羽；关羽善待士兵，却对士大夫傲慢，张飞则喜爱并礼遇士大夫，却不体恤士兵。汉主刘备经常告诫张飞说：“你刑罚杀戮已经过于苛刻，又天天鞭抽棍打健儿，却让他们留在自己身边，这是自取祸患的做法。”张飞仍然不肯悔改。汉主刘备将要讨伐孙权，张飞本当率领一万兵马从阆中出发，到江州与大军会合。临出发时，他帐下的将领张达、范彊杀死张飞，拿着他的首级顺流而下投奔孙权。汉主刘备听说张飞军营的营都督有表章呈上，说道：“唉，张飞死了！”","content_jianti_auto":"初，车骑将军张飞，雄壮威猛亚于关羽；羽善待卒伍而骄于士大夫，飞爱礼君子而不恤军人。汉主常戒飞曰：「卿刑杀既过差，又日鞭檛健儿而令在左右，此取祸之道也。」飞犹不悛。汉主将伐孙权，飞当率兵万人自阆中会江州。临发，其帐下将张达、范彊杀飞，以其首顺流奔孙权。汉主闻飞营都督有表，曰：「噫，飞死矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":5880,"path":"资治通鉴 : 卷第六十九 (魏紀一) / 世祖文皇帝上 / 二年 / 第 13 段","reading_annotation_sources":[],"start_index":12,"tongjian_id":"9a5b6a49-db0e-11ef-bac0-a0d3651f611f","year_int":221},"tongjian_id":"9a5b6a49-db0e-11ef-bac0-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"閬中","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"back_reference","source_end_index":46,"source_start_index":41,"source_text":"事並見上卷","target_paragraph_tongjian_id":"cbe1985b-db0e-11ef-ab80-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"武虔裕","people_name_jianti_auto":"武虔裕","start_index":21,"tongjian_id":"cbf18bd8-db0e-11ef-995a-a0d3651f611f"},{"people_name":"夏魯奇","people_name_jianti_auto":"夏鲁奇","start_index":28,"tongjian_id":"cbf18bd9-db0e-11ef-9658-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","start_index":0,"tongjian_id":"cbf18bda-db0e-11ef-9a50-a0d3651f611f"},{"place_name":"保寧軍","place_name_jianti_auto":"保宁军","start_index":7,"tongjian_id":"cbf18bdb-db0e-11ef-9172-a0d3651f611f"},{"place_name":"閬州","place_name_jianti_auto":"阆州","start_index":11,"tongjian_id":"cbf18bdc-db0e-11ef-a0ac-a0d3651f611f"},{"place_name":"綿","place_name_jianti_auto":"绵","place_note":"四川绵阳","start_index":14,"tongjian_id":"cbf18bdd-db0e-11ef-b761-a0d3651f611f"},{"place_name":"遂","place_name_jianti_auto":"遂","place_note":"四川遂宁","start_index":16,"tongjian_id":"cbf18bde-db0e-11ef-8f1f-a0d3651f611f"},{"place_name":"綿州","place_name_jianti_auto":"绵州","start_index":25,"tongjian_id":"cbf18bdf-db0e-11ef-ac0a-a0d3651f611f"},{"place_name":"遂州","place_name_jianti_auto":"遂州","start_index":32,"tongjian_id":"cbf18be0-db0e-11ef-b316-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"閬中建節，謂置保寧軍於閬州；綿、遂益兵，謂武虔裕刺綿州，夏魯奇帥遂州，皆益兵戍之。事並見上卷上年。","note_content_jianti_auto":"阆中建节，谓置保宁军于阆州；绵、遂益兵，谓武虔裕刺绵州，夏鲁奇帅遂州，皆益兵戍之。事并见上卷上年。","note_type":"hu_note","start_index":39,"tongjian_id":"cbf18bd7-db0e-11ef-9101-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":1159,"start_index":22,"tongjian_id":"cbf18be4-db0e-11ef-bbd8-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"5壬子，孟知祥、董璋同上表言：「兩川聞朝廷於閬中建節，綿、遂益兵，無不憂恐。」上以詔書慰諭之。","content_fanyi":"壬子日，孟知祥、董璋联名上表说：“东川、西川听说朝廷在阆中设置节度使，又向绵州、遂州增派兵力，无不忧虑恐惧。”皇帝下诏书安抚劝谕他们。","content_jianti_auto":"5壬子，孟知祥、董璋同上表言：「两川闻朝廷于阆中建节，绵、遂益兵，无不忧恐。」上以诏书慰谕之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":28797,"number":5,"path":"资治通鉴 : 卷第二百七十七 (後唐紀六) / 明宗聖德和武欽孝皇帝中之下 / 長興元年 / 第 6 段","reading_annotation_sources":[],"start_index":5,"tongjian_id":"cbf18bd6-db0e-11ef-941a-a0d3651f611f","year_int":930},"tongjian_id":"cbf18bd6-db0e-11ef-941a-a0d3651f611f"},"paragraph_order":5},{"mention_count":1,"paragraph_brief":{"brief_for":"閬中","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"閬州","place_name_jianti_auto":"阆州","start_index":4,"tongjian_id":"cbfad82c-db0e-11ef-ab27-a0d3651f611f"},{"place_name":"利州","place_name_jianti_auto":"利州","start_index":9,"tongjian_id":"cbfad82d-db0e-11ef-ae27-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"九域志：閬州西北至利州二百四十里。趣，七喻翻；下同。","note_content_jianti_auto":"九域志：阆州西北至利州二百四十里。趣，七喻翻；下同。","note_type":"hu_note","start_index":11,"tongjian_id":"cbfad82b-db0e-11ef-8a05-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"李彥琦","people_name_jianti_auto":"李彦琦","start_index":2,"tongjian_id":"cbfad831-db0e-11ef-93ed-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"利","place_name_jianti_auto":"利","start_index":0,"tongjian_id":"cbfad832-db0e-11ef-ac26-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"利帥李彥琦。帥，所類翻。","note_content_jianti_auto":"利帅李彦琦。帅，所类翻。","note_type":"hu_note","start_index":55,"tongjian_id":"cbfad830-db0e-11ef-abb7-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漫天寨","place_name_jianti_auto":"漫天寨","start_index":0,"tongjian_id":"cbfad834-db0e-11ef-9dff-a0d3651f611f"},{"place_name":"利州","place_name_jianti_auto":"利州","start_index":4,"tongjian_id":"cbfad835-db0e-11ef-bb21-a0d3651f611f"},{"place_name":"小漫天","place_name_jianti_auto":"小漫天","start_index":9,"tongjian_id":"cbfad836-db0e-11ef-a5c5-a0d3651f611f"},{"place_name":"大漫天","place_name_jianti_auto":"大漫天","start_index":13,"tongjian_id":"cbfad837-db0e-11ef-b112-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漫天寨在利州北，有小漫天、大漫天二寨。","note_content_jianti_auto":"漫天寨在利州北，有小漫天、大漫天二寨。","note_type":"hu_note","start_index":67,"tongjian_id":"cbfad833-db0e-11ef-85f0-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"武信軍","place_name_jianti_auto":"武信军","start_index":0,"tongjian_id":"cbfad839-db0e-11ef-af00-a0d3651f611f"},{"place_name":"遂州","place_name_jianti_auto":"遂州","start_index":4,"tongjian_id":"cbfad83a-db0e-11ef-a01d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"武信軍，遂州。","note_content_jianti_auto":"武信军，遂州。","note_type":"hu_note","start_index":77,"tongjian_id":"cbfad838-db0e-11ef-a302-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"forward_setup","source_end_index":7,"source_start_index":0,"source_text":"爲劍門失守張本","target_paragraph_tongjian_id":"cbfe2001-db0e-11ef-8df6-a0d3651f611f"}],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"劍門","place_name_jianti_auto":"剑门","start_index":1,"tongjian_id":"cbfad83d-db0e-11ef-beb8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"爲劍門失守張本。","note_content_jianti_auto":"为剑门失守张本。","note_type":"hu_note","start_index":117,"tongjian_id":"cbfad83c-db0e-11ef-b8ef-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"閬中","place_name_jianti_auto":"阆中","resolved_place_entity_id":1159,"start_index":34,"tongjian_id":"cbfad842-db0e-11ef-9698-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"戊戌，董璋引兵趣利州，遇雨，糧運不繼，還閬州。知祥聞之，驚曰：「比破閬中，正欲徑取利州，其帥不武，必望風遁去。吾獲其倉廩，據漫天之險，北軍終不能西救武信。今董公僻處閬州，遠棄劍閣，非計也。」欲遣兵三千助守劍門；璋固辭曰：「此已有備。」","content_fanyi":"十月初八日戊戌，董璋率兵扑向利州，途中遇到大雨，粮草运输接济不上，只好退回阆州。孟知祥听说后，吃惊地说：“刚刚攻破阆中，正想径直攻取利州，利州守将并不勇武，必定会望风逃走。我们只要夺得那里的粮仓，凭借漫天寨的险要地势，北面官军终究无法向西救援遂州的武信军。如今董公局促地偏处阆州，远远丢开剑阁，这不是好的计策。”他准备派三千名士兵前去协助防守剑门；董璋坚决推辞说：“这里已有防备。”","content_jianti_auto":"戊戌，董璋引兵趣利州，遇雨，粮运不继，还阆州。知祥闻之，惊曰：「比破阆中，正欲径取利州，其帅不武，必望风遁去。吾获其仓廪，据漫天之险，北军终不能西救武信。今董公僻处阆州，远弃剑阁，非计也。」欲遣兵三千助守剑门；璋固辞曰：「此已有备。」","dtjl_paragraph_links":[],"dtjl_references":[],"id":28839,"path":"资治通鉴 : 卷第二百七十七 (後唐紀六) / 明宗聖德和武欽孝皇帝中之下 / 長興元年 / 第 48 段","reading_annotation_sources":[],"start_index":47,"tongjian_id":"cbfad82a-db0e-11ef-8afb-a0d3651f611f","year_int":930},"tongjian_id":"cbfad82a-db0e-11ef-8afb-a0d3651f611f"},"paragraph_order":6}],"page_size":10,"total_pages":1,"total_paragraphs":6},"place_name":"閬中"},"message":"success","success":true}