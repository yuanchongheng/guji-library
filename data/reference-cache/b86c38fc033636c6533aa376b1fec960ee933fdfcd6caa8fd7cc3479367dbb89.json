":7,"tongjian_id":"52030da6-20aa-4f69-81cd-43b2dd839fab"},{"confidence":0.9,"official_category":"軍事指揮","official_name":"都督荊州諸軍事","official_note":"都督荊州諸軍事是魏晉時期的地方軍事職務，負責統領荊州地區的所有軍事行動，此處王基兼任此職，加強了他在荊州的軍事權力。","official_rank":"高級軍事長官","source_snippet":"都督荊州諸軍事","start_index":14,"tongjian_id":"32d282f3-23a7-4cb3-9a1a-001f0fe1f46f"}],"ExtRef_Children_people":[{"link_birth_year":190,"link_death_year":261,"link_td_description":"王基，字伯舆，东莱曲城人。三国时曹魏重要将领，曾长期镇守与东吴接壤的州郡，且平定毌丘俭之乱和诸葛诞之乱。","link_td_id":"Q10010098","link_td_number_id":952615,"people_name":"王基","people_name_jianti_auto":"王基","people_xingming":"王基","start_index":5,"tongjian_id":"9c366a30-db0e-11ef-bf05-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"荊州","place_name_jianti_auto":"荆州","resolved_place_entity_id":103,"start_index":15,"tongjian_id":"9c366a31-db0e-11ef-967a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"5是歲，以王基爲征南將軍，都督荊州諸軍事。","content_fanyi":"这一年，魏国任命王基为征南将军，并让他都督荆州诸军事。","content_jianti_auto":"5是岁，以王基为征南将军，都督荆州诸军事。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6570,"number":5,"reading_annotation_sources":[],"start_index":4,"tongjian_id":"9c366a28-db0e-11ef-a9a6-a0d3651f611f"}],"reign_name":"四年","reign_name_jianti_auto":"四年","start_index":3,"tongjian_id":"9c3669e9-db0e-11ef-a550-a0d3651f611f","year_anno":"（己卯、二五九）","year_int":259},"message":"success","success":true}