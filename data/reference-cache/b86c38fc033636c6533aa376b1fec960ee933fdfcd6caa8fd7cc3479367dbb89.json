43,"tongjian_id":"9c3669f8-db0e-11ef-bb77-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":47,"tongjian_id":"9c3669f9-db0e-11ef-9034-a0d3651f611f"},{"place_name":"東郡","place_name_jianti_auto":"东郡","start_index":49,"tongjian_id":"9c3669fa-db0e-11ef-9150-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":52,"tongjian_id":"9c3669fb-db0e-11ef-aa06-a0d3651f611f"},{"place_name":"魏郡","place_name_jianti_auto":"魏郡","start_index":54,"tongjian_id":"9c3669fc-db0e-11ef-9ff7-a0d3651f611f"},{"place_name":"冠軍縣","place_name_jianti_auto":"冠军县","start_index":57,"tongjian_id":"9c3669fd-db0e-11ef-97fd-a0d3651f611f"},{"place_name":"南陽郡","place_name_jianti_auto":"南阳郡","start_index":62,"tongjian_id":"9c3669fe-db0e-11ef-8b3b-a0d3651f611f"},{"place_name":"陽夏縣","place_name_jianti_auto":"阳夏县","start_index":66,"tongjian_id":"9c3669ff-db0e-11ef-b57e-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":70,"tongjian_id":"9c366a00-db0e-11ef-a9bf-a0d3651f611f"},{"place_name":"陳國","place_name_jianti_auto":"陈国","start_index":72,"tongjian_id":"9c366a01-db0e-11ef-9f0f-a0d3651f611f"},{"place_name":"魏","place_name_jianti_auto":"魏","start_index":75,"tongjian_id":"9c366a02-db0e-11ef-b645-a0d3651f611f"},{"place_name":"梁國","place_name_jianti_auto":"梁国","start_index":77,"tongjian_id":"9c366a03-db0e-11ef-978e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"陳壽志曰：去年青龍仍見頓丘、冠軍、陽夏縣界井中。寧陵縣，前漢屬陳留郡，後漢、魏屬梁國。頓丘縣，漢屬東郡，魏屬魏郡。冠軍縣，屬南陽郡。陽夏縣，漢屬陳國，魏屬梁國。先，悉薦翻。夏，音賈。","note_content_jianti_auto":"陈寿志曰：去年青龙仍见顿丘、冠军、阳夏县界井中。宁陵县，前汉属陈留郡，后汉、魏属梁国。顿丘县，汉属东郡，魏属魏郡。冠军县，属南阳郡。阳夏县，汉属陈国，魏属梁国。先，悉荐翻。夏，音贾。","note_type":"hu_note","start_index":33,"tongjian_id":"9c3669ed-db0e-11ef-9a14-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":10,"chapter_name":"劝戒篇第十","chenzhu_chapter":"劝戒为史家之大作用，古所贵乎史，即取其能劝戒也。劝戒起于经历，经历不必尽由读书，然读书则可以古人之经历为经历，一展卷而千百年之得失灿然矣。故《胡注》于史事之可以垂戒者，每不惮重言以揭之曰：“可不戒哉！可不戒哉！”孔子云：“书之重，辞之複，其中必有美者焉。”此之谓也。","chenzhu_index_in_chapter":5,"chenzhu_text":"身之盖有感于皇子竑被废之事也。宋宁宗无子，养宗室子贵和，立为皇子，赐名竑。史弥远为丞相，专国政，骇不能平。初，竑好琴，弥远买美人善琴者纳之，而私厚美人家，令伺皇子动静。一日竑指舆地图示美人曰：“此琼崖州也，他日必置史弥远于此。”美人以告弥远，竑又书字于几曰：“弥远当决配八千里。”竑左右皆弥远腹心，走白弥远，弥远大惧，日夕思以处竑，而竑不知也。卒被废立，以至于被缢而死。事详《宋史》宁宗杨后及竑本传。与高贵乡公事，如出一辙，可为浮躁浅露者戒。","created_at":"2025-12-31 08:50:44","seq_in_chapter":16,"tongjian_id":"CH10-CZ005"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昭","people_name_jianti_auto":"昭","start_index":3,"tongjian_id":"9c366a07-db0e-11ef-a1b3-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"帝有誅昭之志，不務養晦，而憤鬱之氣見於辭而不能自揜，蓋亦淺矣，此其所以死於權臣之手乎！惡，烏路翻。","note_content_jianti_auto":"帝有诛昭之志，不务养晦，而愤郁之气见于辞而不能自揜，盖亦浅矣，此其所以死于权臣之手乎！恶，乌路翻。","note_type":"hu_note","start_index":89,"tongjian_id":"9c366a06-db0e-11ef-bf4c-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":211,"link_death_year":265,"link_td_description":"司马昭，字子上（小说《三国演义》为子尚），河内郡温县（今河南省温县）人，曹魏后期政治家和军事家，晋朝奠基者。官至相国，爵至晋王。司马懿与张春华的次子，司马师之弟，西晋开国皇帝司马炎之父。西晋建立后其子司马炎追尊其为文皇帝，庙号太祖。","link_td_id":"Q10000091","link_td_number_id":55992,"people_name":"司馬昭","people_name_jianti_auto":"司马昭","people_xingming":"司马昭","start_index":81,"tongjian_id":"9c366a0c-db0e-11ef-85fc-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"寧陵","place_name_jianti_auto":"宁陵","resolved_place_entity_id":1623,"start_index":10,"tongjian_id":"9c366a08-db0e-11ef-b79a-a0d3651f611f"},{"place_name":"頓丘","place_name_jianti_auto":"顿丘","resolved_place_entity_id":1602,"start_index":18,"tongjian_id":"9c366a09-db0e-11ef-95fe-a0d3651f611f"},{"place_name":"冠軍","place_name_jianti_auto":"冠军","resolved_place_entity_id":2223,"start_index":21,"tongjian_id":"9c366a0a-db0e-11ef-88d8-a0d3651f611f"},{"place_name":"陽夏","place_name_jianti_auto":"阳夏","resolved_place_entity_id":268,"start_index":24,"tongjian_id":"9c366a0b-db0e-11ef-9cc2-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["权争"],"content":"1春，正月，黃龍二見寧陵井中。先是，頓丘、冠軍、陽夏井中屢有龍見，羣臣以爲吉祥，帝曰：「龍者，君德也。上不在天，下不在田，而數屈於井，非嘉兆也。」作潛龍詩以自諷，司馬昭見而惡之。","content_fanyi":"春季，正月，黄龙两次在魏国宁陵的井中现身。此前，顿丘、冠军、阳夏地方的井中多次有龙出现，群臣认为这是吉祥的征兆。魏帝曹髦说：“龙，是君主之德的象征。它上不在天，下不在田，却多次屈居于井中，这不是好的兆头。”于是作《潜龙诗》自我讽喻，司马昭看到后十分厌恶。","content_jianti_auto":"1春，正月，黄龙二见宁陵井中。先是，顿丘、冠军、阳夏井中屡有龙见，群臣以为吉祥，帝曰：「龙者，君德也。上不在天，下不在田，而数屈于井，非嘉兆也。」作潜龙诗以自讽，司马昭见而恶之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":6566,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"9c3669eb-db0e-11ef-9c35-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"爵位","official_name":"京陵穆侯","official_note":"京陵穆侯是王昶的爵位，表示其封地在京陵，穆是谥号，侯是爵位等级。在《资治通鉴》中，爵位常作为官职或身份的一部分提及，此处用于标识王昶的身份。","official_rank":"未知","source_snippet":"京陵穆侯王昶卒","start_index":6,"tongjian_id":"53840352-3368-491b-ae7a-f2286c27fd7c"}],"ExtRef_Children_people":[{"link_death_year":259,"link_td_description":"王昶，字文舒，太原郡晋阳县（今山西省太原市）人，东汉、曹魏官员。","link_td_id":"Q10004543","link_td_number_id":668594,"people_name":"京陵穆侯","people_name_jianti_auto":"京陵穆侯","people_xingming":"王昶","start_index":6,"tongjian_id":"9c366a0f-db0e-11ef-9ff6-a0d3651f611f"},{"link_death_year":259,"link_td_description":"王昶，字文舒，太原郡晋阳县（今山西省太原市）人，东汉、曹魏官员。","link_td_id":"Q10004543","link_td_number_id":668594,"people_name":"王昶","people_name_jianti_auto":"王昶","people_xingming":"王昶","start_index":10,"tongjian_id":"9c366a10-db0e-11ef-9ea7-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"2夏，六月，京陵穆侯王昶卒。","content_fanyi":"夏季六月，魏国的京陵穆侯王昶去世。","content_jianti_auto":"2夏，六月，京陵穆侯王昶卒。","dtjl_