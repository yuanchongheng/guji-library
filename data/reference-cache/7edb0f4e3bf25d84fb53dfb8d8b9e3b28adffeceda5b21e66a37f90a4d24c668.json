_notes":[],"note_content":"少，詩沼翻；下同。","note_content_jianti_auto":"少，诗沼翻；下同。","note_type":"hu_note","start_index":90,"tongjian_id":"a871d449-db0e-11ef-ac87-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"卒，子恤翻；下同。","note_content_jianti_auto":"卒，子恤翻；下同。","note_type":"hu_note","start_index":158,"tongjian_id":"a871d44b-db0e-11ef-b930-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"中枢机构","official_name":"錄尚書事","official_note":"錄尚書事是南北朝时期的高级官职，通常由宗室或重臣担任，负责协助皇帝处理尚书省事务，具有决策和行政权力。在上下文中，江夏王義恭以此官职身份提出货币改革建议，体现了其在朝中的影响力。","official_rank":"未知","source_snippet":"錄尚書事江夏王義恭建議","start_index":38,"tongjian_id":"631bb567-8d89-4fd0-8dd9-e3298334d10c"},{"confidence":0.9,"official_category":"中枢机构","official_name":"右僕射","official_note":"右僕射是尚书省的副长官，负责协助尚书令处理政务，属于高级文官。在上下文中，何尚之以此官职身份对货币改革提出异议，反映了其在财政事务中的参与和意见。","official_rank":"未知","source_snippet":"右僕射何尚之議曰","start_index":52,"tongjian_id":"926e1ff5-ee00-40bc-a24a-437a1e45810f"}],"ExtRef_Children_people":[{"link_birth_year":413,"link_death_year":465,"link_td_description":"江夏文献王刘义恭，刘宋宗室，宋武帝刘裕第五子，母为袁美人。曾于内外出任要职，官至太宰，宋文帝、宋孝武帝及宋前废帝在位期间都任高职，亦为宋孝武帝所遗命的辅政大臣。后因谋废宋前废帝而被其残忍杀害。","link_td_id":"Q10013265","link_td_number_id":1579939,"people_name":"江夏王","people_name_jianti_auto":"江夏王","people_xingming":"刘义恭","start_index":36,"tongjian_id":"a871d44c-db0e-11ef-a77d-a0d3651f611f"},{"link_birth_year":413,"link_death_year":465,"link_td_description":"江夏文献王刘义恭，刘宋宗室，宋武帝刘裕第五子，母为袁美人。曾于内外出任要职，官至太宰，宋文帝、宋孝武帝及宋前废帝在位期间都任高职，亦为宋孝武帝所遗命的辅政大臣。后因谋废宋前废帝而被其残忍杀害。","link_td_id":"Q10013265","link_td_number_id":1579939,"people_name":"義恭","people_name_jianti_auto":"义恭","people_xingming":"刘义恭","start_index":39,"tongjian_id":"a871d44d-db0e-11ef-9c5e-a0d3651f611f"},{"link_birth_year":382,"link_death_year":460,"link_td_description":"何尚之，字彦德，庐江灊县人。东晋骠骑将军何充弟何准曾孙。南朝宋官员。","link_td_id":"Q10006834","link_td_number_id":3984949,"people_name":"何尚之","people_name_jianti_auto":"何尚之","people_xingming":"何尚之","start_index":55,"tongjian_id":"a871d44e-db0e-11ef-9340-a0d3651f611f"},{"link_birth_year":413,"link_death_year":465,"link_td_description":"江夏文献王刘义恭，刘宋宗室，宋武帝刘裕第五子，母为袁美人。曾于内外出任要职，官至太宰，宋文帝、宋孝武帝及宋前废帝在位期间都任高职，亦为宋孝武帝所遗命的辅政大臣。后因谋废宋前废帝而被其残忍杀害。","link_td_id":"Q10013265","link_td_number_id":1579939,"people_name":"義恭","people_name_jianti_auto":"义恭","people_xingming":"刘义恭","start_index":154,"tongjian_id":"a871d44f-db0e-11ef-9e5e-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["内政"],"content":"7初，上以貨重物輕，改鑄四銖錢。民多翦鑿古錢，取銅盜鑄。上患之。錄尚書事江夏王義恭建議，請以大錢一當兩。右僕射何尚之議曰：「夫泉貝之興，以估貨爲本，事存交易，豈假多鑄！數少則幣重，數多則物重，多少雖異，濟用不殊。況復以一當兩，徒崇虛價者邪！若今制遂行，富人之貲自倍，貧者彌增其困，懼非所以使之均壹也。」上卒從義恭議。","content_fanyi":"起初，宋文帝刘义隆因为货币价值过高而物价过低，下令改铸四铢钱。民间很多人剪凿古钱，取出铜料私自铸钱。皇上为此忧虑。录尚书事江夏王刘义恭建议，请求规定一枚大钱相当于两枚小钱。右仆射何尚之发表议论说：“钱币的兴起，本来是用来衡量货物价值的，其作用在于交易，哪里是要靠多铸钱币呢！钱币数量少，币值就高；数量多，物价就高，多少虽然不同，满足使用却没有差别。何况用一枚大钱抵两枚小钱，不过是抬高虚假的价钱罢了！如果这项制度最终推行下去，富人的财产自会成倍增加，穷人的困苦却会更加深重，恐怕不是使百姓贫富均等的办法。”皇上最终听从了刘义恭的建议。","content_jianti_auto":"7初，上以货重物轻，改铸四铢钱。民多翦凿古钱，取铜盗铸。上患之。录尚书事江夏王义恭建议，请以大钱一当两。右仆射何尚之议曰：「夫泉贝之兴，以估货为本，事存交易，岂假多铸！数少则币重，数多则物重，多少虽异，济用不殊。况复以一当两，徒崇虚价者邪！若今制遂行，富人之赀自倍，贫者弥增其困，惧非所以使之均壹也。」上卒从义恭议。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11621,"number":7,"reading_annotation_sources":[],"start_index":6,"tongjian_id":"a871d445-db0e-11ef-83fd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[{"relation_type":"explicit_reference","source_end_index":13,"source_start_index":0,"source_text":"義康貶見一百二十三卷十七年","target_paragraph_tongjian_id":"a82a21a2-db0e-11ef-bd3f-a0d3651f611f"}],"ExtRef_Children_people":[{"people_name":"義康","people_name_jianti_auto":"义康","start_index":0,"tongjian_id":"a871d452-db0e-11ef-ab30-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"義康貶見一百二十三卷十七年。","note_content_jianti_auto":"义康贬见一百二十三卷十七年。","note_type":"hu_note","start_index":32,"tongjian_id":"a871d451-db0e-11ef-912a-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"徐州刺史","official_note":"徐州刺史是地方行政长官，负责管理徐州地区的军政事务。在《资治通鉴》中，此处记载衡陽文王義季担任此职，并描述其因纵酒不事事而受责，最终病逝，反映了官职与人物行为的关联。","official_rank":"未知","source_snippet":"徐州刺史衡陽文王義季卒","start_index":12,"tongjian_id":"0e3457bc-f37c-4c39-8ef3-56d40d4b8532"},{"confidence":0.9,"official_category":"王爵","official_name":"彭城王","official_note":"彭城王是封爵，属于王爵类别，通常授予皇室成员。在上下文中，義康被贬，可能涉及政治变动，官职在此作为背景信息出现。","official_rank":"未知","source_snippet":"彭城王義康之貶","start_index":28,"tongjian_id":"7bc1de28-57ab-4976-b3fc-fea572ff5291"}],"ExtRef_Children_people":[{"link_birth_year":415,"link_death_year":447,"link_td_description":"刘义季，南朝宋政治人物，宋武帝刘裕第七子，母为吕美人。","link_td_id":"Q10013269","link_td_number_id":1579963,"people_name":"衡陽文王","people_name_jianti_auto":"衡阳文王","people_xingming":"刘义季","start_index":13,"tongjian_id":"a871d454-db0e-11ef-8ca6-a0d3651f611f"},{"link_birth_year":415,"link_death_year":447,"link_td_description":"刘义季，南朝宋政治人物，宋武帝刘裕第七子，母为吕美人。","link_td_id":"Q10013269","link_td_number_id":1579963,"people_name":"義季","people_name_jianti_auto":"义季","people_xingming":"刘义季","start_index":17,"tongjian_id":"a871d455-db0e-11ef-9973-a0d3651f611f"},{"link_birth_year":415,"link_death_year":447,"link_td_description":"刘义季，南朝宋政治人物，宋武帝刘裕第七子，母为吕美人。","link_td_id":"Q10013269","link_td_number_id":1579963,"people_name":"義季","people_name_jianti_auto":"义季","people_xingming":"刘义季","start_index":21,"tongjian_id":"a871d456-db0e-11ef-b07c-a0d3651f611f"},{"link_birth_year":409,"link_death_year":451,"link_td_description":"刘义康，小字车子，彭城郡绥舆里（今安徽省萧县）人。南朝宋皇子，宋武帝刘裕第四子，母亲是美人王氏，兄长为宋文帝。","link_td_id":"Q10000985","link_td_number_id":515882,"people_name":"彭城王","people_name_jianti_auto":"彭城王","people_xingming":"刘义康","start_index":24,"tongjian_id":"a871d457-db0e-11ef-ab37-a0d3651f611f"},{"link_birth_year":409,"link_death_year":451,"link_td_description":"刘义康，小字车子，彭城郡绥舆里（今安徽省萧县）人。南朝宋皇子，宋武帝刘裕第四子，母亲是美人王氏，兄长为宋文帝。","link_td_id":"Q10000985","link_td_number_id":515882,"people_name":"義康","people_name_jianti_auto":"义康","people_xingming":"刘义康","start_index":27,"tongjian_id":"a871d458-db0e-11ef-aad7-a0d3651f611f"},{"link_birth_year":415,"link_death_year":447,"link_td_description":"刘义季，南朝宋政治人物，宋武帝刘裕第七子，母为吕美人。","link_td_id":"Q10013269","link_td_number_id":1579963,"people_name":"義季","people_name_jianti_auto":"义季","people_xingming":"刘义季","start_index":49,"tongjian_id":"a871d45a-db0e-11ef-abfe-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"徐州","place_name_jianti_auto":"徐州","resolved_place_entity_id":191,"start_index":9,"tongjian_id":"a871d459-db0e-11ef-9a16-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"8秋，八月，乙未，徐州刺史衡陽文王義季卒。義季自彭城王義康之貶，遂縱酒不事事。帝以書誚責，且戒之；義季猶酣飲自若，以至成疾而終。","content_fanyi":"秋季，八月乙未日，徐州刺史衡阳文王刘义季去世。刘义季自从彭城王刘义康被贬之后，便放纵饮酒，不处理政事。文帝写信责备并告诫他；刘义季仍然酣饮如故，因而得病去世。","content_jianti_auto":"8秋，八月，乙未，徐州刺史衡阳文王义季卒。义季自彭城王义康之贬，遂纵酒不事事。帝以书诮责，且戒之；义季犹酣饮自若，以至成疾而终。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11622,"number":8,"reading_annotation_sources":[],"start_index":7,"tongjian_id":"a871d450-db0e-11ef-87b5-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"封爵","official_name":"樂安宣王","official_note":"樂安宣王是北魏的封爵，樂安為封地，宣為諡號，王為爵位，表示範（人物）的貴族身份，在上下文中用於標記其去世事件。","official_rank":"王爵","source_snippet":"魏樂安宣王範卒。","start_index":1,"tongjian_id":"58ed2a4f-5a1a-49cd-a8d3-caae687070c2"}],"ExtRef_Children_people":[{"link_death_year":447,"link_td_description":"拓跋范，魏明元帝拓跋嗣之子，生母慕容夫人，北魏宗室、官员。","link_td_id":"Q10011816","link_td_number_id":1365047,"people_name":"樂安宣王","people_name_jianti_auto":"乐安宣王","people_xingming":"拓跋范","start_index":2,"tongjian_id":"a871d45c-db0e-11ef-89ab-a0d3651f611f","wl_zhushi":"[拓跋]"},{"link_death_year":447,"link_td_description":"拓跋范，魏明元帝拓跋嗣之子，生母慕容夫人，北魏宗室、官员。","link_td_id":"Q10011816","link_td_number_id":1365047,"people_name":"範","people_name_jianti_auto":"范","people_xingming":"拓跋范","start_index":6,"tongjian_id":"a871d45d-db0e-11ef-9276-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":1,"tongjian_id":"a871d45e-db0e-11ef-a470-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"9魏樂安宣王範卒。","content_fanyi":"北魏乐安宣王拓跋范逝世。","content_jianti_auto":"9魏乐安宣王范卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11623,"number":9,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"a871d45b-db0e-11ef-8310-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否响应胡诞世拥立，参与反叛","decision_tongjian_id":"DECISION_A871D45FDB0E11EF8141A0D3651F611F_01"},{"decision_name":"路过豫章时，是否介入平定胡诞世叛乱","decision_tongjian_id":"DECISION_A871D45FDB0E11EF8141A0D3651F611F_02"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"胡藩","people_name_jianti_auto":"胡藩","start_index":0,"tongjian_id":"a871d461-db0e-11ef-82ba-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"豫章","place_name_jianti_auto":"豫章","start_index":4,"tongjian_id":"a871d462-db0e-11ef-ba53-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"胡藩家于豫章。","note_content_jianti_auto":"胡藩家于豫章。","note_type":"hu_note","start_index":29,"tongjian_id":"a871d460-db0e-11ef-ad3d-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"豫章太守","official_note":"豫章太守是豫章郡的最高行政长官，负责地方治理。在《资治通鉴》此段中，桓隆之担任此职，被胡藩之子诞世杀害，引发叛乱。","official_rank":"未知","source_snippet":"豫章太守桓隆之","start_index":18,"tongjian_id":"81ed53f3-4ccd-40b2-b3d8-d21bff782fec"},{"confidence":0.9,"official_category":"宗室封爵","official_name":"前彭城王","official_note":"彭城王是刘宋宗室的封爵，此处指刘义康，他曾任彭城王，后被废黜。在上下文中，叛乱者欲奉他为领袖，反映其政治影响力。","official_rank":"王爵","source_snippet":"前彭城王義康","start_index":30,"tongjian_id":"0f0f85a7-e070-48e8-a26f-6064aae48b1e"},{"confidence":0.95,"official_category":"地方行政","official_name":"前交州刺史","official_note":"交州刺史是交州的最高行政和军事长官，负责边疆治理。檀和之曾任此职，去官后路过豫章，参与平定叛乱。","official_rank":"未知","source_snippet":"前交州刺史檀和之","start_index":36,"tongjian_id":"234f5767-6b9b-47ba-9c18-733c8633c298"}],"ExtRef_Children_people":[{"link_birth_year":372,"link_death_year":433,"link_td_description":"胡藩，字道序，豫章南昌（今江西南昌）人。东晋末年及南朝宋初年将领。胡藩早年跟随桓玄，在桓玄兵败后还家，为刘裕所召命，参与多场战事，为南朝宋的开国功臣。","link_td_id":"Q10017288","link_td_number_id":4798238,"people_name":"胡藩","people_name_jianti_auto":"胡藩","people_xingming":"胡藩","start_index":10,"tongjian_id":"a871d464-db0e-11ef-bc1f-a0d3651f611f"},{"people_name":"誕世","people_name_jianti_auto":"诞世","people_xingming":"胡诞世","start_index":14,"tongjian_id":"a871d465-db0e-11ef-bcd9-a0d3651f611f"},{"people_name":"桓隆之","people_name_jianti_auto":"桓隆之","people_xingming":"桓隆之","start_index":21,"tongjian_id":"a871d466-db0e-11ef-8c09-a0d3651f611f"},{"link_birth_year":409,"link_death_year":451,"link_td_description":"刘义康，小字车子，彭城郡绥舆里（今安徽省萧县）人。南朝宋皇子，宋武帝刘裕第四子，母亲是美人王氏，兄长为宋文帝。","link_td_id":"Q10000985","link_td_number_id":515882,"people_name":"彭城王","people_name_jianti_auto":"彭城王","people_xingming":"刘义康","start_index":32,"tongjian_id":"a871d468-db0e-11ef-b252-a0d3651f611f"},{"link_birth_year":409,"link_death_year":451,"link_td_description":"刘义康，小字车子，彭城郡绥舆里（今安徽省萧县）人。南朝宋皇子，宋武帝刘裕第四子，母亲是美人王氏，兄长为宋文帝。","link_td_id":"Q10000985","link_td_number_id":515882,"people_name":"義康","people_name_jianti_auto":"义康","people_xingming":"刘义康","start_index":35,"tongjian_id":"a871d469-db0e-11ef-9758-a0d3651f611f"},{"link_death_year":456,"link_td_description":"檀和之，高平郡金鄉縣人。劉宋時期將領，父親是與宋武帝劉裕一同起事討伐桓玄的晉將檀憑之。檀和之曾參與討伐林邑，平定胡誕世之亂及元嘉北伐等戰事。","link_td_id":"Q10017231","link_td_number_id":4788422,"people_name":"檀和之","people_name_jianti_auto":"檀和之","people_xingming":"檀和之","start_index":45,"tongjian_id":"a871d46a-db0e-11ef-a019-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"豫章","place_name_jianti_auto":"豫章","resolved_place_entity_id":310,"start_index":17,"tongjian_id":"a871d467-db0e-11ef-b75a-a0d3651f611f"},{"place_name":"交州","place_name_jianti_auto":"交州","resolved_place_entity_id":374,"start_index":41,"tongjian_id":"a871d46b-db0e-11ef-bbe0-a0d3651f611f"},{"place_name":"豫章","place_name_jianti_auto":"豫章","resolved_place_entity_id":310,"start_index":53,"tongjian_id":"a871d46c-db0e-11ef-a751-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["军事","权争"],"content":"10冬，十月，壬午，胡藩之子誕世殺豫章太守桓隆之，據郡反，欲奉前彭城王義康爲主；前交州刺史檀和之去官歸，過豫章，擊斬之。","content_fanyi":"冬季十月壬午日，刘宋胡藩之子胡诞世杀死豫章太守桓隆之，占据郡城反叛，打算拥立前彭城王刘义康为主；前交州刺史檀和之离任回京，途经豫章，出击斩杀胡诞世。","content_jianti_auto":"10冬，十月，壬午，胡藩之子诞世杀豫章太守桓隆之，据郡反，欲奉前彭城王义康为主；前交州刺史檀和之去官归，过豫章，击斩之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11624,"number":10,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"a871d45f-db0e-11ef-8141-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"地方行政","official_name":"汝陰王","official_note":"汝陰王是封爵，表示皇子渾被封为汝阴王，属于地方封王，在资治通鉴中常见于皇帝封赏宗室成员。","official_rank":"王爵","source_snippet":"封皇子渾爲汝陰王","start_index":11,"tongjian_id":"bf6be2be-0bbf-4036-8cda-c752b41b618a"}],"ExtRef_Children_people":[{"link_birth_year":439,"link_death_year":455,"link_td_description":"刘浑，字休渊，刘宋文帝刘义隆第十子，母为江修仪。刘浑在宋官至雍州刺史，但他年轻而凶狠暴戾，做出很多乖张的事，在雍州就因自号楚王之事而被宋孝武帝赐死。","link_td_id":"Q10002087","link_td_number_id":1073970,"people_name":"渾","people_name_jianti_auto":"浑","people_xingming":"刘浑","start_index":12,"tongjian_id":"a872baa9-db0e-11ef-9229-a0d3651f611f"},{"link_birth_year":439,"link_death_year":455,"link_td_description":"刘浑，字休渊，刘宋文帝刘义隆第十子，母为江修仪。刘浑在宋官至雍州刺史，但他年轻而凶狠暴戾，做出很多乖张的事，在雍州就因自号楚王之事而被宋孝武帝赐死。","link_td_id":"Q10002087","link_td_number_id":1073970,"people_name":"汝陰王","people_name_jianti_auto":"汝阴王","people_xingming":"刘浑","start_index":14,"tongjian_id":"a872baaa-db0e-11ef-82dd-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"11十一月，甲寅，封皇子渾爲汝陰王。","content_fanyi":"十一月甲寅日，文帝把皇子刘浑封为汝阴王。","content_jianti_auto":"11十一月，甲寅，封皇子浑为汝阴王。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11625,"number":11,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"a872baa8-db0e-11ef-8d24-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"燾","people_name_jianti_auto":"焘","start_index":12,"tongjian_id":"a872baad-db0e-11ef-9620-a0d3651f611f"},{"people_name":"晉王","people_name_jianti_auto":"晋王","start_index":38,"tongjian_id":"a872baae-db0e-11ef-98aa-a0d3651f611f"},{"people_name":"燾","people_name_jianti_auto":"焘","start_index":44,"tongjian_id":"a872baaf-db0e-11ef-a7f2-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：宋·索虜傳曰：「燾所住屠蘇爲疾雷所擊，屠蘇倒，見壓殆死。左右皆號泣，晉王獨不悲。燾怒，賜死。」此出於傳聞。今從後魏書。","note_content_jianti_auto":"考异曰：宋·索虏传曰：「焘所住屠苏为疾雷所击，屠苏倒，见压殆死。左右皆号泣，晋王独不悲。焘怒，赐死。」此出于传闻。今从后魏书。","note_type":"hu_note","start_index":13,"tongjian_id":"a872baac-db0e-11ef-9dfa-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"地方行政","official_name":"晉王","official_note":"晉王是北魏封給宗室或功臣的王爵，通常具有地方行政和军事权力，此处指伏羅的封号，用于标识其身份。","official_rank":"王爵","source_snippet":"魏晉王伏羅卒","start_index":3,"tongjian_id":"280d6d08-b283-4761-850e-aaeef55910f6"}],"ExtRef_Children_people":[{"link_death_year":448,"link_td_description":"拓跋伏罗，魏太武帝拓跋焘之子，生母越椒房，北魏宗室、官员。","link_td_id":"Q10011822","link_td_number_id":1363561,"people_name":"晉王","people_name_jianti_auto":"晋王","people_xingming":"拓跋伏罗","start_index":7,"tongjian_id":"a872bab3-db0e-11ef-9b9c-a0d3651f611f"},{"link_death_year":448,"link_td_description":"拓跋伏罗，魏太武帝拓跋焘之子，生母越椒房，北魏宗室、官员。","link_td_id":"Q10011822","link_td_number_id":1363561,"people_name":"伏羅","people_name_jianti_auto":"伏罗","people_xingming":"拓跋伏罗","start_index":9,"tongjian_id":"a872bab4-db0e-11ef-a966-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"魏","place_name_jianti_auto":"魏","resolved_place_entity_id":4,"start_index":6,"tongjian_id":"a872bab5-db0e-11ef-93ce-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"12十二月，魏晉王伏羅卒。","content_fanyi":"十二月，北魏晋王拓跋伏罗去世。","content_jianti_auto":"12十二月，魏晋王伏罗卒。","dtjl_paragraph_links":[],"dtjl_references":[],"id":11626,"number":12,"reading_annotation_sources":[{"count":1,"source":"资治通鉴考异","source_key":"资治通鉴考异"}],"start_index":11,"tongjian_id":"a872baab-db0e-11ef-b60e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[