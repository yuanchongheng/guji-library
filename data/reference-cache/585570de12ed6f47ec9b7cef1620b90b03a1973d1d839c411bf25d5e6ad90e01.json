i_auto":"潼州","start_index":23,"tongjian_id":"b33719ca-db0e-11ef-84c0-a0d3651f611f"},{"place_name":"後齊","place_name_jianti_auto":"后齐","start_index":26,"tongjian_id":"b33719cb-db0e-11ef-acf5-a0d3651f611f"},{"place_name":"睢州","place_name_jianti_auto":"睢州","start_index":30,"tongjian_id":"b33719cc-db0e-11ef-85ad-a0d3651f611f"},{"place_name":"夏丘","place_name_jianti_auto":"夏丘","start_index":36,"tongjian_id":"b33719cd-db0e-11ef-bb61-a0d3651f611f"},{"place_name":"宿豫","place_name_jianti_auto":"宿豫","start_index":39,"tongjian_id":"b33719ce-db0e-11ef-9e5d-a0d3651f611f"},{"place_name":"宿豫","place_name_jianti_auto":"宿豫","start_index":47,"tongjian_id":"b33719cf-db0e-11ef-a29c-a0d3651f611f"},{"place_name":"東楚","place_name_jianti_auto":"东楚","start_index":50,"tongjian_id":"b33719d0-db0e-11ef-815a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"按五代志，後周亦無潼州，但云下邳郡夏丘縣，梁置潼州，後齊改曰睢州，尋廢。夏丘、宿豫，相去不遠，宿豫舊東楚治所，意此時尚有此二州而志逸之也。","note_content_jianti_auto":"按五代志，后周亦无潼州，但云下邳郡夏丘县，梁置潼州，后齐改曰睢州，寻废。夏丘、宿豫，相去不远，宿豫旧东楚治所，意此时尚有此二州而志逸之也。","note_type":"hu_note","start_index":107,"tongjian_id":"b33719c4-db0e-11ef-bd1e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"席","people_name_jianti_auto":"席","start_index":18,"tongjian_id":"b33719d4-db0e-11ef-a7d6-a0d3651f611f"},{"people_name":"藉","people_name_jianti_auto":"藉","start_index":24,"tongjian_id":"b33719d5-db0e-11ef-8df9-a0d3651f611f"},{"people_name":"項羽","people_name_jianti_auto":"项羽","start_index":27,"tongjian_id":"b33719d6-db0e-11ef-bf26-a0d3651f611f"},{"people_name":"席氏","people_name_jianti_auto":"席氏","start_index":33,"tongjian_id":"b33719d7-db0e-11ef-bd47-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"魯郡","place_name_jianti_auto":"鲁郡","start_index":4,"tongjian_id":"b33719d8-db0e-11ef-bd71-a0d3651f611f"},{"place_name":"瑕丘縣","place_name_jianti_auto":"瑕丘县","start_index":6,"tongjian_id":"b33719d9-db0e-11ef-bc9d-a0d3651f611f"},{"place_name":"兗州","place_name_jianti_auto":"兖州","start_index":12,"tongjian_id":"b33719da-db0e-11ef-8691-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：魯郡瑕丘縣，舊置兗州。姓苑：席姓，其先姓藉，避項羽諱，改姓席氏。","note_content_jianti_auto":"五代志：鲁郡瑕丘县，旧置兖州。姓苑：席姓，其先姓藉，避项羽讳，改姓席氏。","note_type":"hu_note","start_index":125,"tongjian_id":"b33719d3-db0e-11ef-a71b-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"蘭陵縣","place_name_jianti_auto":"兰陵县","start_index":4,"tongjian_id":"b33719de-db0e-11ef-a49f-a0d3651f611f"},{"place_name":"承","place_name_jianti_auto":"承","start_index":10,"tongjian_id":"b33719df-db0e-11ef-83ce-a0d3651f611f"},{"place_name":"蘭陵郡","place_name_jianti_auto":"兰陵郡","start_index":13,"tongjian_id":"b33719e0-db0e-11ef-abde-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：蘭陵縣，舊曰承，置蘭陵郡。守，式又翻。","note_content_jianti_auto":"五代志：兰陵县，旧曰承，置兰陵郡。守，式又翻。","note_type":"hu_note","start_index":137,"tongjian_id":"b33719dd-db0e-11ef-bbc8-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"紇豆陵","people_name_jianti_auto":"纥豆陵","start_index":28,"tongjian_id":"b33719e3-db0e-11ef-9d5f-a0d3651f611f"},{"people_name":"魏收","people_name_jianti_auto":"魏收","start_index":37,"tongjian_id":"b33719e4-db0e-11ef-a852-a0d3651f611f"},{"people_name":"紇豆陵氏","people_name_jianti_auto":"纥豆陵氏","start_index":48,"tongjian_id":"b33719e5-db0e-11ef-8dc1-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"懷縣","place_name_jianti_auto":"怀县","start_index":4,"tongjian_id":"b33719e6-db0e-11ef-ab45-a0d3651f611f"},{"place_name":"河內郡","place_name_jianti_auto":"河内郡","start_index":7,"tongjian_id":"b33719e7-db0e-11ef-9211-a0d3651f611f"},{"place_name":"