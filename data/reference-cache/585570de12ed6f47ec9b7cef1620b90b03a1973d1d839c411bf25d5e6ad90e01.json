e-11ef-9b13-a0d3651f611f"},{"place_name":"青州","place_name_jianti_auto":"青州","start_index":8,"tongjian_id":"b3371990-db0e-11ef-a479-a0d3651f611f"},{"place_name":"齊郡","place_name_jianti_auto":"齐郡","start_index":11,"tongjian_id":"b3371991-db0e-11ef-aa6e-a0d3651f611f"},{"place_name":"齊州","place_name_jianti_auto":"齐州","start_index":16,"tongjian_id":"b3371992-db0e-11ef-95e9-a0d3651f611f"},{"place_name":"高密郡","place_name_jianti_auto":"高密郡","start_index":19,"tongjian_id":"b3371993-db0e-11ef-8426-a0d3651f611f"},{"place_name":"膠州","place_name_jianti_auto":"胶州","start_index":25,"tongjian_id":"b3371994-db0e-11ef-9d46-a0d3651f611f"},{"place_name":"東萊郡","place_name_jianti_auto":"东莱郡","start_index":28,"tongjian_id":"b3371995-db0e-11ef-a631-a0d3651f611f"},{"place_name":"光州","place_name_jianti_auto":"光州","start_index":34,"tongjian_id":"b3371996-db0e-11ef-8205-a0d3651f611f"},{"place_name":"琅邪郡","place_name_jianti_auto":"琅邪郡","start_index":37,"tongjian_id":"b3371997-db0e-11ef-b5c8-a0d3651f611f"},{"place_name":"沂水縣","place_name_jianti_auto":"沂水县","start_index":40,"tongjian_id":"b3371998-db0e-11ef-a4a9-a0d3651f611f"},{"place_name":"南青州","place_name_jianti_auto":"南青州","start_index":46,"tongjian_id":"b3371999-db0e-11ef-bed7-a0d3651f611f"},{"place_name":"後周","place_name_jianti_auto":"后周","start_index":50,"tongjian_id":"b337199a-db0e-11ef-b74c-a0d3651f611f"},{"place_name":"莒州","place_name_jianti_auto":"莒州","start_index":54,"tongjian_id":"b337199b-db0e-11ef-882e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代志：北海郡置青州。齊郡，舊曰齊州。高密郡，舊置膠州。東萊郡，舊置光州。琅邪郡沂水縣，舊置南青州，後周改爲莒州。","note_content_jianti_auto":"五代志：北海郡置青州。齐郡，旧曰齐州。高密郡，旧置胶州。东莱郡，旧置光州。琅邪郡沂水县，旧置南青州，后周改为莒州。","note_type":"hu_note","start_index":66,"tongjian_id":"b337198e-db0e-11ef-8949-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"邵公","people_name_jianti_auto":"邵公","start_index":36,"