64-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":39,"tongjian_id":"9ef0e298-db0e-11ef-adfd-a0d3651f611f"},{"place_name":"北屈縣","place_name_jianti_auto":"北屈县","start_index":40,"tongjian_id":"9ef0e299-db0e-11ef-a53f-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"北屈縣，漢屬河東郡，晉屬平陽郡，春秋晉公子夷吾所居邑也。宋白曰：慈州夾城縣，本漢北屈縣地。師古曰：屈，音居勿翻。","note_content_jianti_auto":"北屈县，汉属河东郡，晋属平阳郡，春秋晋公子夷吾所居邑也。宋白曰：慈州夹城县，本汉北屈县地。师古曰：屈，音居勿翻。","note_type":"hu_note","start_index":44,"tongjian_id":"9ef0e28b-db0e-11ef-826e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"聰","people_name_jianti_auto":"聪","start_index":11,"tongjian_id":"9ef0e29b-db0e-11ef-9de2-a0d3651f611f"},{"people_name":"濟南王","people_name_jianti_auto":"济南王","start_index":17,"tongjian_id":"9ef0e29c-db0e-11ef-934e-a0d3651f611f"},{"people_name":"驥","people_name_jianti_auto":"骥","start_index":20,"tongjian_id":"9ef0e29d-db0e-11ef-966f-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"西平城","place_name_jianti_auto":"西平城","start_index":0,"tongjian_id":"9ef0e29e-db0e-11ef-9526-a0d3651f611f"},{"place_name":"平陽","place_name_jianti_auto":"平阳","start_index":5,"tongjian_id":"9ef0e29f-db0e-11ef-8acb-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":9,"tongjian_id":"9ef0e2a0-db0e-11ef-96d1-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"西平城，在平陽西，漢主聰築以居其子濟南王驥。","note_content_jianti_auto":"西平城，在平阳西，汉主聪筑以居其子济南王骥。","note_type":"hu_note","start_index":61,"tongjian_id":"9ef0e29a-db0e-11ef-90ec-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"北屈","place_name_jianti_auto":"北屈","resolved_place_entity_id":4309,"start_index":41,"tongjian_id":"9ef0e2ab-db0e-11ef-a82c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、太原府（卷四十）","excerpts":[{"context_after":"是也。《志》云：今县西十八里有黄芦谷，又县西北二十五里有...","context_before":"...六年，刘曜自蒙山遁归，拓跋猗卢追之，战于蓝谷，曜兵大败。","source_end_index":71,"source_paragraph_tongjian_id":"44a0ea9e-21d0-5d64-bde3-9ee2c3354d9f","source_start_index":50,"source_text":"建兴初，刘琨复与猗卢谋讨刘聪，琨进据蓝谷。"}],"path":"山西方舆纪要/一、太原府（卷四十）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、平阳府（卷四十一）","excerpts":[{"context_after":"是也]。","context_before":"...永嘉五年，刘聪据晋阳，以其子骥为征西将军，筑西平城居之。","source_end_index":234,"source_paragraph_tongjian_id":"d3b7946a-d1e5-5ded-882a-80eef36c7312","source_start_index":198,"source_text":"建兴元年，并州牧刘琨伐汉，遣监军韩据德自西河而南，将攻西平，聪益军守之。"},{"context_after":"升平初，姚襄将图关中，自北屈渡河，进屯杏城。《水经》：北...","context_before":"...北，汲郡古文，翟章救郑，次于南屈。后汉及魏晋仍为北屈县。","source_end_index":152,"source_paragraph_tongjian_id":"97c57cdd-c29f-54a2-8b48-014e041af797","source_start_index":114,"source_text":"晋建兴初，并州刺史刘琨与代公猗卢伐刘聪，琨进据蓝谷，猗卢遣拓拔普根屯于北屈。"}],"path":"山西方舆纪要/二、平阳府（卷四十一）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"17六月，劉琨與代公猗盧會于陘北，謀擊漢。秋，七月，琨進據藍谷，猗盧遣拓跋普根屯于北屈。琨遣監軍韓據自西河而南，將攻西平。漢主聰遣大將軍粲等拒琨，驃騎將軍易等拒普根，蕩晉將軍蘭陽等助守西平。琨等聞之，引兵還。聰使諸軍仍屯所在，爲進取之計。","content_fanyi":"六月，刘琨与代公拓跋猗卢在陉北会合，商议进攻汉国。秋季七月，刘琨进兵占据蓝谷，拓跋猗卢派拓跋普根驻扎在北屈。刘琨派监军韩据从西河向南进军，准备攻打西平。汉主刘聪派大将军刘粲等人抵御刘琨，派骠骑将军刘易等人抵御拓跋普根，派荡晋将军兰阳等人协助守卫西平。刘琨等人听说后，率军撤回。刘聪让各军仍驻扎在原地，作出进取的部署。","content_jianti_auto":"17六月，刘琨与代公猗卢会于陉北，谋击汉。秋，七月，琨进据蓝谷，猗卢遣拓跋普根屯于北屈。琨遣监军韩据自西河而南，将攻西平。汉主聪遣大将军粲等拒琨，骠骑将军易等拒普根，荡晋将军兰阳等助守西平。琨等闻之，引兵还。聪使诸军仍屯所在，为进取之计。","dtjl_paragraph_links":[],"dtjl_references":[],"id":7581,"number":17,"path":"资治通鉴 : 卷第八十八 (晉紀十) / 孝愍皇帝上 / 建興元年 / 第 25 段","reading_annotation_sources":[],"start_index":24,"tongjian_id":"9ef0e289-db0e-11ef-8348-a0d3651f611f","year_int":313},"tongjian_id":"9ef0e289-db0e-11ef-8348-a0d3651f611f"},"paragraph_order":1},{"mention_count":1,"paragraph_brief":{"brief_for":"北屈","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_