-11ef-808c-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭赵之战","tongjian_id":"war_N0546"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/八、大同府（卷四十四）","excerpts":[{"context_after":"汉元年项羽徙封赵歇为代王。歇迁赵，立陈馀为代王。又汉高六...","context_before":"...子定代国，武灵王置代郡。又代北有礻詹礻监之戎，李牧灭之。","source_end_index":101,"source_paragraph_tongjian_id":"65146c4d-a227-5e62-a08e-2f9415dec6d4","source_start_index":55,"source_text":"秦始皇十九年，王翦灭赵。赵公子和率其宗奔代，自立为代王。二十五年，王贲自燕还攻代，虏代王嘉。"},{"context_after":"《括地志》：摩笄山，一名磨笄山，在飞狐县界北百五十里。今...","context_before":"...山麓绵延，西南与代州五台县相接，详见名山五台。○马头山，","source_end_index":70,"source_paragraph_tongjian_id":"ac13b630-8167-5545-8893-6ca65cdab9b3","source_start_index":39,"source_text":"《魏土地记》：代郡东南二十五里有马头山，即代王嘉入摩笄自杀处。"}],"path":"山西方舆纪要/八、大同府（卷四十四）","source_name":"读史方舆纪要"}],"class_tags":["军事"],"content":"2王賁攻代，虜代王嘉。","content_fanyi":"秦将王贲率军攻打代国，俘获了代王赵嘉。","content_jianti_auto":"2王贲攻代，虏代王嘉。","dtjl_paragraph_links":[],"dtjl_references":[],"id":544,"number":2,"reading_annotation_sources":[],"start_index":5,"tongjian_id":"8d671fec-db0e-11ef-9abd-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"劉恕","people_name_jianti_auto":"刘恕","start_index":38,"tongjian_id":"8d671ff7-db0e-11ef-a1e2-a0d3651f611f"},{"people_name":"禹","people_name_jianti_auto":"禹","start_index":42,"tongjian_id":"8d671ff8-db0e-11ef-a316-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":0,"tongjian_id":"8d671ff9-db0e-11ef-9804-a0d3651f611f"},{"place_name":"會稽郡","place_name_jianti_auto":"会稽郡","start_index":1,"tongjian_id":"8d671ffa-db0e-11ef-baae-a0d3651f611f"},{"place_name":"吳縣","place_name_jianti_auto":"吴县","start_index":5,"tongjian_id":"8d671ffb-db0e-11ef-864e-a0d3651f611f