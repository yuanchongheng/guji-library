:"c04280b4-11c0-4244-9b7f-d0a56d791a28"},{"confidence":0.9,"official_category":"地方行政","official_name":"鄢郢大夫","official_note":"鄢郢大夫是战国时期楚国的地方官员，负责治理鄢郢地区，此处表示这些官员不愿为秦国效力，在城南下聚集，源自《资治通鉴》上下文。","official_rank":"未知","source_snippet":"鄢郢大夫不欲爲秦","start_index":78,"tongjian_id":"cd8d6c64-dede-48c7-875f-8739c0ade917"}],"ExtRef_Children_people":[{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_td_number_id":205574,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田建","start_index":8,"tongjian_id":"8d686869-db0e-11ef-8f2a-a0d3651f611f","wl_zhushi":"[田建]"},{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_td_number_id":205574,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田建","start_index":143,"tongjian_id":"8d686876-db0e-11ef-b6da-a0d3651f611f","wl_zhushi":"[田建]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"卽墨","place_name_jianti_auto":"即墨","resolved_place_entity_id":1715,"start_index":0,"tongjian_id":"8d68686a-db0e-11ef-96a3-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","place_note":"都临淄，山东淄博东临淄镇","resolved_place_entity_id":25,"start_index":13,"tongjian_id":"8d68686b-db0e-11ef-88f5-a0d3651f611f"},{"place_name":"三晉","place_name_jianti_auto":"三晋","resolved_place_entity_id":112,"start_index":27,"tongjian_id":"8d68686c-db0e-11ef-a71b-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":34,"tongjian_id":"8d68686d-db0e-11ef-8a7a-a0d3651f611f"},{"place_name":"阿","place_name_jianti_auto":"阿","place_note":"山東东阿","resolved_place_entity_id":1567,"start_index":38,"tongjian_id":"8d68686e-db0e-11ef-ab13-a0d3651f611f"},{"place_name":"甄","place_name_jianti_auto":"甄","place_note":"鄄，山东鄄城","resolved_place_entity_id":8294,"start_index":40,"tongjian_id":"8d68686f-db0e-11ef-b9ce-a0d3651f611f"},{"place_name":"三晉","place_name_jianti_auto":"三晋","resolved_place_entity_id":112,"start_index":60,"tongjian_id":"8d686870-db0e-11ef-a3ce-a0d3651f611f"},{"place_name":"臨晉","place_name_jianti_auto":"临晋","resolved_place_entity_id":1769,"start_index":67,"tongjian_id":"8d686871-db0e-11ef-ba8e-a0d3651f611f"},{"place_name":"鄢郢","place_name_jianti_auto":"鄢郢","place_note":"安徽壽縣","resolved_place_entity_id":341,"start_index":76,"tongjian_id":"8d686872-db0e-11ef-b7fd-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":83,"tongjian_id":"8d686873-db0e-11ef-a744-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":106,"tongjian_id":"8d686874-db0e-11ef-8abb-a0d3651f611f"},{"place_name":"武關","place_name_jianti_auto":"武关","resolved_place_entity_id":840,"start_index":111,"tongjian_id":"8d686875-db0e-11ef-879b-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","resolved_place_entity_id":25,"start_index":122,"tongjian_id":"8d686877-db0e-11ef-ab74-a0d3651f611f"},{"place_name":"秦國","place_name_jianti_auto":"秦国","resolved_place_entity_id":1796,"start_index":127,"tongjian_id":"8d686878-db0e-11ef-b70a-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭齐之战","tongjian_id":"war_N0550"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"汉置鄄城县，属济阴郡。鄄，读绢。后汉末，为兖州治，曹操创...","context_before":"...齐邑。威王八年，赵伐齐，取鄄。宣王八年，与魏惠王会于鄄。","source_end_index":165,"source_paragraph_tongjian_id":"554263ec-83aa-50fc-bcc0-ceabd91a8d1d","source_start_index":138,"source_text":"又王建末，即墨大夫谓三晋大夫不便秦而在阿、鄄之间者也。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"秦始皇二十八年，自南郡繇武关归。二世二年，陈涉使其将宋留...","context_before":"...至则闭，执之以归。顷襄王元年，秦出武关攻楚，取析十五城。","source_end_index":481,"source_paragraph_tongjian_id":"e50d3daf-9bb4-555a-838d-7253c4f724ea","source_start_index":429,"source_text":"及秦并六国，东至齐，即墨大夫入见齐王曰：使鄢郢大夫收楚地，则武关可入；三晋大夫收晋地，则临晋之关可入也。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"}],"class_tags":["外交","军事"],"content":"卽墨大夫聞之，見齊王曰：「齊地方數千里，帶甲數百萬。夫三晉大夫皆不便秦，而在阿、甄之間者百數；王收而與之百萬人之衆，使收三晉之故地，卽臨晉之關可以入矣。鄢郢大夫不欲爲秦，而在城南下者百數，王收而與之百萬之師，使收楚故地，卽武關可以入矣。如此，則齊威可立，秦國可亡，豈特保其國家而已哉！」齊王不聽。","content_fanyi":"即墨大夫听说后，进见齐王建说：“齐国疆域方圆数千里，甲士有数百万。如今韩、赵、魏三国的官员都不愿接受秦国的统治，流亡在阿城、甄城之间的有数百人；大王您把这些人收拢起来，拨给他们百万人的兵众，让他们去收复韩、赵、魏三国的旧地，那么就是秦国的临晋关也可以攻入了。楚国鄢郢的官员不愿受秦国驱使，逃匿在南城之下的有数百人；大王您把这些人召集起来，配给他们百万人的军队，让他们去收复楚国故土，那么即使是武关也可以攻入了。这样一来，齐国的声威可以树立，秦国可以被灭亡，难道仅仅只是保全自己的国家而已吗！”但齐王建不肯听从。","content_jianti_auto":"即墨大夫闻之，见齐王曰：「齐地方数千里，带甲数百万。夫三晋大夫皆不便秦，而在阿、甄之间者百数；王收而与之百万人之众，使收三晋之故地，即临晋之关可以入矣。鄢郢大夫不欲为秦，而在城南下者百数，王收而与之百万之师，使收楚故地，即武关可以入矣。如此，则齐威可立，秦国可亡，岂特保其国家而已哉！」齐王不听。","dtjl_paragraph_links":[],"dtjl_references":[],"id":549,"reading_annotation_sources":[],"start_index":10,"tongjian_id":"8d686857-db0e-11ef-8135-a0d3651f611f"}],"reign_name":"二十五年","reign_name_jianti_auto":"二十五年","start_index":5,"tongjian_id":"8d6636c0-db0e-11ef-896a-a0d3651f611f","year_anno":"（己卯、前二二二）","year_int":-222},"message":"success","success":true}