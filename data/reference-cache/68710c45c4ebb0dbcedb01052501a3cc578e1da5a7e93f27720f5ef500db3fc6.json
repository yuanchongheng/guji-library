solved_place_entity_id":18,"start_index":128,"tongjian_id":"8d686840-db0e-11ef-aeb5-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":135,"tongjian_id":"8d686841-db0e-11ef-a1a5-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":137,"tongjian_id":"8d686842-db0e-11ef-b2be-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":152,"tongjian_id":"8d686843-db0e-11ef-b35d-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":166,"tongjian_id":"8d686844-db0e-11ef-bc77-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":168,"tongjian_id":"8d686845-db0e-11ef-b786-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭齐之战","tongjian_id":"war_N0550"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交","内政"],"content":"5初，齊君王后賢，事秦謹，與諸侯信；齊亦東邊海上。秦日夜攻三晉、燕、楚，五國各自救，以故齊王建立四十餘年不受兵。及君王后且死，戒王建曰：「羣臣之可用者某。」王曰：「請書之。」君王后曰：「善！」王取筆牘受言，君王后曰：「老婦已忘矣。」君王后死，后勝相齊，多受秦間金。賓客入秦，秦又多與金。客皆爲反間，勸王朝秦，不脩攻戰之備，不助五國攻秦，秦以故得滅五國。","content_fanyi":"当初，齐襄王的王后君王后既贤惠又有才干，使齐国恭谨周到地事奉秦国，对诸侯信守承诺；齐国又东临大海，与秦国并不接壤。秦国日夜攻打韩、赵、魏、燕、楚，五国各自忙于自救，无暇他顾，所以齐王田建在位四十多年没有遭受战祸。等到君王后临终前，告诫齐王建说：“群臣中可任用的是某某。”齐王建说：“请让我把名字写下来。”君王后说：“好！”齐王建取来笔和木牍准备记下她的话时，君王后却说：“我已经忘了。”君王后去世后，后胜出任齐国相国，大量收受秦国用来离间齐国君臣的金钱。齐国宾客到秦国去，秦国又送给他们很多钱。这些宾客都成了反间，劝齐王建去朝拜秦王，不要整治、修建攻战的防备设施，不要帮助五国攻打秦国，秦国因此得以灭掉五国。","content_jianti_auto":"5初，齐君王后贤，事秦谨，与诸侯信；齐亦东边海上。秦日夜攻三晋、燕、楚，五国各自救，以故齐王建立四十余年不受兵。及君王后且死，戒王建曰：「群臣之可用者某。」王曰：「请书之。」君王后曰：「善！」王取笔牍受言，君王后曰：「老妇已忘矣。」君王后死，后胜相齐，多受秦间金。宾客入秦，秦又多与金。客皆为反间，劝王朝秦，不修攻战之备，不助五国攻秦，秦以故得灭五国。","dtjl_paragraph_links":[],"dtjl_references":[],"id":547,"number":5,"reading_annotation_sources":[],"start_index":8,"tongjian_id":"8d67200a-db0e-11ef-9744-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"是否应前往秦国朝拜秦王","decision_tongjian_id":"DECISION_8D686846DB0E11EFA855A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":13,"tongjian_id":"8d686848-db0e-11ef-9c5f-a0d3651f611f"},{"people_name":"康","people_name_jianti_auto":"康","start_index":36,"tongjian_id":"8d686849-db0e-11ef-885e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":3,"tongjian_id":"8d68684a-db0e-11ef-bbf2-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":5,"tongjian_id":"8d68684b-db0e-11ef-8de3-a0d3651f611f"},{"place_name":"雍門","place_name_jianti_auto":"雍门","start_index":8,"tongjian_id":"8d68684c-db0e-11ef-a628-a0d3651f611f"},{"place_name":"雍門","place_name_jianti_auto":"雍门","start_index":17,"tongjian_id":"8d68684d-db0e-11ef-90ac-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","place_note":"都临淄，山东淄博东临淄镇","start_index":20,"tongjian_id":"8d68684e-db0e-11ef-ab73-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"左傳：晉圍齊，伐雍門之萩。杜預曰：雍門，齊城門也。經典釋文：雍，於用翻；康：於龍切，非也。","note_content_jianti_auto":"左传：晋围齐，伐雍门之萩。杜预曰：雍门，齐城门也。经典释文：雍，于用翻；康：于龙切，非也。","note_type":"hu_note","start_index":13,"tongjian_id":"8d686847-db0e-11ef-8e4f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"孟子曰：民爲大，社稷次之，君爲輕。","note_content_jianti_auto":"孟子曰：民为大，社稷次之，君为轻。","note_type":"hu_note","start_index":61,"tongjian_id":"8d686851-db0e-11ef-a8f7-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.9,"official_category":"军事指挥","official_name":"雍門司馬","official_note":"雍門司馬是战国时期齐国负责雍门（城门）守卫的司马官职，掌管军事和城门安全。在《资治通鉴》此段中，雍門司馬向齐王进谏，质疑其入朝秦国的决定，体现了其作为军事官员在国家安全事务中的角色。","official_rank":"未知","source_snippet":"雍門司馬前曰","start_index":8,"tongjian_id":"f707a602-f1ac-47bf-ac5e-0b47e609600c"}],"ExtRef_Children_people":[{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_td_number_id":205574,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田建","start_index":0,"tongjian_id":"8d686853-db0e-11ef-9e27-a0d3651f611f","wl_zhushi":"[田建]"},{"link_death_year":-221,"link_td_description":"齐王建，妫姓，田氏，本名田建，齐襄王之子，是战国时代田齐的亡国君主。他于前264年至前221年在位，在位长达44年。","link_td_id":"Q10000346","link_td_number_id":205574,"people_name":"齊王","people_name_jianti_auto":"齐王","people_xingming":"田建","start_index":61,"tongjian_id":"8d686856-db0e-11ef-b792-a0d3651f611f","wl_zhushi":"[田建]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"雍門","place_name_jianti_auto":"雍门","resolved_place_entity_id":5464,"start_index":6,"tongjian_id":"8d686854-db0e-11ef-bb0f-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":58,"tongjian_id":"8d686855-db0e-11ef-b76f-a0d3651f611f"}],"ExtRef_Children_topics":[{"title":"秦灭齐之战","tongjian_id":"war_N0550"}],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/五、青州府（卷三十五）","excerpts":[{"context_after":"是也。《说苑》：韩娥东至齐，乏粮，过雍门，鬻歌于市。其南...","context_before":"...陆子方出雍门奔卫。《战国策》：孙子说田忌轻车锐卒冲雍门。","source_end_index":140,"source_paragraph_tongjian_id":"47a90a9e-6503-5c01-9052-055c764633d9","source_start_index":125,"source_text":"又齐王建入朝秦，雍门司马入谏。"}],"path":"山东方舆纪要/五、青州府（卷三十五）","source_name":"读史方舆纪要"}],"class_tags":["内政","外交"],"content":"齊王將入朝，雍門司馬前曰：「所爲立王者，爲社稷耶，爲王耶？」王曰：「爲社稷。」司馬曰：「爲社稷立王，王何以去社稷而入秦？」齊王還車而反。","content_fanyi":"齐王建预备动身去咸阳朝见秦王政，齐国雍门司马迎上来问：“齐国所以立国君，究竟是为了国家，还是为了君王一己之身？”齐王建回答：“为了国家。”司马说：“既然为了国家才立王，大王为什么背离自己的国家前往秦国？”齐王建便命人掉转车头，返回王宫。","content_jianti_auto":"齐王将入朝，雍门司马前曰：「所为立王者，为社稷耶，为王耶？」王曰：「为社稷。」司马曰：「为社稷立王，王何以去社稷而入秦？」齐王还车而反。","dtjl_paragraph_links":[],"dtjl_references":[],"id":548,"reading_annotation_sources":[],"start_index":9,"tongjian_id":"8d686846-db0e-11ef-a855-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"8d68685a-db0e-11ef-9342-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「數」作「四」；乙十一行本同。』","note_content_jianti_auto":"『章：十二行本「数」作「四」；乙十一行本同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"8d686859-db0e-11ef-b4c1-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":17,"tongjian_id":"8d686858-db0e-11ef-8e84-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"三晉","place_name_jianti_auto":"三晋","start_index":1,"tongjian_id":"8d68685d-db0e-11ef-80c6-a0d3651f611f"},{"place_name":"河東","place_name_jianti_auto":"河东","start_index":5,"tongjian_id":"8d68685e-db0e-11ef-b995-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","start_index":8,"tongjian_id":"8d68685f-db0e-11ef-965f-a0d3651f611f"},{"place_name":"臨晉關","place_name_jianti_auto":"临晋关","start_index":11,"tongjian_id":"8d686860-db0e-11ef-ac70-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"收三晉兵自河東攻秦則入臨晉關。","note_content_jianti_auto":"收三晋兵自河东攻秦则入临晋关。","note_type":"hu_note","start_index":76,"tongjian_id":"8d68685c-db0e-11ef-828a-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Ch