{"data":{"ExtRef_Child_hu_note":{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"（己巳、前二九二）","note_content_jianti_auto":"（己巳、前二九二）","note_type":"hu_note","start_index":0,"tongjian_id":"8ca0d688-db0e-11ef-87bd-a0d3651f611f"},"ExtRef_Children_contents":[{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"楚襄王是否亲赴秦国迎娶新娘","decision_tongjian_id":"DECISION_8CA0D689DB0E11EFB8F6A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":-329,"link_death_year":-263,"link_td_description":"楚顷襄王，简称楚顷王或楚襄王，又作楚庄王（与其远祖楚庄王有别），芈姓，熊氏，名横，楚怀王之子，生母为郑袖。","link_td_id":"Q10000653","link_td_number_id":335229,"people_name":"楚襄王","people_name_jianti_auto":"楚襄王","people_xingming":"芈横","start_index":1,"tongjian_id":"8ca0d68a-db0e-11ef-b13a-a0d3651f611f","wl_zhushi":"[芈横]"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":7,"tongjian_id":"8ca0d68b-db0e-11ef-a68a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["外交"],"content":"1楚襄王迎婦於秦。","content_fanyi":"楚顷襄王自秦国迎娶新娘。","content_jianti_auto":"1楚襄王迎妇于秦。","dtjl_paragraph_links":[],"dtjl_references":[],"id":319,"number":1,"reading_annotation_sources":[],"start_index":0,"tongjian_id":"8ca0d689-db0e-11ef-b8f6-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚懷王","people_name_jianti_auto":"楚怀王","start_index":1,"tongjian_id":"8ca0d68e-db0e-11ef-91e3-a0d3651f611f"},{"people_name":"秦王","people_name_jianti_auto":"秦王","start_index":12,"tongjian_id":"8ca0d68f-db0e-11ef-8136-a0d3651f611f"},{"people_name":"襄王","people_name_jianti_auto":"襄王","start_index":16,"tongjian_id":"8ca0d690-db0e-11ef-8f3c-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":6,"tongjian_id":"8ca0d691-db0e-11ef-b832-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂楚懷王留於秦而以困死，秦王復遺襄王書，以兵威劫之。","note_content_jianti_auto":"谓楚怀王留于秦而以困死，秦王复遗襄王书，以兵威劫之。","note_type":"hu_note","start_index":20,"tongjian_id":"8ca0d68d-db0e-11ef-904d-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"杜預","people_name_jianti_auto":"杜预","start_index":0,"tongjian_id":"8ca0d693-db0e-11ef-b164-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":21,"tongjian_id":"8ca0d694-db0e-11ef-9b8c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"杜預曰：競，強也。或曰：競，爭也，言不能與秦爭也。","note_content_jianti_auto":"杜预曰：竞，强也。或曰：竞，争也，言不能与秦争也。","note_type":"hu_note","start_index":26,"tongjian_id":"8ca0d692-db0e-11ef-8a5e-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[{"chapter_global_index":4,"chapter_name":"解释篇第四","chenzhu_chapter":"解释者，以今言解古言，以今制释古制，其意义即为注，然注备众体，解释不过注之一端，广而言之，则全注均可谓之解释也。《胡注》之前，《通鉴》有《释文》数种，皆简略。身之始为广注九十七卷，亦仿释文体，乱后重注，将注散入正文，是为今本。前四史虽有旧注，不尽可从，自晋以至五代，则皆身之创为之。且每针对当时，以寓规讽，尤得以鉴名书之义。兹篇所谓解释，虽不过注之一端，亦足见其志之所存也。","chenzhu_index_in_chapter":1,"chenzhu_text":"此有憾于宋高宗之忘雠也。宋高宗父死于金，忍耻而与之和。《朱子文集》七五序魏元履编次《绍兴八年戊午谠议》曰：“君父之雠，不与共戴天，而为之说者曰，复雠可尽五世，则又以明夫苟未及五世之外，犹在乎必报之域也。虽然，此特庶民之事耳。若夫有天下者，承万世无疆之统，则亦有万世必报之雠，非若庶民五世则亲尽服穷而遂已也。”此明为南宋君臣言之，身之之解释，亦犹是耳。","created_at":"2025-12-31 08:50:44","seq_in_chapter":4,"tongjian_id":"CH04-CZ001"}],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"楚襄王","people_name_jianti_auto":"楚襄王","start_index":1,"tongjian_id":"8ca0d696-db0e-11ef-bce2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","start_index":7,"tongjian_id":"8ca0d697-db0e-11ef-9eeb-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂楚襄王父死於秦，是仇讎之國也，忍恥而與之婚。","note_content_jianti_auto":"谓楚襄王父死于秦，是仇雠之国也，忍耻而与之婚。","note_type":"hu_note","start_index":34,"tongjian_id":"8ca0d695-db0e-11ef-be9b-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[{"link_birth_year":1019,"link_death_year":1086,"link_td_description":"司马光，字君实，号迂叟，通称司马相公，陕州夏县涑水乡（今山西省夏县）人，出生于光州光山（今河南省信阳市光山县），北宋政治家、文学家、史学家。世称涑水先生，因身后追封温国公，又称司马温公。历仕仁宗、英宗、神宗、哲宗四朝，主持编纂了中国历史上第一部编年体通史《资治通鉴》。","link_td_id":"Q10000074","link_td_number_id":6432,"people_name":"光","people_name_jianti_auto":"光","people_xingming":"司马光","start_index":1,"tongjian_id":"8ca0d699-db0e-11ef-adb8-a0d3651f611f"},{"link_birth_year":-316,"link_death_year":-237,"link_td_description":"荀子，名况，战国时期赵国人，儒家学者和思想家，主张性恶论，重视礼义与后天学习，曾任齐国稷下学宫祭酒、楚国兰陵令。","link_td_id":"Q10000131","link_td_number_id":5847,"people_name":"荀卿","people_name_jianti_auto":"荀卿","people_xingming":"荀况","start_index":63,"tongjian_id":"8ca0d69c-db0e-11ef-abe6-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":6,"tongjian_id":"8ca0d69a-db0e-11ef-a617-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":20,"tongjian_id":"8ca0d69b-db0e-11ef-b208-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":37,"tongjian_id":"8ca0d69d-db0e-11ef-9d84-a0d3651f611f"},{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":51,"tongjian_id":"8ca0d69e-db0e-11ef-9b4f-a0d3651f611f"},{"place_name":"楚","place_name_jianti_auto":"楚","resolved_place_entity_id":130,"start_index":91,"tongjian_id":"8ca0d69f-db0e-11ef-8522-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["史论"],"content":"臣光曰：甚哉秦之無道也，殺其父而劫其子；楚之不競也，忍其父而婚其讎！烏呼，楚之君誠得其道，臣誠得其人，秦雖強，烏得陵之哉！善乎荀卿論之曰：「夫道，善用之則百里之地可以獨立，不善用之則楚六千里而爲讎人役。」故人主不務得道而廣有其勢，是其所以危也。","content_fanyi":"臣司马光说：秦国的无道实在太甚了，害死楚怀王，又威逼怀王的儿子顷襄王；楚国也太软弱不争气，忍下杀父之仇，竟与仇敌秦国通婚！唉，楚国国君如果真能遵行治国之道，臣子果真都是贤能之人，秦国虽然强大，又怎能欺凌楚国呢！荀卿评论得真好：“治国之道，善于运用，即使只有百里之地也可以独立；不善于运用，像楚国这样拥有六千里土地的国家也会被仇敌奴役。”所以君主不致力于求道，反而一味扩张自己的权势，这正是他危险的原因。","content_jianti_auto":"臣光曰：甚哉秦之无道也，杀其父而劫其子；楚之不竞也，忍其父而婚其雠！乌呼，楚之君诚得其道，臣诚得其人，秦虽强，乌得陵之哉！善乎荀卿论之曰：「夫道，善用之则百里之地可以独立，不善用之则楚六千里而为雠人役。」故人主不务得道而广有其势，是其所以危也。","dtjl_paragraph_links":[],"dtjl_references":[],"id":320,"reading_annotation_sources":[],"start_index":1,"tongjian_id":"8ca0d68c-db0e-11ef-8f40-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[{"decision_name":"魏冉因病辞去丞相职务","decision_tongjian_id":"DECISION_8CA0D6A0DB0E11EF9534A0D3651F611F_01"}],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"燭","people_name_jianti_auto":"烛","start_index":0,"tongjian_id":"8ca0d6a2-db0e-11ef-986c-a0d3651f611f"},{"people_name":"燭之武","people_name_jianti_auto":"烛之武","start_index":12,"tongjian_id":"8ca0d6a3-db0e-11ef-b131-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"鄭","place_name_jianti_auto":"郑","start_index":8,"tongjian_id":"8ca0d6a4-db0e-11ef-a0de-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燭，姓也。左傳，鄭有大夫燭之武。","note_content_jianti_auto":"烛，姓也。左传，郑有大夫烛之武。","note_type":"hu_note","start_index":17,"tongjian_id":"8ca0d6a1-db0e-11ef-85b4-a0d3651f611f"}],"ExtRef_Children_officials":[{"confidence":0.95,"official_category":"中枢机构","official_name":"丞相","official_note":"丞相是秦国的最高行政长官，负责辅佐君主处理国家政务。在《资治通鉴》此段中，烛寿被任命为丞相，接替因病免职的魏冉，这反映了秦国中央权力的变动。","official_rank":"正一品","source_snippet":"以客卿燭壽爲丞相","start_index":12,"tongjian_id":"8c405431-5b24-48c0-a02c-d8c3d444a4d8"}],"ExtRef_Children_people":[{"link_birth_year":-335,"link_death_year":-266,"link_td_description":"魏冉，芈姓，魏氏，名冉，亦作魏焻、魏厓，中国战国时期秦国政治家，宣太后异父弟，封於穰邑（今日河南邓州市），故为穰侯。","link_td_id":"Q10001101","link_td_number_id":672615,"people_name":"魏冉","people_name_jianti_auto":"魏冉","people_xingming":"魏冉","start_index":2,"tongjian_id":"8ca0d6aa-db0e-11ef-8292-a0d3651f611f"},{"people_name":"燭壽","people_name_jianti_auto":"烛寿","people_xingming":"烛寿","start_index":11,"tongjian_id":"8ca0d6ab-db0e-11ef-90ec-a0d3651f611f"}],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"秦","place_name_jianti_auto":"秦","resolved_place_entity_id":18,"start_index":1,"tongjian_id":"8ca0d6ac-db0e-11ef-9b79-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":["人事"],"content":"2秦魏冉謝病免，以客卿燭壽爲丞相。","content_fanyi":"秦国魏冉称病免去丞相职务，任命客卿烛寿为丞相。","content_jianti_auto":"2秦魏冉谢病免，以客卿烛寿为丞相。","dtjl_paragraph_links":[],"dtjl_references":[],"id":321,"number":2,"reading_annotation_sources":[],"start_index":2,"tongjian_id":"8ca0d6a0-db0e-11ef-9534-a0d3651f611f"}],"reign_name":"二十三年","reign_name_jianti_auto":"二十三年","start_index":5,"tongjian_id":"8ca0d687-db0e-11ef-a223-a0d3651f611f","year_anno":"（己巳、前二九二）","year_int":-292},"message":"success","success":true}