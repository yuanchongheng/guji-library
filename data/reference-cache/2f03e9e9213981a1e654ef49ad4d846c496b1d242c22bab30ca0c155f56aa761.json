er_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂韓信。","note_content_jianti_auto":"谓韩信。","note_type":"hu_note","start_index":33,"tongjian_id":"9b1aa264-db0e-11ef-9a59-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"呂望","people_name_jianti_auto":"吕望","start_index":1,"tongjian_id":"9b1aa267-db0e-11ef-9dd8-a0d3651f611f"}],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂呂望。","note_content_jianti_auto":"谓吕望。","note_type":"hu_note","start_index":42,"tongjian_id":"9b1aa266-db0e-11ef-9182-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"謂草創之規略，不可用於承平之時也。","note_content_jianti_auto":"谓草创之规略，不可用于承平之时也。","note_type":"hu_note","start_index":88,"tongjian_id":"9b1aa269-db0e-11ef-9617-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"好，呼到翻。經，常也。","note_content_jianti_auto":"好，呼到翻。经，常也。","note_type":"hu_note","start_index":94,"tongjian_id":"9b1aa26a-db0e-11ef-8899-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"津，江河濟渡之要，故以爲喻。","note_content_jianti_auto":"津，江河济渡之要，故以为喻。","note_type":"hu_note","start_index":100,"tongjian_id":"9b1aa26b-db0e-11ef-9425-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"牧野","place_name_jianti_auto":"牧野","resolved_place_entity_id":4997,"start_index":73,"tongjian_id":"9b1aa276-db0e-11ef-9267-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"17初，右僕射衞臻典選舉，中護軍蔣濟遺臻書曰：「漢主遇亡虜爲上將，周武拔漁父爲太師；布衣廝養，可登王公，何必守文，試而後用！」臻曰：「不然。子欲同牧野於成、康，喻斷蛇於文、景，好不經之舉，開拔奇之津，將使天下馳騁而起矣！」","content_fanyi":"起初，右仆射卫臻主管选拔举荐人才的事务，中护军蒋济写信给卫臻说：“汉高祖刘邦把逃亡的俘虏韩信任用为上将，周武王提拔渔父姜子牙担任太师；平民和奴仆都可以登上王公之位，何必拘守成法，先经过考试再任用呢！”卫臻说：“不对。你想把牧野之战时的用人等同于周成王、周康王时期的常规选才，把汉高祖斩蛇起义时的用人比作汉文帝、汉景帝时期的制度，喜好不合常规的举动，打开提拔奇才的门径，将会使天下人奔走竞逐、纷纷而起啊！”","content_jianti_auto":"17初，右仆射衞臻典选举，中护军蒋济遗臻书曰：「汉主遇亡虏为上将，周武拔渔父为太师；布衣厮养，可登王公，何必守文，试而后用！」臻曰：「不然。子欲同牧野于成、康，喻断蛇于文、景，好不经之举，开拔奇之津，将使天下驰骋而起矣！」","dtjl_paragraph_links":[],"dtjl_references":[],"id":6247,"number":17,"path":"资治通鉴 : 卷第七十三 (魏紀五) / 烈祖明皇帝中之下 / 景初元年 / 第 32 段","reading_annotation_sources":[],"start_index":31,"tongjian_id":"9b1aa25e-db0e-11ef-869d-a0d3651f611f","year_int":237},"tongjian_id":"9b1aa25e-db0e-11ef-869d-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"brief_for":"牧野","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"高祖","people_name_jianti_auto":"高祖","start_index":10,"tongjian_id":"b6051f69-db0e-11ef-b0eb-a0d3651f611f"},{"people_name":"張仁則","people_name_jianti_auto":"张仁则","start_index":21,"tongjian_id":"b6051f6a-db0e-11ef-b130-a0d3651f611f"},{"people_name":"李密","people_name_jianti_auto":"李密","start_index":27,"tongjian_id":"b6051f6b-db0e-11ef-ba37-a0d3651f611f"},{"people_name":"密","people_name_jianti_auto":"密","start_index":37,"tongjian_id":"b6051f6c-db0e-11ef-a8e0-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"壽陽","place_name_jianti_auto":"寿阳","start_index":13,"tongjian_id":"b6051f6d-db0e-11ef-b818-a0d3651f611f"},{"place_name":"霍邑","place_name_jianti_auto":"霍邑","start_index":76,"tongjian_id":"b6051f6e-db0e-11ef-8c59-a0d3651f611f"},{"place_name":"壽陽","place_name_jianti_auto":"寿阳","start_index":87,"tongjian_id":"b6051f6f-db0e-11ef-8d6d-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"考異曰：壺關錄云：「高祖屯壽陽，遣右衞將軍張仁則齋書招李密。」蒲山公傳：「密答書曰：『使至，辱今月十九日書』，按長曆是月己酉朔，十九日丁卯，不應己巳還至霍邑，又發書日不應猶在壽陽。今皆不取。","note_content_jianti_auto":"考异曰：壶关录云：「高祖屯寿阳，遣右衞将军张仁则斋书招李密。」蒲山公传：「密答书曰：『使至，辱今月十九日书』，按长历是月己酉朔，十九日丁卯，不应己巳还至霍邑，又发书日不应犹在寿阳。今皆不取。","note_type":"hu_note","start_index":7,"tongjian_id":"b6051f68-db0e-11ef-8449-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_people":[{"people_name":"章","people_name_jianti_auto":"章","start_index":1,"tongjian_id":"b6051f76-db0e-11ef-a4fd-a0d3651f611f"},{"people_name":"孔","people_name_jianti_auto":"孔","start_index":26,"tongjian_id":"b6051f77-db0e-11ef-a4a0-a0d3651f611f"},{"people_name":"張","people_name_jianti_auto":"张","start_index":30,"tongjian_id":"b6051f78-db0e-11ef-8f09-a0d3651f611f"}],"ExtRef_Children_places":[],"note_content":"『章：十二行本「主」下有「己巳」二字；乙十一行本同；孔本同；張校同。』","note_content_jianti_auto":"『章：十二行本「主」下有「己巳」二字；乙十一行本同；孔本同；张校同。』","note_type":"『章：[^』]*』","start_index":0,"tongjian_id":"b6051f75-db0e-11ef-8bb6-a0d3651f611f"}],"note_content":"","note_type":"hu_note","start_index":18,"tongjian_id":"b6051f74-db0e-11ef-ba96-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"唐公","people_name_jianti_auto":"唐公","start_index":0,"tongjian_id":"b6051f7a-db0e-11ef-b7a0-a0d3651f611f"},{"people_name":"李虎","people_name_jianti_auto":"李虎","start_index":4,"tongjian_id":"b6051f7b-db0e-11ef-98d7-a0d3651f611f"},{"people_name":"密","people_name_jianti_auto":"密","start_index":7,"tongjian_id":"b6051f7c-db0e-11ef-994f-a0d3651f611f"},{"people_name":"李弼","people_name_jianti_auto":"李弼","start_index":10,"tongjian_id":"b6051f7d-db0e-11ef-9ca0-a0d3651f611f"},{"people_name":"李弼","people_name_jianti_auto":"李弼","start_index":19,"tongjian_id":"b6051f7e-db0e-11ef-babd-a0d3651f611f"},{"people_name":"李虎","people_name_jianti_auto":"李虎","start_index":31,"tongjian_id":"b6051f7f-db0e-11ef-9e92-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"遼東","place_name_jianti_auto":"辽东","start_index":25,"tongjian_id":"b6051f80-db0e-11ef-abcd-a0d3651f611f"},{"place_name":"襄平","place_name_jianti_auto":"襄平","place_note":"辽宁省辽阳市","start_index":27,"tongjian_id":"b6051f81-db0e-11ef-bf56-a0d3651f611f"},{"place_name":"西涼","place_name_jianti_auto":"西凉","start_index":34,"tongjian_id":"b6051f82-db0e-11ef-8aa7-a0d3651f611f"},{"place_name":"隴西","place_name_jianti_auto":"陇西","start_index":38,"tongjian_id":"b6051f83-db0e-11ef-afb2-a0d3651f611f"},{"place_name":"成紀","place_name_jianti_auto":"成纪","place_note":"甘肃省临洮县","start_index":40,"tongjian_id":"b6051f84-db0e-11ef-a77a-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"唐公出於李虎，密出於李弼，是異派也。然李弼之先，本遼東襄平人。李虎祖西涼，本隴西成紀人。所謂根系，但同姓耳。","note_content_jianti_auto":"唐公出于李虎，密出于李弼，是异派也。然李弼之先，本辽东襄平人。李虎祖西凉，本陇西成纪人。所谓根系，但同姓耳。","note_type":"hu_note","start_index":39,"tongjian_id":"b6051f79-db0e-11ef-b80f-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"「唯」，當作「惟」。惟，思也。詳見審是。","note_content_jianti_auto":"「唯」，当作「惟」。惟，思也。详见审是。","note_type":"hu_note","start_index":54,"tongjian_id":"b6051f85-db0e-11ef-a474-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_ch