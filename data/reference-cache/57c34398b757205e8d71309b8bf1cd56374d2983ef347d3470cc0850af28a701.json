b0e-11ef-902b-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":97,"tongjian_id":"8c27e674-db0e-11ef-aafc-a0d3651f611f"},{"place_name":"禹城","place_name_jianti_auto":"禹城","start_index":99,"tongjian_id":"8c27e675-db0e-11ef-993a-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":102,"tongjian_id":"8c27e676-db0e-11ef-90da-a0d3651f611f"},{"place_name":"祝阿","place_name_jianti_auto":"祝阿","start_index":103,"tongjian_id":"8c27e677-db0e-11ef-a6af-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"盼，匹莧翻，又披班翻。按丁度集韻，盼，與盻同。盼子，齊之同姓，卽田盼也。班志，高唐縣屬平原郡。杜預曰：祝阿西北有高唐城。宋白曰：齊州章丘縣，古高唐，春秋、戰國之時爲齊邑，故城在廢禹城縣西四十里。唐之禹城，漢祝阿也。","note_content_jianti_auto":"盼，匹苋翻，又披班翻。按丁度集韵，盼，与盻同。盼子，齐之同姓，即田盼也。班志，高唐县属平原郡。杜预曰：祝阿西北有高唐城。宋白曰：齐州章丘县，古高唐，春秋、战国之时为齐邑，故城在废禹城县西四十里。唐之禹城，汉祝阿也。","note_type":"hu_note","start_index":144,"tongjian_id":"8c27e661-db0e-11ef-9c27-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"黔敖","people_name_jianti_auto":"黔敖","start_index":5,"tongjian_id":"8c27e67b-db0e-11ef-ab78-a0d3651f611f"},{"people_name":"黔","people_name_jianti_auto":"黔","start_index":9,"tongjian_id":"8c27e67c-db0e-11ef-b81d-a0d3651f611f"},{"people_name":"司馬彪","people_name_jianti_auto":"司马彪","start_index":19,"tongjian_id":"8c27e67d-db0e-11ef-a07f-a0d3651f611f"},{"people_name":"丁度","people_name_jianti_auto":"丁度","start_index":41,"tongjian_id":"8c27e67e-db0e-11ef-b1ce-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"齊","place_name_jianti_auto":"齐","start_index":3,"tongjian_id":"8c27e67f-db0e-11ef-96f8-a0d3651f611f"},{"place_name":"魯國","place_name_jianti_auto":"鲁国","start_index":24,"tongjian_id":"8c27e680-db0e-11ef-9377-a0d3651f611f"},{"place_name":"薛縣","place_name_jianti_auto":"薛县","start_index":26,"tongjian_id":"8c27e681-db0e-11ef-b69e-a0d3651f611f"},{"place_name":"六國","place_name_jianti_auto":"六国","start_index":29,"tongjian_id":"8c27e682-db0e-11ef-9db0-a0d3651f611f"},{"place_name":"徐州","place_name_jianti_auto":"徐州","start_index":33,"tongjian_id":"8c27e683-db0e-11ef-ab3e-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"姓譜：齊有黔敖、則黔亦姓也，音其淹翻。司馬彪曰：魯國薛縣，六國時曰徐州。徐，音舒。丁度集韻「徐」作「俆」，音同。","note_content_jianti_auto":"姓谱：齐有黔敖、则黔亦姓也，音其淹翻。司马彪曰：鲁国薛县，六国时曰徐州。徐，音舒。丁度集韵「徐」作「俆」，音同。","note_type":"hu_note","start_index":156,"tongjian_id":"8c27e67a-db0e-11ef-ad72-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"賈逵","people_name_jianti_auto":"贾逵","start_index":12,"tongjian_id":"8c27e687-db0e-11ef-b189-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"燕","place_name_jianti_auto":"燕","start_index":0,"tongjian_id":"8c27e688-db0e-11ef-81f0-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":2,"tongjian_id":"8c27e689-db0e-11ef-bb6c-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":6,"tongjian_id":"8c27e68a-db0e-11ef-bdad-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":8,"tongjian_id":"8c27e68b-db0e-11ef-8089-a0d3651f611f"},{"place_name":"燕","place_name_jianti_auto":"燕","start_index":16,"tongjian_id":"8c27e68c-db0e-11ef-90f2-a0d3651f611f"},{"place_name":"趙","place_name_jianti_auto":"赵","start_index":18,"tongjian_id":"8c27e68d-db0e-11ef-a00c-a0d3651f611f"},{"place_name":"齊","place_name_jianti_auto":"齐","start_index":20,"tongjian_id":"8c27e68e-db0e-11ef-85b8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"燕在齊之北，趙在齊之西。賈逵曰：燕、趙畏齊，故祭以求福。燕，因肩翻。","note_content_jianti_auto":"燕在齐之北，赵在齐之西。贾逵曰：燕、赵畏齐，故祭以求福。燕，因肩翻。","note_type":"hu_note","start_index":169,"tongjian_id":"8c27e686-db0e-11ef-8cee-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","place_note":"山東禹城縣西南","resolved_place_entity_id":3050,"start_index":131,"tongjian_id":"8c29326c-db0e-11ef-b045-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/一、济南府（卷三十一）","excerpts":[{"context_after":"又鲁仲连谓田巴：今楚军南阳，赵伐高唐者也。汉置高唐县于此...","context_before":"...：齐庄公初，晋伐齐，至高唐。又赵肃侯六年，攻齐，拔高唐。","source_end_index":220,"source_paragraph_tongjian_id":"6d8917ea-a72f-567c-bf0a-f131ed834127","source_start_index":181,"source_text":"齐威王三十四年，与魏惠王会。威王曰：吾臣有盻子者，使守高唐，赵人不敢东渔于河。"}],"path":"山东方舆纪要/一、济南府（卷三十一）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/二、兖州府（卷三十二）","excerpts":[{"context_after":"又宣王八年，与魏襄王会徐州，诸侯相王也。十年，楚围我徐州...","context_before":"...》作徐州。又句践平吴，以兵北渡淮，与齐、晋诸侯会于徐州。","source_end_index":329,"source_paragraph_tongjian_id":"7a04b6d6-ac2b-54ee-a7d6-8d8a39f95109","source_start_index":308,"source_text":"又齐威王谓魏惠王，吾吏有黔夫者，使守徐州。"}],"path":"山东方舆纪要/二、兖州府（卷三十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/三、济宁州（卷三十三）","excerpts":[{"context_after":"是也。汉置南城县，属东海郡，亦曰南成。武帝封城阳共王子贞...","context_before":"...武城。《孟子》：曾子居武城，有越寇。皆此。后亦谓之南城。","source_end_index":183,"source_paragraph_tongjian_id":"cfc5e774-3cb9-5008-982a-e7e85ce41520","source_start_index":156,"source_text":"齐威王谓魏惠王，吾臣有檀子者，使守南城，楚人不敢为寇。"}],"path":"山东方舆纪要/三、济宁州（卷三十三）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"1齊威王、魏惠王會田于郊。惠王曰：「齊亦有寶乎？」威王曰：「無有。」惠王曰：「寡人國雖小，尚有徑寸之珠，照車前後各十二乘者十枚。豈以齊大國而無寶乎？」威王曰：「寡人之所以爲寶者與王異。吾臣有檀子者，使守南城，則楚人不敢爲寇，泗上十二諸侯皆來朝。吾臣有盼子者，使守高唐，則趙人不敢東漁于河。吾吏有黔夫者，使守徐州，則燕人祭北門，趙人祭西門，徙而從者七千餘家。吾臣有種首者，使備盜賊，則道不拾遺。此四臣者，將照千里，豈特十二乘哉！」惠王有慚色。","content_fanyi":"齐威王、魏惠王在郊外相会并一同打猎。魏惠王问：“齐国也有值得称为宝物的东西吗？”齐威王说：“没有。”魏惠王说：“寡人的国家虽然狭小，尚且有十颗直径一寸、能照亮前后各十二辆车子的明珠。难道以齐国的大国地位，反而没有宝物吗？”齐威王说：“寡人所认为的宝物，与大王不同。我的臣子中有个叫檀子的，派他镇守南城，楚国人便不敢前来侵扰，泗水一带的十二个诸侯都来朝见。我的臣子中有个叫盼子的，派他镇守高唐，赵国人便不敢向东到黄河里捕鱼。我的官吏中有个叫黔夫的，派他镇守徐州，燕国人祭祀北门，赵国人祭祀西门，迁来跟随他的有七千多家。我的臣子中有个叫种首的，派他防范盗贼，道路上便没有人拾取他人遗失的东西。这四位臣子，光芒将照耀千里，哪里只是照亮十二辆车子呢！”魏惠王露出惭愧的神色。","content_jianti_auto":"1齐威王、魏惠王会田于郊。惠王曰：「齐亦有宝乎？」威王曰：「无有。」惠王曰：「寡人国虽小，尚有径寸之珠，照车前后各十二乘者十枚。岂以齐大国而无宝乎？」威王曰：「寡人之所以为宝者与王异。吾臣有檀子者，使守南城，则楚人不敢为寇，泗上十二诸侯皆来朝。吾臣有盼子者，使守高唐，则赵人不敢东渔于河。吾吏有黔夫者，使守徐州，则燕人祭北门，赵人祭西门，徙而从者七千余家。吾臣有种首者，使备盗贼，则道不拾遗。此四臣者，将照千里，岂特十二乘哉！」惠王有惭色。","dtjl_paragraph_links":[],"dtjl_references":[],"id":135,"number":1,"path":"资治通鉴 : 卷第二 (周紀二) / 顯王 / 十四年 / 第 1 段","reading_annotation_sources":[],"start_index":0,"tongjian_id":"8c27e657-db0e-11ef-a241-a0d3651f611f","year_int":-355,"zhang_TJZJ_id":"zttjzj_000362"},"tongjian_id":"8c27e657-db0e-11ef-a241-a0d3651f611f"},"paragraph_order":1},{"mention_count":2,"paragraph_brief":{"brief_for":"高唐","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"高唐縣","place_name_jianti_auto":"高唐县","start_index":0,"tongjian_id":"a49adf63-db0e-11ef-afbd-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":5,"tongjian_id":"a49adf64-db0e-11ef-b4c0-a0d3651f611f"},{"place_name":"平原郡","place_name_jianti_auto":"平原郡","start_index":9,"tongjian_id":"a49adf65-db0e-11ef-bc49-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高唐縣，自漢以來屬平原郡。","note_content_jianti_auto":"高唐县，自汉以来属平原郡。","note_type":"hu_note","start_index":12,"tongjian_id":"a49adf62-db0e-11ef-bfb9-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"相屬於路也。屬，之欲翻。","note_content_jianti_auto":"相属于路也。属，之欲翻。","note_type":"hu_note","start_index":41,"tongjian_id":"a49adf67-db0e-11ef-b873-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","resolved_place_entity_id":3050,"start_index":9,"tongjian_id":"a49adf6a-db0e-11ef-adf9-a0d3651f611f"},{"place_name":"高唐","place_name_jianti_auto":"高唐","resolved_place_entity_id":3050,"start_index":54,"tongjian_id":"a49adf76-db0e-11ef-b1a5-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[],"class_tags":[],"content":"12平規收合餘黨據高唐，燕主寶遣高陽王隆將兵討之；東土之民，素懷隆惠，迎候者屬路。秋，七月，隆進軍臨河，規棄高唐走。隆遣建威將軍慕容進等濟河追之，斬規於濟北。平喜奔彭城。","content_fanyi":"后燕叛将平规收拢、聚合他的余党，占据高唐；后燕主慕容宝派遣高阳王慕容隆率兵前往讨伐。东土地区的百姓素来感念慕容隆的恩惠，迎接等候他的人沿途络绎不绝。秋季七月，慕容隆进军抵达黄河岸边，平规放弃高唐逃走。慕容隆派建威将军慕容进等人渡过黄河追击，在济北将平规斩首。平喜逃奔彭城。","content_jianti_auto":"12平规收合余党据高唐，燕主宝遣高阳王隆将兵讨之；东土之民，素怀隆惠，迎候者属路。秋，七月，隆进军临河，规弃高唐走。隆遣建威将军慕容进等济河追之，斩规于济北。平喜奔彭城。","dtjl_paragraph_links":[],"dtjl_references":[],"id":9678,"number":12,"path":"资治通鉴 : 卷第一百八 (晉紀三十) / 烈宗孝武皇帝下 / 二十一年 / 第 17 段","reading_annotation_sources":[],"start_index":16,"tongjian_id":"a49adf61-db0e-11ef-8703-a0d3651f611f","year_int":396},"tongjian_id":"a49adf61-db0e-11ef-8703-a0d3651f611f"},"paragraph_order":2},{"mention_count":3,"paragraph_brief":{"brief_for":"高唐","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","place_note":"山东高唐县","start_index":0,"tongjian_id":"c98e236c-db0e-11ef-830f-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":3,"tongjian_id":"c98e236d-db0e-11ef-bbcb-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":7,"tongjian_id":"c98e236e-db0e-11ef-af1e-a0d3651f611f"},{"place_name":"博州","place_name_jianti_auto":"博州","start_index":9,"tongjian_id":"c98e236f-db0e-11ef-8466-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高唐，漢古縣，唐屬博州。九域志，在州東北一百一十里。","note_content_jianti_auto":"高唐，汉古县，唐属博州。九域志，在州东北一百一十里。","note_type":"hu_note","start_index":68,"tongjian_id":"c98e236b-db0e-11ef-aa71-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"宋白","people_name_jianti_auto":"宋白","start_index":18,"tongjian_id":"c98e2372-db0e-11ef-82b0-a0d3651f611f"},{"people_name":"王莽","people_name_jianti_auto":"王莽","start_index":85,"tongjian_id":"c98e2373-db0e-11ef-82a2-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"歷亭縣","place_name_jianti_auto":"历亭县","start_index":0,"tongjian_id":"c98e2374-db0e-11ef-9a39-a0d3651f611f"},{"place_name":"貝州","place_name_jianti_auto":"贝州","start_index":4,"tongjian_id":"c98e2375-db0e-11ef-8c9d-a0d3651f611f"},{"place_name":"歷亭縣","place_name_jianti_auto":"历亭县","start_index":22,"tongjian_id":"c98e2376-db0e-11ef-ae22-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":29,"tongjian_id":"c98e2377-db0e-11ef-bf99-a0d3651f611f"},{"place_name":"高齊","place_name_jianti_auto":"高齐","start_index":32,"tongjian_id":"c98e2378-db0e-11ef-babe-a0d3651f611f"},{"place_name":"鄃縣","place_name_jianti_auto":"鄃县","start_index":38,"tongjian_id":"c98e2379-db0e-11ef-98de-a0d3651f611f"},{"place_name":"隋","place_name_jianti_auto":"隋","start_index":41,"tongjian_id":"c98e237a-db0e-11ef-838c-a0d3651f611f"},{"place_name":"永濟渠","place_name_jianti_auto":"永济渠","start_index":48,"tongjian_id":"c98e237b-db0e-11ef-a806-a0d3651f611f"},{"place_name":"歷亭縣","place_name_jianti_auto":"历亭县","start_index":53,"tongjian_id":"c98e237c-db0e-11ef-8a1c-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":59,"tongjian_id":"c98e237d-db0e-11ef-90b7-a0d3651f611f"},{"place_name":"歷城縣","place_name_jianti_auto":"历城县","start_index":60,"tongjian_id":"c98e237e-db0e-11ef-9ad6-a0d3651f611f"},{"place_name":"歷城","place_name_jianti_auto":"历城","start_index":73,"tongjian_id":"c98e237f-db0e-11ef-9f06-a0d3651f611f"},{"place_name":"信都郡","place_name_jianti_auto":"信都郡","start_index":76,"tongjian_id":"c98e2380-db0e-11ef-a91d-a0d3651f611f"},{"place_name":"蓨縣","place_name_jianti_auto":"蓨县","place_note":"河北景县","start_index":81,"tongjian_id":"c98e2381-db0e-11ef-8801-a0d3651f611f"},{"place_name":"歷亭","place_name_jianti_auto":"历亭","start_index":89,"tongjian_id":"c98e2382-db0e-11ef-b583-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":92,"tongjian_id":"c98e2383-db0e-11ef-9956-a0d3651f611f"},{"place_name":"盤河","place_name_jianti_auto":"盘河","start_index":101,"tongjian_id":"c98e2384-db0e-11ef-9836-a0d3651f611f"},{"place_name":"歷城","place_name_jianti_auto":"历城","start_index":107,"tongjian_id":"c98e2385-db0e-11ef-ad61-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"歷亭縣屬貝州。九域志，在州東九十里。宋白曰：歷亭縣之地，自後魏至高齊，其地屬鄃縣，隋開皇十六年於永濟渠南置歷亭縣，遙取漢歷城縣爲名。按漢·地理志，歷城屬信都郡，在蓨縣界，王莽改曰歷亭。唐萬歲登封元年移就盤河置，在古歷城西七十里。","note_content_jianti_auto":"历亭县属贝州。九域志，在州东九十里。宋白曰：历亭县之地，自后魏至高齐，其地属鄃县，隋开皇十六年于永济渠南置历亭县，遥取汉历城县为名。按汉·地理志，历城属信都郡，在蓨县界，王莽改曰历亭。唐万岁登封元年移就盘河置，在古历城西七十里。","note_type":"hu_note","start_index":105,"tongjian_id":"c98e2371-db0e-11ef-8e91-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","place_note":"山东高唐县","resolved_place_entity_id":3050,"start_index":65,"tongjian_id":"c98e2390-db0e-11ef-acc4-a0d3651f611f"},{"place_name":"高唐","place_name_jianti_auto":"高唐","resolved_place_entity_id":3050,"start_index":98,"tongjian_id":"c98e2393-db0e-11ef-9e98-a0d3651f611f"},{"place_name":"高唐","place_name_jianti_auto":"高唐","resolved_place_entity_id":3050,"start_index":146,"tongjian_id":"c98e2399-db0e-11ef-af8c-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"宋仍为历亭县治。金为恩州治。明初，为恩县治。洪武七年，徙...","context_before":"...。万岁登封初，移县治盘河，去信都废历县城七十里，寻复旧。","source_end_index":180,"source_paragraph_tongjian_id":"93ff70c5-2962-5ae8-9cda-33c59db7d4d0","source_start_index":132,"source_text":"天祐三年，魏博牙将史仁遇作乱，据高唐。朱全忠时营于魏州，召行营兵于乐寿，至历亭，进攻高唐，克之。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"12羅紹威旣誅牙軍，魏之諸軍皆懼，紹威雖數撫諭之，而猜怨益甚。朱全忠營於魏州城東數旬，將北巡行營，會天雄牙將史仁遇作亂，聚衆數萬據高唐，自稱留後，天雄巡內諸縣多應之。全忠移軍入城，遣使召行營兵還攻高唐，至歷亭，魏兵在行營者作亂，與仁遇相應。元帥府左司馬李周彝、右司馬苻道昭擊之，所殺殆半，進攻高唐，克之，城中兵民無少長皆死。擒史仁遇，鋸殺之。","content_fanyi":"罗绍威诛灭牙军之后，魏博各军都很恐惧，罗绍威虽然多次安抚劝谕他们，但猜忌怨恨反而更加严重。朱全忠在魏州城东扎营数十天，准备北上巡视行营，恰逢天雄牙将史仁遇发动叛乱，聚集部众数万人占据高唐县，自称天雄留后，天雄巡内各县大多响应他。朱全忠移军进入魏州城，派使者召回行营兵返回攻打高唐县，行营兵到达历亭县时，行营中的魏州士兵发动叛乱，与史仁遇互相呼应。元帅府左司马李周彝、右司马苻道昭攻击这些叛军，杀死近半，又进攻高唐县并将其攻克，城中士兵百姓不论老幼全部被杀。擒获史仁遇，用锯子将他处死。","content_jianti_auto":"12罗绍威既诛牙军，魏之诸军皆惧，绍威虽数抚谕之，而猜怨益甚。朱全忠营于魏州城东数旬，将北巡行营，会天雄牙将史仁遇作乱，聚众数万据高唐，自称留后，天雄巡内诸县多应之。全忠移军入城，遣使召行营兵还攻高唐，至历亭，魏兵在行营者作乱，与仁遇相应。元帅府左司马李周彝、右司马苻道昭击之，所杀殆半，进攻高唐，克之，城中兵民无少长皆死。擒史仁遇，锯杀之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27446,"number":12,"path":"资治通鉴 : 卷第二百六十五 (唐紀八十一) / 昭宣光烈孝皇帝 / 三年 / 第 12 段","reading_annotation_sources":[],"start_index":11,"tongjian_id":"c98e2369-db0e-11ef-a245-a0d3651f611f","year_int":906},"tongjian_id":"c98e2369-db0e-11ef-a245-a0d3651f611f"},"paragraph_order":3},{"mention_count":1,"paragraph_brief":{"brief_for":"高唐","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"夏津","place_name_jianti_auto":"夏津","place_note":"山东夏津县","start_index":0,"tongjian_id":"ca15d45f-db0e-11ef-81db-a0d3651f611f"},{"place_name":"鄃縣","place_name_jianti_auto":"鄃县","place_note":"山东平原县西南，夏津县东北","start_index":4,"tongjian_id":"ca15d460-db0e-11ef-83eb-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":7,"tongjian_id":"ca15d461-db0e-11ef-ac45-a0d3651f611f"},{"place_name":"夏津","place_name_jianti_auto":"夏津","start_index":14,"tongjian_id":"ca15d462-db0e-11ef-b363-a0d3651f611f"},{"place_name":"貝州","place_name_jianti_auto":"贝州","start_index":18,"tongjian_id":"ca15d463-db0e-11ef-8550-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":26,"tongjian_id":"ca15d464-db0e-11ef-aa7c-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"夏津本古鄃縣，唐天寶元年更名夏津，屬貝州。九域志：在魏州東北二百五十里。","note_content_jianti_auto":"夏津本古鄃县，唐天宝元年更名夏津，属贝州。九域志：在魏州东北二百五十里。","note_type":"hu_note","start_index":21,"tongjian_id":"ca15d45e-db0e-11ef-b902-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢東郡","place_name_jianti_auto":"汉东郡","start_index":0,"tongjian_id":"ca15d467-db0e-11ef-9565-a0d3651f611f"},{"place_name":"東武陽縣","place_name_jianti_auto":"东武阳县","start_index":3,"tongjian_id":"ca15d468-db0e-11ef-a851-a0d3651f611f"},{"place_name":"後魏","place_name_jianti_auto":"后魏","start_index":8,"tongjian_id":"ca15d469-db0e-11ef-b490-a0d3651f611f"},{"place_name":"武陽","place_name_jianti_auto":"武阳","start_index":11,"tongjian_id":"ca15d46a-db0e-11ef-94dc-a0d3651f611f"},{"place_name":"唐","place_name_jianti_auto":"唐","start_index":14,"tongjian_id":"ca15d46b-db0e-11ef-80a3-a0d3651f611f"},{"place_name":"朝城","place_name_jianti_auto":"朝城","start_index":21,"tongjian_id":"ca15d46c-db0e-11ef-be7b-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":25,"tongjian_id":"ca15d46d-db0e-11ef-9fd8-a0d3651f611f"},{"place_name":"朝城縣","place_name_jianti_auto":"朝城县","start_index":29,"tongjian_id":"ca15d46e-db0e-11ef-83a3-a0d3651f611f"},{"place_name":"東武","place_name_jianti_auto":"东武","start_index":38,"tongjian_id":"ca15d46f-db0e-11ef-a807-a0d3651f611f"},{"place_name":"朝城","place_name_jianti_auto":"朝城","place_note":"山东莘县西南朝城镇","start_index":45,"tongjian_id":"ca15d470-db0e-11ef-b08c-a0d3651f611f"},{"place_name":"魏州","place_name_jianti_auto":"魏州","start_index":48,"tongjian_id":"ca15d471-db0e-11ef-b8fd-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"漢東郡東武陽縣，後魏曰武陽，唐開元七年更名朝城，屬魏州。故朝城縣管內猶有地名東武。九域志：朝城在魏州東南八十里。","note_content_jianti_auto":"汉东郡东武阳县，后魏曰武阳，唐开元七年更名朝城，属魏州。故朝城县管内犹有地名东武。九域志：朝城在魏州东南八十里。","note_type":"hu_note","start_index":32,"tongjian_id":"ca15d466-db0e-11ef-8fe2-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"隋","place_name_jianti_auto":"隋","start_index":0,"tongjian_id":"ca15d474-db0e-11ef-8ae4-a0d3651f611f"},{"place_name":"汲","place_name_jianti_auto":"汲","start_index":2,"tongjian_id":"ca15d475-db0e-11ef-b1d2-a0d3651f611f"},{"place_name":"獲嘉","place_name_jianti_auto":"获嘉","place_note":"河南省获嘉县","start_index":4,"tongjian_id":"ca15d476-db0e-11ef-9be3-a0d3651f611f"},{"place_name":"新樂城","place_name_jianti_auto":"新乐城","start_index":12,"tongjian_id":"ca15d477-db0e-11ef-95bb-a0d3651f611f"},{"place_name":"新鄕縣","place_name_jianti_auto":"新鄕县","start_index":16,"tongjian_id":"ca15d478-db0e-11ef-9e9b-a0d3651f611f"},{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":20,"tongjian_id":"ca15d479-db0e-11ef-8ecb-a0d3651f611f"},{"place_name":"漢","place_name_jianti_auto":"汉","start_index":23,"tongjian_id":"ca15d47a-db0e-11ef-9703-a0d3651f611f"},{"place_name":"共縣","place_name_jianti_auto":"共县","start_index":24,"tongjian_id":"ca15d47b-db0e-11ef-b9ef-a0d3651f611f"},{"place_name":"衞州","place_name_jianti_auto":"衞州","start_index":31,"tongjian_id":"ca15d47c-db0e-11ef-9d69-a0d3651f611f"},{"place_name":"共城","place_name_jianti_auto":"共城","place_note":"河南辉县市","start_index":38,"tongjian_id":"ca15d47d-db0e-11ef-9aa3-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"隋分汲、獲嘉二縣地，於古新樂城置新鄕縣。共城，漢共縣地，唐志屬衞州。九域志：共城在州西北五十五里。共，音恭。","note_content_jianti_auto":"隋分汲、获嘉二县地，于古新乐城置新鄕县。共城，汉共县地，唐志属衞州。九域志：共城在州西北五十五里。共，音恭。","note_type":"hu_note","start_index":74,"tongjian_id":"ca15d473-db0e-11ef-9358-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"梁祖","people_name_jianti_auto":"梁祖","start_index":11,"tongjian_id":"ca15d481-db0e-11ef-948d-a0d3651f611f"},{"people_name":"薛居正","people_name_jianti_auto":"薛居正","start_index":30,"tongjian_id":"ca15d482-db0e-11ef-a2f7-a0d3651f611f"},{"people_name":"太祖","people_name_jianti_auto":"太祖","start_index":35,"tongjian_id":"ca15d483-db0e-11ef-8b9e-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"晉","place_name_jianti_auto":"晋","start_index":2,"tongjian_id":"ca15d484-db0e-11ef-bfe1-a0d3651f611f"},{"place_name":"白司馬阪","place_name_jianti_auto":"白司马阪","place_note":"河南洛阳市北","start_index":47,"tongjian_id":"ca15d485-db0e-11ef-aff3-a0d3651f611f"},{"place_name":"洛陽","place_name_jianti_auto":"洛阳","start_index":52,"tongjian_id":"ca15d486-db0e-11ef-bfab-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"史言晉兵乘勝聲勢之盛。梁祖選富家子有材力者置帳下，號廳子都。薛居正曰：太祖置廳子都，最爲親軍。白司馬阪在洛陽城北。帥，讀曰率。","note_content_jianti_auto":"史言晋兵乘胜声势之盛。梁祖选富家子有材力者置帐下，号厅子都。薛居正曰：太祖置厅子都，最为亲军。白司马阪在洛阳城北。帅，读曰率。","note_type":"hu_note","start_index":90,"tongjian_id":"ca15d480-db0e-11ef-a793-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","place_note":"山东高唐县","resolved_place_entity_id":3050,"start_index":18,"tongjian_id":"ca15d48b-db0e-11ef-a886-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/四、东昌府（卷三十四）","excerpts":[{"context_after":"乾化五年，魏博附晋，晋王存勖命李存审自赵州进据临清，晋王...","context_before":"...。贞元末，属贝州。乾宁三年，河东将李存信攻临清，败汴兵。","source_end_index":152,"source_paragraph_tongjian_id":"9f2f6813-d180-5721-9a81-091aeeae12eb","source_start_index":122,"source_text":"朱梁开平五年，晋将周德威略魏博，自临清攻贝州，拔夏津、高唐。"},{"context_after":"盖因故东武朝城而名也。贞明五年，晋王存勖败于朝城，视河冰...","context_before":"...师自清入河，军于东武阳。后魏曰武阳县。隋因之。唐曰朝城。","source_end_index":225,"source_paragraph_tongjian_id":"ba91fc78-2d5b-50d3-ad4c-acb8c7cb0150","source_start_index":192,"source_text":"五代梁开平五年，晋将周德威攻博州，拔东武朝城。又贝州奏晋兵侵东武。"}],"path":"山东方舆纪要/四、东昌府（卷三十四）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、卫辉府（卷四十九）","excerpts":[{"context_after":"新乡，皆今治也]。","context_before":"...置今县。唐武德二年，王世充使刘黑闼守新乡，为窦建德所获。","source_end_index":106,"source_paragraph_tongjian_id":"9345b8f3-8ce1-5fe2-852d-4b521b6fd4c9","source_start_index":83,"source_text":"朱梁开平五年，晋将周德威逼卫州，拔新乡及共城。"}],"path":"河南方舆纪要/四、卫辉府（卷四十九）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"7乙丑，周德威自臨清攻貝州，拔夏津、高唐；攻博州，拔東武、朝城。攻澶州，刺史張可臻棄城走，帝斬之。德威進攻黎陽，拔臨河、淇門；逼衞州，掠新鄕、共城。庚午，帝親帥軍屯白司馬阪以備之。","content_fanyi":"乙丑日，周德威从临清进攻贝州，攻克夏津、高唐；又进攻博州，攻克东武、朝城。攻打澶州时，刺史张可臻弃城逃跑，皇帝将他处死。周德威又进攻黎阳，夺取临河、淇门；逼近卫州，抢掠新乡、共城。庚午日，皇帝亲自率领军队驻扎在白司马阪，以防备晋军。","content_jianti_auto":"7乙丑，周德威自临清攻贝州，拔夏津、高唐；攻博州，拔东武、朝城。攻澶州，刺史张可臻弃城走，帝斩之。德威进攻黎阳，拔临河、淇门；逼衞州，掠新鄕、共城。庚午，帝亲帅军屯白司马阪以备之。","dtjl_paragraph_links":[],"dtjl_references":[],"id":27742,"number":7,"path":"资治通鉴 : 卷第二百六十七 (後梁紀二) / 太祖神武元聖孝皇帝中 / 乾化元年 / 第 10 段","reading_annotation_sources":[],"start_index":9,"tongjian_id":"ca15d45d-db0e-11ef-8633-a0d3651f611f","year_int":911},"tongjian_id":"ca15d45d-db0e-11ef-8633-a0d3651f611f"},"paragraph_order":4},{"mention_count":1,"paragraph_brief":{"brief_for":"高唐","paragraph":{"ExtRef_Children_books":[],"ExtRef_Children_companion_annotation_entities":[],"ExtRef_Children_decisions":[],"ExtRef_Children_hu_notes":[{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[],"ExtRef_Children_places":[{"place_name":"漢","place_name_jianti_auto":"汉","start_index":5,"tongjian_id":"ceb49516-db0e-11ef-b2c4-a0d3651f611f"},{"place_name":"陳州","place_name_jianti_auto":"陈州","start_index":13,"tongjian_id":"ceb49517-db0e-11ef-9ebc-a0d3651f611f"},{"place_name":"鎭安軍","place_name_jianti_auto":"镇安军","start_index":15,"tongjian_id":"ceb49518-db0e-11ef-aa94-a0d3651f611f"},{"place_name":"周","place_name_jianti_auto":"周","start_index":19,"tongjian_id":"ceb49519-db0e-11ef-bdd8-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"五代會要：漢天福十二年，廢陳州鎭安軍，周廣順二年復。","note_content_jianti_auto":"五代会要：汉天福十二年，废陈州镇安军，周广顺二年复。","note_type":"hu_note","start_index":31,"tongjian_id":"ceb49515-db0e-11ef-b9ea-a0d3651f611f"},{"ExtRef_Children_books":[],"ExtRef_Children_chenzhu":[],"ExtRef_Children_paragraph_links":[],"ExtRef_Children_people":[{"people_name":"昝","people_name_jianti_auto":"昝","start_index":22,"tongjian_id":"ceb4951c-db0e-11ef-a1d7-a0d3651f611f"}],"ExtRef_Children_places":[{"place_name":"高唐縣","place_name_jianti_auto":"高唐县","start_index":0,"tongjian_id":"ceb4951d-db0e-11ef-ab83-a0d3651f611f"},{"place_name":"博州","place_name_jianti_auto":"博州","start_index":4,"tongjian_id":"ceb4951e-db0e-11ef-8459-a0d3651f611f"}],"ExtRef_Children_user_annotation_entities":[],"ExtRef_Children_zhang_notes":[],"note_content":"高唐縣屬博州。九域志：縣在州東北一百七十里。昝，姓也，音子感翻。","note_content_jianti_auto":"高唐县属博州。九域志：县在州东北一百七十里。昝，姓也，音子感翻。","note_type":"hu_note","start_index":54,"tongjian_id":"ceb4951b-db0e-11ef-95a0-a0d3651f611f"}],"ExtRef_Children_officials":[],"ExtRef_Children_people":[],"ExtRef_Children_pinyin":[],"ExtRef_Children_places":[{"place_name":"高唐","place_name_jianti_auto":"高唐","place_note":"山东高唐","resolved_place_entity_id":3050,"start_index":46,"tongjian_id":"ceb4952a-db0e-11ef-9d1a-a0d3651f611f"}],"ExtRef_Children_topics":[],"ExtRef_Children_user_annotation_entities":[],"background_material_references":[{"display_title":"读史方舆纪要/〇、封域山川险要（卷五十二）","excerpts":[{"context_after":"南宋初，恒屯重兵于此，以备金人。而金人亦盛兵宝鸡，以当大...","context_before":"...从击败蜀兵。既而蜀将安思谦复自散关应援，击汉兵于箭筈寨。","source_end_index":992,"source_paragraph_tongjian_id":"8d7f54c3-d819-5dc1-a269-b0ee9b4cf27f","source_start_index":962,"source_text":"周显德二年，命凤翔节度使王景攻蜀，自散关入，拔其秦凤诸州镇。"}],"path":"陕西方舆纪要/〇、封域山川险要（卷五十二）","source_name":"读史方舆纪要"},{"display_title":"读史方舆纪要/四、汉中府（卷五十六）","excerpts":[{"context_after":"即此。○龙安城，在县西。《隋志》：西魏有龙安、商乐二县。...","context_before":"...屯威武城。后唐同光三年，伐蜀，前锋李绍琛攻威武城，城降。","source_end_index":146,"source_paragraph_tongjian_id":"397e1aca-5975-5f6c-adf4-3d025b112180","source_start_index":113,"source_text":"周显德二年，遣王景等伐蜀，入散关，攻秦凤诸州镇，战于威武城，不利。"},{"context_after":"又县西有画眉关。《志》云：县境大散、仙人、武休、马岭、画...","context_before":"马岭关[县西三十五里。亦曰马岭寨。","source_end_index":55,"source_paragraph_tongjian_id":"2051772c-7b40-537e-a539-a1f8ea41e083","source_start_index":17,"source_text":"五代周显德二年，遣将王景等入散关，攻蜀秦州。蜀将李廷珪遣别将据马岭寨，即此。"}],"path":"陕西方舆纪要/四、汉中府（卷五十六）","source_name":"读史方舆纪要"}],"class_tags":[],"content":"15上謀取秦、鳳，求可將者。王溥薦宣徽南院使、鎭安節度使向訓。上命訓與鳳翔節度使王景、客省使高唐昝居潤偕行。五月，戊辰朔，景出兵自散關趣秦州。","content_fanyi":"后周世宗计划夺取秦州、凤州，寻求能够统领军队的人。王溥举荐宣徽南院使、镇安节度使向训。后周世宗命令向训与凤翔节度使王景、客省使高唐人昝居润一同前往。五月初一日戊辰，王景从散关出兵直奔秦州。","content_jianti_auto":"15上谋取秦、凤，求可将者。王溥荐宣徽南院使、镇安节度使向训。上命训与凤翔节度使王景、客省使高唐昝居润偕行。五月，戊辰朔，景出兵自散关趣秦州。","dtjl_paragraph_links":[],"dtjl_references":[],"id":30682,"number":15,"path":"资治通鉴 : 卷第二百九十二 (後周紀三) / 世宗睿武孝文皇帝上 / 顯德二年 / 第 19 段","reading_annotation_sources":[],"start_index":18,"tongjian_id":"ceb49513-db0e-11ef-aa22-a0d3651f611f","year_int":955},"tongjian_id":"ceb49513-db0e-11ef-aa22-a0d3651f611f"},"paragraph_order":5}],"page_size":10,"total_pages":1,"total_paragraphs":5},"place_name":"高唐"},"message":"success","success":true}